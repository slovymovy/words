        "fr-extract.jsonl": [
            {
                "entry_id": "af7ccf6d-b7eb-3a54-8303-0b8728cd5ca4",
                "word": "Gorgone",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "483f9a58-1553-4163-a1e1-072ecba86da3",
                        "entry_id": "af7ccf6d-b7eb-3a54-8303-0b8728cd5ca4",
                        "tags": [
                            "plural"
                        ],
                        "form": "Gorgones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fda67ad4-03b3-3278-9e4e-b33381601bc7",
                        "entry_id": "af7ccf6d-b7eb-3a54-8303-0b8728cd5ca4",
                        "glosses": [
                            "Créature fantastique malfaisante de la mythologie grecque, représentée sous les traits d’une femme à la chevelure constituée de serpents, et qui existait au nombre de trois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3b2903-8e7d-44eb-96f4-ccc9ab356f7f",
                                "sense_id": "fda67ad4-03b3-3278-9e4e-b33381601bc7",
                                "text": "Les Gorgones sont trois filles des divinités marines Phorcys et Céto : Sthéno, Euryale et la plus célèbre, Méduse. Méduse est la seule à être mortelle."
                            },
                            {
                                "example_id": "19e0045e-4bb0-4b82-929f-c95c6de746df",
                                "sense_id": "fda67ad4-03b3-3278-9e4e-b33381601bc7",
                                "text": "[…] qu’après avoir subi les affres de tortures intolérables ils seront précipités dans les labyrinthes abyssaux de l’antéchrist, que des démones perverses aux yeux de feu, aux sourires languides, les pousseront des hauteurs des beffrois du Malin d’où ils cherront sur des entrelacs pullulant de gorgones et de griffons avec lesquels il pataugeront à jamais […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "6354c669-f700-30b3-b312-8d6a1ae38d8a",
                        "entry_id": "af7ccf6d-b7eb-3a54-8303-0b8728cd5ca4",
                        "glosses": [
                            "Méduse, la plus connue des trois Gorgones."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c0313c5f-1fc2-4259-848b-3efedd05efbe",
                                "sense_id": "6354c669-f700-30b3-b312-8d6a1ae38d8a",
                                "text": "De Raittolbe, sévère, son masque de Slave impénétrable, songeant à la Gorgone antique lorsqu’il regardait Mlle de Vénérande."
                            },
                            {
                                "example_id": "451df6f5-f7cf-4596-aac7-fb283ed9fcf2",
                                "sense_id": "6354c669-f700-30b3-b312-8d6a1ae38d8a",
                                "text": "Le lendemain du banquet, comme les autres convives, Persée amena un cheval. Mais le roi ne l’accepta pas et il lui réclama la tête de la Gorgone, conformément à sa promesse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a46c46b3-c769-4efd-a8a7-87df0f059a77",
                        "source_entry_id": "af7ccf6d-b7eb-3a54-8303-0b8728cd5ca4",
                        "target_lang_word": "Gorgo",
