                    {
                        "translation_id": "442139a9-bd0e-4da1-928c-b017bf7dd951",
                        "source_entry_id": "eb7d5e5b-abd2-3923-af7c-506b82a0a4be",
                        "source_sense_id": "3f2cee46-2454-3305-8fab-22424f1b4b95",
