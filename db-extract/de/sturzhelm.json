                ],
                "senses": [
                    {
                        "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                        "entry_id": "fe89c763-b236-3a81-b899-9d32fefce7e5",
                        "glosses": [
                            "Kopfbedeckung meist aus Kunststoff und mit einer Polsterung zum Schutz vor Verletzung bei Stürzen (beispielsweise für Fahrradfahrer, Motorradfahrer, Skifahrer oder Reiter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e75a00-9124-4dee-940f-4a47340bc633",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "Seit 1953 sind Sturzhelme bei Formel-1-Rennen Pflicht."
                            },
                            {
                                "example_id": "427ef20d-a2b6-4a4a-8b2f-9c04542681a7",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "Hätte er einen Sturzhelm getragen, wäre ihm die schwere Kopfverletzung beim Unfall erspart geblieben."
                            },
                            {
                                "example_id": "271df1a8-f8a9-46fa-be43-2c37007969f7",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„Vom Radfahren in den Niederlanden – Ein Kind vorne, eins hinten, rechts und links prall gefüllte Einkaufstaschen – und das alles ohne Sturzhelm.“"
                            },
                            {
                                "example_id": "a7753b78-bb7b-4b14-a52a-6dd1f4df17aa",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„[…] immer wieder sieht man hagere Männer in ihrer bunten Rennfahrermontur mit Sturzhelm und Sonnenbrille über Berge Pässe und Täler fahren.“"
                            },
                            {
                                "example_id": "6aaa33f0-910f-4c8b-a8f3-840245a53561",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„Mit Verdacht auf ein Schädel-Hirntrauma und Schürfwunden im Gesicht ist am Mittwochabend ein 33-jähriger Radfahrer ins Freisinger Krankenhaus gebracht worden. […] Der Mann hatte keinen Sturzhelm getragen.“"
                            },
                            {
                                "example_id": "f0b45a68-4f4e-41fa-aa94-083f0daa8eba",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "[Soirée luge, Frankreichs längste Schlitten-Abfahrt:] „Oben angekommen ziehen wir den bereitgestellten Sturzhelm mit Stirnlampe auf, setzen uns auf einen „toboggan“, einen Plastik-Schalenschlitten also, stecken die Fußspitzen in Stütz-Schlaufen und – lassen es laufen.“"
                            },
                            {
                                "example_id": "8faed669-f9af-4bd8-9d01-854abe71709d",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„In voller Montur mit Sturzhelm und Skibrille stiefeln die beiden in Richtung Piste.“"
                            },
                            {
                                "example_id": "5916e2b2-9017-4b28-99a0-1f91052a3791",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„50 Sekunden sitzt Lauda in den Flammen, atmet giftige Gase ein, »der Aufprall war so hart, dass es mir den Sturzhelm heruntergerissen hat«, sagte er dem „SZ-Magazin“ vor sechs Jahren.“"
                            },
                            {
                                "example_id": "975d8ae8-0a87-47e3-8dfd-d6fca02e8353",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„Jockeys schützen zwar Sturzhelm und eine wattierte Weste, dennoch wirken bei einem Sturz auf den Körper enorme Kräfte.“"
                            },
                            {
                                "example_id": "7a6e55f8-b829-46aa-89e7-a98b81d28d73",
                                "sense_id": "0b6d98a1-84bc-3b53-82f3-7a8e47131a43",
                                "text": "„Alles, was die Reiter tragen, inklusive Sattel und Sturzhelm, wiegt 1,2 Kilo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
