                ],
                "senses": [
                    {
                        "sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                        "entry_id": "986b2d9c-8d58-3a5f-a6f1-63ee0464abfe",
                        "glosses": [
                            "Tropfkante am Dach eines Gebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec513daa-4747-48ad-958f-a00c64b348fd",
                                "sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                                "text": "„Das klatscht gegen die Fensterscheiben, das gießt aus der Dachtraufe, Gras und Blumen beugen sich nieder unter dem Platzregen.“"
                            },
                            {
                                "example_id": "8f5d348c-7b09-4f8c-a175-fd70529e4d60",
                                "sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                                "text": "„Der Mann habe auf Höhe der Dachtraufe gearbeitet und sei zwischen Gerüst und Hauswand gestürzt, teilte das Polizeipräsidium am Freitag mit.“"
                            },
                            {
                                "example_id": "93ee6a0e-1ec3-4b90-b2c2-b16550bf3856",
                                "sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                                "text": "„Mit mächtigem Krach bricht ein Teil der Dachtraufe nieder, und das Wasser schießt vor unserem Fenster herunter wie ein grauer Glaswall.“"
                            },
                            {
                                "example_id": "9706eab0-0fd3-418c-b211-14a5d4bb44e2",
                                "sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                                "text": "„Die Strohdächer der Häuser waren so niedrig, daß man im Vorbeimarschieren mit der Schulter die Dachtraufen streifte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "964e20d9-c7f4-4bf6-b5a2-4275a3f4085c",
                        "source_entry_id": "986b2d9c-8d58-3a5f-a6f1-63ee0464abfe",
                        "source_sense_id": "581a4ba7-70e4-3ac8-a18f-06fef72a0edb",
                        "source_sense_description": "Tropfkante am Dach eines Gebäudes",
                        "target_lang_word": "eaves",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eaves",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "The underside of a roof that extends beyond the external walls of a building."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c395de3c-d797-4e01-a277-6819fd921660",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Him that you term'd Sir, the good old Lord Gonzallo, / His teares runs downe his beard like winters drops / From eaues of reeds: […]"
                                            },
                                            {
                                                "example_id": "23d479e1-fa86-4cfc-9acc-2f256d89c89f",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "Thus night oft ſee me in thy pale career, / Till civil-ſuited morn appeer, / […] / Or uſher'd with a ſhower ſtill, / When the guſt hath blown his fill, / Ending on the ruſsling Leaves, / With minute drops from off the Eaves."
                                            },
                                            {
                                                "example_id": "e0f63a99-e467-4ffa-8371-f0aa511617c0",
                                                "sense_id": "fc6115bc-d71b-3c4d-91d1-3780d63bc208",
                                                "text": "By my window bowered round with leaves, / And down my cheeks the quick tears ran / Like twinkling rain-drops from the eaves, / When warm spring showers are passing o'er: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                        "entry_id": "ab7b6d70-d59f-3565-b9c3-e6b87b5499b4",
                                        "glosses": [
                                            "Something that extends over or projects beyond."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe62c57b-0624-47e8-98dc-9d35a81c2ba7",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "But after many strains and heaves / He got up to the Saddle eaves."
                                            },
                                            {
                                                "example_id": "4648dd4e-fb97-439c-a218-5154273ad044",
                                                "sense_id": "862bbbf9-051d-3012-a351-f26fcc9ccfd3",
                                                "text": "The mystic glory swims away; / From off my bed the moonlight dies; / And closing eaves of wearied eyes / I sleep till dusk is dipt in gray: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
