                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9b40520-da33-36d5-a685-b57fb64f3f78",
                                        "entry_id": "f918f898-ad87-32a4-b705-16e6058ce7e5",
                                        "glosses": [
                                            "weibliche Person, die einem anderen Hilfe leistet, ihn oder etwas rettet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "473f0f63-35d8-4b90-845b-bbe4eff00b3a",
                                                "sense_id": "f9b40520-da33-36d5-a685-b57fb64f3f78",
                                                "text": "„Sie liebte das Gefühl, die Retterin des Buchs zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe70d2e6-18a2-4ad4-b387-5b1fde61c951",
                        "source_entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "source_sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
                        "target_lang_word": "Helferin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Helferin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fac6410e-9adb-354b-bdf9-34191296806a",
                                        "entry_id": "8ab53df3-d01b-3f56-b133-60513a289228",
                                        "glosses": [
                                            "weibliche Person, die jemandem hilft oder ihn unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c911aef-bbe8-4f82-b478-d8d1beb6df26",
                                                "sense_id": "fac6410e-9adb-354b-bdf9-34191296806a",
                                                "text": "„Diese Ummantelung könnte der Wunsch nach einem Gespräch mit dem Pfarrer ebenso sein wie das Begleitet werden durch eine freiwillige Helferin sein.“"
                                            },
                                            {
                                                "example_id": "4b98694b-ddd5-4ffe-8935-4cf6993742e6",
                                                "sense_id": "fac6410e-9adb-354b-bdf9-34191296806a",
                                                "text": "„Eine Helferin im Arbeitskreis Asyl beschreibt ihn als freundlichen, gebildeten jungen Mann.“"
                                            },
                                            {
                                                "example_id": "dcd2e0a6-00ed-4864-949c-6f8e92afce54",
                                                "sense_id": "fac6410e-9adb-354b-bdf9-34191296806a",
                                                "text": "„Selbst verheiratet, wird sie für die nächsten Monate Helferin im turbulenten Alltag.“"
                                            },
                                            {
                                                "example_id": "c854193e-7223-4ab9-88ab-df3ea33b6039",
                                                "sense_id": "fac6410e-9adb-354b-bdf9-34191296806a",
                                                "text": "„Die meisten Frauen arbeiten als Helferinnen im Familienbetrieb, in der Landwirtschaft und im Haus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bbdfd1a1-aaf6-4248-9b7f-04c26615edcc",
                        "source_entry_id": "cec223da-611e-3a58-96bf-f9d029c2ee1c",
                        "source_sense_id": "2c5b242d-34c2-39c3-a11e-7125babb0bc3",
