                        "glosses": [
                            "S’octroyer à soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c6ec576-0541-4989-96dc-4f219a778321",
                                "sense_id": "7dbfcdde-35da-3803-93f9-dcfede9d827e",
                                "text": "Sans retracer tout l'historique de cette affaire, rappelons que le comité villageois de la N931 a lancé, devant le Conseil d'Etat, une demande de suspension et d'annulation du permis de bâtir que le ministre Lebrun s'était autooctroyé le dernier jour de son mandat."
                            },
                            {
                                "example_id": "8a8c72d6-b368-43b4-9b50-8a91825be1e6",
                                "sense_id": "7dbfcdde-35da-3803-93f9-dcfede9d827e",
                                "text": "Un pur parasitisme et un pur privilège autooctroyé."
                            },
                            {
                                "example_id": "8215a08f-95d3-4eee-871f-77f58a911ab3",
                                "sense_id": "7dbfcdde-35da-3803-93f9-dcfede9d827e",
                                "text": "Comme lui-même s’était autooctroyé, en 2007, la somme astronomique de 20 millions de livres, soit par mois ce qu’une centaine de personnes gagnent par an, il avait quelques raisons d’exorciser le diable collectiviste."
                            }
                        ]
                    }
