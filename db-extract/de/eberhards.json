                ],
                "senses": [
                    {
                        "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                        "entry_id": "f2c72257-5cbb-3fab-bf98-fe2c501c4c5b",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bd5c526-a74a-4d0c-8b99-4671f932ded7",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Eberhards kamen, sahen und siegten."
                            },
                            {
                                "example_id": "bb16bed8-dabb-4ecd-9149-dbf1b0eafb82",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eberhards kommt, geht der Herr Eberhards.“"
                            },
                            {
                                "example_id": "3c03816a-b1f5-4d6c-a3ff-bbdd6f89cac8",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Eberhards kommt und geht."
                            },
                            {
                                "example_id": "140916bd-6008-421a-b43f-b45a95c6008c",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Frau Eberhards ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "3b7584fa-0511-4fd6-afa3-ef6fd5e0b334",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Herr Eberhards wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1f73baa5-89e2-472e-82a2-dbcf2c78b14c",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Die Eberhardsens kommen heute aus dem Thüringer Wald."
                            },
                            {
                                "example_id": "f90f66a6-6853-468c-9cb6-8eaef405619e",
                                "sense_id": "48ec2583-18f9-3317-9855-5d02871ce1b4",
                                "text": "Der Eberhards trägt nie die Schals, die die Eberhards ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
