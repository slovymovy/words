                ],
                "senses": [
                    {
                        "sense_id": "0ac72651-71bd-339d-bff2-69313f6e5006",
                        "entry_id": "b5e58fcc-e105-35eb-9199-f187a9e781d8",
                        "glosses": [
                            "находиться в состоянии истомы, расслабленности"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0e23db4a-ce67-3fd6-8225-6a4fcf5b32dc",
                        "entry_id": "b5e58fcc-e105-35eb-9199-f187a9e781d8",
                        "glosses": [
                            "переживать состояние восторга, наслаждения под влиянием сильного чувства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3c8474-89e5-469f-a8f4-857f848ac4cb",
                                "sense_id": "0e23db4a-ce67-3fd6-8225-6a4fcf5b32dc",
                                "text": "Она и гордилась им, и умилялась перед ним и перед собой и своей любовью, и вся млела и таяла от любви к нему."
                            }
                        ]
                    },
                    {
                        "sense_id": "83c75105-314b-314e-b99b-ced114ca6280",
                        "entry_id": "b5e58fcc-e105-35eb-9199-f187a9e781d8",
                        "glosses": [
                            "замирать, цепенеть от сильного потрясения, волнения и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acad84d7-c077-4b3b-acae-b8ed58de779c",
                                "sense_id": "83c75105-314b-314e-b99b-ced114ca6280",
                                "text": "Тина, увидав во мне официальное лицо, совсем забыла наши прежние отношения и, говоря со мной, дрожала и млела от страха, как высеченная девочка."
                            }
                        ]
                    },
                    {
                        "sense_id": "5555df17-af0f-3626-8292-c3db1685dffb",
                        "entry_id": "b5e58fcc-e105-35eb-9199-f187a9e781d8",
                        "glosses": [
                            "разг. (о частях тела) терять чувствительность, цепенеть"
                        ],
                        "tags": [],
                        "examples": []
                    }
