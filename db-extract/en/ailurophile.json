{
    "word": "ailurophile",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "40957673-4dbb-3a06-8398-a3ff5c155a9f",
                "word": "ailurophile",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1bbfba2-33f0-4923-8932-7dbdca3fa14f",
                        "entry_id": "40957673-4dbb-3a06-8398-a3ff5c155a9f",
                        "tags": [
                            "plural"
                        ],
                        "form": "ailurophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                        "entry_id": "40957673-4dbb-3a06-8398-a3ff5c155a9f",
                        "glosses": [
                            "A person with ailurophilia; a cat-lover."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42815062-0e49-4316-a987-9fd40b1fd45e",
                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                "text": "He played the piano well, was an enthusiastic ailurophile, and persistently played solitaire while talking and writing."
                            },
                            {
                                "example_id": "94c1ed4b-72d1-42cf-855a-cba53f75b9fb",
                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                "text": "When the archbishop would send Philip on an assignment, he would leave the cat in the care of the archbishop, who apparently was not an ailurophile."
                            },
                            {
                                "example_id": "f0fa9d50-2973-4f7a-a083-c1cbd5e25cb4",
                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                "text": "Alicia is not a serious ailurophile, however; she neglects Chestnut, and Chestnut knows it."
                            },
                            {
                                "example_id": "ade073bf-e00a-4e4c-8516-8e91c496e861",
                                "sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                                "text": "Your identity as an ailurophile (cat lover) is confirmed by cat hair on your clothes, but that is a distinction that most of us will gladly forfeit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dd63e8f-c11a-4540-897b-afadd863e55e",
                        "source_entry_id": "40957673-4dbb-3a06-8398-a3ff5c155a9f",
                        "source_sense_id": "e025a5df-88b8-382b-9d03-7a8889026557",
                        "source_sense_description": "cat-lover",
                        "target_lang_word": "ailurophile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailurophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bba6165c-5162-3648-aa53-b8afa46fb82e",
                                        "entry_id": "e39476fd-192f-3c34-8254-a7cefb62e09b",
                                        "glosses": [
                                            "Relatif à l’amour des chats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7acf477c-7081-469a-9a3d-1c806c979ffd",
                                                "sense_id": "bba6165c-5162-3648-aa53-b8afa46fb82e",
                                                "text": "J’ai exactement le même sentiment que toi Annick, et certains textes trouvés au hasard de mes modestes recherches ailurophiles, font particulièrement écho. — (site lesboisdeprincay.blogspot.com)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ailurophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4211c9e6-ad43-374e-bc23-3e329c0cb4a8",
                                        "entry_id": "9fa50bb6-0d6d-38c5-bdd5-ad0be26902cf",
                                        "glosses": [
                                            "Personne qui aime les chats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70495af8-4c2b-4e56-a4ab-1396aee74bc2",
                                                "sense_id": "4211c9e6-ad43-374e-bc23-3e329c0cb4a8",
                                                "text": "Ernest Hemingway était ce que nous pourrions appeler un « ailurophile » (ceux qui aiment les chats) comme beaucoup d’auteurs, notamment Colette l’était aussi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
