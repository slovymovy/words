{
    "word_family": [
        "moe",
        "moeheid",
        "vermoeid",
        "vermoeidheid",
        "vermoeien"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0adb0a21-a960-35fc-b3ea-e6eec27312ae",
                    "sense_definition": "Een toestand van vermoeidheid waarbij men behoefte heeft aan rust of slaap; een alternatieve vorm van <w>moe</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vermoeidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de lange wandeling door de duinen voelde hij zich dood <w>moede</w>.",
                            "target_lang_translations": {
                                "en": "After the long walk through the dunes, he felt dead <w>tired</w>."
                            }
                        },
                        {
                            "text": "De reiziger was <w>moede</w> van de lange tocht en zocht een plek om te slapen.",
                            "target_lang_translations": {
                                "en": "The traveler was <w>weary</w> from the long journey and sought a place to sleep."
                            }
                        }
                    ],
                    "synonyms": [
                        "moe",
                        "vermoeid",
                        "afgemat"
                    ],
                    "antonyms": [
                        "fit",
                        "uitgerust",
                        "wakker"
                    ],
                    "common_phrases": [
                        "moede van de strijd",
                        "dood moede"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt vaker in literatuur of oudere teksten gebruikt dan in het dagelijks leven."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A state of fatigue where one needs rest or sleep; an alternative or literary form of 'moe' (tired)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tired",
                                "target_lang_sense_clarification": "needing rest"
                            },
                            {
                                "target_lang_word": "weary",
                                "target_lang_sense_clarification": "physically or mentally exhausted, often literary"
                            },
                            {
                                "target_lang_word": "fatigued",
                                "target_lang_sense_clarification": "very tired"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffbf651a-fd73-360a-b43d-b1dd767c1713",
                    "sense_definition": "De verbogen vorm van het bijvoeglijk naamwoord <w>moe</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammaticale_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>moede</w> strijders keerden eindelijk terug naar hun eigen land.",
                            "target_lang_translations": {
                                "en": "The <w>weary</w> warriors finally returned to their own country."
                            }
                        },
                        {
                            "text": "Zij legde haar <w>moede</w> hoofd op het zachte kussen.",
                            "target_lang_translations": {
                                "en": "She laid her <w>tired</w> head on the soft pillow."
                            }
                        }
                    ],
                    "synonyms": [
                        "vermoeide"
                    ],
                    "common_phrases": [
                        "moede ogen",
                        "moede benen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Attributieve vorm van moe"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The inflected (attributive) form of the adjective 'moe', used before a noun."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tired",
                                "target_lang_sense_clarification": "used before a noun"
                            },
                            {
                                "target_lang_word": "weary",
                                "target_lang_sense_clarification": "literary, used before a noun"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6a8a3aa-4568-3597-8fd6-c1ee90768fd4",
                    "sense_definition": "Een verouderde naamvalsform (datief) van het zelfstandig naamwoord <w>moed</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammaticale_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude tekst stond geschreven dat men te goeder <w>moede</w> voorwaarts moest gaan.",
                            "target_lang_translations": {
                                "en": "In the old text it was written that one should go forward in good <w>spirits</w>."
                            }
                        },
                        {
                            "text": "Zij gingen vol goede <w>moede</w> aan de slag met het nieuwe project.",
                            "target_lang_translations": {
                                "en": "They started work on the new project full of good <w>cheer</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "te goeder moede",
                        "vol goede moede"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Alleen nog gebruikelijk in vaste uitdrukkingen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An archaic dative case form of the noun 'moed' (courage/spirit), now only found in fixed expressions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spirit",
                                "target_lang_sense_clarification": "in the context of mood or courage"
                            },
                            {
                                "target_lang_word": "heart",
                                "target_lang_sense_clarification": "as in 'to be of good heart'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}