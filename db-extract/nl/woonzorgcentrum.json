                "senses": [
                    {
                        "sense_id": "72382ea3-bd52-375f-b194-27282afc9abb",
                        "entry_id": "357e3802-acd0-3e76-bde5-49ae7c7ecb6e",
                        "glosses": [
                            "plaats waar ouderen zowel huisvesting als zorg wordt geboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d359d48-562f-46fb-a0ca-86865ee59f72",
                                "sense_id": "72382ea3-bd52-375f-b194-27282afc9abb",
                                "text": "Een woonzorgcentrum is een voorziening die bestaat uit een of meer gebouwen die functioneel een geheel vormen en waar, onder welke benaming ook, aan gebruikers van 65 jaar of ouder, die er permanent verblijven, in een thuisvervangend milieu huisvesting en ouderenzorg wordt aangeboden."
                            }
                        ]
                    },
                    {
                        "sense_id": "885369d6-dfa7-3f0e-b2c6-da0fb7c08d1b",
                        "entry_id": "357e3802-acd0-3e76-bde5-49ae7c7ecb6e",
                        "glosses": [
                            "instelling die ouderen zowel huisvesting als zorg kan biedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1053cc-40b9-4a12-a6ed-45822954b035",
                                "sense_id": "885369d6-dfa7-3f0e-b2c6-da0fb7c08d1b",
                                "text": "Naast het belang van uitwisseling van expertise, komen vooral de concrete ervaringen aan bod, zeker daar waar het woonzorgcentrum tegen grenzen aanbotst."
                            }
                        ]
                    }
