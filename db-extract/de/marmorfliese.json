                "senses": [
                    {
                        "sense_id": "7a91bab8-0dba-3514-8dab-3fa5c6eff8ba",
                        "entry_id": "22a294b3-ed02-3d99-a550-b7d851aad145",
                        "glosses": [
                            "Fliese aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4532831d-ff1a-47d7-99fa-33c3d8ae0181",
                                "sense_id": "7a91bab8-0dba-3514-8dab-3fa5c6eff8ba",
                                "text": "„Die Marmorfliesen im Andachtsraum der Kirche waren roströtlich gefärbt.“"
                            },
                            {
                                "example_id": "bcfd97eb-f701-4f92-9f1a-3c45eb873a64",
                                "sense_id": "7a91bab8-0dba-3514-8dab-3fa5c6eff8ba",
                                "text": "„Im Umkleideraum zog er sich um, ging über die Marmorfliesen des Flurs zum Pool, sprang hinein und begann, seine Bahnen zu ziehen.“"
                            },
                            {
                                "example_id": "28d27823-e33c-43bd-8e84-abb7f5521a1e",
                                "sense_id": "7a91bab8-0dba-3514-8dab-3fa5c6eff8ba",
                                "text": "„Ein paar Minuten lang starrte er mit dessen Kollegen die schwarz-weiß gemusterten Marmorfliesen an, bis der Minister über die lange Treppe nach unten kam.“"
                            },
                            {
                                "example_id": "817ac318-8cdd-4e2e-84b0-1fe33e8a746f",
                                "sense_id": "7a91bab8-0dba-3514-8dab-3fa5c6eff8ba",
                                "text": "„Die Angeln seufzen leise, und gedämpfte Schritte tappen über die Marmorfliesen des Vorraums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
