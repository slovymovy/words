                    }
                ],
                "senses": [
                    {
                        "sense_id": "da605d19-4a6e-31de-b6d8-67723874374c",
                        "entry_id": "219f78ca-f090-39df-ad80-7ce669e7da4b",
                        "glosses": [
                            "A minor offence, petty crime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1616417b-790b-4e06-8b9d-954e38cc8005",
                                "sense_id": "da605d19-4a6e-31de-b6d8-67723874374c",
                                "text": "Even stealing a pack of gum is an infraction in the eyes of the law."
                            },
                            {
                                "example_id": "d6000d4c-8203-41d0-b1e6-adbcae912418",
                                "sense_id": "da605d19-4a6e-31de-b6d8-67723874374c",
                                "text": "Pretending a litterbug and a spree killer have committed equivalent infractions doesn’t make people safer."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac2507d6-f571-3dd9-b28d-c3603d8ff608",
                        "entry_id": "219f78ca-f090-39df-ad80-7ce669e7da4b",
                        "glosses": [
                            "A violation; breach."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f8cb25-a806-4b29-bf71-b7f9944e8fe8",
                                "sense_id": "ac2507d6-f571-3dd9-b28d-c3603d8ff608",
                                "text": "A team's first infraction could mean a fine of up to $25,000."
                            }
                        ]
                    },
                    {
                        "sense_id": "03152bde-c25e-3c82-a815-de810ec6be92",
                        "entry_id": "219f78ca-f090-39df-ad80-7ce669e7da4b",
                        "glosses": [
                            "A major violation of rules which leads to a penalty, if detected by the referee."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
