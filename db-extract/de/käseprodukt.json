                "senses": [
                    {
                        "sense_id": "83534aa3-5834-35e3-b423-faa007927f5d",
                        "entry_id": "e3738ed5-8d7b-3d7f-a5bd-d4e120519c26",
                        "glosses": [
                            "Nahrungsmittel, das aus Käse hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd2531e-3fde-424c-9e76-7d4206d760d6",
                                "sense_id": "83534aa3-5834-35e3-b423-faa007927f5d",
                                "text": "„Da war Stan, der Milchbauer, der für seine Käseprodukte weit über die Grenze des Dorfes hinaus bekannt war.“"
                            },
                            {
                                "example_id": "d9b01583-7f6d-4229-9e20-0d758ef5267e",
                                "sense_id": "83534aa3-5834-35e3-b423-faa007927f5d",
                                "text": "„Zu empfehlende proteinreiche Nahrungsmittel sind zum Beispiel Milch- und Käseprodukte, aber auch Erbsen, Bohnen und Linsen.“"
                            },
                            {
                                "example_id": "341fa894-fa48-4627-bbf7-5f4f0385e081",
                                "sense_id": "83534aa3-5834-35e3-b423-faa007927f5d",
                                "text": "„Milchprodukte waren im Lebensmittelgeschäft noch genug vorhanden sowie Wurstprodukte und Käseprodukte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
