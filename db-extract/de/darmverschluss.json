                        ]
                    },
                    {
                        "translation_id": "eccd91b2-4040-4837-b20d-aa07ddfe473d",
                        "source_entry_id": "2f57a4a4-c57a-3c94-a08b-b893f05022bb",
                        "source_sense_id": "56263b61-f1b5-3d60-8d01-ecc78e783368",
                        "source_sense_description": "lebensbedrohliche Unterbrechung der Darmpassage, die oft einer chirurgischen Intervention bedarf",
                        "target_lang_word": "bowel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bowel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c1a7dd0-dd93-3fa1-980e-54d7a1e278f8",
                                        "entry_id": "b3afa18a-3ee6-32a4-a516-00d0fe5e7431",
                                        "glosses": [
                                            "A part or division of the intestines, usually the large intestine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7d708dce-3969-36cf-8d29-6443e054b6a5",
                                        "entry_id": "b3afa18a-3ee6-32a4-a516-00d0fe5e7431",
                                        "glosses": [
                                            "The entrails or intestines; the internal organs of the stomach."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b2deaba-5c22-451d-8d72-2727589e5b10",
                                                "sense_id": "7d708dce-3969-36cf-8d29-6443e054b6a5",
                                                "text": "And when he was hanged, brast asondre in the myddes, and all his bowels gusshed out."
                                            },
                                            {
                                                "example_id": "1eaef2c5-154e-40d8-8662-f2e6f355319d",
                                                "sense_id": "7d708dce-3969-36cf-8d29-6443e054b6a5",
                                                "text": "Leaue words & let them feele your lances pointes,\nUUhich glided through the bowels of the Greekes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc45078b-42ab-3e50-9738-10fe1d6eec6c",
                                        "entry_id": "b3afa18a-3ee6-32a4-a516-00d0fe5e7431",
                                        "glosses": [
                                            "The (deep) interior of something."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb56e640-8556-4d53-aecb-8f19f8564637",
                                                "sense_id": "dc45078b-42ab-3e50-9738-10fe1d6eec6c",
                                                "text": "The treasures were stored in the bowels of the ship."
                                            },
                                            {
                                                "example_id": "96998c13-12c4-487d-830f-f8c49aa30441",
                                                "sense_id": "dc45078b-42ab-3e50-9738-10fe1d6eec6c",
                                                "text": "His soldiers […] cried out amain, / And rushed into the bowels of the battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28f0872a-8160-3e8e-8147-0a3e8bb241bc",
                                        "entry_id": "b3afa18a-3ee6-32a4-a516-00d0fe5e7431",
                                        "glosses": [
                                            "The seat of pity or the gentler emotions; pity or mercy."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "281b64dc-f440-407a-a3af-b777f41e1680",
                                                "sense_id": "28f0872a-8160-3e8e-8147-0a3e8bb241bc",
                                                "text": "Thou thing of no bowels, thou!"
                                            },
                                            {
                                                "example_id": "3659c3d4-adf4-4e5b-be32-a7d2e36f448c",
                                                "sense_id": "28f0872a-8160-3e8e-8147-0a3e8bb241bc",
                                                "text": "Bloody Bonner, that corpulent tyrant, full (as one said) of guts, and empty of bowels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c387cca-3d8c-3539-9acf-dda79ed98455",
                                        "entry_id": "b3afa18a-3ee6-32a4-a516-00d0fe5e7431",
                                        "glosses": [
                                            "offspring"
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d67c1457-0934-41d2-9c85-5d22c3b25b1b",
                                                "sense_id": "2c387cca-3d8c-3539-9acf-dda79ed98455",
                                                "text": "Friend hast thou none, / For thine own bowels, which do call thee sire,"
                                            }
                                        ]
                                    }
                                ]
                            },
