                ],
                "translations": [
                    {
                        "translation_id": "78c0ee37-bd13-42c4-b6d9-e1c5b84bac7d",
                        "source_entry_id": "63c9fcce-6737-3997-91dd-ea4fee913a1e",
                        "source_sense_id": "3d9c16ed-1bea-3670-9281-1fe762ddd355",
                        "target_lang_word": "area",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "area",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89dc3c40-515f-3a70-a00d-ad38bacab4c5",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "A measure of the extent of a surface; it is measured in square units."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c03ad4-ed22-4c15-8dee-e868431793bc",
                                                "sense_id": "89dc3c40-515f-3a70-a00d-ad38bacab4c5",
                                                "text": "It is about 4.5 million square kilometers in area and holds the world’s third largest collection of ice after Antarctica and Greenland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d194755c-700c-3a26-a434-462d95182b57",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "A particular geographic region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65efa17d-8d8c-4539-9add-dec7a4448e8d",
                                                "sense_id": "d194755c-700c-3a26-a434-462d95182b57",
                                                "text": "Eggimann used a computer algorithm to analyze data from the open-source geographic database OpenStreetMap and automatically detect areas with the superblock potential. He applied this analysis to 5 km x 5 km areas of the city center in 18 different cities around the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653e590d-0b5c-3e9f-a4fb-0f7866644ef9",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "Any particular extent of surface, especially an empty or unused extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8fadb57-f62e-4371-aa90-47467c411f96",
                                                "sense_id": "653e590d-0b5c-3e9f-a4fb-0f7866644ef9",
                                                "text": "The photo is a little dark in that area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fc5000-8d12-320f-a749-9c04d2b322dc",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "The extent, scope, or range of an object or concept."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a92b604e-af6f-4265-9c29-033ede43cddf",
                                                "sense_id": "30fc5000-8d12-320f-a749-9c04d2b322dc",
                                                "text": "The plans are a bit vague in that area."
                                            },
                                            {
                                                "example_id": "acd04b26-861f-49e7-814e-f265cc7005ad",
                                                "sense_id": "30fc5000-8d12-320f-a749-9c04d2b322dc",
                                                "text": "Today, a new area of research that similarly aims to mimic a complex biological phenomenon—life itself—is taking off. Synthetic biology, a seductive experimental subfield in the life sciences, seems tantalizingly to promise custom-designed life created in the laboratory."
                                            },
                                            {
                                                "example_id": "99a93234-3efc-479f-b18d-ad2f492b2d7b",
                                                "sense_id": "30fc5000-8d12-320f-a749-9c04d2b322dc",
                                                "text": "The Green-Tao theorem on primes was a similar collaboration. Green is a specialist in an area called number theory, and Tao originally trained in an area called harmonic analysis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "431b1991-6bac-38fb-b5f2-134872cb12f9",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "An open space, below ground level, giving access to the basement of a house, and typically separated from the pavement by railings."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230a6176-e17e-4835-9afa-bc16bc53e98f",
                                                "sense_id": "431b1991-6bac-38fb-b5f2-134872cb12f9",
                                                "text": "A boy seized it, whom she bribed with a shilling to relinquish his prize, which she was taking home, when it escaped from her hand, and fell down the area of a house."
                                            },
                                            {
                                                "example_id": "cab04946-14bf-46d8-ae9c-774ffe81deca",
                                                "sense_id": "431b1991-6bac-38fb-b5f2-134872cb12f9",
                                                "text": "This was so favourably received by the milkman and beadle that he would immediately have been pushed into the area if I had not held his pinafore while Richard and Mr. Guppy ran down through the kitchen to catch him when he should be released."
                                            },
                                            {
                                                "example_id": "d30af9f1-a487-4ac2-8c64-972a070a6c3b",
                                                "sense_id": "431b1991-6bac-38fb-b5f2-134872cb12f9",
                                                "text": "He crept down the back stairs; but as he could not quite condescend to escape through the area, he was forced to emerge upon the hall, and here his aunt pounced upon him, coming out of the breakfast-parlour."
                                            },
                                            {
                                                "example_id": "67d0509f-7f04-4049-97a2-a1a1337b1d11",
                                                "sense_id": "431b1991-6bac-38fb-b5f2-134872cb12f9",
                                                "text": "A minute later we were both in the area. Hardly had we reached the dark shadows before the step of the policeman was heard in the fog above. As its soft rhythm died away, Holmes set to work upon the lower door. I saw him stoop and strain until with a sharp crash it flew open. We sprang through into the dark passage, closing the area door behind us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79249efc-6c86-39ab-af7c-22bc5dcc9e22",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "Penalty box; penalty area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2c42f29-f16a-4c02-83a5-8b27dc5e397e",
                                                "sense_id": "79249efc-6c86-39ab-af7c-22bc5dcc9e22",
                                                "text": "Bendtner's goal-bound shot was well saved by goalkeeper Ali Al Habsi but fell to Arsahvin on the edge of the area and the Russian swivelled, shaped his body and angled a sumptuous volley into the corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d320be96-f344-326b-b4bd-6cb907e88a70",
                                        "entry_id": "ff93554f-4100-39d0-8aba-b4f003e085d5",
                                        "glosses": [
                                            "Genitals."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9a6926c-030d-44d2-8078-17c83f8c6c3f",
                                                "sense_id": "d320be96-f344-326b-b4bd-6cb907e88a70",
                                                "text": "But what do I do when the third one runs at me with his bike helmet on? I got no more hands to protect my area!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
