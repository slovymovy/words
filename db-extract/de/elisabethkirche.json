                "senses": [
                    {
                        "sense_id": "a5f5e35c-b848-3d72-902c-8105a2bc9386",
                        "entry_id": "af744600-5da4-38d9-9768-8ee3d5fce3a1",
                        "glosses": [
                            "Gotteshaus zu Ehren eines der Heiligen namens Elisabeth, meistens der Elisabeth von Thüringen oder Ungarn ^(→ WP), das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b267c0ed-9e97-48e7-9a9e-f673b6cb433d",
                                "sense_id": "a5f5e35c-b848-3d72-902c-8105a2bc9386",
                                "text": "„Der Ring bildet ein städtebauliches Ensemble mit den beiden diagonal anschließenden Plätzen – Salzring und Kirchenplatz bei der Elisabethkirche.“"
                            },
                            {
                                "example_id": "56fbe7f1-242d-49ab-964d-ff15b1e1993f",
                                "sense_id": "a5f5e35c-b848-3d72-902c-8105a2bc9386",
                                "text": "„Die Elisabethkirche ist die älteste gotische Hallenkirche Deutschlands.“"
                            },
                            {
                                "example_id": "6b8eba78-4d3d-43bf-bb82-4be60ef906e3",
                                "sense_id": "a5f5e35c-b848-3d72-902c-8105a2bc9386",
                                "text": "„Die ungarische Königin ist die Namenspatronin aller europäischen Elisabethkirchen und wurde in der Elisabethkirche in Marburg beigesetzt.“"
                            },
                            {
                                "example_id": "e2425da8-6b3a-4886-81bf-bf52f34b069f",
                                "sense_id": "a5f5e35c-b848-3d72-902c-8105a2bc9386",
                                "text": "„Wie viele Elisabethkirchen es auf der Welt gibt, weiß man beim Marburger Verkehrsverein nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
