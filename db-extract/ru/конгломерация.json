                                        "entry_id": "5e8cdd0c-fe31-3921-bbad-6e3837b21f69",
                                        "glosses": [
                                            "That which consists of many previously separate parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0a96344-dc3a-4278-bd37-4050db5e9bee",
                                                "sense_id": "bf9a7752-154d-3726-b1ed-b54e3503eba7",
                                                "text": "The green-purple conglomeration behaves nearly like a monospecific culture with characteristics halfway between those of the green and the purple, though metamorphosing more slowly than either[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe4f799d-d231-3579-ac31-c53dd97d17d2",
                                        "entry_id": "5e8cdd0c-fe31-3921-bbad-6e3837b21f69",
                                        "glosses": [
                                            "An instance of conglomerating, a coming together of separate parts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6297e3d-0114-4ce1-8efe-b4911965d07a",
                                                "sense_id": "fe4f799d-d231-3579-ac31-c53dd97d17d2",
                                                "text": "A sallow prisoner has come up, in custody, for the half-dozenth time to make a personal application \"to purge himself of his contempt,\" which, being a solitary surviving executor who has fallen into a state of conglomeration about accounts of which it is not pretended that he had ever any knowledge, he is not at all likely ever to do."
                                            }
                                        ]
                                    }
                                ]
                            }
