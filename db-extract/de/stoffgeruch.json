                ],
                "senses": [
                    {
                        "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                        "entry_id": "39534cd7-ad60-34be-a499-f1dcb2a58ec4",
                        "glosses": [
                            "Geruch von Textilien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b13f4bd4-e231-4b40-9495-7fdf190a666a",
                                "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                                "text": "„Statt einem stickigen Innenraum, Leder- oder Stoffgeruch, erwartet den Fahrer in einem Cabriolet frische Luft, Sonne und garantiert neidische Blicke der Fußgänger.“"
                            },
                            {
                                "example_id": "ea6327dd-4609-4836-bd40-1145127dba63",
                                "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                                "text": "In die Polster des Autos gelehnt, nahm Friedrich den Stoffgeruch wahr, die Reden der Mitfahrer, denen er sich nicht zugehörig fühlte."
                            },
                            {
                                "example_id": "2353b3ef-9f13-41fc-ad2d-fb305947465b",
                                "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                                "text": "Diese Kackfarbe des Hemdes veranlasste mich, meine Nase daran zu halten, doch ich erschnüffelte nur den Stoffgeruch dieses Textils."
                            },
                            {
                                "example_id": "d078007c-7eae-472a-9757-a4f3ba47e72c",
                                "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                                "text": "Auch er saß jetzt an die Wand gelehnt, sie sog den Stoffgeruch seines Hemdes ein und spürte die steife Oberfläche an ihrem."
                            },
                            {
                                "example_id": "a3efae49-db25-4775-96aa-2e9921a6cc61",
                                "sense_id": "255faa2e-b27e-3f2d-9b37-cee65d6d9dbb",
                                "text": "Die Västerlanggata mit ihren Kleidergeschäften, durch die man wie durch eine lange Garderobe wanderte und wo der Stoffgeruch durch alle Türen und Ritzen drang."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
