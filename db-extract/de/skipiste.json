                ],
                "senses": [
                    {
                        "sense_id": "d6616f26-7f74-3717-96e5-25a69dcc1a4c",
                        "entry_id": "d276ff1d-c850-3f00-8c91-59b2af719b58",
                        "glosses": [
                            "Teil von einem Berg, der für die Skiabfahrt freigegeben ist"
                        ],
                        "tags": [
                            "Wintersport"
                        ],
                        "examples": [
                            {
                                "example_id": "d4987997-c476-4b9c-9de4-fa61e18ae324",
                                "sense_id": "d6616f26-7f74-3717-96e5-25a69dcc1a4c",
                                "text": "„Durch Bearbeitung mit Großmaschinen in der Land- und Forstwirtschaft und bei der Planierung von Skipisten wird der Boden verfestigt; damit ist er, auch durch großflächige Monokulturen, leichter der Bodenerosion ausgesetzt.“"
                            },
                            {
                                "example_id": "0638aafd-cef1-421d-9b6d-0b5b31bf7eb7",
                                "sense_id": "d6616f26-7f74-3717-96e5-25a69dcc1a4c",
                                "text": "„Die meisten der tödlichen Lawinenunfälle verlaufen allerdings durch Leichtsinn oder Unachtsamkeit beim Skifahren (zum Beispiel Variantenfahren jenseits der markierten Skipisten) oder beim Skitourengehen.“"
                            },
                            {
                                "example_id": "f76b1b59-60f2-43af-a8f5-2c3686fea55d",
                                "sense_id": "d6616f26-7f74-3717-96e5-25a69dcc1a4c",
                                "text": "„Sie kommen schneller runter und fallen wie Vögel, seltsame Vögel, die viele Geheimnisse kennen, und nur tiefer Neuschnee bringt zusätzliche Gefahr für diejenigen, die gewalzte Skipisten brauchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
