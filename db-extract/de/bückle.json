                "senses": [
                    {
                        "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                        "entry_id": "7970effd-e611-337e-a519-f85865bba0d8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b3831da-a34d-4b74-bcf8-7d6cd369a9ce",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Frau Bückle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16bb6213-60cd-4fdc-9a6e-47a35dbe3047",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Herr Bückle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b9037933-345f-4163-851b-932b5b685d7e",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Die Bückles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "82f98d25-5712-43b4-af9e-e4f69de5148f",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Der Bückle trägt nie die Schals, die die Bückle ihm strickt."
                            },
                            {
                                "example_id": "cd7e588c-3c9a-4e89-a939-698a6600bab9",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bückle kommt, geht der Herr Bückle.“"
                            },
                            {
                                "example_id": "5dd98ac4-a239-4cde-8811-88c0e2e31dee",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Bückle kommt und geht."
                            },
                            {
                                "example_id": "63b4f429-d6db-4515-a50a-0275c7b445be",
                                "sense_id": "6bbc60e7-5f62-33a9-8ede-5aba2c54659a",
                                "text": "Bückles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
