                {
                    "sense_id": "5a51060e-9846-3577-8c05-0a8afebf0b63",
                    "sense_definition": "na gebruik of verloop van tijd nog aanwezig zijn",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "restant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er was nog maar één munt in de portemonnee <w>overgebleven</w> na het winkelen.",
                            "target_lang_translations": {
                                "en": "There was only one coin <w>left</w> in the wallet after shopping."
                            }
                        },
                        {
                            "text": "Hoeveel geld zal er aan het einde van de maand <w>overblijven</w> op onze rekening?",
                            "target_lang_translations": {
                                "en": "How much money will <w>remain</w> in our account at the end of the month?"
                            }
                        }
                    ],
                    "synonyms": [
                        "resteren"
                    ],
                    "antonyms": [
                        "opgaan",
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "geld overblijven",
                        "weinig overblijven"
                    ],
                    "target_lang_definitions": {
                        "en": "to be still present after use or the passage of time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "remain",
                                "target_lang_sense_clarification": "to be left over after others have gone or been used"
                            },
                            {
                                "target_lang_word": "be left",
                                "target_lang_sense_clarification": "to remain available or present"
                            },
                            {
                                "target_lang_word": "be left over",
                                "target_lang_sense_clarification": "specifically regarding food or materials remaining after use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b39e0fd4-a519-398a-b8af-8d2be5767714",
                    "sense_definition": "tijdens de middagpauze op school blijven om daar te eten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "school",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen de middag mocht Marcel op school <w>overblijven</w> met zijn vriendjes.",
                            "target_lang_translations": {
                                "en": "Marcel was allowed to <w>stay for lunch</w> at school with his friends during the break."
                            }
                        },
                        {
                            "text": "Omdat beide ouders werken, moeten de kinderen drie dagen per week <w>overblijven</w>.",
                            "target_lang_translations": {
                                "en": "Because both parents work, the children have to <w>stay at school</w> three days a week."
                            }
                        }
                    ],
                    "antonyms": [
                        "thuis eten"
                    ],
                    "common_phrases": [
                        "tussen de middag overblijven",
                        "op school overblijven"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk gebruikt in Nederland"
                        }
                    ],
                    "target_lang_definitions": {
