                    {
                        "sense_id": "1cca9da5-3ad4-3835-a35e-7dc421c9954b",
                        "entry_id": "478d8707-09ac-3592-869c-e2aa020f6cdc",
                        "glosses": [
                            "An inhabitant of the antipodes."
                        ],
                        "tags": [],
