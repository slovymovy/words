                "senses": [
                    {
                        "sense_id": "e9ce11f9-d294-3121-b440-2a4b9028e5c1",
                        "entry_id": "713c7f8e-0c39-3095-825a-d778720ff4a7",
                        "glosses": [
                            "Donner un caractère rappelant Walt Disney (ou les personnages qu'il a créés) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e3c37b-2986-4e95-8ce2-9839312c0e3d",
                                "sense_id": "e9ce11f9-d294-3121-b440-2a4b9028e5c1",
                                "text": "Star Wars VII: J.J.Abrams promet de ne pas «disney-iser» son film"
                            },
                            {
                                "example_id": "c4f18fb0-5042-4dab-8d66-18a06ee653c9",
                                "sense_id": "e9ce11f9-d294-3121-b440-2a4b9028e5c1",
                                "text": "L'œuvre originale est très peu connue du public, Don Hall peut donc disney-iser le tout à volonté, ne gardant finalement dans Les Nouveaux Héros que les grandes lignes du concept, ainsi que les personnages."
                            },
                            {
                                "example_id": "3863cb04-4462-42e0-a122-cb1d32fdc379",
                                "sense_id": "e9ce11f9-d294-3121-b440-2a4b9028e5c1",
                                "text": "Mais ils ne tenteront pas de la “Disney-iser”."
                            }
                        ]
                    }
