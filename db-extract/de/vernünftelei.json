                        "examples": [
                            {
                                "example_id": "73b97bc0-2327-4e43-a83c-1caeb50312cf",
                                "sense_id": "b71fbe0e-16a2-3e2d-97d1-8ca52bbac50f",
                                "text": "„Denn wie die Vernünfteleien Spaltung, und Schwanken erzeugen, so gewährt der Glaube Festigkeit und Standhaftigkeit.“"
                            },
                            {
                                "example_id": "b922d22f-89c6-4c27-9cc0-9d7cdccb5ecd",
                                "sense_id": "b71fbe0e-16a2-3e2d-97d1-8ca52bbac50f",
                                "text": "„Davor aber bitte ich Sie sehr, sich zu hüten, daß durch die Vernünftelei der Menschen der Glaube nicht hinweg simplifiziert werde […].“"
                            }
                        ],
