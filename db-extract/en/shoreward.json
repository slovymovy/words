                                "example_id": "44563ab7-d7ed-42d7-bf27-8643525ab8fd",
                                "sense_id": "cc8d1261-8914-3084-bcba-f717dcfd30ef",
                                "text": "If their enemies were really on the watch, if they had beleaguered the shoreward end of the pier, he and Lord Foxham were taken in a posture of poor defence […]"
                            },
                            {
                                "example_id": "4a030055-f295-4058-9949-d4a774d7f95b",
                                "sense_id": "cc8d1261-8914-3084-bcba-f717dcfd30ef",
                                "text": "Felixstowe's pier was cut short during the Second World War as an anti-invasion measure. Although its pierhead was subsequently demolished in the 1950s, a new £3 million shoreward building opened in August 2017."
                            }
                        ]
                    }
