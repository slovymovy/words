                "senses": [
                    {
                        "sense_id": "b0d945ee-5d14-3bf4-9ef1-bc90490e1e16",
                        "entry_id": "1cadebe2-4b97-31be-a3a5-f0c27d17be18",
                        "glosses": [
                            "Heiratsregel, die eine Eheschließung nur innerhalb einer bestimmten Gruppe erlaubt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710c3b0b-dd4e-41fa-bef7-e7c2a789c2b7",
                                "sense_id": "b0d945ee-5d14-3bf4-9ef1-bc90490e1e16",
                                "text": "„In den Zehn Geboten ist sie festgeschrieben, und immer hat eine strikte Endogamie sie aufrecht erhalten, hat seit der Vertreibung aus Palästina dafür gesorgt, dass die Diaspora nicht zu einer Zerstreuung der Juden im wörtlichen Sinne wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
