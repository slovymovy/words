                    },
                    {
                        "form_id": "5d783c0a-2684-4386-8fda-a718d7aba2a2",
                        "entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "déliquescentes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3794f6e0-bf79-34a1-bb0f-94e708f47223",
                        "entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "glosses": [
                            "Qui tombe ou peut tomber en déliquescence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4468905-007e-4b00-85ef-78a362304924",
                                "sense_id": "3794f6e0-bf79-34a1-bb0f-94e708f47223",
                                "text": "Sel déliquescent."
                            },
                            {
                                "example_id": "bb84b65d-a575-48ea-87cb-0529e5143ec4",
                                "sense_id": "3794f6e0-bf79-34a1-bb0f-94e708f47223",
                                "text": "La potasse est déliquescente"
                            },
                            {
                                "example_id": "f9a261a0-c9f5-48ed-b68b-bc551a597b29",
                                "sense_id": "3794f6e0-bf79-34a1-bb0f-94e708f47223",
                                "text": "Ces cristaux sont très solubles dans l’eau et dans l’alcool. Ils sont efflorescents dans l’air sec, déliquescents dans l’air humide."
                            }
                        ]
                    },
                    {
                        "sense_id": "db12295c-693c-31c4-b926-f3e525ebe887",
                        "entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "glosses": [
                            "Capacité de certains champignons à se liquéfier ou à se désintégrer en une substance visqueuse et noire au fur et à mesure de leur maturation ou de leur maturité sporelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821546ff-68de-4311-9ed4-cdadbddaa38f",
                                "sense_id": "db12295c-693c-31c4-b926-f3e525ebe887",
                                "text": "Comme tous les coprins, il est déliquescent : en vieillissant, les bords du chapeau se relèvent et les lames blanches ou rosées de son chapeau deviennent noires puis se liquéfient, d’où le nom “goutte d’encre”."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f28f063-016f-38bd-8e88-4768a7f92fd6",
                        "entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "glosses": [
                            "Qui est en pleine décadence, qui va s’affaiblissant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f3d30d23-94a7-400f-a62e-d007f8005985",
                                "sense_id": "0f28f063-016f-38bd-8e88-4768a7f92fd6",
                                "text": "Il y eut un saint qui était la symbolisation de la niaiserie, l'idéalisation de tout ce qu'il y a d'abject dans les superstitieux lobes des cervelles déliquescentes et dévotes."
                            },
                            {
                                "example_id": "77c1569c-9c21-48a5-a872-86e7618804a1",
                                "sense_id": "0f28f063-016f-38bd-8e88-4768a7f92fd6",
                                "text": "Rien n’était plus déplacé que la comtesse de Kendale au milieu de ce luxe déliquescent."
                            },
                            {
                                "example_id": "9c8fd8d4-77af-4493-ae9a-a2eea0ce574b",
                                "sense_id": "0f28f063-016f-38bd-8e88-4768a7f92fd6",
                                "text": "En termes à peine voilés, les deux pays déclarent qu’ils veulent instaurer un nouvel ordre mondial sino-russe qui s’oppose à l’ordre américain déliquescent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "85cb2d1a-fb8b-4f54-95a6-0575c81573ee",
                        "source_entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "target_lang_word": "deliquescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deliquescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1d317ee-b4f2-3b63-b9ca-2021217f5ddf",
                                        "entry_id": "d512a36d-eb27-37ba-acd7-aec0edbf2166",
                                        "glosses": [
                                            "Seeming to melt away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d3b5b5f-3952-4092-8054-0db7a261f94a",
                                                "sense_id": "d1d317ee-b4f2-3b63-b9ca-2021217f5ddf",
                                                "text": "“Any one who stands outside, who hides himself in a deliquescent aloofness, is a sneak and a spy—”"
                                            },
                                            {
                                                "example_id": "5c8ca9ba-0f1a-48df-8986-cae227ad2c76",
                                                "sense_id": "d1d317ee-b4f2-3b63-b9ca-2021217f5ddf",
                                                "text": "Yes, laugh, as I want to laugh for instance in the concert hall when the orchestra trundles to a stop and the virtuoso at his piano, hunched like a demented vet before the bared teeth of this enormous black beast of sound, lifts up deliquescent hands and prepares to plunge into the cadenza."
                                            },
                                            {
                                                "example_id": "48c7e41e-d20a-45e3-a8c4-c9180657cec3",
                                                "sense_id": "d1d317ee-b4f2-3b63-b9ca-2021217f5ddf",
                                                "text": "[…] Manet painted him [ Stéphane Mallarmé ] in a boneless, deliquescent slouch;"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a5f722d-44c9-33c3-97fe-7dfac19b790c",
                                        "entry_id": "d512a36d-eb27-37ba-acd7-aec0edbf2166",
                                        "glosses": [
                                            "Absorbing moisture from the air and forming a solution."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68936749-b743-4dcb-a34a-a2bd03df2d4f",
                                                "sense_id": "8a5f722d-44c9-33c3-97fe-7dfac19b790c",
                                                "text": "deliquescent salts"
                                            },
                                            {
                                                "example_id": "70a5d04d-b55f-4db8-be06-e99a680b845a",
                                                "sense_id": "8a5f722d-44c9-33c3-97fe-7dfac19b790c",
                                                "text": "[…] dew fell in sufficient quantity to make the streets muddy, and it would certainly have washed so deliquescent a substance as salt into the soil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "434a33f8-99dd-3d16-8ff7-749942209589",
                                        "entry_id": "d512a36d-eb27-37ba-acd7-aec0edbf2166",
                                        "glosses": [
                                            "Branching so that the stem is lost in branches, as in most deciduous trees."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e842ed-81fb-437f-a7bc-ac7eb1067e48",
                                                "sense_id": "434a33f8-99dd-3d16-8ff7-749942209589",
                                                "text": "1850, Asa Gray, The Botanical Text-Book, New York: Putnam, 3rd edition, rewritten and enlarged, Chapter 4, p. 102,\nIn other cases, the main stem is arrested, sooner or later, either by flowering, by the failure of the terminal bud, or the more vigorous development of some of the lateral buds, and thus the trunk is lost in the branches, or is deliquescent, as in most of our deciduous-leaved trees."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d0898a5-4267-3193-a6fa-88f75a547a93",
                                        "entry_id": "d512a36d-eb27-37ba-acd7-aec0edbf2166",
                                        "glosses": [
                                            "Becoming liquid as a phase of its life cycle."
                                        ],
                                        "tags": [
                                            "of the fruiting body of a fungus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd98109-e2ee-43ab-9695-a83eba698b27",
                                                "sense_id": "0d0898a5-4267-3193-a6fa-88f75a547a93",
                                                "text": "The spores, so soon as they are ripe, either drop out of the sporiferous membrane (hymenium), or, as more frequently happens, are projected from it with an elastic jerk, or else, as is the case of Agarics of a deliquescent kind, return to the earth mixed up with the black liquid into which these ultimately resolve themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f3543e0-15c5-4099-accc-8918293e43b9",
                        "source_entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "target_lang_word": "decadent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decadent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1be96ac-16ac-3108-b6b6-5349bc090caf",
                                        "entry_id": "9ac0e860-4574-30f3-9536-e1e8fa9c680a",
                                        "glosses": [
                                            "Characterized by moral or cultural decline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3d34f8-83d3-4cb1-a5e5-8843ea7c20e4",
                                                "sense_id": "e1be96ac-16ac-3108-b6b6-5349bc090caf",
                                                "text": "As societies grow decadent, the language grows decadent, too. Words are used to disguise, not to illuminate, action: you liberate a city by destroying it. Words are to confuse, so that at election time people will solemnly vote against their own interests."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "412273b3-7344-3eb7-a3df-7e44aaac32cc",
                                        "entry_id": "9ac0e860-4574-30f3-9536-e1e8fa9c680a",
                                        "glosses": [
                                            "Luxuriously self-indulgent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aff531fe-b236-4340-afd5-a5e178b5819a",
                                                "sense_id": "412273b3-7344-3eb7-a3df-7e44aaac32cc",
                                                "text": "2003, Hedonismbot in the Futurama episode \"The Devil's Hands Are Idle Playthings\"\nSurgery in an opera? How wonderfully decadent! And just as I was beginning to lose interest!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "decadent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "628d6134-10ee-37ff-9090-bcb8feb2b910",
                                        "entry_id": "768651ea-283d-357b-bc69-a639c4698d47",
                                        "glosses": [
                                            "A person affected by moral decay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a782486-403c-4e25-95dc-55293b8c5bda",
                                                "sense_id": "628d6134-10ee-37ff-9090-bcb8feb2b910",
                                                "text": "L. Douglas\nHe had the fastidiousness, the preciosity, the love of archaisms, of your true decadent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "130279fc-b080-49b0-a50b-57a1a1579cb2",
                        "source_entry_id": "85c28328-4e0c-304f-96f3-0dbe93c0462a",
                        "target_lang_word": "effete",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effete",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e86a4b0f-7f05-3ec6-994a-82704880d26b",
                                        "entry_id": "7318434d-c2a3-32e4-9e2d-28e58505dd23",
                                        "glosses": [
                                            "exhausted, spent, worn-out."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af2660b8-ce2a-4c1e-bb65-4167b8329c53",
                                                "sense_id": "e86a4b0f-7f05-3ec6-994a-82704880d26b",
                                                "text": "Nature is not effœte, as he saith, or so lavish, to bestow all her gifts upon an age, but hath reserved some for posterity, to shew her power, that she is still the same, and not old or consumed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                        "entry_id": "7318434d-c2a3-32e4-9e2d-28e58505dd23",
                                        "glosses": [
                                            "Lacking strength or vitality; feeble, powerless, impotent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088e77b9-4f89-4d44-b8b5-94665ef43dd2",
                                                "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                                "text": "Amid the effete monarchies and princedoms of feudal Europe, morally and materially exhausted by the Thirty Years' War, the only hope of resistance to France lay in the little Republic of merchants, Holland."
                                            },
                                            {
                                                "example_id": "adea7056-2a6c-409b-8287-25eaac5487f0",
                                                "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                                "text": "They used rock'n'roll as a weapon against itself. With all instruments but guitar, bass, drums, and voice written off as effete, as elitist accoutrements of a professionalist cult of technique, it was music best suited to anger and frustration, […]"
                                            },
                                            {
                                                "example_id": "46436e1b-18ca-432c-881b-7eca514854f1",
                                                "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                                "text": "A spirit of national masochism prevails, encouraged by an effete core of impudent snobs who characterize themselves as intellectuals (Spiro Agnew, October 1969)"
                                            },
                                            {
                                                "example_id": "123bc23a-8a62-4d99-8227-a678c5876e70",
                                                "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                                "text": "Most writers merely produce effete works on paper, you might say, but Kerouac went and wrestled with the tree itself."
                                            },
                                            {
                                                "example_id": "f3b41a6d-7410-4220-8c40-4aebb6190383",
                                                "sense_id": "869ea15b-9caf-3a28-b721-a36ed0e51097",
                                                "text": "For the President, the EU is an essentially effete project – a civilian power that likes to see itself as human rights based and collegiate, but with no hard power of its own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eeceb55e-439d-337f-a60e-95b2f46a15d5",
                                        "entry_id": "7318434d-c2a3-32e4-9e2d-28e58505dd23",
                                        "glosses": [
                                            "Decadent, weak through self-indulgence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc4a25b-a9ac-4ea1-b87a-93c8839d9c2f",
                                                "sense_id": "eeceb55e-439d-337f-a60e-95b2f46a15d5",
                                                "text": "In fact, one obvious project of the MLF […] is to counter the idea that lobster is unusually luxe or unhealthy, suitable only for effete palates or the occasional blow-the-diet treat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70af0bf-8c3f-3968-afaf-9b29df007439",
                                        "entry_id": "7318434d-c2a3-32e4-9e2d-28e58505dd23",
                                        "glosses": [
                                            "Affected, overrefined."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8a40b6b-d108-4618-be34-7a8b9dd756e9",
                                                "sense_id": "e70af0bf-8c3f-3968-afaf-9b29df007439",
                                                "text": "The Port Washington players all wear matching socks and shorts and tucked-in shirts. They look sharp but effete, a mannequinish aspect to them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
