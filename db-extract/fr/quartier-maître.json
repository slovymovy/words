                        "entry_id": "f68ffdc2-8f24-352a-ba2d-e51b8bf758b8",
                        "glosses": [
                            "Officier du grade de lieutenant ou de capitaine, chargé de la comptabilité d’un corps de troupes et qui faisait partie de l’état-major."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "824dffbb-8f8f-4fef-82f3-48b2b264a25b",
                                "sense_id": "84037590-21b4-3353-8c60-588f467a3c16",
                                "text": "Quartier-maître d’un régiment de dragons d’un régiment d’infanterie, etc. Quartier-maître trésorier."
                            },
                            {
                                "example_id": "9f594a2b-e46f-4f53-8f4e-964f2e0c6594",
                                "sense_id": "84037590-21b4-3353-8c60-588f467a3c16",
                                "text": "Son mari, ancien quartier-maître dans la garde impériale, grièvement blessé à Austerlitz et retraité, conservait, malgré sa considération pour Grandet, l’apparente franchise des militaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "01833eb1-d721-3105-91dc-cd33be5d0e5a",
                        "entry_id": "f68ffdc2-8f24-352a-ba2d-e51b8bf758b8",
                        "glosses": [
                            "Marin du premier grade au-dessus de matelot, qui correspond à celui de caporal dans l’infanterie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df918c7-4b3c-42c8-a2b2-fd141e75b0cc",
                                "sense_id": "01833eb1-d721-3105-91dc-cd33be5d0e5a",
                                "text": "Le quartier-maître du Britannia examina le yacht à un point de vue plus marin."
                            }
                        ]
