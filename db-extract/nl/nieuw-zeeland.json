                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "60ba368b-992a-369e-8ffc-6e445e9118e7",
                                        "entry_id": "b550923a-6518-33a1-aca5-e8ec1c795b0a",
                                        "glosses": [
                                            "Archipel du sud-ouest du Pacifique, composé de deux grandes îles (l’île du Nord et l’île du Sud)."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e10a3f42-dcab-463f-8d69-418547daedd1",
                                                "sense_id": "60ba368b-992a-369e-8ffc-6e445e9118e7",
                                                "text": "Lorsqu’on est un kakapo, perroquet-hibou de Nouvelle-Zélande, et une pipistrelle, petite espèce de chauve-souris, comment faire pour voir le soleil alors que l’on dort toute la journée pour ne s’éveiller que la nuit venue ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494ce520-109f-3e51-9ae8-714d678aa87e",
                                        "entry_id": "b550923a-6518-33a1-aca5-e8ec1c795b0a",
                                        "glosses": [
                                            "Pays occupant ces îles, dont la capitale est Wellington."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42db6ea2-13f5-421c-81f8-913a29b5f8d8",
                                                "sense_id": "494ce520-109f-3e51-9ae8-714d678aa87e",
                                                "text": "Au premier rang des pays fournisseurs de la Nouvelle-Zélande se place, naturellement, l’Angleterre avec 175 millions de marchandises, puis viennent : les États-Unis (38 millions), la Nouvelle-Galles du Sud (30 millions), l’État de Victoria (15 millions), etc."
                                            },
                                            {
                                                "example_id": "435d8e8c-e0a0-4edd-bdcd-a7c4fbc7b859",
                                                "sense_id": "494ce520-109f-3e51-9ae8-714d678aa87e",
                                                "text": "La première ministre de Nouvelle-Zélande, Jacinda Ardern, a annoncé sa démission, jeudi, neuf mois avant les prochaines élections."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
