                    {
                        "sense_id": "23e8b8ea-ce80-3384-a733-ff36bb55b40d",
                        "entry_id": "c58fca43-41ab-3d69-85e4-7a8afba055ec",
                        "glosses": [
                            "Relatif aux côtés des vertèbres, à droite ou à gauche des vertèbres par rapport au corps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9abab55-7ba8-474c-9050-0d85a5c6d7f2",
                                "sense_id": "23e8b8ea-ce80-3384-a733-ff36bb55b40d",
                                "text": "Les deux aiguilles à droite et à gauche se dirigent vers les sites splanchniques en latérovertébral en évitant les culs-de-sac pleuraux (hydrodissection) (C)."
                            },
                            {
                                "example_id": "4be2213c-f410-4ce6-88f8-8619190f9dad",
                                "sense_id": "23e8b8ea-ce80-3384-a733-ff36bb55b40d",
                                "text": "Sa racine antérieure est issue du tronc sympathique (anc. chaîne sympathique latérovertébrale), le plus souvent du rameau communiquant blanc."
                            },
                            {
                                "example_id": "df658066-0121-40f5-8f61-c574f2f1dc9e",
                                "sense_id": "23e8b8ea-ce80-3384-a733-ff36bb55b40d",
                                "text": "L’atteinte du sterno-cléido-mastoïdien n’entraîne pas de déficit fonctionnel aussi évident car elle est compensée par l’action des muscles pré– et latérovertébraux."
                            }
                        ]
                    }
