                "senses": [
                    {
                        "sense_id": "9f0b6932-546c-33b4-9e77-cb5bff55b3a9",
                        "entry_id": "7a5b838f-0746-35ca-a729-16f69b8940b2",
                        "glosses": [
                            "Combat à coups de poing qui était en usage dans les gymnases des anciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcc9d192-86f8-4bc0-93f8-0384754535c6",
                                "sense_id": "9f0b6932-546c-33b4-9e77-cb5bff55b3a9",
                                "text": "Les bras des athlètes étaient armés de cestes dans l’exercice du pugilat."
                            }
                        ]
                    },
                    {
                        "sense_id": "71cc61c0-5276-3f2b-8a68-e555a096522f",
                        "entry_id": "7a5b838f-0746-35ca-a729-16f69b8940b2",
                        "glosses": [
                            "Toute lutte à coups de poing ; rixe."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f5447fc7-9c92-4913-83f1-8ed99643eec7",
                                "sense_id": "71cc61c0-5276-3f2b-8a68-e555a096522f",
                                "text": "Dans un coin, la buvette accueillait, toujours ceux qui avaient essuyé quelques refus et les consolait par une ou deux tournées de « blanc-limé », du vin blanc avec un peu de limonade, ce qui finissait par énerver, et transformait la piste de danse, en ring de pugilat, il fallait bien que jeunesse se passe."
                            },
                            {
                                "example_id": "56f13626-9357-40b2-9280-f92bebe54775",
                                "sense_id": "71cc61c0-5276-3f2b-8a68-e555a096522f",
                                "text": "Ils organisèrent des manifestations tapageuses dégénérant souvent en pugilats, contre des universitaires ou des dramaturges juifs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
