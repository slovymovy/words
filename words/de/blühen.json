    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "73a2ac80-4003-3709-93d6-3f7e99034e36",
                    "sense_definition": "Blüten tragen oder in Blüte stehen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "Pflanze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Frühling <w>blühen</w> die Kirschbäume im ganzen Park wunderschön."
                        },
                        {
                            "text": "Viele bunte Blumen <w>blühen</w> jetzt im sonnigen Garten unserer Nachbarn."
                        }
                    ],
                    "common_phrases": [
                        "im Frühling blühen",
                        "prächtig blühen"
                    ]
                },
                {
                    "sense_id": "dd6761ce-439a-3bd6-8321-d027eeede389",
                    "sense_definition": "sich sehr gut entwickeln, wirtschaftlich erfolgreich sein oder florieren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "Erfolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Handel in der historischen Altstadt <w>blühte</w> im vergangenen Jahrhundert."
                        },
                        {
                            "text": "Dank der neuen Investitionen <w>blüht</w> das kleine Familienunternehmen seit zwei Jahren."
                        }
                    ],
                    "synonyms": [
                        "florieren",
                        "gedeihen",
                        "prosperieren"
                    ],
                    "common_phrases": [
                        "das Geschäft blüht",
                        "der Handel blüht"
                    ]
                },
                {
                    "sense_id": "4c2f1956-7321-3516-91e0-14f476b9f503",
                    "sense_definition": "jemandem als unangenehme Konsequenz oder Strafe bevorstehen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "Konsequenz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du die Frist verpasst, <w>blüht</w> dir eine empfindliche Geldstrafe."
                        },
                        {
                            "text": "Ihm <w>blühte</w> nach diesem schweren Fehler ein unangenehmes Gespräch mit der Chefin."
                        }
                    ],
                    "common_phrases": [
                        "jemandem blüht etwas",
                        "jemandem blüht Ärger"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "übertragen verwendet für drohende Nachteile"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e8537e2-6caa-3f68-b5cf-758144af0058",
                    "sense_definition": "das Entfalten oder Tragen von Blüten durch eine Pflanze",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Pflanze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das <w>Blühen</w> der Rosen im Garten lockt im Sommer zahlreiche Bienen an."
                        },
                        {
                            "text": "Die richtige Pflege bringt die empfindliche Pflanze im Frühling wieder zum <w>Blühen</w>."
                        }
                    ],
                    "common_phrases": [
                        "zum Blühen bringen"
                    ]
                }
            ]
        }
