                "senses": [
                    {
                        "sense_id": "98331942-a1c5-330f-95cd-17f9d4bed69a",
                        "entry_id": "cea8ec01-1068-34d5-a7a0-504ecee73c3a",
                        "glosses": [
                            "Schlag einer Glocke oder Uhr, der die volle Stunde anzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482134d1-93a3-407e-8df9-5935870ffb09",
                                "sense_id": "98331942-a1c5-330f-95cd-17f9d4bed69a",
                                "text": "„Die Stundenschläge des Big Ben scheinen sein Ende anzuzeigen.“"
                            },
                            {
                                "example_id": "5858ba7a-88b4-4a51-82d3-9873344afa5f",
                                "sense_id": "98331942-a1c5-330f-95cd-17f9d4bed69a",
                                "text": "„Ich höre den Stundenschlag einer Wanduhr, ich sehe meine Mutter auf ihrem Bett sitzen, ich erkenne Vater Jesko.“"
                            },
                            {
                                "example_id": "4ee5e19b-d5d3-493a-b527-150495ad21d1",
                                "sense_id": "98331942-a1c5-330f-95cd-17f9d4bed69a",
                                "text": "„Ein Stundenschlag traf ihn hart.“"
                            },
                            {
                                "example_id": "bc22b027-0465-424d-b38e-37b023b36220",
                                "sense_id": "98331942-a1c5-330f-95cd-17f9d4bed69a",
                                "text": "„Dann legte sie ein großes Wischtuch hinein, um es zu brühen, und lauschte auf die Stundenschläge des Nachtwächters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
