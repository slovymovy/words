                                "example_id": "796004dc-4ea7-4191-a94e-297bbefb6586",
                                "sense_id": "eb082616-6ca1-3243-9734-040c6067b65b",
                                "text": "Wanneer verschillende goederen gezamenlijk zijn verpakt in één colli of één container, moet de verzender verklaren dat gezamenlijke verpakking niet verboden is."
                            },
                            {
                                "example_id": "da92909a-6664-46a5-82b5-26a3afbbce7e",
                                "sense_id": "eb082616-6ca1-3243-9734-040c6067b65b",
                                "text": "Er wordt een gedagtekend bewijs afgegeven, waarop het totale gewicht van de colli's wordt vermeld."
                            }
                        ]
