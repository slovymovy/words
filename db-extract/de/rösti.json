                ],
                "senses": [
                    {
                        "sense_id": "3f5d134f-9576-3d9a-9859-e95047173d65",
                        "entry_id": "d2692b9f-360c-3d84-9582-ea27e73b5286",
                        "glosses": [
                            "in der Pfanne knusprig gebratener Fladen aus geraffelten Kartoffeln"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "1f1f498f-4f62-4f92-948d-66dce6e6d56e",
                                "sense_id": "3f5d134f-9576-3d9a-9859-e95047173d65",
                                "text": "„Das Kantonale Labor ruft Hobbyköche in einer etwas kryptischen Ausschreibung dazu auf, Proben von selbstgemachter Rösti einzuschicken.“"
                            },
                            {
                                "example_id": "4d12bac8-45d8-44ba-8cd4-bbb32994e30c",
                                "sense_id": "3f5d134f-9576-3d9a-9859-e95047173d65",
                                "text": "„Stiller freute sich auf Rösti und Bauernschüblig.“"
                            },
                            {
                                "example_id": "842fd7de-91d8-448f-9987-2a740d480aae",
                                "sense_id": "3f5d134f-9576-3d9a-9859-e95047173d65",
                                "text": "„Der Kellner brachte zweimal Läberli mit Rösti und Salat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "739ccd94-40cb-4d12-8b84-702d939a2ae6",
