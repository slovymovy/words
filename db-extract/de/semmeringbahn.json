                        "entry_id": "991a90ab-1b0b-3826-96ed-983fff941bda",
                        "glosses": [
                            "Bahnstrecke, die von Gloggnitz über den Semmering nach Mürzzuschlag verläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "669e0e2c-36a6-46e1-8c18-667ca00126e9",
                                "sense_id": "8c088735-17f7-3549-a91f-3b3fd7b5e16d",
                                "text": "„Am Bahnhof Semmering erfährt man im neuen Informationszentrum alles Wissenswerte über das Weltkulturerbe Semmeringbahn und umgebende Landschaft.“"
                            },
                            {
                                "example_id": "c7751625-2e98-4afc-9a02-f25bee41948c",
                                "sense_id": "8c088735-17f7-3549-a91f-3b3fd7b5e16d",
                                "text": "„Der Bahnwanderweg am Weltkulturerbe Semmeringbahn wird meist geräumt, sodass man die Strecke entlanggehen kann – außer, der Schneefall ist so stark, dass der Räumtrupp nicht nachkommt.“"
                            }
                        ],
