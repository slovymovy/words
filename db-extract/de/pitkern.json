                "senses": [
                    {
                        "sense_id": "5ad81450-061f-3612-b2a6-93d1d19a86b9",
                        "entry_id": "e24103a6-ff66-3542-b857-feb5b56e5cd5",
                        "glosses": [
                            "eine Kreolsprache, die auf Pitcairn und der Norfolkinsel (beides Inseln im Südpazifik) gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e4f651-400d-4e13-99c2-05d165b97737",
                                "sense_id": "5ad81450-061f-3612-b2a6-93d1d19a86b9",
                                "text": "„Bisher der einzige Versuch, das Vokabular des Pitkern vollständig zu erfassen.“"
                            },
                            {
                                "example_id": "6af30b8b-0f51-4a46-a6ec-3cc8781fc30a",
                                "sense_id": "5ad81450-061f-3612-b2a6-93d1d19a86b9",
                                "text": "„Die Eröffnung des Panamakanals im Jahr 1914 erleichterte den Zugang zu der 4100 Meilen entfernten Insel merklich. Seitdem wissen wir mehr über das Pitkern, die Sprache der Insulaner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
