                "senses": [
                    {
                        "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                        "entry_id": "992ea779-b6a2-3ade-a956-e409a85e333e",
                        "glosses": [
                            "brak doświadczenia, orientacji"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75dc5bbb-cf62-41d3-964a-179da6e6b2a4",
                                "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                                "text": "Jeżeli jedna ze stron, wyzyskując przymusowe położenie, niedołęstwo lub niedoświadczenie drugiej strony, w zamian za swoje świadczenie przyjmuje albo zastrzega …"
                            },
                            {
                                "example_id": "bf5c6476-9ce3-4955-9b25-17073cb05da2",
                                "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                                "text": "Młodość i niedoświadczenie podszepnęły mu myśli dodające otuchy"
                            },
                            {
                                "example_id": "271eda69-017c-48e5-8717-b33e73940398",
                                "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                                "text": "Wreszcie gdyby istotnie [Józef] Zajączek pod Chełmem zawinił był niedoświadczeniem, to przecież późniejsze jego odznaczenie się pod Gołkowem i przy oblężeniu Warszawy wystarczyłoby do podreperowania jego sławy"
                            },
                            {
                                "example_id": "c77e2d0b-1ec6-42d2-bcb8-4471769c9455",
                                "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                                "text": "Z góry byłam uprzedzoną[,] dokąd jadę[,] i niezmiernie ciekawą… Mamcia[,] lękając się mojego niedoświadczenia, objaśniła mi o wszystkim"
                            },
                            {
                                "example_id": "7ab017dd-e65a-4489-88da-3caf3698ccb6",
                                "sense_id": "fbeebd65-2be3-3be4-bfb2-5932c6a770cc",
                                "text": "Prawdę mówiąc, niedoświadczenie podwajało mi każdą pracę, nade[ ]wszystko piśmienną"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
