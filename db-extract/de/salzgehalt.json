                    {
                        "sense_id": "600fbde1-0ee8-392d-bf6d-18af1427e407",
                        "entry_id": "81dbf2e0-50b8-3570-a7e5-e38e472810d5",
                        "glosses": [
                            "Salinité, salure, teneur en sel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8079d2-2a4c-4384-b1e3-53aee498e2a0",
                                "sense_id": "600fbde1-0ee8-392d-bf6d-18af1427e407",
                                "text": "Der Salzgehalt beträgt 3%.",
                                "translation": "La teneur en sel est de 3%."
                            },
                            {
                                "example_id": "e31e096c-c0f3-4f22-bc58-8b646f7d9fde",
                                "sense_id": "600fbde1-0ee8-392d-bf6d-18af1427e407",
                                "text": "Die Forscher hatten laut »Guardian« nach Warnzeichen für den Salzgehalt im südlichen Teil des Atlantiks zwischen Kapstadt und Buenos Aires gesucht.",
                                "translation": "Selon le « Guardian », les chercheurs ont cherché des signes avant-coureurs de la salinité dans la partie sud de l'Atlantique, entre Le Cap et Buenos Aires."
                            },
                            {
                                "example_id": "e4f6a991-3dbf-4ac8-9cd4-f674a568ae4a",
                                "sense_id": "600fbde1-0ee8-392d-bf6d-18af1427e407",
                                "text": "Die britische Regierung legte eine Liste der Lebensmittel mit hohem Fett-, Salz- und Zuckergehalt vor, die von dem Werbeverbot betroffen sind.",
                                "translation": "Le gouvernement britannique a présenté une liste des aliments à forte teneur en graisse, en sel et en sucre concernés par l'interdiction de publicité."
                            }
                        ]
                    }
