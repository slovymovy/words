                ],
                "senses": [
                    {
                        "sense_id": "1703f9c2-d26e-3694-8897-a4f9b64e51af",
                        "entry_id": "2bd4284b-f7b5-3963-b812-493b65e0292d",
                        "glosses": [
                            "ein Pfeiler oder Säule mit einem tabernakelartigen Aufsatz, in die ein „Licht“ gestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f7db35-616b-4c40-8b23-7b3941d1aab3",
                                "sense_id": "1703f9c2-d26e-3694-8897-a4f9b64e51af",
                                "text": "„Die ältesten Lichtstöcke stammen aus dem 14. Jh. und finden mit dem spätgotischen Erscheinungsbild ihren Höhepunkt, wobei gerade hier ein Beharren der Erscheinungsform lange über die Gotik hinaus zu beobachten ist“"
                            },
                            {
                                "example_id": "e03f8ccc-16a7-49f2-9707-a6cc00ffc0e9",
                                "sense_id": "1703f9c2-d26e-3694-8897-a4f9b64e51af",
                                "text": "„In der Gegend von Pernitz-Muggendorf steht \"Im Thal\", an einer Weggabelung in der Nähe des \"Kamerwirtes\", ein eigentümlicher Lichtstock, über den kurz berichtet werden soll.“"
                            },
                            {
                                "example_id": "1c8c2d1f-4185-4740-abf1-339ee8282f3f",
                                "sense_id": "1703f9c2-d26e-3694-8897-a4f9b64e51af",
                                "text": "„Die Nahansicht des Lichtstockes im oberen Bereich welcher unter Denkmalschutz steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8ea1b44e-5efe-346c-bbce-ca13a49f5ca1",
                        "entry_id": "2bd4284b-f7b5-3963-b812-493b65e0292d",
                        "glosses": [
                            "veraltet: Kerzenständer, Leuchter auf/in dem eine Kerze steht; oder auch Fackel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34c534d6-2e3b-4545-b8d4-5e388eba1334",
                                "sense_id": "8ea1b44e-5efe-346c-bbce-ca13a49f5ca1",
                                "text": "„Der Lichtstock, des -es, plur. die -stöcke, im gemeinen Leben einiger Gegenden, der Nahme eines Leuchters, besonders wenn derselbe ganz einfach und grob aus Holz bereitet ist. S. Leuchter.“"
                            },
                            {
                                "example_id": "e4860528-563b-4a9c-a707-00c053f31c7f",
                                "sense_id": "8ea1b44e-5efe-346c-bbce-ca13a49f5ca1",
                                "text": "„Im ländlichen Milieu ebenso selten ist ein weiteres Fundstück: ein aus Ton gebrannter, pyramidenförmiger Leuchter – auch Lichtstock genannt – der reich mit Kerbschnitdekor verziert ist und zusammen mit weiteren Funden aus der Verfüllung eines im 16. Jahrhundert aufgegebenen Kellers stammt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b577a71b-535c-3800-98cd-84b8c8d297c6",
                        "entry_id": "2bd4284b-f7b5-3963-b812-493b65e0292d",
                        "glosses": [
                            "altertümlich: kleine Münze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeeabb57-cf02-4c8b-8f05-ca058bd7e944",
                                "sense_id": "b577a71b-535c-3800-98cd-84b8c8d297c6",
                                "text": "„Lichtstock: Leuchter, hier Bezeichnung für eine Münze: \"Liechtstöck … wurden lothringische Halbgroschen mit dem Bilde des aufgerichteten lothring. Schwertes, welches man mit einem Lichtstock verglich, genannt\"“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
