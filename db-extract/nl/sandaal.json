                ],
                "translations": [
                    {
                        "translation_id": "26020450-ad32-4349-9f35-5b7aafa1434b",
                        "source_entry_id": "74e2a7f9-40b2-37a7-827b-ab4876c05aa4",
                        "source_sense_id": "1c897ab4-f2f5-342c-8e8d-396cf95ea237",
