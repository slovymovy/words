                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fe6b068-bede-4988-815f-f5e11862e131",
                                                "sense_id": "a0dea9c8-4927-3783-ba97-f1c8ec2dcb6d",
                                                "text": "Was genau Pornografie ist, ist umstritten und von der persönlichen Einstellung des Einzelnen und seinen weltanschaulichen Vorstellungen abhängig."
                                            },
                                            {
                                                "example_id": "842c4a84-e88d-4a48-a7a9-ca09ab6d1b6a",
                                                "sense_id": "a0dea9c8-4927-3783-ba97-f1c8ec2dcb6d",
                                                "text": "„Die Satellitensender und das Internet wurden nicht in erster Linie benutzt, um Informationen zu erlangen oder auszutauschen, sondern um Pornografie zu konsumieren.“"
                                            },
                                            {
                                                "example_id": "372bef16-bf8c-4285-a1ef-ac859d1fcf6a",
                                                "sense_id": "a0dea9c8-4927-3783-ba97-f1c8ec2dcb6d",
                                                "text": "„Aber die biblische Geschichte hat herrliche Vorwände für die edelste Pornografie geliefert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e182810-3131-3ea1-a54e-b7aa3475bc32",
                                        "entry_id": "dcf08770-4a9e-32df-8bf8-596626ad02ec",
                                        "glosses": [
                                            "pornografisches Erzeugnis, pornografische Schrift, solcher Art Tonträger, Bild oder Film"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43b7f32c-85b0-47f2-adc6-c1ad08c60a7e",
                                                "sense_id": "8e182810-3131-3ea1-a54e-b7aa3475bc32",
                                                "text": "Früher wurde Pornografie, wenn überhaupt, unter dem Ladentisch verkauft, und Heerscharen reisten über die Grenze nach Dänemark, um Heftchen zu erwerben."
                                            },
                                            {
                                                "example_id": "13cffaa4-40d2-44cb-b6be-f8de5cb34d02",
                                                "sense_id": "8e182810-3131-3ea1-a54e-b7aa3475bc32",
                                                "text": "„In Zeitungskiosken, Bibliotheken und Buchhandlungen anfangs verboten, musste der »Sturm« wie Pornografie unter dem Ladentisch gehandelt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
