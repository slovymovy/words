                "senses": [
                    {
                        "sense_id": "d99fc4fe-0b49-3fe2-833f-acf0f53d791b",
                        "entry_id": "96f7096b-0ab6-37fa-a274-e19b9724b044",
                        "glosses": [
                            "Fait de financiariser, de baser sur les services financiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e5d13b2-9f4c-4dcb-b090-af454fa8e5bf",
                                "sense_id": "d99fc4fe-0b49-3fe2-833f-acf0f53d791b",
                                "text": "Depuis la financiarisation de l’économie au tournant des années 2000, les grands patrons français vivent sur un (très) grand pied."
                            },
                            {
                                "example_id": "fbef8593-38ed-4cd4-93eb-b7f36c50a0f8",
                                "sense_id": "d99fc4fe-0b49-3fe2-833f-acf0f53d791b",
                                "text": "Cette nouvelle dynamique, appelons-la financiarisation. Son inversion tient à une inversion de la logique financière. Au lieu que la finance soit au service de la production des entreprises, c'est l'inverse qui se produit : l'activité de l'entreprise est tirée par les attentes de la finance. L'accès aux immenses ressources financières détermine les stratégies des producteurs."
                            }
                        ]
                    }
                ],
