                                    {
                                        "sense_id": "5fd365f1-9201-33c5-b340-59e884185431",
                                        "entry_id": "17f2f78f-b437-3a49-abe6-08d36a349d33",
                                        "glosses": [
                                            "Adventurous, willing to take on or look for risks; overbold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cd84d0-46e8-40ff-aae2-839f84cb67da",
                                                "sense_id": "5fd365f1-9201-33c5-b340-59e884185431",
                                                "text": "“There the cause of death was soon ascertained ; the victim of this daring outrage had been stabbed to death from ear to ear with a long, sharp instrument, in shape like an antique stiletto, which […] was subsequently found under the cushions of the hansom. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d50efd6a-29aa-3fed-ae1c-4ae7fbf8d32f",
                                        "entry_id": "17f2f78f-b437-3a49-abe6-08d36a349d33",
                                        "glosses": [
                                            "Courageous or showing bravery; doughty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c846362b-5192-4892-b0a7-bdcd53919729",
                                                "sense_id": "d50efd6a-29aa-3fed-ae1c-4ae7fbf8d32f",
                                                "text": "[…]By this scimitar,\nThat slew the Sophy and a Persian prince\nThat won three fields of Sultan Solyman,\nI would outstare the sternest eyes that look,\nOutbrave the heart most daring on earth,\nPluck the young sucking cubs from the she-bear,\nYea, mock the lion when he roars for prey,\nTo win thee, lady. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbd4f7be-6470-3cc2-9bd4-fd5149ca2218",
                                        "entry_id": "17f2f78f-b437-3a49-abe6-08d36a349d33",
                                        "glosses": [
                                            "Racy; sexually provocative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2ca9ad1-a13c-464c-ba63-c8fda58b2e4b",
                                                "sense_id": "dbd4f7be-6470-3cc2-9bd4-fd5149ca2218",
                                                "text": "Just what I wanted, seeing my mom in a daring bikini—or worse yet, my being in one. I had the perfect drawer I could bury it in."
                                            }
                                        ]
