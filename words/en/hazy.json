{
    "word_family": [
        "haze",
        "hazily",
        "haziness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d91f011a-fb0a-3ba7-8821-010b10fd24b7",
                    "sense_definition": "Thick or obscured with haze, such as smoke, dust, or light mist in the air.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "atmospheric_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The morning sun struggled to shine through the <w>hazy</w> sky filled with summer heat.",
                            "target_lang_translations": {
                                "ru": "Утреннее солнце с трудом пробивалось сквозь <w>мглистое</w> небо, напоенное летним зноем."
                            }
                        },
                        {
                            "text": "We could only see a <w>hazy</w> view of the mountains because of the pollution from the nearby city.",
                            "target_lang_translations": {
                                "ru": "Из-за загрязнения от соседнего города горы были видны лишь как <w>туманный</w> силуэт."
                            }
                        }
                    ],
                    "synonyms": [
                        "hazed",
                        "indistinct"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "hazy view",
                        "hazy sky",
                        "hazy sunshine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затуманенный или скрытый дымкой, такой как дым, пыль или легкий туман в воздухе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мглистый",
                                "target_lang_sense_clarification": "о воздухе или небе, наполненном дымкой"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "скрытый легким туманом или дымкой"
                            },
                            {
                                "target_lang_word": "затуманенный",
                                "target_lang_sense_clarification": "ставший неясным из-за атмосферных явлений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e9c597d-557b-31c2-990c-1ec46efd07bf",
                    "sense_definition": "Vague, uncertain, or poorly defined in one's mind or memory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have a <w>hazy</w> recollection of what happened during the accident many years ago.",
                            "target_lang_translations": {
                                "ru": "У меня остались лишь <w>смутные</w> воспоминания о том, что произошло во время аварии много лет назад."
                            }
                        },
                        {
                            "text": "The details of the contract remained <w>hazy</w> even after we read it several times.",
                            "target_lang_translations": {
                                "ru": "Детали контракта оставались <w>туманными</w> даже после того, как мы перечитали его несколько раз."
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "ambiguous",
                        "nebulous",
                        "fuzzy"
                    ],
                    "antonyms": [
                        "clear",
                        "distinct",
                        "precise"
                    ],
                    "common_phrases": [
                        "hazy recollection",
                        "hazy memory",
                        "hazy idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смутный, неопределенный или плохо очерченный в сознании или памяти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутный",
                                "target_lang_sense_clarification": "о воспоминаниях или представлениях"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "неясный или неопределенный"
                            },
                            {
                                "target_lang_word": "расплывчатый",
                                "target_lang_sense_clarification": "лишенный четкости и конкретики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "742c2e7e-b09c-31de-8477-f78f7a45e09b",
                    "sense_definition": "Not clear or transparent; having a cloudy or blurred appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old photograph had become <w>hazy</w> and yellowed with age.",
                            "target_lang_translations": {
                                "ru": "Старая фотография со временем стала <w>размытой</w> и пожелтела."
                            }
                        },
                        {
                            "text": "Looking through the <w>hazy</w> glass of the shower door, I could barely see the tiles.",
                            "target_lang_translations": {
                                "ru": "Сквозь <w>мутное</w> стекло душевой двери я едва мог разглядеть плитку."
                            }
                        }
                    ],
                    "synonyms": [
                        "blurry",
                        "indistinct",
                        "ill-defined"
                    ],
                    "antonyms": [
                        "sharp",
                        "transparent"
                    ],
                    "common_phrases": [
                        "hazy glass",
                        "hazy image"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрозрачный или неясный; имеющий мутный или размытый вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "о стекле или жидкости, потерявших прозрачность"
                            },
                            {
                                "target_lang_word": "размытый",
                                "target_lang_sense_clarification": "о контурах или изображении"
                            },
                            {
                                "target_lang_word": "неясный",
                                "target_lang_sense_clarification": "плохо различимый визуально"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e8504cec-8bb2-3c48-beb0-118bf1956a86",
                    "sense_definition": "A type of beer, usually an IPA, that is cloudy in appearance and has a fruity, less bitter taste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender asked if I wanted a crisp lager or one of the local <w>hazies</w> on tap.",
                            "target_lang_translations": {
                                "ru": "Бармен спросил, хочу ли я освежающий лагер или что-нибудь из местного <w>хейзи</w> на кране."
                            }
                        },
                        {
                            "text": "Many craft beer fans prefer <w>hazies</w> because of their smooth mouthfeel and tropical notes.",
                            "target_lang_translations": {
                                "ru": "Многие любители крафтового пива предпочитают <w>мутные сорта</w> из-за их мягкого вкуса и тропических ноток."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in craft beer culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип пива, обычно IPA, которое имеет мутный вид и фруктовый, менее горький вкус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хейзи",
                                "target_lang_sense_clarification": "сленговое название мутных сортов пива"
                            },
                            {
                                "target_lang_word": "мутный IPA",
                                "target_lang_sense_clarification": "описание стиля пива"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
