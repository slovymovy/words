                        "in Andacht verharren"
                    ]
                },
                {
                    "sense_id": "37ae71b1-79bc-39a3-8f3b-07eda9315497",
                    "sense_definition": "Starke Konzentration und Versunkenheit bei einer nichtreligiösen Beschäftigung",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "versunkenheit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Völlig in <w>Andacht</w> versunken saß der alte Mann am Fenster und beobachtete den Regen."
