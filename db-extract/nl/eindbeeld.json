                                                "example_id": "f3325844-c00b-44a1-be50-2a6d5f4d1198",
                                                "sense_id": "a63c3a02-7e3a-3117-a1ba-840f8a1b20b1",
                                                "text": "These four came all afront, and mainly thrust at me. I made me no more ado but took all their seven points in my target, thus."
                                            }
