        "pl-extract.jsonl": [
            {
                "entry_id": "fbaa9728-e878-3ea5-8e84-d7bad26fab39",
                "word": "fora",
                "pos": "intj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                        "entry_id": "fbaa9728-e878-3ea5-8e84-d7bad26fab39",
                        "glosses": [
                            "precz!"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "252a0095-c292-4843-b30f-e36a92ade025",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "Jeśli się jej coś nie podoba, śmiało może brać swoje graty i fora do ojca."
                            },
                            {
                                "example_id": "9bf40541-975f-4128-93cb-02211cb058c4",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "KUCHARZ: Dosyć! Zbierać łachy i fora ze dwora."
                            },
                            {
                                "example_id": "ff53dd71-a2e1-4e71-9802-cad926c6248e",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "— Ejże[,] nie żartujcie ze mną! fora, won! pókiście cali! — zawołał[,] a oczy dzikim rozgorzały mu blaskiem."
                            },
                            {
                                "example_id": "ba928f9f-ab31-4c94-9e5f-e5230afe5ff7",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "Zaraz mnie [mi] zapowiedział albo aukcją, albo fora z karczmy."
                            },
                            {
                                "example_id": "13da85f3-cb11-4630-a6e6-d12e395b3f17",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "Ustępuj z domu mojej siostry… fora…"
                            },
                            {
                                "example_id": "01c7bb86-45e7-48cc-af09-4f70058b4ffd",
                                "sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                                "text": "Dom ten w moim zarządzeniu cały. Kogo chcę przyjmę, kogo nie chcę, za drzwi fora!"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    },
                    {
                        "sense_id": "4c2459c9-6528-3007-ab59-6e229a3e5a03",
                        "entry_id": "fbaa9728-e878-3ea5-8e84-d7bad26fab39",
                        "glosses": [
                            "bis!"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b2197674-8f85-471b-8a0b-aa93c4ef94e7",
                                "sense_id": "4c2459c9-6528-3007-ab59-6e229a3e5a03",
                                "text": "Wojewodzianka starsza i ciotka moja[,] na swój śpiew piękny otrzymały fora i huczne oklaski."
                            }
                        ],
                        "sense_index_json": "\"2.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27c25a72-c189-42fd-ae3a-2dd8825039e2",
                        "source_entry_id": "fbaa9728-e878-3ea5-8e84-d7bad26fab39",
                        "source_sense_id": "0083a5db-0f8c-3b45-bd3e-750920cc5b92",
                        "target_lang_word": "get out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3809207-65b5-3ded-90aa-656692366f5d",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To leave or escape."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d0fa76c-af22-4623-a19b-5d07def819b3",
                                                "sense_id": "d3809207-65b5-3ded-90aa-656692366f5d",
                                                "text": "In case of fire, get out by the nearest exit."
                                            },
                                            {
                                                "example_id": "f2dba2f1-856b-4719-a4c5-35995659430d",
                                                "sense_id": "d3809207-65b5-3ded-90aa-656692366f5d",
                                                "text": "You have to get out on a bull to succeed in a rodeo."
                                            },
                                            {
                                                "example_id": "62053323-fe95-49fd-b713-94d8703eeaf4",
                                                "sense_id": "d3809207-65b5-3ded-90aa-656692366f5d",
                                                "text": "‘It is grim reading,’ he said. ‘I fear their end was cruel. Listen! We cannot get out. We cannot get out. They have taken the Bridge and second hall. Frár and Lóni and Náli fell there. Then there are four lines smeared so that I can only read went 5 days ago. The last lines run the pool is up to the wall at Westgate. The Watcher in the Water took Óin. We cannot get out. The end comes, and then drums, drums in the deep. I wonder what that means. The last thing written is in a trailing scrawl of elf-letters: they are coming. There is nothing more.’ Gandalf paused and stood in silent thought."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73a200c1-7e38-38a7-b705-4af7c15c6f4c",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To come out of a situation; to escape a fate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2420a7f2-8af9-4956-8c2b-ae8d2ecfc084",
                                                "sense_id": "73a200c1-7e38-38a7-b705-4af7c15c6f4c",
                                                "text": "Never take life seriously. Nobody gets out alive anyway."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da4467f-19d6-3c5e-bb04-795c24bb7692",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To be released, especially from hospital or prison."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a4c2a8-8183-4b59-95b6-f6622f3bff26",
                                                "sense_id": "3da4467f-19d6-3c5e-bb04-795c24bb7692",
                                                "text": "He's been in prison for six months, but he gets out next week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "530191bb-58a6-3468-93a2-c47b11fb4f5d",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To remove one's money from an investment; to end an investment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "897d5f3e-69d4-4d8c-83c0-e8001d67546f",
                                                "sense_id": "530191bb-58a6-3468-93a2-c47b11fb4f5d",
                                                "text": "I think copper prices will plummet this fall, so I'm getting out while I can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f0584bd-e5e2-3f29-807a-a8170e7e8890",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To help (someone) leave."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6240c55-dafd-4e92-9f69-ebf279597e7c",
                                                "sense_id": "5f0584bd-e5e2-3f29-807a-a8170e7e8890",
                                                "text": "We must get the children out first."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f93acd29-14f1-3729-a3e1-8a181463e1b4",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To take (something) from its container or storage place, so as to use or display it."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3e8c53e-f3de-469f-98e7-1fe2f1d56598",
                                                "sense_id": "f93acd29-14f1-3729-a3e1-8a181463e1b4",
                                                "text": "Get the playing cards out and we'll have a game of snap."
                                            },
                                            {
                                                "example_id": "2eb7e1ca-751f-4e48-9ad0-feeadb97e2f8",
                                                "sense_id": "f93acd29-14f1-3729-a3e1-8a181463e1b4",
                                                "text": "It's time to get the Christmas decorations out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc4233a-1078-3440-a0c1-cffa68442ae2",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To leave the inside of a vehicle such as a car. (Note: for public transport, get off is more common.)"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a435bff2-0d50-4db4-94a4-37ca56cf20aa",
                                                "sense_id": "9dc4233a-1078-3440-a0c1-cffa68442ae2",
                                                "text": "I'll get out at the end of the road and walk from there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b5f957-c7bb-3659-a289-92c89abb37dd",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To become known."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75cf07c2-3d46-4e79-a994-c42edc2d3a0c",
                                                "sense_id": "e0b5f957-c7bb-3659-a289-92c89abb37dd",
                                                "text": "Somehow the secret got out."
                                            },
                                            {
                                                "example_id": "f90e563d-ff66-4729-9346-b69a907d6306",
                                                "sense_id": "e0b5f957-c7bb-3659-a289-92c89abb37dd",
                                                "text": "We have to act before that fact gets out on us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7914c40b-2f55-3338-abe3-eb5c6283effc",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To spend free time out of the house."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f65b399e-5264-430e-b689-82c6a111edf1",
                                                "sense_id": "7914c40b-2f55-3338-abe3-eb5c6283effc",
                                                "text": "You work too hard. You should get out more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2670f3ee-0d26-3389-8cee-a4d2200f85e9",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To publish or make available; to disseminate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "067c7fce-9517-4314-99d3-22bf430c72d2",
                                                "sense_id": "2670f3ee-0d26-3389-8cee-a4d2200f85e9",
                                                "text": "The organization has just gotten their newsletter out."
                                            },
                                            {
                                                "example_id": "ea6fc5da-a690-45c5-8d80-cb8f4459a162",
                                                "sense_id": "2670f3ee-0d26-3389-8cee-a4d2200f85e9",
                                                "text": "This candidate is struggling to get her message out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5497a677-44f7-3cbd-8c4f-8fd99acc390f",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To say with difficulty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2825618-3baf-45f4-8433-db96f734280d",
                                                "sense_id": "5497a677-44f7-3cbd-8c4f-8fd99acc390f",
                                                "text": "He could hardly get the words out for the tears."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc41f184-86d4-3080-908a-c6b7438e9df9",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To remove or eliminate (dirt or stains)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b67802f-31dd-411d-ac62-cffe1071ad6b",
                                                "sense_id": "cc41f184-86d4-3080-908a-c6b7438e9df9",
                                                "text": "This detergent will get most household stains out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a787874b-21e1-31c3-82d3-88b11b83131b",
                                        "entry_id": "d5085c64-5a0c-340f-ac6b-ef095b2f1775",
                                        "glosses": [
                                            "To end."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94691050-e615-4a94-ad17-9b95c3edf507",
                                                "sense_id": "a787874b-21e1-31c3-82d3-88b11b83131b",
                                                "text": "School gets out in the afternoon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "get out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b89438-34ca-3824-a9ce-ea6838dcdb04",
                                        "entry_id": "88c43fba-a9b7-313b-b040-472ba1a32ccb",
                                        "glosses": [
                                            "Commanding a person to leave."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee55da2-7add-4df1-a79d-fa8fbbc4c657",
                                                "sense_id": "e1b89438-34ca-3824-a9ce-ea6838dcdb04",
                                                "text": "Get out! I never want to see you in here again!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c15afcaf-4646-311a-b0ef-43ad529c251e",
                                        "entry_id": "88c43fba-a9b7-313b-b040-472ba1a32ccb",
                                        "glosses": [
                                            "Indicating incredulity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05f8acbd-3ae4-464b-bb5f-b18a9f326f29",
                                                "sense_id": "c15afcaf-4646-311a-b0ef-43ad529c251e",
                                                "text": "\"Giants in armour, sir. Hundred feet high. Three legs and a body like 'luminium, with a mighty great head in a hood, sir.\" \"Get out!\" said the lieutenant. \"What confounded nonsense!\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c774186b-623c-3ea6-9e50-cfa165a0de0c",
                                        "entry_id": "88c43fba-a9b7-313b-b040-472ba1a32ccb",
                                        "glosses": [
                                            "Expressing disapproval or disgust, especially after a bad joke."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ff7bac-d9e9-4cdb-8595-c1c59164717d",
                                                "sense_id": "c774186b-623c-3ea6-9e50-cfa165a0de0c",
                                                "text": "Just get out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
