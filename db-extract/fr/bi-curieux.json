                    {
                        "sense_id": "267c9ba1-49cb-305d-a803-e8e5696383f7",
                        "entry_id": "29dcbfdc-7501-31a8-ab1c-0d65c3f17e38",
                        "glosses": [
                            "Personne s’identifiant habituellement comme hétérosexuelle ou homosexuelle, mais qui manifeste un certain intérêt ou entretient des fantasmes à l’idée d’avoir une expérience sexuelle avec une personne du sexe qu’elle ne favorise pas d’habitude, souvent en n’assumant pas ou en rejetant l’étiquette de bisexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6d681d-d6da-4a50-9f71-2e78be43541b",
                                "sense_id": "267c9ba1-49cb-305d-a803-e8e5696383f7",
                                "text": "D’après moi, un bi-curieux, c’est juste un bi qui se convainc qu’il est hétéro, mais qu’il essaierait bien « pour voir »."
                            },
                            {
                                "example_id": "ca7fe2da-c827-48a0-85e8-25143804f92f",
                                "sense_id": "267c9ba1-49cb-305d-a803-e8e5696383f7",
                                "text": "Elle mélange tout, c’est incroyable ! Elle vient mettre les bi-curieux et les bisexuels dans le même sac, c’est honteux !"
                            },
                            {
                                "example_id": "d9491d87-c01f-411a-8962-a51f7b9a2e37",
                                "sense_id": "267c9ba1-49cb-305d-a803-e8e5696383f7",
                                "text": "C’est un peu comme les « bi-curieux » […], c’est juste une façon de réduire sa bisexualité parce que c’est pas viril d’être bi."
                            },
                            {
                                "example_id": "ddcd03b5-de20-4458-92eb-9cbd3d5c02a9",
                                "sense_id": "267c9ba1-49cb-305d-a803-e8e5696383f7",
                                "text": "Les bi-curieux qui sont passés à l’acte, vous regrettez ?"
                            }
                        ]
                    }
