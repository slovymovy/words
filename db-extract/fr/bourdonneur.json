                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ead5281-6e0e-49d7-9eda-497984b2f0a7",
                        "entry_id": "84923dce-f818-30cc-93e2-b3bb13f21915",
                        "tags": [
                            "plural"
                        ],
                        "form": "bourdonneurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df8c5632-c9c4-33bb-aaa8-03dd5a075016",
                        "entry_id": "84923dce-f818-30cc-93e2-b3bb13f21915",
                        "glosses": [
                            "Machine sonore utilisée dans la musique bruitiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d6659a-b64f-4a64-8758-f5c8fdb5f489",
                                "sense_id": "df8c5632-c9c4-33bb-aaa8-03dd5a075016",
                                "text": "Lorsque je présentai au public ce premier bruiteur, trois autres instruments étaient presque achevés : un crépiteur, un bourdonneur et un strideur."
                            },
                            {
                                "example_id": "7280b34f-709b-435b-9225-1ae445c6f05f",
                                "sense_id": "df8c5632-c9c4-33bb-aaa8-03dd5a075016",
                                "text": "L’orchestre était composé de trois bourdonneurs, deux éclateurs, un tonneur, trois siffleurs, deux bruisseurs, deux glouglouteurs, un fracasseur, un stridenteur, un renâcleur et interprétait quatre « réseaux de bruits » poétiquement intitulés: « Réveil de Capitale », « Rendez-vous d’autos et d’aéroplanes », « On dîne à la terrasse du Casino », « Escarmouche dans l'oasis »."
                            },
                            {
                                "example_id": "806d1ee6-374d-43d6-9989-8d1ebecda831",
                                "sense_id": "df8c5632-c9c4-33bb-aaa8-03dd5a075016",
                                "text": "Les noms mêmes qu’ont choisi, non sans ironie, ces « instrumentistes », le proclament : hululeurs, grondeurs, crépiteurs, striduleurs, bourdonneurs, glouglouteurs, sibilleurs, éclateurs, croasseurs, froufrouteurs…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a72832f-ff71-46eb-a6ec-b3c0e2a27866",
                        "source_entry_id": "84923dce-f818-30cc-93e2-b3bb13f21915",
                        "source_sense_id": "df8c5632-c9c4-33bb-aaa8-03dd5a075016",
                        "source_sense_description": "Bruiteur",
                        "target_lang_word": "buzzer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buzzer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "One who, or that which, buzzes; an insect that buzzes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1eb639-1c19-4bc9-ad6c-2c627440997f",
                                                "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                                "text": "And wants not buzzers to infect his ear / With pestilent speeches of his father's death."
                                            },
                                            {
                                                "example_id": "d0540d76-ff42-4ce1-bd68-19b824b1e33f",
                                                "sense_id": "c66aeb3f-13bc-3e0b-ac53-012cc661ff9e",
                                                "text": "... it left, however, a bee at his ear and an itch to transfer the buzzer's attentions and tease his darling; for she had betrayed herself as right good game."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A device that makes a buzzing sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b527ea1a-ff0c-4d29-b3c8-63e19b355405",
                                                "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                                "text": "If you think you know the answer to the question, hit the buzzer as fast as you can."
                                            },
                                            {
                                                "example_id": "a53bb444-6af1-4744-bcb6-1e698f7d488b",
                                                "sense_id": "41091420-ce70-3d1b-aed2-0863928f4a78",
                                                "text": "If a train enters the forward section before its description has been transmitted, a \"not described\" lamp is illuminated on the transmitter, an alarm buzzer is sounded, and the lamp remains alight until a description has been transmitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d211a4d1-9681-3837-affc-2e389d88b088",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A police badge."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29ecc8d9-6ac4-4a66-954c-a32dd9137831",
                                                "sense_id": "d211a4d1-9681-3837-affc-2e389d88b088",
                                                "text": "I flipped my wallet open on her desk and let her look at the buzzer pinned to the flap."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "590ad0d9-2196-3069-abf7-667294ecbf49",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A run scored from an overthrow."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c3332e8a-3f9d-3f4e-b826-4ac35e0c935c",
                                        "entry_id": "bf101cbf-8dc5-34d0-af7a-d3635286a31c",
                                        "glosses": [
                                            "A gossip."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66531c07-9104-4441-8644-5d5a863ebaeb",
                                                "sense_id": "c3332e8a-3f9d-3f4e-b826-4ac35e0c935c",
                                                "text": "Her brother is in secret come from France,\nFeeds on this wonder, keeps himself in clouds\nAnd wants not buzzers to infect his ear\nWith pestilent speeches of his father's death."
                                            }
                                        ]
                                    }
                                ]
