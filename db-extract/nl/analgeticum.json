                                ]
                            },
                            {
                                "target_word": "analgesic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83a445de-8bcd-3853-a6a1-667ec019857a",
                                        "entry_id": "58154897-9c97-35f4-9090-f9a8115544c2",
                                        "glosses": [
                                            "Of or relating to analgesia; anodyne.",
                                            "Acting to relieve pain; being an analgesic."
                                        ],
                                        "tags": [
                                            "of medicine"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95919401-13dd-353e-bc8b-39ab49717458",
                                        "entry_id": "58154897-9c97-35f4-9090-f9a8115544c2",
                                        "glosses": [
                                            "Of or relating to analgesia; anodyne.",
                                            "Unable to feel pain."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75358d03-f567-4486-8537-e808ae6be748",
                                                "sense_id": "95919401-13dd-353e-bc8b-39ab49717458",
                                                "text": "With the exception of the foot and a small area over the malar bone, the entire left side of the body is analgesic and anaesthetic. This extends to the exact median line of the body, including the left half of the tongue, nose and chin, […]"
                                            },
                                            {
                                                "example_id": "1d8ef493-f08c-4481-9ff5-787afc2db4ac",
                                                "sense_id": "95919401-13dd-353e-bc8b-39ab49717458",
                                                "text": "(I find that he is analgesic and anaesthetic; evidently he is in a state of passive somnambulism.)\nE. A. Did you feel anybody touch you?\nK. No. There's no one near me. (He continues laughing and talking. […])"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4cb2765-b67a-476d-9a01-2f993b2ea7df",
                        "source_entry_id": "3d95801c-8e36-335b-9aa7-1c41392fa814",
                        "source_sense_id": "feefb353-8add-3ed5-aa21-e9597ef839d8",
                        "source_sense_description": "een pijnstiller",
                        "target_lang_word": "analgésique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analgésique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "332729ed-f519-38e5-9126-f31f96a8597d",
                                        "entry_id": "b48c90c3-a39f-36e8-be7d-7c92a11b0665",
                                        "glosses": [
                                            "Qui produit l’analgésie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62cf09ba-ca97-4d88-8bf4-f8c95d86141c",
                                                "sense_id": "332729ed-f519-38e5-9126-f31f96a8597d",
                                                "text": "Lorsque ce bilan est rapide et la lésion causale facilement accessible ( pulpite, desmodontite… ) celle-ci n’appelle qu’une thérapeutique locale. Dans un cas contraire la thérapeutique analgésique est habituellement inévitable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "analgésique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                        "entry_id": "c70d107a-4517-3836-b327-d59722138fcc",
                                        "glosses": [
                                            "Médicament utilisé pour calmer la douleur."
                                        ],
                                        "tags": [
                                            "Pharmacie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c466f196-302c-4d04-8b92-9b21ccbf73f2",
                                                "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                                "text": "L’antipyrine est très employée comme analgésique et hémostatique."
                                            },
                                            {
                                                "example_id": "345c0d8b-968a-4968-b160-17d19cb7051c",
                                                "sense_id": "25db7da4-0b60-3783-8c51-3381a077084e",
                                                "text": "C’est à l’origine un sédatif et anesthésiant pour animaux hyperpuissant. Mais la xylazine est aujourd’hui, aux États-Unis, vendue mélangée à un analgésique de synthèse, le fentanyl, qui, utilisé seul, était déjà considéré par l’agence fédérale dédiée à la prévention des risques sanitaires comme « cinquante fois plus fort que l’héroïne». Le cocktail des deux, appelé «zombie drug» ou «tranq dope », est donc pire encore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
