                        "glosses": [
                            "Person, die per Telefon Produkte zu verkaufen versucht, telefonisch Verkaufsangebote macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b517adf-275c-486b-b162-61bfc1bef2a5",
                                "sense_id": "1fd81ce6-900e-3bf7-98eb-6641fb3caefb",
                                "text": "„Unter der Decke herumgondelnd erklärt sie, seit sie ein kleines Mädchen war und auf jenem Bauernhof auf dem Land Unkraut gejätet und Teppiche ausgeklopft hat, werde sie regelmäßig von einem Telefonverkäufer angerufen, der ihr die Zukunft voraussage.“"
                            }
                        ],
