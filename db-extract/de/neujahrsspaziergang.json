                ],
                "senses": [
                    {
                        "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                        "entry_id": "99b22151-adad-3212-87f3-7cb554e50c37",
                        "glosses": [
                            "Spazierengehen am ersten Tage eines neuen Jahres"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41c02f56-a8e3-4003-8405-719264f973a7",
                                "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                                "text": "„Dieses Jahr war sie mit ihrem Neujahrsspaziergang spät dran, weil sie eine Silvesterparty besucht hatte.“"
                            },
                            {
                                "example_id": "c1857bcb-b674-4d3d-a818-1b347f8dc4d5",
                                "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                                "text": "„Es war ein sonniger Morgen, und man entschloss sich dazu, einen Neujahrsspaziergang zu machen.“"
                            },
                            {
                                "example_id": "86df2497-d971-455e-9e5d-ce00362b3c0d",
                                "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                                "text": "„Und wie meine Eltern immer einen Neujahrsspaziergang machen, mache auch ich immer meine Neujahrsfahrt.“"
                            },
                            {
                                "example_id": "b9ec234c-10a6-4e4e-8802-b893aba6e312",
                                "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                                "text": "„Er nahm sich zwei große Beutel und startete einen sehr frühen Neujahrsspaziergang.“"
                            },
                            {
                                "example_id": "af2eac85-ed10-42da-af24-83b019a3fd28",
                                "sense_id": "b29235dd-2049-3a62-91fa-209c04f975a0",
                                "text": "„Nach einem nächtlichen Neujahrsspaziergang durch die schlafende Stadt machte ich mir in Omas Küche einen Viertelliter Glühwein heiß, um meine Neuronen in den Schlaf zu schicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
