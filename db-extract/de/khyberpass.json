                                    {
                                        "sense_id": "3b535d29-b6c3-3f43-aaac-a207aa6021fb",
                                        "entry_id": "ca4cb26e-58a0-34be-b9f7-96c9fdc988c9",
                                        "glosses": [
                                            "A mountain pass connecting Pakistan and Afghanistan of great strategic and historical importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b002356-1e2e-46a8-bdb2-657b6df0a7c1",
                                                "sense_id": "3b535d29-b6c3-3f43-aaac-a207aa6021fb",
                                                "text": "Bab-e-Khyber is the name of the fortified arch, inaugurated with great pomp in 1963 by Pakistan's former military ruler Field Marshal Muhammad Ayub Khan, that today bridges the road entrance to the Khyber Pass."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Khyber Pass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd2d4a1-6a00-3625-9c98-7d2bcf3b93b1",
                                        "entry_id": "58a3e60b-c918-3c7c-9e80-3cf99921eb57",
                                        "glosses": [
                                            "The arse."
                                        ],
                                        "tags": [
                                            "Cockney",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
