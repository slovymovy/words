                        "entry_id": "23b85df9-c498-3dd6-ae89-314ad26e6b98",
                        "glosses": [
                            "Phrase ou vers composé de mots commençant tous par la même lettre."
                        ],
                        "tags": [
                            "Versification"
                        ],
                        "examples": [
                            {
                                "example_id": "77b9b23d-0fcf-40e4-8e47-7426d83ce6b9",
                                "sense_id": "8798d401-e209-3118-a6c7-a504a4f5d801",
                                "text": "« Mazarin Ministre malade meditoit, même moribond, malicieusement mille maltôtes », est un 'tautogramme'"
                            },
                            {
                                "example_id": "f9a1bebd-6ef8-4f53-9271-e59378475d07",
                                "sense_id": "8798d401-e209-3118-a6c7-a504a4f5d801",
                                "text": "« Triste, transi, tout terni, tout tremblant » est un tautogramme."
                            },
                            {
                                "example_id": "7984afc3-7e77-48e7-81aa-26c629d27b1e",
                                "sense_id": "8798d401-e209-3118-a6c7-a504a4f5d801",
                                "text": "« Sombre, songeant, sans sûre soutenance » est un tautogramme."
                            },
                            {
                                "example_id": "147d8a9e-9a49-48af-bd36-d0d958d3b608",
                                "sense_id": "8798d401-e209-3118-a6c7-a504a4f5d801",
                                "text": "« Ce cher Charles caresse ce chat câlin » est un tautogramme."
                            }
                        ]
                    }
