                "forms": [],
                "senses": [
                    {
                        "sense_id": "510c69ee-4ae1-3b12-92d0-93f043ffd6c0",
                        "entry_id": "f8769b28-f0e4-3a6c-b85c-088e00e2421c",
                        "glosses": [
                            "heel vreemd doen (door een verkeerde reactie op drugs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19567ab3-71cb-4f3e-8a0b-25cf3ddc83c6",
                                "sense_id": "510c69ee-4ae1-3b12-92d0-93f043ffd6c0",
                                "text": "De geflipte junk dacht te kunnen vliegen na het gebruik van cocaïne."
                            },
                            {
                                "example_id": "3fc4b33b-5457-48f4-aefc-69d3f4e3fc07",
                                "sense_id": "510c69ee-4ae1-3b12-92d0-93f043ffd6c0",
                                "text": "De geflipte patiënt kon alleen met sterk werkzame medicamenten weer rustig gekregen worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "7691cf0b-a012-325c-af06-7129d143a141",
                        "entry_id": "f8769b28-f0e4-3a6c-b85c-088e00e2421c",
                        "glosses": [
                            "mislukt, teleurgesteld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2416f29-b1d0-4337-830a-47cb74cdfcc1",
                                "sense_id": "7691cf0b-a012-325c-af06-7129d143a141",
                                "text": "Waarschijnlijk een geflipte doctorandus die niet aan de slag kwam, maar wel wist hoe je bij de nationale subsidiepot moet komen en toen maar gauw de broodnodige stichting heeft opgericht. Daarna heeft hij op het Ministerie van Onderwijs uitgelegd wat voor drama's zich afspelen in de gezinnen van de geschudde leraren en toen was de opdracht een feit."
                            }
                        ]
                    }
