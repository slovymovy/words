                        "sense_id": "03b0365c-94b3-3cf6-8e47-a07f4d212af4",
                        "entry_id": "3e7e65dd-0271-37da-861a-d020f91f7d91",
                        "glosses": [
                            "To surpass in rocking (thrilling or exciting, especially with rock music)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3f1a0f07-4bc1-4947-84e0-2402b28bc14b",
                                "sense_id": "03b0365c-94b3-3cf6-8e47-a07f4d212af4",
                                "text": "Love vows to outrock the cooler-than-thou swish kids — and succeeds — chanting \"Gabba-gabba baby\" and \"Shut up!\" until there's a puddle of sweat on the floorboards."
                            },
                            {
                                "example_id": "c3eabd29-4fd8-4f28-a6a1-c3fc7e3f5fd7",
                                "sense_id": "03b0365c-94b3-3cf6-8e47-a07f4d212af4",
                                "text": "Two songs Merle wrote when he was a teenager manage to outrock anything he'd yet recorded."
                            },
                            {
                                "example_id": "db747ab7-7873-423f-a780-72cd68cc5207",
                                "sense_id": "03b0365c-94b3-3cf6-8e47-a07f4d212af4",
                                "text": "There's always another fame-hungry band ready to outrock you and steal your fans. God knows we've taken enough breaks and cancelled enough shows to leave half our fans pissed off."
                            }
                        ]
                    }
