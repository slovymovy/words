                                "target_senses": [
                                    {
                                        "sense_id": "7c1afb13-a112-3a44-a1dc-8206cd982ee6",
                                        "entry_id": "300bf7e5-4e31-3a96-904b-6c39d20b2f44",
                                        "glosses": [
                                            "etwas auf seine Richtigkeit überprüfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9328820a-4239-47d7-81e5-c71ec2c7be30",
                                                "sense_id": "7c1afb13-a112-3a44-a1dc-8206cd982ee6",
                                                "text": "„Sämtliche Rechnungen sind von mir eingehend revidiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcfda599-2578-329b-892c-095cd0ab02e4",
                                        "entry_id": "300bf7e5-4e31-3a96-904b-6c39d20b2f44",
                                        "glosses": [
                                            "etwas Falsches verbessern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d26ccfda-e069-4aa3-993e-06762a8b90bc",
                                                "sense_id": "fcfda599-2578-329b-892c-095cd0ab02e4",
                                                "text": "Die Daten waren falsch und mussten revidiert werden."
                                            },
                                            {
                                                "example_id": "ee98dee4-18b4-42fb-b870-bdeef1e62920",
                                                "sense_id": "fcfda599-2578-329b-892c-095cd0ab02e4",
                                                "text": "„Die ursprünglichen Annahmen von der Ähnlichkeit des Skelettbaus von Homo habilis zum modernen Menschen mußten stark revidiert werden.“"
                                            },
                                            {
                                                "example_id": "bdb69db7-8414-4f5d-837f-dae446746309",
                                                "sense_id": "fcfda599-2578-329b-892c-095cd0ab02e4",
                                                "text": "„Für Nehru war China eine anti-imperialistische Macht. Er hatte diese Einschätzung auch nicht revidiert, als China Tibet besetzte, und hatte 1954 einen Vertrag mit China geschlossen, in dem er Tibet als chinesisches Gebiet anerkannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9682ab91-a6c2-3783-9e17-ca71a56ad13e",
                                        "entry_id": "300bf7e5-4e31-3a96-904b-6c39d20b2f44",
                                        "glosses": [
                                            "überholen, wieder instand setzen"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c50be7b-a47b-441b-8520-c8499c69b914",
                                                "sense_id": "9682ab91-a6c2-3783-9e17-ca71a56ad13e",
                                                "text": "Das Auto muss nächstes Jahr beim Garagisten revidiert werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
