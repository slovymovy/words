                            {
                                "target_lang_word": "застроенный",
                                "target_lang_sense_clarification": "покрытый строениями"
                            },
                            {
                                "target_lang_word": "благоустроенный",
                                "target_lang_sense_clarification": "о парках или зонах отдыха"
                            }
