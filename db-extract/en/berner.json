                "senses": [
                    {
                        "sense_id": "a06e26c6-ba02-3e62-8b9b-ad40d1a25425",
                        "entry_id": "3634964e-a38e-38dd-a818-912e2364b829",
                        "glosses": [
                            "A supporter of Bernie Sanders."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "7f3a8a49-7b16-4fd6-9fc3-11a9fd0301ad",
                                "sense_id": "a06e26c6-ba02-3e62-8b9b-ad40d1a25425",
                                "text": "Leaving City Hall with a smile, he mirrored the Berner’s excitement, but for Hillary. “She has the strongest record,” he said."
                            },
                            {
                                "example_id": "633815bc-6ba3-4248-99d2-5396010af891",
                                "sense_id": "a06e26c6-ba02-3e62-8b9b-ad40d1a25425",
                                "text": "Nick Merrill, Clinton’s press secretary, issued this response on Twitter, citing the words of Mike Casca, Sanders’ deputy communications director and a “die-hard” Berner."
                            },
                            {
                                "example_id": "7db49182-03b7-452b-b0db-31420e7f8425",
                                "sense_id": "a06e26c6-ba02-3e62-8b9b-ad40d1a25425",
                                "text": "Some, like the Indivisible network that has spawned more than 5,000 chapters nationwide, have tapped into the same organizational formula the Berners did."
                            },
                            {
                                "example_id": "4bd1ab93-4030-40b8-a6cd-e12d7e6afa67",
                                "sense_id": "a06e26c6-ba02-3e62-8b9b-ad40d1a25425",
                                "text": "\"We have almost enough Berners to hold the majority. It's real close,\" he said."
                            }
                        ]
                    }
                ],
