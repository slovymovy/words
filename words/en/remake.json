                            },
                            {
                                "target_lang_word": "nueva versión",
                                "target_lang_sense_clarification": "para objetos o conceptos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1176dcfb-3b81-3715-bad1-50ad644c74d3",
                    "sense_definition": "To make something again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will need to <w>remake</w> the cake because it burned.",
                            "target_lang_translations": {
                                "ru": "Тебе придется <w>переделать</w> торт, так как он сгорел.",
                                "zh": "蛋糕烤糊了，你得<w>重做</w>一个。",
                                "es": "Tendrás que <w>rehacer</w> el pastel porque se quemó."
                            }
                        },
                        {
                            "text": "She had to <w>remake</w> her bed after sitting on it.",
                            "target_lang_translations": {
                                "ru": "Ей пришлось <w>перестелить</w> постель после того, как она на ней посидела.",
                                "zh": "她坐过床之后，不得不<w>重新整理</w>床铺。",
                                "es": "Ella tuvo que <w>volver a hacer</w> su cama después de sentarse en ella."
                            }
                        }
