            "senses": [
                {
                    "sense_id": "6069e162-2ce0-3a8a-80d1-b4a52f2f4ff5",
                    "sense_definition": "decydować o zrobieniu czegoś, powziąć konkretny zamiar lub plan",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "decyzja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Każdego roku w styczniu <w>postanawiam</w> zdrowiej się odżywiać i regularnie biegać rano.",
                            "target_lang_translations": {
                                "ru": "Каждый год в январе я <w>решаю</w> питаться более здоровой пищей и регулярно бегать по утрам."
                            }
                        },
                        {
                            "text": "Mój brat długo myśli nad przyszłością, po czym <w>postanawia</w> zmienić pracę na lepszą.",
                            "target_lang_translations": {
                                "ru": "Мой брат долго думает о будущем, после чего <w>принимает решение</w> сменить работу на более хорошую."
                            }
                        }
                    ],
                    "synonyms": [
                        "decydować",
                        "decydować się",
                        "planować"
                    ],
                    "common_phrases": [
                        "postanawiać zmienić",
                        "postanawiać zacząć"
                    ],
                    "target_lang_definitions": {
                        "ru": "принимать решение что-либо сделать, иметь твёрдое намерение или план"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решать",
                                "target_lang_sense_clarification": "принимать решение о своих действиях"
                            },
                            {
                                "target_lang_word": "принимать решение",
                                "target_lang_sense_clarification": "делать выбор в пользу какого-либо действия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82b724a4-f6aa-3e2b-baa3-518cd55820bb",
                    "sense_definition": "wydawać oficjalne orzeczenie, uchwałę, nakaz lub zakaz drogą urzędową",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prawo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po zapoznaniu się ze sprawą sąd <w>postanawia</w> odrzucić wniosek obu stron.",
                            "target_lang_translations": {
                                "ru": "Ознакомившись с делом, суд <w>постановляет</w> отклонить ходатайство обеих сторон."
                            }
                        },
                        {
                            "text": "Rada miejska często <w>postanawia</w> o wprowadzeniu nowych przepisów drogowych.",
                            "target_lang_translations": {
                                "ru": "Городской совет часто <w>постановляет</w> ввести новые правила дорожного движения."
                            }
                        }
                    ],
                    "synonyms": [
                        "decydować"
                    ],
                    "common_phrases": [
                        "sąd postanawia"
                    ],
                    "target_lang_definitions": {
                        "ru": "выносить официальное решение, постановление, распоряжение или указ"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "постановлять",
