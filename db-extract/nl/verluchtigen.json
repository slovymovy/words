                        "glosses": [
                            "met plaatjes aantrekkelijker maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb68ba1-336b-4c71-8466-747c0a85205a",
                                "sense_id": "9149198d-75f9-3f52-9f35-de65e4a73fa5",
                                "text": "Elke periode kent vier kernthema’s: ruimtelijke ordening, sociaaleconomische ontwikkeling, geschiedenis van politiek en bestuur, bevolking en levensstijl. Vierhonderd foto’s verluchtigen de verhalen en moeten een levendig beeld schetsen van Enschede’s geschiedenis."
                            },
                            {
                                "example_id": "1e6559dc-351f-403b-a164-d9edf84a5118",
                                "sense_id": "9149198d-75f9-3f52-9f35-de65e4a73fa5",
                                "text": "Om hun avonturen te verluchtigen, maken ze gebruik van een toverlantaarn, met elf oude afbeeldingen van de stad."
                            }
                        ]
                    }
