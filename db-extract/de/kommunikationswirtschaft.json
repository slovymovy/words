                "senses": [
                    {
                        "sense_id": "0b57db64-1969-36e1-8920-55cc22869755",
                        "entry_id": "0310d1be-c5cf-3a2f-a577-334a2de1e969",
                        "glosses": [
                            "Wirtschaftszweig, der sich mit Kommunikation im Hinblick auf praktische wirtschaftliche Zwecke (Werbung, Vertrieb, Vermarktung, Öffentlichkeitsarbeit, Unternehmenskultur und Ähnliches) beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c121125-278f-47b1-a6f1-a5878b692598",
                                "sense_id": "0b57db64-1969-36e1-8920-55cc22869755",
                                "text": "„Der Grund für ein Ansinnen dieser Art liegt auf der Hand, denn die Kommunikationswirtschaft wird durch das Versteigerungsverfahren gleich in doppelter Weise belastet: Neben einem massiven Entzug von Finanzmitteln durch die immensen Lizenzkosten müssen die Unternehmen anschließend weitere Milliarden für den Auf- und Ausbau geeigneter Infrastrukturen investieren.“"
                            }
                        ],
