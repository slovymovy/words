                "senses": [
                    {
                        "sense_id": "12e68bb3-a3a8-34b4-b910-fa08dc39ae10",
                        "entry_id": "88531cbd-d4b4-3ce3-8a87-4b99cedc9892",
                        "glosses": [
                            "Tuer à coup de pistolet."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "11bac6f0-2b7f-4f32-b630-89af5d39a1ce",
                                "sense_id": "12e68bb3-a3a8-34b4-b910-fa08dc39ae10",
                                "text": "On a pistolé ce cavalier."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2d789b1-4432-36dc-a65a-0eebbc0c3396",
                        "entry_id": "88531cbd-d4b4-3ce3-8a87-4b99cedc9892",
                        "glosses": [
                            "Appliquer (de la peinture, de la mousse…) avec un pistolet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8974fcd7-62c3-456c-9af8-5a9924b28968",
                                "sense_id": "c2d789b1-4432-36dc-a65a-0eebbc0c3396",
                                "text": "Bon on suppose maintenant que la surface est nickel et prête à peindre : pistoler une couche de peinture, attendre 5 minutes, pistoler une deuxième, attendre 1/4 heure, pistoler une troisième, ainsi de suite, jusque 6/7 couches, en augmentant chaque fois le temps d'attente entre couche, pour que la peinture \"prenne\" avant de pistoler la suivante."
                            },
                            {
                                "example_id": "5184ddb1-fff4-4986-bb17-4e570e51f105",
                                "sense_id": "c2d789b1-4432-36dc-a65a-0eebbc0c3396",
                                "text": "Il apporte des conseils sur les méthodes de préparation des surfaces à peindre et sur la manière de pistoler la peinture dans les meilleures conditions."
                            },
                            {
                                "example_id": "be176ce7-c4b2-49e1-a4cd-cf4f6d52dd09",
                                "sense_id": "c2d789b1-4432-36dc-a65a-0eebbc0c3396",
                                "text": "Pistoler la mousse dans le joint ou le vide ventilé."
                            }
                        ]
                    }
                ],
