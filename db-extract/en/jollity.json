                        "translation_id": "74286bb3-a4e7-4c24-bcd6-2fc800ce95d4",
                        "source_entry_id": "189c9be3-a875-3ad7-9750-cb5db0e2ca0d",
                        "source_sense_id": "155addb0-c74d-38e1-b31e-e53d3fea7f57",
                        "source_sense_description": "Fröhlichkeit",
                        "target_lang_word": "Fröhlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fröhlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                        "entry_id": "bf264646-eeca-3a4e-b1ad-37f1c4f8bd9d",
                                        "glosses": [
                                            "Zustand, Stimmung einer Person oder Gruppe voller erkennbarer Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17cf35cf-c8d0-4521-a5ea-40d01854e1f3",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "Ihre Fröhlichkeit wirkte auf alle anderen ansteckend."
                                            },
                                            {
                                                "example_id": "e08ccdd2-c7b1-4e28-8ce5-ffb261643579",
                                                "sense_id": "64d89ccd-5ad5-3181-a8cb-466e4745d28d",
                                                "text": "„In diesem Augenblick trat die Sonne völlig aus den Wolken heraus, und der kraftvolle Schall des einzelnen Schusses und der Glanz der hellen Sonne flossen für alle zu einem einzigen Eindruck von Kühnheit und Fröhlichkeit zusammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ffbf6f-27df-4d37-b7df-b2bfc8bb9497",
                        "source_entry_id": "189c9be3-a875-3ad7-9750-cb5db0e2ca0d",
                        "source_sense_id": "8ebf361a-a478-362f-b92c-0aeecc4d1dce",
                        "target_lang_word": "Fest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                        "entry_id": "d409651f-8cfc-3bdc-a6ca-24575bb837c3",
                                        "glosses": [
                                            "größere Feier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6decffe8-7489-4977-982c-de3c4e009812",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "Wir feiern heute ein Fest."
                                            },
                                            {
                                                "example_id": "3ce9a780-8229-4029-a9f3-ced04effc536",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Weihnachten ist das Fest der Familie.“"
                                            },
                                            {
                                                "example_id": "6a9c41a5-717b-405b-9c73-a0910b3ddd3a",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Deshalb ist dieses Fest das vielleicht wichtigste überhaupt.“"
                                            },
                                            {
                                                "example_id": "681e6c94-1e39-45f2-bcdb-cfdfbff1d7f9",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Ein Fest ohne Festessen verdient seinen Namen nicht, es ist zum Scheitern verurteilt.“"
                                            },
                                            {
                                                "example_id": "f2f70d30-1f3e-48af-9510-10b0127a146a",
                                                "sense_id": "31fda60e-77e8-3448-9c17-1239917ebd86",
                                                "text": "„Erst die Reformation machte dem Fest ein Ende.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
