                ],
                "senses": [
                    {
                        "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                        "entry_id": "8c631273-28cd-3a95-aea5-fdf10646864a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81daf6ad-24b6-4a17-b2e4-dd557a9271fb",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Frau Fäustle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "14334cf8-1075-4e47-9adc-dbfe3f456191",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Herr Fäustle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "29e957b0-102f-4faa-bc5f-ff6fe6bcd9a6",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Die Fäustles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7784966c-f6f1-4ef5-b870-111a380dee2c",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Der Fäustle trägt nie die Schals, die die Fäustle ihm strickt."
                            },
                            {
                                "example_id": "296fed57-5f6a-4aa7-8e31-6b0a612e49fc",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Fäustle kommt, geht der Herr Fäustle.“"
                            },
                            {
                                "example_id": "5512cf6c-de19-4240-8720-4a4a6ffa99b9",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Fäustle kommt und geht."
                            },
                            {
                                "example_id": "a9e07fae-424d-4ce7-a62e-9c19b8b6effc",
                                "sense_id": "3597b23c-bffa-314a-a914-b7e4f6c15af6",
                                "text": "Fäustles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
