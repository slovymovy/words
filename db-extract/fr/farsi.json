                                            {
                                                "example_id": "72fccbdb-7cb2-40ef-bfc6-67f58f2fa4b6",
                                                "sense_id": "5b31c1b6-be51-3f9a-baca-8832e728f573",
                                                "text": "The resulting Belter creole is a crazy mix of English, Chinese, romance languages like French, German, Persian, Hebrew, Zulu, and a few other surprises. Farmer says he has over 1,000 Belter words in his personal dictionary, and he keeps adding more as the show’s producers and fans request them."
                                            }
                                        ]
                                    }
