                    "sense_definition": "Plural of <w>sow</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pig_animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In archaic texts, several adult <w>swine</w> grazed peacefully across the meadows.",
                            "target_lang_translations": {
                                "ru": "В старинных текстах несколько взрослых <w>свиноматок</w> мирно паслись на лугах."
                            }
                        },
                        {
                            "text": "The ancient farmer kept five <w>swine</w> penned alongside their new litters.",
                            "target_lang_translations": {
