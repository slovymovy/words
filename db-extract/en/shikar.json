                "senses": [
                    {
                        "sense_id": "779fd8d0-b1c0-3cba-9b87-434c26618791",
                        "entry_id": "2957d87a-cc30-3af4-8a1b-3053d71344b6",
                        "glosses": [
                            "Hunting, sport; a hunting expedition."
                        ],
                        "tags": [
                            "India",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6237b739-29e0-4118-b9f9-463079dc7231",
                                "sense_id": "779fd8d0-b1c0-3cba-9b87-434c26618791",
                                "text": "Where other men took ten days to the Hills, Strickland took leave for what he called shikar, put on the disguise that appealed to him at the time, stepped down into the brown crowd, and was swallowed up for a while."
                            },
                            {
                                "example_id": "0bffab20-19b0-4e52-b44a-7ab2b1818fc8",
                                "sense_id": "779fd8d0-b1c0-3cba-9b87-434c26618791",
                                "text": "They climbed up the ladder, and he mounted shikar fashion, treading first on the sharp edge of the heel and then into the looped-up tail."
                            }
                        ]
                    },
                    {
                        "sense_id": "63b8d442-78e4-31d9-8b33-c11020e61491",
                        "entry_id": "2957d87a-cc30-3af4-8a1b-3053d71344b6",
                        "glosses": [
                            "A hunt."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "af73d757-4531-43c5-9db4-207d54dde0fe",
                                "sense_id": "63b8d442-78e4-31d9-8b33-c11020e61491",
                                "text": "With us we had fifteen of the keenest and most cheerful hillman I have ever been associated with on a shikar."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a5284c1-2c33-3bd9-a05b-882b7e0e2b1b",
                        "entry_id": "2957d87a-cc30-3af4-8a1b-3053d71344b6",
                        "glosses": [
                            "Alternative form of shikari (“a hunter or tracker”)"
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cb30f7cc-7b61-40e8-b380-28d3209b1ee3",
                                "sense_id": "1a5284c1-2c33-3bd9-a05b-882b7e0e2b1b",
                                "text": "I became an immense favourite with the simple inhabitants of the country, who called me the Burra Feringhee Shikar, or great European hunter[.]"
                            }
                        ]
                    }
                ],
