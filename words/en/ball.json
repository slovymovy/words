                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "сленг, тысяча денежных единиц"
                            },
                            {
                                "target_lang_word": "косарь",
                                "target_lang_sense_clarification": "сленг, тысяча рублей или долларов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一千美元",
                                "target_lang_sense_clarification": "金额单位，指一千美元"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3293ac92-6871-3403-a622-80324d280bd1",
                    "sense_definition": "To form or wind something into the shape of a ball.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>balled</w> up the piece of paper and threw it in the trash.",
                            "target_lang_translations": {
