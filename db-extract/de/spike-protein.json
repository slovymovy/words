                ],
                "senses": [
                    {
                        "sense_id": "54b38a06-d16b-3330-b994-b7cf9a93e081",
                        "entry_id": "351dad9e-0aea-39ab-b1db-8fab682bc8ad",
                        "glosses": [
                            "Eiweißmolekül (Protein), das (wie eine hervorstehende Zacke) auf der Umhüllung eines Kerns/Virus sitzt und dazu dient, an Rezeptoren von Wirtszellen anzudocken"
                        ],
                        "tags": [
                            "Biochemie"
                        ],
                        "examples": [
                            {
                                "example_id": "5c98e2bf-6da5-47c2-bf9a-c41c23f14325",
                                "sense_id": "54b38a06-d16b-3330-b994-b7cf9a93e081",
                                "text": "Das Coronavirus SARS-CoV-2 ist in der Lage, mithilfe des Spike-Proteins der Virushülle an das menschliche Enzym ACE2 zu binden."
                            },
                            {
                                "example_id": "f6f3277c-2599-4f6d-a30a-50d82f55fd85",
                                "sense_id": "54b38a06-d16b-3330-b994-b7cf9a93e081",
                                "text": "„Corona heißt Krone und die Spike-Proteine sind sozusagen deren Zacken oder Spitzen. Sie bilden die Außenhülle des Virus.“"
                            },
                            {
                                "example_id": "9f33c079-1f03-4ac3-9f4f-a68a8f5b306a",
                                "sense_id": "54b38a06-d16b-3330-b994-b7cf9a93e081",
                                "text": "„Das Spike-Protein ist aber nicht nur die schärfste Waffe des Virus, es ist auch seine Achillesferse, denn seine exponierte Lage macht es zum bevorzugten Angriffspunkt für das Immunsystem. Antikörper können das Virus anhand des Spike-Proteins erkennen, daran binden und es so als Ziel für Immunzellen markieren.“"
                            },
                            {
                                "example_id": "44cbad6f-1439-4e4f-b43f-d647942e5348",
                                "sense_id": "54b38a06-d16b-3330-b994-b7cf9a93e081",
                                "text": "„Forscher des Max-Planck-Institutes in Frankfurt am Main hatten bereits Anfang April über eine Schutzmaßnahme des Virus berichtet. Sie erklärten, dass sich Sars-CoV-2 mit einem Schirm aus Zuckermolekülen am Spike-Protein vor dem Aufspüren des Immunsystems schützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
