                            {
                                "example_id": "84cd72f8-6cf6-4cc2-93c7-a54052a4cdc2",
                                "sense_id": "0c5a48d5-6ae1-3f0e-898a-b0fb0bb5032e",
                                "text": "Parlament Europejski zabronił stosowania rtęci w sfigmomanometrach i barometrach."
