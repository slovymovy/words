                    },
                    {
                        "form_id": "ea6cf48e-f041-4fdf-8019-cce101061771",
                        "entry_id": "c6748ec1-0d94-3e77-ade8-b41ea37922cd",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind monogen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06fbeafa-9023-3c7f-a35c-8b9d913a0832",
                        "entry_id": "c6748ec1-0d94-3e77-ade8-b41ea37922cd",
                        "glosses": [
                            "von nur einem einzigen/einzelnen Gen bestimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe50059-517c-4555-a2c1-1e958c36f38d",
                                "sense_id": "06fbeafa-9023-3c7f-a35c-8b9d913a0832",
                                "text": "„Bei keiner anderen monogenen Erkrankung sind die DNA-diagnostischen Möglichkeiten zum gegenwärtigen Zeitpunkt so effizient wie bei den Globingendefekten. “"
                            },
                            {
                                "example_id": "94638063-0f70-4fcf-b74f-13e9dc0c9669",
                                "sense_id": "06fbeafa-9023-3c7f-a35c-8b9d913a0832",
                                "text": "„Nach diesen Erläuterungen wende ich mich zur ungeschlechtlichen oder monogenen Zeugung und ihrem Verhältniss zum Generationswechsel.“"
                            },
                            {
                                "example_id": "448860a6-b9d8-4962-b4e8-08177bed3938",
                                "sense_id": "06fbeafa-9023-3c7f-a35c-8b9d913a0832",
                                "text": "„Einzelne Freilandweibchen dieser Art sind monogen, d. h. sie zeugen nur oder fast nur Weibchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a6a1523-813c-38b1-a984-70f33dba0b5b",
                        "entry_id": "c6748ec1-0d94-3e77-ade8-b41ea37922cd",
                        "glosses": [
                            "nur von einer einzigen Ursache abhängend, aus ein und der selben Art Gestein/Material bestehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7baa30-2384-42cd-8f7a-d222d05e6145",
                                "sense_id": "9a6a1523-813c-38b1-a984-70f33dba0b5b",
                                "text": "„Stammen alle Fragmente, oder doch die meisten, von ein und demselben Gestein ab, so nennt man es ein einfaches oder ein monogenes Gestein, dagegen ein gemengtes oder polygenes, wenn die Fragmente desselben von zwei oder mehreren verschiedenen Gesteinen abstammen.“"
                            },
                            {
                                "example_id": "f939de64-2dc1-47c2-b00e-c210da4fa454",
                                "sense_id": "9a6a1523-813c-38b1-a984-70f33dba0b5b",
                                "text": "„Sie sind monogen aus dem gleichen Material der grobkörnigen Pyroxen-Andesite zusammengesetzt.“"
                            },
                            {
                                "example_id": "e7ec7752-6f49-4646-9c4d-68ba2cf918f4",
                                "sense_id": "9a6a1523-813c-38b1-a984-70f33dba0b5b",
                                "text": "„Monogene Vulkane sind solche, die ihre Entstehung einem einmaligen Ausbruch verdanken. Das soll aber nicht etwa so zu verstehen sein, als ob ein monogener Vulkan in einem oder einigen Tagen oder Jahren aufgeschüttet sein muss.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
