                        "entry_id": "f999a406-c86c-3a78-80a0-f999fa409c6c",
                        "glosses": [
                            "Umgangsformen bei Tisch, genauer beim Einnehmen von Speisen und Getränken in Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7f0cd95-b195-4a41-ab0c-6990bcb5b696",
                                "sense_id": "13b575d5-75cb-3c93-b28c-6e50b691ae6a",
                                "text": "Bei strengen Tischmanieren wird nicht mit vollem Mund gesprochen."
                            },
                            {
                                "example_id": "469166f5-0b9a-4c59-bdf6-16be1afd9711",
                                "sense_id": "13b575d5-75cb-3c93-b28c-6e50b691ae6a",
                                "text": "„Alle anderen versuchten ihn einzuschüchtern, auch Lyells Frau Mary Horner Lyell, die Wallaces Tischmanieren ans Vulgäre grenzend gewöhnlich fand.“"
                            },
                            {
                                "example_id": "957781ca-6fed-4464-afdc-a02375762117",
                                "sense_id": "13b575d5-75cb-3c93-b28c-6e50b691ae6a",
                                "text": "„Seine Tischmanieren waren genau wie sein Anzughemd, das er frisch angezogen hatte und ohne Jackett trug, makellos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
