                                "target_senses": [
                                    {
                                        "sense_id": "0a786a94-d58e-3ee2-8bd5-7b57678031cf",
                                        "entry_id": "d59d48ea-bf02-373b-b3ac-18b75a159526",
                                        "glosses": [
                                            "A descending path or stairway to a river; a ford or landing-place."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "469746f5-fc36-4288-8e60-14d5597feb5c",
                                                "sense_id": "0a786a94-d58e-3ee2-8bd5-7b57678031cf",
                                                "text": "The abrupt escarpment of the western Ghats condenses so much of the moisture of the south-west monsoon"
                                            },
                                            {
                                                "example_id": "b92d9afb-9853-4544-b4a8-29fdbe310713",
                                                "sense_id": "0a786a94-d58e-3ee2-8bd5-7b57678031cf",
                                                "text": "Chunks of wood were being built into funeral pyres on the steps of the ghat that went down into the water; four bodies were burning on the ghat steps when we got there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b99eb421-97ed-350c-a338-6dbce108e4f2",
                                        "entry_id": "d59d48ea-bf02-373b-b3ac-18b75a159526",
                                        "glosses": [
                                            "A mountain range."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e10d5f78-3528-4493-a3bb-a7d6caddf798",
                                                "sense_id": "b99eb421-97ed-350c-a338-6dbce108e4f2",
                                                "text": "And farther south, in the interior of the Peninsula, in the elevated tract from 1200 to 2400 feet above the sea, between the Eastern and Western Ghats"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "869cbbe2-4d47-3bc3-bb6b-3636d1a568c4",
                                        "entry_id": "d59d48ea-bf02-373b-b3ac-18b75a159526",
                                        "glosses": [
                                            "A mountain pass."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b6f2f6f-2df6-3c65-89aa-d65655508816",
                                        "entry_id": "d59d48ea-bf02-373b-b3ac-18b75a159526",
                                        "glosses": [
                                            "A steep ravine leading to the sea."
                                        ],
                                        "tags": [
                                            "Caribbean"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f4324862-6ff9-37b8-9752-6c2f1518bb8c",
                                        "entry_id": "d59d48ea-bf02-373b-b3ac-18b75a159526",
                                        "glosses": [
                                            "A burning-ghat."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d582b5a-57b7-4b9d-b1c6-9e0966ad30dd",
                                                "sense_id": "f4324862-6ff9-37b8-9752-6c2f1518bb8c",
                                                "text": "On the steps of the Manikarnika ghat—the holiest of the city’s stepped riverbanks, upon which Hindu dead are cremated—the fires are already lit, and mourners assemble by the hundred to accompany their loved ones at the end."
                                            }
                                        ]
