                                "example_id": "6a098bef-aaf9-479f-a158-dd3b25179fed",
                                "sense_id": "2bc47ef4-3415-3743-aa78-15fe004dd9e9",
                                "text": "Happen we seen there was a damber in the ruffmans, and since we'd no yen t' deck the chates, we'd ha' binged a wast but for the rhino we was promised."
                            },
                            {
                                "example_id": "4bc16ace-2948-45c1-bd8d-e5103a9f1212",
                                "sense_id": "2bc47ef4-3415-3743-aa78-15fe004dd9e9",
                                "text": "Ben mort, shall you and I heave a bough, mill a ken, or nip a bung, and then we'll couch a hogshead under the ruffmans, and there you shall wap with me, and I'll niggle with you."
                            }
                        ]
                    }
