                        ],
                        "examples": [
                            {
                                "example_id": "53fb2c1a-435a-45c6-addd-2ae2afd1cea5",
                                "sense_id": "c46b2468-7435-3859-8bdd-48f0faf2c0a3",
                                "text": "He sees the soldiers, with their red coats lighted up by the torches carried afore, closing in round him."
