                                        "entry_id": "64086343-7982-3fa9-b9e4-dd0383a63789",
                                        "glosses": [
                                            "Lowly, vulgar; reprehensible; dishonest."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0769864-1447-4b96-b236-92020e4e7181",
                                                "sense_id": "c0ce2d34-1e87-3a01-9693-08dc1d2abe98",
                                                "text": "Oh what a Rogue and Pesant slave am I?"
