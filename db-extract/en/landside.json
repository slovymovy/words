                    },
                    {
                        "sense_id": "f34ffdd2-54cd-32e9-a2ec-96c25cb8fd45",
                        "entry_id": "bf514b09-5c03-3f3f-aecf-9661038699b0",
                        "glosses": [
                            "In the freely accessible area of an airport, outside of security, passport/immigration, and customs control."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4ab08a26-a597-4de0-a535-7cb34c5b1474",
                                "sense_id": "f34ffdd2-54cd-32e9-a2ec-96c25cb8fd45",
                                "text": "I had to remain landside because I did not have a boarding card."
                            },
                            {
                                "example_id": "e3d57800-2e6f-4aa0-ba9c-171e087f9e39",
                                "sense_id": "f34ffdd2-54cd-32e9-a2ec-96c25cb8fd45",
                                "text": "You can relax, or catch up with work, safe in the knowledge that it’s just a few yards to the gate, assuming the lounge is “airside” (not “landside”)."
                            },
                            {
                                "example_id": "e75b2bb6-41d0-4193-9f93-4f11e28bae24",
                                "sense_id": "f34ffdd2-54cd-32e9-a2ec-96c25cb8fd45",
                                "text": "The airside terminal building will be extended into the landside building, making one large structure, getting rid of the people mover and remodeling the gate areas. It should be completed in 2023."
                            }
                        ]
                    }
                ],
