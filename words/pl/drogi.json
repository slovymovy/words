                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "road_genitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nie znam tej <w>drogi</w>, więc muszę użyć mapy.",
                            "target_lang_translations": {
                                "ru": "Я не знаю этой <w>дороги</w>, поэтому должен воспользоваться картой.",
                                "de": "Ich kenne diesen <w>Weg</w> nicht, also muss ich eine Karte benutzen."
                            }
                        },
                        {
                            "text": "Zejdź mi z <w>drogi</w>, bo bardzo się spieszę.",
                            "target_lang_translations": {
                                "ru": "Уйди с моей <w>дороги</w>, я очень спешу.",
                                "de": "Geh mir aus dem <w>Weg</w>, denn ich habe es sehr eilig."
                            }
