                            {
                                "target_lang_word": "desire",
                                "target_lang_sense_clarification": "crave or covet (archaic)"
                            },
                            {
                                "target_lang_word": "covet",
                                "target_lang_sense_clarification": "strongly yearn for"
                            }
                        ]
                    }
                }
            ]
        },
