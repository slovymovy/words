                    }
                ],
                "senses": [
                    {
                        "sense_id": "a78888a7-4fab-3af8-b2b8-57f747c8f9ca",
                        "entry_id": "5237808e-42dd-3110-a0e8-f447197b028e",
                        "glosses": [
                            "Cépage noir, issu de Croatie, nommé officiellement primitivo sauf au Portugal, à Malte et en Italie où son nom officiel est zinfandel. Il donne des grappes à petits grains d'un noir bleuté. Il est très répandu en Californie et en Italie"
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "e245d0c9-9aff-4f57-be85-f21f8fbd3017",
                                "sense_id": "a78888a7-4fab-3af8-b2b8-57f747c8f9ca",
                                "text": "Propriétaire d'une pépinière viticole, le géologue américain George Gibbs fut le premier à importer d'Autriche, en 1820, des plants de zinfandel."
                            },
                            {
                                "example_id": "6fa387cb-08fe-460e-aeab-911a7b55f7eb",
                                "sense_id": "a78888a7-4fab-3af8-b2b8-57f747c8f9ca",
                                "text": "Le zinfandel est un cépage exotique d’origine Croate et principalement cultivé depuis les années 2000 en Californie, marquant une nouvelle tendance dans le secteur du vin américain."
                            },
                            {
                                "example_id": "28a9abd8-579d-4d6e-9623-135023235b32",
                                "sense_id": "a78888a7-4fab-3af8-b2b8-57f747c8f9ca",
                                "text": "Cépage vedette de Californie, le zinfandel est aussi un peu caméléon. Il peut donner des vins aux styles très différents, qui évoquent tour à tour le pinot noir, le gamay, voire le malbec ou le cabernet franc, et ce, au point de mystifier les dégustateurs les plus chevronnés."
                            }
                        ]
                    },
                    {
                        "sense_id": "d400ae11-ecf8-3f40-afb9-4ef0c6549a69",
                        "entry_id": "5237808e-42dd-3110-a0e8-f447197b028e",
                        "glosses": [
                            "Vin issu de ce cépage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff1db050-48ae-405e-b118-0a3a65e15422",
                                "sense_id": "d400ae11-ecf8-3f40-afb9-4ef0c6549a69",
                                "text": "Son succès fut tel que le white zinfandel est devenu le vin le plus vendu aux États-Unis pendant les décennies quatre-vingt et quatre-vingt-dix."
                            },
                            {
                                "example_id": "08859d99-a410-4998-9958-545b8f7606cb",
                                "sense_id": "d400ae11-ecf8-3f40-afb9-4ef0c6549a69",
                                "text": "Importation des crus français les plus renommés de Bourgogne et de Bordeaux, Vins de Californie, Zinfandel, Burgundy, Port Wine, Cherry, Muscatel, etc."
                            }
                        ]
                    }
                ],
