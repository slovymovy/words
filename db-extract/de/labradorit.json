                "senses": [
                    {
                        "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                        "entry_id": "7d09a0d5-658e-38e4-9e14-a6c0393b1f48",
                        "glosses": [
                            "Abart des Feldspats mit auffälligem Farbenspiel (meist in Blau-, Violett- oder Grüntönen), weshalb er auch gerne als Schmuckstein verwendet wird"
                        ],
                        "tags": [
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "811a7eb6-b0cb-4444-b86a-e90c2aa4161f",
                                "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                                "text": "„Labradorit bildet sich entweder magmatisch in Gabbros, Basalt und Anorthosit oder metamorph in Amphibolit.“"
                            },
                            {
                                "example_id": "b916ff12-4451-4bd4-83b1-34523c5878f4",
                                "sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
                                "text": "„Alle Ketten sind Unikate und von einer kleinen Kollektion mal abgesehen jeweils auf die Trägerin persönlich abgestimmt. Am Hals der Besitzerin entfalten Labradorit, Amazonit oder Bergkristall dann nicht nur ihre optische Wirkung: Die Steine fördern Energie und Wohlbefinden, Sinnlichkeit und Lebensfreude, Gesundheit und manchmal auch das Glück in der Liebe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e78ed8ea-6741-46e1-a368-a2d54c44989b",
                        "source_entry_id": "7d09a0d5-658e-38e4-9e14-a6c0393b1f48",
                        "source_sense_id": "c848adea-cdb4-3b66-bcfb-5ac1bf57a444",
