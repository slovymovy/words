                            }
                        },
                        {
                            "text": "The landlord promised to call an exterminator to eliminate the <w>roach</w> infestation.",
                            "target_lang_translations": {
                                "ru": "Арендодатель пообещал вызвать дезинсектора, чтобы избавиться от нашествия <w>тараканов</w>."
