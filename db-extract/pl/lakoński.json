                                        "glosses": [
                                            "De Laconie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bd844c-2f8a-4435-a211-c217ea563642",
                                                "sense_id": "9b5dc566-e173-3d65-bbb9-731fa8eeeb9c",
                                                "text": "Le dialecte laconien."
                                            },
                                            {
                                                "example_id": "e0d4ba42-4d4d-491a-9daf-e4e5e197dc24",
                                                "sense_id": "9b5dc566-e173-3d65-bbb9-731fa8eeeb9c",
                                                "text": "À la laconienne, de façon laconique, aussi brièvement que les Lacédémoniens."
                                            },
                                            {
                                                "example_id": "f7c98dca-1f63-4222-8e51-8733e662650b",
                                                "sense_id": "9b5dc566-e173-3d65-bbb9-731fa8eeeb9c",
                                                "text": "Molle harpe d’Ionie, flûte phrygienne, un peu folle, désordonnant le sévère appareil laconien du sport viril."
                                            }
                                        ]
                                    }
                                ]
                            },
