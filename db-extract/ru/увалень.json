                "senses": [
                    {
                        "sense_id": "227d3dd5-9adc-3958-90ad-d2b0421bb01a",
                        "entry_id": "af8709b8-52a8-3c83-a852-3280f692f6bf",
                        "glosses": [
                            "galoot, lubber, bumpkin, lazybones (clumsy or lazy person)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1426f4f7-465c-4ebf-a54f-2b9e3ec7da48",
                                "sense_id": "227d3dd5-9adc-3958-90ad-d2b0421bb01a",
                                "text": "Е́сли бы э́то бы́ли каде́ты, то он пря́мо сказа́л бы, что о них ду́мает. Но об э́тих у́вальнях не сто́ило говори́ть неприя́тной пра́вды челове́ку, от кото́рого зави́сели его́ уро́ки.",
                                "translation": "If they had been cadets he would have told them at once what he thought of them, but it was not worth while to tell the unpleasant truth about these sluggards to the man on whom these lessons depended.",
                                "english": "If they had been cadets he would have told them at once what he thought of them, but it was not worth while to tell the unpleasant truth about these sluggards to the man on whom these lessons depended."
                            }
                        ]
                    }
                ],
