                                "target_senses": [
                                    {
                                        "sense_id": "cf3e0514-44c8-3446-b0ef-346033ff3920",
                                        "entry_id": "61dbd8a8-c411-3b38-8456-3e69db11ba40",
                                        "glosses": [
                                            "hloupý člověk"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7544b4d7-e994-4058-97de-fc18082802c4",
                                                "sense_id": "cf3e0514-44c8-3446-b0ef-346033ff3920",
                                                "text": "On to nechápe, je to hňup."
                                            },
                                            {
                                                "example_id": "79173bf6-8cda-44d9-83ec-e05c17af2d44",
                                                "sense_id": "cf3e0514-44c8-3446-b0ef-346033ff3920",
                                                "text": "Takovýho hňupa aby pohledal!"
                                            },
                                            {
                                                "example_id": "542d8335-184c-4f3c-8f5c-17524161afaf",
                                                "sense_id": "cf3e0514-44c8-3446-b0ef-346033ff3920",
                                                "text": "Ty mysíš, že já su nejaký hňup – ty hňupe?!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25f8a49-253d-3f70-a0bc-807e3afde542",
                                        "entry_id": "61dbd8a8-c411-3b38-8456-3e69db11ba40",
                                        "glosses": [
                                            "kastrovaný kozel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa5042c-2c41-49ff-9bd2-444e6c0aefea",
                                                "sense_id": "e25f8a49-253d-3f70-a0bc-807e3afde542",
                                                "text": "Maso hňupa má slabší zápach."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
