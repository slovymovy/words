                    "semantic_group_id": "enlevement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les criminels voulaient <w>kidnapper</w> le fils du banquier pour exiger de l'argent."
                        },
                        {
                            "text": "Ils ont réussi à <w>kidnapper</w> un diplomate en plein centre-ville."
                        }
                    ],
                    "synonyms": [
