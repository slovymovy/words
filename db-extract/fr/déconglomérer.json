                "senses": [
                    {
                        "sense_id": "6f79a3ab-267d-3cb8-a0d7-f663e74189ca",
                        "entry_id": "bc89a739-7f0e-377b-9015-9b4b63af108b",
                        "glosses": [
                            "Faire perdre son caractère de conglomérat à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80ead8c5-510d-40e0-80fb-79fc60813626",
                                "sense_id": "6f79a3ab-267d-3cb8-a0d7-f663e74189ca",
                                "text": "Il croit que l’heure n’est plus aux conglomérats. Et que le rôle des grands raiders comme lui, c’est de « déconglomérer », comme il dit."
                            },
                            {
                                "example_id": "144827e3-38eb-40ea-b93b-171bfc8c4fbf",
                                "sense_id": "6f79a3ab-267d-3cb8-a0d7-f663e74189ca",
                                "text": "Il faudra donc profiter de la dénationalisation pour « déconglomérer » ces groupements."
                            },
                            {
                                "example_id": "01b7f7cd-1a93-4250-918f-66dc37adf8e3",
                                "sense_id": "6f79a3ab-267d-3cb8-a0d7-f663e74189ca",
                                "text": "Il faudrait, si je puis dire, \" déconglomérer \" un certain nombre de trop grandes entreprises."
                            }
                        ]
                    }
                ],
