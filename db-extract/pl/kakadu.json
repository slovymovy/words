                                    {
                                        "sense_id": "6b9e9853-77ad-30fe-ad61-0b6fa21f601f",
                                        "entry_id": "89093172-0592-3f6d-b4a1-68642b2c06a3",
                                        "glosses": [
                                            "Papagei mit aufstellbarer Federhaube"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "441b45fa-6743-43a9-a075-cf5196365524",
                                                "sense_id": "6b9e9853-77ad-30fe-ad61-0b6fa21f601f",
                                                "text": "Der Kakadu sitzt traurig im Käfig."
                                            },
                                            {
                                                "example_id": "bf2e4539-de78-42a0-a291-63e2621d8a43",
                                                "sense_id": "6b9e9853-77ad-30fe-ad61-0b6fa21f601f",
                                                "text": "„Am Tag nach Stellas Tod war Therese die Straße entlanggegangen und hatte dabei natürlich an ihre Mutter gedacht. Da flog auf einmal ein riesiger weißer Kakadu vor ihr herab, so nah, dass sie den Luftzug von seinen Flügeln spürte.“"
                                            },
                                            {
                                                "example_id": "da80cb9f-48b6-49a4-b67e-dab2c11aec9f",
                                                "sense_id": "6b9e9853-77ad-30fe-ad61-0b6fa21f601f",
                                                "text": "„Der Kakadu war so gelangweilt, daß er sie nicht einmal abschüttelte.“"
                                            },
                                            {
                                                "example_id": "fa125fb9-a2e9-4169-9bd8-ba7b90878a1b",
                                                "sense_id": "6b9e9853-77ad-30fe-ad61-0b6fa21f601f",
                                                "text": "„In den Zweigen veranstalteten farbenprächtige Kakadus einen Riesenspektakel, sonst zeigte sich kaum ein Lebewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
