                        "examples": [
                            {
                                "example_id": "4ee7ecd7-0177-48cf-a090-0ab3a36943bd",
                                "sense_id": "c44a9dc5-8360-369a-a6bb-d8363be7bf0b",
                                "text": "Eha ! le meuglement affolé des gogouas, ou bœufs sauvages, qui ruent, se bousculent et se précipitent, la queue droite, aveuglés qu’ils sont par la fumée et le crépitement des flammes."
                            },
                            {
                                "example_id": "7f1d27e9-9b42-4d93-9f49-ef111681d5ca",
                                "sense_id": "c44a9dc5-8360-369a-a6bb-d8363be7bf0b",
                                "text": "Le chef du village est venu me voir : « Ça ne peut plus durer! Il faut tuer ce gogoua. Cela va te faire de la peine, je le sais, mais chez nous personne n’ose plus sortir. »"
                            }
                        ]
                    }
