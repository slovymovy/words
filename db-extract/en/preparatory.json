                                "sense_id": "01f0710e-9463-33f5-b61e-62791e6eb5eb",
                                "text": "I will conduct some preparatory research before choosing the new restaurant's location."
                            },
                            {
                                "example_id": "016a72d9-0f1d-4f62-aaf9-38479846ed52",
                                "sense_id": "01f0710e-9463-33f5-b61e-62791e6eb5eb",
                                "text": "A butcher bird has stirred, tuned its flute with a few preparatory notes."
