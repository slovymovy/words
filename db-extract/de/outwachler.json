                        "examples": [
                            {
                                "example_id": "e7feeeb9-2b50-4e9d-9781-b73b355cfc88",
                                "sense_id": "797c3e24-437f-3ce4-b5e3-599625459f63",
                                "text": "„Das wird noch ein Nachspiel haben: Becher-Wurf gegen ‚Outwachler‘ gibt Strafe“"
                            },
                            {
                                "example_id": "799b4ae6-5978-466b-8b06-2f62a1e41486",
                                "sense_id": "797c3e24-437f-3ce4-b5e3-599625459f63",
                                "text": "„Im Gegensatz zu den Schiedsrichter-Assistenten an der Längsseite, vormals Outwachler, zeigen die Torrichter ein Vergehen nicht mit einer Fahne an, sondern können über eine Funkverbindung Kontakt zum Schiedsrichter aufnehmen.“"
                            }
                        ],
