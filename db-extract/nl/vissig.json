                "senses": [
                    {
                        "sense_id": "a963d769-03b1-3fdb-9906-d466a96c91db",
                        "entry_id": "a4fbd4a1-f1ee-34e9-921e-72c967e56082",
                        "glosses": [
                            "lijkend op vis of de smaak van vis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7809dbbc-e86f-4ebe-be0d-e5c006cb6661",
                                "sense_id": "a963d769-03b1-3fdb-9906-d466a96c91db",
                                "text": ",,Voor mij smaakt het als gewoon brood. Niet heel hartig of vissig. We wilden het zo toegankelijk mogelijk maken.’’"
                            },
                            {
                                "example_id": "d86a43c1-9cb2-4132-8b95-99162150e067",
                                "sense_id": "a963d769-03b1-3fdb-9906-d466a96c91db",
                                "text": "Dat komt doordat vissen koudbloedig zijn, wat wil zeggen dat hun hele vissige lijfje erop ingesteld is om te functioneren bij lage temperaturen. Ook de bacteriën en enzymen die op en in het vissenlijf rond krioelen voelen zich helemaal happy bij zulke lage temperaturen."
                            }
                        ]
                    }
