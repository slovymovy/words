                "senses": [
                    {
                        "sense_id": "380a7438-b66c-3c52-8899-882333077f45",
                        "entry_id": "3ce612c2-b244-36e1-8b46-6b0d6c92dc63",
                        "glosses": [
                            "große Wildkatze aus Nord- und Südamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19724d5f-5575-4d98-91f3-491b279129a6",
                                "sense_id": "380a7438-b66c-3c52-8899-882333077f45",
                                "text": "„Ich war nun überzeugt, dass ich durch meine Rufe ein wildes Tier, einen Berglöwen vielleicht, auf mich aufmerksam gemacht hatte, der zufällig in dieser Höhle umherstreunte.“"
                            },
                            {
                                "example_id": "14142175-ef45-436a-b3c4-e5ce384d2e2a",
                                "sense_id": "380a7438-b66c-3c52-8899-882333077f45",
                                "text": "„Bären rennen quer durch das Unterholz auf dich zu. Du kannst sie hören. Berglöwen' knurren.“"
                            },
                            {
                                "example_id": "56e12752-1b1a-4df1-bfb7-711ba442ee31",
                                "sense_id": "380a7438-b66c-3c52-8899-882333077f45",
                                "text": "„Dann gähnte er wie ein Berglöwe.“"
                            },
                            {
                                "example_id": "c0a60687-8690-45d6-a85e-be42b51d4ff4",
                                "sense_id": "380a7438-b66c-3c52-8899-882333077f45",
                                "text": "„›Ich will aber keinen Berglöwen und auch keinen Kojoten erschießen.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
