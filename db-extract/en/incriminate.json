                    {
                        "translation_id": "4aff4196-194e-4337-aac5-0ed41113cea9",
                        "source_entry_id": "eb04238a-c598-3bce-a8c1-f8230a0d4f3a",
                        "source_sense_description": "to indicate the guilt of",
                        "target_lang_word": "belasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "belasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                        "entry_id": "2c74492d-2933-351f-803e-93a5cec8e121",
                                        "glosses": [
                                            "bewirken, dass etwas eine störende oder schädliche Wirkung auf etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91f504cf-166a-42db-abff-eaf6995fd3f3",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "Deutschlands Verhältnis zu England, das seine Weltmachtsstellung auf See in Gefahr sah, war ohnehin durch den forcierten Ausbau der deutschen Kriegsflotte belastet."
                                            },
                                            {
                                                "example_id": "907c09bd-20ea-4128-9dbd-8297805a30e3",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "„Langfristig belasten werden die Stadt vor allem aber die hohen Reinigungskosten.“"
                                            },
                                            {
                                                "example_id": "d244c5b9-e63a-4229-8992-90410bee9909",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "Die Kostensteigerungen werden das Jahresergebnis der Gesundheit Nord (Geno) bis etwa 2030 mit jährlich rund drei Millionen Euro zusätzlich belasten."
                                            },
                                            {
                                                "example_id": "52013f4f-1c4d-4ab2-9d04-798e956f91c5",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "Muttermilch gilt als besonders gut für Säuglinge: Voll mit gesunden Inhaltsstoffen, körperwarm und natürlich. Doch nun zeigen Stichproben: Sie ist mit dem Unkrautvernichter Glyphosat belastet."
                                            },
                                            {
                                                "example_id": "9317e415-964c-4133-a583-ad2f3af86d3f",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "„Holzkohlen-Qualm belastet die Atemluft am Grill und in der Nachbarschaft mit Feinstaub und Ruß.“"
                                            },
                                            {
                                                "example_id": "f2458ca9-2d30-4825-a878-b5c8e6115734",
                                                "sense_id": "a6bd91f4-4a52-30ab-af22-a58424d2ab13",
                                                "text": "Laut einer Studie des Instituts für Bildungsmanagement und Bildungsökonomie fühlen sich 16 Prozent [der Schulleiter] stark belastet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39790a45-af29-31d1-a50d-b8db2881b823",
                                        "entry_id": "2c74492d-2933-351f-803e-93a5cec8e121",
                                        "glosses": [
                                            "jemandem Schuld zuschreiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5080e3a5-a1ff-46f8-a88a-b64d0812d419",
                                                "sense_id": "39790a45-af29-31d1-a50d-b8db2881b823",
                                                "text": "Der Angeklagte wurde durch die Zeugen schwer belastet."
                                            },
                                            {
                                                "example_id": "fe081dbe-7354-4661-8c11-27f1e5318145",
                                                "sense_id": "39790a45-af29-31d1-a50d-b8db2881b823",
                                                "text": "„Tom hatte Peter den Tathergang minutiös dargestellt und dabei auch Fabian Z. schwer belastet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "15486064-2687-3c7d-86ba-c98751d4430d",
                                        "entry_id": "2c74492d-2933-351f-803e-93a5cec8e121",
                                        "glosses": [
                                            "jemandem oder etwas eine Last durch finanzielle Mittel auferlegen"
                                        ],
                                        "tags": [
                                            "Geldwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ddff1b6-5353-4e14-879a-d0060db5e90a",
                                                "sense_id": "15486064-2687-3c7d-86ba-c98751d4430d",
                                                "text": "„So wie die Energiewende heute finanziert wird, werden ärmere Menschen stärker belastet als Besserverdiener.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
