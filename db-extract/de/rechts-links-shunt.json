                ],
                "senses": [
                    {
                        "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                        "entry_id": "1e124066-7b87-31b9-8f0c-2fabd4f9c4f9",
                        "glosses": [
                            "Kurzschlussverbindung zwischen dem pulmonalarteriellen und dem pulmonalvenösen Abschnitt des Kreislaufsystems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58890f17-2d88-4557-9959-d768fde67d46",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Bei den meisten Vitien mit Rechts-Links-Shunt bleiben die vorgeburtlich physiologischen Shunts bestehen, weil keine Druckumkehr nach Geburt erfolgt."
                            },
                            {
                                "example_id": "af795e35-2a5b-4caf-8440-ddc9705f7317",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Der intrapulmonale Rechts-Links-Shunt entspricht definitionsgemäß der Menge venösen Blutes, die sich ohne Aufsättigung in den Alveolarcapillaren dem arterialisierten Blute zumischt."
                            },
                            {
                                "example_id": "06f14968-ac7a-447f-9d84-a43d5582746a",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Der Rechts-Links-Shunt lässt sich in anatomische und physiologische Shunts einteilen."
                            },
                            {
                                "example_id": "15a908ab-17b5-474a-a4a5-3aa6d070fd3f",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Ein solcher Herzfehler ist üblicherweise charakterisiert durch das Vorliegen eines Ventrikelseptumdefektes mit reitender Aorta, Vergrößerung der rechten Herzkammer, pulmonaler Hypertonie und Rechts-Links-Shunt."
                            },
                            {
                                "example_id": "4d5be9b0-b612-42f5-854b-0f4048abbf3f",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Die REDUCE-Studie zeigt einen signifikanten Nutzen des PFO-Verschlusses bei Patienten unter 60 Jahren mit kryptogenem Schlaganfall und großem Rechts-Links-Shunt oder Vorhofseptumaneurysma."
                            },
                            {
                                "example_id": "38d13929-d3fd-4cd9-9525-59f0ca4fc2aa",
                                "sense_id": "84ff16b0-442f-30b9-bc29-46aa46d6fd1e",
                                "text": "Das Blut fließt mit Rechts-Links-Shunts durch den offenen Ductus arteriosus Botalli (der die Pulmonalarterie und die Aorta verbindet) und das Foramen ovale (das den rechten und linken Vorhof verbindet) von rechts nach links, vorbei an der nichtoxygenierten Lunge."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
