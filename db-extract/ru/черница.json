                "senses": [
                    {
                        "sense_id": "867dddb4-59d9-3bef-a4d7-57260fc4eeba",
                        "entry_id": "a33444d4-5556-362e-aab6-6d997b790ac6",
                        "glosses": [
                            "рег. то же, что черника; мелкий дикорастущий кустарник семейства брусничных с чёрными съедобными ягодами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06d094d-9fa2-4370-ad17-42f4e85c2a12",
                                "sense_id": "867dddb4-59d9-3bef-a4d7-57260fc4eeba",
                                "text": "Грибная пора отойти не успела, // Гляди — уж чернёхоньки губы у всех, // Набили оскому: черница поспела! // А там и малина, брусника, орех!"
                            }
                        ]
                    },
