                                        "examples": [
                                            {
                                                "example_id": "1d698771-cc01-4392-bcac-6ed561293f81",
                                                "sense_id": "e2dbc790-7cbd-33ce-b984-d0822e41f144",
                                                "text": "Hij kreeg van de automobielindustrie 20.000 rijksmark voor zijn opdracht. Een jaar later, in juli 1935, volgde de onthulling. Het was onmiddellijk een sensatie: in een tijd dat de meeste wagens groot en vierkant waren, kwam Porsche op de proppen met een compact wagentje."
                                            },
                                            {
                                                "example_id": "3059d5d0-262b-4524-a283-e9040f2b5303",
                                                "sense_id": "e2dbc790-7cbd-33ce-b984-d0822e41f144",
                                                "text": "Arnhem bleef verwoest achter. In de maanden na de slag roofde de Duitse bezetter huizen, winkels en zelfs ziekenhuizen compleet leeg. Voor miljoenen aan rijksmarken, schrijft Beevor. Nijmegen werd frontstad tot het eind van de oorlog en raakte eveneens grotendeels verwoest."
                                            }
                                        ]
