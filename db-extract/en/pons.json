                    {
                        "sense_id": "2710fdfb-2998-3114-965f-d2ce981307c8",
                        "entry_id": "cf5d29d2-878d-3be3-8ab0-f475bc5bcdd1",
                        "glosses": [
                            "A bridge-like tissue connecting two parts of an organ."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "869681d2-2873-39bb-954c-f612fad3b0b6",
                        "entry_id": "cf5d29d2-878d-3be3-8ab0-f475bc5bcdd1",
                        "glosses": [
                            "A band of nerve fibres, from the Latin term pōns Varoliī, within the brain stem."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d61e8d0-018a-4fef-b3a6-906dcdfb9999",
                        "source_entry_id": "cf5d29d2-878d-3be3-8ab0-f475bc5bcdd1",
                        "source_sense_description": "part of the brain",
                        "target_lang_word": "most",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "most",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "2e17ce23-11fe-374c-acfe-5c1c19c06a48",
                                        "entry_id": "0705d9de-2d68-3166-bb87-648d6e81e1d5",
                                        "glosses": [
                                            "stavba k překonání sníženiny nebo vodního toku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c87173-c881-4144-a273-8e21301d11a0",
                                                "sense_id": "2e17ce23-11fe-374c-acfe-5c1c19c06a48",
                                                "text": "Karlův most je nejspíše nejznámější památkou a stavbou svého druhu na území Čech."
                                            },
                                            {
                                                "example_id": "7e3e5ecf-70fe-41e0-938c-8d1182c7b8e4",
                                                "sense_id": "2e17ce23-11fe-374c-acfe-5c1c19c06a48",
                                                "text": "„Winkler nám oznámil, že je nutno nepřítele nechat přes naši župu převalit a potom v jeho týlu ničit a rušit dopravu, vyhazovat mosty, železniční spoje, telefonní spoje, důležité podniky průmyslové výroby a různá skladiště,“ vypověděl po válce jeden ze zatčených vlkodlaků - třiadvacetiletý lakýrník Herbert Assman z Mojžíře."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7175b4cd-e674-32bf-8c36-a35f9a404d35",
                                        "entry_id": "0705d9de-2d68-3166-bb87-648d6e81e1d5",
                                        "glosses": [
                                            "gymnastický prvek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f59341-d2d2-4954-b50e-7cd8f28d196c",
                                                "sense_id": "7175b4cd-e674-32bf-8c36-a35f9a404d35",
                                                "text": "V tělocviku se děti dnes učily dělat most."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcb67ed1-abdf-3175-8892-d37135f29bd7",
                                        "entry_id": "0705d9de-2d68-3166-bb87-648d6e81e1d5",
                                        "glosses": [
                                            "jednotící, spojující prvek"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b3272b-cfed-4fb2-8651-e97e554e5a15",
                                                "sense_id": "fcb67ed1-abdf-3175-8892-d37135f29bd7",
                                                "text": "Paměť vlastně představuje jakýsi most mezi minulostí a přítomností, proto je z hlediska času k popisu paměti zapotřebí uvažovat přinejmenším tři momenty"
                                            },
                                            {
                                                "example_id": "a7a795d7-409d-4cbf-836a-2929a8192876",
                                                "sense_id": "fcb67ed1-abdf-3175-8892-d37135f29bd7",
                                                "text": "Stejně tak jim není příliš po chuti, aby se hášimovské Jordánsko změnilo v ostrov prosperity a liberalismu a stalo se mostem mezi potenciálními demokraciemi v budoucím Palestinském státě a v Iráku"
                                            },
                                            {
                                                "example_id": "8044144a-ee66-4d71-a962-e62c9ced7503",
                                                "sense_id": "fcb67ed1-abdf-3175-8892-d37135f29bd7",
                                                "text": "O mnoho let později jsem měl možnost osobně poděkovat Janu Pavlu II., že postavil most mezi křesťany a Židy v novověku. Řekl jsem mu, že mu za to jako dítě z židovské rodiny děkuji"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "most",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "059d33da-72eb-3d0f-8e09-6c8e14cd3c65",
                                        "entry_id": "f8d285a3-4e4f-3892-8511-e3903fb8f1ff",
                                        "glosses": [
                                            "visutý most"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6c43106-b6e0-4a80-b921-9a31ba706cf3",
                        "source_entry_id": "cf5d29d2-878d-3be3-8ab0-f475bc5bcdd1",
                        "source_sense_description": "part of the brain",
                        "target_lang_word": "pont",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pont",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3002bc95-bbfc-3339-baec-7ffedfac1424",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Construction élevée d’un bord à l’autre d’une rivière, d’un ruisseau, d’un fossé pour permettre de les traverser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e99e8ffd-7c61-437a-a0bb-6fedee83ccde",
                                                "sense_id": "3002bc95-bbfc-3339-baec-7ffedfac1424",
                                                "text": "Depuis l’aube, les troupes passaient la Moselle. C'était, sur le tremblement des ponts de bois, l’avalanche interminable des régiments."
                                            },
                                            {
                                                "example_id": "a09d27ca-15cc-495b-893a-abcf7efe93a3",
                                                "sense_id": "3002bc95-bbfc-3339-baec-7ffedfac1424",
                                                "text": "[…] nous passons sous le pont suspendu de Brooklyn et devant Manhattan et ses gratte-ciel, et ma dernière vision de New-York me laisse une impression de ville monstrueuse et titanesque."
                                            },
                                            {
                                                "example_id": "443af3f2-a832-4465-a391-1f1dfb6380cc",
                                                "sense_id": "3002bc95-bbfc-3339-baec-7ffedfac1424",
                                                "text": "Le vénérable pont sur le Tarn a non seulement de hautes arches en ogive, mais ses piles de briques, entre les voûtes et au-dessus des avant-becs, sont percées de baies du même style."
                                            },
                                            {
                                                "example_id": "082a2db7-dd5b-4789-98e4-f184d67ad9dd",
                                                "sense_id": "3002bc95-bbfc-3339-baec-7ffedfac1424",
                                                "text": "Les mêmes juifs d'Arles avaient été astreints à travailler à la construction du pont de la Crau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f301f06-4966-360e-9a31-bf499f88df5f",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Ensemble de toutes les choses nécessaires pour établir le passage sur les rivières que les troupes peuvent être obligées de traverser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0995f3c-db39-4e22-89f6-eaee3a17f6a1",
                                                "sense_id": "0f301f06-4966-360e-9a31-bf499f88df5f",
                                                "text": "Mais, dans la matinée, une reconnaissance rendait compte que, par un brouillard épais, on avait entendu rouler des canons sur un pont de bateaux jeté par l’ennemi à hauteur de Mont-devant-Sassey."
                                            },
                                            {
                                                "example_id": "7b5a3f58-a942-49ec-a4b6-16c2f8b945f6",
                                                "sense_id": "0f301f06-4966-360e-9a31-bf499f88df5f",
                                                "text": "Le 17 octobre, seulement, Le Caire comprit que les Israéliens continuaient à renforcer leur tête de pont ; à cette date, un pont flottant était déjà en place et une division au grand complet avait pu traverser."
                                            },
                                            {
                                                "example_id": "7da62277-664e-4cb7-b702-aba20af19758",
                                                "sense_id": "0f301f06-4966-360e-9a31-bf499f88df5f",
                                                "text": "Équipage de pont (Ensemble de toutes les choses nécessaires pour établir des ponts sur les rivières que les troupes peuvent être obligées de traverser)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58355592-9dc0-3897-a022-2ae9d62c9067",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Jour de congé entre deux jours fériés ou entre un jour férié et le week-end."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bece345-12f4-4aa3-8d70-8dfcf23c4630",
                                                "sense_id": "58355592-9dc0-3897-a022-2ae9d62c9067",
                                                "text": "C'est que voici « le pont » c'est-à-dire quatre jours de fête à rester sans argent ou presque."
                                            },
                                            {
                                                "example_id": "29b3f15e-024e-4ee0-b48f-2997a64b791b",
                                                "sense_id": "58355592-9dc0-3897-a022-2ae9d62c9067",
                                                "text": "C'est le jeudi de l'Ascension 1994, avec le pont de quatre jours qui y est associé. Il fait un temps magnifique, soleil, mer déjà tiède propice à la baignade. Les vacanciers ont envahi la côte, le port et la mer en masse, avant-garde de la grande invasion de l'été qui approche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3765d1-8302-3a1d-846b-0ba64546e35b",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Ensemble de l’essieu et des divers organes qu’il comprend pour transmettre le mouvement moteur aux deux roues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fcedfbc-551e-43d7-86f8-2438315dad41",
                                                "sense_id": "9d3765d1-8302-3a1d-846b-0ba64546e35b",
                                                "text": "Cette fabrication spéciale se dénomme pont Banjo. Sa particularité réside dans le fait que tout le pont arrière est construit d’une seule pièce, mais le différentiel est accessible de l’avant et de l’arrière par des couvercles ronds."
                                            },
                                            {
                                                "example_id": "19a5ddd0-5dd5-4f92-b8bb-4db0ff0feaed",
                                                "sense_id": "9d3765d1-8302-3a1d-846b-0ba64546e35b",
                                                "text": "Il a son air matois de marchand de vieilles bagnoles, de ceux en tout cas qui mettent de la sciure dans le pont pour l’empêcher de chanter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Plancher ou divers planchers établis dans la longueur du navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74a39f3a-fdcf-4dd5-a79f-280c4590bdc5",
                                                "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                                "text": "Les vagues brisent à bord et submergent constamment le pont qui, mal calfaté à New-York, laisse pénétrer l'eau dans la cabine."
                                            },
                                            {
                                                "example_id": "6d13981e-89ce-4f3b-825d-9bbdc21ae53d",
                                                "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                                "text": "Dans la partie couverte des ponts 6 à 8 se trouve le cœur battant du bateau : 14 des 33 bars et restaurants, ainsi qu’un chocolatier, un cinéma, une salle de jeux vidéo et un coiffeur barbier."
                                            },
                                            {
                                                "example_id": "8a9605ed-db84-4ec9-85ec-492f321ce0de",
                                                "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                                "text": "Un vaisseau à trois ponts."
                                            },
                                            {
                                                "example_id": "8bea1c28-1f1f-4173-829a-c81f1d62b043",
                                                "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                                "text": "Quand on dit le pont, on entend ordinairement le pont supérieur."
                                            },
                                            {
                                                "example_id": "d8b43d27-541d-4ab0-8c15-9adbee166b1c",
                                                "sense_id": "aa632315-0ca4-384e-b335-1b935c8a28df",
                                                "text": "Nous passions le temps, tous les deux, sur le pont supérieur, à prendre des bains de soleil et à lire des poètes..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41061ac-5151-3b9a-ba65-b7510a0f21f2",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Partie antérieure du pantalon ou de la culotte qui se boutonnait à droite et à gauche et qui pouvait s’abaisser."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9ad7a42-6a77-4344-a1a0-4efe8dbabbc6",
                                                "sense_id": "c41061ac-5151-3b9a-ba65-b7510a0f21f2",
                                                "text": "Son pantalon à grand pont, éraillé aux boutonnières et bombé aux genoux, s’arrêtait à mi-jambe sur la tige d’une forte botte dont le cuir ne ployait pas"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6223647-3bf5-300a-9e0b-59a120bae434",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Montage de semi-conducteurs destiné à produire et moduler du courant continu à partir de courant alternatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5890bdc6-63d4-4e92-a95b-c8cfcc1aa70c",
                                                "sense_id": "b6223647-3bf5-300a-9e0b-59a120bae434",
                                                "text": "Ainsi, pour le contrôle de moteurs à commutation électronique ([…]), une carte contient généralement un pont de transistors de puissance alimenté par une tension continue et commandé par un circuit de modulation de largeur d’impulsions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7debdd75-374c-3558-933c-98ead39614c9",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Dispositif destiné à assurer entre deux réseaux locaux l’échange des trames de données sans les modifier, tout en détectant et en corrigeant les erreurs."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09dd9ee8-dd0a-4ae6-80cd-c281a0f5a0aa",
                                                "sense_id": "7debdd75-374c-3558-933c-98ead39614c9",
                                                "text": "Le pont, encore appelé « bridge » par les anglophiles, est l’équipement le plus ancien et le plus facile à mettre en œuvre. Il unit des réseaux proches ou distants en interprétant les deux premières couches du modèle OSI, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4655e5fd-09ff-3f18-b06f-ed2be872cd61",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Courte séquence instrumentale d'une chanson chantée, dans sa seconde partie, avant le dernier couplet ou le dernier refrain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e053f38a-4938-400e-a639-3b1628ed3b23",
                                                "sense_id": "4655e5fd-09ff-3f18-b06f-ed2be872cd61",
                                                "text": "Que serait un morceau sans pont ?"
                                            },
                                            {
                                                "example_id": "5962ffab-c612-40c0-8e22-6e3f1c674ccf",
                                                "sense_id": "4655e5fd-09ff-3f18-b06f-ed2be872cd61",
                                                "text": "On a vu que le « format » des petits ensembles bebop repose sur une règle assez simple : énoncé une ou deux fois du thème (qui comporte le plus souvent un pont, genre AABA), improvisation ad lib sur la grille, puis dernier exposé."
                                            },
                                            {
                                                "example_id": "5dd69a8d-082f-423d-bdda-6850e1ce36e7",
                                                "sense_id": "4655e5fd-09ff-3f18-b06f-ed2be872cd61",
                                                "text": "J’ai toujours aimé la façon dont Thelonius dénommait le « pont » d’une chanson. Les Américains ont une douzaine d’appellations pour ce passage quasi imposé de toutes les mélodies : the bridge, the channel the tunnel… Monk dit : the inside. Le dedans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4419d0c9-3c84-3336-ba4b-0c6fa0db1eed",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Meuble représentant l’ouvrage d’art du même nom dans les armoiries. Il est généralement représenté avec un nombre d’arches qui doit être précisé dans le blasonnement. Contrairement aux meubles classiques, le pont va d’un flanc à l’autre de l’écu, ce qui le rapproche des fasces. À rapprocher de aqueduc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a17554a9-0e51-46aa-b754-275b147e7b9a",
                                                "sense_id": "4419d0c9-3c84-3336-ba4b-0c6fa0db1eed",
                                                "text": "De gueules au pont de trois arches d’or sur une rivière d’azur où nage un poisson aussi d’or, surmonté d’un léopard du même, qui est de la commune de Pont-d’Ouilly du Calvados → voir illustration « armoiries avec un pont »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d9624f8-2bd0-3d4a-a321-011d4e11d137",
                                        "entry_id": "cf2e85b2-cc3b-3983-8541-0132f3ac4487",
                                        "glosses": [
                                            "Élément de souplesse statique, réalisé en appui sur les mains et les pieds avec une extension répartie sur toute la colonne vertébrale, les épaules et les hanches, jambes et bras tendus."
                                        ],
                                        "tags": [
                                            "Gymnastique"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
