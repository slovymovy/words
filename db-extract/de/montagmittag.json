                        "entry_id": "a6b1844b-1f2e-3dc0-864d-ca9e269b970c",
                        "glosses": [
                            "星期一中午，週一中午"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1dcf4e3-9cee-402a-b87f-43acab652729",
                                "sense_id": "03a04834-1205-3a63-bc42-a246aac53383",
                                "text": "Bereits am Montagmittag lagen zwanzig Zentimeter Schnee, was sich bis zum Abend nochmals verdoppelte.",
                                "translation": "週一中午時分，積雪已達二十公分，到了傍晚時分，這個數字又翻了一倍。"
                            },
                            {
                                "example_id": "92edaeb3-bcb1-4521-99d4-e0f8f908151d",
                                "sense_id": "03a04834-1205-3a63-bc42-a246aac53383",
                                "text": "Wir haben uns für Montagmittag in der Kantine verabredet.",
                                "translation": "我們約好週一中午在食堂見面。"
                            },
                            {
                                "example_id": "80786e28-574f-42cc-a558-15ba601eb7f5",
                                "sense_id": "03a04834-1205-3a63-bc42-a246aac53383",
                                "text": "Die Montagmittage verbringt Eulalie vorwiegend mit ihrem Freund in der Stadt.",
                                "translation": "尤拉莉通常週一中午會和男友在城裡待著。"
                            }
                        ]
                    }
