                "senses": [
                    {
                        "sense_id": "b8477429-004e-32fb-8ef8-6f37f730ca78",
                        "entry_id": "a5588e9f-cbc8-34d9-95ef-0ed62b8a5344",
                        "glosses": [
                            "семья пчёл или других подобных насекомых, образующих во главе с маткой обособленную группу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9336aac-8f8e-47e6-a351-00bbddf906be",
                                "sense_id": "b8477429-004e-32fb-8ef8-6f37f730ca78",
                                "text": ".. зашумело, как в рою пчелином, когда возвращается матка, отлетавшая погулять с своею охранной стражей."
                            },
                            {
                                "example_id": "b1b4f69f-5b45-4dd4-869e-db93a4c8c287",
                                "sense_id": "b8477429-004e-32fb-8ef8-6f37f730ca78",
                                "text": "Около деревьев в цвету вились и жужжали целые рои пчёл, ос и шмелей."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0bae6e8-a26f-3686-ba0f-ccb545fcca98",
                        "entry_id": "a5588e9f-cbc8-34d9-95ef-0ed62b8a5344",
                        "glosses": [
                            "перен., разг. значительное скопление, множество кого-либо, чего-либо; вереница"
                        ],
                        "tags": [
                            "кого., чего. или с опр."
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e440a39-9348-4b79-8fc1-6d45ca14ba16",
                        "source_entry_id": "a5588e9f-cbc8-34d9-95ef-0ed62b8a5344",
                        "source_sense_description": "семья пчёл или других подобных насекомых, образующих во главе с маткой обособленную группу",
                        "target_lang_word": "swarm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swarm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d1a4d3a-a05c-3db8-ab20-08ca649be38a",
                                        "entry_id": "b833258b-21f1-3df1-8d29-678a37e7b3d6",
                                        "glosses": [
                                            "A large number of insects, especially when in motion or (for bees) migrating to a new colony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7239b232-fc14-447c-8ad6-aca9e9b9cf29",
                                                "sense_id": "2d1a4d3a-a05c-3db8-ab20-08ca649be38a",
                                                "text": "[…] reſtleſs thoughts, that like a deadly ſwarm / Of Hornets arm'd […] ruſh upon me thronging,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "461ad9f9-c692-3c78-ace1-133799d3aec6",
                                        "entry_id": "b833258b-21f1-3df1-8d29-678a37e7b3d6",
                                        "glosses": [
                                            "A mass of people, animals or things in motion or turmoil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ac38e61-e4dd-4aa9-b4e7-77892e93c2fb",
                                                "sense_id": "461ad9f9-c692-3c78-ace1-133799d3aec6",
                                                "text": "a swarm of meteorites"
                                            },
                                            {
                                                "example_id": "254630d8-15bb-4678-a8ad-1b2d6e249043",
                                                "sense_id": "461ad9f9-c692-3c78-ace1-133799d3aec6",
                                                "text": "those prodigious swarms that had settled themselves in every part of it [Italy]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cee2b1ea-609e-341e-8aef-9e78987506fd",
                                        "entry_id": "b833258b-21f1-3df1-8d29-678a37e7b3d6",
                                        "glosses": [
                                            "A group of nodes sharing the same torrent in a BitTorrent network."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4e4df2d-3c89-3699-942e-8b7dbfbfe99c",
                                        "entry_id": "b833258b-21f1-3df1-8d29-678a37e7b3d6",
                                        "glosses": [
                                            "A number of small earthquakes (or other seismic events) occurring, with no clear cause, in a specific area within a relatively short space of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48d65fa4-a190-4200-a7a5-de8882c24abd",
                                                "sense_id": "e4e4df2d-3c89-3699-942e-8b7dbfbfe99c",
                                                "text": "Earthquakes were another concern, particularly after swarms were felt in Oklahoma."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swarm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a998d8-653a-3612-9b38-3a433512a3f5",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To move as a swarm."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf50d19-65f9-4595-8f5b-d3df420ee715",
                                                "sense_id": "b6a998d8-653a-3612-9b38-3a433512a3f5",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy. Mail bags, so I understand, are being put on board. Stewards, carrying cabin trunks, swarm in the corridors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f6f3c0-60ba-36ae-a2ed-fef8adf13728",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To teem, or be overrun with insects, people, etc."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30cf7b1c-9a95-4f4b-965f-334c3d00bd07",
                                                "sense_id": "81f6f3c0-60ba-36ae-a2ed-fef8adf13728",
                                                "text": "Every place swarming with soldiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5128ebf-0b5e-32b9-909d-3fbb728b15e8",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To fill a place as a swarm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4faff37-d45f-4990-8635-667404d133d6",
                                                "sense_id": "e5128ebf-0b5e-32b9-909d-3fbb728b15e8",
                                                "text": "All is well until Treorchy, where the platform is swamped by teenagers who have been attending an event. Around four dozen unescorted 12 to 16 year-olds swarm aboard and begin to run riot through the train. Their behaviour is appalling and the presence of CCTV no deterrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e2061cd-9901-37cd-9750-7be23b1c3dd3",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To overwhelm as by an opposing army."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15fc65ef-f0b3-4c14-b485-c0f5bc253758",
                                                "sense_id": "5e2061cd-9901-37cd-9750-7be23b1c3dd3",
                                                "text": "So, yeah. The overall conclusion of the big gunfight being that, if Yamato is able to tackle the Colorados early, then the Japanese probably have a, maybe a sixty-to-sixty-five-percent chance of pulling this off... although you say \"pulling it off\", it's more a case of \"the Japanese are the last battleship standing\"; they tend to then just get swarmed by angry Fletchers[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e16c827-fcec-3ff3-a122-5ea2bc3cd478",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To climb by gripping with arms and legs alternately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ea1e90-5e13-456a-93c1-a76cf6d5e3af",
                                                "sense_id": "7e16c827-fcec-3ff3-a122-5ea2bc3cd478",
                                                "text": "At the top was placed a piece of money, as a prize for those who could swarm up and seize it."
                                            },
                                            {
                                                "example_id": "45680c44-516c-4a8c-8391-dad1af7cc241",
                                                "sense_id": "7e16c827-fcec-3ff3-a122-5ea2bc3cd478",
                                                "text": "She called out, and a boy came running along. He swarmed up a tree, and presently threw down a ripe nut. Ata pierced a hole in it, and the doctor took a long, refreshing draught."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47c05cb0-98c7-3d6c-a1bd-414ae30f790e",
                                        "entry_id": "1b02df13-d9a9-3c2e-b42f-81cca56dc9bc",
                                        "glosses": [
                                            "To breed multitudes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5a3731-a94d-47d6-a52c-27d550bd478a",
                                                "sense_id": "47c05cb0-98c7-3d6c-a1bd-414ae30f790e",
                                                "text": "Not ſo thick ſwarm'd once the Soil / Bedropt with blood of Gorgon,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
