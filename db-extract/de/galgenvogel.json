                    {
                        "translation_id": "f96287f3-8e8e-46fd-b215-00d6a5bcd389",
                        "source_entry_id": "a1402e2d-b8d4-32a5-9a9a-b13929c573b5",
                        "source_sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                        "source_sense_description": "jemand, der zu nichts taugt",
                        "target_lang_word": "padouch",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "padouch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                        "entry_id": "01a2a2a7-9b0d-31cb-b5ce-73fa0cd5af74",
                                        "glosses": [
                                            "zlý, podlý člověk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f360487-bd97-41c1-ab27-75ff5032a13a",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Padouch nebo hrdina, vždyť jsme jedna rodina."
                                            },
                                            {
                                                "example_id": "943a2860-b222-42d7-a075-33b438f9b042",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Jedním skokem jako chrti vrhla se celá tlupa k místu, odkud šustot ten pošel. „Ach — milost… ó!“ „Lotře!“ „Padouchu!“ „Zrádče!“ „Šibeničníku!“ Tak znělo spílání šesti ozbrojenců, když se nočního tuláka zmocnili."
                                            },
                                            {
                                                "example_id": "175310d3-f6ae-4c7c-8ff7-5504602eda16",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Hejtman chodí kolem nás a povídá: ,Vy lumpové, padouchové, neřádi, hyeny skvrnitý, tak bych vám chtěl kvůli tomu psovi všem napařit ajnclíka, rozsekat vás na nudle, postřílet a udělat z vás kapra namodro. Abyste ale věděli, že vás nebudu šetřit, dávám vám všem na čtrnáct dní kasárníka.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87dd7131-e3ce-46b9-b7a8-31920fdb40f1",
                        "source_entry_id": "a1402e2d-b8d4-32a5-9a9a-b13929c573b5",
                        "source_sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
                        "source_sense_description": "jemand, der zu nichts taugt",
                        "target_lang_word": "lotr",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lotr",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "45cd9b90-47a7-3ef2-8432-df5fd96f3763",
                                        "entry_id": "5d26aa8a-ce59-3733-a0c7-bc28b0954888",
                                        "glosses": [
                                            "podlý člověk"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "223ea41b-662f-4f3f-9319-4e907f5b3fea",
                                                "sense_id": "45cd9b90-47a7-3ef2-8432-df5fd96f3763",
                                                "text": "Aspoň každý u nich i jinde pozná, jak Lomikar s nimi jednal a jedná; a každý ví, že Kozina z Oujezda není ani lotr, ani vrah, každý ví, proč mu tu potupnou smrt usoudili."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30be5f8e-e31e-4183-8af4-286b02868ed8",
                        "source_entry_id": "a1402e2d-b8d4-32a5-9a9a-b13929c573b5",
                        "source_sense_id": "42fb4202-ac25-3c4d-ad11-da3867c04c4c",
