                "senses": [
                    {
                        "sense_id": "0a15f270-9495-3678-b6c1-f52b854d87c0",
                        "entry_id": "7aa8984b-ea0a-3db0-8f3c-a8def9b4fb2e",
                        "glosses": [
                            "Celle à qui l’on confie ses plus secrètes pensées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a979d88c-4920-43ba-816d-86cca606f063",
                                "sense_id": "0a15f270-9495-3678-b6c1-f52b854d87c0",
                                "text": "La dame du comptoir, seule femme à laquelle il parlât avec plaisir, était la confidente des petits accidents de sa vie, car il possédait sa place à la table située près du comptoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a3329d2-582d-3a17-8edb-bbc81247e81c",
                        "entry_id": "7aa8984b-ea0a-3db0-8f3c-a8def9b4fb2e",
                        "glosses": [
                            "Personnage subalterne d’une tragédie ou d’une comédie à qui le ou les personnages principaux font leurs confidences."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a73e2f2-54a7-4285-92c4-c7a4581af4c6",
                                "sense_id": "0a3329d2-582d-3a17-8edb-bbc81247e81c",
                                "text": "Corasmin est un confident dans la tragédie de Zaïre. Céphise une confidente dans la tragédie d’Andromaque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ca1a619-64bc-474a-bab5-9b38eacb2ec7",
                        "source_entry_id": "7aa8984b-ea0a-3db0-8f3c-a8def9b4fb2e",
                        "source_sense_id": "0a15f270-9495-3678-b6c1-f52b854d87c0",
                        "source_sense_description": "Celui à qui l’on confie ses plus secrètes pensées.",
                        "target_lang_word": "confidant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confidant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                        "entry_id": "8aa38900-1219-3b95-8905-542b867d4cd9",
                                        "glosses": [
                                            "A person in whom one can confide or share one's secrets: a friend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954bd9cd-f292-45ca-8643-b5c67c3dd1cb",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "Heaven made you love me for no other end, / But to become my confidant and friend: / As such, I keep no secret from your sight, […]"
                                            },
                                            {
                                                "example_id": "aa57e3cf-afaf-42ea-acf8-ff3c5604c43c",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "One in thought and purpose, linked by the necessity of combating one hostile fate, a power antagonistic ever, - a power we lived to evade, - we had no confidants save ourselves."
                                            },
                                            {
                                                "example_id": "62369c4f-1a0b-4d48-bb13-ecce6164159f",
                                                "sense_id": "5fb16ecf-5047-3d23-b6eb-6807b3e18a9c",
                                                "text": "Bankman-Fried’s confidants were along for the ride. At his side was Caroline Ellison, Alameda’s CEO and his on-again, off-again lover."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
