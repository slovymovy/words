                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a09b1e07-18aa-4a32-8ba9-c21e0b5c1480",
                        "source_entry_id": "8f67f10a-23a2-3a86-a720-385ecafd8a3a",
                        "source_sense_id": "0c53171e-f83f-3654-8470-13792f05c451",
                        "source_sense_description": "opgewekt en tegelijk aardig en vriendschappelijk in de omgang",
                        "target_lang_word": "herzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                        "entry_id": "e6c52fc0-0e1a-3391-ae2f-80597d727dee",
                                        "glosses": [
                                            "freundlich gesinnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ec705a7-5eb8-461f-a24b-ae0a8b62c597",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "Sie wurde am Bahnhof von der Tante herzlich empfangen."
                                            },
                                            {
                                                "example_id": "764f2cc8-9bec-4019-8697-e68a6195fa7a",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "Er wünschte ihr herzliche Glückwünsche zum Geburtstag."
                                            },
                                            {
                                                "example_id": "22f4acf6-2a01-4adb-a123-fe4fbc6f4dbd",
                                                "sense_id": "ab1ca000-6055-3bb8-b900-a1c90f7b5bc7",
                                                "text": "„Freddie begrüßte seinen Bruder mit einer herzlichen Umarmung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                        "entry_id": "e6c52fc0-0e1a-3391-ae2f-80597d727dee",
                                        "glosses": [
                                            "ziemlich, sehr"
                                        ],
                                        "tags": [
                                            "verstärkend",
                                            "bei Adjektiven und Verben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b77a4663-9dfe-44bb-bb22-e6805cf3da4b",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "Der Schüler wusste bei der Prüfung herzlich wenig vom Lehrstoff."
                                            },
                                            {
                                                "example_id": "c6de4dbb-e58c-4255-9b5e-db423124f50f",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "Das tut mir aber herzlich leid."
                                            },
                                            {
                                                "example_id": "a7a22175-247f-4251-8c9b-c7892edcdc4d",
                                                "sense_id": "3d708938-9e55-35c8-b8e7-edacdbf8de9c",
                                                "text": "„Den Schweden ist das EuGH-Urteil zur Arbeitszeiterfassung herzlich egal. Denn sie machen schon heute kaum Überstunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d628f7-d7f6-426c-b1f7-d490e4da13e1",
                        "source_entry_id": "8f67f10a-23a2-3a86-a720-385ecafd8a3a",
                        "source_sense_id": "0c53171e-f83f-3654-8470-13792f05c451",
                        "source_sense_description": "opgewekt en tegelijk aardig en vriendschappelijk in de omgang",
                        "target_lang_word": "jovial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jovial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                        "entry_id": "e37daa56-77c3-3c47-9192-b4c9341a9d3f",
                                        "glosses": [
                                            "Cheerful and good-humoured; jolly, merry."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5cf3b7f-a5aa-4820-b687-9cd70223e3e7",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "A melancholy boddy is not the kindeſt nurſe for a chearely minde, (the joviall complexion is ſoverainly beholding to nature,) […]"
                                            },
                                            {
                                                "example_id": "c1dd002c-67d3-4c3c-a098-b58d8d2dc3cc",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "The moſt ſecure, happy, Ioviall & merry in the worlds eſteeme, are Princes & great men, free from melancholy, but for their cares, miſeries, ſuſpicions, Iealoſies, diſcontents, folly, & madneſſe, I referre you to Xenophons Tyrannus, where king Hieron diſcourſeth at large with Simonides the Poet, of this ſubject."
                                            },
                                            {
                                                "example_id": "d5b19c1d-611f-4437-bfd3-8f3d3db0679b",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "But being ill-used by the above-mentioned widow, he was very serious for a year and a half; and though, his temper being naturally jovial, he at last got over it, he grew careless of himself, and never dressed afterwards."
                                            },
                                            {
                                                "example_id": "a1ccb0ba-c078-4df6-9d31-81400fd77326",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "[I]n polite ſocieties, he is the eaſy, well-bred man of faſhion; and, in the more convivial parties, he is the jovial companion."
                                            },
                                            {
                                                "example_id": "23bd28ee-d16c-4d50-97c0-39ed6b72f014",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "At length, my friends, the feaſt of life is o’er; / I’ve eat ſufficient, I can drink no more: / My nigh is come; I’ve ſpent a jovial day; ’Tis time to part; but, oh!—what is to pay?"
                                            },
                                            {
                                                "example_id": "37d7a475-e206-4a2d-a4a2-67fbafe54477",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "Running to the window, he opened it, and put out his head. No fog, no mist; clear, bright, jovial, stirring, cold; cold, piping for the blood to dance to; Golden sunlight; Heavenly sky; sweet fresh air; merry bells. Oh, glorious. Glorious!"
                                            },
                                            {
                                                "example_id": "752a4eb9-90ac-49e1-ab1e-226bb5d44b9b",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "A long, jovial, inane laugh broke the sudden silence which had fallen over everyone."
                                            },
                                            {
                                                "example_id": "5113db07-5422-4e77-a893-bab9994847f6",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "She takes the whole thing with desperate seriousness. But the others are all easy and jovial—thinking about the good fare that is soon to be eaten, about the hired fly, about anything."
                                            },
                                            {
                                                "example_id": "b725b4c3-0638-4442-995a-7c9fc8f10708",
                                                "sense_id": "52398733-4f6c-390d-9c44-b5b1247c34e5",
                                                "text": "[A] jovial Santa Claus with an understanding heart and an attentive ear— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "007bf4f0-d10c-3e90-b00c-87f835c788d4",
                                        "entry_id": "e37daa56-77c3-3c47-9192-b4c9341a9d3f",
                                        "glosses": [
                                            "Pertaining to the astrological influence of the planet Jupiter; having the characteristics of a person under such influence (see sense 1)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c3eb98b-490f-479c-9d37-1a0d519138af",
                                                "sense_id": "007bf4f0-d10c-3e90-b00c-87f835c788d4",
                                                "text": "This Planet [Jupiter] being a Fortune, and Friend unto nature, inclineth the native, upon this direction, not only unto healthfulneſs, but alſo to be jovial and merry, affable and pleaſant, and to delight in the company of religious men: […] [T]his direction importeth good from jovial perſons, and is an excellent time to have dealings with, or to receive any courteſie from, or benefit by them, […]"
                                            },
                                            {
                                                "example_id": "491c5cba-1ad7-4623-a277-0bd66e24bb65",
