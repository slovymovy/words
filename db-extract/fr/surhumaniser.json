                ],
                "senses": [
                    {
                        "sense_id": "413e21a0-11d3-31e2-93b7-fbce3e2284da",
                        "entry_id": "6feae58a-8ae3-3774-9142-593f4002dc3c",
                        "glosses": [
                            "Donner un caractère surhumain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e0a9ee-3a47-4ff7-a052-b98cfc9b2711",
                                "sense_id": "413e21a0-11d3-31e2-93b7-fbce3e2284da",
                                "text": "Les considérer comme « plus qu’humains », c’est, si l'on peut dire, les « surhumaniser »."
                            },
                            {
                                "example_id": "9a38656b-e19f-477a-a6dd-1316c1f7b021",
                                "sense_id": "413e21a0-11d3-31e2-93b7-fbce3e2284da",
                                "text": "L’espace étant humanisé dès les temps les plus reculés, il n’est pas étonnant que la tendance à le surhumaniser aboutisse aux voyages spatiaux d’hommes enfermés dans leur propre milieu devenu artificiel."
                            }
                        ]
                    }
