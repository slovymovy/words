            {
                "entry_id": "78362456-29df-3828-b397-54d539d6fb5c",
                "word": "Mdm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                        "entry_id": "78362456-29df-3828-b397-54d539d6fb5c",
                        "glosses": [
                            "Abbreviation of Madam; a polite form of address and title used before a (usually middle-aged) adult or elderly woman's surname, full name or given name if she does not have a family name."
                        ],
                        "tags": [
                            "Singapore"
                        ],
                        "examples": [
                            {
                                "example_id": "217d9594-d71e-4cb6-bf81-9d3195fde88e",
                                "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                                "text": "The plaintiff was painted in an unfavourable light in an interlocutory judgment by the High Court of Johore instituted by one Mdm Tara Rajaratnam. The appeal to the Malaysian Federal Court of Civil Appeal was dismissed. However, on appeal to the Privy Council, the plaintiff reached a settlement with Mdm Rajaratnam who withdrew all her allegations of fraud against the plaintiff."
                            },
                            {
                                "example_id": "a16f85f5-43ed-4157-9349-ac68f3919762",
                                "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                                "text": "His is also a family of four comprising the father, 36-year-old Mr Marzuki; the mother, 35-year-old Mdm Zaiton; […]"
                            },
                            {
                                "example_id": "acddcc28-e41f-409b-9705-743b62e59c5c",
                                "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                                "text": "Mdm Esah has been volunteering since her school days."
                            },
                            {
                                "example_id": "95c1b0fd-bd04-447f-89a5-be2e02e33919",
                                "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                                "text": "Mdm Margaret Yeo, 77, recalls in English: “The way (the police inspector) spoke was slow and full of authority. I really trusted him.”"
                            },
                            {
                                "example_id": "87e9a4c2-6409-41ba-bcc9-3fa3fc98b660",
                                "sense_id": "29519de8-4d7e-3a95-9178-7128d02345f5",
                                "text": "Two seasoned teachers, Ms Fong and Mdm Wong, shared their experience of the Builders Project and the progression of restorative practices in their school leading to effective student engagement."
                            }
                        ]
                    }
                ],
