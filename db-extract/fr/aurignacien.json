                "senses": [
                    {
                        "sense_id": "01d32a41-6c23-3468-8081-141ceab127f4",
                        "entry_id": "62d98712-3da3-316e-89f3-e1bc88746e00",
                        "glosses": [
                            "Relatif à Aurignac, commune française située dans le département de la Haute-Garonne."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4d13d36d-9a6d-3894-b54b-c1ffe3390dd5",
                        "entry_id": "62d98712-3da3-316e-89f3-e1bc88746e00",
                        "glosses": [
                            "Relatif à la période préhistorique de l’aurignacien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5af4571-a3bf-4be5-9e87-f2e5ca11c874",
                                "sense_id": "4d13d36d-9a6d-3894-b54b-c1ffe3390dd5",
                                "text": "Avec les restes de l'industrie aurignacienne, on rencontre les os de tous les animaux dont l'homme faisait alors sa nourriture, et dont il employait les dents et les os pour fabriquer les ustensiles nécessaires à sa vie, […]."
                            },
                            {
                                "example_id": "1412521b-1581-4681-9ddc-8557cef7e09a",
                                "sense_id": "4d13d36d-9a6d-3894-b54b-c1ffe3390dd5",
                                "text": "J'aurais la tentation irrésistible de les accrocher çà et là dans une cage de singes, par la queue ou la patte, en quoi je ne contredirais par la préhistoire pithécanthropique de l'homme mais la pousserais encore plus avant que l'art aurignacien."
                            },
                            {
                                "example_id": "9225a871-9323-425c-a1a8-f8b360b9a1e0",
                                "sense_id": "4d13d36d-9a6d-3894-b54b-c1ffe3390dd5",
                                "text": "Dans le Bassin parisien, cette discussion s’est engagée à partir du gisement de Thèmes, dans l’Yonne (fig. 15 ; Le Brun-Ricalens et Brou, 2003). Ce gisement de plein air avait été initialement considéré comme aurignacien (Bodechon, 1982 ; Bel, 1991) sur la base d’une industrie lithique associant burins carénés et produits lamellaires, en particulier des lamelles torses à retouche abrupte directe fortement latéralisée (Le Brun-Ricalens et Brou, 2003)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "657dd535-f8f2-4c3b-ae53-1bc00178fc68",
                        "source_entry_id": "62d98712-3da3-316e-89f3-e1bc88746e00",
                        "target_lang_word": "Aurignacian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aurignacian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29db8eec-fd4d-320a-8d46-8ed0f18daf44",
                                        "entry_id": "26bcc22e-d531-3418-a222-f970269f98af",
                                        "glosses": [
                                            "From or pertaining to a culture of the Upper Paleolithic, located in Europe and southwest Asia from circa 45,000 to 35,000 years ago, known from archaeological remains."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Aurignacian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59d639b3-a7ff-32ae-b54d-3b44f8518f00",
                                        "entry_id": "7b0cd7bd-c795-390e-b063-4dc927819fbd",
                                        "glosses": [
                                            "A member of the Aurignacian culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80596f79-cfac-487c-80a0-23a394cc7885",
                                                "sense_id": "59d639b3-a7ff-32ae-b54d-3b44f8518f00",
                                                "text": "While the Aurignacians were capable hunters of the largest mammals, they were not equipped with the specialist flint points characteristic of later European cultures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
