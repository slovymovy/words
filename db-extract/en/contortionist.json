                                        "entry_id": "92e9a666-0b56-3681-8c6d-c4a8887efc80",
                                        "glosses": [
                                            "Akrobat, der seinen Körper aufgrund von jahrelangem Training extrem biegen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132a496e-21ef-488c-89fc-340ae0a9c013",
                                                "sense_id": "c9be359f-2a7c-3f75-a07b-dda0b4937f66",
                                                "text": "„Einige der Positionen, die sie testeten, erforderten es, dass ihre Beine so biegsam waren wie die eines Schlangenmenschen im Zirkus.“"
                                            },
                                            {
                                                "example_id": "28b27dab-6973-4763-ae4b-3a924f5a93dd",
                                                "sense_id": "c9be359f-2a7c-3f75-a07b-dda0b4937f66",
                                                "text": "„Er hatte sich wie ein Schlangenmensch in sein kleines Gefängnis gequetscht.“"
                                            }
                                        ],
