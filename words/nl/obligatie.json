            "senses": [
                {
                    "sense_id": "7e30c461-0eac-3b29-9897-ca802533fdd5",
                    "sense_definition": "Een schuldbewijs voor een lening die door een overheid of een bedrijf is uitgegeven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "financieel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De belegger besloot om een deel van zijn kapitaal in een veilige <w>obligatie</w> te steken.",
                            "target_lang_translations": {
                                "en": "The investor decided to put part of his capital into a safe <w>bond</w>."
                            }
                        },
                        {
                            "text": "De rente op een <w>obligatie</w> van de overheid is meestal lager dan die van een bedrijf.",
                            "target_lang_translations": {
                                "en": "The interest on a government <w>bond</w> is usually lower than that of a company."
                            }
                        }
                    ],
                    "synonyms": [
                        "schuldbewijs",
                        "waardepapier"
                    ],
                    "antonyms": [
                        "aandeel"
                    ],
                    "common_phrases": [
                        "een obligatie kopen",
                        "obligatie van de staat",
                        "rente op obligaties"
                    ],
                    "target_lang_definitions": {
                        "en": "A debt instrument for a loan issued by a government or a company."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bond",
                                "target_lang_sense_clarification": "financial security"
                            },
                            {
                                "target_lang_word": "debenture",
                                "target_lang_sense_clarification": "unsecured loan certificate"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c674666-fda8-3b28-85ab-1d2fe20f85e2",
                    "sense_definition": "Een morele of wettelijke verplichting om iets te doen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij voelde een morele <w>obligatie</w> om zijn buren te helpen tijdens de crisis.",
                            "target_lang_translations": {
                                "en": "He felt a moral <w>obligation</w> to help his neighbors during the crisis."
                            }
                        },
                        {
                            "text": "In dit contract staat een duidelijke <w>obligatie</w> voor beide partijen vermeld.",
                            "target_lang_translations": {
                                "en": "A clear <w>obligation</w> for both parties is stated in this contract."
                            }
                        }
                    ],
                    "synonyms": [
                        "verplichting",
                        "verbintenis"
                    ],
                    "antonyms": [
                        "vrijblijvendheid"
                    ],
                    "common_phrases": [
                        "morele obligatie",
                        "wettelijke obligatie"
                    ],
                    "target_lang_definitions": {
                        "en": "A moral or legal obligation to do something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obligation",
                                "target_lang_sense_clarification": "duty or commitment"
                            },
                            {
                                "target_lang_word": "duty",
                                "target_lang_sense_clarification": "moral or legal responsibility"
                            }
                        ]
                    }
                }
            ]
        }
    ]
