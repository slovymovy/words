                        "glosses": [
                            "Ustensile de cuisine à deux étages dont un percé de trous, qui sert à faire cuire le couscous à la vapeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59ae2d6b-ae00-4870-9f3f-a5c2b4bbd09c",
                                "sense_id": "4109b06f-35f3-3c09-af35-d30a51d7c96f",
                                "text": "La cuisson se fait dans une couscoussière en tôle, percée de trous avec un clou dans sa partie inférieure, et placée au-dessus d’une marmite en fonte à moitié pleine d’eau, chauffant sur un feu vif."
                            }
                        ]
                    }
                ],
