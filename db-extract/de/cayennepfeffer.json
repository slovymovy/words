                "senses": [
                    {
                        "sense_id": "f9b195b6-60ed-3278-8306-3729a17a5486",
                        "entry_id": "01718245-4e09-39fa-8cf9-1f29374a2269",
                        "glosses": [
                            "rotes und scharfes Gewürz, das durch Mahlen von Chillies hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7aeb1a7-a79a-4c79-9819-95b36d29769a",
                                "sense_id": "f9b195b6-60ed-3278-8306-3729a17a5486",
                                "text": "„Der Export von Zucker, Edelhölzern, Cayennepfeffer (benannt nach Cayenne, der Hauptstadt Französisch-Guayanas) und anderen Gewürzen führte erstmals zu einem gewissen Wohlstand in der Kolonie.“"
                            },
                            {
                                "example_id": "3e225421-0a1b-4bef-95da-9b1864f886a8",
                                "sense_id": "f9b195b6-60ed-3278-8306-3729a17a5486",
                                "text": "„Auch der Cayennepfeffer wird nicht aus Früchten eines Pfeffergewächses gewonnen, sondern aus gemahlenen Chilis.“"
                            },
                            {
                                "example_id": "200f6643-5d8e-41cf-924d-d85e213f6b49",
                                "sense_id": "f9b195b6-60ed-3278-8306-3729a17a5486",
                                "text": "„Der Cayennepfeffer ist eigentlich eine Paprikasorte […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
