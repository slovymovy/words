                    "frequency": "Low",
                    "semantic_group_id": "act_of_shedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The seasonal <w>shedding</w> of leaves helps the trees conserve water during the winter.",
                            "target_lang_translations": {
