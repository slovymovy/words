                "senses": [
                    {
                        "sense_id": "7cc8fc49-11e8-30c2-a8bb-6b9b52fe7c92",
                        "entry_id": "fdfdb252-7441-3394-beef-13172fa3b72a",
                        "glosses": [
                            "het tekort aan woningen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80274166-c4b2-4ee0-b1d6-89df68c106ab",
                                "sense_id": "7cc8fc49-11e8-30c2-a8bb-6b9b52fe7c92",
                                "text": "Voor het woningprobleem bijvoorbeeld worden veel oplossingen aangedragen door de burgers zelf waar de overheid uit arrogantie niets mee doet. De overheid zit op een andere planeet en is bezig met eigen spelletjes en dubbele agenda’s."
                            }
                        ]
                    },
                    {
                        "sense_id": "06550ce6-b19d-3bb2-a700-25a296754862",
                        "entry_id": "fdfdb252-7441-3394-beef-13172fa3b72a",
                        "glosses": [
                            "moeilijkheid bij het vinden van een geschikte woning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63509b8c-4910-46a0-8f4a-56813455ff91",
                                "sense_id": "06550ce6-b19d-3bb2-a700-25a296754862",
                                "text": "Niels Joosten vertrekt als burgemeester van Doetinchem. De VVDér was sinds maart tijdelijk weg. Hij kreeg verlof, zodat hij een echtscheiding kon afronden en een oplossing kon vinden voor zijn woningproblemen."
                            },
                            {
                                "example_id": "d80f1d61-acf5-4316-b1f8-eb80bf7848b6",
                                "sense_id": "06550ce6-b19d-3bb2-a700-25a296754862",
                                "text": "„Als je arm bent kan je woningproblemen hebben, ruzie in de familie, je hebt meer moeite om rekeningen te betalen, je zult waarschijnlijk vaker verhuizen. Dat zorgt voor stress in gezinnen, ook bij de kinderen”, aldus hoogleraar Gary Evans van de Cornell Universiteit in de staat New York."
                            }
                        ]
                    }
