    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4d0e14c-789c-36dc-834f-cd7482e81396",
                    "sense_definition": "een persoon die is ingehuurd om iemand te beschermen tegen fysiek gevaar",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De beroemde zangeres wordt overal gevolgd door een gespierde <w>lijfwacht</w>.",
                            "target_lang_translations": {
                                "en": "The famous singer is followed everywhere by a muscular <w>bodyguard</w>."
                            }
                        },
                        {
                            "text": "Na een uitgebreide sollicitatieprocedure kon de man zich eindelijk <w>lijfwacht</w> van de koning noemen.",
                            "target_lang_translations": {
                                "en": "After an extensive application process, the man could finally call himself the king's <w>bodyguard</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "persoonsbeveiliger"
                    ],
                    "common_phrases": [
                        "persoonlijke lijfwacht",
                        "lijfwacht van de koning"
                    ],
                    "target_lang_definitions": {
                        "en": "a person hired to protect someone from physical danger"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bodyguard",
                                "target_lang_sense_clarification": "an individual protector"
                            },
                            {
                                "target_lang_word": "close protection officer",
                                "target_lang_sense_clarification": "professional term for a personal guard"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2355b3fa-a91d-3658-8abd-a68d52cebd60",
                    "sense_definition": "een groep bewakers die belast is met de veiligheid van een vorst of hooggeplaatst persoon",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "beveiliging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De koninklijke <w>lijfwacht</w> stond strak in het gelid tijdens de ceremonie.",
                            "target_lang_translations": {
                                "en": "The royal <w>bodyguard</w> stood strictly in formation during the ceremony."
                            }
                        },
                        {
                            "text": "Na de ernstige bedreiging eiste de politicus van de regering een permanente <w>lijfwacht</w>.",
                            "target_lang_translations": {
                                "en": "After the serious threat, the politician demanded a permanent <w>security detail</w> from the government."
                            }
                        }
                    ],
                    "common_phrases": [
                        "koninklijke lijfwacht"
                    ],
                    "target_lang_definitions": {
                        "en": "a group of guards responsible for the safety of a monarch or high-ranking person"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bodyguard",
                                "target_lang_sense_clarification": "a collective unit of protectors"
                            },
                            {
                                "target_lang_word": "life guard",
                                "target_lang_sense_clarification": "historical or ceremonial military unit"
                            },
                            {
                                "target_lang_word": "security detail",
                                "target_lang_sense_clarification": "a group assigned to protect a specific person"
                            }
                        ]
                    }
                }
            ]
        }
    ]
