                    {
                        "sense_id": "c48656fa-4338-35c9-a3d5-a2de23bc2887",
                        "entry_id": "84056e8a-e6a8-3325-a968-32cc6b3fc999",
                        "glosses": [
                            "Qui n’est pas civique, qui n’est pas conforme aux sentiments et aux obligations d’un bon citoyen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fc5fed-74e4-4a61-b263-a53519ee4331",
                                "sense_id": "c48656fa-4338-35c9-a3d5-a2de23bc2887",
                                "text": "Une conduite, une proposition incivique."
                            },
                            {
                                "example_id": "eb8c43c4-dc80-4428-809e-4290bc7dc877",
                                "sense_id": "c48656fa-4338-35c9-a3d5-a2de23bc2887",
                                "text": "– Je t’avertis, Josef… si tu te sauves, je te dénonce au Parti comme incivique et déviationniste ! Après, je te la souhaite belle l’existence que tu mèneras !"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6c82c90d-a004-3e50-92e8-b2c1074af19e",
                "word": "incivique",
