                ],
                "senses": [
                    {
                        "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                        "entry_id": "7e37591e-ae7e-3d1a-80b8-f04112543ef6",
                        "glosses": [
                            "männliche Person, deren Schwester oder Bruder gleichzeitig von der Mutter ausgetragen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a83dfa9f-95af-4e0d-9c68-515b02c2e653",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "Tom spielt mit seinem Zwillingsbruder Schach."
                            },
                            {
                                "example_id": "6886b95e-8048-487d-9d48-9e1769229bab",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "Bei eineiigen Zwillingsbrüdern sieht man kaum Unterschiede."
                            },
                            {
                                "example_id": "4a2c7cf0-9938-469c-b37f-1a2ba0ed3f2d",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "Thomas hat einen Zwillingsbruder."
                            },
                            {
                                "example_id": "0f6dafd2-074e-4164-b2f5-a95f849eb7ea",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "„Nathan hatte mir erzählt, dass er einen Zwillingsbruder namens Heath habe, der in Australien lebe.“"
                            },
                            {
                                "example_id": "41c3ec69-9b63-4c39-a613-5898e71ae81c",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "„Aus den Zwillingsstudien von Davis (1937) geht hervor, daß die Zwillingsbrüder, die Zwillingsschwestern hatten, in ihren sprachlichen Leistungen weniger zurückgeblieben waren als diejenigen, die nur mit Zwillingsbrüdern aufwuchsen.“"
                            },
                            {
                                "example_id": "22cddf72-94e7-430d-be2c-8c49ecc2974c",
                                "sense_id": "6f32c917-117f-3e64-9e24-0b2cbe51098a",
                                "text": "„Der zerstreute Münchner Professor mit dem durchlöcherten Schirm könnte ohne weiteres der Zwillingsbruder des Österreichers Graf Bobby sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
