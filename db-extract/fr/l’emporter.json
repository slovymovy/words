        "fr-extract.jsonl": [
            {
                "entry_id": "0a806477-c765-3f00-b0ba-4a23cfbf6694",
                "word": "l’emporter",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                        "entry_id": "0a806477-c765-3f00-b0ba-4a23cfbf6694",
                        "glosses": [
                            "Avoir la supériorité, le dessus ; prévaloir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcdc2426-1e4c-4683-abee-93e16d772eaf",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "L’air s’obscurcit ; la fumée et le brouillard se mêlent sans qu’on sache qui l’emporte en épaisseur du brouillard ou de la fumée."
                            },
                            {
                                "example_id": "ac6bc36d-ab0d-4c67-b8dd-f33a9a872d25",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "Quand je la menai à l’autel, j’étais bien convaincu que ma femme l’emportait en beauté sur toutes les femmes belles de la terre."
                            },
                            {
                                "example_id": "4a187240-6f70-4810-8690-a41c1ee79121",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "En dépit de son bon vouloir, de sa passion pour le travail, le désespoir d’être loin des siens l’emportait chez Pasteur. Le mal du pays l’envahissait."
                            },
                            {
                                "example_id": "9281e87e-2c89-4285-85e1-41f4d8e32409",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "Manue l’emporte haut la main."
                            },
                            {
                                "example_id": "cf484961-2964-4d67-af51-faf881379c1d",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "Il n’y avait plus d’air dans la cour, rien que des odeurs. C’est celle du chou-fleur qui l’emporte facilement sur toutes les autres. Un chou-fleur vaut dix cabinets, même s’ils débordent."
                            },
                            {
                                "example_id": "cb67e3f8-38d4-41b0-b0c6-1371fdb6060c",
                                "sense_id": "85c8e371-e0cb-3fb7-bafd-6aee0c16683d",
                                "text": "Chez les métallurgistes, les grèves politiques l’emportent sur les grèves économiques pendant toute l’année 1905, encore qu’au début cette prédominance ait été beaucoup moins marquée qu’à la fin de l’année."
                            }
                        ]
                    },
                    {
                        "sense_id": "6bc7e158-b724-375d-bbea-205e0c843277",
                        "entry_id": "0a806477-c765-3f00-b0ba-4a23cfbf6694",
                        "glosses": [
                            "Peser davantage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "461b267e-dbee-420e-b053-a90c90c74f3f",
                                "sense_id": "6bc7e158-b724-375d-bbea-205e0c843277",
                                "text": "À volume égal, l’or l’emporte de beaucoup sur l’argent."
                            }
                        ]
                    },
                    {
                        "sense_id": "0816f83c-ab8f-3519-8d31-df51e33bf0ce",
                        "entry_id": "0a806477-c765-3f00-b0ba-4a23cfbf6694",
                        "glosses": [
                            "Être prépondérant, le plus important, dominer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cc8de99-2d1d-4a36-bdeb-43b9d2295c72",
                                "sense_id": "0816f83c-ab8f-3519-8d31-df51e33bf0ce",
                                "text": "À proximité de cette singularité, c’est le terme en √ qui l’emporte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1356830a-0f51-4025-949a-b669519ab4f7",
                        "source_entry_id": "0a806477-c765-3f00-b0ba-4a23cfbf6694",
                        "source_sense_description": "Avoir le dessus.",
                        "target_lang_word": "prevail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prevail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccce7ac0-7242-3d54-81e3-66c63eb85d07",
                                        "entry_id": "28209bf2-6d2f-352e-9d48-4cedbd39aae0",
                                        "glosses": [
                                            "To be superior in strength, dominance, influence, or frequency; to have or gain the advantage over others; to have the upper hand; to outnumber others."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffaf1f49-eb4c-4ae1-8978-6ae0e3164886",
                                                "sense_id": "ccce7ac0-7242-3d54-81e3-66c63eb85d07",
                                                "text": "Red colour prevails in the Canadian flag."
                                            },
                                            {
                                                "example_id": "f8746ca5-2f5e-49e9-8a31-ab4bf490ce7a",
                                                "sense_id": "ccce7ac0-7242-3d54-81e3-66c63eb85d07",
                                                "text": "And it came to pass, when Moses held up his hand, that Israel prevailed; and when he let down his hand, Amalek prevailed."
                                            },
                                            {
                                                "example_id": "7c4fe7d4-18c4-43a7-926c-015d36d4cad9",
                                                "sense_id": "ccce7ac0-7242-3d54-81e3-66c63eb85d07",
                                                "text": "Liverpool created a host of chances and had a Joel Matip goal ruled out for a foul and offside in an incident-packed game that went right down to the wire before Jurgen Klopp's side prevailed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8abdfc7-293b-3d63-94bb-c2938c666356",
                                        "entry_id": "28209bf2-6d2f-352e-9d48-4cedbd39aae0",
                                        "glosses": [
                                            "To triumph; to be victorious."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70b77517-929b-4908-a604-217af8956617",
                                                "sense_id": "f8abdfc7-293b-3d63-94bb-c2938c666356",
                                                "text": "There are a number of SCPs and tales that look at potential apocalypses, but rarely with such totality as SCP-2935, a parallel dimension in which death prevailed."
                                            },
                                            {
                                                "example_id": "75fb0b73-2cde-4b5f-b47f-cea6e75ea6c1",
                                                "sense_id": "f8abdfc7-293b-3d63-94bb-c2938c666356",
                                                "text": "Zakharova also made light of Moore’s claims that Russia will not be able to regain momentum in the war after the MI6 chief said he was”optimistic”^([sic]) Ukraine would prevail against the Russian invasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64679317-5bdd-347b-a80a-d3996359b68d",
                                        "entry_id": "28209bf2-6d2f-352e-9d48-4cedbd39aae0",
                                        "glosses": [
                                            "To be current, widespread, or predominant; to have currency or prevalence."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84ef68e3-6df2-4337-82ed-fd088945b02d",
                                                "sense_id": "64679317-5bdd-347b-a80a-d3996359b68d",
                                                "text": "In his day and age, such practices prevailed all over Europe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bf3d096-fbbb-38d7-b5e7-00ec390d5f8f",
                                        "entry_id": "28209bf2-6d2f-352e-9d48-4cedbd39aae0",
                                        "glosses": [
                                            "To succeed in persuading or inducing."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfe22d54-b95d-423c-ab90-2326336e1192",
                                                "sense_id": "8bf3d096-fbbb-38d7-b5e7-00ec390d5f8f",
                                                "text": "I prevailed on him to wait."
                                            },
                                            {
                                                "example_id": "2c902359-da65-42d1-a76b-585ad5e4f792",
                                                "sense_id": "8bf3d096-fbbb-38d7-b5e7-00ec390d5f8f",
                                                "text": "Jones began to be very importunate with the lady to unmask; and at length having prevailed, there appeared not Mrs Fitzpatrick, but the Lady Bellaston herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5307b09c-1e08-3939-917c-fca7aeb776b3",
                                        "entry_id": "28209bf2-6d2f-352e-9d48-4cedbd39aae0",
                                        "glosses": [
                                            "To avail."
                                        ],
