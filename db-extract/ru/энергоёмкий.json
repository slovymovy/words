                    },
                    {
                        "translation_id": "bacb346a-62a9-4a05-a0a3-bcfcca9557a4",
                        "source_entry_id": "1eaa9d40-8cd7-353f-bc90-f6997440cd1c",
                        "target_lang_word": "power-hungry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power-hungry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8704333-fa1a-3aae-9a37-c9b6d58ee383",
                                        "entry_id": "32d7639a-0ce5-38dc-9e1c-abd6644895a8",
                                        "glosses": [
                                            "Having a strong desire for power."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06bae626-9f1d-4950-96df-1bc76cb8f550",
                                                "sense_id": "b8704333-fa1a-3aae-9a37-c9b6d58ee383",
                                                "text": "The accused politician was a power-hungry man who broke the law so he could help his buddies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e5ace56-839c-33b6-b14e-a1625fb0e913",
                                        "entry_id": "32d7639a-0ce5-38dc-9e1c-abd6644895a8",
                                        "glosses": [
                                            "Of a device, using or requiring a large amount of electrical power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68b2d2ab-1aa2-40ce-91eb-24a7925a96c9",
                                                "sense_id": "6e5ace56-839c-33b6-b14e-a1625fb0e913",
                                                "text": "The latest model is also the most power-hungry in the lineup."
                                            },
                                            {
                                                "example_id": "d28fed07-86f8-4006-a83b-dbe95e08c7a0",
                                                "sense_id": "6e5ace56-839c-33b6-b14e-a1625fb0e913",
                                                "text": "Could we eventually see Class 800/802 trains exchanging their diesel engines for Fast Charge battery technology and 'opportunity charging', at each station stop on their long journey west? We're a long way from that being a possibility for heavy, power-hungry inter-city trains, but the Greenford line trial will provide GWR with the experience and data it needs to start the process of making diesel history."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
