                    {
                        "translation_id": "70c13eb4-77ce-4dbb-8dd5-0eb46a3400c4",
                        "source_entry_id": "d3b272a3-0346-367b-b022-622735128664",
                        "source_sense_id": "1c708c06-eb83-348a-bdf1-6e5a5b709a87",
                        "target_lang_word": "octaédrique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octaédrique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94b94d7a-c4ee-37fe-b28a-1d58b8118f99",
                                        "entry_id": "89d33b3a-4136-38a4-927a-f25e39560130",
                                        "glosses": [
                                            "Relatif à l’octaèdre ; qui en a les caractères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcecc017-cc37-46d1-8888-96c6a3e5b343",
                                                "sense_id": "94b94d7a-c4ee-37fe-b28a-1d58b8118f99",
                                                "text": "Les carbones sont des diamants polycristallins formés d'une matrice poreuse de cristallites anhédrales de très petites dimensions, de 0,5 à 20 microns, orientées au hasard, et entourant parfois des cristaux octaédriques ou cubiques bien formés de diamant, qui seraient de première génération, et atteignent 500 μ."
                                            },
                                            {
                                                "example_id": "7bd7ccd1-8125-4a89-bf6c-1ac98fcf701f",
                                                "sense_id": "94b94d7a-c4ee-37fe-b28a-1d58b8118f99",
                                                "text": "Les trois échantillons sur lesquels ont porté les expériences ont été pris dans le même cristal de magnétite octaédrique (provenance d'Essex, États-Unis)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "906080d0-341f-4826-bbfc-a9e450246f0b",
                        "source_entry_id": "d3b272a3-0346-367b-b022-622735128664",
                        "source_sense_id": "1c708c06-eb83-348a-bdf1-6e5a5b709a87",
                        "target_lang_word": "octaèdre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octaèdre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "69d88466-39c9-3b30-9b5c-527610912e3c",
                                        "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                                        "glosses": [
                                            "Corps solide à huit faces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662bdf96-6ef7-4043-be1a-50a042639b6e",
                                                "sense_id": "69d88466-39c9-3b30-9b5c-527610912e3c",
                                                "text": "L’acide oxalique concentré donne, avec les liqueurs contenant du strontium, à chaud des cristaux monocliniques ; à froid des octaèdres mêlés de tables pseudo-rectangulaires, à extinctions monocliniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8418a28-c764-3660-b041-5138d7e84727",
                                        "entry_id": "6aa126b9-398e-3f33-b7f2-0e84cbd97166",
                                        "glosses": [
                                            "Octaèdre régulier, dont les faces font huit triangles équilatéraux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95ac5c6f-03ad-437f-b7c3-b1ccbb71a5b8",
                                                "sense_id": "b8418a28-c764-3660-b041-5138d7e84727",
                                                "text": "Quand il est régulier (ses faces et les angles qui les séparent sont alors identiques), on parle de solide platonicien. Il existe cinq solides platoniciens distincts, le tétraèdre, le cube, l’octaèdre, le dodécaèdre et l’icosaèdre qui comportent respectivement 4, 6, 8, 12 et 20 côtés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
