                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2676380-4334-4530-8c07-cbd2345e4e91",
                                                "sense_id": "8fc0a92e-60ed-368c-a233-01e61f38ef92",
                                                "text": "Bitte detaillieren Sie Ihre Beschwerde, damit wir Ihnen besser helfen können."
