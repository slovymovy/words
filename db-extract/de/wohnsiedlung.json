                "senses": [
                    {
                        "sense_id": "bcbd93d8-9531-3b8b-a79d-4b2ec2f09807",
                        "entry_id": "0b5ccf74-dea7-3dc4-bbc0-da84ac2e2015",
                        "glosses": [
                            "zusammenhängendes Gebiet mit Wohnhäusern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddb35b01-f4cf-4c01-a56b-2774ad10d16a",
                                "sense_id": "bcbd93d8-9531-3b8b-a79d-4b2ec2f09807",
                                "text": "„Es entstanden große Wohnsiedlungen mit modernen sanitären Anlagen und Elektrizität, vor allem für kinderreiche Familien, Kriegsinvaliden und Kriegerwitwen.“"
                            },
                            {
                                "example_id": "d3d03636-e158-4bb7-9983-7d0957974c7c",
                                "sense_id": "bcbd93d8-9531-3b8b-a79d-4b2ec2f09807",
                                "text": "„Ich folgte ihr mit dem Blick bis Berg, vorbei an dem schleimigen Brackwasser bei Bergsbotn, über die Brücke nach Bjerka, dann hoch zu der Wohnsiedlung, wo das Gartenfest stattfand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55d08645-0869-4949-a09f-5e3ff0a7c886",
                        "source_entry_id": "0b5ccf74-dea7-3dc4-bbc0-da84ac2e2015",
                        "source_sense_id": "bcbd93d8-9531-3b8b-a79d-4b2ec2f09807",
                        "source_sense_description": "zusammenhängendes Gebiet mit Wohnhäusern",
                        "target_lang_word": "συνοικία",
                        "target_lang_code": "el",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "συνοικία",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "288bbc53-feec-3927-ad82-194a1d62bbad",
                                        "entry_id": "21d720b8-23dd-32f0-872e-a7da57cd28e5",
                                        "glosses": [
                                            "τμήμα ενός οικισμού (πόλης, κωμόπολης κ.λπ.) με συγκεκριμένα όρια και χαρακτηριστικά"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d0c2ccc-6b66-4ca1-9fba-b8d443a8b231",
                                                "sense_id": "288bbc53-feec-3927-ad82-194a1d62bbad",
                                                "text": "※ Έχω ένα δωμάτιο στον Ταύρο. Τη συνοικία κάτω κάτω στην οδό Πειραιώς.",
                                                "translation": "⌘ Γιάννης Ξανθούλης Ο Σόουμαν δεν θα 'ρθει απόψε (1985) [μυθιστόρημα]"
                                            },
                                            {
                                                "example_id": "93bedd1c-73a5-4585-97f2-e3a0fb2e85a3",
                                                "sense_id": "288bbc53-feec-3927-ad82-194a1d62bbad",
                                                "text": "※ Ο μπακάλης της συνοικίας είχεν ακόμη ανοικτόν το εργαστήριόν του. Μετέβην και έφερα μίαν οκάν κρασί και αρκετά φουντούκια και εκαθίσαμεν επί αρκετήν ώραν πίνοντες ευθύμως παρά το θαυματουργόν τραπέζιον (Χαράλαμπος Άννινος, Αττικαί ημέραι, Α, 1894)"
                                            },
                                            {
                                                "example_id": "61ad7594-5988-4bac-865d-df261bffaac4",
                                                "sense_id": "288bbc53-feec-3927-ad82-194a1d62bbad",
                                                "text": "※ Τι σπίτι; Μια μεζονέτα που ο Ρίκος τη χάζευε με ανοιχτό το στόμα, μην μπορώντας να χωνέψει την ιδέα πως θα έμενε σʼ αυτήν τη μεγαλοαστική συνοικία.",
                                                "translation": "Κώστας Ακρίβος, Καιρός για θαύματα, αρχική έκδοση από τις εκδόσεις: Κέδρος, Αθήνα 2005, ISBN 9789600427226, @google.gr/books"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
