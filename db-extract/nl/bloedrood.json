                ],
                "senses": [
                    {
                        "sense_id": "21af6053-55e5-37f9-b81c-506664d14911",
                        "entry_id": "701bb541-5a83-340c-b647-8f684cb22707",
                        "glosses": [
                            "rood als de kleur van bloed"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0360da36-22a5-41b7-b091-d8a0efdd91a9",
                                "sense_id": "21af6053-55e5-37f9-b81c-506664d14911",
                                "text": "De kleding overgeleverd op de stijve foto’s uit die eeuw heeft hier kleur, lichtblauw en donkerrood, roestbruin en bloedrood, verenigd in lieflijke en woeste patronen."
                            },
                            {
                                "example_id": "12d61680-f2cd-417d-a28e-f8e673c481c7",
                                "sense_id": "21af6053-55e5-37f9-b81c-506664d14911",
                                "text": "Na een tijdje stond ze op en keek ze in de spiegel, maar daar werd ze ook niet bepaald opgewekter van. Haar ogen waren bloedrood."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9b5538d-8f8b-396c-89a2-364e4e23f3ce",
                        "entry_id": "701bb541-5a83-340c-b647-8f684cb22707",
                        "glosses": [
                            "heel erg rood, vaak gebruikt in een meer figuurlijke betekenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02388dda-cc16-4ba6-a1d5-0f4c1c4bd887",
                                "sense_id": "e9b5538d-8f8b-396c-89a2-364e4e23f3ce",
                                "text": "Nadat de beurzen alsnog een bescheiden eindejaarsrally lieten zien, waren de eerste dagen van januari alweer bloedrood."
                            },
                            {
                                "example_id": "108db1d1-1b5e-40c3-9797-8d6f859fe9a4",
                                "sense_id": "e9b5538d-8f8b-396c-89a2-364e4e23f3ce",
                                "text": "Helwitte vlakken en zwarte schaduwen wisselen elkaar af op het toneel. De kleding van de acteurs is diep paars, groen of geel. Lippen zijn bloedrood, oranje is de haardos van Dafoe."
                            }
                        ]
                    }
                ],
