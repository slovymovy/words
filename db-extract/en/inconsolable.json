                        "glosses": [
                            "Not consolable; unable to be consoled or comforted, usually due to grief, disappointment, or other distress."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18a0995d-8dd4-405c-b6a3-aae96ed18cf7",
                                "sense_id": "d8a9eb4b-550c-391e-8594-96ce28cde0ff",
                                "text": "Near-synonyms: miserable, despondent; see also Thesaurus:sad"
                            },
                            {
                                "example_id": "0342280a-dbcc-464c-85c4-4403eed1b5d1",
                                "sense_id": "d8a9eb4b-550c-391e-8594-96ce28cde0ff",
                                "text": "Salah looked inconsolable as he was led from the pitch and Sergio Ramos had some nerve offering a sympathetic hug on the way off."
                            }
                        ]
                    }
                ],
