                "senses": [
                    {
                        "sense_id": "22c7c783-c1f5-3d53-9723-3fcf11f9f4f0",
                        "entry_id": "1da4ac38-cdd5-349f-b9e4-153abe3c76af",
                        "glosses": [
                            "Action de modifier légèrement la carrosserie ou les équipements extérieurs d’un véhicule, de façon à le rajeunir, sans apporter de transformations profondes à sa ligne générale."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "80b865e7-49bf-4055-9ea3-75fec48d7d53",
                                "sense_id": "22c7c783-c1f5-3d53-9723-3fcf11f9f4f0",
                                "text": "Ce restylage pourrait aussi être l'occasion pour Citroën de faire quelques économies sur les coûts de production de sa berline compacte, la marque n'ayant désormais aucune gêne à empiéter sur les plates-bandes de Dacia."
                            },
                            {
                                "example_id": "776e61f2-5f26-4fd6-bd1a-856e9ae575c9",
                                "sense_id": "22c7c783-c1f5-3d53-9723-3fcf11f9f4f0",
                                "text": "Le restylage du Honda HR-V se concentre essentiellement sur des ajustements esthétiques qui apportent une touche de fraîcheur sans bouleverser le design d’origine."
                            },
                            {
                                "example_id": "a8d58da6-bd34-4382-bfdf-ed55d548249e",
                                "sense_id": "22c7c783-c1f5-3d53-9723-3fcf11f9f4f0",
                                "text": "Ce partenaire industriel est souvent lié au constructeur par un contrat d’une durée proche de la durée de vie du modèle (jusqu’à un restylage par exemple)."
                            }
                        ]
                    }
                ],
