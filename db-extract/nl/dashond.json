                "senses": [
                    {
                        "sense_id": "343a5118-d518-3086-83e4-755db2aaa141",
                        "entry_id": "c4f17c06-2f77-372e-aa16-297f0ffb015b",
                        "glosses": [
                            "hondenras, klein, met lang lijf en korte poten, die speciaal gefokt wordt voor de jacht op dassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7b6fc61-419d-4b73-b0e0-9395d552f268",
                                "sense_id": "343a5118-d518-3086-83e4-755db2aaa141",
                                "text": "Hij heeft thuis een dashond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39decada-8dfe-4b29-9813-c111910e1c51",
                        "source_entry_id": "c4f17c06-2f77-372e-aa16-297f0ffb015b",
                        "source_sense_id": "343a5118-d518-3086-83e4-755db2aaa141",
                        "target_lang_word": "Dackel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dackel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                        "entry_id": "090ad0cc-cffa-32b3-82a9-21eb7043a611",
                                        "glosses": [
                                            "kleiner Hund, der traditionell zur Jagd eingesetzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393587f1-d850-4f5f-bb02-6bbeed48deee",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "Dackel sind beliebte Jagdhunde, weil sie wegen ihrer kurzen Beine gut in Fuchs- und Dachsbaue kriechen können."
                                            },
                                            {
                                                "example_id": "bdc64dba-f276-4702-b0f6-ce65fcc2f5d2",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "„Ich wollte auch einen Dackel haben, aber Mama sagte, vier Kinder seien ihr genug, da brauche sie nicht auch noch einen Köter im Haus.“"
                                            },
                                            {
                                                "example_id": "ebd446f2-54aa-46d3-b744-74de194ed556",
                                                "sense_id": "7cc21a3a-375f-3b98-a59b-803908d0c7b7",
                                                "text": "„Mutter Helene züchtete Schäferhunde und Dackel, die in Ostpreußen Teckel genannt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a570499-6059-3226-94b4-071838e15cdb",
                                        "entry_id": "090ad0cc-cffa-32b3-82a9-21eb7043a611",
                                        "glosses": [
                                            "ein dummer, blöder Kerl"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eede2120-add5-49f8-90fc-587f5f2664dd",
                                                "sense_id": "4a570499-6059-3226-94b4-071838e15cdb",
                                                "text": "Ach, du bist eben ein Dackel!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01538ef5-9096-4625-9b3c-3887664559f0",
                        "source_entry_id": "c4f17c06-2f77-372e-aa16-297f0ffb015b",
                        "source_sense_id": "343a5118-d518-3086-83e4-755db2aaa141",
                        "target_lang_word": "dachshund",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dachshund",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                        "entry_id": "eb45c431-1470-30af-8206-5e0ffcb9b13a",
                                        "glosses": [
                                            "A certain breed of dog having short legs and a long trunk, including standard-sized, miniature (smooth-haired, long-haired, and short-haired) varieties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375a61f2-6c1d-46d3-908a-5697e9bb9f4f",
                                                "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                                "text": "Say what you will of dachshunds, their peculiar shape makes them the easiest breed of dog to trip over in existence."
                                            },
                                            {
                                                "example_id": "1456edb8-df9a-45db-9c9f-db2d53af2cc0",
                                                "sense_id": "57dcf017-5cbc-3307-876f-ae0b27706cb0",
                                                "text": "We had decided to take a small dog for the children and we chose a tan, short-haired, six-week-old male dachshund. We named him Fritz."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "546279e8-04e0-4136-bccf-8905e67025e7",
                        "source_entry_id": "c4f17c06-2f77-372e-aa16-297f0ffb015b",
                        "source_sense_id": "343a5118-d518-3086-83e4-755db2aaa141",
                        "target_lang_word": "teckel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "teckel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                        "entry_id": "b6363a7a-1bd6-3cfe-80be-2c03ddd3e525",
                                        "glosses": [
                                            "Race de chien originaire d’Allemagne, basset (chien long et court sur pattes), à poil long, ras ou dur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1788554c-db93-4a84-8ad6-71bd9378808d",
                                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                                "text": "Elle en a élevé une trentaine sur des générations, avec une préférence pour la race Pembroke, mais a aussi créé le « dorgi », croisement du corgi et du teckel."
                                            },
                                            {
                                                "example_id": "694f7d01-4f96-44ce-9e28-ad3d25da02ef",
                                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                                "text": "Les teckels forment le groupe 4 du classement des races de chien par la société centrale canine ou SCC."
                                            },
                                            {
                                                "example_id": "3f7c468c-d985-415d-8fb0-7bb79d9887f9",
                                                "sense_id": "49ac2b61-53d2-32d5-8bf2-7eb08e5cfc0b",
                                                "text": "Votre service de table peut être accompagné des porte-couteaux aux modèles variés : cerfs, teckels ou canards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f1c64f8-c5c0-426b-bd8a-a4087fb94a4b",
                        "source_entry_id": "c4f17c06-2f77-372e-aa16-297f0ffb015b",
