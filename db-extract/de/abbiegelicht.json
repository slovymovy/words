                        "entry_id": "eb05e15c-a4e5-337f-a71f-194cab223cc4",
                        "glosses": [
                            "Scheinwerferlicht, das sich einschaltet, wenn man bei niedriger Geschwindigkeit lenkt (also insbesondere abbiegt), wodurch das ausgeleuchtete Sichtfeld seitlich erweitert wird"
                        ],
                        "tags": [
                            "Kraftfahrzeugtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "536ed5dc-de54-421b-98a7-7acf86fa2a43",
                                "sense_id": "213fae80-4959-3e99-b479-8c701e815de3",
                                "text": "„Die teuerste Ausstattungslinie Style verfügt ferner über LED-Tagfahrlicht, Nebelscheinwerfer und Abbiegelicht, Leichtmetallfelgen und Bluetooth-Freisprecheinrichtung.“"
                            },
                            {
                                "example_id": "6c3c3883-5ac5-4892-92af-ada52a568d68",
                                "sense_id": "213fae80-4959-3e99-b479-8c701e815de3",
                                "text": "„Die Blinker und das Abbiegelicht arbeiten mit LED-Technik.“"
                            }
                        ],
