                "senses": [
                    {
                        "sense_id": "8913ddc8-bf25-3bfa-b422-13d48a5670ab",
                        "entry_id": "09d2675e-4ab1-34bc-81a7-22cef744c0aa",
                        "glosses": [
                            "ufo, mimozemšťan, neidentifikované létající těleso, UFO (objet volant non identifié)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ffd8cc8-b19e-4294-a51d-85763de72b49",
                                "sense_id": "8913ddc8-bf25-3bfa-b422-13d48a5670ab",
                                "text": "Dans cet ouvrage, vous affirmez, à partir de documents déclassifiés, que les présidents américains entre 1942 et 1954 ont menti sur la question des ovnis. Pourquoi pensez-vous qu’ils existent ?"
                            },
                            {
                                "example_id": "87e2083e-ea4f-431a-8858-53ffac94f2bb",
                                "sense_id": "8913ddc8-bf25-3bfa-b422-13d48a5670ab",
                                "text": "Et les ovnis, direz-vous ? Ne sont-ils pas la preuve d’une intelligence extraterrestre ? Ils le seraient s’ils existaient. Or rien n’est moins prouvé à ce jour.",
                                "translation": "Namítnete, a co létající talíře? Nejsou důkazem mimozemské inteligence? Byly by, pokud by existovaly. Nic však není v současnosti méně prokázaného."
                            }
                        ]
                    },
                    {
