                    {
                        "sense_id": "cee8a5f3-6f8c-3041-9bb7-3825b14bbfec",
                        "entry_id": "fc62feab-5bb1-35aa-a595-47095751475d",
                        "glosses": [
                            "miasto hanzeatyckie, w północnych Niemczech, w kraju związkowym Szlezwik-Holsztyn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd91c00-f7b0-4770-9add-81eabf1bcfa4",
                                "sense_id": "cee8a5f3-6f8c-3041-9bb7-3825b14bbfec",
                                "text": "Cech Złotników z Lubeki ogłosił konkurs złotniczy, do udziału w którym zaproszeni są wszyscy twórcy biżuterii z krajów nadbałtyckich: Litwy, Łotwy, Estonii, Polski, Norwegii, Finlandii, Szwecji, Danii, Rosji (Kaliningrad i Petersburg) i Niemiec"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2967e94-eac1-44d5-8d17-09aca16fb69b",
                        "source_entry_id": "fc62feab-5bb1-35aa-a595-47095751475d",
                        "source_sense_id": "cee8a5f3-6f8c-3041-9bb7-3825b14bbfec",
                        "target_lang_word": "Lübeck",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lübeck",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4fbf3c-5083-30f5-8126-44e6d148bbf4",
                                        "entry_id": "c642471c-ad55-3d90-893a-ede73d70c9bc",
                                        "glosses": [
                                            "A city in Schleswig-Holstein, north-central Germany, northeast of Hamburg; a major Baltic port and industrial center, the present city dates from 1143 and was the leading town of the Hanseatic League after its designation as a free city in 1226; it retained that status until 1937."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8cd1f55-ce21-42ea-a7d9-2bcbb62329c1",
                        "source_entry_id": "fc62feab-5bb1-35aa-a595-47095751475d",
                        "source_sense_id": "cee8a5f3-6f8c-3041-9bb7-3825b14bbfec",
                        "target_lang_word": "Lübeck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lübeck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1ba717b-ed0b-333d-977b-e1b13d5f8921",
                                        "entry_id": "156a4893-7e09-3d41-bdc8-03fbf417f897",
                                        "glosses": [
                                            "eine Hansestadt in Schleswig-Holstein, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0b0f19b-6731-4318-8f61-8986f2c6b4a2",
                                                "sense_id": "f1ba717b-ed0b-333d-977b-e1b13d5f8921",
                                                "text": "Lübeck liegt an der Trave."
                                            },
                                            {
                                                "example_id": "2e11de1b-8a0c-4175-a50b-e716ca4bd722",
                                                "sense_id": "f1ba717b-ed0b-333d-977b-e1b13d5f8921",
                                                "text": "„Eigentlich beginnt der Osten bereits in Lübeck selbst, das vor nunmehr 850 Jahren als bescheidene Siedlung fremder Kaufleute auf slawischem Grund errichtet wurde.“"
                                            },
                                            {
                                                "example_id": "a754e908-2e7e-4489-bbf7-436e11a3ff27",
                                                "sense_id": "f1ba717b-ed0b-333d-977b-e1b13d5f8921",
                                                "text": "„In Lübeck hat er Schriftsetzer gelernt, nahm als Kriegsfreiwilliger an den Befreiungskriegen gegen Napoleon teil und kam um 1814 nach Frankfurt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
