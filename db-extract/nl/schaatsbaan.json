                            {
                                "example_id": "23ec622d-23eb-4db0-a1e1-24ea43edd2e3",
                                "sense_id": "b7cf6b14-a761-3b45-8483-407be21effa5",
                                "text": "Van Deutekom was tussen 1998 en 2012 actief op de schaatsbaan. Haar absolute topjaar was 2008, toen ze in Berlijn de wereldtitel allround veroverde. Ze onttroonde Ireen Wüst en werd de vijfde Nederlandse schaatsster die de WK allround op haar naam schreef."
                            },
                            {
                                "example_id": "c2667267-a5cb-4826-a40d-2a465502427d",
                                "sense_id": "b7cf6b14-a761-3b45-8483-407be21effa5",
                                "text": "De verwachtingen rondom Schulting zijn hooggespannen dit EK. Wie naar de schaatsbaan in Dordrecht trekt, ziet het gezicht van de olympisch kampioene op de 1.000 meter op de toernooivlaggen prijken."
                            }
                        ]
