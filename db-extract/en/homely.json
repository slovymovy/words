                        "examples": [
                            {
                                "example_id": "1bf6b4e2-f82f-4866-8718-15e926d6ea52",
                                "sense_id": "15d1dffc-650c-3fd2-bad0-a8f425311f29",
                                "text": "I am seeking a beautiful homely girl for marriage.",
                                "translation": "我想找一个注重家庭的女子结婚。"
                            }
                        ]
                    },
                    {
                        "sense_id": "aed1fa46-7f8d-3852-aef9-4affab290ca7",
                        "entry_id": "88712b80-442d-3309-819f-99f8aa2ff535",
                        "glosses": [
