                    {
                        "translation_id": "274ea048-52f2-4c56-a068-c59ec61de80c",
                        "source_entry_id": "01698213-c711-336d-8342-40b053b00ece",
                        "source_sense_description": "bus that is a motor vehicle",
                        "target_lang_word": "autobus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autobus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                        "entry_id": "bfcf01be-868a-30b5-87a8-b12be806721a",
                                        "glosses": [
                                            "Véhicule de transports en commun, sur des lignes urbaines régulières, comptant des places pour voyager assis et d’autres pour voyager debout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9bdfcaf-eab2-4503-ad59-5814c80d98f7",
                                                "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                                "text": "À toute allure les autobus, les omnibus et les charrettes de commissionnaires voituraient malles et valises vers la gare ; sur les quai envahis, l’exode des hiverneurs d’élite se heurtait à la bousculade des voyageurs de toute espèce."
                                            },
                                            {
                                                "example_id": "1c2d4c08-3c29-4ef4-9e3b-2d8eea6bb433",
                                                "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                                "text": "Il haussa les épaules, et, lentement, tête baissée, il se dirigea vers la rue Drouot où il savait trouver son autobus."
                                            },
                                            {
                                                "example_id": "e8329375-76f9-4c89-bc12-868b58059e5b",
                                                "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                                "text": "De volumineux autobus arrivent, chargés à craquer : leur toit est même garni de paysans hilares assis en rang, à la place des marchandises, comme sur une impériale."
                                            },
                                            {
                                                "example_id": "54fad417-14a7-4613-b170-398d1abc76b7",
                                                "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                                "text": "Le voyage de Zaheira fut pénible. L’autobus était bourré de paysans chargés de lourds paniers, de sacs de victuailles et accompagnés d’une marmaille d’enfants. Il cahotait sur toutes les ornières de la route."
                                            },
                                            {
                                                "example_id": "654d42d8-2794-4ad9-bd04-aa0599814856",
                                                "sense_id": "1f24f6cb-ea71-3cf5-80ea-0256e847530a",
                                                "text": "Avec 56 lignes et 2 navettes, le réseau d’autobus est particulièrement bien développé sur le territoire métropolitain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee9b36cc-dfd7-45be-83ac-504f4d81edc4",
                        "source_entry_id": "01698213-c711-336d-8342-40b053b00ece",
                        "source_sense_description": "bus that is a motor vehicle",
                        "target_lang_word": "Autobus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
