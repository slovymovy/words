                    {
                        "sense_id": "2942ce2f-74f1-33b6-a5fe-4fe3aef93aff",
                        "entry_id": "8c744de9-21dc-30b3-ad94-158241941683",
                        "glosses": [
                            "Manière insinuante et artificieuse d’un patelin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c80de3-df0c-4f55-b5a4-f5491efa0793",
                                "sense_id": "2942ce2f-74f1-33b6-a5fe-4fe3aef93aff",
                                "text": "Canalis se distingue de Lamartine, le chef de l’École Angélique, par un patelinage de garde-malade, par une douceur traîtresse, par une correction délicieuse."
                            },
                            {
                                "example_id": "a2965b95-b8e4-4bad-b0bd-65bf27e8c8b5",
                                "sense_id": "2942ce2f-74f1-33b6-a5fe-4fe3aef93aff",
                                "text": "Elle avait fini par comprendre la vie en se voyant à la merci de tout le monde ; et voulant plaire à tout le monde, elle riait avec les jeunes gens à qui elle était sympathique par une espèce de patelinage qui les séduit toujours, elle devinait et épousait leurs désirs, elle se rendait leur interprète, elle leur paraissait être une bonne confidente, car elle n’avait pas le droit de les gronder."
                            }
                        ]
                    }
