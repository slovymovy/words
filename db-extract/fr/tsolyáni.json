                "senses": [
                    {
                        "sense_id": "9b34e2da-76f1-3b73-a2ab-7e76e614c818",
                        "entry_id": "71d707d4-c393-3403-89f3-edd1a28554eb",
                        "glosses": [
                            "Langue artificielle créée par Muhammad Abd-el-Rahman Barker, et langue officielle de l’empire Tsolyánu, une des nations dominantes de l’univers imaginaire de Tékumel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc93c8b-d057-4a07-b99e-65ec02623ae0",
                                "sense_id": "9b34e2da-76f1-3b73-a2ab-7e76e614c818",
                                "text": "Les Tsolyáni humains parlent le tsolyáni."
                            },
                            {
                                "example_id": "6776d0c9-0da1-4718-a3c9-f1131e5f6a11",
                                "sense_id": "9b34e2da-76f1-3b73-a2ab-7e76e614c818",
                                "text": "Le tsolyáni s’écrit à l’aide de l’alphabet engsvanyáli."
                            },
                            {
                                "example_id": "28736761-6599-4f25-b20c-03e7d64d843a",
                                "sense_id": "9b34e2da-76f1-3b73-a2ab-7e76e614c818",
                                "text": "Le tsolyáni, le mu’ugalavyáni, le salarvyáni et le livyáni appartiennent à la famille des langues khíshanes."
                            }
                        ]
                    }
