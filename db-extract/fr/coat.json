                                        "entry_id": "0a3cdcfb-5b2f-37b5-bd84-0eadd6ac4ba9",
                                        "glosses": [
                                            "A coat of arms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
