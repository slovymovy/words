                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d3553c9f-c62e-4665-8257-5f5f80401e91",
                        "source_entry_id": "28b61fb0-2ed0-397d-867a-18accb9cf4a1",
                        "source_sense_id": "472e0273-8cff-3d82-b832-7ad436c33a07",
