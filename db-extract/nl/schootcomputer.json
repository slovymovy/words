                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6ff77ea-d3ef-40eb-bfa7-11fe7c9e875d",
                                "sense_id": "3b8442b8-7279-34aa-af7f-7ca0db1f9938",
                                "text": "Als je telkens op en neer reist, is het misschien handiger om een schootcomputer te gebruiken, die kun je tenminste meenemen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a55ebc38-98d8-4faf-9dbb-f5e522a4e3f4",
                        "source_entry_id": "aa94c281-1e68-36fb-8074-e427a9abbc4b",
                        "source_sense_id": "3b8442b8-7279-34aa-af7f-7ca0db1f9938",
                        "source_sense_description": "een invouwbare, draagbare computer",
                        "target_lang_word": "Laptop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laptop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                        "entry_id": "8fb77eae-c1ef-3308-98ba-c198bb1f63d4",
                                        "glosses": [
                                            "tragbarer Computer mit Batteriebetrieb/Akku, der meist schwerer und größer ist als ein Notebook"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "053ea3c8-80eb-4e3b-9a3f-3cde3ba0ca5e",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "Ohne einen Laptop geht heute fast kein Student mehr in die Bibliothek."
                                            },
                                            {
                                                "example_id": "1af27bcf-f680-4dc0-9c65-8cc25e049a09",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "Bei einem Laptop ist die Akkulaufzeit ein wichtiges Kaufkriterium."
                                            },
                                            {
                                                "example_id": "8493115c-f7b0-46ab-bc72-b30c059f580e",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "„Sie tippt auf der Tastatur ihres Laptops herum, bis sie merkt, dass sie umstellt ist.“"
                                            },
                                            {
                                                "example_id": "d24352f3-18f6-4a1f-8159-84ec0984d5c4",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "„Wenn ich jetzt von meinem Laptop aufsehe, kann ich durch mein Dachfenster hinüberschauen zu den zwei Fenstern des schmucklosen Apartmenthauses aus der Zwischenkriegszeit.“"
                                            },
                                            {
                                                "example_id": "39743ec5-4e0d-4ff7-962b-d744c09f9925",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "„Von weit her kamen Webmaster, technische Helfer, Linguisten (aus Deutschland), Spenden für Laptops und eine Solarstromanlage.“"
                                            },
                                            {
                                                "example_id": "cefedcb5-39aa-4709-ae0a-454967d1db6b",
                                                "sense_id": "a15a5bee-8aea-397f-908a-22e4f6500ea0",
                                                "text": "„Ich hatte gestern sogar auf dem Bildschirm des Laptops den Cursor geschlagen, weil ich dachte, es sei eine Mücke.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
