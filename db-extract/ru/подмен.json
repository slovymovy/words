                    }
                ],
                "translations": [
                    {
                        "translation_id": "20432b5f-0d52-474b-9ab6-2ab6f75f0da6",
                        "source_entry_id": "333f2f33-5c9c-3d4b-afae-56cb03c851ee",
                        "source_sense_id": "0d48565a-7d26-3fe3-b2dd-2b5c5f9760ed",
                        "target_lang_word": "substitution",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "substitution",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                                        "glosses": [
                                            "Action de substituer, de remplacer une personne ou une chose à la place d’une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b7cbf7-d067-46d4-8747-be968ae68dec",
                                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                                "text": "La veulerie des hommes de ce temps fut si grande que parfois la substitution du nouveau personnel à l'ancien prenait des allures bouffonnes."
                                            },
                                            {
                                                "example_id": "2affa4bd-e736-4a83-bd5d-bd80d6af5838",
                                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                                "text": "Ensuite celle-là n'est qu'une substitution de termes, car entre l’innéité et la primordialité, il n'y a pas de différence pratique, et les adversaires de l'une sont nécessairement ceux de l'autre aussi."
                                            },
                                            {
                                                "example_id": "06187e96-4eec-42b7-8a82-969955042dbd",
                                                "sense_id": "3b66b439-a8af-377e-a4e5-1ac48e4617fb",
                                                "text": "Il n'en demeure pas moins que la substitution des archives judiciaires aux archives notariales amène un changement de tonalité dans l'éclairage : à une vision « lisse » se substitue une vision « rugueuse » des relations sociales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aadf179-1769-3ab0-be50-26e7b385b209",
                                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                                        "glosses": [
                                            "Remplacement d’un atome ou d'un radical par un autre dans une molécule."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5673c88b-7ebd-461e-bcb4-cb8bc1511084",
                                                "sense_id": "1aadf179-1769-3ab0-be50-26e7b385b209",
                                                "text": "Le formène est surtout intéressant par les dérivés de substitution qu'il forme avec les halogènes Cl, Br, I."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                                        "entry_id": "b42db186-9123-3f44-b628-16965fce7661",
                                        "glosses": [
                                            "Disposition par laquelle on appelle à sa succession un ou plusieurs héritiers successivement, après celui qu’on a institué, de manière que celui-ci ne peut aliéner les biens sujets à la substitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e74f113a-1609-4e79-b2b2-39bc54591822",
                                                "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                                                "text": "Dans le même souci de protection du lignage, le père pouvait cependant, s'il se méfiait de ses enfants, les obliger à conserver le patrimoine pour leurs propres enfants : c'est la substitution si répandue dans notre ancien régime."
                                            },
                                            {
                                                "example_id": "0de83937-3517-4a34-ad29-94c75a27289e",
                                                "sense_id": "49e65d6f-9174-3521-9533-75a24fcc95db",
                                                "text": "Extrêmement fréquent suivant les pratiques nobles est en Forez aux XVIIᵉ et XVIIIᵉ siècles l’usage des substitutions, qui prolonge une tradition bien ancrée dès la période médiévale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bdcf77c-cda4-4b69-89bb-bac46b608640",
                        "source_entry_id": "333f2f33-5c9c-3d4b-afae-56cb03c851ee",
                        "source_sense_id": "0d48565a-7d26-3fe3-b2dd-2b5c5f9760ed",
                        "target_lang_word": "remplacement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remplacement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Action de remplacer une chose par une autre ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24856779-4b07-4cca-9b16-5914c288b986",
                                                "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                                "text": "Les arrêts sont en effet plus fréquents au renvideur par suite des réparations, remplacements de cordes et de câbles et nettoyages plus difficultueux."
                                            },
                                            {
                                                "example_id": "5b2e311c-eb1c-4115-8132-aab4b3049fd3",
                                                "sense_id": "387d6719-d1ba-3c5e-8fa1-bc13f9c247d1",
                                                "text": "L'utilisation des additions minérales dans les bétons en remplacement au ciment est une pratique courante depuis de nombreuses années."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Action de remplacer une personne par une autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9b40bb-2f64-4c31-960d-8476c88e17b8",
                                                "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                                "text": "Le concept de remplacement des gens que l'on fréquente et qui nous sont proches par des humanoïdes est évidemment puissant et traumatisant car il suscite le doute et la paranoïa aiguë."
                                            },
                                            {
                                                "example_id": "85cf2b9e-08ad-4b79-8e64-2272aaef7464",
                                                "sense_id": "04fd1e67-0a1d-3eca-aebd-4621bba9d025",
                                                "text": "Pourvoir au remplacement d’un juge, d’un employé, d’un commis. — Le remplacement d’un titulaire par un remplaçant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c84834b3-0c78-3fbf-b874-64bf1eeb2860",
                                        "entry_id": "2de527b7-799f-3b1f-ab83-1f93b41b0b92",
                                        "glosses": [
                                            "Substitution d'un conscrit par un volontaire moyennant rétribution."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "672f3db6-fbfe-4293-80db-17abce18fb85",
                                                "sense_id": "c84834b3-0c78-3fbf-b874-64bf1eeb2860",
                                                "text": "Le remplacement a été aboli en France par la loi Berteaux du 21 mars 1905 instaurant le service militaire universel ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
