        "fr-extract.jsonl": [
            {
                "entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                "word": "cosmique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1242e018-0748-4758-8e20-20ff8aa33183",
                        "entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "cosmiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05dd2a02-8cd3-3bb7-9a71-7ba830ceee80",
                        "entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                        "glosses": [
                            "Relatif à l’univers."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b8db4b36-39dc-4fb6-9e37-2633383c7b62",
                                "sense_id": "05dd2a02-8cd3-3bb7-9a71-7ba830ceee80",
                                "text": "La parousie en effet constituera une apocatastase générique et cosmique, un \"rétablissement\" de tous et de tout dans l'énergie divine."
                            },
                            {
                                "example_id": "d4b34186-01e0-4f5b-bf20-6f14c33537d4",
                                "sense_id": "05dd2a02-8cd3-3bb7-9a71-7ba830ceee80",
                                "text": "Le pouvoir caché que le magicien utilise est (les idoles), les êtres divins et les pouvoirs cosmiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3261de9-9cc6-3210-91e3-52157f3e9de9",
                        "entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                        "glosses": [
                            "Qualifie les parties constitutives de l'univers."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "38e37924-abb9-4740-9dd5-f157903e19f4",
                                "sense_id": "a3261de9-9cc6-3210-91e3-52157f3e9de9",
                                "text": "Si la chaleur cosmique diminue, c'est donc que le monde n'a pas toujours existé, sans quoi, […], il y a longtemps qu'elle serait complétement usée."
                            },
                            {
                                "example_id": "702e9a22-ede0-479a-9f43-c50f0cad71c9",
                                "sense_id": "a3261de9-9cc6-3210-91e3-52157f3e9de9",
                                "text": "Dans l’espace, de graves dangers nous guettent, parmi lesquels : micrométéorites, radiations cosmiques mortelles et vieillissement accéléré en apesanteur."
                            },
                            {
                                "example_id": "c0131113-857f-4aa3-b1c4-4b257643a76f",
                                "sense_id": "a3261de9-9cc6-3210-91e3-52157f3e9de9",
                                "text": "Les espaces cosmiques, la matière cosmique."
                            }
                        ]
                    },
                    {
                        "sense_id": "56394e15-1536-3b27-881c-d494e540d22d",
                        "entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                        "glosses": [
                            "Qualifie la position d'un astre qui ne peut être observé, mais seulement calculé, à cause de l’éclat trop vif du soleil."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "d97f60c0-9881-41c1-8c0d-aaa5544c4a46",
                                "sense_id": "56394e15-1536-3b27-881c-d494e540d22d",
                                "text": "Le lever ou le coucher cosmique d’une étoile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4d39f99-7849-43dc-b093-e0e023ad8933",
                        "source_entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
                        "target_lang_word": "kosmisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kosmisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "05b897cf-aa5c-3122-81ac-a4ea1fdef294",
                                        "entry_id": "9ac86e24-68d7-3ad1-9fef-5818d3da92a1",
                                        "glosses": [
                                            "den Kosmos betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19c3943f-a5e3-44eb-8ed6-b03a5134278f",
                                                "sense_id": "05b897cf-aa5c-3122-81ac-a4ea1fdef294",
                                                "text": "Die kosmische Forschung ist interessant."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15744501-cb68-3150-ab2f-5bfb73e6db43",
                                        "entry_id": "9ac86e24-68d7-3ad1-9fef-5818d3da92a1",
                                        "glosses": [
                                            "aus dem Kosmos stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d942a2c7-f5d1-459e-a987-2b664ec8d777",
                                                "sense_id": "15744501-cb68-3150-ab2f-5bfb73e6db43",
                                                "text": "Der kürzlich gefundene Gesteinsbrocken ist kosmisch."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51cffb54-26f1-3c68-beea-6874928ecb17",
                                        "entry_id": "9ac86e24-68d7-3ad1-9fef-5818d3da92a1",
                                        "glosses": [
                                            "im Kosmos stattfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbbf0bf2-473a-46a1-aa1e-4c0f6062b0f3",
                                                "sense_id": "51cffb54-26f1-3c68-beea-6874928ecb17",
                                                "text": "Die Flugbahn des kosmischen Objektes wird vermutlich 2016 die der Erde kreuzen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "62861987-ccd5-4161-b665-f8a32e8e5b57",
                        "source_entry_id": "d64579da-d4ff-35cb-9f07-9735cb5e6eac",
