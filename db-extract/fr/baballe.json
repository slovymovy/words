                        "glosses": [
                            "Diminutif péjoratif ou affectueux de balle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc7ee2b4-b016-4550-b41f-16432f56009c",
                                "sense_id": "5d77033f-456c-37d2-af26-d6af51969a3b",
                                "text": "ce n'est plus un sport mais un « cirque », le ballon devient une « baballe » dans laquelle tapent non des sportifs, mais des « mercenaires », « techniciens capables de se vendre à n'importe qui et n'importe où » (Saint-Clair), des « millionnaires en short » (Jeans)."
                            },
                            {
                                "example_id": "f3658b62-5f56-4713-b66f-3cd306055cfd",
                                "sense_id": "5d77033f-456c-37d2-af26-d6af51969a3b",
                                "text": "Des sifflets permanents quand la Roja jouait à la baballe, un emballement à l’approche des buts d’Unai Simon et deux kops qui se répondaient en s’applaudissant."
                            },
                            {
                                "example_id": "12e9a8c4-1d88-4fa2-ae8c-ce310780a686",
                                "sense_id": "5d77033f-456c-37d2-af26-d6af51969a3b",
                                "text": "Enfin je me vois mal demander à un serveur une bassine d'eau glacée pour pouvoir tremper mes baballes dedans."
                            }
                        ]
                    }
