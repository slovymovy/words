                            },
                            {
                                "target_lang_word": "празднество",
                                "target_lang_sense_clarification": "торжество и развлечения"
                            },
                            {
                                "target_lang_word": "разгул",
                                "target_lang_sense_clarification": "шумное и бурное веселье"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36d3021c-775a-3dfa-bc0f-9f4f8b87227c",
                    "sense_definition": "To engage in a daydream or to be lost in thought.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "daydreaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would often <w>reverie</w> about traveling to distant lands during her lunch break.",
                            "target_lang_translations": {
                                "ru": "Во время обеденного перерыва она часто <w>грезила</w> о путешествиях в дальние страны."
                            }
                        },
                        {
                            "text": "He sat by the fire, <w>reverieing</w> in the shades of the past.",
                            "target_lang_translations": {
                                "ru": "Он сидел у огня, <w>погрузившись в воспоминания</w> о тенях прошлого."
                            }
                        }
                    ],
                    "synonyms": [
                        "daydream"
                    ],
                    "traits": [
