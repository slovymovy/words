                },
                {
                    "sense_id": "b6b11917-7f4d-3c97-a7d7-7e5dd60ba9c1",
                    "sense_definition": "Jemanden gewaltsam töten oder ermorden.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vernichten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Kriminalroman beauftragte der Bandenchef einen Mörder, den unliebsamen Zeugen zu <w>erledigen</w>."
                        },
                        {
                            "text": "Der Gesetzlose drohte damit, jeden Verräter sofort zu <w>erledigen</w>."
                        }
                    ],
                    "synonyms": [
                        "liquidieren",
                        "umlegen"
                    ],
                    "common_phrases": [
