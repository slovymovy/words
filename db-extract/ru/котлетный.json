                "senses": [
                    {
                        "sense_id": "6cc00603-be66-318a-b327-d590d75b600f",
                        "entry_id": "a1996a9d-1553-30f3-b04f-c5cf204064f2",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным котлета; свойственный, характерный для него"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a68cdd-be20-4601-b2a5-206cc03e6ac4",
                                "sense_id": "6cc00603-be66-318a-b327-d590d75b600f",
                                "text": "Они сошли на рассвете в Харькове, оставив после себя смятые постели, просаленный листок арифметической бумаги, котлетные и хлебные крошки, а также веревочку."
                            },
                            {
                                "example_id": "fbee4788-2e24-40a8-b2a6-d2621b73890f",
                                "sense_id": "6cc00603-be66-318a-b327-d590d75b600f",
                                "text": "У нас стены пропитаны котлетным запахом!"
                            }
                        ]
                    }
