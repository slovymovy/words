                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tinnitus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "747584ad-94f2-350b-bdf0-39de2efed4b0",
                                        "entry_id": "96c098b2-d6ba-3861-a461-0c03d67d79a1",
                                        "glosses": [
                                            "Symptom, bei dem der Betroffene Geräusche ohne äußere Schallquelle wahrnimmt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b694d786-1ca4-49af-b4e6-2c88216134a6",
                                                "sense_id": "747584ad-94f2-350b-bdf0-39de2efed4b0",
                                                "text": "Seit der Explosion leidet Toni an Tinnitus."
                                            },
                                            {
                                                "example_id": "44282e3d-374a-498c-b4d9-ca1497291d3b",
                                                "sense_id": "747584ad-94f2-350b-bdf0-39de2efed4b0",
                                                "text": "Mein Tinnitus bringt mich noch um den Verstand!"
                                            },
                                            {
                                                "example_id": "3901d4ef-5a49-4e30-8b6f-f2c0173c7664",
                                                "sense_id": "747584ad-94f2-350b-bdf0-39de2efed4b0",
                                                "text": "„Von dem Konzert hatte ich übrigens am nächsten Tag noch einen dermaßen starken Tinnitus, dass ich am Morgen nach dem Pinkeln die Toilettenspülung nicht hörte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
