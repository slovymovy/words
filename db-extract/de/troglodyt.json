                    {
                        "form_id": "ac32a8d2-adb0-45a2-aee8-24bb65f16e5f",
                        "entry_id": "1a4634ed-14ed-321c-a15d-b06671841685",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Troglodyten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                        "entry_id": "1a4634ed-14ed-321c-a15d-b06671841685",
                        "glosses": [
                            "Mensch, der in Höhlen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69a09013-3920-4c12-8195-8c324b2bbb1e",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "„Troglodyten ist ein allgemeiner Name, den die Alten gewissen Völkern geben, welche in Höhlen und unterirdischen Wohnungen leben. Die Pygmäen waren, nach Aristotelis Bericht, solche Troglodyten.“"
                            },
                            {
                                "example_id": "a978662c-84ca-4e8b-a83a-712cc966effe",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "„[…] dannenhero sah ich zugleich die Ebenbilder der Chinesen und Afrikaner, Troglodyten und Novazembler, Tatarn und Mexikaner, Samojeden und Molukkenser, ja auch von denen, so unter den Polis arctico und antarctico wohnen, das wohl ein seltsames Spektakul war; […]“"
                            },
                            {
                                "example_id": "af237c8b-723d-49bc-8979-0fc2482e31c0",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "In dem fantastischen Film von Jean-Pierre Jeunet und Marc Caro, „Delikatessen“ spielen die in der Unterwelt der Kanalisation hausenden vegetarischen Troglodyten eine entscheidende Rolle bei der Errettung der Helden aus der Hand kannibalischer Hausbewohner."
                            },
                            {
                                "example_id": "79d5ea8f-0477-4611-bd2f-156c0186f5f4",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "„War es die Einheit der Person, also eine Persons-Werdung und damit (wir wagen das zu sagen) eigentlich erst Menschwerdung, nach welcher ein junger Troglodyt aus seiner dumpfen Schlucht sich sehnte, wo alle Fähigkeiten oder Talente in schweren Fesseln liegen mußten?“"
                            },
                            {
                                "example_id": "df3c8488-583b-4bc3-a397-d2a09350556f",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "„Wenn die Troglodyten [das Schwert] bei Sonnenaufgang am Erdloch fanden, wussten sie, dass ein arabischer Späher in ihre Höhlenstadt eingedrungen war.“"
                            },
                            {
                                "example_id": "43d22a88-11bf-4dbf-8c5c-b715f63ba9f8",
                                "sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                                "text": "„In dieser außerirdisch anmutenden Kulisse gab es Hunderte von winzigen Wohnhöhlen in den Hügeln, das Zuhause der Troglodyten im Süden von Tunesien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4e87125-6a57-4d5e-925c-08f67e4035c2",
                        "source_entry_id": "1a4634ed-14ed-321c-a15d-b06671841685",
                        "source_sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                        "source_sense_description": "Mensch, der in Höhlen lebt",
                        "target_lang_word": "troglodyte",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troglodyte",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdf59bca-4c7d-3623-b0e7-7e838e691c8e",
                                        "entry_id": "0c06f68e-2027-3ce5-9431-3a3d1f3047aa",
                                        "glosses": [
                                            "A member of a supposed prehistoric race that lived in caves or holes, a caveman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3dbef799-82cb-31b6-b683-7847546d2ffc",
                                        "entry_id": "0c06f68e-2027-3ce5-9431-3a3d1f3047aa",
                                        "glosses": [
                                            "Anything that lives underground."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afc34569-b784-446d-b5ed-989803e4924a",
                                                "sense_id": "3dbef799-82cb-31b6-b683-7847546d2ffc",
                                                "text": "The cave was populated by albino scorpions, blind salamanders, and other troglodytes."
                                            },
                                            {
                                                "example_id": "066e8f0a-ad9e-45f3-b2d5-a05cb5f825ab",
                                                "sense_id": "3dbef799-82cb-31b6-b683-7847546d2ffc",
                                                "text": "Inhabited as early as the Gallo-Roman era, the caves of the troglodytes are slighted in guidebooks, naturally overshadowed by the chateaus of the kings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c58fbf48-3096-31ba-9f54-eac8c6648ab0",
                                        "entry_id": "0c06f68e-2027-3ce5-9431-3a3d1f3047aa",
                                        "glosses": [
                                            "The Eurasian wren, Troglodytes troglodytes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f125dec8-ea88-399f-8713-44d8a7eb410b",
                                        "entry_id": "0c06f68e-2027-3ce5-9431-3a3d1f3047aa",
                                        "glosses": [
                                            "A reclusive, reactionary or out-of-date person, especially if brutish."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f82e179e-030e-48ad-b5bc-a69c000bee0b",
                                                "sense_id": "f125dec8-ea88-399f-8713-44d8a7eb410b",
                                                "text": "Blair brought out the febrile intensity of Stanhope, wiring himself into his ever more circumscribed troglodyte world, speculating moodily on the worm that went down when it thought it was coming up. Robert Philp thought Blair's ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "038ccf0e-7dc2-30f9-bfea-4595a98c5438",
                                        "entry_id": "0c06f68e-2027-3ce5-9431-3a3d1f3047aa",
                                        "glosses": [
                                            "A person who chooses not to keep up to date with the latest software and hardware."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4d03b8ae-fcb6-41f4-aeeb-cda068d06fdc",
                        "source_entry_id": "1a4634ed-14ed-321c-a15d-b06671841685",
                        "source_sense_id": "9a10949d-8611-370d-889f-cd2374413b63",
                        "source_sense_description": "Mensch, der in Höhlen lebt",
                        "target_lang_word": "troglodyte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troglodyte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a24e84b-ab87-3de6-ba1e-bf53434463ca",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Nom donné par les Anciens à une race fabuleuse d’hommes cavernicoles qui vivaient en Afrique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cdd7e24-b4e8-3e2e-9f3a-07f73c889815",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Habitant d’une demeure creusée dans la roche (caverne ou carrière)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f953378-0281-472d-9dc3-4f62eb827d20",
                                                "sense_id": "3cdd7e24-b4e8-3e2e-9f3a-07f73c889815",
                                                "text": "Car, sans immigration, il n’y a ni défi lancé aux habitudes invétérées ni plaisir à retrouver ses façons habituelles de faire ; en revanche, quand les habitants de longue date se sentent « envahis », ils coupent les ponts, rentrent dans leur caverne identitaire et se muent en troglodytes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac8b868-3722-36cf-9089-8f8dffb30bdc",
                                        "entry_id": "dea06725-2581-3d4b-842e-6d7d3282b196",
                                        "glosses": [
                                            "Personne non évoluée, non civilisée."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a267e6f-ef2d-4d5c-8cef-16c182be1c32",
                                                "sense_id": "aac8b868-3722-36cf-9089-8f8dffb30bdc",
                                                "text": "Soyons clairs, ces conservateurs de centre n’ont rien en commun avec les troglodytes qui ont envahi Ottawa l’hiver dernier et qui ont été félicités et encouragés par Poilievre."
                                            }
                                        ]
                                    }
                                ]
                            },
