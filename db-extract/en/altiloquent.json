                            {
                                "example_id": "fdb80c80-1d25-4b7c-a262-98dba3f06605",
                                "sense_id": "c36bc099-4d0e-3c8d-96f7-7f2b4c0d0c76",
                                "text": "[T]hey listened, dazzle-eyed- secretly making lists- to grandly romantic trash: bad poetry, stupid theology- altiloquent designs in the empty air."
                            },
                            {
                                "example_id": "5f59ec78-4bd3-4451-af86-7ae6f6447eaa",
                                "sense_id": "c36bc099-4d0e-3c8d-96f7-7f2b4c0d0c76",
                                "text": "He remembered that the politeness seemed too elaborate, too florid, altiloquent to the extent of insincerity."
                            }
                        ]
