                "senses": [
                    {
                        "sense_id": "3da5dc80-38a0-38a7-9fb4-809087041f90",
                        "entry_id": "49397872-507c-3b23-9494-3c1339744a5c",
                        "glosses": [
                            "Donner un caractère jeune à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7147c124-335d-4213-9a43-3c61682233a0",
                                "sense_id": "3da5dc80-38a0-38a7-9fb4-809087041f90",
                                "text": "C'est pour jeuniser le titre ?"
                            },
                            {
                                "example_id": "cb386286-a277-4e97-93e3-cea1bee49f88",
                                "sense_id": "3da5dc80-38a0-38a7-9fb4-809087041f90",
                                "text": "D'abord, soyez sincère : montrez-vous tel que vous êtes et n'essayez pas, sous prétexte qu'il s'agit du web, de vous « jeuniser » excessivement."
                            },
                            {
                                "example_id": "98c3b31f-7a29-4756-aeb6-39956cf315bc",
                                "sense_id": "3da5dc80-38a0-38a7-9fb4-809087041f90",
                                "text": "Loin de s'endimancher telle une Sophia Loren, ou de se «jeuniser» telle Raquel Welch, l’Américaine assure, avec une silhouette moderne qui suit subtilement les tendances de la saison."
                            }
                        ]
                    }
