                        "examples": [
                            {
                                "example_id": "26d9fbbb-7dee-4f25-85ab-2ea34198bc6d",
                                "sense_id": "753a1369-f803-315b-99b6-5fe5d7f2b038",
                                "text": "Daar schampte hij weer het kloosterterrein op het centrale plein, waar de groen geverfde ijzeren kloosterpoort op uitkwam."
                            },
                            {
                                "example_id": "130434ff-85bc-4801-8763-a2f77dd3276b",
                                "sense_id": "753a1369-f803-315b-99b6-5fe5d7f2b038",
                                "text": "De aanstaande bruid Jetsun Pema liep, voorafgegaan door een processie van boeddhistische monniken met cimbalen, trommels en hoorns, naar het klooster. Baby-olifanten met kleurige versiering keken toe terwijl zij onder de kloosterpoort doorliep. Binnen wachtte de koning haar op, gehuld in een gewaad van goud brokaat met een gele sjerp."
                            }
                        ]
                    }
