                                "example_id": "66b73bec-0830-4a20-b610-2549e53ee7a0",
                                "sense_id": "367e3f70-9528-3208-b5a8-d61114d745ad",
                                "text": "C’était une maladie honteuse ; cela devient un dysfonctionnement au même titre que l’énurésie, à ceci près que ce symptôme est moins « cachable » à l' environnement."
                            },
                            {
                                "example_id": "e88d3569-c77e-44b1-890d-257275e2967e",
                                "sense_id": "367e3f70-9528-3208-b5a8-d61114d745ad",
                                "text": "… de toutes façons, ce gosse n’est pas « cachable ». Il ne tient pas cinq minutes dans un lieu confiné."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a20f6f4-b9fa-30e3-a1d6-60432853bbde",
                        "entry_id": "5b022487-bae9-3940-a2e9-5a72ecbb278f",
                        "glosses": [
                            "Qui peut être mis en cache."
                        ],
                        "tags": [],
                        "examples": [
                            {
