                "senses": [
                    {
                        "sense_id": "3acc31bb-1234-3ce0-af0c-50df8e997bb9",
                        "entry_id": "d1d2753e-c496-3a25-8283-17941352f3ac",
                        "glosses": [
                            "weibliche Person, die eine Verhandlung führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c66f418c-a5a9-4533-8bea-4d9398c09229",
                                "sense_id": "3acc31bb-1234-3ce0-af0c-50df8e997bb9",
                                "text": "Die Verhandlerin unserer Firma hatte erreicht, dass die Zahlungen für drei Monate gestundet werden."
                            },
                            {
                                "example_id": "7fad3814-66b1-495d-b572-62fba1efd497",
                                "sense_id": "3acc31bb-1234-3ce0-af0c-50df8e997bb9",
                                "text": "„Dass Merkel keine emotionalen, mitreißenden Reden hält, daran hat man sich bereits gewöhnt. Aber lagerübergreifend hat man ihr bisher zugutehalten, dass sie eine kühle, rationale Verhandlerin ist, die eisern die deutschen Interessen vertritt. Als ihr Agieren in Brüssel nun den Eindruck erweckte, sie würde von ihren eigenen Linien abweichen und sich überlisten lassen, bröckelte prompt ihr Rückhalt im eigenen Lager.“"
                            },
                            {
                                "example_id": "cf5c0d99-fcd8-4546-a27b-99601b07c32d",
                                "sense_id": "3acc31bb-1234-3ce0-af0c-50df8e997bb9",
                                "text": "„Am wichtigsten sei derzeit aber mehr Geld: \"Da kann Karl gleich ihren Ruf als gute Verhandlerin unter Beweis stellen, wenn es gilt, ihrem Parteichef und Finanzminister zusätzliche Mittel zu entlocken.\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
