                "senses": [
                    {
                        "sense_id": "529a8c89-0e01-344b-8ed1-8f3a6d32031f",
                        "entry_id": "98c3f6ed-3bde-3e8c-921d-acfbd024f1ff",
                        "glosses": [
                            "To work as a roustabout."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a161dcbe-7246-4a7a-83b0-f7c5511f0517",
                                "sense_id": "529a8c89-0e01-344b-8ed1-8f3a6d32031f",
                                "text": "When Jack is old and weatherbeat, / Too old to roustabout, / In some rum-shop they’ll let him stop, / At eight bells he’s turned out."
                            },
                            {
                                "example_id": "3bc15eec-5f06-4b19-946e-4adf56a77e33",
                                "sense_id": "529a8c89-0e01-344b-8ed1-8f3a6d32031f",
                                "text": "I was due to bust through that cellar door here to-night, so I hurried the rest of the way up the river, roustabouting on a lower coast packet that made a landing for every fisherman that wanted a plug of tobacco."
                            },
                            {
                                "example_id": "e9a22ef0-dc50-4d7f-813d-ace0e248c606",
                                "sense_id": "529a8c89-0e01-344b-8ed1-8f3a6d32031f",
                                "text": "Thereafter, the youth gives many years to aimless wandering about the South and the Middle West. He roustabouts with a carnival […]"
                            }
                        ]
                    }
                ],
