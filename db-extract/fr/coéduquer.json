                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2d20af-245b-4b7b-801a-60dd30fd936c",
                                "sense_id": "6930d5ab-fa4c-3050-a96f-92a9c1551494",
                                "text": "Être parent c'est s'auto-éduquer sans cesse pour comprendre l'enfant et agir dans son intérêt, c'est se coéduquer au sein du couple et de la famille."
                            },
                            {
                                "example_id": "73d8fa29-4722-4f31-9b3c-ad1ffbeb807b",
                                "sense_id": "6930d5ab-fa4c-3050-a96f-92a9c1551494",
                                "text": "Peut-on « coéduquer » avec des entreprises qui poursuivent une telle politique ?"
                            }
                        ]
                    },
                    {
