    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "64c63604-ce81-377c-846a-e2eae33a5cc5",
                    "sense_definition": "Сильно звучащий, обладающий большой силой звучания и хорошо слышный.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "звук",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В соседней комнате неожиданно раздался <w>громкий</w> звук разбитого стекла.",
                            "target_lang_translations": {
                                "en": "In the next room, the <w>loud</w> sound of breaking glass suddenly rang out."
                            }
                        },
                        {
                            "text": "Дети во дворе играли весь вечер и заливались <w>громким</w> смехом.",
                            "target_lang_translations": {
                                "en": "The children played in the yard all evening and burst into <w>loud</w> laughter."
                            }
                        }
                    ],
                    "synonyms": [
                        "звучный",
                        "шумный",
                        "громогласный"
                    ],
                    "antonyms": [
                        "слабый"
                    ],
                    "common_phrases": [
                        "громкий голос",
                        "громкий смех",
                        "громкая музыка"
                    ],
                    "target_lang_definitions": {
                        "en": "Producing or characterized by a large volume of sound; easily heard."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "loud",
                                "target_lang_sense_clarification": "sound of high volume or intensity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d163282b-0cdf-30cb-8d4f-3e7379b9705e",
                    "sense_definition": "Получивший широкую известность, вызвавший оживлённое общественное внимание и огласку.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "известность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Судебный процесс завершился, вызвав <w>громкий</w> скандал во всей прессе.",
                            "target_lang_translations": {
                                "en": "The trial concluded, sparking a <w>major</w> scandal across the entire press."
                            }
                        },
                        {
                            "text": "Молодой ученый добился первого <w>громкого</w> успеха сразу после защиты диссертации.",
                            "target_lang_translations": {
                                "en": "The young scientist achieved his first <w>great</w> success right after defending his dissertation."
                            }
                        }
                    ],
                    "antonyms": [
                        "неизвестный"
                    ],
                    "common_phrases": [
                        "громкий скандал",
                        "громкий успех",
                        "громкое дело"
                    ],
                    "target_lang_definitions": {
                        "en": "Widely known; having attracted widespread public attention or publicity."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "high-profile",
                                "target_lang_sense_clarification": "attracting public attention, as in a trial or scandal"
                            },
                            {
                                "target_lang_word": "major",
                                "target_lang_sense_clarification": "prominent or significant, as in an achievement or scandal"
                            },
                            {
                                "target_lang_word": "famous",
                                "target_lang_sense_clarification": "well known or widely talked about"
                            },
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "consequential or notable, as in a great success"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36dfd9f0-40c6-39db-a383-0736f075e64a",
                    "sense_definition": "Излишне торжественный, напыщенный, рассчитанный на внешний эффект.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "риторика",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оратор произносил <w>громкие</w> слова, но за ними не было никаких реальных дел.",
                            "target_lang_translations": {
                                "en": "The speaker uttered <w>high-sounding</w> words, but there were no real deeds behind them."
                            }
                        },
                        {
                            "text": "Никто из присутствующих больше не верил этим <w>громким</w> фразам и обещаниям.",
                            "target_lang_translations": {
                                "en": "None of those present believed these <w>grand</w> phrases and promises anymore."
                            }
                        }
                    ],
                    "antonyms": [
                        "скромный"
                    ],
                    "common_phrases": [
                        "громкие слова",
                        "громкие фразы",
                        "громкие заявления"
                    ],
                    "target_lang_definitions": {
                        "en": "Overly solemn, pompous, high-sounding, or calculated for dramatic effect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "high-sounding",
                                "target_lang_sense_clarification": "pompous or grandiose words"
                            },
                            {
                                "target_lang_word": "grand",
                                "target_lang_sense_clarification": "pretentious, ostentatious, or exaggerated"
                            },
                            {
                                "target_lang_word": "loud",
                                "target_lang_sense_clarification": "brash, showy, or excessively emphatic"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}