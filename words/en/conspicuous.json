{
    "word_family": [
        "conspicuously",
        "conspicuousness",
        "inconspicuous"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b5b6f9d4-23f2-3ac0-83c3-2a3308e12138",
                    "sense_definition": "Easily seen or noticed; attracting attention by being very obvious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bright red sign was very <w>conspicuous</w> against the white wall of the building.",
                            "target_lang_translations": {
                                "ru": "Ярко-красная вывеска была очень <w>заметна</w> на фоне белой стены здания.",
                                "tr": "Parlak kırmızı tabela, binanın beyaz duvarı üzerinde çok <w>göze çarpıyordu</w>.",
                                "zh": "那块鲜红的招牌在白色的墙面上非常<w>显眼</w>。"
                            }
                        },
                        {
                            "text": "He was <w>conspicuous</w> by his absence at the meeting, as everyone expected him to be there.",
                            "target_lang_translations": {
                                "ru": "Его отсутствие на собрании было <w>заметным</w>, так как все ожидали его присутствия.",
                                "tr": "Herkes orada olmasını beklediği için toplantıdaki yokluğu çok <w>barizdi</w>.",
                                "zh": "他没来参加会议显得格外<w>扎眼</w>，因为大家都以为他会出席。"
                            }
                        }
                    ],
                    "synonyms": [
                        "observable",
                        "perceivable",
                        "perceptible"
                    ],
                    "antonyms": [
                        "inconspicuous"
                    ],
                    "common_phrases": [
                        "conspicuous by his absence",
                        "highly conspicuous"
                    ],
                    "target_lang_definitions": {
                        "ru": "Легко видимый или заметный; привлекающий внимание своей очевидностью.",
                        "tr": "Kolayca görülen veya fark edilen; çok bariz olmasıyla dikkat çeken.",
                        "zh": "容易被看见或注意到；因非常明显而引人注目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметный",
                                "target_lang_sense_clarification": "легко различимый глазом"
                            },
                            {
                                "target_lang_word": "очевидный",
                                "target_lang_sense_clarification": "явно выраженный"
                            },
                            {
                                "target_lang_word": "бросающийся в глаза",
                                "target_lang_sense_clarification": "привлекающий внимание"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bariz",
                                "target_lang_sense_clarification": "açık, göze çarpan, belirgin"
                            },
                            {
                                "target_lang_word": "belli",
                                "target_lang_sense_clarification": "gizli olmayan, ortada olan, aşikâr"
                            },
                            {
                                "target_lang_word": "göze çarpan",
                                "target_lang_sense_clarification": "kolayca fark edilen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显眼",
                                "target_lang_sense_clarification": "容易被看见，引人注目"
                            },
                            {
                                "target_lang_word": "明显",
                                "target_lang_sense_clarification": "清楚地显露出来"
                            },
                            {
                                "target_lang_word": "引人注目",
                                "target_lang_sense_clarification": "吸引人的注意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8bac006f-1325-342d-9740-0b4c00479ac8",
                    "sense_definition": "Attracting attention in a way that is prominent or sometimes unattractive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete had a <w>conspicuous</w> lump on his forehead after the collision during the game.",
                            "target_lang_translations": {
                                "ru": "У спортсмена была <w>заметная</w> шишка на лбу после столкновения во время игры.",
                                "tr": "Sporcunun oyun sırasındaki çarpışmadan sonra alnında <w>dikkat çeken</w> bir şişlik vardı.",
                                "zh": "比赛中发生碰撞后，运动员的额头上鼓起了一个<w>明显</w>的包。"
                            }
                        },
                        {
                            "text": "She tried to avoid wearing <w>conspicuous</w> jewelry that might draw too much attention in the office.",
                            "target_lang_translations": {
                                "ru": "Она старалась не носить <w>броских</w> украшений, которые могли бы привлечь слишком много внимания в офисе.",
                                "tr": "Ofiste çok fazla dikkat çekebilecek <w>göze çarpan</w> takılar takmaktan kaçınmaya çalıştı.",
                                "zh": "她尽量避免佩戴在办公室里会显得过于<w>招摇</w>的首饰。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flashy",
                        "prominent"
                    ],
                    "antonyms": [
                        "inconspicuous"
                    ],
                    "common_phrases": [
                        "conspicuous consumption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекающий внимание тем, что является выдающимся или иногда непривлекательным.",
                        "tr": "Öne çıkan veya bazen göze hoş gelmeyen bir şekilde dikkat çeken.",
                        "zh": "以一种突出或有时不雅观的方式吸引注意力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выделяющийся",
                                "target_lang_sense_clarification": "заметный на фоне остального"
                            },
                            {
                                "target_lang_word": "броский",
                                "target_lang_sense_clarification": "яркий или вызывающий"
                            },
                            {
                                "target_lang_word": "приметный",
                                "target_lang_sense_clarification": "такой, которого трудно не заметить"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dikkat çeken",
                                "target_lang_sense_clarification": "göze batan veya ilgi uyandıran"
                            },
                            {
                                "target_lang_word": "göze çarpan",
                                "target_lang_sense_clarification": "belirgin, dikkat çekici"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扎眼",
                                "target_lang_sense_clarification": "因过于突出而显得刺眼或不协调"
                            },
                            {
                                "target_lang_word": "显眼",
                                "target_lang_sense_clarification": "非常突出，容易引起注意"
                            },
                            {
                                "target_lang_word": "招摇",
                                "target_lang_sense_clarification": "故意炫耀或引起注意"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}