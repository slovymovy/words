                    {
                        "form_id": "6ec24237-e159-4792-aad4-aa5bdae9d774",
                        "entry_id": "b6e24636-b70f-3bdb-9d1c-98dec69739b9",
                        "tags": [
                            "plural"
                        ],
                        "form": "sleutelwoorden"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8ed16f3-0e6b-35d2-892f-1c678a6ba699",
                        "entry_id": "b6e24636-b70f-3bdb-9d1c-98dec69739b9",
                        "glosses": [
                            "een reserveerd woord dat in een computertaal een vaste functie heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c0d623d-654c-463d-80c7-4fff6f6aacfa",
                                "sense_id": "b8ed16f3-0e6b-35d2-892f-1c678a6ba699",
                                "text": "Woorden als IF, THEN en ELSE zijn sleutelwoorden in een aantal programmeertalen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14f498cd-4d7d-40b7-900e-58428714b949",
                        "source_entry_id": "b6e24636-b70f-3bdb-9d1c-98dec69739b9",
                        "source_sense_id": "b8ed16f3-0e6b-35d2-892f-1c678a6ba699",
                        "target_lang_word": "Schlüsselwort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlüsselwort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fcd28b90-529a-3063-ade0-7786337ecfde",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "Wort oder Aussage als Kennwort oder Leitlinie für etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62e8b0a-256c-48d2-8400-ba76824388c0",
                                                "sense_id": "fcd28b90-529a-3063-ade0-7786337ecfde",
                                                "text": "Globalisierung ist ein Schlüsselwort der gegenwärtigen Entwicklungen."
                                            },
                                            {
                                                "example_id": "e885a33f-cb3f-4fac-b355-aa2ca73e953a",
                                                "sense_id": "fcd28b90-529a-3063-ade0-7786337ecfde",
                                                "text": "Zum Stichwort „Bürgerinitiative“: „Schlüsselwörter dieser Mentalität waren Mitgestaltung, soziale Verantwortung, Engagement, Solidarität, Bewegung und ähnliche Anachronismen.“"
                                            },
                                            {
                                                "example_id": "1535e07b-ba76-46a6-8828-a3552b832173",
                                                "sense_id": "fcd28b90-529a-3063-ade0-7786337ecfde",
                                                "text": "„Ohne diese Schlüsselworte wurde jedes Argument mit einem Verdikt aus ebendiesem Vokabelschatz abgeschmettert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad29d2a7-f19e-391b-b691-9a28ce31d0c5",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "eine von wenigen Zeichenketten unveränderlicher Bedeutung einer Programmiersprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d62eadce-c120-48a6-9f14-ed985b179d26",
                                                "sense_id": "ad29d2a7-f19e-391b-b691-9a28ce31d0c5",
                                                "text": "Programmiersprachen enthalten in ihrem Sprachumfang meist nicht mehr als 50 Schlüsselwörter, meist werden damit programmatische Konstrukte wie etwa Kontrollstrukturen realisiert, primitive Datentypen und vordefinierte Funktionen bezeichnet. Literale dagegen können sehr viele auftreten und haben ebenfalls eine vordefinierte Bedeutung, sie vertreten in Programmen z.B. alle Zahlen, deren Darstellungsweise jedoch die Konvention bestimmt und nicht die Willkür des Programmierers. Variablennamen dagegen werden nach eigenem Belieben vom Programmierer benutzt und definiert."
                                            },
                                            {
                                                "example_id": "58e411f5-8aa4-4ad9-9ce8-709e6c419e2f",
                                                "sense_id": "ad29d2a7-f19e-391b-b691-9a28ce31d0c5",
                                                "text": "Schlüsselwörter einer Programmiersprache ähneln den Grammemen einer natürlichen Sprache, insofern ihre Zahl beschränkt und abgeschlossen ist und sie in der Matrix eines Textes der Sprache auffällig häufig vertreten sind."
                                            },
                                            {
                                                "example_id": "30ca5b0c-db6a-4104-aa70-6a4f14535751",
                                                "sense_id": "ad29d2a7-f19e-391b-b691-9a28ce31d0c5",
                                                "text": "Sonderzeichen wie „=“, „{“, „}“, „*“ haben in Programmiersprachen oft eine ähnliche Funktion wie Schlüsselworte, für ein und dieselbe Sache kann in einer Programmiersprache ein Schlüsselwort stehen, in einer anderen dagegen ein Sonderzeichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b726435e-7166-3dfb-a480-f6733a2f7f24",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "Wort, das als Grundlage für die Chiffrierung von Texten genutzt wird"
                                        ],
                                        "tags": [
                                            "Kryptologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "555077cb-e346-45af-b1d7-039a820d774c",
                                                "sense_id": "b726435e-7166-3dfb-a480-f6733a2f7f24",
                                                "text": "„Das Verdienst, die Chiffrierung durch Angabe eines Schlüsselworts zur Bestimmung der sukzessiven Verdrehung der Scheibe oder zur Auswahl der Zeile der Tafel erweitert zu haben, kommt Giovanni Battista Belaso (1553) zu.“"
                                            },
                                            {
                                                "example_id": "6b60a544-d0d6-4bc7-a310-8c551d0bcff5",
                                                "sense_id": "b726435e-7166-3dfb-a480-f6733a2f7f24",
                                                "text": "„Je länger das Schlüsselwort wird, desto stärker bewegen wir uns auf die unknackbaren Codes zu…“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "deb9c9b4-b609-3d71-a138-f6e95121b59e",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "Begriff aus der Linguistik der Werbesprache, der solche Wörter bezeichnet, die wie Hochwertwörter aufwertenden Charakter haben, zugleich aber „eine Schlüsselstellung im Gedanken- und Sprachfeld der Werbung einnehmen.“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d9ccdea-0560-4eb5-973a-ad760bfc111a",
                                                "sense_id": "deb9c9b4-b609-3d71-a138-f6e95121b59e",
                                                "text": "Zu den Schlüsselwörtern gehören Adjektive wie „frei“, „frisch“, „gesund“ und „neu“, aber auch Substantive wie „Erfolg“, „Leistung“, „Service.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "51f3f761-814d-367f-907c-563891ad8e87",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "Begriff aus der Inhaltsanalyse: die sprachlichen Einheiten, die der Inhaltsanalyse besonders aufschlussreich für die latenten (d.h. nicht offenkundigen) Inhalte von Texten zu sein scheinen und die deshalb systematisch ausgewertet werden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aa2053b-f52b-4c13-b8d7-8886b588f908",
                                                "sense_id": "51f3f761-814d-367f-907c-563891ad8e87",
                                                "text": "Für die Inhaltsanalyse verraten sich Schlüsselwörter unter anderem durch ihre auffallende Häufigkeit."
                                            },
                                            {
                                                "example_id": "ed71bfe8-0d21-4f59-a50a-f97437ee418e",
                                                "sense_id": "51f3f761-814d-367f-907c-563891ad8e87",
                                                "text": "„Man kann das Fehlen der gesellschaftspolitischen Dimension in den Bedeutungsangaben entsprechender Schlüsselwörter vielleicht damit erklären, dass die Linguistik der 70-er Jahre noch mitten in der pragmatischen Wende begriffen war …“"
                                            },
                                            {
                                                "example_id": "16e8dc45-1d88-4ea9-a0d6-99f5c3f31666",
                                                "sense_id": "51f3f761-814d-367f-907c-563891ad8e87",
                                                "text": "„Die Rechner der Firma suchen dabei vor allem nach Schlüsselwörtern, Floskeln oder linguistischen Mustern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "5201335a-c695-349f-acb4-5dd787f48b73",
                                        "entry_id": "30b8a604-33c3-3256-a2b3-fc0c50eb8165",
                                        "glosses": [
                                            "ein geheimes Wort, das eine Tür oder einen anderen Zugang öffnet"
                                        ],
                                        "tags": [
                                            "Märchen",
                                            "Datenverarbeitung",
                                            "Militär und Wachdienst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ce3307a-c880-416b-b9dc-68a560466498",
                                                "sense_id": "5201335a-c695-349f-acb4-5dd787f48b73",
                                                "text": "In Märchen gibt es verschlossene Türen, die man nur durch Aussprechen eines Schlüsselwortes öffnen kann, etwa „Sesam öffne dich“, und Verwandlungen, die man nur so rückgängig machen kann, etwa durch das Wort „mutabor“."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
