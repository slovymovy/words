{
    "word_family": [
        "sprawl",
        "sprawler"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8d46424e-126e-3fa7-86d1-622b44c01517",
                    "sense_definition": "Spreading out over a large area in an untidy or irregular way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expansive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sprawling</w> suburbs continue to grow further into the countryside every year.",
                            "target_lang_translations": {
                                "ru": "<w>Разросшиеся</w> пригороды с каждым годом продолжают уходить всё дальше в сельскую местность."
                            }
                        },
                        {
                            "text": "We looked out over the <w>sprawling</w> cityscape from the top of the mountain.",
                            "target_lang_translations": {
                                "ru": "С вершины горы мы смотрели на <w>раскинувшийся</w> внизу городской пейзаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "expansive",
                        "extensive",
                        "rambling",
                        "straggling"
                    ],
                    "antonyms": [
                        "compact",
                        "contained"
                    ],
                    "common_phrases": [
                        "sprawling cityscape",
                        "sprawling suburbs",
                        "sprawling campus",
                        "sprawling metropolis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскинувшийся на большой территории, часто беспорядочно или неравномерно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскинувшийся",
                                "target_lang_sense_clarification": "о городе или территории"
                            },
                            {
                                "target_lang_word": "разросшийся",
                                "target_lang_sense_clarification": "о пригородах или садах"
                            },
                            {
                                "target_lang_word": "обширный",
                                "target_lang_sense_clarification": "занимающий большое пространство"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94a1d689-f61e-385f-a3b5-7e87da56f9c5",
                    "sense_definition": "Lying or sitting with arms and legs spread out widely and awkwardly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was found <w>sprawling</w> on the sofa after a long day at work.",
                            "target_lang_translations": {
                                "ru": "Его нашли <w>развалившимся</w> на диване после долгого рабочего дня."
                            }
                        },
                        {
                            "text": "The <w>sprawling</w> figure of the exhausted runner lay across the finish line.",
                            "target_lang_translations": {
                                "ru": "<w>Растянувшаяся</w> фигура изможденного бегуна лежала на финишной черте."
                            }
                        }
                    ],
                    "synonyms": [
                        "stretched",
                        "spread-eagled"
                    ],
                    "common_phrases": [
                        "sprawling on the floor",
                        "sprawling limbs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лежащий или сидящий с широко и неуклюже раскинутыми руками и ногами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развалившийся",
                                "target_lang_sense_clarification": "в небрежной позе"
                            },
                            {
                                "target_lang_word": "растянувшийся",
                                "target_lang_sense_clarification": "на полу или диване"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fde052ef-c69f-3192-a21a-91e6ee34a2eb",
                    "sense_definition": "Present participle and gerund of <w>sprawl</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is <w>sprawling</w> in every direction due to lack of planning.",
                            "target_lang_translations": {
                                "ru": "Город хаотично <w>разрастается</w> во всех направлениях из-за отсутствия планирования."
                            }
                        },
                        {
                            "text": "Stop <w>sprawling</w> across the table and sit up straight.",
                            "target_lang_translations": {
                                "ru": "Перестань <w>разваливаться</w> на столе и сядь прямо."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени от глагола «sprawl» (раскидываться, разрастаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разрастающийся",
                                "target_lang_sense_clarification": "о застройке"
                            },
                            {
                                "target_lang_word": "раскинувшийся",
                                "target_lang_sense_clarification": "в данный момент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3c00cc5-83eb-3d30-a466-71fd3ddf33e8",
                    "sense_definition": "The act or instance of spreading out or falling awkwardly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The descent was marked by various tumblings and <w>sprawlings</w> on the slippery rocks.",
                            "target_lang_translations": {
                                "ru": "Спуск сопровождался постоянными кувырками и <w>падениями</w> на скользких камнях."
                            }
                        },
                        {
                            "text": "His clumsy <w>sprawlings</w> made everyone in the room laugh.",
                            "target_lang_translations": {
                                "ru": "Его неуклюжее <w>барахтанье</w> рассмешило всех в комнате."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай беспорядочного падения или неуклюжего расположения тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падение",
                                "target_lang_sense_clarification": "неуклюжее, с раскинутыми конечностями"
                            },
                            {
                                "target_lang_word": "барахтанье",
                                "target_lang_sense_clarification": "беспорядочные движения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}