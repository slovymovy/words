                                "target_senses": [
                                    {
                                        "sense_id": "ed1e40eb-d143-350a-8d03-fbdd0a36d59b",
                                        "entry_id": "13c36fee-6a78-3f7f-9029-73f928018e60",
                                        "glosses": [
                                            "The act of making black; a blackening or defamation."
                                        ],
