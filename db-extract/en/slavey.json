    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9ba6c6cf-e21a-370f-8f65-4a2faaee992f",
                "word": "Slavey",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb58513f-05c8-3889-ab49-3b24758be153",
                        "entry_id": "9ba6c6cf-e21a-370f-8f65-4a2faaee992f",
                        "glosses": [
                            "A language spoken by the Slavey peoples."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45474292-30ee-4d2c-a8b6-3c87e5a0150f",
                                "sense_id": "cb58513f-05c8-3889-ab49-3b24758be153",
                                "text": "In the Northwest Territories, the languages with official status are English, French, Dëne Sųłıné (Chipewyan), Nēhiyawēwin (Cree), Dene Kǝdǝ́ (Northern Slavey), Dene Zhatıé (Southern Slavey), Dinjii Zhu’ Ginjik (Gwich’in), Inuinnaqtun, Inuktitut, Inuvialuktun and Tłįcho."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3dd658d0-2737-4d4d-a4d2-6c5779f24ec5",
                        "source_entry_id": "9ba6c6cf-e21a-370f-8f65-4a2faaee992f",
                        "source_sense_id": "cb58513f-05c8-3889-ab49-3b24758be153",
                        "source_sense_description": "language",
                        "target_lang_word": "esclave",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Celui ou celle qui par sa naissance ou par sa capture n’est pas de condition libre ou que la violence a mis sous la puissance absolue d’un maître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9043ce8-29ca-4bd4-a7ef-3459c61edda2",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Le second document n’est pas plus exact que le premier, car il ne dit pas si tous les esclaves entrés dans le port de Rio ont été le produit d’un commerce direct entre cette place et l’Afrique."
                                            },
                                            {
                                                "example_id": "ca8f630e-e621-4af7-b8be-f74a2adc2290",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Dans les premiers âges historiques, on ne voit pas seulement les maîtres frapper et fouetter leurs esclaves ; les rois eux-mêmes administrent le supplice de la bastonnade."
                                            },
                                            {
                                                "example_id": "619dc973-498a-42f2-88ea-af184348c750",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Le Concile de Mâcon (581) recommande aux chrétiens de racheter les esclaves chrétiens servant chez les juifs, pour le prix de 12 sols."
                                            },
                                            {
                                                "example_id": "117c9017-8f29-4a03-87dc-c1206f4f77bd",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "Les marchés d’esclaves les plus importants étaient ceux de Fez et de Marrakech. Je n’ai vu que ce dernier."
                                            },
                                            {
                                                "example_id": "94bb3472-b00c-4d6c-b9c5-4a9f7e697262",
                                                "sense_id": "f529d847-cfbe-324b-9e0d-cbc0ae240ae7",
                                                "text": "La masse servile, issue des deux dernières castes, représente près de 10 % de la population, faisant de la Mauritanie le pays qui connaît le taux d’esclaves le plus élevé au monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Prolétaire opprimé et exploité."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "994290bd-0fca-4c1d-a370-68c0346cbcd5",
                                                "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                                "text": "Enfin, c’est celui qui veut remplacer la loi tutélaire de la majorité par l'arbitraire tyrannique du petit nombre, faire le peuple esclave du parti & écraser la démocratie tout entière sous une despotique kakistocratie."
                                            },
                                            {
                                                "example_id": "cb73b4c4-5cc1-4f1b-b129-1486f1d0a4f5",
                                                "sense_id": "86e933bf-dcc4-36de-bc82-1b13a14ddfd7",
                                                "text": "Au vrai j’entrevoyais que le conflit politique était le même en tous pays, et qu’il n’était autre qu’une révolte des esclaves contre les maîtres, chose qu’il fallait attendre, après cette tuerie imbécile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bffe65ae-623c-396a-91bb-75d0504bab06",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne qu'on traite comme étant entièrement à sa disposition, sans liberté aucune."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2d294b3-6d4c-42af-89ba-c61681c672cd",
                                                "sense_id": "bffe65ae-623c-396a-91bb-75d0504bab06",
                                                "text": "« Il place ses amis, on est dégoûtés! De toute façon, tu ne peux être que son ennemi ou son esclave », fulmine l'un, outré de la nomination de deux très proches de Wauquiez, …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4911297f-ae4b-3bc7-bf20-3deb5f443944",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne qui, par amour, se met dans la dépendance de quelqu’un et suit aveuglément ses volontés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cb8e8ec-ec42-4d26-8dee-d3b37666587d",
                                                "sense_id": "4911297f-ae4b-3bc7-bf20-3deb5f443944",
                                                "text": "Yasmina pria Chérif de répondre à Jacques qu’elle aussi l’aimait toujours, qu’elle lui resterait fidèle tant qu’elle vivrait, qu’elle restait son esclave soumise et aimante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f88b5ad-c5b0-3e67-a50d-5e920c8f3616",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Personne ayant apparemment abandonné sa liberté au profit d'une passion, d'une idée, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d181824-09e9-433b-a0db-49a5341a688e",
                                                "sense_id": "7f88b5ad-c5b0-3e67-a50d-5e920c8f3616",
                                                "text": "Doux esclave de ses habitudes, l’idée seule de l’imprévu le faisait se recroqueviller prudemment, comme si quelque gros nuage menaçait de répandre son déluge sur la divine monotonie des choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c73fcd60-89e2-3ec4-8ee2-6c0810e1f62e",
                                        "entry_id": "448ed1d1-3a5f-36da-bb3e-ab8707d4eb32",
                                        "glosses": [
                                            "Élément vers lequel on synchronise, par opposition au maître."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0a91252-ac8b-32e7-a1be-a7835f7a552b",
                                        "entry_id": "edd3df41-8078-3491-b87e-93e2efe6355d",
                                        "glosses": [
                                            "Langue amérindienne de la famille dénée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beaf0830-e710-4950-a3d7-12e8aac30860",
                                                "sense_id": "b0a91252-ac8b-32e7-a1be-a7835f7a552b",
                                                "text": "La plupart des langues dénées (ou athabascanes) sont menacées, même si le chipewyan, l’esclave, le dogrib et le gwich’in sont langues officielles dans les Territoires du Nord-Ouest."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esclave",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                        "entry_id": "a66a4811-a883-36cd-a3d8-e544fd294263",
                                        "glosses": [
                                            "Soumis, servile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0236ebe8-ed87-4afe-aec6-0aab940adf02",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Avoir une âme esclave."
                                            },
                                            {
                                                "example_id": "93dd4bcf-fe4e-49cd-838f-b3f78c4ef4f2",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Être esclave, être tellement attaché au service de quelqu’un, ou à quelque emploi, qu’on ne peut s’éloigner, ni faire autre chose."
                                            },
                                            {
                                                "example_id": "6a497d1a-9621-49ae-bc9e-2b663c301d2f",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "On est esclave auprès de ce maître-là."
                                            },
                                            {
                                                "example_id": "84410221-e1e3-4d24-9e47-708d0480b34b",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Être esclave de la faveur, être esclave de ses intérêts, de ses passions, faire tout pour la faveur, pour ses intérêts, pour satisfaire ses passions."
                                            },
                                            {
                                                "example_id": "d022f99a-be00-47a4-abf5-1465f99f6eb1",
                                                "sense_id": "e878f564-f5f7-3945-902d-603ee7ae9828",
                                                "text": "Elles étaient vêtues à la mode de la saison prochaine, chose fatale, menaçant toute étrangère esclave de certains journaux, qui ont plutôt pour habitude de prédire les modes que de les indiquer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "939dc452-a550-312b-b2ee-e71da94b2c06",
                                        "entry_id": "a66a4811-a883-36cd-a3d8-e544fd294263",
                                        "glosses": [
                                            "Qualifie une personne est attachée à ses devoirs ou à ses promesses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5679e075-d8ec-46e1-8bb6-b743d808d3be",
                                                "sense_id": "939dc452-a550-312b-b2ee-e71da94b2c06",
                                                "text": "Il savait que son futur beau-père était avant tout l’homme du devoir, esclave de tous ses engagements et incapable de manquer à un rendez-vous d’affaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
