{
    "word_family": [
        "storten",
        "neerstorting",
        "instorten",
        "uitstorten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9878f257-8960-353b-bc75-8d4f2ffba31c",
                    "sense_definition": "het vliegvermogen verliezen en onzacht op de aarde terugvallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vliegtuig verloor alle brandstof en <w>stortte neer</w> in de oceaan.",
                            "target_lang_translations": {
                                "en": "The plane ran out of fuel and <w>crashed</w> into the ocean.",
                                "fr": "L'avion a perdu tout son carburant et s'est <w>écrasé</w> dans l'océan."
                            }
                        },
                        {
                            "text": "De piloot kon voorkomen dat het toestel zou <w>neerstorten</w> op een woonwijk.",
                            "target_lang_translations": {
                                "en": "The pilot was able to prevent the aircraft from <w>crashing</w> into a residential area.",
                                "fr": "Le pilote a pu éviter que l'appareil ne <w>s'écrase</w> sur une zone résidentielle."
                            }
                        }
                    ],
                    "synonyms": [
                        "verongelukken",
                        "crashen"
                    ],
                    "antonyms": [
                        "opstijgen",
                        "landen"
                    ],
                    "common_phrases": [
                        "vliegtuig stort neer",
                        "bijna neerstorten"
                    ],
                    "target_lang_definitions": {
                        "en": "to lose the ability to fly and fall violently back to earth",
                        "fr": "perdre sa capacité de vol et s'écraser violemment au sol"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crash",
                                "target_lang_sense_clarification": "of an aircraft"
                            },
                            {
                                "target_lang_word": "go down",
                                "target_lang_sense_clarification": "of a plane"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'écraser",
                                "target_lang_sense_clarification": "en parlant d'un avion"
                            },
                            {
                                "target_lang_word": "se crasher",
                                "target_lang_sense_clarification": "familier, en parlant d'un avion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "288595a2-3b07-3f8a-a338-6bee967a6d4c",
                    "sense_definition": "met grote kracht of snelheid naar beneden vallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "crash",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hevige regenval <w>stortte</w> een deel van de rotswand <w>neer</w> op de weg.",
                            "target_lang_translations": {
                                "en": "Due to the heavy rainfall, part of the rock face <w>crashed down</w> onto the road.",
                                "fr": "À cause des fortes pluies, une partie de la paroi rocheuse s'est <w>effondrée</w> sur la route."
                            }
                        },
                        {
                            "text": "Het water van de waterval bleef met een donderend geraas <w>neerstorten</w>.",
                            "target_lang_translations": {
                                "en": "The water of the waterfall continued to <w>plunge down</w> with a thundering roar.",
                                "fr": "L'eau de la cascade continuait de se <w>précipiter</w> avec un fracas tonitruant."
                            }
                        }
                    ],
                    "synonyms": [
                        "omlaagstorten",
                        "vallen",
                        "storten"
                    ],
                    "common_phrases": [
                        "naar beneden neerstorten"
                    ],
                    "target_lang_definitions": {
                        "en": "to fall down with great force or speed",
                        "fr": "tomber avec une grande force ou une grande vitesse"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crash down",
                                "target_lang_sense_clarification": "falling with force"
                            },
                            {
                                "target_lang_word": "tumble down",
                                "target_lang_sense_clarification": "falling rapidly"
                            },
                            {
                                "target_lang_word": "plunge",
                                "target_lang_sense_clarification": "falling from a height"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'effondrer",
                                "target_lang_sense_clarification": "en parlant d'une structure ou d'un pan de roche"
                            },
                            {
                                "target_lang_word": "se précipiter",
                                "target_lang_sense_clarification": "en parlant d'une chute d'eau ou d'un liquide"
                            },
                            {
                                "target_lang_word": "dégringoler",
                                "target_lang_sense_clarification": "tomber rapidement et avec fracas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}