                            {
                                "target_word": "legerkorps",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff7604e-9df8-3be6-bad5-2820b593353e",
                                        "entry_id": "c1871f9c-6f15-385c-a398-e4401ddec8bf",
                                        "glosses": [
                                            "deel van een leger met een sterkte van enkele tienduizenden militairen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67d4028e-54a8-410a-b548-2eeffc07779a",
                                                "sense_id": "8ff7604e-9df8-3be6-bad5-2820b593353e",
                                                "text": "In 1809 was de toenadering tussen de beide heersers van de wereld, zoals Napoleon en Alexander werden genoemd, zo voortgeschreden dat toen Napoleon in dat jaar Oostenrijk de oorlog verklaarde, een Russisch legerkorps de grens overtrok om de vroegere vijand, Bonaparte, bij te staan tegen de vroegere bondgenoot, de Oostenrijkse keizer, en dat in de hoogste kringen gesproken werd over de mogelijkheid van een huwelijk tussen Napoleon en een van de zusters van tsaar Alexander."
                                            },
                                            {
                                                "example_id": "8471ace7-9c3c-4a7a-8589-919eb5dfb773",
                                                "sense_id": "8ff7604e-9df8-3be6-bad5-2820b593353e",
                                                "text": "De Commandant der Strijdkrachten Middendorp vindt het Duits-Nederlandse legerkorps een rolmodel voor internationale samenwerking. Het korps bestaat twintig jaar en dat wordt vandaag plechtig gevierd in Münster."
                                            }
                                        ]
                                    }
                                ]
                            }
