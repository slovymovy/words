                                        "sense_id": "0e397ceb-ab85-3857-ad92-d3c6fb1d6da1",
                                        "entry_id": "13332262-369f-38ea-922d-cf327477f30b",
                                        "glosses": [
                                            "Of, relating to, or having melody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a68390e-c588-4dc4-9e01-a08366424d5d",
                                                "sense_id": "0e397ceb-ab85-3857-ad92-d3c6fb1d6da1",
                                                "text": "Debussy's melody is fractional, fragmentary. But at the core all his music is melodic and melody is its main motive force."
                                            }
                                        ]
