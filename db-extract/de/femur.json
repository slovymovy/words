                ],
                "senses": [
                    {
                        "sense_id": "212b18b5-d6a2-33e0-9546-83d2b9029d20",
                        "entry_id": "e121c87f-76d2-36e9-ae12-3eb16d47062b",
                        "glosses": [
                            "einer der kräftigsten Röhrenknochen, der Oberschenkelknochen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f94ebb9-f047-4551-b740-b11257ea2653",
                                "sense_id": "212b18b5-d6a2-33e0-9546-83d2b9029d20",
                                "text": "„Das Femur besitzt einen kugelförmigen Kopf (Caput), der über einen Hals (Collum) mit dem Schaft (Diaphyse) verbunden ist.“"
                            },
                            {
                                "example_id": "97fd0f90-9882-4b10-a5d7-b3abf7310390",
                                "sense_id": "212b18b5-d6a2-33e0-9546-83d2b9029d20",
                                "text": "„Nur das distale Ende des Femur kann ohne Hilfsmittel untersucht werden.“"
                            },
                            {
                                "example_id": "10af678a-3748-4fc1-8cf8-c37f2d8d323e",
                                "sense_id": "212b18b5-d6a2-33e0-9546-83d2b9029d20",
                                "text": "„Der Femur kann somit in jeder Beugestelle um diesen Zapfen drehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4b78abbb-888c-35cb-b701-f4a6d1ea5345",
                        "entry_id": "e121c87f-76d2-36e9-ae12-3eb16d47062b",
                        "glosses": [
                            "das dritte Glied von Gliederfüßlern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21d2ce2c-0f9a-4526-aef5-62c8172b9521",
                                "sense_id": "4b78abbb-888c-35cb-b701-f4a6d1ea5345",
                                "text": "„Ein Silberdraht wurde in das Femur gesteckt […]“"
                            },
                            {
                                "example_id": "dd079969-bf0d-4a0f-aa15-1c89eb30914f",
                                "sense_id": "4b78abbb-888c-35cb-b701-f4a6d1ea5345",
                                "text": "„Der Trochanter (Schenkelring) ist klein und dem Femur fest angeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
