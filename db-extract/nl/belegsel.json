                "senses": [
                    {
                        "sense_id": "698e8f2d-48bc-3f36-a44e-26559f6fd430",
                        "entry_id": "2ad9e0aa-c188-38a4-b941-348d0d52525e",
                        "glosses": [
                            "dat wat men op een boterham doet om het smakelijker te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecaf7d8-1dde-4491-ad43-810e7e573593",
                                "sense_id": "698e8f2d-48bc-3f36-a44e-26559f6fd430",
                                "text": "Er werden veel goede woorden gesproken en de grote sneden brood met echt Drents belegsel werd alle eer aangedaan."
                            },
                            {
                                "example_id": "268ba0c4-0c85-453d-aa50-b5c6eaceafe6",
                                "sense_id": "698e8f2d-48bc-3f36-a44e-26559f6fd430",
                                "text": "Terwijl mijnheer in stad zijn beleggingen verzorgt, heeft mevrouw in haar morgenjak de beslommeringen van het ‘belegsel’. Wat zal het wezen vandaag? Kaas, rookvleesch of boterhammenworst?"
                            }
                        ]
                    },
                    {
                        "sense_id": "95771ed0-a3b3-3085-ab00-07f4b5a4eca2",
                        "entry_id": "2ad9e0aa-c188-38a4-b941-348d0d52525e",
                        "glosses": [
                            "iets waarmee men een oppervlak bedekt ter versiering of bescherming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0daaaa-7c7b-4da3-affd-c334a77ba177",
                                "sense_id": "95771ed0-a3b3-3085-ab00-07f4b5a4eca2",
                                "text": "Tabernakelkastje (XVIII d) met parelmoer belegsel en houten beeldjes."
                            }
                        ]
                    }
