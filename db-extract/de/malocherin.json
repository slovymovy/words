                                                "example_id": "0a30a574-3b94-4b5f-91bb-05e97a226ab8",
                                                "sense_id": "6790fdfb-90f4-373b-b17d-4f53087904f4",
                                                "text": "Avant de quitter le torrent, pour monter à Dragia, on rencontre de nouveau des grès marneux, fins, gris-bleuâtres, et le coteau de Dragia se trouve composé de ces molasses couvertes d’argile marneuse jaunâtre."
                                            },
                                            {
                                                "example_id": "fadb54e7-35cd-433b-b90a-a1c065a6c6dc",
                                                "sense_id": "6790fdfb-90f4-373b-b17d-4f53087904f4",
                                                "text": "Le ruisseau des Barres naît à Sévigny-Waleppe sur la craie marneuse et aboutit à l'Aisne en aval de Balham."
                                            }
                                        ]
                                    }
                                ]
                            },
