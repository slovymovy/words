                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                        "entry_id": "5a9b55f2-c53e-364e-a1c3-b649123d0f2b",
                                        "glosses": [
                                            "Until; to, up to; as late as (a given time)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9eb8ced-6d20-42f0-a607-98d601f8e4ec",
                                                "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                                "text": "She stayed till the very end."
                                            },
                                            {
                                                "example_id": "f4048ef8-03b7-4c5b-8a35-5c1996cbd67c",
                                                "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                                "text": "I have to work till eight o'clock tonight."
                                            },
                                            {
                                                "example_id": "9495d94d-6512-4977-b519-59f62109ed53",
                                                "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                                "text": "Similar sentiments will recur to everyone familiar with his writings all through them till the very end."
                                            },
                                            {
                                                "example_id": "c5e83238-609c-4737-8482-b6971aae9fdd",
                                                "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                                "text": "The line was authorised on June 23, 1864, but not opened till July 11, 1881."
                                            },
                                            {
                                                "example_id": "1558a057-0a3b-4b8a-97b0-df34a749f0a0",
                                                "sense_id": "a9d77706-a69d-3ccd-8487-645cd70f1d06",
                                                "text": "While the PA has not always seen eye-to-eye with US foreign policy, its survival remained, till recently, a top American priority."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f761b99-a1ad-3f29-9bc6-8153e53fa8eb",
                                        "entry_id": "5a9b55f2-c53e-364e-a1c3-b649123d0f2b",
                                        "glosses": [
                                            "Before (a certain time or event)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe024987-2cfb-41e2-92d2-3f9d0eadff9f",
                                                "sense_id": "6f761b99-a1ad-3f29-9bc6-8153e53fa8eb",
                                                "text": "It's twenty till two. (1:40)"
                                            },
                                            {
                                                "example_id": "a855ba56-fb06-46ae-a051-a04b0a60689a",
                                                "sense_id": "6f761b99-a1ad-3f29-9bc6-8153e53fa8eb",
                                                "text": "Is that the town-clock striking? / I think that it is to-night / My fever will reach its crisis, / There are long hours yet till light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c45a632-85ef-3851-ae84-dd3664f37b9c",
                                        "entry_id": "5a9b55f2-c53e-364e-a1c3-b649123d0f2b",
                                        "glosses": [
                                            "To, up to (physically)."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a389d3-7149-4f65-a22d-95ebc0e08702",
                                                "sense_id": "7c45a632-85ef-3851-ae84-dd3664f37b9c",
                                                "text": "They led him till his tent"
                                            },
                                            {
                                                "example_id": "6ea68c78-a575-48f7-b1c1-63872581752b",
                                                "sense_id": "7c45a632-85ef-3851-ae84-dd3664f37b9c",
                                                "text": "She, poor bird, as all forlorn / Lean'd her breast up-till a thorn / And there sung the dolefull'st ditty, / To to hear it was great pity."
                                            },
                                            {
                                                "example_id": "5bc1bb37-2727-4962-a11d-d91595a863f6",
                                                "sense_id": "7c45a632-85ef-3851-ae84-dd3664f37b9c",
                                                "text": "And till the kirk she wadna gae, / nor till't she wadna ride, / Till four-and-twenty men she gat her before, / And twenty on ilka side"
                                            },
                                            {
                                                "example_id": "2f1ba1cd-fccf-4e76-94e9-81db77a4d94a",
                                                "sense_id": "7c45a632-85ef-3851-ae84-dd3664f37b9c",
                                                "text": "For a king to gang an outlaw till / Is beneath his state and his dignitie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8734e65-b928-353c-8924-51c41abbd07e",
                                        "entry_id": "5a9b55f2-c53e-364e-a1c3-b649123d0f2b",
                                        "glosses": [
                                            "To, toward (in attitude)."
                                        ],
                                        "tags": [
                                            "dialectal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c88e232a-3fdb-42e7-83c9-52f690bb9852",
                                                "sense_id": "e8734e65-b928-353c-8924-51c41abbd07e",
                                                "text": "\"Here's at you old hoss!\" hiccupped I, with a friendly pitch in the way of a nod at Rice.\n\"Go it, young grampus, that's me! Here's till ye, my infant progidy!\" replied he, as he clinked his glass against mine."
                                            },
                                            {
                                                "example_id": "7ef6822c-484b-48af-a6ce-544ffad45a21",
                                                "sense_id": "e8734e65-b928-353c-8924-51c41abbd07e",
                                                "text": "And then she changed her voice and would be as saft as honey: 'My puir wee Ailie, was I thrawn till ye? Never mind, my bonnie. You and me are a' that's left, and we maunna be ill to ither.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d33afe3-4786-300a-8198-07114a4aa83f",
                                        "entry_id": "5a9b55f2-c53e-364e-a1c3-b649123d0f2b",
                                        "glosses": [
                                            "So that (something may happen)."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29495f5-268c-43eb-80b1-3f8e2503f5ec",
                                                "sense_id": "1d33afe3-4786-300a-8198-07114a4aa83f",
                                                "text": "1953?, Samuel Beckett, Waiting for Godot\nVLADIMIR: Together again at last! We'll have to celebrate this. But how? (He reflects.) Get up till I embrace you."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "till",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1cf0bf02-6b77-3a10-8bd4-af75c930574b",
                                        "entry_id": "ba38ef87-13a5-3ef5-8f69-2d28486e606e",
                                        "glosses": [
                                            "Until, until the time that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "540b5974-69fb-46c9-a19f-0d966ed62218",
                                                "sense_id": "1cf0bf02-6b77-3a10-8bd4-af75c930574b",
                                                "text": "Maybe you can, maybe you can't: you won't know till you try."
                                            },
                                            {
                                                "example_id": "ae22a832-3a65-4ee3-b4a1-912f3c0c7f47",
                                                "sense_id": "1cf0bf02-6b77-3a10-8bd4-af75c930574b",
                                                "text": "I charge you, O ye daughters of Ierusalem, by the Roes, and by the hindes of the field, that ye stirre not vp, nor awake my loue, till she please."
                                            },
                                            {
                                                "example_id": "483f65f7-f4a2-4213-a9f0-41aa76c98a71",
                                                "sense_id": "1cf0bf02-6b77-3a10-8bd4-af75c930574b",
                                                "text": "She twirled round and round, / Till she sunk underground, […]"
                                            },
                                            {
                                                "example_id": "5c948d2b-fdf8-4555-ac69-e905521034d3",
                                                "sense_id": "1cf0bf02-6b77-3a10-8bd4-af75c930574b",
                                                "text": "And the Mouse sat and laughed till he cried."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "till",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa876787-c0b8-314b-a5cd-a65a31c4824e",
                                        "entry_id": "81dd3e20-c40e-3b70-a616-9b69125feae5",
                                        "glosses": [
                                            "A cash register."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7317c3ee-66fa-4e81-a470-739186783315",
                                                "sense_id": "aa876787-c0b8-314b-a5cd-a65a31c4824e",
                                                "text": "I got most of the money to pay for all this by stealing. It was very wrong. Today I'm so finickity that I fired one of my staff for nicking twenty-pence worth of curtain hangers from Barkers because he couldn't be bothered to wait at the till queue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc4ca4b6-d0d5-35f4-a0e7-552c38459356",
                                        "entry_id": "81dd3e20-c40e-3b70-a616-9b69125feae5",
                                        "glosses": [
                                            "A removable box within a cash register containing the money."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "652df36e-0d8e-4b87-8942-eedddd60e621",
                                                "sense_id": "fc4ca4b6-d0d5-35f4-a0e7-552c38459356",
                                                "text": "Pull all the tills and lock them in the safe."
                                            },
                                            {
                                                "example_id": "5e81f5a5-528f-4315-8df8-e59baca4570d",
                                                "sense_id": "fc4ca4b6-d0d5-35f4-a0e7-552c38459356",
                                                "text": "When you've finished serving that customer could you jump off please? We need to take the till."
                                            },
                                            {
                                                "example_id": "c870ffcd-dda7-48f6-892b-21222538a1e2",
                                                "sense_id": "fc4ca4b6-d0d5-35f4-a0e7-552c38459356",
                                                "text": "That said, and I'll put this down to its newness, the bin lid was a bit snappy, like Arkwright's till (google that if you're a youngster)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cff8ebf-bbdf-3669-a12a-e1cd27e7874e",
                                        "entry_id": "81dd3e20-c40e-3b70-a616-9b69125feae5",
                                        "glosses": [
                                            "The contents of a cash register, for example at the beginning or end of the day or of a cashier's shift."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa09a217-574f-4de3-8004-ae36f50585bf",
                                                "sense_id": "0cff8ebf-bbdf-3669-a12a-e1cd27e7874e",
                                                "text": "My count of my till was 30 dollars short."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52f679c4-646b-39e2-b8ab-3982a8da9b3f",
                                        "entry_id": "81dd3e20-c40e-3b70-a616-9b69125feae5",
                                        "glosses": [
                                            "A cash drawer in a bank, used by a teller."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
