                        "entry_id": "1df3ad98-9561-3ef0-a50f-15c3463d14ab",
                        "glosses": [
                            "kwas acetylosalicylowy używany jako lek; pastylka lub płyn z tą substancją"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e77e7ca-cb30-4eeb-b4c8-57dde84f0221",
                                "sense_id": "4bf5b6c1-9724-380e-b26a-f86a430a4edb",
                                "text": "Lekarz zalecił mi wzięcie aspiryny przed snem."
                            }
