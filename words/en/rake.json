{
    "word_family": [
        "raker",
        "rakish",
        "rakishly",
        "rakishness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "249c5f28-88b9-397c-9827-ff788db49b31",
                    "sense_definition": "To act upon with a rake, or as if with a rake, such as gathering leaves or smoothing soil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gardening_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>raked</w> all the leaves into a pile before it started to rain.",
                            "target_lang_translations": {
                                "ru": "Мы <w>сгребли</w> все листья в кучу до того, как пошел дождь."
                            }
                        },
                        {
                            "text": "She is <w>raking</w> the gravel path to keep it even and neat.",
                            "target_lang_translations": {
                                "ru": "Она <w>разравнивает</w> гравийную дорожку, чтобы она выглядела ровной и аккуратной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rake the leaves",
                        "rake the soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгребать листья, траву или разравнивать почву с помощью грабель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сгребать",
                                "target_lang_sense_clarification": "листья, сено граблями"
                            },
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "граблями"
                            },
                            {
                                "target_lang_word": "разравнивать",
                                "target_lang_sense_clarification": "землю граблями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d55faec1-4e19-3b10-ac0a-de39e129dd83",
                    "sense_definition": "To gather things together quickly, especially money or profits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gathering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new casino is just <w>raking</w> in the cash every single weekend.",
                            "target_lang_translations": {
                                "ru": "Новое казино просто <w>загребает</w> деньги каждые выходные."
                            }
                        },
                        {
                            "text": "They managed to <w>rake</w> in a fortune with their online business.",
                            "target_lang_translations": {
                                "ru": "Им удалось <w>загрести</w> целое состояние на своем онлайн-бизнесе."
                            }
                        }
                    ],
                    "synonyms": [
                        "accumulate",
                        "amass"
                    ],
                    "common_phrases": [
                        "rake in the cash",
                        "rake in profits"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used with 'in'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро собирать или загребать (особенно деньги, прибыль)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загребать",
                                "target_lang_sense_clarification": "деньги, прибыль"
                            },
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "деньги лопатой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3100cdd8-b817-3fe2-9971-389cce6f3b9d",
                    "sense_definition": "To bring up or uncover past misdeeds, embarrassing information, or old arguments.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncovering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no need to <w>rake</w> up old arguments from years ago.",
                            "target_lang_translations": {
                                "ru": "Нет никакой необходимости <w>ворошить</w> старые споры многолетней давности."
                            }
                        },
                        {
                            "text": "The journalists tried to <w>rake</w> up the politician's past scandals.",
                            "target_lang_translations": {
                                "ru": "Журналисты пытались <w>раскопать</w> прошлые скандалы политика."
                            }
                        }
                    ],
                    "synonyms": [
                        "dredge up",
                        "resurrect"
                    ],
                    "common_phrases": [
                        "rake up the past",
                        "rake up old memories"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Usually used with 'up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ворошить прошлое, раскапывать старые обиды, скандалы или неприятные факты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ворошить",
                                "target_lang_sense_clarification": "прошлое, старые обиды"
                            },
                            {
                                "target_lang_word": "раскапывать",
                                "target_lang_sense_clarification": "старые скандалы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b52eb201-0a4b-3dbb-85e2-2bb405a42bb5",
                    "sense_definition": "To scratch or scrape with sharp objects, claws, or nails.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "scratching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat's sharp claws <w>raked</w> the side of my face when I tried to pick it up.",
                            "target_lang_translations": {
                                "ru": "Острые когти кошки <w>царапнули</w> меня по лицу, когда я попытался взять ее на руки."
                            }
                        },
                        {
                            "text": "Branches <w>raked</w> against the window during the violent storm.",
                            "target_lang_translations": {
                                "ru": "Во время сильной бури ветки <w>скребли</w> по окну."
                            }
                        }
                    ],
                    "synonyms": [
                        "scratch",
                        "scrape",
                        "claw"
                    ],
                    "common_phrases": [
                        "rake with claws"
                    ],
                    "target_lang_definitions": {
                        "ru": "Царапать или скрести острыми предметами, когтями или ногтями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "царапать",
                                "target_lang_sense_clarification": "когтями, ветками"
                            },
                            {
                                "target_lang_word": "скрести",
                                "target_lang_sense_clarification": "по поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53ee22a7-72eb-33e4-a03e-368b2189271c",
                    "sense_definition": "To search through a place or a collection of things thoroughly.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "searching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jack's gaze <w>raked</w> the room, searching for some indication that something was wrong.",
                            "target_lang_translations": {
                                "ru": "Взгляд Джека <w>пробежал</w> по комнате в поисках каких-либо признаков того, что что-то не так."
                            }
                        },
                        {
                            "text": "She <w>raked</w> through the old files looking for the missing contract.",
                            "target_lang_translations": {
                                "ru": "Она <w>рылась</w> в старых папках в поисках пропавшего контракта."
                            }
                        }
                    ],
                    "synonyms": [
                        "scour",
                        "comb",
                        "search"
                    ],
                    "common_phrases": [
                        "rake through files"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно осматривать, прочесывать или искать что-то в вещах или документах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочёсывать",
                                "target_lang_sense_clarification": "взглядом, местность"
                            },
                            {
                                "target_lang_word": "рыться",
                                "target_lang_sense_clarification": "в бумагах, вещах"
                            },
                            {
                                "target_lang_word": "прочесать",
                                "target_lang_sense_clarification": "в поисках чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96612cd5-f3bb-3067-97d4-5a1262fe70ac",
                    "sense_definition": "To sweep with gunfire, light, or a glance from side to side.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sweeping_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy machine guns <w>raked</w> the roadway to prevent any escape.",
                            "target_lang_translations": {
                                "ru": "Вражеские пулеметы <w>простреливали</w> дорогу, чтобы не дать никому спастись."
                            }
                        },
                        {
                            "text": "A powerful searchlight <w>raked</w> across the dark waters of the harbor.",
                            "target_lang_translations": {
                                "ru": "Мощный прожектор <w>прорезал</w> темные воды гавани."
                            }
                        }
                    ],
                    "synonyms": [
                        "sweep",
                        "enfilade"
                    ],
                    "common_phrases": [
                        "rake with gunfire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обстреливать вдоль или прочесывать лучами света, взглядом из стороны в сторону."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простреливать",
                                "target_lang_sense_clarification": "огнем вдоль дороги"
                            },
                            {
                                "target_lang_word": "освещать",
                                "target_lang_sense_clarification": "прожектором из стороны в сторону"
                            },
                            {
                                "target_lang_word": "окидывать",
                                "target_lang_sense_clarification": "взглядом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "196762a5-1487-36e8-af20-636a4d41d87b",
                    "sense_definition": "To incline or slope from a perpendicular or horizontal direction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sloping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship's masts <w>rake</w> backward at a very elegant angle.",
                            "target_lang_translations": {
                                "ru": "Мачты корабля <w>наклонены</w> назад под очень элегантным углом."
                            }
                        },
                        {
                            "text": "The stage was designed to <w>rake</w> upward toward the back of the theater.",
                            "target_lang_translations": {
                                "ru": "Сцена была спроектирована так, чтобы <w>подниматься</w> к задней части театра."
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "slant",
                        "incline"
                    ],
                    "common_phrases": [
                        "rake backward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь наклон или скос назад или вверх."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклоняться",
                                "target_lang_sense_clarification": "назад под углом"
                            },
                            {
                                "target_lang_word": "иметь наклон",
                                "target_lang_sense_clarification": "о мачте, сцене"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5f61ceca-933b-37d3-9c1a-b13aca061075",
                    "sense_definition": "A garden tool with a row of pointed teeth fixed to a long handle, used for collecting leaves, grass, or loosening soil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "garden_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a wooden <w>rake</w> to gather the fallen leaves in the backyard.",
                            "target_lang_translations": {
                                "ru": "Он использовал деревянные <w>грабли</w>, чтобы собрать опавшие листья на заднем дворе."
                            }
                        },
                        {
                            "text": "Please put the garden <w>rake</w> back in the tool shed when you are finished.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убери садовые <w>грабли</w> обратно в сарай для инструментов, когда закончишь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garden rake",
                        "wooden rake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Садовый инструмент с зубьями на длинной ручке для сбора листьев или рыхления земли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грабли",
                                "target_lang_sense_clarification": "садовый инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c5f5609-f734-33da-8110-f50d426c5356",
                    "sense_definition": "A stylish but immoral and hedonistic man; a libertine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "people_types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the novel, the protagonist is a charming <w>rake</w> who eventually reforms.",
                            "target_lang_translations": {
                                "ru": "В романе главный герой — очаровательный <w>повеса</w>, который в конце концов исправляется."
                            }
                        },
                        {
                            "text": "He lived the life of a notorious <w>rake</w>, spending his fortune on gambling and parties.",
                            "target_lang_translations": {
                                "ru": "Он вел жизнь отъявленного <w>распутника</w>, тратя свое состояние на азартные игры и вечеринки."
                            }
                        }
                    ],
                    "synonyms": [
                        "libertine",
                        "roué",
                        "debauchee",
                        "philanderer"
                    ],
                    "common_phrases": [
                        "charming rake",
                        "notorious rake"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in historical or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Повеса, распутник, ведущий праздный и аморальный образ жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повеса",
                                "target_lang_sense_clarification": "ветреный мужчина"
                            },
                            {
                                "target_lang_word": "распутник",
                                "target_lang_sense_clarification": "аморальный мужчина"
                            },
                            {
                                "target_lang_word": "ловелас",
                                "target_lang_sense_clarification": "соблазнитель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed672c95-c73b-3ace-ab28-9c44266f76ad",
                    "sense_definition": "An angle of slope or slant, especially of a ship's mast, a roof, or a theater stage.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slopes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steep <w>rake</w> of the auditorium seating ensures everyone has a clear view.",
                            "target_lang_translations": {
                                "ru": "Крутой <w>наклон</w> зрительских мест гарантирует каждому хороший обзор."
                            }
                        },
                        {
                            "text": "The architect adjusted the <w>rake</w> of the roof to allow snow to slide off easily.",
                            "target_lang_translations": {
                                "ru": "Архитектор скорректировал <w>уклон</w> крыши, чтобы снег мог легко сползать."
                            }
                        }
                    ],
                    "synonyms": [
                        "slope",
                        "slant",
                        "inclination"
                    ],
                    "common_phrases": [
                        "steep rake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол наклона или скоса (например, мачты судна, крыши или сцены)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наклон",
                                "target_lang_sense_clarification": "угол наклона"
                            },
                            {
                                "target_lang_word": "уклон",
                                "target_lang_sense_clarification": "поверхности, сцены"
                            },
                            {
                                "target_lang_word": "скос",
                                "target_lang_sense_clarification": "конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3514553c-c64b-3ba8-a94f-35d7f7cc009a",
                    "sense_definition": "A set of coupled railway carriages or wagons.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "railway_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steam locomotive was coupled to a <w>rake</w> of vintage passenger coaches.",
                            "target_lang_translations": {
                                "ru": "Паровоз был сцеплен с <w>составом</w> старинных пассажирских вагонов."
                            }
                        },
                        {
                            "text": "A long <w>rake</w> of empty coal wagons sat idle on the siding.",
                            "target_lang_translations": {
                                "ru": "Длинный <w>состав</w> пустых угольных вагонов стоял без дела на запасном пути."
                            }
                        }
                    ],
                    "synonyms": [
                        "consist"
                    ],
                    "common_phrases": [
