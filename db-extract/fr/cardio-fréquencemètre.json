                        "entry_id": "5604130b-a313-322b-bba7-05669ba5505e",
                        "glosses": [
                            "Appareil permettant de déterminer la fréquence cardiaque instantanée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbe8a5d0-5d46-4750-a508-c99da63f11ea",
                                "sense_id": "f7787560-3837-3976-a8ce-1a6b669803db",
                                "text": "Le cardio-fréquencemètre est un appareil électronique de la taille d’une montre-bracelet qui mesure en temps réel, de manière continue, fiable et précise la fréquence des battements du cœur."
                            }
                        ]
                    }
                ],
