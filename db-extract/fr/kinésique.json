                        "entry_id": "2f3b5628-4158-3c58-b5c2-0ad36fd02e51",
                        "glosses": [
                            "Étude des mouvements ou postures du corps humain, en particulier, comme moyen de communication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "954714c8-75b5-40a3-9ae8-51af0713d220",
                                "sense_id": "c7618a27-d994-3bbd-a20a-43f108aa58c5",
                                "text": "L’anthropologue Ray Birdwhistell est en train de fonder la kinésique, qui n’est pas tant une phonétique du « langage » corporel qu’une théorie du comportement communicatif passant, parmi d’autres modalités, par le corps en mouvement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d2d954e-2795-4aef-a453-5ce51af3f974",
                        "source_entry_id": "2f3b5628-4158-3c58-b5c2-0ad36fd02e51",
                        "source_sense_id": "c7618a27-d994-3bbd-a20a-43f108aa58c5",
