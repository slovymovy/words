                "senses": [
                    {
                        "sense_id": "700fb875-a31e-324b-b106-f1a4245f08bf",
                        "entry_id": "f0b6f941-ce6c-38a5-8ecf-29a99d1b7918",
                        "glosses": [
                            "hinterer Teil eines Schiffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad6efa09-9522-44f0-8368-cb6edb140244",
                                "sense_id": "700fb875-a31e-324b-b106-f1a4245f08bf",
                                "text": "„Mittags um zwölf hatte wie üblich die Wache gewechselt, jetzt stand der Matrose John Johnsen am Steuerrad auf dem Achterschiff, noch hinter dem Großmast und dem niedrigen Deckshaus.“"
                            },
                            {
                                "example_id": "d464122d-d617-466b-bb8e-78fc441c6c9a",
                                "sense_id": "700fb875-a31e-324b-b106-f1a4245f08bf",
                                "text": "„Die Pulverkammer war kaum beschädigt, das Achterschiff schien überhaupt kaum in Mitleidenschaft gezogen zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "997a2813-4e54-3fee-b2d5-5133d750181c",
                        "entry_id": "f0b6f941-ce6c-38a5-8ecf-29a99d1b7918",
                        "glosses": [
                            "Sternbild des Südhimmels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18ca97fb-eef1-4218-9f34-18af467de8bd",
                                "sense_id": "997a2813-4e54-3fee-b2d5-5133d750181c",
                                "text": "Die Sternanordnung links vom Großen Hund, die wir in unserm Atlas als Schiff Argo bezeichnen, heißt offiziell Puppis, d. h. Schiffshinterteil oder Achterschiff."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9c5cdb1-7ab8-46e5-81c0-1423d12c9d00",
                        "source_entry_id": "f0b6f941-ce6c-38a5-8ecf-29a99d1b7918",
                        "source_sense_id": "700fb875-a31e-324b-b106-f1a4245f08bf",
                        "source_sense_description": "hinterer Teil eines Schiffes",
                        "target_lang_word": "stern",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "438134c2-d745-372f-8d91-37c2d2927bc3",
                                        "entry_id": "51f117cc-2e96-3015-98e6-73e5f3c60f2c",
                                        "glosses": [
                                            "Having a hardness and severity of nature or manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325a02b5-efa9-4967-9428-226b80c51d27",
                                                "sense_id": "438134c2-d745-372f-8d91-37c2d2927bc3",
                                                "text": "I haue beene wooed, as I intreat thee now, / Euen by the ſterne, and direfull God of warre, / VVhoſe ſinowie necke in battel nere did bow, / VVho conquers where he comes in euery iarre; […]"
                                            },
                                            {
                                                "example_id": "2c4b2a21-c515-445c-8eeb-caf9b69b2a61",
                                                "sense_id": "438134c2-d745-372f-8d91-37c2d2927bc3",
                                                "text": "stern as tutors, and as uncles hard"
                                            },
                                            {
                                                "example_id": "21f767b8-5dc4-42d6-8a48-c843bdc3faec",
                                                "sense_id": "438134c2-d745-372f-8d91-37c2d2927bc3",
                                                "text": "Risk is everywhere. From tabloid headlines insisting that coffee causes cancer (yesterday, of course, it cured it) to stern government warnings about alcohol and driving, the world is teeming with goblins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22068495-3c1a-3032-a4f0-6939435fc8ec",
                                        "entry_id": "51f117cc-2e96-3015-98e6-73e5f3c60f2c",
                                        "glosses": [
                                            "Grim and forbidding in appearance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "341f95c3-ea44-47da-b198-ebf4502d2f9f",
                                                "sense_id": "22068495-3c1a-3032-a4f0-6939435fc8ec",
                                                "text": "these barren rocks, your stern inheritance"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stern",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7472736-0705-3ca3-ab1c-d84c2e0b35d8",
                                        "entry_id": "7697d7d1-413d-3e65-ab0b-adba6ccdaac0",
                                        "glosses": [
                                            "The rear part (after end) of a ship or other vessel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ceddeff4-f19d-48af-8150-53cb45f9bc43",
                                                "sense_id": "b7472736-0705-3ca3-ab1c-d84c2e0b35d8",
                                                "text": "Holonyms: watercraft < vessel"
                                            },
                                            {
                                                "example_id": "39ddac68-9ff0-4a18-b37c-2be2ffb1abdc",
                                                "sense_id": "b7472736-0705-3ca3-ab1c-d84c2e0b35d8",
                                                "text": "Old Applegate, in the stern, just set and looked at me, and Lord James, amidship, waved both arms and kept hollering for help. I took a couple of everlasting big strokes and managed to grab hold of the skiff's rail, close to the stern."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cea3967e-1618-3b3c-a63b-2480565801f2",
                                        "entry_id": "7697d7d1-413d-3e65-ab0b-adba6ccdaac0",
                                        "glosses": [
                                            "The post of management or direction."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c3f192-a084-4f26-ad54-9ec31e960978",
                                                "sense_id": "cea3967e-1618-3b3c-a63b-2480565801f2",
                                                "text": "and sit chiefest stern of public weal"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec69c862-ad11-344f-8a1b-ff0cd64fd70a",
                                        "entry_id": "7697d7d1-413d-3e65-ab0b-adba6ccdaac0",
                                        "glosses": [
                                            "The hinder part of anything."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8eabd611-058c-3d52-9c12-fcf1198dd0fc",
                                        "entry_id": "7697d7d1-413d-3e65-ab0b-adba6ccdaac0",
                                        "glosses": [
                                            "The tail of an animal; now used only of the tail of a dog."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68cc941-544a-4e88-bfbc-4c2d00424ba8",
                                                "sense_id": "8eabd611-058c-3d52-9c12-fcf1198dd0fc",
                                                "text": "And all attonce her beaſtly bodie raizd / With doubled forces high aboue the ground: / Tho wrapping vp her wrethed ſterne arownd, / Lept fierce vpon his ſhield, [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stern",
                                "target_lang_code": "en",
