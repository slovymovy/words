                        "sense_id": "a8f0865d-5b0f-3cb5-8df5-8ab7b9fd5ba2",
                        "entry_id": "327a8f82-f7cd-329e-9d47-f981aa156d2b",
                        "glosses": [
                            "Toxine produite par les bactéries intestinales et susceptible de provoquer des troubles intestinaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cddbe3aa-6a6b-4b34-aa12-c6fad3e7e1b8",
                                "sense_id": "a8f0865d-5b0f-3cb5-8df5-8ab7b9fd5ba2",
                                "text": "Le bacille Vibrio cholerae produit une entérotoxine qui provoque une diarrhée abondante pouvant aboutir à une déshydratation sévère et à la mort du sujet si le traitement n’est pas administré rapidement."
                            },
                            {
                                "example_id": "6a8e4a84-4583-48df-80f0-036e7926e368",
                                "sense_id": "a8f0865d-5b0f-3cb5-8df5-8ab7b9fd5ba2",
                                "text": "L’entérotoxine est distincte des autres toxines, notamment des hémolysines."
                            }
                        ]
                    }
                ],
