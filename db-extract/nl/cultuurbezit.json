                "senses": [
                    {
                        "sense_id": "b708605d-ffbf-3a27-b8f7-7ec09b015b34",
                        "entry_id": "8e1f9195-e4a5-3fca-9e03-c93b8afd28d9",
                        "glosses": [
                            "verzamelterm voor zaken die in de tradities van een groep mensen ook een symbolische waarde hebben en daarom met veel aandacht worden vormgegeven of in stand gehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4e8429-c265-44f6-b096-f3415996eb51",
                                "sense_id": "b708605d-ffbf-3a27-b8f7-7ec09b015b34",
                                "text": "Als het Nederlands in de Grondwet komt, zoals het kabinet wil, dan ook het Fries. Het rijk moet erkennen dat het Fries een uniek Nederlands cultuurbezit is en geen aparte eigenaardigheid van de Friezen."
                            },
                            {
                                "example_id": "b3f2a861-6cfa-4f1d-9928-7695cbbfd9f0",
                                "sense_id": "b708605d-ffbf-3a27-b8f7-7ec09b015b34",
                                "text": "Wij kunnen niet buiten het idee van een gemeenschappelijk cultuurbezit, een referentiekader voor de literatuurkritiek, het onderwijs en de lezers, (…)"
                            }
                        ]
                    },
                    {
                        "sense_id": "6ca3c898-ecb2-3209-96a3-1a0113a03979",
                        "entry_id": "8e1f9195-e4a5-3fca-9e03-c93b8afd28d9",
                        "glosses": [
                            "voorwerpen met een bijzondere betekenis binnen de ontwikkeling van kunst en wetenschap"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee486747-a473-42a4-b6dd-af90924a73c9",
                                "sense_id": "6ca3c898-ecb2-3209-96a3-1a0113a03979",
                                "text": "Bij een vermoeden van bijzonder belang voor het nationale cultuurbezit moet voor afstoting eerst een deskundigenadvies worden ingewonnen."
                            },
                            {
                                "example_id": "5c64cac0-f14e-4c4f-8c41-d4a917ae06ec",
                                "sense_id": "6ca3c898-ecb2-3209-96a3-1a0113a03979",
                                "text": "Het topstuk van de veiling, een tekening van Rubens, stond niet op de lijst van beschermde cultuurgoederen, de kunstwerken die onvervangbaar en onmisbaar worden geacht voor het Nederlandse cultuurbezit."
                            },
                            {
                                "example_id": "9d07d1e0-33b4-4949-ae40-abf64dd992b6",
                                "sense_id": "6ca3c898-ecb2-3209-96a3-1a0113a03979",
                                "text": "Het proefschrift biedt een overzicht van de rechtspraktijk bij de teruggave van cultuurbezit uit publieke collecties."
                            }
                        ]
                    }
