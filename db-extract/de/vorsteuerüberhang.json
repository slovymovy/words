                "senses": [
                    {
                        "sense_id": "670e116a-f2d1-3f74-98a7-d8028b214e62",
                        "entry_id": "84c0a6da-0ac2-306c-8dab-25933bead880",
                        "glosses": [
                            "Betrag, um den die abzugsfähige Vorsteuer die abzuführende Umsatzsteuer für einen bestimmten Zeitraum übersteigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a0a7b54-385d-49b2-95a8-934ff04376a9",
                                "sense_id": "670e116a-f2d1-3f74-98a7-d8028b214e62",
                                "text": "Im Voranmeldungszeitraum September hatten wir aufgrund außerordentlicher Investitionen einen Vorsteuerüberhang in Höhe von 15.687 Euro."
                            },
                            {
                                "example_id": "5df41441-fe6b-4f15-b583-5f23a6b26bad",
                                "sense_id": "670e116a-f2d1-3f74-98a7-d8028b214e62",
                                "text": "„Angesichts der geltend gemachten Vorsteuer für die Photovoltaikanlage in Höhe von 6.394,63 EUR ergab sich daraus ein Vorsteuerüberhang bzw. eine Abgabengutschrift in Höhe von 6.309,29 EUR.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
