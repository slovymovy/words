                    },
                    {
                        "sense_id": "c6327513-8f41-388b-bc05-3d84083db453",
                        "entry_id": "0345db1c-f16c-38a7-a8de-b8d5438015e6",
                        "glosses": [
                            "van plannen dat ze nog niet genoeg zijn uitgewerkt om ze tot uitvoering te kunnen brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0faaac1d-0a6f-437f-8fd8-1ada0ed8c34b",
                                "sense_id": "c6327513-8f41-388b-bc05-3d84083db453",
                                "text": "Vorige week gaven oppositiepartijen PvdA en GroenLinks te kennen dat ze bereid zijn om in te stemmen met een stelsel van eeuwigdurende erfpacht, maar alleen als zij mee kunnen praten over de voorwaarden en als het huidige, in hun ogen onvoldragen, voorstel van tafel gaat."
                            },
                            {
                                "example_id": "f9e6c7c9-8697-4f45-83a0-3fa63c8df827",
                                "sense_id": "c6327513-8f41-388b-bc05-3d84083db453",
                                "text": "Ze vrezen onder meer dat justitie willekeurig zal omgaan met zulke verdachten en dat de maatschappelijke onrust daarin te leidend wordt. De SP-fractie noemt het een onvoldragen en ontijdig voorstel."
                            }
                        ]
                    }
