                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "6b5bd912-a905-326b-841d-d27d87100449",
                        "entry_id": "cbb9ca7a-00e6-3ec3-8004-8611e7ff7a0c",
                        "glosses": [
                            "spätmittelalterliches Herzogtum"
                        ],
