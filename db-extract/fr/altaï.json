                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0613b90f-f8e7-4700-a85a-37717a8dee32",
                        "source_entry_id": "3348eb4c-8bdf-390d-997b-27327e2e1a6e",
                        "source_sense_description": "chaine de montagne",
                        "target_lang_word": "Altay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c0aca51-54ef-35f9-8cda-2bdec2684084",
                                        "entry_id": "aeae4148-872e-3cab-b71a-aaf8b6c8e339",
                                        "glosses": [
                                            "Alternative form of Altai."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66692b1-9a6e-4b2f-8f0d-fa5449674bf5",
                                                "sense_id": "7c0aca51-54ef-35f9-8cda-2bdec2684084",
                                                "text": "The Altay Mountains to the north prevent rain clouds from reaching the Gurbantünggüt Desert, which fills the center of the Junggar Basin in China's northwest corner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                        "entry_id": "aeae4148-872e-3cab-b71a-aaf8b6c8e339",
                                        "glosses": [
                                            "A prefecture in northern Xinjiang autonomous region, China."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea57420-6eb9-4d7d-9c74-0e3873dfa6fc",
                                                "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                                "text": "The Kazaks were struggling in poverty before liberation. Some 2,000 people died of starvation in the Altay Prefecture from 1944 to 1945, and 40 per cent of the Kazak herdsmen in Altay County alone were homeless in 1946.",
                                                "translation": "China's Minority Nationalities",
                                                "english": "China's Minority Nationalities"
                                            },
                                            {
                                                "example_id": "dd864003-d6be-4e3e-9aa7-17c2efe3280f",
                                                "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                                "text": "In January 2010, a blizzard of such force which had not occurred in six decades attacked the Altay Prefecture, and the minimum temperature dropped to minus 40 degrees Celsius.",
                                                "translation": "Modern Xinjiang",
                                                "english": "Modern Xinjiang"
                                            },
                                            {
                                                "example_id": "309a41b2-f4bf-40e7-9a32-d99ab0a65fd3",
                                                "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                                "text": "When Saliye Hobay, a Kazak ethnic woman born in Altay Prefecture in the north of the Xinjiang Uygur Autonomous Region, was laid off in 2002 after the clothing factory in which she had worked for six years went bankrupt, she fell into momentary depression."
                                            },
                                            {
                                                "example_id": "9f39d5c6-d5a2-4fc0-9621-9deea944e2a4",
                                                "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                                "text": "Yilamujiang grew up in Altay, a prefecture bordering Mongolia in far northwest Xinjiang. Chinese officials consider the region the cradle of Alpine sport, after cave paintings of hunters on skis were dated at 10,000 years old. Locals still use hand-carved wooden skis covered in a horsehide, although mostly now for the benefit of tourists."
                                            },
                                            {
                                                "example_id": "9ba5ba1e-4c91-42b8-a6fe-5b2af6c5e89f",
                                                "sense_id": "90a5e769-9f4d-3b89-ac06-1c99a4a50a2a",
                                                "text": "Torchbearer Dinigeer Yilamujiang hails from the mountainous terrain of Xinjiang's Altay prefecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1be17c-359d-32cb-a387-d630dedae219",
                                        "entry_id": "aeae4148-872e-3cab-b71a-aaf8b6c8e339",
                                        "glosses": [
                                            "A county-level city of Altay prefecture, in far northern Xinjiang autonomous region, China."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
