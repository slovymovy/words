                "senses": [
                    {
                        "sense_id": "d63881c5-dcba-3560-abc5-31d99e3c15c7",
                        "entry_id": "45055fda-0246-3fe3-8212-c4925003e75a",
                        "glosses": [
                            "jednostka objętości, a także masy materiałów sypkich, stosowana zwłaszcza w krajach anglosaskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0015f0-d8a0-40e5-b43c-c2abd06e3b36",
                                "sense_id": "d63881c5-dcba-3560-abc5-31d99e3c15c7",
                                "text": "Według obliczeń Pimentela sprzed mniej więcej 10 lat, z jednego buszla kukurydzy (buszel to w przybliżeniu 1/40 tony) wyprodukować można 2,5 galona etanolu"
                            },
                            {
                                "example_id": "fa6a7389-8407-4b7f-9489-5b51e08fa76a",
                                "sense_id": "d63881c5-dcba-3560-abc5-31d99e3c15c7",
                                "text": "też tak pomyślałem, ale na buszle mierzy się rzeczy sypkie jak ziarno albo cukier. Na pewno nie tuczniki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
