                                    {
                                        "sense_id": "4f33a86a-8a61-3731-94b2-5ead004d0ea0",
                                        "entry_id": "bc8ab385-cb07-3501-a5b3-fbc2438285ca",
                                        "glosses": [
                                            "een stad in Griekenland met ongeveer 20.000 inwoners"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "674d7d19-b63f-4612-b5d2-24f0469416f3",
                                                "sense_id": "4f33a86a-8a61-3731-94b2-5ead004d0ea0",
                                                "text": "Het (pre)historische Thebe is het decor van heel wat Griekse mythen en sagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5cf6c910-74a1-4eae-8038-76d6c08d3356",
                        "source_entry_id": "4c01c4b7-aa6a-39e7-bd63-6774f77ff990",
