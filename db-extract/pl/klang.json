                                "target_senses": [
                                    {
                                        "sense_id": "1df41aff-df80-3205-b63c-38b9ccf7a3aa",
                                        "entry_id": "52af3e1f-e451-35ee-9f95-9128eeff5f30",
                                        "glosses": [
                                            "die Art, wie etwas klingt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f3e5a88-f86f-4621-8438-b46e25826fc4",
                                                "sense_id": "1df41aff-df80-3205-b63c-38b9ccf7a3aa",
                                                "text": "Der Klang ihrer Stimme entzückte ihn immer wieder aufs neue."
                                            },
                                            {
                                                "example_id": "806833ff-1fe4-4e16-805f-1feff6749a2e",
                                                "sense_id": "1df41aff-df80-3205-b63c-38b9ccf7a3aa",
                                                "text": "„In einiger Entfernung höre ich lustige Stimmen von mehreren Menschen und gehe dem Klange nach.“"
                                            },
                                            {
                                                "example_id": "388af11e-0a6f-42ff-855b-7fcaf7254708",
                                                "sense_id": "1df41aff-df80-3205-b63c-38b9ccf7a3aa",
                                                "text": "„Er nahm das Tuch ab, mit dem sie zugedeckt war, und dabei gab die Harfe einen misstönenden Klang von sich.“"
                                            },
                                            {
                                                "example_id": "5faf9c79-d0d1-4785-824d-714c8e26840c",
                                                "sense_id": "1df41aff-df80-3205-b63c-38b9ccf7a3aa",
                                                "text": "„Ohne es zu wollen, gewöhnte ich mich an den Klang des unermüdlichen Klaviers, die Töne, die sich immer wieder um sich selbst drehten, wie Karussellmusik, und schlief ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b6ec5041-79de-3358-abf5-0489751dd467",
                                        "entry_id": "52af3e1f-e451-35ee-9f95-9128eeff5f30",
                                        "glosses": [
                                            "Ton oder Geräusch, als musikalisch empfunden"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bee0751d-9ec0-400a-85eb-bdc3a0294d26",
                                                "sense_id": "b6ec5041-79de-3358-abf5-0489751dd467",
                                                "text": "Die verschiedensten Klänge erfüllten den Raum."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f103e0d3-2da8-3247-859a-da54eda82848",
                                        "entry_id": "52af3e1f-e451-35ee-9f95-9128eeff5f30",
                                        "glosses": [
                                            "mehrere gleichzeitig erklingende, sich überlagernde Töne"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29570566-84df-4de0-8ef0-dab3f37499b8",
                                                "sense_id": "f103e0d3-2da8-3247-859a-da54eda82848",
                                                "text": "Das Stück enthält einige für die damalige Zeit ungewohnte Klänge."
                                            }
                                        ],
