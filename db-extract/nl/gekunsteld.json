                                            {
                                                "example_id": "fd5165f8-dad0-464a-adfe-e04be58fdaa4",
                                                "sense_id": "d2c89e3d-4a59-31c1-b96d-ca2bfa1974b0",
                                                "text": "«Esta renovación del aire podrá hacerse mediante ventilación natural o artificial, debiendo tenerse en cuenta la velocidad, forma de entrada, distribución, volumen del aire por persona y por minuto, condiciones de pureza, temperatura y humedad, con el objeto de que no resulten molestas o perjudiciales para la salud de los trabajadores»"
                                            }
