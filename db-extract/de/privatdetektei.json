                "senses": [
                    {
                        "sense_id": "009eea15-65da-392b-b301-e113c81e4a2c",
                        "entry_id": "044af1e4-fe9f-353a-8662-0da3869ae431",
                        "glosses": [
                            "von einem oder mehreren Privatdetektiven unterhaltener Betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b33884c8-b4fb-45cf-9b75-9cc6df940d5d",
                                "sense_id": "009eea15-65da-392b-b301-e113c81e4a2c",
                                "text": "„Dekker kannte die Firma - ehemalige Polizisten, hohe Offiziere, die vor fünf, sechs Jahren aus dem Dienst ausgeschieden waren und mit ihren fetten Abfindungen eine eigene Privatdetektei eröffnet hatten.“"
                            },
                            {
                                "example_id": "6aa0dbb0-36ae-4132-8b34-c688b76bfd10",
                                "sense_id": "009eea15-65da-392b-b301-e113c81e4a2c",
                                "text": "„Und was ich tat, war, die verdammt beste Privatdetektei in Südkalifornien aufzubauen.“"
                            },
                            {
                                "example_id": "8c55c2e6-b3bc-4d56-83a2-677bca5072ce",
                                "sense_id": "009eea15-65da-392b-b301-e113c81e4a2c",
                                "text": "„Jahre später nahm Armah vorzeitig seinen Abschied bei der Polizei, um eine Privatdetektei in Kumasi zu eröffnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
