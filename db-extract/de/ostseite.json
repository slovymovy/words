                ],
                "senses": [
                    {
                        "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                        "entry_id": "74f5bcb6-fd60-3832-a340-417779bf2a74",
                        "glosses": [
                            "die Seite von etwas, die nach Osten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a631fb8a-959b-425e-a9c4-8ee55ba2c334",
                                "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                                "text": "„Während dieser Baumaßnahme, die voraussichtlich bis Mitte Dezember andauert, ist der Gehweg auf der Ostseite nicht zu nutzen.“"
                            },
                            {
                                "example_id": "659d7796-dc4f-49a5-bbed-275a10a31ace",
                                "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                                "text": "„Auf dem Felsmassiv haben sich nur auf der Ostseite vereinzelte Mauerteile erhalten, die zusammen mit Abarbeitungen im Fels eine intensive Nutzung der Burg belegen.“"
                            },
                            {
                                "example_id": "f63703be-9d9d-4bc4-bece-4d130ea3bf18",
                                "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                                "text": "„Auf der Ostseite öffnet sich die windgeschützte Bucht zum Meer.“"
                            },
                            {
                                "example_id": "a357529b-9375-45da-b651-7842d43f3622",
                                "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                                "text": "„So umschmeichelte man einander den halben Tag, bis endlich die Tafelordnung in der Weise zustande kam, daß den Ehrenplatz die Gemahlin des fünften Tjau inne hatte, die übrigen Gäste auf der Ostseite und die gastgebenden Frauen auf der Westseite Platz nahmen.“"
                            },
                            {
                                "example_id": "5cc98ed2-568e-4501-a498-51d61aa0f073",
                                "sense_id": "c9023bbb-2666-3a5a-b191-0e6a74db7df1",
                                "text": "„Zwei Stunden später nahm er sich ein Zimmer im Rodeway Inn auf der Ostseite der Stadt und ging gleich zu Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
