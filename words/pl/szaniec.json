            "senses": [
                {
                    "sense_id": "8fd977c1-6b2b-350c-8973-e277736d789b",
                    "sense_definition": "ziemna fortyfikacja polowa składająca się z wału i rowu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fortyfikacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żołnierze wykopali głęboki <w>szaniec</w>, aby bronić się przed atakiem wroga.",
                            "target_lang_translations": {
                                "ru": "Солдаты вырыли глубокий <w>окоп</w>, чтобы защититься от атаки врага."
                            }
                        },
                        {
                            "text": "Stary <w>szaniec</w> był już mocno zarośnięty trawą i krzewami.",
                            "target_lang_translations": {
                                "ru": "Старый <w>шанец</w> уже сильно зарос травой и кустарником."
                            }
                        }
                    ],
                    "common_phrases": [
                        "budować szaniec"
                    ],
                    "target_lang_definitions": {
                        "ru": "полевое земляное укрепление, состоящее из вала и рва"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шанец",
                                "target_lang_sense_clarification": "историческое название временных полевых укреплений"
                            },
                            {
                                "target_lang_word": "окоп",
                                "target_lang_sense_clarification": "более современный и общеупотребительный термин для земляного укрепления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed6627d5-99a1-3a87-9f46-e394cd5004f0",
                    "sense_definition": "miejsce będące ostoją lub oparciem dla jakiejś idei lub grupy ludzi",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "metafory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Uniwersytet stał się ostatnim <w>szańcem</w> wolnej myśli w tym kraju.",
                            "target_lang_translations": {
                                "ru": "Университет стал последним <w>бастионом</w> свободной мысли в этой стране."
                            }
                        },
                        {
                            "text": "Ta gazeta jest prawdziwym <w>szańcem</w> tradycyjnych wartości.",
                            "target_lang_translations": {
                                "ru": "Эта газета — настоящий <w>оплот</w> традиционных ценностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bastion"
                    ],
                    "target_lang_definitions": {
                        "ru": "место или организация, служащие опорой для защиты каких-либо идей или группы людей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бастион",
                                "target_lang_sense_clarification": "переносное значение: оплот, надежная защита"
                            },
                            {
                                "target_lang_word": "оплот",
                                "target_lang_sense_clarification": "переносное значение: надежная опора, защита"
                            }
                        ]
                    }
                }
            ]
        }
