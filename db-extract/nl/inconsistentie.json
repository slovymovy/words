                        "entry_id": "9225e5f3-eeda-3057-80d4-8271b7d63a60",
                        "glosses": [
                            "gebrek aan samenhang, innerlijke tegenstrijdigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3615bc1-c2e1-44ac-8bf5-e901b27a1d98",
                                "sense_id": "3d95bd6d-c49d-3d9d-8592-2a46709d23bb",
                                "text": "Mensink: „Dat is een constante inconsistentie in veel onderzoek naar de publieke opinie. Veel mensen vinden dat er te veel vluchtelingen komen, maar voelen ook een morele plicht om vluchtelingen op te vangen. De grenzen volledig sluiten, gaat ze dan toch te ver.”"
                            },
                            {
                                "example_id": "68a510d6-1a01-4dee-870b-b9215b12d8f3",
                                "sense_id": "3d95bd6d-c49d-3d9d-8592-2a46709d23bb",
                                "text": "Striplezers hechten zeer aan ‘continuïteit’ en dus moest er in de stripverhalen zelf een uitleg komen voor de inconsistenties."
                            },
                            {
                                "example_id": "4dbc01bc-98d2-4d09-a4bc-e4ee33b08d4d",
                                "sense_id": "3d95bd6d-c49d-3d9d-8592-2a46709d23bb",
                                "text": "⧖ Hij achtte het uitlokken van een Pauselijk verbod tegen staatkundige woelingen eene groote inconsistentie van de Britsche regering, die alle tijdelijk gezag aan den stoel van Rome betwistte."
                            }
                        ]
                    }
