                                "target_senses": [
                                    {
                                        "sense_id": "b16ddd02-d730-33e5-bd03-3a8c922a8c22",
                                        "entry_id": "aa57a0a6-4823-36bf-8ae0-785fb122ee26",
                                        "glosses": [
                                            "Any of a group of crystalline minerals containing silicates of iron, magnesium and calcium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "734a1018-66f9-4937-80ef-b4c2f3aafa95",
                                                "sense_id": "b16ddd02-d730-33e5-bd03-3a8c922a8c22",
                                                "text": "By the pathside, there are occasional large boulders that shown black crystals the size of a fingernail; these are pyroxene minerals that had time to crystallise out deep within the chamber of liquid rock – or magma – beneath the volcano."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
