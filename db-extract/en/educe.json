                        "target_lang_word": "afleiden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afleiden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dbd45b66-4e85-3859-8084-7e9abb16afc1",
                                        "entry_id": "0818c75c-4f17-3d34-be5d-c2469b689730",
                                        "glosses": [
                                            "de aandacht van iemand naar een ander onderwerp laten gaan"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "791fcd53-d49d-4bfe-b7af-438e4bd894bc",
                                                "sense_id": "dbd45b66-4e85-3859-8084-7e9abb16afc1",
                                                "text": "De zoon moest zijn vader afleiden, zodat de dochter ongemerkt naar buiten kon gaan."
                                            },
                                            {
                                                "example_id": "4d355c05-2472-4f43-9cb9-dd5cabce51ab",
                                                "sense_id": "dbd45b66-4e85-3859-8084-7e9abb16afc1",
                                                "text": "Een onbekende stem vertelde een eindeloos lange mop met een zeer matige clou, maar ik was allang blij afgeleid te worden."
                                            },
                                            {
                                                "example_id": "df45d8f2-1ba4-4e63-a3a9-0fc63fef49f9",
                                                "sense_id": "dbd45b66-4e85-3859-8084-7e9abb16afc1",
                                                "text": "Een mooi uitzicht zou me waarschijnlijk alleen maar afleiden van mijn werk."
                                            },
                                            {
                                                "example_id": "8c5b526f-a8f7-4323-a804-5b698c314d82",
                                                "sense_id": "dbd45b66-4e85-3859-8084-7e9abb16afc1",
                                                "text": "Ik tastte op het nachtkastje naar mijn telefoon, zette de meditatie-app uit en opende mijn mail. Ik moest mezelf maar weer afleiden. Tussen een woud van spamberichten, zag ik haar naam staan: Mirte van Reeden, hoofdredacteur Psychologie Magazine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c300ca1-318f-3d6f-a494-4b7724e16d2f",
                                        "entry_id": "0818c75c-4f17-3d34-be5d-c2469b689730",
                                        "glosses": [
                                            "~ uit: begrijpen, concluderen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "376be743-5be8-4beb-b86c-3375445bc8a4",
                                                "sense_id": "1c300ca1-318f-3d6f-a494-4b7724e16d2f",
                                                "text": "Ik kon uit haar woorden wel afleiden dat ze het leuk had gehad."
                                            },
                                            {
                                                "example_id": "33a214e8-6f03-4c0a-9100-53bb86134173",
                                                "sense_id": "1c300ca1-318f-3d6f-a494-4b7724e16d2f",
                                                "text": "Uit de contouren kon ze eveneens afleiden dat de haardos van haar zus op zijn minst verwilderd te noemen was."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a687b66-cf22-4624-86aa-c906465f6023",
