                        "sense_id": "aca7f09a-ce9e-3996-9099-fcca93809517",
                        "entry_id": "04864427-9694-371b-a6da-5a895a76c3b8",
                        "glosses": [
                            "ein Programm, das in einer Quellsprache geschriebenen Quelltext in eine bestimmte Zielsprache (zum Beispiel) Maschinensprache) übersetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19f6924-f466-4693-89bc-77baacc64a83",
                                "sense_id": "aca7f09a-ce9e-3996-9099-fcca93809517",
                                "text": "Ein Compiler übersetzt den von Menschen lesbaren Quelltext in die für den Computer verständliche Maschinensprache."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e2ca1d8-d0f8-4320-a457-77b1b18a48b2",
                        "source_entry_id": "04864427-9694-371b-a6da-5a895a76c3b8",
                        "source_sense_id": "aca7f09a-ce9e-3996-9099-fcca93809517",
                        "source_sense_description": "Programm, das in einer Quellsprache geschriebenen Quelltext in eine Zielsprache übersetzt",
                        "target_lang_word": "compiler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compiler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88f4ef4a-2359-3171-bc74-f2c1be585624",
                                        "entry_id": "f4091f2e-ea99-3dcb-96af-373b071b06be",
                                        "glosses": [
                                            "One who compiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e403e308-c16b-491b-b5af-0729b0cd3423",
                                                "sense_id": "88f4ef4a-2359-3171-bc74-f2c1be585624",
                                                "text": "a compiler of poetry anthologies"
                                            },
                                            {
                                                "example_id": "ac78f41b-8abe-47c6-91da-f402c6aa4352",
                                                "sense_id": "88f4ef4a-2359-3171-bc74-f2c1be585624",
                                                "text": "my favourite crossword compiler"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a84059-5a04-33f8-9fcd-82f5bbc243b3",
                                        "entry_id": "f4091f2e-ea99-3dcb-96af-373b071b06be",
                                        "glosses": [
                                            "A computer program that transforms source code into object code."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2856ec8f-cf78-41b1-853d-8edc69a9d8c5",
                                                "sense_id": "83a84059-5a04-33f8-9fcd-82f5bbc243b3",
                                                "text": "As a result, many compilers automatically allocate blocks of memory and then parcel chunks out to programs with a suballocator when needed. That is, the compiler allocates a chunk of some 4,000 bytes and then parcels this memory out to you in bits and pieces when you need it."
                                            },
                                            {
                                                "example_id": "070f0721-e9d5-4cd8-84d6-d56d06729e11",
                                                "sense_id": "83a84059-5a04-33f8-9fcd-82f5bbc243b3",
                                                "text": "The recommended Apple Objective-C compiler, Clang/LLVM (versions 4.2 and above) provides support for autosynthesis of declared properties. This means that the compiler will automatically synthesize declared properties […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b217303d-d2f9-45f0-b225-c6a5d9a21136",
                        "source_entry_id": "04864427-9694-371b-a6da-5a895a76c3b8",
                        "source_sense_id": "aca7f09a-ce9e-3996-9099-fcca93809517",
                        "source_sense_description": "Programm, das in einer Quellsprache geschriebenen Quelltext in eine Zielsprache übersetzt",
                        "target_lang_word": "compilateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compilateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17c3b011-eadd-33a7-970f-91427e909fa9",
                                        "entry_id": "1d860906-14d2-354b-b2d5-19128fb9f2aa",
                                        "glosses": [
                                            "Relatif à la compilation ; qui compile des informations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "582ed304-702b-4cb3-9178-f6bff59316e0",
                                                "sense_id": "17c3b011-eadd-33a7-970f-91427e909fa9",
                                                "text": "À cette littérature tantôt contingente et circonstancielle, tantôt scolaire et compilatrice, s’oppose la profonde réflexion théologique des historiographes arméniens."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "compilateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8369f1-3b80-36c2-9b1f-2b4affa2fc4f",
                                        "entry_id": "7a9cb31d-65a6-301e-806c-fdbbf79c88b4",
                                        "glosses": [
                                            "Celui qui compile des données de sources diverses pour en faire une œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd4d6226-3fd7-48a1-8a98-b54ad32669e1",
                                                "sense_id": "4b8369f1-3b80-36c2-9b1f-2b4affa2fc4f",
                                                "text": "Diverses copies en circulaient un peu partout, ainsi reproduites dans les ouvrages de Lepoittevin-Janot, de Jules Leroux et de tant d’autres compilateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "097ec52c-cf10-316b-bcca-33b34e9e13ff",
                                        "entry_id": "7a9cb31d-65a6-301e-806c-fdbbf79c88b4",
                                        "glosses": [
                                            "Programme informatique destiné à traduire des programmes écrits par le programmeur dans un langage de haut niveau (le langage source), en un code objet (écrit dans le langage cible, habituellement lié à la machine d’exécution : langage d’assemblage ou langage machine)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7b43156-33e7-4c17-a4d8-e92400069431",
                                                "sense_id": "097ec52c-cf10-316b-bcca-33b34e9e13ff",
                                                "text": "Les opérations de création de noyau sont logiquement accomplies sur un système particulier possédant un compilateur. Les systèmes en production n’en possèdent généralement pas."
                                            },
                                            {
                                                "example_id": "cf7c4f6c-8a28-4c5e-8427-45aaacdf86fc",
                                                "sense_id": "097ec52c-cf10-316b-bcca-33b34e9e13ff",
                                                "text": "Ils confient donc à un compilateur, à partir du logiciel qu’ils ont écrit dans un langage de programmation OO tel que C++, Smalltalk, Java ou C#, le soin de le traduire dans les instructions élémentaires du processeur […]"
                                            },
                                            {
                                                "example_id": "5989db33-b718-4825-a940-a647ac97bbc2",
                                                "sense_id": "097ec52c-cf10-316b-bcca-33b34e9e13ff",
                                                "text": "Comme promis, nous allons étudier maintenant la règle qui autorise l’omission de l’esperluète dans un appel de sous-programme. Si le compilateur rencontre la définition de la fonction avant l’invocation, ou si Perl peut savoir d’après la syntaxe qu’il s’agit d’un appel de fonction, celle-ci peut être appelée sans esperluète, comme une fonction intégrée quelconque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
