                "senses": [
                    {
                        "sense_id": "56d8e39a-82a7-315c-9d55-73547a0e3b64",
                        "entry_id": "ca55c020-e48c-30f4-a083-464131882aa6",
                        "glosses": [
                            "Faire défection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50acf4f0-9eb3-4afe-8940-3f5a5de4adea",
                                "sense_id": "56d8e39a-82a7-315c-9d55-73547a0e3b64",
                                "text": "Ledit sieur comte me communiqua l’instance que faisoient ces derniers à leurs députés et à vous, de faire une ligue offensive et défensive envers et contre tous, et me déclara que pour l’offensive ils n’y pouvoient venir, ne voulant que le roi d'Espagne pût dire qu’ils eussent été les premiers à défecter de leur traité ;"
                            },
                            {
                                "example_id": "5830f1d9-98c7-42af-9daa-5dfa047d9c61",
                                "sense_id": "56d8e39a-82a7-315c-9d55-73547a0e3b64",
                                "text": "Cecy est capable de les faire défecter, ils ne venoient que se montrer […] leur habits et ne payoient point."
                            },
                            {
                                "example_id": "ad4b8055-0f98-4284-ad1a-a6b8440ca1f8",
                                "sense_id": "56d8e39a-82a7-315c-9d55-73547a0e3b64",
                                "text": "On peut essayer, Paul lui a dit qu’il demandait des instructions à Washington ; pour le moment elle ne se doute pas que vous savez… vous allez la prévenir que Washington envoie un agent spécial du F.B.I., pour faire défecter Makaradze…"
                            }
                        ]
                    }
