{
    "word_family": [
        "intimidate",
        "intimidation",
        "intimidator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f9c3831-5b48-33ba-b3c8-c7b523b9aaa3",
                    "sense_definition": "causing a person to feel fear, lack of confidence, or anxiety, often due to being impressive, powerful, or threatening",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frightening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer size of the mountain was <w>intimidating</w> to the amateur climbers.",
                            "target_lang_translations": {
                                "ru": "Огромный размер горы был <w>устрашающим</w> для альпинистов-любителей."
                            }
                        },
                        {
                            "text": "She found the <w>intimidating</w> atmosphere of the courtroom very difficult to handle during her testimony.",
                            "target_lang_translations": {
                                "ru": "Ей было очень трудно справиться с <w>пугающей</w> атмосферой в зале суда во время дачи показаний."
                            }
                        }
                    ],
                    "synonyms": [
                        "daunting",
                        "frightening",
                        "menacing",
                        "scary",
                        "terrifying"
                    ],
                    "antonyms": [
                        "reassuring",
                        "comforting",
                        "inviting",
                        "encouraging"
                    ],
                    "common_phrases": [
                        "intimidating atmosphere",
                        "intimidating presence",
                        "intimidating task",
                        "look intimidating"
                    ],
                    "target_lang_definitions": {
                        "ru": "вызывающий у человека чувство страха, неуверенности или тревоги, часто из-за своей внушительности, силы или угрожающего вида"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пугающий",
                                "target_lang_sense_clarification": "вызывающий страх или тревогу"
                            },
                            {
                                "target_lang_word": "устрашающий",
                                "target_lang_sense_clarification": "внушающий страх своим видом или мощью"
                            },
                            {
                                "target_lang_word": "внушительный",
                                "target_lang_sense_clarification": "производящий сильное впечатление, подавляющий своим масштабом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f3d05927-14f3-3c4a-9ef2-0f9b5cf5fbff",
                    "sense_definition": "present participle and gerund of <w>intimidate</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang was arrested for <w>intimidating</w> witnesses before the trial began.",
                            "target_lang_translations": {
                                "ru": "Банда была арестована за <w>запугивание</w> свидетелей до начала судебного процесса."
                            }
                        },
                        {
                            "text": "By <w>intimidating</w> the smaller children, the bully managed to take their lunch money every day.",
                            "target_lang_translations": {
                                "ru": "<w>Запугивая</w> детей помладше, хулигану удавалось каждый день забирать их деньги на обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "frightening",
                        "bullying",
                        "threatening"
                    ],
                    "common_phrases": [
                        "intimidating witnesses",
                        "accused of intimidating"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "причастие настоящего времени и герундий от глагола «запугивать»"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запугивание",
                                "target_lang_sense_clarification": "процесс внушения страха (герундий)"
                            },
                            {
                                "target_lang_word": "запугивающий",
                                "target_lang_sense_clarification": "тот, кто внушает страх (причастие)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}