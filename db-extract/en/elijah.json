                                            {
                                                "example_id": "cf4ca2f7-8ff9-4872-b8ac-45c814eabf22",
                                                "sense_id": "c1e13b1b-c8c8-3994-9caf-9f02142f1bef",
                                                "text": "Mam na imię Eliasz i studiuję judaistykę w Instytucie Judaistyki Uniwersytetu Jagiellońskiego w Krakowie."
