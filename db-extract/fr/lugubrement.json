        "fr-extract.jsonl": [
            {
                "entry_id": "618b6cf1-41cf-3fcf-bc48-9b6583e20806",
                "word": "lugubrement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                        "entry_id": "618b6cf1-41cf-3fcf-bc48-9b6583e20806",
                        "glosses": [
                            "D’une manière lugubre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca164b09-3683-4dd5-94a1-eb4aab18ad90",
                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                "text": "Pierre se leva de table, sans un mot, et descendit au jardin ; le dîner s'acheva lugubrement."
                            },
                            {
                                "example_id": "acd8ea03-cd4a-4567-a85d-7f7f0687cc3a",
                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                "text": "Dans les airs obscurcis d’un voile de ténèbres, Pour toi l’airain sacré sonnait lugubrement."
                            },
                            {
                                "example_id": "439cefcf-fd49-49c8-b1b9-5ea5b2a57ab4",
                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                "text": "Un double coassement venu des palmes obscures de l’île peupla lugubrement le silence de l’équipage."
                            },
                            {
                                "example_id": "280fabce-0797-441d-855e-b85b75d290e5",
                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                "text": "Chanter lugubrement."
                            },
                            {
                                "example_id": "391a694f-8399-4ce0-9b38-73dfe6e9b6dc",
                                "sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                                "text": "Être vêtu lugubrement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a19bd205-6d24-458b-8c09-8cde2509074e",
                        "source_entry_id": "618b6cf1-41cf-3fcf-bc48-9b6583e20806",
                        "source_sense_id": "a6f2b2c7-8de9-32c8-a0e8-d29fa8e4445f",
                        "target_lang_word": "dismally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dismally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b9617ac-555f-3ade-9061-cd2fb6ff8e4f",
                                        "entry_id": "8661709d-6651-36ad-b47c-4596a925f359",
                                        "glosses": [
                                            "In a dismal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2397f92-9b2d-43f6-a77b-53ac6d4e3ba5",
                                                "sense_id": "5b9617ac-555f-3ade-9061-cd2fb6ff8e4f",
                                                "text": "The ribs of the few horses showed dismally."
                                            },
                                            {
                                                "example_id": "56947428-13a0-45f1-8493-2a6a21630c87",
                                                "sense_id": "5b9617ac-555f-3ade-9061-cd2fb6ff8e4f",
                                                "text": "Outside an owl was hooting most dismally in the darkness."
                                            },
                                            {
                                                "example_id": "fc8e84f6-a22d-4708-b938-26a0aa254eeb",
                                                "sense_id": "5b9617ac-555f-3ade-9061-cd2fb6ff8e4f",
                                                "text": "Boris Johnson's speech to the nation on Sunday May 10 was rambly, incoherent, and he failed dismally in his attempt to sound Churchillian."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
