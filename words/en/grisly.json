                            "trait_type": "obsolete",
                            "comment": "historical spelling of the noun grizzly"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая форма написания названия медведя гризли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гризли",
