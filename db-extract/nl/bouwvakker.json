                "translations": [
                    {
                        "translation_id": "1f6dc40f-27ee-40fa-ad85-b2d3e44525f8",
                        "source_entry_id": "58fb52c2-433f-3c4d-9b97-296facee83cb",
                        "source_sense_id": "a93e4d90-059b-3715-b8d5-15325f9620e3",
                        "target_lang_word": "Bauarbeiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauarbeiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3bb712d-b35f-322b-9d11-6fce85d7f073",
                                        "entry_id": "40876ca5-ab07-3b9d-8e60-6202a7f7584c",
                                        "glosses": [
                                            "eine Person, deren Beruf es ist, an der Erstellung von Bauwerken mitzuarbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0662e203-6010-4d1a-b6b9-671d83ab3859",
                                                "sense_id": "d3bb712d-b35f-322b-9d11-6fce85d7f073",
                                                "text": "Zu den Bauarbeitern zählen Betonbauer, Maurer, Poliere und viele andere mehr."
                                            },
                                            {
                                                "example_id": "6ba102b8-d6e0-4678-9bf1-a905c63faf3a",
                                                "sense_id": "d3bb712d-b35f-322b-9d11-6fce85d7f073",
                                                "text": "„Bei seinem allerersten Disco-Besuch musste er deshalb riesige Ohrenschützer anlegen, wie sie sonst nur Bauarbeiter tragen.“"
                                            },
                                            {
                                                "example_id": "b69f910e-76aa-4468-9fcc-d4369c40808f",
                                                "sense_id": "d3bb712d-b35f-322b-9d11-6fce85d7f073",
                                                "text": "„Grenfeld drängte sich vorbei an den lautstark diskutierenden Bauarbeitern, die offenbar in den Streik getreten waren und sich nun vor einem Kiosk versammelten.“"
                                            },
                                            {
                                                "example_id": "0f015395-6239-4231-8b27-11b45768010f",
                                                "sense_id": "d3bb712d-b35f-322b-9d11-6fce85d7f073",
                                                "text": "„Ein Bauarbeiter verunglückt tödlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
