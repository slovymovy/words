                                                "text": "Nudyści twierdzą, że nago lepiej się czują na łonie natury."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6409403d-85db-4280-958e-35b647cea584",
                        "source_entry_id": "3ad970bf-0efa-3c5c-a4f9-fb253004e552",
                        "source_sense_id": "6733062e-d700-3fe0-968c-d55b01af9184",
                        "target_lang_word": "nudiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nudiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ef57f91-e330-3f9f-aee7-a050fa843682",
                                        "entry_id": "f180e690-0f8b-3bd5-9811-8933c8184dd9",
                                        "glosses": [
                                            "Relatif au nudisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc78c1f-3c56-4619-83f4-769b85f09c41",
                                                "sense_id": "4ef57f91-e330-3f9f-aee7-a050fa843682",
                                                "text": "Une plage nudiste."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nudiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "731ba725-5a47-387c-85a2-6ebf43c3b9a7",
                                        "entry_id": "415a9457-8bdc-343c-a0c8-8a9545416b87",
                                        "glosses": [
                                            "Personne qui pratique le nudisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb58424-e36f-4a4b-8360-5e73cb00177b",
                                                "sense_id": "731ba725-5a47-387c-85a2-6ebf43c3b9a7",
                                                "text": "Le nudiste doit se convaincre que les corps nus qu’il voit ne sont pas érotiques, que les sexes qu’il a sous les yeux ne sont pas des sexes, ou plutôt qu’ils n’ont pas de rapport avec la sexualité."
                                            },
                                            {
                                                "example_id": "5f0758b2-a975-4521-aff5-c33d52eb175c",
                                                "sense_id": "731ba725-5a47-387c-85a2-6ebf43c3b9a7",
                                                "text": "Les détracteurs du nudisme —les moralistes ou hygiénistes conservateurs d’État ou d’Église— prétendent que la vue du nu, que la fréquentation entre nudistes des deux sexes exaltent le désir érotique."
                                            },
                                            {
                                                "example_id": "f4e92bf4-6a7e-46e5-aad8-cc4a572629b8",
                                                "sense_id": "731ba725-5a47-387c-85a2-6ebf43c3b9a7",
                                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
