                                        "sense_id": "6906512a-2c5a-3275-b63e-9d4510f5db68",
                                        "entry_id": "6ddb78a6-9fc2-3da3-9cc7-66e8bd1a1dff",
                                        "glosses": [
                                            "Dienstbereitschaft"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fcd5c18e-dbb7-37b6-b454-de97b62ac1fe",
                                        "entry_id": "6ddb78a6-9fc2-3da3-9cc7-66e8bd1a1dff",
                                        "glosses": [
                                            "dingliches Recht an einem Grundstück"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e19ff84-9fce-4467-9d82-efdf4f9c4009",
                                                "sense_id": "fcd5c18e-dbb7-37b6-b454-de97b62ac1fe",
                                                "text": "Dienstbarkeiten werden im Lastenblatt vermerkt."
                                            },
                                            {
                                                "example_id": "2b133acc-b382-4f3b-9831-24f1af21a22b",
                                                "sense_id": "fcd5c18e-dbb7-37b6-b454-de97b62ac1fe",
                                                "text": "„Durch das Recht der Dienstbarkeit wird ein Eigenthümer verbunden, zum Vortheile eines Andern in Rücksicht seiner Sache etwas zu dulden oder zu unterlassen.“"
                                            },
                                            {
                                                "example_id": "3a436ae8-9f1b-489b-b72d-0936a54eccd0",
                                                "sense_id": "fcd5c18e-dbb7-37b6-b454-de97b62ac1fe",
                                                "text": "„Fußsteig und Fahrweg sind keine Dienstbarkeiten, welche ihrer Natur nach das ganze dienende Grundstück erfassen und daher im Sinne des § 485 ABGB unteilbar wären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205b3512-8ded-46f6-b148-a7bac082032f",
                        "source_entry_id": "2bf7f855-ea92-346d-a06a-ec5abbf602bd",
                        "source_sense_id": "6df050c5-16d0-3f8d-b2db-ae721141a729",
                        "source_sense_description": "zakelijk recht op andermans onroerend goed",
                        "target_lang_word": "servitude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "servitude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                                        "entry_id": "76554362-776e-3c1f-8e1c-23598406a528",
                                        "glosses": [
                                            "Esclavage, captivité ; état d’un peuple entièrement subjugué."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b461be-845b-4d85-808f-0334b9a339bd",
                                                "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                                                "text": "Le joug de la servitude."
                                            },
                                            {
                                                "example_id": "22373db4-65e8-457a-80ba-771d00e8e76e",
                                                "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                                                "text": "Délivrer, tirer de servitude."
                                            },
                                            {
                                                "example_id": "ff0052b3-9524-4f45-8018-9400a22065a2",
                                                "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                                                "text": "Sortir de servitude."
                                            },
                                            {
                                                "example_id": "980f061d-23b5-44cc-8659-63da1c7ca1bb",
                                                "sense_id": "6d7e4d68-cab8-3b79-9b44-09cace289365",
                                                "text": "Historiquement, lorsqu'une ethnie envahit le territoire d'une autre ethnie, elle la réduit habituellement en servitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbc863d1-11be-3e04-b300-1b157e856fab",
                                        "entry_id": "76554362-776e-3c1f-8e1c-23598406a528",
                                        "glosses": [
                                            "État d’un homme assujetti, livré à ses passions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7539cd7a-d182-444c-92ed-1e85e9870ff0",
                                                "sense_id": "bbc863d1-11be-3e04-b300-1b157e856fab",
                                                "text": "Je percevais au tremblement de leur voix, au miel de leurs paroles, cette terrible servitude qui les liait à ce qu'on nomme l'amour, d'un mot trop doux parce qu'on ne veut pas lui donner son véritable visage de bestialité et d'animalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77f935c7-cec4-31d0-9b35-119ddb1ce05f",
                                        "entry_id": "76554362-776e-3c1f-8e1c-23598406a528",
                                        "glosses": [
                                            "Contrainte ; assujettissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57990832-55b2-4daf-9922-cbbf0d7d7ea3",
                                                "sense_id": "77f935c7-cec4-31d0-9b35-119ddb1ce05f",
                                                "text": "La servitude militaire est lourde et inflexible comme le masque de fer du prisonnier sans nom, et donne à tout homme de guerre une figure uniforme et froide."
                                            },
                                            {
                                                "example_id": "8f1b5d2d-5979-4f88-8ba9-6405f2cd2b1e",
                                                "sense_id": "77f935c7-cec4-31d0-9b35-119ddb1ce05f",
                                                "text": "De fastidieuses productions de généalogies, de froides disquisitions sur les faits, d'insipides vérifications de dates sont les charges et les servitudes de l'écrivain."
                                            },
                                            {
                                                "example_id": "b7e491bb-85b0-49f5-9096-925be302ebef",
                                                "sense_id": "77f935c7-cec4-31d0-9b35-119ddb1ce05f",
                                                "text": "Pourtant, il s’en trouvera pour voter pour lui avec enthousiasme.\n Pourquoi certains, demandait Spinoza il y a 350 ans, « combattent-ils pour leur servitude comme si c’était pour leur salut ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                        "entry_id": "76554362-776e-3c1f-8e1c-23598406a528",
                                        "glosses": [
                                            "Assujettissement, charge que doit supporter le propriétaire d’une maison, d’une terre, comme un passage, une vue, l’écoulement des eaux, etc."
                                        ],
                                        "tags": [
                                            "Droit de propriété"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55f81b9-b6aa-4715-93c9-4746f9a6109b",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Imposer une servitude."
                                            },
                                            {
                                                "example_id": "a40b173b-f025-469c-83b4-a4bb3d8e8dc7",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Racheter une servitude."
                                            },
                                            {
                                                "example_id": "c4f04383-cb21-4864-934e-43c24e082423",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Il y a de fâcheuses servitudes sur cette maison."
                                            },
                                            {
                                                "example_id": "94608d55-4e15-45f5-998a-b3c07b0d56c8",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Servitudes urbaines."
                                            },
                                            {
                                                "example_id": "20ed7385-27c4-4560-be7a-540e86123e8e",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Servitudes rurales."
                                            },
                                            {
                                                "example_id": "ef2e68d6-391d-49a6-a807-c30678f455c8",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Servitude de passage, de vue."
                                            },
                                            {
                                                "example_id": "cab854d6-5766-4e2e-86a9-c772c3c360d2",
                                                "sense_id": "a338a6bc-47e7-30bc-aa26-a55de44e2431",
                                                "text": "Servitude de tréfonds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c71777-98fe-3c9a-b5bf-06ad1a8557bf",
                                        "entry_id": "76554362-776e-3c1f-8e1c-23598406a528",
                                        "glosses": [
                                            "Installation, réseau, alimentation auxiliaire qui est nécessaire au fonctionnement d’un appareil, d’un système, d’un laboratoire."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a66be5-7431-4002-8a6d-f24323639063",
                                                "sense_id": "e4c71777-98fe-3c9a-b5bf-06ad1a8557bf",
                                                "text": "Servitudes d’habitacle (climatisation, éclairage interne d’une voiture, d'un avion)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
