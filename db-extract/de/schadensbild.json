                        "tags": [],
                        "examples": [
                            {
                                "example_id": "661d8063-0e37-48db-aa99-bdfff23c3883",
                                "sense_id": "3b6cabeb-8075-33ca-a59f-92c3814009c1",
                                "text": "„Das Schadensbild lässt auf eine leichte Kollision schließen, die aufgrund der großen Massenunterschiede vom Beschuldigten vermutlich nicht gespürt wurde bzw. taktil nicht wahrgenommen werden konnte.“"
                            },
                            {
                                "example_id": "a53b1399-559a-4e5a-b4f6-627743105e9b",
                                "sense_id": "3b6cabeb-8075-33ca-a59f-92c3814009c1",
                                "text": "„Eine Überprüfung ergab, dass das dortige Schadenbild mit dem Schadensbild am Fahrzeug übereinstimmt.“"
                            }
                        ],
