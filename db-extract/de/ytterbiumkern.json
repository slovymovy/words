                ],
                "senses": [
                    {
                        "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                        "entry_id": "25b593ca-e363-3d12-83ae-174a0b98661f",
                        "glosses": [
                            "Kern des Ytterbiumatoms"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "fa21fb97-a269-44da-a3da-85170f530b1b",
                                "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                                "text": "„Dies könnte die Diskrepanz zwischen Modell und Experiment für diesen Kern erklären. Die Ytterbium-Kerne sind stark deformiert.“"
                            },
                            {
                                "example_id": "641dc0ad-4746-4aef-bf9b-27736010b4cf",
                                "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                                "text": "„Nach dem vorgestellten Modell wird zur Veranschaulichung Bild 3.28, Seite 54, der vollständige, belegte Kern bis zur N'-Schale, dem Ytterbium-Kern, als Kürzel neu eingeführt und Zentralkern genannt (Tabelle 8.6).“"
                            },
                            {
                                "example_id": "7794b2b9-07d3-4cb3-89be-7d20b23dc7cf",
                                "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                                "text": "„In zwei Fällen nimmt dieser die Edelgaskonfiguration an, mit Ausnahme vom Zinkkern und Ytterbiumkern, und bildet aus einem vorhandenen Kern um ein erweitertes Neutron ein schwereres Element.“"
                            },
                            {
                                "example_id": "4a8b8d02-334e-4370-b4e2-cbcf0724395a",
                                "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                                "text": "„In der Potentialenergiefläche liegen diese Nuklide, besonders wenn man mit den schwersten Lutetium- und Ytterbiumkernen im 136 Xe-Experiment vergleicht, noch nicht sehr weit im Gebiet steilen Abfalles.“"
                            },
                            {
                                "example_id": "cf6a3757-f8f1-4691-a538-bdd2d81ec19e",
                                "sense_id": "03a570a3-2197-3c54-99e4-bae1aec01355",
                                "text": "„Eine spätere Messung der koinzidenten Röntgenlinien bestätigte, daß auch die bisher unbekannten Reaktionsprodukte Ytterbiumkerne sind und nicht durch Emission geladener Teilchen entstehen […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
