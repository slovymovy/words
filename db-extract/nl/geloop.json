                            {
                                "example_id": "c1b469b5-7d9b-4898-a2d7-4154ec2e7707",
                                "sense_id": "cb2dc82c-44a6-365c-abb5-a7ed0be9e255",
                                "text": "De liefde voor mieren heet formicofilie. Het geloop van mieren of andere insecten over gevoelige lichaamsdelen veroorzaakt bij sommige mensen opwinding."
                            },
                            {
                                "example_id": "1389c9a7-4ead-4dbc-94d4-9a0b5ad5a6a8",
                                "sense_id": "cb2dc82c-44a6-365c-abb5-a7ed0be9e255",
                                "text": "Hele dag heen en weer geloop, vanaf 23 uur muziek (zware bas), 23:30 uur aangebeld, drie Duitstalige jongens in zware wietdamp aangetroffen."
                            }
                        ]
                    }
