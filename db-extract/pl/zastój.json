                    {
                        "translation_id": "27b679ed-226b-40a7-9433-7ad07f1e3656",
                        "source_entry_id": "e7314d1b-544d-3ec2-961f-4384b29b140b",
                        "source_sense_id": "eb1dd311-45e0-3586-897b-f206b09fcbb8",
