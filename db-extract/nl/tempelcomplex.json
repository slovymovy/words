                "senses": [
                    {
                        "sense_id": "62501969-693b-3f88-8686-8e978f68103c",
                        "entry_id": "ef060b45-a8dd-37dc-92a4-ac373cd2de0c",
                        "glosses": [
                            "tempel met bijgebouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d72afa5-c3b5-4b03-ad1a-3d03fe97aca3",
                                "sense_id": "62501969-693b-3f88-8686-8e978f68103c",
                                "text": "Tijdens de tweede reis maakte Van Kinsbergen zijn eerste foto's van de Borobudur en het bij Yogyakarta gelegen tempelcomplex de Prambanan."
                            },
                            {
                                "example_id": "45db7975-b827-4429-b44a-b2f21fe2c9bb",
                                "sense_id": "62501969-693b-3f88-8686-8e978f68103c",
                                "text": "De Soemerisch-Akkadische Isjtar was hoedster van wellust, vruchtbaarheid, huwelijk, graan, handel (het graan werd in haar tempelcomplex opgeslagen en verhandeld), oorlog en dood."
                            },
                            {
                                "example_id": "8f3876be-1cd6-4c58-baf9-7e2de8e65658",
                                "sense_id": "62501969-693b-3f88-8686-8e978f68103c",
                                "text": "Op 14 september 1833 stond er bij Rouen een menigte langs de oevers van de Seine te juichen toen er een Frans marineschip, de Louxor, afkomstig uit Alexandrië, stroomopwaarts richting Parijs voer met in een speciaal voor de gelegenheid aangepast ruim de reusachtige obelisk die uit het tempelcomplex van Thebe was gelicht en bestemd was voor een verkeerseiland op de Place de la Concorde."
                            }
                        ]
                    }
