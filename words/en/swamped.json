                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A huge wave <w>swamped</w> the small boat and nearly caused it to sink.",
                            "target_lang_translations": {
