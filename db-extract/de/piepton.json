                "senses": [
                    {
                        "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                        "entry_id": "fc69ed73-ba3d-30a2-9b65-10a7afdcace5",
                        "glosses": [
                            "hohes akustisches Signal, das auf etwas aufmerksam macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "637dc260-bdf6-4c9d-a5f4-1fef28d216e1",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "Der Piepton von Rauchdetektoren ist unglaublich laut."
                            },
                            {
                                "example_id": "8832d7eb-7b36-4032-ba11-0babe8348ba2",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "Die Pieptöne von rückwärts fahrenden LKWs nerven ziemlich."
                            },
                            {
                                "example_id": "c8b5c779-579a-4fcb-955b-625def9af1fc",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Dies ist der Anschluss der Familie ... nach dem Piepton kann eine Nachricht hinterlassen werden.“"
                            },
                            {
                                "example_id": "abf9db26-0a39-4846-b9d2-8f62358ca00f",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„In den meisten Haushalten sind heute elektronische Fieberthermometer vorhanden, die einen Piepton abgeben, wenn die Messung abgeschlossen ist.“"
                            },
                            {
                                "example_id": "9364133d-3448-4040-be04-6cc9c5eb500a",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Joachim Griep steckt seinen elektronischen Ausweis in das Lesegerät. Das Gerät gibt einen Piepton von sich, fast lautlos öffnet sich eine wuchtige Tür.“"
                            },
                            {
                                "example_id": "583326c5-f61a-47db-b200-0024b5fd9472",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Wenn die Batterie leer ist, vibriert die Fußfessel und gibt einen lauten Piepton von sich. Sie muss dann schnell wieder aufgeladen werden.“"
                            },
                            {
                                "example_id": "97bd7701-253a-4e84-852e-6ab84099c564",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Sobald nun also die CO2-Sättigung zu hoch ist – die Luft also „schlecht“ ist –, ertönt ein Piepton: Dann wird gelüftet, und die Atemluft sollte wieder ungefährlich sein.“"
                            },
                            {
                                "example_id": "f39365f6-a2ad-4524-8619-520436bbd008",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "[Kunstauktion:] „Banksys Gemälde \"Mädchen mit dem Luftballon\" wechselt für 1,04 Millionen Pfund den Besitzer, da erklingt ein Piepton. Darauf rutscht das kleine Mädchen durch den Rahmen. Was unten herauskommt, ist in schmale Streifen zerschnitten.“"
                            },
                            {
                                "example_id": "ba540b30-1f99-45b8-84cb-aa8e7acaaf88",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "[Schimpfen:] „Sie lieben Wörter, die im Fernsehen immer mit einem schrillen Piepton kaschiert werden? Weiter so! Britische Forscher haben herausgefunden, dass Schimpfkanonaden Schmerzen erträglicher machen.“"
                            },
                            {
                                "example_id": "f0c06667-5196-4415-8624-bde30a753d8d",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Die Küken können schon im Ei über Pieptöne miteinander kommunizieren. Das ist der Grund, warum die Küken meist auch gleichzeitig schlüpfen, so erklären es viele Experten für Hühnerhaltung.“"
                            },
                            {
                                "example_id": "0d1def54-2f02-47a1-8814-7fc36ed7a9d3",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "„Einer der Haupt-Lärmverursacher [in den Ozeanen] sind dabei die Militärs mit ihren Sonargeräten zur U-Boot-Ortung. Diese Schallgeräte geben in kurzen Abständen einen hohen Piepton ab. Wird der Ton reflektiert, befindet sich ein Gegenstand (meist ein weiteres U-Boot) in der Nähe.“"
                            },
                            {
                                "example_id": "256df53d-2ad7-49b4-b251-679247c44009",
                                "sense_id": "fc2f5c2b-140b-3e25-9d1b-85e46d7bcfe8",
                                "text": "[Selbstfahrende Autos:] „Sogar bei einem Totalausfall warnt das Auto mit einem lauten Piepton und fordert den Fahrer auf, das Lenkrad wieder selber in die Hände zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
