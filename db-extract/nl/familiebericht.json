                        "glosses": [
                            "bericht in een krant waarin de nabestaanden het overlijden van iemand mededelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8744d22b-9d0d-4bf7-82ab-7e5ea375d51b",
                                "sense_id": "c72bb99f-8b5d-3fad-be7a-8177588f5e28",
                                "text": "U kunt rechtstreeks onder een overlijdensbericht condoleren en/of condoleances van anderen teruglezen. Als u op zoek bent naar een specifiek familiebericht kunt u zoeken op onder andere voornaam, achternaam of binnen een bepaalde tijdsperiode."
                            }
                        ]
                    },
