                                        "sense_id": "69b714a2-82bf-3251-ba0d-11381727a9c4",
                                        "entry_id": "af723943-35a5-38da-8a96-fc1b421ffd92",
                                        "glosses": [
                                            "инструмент для открывания консервных банок, металлических крышек и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f126dec-7531-44f6-a983-524f1d414be2",
                                                "sense_id": "69b714a2-82bf-3251-ba0d-11381727a9c4",
                                                "text": "― Пиво откройте кто-нибудь. ― А где открывалка?"
