                ],
                "senses": [
                    {
                        "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                        "entry_id": "df4292fd-fb8c-3fd7-9600-937217ee4034",
                        "glosses": [
                            "Aufenthalt von Soldaten, die im Krieg in die Hände ihrer Feinde geraten sind und als Kriegsgefangene behandelt werden und eingesperrt sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c046d4d-da9b-41c7-9531-efaffca748c6",
                                "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                                "text": "„Im Rettungsboot gondelte Luckner daraufhin 2300 Seemeilen durch die Südsee, bis er in neuseeländische Kriegsgefangenschaft geriet.“"
                            },
                            {
                                "example_id": "d8ab9be1-082d-4490-85b0-747ce8b0a127",
                                "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                                "text": "„Frau Fontanas erster Mann war in russische Kriegsgefangenschaft geraten und nach Sibirien gekommen, wo er einige Jahre verbrachte und dann an einer Krankheit starb.“"
                            },
                            {
                                "example_id": "ae2ac276-d679-4517-b7e6-e380363e44bf",
                                "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                                "text": "„Es ist, als stiege man in die Verliese einer Vergangenheit, deren Reize und Schrecken ich allein vom Hörensagen kenne, aus den zahllosen Erzählungen meiner Eltern und Großeltern, die von Gestellungsbefehlen und Bombennächten, Kriegsgefangenschaft und Hamsterfahrten handelten und mit der Währungsreform endeten.“"
                            },
                            {
                                "example_id": "32078389-169f-4929-8301-db607831fdbe",
                                "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                                "text": "„Mein Großvater geriet in Dänemark in Kriegsgefangenschaft und war für die Familie einige Zeit verschollen.“"
                            },
                            {
                                "example_id": "92867324-92e1-4a42-b9fe-f31ea91fcfa6",
                                "sense_id": "432489ec-884b-3963-abd6-0ef5687a7bde",
                                "text": "„Der Ehemann von Gertrud Gabriel kehrt im Januar 1946 aus der Kriegsgefangenschaft nach Hause zurück und wird kurze Zeit später durch die polnische Miliz verhaftet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
