                    {
                        "translation_id": "f555a19e-4501-4b6f-8c04-f3c674446742",
                        "source_entry_id": "9eaee514-29f3-33f7-b4af-75aab16eccf8",
                        "target_lang_word": "toolbox",
                        "target_lang_code": "en",
