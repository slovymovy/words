            {
                "entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                "word": "arsenaliser",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                        "entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                        "glosses": [
                            "Employer de manière militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7c65c49-81d2-41f4-b76e-c1f9062ee7e7",
                                "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                                "text": "Le Pentagone accuse Moscou d'avoir arsenalisé l'espace"
                            },
                            {
                                "example_id": "3d4de6f7-e3b0-4e5a-937b-6a844fa8f403",
                                "sense_id": "25cf39aa-1866-32d5-9d7d-fcf7994f2316",
                                "text": "Dans un nouveau décret, Trump cherche à arsenaliser l'espace en créant un système de défense reposant sur les technologies satellites"
                            }
                        ]
                    },
                    {
                        "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                        "entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                        "glosses": [
                            "Utiliser à la façon d’une arme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55dc0d48-3558-4aef-98ff-9a47269cdd3a",
                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                "text": "USA : comment le pays a arsenalisé l'économie mondiale"
                            },
                            {
                                "example_id": "b5f13555-242d-45ad-b7f8-be4abedd84c6",
                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                "text": "Le « fardeau » de l'homme russe : la doctrine Lavrov pour arsenaliser l'ONU."
                            },
                            {
                                "example_id": "601c1d46-74c1-4bac-a281-f5a57d7f5bb2",
                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                "text": "Arsenaliser le sport mondial : un plan quinquennal athlétique dans la Russie de Poutine."
                            },
                            {
                                "example_id": "f04171e6-b6c8-4716-8dd1-4262c83e939d",
                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                "text": "il est bien sûr impossible d’arsenaliser la totalité de la production de chaque ministère."
                            },
                            {
                                "example_id": "298e9371-4855-4eff-9cd1-3ff8ff67ed0c",
                                "sense_id": "1514414a-b47c-3804-9d2a-f0772edbe602",
                                "text": "La crainte se renforce en observant le Kremlin arsenaliser le pouvoir agricole du pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fade8d32-259a-407f-a7b9-e6916bca5228",
                        "source_entry_id": "b760eca9-be49-3926-99e2-ef84a14fc273",
                        "target_lang_word": "weaponize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weaponize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                        "entry_id": "931427ca-0465-3c86-bb43-58aa315c9e17",
                                        "glosses": [
                                            "To make into a weapon."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ae3d51-54ab-47b3-b442-854bd04fee0a",
                                                "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                                "text": "Anything can be weaponized. A big enough rock, dropped from a sufficient height, is a very good weapon."
                                            },
                                            {
                                                "example_id": "cfab5454-4116-472d-8a67-12b2f50b049a",
                                                "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                                "text": "The writer has to an unusually high degree the gift of being able to coin a telling phrase, though I do not like the verb in the sentence \"However unassailable their arguments may be they could not weaponize their strength.\""
                                            },
                                            {
                                                "example_id": "457a782e-3e15-4834-80b7-8418d4409e0e",
                                                "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                                "text": "Though most Russian efforts unveiled thus far seem to have been aimed at weaponizing the far right, the existence of BlackMattersUS indicates Russian agents were equally motivated to infiltrate the far left in order to amplify partisan divides that would simultaneously energize Trump’s base and disillusion Hillary’s."
                                            },
                                            {
                                                "example_id": "bc6ec479-b865-4623-a051-b4c3331388c2",
                                                "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                                "text": "They have weaponized social media. They have weaponized the First Amendment. They have weaponized civic discourse. And they have weaponized, most of all, politics."
                                            },
                                            {
                                                "example_id": "4f6bfbca-1f1e-4a0e-a850-0031bfc486d3",
                                                "sense_id": "199c17fe-bc7c-3423-9df5-54b19e94a943",
                                                "text": "[I]f you’re against the weaponization of the Justice Department because you think it was weaponized against you, then you don’t make the situation worse by weaponizing it against your opponents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb28703c-b293-3450-aaa2-0fa5c4556a59",
                                        "entry_id": "931427ca-0465-3c86-bb43-58aa315c9e17",
                                        "glosses": [
                                            "To make more effective as a weapon."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb84596d-6b5e-4109-b49e-375c6530f72e",
                                                "sense_id": "cb28703c-b293-3450-aaa2-0fa5c4556a59",
                                                "text": "To weaponize anthrax it is made more distributable, not more virulent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
