                "senses": [
                    {
                        "sense_id": "7c8fcf6f-e1c2-3439-8ee4-cf83f6140793",
                        "entry_id": "5b60e0b5-dba1-3385-bf07-783f81235574",
                        "glosses": [
                            "Chrysopidae Vlieg met transparante vleugels uit een familie van insecten uit de orde netvleugeligen (Neuroptera)"
                        ],
                        "tags": [
                            "netvleugeligen"
                        ],
                        "examples": [
                            {
                                "example_id": "72a92b93-dd95-450e-af61-b73d2038c84c",
                                "sense_id": "7c8fcf6f-e1c2-3439-8ee4-cf83f6140793",
                                "text": "Zo voeden de sluipwesp en de gaasvlieg zich met de eitjes van de eikenprocessierups. Bermen met meer wilde bloemen trekken meer insecten, die zich ook op de eikenprocessierups kunnen storten. En met het ophangen van broedkastjes worden meer koolmezen gelokt. Zij voeren de rupsen in het broedseizoen aan hun jongen."
                            },
                            {
                                "example_id": "186703d1-e86b-4c42-9ac9-8b3f4810375d",
                                "sense_id": "7c8fcf6f-e1c2-3439-8ee4-cf83f6140793",
                                "text": "De natuur draagt overigens ook bij aan de bestrijding, meldt Natuurbericht. Diverse vogelsoorten doen zich tegoed aan de wantsen en ook de larven van de gaasvlieg profiteren van de overvloed aan voedsel."
                            }
                        ]
                    }
