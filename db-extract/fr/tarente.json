                ],
                "senses": [
                    {
                        "sense_id": "438fac96-039b-32e7-8455-7e74bbb476c8",
                        "entry_id": "08176fca-5cbc-36fd-8101-a7a0348e74b1",
                        "glosses": [
                            "Gecko, lézards de taille moyenne, de la famille des phyllodactylidés, mimétiques le jour, pouvant se déplacer vite, même sur des murs ou des plafonds."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e4e3af9-aef2-4d5a-9370-306afcdb3bff",
                                "sense_id": "438fac96-039b-32e7-8455-7e74bbb476c8",
                                "text": "Tarentule est aussi le nom qu'on donne à un petit lézard qu'on appelle en Provence, Tarente."
                            },
                            {
                                "example_id": "1188695a-2f98-4ddd-9cf4-a5a35d44dba4",
                                "sense_id": "438fac96-039b-32e7-8455-7e74bbb476c8",
                                "text": "Parfois une tarente, sorte de petit lézard, grimpait au mur et s'immobilisait, comme en embuscade, en quête d'insectes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c00f8d3-0884-477b-814f-ad11aa2b6c9f",
                        "source_entry_id": "08176fca-5cbc-36fd-8101-a7a0348e74b1",
                        "source_sense_id": "438fac96-039b-32e7-8455-7e74bbb476c8",
                        "target_lang_word": "Mauergecko",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mauergecko",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a1a3fa1-6300-35fb-a285-e8cc87450b22",
                                        "entry_id": "7ffc9373-b702-3f6d-96af-dcbec1cdd236",
                                        "glosses": [
                                            "im Mittelmeerraum großflächig verbreiteter, nachtaktiver Gecko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3053312b-ed7a-49e3-a46f-13c1ecc32734",
                                                "sense_id": "7a1a3fa1-6300-35fb-a285-e8cc87450b22",
                                                "text": "„Was ich ihm gerade erzählt habe, scheint ihn weder zu überraschen noch zu beunruhigen. Oder besonders zu interessieren. Ich hätte ihm ebenso gut berichten können, ich hätte auf dem Weg zur Arbeit einen Mauergecko gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
