                        "glosses": [
                            "Que l’on ne peut pas allumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ab5837-ce88-442b-a52e-93101ff9839a",
                                "sense_id": "c6914613-4c92-3cb4-a1a0-ef1f81848686",
                                "text": "Je veux faire du feu : mon bois inallumable\nSue ironiquement sur les grands chenets froids"
                            },
                            {
                                "example_id": "151a1902-c294-4feb-afcf-5d05eb6e7ca4",
                                "sense_id": "c6914613-4c92-3cb4-a1a0-ef1f81848686",
                                "text": "À trente-quatre ans, une cigarette inallumable dans les mains, tu es vautré sur un lit, un simple matelas posé sur le plancher, tu loues cet appartement avec l’argent de ton travail et tu trembles d’un silence au téléphone à deux heures …."
                            },
                            {
                                "example_id": "69ec839c-aef0-42ad-a2dc-26f454c029dc",
                                "sense_id": "c6914613-4c92-3cb4-a1a0-ef1f81848686",
                                "text": "Mauvais souvenir de briquet inallumable sous la pluie. Mais c’est idiot puisque je ne peux pas allumer le réchaud sous la pluie."
                            }
                        ]
                    }
