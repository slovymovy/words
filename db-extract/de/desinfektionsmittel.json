                ],
                "senses": [
                    {
                        "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                        "entry_id": "96b677c8-0acf-3c4e-983a-9d787b960493",
                        "glosses": [
                            "keimtötendes Mittel, das zur äußeren Anwendung gedacht ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5153e8-0138-4b0b-9ad7-a7eff679c410",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "Die öffentlichen Toiletten werden zweimal am Tag mit Desinfektionsmittel gereinigt."
                            },
                            {
                                "example_id": "5f9368b4-711d-43dc-b992-b876bba0fdfe",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "Die Schwester reinigte sich die Hände mit einem Desinfektionsmittel, bevor sie den Verband des Patienten wechselte."
                            },
                            {
                                "example_id": "437e100f-6b12-464c-9bc0-10f86e96c906",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "„Er tunkte ein paar Wattebäusche in Desinfektionsmittel und reinigte und verband die Wunden dann mit einer Zartheit, die ihm weder Val noch Bobby zugetraut hatten.“"
                            },
                            {
                                "example_id": "c4ac4892-5049-4691-8c8f-ef8575857345",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "„Eine Platte spielte Orgelmusik, und die künstliche Luft roch nach Kerzen und einem Desinfektionsmittel.“"
                            },
                            {
                                "example_id": "caa039bc-a1e4-42d8-aa3c-6a4daa56dccc",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "„Ich hatte keinerlei Desinfektionsmittel, lebte im Schmutz, es konnte eine Blutvergiftung entstehen.“"
                            },
                            {
                                "example_id": "63751837-9ee7-4516-a4fe-ca88d5327b39",
                                "sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                                "text": "„Die sonst so helle und luftige Wohnung war stickig und roch penetrant nach Körperausdünstungen und Desinfektionsmitteln, obwohl alle Fenster weit offen standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75d9eb9b-5099-43d7-869c-4709d44aaf5f",
                        "source_entry_id": "96b677c8-0acf-3c4e-983a-9d787b960493",
                        "source_sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                        "source_sense_description": "keimtötendes Mittel, das zur äußeren Anwendung gedacht ist",
                        "target_lang_word": "disinfectant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disinfectant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5be0fab1-ffef-31f0-b496-f4791c2f1dae",
                                        "entry_id": "dce4f932-44e6-3827-be71-cf88c7add587",
                                        "glosses": [
                                            "Serving to kill germs or viruses."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a32fba-cf99-4e5e-8182-7abbcc59b247",
                                                "sense_id": "5be0fab1-ffef-31f0-b496-f4791c2f1dae",
                                                "text": "I washed repeatedly with a disinfectant soap but I still caught the flu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disinfectant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8298d38-05c7-3a24-9885-69e57e693c2a",
                                        "entry_id": "edb8286d-3103-3039-8255-d7f20cdedb30",
                                        "glosses": [
                                            "A substance that kills germs or viruses."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67f77eed-8065-48fb-aa08-c034140e8554",
                                                "sense_id": "c8298d38-05c7-3a24-9885-69e57e693c2a",
                                                "text": "The scalpels were soaked in disinfectant before the operation so disease wouldn't be spread."
                                            },
                                            {
                                                "example_id": "3eb436da-a366-4753-9efb-4ea78ddc1a82",
                                                "sense_id": "c8298d38-05c7-3a24-9885-69e57e693c2a",
                                                "text": "\"Using the correct disinfectant is an important part of preventing and reducing the spread of illnesses along with other critical aspects such as hand washing,\" EPA Administrator Andrew Wheeler said in a statement."
                                            },
                                            {
                                                "example_id": "6c8b72fa-26df-49b7-af38-9dc025261fd0",
                                                "sense_id": "c8298d38-05c7-3a24-9885-69e57e693c2a",
                                                "text": "Whether boarding an airplane with underwear on your face to protest mask requirements, injecting yourself with horse dewormer instead of a safe and effective vaccine or swallowing household disinfectants because the President of the United States unironically suggested that it might help, the pandemic has amplified the frequency and tenor of ridiculous and sometimes alarming behavior."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "793e413b-484e-4e59-a56e-5caa26570300",
                        "source_entry_id": "96b677c8-0acf-3c4e-983a-9d787b960493",
                        "source_sense_id": "28bbc240-761c-340c-b854-94f645b0a3e8",
                        "source_sense_description": "keimtötendes Mittel, das zur äußeren Anwendung gedacht ist",
                        "target_lang_word": "désinfectant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désinfectant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d425365-06fc-3277-adae-25e7d8dca049",
                                        "entry_id": "cda8144b-9daf-3895-bca5-97c6747de1b6",
                                        "glosses": [
                                            "Qui sert à désinfecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d12b20-667e-4b89-8e62-d553fece7484",
                                                "sense_id": "4d425365-06fc-3277-adae-25e7d8dca049",
                                                "text": "Offrir cinq cents flacons de vinaigre des quatre-voleurs comme produit désinfectant au bureau de bienfaisance du XIᵉ arrondissement, c’est un acte généreux ; faire savoir qu’il provient de la maison Maille, Robillard, Segond et Cie, cela devient de la réclame […]"
                                            },
                                            {
                                                "example_id": "201c9eb4-e4bb-4427-ad49-41e81326b3e5",
                                                "sense_id": "4d425365-06fc-3277-adae-25e7d8dca049",
                                                "text": "Outre ses effets désinfectants sur les nématodes et diverses maladies transmises par le sol en maraîchage, la solarisation a un effet de destruction des graines d’herbes situées près de la surface, les plus dangereuses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "désinfectant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b978456-056a-3162-87a5-f3518fdfdd02",
                                        "entry_id": "d69f0657-0482-3582-b75a-44140a9f2723",
                                        "glosses": [
                                            "Substance qui sert à désinfecter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6a8d8be-8909-4d82-ad7e-ed47dc28a788",
                                                "sense_id": "6b978456-056a-3162-87a5-f3518fdfdd02",
                                                "text": "Celui-ci, au contact des acides même les plus faibles, dégage de l’acide hypochloreux qui est un décolorant et un désinfectant énergique."
                                            },
                                            {
                                                "example_id": "d3e82600-5f9e-4b4d-8f42-6b232ee2658f",
                                                "sense_id": "6b978456-056a-3162-87a5-f3518fdfdd02",
                                                "text": "Des odeurs de désinfectant se mêlent aux arômes d’encens dans les rues de Phuket, en Thaïlande, pour le début du festival végétarien, connu pour son défilé d’adeptes aux joues et lèvres percées de couteaux, aiguilles et autres sabres."
                                            },
                                            {
                                                "example_id": "b7137334-267e-40bd-b53c-4a8bebea12fe",
                                                "sense_id": "6b978456-056a-3162-87a5-f3518fdfdd02",
                                                "text": "Les désinfectants sont des substances chimiques qui tuent les micro-organismes dont les pathogènes ou bloquent leur multiplication. Beaucoup de produits différents existent sur le marché pour des usages divers […] Les instructions du fabricant doivent être lues attentivement et scrupuleusement suivies […]"
                                            },
                                            {
                                                "example_id": "81c60ab8-c247-46f9-aeda-9ac515237c8d",
