        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "01ed7c0c-5bca-38dd-99e4-288a87e12eba",
                    "sense_definition": "Текущий день, эти сутки (как предмет обсуждения)",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "literal_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Не стоит жить одним <w>сегодня</w>, нужно думать и о будущем.",
                            "target_lang_translations": {
                                "en": "One shouldn't live just for <w>today</w>; one needs to think about the future as well.",
                                "zh": "不应该只活在<w>今天</w>，也需要考虑未来。",
                                "de": "Man sollte nicht nur für das <w>Heute</w> leben, man muss auch an die Zukunft denken."
                            }
                        },
                        {
                            "text": "Твоё <w>сегодня</w> зависит от решений, принятых вчера.",
                            "target_lang_translations": {
                                "en": "Your <w>today</w> depends on decisions made yesterday.",
                                "zh": "你的<w>今天</w>取决于昨天所做的决定。",
                                "de": "Dein <w>Heute</w> hängt von den Entscheidungen ab, die gestern getroffen wurden."
                            }
                        }
                    ],
                    "antonyms": [
                        "вчера",
                        "завтра"
                    ],
                    "common_phrases": [
                        "жить сегодня"
                    ],
                    "target_lang_definitions": {
                        "en": "The current day (as a noun)",
                        "zh": "当前这一天（作为名词）",
                        "de": "Der aktuelle Tag (als Substantiv)"
                    },
