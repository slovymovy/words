                        "glosses": [
                            "A spherical gram-positive parasitic bacterium of the genus Staphylococcus, causing blisters, septicemia, and other infections."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3300ebcf-c351-4bbd-9128-90111cfd2f0e",
                                "sense_id": "60d6455d-1aa1-3680-948d-c95cde95bac2",
                                "text": "This Scottish bacteriologist accidentally discovered the antibiotic penicillin after bacteria-killing fungus formed on staphylococci cultures he had left unattended."
                            }
                        ]
                    }
