                ],
                "senses": [
                    {
                        "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                        "entry_id": "ea2b05d2-3ecf-3dbf-8ab8-14457e9aeb55",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3234933-8164-45b9-85bc-ad80d921daed",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Frau Stechele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dba61d40-69f1-48b0-b7c5-bebe0fd69a68",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Herr Stechele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "81c1114e-71bf-4cba-ba23-f1fcf76e87ff",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Die Stecheles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "8119c8d4-1752-43ad-ae0a-fc5aca592fbb",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Der Stechele trägt nie die Pullover, die die Stechele ihm strickt."
                            },
                            {
                                "example_id": "6f7ec4bc-12e2-41be-9d9d-6170e7fd8d24",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stechele kommt, geht der Herr Stechele.“"
                            },
                            {
                                "example_id": "08e6dd74-46a4-4317-8b6b-dbbe0674b4c4",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Stechele kommt und geht."
                            },
                            {
                                "example_id": "4c2b2748-2bb8-4e14-9871-41adfa4f1f6e",
                                "sense_id": "075607b7-f268-341e-b511-577deb5b44a0",
                                "text": "Stecheles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
