                                        "glosses": [
                                            "A figure whose birth is prophesied in the Book of Isaiah in the Bible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43087e6d-15fc-4010-8074-a1c3e32ca0af",
                                                "sense_id": "991188cc-fef2-3d30-a629-3c52a5c904f5",
                                                "text": "Behold, a virgin shall conceive, and bear a son, and shall call his name Immanuel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9834997b-c3c5-3395-849e-1fd0b0b054c7",
