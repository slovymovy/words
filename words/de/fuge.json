                    "frequency": "Middle",
                    "semantic_group_id": "spalt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch die undichte <w>Fuge</w> zwischen den Fliesen drang über Monate hinweg Feuchtigkeit ein."
                        },
                        {
                            "text": "Vor dem Winter müssen wir jede offene <w>Fuge</w> im Mauerwerk sorgfältig mit Mörtel füllen."
                        }
                    ],
                    "synonyms": [
                        "Spalt",
                        "Ritze"
                    ],
                    "common_phrases": [
