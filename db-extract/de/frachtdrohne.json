                "senses": [
                    {
                        "sense_id": "09a430f5-5c53-3a8f-a808-1805cd6d8ce7",
                        "entry_id": "7e22f816-2c9c-3dcc-ad13-6eba6937cb40",
                        "glosses": [
                            "Drohne, die für den Transport von Waren verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b43b419-e0c0-4f00-8043-86a72893953a",
                                "sense_id": "09a430f5-5c53-3a8f-a808-1805cd6d8ce7",
                                "text": "„Parallel arbeitet das Unternehmen an einer Frachtdrohne sowie an verschiedenen Projekten für eine Flugtaxi-Infrastruktur.“"
                            },
                            {
                                "example_id": "a6842451-718a-4040-b575-7806afa7b109",
                                "sense_id": "09a430f5-5c53-3a8f-a808-1805cd6d8ce7",
                                "text": "„Erst sollten sie mit Futter angelockt und dann Netze über sie geworfen werden, um sie mit einer Frachtdrohne zu bergen.“"
                            },
                            {
                                "example_id": "eba205f1-e914-4027-bc4e-1af565b2a918",
                                "sense_id": "09a430f5-5c53-3a8f-a808-1805cd6d8ce7",
                                "text": "„Er entwickelt eine Frachtdrohne, die direkt am Balkon oder unter einem Fenster landen kann.“"
                            },
                            {
                                "example_id": "efd314a4-cdb4-4750-a92d-a6328b3d4bb2",
                                "sense_id": "09a430f5-5c53-3a8f-a808-1805cd6d8ce7",
                                "text": "„Am Dienstag absolvierte eine Frachtdrohne mit zehn Metern Durchmesser ihren öffentlichen Erstflug über dem Hafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
