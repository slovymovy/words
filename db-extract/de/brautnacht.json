                "senses": [
                    {
                        "sense_id": "2934eee0-1689-38c7-a29d-9da0a80dbf1c",
                        "entry_id": "a219cc36-88fb-3c1e-8bad-ca7aadd6e462",
                        "glosses": [
                            "erste gemeinsame Nacht eines Paares nach seiner Hochzeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b68cf1ab-937d-405e-982f-53535752410b",
                                "sense_id": "2934eee0-1689-38c7-a29d-9da0a80dbf1c",
                                "text": "„Zugegeben, Edelduft war eine unvergleichliche Schönheit, aber zum Leidwesen ihres Partners versagte sie im ›Wind- und Mondspiel‹ gänzlich, und so blieben die Erwartungen, die er auf die Freuden der Brautnacht gesetzt hatte, zu gut sieben Zehntel unerfüllt.“"
                            },
                            {
                                "example_id": "093f1917-5eaf-47c1-af76-0d4116184b88",
                                "sense_id": "2934eee0-1689-38c7-a29d-9da0a80dbf1c",
                                "text": "„Dieser fünfstündige Besuch am Tage nach der Brautnacht ließ mich ekennen, daß ich in die Q. richtig verliebt war, und überzeugte auch sie, daß ich ihre Zuneigung verdiente.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
