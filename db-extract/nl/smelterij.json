                    {
                        "sense_id": "d5c00393-4a9d-349e-8796-262d83696f15",
                        "entry_id": "9ac7e9f4-5d93-3c46-b7f7-dc8bb0572b13",
                        "glosses": [
                            "bedrijf waar men een vaste stof door verhitting vloeibaar maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7799f9cd-96a5-431d-8d88-7631e15a8187",
                                "sense_id": "d5c00393-4a9d-349e-8796-262d83696f15",
                                "text": "De smelterij wordt ontwikkeld in samenwerking met Al Braik Investments. Er wordt momenteel nog een haalbaarheidsstudie uitgevoerd. De definitieve investeringsbeslissing zal medio volgend jaar worden genomen. Er werden geen financiële details gemeld."
                            },
                            {
                                "example_id": "1174f468-311e-44c2-a174-d1af9ee80c4f",
                                "sense_id": "d5c00393-4a9d-349e-8796-262d83696f15",
                                "text": "Het pakket van Antwerpen heeft na jaren van verzamelen van feiten besloten de keten van Tony Goetz en de smelterij te vervolgen. Volgens De Tijd zouden tientallen mensen onder verdenking staan zwart geld te hebben witgewassen via de goudhandel."
                            },
                            {
                                "example_id": "f7baa370-1f53-40b9-823d-a8ffe8cfc1a7",
                                "sense_id": "d5c00393-4a9d-349e-8796-262d83696f15",
                                "text": "De herwonnen metalen en koper gaan naar Nederlandse smelterijen, van het kunststof willen de ondernemers uiteindelijk, met partners, tasjes en flessen maken."
                            }
                        ]
                    }
                ],
