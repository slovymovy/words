                ],
                "senses": [
                    {
                        "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                        "entry_id": "6e8fec44-cb12-3a8c-8261-c891b4e020ca",
                        "glosses": [
                            "Vorgang, jemanden zu beruhigen oder zu beschwichtigen, insbesondere wenn diese Person verärgert, wütend oder aufgeregt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8359a55-e19f-43c6-a559-8d7aa865ce7a",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "Die Besänftigung der aufgebrachten Menge gelang nur durch das Versprechen auf Veränderungen."
                            },
                            {
                                "example_id": "ab6bd3b0-b2ba-4bc5-a437-7e44e7c2ed9b",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "Smoker dienen der Besänftigung von Bienen."
                            },
                            {
                                "example_id": "8933e941-1f21-4730-b16c-1784eb32f9d6",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "„Zur Besänftigung lädt er die Götter in sein Haus zum Mahl ein, welche allesamt kommen.“"
                            },
                            {
                                "example_id": "dd0948c2-bd17-43d3-8ac9-bba7c4664533",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "„Aberglaube, Hexerei und das Opfern junger Frauen zur Besänftigung der Geister im Falle von Katastrophen waren in Arabien sehr weit verbreitet.“"
                            },
                            {
                                "example_id": "f0424039-0654-4bc3-a5e1-f5e94d96fd0e",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "„Folglich müssen die Vorfahren verehrt werden: Gebete und Opfer zu ihren Ehren oder zur Besänftigung sind üblich, ebenso wie die Einhaltung der örtlichen Fady (Tabus).“"
                            },
                            {
                                "example_id": "7ebe67bc-91e2-4844-8473-cd6123ef8fea",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "Wiedergutmachungsgeschenke eines von schlechtem Gewissen geplagten Ehemanns an seine Ehefrau sind Mitbringsel vom Blumenstrauß bis zum Brillantring, die ausschließlich der Besänftigung der Gattin und der Ablenkung von Versäumnissen dienen."
                            },
                            {
                                "example_id": "8bd21483-bb15-4e3b-9ab9-cee156073571",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "[Olympischen Spiele 1936 in Berlin:] „Die Gleichschaltung der Presse wurde intensiviert und zur Besänftigung ausländischer Kritik zwei jüdische SportlerInnen [sic!] zugelassen.“"
                            },
                            {
                                "example_id": "8e1ba9a0-49ee-41af-97f1-9faa9a8a0d69",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "[DDR: Die Energiekosten waren] „für die Bevölkerung, wie viele Produkte des täglichen Bedarfs, im Sinne der Sozialpolitik der kommunistischen Ideologie und zur Besänftigung der Menschen immer stark subventioniert gewesen.“"
                            },
                            {
                                "example_id": "dadacd09-f256-4cb7-bf2f-45cffd8b5893",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "[Soziale Medien:] „Meta hat sein „Journalism Programm“ zur Förderung des Journalismus, das offenbar vorrangig zur Besänftigung journalistischer Medien eingeführt worden war, im Rahmen von Kosteneinsparungen Ende 2022 abrupt beendet.“"
                            },
                            {
                                "example_id": "7669593c-20e9-4930-8bc9-b9b7fcec28c5",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "„Dass ein Premierminister vom Präsidenten zur Besänftigung des Volkszorns geopfert wird, das hat in Frankreich eine lange Tradition.“"
                            },
                            {
                                "example_id": "8d577b97-063b-4ceb-809b-1bd617aa1dc5",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "[November 2023: Brüssel hat] „sich am Mittwoch für Georgien als Beitrittskandidat ausgesprochen hat. Doch eine EU-Mitgliedschaft wird nicht automatisch Frieden im Osten mit sich bringen und auch keine Besänftigung der Beziehungen mit dem Nachbarn Russland.“"
                            },
                            {
                                "example_id": "e93cf9af-6c00-4e85-8cae-249585c8512c",
                                "sense_id": "85c961eb-0e05-32e6-8ab7-974263df97f4",
                                "text": "„Mal ganz konkret: Wenn Protestierende auf den Straßen wüten, Pegida-Anhänger marschieren, Rechtspopulisten die Parlamente stürmen, dann treten regelmäßig Politikerinnen und Politiker auf den Plan und fordern, man müsse „die Sorgen und Nöte der Menschen ernst nehmen“, man müsse „das Gespräch auf Augenhöhe“ suchen, man müsse „wirklich zuhören“ und endlich „miteinander reden.“ Das Problem: Menschen sind Expertinnen und Experten bei der Entlarvung von Heuchelei. Sie spüren mit sehr feinen Antennen, wenn das Gesprächsangebot nur als pseudotherapeutische Beschwichtigungsfloskel zur Konfliktvermeidung und Trick zur raschen Besänftigung taugen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
