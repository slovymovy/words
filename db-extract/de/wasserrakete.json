                "senses": [
                    {
                        "sense_id": "318e7bda-0051-343a-b863-f3237ee54cd5",
                        "entry_id": "96254c7b-0eec-3112-a329-5fc94ec83a9e",
                        "glosses": [
                            "Rakete, deren Antrieb durch das Ausstoßen eines unter Druck stehenden Wasserstrahls erfolgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d56afdb-88b6-4638-a9aa-25f16f0ded1e",
                                "sense_id": "318e7bda-0051-343a-b863-f3237ee54cd5",
                                "text": "„Bis zu 80 km/h war die Wasserrakete der Klasse 10d schnell, ehe sie sanft per Fallschirm zu Boden segelte.“"
                            },
                            {
                                "example_id": "947571c9-be06-44d6-9eaf-059c0235f4a3",
                                "sense_id": "318e7bda-0051-343a-b863-f3237ee54cd5",
                                "text": "„Thomas Pauels aus der 9a des Goethe-Gymnasiums und sein Konstrukteur-Kollege Jan Aaron aus der 7c sind sicher, dass ihre Wasserrakete abhebt und 25 bis 30 Meter hoch fliegt.“"
                            },
                            {
                                "example_id": "bbcb1a6d-c581-472f-8381-c73e0a8bcbdc",
                                "sense_id": "318e7bda-0051-343a-b863-f3237ee54cd5",
                                "text": "„Der Bau von Wasserraketen wird nach und nach zu einem wahren Volkssport. Mit handelsüblichen PET-Flaschen bauen Hobby-Raketenwissenschaftler die unglaublichsten Flugobjekte und alle haben eins gemein: sie werden nur mit Wasser und Luft betrieben!“"
                            },
                            {
                                "example_id": "23b2276f-8b6a-45ac-a716-f14cb2189bdf",
                                "sense_id": "318e7bda-0051-343a-b863-f3237ee54cd5",
                                "text": "„Das Prinzip, nach dem die Wasserrakete funktioniert, ist genau dasselbe wie bei einem Raketenantrieb in der Luft-Raumfahrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
