{
    "word_family": [
        "hot-rod",
        "rod-like",
        "ramrod",
        "fishing-rod"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "139abfce-37f9-3f9b-b7ef-ac70f28c55a4",
                    "sense_definition": "A straight, round stick, shaft, bar, cane, or staff.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The circus strong man proved his strength by bending an iron <w>rod</w> and then straightening it.",
                            "target_lang_translations": {
                                "ru": "Цирковой силач доказал свою силу, согнув железный <w>прут</w>, а затем выпрямив его."
                            }
                        },
                        {
                            "text": "The construction workers used a long metal <w>rod</w> to reinforce the structure.",
                            "target_lang_translations": {
                                "ru": "Строители использовали длинный металлический <w>стержень</w> для укрепления конструкции."
                            }
                        }
                    ],
                    "synonyms": [
                        "skyfish"
                    ],
                    "common_phrases": [
                        "iron rod",
                        "metal rod",
                        "steel rod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямой круглый стержень, палка, брусок или посох."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стержень",
                                "target_lang_sense_clarification": "металлический или графитовый"
                            },
                            {
                                "target_lang_word": "прут",
                                "target_lang_sense_clarification": "тонкий металлический или деревянный"
                            },
                            {
                                "target_lang_word": "палка",
                                "target_lang_sense_clarification": "деревянная или универсальная"
                            },
                            {
                                "target_lang_word": "штанга",
                                "target_lang_sense_clarification": "длинный металлический стержень"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "680a8bf4-535d-32f2-9a37-098868665cb8",
                    "sense_definition": "A long slender usually tapering pole used for angling; a fishing rod.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When I hooked a snake and not a fish, I got so scared I dropped my <w>rod</w> in the water.",
                            "target_lang_translations": {
                                "ru": "Когда я поймал на крючок змею вместо рыбы, я так испугался, что уронил <w>удочку</w> в воду."
                            }
                        },
                        {
                            "text": "He spent the whole afternoon by the lake with his favorite <w>fishing</w> <w>rod</w>.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день у озера со своей любимой <w>удочкой</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fishing rod",
                        "fly rod",
                        "casting rod"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный тонкий шест, используемый для рыбной ловли; удочка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удочка",
                                "target_lang_sense_clarification": "рыболовная снасть"
                            },
                            {
                                "target_lang_word": "удилище",
                                "target_lang_sense_clarification": "основная часть удочки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34b309fe-e293-3b2c-a3d6-ca41e4dfeaad",
                    "sense_definition": "A straight bar that unites moving parts of a machine, for holding parts together or for transferring power.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine threw a <w>rod</w> and then went to pieces before our eyes.",
                            "target_lang_translations": {
                                "ru": "Двигатель выбил <w>шатун</w> и развалился на части прямо у нас на глазах."
                            }
                        },
                        {
                            "text": "A broken connecting <w>rod</w> can cause significant damage to the vehicle's motor.",
                            "target_lang_translations": {
                                "ru": "Сломанный <w>шатун</w> может нанести серьезный ущерб двигателю автомобиля."
                            }
                        }
                    ],
                    "common_phrases": [
                        "connecting rod",
                        "piston rod",
                        "steering rod"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямой стержень, соединяющий движущиеся части машины для передачи энергии или удержания деталей вместе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шатун",
                                "target_lang_sense_clarification": "в двигателе"
                            },
                            {
                                "target_lang_word": "шток",
                                "target_lang_sense_clarification": "соединительный стержень"
                            },
                            {
                                "target_lang_word": "тяга",
                                "target_lang_sense_clarification": "передающая усилие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07a2b98f-a36f-3367-942f-5f0954d781c0",
                    "sense_definition": "A rod cell: a rod-shaped cell in the eye that is sensitive to light.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rods</w> are more sensitive than the cones but do not discern color.",
                            "target_lang_translations": {
                                "ru": "<w>Палочки</w> более чувствительны, чем колбочки, но не различают цвета."
                            }
                        },
                        {
                            "text": "Night vision depends largely on the function of the <w>rods</w> in the retina.",
                            "target_lang_translations": {
                                "ru": "Ночное зрение во многом зависит от работы <w>палочек</w> в сетчатке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rods and cones",
                        "retinal rods"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Палочка: светочувствительная клетка в сетчатке глаза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палочка",
                                "target_lang_sense_clarification": "рецептор сетчатки глаза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d95973c9-7385-3d8a-af3a-db9b7b315bba",
                    "sense_definition": "A unit of length equal to 5.5 yards or 16.5 feet.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thicket was in the immediate vicinity, within a few <w>rods</w> of the dwelling.",
                            "target_lang_translations": {
                                "ru": "Заросли находились в непосредственной близости, в нескольких <w>родах</w> от жилища."
                            }
                        },
                        {
                            "text": "The valley is forty to sixty <w>rods</w> wide at its narrowest point.",
                            "target_lang_translations": {
                                "ru": "Ширина долины в самом узком месте составляет от сорока до шестидесяти <w>родов</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "square rod"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "traditional unit of measurement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица длины, равная 5,5 ярдам или 16,5 футам (около 5 метров)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "род",
                                "target_lang_sense_clarification": "английская мера длины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73ce4694-d84b-339d-81a0-bf61c56a1b84",
                    "sense_definition": "A pistol or a gun.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weapons",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "One of them strode to his side and reported that the suspect had no <w>rod</w> on him.",
                            "target_lang_translations": {
                                "ru": "Один из них подошел к нему и доложил, что у подозреваемого при себе нет <w>ствола</w>."
                            }
                        },
                        {
                            "text": "The gangster reached for his <w>rod</w> when he saw the police approaching.",
                            "target_lang_translations": {
                                "ru": "Гангстер потянулся за своей <w>пушкой</w>, когда увидел приближающуюся полицию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "old-fashioned criminal slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пистолет или огнестрельное оружие (на сленге)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "сленг для пистолета"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "сленг для оружия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25749fc0-5d2b-3820-bd5b-804ed119370a",
                    "sense_definition": "The penis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explicit novel described the character's <w>rod</w> in graphic detail.",
                            "target_lang_translations": {
                                "ru": "В откровенном романе мужское <w>достоинство</w> персонажа описывалось во всех подробностях."
                            }
                        },
                        {
                            "text": "He used a vulgar term for his <w>rod</w> during the argument.",
                            "target_lang_translations": {
                                "ru": "Во время спора он использовал вульгарный термин для своего <w>члена</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужской половой орган (вульгарно)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палка",
                                "target_lang_sense_clarification": "вульгарный эвфемизм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2134b770-6459-39a8-ba52-06c204f94a0d",
                    "sense_definition": "A nickname for the male given names <w>Rodney</w> and <w>Roderick</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "President Donald Trump on Monday pardoned former Illinois Gov. <w>Rod</w> Blagojevich.",
                            "target_lang_translations": {
                                "ru": "Президент Дональд Трамп в понедельник помиловал бывшего губернатора Иллинойса <w>Рода</w> Благоевича."
                            }
                        },
                        {
                            "text": "Everyone in the office calls him <w>Rod</w> instead of his full name, Rodney.",
                            "target_lang_translations": {
                                "ru": "Все в офисе зовут его <w>Род</w> вместо полного имени Родни."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшительная форма мужских имен Родни и Родерик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Род",
                                "target_lang_sense_clarification": "имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c0c9cb-ed10-3341-8d43-d48b134aa7a1",
                    "sense_definition": "The god of the family, ancestors, and fate in Slavic mythology.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "deity_or_religious_name",
                    "examples": [
                        {
                            "text": "In ancient Slavic beliefs, <w>Rod</w> was considered the creator of all life.",
                            "target_lang_translations": {
                                "ru": "В древнеславянских верованиях <w>Род</w> считался творцом всей жизни."
                            }
                        },
                        {
                            "text": "Scholars debate the exact role of <w>Rod</w> in the hierarchy of Slavic gods.",
                            "target_lang_translations": {
                                "ru": "Ученые спорят о точной роли <w>Рода</w> в иерархии славянских богов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бог семьи, предков и судьбы в славянской мифологии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Род",
                                "target_lang_sense_clarification": "славянское божество"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "68c2fc8a-3278-311b-899d-8248e9e4e2a8",
                    "sense_definition": "To reinforce concrete with metal rods.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers decided to <w>rod</w> the foundation to ensure it could support the weight.",
                            "target_lang_translations": {
                                "ru": "Инженеры решили <w>армировать</w> фундамент, чтобы он мог выдержать вес."
                            }
                        },
                        {
                            "text": "They are <w>rodding</w> the concrete pillars to prevent them from cracking under pressure.",
                            "target_lang_translations": {
                                "ru": "Они <w>армируют</w> бетонные колонны, чтобы предотвратить их растрескивание под давлением."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять бетон металлическими стержнями (армировать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "армировать",
                                "target_lang_sense_clarification": "бетон стержнями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90f7282b-0c8e-3c01-b05a-db8882a7bf0b",
                    "sense_definition": "To drive or modify a hot rod.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "driving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There were several teenagers <w>rodding</w> in and out of the parking lot with their girlfriends.",
                            "target_lang_translations": {
                                "ru": "Несколько подростков <w>гоняли</w> на парковку и обратно со своими подружками."
                            }
                        },
                        {
                            "text": "He spent his weekends <w>rodding</w> around the small town in his modified car.",
                            "target_lang_translations": {
                                "ru": "Он проводил выходные, <w>раскатывая</w> по маленькому городку на своей модифицированной машине."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водить или модифицировать хот-род (гоночный автомобиль)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гонять",
                                "target_lang_sense_clarification": "на хот-роде"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}