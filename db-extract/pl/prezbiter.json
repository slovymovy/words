                                    {
                                        "sense_id": "da389461-ca82-3cdf-b568-e3a8c9940153",
                                        "entry_id": "66fb879c-c2ce-3f5a-8cb6-f4bb799c171d",
                                        "glosses": [
                                            "vůdčí funkcionář církve (chápání a užívání se mezi různými denominacemi značně liší)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed59f8bc-e2a0-4149-8b9c-4bbd794d921a",
                                                "sense_id": "da389461-ca82-3cdf-b568-e3a8c9940153",
                                                "text": "Spravovalli nově zvolený presbyter již dříve úřad tento, dosti jest, když se ohlásí, že znovu do presbyterium vstupuje."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed054cac-f9f7-49b3-a0bb-38fc3aa3233a",
                        "source_entry_id": "d83fb57d-e871-3626-a639-a0a50851a07d",
                        "source_sense_id": "f81231b2-02d1-3685-a38f-c3ab2225c11d",
                        "target_lang_word": "presbytre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presbytre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9868699-3534-3e1c-8b07-f1d8ee19a7dc",
                                        "entry_id": "b25080eb-a3e4-3534-ab2b-ac58ded6d087",
                                        "glosses": [
                                            "Vieil homme, responsable des premières communautés chrétiennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d692dfc-1f2d-47f7-9402-af7a1f377ae3",
                                                "sense_id": "e9868699-3534-3e1c-8b07-f1d8ee19a7dc",
                                                "text": "Le rôle des presbytres est moins clair que celui de l'épiscope, avec lequel il se confond souvent, qui désignera quant à lui progressivement le pasteur principal des communautés."
                                            },
                                            {
                                                "example_id": "46583e9b-4274-4e85-a341-cefc69a9786f",
                                                "sense_id": "e9868699-3534-3e1c-8b07-f1d8ee19a7dc",
                                                "text": "Le mot \"prêtre\" ne vient pas du mot grec désignant le préposé à la religion, le hiéreus, mais d'un mot profane, presbutéros, qui signifie le presbytre, l'ancien d'une communauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "079751f1-348f-490d-b594-740236d33081",
                        "source_entry_id": "d83fb57d-e871-3626-a639-a0a50851a07d",
                        "source_sense_id": "f81231b2-02d1-3685-a38f-c3ab2225c11d",
