                "senses": [
                    {
                        "sense_id": "e3618a9b-34c6-375f-a073-1182ddebb83b",
                        "entry_id": "14304ef8-9f2d-3e55-af2a-ff0b61f3e28f",
                        "glosses": [
                            "In a humane manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2116cdf6-e199-48ec-a65c-913ce3e3e028",
                                "sense_id": "e3618a9b-34c6-375f-a073-1182ddebb83b",
                                "text": "The study was approved by the Institutional Animal Care and Use Committee (IACUC) of the University of Florida and the tortoise was humanely euthanized with an overdose of sodium pentobarbital performed by intracoelomatic injection [34 ]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b769f40e-7026-4fba-8c70-914f23001582",
                        "source_entry_id": "14304ef8-9f2d-3e55-af2a-ff0b61f3e28f",
                        "source_sense_id": "e3618a9b-34c6-375f-a073-1182ddebb83b",
                        "source_sense_description": "in a humane manner",
                        "target_lang_word": "humainement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humainement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "878ef0c7-85a9-3e46-bde0-9d33b8cd8d80",
                                        "entry_id": "7f780200-9c32-3b82-b586-fa4d36513324",
                                        "glosses": [
                                            "Comme un homme, comme il convient à un homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9faa7e04-8386-4384-b240-8489c76dd8e0",
                                                "sense_id": "878ef0c7-85a9-3e46-bde0-9d33b8cd8d80",
                                                "text": "À la table s’asseoir, manger humainement […]"
                                            },
                                            {
                                                "example_id": "b7af2fd6-6671-4b60-938c-8523c4e1be61",
                                                "sense_id": "878ef0c7-85a9-3e46-bde0-9d33b8cd8d80",
                                                "text": "[…] il me semble qu’un roi qui s’entretient tout seul avec son capitaine des gardes, parle un peu plus humainement, et ne prend guère ce ton de démoniaque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e387f72-4cad-3bc9-b4a2-724e17441fc4",
                                        "entry_id": "7f780200-9c32-3b82-b586-fa4d36513324",
                                        "glosses": [
                                            "Suivant la portée, la capacité, le pouvoir de l’homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b20024b-64a7-458b-ba50-045baecad84b",
                                                "sense_id": "3e387f72-4cad-3bc9-b4a2-724e17441fc4",
                                                "text": "Je vous parle humainement, à cause de la faiblesse de votre chair."
                                            },
                                            {
                                                "example_id": "27c2275e-cf5b-42a3-baca-492d9fab9080",
                                                "sense_id": "3e387f72-4cad-3bc9-b4a2-724e17441fc4",
                                                "text": "Les manières libres de Cratès plurent tellement à Hyparchia, sœur de Métrocle, qu elle ne voulut point entendre parler de plusieurs autres personnes considérables qui la recherchoient avec empressement ; elle menaça ses parents que si on ne la marioit pas à Cratès, elle se tueroit elle-même. Ses parents firent humainement tout ce qu’ils purent pour lui ôter cette idée de l’esprit ; ils n’y purent jamais réussir […]"
                                            },
                                            {
                                                "example_id": "14768d6b-00fe-47cb-9dbc-43fbd88ccca7",
                                                "sense_id": "3e387f72-4cad-3bc9-b4a2-724e17441fc4",
                                                "text": "[…] et n’est-ce pas penser trop humainement d’un Dieu qu’on nous fait si grand […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad3b1e91-3f13-35f3-8994-ad52d321c3de",
                                        "entry_id": "7f780200-9c32-3b82-b586-fa4d36513324",
                                        "glosses": [
                                            "Avec humanité, avec bonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53767d6f-cd41-473b-9c2f-c1594f5caf94",
                                                "sense_id": "ad3b1e91-3f13-35f3-8994-ad52d321c3de",
                                                "text": "Alexandre traita humainement les Milésiens, et vendit ce qu’il y trouva d’étrangers."
                                            },
                                            {
                                                "example_id": "1e166f3a-67e2-4609-b7ef-13183e1ce1bb",
                                                "sense_id": "ad3b1e91-3f13-35f3-8994-ad52d321c3de",
                                                "text": "[…] Albéroni lui [le marquis de Leyde] écrivit humainement que les soldats sont faits pour mourir quand cela convient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b9847c8-25d4-4afe-9ebf-d3524af26833",
                        "source_entry_id": "14304ef8-9f2d-3e55-af2a-ff0b61f3e28f",
                        "source_sense_id": "e3618a9b-34c6-375f-a073-1182ddebb83b",
                        "source_sense_description": "in a humane manner",
                        "target_lang_word": "menschlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menschlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                        "entry_id": "c74e74b1-2431-3d8c-b707-ef5d3f1da311",
                                        "glosses": [
                                            "dem Menschen zugehörig, (wie) ein Mensch seiend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c896d741-b752-47eb-9c82-7615a5af7776",
                                                "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                                "text": "Affen zeigen viele menschliche Eigenschaften."
                                            },
                                            {
                                                "example_id": "3df741ef-d82b-4d2d-a2de-ea2874d32cac",
                                                "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                                "text": "„Seit Beginn der dreißiger Jahre war Louis Leakey im östlichen Afrika auf der Suche nach Zeugnissen der Existenz menschlicher Vorfahren; vor allem suchte er Steinwerkzeuge.“"
                                            },
                                            {
                                                "example_id": "c30ca790-f79c-4512-937d-179a0a4ad70c",
                                                "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                                "text": "„Drei schwarze Vögel verspotten ihn mit einem Lied auf die Sinnlosigkeit alles menschlichen Tuns.“"
                                            },
                                            {
                                                "example_id": "df5a89f8-9d62-43fb-b1d9-273cd0195d98",
                                                "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                                "text": "„Eine Religion ist ein System menschlicher Werte und Normen, das auf dem Glauben an eine übermenschliche Ordnung basisert.“"
                                            },
                                            {
                                                "example_id": "2987e354-e7e2-4de3-af2f-89fd860dd034",
                                                "sense_id": "2c78864d-ade1-3383-a4a6-1f9233e718dd",
                                                "text": "„Die Sirenen erschienen Morgner wagemutiger als Odysseus, eine weibliche Trobadora sinnlicher als ihre männlichen Kollegen und Pandora menschlicher als der von ihr angebetete Prometheus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                        "entry_id": "c74e74b1-2431-3d8c-b707-ef5d3f1da311",
                                        "glosses": [
                                            "menschliche Charakterzüge besitzend (oft in Verbindung gebracht mit gütig oder sozial)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53693db1-acbf-4350-ac78-4b6aa37a0e95",
                                                "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                                "text": "„Sei doch mal menschlich und lass den alten Mann hier bei dir übernachten.“"
                                            },
                                            {
                                                "example_id": "dfad9b61-a285-4f35-9ae9-0610d3c27f4e",
                                                "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                                "text": "„Entscheidungen fielen grundsätzlich im Senat. Aber zu ihrer Verwirklichung bedurfte es der Magistrate und bei Gesetzen auch der Volksversammlung. Einzelne Politiker oder Gruppen konnten vielleicht vorübergehend den Senat majorisieren, doch sie mussten nach menschlichem Ermessen an einer der beiden anderen Instanzen scheitern, da sich diese ihrer Kontrolle entzogen, wenn innerhalb der Nobilität kein Konsens zustande kam.“"
                                            },
                                            {
                                                "example_id": "b5999054-7df4-42f6-8f17-76e9d7161886",
                                                "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                                "text": "„[Der Polizist] glaubte, daß der Mann betrunken sei, […]. Er wollte daher dem Fremden nicht amtlich, sondern menschlich begegnen. Er trat mit der Absicht ans Automobil, den Schlafenden zu wecken, ihn nach Twann zu fahren und im Hotel Bären bei schwarzem Kaffee und einer Mehlsuppe nüchtern werden zu lassen, […]“"
                                            },
                                            {
                                                "example_id": "e41450c2-debc-42b1-adf2-71c03b30018a",
                                                "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                                "text": "„Eine Religion ist ein System menschlicher Werte und Normen, das auf dem Glauben an eine übermenschliche Ordnung basisert.“"
                                            },
                                            {
                                                "example_id": "c18c9d6f-6005-4dbf-8d88-e76b669b404e",
                                                "sense_id": "05819ef0-fc33-3403-8cb4-3cdca4bda2c9",
                                                "text": "„Die Sirenen erschienen Morgner wagemutiger als Odysseus, eine weibliche Trobadora sinnlicher als ihre männlichen Kollegen und Pandora menschlicher als der von ihr angebetete Prometheus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cc50bb3-582f-4a66-a38d-c715c542fd7c",
                        "source_entry_id": "14304ef8-9f2d-3e55-af2a-ff0b61f3e28f",
