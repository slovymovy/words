                "word": "trilogy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "416d9f19-fae6-49d9-8eb2-0a29004ad815",
                        "entry_id": "d457db53-6014-3bce-ba97-3a79ed495394",
                        "tags": [
                            "plural"
                        ],
