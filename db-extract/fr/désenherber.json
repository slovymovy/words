                        "sense_id": "a6b90d67-32cb-3860-817b-0af19a3de4e6",
                        "entry_id": "cdbb1e20-e2b0-3c48-9b57-3dc798c11edf",
                        "glosses": [
                            "Enlever la couverture d’herbes de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5013a703-5290-4251-bcdd-1728414e9209",
                                "sense_id": "a6b90d67-32cb-3860-817b-0af19a3de4e6",
                                "text": "Ce mélange comble les espaces désenherbés et aide à réduire la prolifération des mauvaises herbes et des plantes vénéneuses."
                            },
                            {
                                "example_id": "3deb96a6-213b-44a2-b6a5-cf3a5d6e5ba4",
                                "sense_id": "a6b90d67-32cb-3860-817b-0af19a3de4e6",
                                "text": "C’est sous les yeux des écoliers caillacois que mardi 3 septembre, le chapiteau a retrouvé sa place minimale, plié sur lui-même, laissant alors une piste désenherbée comme souvenir."
                            }
                        ]
                    }
