                                        "entry_id": "0721c6cd-c303-38ea-b54c-854e4988beac",
                                        "glosses": [
                                            "rätoromanische Sprache, die in Friaul im Nordosten Italiens gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e796e186-fc23-4a4b-a9f1-0dc4269d2dc0",
                                                "sense_id": "bda4a83b-4f8c-3e43-bd14-53d2d88e21cb",
                                                "text": "Furlanisch ist als Minderheitensprache in Italien offiziell anerkannt."
                                            },
                                            {
                                                "example_id": "1f88eac3-55fc-4e6f-81ea-31149bab8a6e",
