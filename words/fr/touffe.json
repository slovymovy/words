    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47610ba3-d332-31df-b62c-6525a1ee67b0",
                    "sense_definition": "Ensemble d'éléments végétaux, de poils ou de cheveux serrés et réunis naturellement par la base.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assemblage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier arrache chaque <w>touffe</w> d'herbe qui pousse entre les pavés de l'allée."
                        },
                        {
                            "text": "L'enfant a une petite <w>touffe</w> de cheveux rebelles qui se dresse sur le front."
                        }
                    ],
                    "synonyms": [
                        "houppe"
                    ],
                    "common_phrases": [
                        "touffe d'herbe",
                        "touffe de cheveux"
                    ]
                },
                {
                    "sense_id": "34f49e9d-651c-30b3-9442-228e36746374",
                    "sense_definition": "Toison pubienne féminine, et par métonymie, sexe de la femme.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette robe fendue est si courte qu'on devine presque sa <w>touffe</w> quand elle marche."
                        },
                        {
                            "text": "L'auteur utilise des termes très crus dans son roman pour décrire la <w>touffe</w> de son amante."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgaire ou très familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3daade61-e4d0-3915-afd0-73deddde52c4",
                    "sense_definition": "Première ou troisième personne du singulier du présent de l'indicatif ou du subjonctif de <w>touffer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut que l'artisan <w>touffe</w> ce tapis pour lui donner une belle épaisseur."
                        },
                        {
                            "text": "Dans l'atelier textile, la machine <w>touffe</w> les fibres de laine de manière régulière."
                        }
                    ]
                },
                {
                    "sense_id": "5ce6731c-2245-3a00-ac6f-26313c120c58",
                    "sense_definition": "Deuxième personne du singulier de l'impératif présent de <w>touffer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "conjugaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Touffe</w> ce tissu plus serré pour éviter que les poils ne s'arrachent facilement."
                        },
                        {
                            "text": "Ne laisse pas d'espace vide et <w>touffe</w> la matière comme le maître l'enseigne."
                        }
                    ]
                }
            ]
        }
    ]
}