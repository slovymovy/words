                ],
                "senses": [
                    {
                        "sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                        "entry_id": "8dee00f5-5a7f-3530-9319-a0f501ed724c",
                        "glosses": [
                            "biologisches Abwehrsystem höherer Lebewesen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9088b3c-f60e-469b-8ed9-ca4943ab85c3",
                                "sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                                "text": "Sein Immunsystem war nach seiner Krankheit geschwächt."
                            },
                            {
                                "example_id": "d15e8f2a-29d3-4891-8e0c-200d73d238ca",
                                "sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                                "text": "„Die Gefahren, von denen Zacharowski spricht, waren jedoch schon immer da, sie wurden nur lange nicht erkannt: Fremdblut zwingt das Immunsystem des Empfängers in die Knie, zu einem Zeitpunkt, an dem er schwach ist – nach Unfällen oder großen Operationen.“"
                            },
                            {
                                "example_id": "10aefb6d-ada6-46a8-adb7-0ad83c26bac9",
                                "sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                                "text": "„Das Robert-Koch-Institut (RKI) spricht davon, dass ab 50 bis 60 Jahren das Risiko [einer Covid-19-Erkrankung] zunehmend ansteigt. Der Grund dafür ist, dass mit zunehmenden Alter das Immunsystem schwächer wird.“"
                            },
                            {
                                "example_id": "6bb36cad-14f7-4288-836a-3f1fb8b8ff7e",
                                "sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                                "text": "„Das Immunsystem der Indigenen hatte den Krankheitserregern aus Europa wenig entgegenzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fce4e827-3c58-4339-8387-bae60a16e511",
                        "source_entry_id": "8dee00f5-5a7f-3530-9319-a0f501ed724c",
                        "source_sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                        "source_sense_description": "Medizin: biologisches Abwehrsystem höherer Lebewesen",
                        "target_lang_word": "immune system",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immune system",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9cc4e5ea-8ba4-3037-90f2-1703983684a6",
                                        "entry_id": "a0c1f357-8c08-3036-82fc-68b558345f76",
                                        "glosses": [
                                            "The system that differentiates self from non-self and protects the body from foreign substances and pathogenic organisms by producing an immune response. It includes organs such as the thymus, the spleen and lymph nodes; tissue such as bone marrow, and lymphoid tissues such as the tonsils; cells such as lymphocytes including the B cells and T cells, and cell products such as antibodies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8209a28-d511-43a8-abe3-2419e943b144",
                        "source_entry_id": "8dee00f5-5a7f-3530-9319-a0f501ed724c",
                        "source_sense_id": "73481874-28fa-3f1d-b58c-602b5da8671d",
                        "source_sense_description": "Medizin: biologisches Abwehrsystem höherer Lebewesen",
                        "target_lang_word": "système immunitaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "système immunitaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9641bb6b-83d9-3808-9441-e48cfbe02763",
                                        "entry_id": "c1f98ddc-a445-3cf9-aaaf-3a42fe8c079d",
                                        "glosses": [
                                            "Système de l’organisme relatif à la défense de celui-ci envers les corps extérieurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3bad28e-8b8f-4e85-88ac-e684d4d91553",
                                                "sense_id": "9641bb6b-83d9-3808-9441-e48cfbe02763",
                                                "text": "Contrairement aux rayons X ou ultraviolets, elles ne seraient pas assez puissantes pour atteindre les cellules du corps humain et affecter notre système immunitaire."
                                            },
                                            {
                                                "example_id": "f4ff4d52-047f-4c9c-925f-85d663626e14",
                                                "sense_id": "9641bb6b-83d9-3808-9441-e48cfbe02763",
                                                "text": "\"L’idée d’utiliser des vaccins pour stimuler le système immunitaire de manière non spécifique, ça existe depuis longtemps\", explique Alain Lamarre, expert en immunologie et virologie à l'Institut national de la recherche scientifique (INRS)."
                                            },
                                            {
                                                "example_id": "991d1d1a-d703-4a97-9889-0761978f4209",
                                                "sense_id": "9641bb6b-83d9-3808-9441-e48cfbe02763",
                                                "text": "Les traitements immunomodulateurs ont pour objectif de rétablir l’action du système immunitaire en levant les mécanismes d’inhibition et de détournement mis en place par les cellules tumorales."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "939351a4-7a25-41fd-a234-4eb24bc85ce8",
                        "source_entry_id": "8dee00f5-5a7f-3530-9319-a0f501ed724c",
