                        "glosses": [
                            "Relatif à une dissolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "161d17c8-dc5a-45fd-aee9-bbdac16bf813",
                                "sense_id": "4fe4fa3a-0847-30db-96d3-a7374314aa10",
                                "text": "Inventaire dissolutif de la communauté d'entre le citoyen Lamarck et la citoyenne Reverdy son épouse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d63684e-1d89-37bd-b7c6-3473859ce7be",
                        "entry_id": "0f7e24cb-0c94-372b-b3d9-8a0174812e51",
                        "glosses": [
                            "Dissolvant, qui dissout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1ab9fb-a870-4b25-a8ce-1c4bbffee140",
                                "sense_id": "8d63684e-1d89-37bd-b7c6-3473859ce7be",
                                "text": "La dialectique marxiste produit son moment dissolutif."
                            },
                            {
                                "example_id": "3818a357-86d4-495a-befb-f252682a15f8",
                                "sense_id": "8d63684e-1d89-37bd-b7c6-3473859ce7be",
                                "text": "Désemparés, soucieux d'éviter des conflits, ou déjà gagnés aux vertus d'un multiculturalisme dissolutif de la culture française et de la nation, trop de responsables renoncent déjà à faire respecter les règles de la laïcité."
                            }
                        ]
                    }
