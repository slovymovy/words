                "translations": [
                    {
                        "translation_id": "3d5b9c1d-4845-4d5f-b8f2-271797fa979b",
                        "source_entry_id": "c05c3825-a3d7-3abc-9498-8ddd8a74b047",
                        "source_sense_id": "1489a634-81bd-3f36-95ae-8565e5c8efc8",
                        "target_lang_word": "sich aus dem Staub machen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sich aus dem Staub machen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5fe5bd0-c3d1-38e6-8ccf-c518bd443862",
                                        "entry_id": "f8af340c-7fbb-38b7-8491-7240aaf09507",
                                        "glosses": [
                                            "einen Ort rasch, fluchtartig und meist heimlich verlassen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68f8181-3cdc-44ae-9749-f9e778f96800",
                                                "sense_id": "b5fe5bd0-c3d1-38e6-8ccf-c518bd443862",
                                                "text": "Als die Typen mich bemerkten und auf mich zukamen, machte ich mich aus dem Staub."
                                            },
                                            {
                                                "example_id": "a2224039-199a-4f08-be6e-46acf0608354",
                                                "sense_id": "b5fe5bd0-c3d1-38e6-8ccf-c518bd443862",
                                                "text": "„Die fünf CIA-Agenten, die auf Sumatra dabei gewesen waren, machten sich Hals über Kopf mit einem Jeep Richtung Süden aus dem Staub.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdccee56-90c0-438d-b095-10812149fb37",
                        "source_entry_id": "c05c3825-a3d7-3abc-9498-8ddd8a74b047",
                        "source_sense_id": "1489a634-81bd-3f36-95ae-8565e5c8efc8",
                        "target_lang_word": "stiften gehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stiften gehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                        "entry_id": "a2b466b8-15c0-3e9a-82b1-0dea15f0515c",
                                        "glosses": [
                                            "davonlaufen; möglichst unauffällig verschwinden"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04788c78-a5fb-486f-9acd-036505b64c62",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "Nach dem Klingelstreich gingen die drei Steppkes stiften."
                                            },
                                            {
                                                "example_id": "dd06ed88-9fe7-4a3f-a0dc-87f90dccd224",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„»Wir hatten […] einen Einbruch im Supermarkt, wo auf den Überwachungsvideos fünf Täter zu sehen waren. […] Drei hatte man gefasst, zwei waren stiften gegangen.«“"
                                            },
                                            {
                                                "example_id": "3ef87456-8c6d-4cac-8337-ef1ae87b5b6f",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„Doch anstatt die Täter zur Kasse zu führen, rannte die Frau schreiend durch das Geschäft. Daraufhin flohen die beiden Unbekannten ohne Beute. »Die Ganoven waren wohl perplex und sind stiften gegangen«, sagte ein Polizeisprecher. Nun ermittelt die Kriminalpolizei.“"
                                            },
                                            {
                                                "example_id": "e7415642-76b8-4d83-81e7-152b22e0d729",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„Der Fahrer eines Geldtransporters, der in München mit mehr als einer Million Euro stiften gegangen ist, konnte wohl auf die Hilfe eines Komplizen bauen. »Aller Wahrscheinlichkeit nach hatte er einen Mittäter«, sagte eine Sprecherin der Staatsanwaltschaft München I am Dienstag.“"
                                            },
                                            {
                                                "example_id": "4b02d899-93cc-428f-9e9a-8595ccc0b94a",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„Schwarzfahrer legt mit Flucht in Tunnel S-Bahn-Verkehr lahm: Ein frisch ertappter Schwarzfahrer ist im Frankfurter Hauptbahnhof stiften gegangen - und hat damit vorübergehend den S-Bahn-Verkehr lahmgelegt.“"
                                            },
                                            {
                                                "example_id": "aaabb861-0627-4ed9-9ac2-6c500eed496c",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„In Leipzig waren den Russen von einem Transport, es können entweder politische Gefangene gewesen sein oder vielleicht SS-Leute, fünf Mann stiften gegangen.“"
                                            },
                                            {
                                                "example_id": "d159566f-388d-49b2-a2a9-5cad8a54be62",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„»Da war es schon hell, so um halb fünf herum, schätze ich. Jemand machte sich an der Tür zu schaffen und rief etwas. Ich dachte, dass der Besitzer käme, und ging stiften.«“"
                                            },
                                            {
                                                "example_id": "0aae928c-659b-47d1-a418-82a70f56f5d7",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„Aber sie war nervös. Wollte er wirklich nur telefonieren, oder hatte sein Instinkt gewonnen, und er ging stiften?“"
                                            },
                                            {
                                                "example_id": "ff6c13ea-85dc-4b62-b08a-c1f72a2accda",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„»[…] Bist du dir sicher, dass er es ihr nicht besorgt hat und sie danach einfach stiften gegangen ist?«“"
                                            },
                                            {
                                                "example_id": "681436e4-fe5a-4ea4-81cd-2cf24a5e9f2f",
                                                "sense_id": "0e73c615-c1a2-32f1-8ad2-2b20af63d314",
                                                "text": "„Wieviel Wahrheitsgehalt hatten wohl ihre ständigen Liebesbeteuerungen. Ein bisschen krank war ihr Verhalten wohl doch, dermaßen heftig zu klammern. Andere Männer wären wohl längst stiften gegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edfbe4fe-0fce-4618-bb6c-3672eca98152",
                        "source_entry_id": "c05c3825-a3d7-3abc-9498-8ddd8a74b047",
                        "source_sense_id": "1489a634-81bd-3f36-95ae-8565e5c8efc8",
                        "target_lang_word": "abhauen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abhauen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1132d4c-3257-3747-a480-c3dc4597f240",
                                        "entry_id": "1faa3ccd-bba4-3c5e-9814-43df87f39302",
                                        "glosses": [
                                            "etwas abschlagen, abtrennen (starke und schwache Konjugation: hieb/haute ab und abgehauen/abgehaut)"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07ef3dad-a234-4c74-a379-e9be8e6d6102",
                                                "sense_id": "f1132d4c-3257-3747-a480-c3dc4597f240",
                                                "text": "Er nahm das große Schwert, hieb/haute ihm damit den Kopf ab und schrie: „Es kann nur einen geben!“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e5cc681-5269-3e7c-95f3-6257ede2c878",
                                        "entry_id": "1faa3ccd-bba4-3c5e-9814-43df87f39302",
                                        "glosses": [
                                            "sich entfernen, davonmachen (Präteritum nur schwache Konjugation: haute; Partizip II abgehaut oder abgehauen)"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01d582f3-b79c-4288-add9-14624ebfd61d",
                                                "sense_id": "2e5cc681-5269-3e7c-95f3-6257ede2c878",
                                                "text": "Sie wollte nur Zigaretten holen gehen, doch eigentlich nutzte sie die Gelegenheit um abzuhauen."
                                            },
                                            {
                                                "example_id": "02bf4ce3-4847-4d88-b696-63d0246157ba",
                                                "sense_id": "2e5cc681-5269-3e7c-95f3-6257ede2c878",
                                                "text": "Der Junge ist von zuhause abgehauen/abgehaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fb58be3-e094-423e-a202-84bcc515dd19",
                        "source_entry_id": "c05c3825-a3d7-3abc-9498-8ddd8a74b047",
                        "source_sense_id": "1489a634-81bd-3f36-95ae-8565e5c8efc8",
                        "target_lang_word": "verduften",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verduften",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d5f300-9141-3e79-ac10-b41fd0c31209",
                                        "entry_id": "45988371-476f-30df-a18b-e8148dd3e07e",
                                        "glosses": [
                                            "den Geruch verlieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69769df9-77fd-412e-a8ce-d45d7aff42d1",
                                                "sense_id": "a6d5f300-9141-3e79-ac10-b41fd0c31209",
                                                "text": "Das Parfum verduftet langsam."
                                            },
                                            {
                                                "example_id": "52a310e7-9a82-452c-89e3-c3033389ee83",
                                                "sense_id": "a6d5f300-9141-3e79-ac10-b41fd0c31209",
                                                "text": "Für Rosenpflückerinnen und Rosenbauern ist die Ernte ein Wettlauf mit der Zeit, denn die Blüten müssen im Morgengrauen gepflückt und schnell verarbeitet werden, sonst „verduften“ die wertvollen ätherischen Öle."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "371de6af-02cf-3027-a300-7cf42ef50cff",
                                        "entry_id": "45988371-476f-30df-a18b-e8148dd3e07e",
                                        "glosses": [
                                            "sich unauffällig davonmachen, verschwinden"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f90c21c3-3d05-47fe-b429-e9778c0951cb",
                                                "sense_id": "371de6af-02cf-3027-a300-7cf42ef50cff",
                                                "text": "Bevor es zu brenzlig wurde verduftete er schnell."
                                            },
                                            {
                                                "example_id": "53ec95f9-6c1d-4e6f-9d05-97abf1ec5792",
                                                "sense_id": "371de6af-02cf-3027-a300-7cf42ef50cff",
                                                "text": "Der Einbrecher verduftete durch den Garten, als er Schlüsselklappern an der Haustür hörte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
