                            {
                                "example_id": "80dde4d7-1afa-4d2a-9ce2-c3eec61f67f5",
                                "sense_id": "bb8ff8cc-2ef3-3c36-9a91-998451d59064",
                                "text": "DVEP Energie gaat het terrein afrasteren met een hek en erbinnen worden de zonnepanelen door middel van een waterpartij en een rietkraag onttrokken aan het zicht."
                            },
                            {
                                "example_id": "dd96dc7c-c6b5-4472-852c-22a36079a9e7",
                                "sense_id": "bb8ff8cc-2ef3-3c36-9a91-998451d59064",
                                "text": "Varen is toegestaan, maar de laatste 150 meter van de vaargeul - de aansluiting op het Drontermeer - mag niet worden aangelegd. De waterrecreatie bedreigt daar een rietkraag waar de beschermde roerdomp en de grote karekiet leven."
                            }
