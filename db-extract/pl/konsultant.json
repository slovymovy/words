                                    },
                                    {
                                        "sense_id": "9e06bc9b-bc83-3f24-9277-c23f6878f811",
                                        "entry_id": "6ff03ece-72ae-3a5a-9ae7-a4e2c0f490fd",
                                        "glosses": [
                                            "Qualifie l’avocat qui donne son avis et son conseil par écrit ou de vive voix sur les affaires litigieuses."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
