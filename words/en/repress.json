    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6bc872eb-3c29-3738-bdda-bff4519774b4",
                    "sense_definition": "To forcefully stop or put an end to a rebellion or uprising.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government used the military to <w>repress</w> the violent rebellion."
                        },
                        {
                            "text": "The soldiers were ordered to <w>repress</w> the uprising before it spread further."
                        }
                    ],
                    "synonyms": [
                        "quell",
                        "subdue",
                        "suppress"
                    ],
                    "common_phrases": [
                        "repress a rebellion"
                    ]
                },
                {
                    "sense_id": "e5776f9d-37e3-33d9-89d6-80221602adb3",
                    "sense_definition": "To control or hold back an emotion or desire.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to <w>repress</w> her anger during the difficult meeting."
                        },
                        {
                            "text": "It is unhealthy to <w>repress</w> your true feelings for too long."
                        }
                    ],
                    "synonyms": [
                        "restrain",
                        "stifle",
                        "curb"
                    ],
                    "common_phrases": [
                        "repress emotions"
                    ]
                },
                {
                    "sense_id": "09dcd82d-1396-3b51-86d7-42c3c4010fd2",
                    "sense_definition": "To press something again.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory decided to <w>repress</w> the classic album on high-quality vinyl."
                        },
                        {
                            "text": "The plant had to <w>repress</w> the records after the first batch came out warped."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "spelling: usually 're-press' in this sense"
