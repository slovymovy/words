    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "860bcfe8-16d5-3c8e-8d1d-39331eabc0f9",
                    "sense_definition": "czynić coś trudnym do zrozumienia, skomplikowanym lub niejasnym, wprowadzając zamęt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "komplikowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego sprzeczne zeznania tylko niepotrzebnie <w>gmatwają</w> całe śledztwo prowadzone przez policję.",
                            "target_lang_translations": {
                                "ru": "Его противоречивые показания только попусту <w>запутывают</w> все следствие, проводимое полицией."
                            }
                        },
                        {
                            "text": "Nie próbuj <w>gmatwać</w> sytuacji, kiedy wszystko jest już jasne i ustalone.",
                            "target_lang_translations": {
                                "ru": "Не пытайся <w>усложнять</w> ситуацию, когда все уже ясно и решено."
                            }
                        }
                    ],
                    "synonyms": [
                        "mącić",
                        "plątać",
                        "wikłać"
                    ],
                    "common_phrases": [
                        "gmatwać sytuację",
                        "gmatwać sprawę"
                    ],
                    "target_lang_definitions": {
                        "ru": "делать что-либо трудным для понимания, запутанным или неясным, внося путаницу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путать",
                                "target_lang_sense_clarification": "делать неясным, вносить неразбериху"
                            },
                            {
                                "target_lang_word": "запутывать",
                                "target_lang_sense_clarification": "усложнять ситуацию или дело"
                            },
                            {
                                "target_lang_word": "усложнять",
                                "target_lang_sense_clarification": "делать более сложным для понимания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "886a6377-e66c-3545-9663-e5a74e086d1a",
                    "sense_definition": "fizycznie plątać lub bezładnie mieszać ze sobą nitki, sznury bądź włosy",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "splatanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr bezlitośnie <w>gmatwał</w> jej długie włosy podczas spaceru brzegiem morza.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер безжалостно <w>путал</w> ее длинные волосы во время прогулки по берегу моря."
                            }
                        },
                        {
                            "text": "Bawiący się kot zaczął <w>gmatwać</w> nici wyciągnięte z koszyka do szycia.",
                            "target_lang_translations": {
                                "ru": "Играющий кот начал <w>спутывать</w> нитки, вытащенные из корзинки для шитья."
                            }
                        }
                    ],
                    "synonyms": [
                        "plątać"
                    ],
                    "common_phrases": [
                        "gmatwać nici",
                        "gmatwać włosy"
                    ],
                    "target_lang_definitions": {
                        "ru": "беспорядочно переплетать, спутывать нити, веревки или волосы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путать",
                                "target_lang_sense_clarification": "о нитках, волосах и т. п."
                            },
                            {
                                "target_lang_word": "спутывать",
                                "target_lang_sense_clarification": "переплетать в беспорядке"
                            },
                            {
                                "target_lang_word": "колтунить",
                                "target_lang_sense_clarification": "сбивать волосы или шерсть в комки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}