                        "entry_id": "79d22014-bf23-3a97-92fe-594c663d6d20",
                        "glosses": [
                            "wildes, lebhaftes Mädchen, das sich verhält, wie es typischerweise von Jungen erwartet wird"
                        ],
                        "tags": [],
