{
    "word_family": [
        "cristal",
        "cristallin",
        "cristallisation",
        "cristallerie",
        "cristallographie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37ebb157-fa76-3580-a9a3-d44085336499",
                    "sense_definition": "Fixer, figer ou concentrer durablement des opinions, des sentiments ou des oppositions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette réforme controversée a fini par <w>cristalliser</w> toutes les colères des manifestants."
                        },
                        {
                            "text": "Le nouveau projet de loi risque de <w>cristalliser</w> les tensions entre les deux partis."
                        }
                    ],
                    "synonyms": [
                        "figer",
                        "fixer",
                        "polariser"
                    ],
                    "antonyms": [
                        "apaiser",
                        "dissiper"
                    ],
                    "common_phrases": [
                        "cristalliser les tensions",
                        "cristalliser l'attention",
                        "cristalliser les mécontentements"
                    ]
                },
                {
                    "sense_id": "59bf4efb-e2d2-3468-897d-57e8acec5787",
                    "sense_definition": "Prendre la forme de cristaux ou amener un corps liquide ou gazeux à l'état solide sous forme cristalline.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "chimie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En refroidissant lentement, la solution saturée commence à <w>cristalliser</w> au fond du récipient."
                        },
                        {
                            "text": "Le chimiste tente de faire <w>cristalliser</w> le produit pour en vérifier la pureté."
                        }
                    ],
                    "antonyms": [
                        "dissoudre"
                    ],
                    "common_phrases": [
                        "commencer à cristalliser",
                        "faire cristalliser"
                    ]
                },
                {
                    "sense_id": "56e62715-f31d-30c4-bbbc-e26163cc8f6e",
                    "sense_definition": "Prendre naissance et se développer en parant l'objet aimé de toutes les perfections, en référence à la théorie de Stendhal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au contact de son regard, son sentiment d'amour a rapidement <w>cristallisé</w>."
                        },
                        {
                            "text": "Dès qu'il l'a vue pour la première fois, son imagination a <w>cristallisé</w>."
                        }
                    ],
                    "synonyms": [
                        "idéaliser"
                    ]
                }
            ]
        }
    ]
}