                "senses": [
                    {
                        "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                        "entry_id": "d44060d2-38bb-353b-ae9f-a1703e923f40",
                        "glosses": [
                            "Ausdruck der menschlichen Stimme im Vortrag (von Gesang); Artikulation der Gesangsstimme; Stimmklang als Informationsträger"
                        ],
                        "tags": [
                            "Musik",
                            "Poesie",
                            "Gesang",
                            "Germanistik, besonders im Zusammenhang mit Balladen des Mittelalters"
                        ],
                        "examples": [
                            {
                                "example_id": "70600213-126a-4239-bb50-217da4bdb409",
                                "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                                "text": "Vokalität kommt dann zum Tragen, wenn etwas schriftlich Fixiertes durch die menschliche Stimme einem Auditorium vorgetragen wird."
                            },
                            {
                                "example_id": "e181dc10-cd3b-418c-b5f2-215b6a1ab113",
                                "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                                "text": "Vokalität ist eine sekundäre Form der Mündlichkeit, die Gestik, Mimik, Klang der Stimme und Rhythmik nutzt, um Text zu vermitteln."
                            },
                            {
                                "example_id": "09fcb86f-8a7d-400f-b2e0-d7a7f1801fc5",
                                "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                                "text": "Vokalität ist umschrieben »das mit Gesang Geladene« oder »das aus dem Mund heraus Klingende«."
                            },
                            {
                                "example_id": "8c91dcf7-9fcc-434f-af4b-bc976dade5ff",
                                "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                                "text": "„Mediengeschichtlich könnte man das Zusammentreffen von Mündlichkeit und Schriftlichkeit in Vokalität wohl als den entscheidenden Konvergenzpunkt verstehen.“"
                            },
                            {
                                "example_id": "17f40034-027e-434a-aaf5-9131ce84219f",
                                "sense_id": "fb60198c-c4ef-387c-a8de-9a1945952df8",
                                "text": "Heute kann man seine ungebrochene Vitalität und Vokalität in den Clubs der Bay Area bewundern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
