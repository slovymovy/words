                "senses": [
                    {
                        "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                        "entry_id": "92c3649a-25e7-39b1-b360-b75b6ba4d61d",
                        "glosses": [
                            "Wasser, dem Thymian zugesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3c49178-619c-4725-9432-af19ebc93b07",
                                "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                                "text": "„Thymianwasser hat er am liebsten.“"
                            },
                            {
                                "example_id": "fb30f062-4372-4189-a610-0b496732c0c6",
                                "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                                "text": "„Auf mein Geheiß hin mussten die Mägde die ausgebleichten Wandbehänge und Teppiche ausklopfen, die Wäsche in Thymianwasser reinigen und die muffigen Oberkleider lüften.“"
                            },
                            {
                                "example_id": "443fed2f-2ad9-41e7-9a2f-b0e809662adc",
                                "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                                "text": "„Beide Völker werden mit etwas Thymianwasser besprüht.“"
                            },
                            {
                                "example_id": "2b956bdf-d8a3-4591-944b-070cb6b6d7cd",
                                "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                                "text": "„Ich habe das Direktverfahren angewandt, indem ich das ganze Kästlein samt der jungen Königin mit Thymianwasser angespritzt habe.“"
                            },
                            {
                                "example_id": "de10e8d0-babd-4cd8-9632-d38576d7af11",
                                "sense_id": "a7bfb3d2-5213-3941-8942-3219066b0770",
                                "text": "„Durch Bespritzen mit Thymianwasser wird den Schröpfbienen und den Schröpfwaben der gleiche Geruch wie den ebenfalls angespritzten Bienen des zu verstärkenden Volkes gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
