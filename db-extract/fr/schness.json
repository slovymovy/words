                                                "sense_id": "60bb244c-cfcc-33d7-936d-889e55da320e",
                                                "text": "Schäferhunde haben lange Schnauzen."
                                            },
                                            {
                                                "example_id": "56b0d237-4864-47a9-99e2-5f1672bf98e9",
                                                "sense_id": "60bb244c-cfcc-33d7-936d-889e55da320e",
                                                "text": "„Um die zehn Meter maß ein ausgewachsener Brachylophosaurier – von der an Enten erinnernden Schnauze über den mit einer Knochenplatte gepanzerten Schädel bis zur Schwanzspitze.“"
                                            },
                                            {
                                                "example_id": "9871c5a5-99f4-45e0-ae64-a5c89edc0398",
                                                "sense_id": "60bb244c-cfcc-33d7-936d-889e55da320e",
                                                "text": "„Er stand neben dem Hai, blickte zu seiner Schnauze auf und tätschelte ihn mit der Hand.“"
                                            },
                                            {
                                                "example_id": "0fe7c352-1970-42c2-8efd-86ae41eff726",
                                                "sense_id": "60bb244c-cfcc-33d7-936d-889e55da320e",
                                                "text": "„Er leckte sich die Schnauze und schien gefressen zu haben.“"
                                            }
