                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "a8f51e08-afe8-425e-9a22-b2c6bd30d02f",
                                "sense_id": "05e1af4f-eb25-3328-bcd8-c058319541d6",
                                "text": "Ses employeurs, les grandes administrations, sinon un passage au cabinet de la juppette Colette Codaccioni, le savaient à peine."
                            },
                            {
                                "example_id": "046ad463-c929-4daa-846f-50d99a95effb",
                                "sense_id": "05e1af4f-eb25-3328-bcd8-c058319541d6",
                                "text": "Chez les chiraquiens, l'expérience douloureuse des « juppettes » reste dans les mémoires."
                            }
                        ]
                    }
