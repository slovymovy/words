                "senses": [
                    {
                        "sense_id": "8e171ee6-2ff0-3a27-9e63-5ee89c74b394",
                        "entry_id": "a1a831bb-e1f1-315d-b4ef-6e28e5657900",
                        "glosses": [
                            "Teil der Polizei, dessen Aufgabenbereich die Überwachung und Sicherung des Straßenverkehrs umfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fd221b-dcb8-417e-90a9-a74cacbf4e3d",
                                "sense_id": "8e171ee6-2ff0-3a27-9e63-5ee89c74b394",
                                "text": "„Als man mich zur Verkehrspolizei versetzt hat, weil einer meiner eigenen Leute mich reingelegt hat, damit ich degradiert werde, wollte ich kündigen.“"
                            },
                            {
                                "example_id": "c2fc5d83-5e57-4565-9ecc-8562c074a5b3",
                                "sense_id": "8e171ee6-2ff0-3a27-9e63-5ee89c74b394",
                                "text": "„Jugendliche fuhren dort ohne Führerschein, ohne jede Furcht vor der Verkehrspolizei.“"
                            },
                            {
                                "example_id": "47011f39-388b-47a8-aa06-4fe16d43a807",
                                "sense_id": "8e171ee6-2ff0-3a27-9e63-5ee89c74b394",
                                "text": "„Sollte er eine feste Stelle beim G-Korps bekommen, plant er insgeheim, sie anzunehmen, sich aber später zur Verkehrspolizei versetzen zu lassen, wo man nie jemanden anfassen muss und die Leute einem bereits die Taschen vollstopfen, wenn man nur den Notizblock zückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
