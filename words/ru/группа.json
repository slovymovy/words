            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bd8af4e-fe59-3540-ae6a-e89fbeb05638",
                    "sense_definition": "Несколько людей, животных или предметов, находящихся вместе в одном месте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "physical_cluster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Возле входа в музей стояла большая <w>группа</w> иностранных туристов.",
                            "target_lang_translations": {
                                "en": "A large <w>group</w> of foreign tourists stood near the museum entrance.",
                                "zh": "博物馆入口处站着一大<w>群</w>外国游客。"
                            }
                        },
                        {
                            "text": "Мы заметили, что <w>группа</w> островов виднеется на горизонте.",
                            "target_lang_translations": {
                                "en": "We noticed that a <w>group</w> of islands was visible on the horizon.",
                                "zh": "我们注意到地平线上隐约可见一<w>群</w>岛屿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "группа людей",
                        "группа туристов",
                        "экскурсионная группа"
                    ],
                    "target_lang_definitions": {
                        "en": "A number of people, animals, or objects located together in one place.",
                        "zh": "位于同一地点的若干人、动物或物体。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "group",
                                "target_lang_sense_clarification": "collection of people or things"
                            },
                            {
