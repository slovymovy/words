                    {
                        "sense_id": "d0f3a465-a4ed-339b-8b18-3acef0afb63c",
                        "entry_id": "848cd031-386f-376e-b584-78952fd245f8",
                        "glosses": [
                            "Slightly glazed; covered by a thin gloss."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "57d1bc38-5e79-4c43-80b9-20bec9e4a3ad",
                                "sense_id": "d0f3a465-a4ed-339b-8b18-3acef0afb63c",
                                "text": "Sift a small quantity of the dust on to a semiglazed white paper about 8 by 10 inches."
                            },
                            {
                                "example_id": "4ad8da21-daa2-4429-bdd8-783df8445153",
                                "sense_id": "d0f3a465-a4ed-339b-8b18-3acef0afb63c",
                                "text": "The semiglazed chintz curtains are hung from a rod placed inside a painted wooden cornice."
                            },
                            {
                                "example_id": "24010faf-a52e-4097-90f8-a3d2f05a4eba",
                                "sense_id": "d0f3a465-a4ed-339b-8b18-3acef0afb63c",
                                "text": "Two-inch-square tan or turquoise-colored semiglazed tile is attractive and has the advantage of not showing footmarks or discoloration."
                            }
                        ]
                    },
                    {
                        "sense_id": "c09eda9d-ea54-3e11-98a8-14df99ab1fdd",
                        "entry_id": "848cd031-386f-376e-b584-78952fd245f8",
                        "glosses": [
                            "Partially glazed; glazed over only part of the surface or not completely glazed over."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6613c41-0f94-43e6-bb29-ecdca39a1cee",
                                "sense_id": "c09eda9d-ea54-3e11-98a8-14df99ab1fdd",
                                "text": "As she peered at me from semiglazed eyes, her yawn was interrupted by a rich giggle."
                            },
                            {
                                "example_id": "4f5f9610-e5fd-4e9b-bda1-fee73c2854c1",
                                "sense_id": "c09eda9d-ea54-3e11-98a8-14df99ab1fdd",
                                "text": "This smaller foot is normal on examples dating at the end of the 2nd century, as well as on semiglazed bowls (see below)."
                            },
                            {
                                "example_id": "05206642-ad9d-4f8f-9500-71244f48fb2f",
                                "sense_id": "c09eda9d-ea54-3e11-98a8-14df99ab1fdd",
                                "text": "Semiglazed bowls (22) have a simple ring foot and convex lower wall that constricts and is pulled out in its upper reaches to form a concave upper wall terminating in a tapered, outturned rim. They are given the name “semiglazed” because most examples from Corinth are dipped in slip to about mid-wall on the exterior."
                            }
                        ]
                    }
