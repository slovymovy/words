                "translations": [
                    {
                        "translation_id": "757db1e8-7706-4d8f-bee1-be0378e6b666",
                        "source_entry_id": "e369f00a-91ef-33ce-bb67-8a395875e6a9",
                        "source_sense_id": "ee5e80a7-8115-34ff-98a2-187cc8abaab5",
                        "target_lang_word": "cordelette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cordelette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                        "entry_id": "3f835e39-ea92-3857-916a-d8f7ff62c0f3",
                                        "glosses": [
                                            "Toute petite corde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95080e39-1633-4a1e-afb4-777ffc0a4d86",
                                                "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                                "text": "Les cordelettes m'entraient dans la chair, les mains me faisaient mal et la position dans laquelle mes bras étaient maintenus me brisait les épaules."
                                            },
                                            {
                                                "example_id": "7abd55f1-1f17-4736-91f6-daa3b01b3959",
                                                "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                                "text": "Sur le mur, grâce au calendrier des P.T.T. dont le carton blanc bordé d’un liséré rouge se balançait au bout de sa cordelette, c’était l’automne."
                                            },
                                            {
                                                "example_id": "742e5317-c2d4-4a41-9675-6e76d774356b",
                                                "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                                "text": "Cette chambre qui n’était cependant qu’un secteur de la yourte princière, avec en guise de porte une rangée de cordelettes alourdies de coquillages colorés qui s’arrêtaient à deux coudées du sol. Pour que la princesse fût la seule à pouvoir entrer sans les faire tinter."
                                            },
                                            {
                                                "example_id": "7888d413-3fe3-4690-a5bb-d20b4dcaa9c2",
                                                "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                                "text": "Lorsque, pour montrer ou vendre, la mère allume l’un des cagibis du fond, c’est cela qui saute aux yeux : toutes ces étiquettes pendues par des cordelettes."
                                            },
                                            {
                                                "example_id": "88282a8c-2662-47e2-a426-d72fb3dac277",
                                                "sense_id": "e56c672f-15d6-38dd-ae6b-476a650837db",
                                                "text": "La cordelette est composée de fibres d’écorce de conifères, tissées dans le sens antihoraire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
