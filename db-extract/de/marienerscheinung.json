                "senses": [
                    {
                        "sense_id": "b5d6c0dc-b0cf-3852-a708-6fde67b0aeb9",
                        "entry_id": "3c8867bf-48c9-3772-8d70-1e05c4f242ab",
                        "glosses": [
                            "Vision, bei der Zeugen berichten, dass ihnen die Jungfrau Maria erschienen sei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95031b2e-2011-407f-9fe5-06fa33b47934",
                                "sense_id": "b5d6c0dc-b0cf-3852-a708-6fde67b0aeb9",
                                "text": "„Entsprechend der zu Boschs Zeiten verbindlichen theologischen Interpretation dieser Vision zeigt die Tafel am Himmel in einer Aureole aus Licht eine Marienerscheinung.“"
                            },
                            {
                                "example_id": "b154273f-094d-42d9-ab04-f867d240a912",
                                "sense_id": "b5d6c0dc-b0cf-3852-a708-6fde67b0aeb9",
                                "text": "„Das Bild zog so viele Besucher an, dass es die Franziskaner alarmierte und für sehr viel Unruhe unter ihnen sorgte. (Später, im 17. Jahrhundert, kam das Gerücht auf, dass der Ort berühmt geworden sei, weil ein Indio namens ›Juan Diego‹ nur wenige Jahre nach der Konquista dort eine Marienerscheinung gehabt habe.)“"
                            },
                            {
                                "example_id": "cbcb103b-469e-41e8-8e34-05020740f4e7",
                                "sense_id": "b5d6c0dc-b0cf-3852-a708-6fde67b0aeb9",
                                "text": "„Nachdem sie die Gefahr überstanden hatten, suchten einige den Grund dafür in einer Marienerscheinung und der Hilfe durch den heiligen Jakob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
