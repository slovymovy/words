                        "glosses": [
                            "Having a powdery or granular texture;"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8a914f-697b-4b2d-a135-f7111eb70d32",
                                "sense_id": "dc9d3daa-5044-377b-b77f-e463f9a37abc",
                                "text": "interior tube extends until its diameter attains the size of the interior peridium . It is constant yellowish white , pulverate ."
                            },
                            {
                                "example_id": "77b6be31-9964-4664-9eb3-c85381847cf4",
                                "sense_id": "dc9d3daa-5044-377b-b77f-e463f9a37abc",
                                "text": "of the lower plane suberect, imbricate, ovate, acuminate, keeled, piloso-denticulate; macrospores whitish with yellow contents, pulverate, soon smooth;"
                            },
                            {
                                "example_id": "708a0662-a166-4aa6-9616-006c389ea18b",
                                "sense_id": "dc9d3daa-5044-377b-b77f-e463f9a37abc",
                                "text": "Have recorded over a dozen specimens in which the macronucleus is unquestionably double. Not lobed, not pulverate, as in Oxytricha, but double!"
                            }
                        ]
                    }
