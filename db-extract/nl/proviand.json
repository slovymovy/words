                        "sense_id": "7cf22d5e-6f36-35bd-9efe-56267bf6a48b",
                        "entry_id": "f258cf4f-5a20-31ad-afed-d88b4fdb8d3c",
                        "glosses": [
                            "een hoeveelheid voedsel die genoeg is voor een langere tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "babea19b-d3bc-4904-a4a0-e41e2732e9e3",
                                "sense_id": "7cf22d5e-6f36-35bd-9efe-56267bf6a48b",
                                "text": "Om zijn investering terug te verdienen zal de nieuwe eigenaar de schepen weer snel in de vaart brengen. Zo profiteert niet alleen de ‘natte’ advocatuur maar de Rotterdamse haven in het algemeen: scheepsagenten voor het papierwerk, bevoorraders voor de proviand, bunkeraars voor de brandstof en werven voor eventuele reparaties en onderhoud."
                            },
                            {
                                "example_id": "bd1f2144-4779-4ae4-ac1f-3870d468394c",
                                "sense_id": "7cf22d5e-6f36-35bd-9efe-56267bf6a48b",
                                "text": "Op de elfde van deze maand heeft de regering het besluit genomen om wapens, vrijwilligers, materiaal en proviand naar Finland te sturen."
                            }
                        ]
                    }
