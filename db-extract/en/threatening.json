                                "target_senses": [
                                    {
                                        "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                        "entry_id": "71204558-c887-3602-a189-d959d3292b50",
                                        "glosses": [
                                            "(als etwas negatives) unmittelbar bevorstehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78c06523-6a0c-48a8-ad94-3411a0766704",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer drohenden Frühgeburt werden z. B. Beta-2-Sympathomimetika zur Muskelrelaxation der Gebärmutter eingesetzt.“"
                                            },
                                            {
                                                "example_id": "bf1ef0fe-064b-4ef8-a652-3ef4986d75dd",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Gegen Ende des 2. Weltkrieges prägten die Nationalsozialisten angesichts der drohenden Niederlage den Begriff Wunderwaffe und propagierten damit vor allem die siegbringende Wirkung der sogenannten V–Waffen (= »Vergeltungswaffen«).“"
                                            },
                                            {
                                                "example_id": "5a48b6e3-4de8-4ba7-ac95-ddf92cc1f3d8",
                                                "sense_id": "fb4c2f21-0e74-387b-b712-8e4d65d8bed1",
                                                "text": "„Bei einer Vitalindikation werden z. T. auch Maßnahmen ergriffen, die ohne die Lebensgefahr nicht angebracht wären, z. B. ein Luftröhrenschnitt bei drohendem Erstickungstod oder die Anwendung von Zytostatika bei einer akuten Leukämie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
