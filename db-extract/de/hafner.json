                        ],
                        "examples": [
                            {
                                "example_id": "00300d4d-db62-4d2b-9ab5-2b639f838694",
                                "sense_id": "e0154f2b-0d60-3fb2-82e6-1f94a8e9825a",
                                "text": "„Der Mai brachte kalte Tage, es mußte geheizt werden, der Ofen rauchte. Der Hafner kam, die Kacheln wurden entfernt, die Stube glich einer schmutzigen Hölle.“"
                            }
                        ],
