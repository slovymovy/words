                                                "sense_id": "4513d229-61fb-30cd-873b-da15ecfc8d2f",
                                                "text": "Konstantynopol to dawna stolica cesarstwa bizantyjskiego."
                                            },
                                            {
                                                "example_id": "44bc6b2b-07c8-406a-979a-417c7e50235d",
                                                "sense_id": "4513d229-61fb-30cd-873b-da15ecfc8d2f",
                                                "text": "Cesarz Konstantyn I Wielki przeniósł stolicę swego cesarstwa z Rzymu do Konstantynopola."
                                            },
                                            {
                                                "example_id": "3ec50dba-fab4-4f2e-8b2d-dac06befb026",
                                                "sense_id": "4513d229-61fb-30cd-873b-da15ecfc8d2f",
                                                "text": "To Odoaker obalił ostatniego cesarza zachodniorzymskiego, a insygnia cesarskie wysłał do Konstantynopola."
                                            }
