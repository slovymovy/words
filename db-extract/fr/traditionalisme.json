                        "tags": [
                            "Beaucoup moins courant"
                        ],
                        "form": "traditionnalisme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b995468f-4738-39d7-b09d-edd606a862e1",
                        "entry_id": "4eccdb7b-7e49-37af-a5a8-d84c0957c369",
                        "glosses": [
                            "Doctrine qui, dominée par le souci de l’élément traditionnel, conteste la part de l’élément rationnel dans l’acte de foi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3217adfa-b6e6-41a2-bb30-50b65af8e7b6",
                                "sense_id": "b995468f-4738-39d7-b09d-edd606a862e1",
                                "text": "À ce titre, il était de l’intérêt de l’« establishment » religieux de promouvoir et de défendre l’orthodoxie religieuse, l’éducation formaliste et un traditionalisme rigide sous prétexte de sauvegarder le caractère islamique de la communauté."
                            }
                        ]
                    },
                    {
                        "sense_id": "06a47326-c83e-3bf2-9f71-15651cb5f574",
                        "entry_id": "4eccdb7b-7e49-37af-a5a8-d84c0957c369",
                        "glosses": [
                            "Attachement aux idées, aux coutumes transmises par la tradition."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3eaa6ba0-436f-4284-acf3-f5c8fc2546f5",
                        "source_entry_id": "4eccdb7b-7e49-37af-a5a8-d84c0957c369",
