                    {
                        "sense_id": "64058534-fc41-37e6-ab47-aad96faed9e8",
                        "entry_id": "de47c34e-dee0-3ebb-b976-a060e8d3c223",
                        "glosses": [
                            "od: szkielet (kości)"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "5e39bf95-42af-4798-924a-f242ec133671",
                                "sense_id": "64058534-fc41-37e6-ab47-aad96faed9e8",
                                "text": "Jak godzą się te drapieżniki z bezbronnymi pingwinkami Adeli […]? Odpowiedź na to pytanie dają bielejące tu i ówdzie szkieleciki piskląt. Jedne oczyszczone dokładnie z mięsa, inne ledwie napoczęte z wyżartymi wnętrznościami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b93ae365-c6c0-310d-aebe-e900476d4984",
                        "entry_id": "de47c34e-dee0-3ebb-b976-a060e8d3c223",
                        "glosses": [
                            "od: szkielet (podstawa)"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "9e8fd64e-d152-4968-9b8b-75595d25d752",
                                "sense_id": "b93ae365-c6c0-310d-aebe-e900476d4984",
                                "text": "Na tym nędznym szkieleciku postanowiłem oprzeć ogromną obudowę historyczną dwudziestu lat niezwykle dramatycznych wydarzeń, których dokumentacja była już po wielekroć opisywana w dziełach naukowych i popularnych"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
