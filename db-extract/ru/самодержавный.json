                "senses": [
                    {
                        "sense_id": "03ce7e85-ba3f-34e3-a495-c336cff14838",
                        "entry_id": "3d8f06cb-ab68-319f-b7b8-54b54b291f8a",
                        "glosses": [
                            "обладающий неограниченной государственной властью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed38dcdc-b5b4-4b90-8e1e-82e46757ec89",
                                "sense_id": "03ce7e85-ba3f-34e3-a495-c336cff14838",
                                "text": "И все русские люди, начиная от придворного сановника и до последнего батрака, давно знали и знают теперь, что они повинуются одному и тому же Самодержавному Государю."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe8dca78-d106-30de-bc86-a6f34f97ec92",
                        "entry_id": "3d8f06cb-ab68-319f-b7b8-54b54b291f8a",
                        "glosses": [
                            "основанный на самодержавии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d263478-a3f7-438f-bf65-c00af98d1e21",
                                "sense_id": "fe8dca78-d106-30de-bc86-a6f34f97ec92",
                                "text": "Попытка Николая II после поражения сторонников самодержавной монархии в Думе усилить консервативное крыло Государственного совета не дала ожидаемых результатов: правые пребывали в глубокой апатии и максимум, что могли сделать, так это взывать к благоразумию общества."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fc35e6a-0ccd-4c8e-b12d-857038660db0",
                        "source_entry_id": "3d8f06cb-ab68-319f-b7b8-54b54b291f8a",
                        "target_lang_word": "autocratic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autocratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                        "entry_id": "10b537e5-5fa3-32be-9ca4-89d3ae517912",
                                        "glosses": [
                                            "Of or pertaining to autocracy or to an autocrat; absolute; holding independent and arbitrary powers of government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4cdc29b-e205-4b62-88bb-628a96efd9bf",
                                                "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                                "text": "In recent years, the prime minister has become increasingly autocratic."
                                            },
                                            {
                                                "example_id": "c732ec8c-2ce7-4a3d-8955-14705a458295",
                                                "sense_id": "fee04b45-382d-37ed-a06c-c68e37a7f767",
                                                "text": "Within democracies, nationalist leaders with autocratic impulses – from outgoing President Jair Bolsonaro in Brazil to presidential hopeful Marine Le Pen in France – have seen defeats in recent months."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                        "entry_id": "10b537e5-5fa3-32be-9ca4-89d3ae517912",
                                        "glosses": [
                                            "Of or pertaining to the manner of an autocrat."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25077508-20e0-46bf-9f28-e7c185032ae0",
                                                "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                                "text": "Despite his lack of actual authority, his autocratic demeanour annoyed many of his colleagues."
                                            },
                                            {
                                                "example_id": "95837aab-9e3d-4679-9873-e400f1d4ba31",
                                                "sense_id": "9bf97407-55f0-39a0-b4ab-40b4bb74a0ce",
                                                "text": "Donna became autocratic the day Daniel born, and she realized she had absolute power over another human being."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
