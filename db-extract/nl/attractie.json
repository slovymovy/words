                    },
                    {
                        "sense_id": "3ff2345a-fb26-3783-a838-d1f33d4a5174",
                        "entry_id": "e9828363-967c-3485-8853-627f1cec02fe",
                        "glosses": [
                            "iets wat aantrekkingskracht en/of een mogelijkheid tot vermaak uitoefent, vaak speciaal gericht op toeristen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8e1b36f-042f-4619-b557-04f50771005c",
                                "sense_id": "3ff2345a-fb26-3783-a838-d1f33d4a5174",
                                "text": "Toch blijft de Nationale 7 een mythisch traject, een Franse Route 66, aan een tweede leven begonnen als nostalgische attractie. 'De mensen willen terugkeren naar een gelukkige tijd', zegt Patrick Henriroux (55), patron van tweesterrenrestaurant La Pyramide in Vienne."
                            },
                            {
                                "example_id": "a834a73e-8514-4f82-b02f-05bbfe8da3d2",
                                "sense_id": "3ff2345a-fb26-3783-a838-d1f33d4a5174",
                                "text": "Fata Morgana is een van de attracties van de Efteling."
                            },
                            {
                                "example_id": "743e701b-4457-467f-9e20-772109e2c313",
                                "sense_id": "3ff2345a-fb26-3783-a838-d1f33d4a5174",
                                "text": "De vollemaan zorgde voor een natuurlijke verlichting, waardoor de meeste attracties in de gigantische tuin van Hotel Luxor tot in detail zichtbaar waren."
                            }
                        ]
                    },
                    {
                        "sense_id": "f60af554-38cf-3c06-8657-319524b50985",
                        "entry_id": "e9828363-967c-3485-8853-627f1cec02fe",
                        "glosses": [
