                    {
                        "sense_id": "5ceac20b-224e-33ca-9a87-ed65539434db",
                        "entry_id": "4dafa8ed-a06a-3280-acfe-8445a3c7d721",
                        "glosses": [
                            "Of, related to or connected with syntax."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a439b206-0bad-414f-9c6a-279499893944",
                                "sense_id": "5ceac20b-224e-33ca-9a87-ed65539434db",
                                "text": "The sentence “I saw he” contains a syntactic mistake."
                            },
                            {
                                "example_id": "2b5346c3-bfca-4638-a5a0-ac29e0ef0eef",
                                "sense_id": "5ceac20b-224e-33ca-9a87-ed65539434db",
                                "text": "the rules specifying how agglutinative morphemes are combined with each other are more syntactic than morphological by their nature and thus are closer to rules specifying how word-forms are combined with each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb3c4510-eb24-3d55-8b30-f7184c0b7ea3",
                        "entry_id": "4dafa8ed-a06a-3280-acfe-8445a3c7d721",
                        "glosses": [
                            "Containing morphemes that are combined in the same order as they would be if they were separate words e.g. greenfinch"
                        ],
                        "tags": [],
                        "examples": []
                    }
