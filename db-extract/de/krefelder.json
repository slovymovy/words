                    {
                        "sense_id": "41e7d7a3-a1fd-358b-9105-0e36cde3dad3",
                        "entry_id": "37396ba2-7e93-34ec-bfeb-995294e6f9f2",
                        "glosses": [
                            "Bewohner von Krefeld, jemand, der aus Krefeld stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad712791-2e51-4fd8-b924-3b82e8e10c4e",
                                "sense_id": "41e7d7a3-a1fd-358b-9105-0e36cde3dad3",
                                "text": "Mein Wohnungsnachbar ist ein gebürtiger Krefelder."
                            },
                            {
                                "example_id": "87587dc6-922a-4d20-a621-4be173478d34",
                                "sense_id": "41e7d7a3-a1fd-358b-9105-0e36cde3dad3",
                                "text": "„Der weit bekannte Spruch ‚Es gibt Gute, Böse und Krefelder‘ enthält im Kern eine begründete Aussage. Die Krefelder empfinden und erleben ihre Kultur und Gesellschaft, ihre Mentalität und ihre Atmosphäre als etwas Besonderes, in dem sie sich wohlfühlen und deren Bestand sie jederzeit verteidigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
