                ],
                "senses": [
                    {
                        "sense_id": "bc7068aa-30e3-3856-9373-8247237cffc6",
                        "entry_id": "5c01464d-5292-39c2-bd28-542e62fb67c1",
                        "glosses": [
                            "einer der freien Dative; er drückt die Zugehörigkeit einer Person oder Sache zu jemandem aus"
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "0e73de6e-19ad-43df-a2d1-a5a36f4b4a0b",
                                "sense_id": "bc7068aa-30e3-3856-9373-8247237cffc6",
                                "text": "In dem Satz \"Er tippte ihr auf die Schulter\" ist \"ihr\" ein Pertinenzdativ und damit ein freier Dativ; mit \"ihr\" wird die Person bezeichnet, der die Schulter gehört."
                            },
                            {
                                "example_id": "1684cd96-e688-4dd9-a9b8-bf53e144f683",
                                "sense_id": "bc7068aa-30e3-3856-9373-8247237cffc6",
                                "text": "„Zu den angeblich »freien Dativen« werden vielfach auch der Dativus ethicus und der Pertinenzdativ gerechnet.“"
                            },
                            {
                                "example_id": "f699b739-0921-4013-ad22-d8f89fa5e927",
                                "sense_id": "bc7068aa-30e3-3856-9373-8247237cffc6",
                                "text": "„Bei einem Teil-Ganzes-Verhältnis wird der Pertinenzdativ verwendet. Beispiele: Ich wählte mir die Finger wund…“"
                            },
                            {
                                "example_id": "7599a4b6-38b0-43f7-b02d-4f7bd730fcc3",
                                "sense_id": "bc7068aa-30e3-3856-9373-8247237cffc6",
                                "text": "„Die Pertinenzdative, die Genitivkonstruktionen ersetzen, wurden oben angesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
