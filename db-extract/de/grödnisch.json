                "senses": [
                    {
                        "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                        "entry_id": "4b452a72-484b-3ddf-ad6e-3e2822a5a552",
                        "glosses": [
                            "Dialekt des Ladinischen; Grödnerisch"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "27ff1dca-1092-4199-b3c6-66af9e0e00ef",
                                "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                                "text": "„Die vier Täler, die direkt an die Sella-Gruppe grenzen […], sind diese: Im Norden das Gadertal […] – dort spricht man Gadertalisch, […]. Im Westen liegt Gröden, wo man Grödnerisch oder Grödnisch (gherdëina) spricht, […].“"
                            },
                            {
                                "example_id": "e98cefc2-3c56-49eb-b3ea-9b0f7674b4b7",
                                "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                                "text": "„[…] [ich] kann […] mir kaum eine andere romanische Sprache vorstellen, die über so viele Spielarten der Negation und der Negationsabtönung verfügt wie das Dolomitenladinische und hier vielleicht ganz besonders das Grödnische.“"
                            },
                            {
                                "example_id": "72e0f9aa-3f14-48f8-bc2c-f38c7a94d0b9",
                                "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                                "text": "„Der Wandel v- zu b- kann zwar im Fassanischen des Öfteren beobachtet werden […], gilt aber nicht in gleicher Weise für das Grödnische.“"
                            },
                            {
                                "example_id": "5e3ff4df-e2f2-4a74-8dbd-f9cdfb3b18a9",
                                "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                                "text": "„[…] im Grödnischen (wie auch im Fassanischen) ist vlat. offenes ę in geschlossenes übergegangen, […].“"
                            },
                            {
                                "example_id": "0206714f-da4f-484a-baed-9a25db42b390",
                                "sense_id": "9c29b5ac-f116-3af4-985d-7d65860abc7a",
                                "text": "„Als um 1790 der Grödner Josef Senoner in der Klosterküche von Muster / Disentis arbeitete, wunderte sich Pater Piaci Spescha (geb. in Trun / Surselva […]) über die große Ähnlichkeit des Grödnischen mit dem Bündnerromanischen; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
