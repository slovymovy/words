                "senses": [
                    {
                        "sense_id": "17a548a3-c364-3562-b36e-5296bf09a473",
                        "entry_id": "32e1eed8-058e-3342-9dc9-4f215c3f4c6a",
                        "glosses": [
                            "To feature alongside; to present as a cofeature."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4524907e-15db-4c9e-8299-6b2b6127e807",
                                "sense_id": "17a548a3-c364-3562-b36e-5296bf09a473",
                                "text": "Thus, if a chuck roast were featured at 49₵ a pound, meat managers in both stores would be instructed to cofeature \"Yankee\" pot roast, chuck arm or \"California\" roast —all products from the same basic chuck."
                            },
                            {
                                "example_id": "6a0bd0fb-4ab0-481a-95da-4ba6e4d156da",
                                "sense_id": "17a548a3-c364-3562-b36e-5296bf09a473",
                                "text": "Elaine de Kooning used the occasion of the show to cofeature Dickinson's work in an article, \"The Modern Museum's Fifteen: Dickinson and Kiesler,\" that appeared the month of the exhibition."
                            },
                            {
                                "example_id": "b179f300-35e9-4826-8c29-a97b075d98ab",
                                "sense_id": "17a548a3-c364-3562-b36e-5296bf09a473",
                                "text": "Moreover, the band's book was written to cofeature Tommy's trombone."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b1b1340-f8da-3135-9e22-5fed03f5429b",
                        "entry_id": "32e1eed8-058e-3342-9dc9-4f215c3f4c6a",
                        "glosses": [
                            "To be presented as a cofeature."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4a9cfa05-2a58-4aca-8855-3a638b6ffdb7",
                                "sense_id": "8b1b1340-f8da-3135-9e22-5fed03f5429b",
                                "text": "In the interim, the opportunity had arisen for Pirates to cofeature with surefire Columbia winner Mysterious Island, and the film was sent back to the Board for further pasteurization."
                            }
                        ]
                    }
