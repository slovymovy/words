                        "glosses": [
                            "Parapublic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc0cd18-3b54-47a6-9421-3764c7fa034d",
                                "sense_id": "ac5ac51f-4dc8-3d04-9f9b-9fb2cd36abd1",
                                "text": "Dimoke Mulamba et Tabu Olonda seront par ailleurs privés du droit de voter, d’être élu ou d’accéder à une quelconque fonction publique ou paraétatique durant les cinq années qui suivront l’expiration de leur peine."
                            },
                            {
                                "example_id": "0bb6d81a-cfa1-451d-bd1a-77b6e955a7a2",
                                "sense_id": "ac5ac51f-4dc8-3d04-9f9b-9fb2cd36abd1",
                                "text": "Cette structure paraétatique, créée un an plus tôt, a été curieusement placée sous la tutelle du ministre de l’Économie, qui s’est empressé d’en confier la présidence à Olivier Ginon."
                            }
                        ]
