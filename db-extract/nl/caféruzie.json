                        "glosses": [
                            "een conflict in een horecagelegenheid waarbij vaak alcoholgebruik in het spel is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f07230-1567-4b11-b4ef-f821980ab618",
                                "sense_id": "748da26f-75d2-331f-9b67-48b418aeb4cf",
                                "text": "In Mol in de Antwerpse Kempen is in de nacht van zaterdag op zondag een dode gevallen bij een steekpartij tijdens een caféruzie. Dat zegt de Turnhoutse afdeling van het parket van Antwerpen. Het slachtoffer is een 28-jarige man uit Neerpelt."
                            },
                            {
                                "example_id": "31fa05e4-fe4d-400d-a259-cfbeba664e6a",
                                "sense_id": "748da26f-75d2-331f-9b67-48b418aeb4cf",
                                "text": "Tijdens een caféruzie in Eben-Emael (Bassenge, provincie Luik) is woensdagavond een 29-jarige man om het leven gekomen. De inwoner van Bassenge, pal aan de taalgrens, werd doodgestoken door de ex-vriend van zijn nieuwe vriendin. Verschillende bronnen bevestigen zo donderdag de informatie uit de krant La Dernière Heure."
                            }
                        ]
                    }
