                "senses": [
                    {
                        "sense_id": "65864734-6cdb-3cfe-aa8f-f4986bbf3366",
                        "entry_id": "01a13f60-8d40-37d1-825e-ff0b2d54045a",
                        "glosses": [
                            "zum Essen bestimmtes mit Geschmacksstoffen versetztes gefrorenes Wasser"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fa44213-fbd7-4568-818c-51d8259f3b85",
                        "source_entry_id": "01a13f60-8d40-37d1-825e-ff0b2d54045a",
                        "source_sense_id": "65864734-6cdb-3cfe-aa8f-f4986bbf3366",
                        "source_sense_description": "Schweiz: zum Essen bestimmtes mit Geschmacksstoffen versetztes gefrorenes Wasser",
                        "target_lang_word": "glace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "ou Eau à l’état solide."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad7dcb0e-1e34-46e4-9589-ff2c5f66d535",
                                                "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                                "text": "Cette glace fondait un tantinet à midi mais regelait le soir, et, chaque matin, on commençait par la repolir avec amour."
                                            },
                                            {
                                                "example_id": "250ec1e6-81b9-4fd6-9f0d-ae32501c42da",
                                                "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                                "text": "Les glaces de la mer Blanche n’avaient que peu de rapports avec celles de la banquise, et les cargos étaient précédés et convoyés par de remarquables « brise-glaces »."
                                            },
                                            {
                                                "example_id": "6ad35d34-67e1-445c-a5e9-f7fb474eba9a",
                                                "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                                "text": "Quand éclata la masse, Alexis était debout sur la falaise, et, riant, montrait le bois qui se culbutait dans la rivière comme les glaces dans le bouscueil du printemps."
                                            },
                                            {
                                                "example_id": "394e6bd7-c21c-4e74-a6bf-681bc38c0566",
                                                "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                                "text": "Je m'explique: nos usines cédulent le départ et l'arrivée des bateaux, leur fournissant la quantité de glace nécessaire pour qu'ils rapportent le poisson dans le meilleur état de fraîcheur possible."
                                            },
                                            {
                                                "example_id": "0ab3d478-b898-4dd7-86af-38e65e26eba2",
                                                "sense_id": "087cefae-8899-3001-8086-61f21f611cbd",
                                                "text": "En plus des glaces cristallines, il existe aussi trois polymorphes de glace amorphe dans le domaine des faibles températures et basse pression."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5022e5a-3b3c-36ca-9f5c-cb5e9ba51557",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Zéro degré Celsius, température de l’eau qui gèle."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7de572d-19ce-4536-9387-01d8eed7640a",
                                                "sense_id": "c5022e5a-3b3c-36ca-9f5c-cb5e9ba51557",
                                                "text": "Le thermomètre est à glace."
                                            },
                                            {
                                                "example_id": "9fea3c49-6069-418a-9b90-4a0841485597",
                                                "sense_id": "c5022e5a-3b3c-36ca-9f5c-cb5e9ba51557",
                                                "text": "Vin de glace, vin dont on a vendangé les raisins alors qu’il avait commencé à geler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Table de verre blanc de dimension quelconque et d'une égale épaisseur, dont les deux faces sont polies, et qui, au moyen de l’étain préparé appliqué sur une des faces, reflète fidèlement l’image des objets. En termes de miroiterie, un miroir est une glace de petite taille."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b977c51-ec15-431e-9b2e-c72633539d44",
                                                "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                                "text": "De petits miroirs, unis l’un à l’autre par des ornements d’argent, simulaient une glace entière, perfection alors inconnue, et multipliaient partout leurs facettes étincelantes."
                                            },
                                            {
                                                "example_id": "c21f60d5-08fd-490f-b89d-63052a078262",
                                                "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                                "text": "Il humecta une main-éponge, se baigna le visage, et s’observa un instant, dans la glace."
                                            },
                                            {
                                                "example_id": "57b488b6-0c4c-470b-bca4-575262153656",
                                                "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                                "text": "Une glace munie d’une tablette en bois blanc se trouvait fixée contre un des murs et éclairée par deux ampoules sans abat-jour."
                                            },
                                            {
                                                "example_id": "a23c7d83-b991-454c-a589-7aad0001d9f1",
                                                "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                                "text": "Elle disposa les fleurs au chevet, fit arrêter le balancier de l’horloge, voiler les glaces et les miroirs, fermer les fenêtres et cacher les portraits."
                                            },
                                            {
                                                "example_id": "00645474-ffa7-45c6-b74f-77014cf897ae",
                                                "sense_id": "cb5dcf4f-8eb5-32da-beea-bef2b3781f97",
                                                "text": "Les glaces d’un appartement sont censées mises à perpétuelle demeure lorsque le parquet sur lequel elles sont attachées fait corps avec la boiserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "213b2d93-617d-3ba8-aa5c-999ce6e78224",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Miroir portatif."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ef594a-47a6-49d0-8bc8-ece6b91f91be",
                                                "sense_id": "213b2d93-617d-3ba8-aa5c-999ce6e78224",
                                                "text": "Un cantinier qui se rase sur l’accotement, sa glace pendue à un cerisier, attend avec nervosité, la figure débordant de mousse, que nous ayons fini de faire trembler la route."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "873d5783-ce19-38bf-bbb9-b9711ce4dfc1",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Vitrage."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f1dff3-ce1d-4123-8355-1d66b3b64634",
                                                "sense_id": "873d5783-ce19-38bf-bbb9-b9711ce4dfc1",
                                                "text": "Ils guignaient depuis longtemps, pour leur nouvelle installation, […], une petite boutique, en forme de hangar, avec une vitrine d’une seule glace et une unique pièce sur le derrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eec30ca1-fb95-3ad8-9fa1-070d8096a777",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Crème glacée, en général aromatisée aux fruits et servie à la fin d’un repas ou comme rafraîchissement."
                                        ],
                                        "tags": [
                                            "France",
                                            "Viêt Nam",
                                            "Cambodge",
                                            "Laos",
                                            "Algérie",
                                            "Maroc",
                                            "Tunisie",
                                            "Nouvelle-Calédonie",
                                            "La Réunion",
                                            "Afrique de l’Ouest"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e8a1ccc-b3ce-4854-ba9e-c0072b1d7138",
                                                "sense_id": "eec30ca1-fb95-3ad8-9fa1-070d8096a777",
                                                "text": "— Vous ne pouvez pas prendre votre glace, et vous avez peur qu’elle ne se fonde, dit madame Leuwen. Quelle situation pour un gourmand !\n— Et je meurs de peur de regretter ma glace quand elle sera fondue."
                                            },
                                            {
                                                "example_id": "b28c8897-6db4-4d4a-a144-db017dac6765",
                                                "sense_id": "eec30ca1-fb95-3ad8-9fa1-070d8096a777",
                                                "text": "Mais pourquoi donc ? Parce que les carences en fer accompagnées d’anémie entraînent fréquemment un comportement que l’on appelle le « pica ». Il se traduit, huit fois sur dix par une… pagophagie, ce qui signifie une absorption massive de glaces ; glaçons en cube, et non pas des glaces en cornet."
                                            },
                                            {
                                                "example_id": "05f6e758-e18c-4a80-9bb6-191c812a800b",
                                                "sense_id": "eec30ca1-fb95-3ad8-9fa1-070d8096a777",
                                                "text": "À dix-sept heures, comme un grand nombre d’amoureuses locales, je reçus un kori à la grenadine. Je croquai la glace pilée et colorée avec enthousiasme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ef0fe3d-9492-3e19-a06e-1a22832cd030",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Préparation servant à napper, à réaliser le glaçage d’un mets, → voir demi-glace."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cdc5706-d572-43e1-a9cc-64fa3686f0e0",
                                                "sense_id": "2ef0fe3d-9492-3e19-a06e-1a22832cd030",
                                                "text": "Nappez les pâtisseries avec une glace de blanc d’œuf sucré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6562e124-545b-36aa-9d2b-74cd17616f1e",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Petite tache d’un diamant."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7568218-1c55-3ce7-95e5-13c3d4e30208",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Nom donné au XVIIIᵉ siècle à certains brocarts d’or ou d’argent d’aspect lisse comme un miroir."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e8fb6882-66d0-37df-bf02-7a7d87a07d55",
                                        "entry_id": "bb04f1ba-b7b5-373b-afe7-b060c3974457",
                                        "glosses": [
                                            "Aire elle-même, sur laquelle évoluent les joueurs de hockey."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
