                "senses": [
                    {
                        "sense_id": "223f0150-4045-3df6-88a0-2ba8ac56c10a",
                        "entry_id": "b19938ad-087e-34f8-9eec-7351cb542a87",
                        "glosses": [
                            "Ulcération blanchâtre, cernée de tissus inflammatoires rouges, allant de superficielle à nécrosante et siégeant sur les muqueuses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cf2066a-2d5f-4027-962c-adac172fbc78",
                                "sense_id": "223f0150-4045-3df6-88a0-2ba8ac56c10a",
                                "text": "Un aphte est une ulcération douloureuse à lʼemporte-pièce, au fond blanchâtre, entouré dʼun liséré inflammatoire."
                            },
                            {
                                "example_id": "217dd788-24fd-453b-89bd-cf378e09a2f8",
                                "sense_id": "223f0150-4045-3df6-88a0-2ba8ac56c10a",
                                "text": "J'aime pas beaucoup les noix, ça se coince entre les dents et ça donne des aphtes."
                            },
                            {
                                "example_id": "c63fc600-d7b4-4122-8cf0-8d100840e3ba",
                                "sense_id": "223f0150-4045-3df6-88a0-2ba8ac56c10a",
                                "text": "Il existe trois types d'aphtes : 1/ Les aphtes buccaux vulgaires; 1/ Les aphtes buccaux récidivants, pouvant signer une stomatite aphteuse récidivante ; 1/ Les aphtes buccaux associés à des aphtes génitaux ou oculaires, pouvant être l'expression d'une maladie aphteuse"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "337c5216-93fb-446f-9702-a98689a2d37c",
                        "source_entry_id": "b19938ad-087e-34f8-9eec-7351cb542a87",
