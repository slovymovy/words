                                        "entry_id": "9523b7ce-130a-3165-ab43-85c4a1641349",
                                        "glosses": [
                                            "To focus automatically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0df15a6-55f7-4aef-a146-fa1d48c5181a",
                                                "sense_id": "c1b48812-4e5d-3a70-b9b4-1749c9f4c9c6",
                                                "text": "My camera makes a funny sound when it autofocuses."
