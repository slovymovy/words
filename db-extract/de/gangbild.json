                "senses": [
                    {
                        "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                        "entry_id": "344b3b49-157a-3039-ad27-72ed31742652",
                        "glosses": [
                            "Gesamtheit der beim Gehen durchgeführten Bewegungen der Gliedmaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "befd4f7f-f743-4193-a38f-d6b8723aa8af",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„Häufig sind Menschen mit Down-Syndrom im Alltag bereits an ihrem Gangbild und ihrer Haltung zu erkennen.“"
                            },
                            {
                                "example_id": "b0ec5a60-6800-4daf-9c1e-a853ec8f3f44",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„Mit etwas Übung kann selbst am Gangbild und der damit verbundenen Körperhaltung einer Person, einiges Interessantes abgeleitet werden.“"
                            },
                            {
                                "example_id": "6942ff14-5217-4092-80ae-23b6dda41403",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„In diesen Fällen ist das Gangbild betont langsam, kleinschrittig und vorsichtig, als würde der Patient auf Eis gehen […].“"
                            },
                            {
                                "example_id": "3a69bb24-21ba-4720-8a42-4d492a6668b1",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„Betritt ein Mensch einen Raum, erzählt sein Gangbild so ziemlich alles über seine Verbindung zur Welt und über sein Vertrauen ins Universum.“"
                            },
                            {
                                "example_id": "76e8b6e4-cd44-41fb-a6df-767ce81d7c5c",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„Bei der Besprechung des Gangbildes soll der Einfachheit halber auf alle rotierenden Bewegungen in Becken und Knie, denen solche am Fuß entsprechen, verzichtet werden.“"
                            },
                            {
                                "example_id": "5078f07d-ea58-492d-a5f7-5e4020123882",
                                "sense_id": "f31208d9-3ac2-3f03-86a0-8b763ffc41ce",
                                "text": "„An den Fussabdrücken, am Gangbilde kommt der hinkende Gang zum unverkennbaren Ausdruck in der Ungleichheit der Spurenweite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
