                "senses": [
                    {
                        "sense_id": "891b02c5-2cef-39a2-9fd3-06372b5cd931",
                        "entry_id": "90f3d48b-44c8-3d01-b38d-c6308e2ebe37",
                        "glosses": [
                            "erzeugter Unterdruck (Kraft), mit dem Jemand oder Etwas saugt und so in sich hinein befördert (zieht); Saugleistung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa3ac0de-6ee1-482d-9aea-5fdd17251a70",
                                "sense_id": "891b02c5-2cef-39a2-9fd3-06372b5cd931",
                                "text": "„Während auf Fliesen, Linoleum und Parkett oft eine Leistung von 500 Watt vollkommen ausreicht, wird bei einem Teppich mehr Saugkraft benötigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "60bb23e7-d230-3fd9-9998-7e1ac7bc61d2",
                        "entry_id": "90f3d48b-44c8-3d01-b38d-c6308e2ebe37",
                        "glosses": [
                            "erzeugter Unterdruck (Kraft), mit dem Jemand oder Etwas saugt und so an sich heran befördert (zieht); Saugvermögen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a6e3b9-348e-4027-8100-8b4badeb668d",
                                "sense_id": "60bb23e7-d230-3fd9-9998-7e1ac7bc61d2",
                                "text": "„Die Saugkraft jedes einzelnen (Saugnapfes) kann individuell reguliert werden und extreme Unterdrücke erzeugen, die sogar technische Vakuumsysteme übertreffen.“"
                            },
                            {
                                "example_id": "f3d95d99-3bfb-4c3e-9f4d-af1243431434",
                                "sense_id": "60bb23e7-d230-3fd9-9998-7e1ac7bc61d2",
                                "text": "„Für die Saugkraft sind einerseits die Höhe des Unterdrucks und andererseits der Volumenstrom entscheidend, der den Unterdruck aufbaut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
