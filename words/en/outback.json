                {
                    "sense_id": "4223bf40-3e71-3d66-80a8-f10ef5fba433",
                    "sense_definition": "The remote, vast, and sparsely populated inland regions of Australia.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent three weeks driving through the Australian <w>outback</w>.",
                            "target_lang_translations": {
                                "tr": "Avustralya'nın <w>iç bölgelerinde</w> arabayla üç hafta geçirdiler."
                            }
                        },
                        {
                            "text": "Life in the <w>outback</w> requires resilience due to extreme weather and long distances between towns.",
                            "target_lang_translations": {
                                "tr": "<w>İç bölgelerde</w> yaşam, aşırı hava koşulları ve şehirler arasındaki uzun mesafeler nedeniyle dayanıklılık gerektirir."
                            }
                        }
                    ],
                    "synonyms": [
                        "bush",
                        "hinterland"
                    ],
                    "common_phrases": [
                        "Australian outback",
                        "in the outback"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Avustralya'nın ücra, geniş ve nüfusu az olan iç bölgeleri."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "outback",
                                "target_lang_sense_clarification": "Avustralya'nın iç ve ücra bölgeleri"
                            },
                            {
                                "target_lang_word": "iç bölgeler",
                                "target_lang_sense_clarification": "yerleşimden uzak iç kesimler"
                            }
                        ]
                    }
                }
            ]
        },
        {
