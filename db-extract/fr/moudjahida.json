                        "entry_id": "11bb5bf2-b0ae-397a-b75f-bce34187e5c3",
                        "glosses": [
                            "Combattante de la guerre de libération de l’Algérie de 1954 à 1962."
                        ],
                        "tags": [
                            "Algérie"
                        ],
                        "examples": [
                            {
                                "example_id": "dce92e26-0280-4f21-ba04-13e07c267f67",
                                "sense_id": "da1bd4da-b75b-38f7-a8e8-24fd835a752d",
                                "text": "En fait, Jacqueline, moudjahida, doyenne des condamnées à mort, toujours égale à elle-même s’est jurée de refuser l’inacceptable et de faire reculer les murs."
                            },
                            {
                                "example_id": "d5e3fa88-6614-4f87-b87d-eb2d2d10af99",
                                "sense_id": "da1bd4da-b75b-38f7-a8e8-24fd835a752d",
                                "text": "Tels ont été les thèmes qui devaient nourrir le débat auquel ont pris part Djamila Amrane, historienne et moudjahida, une ancienne infirmière de la Wilaya III, Baya Outata, et d’autres moudjahidate."
                            }
                        ]
                    }
