    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bb4ed0a-35e6-3298-be4f-ef124c94719f",
                    "sense_definition": "Een begin maken met iets of het moment waarop iets start.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voorstelling zal precies om acht uur <w>aanvangen</w>.",
                            "target_lang_translations": {
                                "en": "The performance will <w>commence</w> exactly at eight o'clock.",
                                "fr": "La représentation <w>commencera</w> exactement à huit heures."
                            }
                        },
                        {
                            "text": "Het nieuwe schooljaar zal dit jaar een maand later <w>aanvangen</w>.",
                            "target_lang_translations": {
                                "en": "The new school year will <w>begin</w> a month later this year.",
                                "fr": "La nouvelle année scolaire <w>débutera</w> un mois plus tard cette année."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginnen",
                        "starten",
                        "aanbreken"
                    ],
                    "antonyms": [
                        "eindigen",
                        "ophouden",
                        "stoppen"
                    ],
                    "common_phrases": [
                        "een maand later aanvangen",
                        "de werkzaamheden aanvangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To make a beginning with something or the moment at which something starts.",
                        "fr": "Commencer quelque chose ou le moment où quelque chose débute."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commence",
                                "target_lang_sense_clarification": "formal, to begin or start"
                            },
                            {
                                "target_lang_word": "begin",
                                "target_lang_sense_clarification": "to start or initiate"
                            },
                            {
                                "target_lang_word": "start",
                                "target_lang_sense_clarification": "to begin an event or process"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "commencer",
                                "target_lang_sense_clarification": "verbe général pour indiquer le début d'une action ou d'un événement"
                            },
                            {
                                "target_lang_word": "débuter",
                                "target_lang_sense_clarification": "indique le commencement d'une période ou d'une activité"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cdc6880-152a-3022-8cdb-c75b5c17f157",
                    "sense_definition": "Actief beginnen met het uitvoeren van een taak of werkzaamheid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hebben de werkzaamheden aan het spoor meteen <w>aangevangen</w>.",
                            "target_lang_translations": {
                                "en": "We <w>commenced</w> the work on the railway immediately.",
                                "fr": "Nous avons immédiatement <w>entrepris</w> les travaux sur la voie ferrée."
                            }
                        },
                        {
                            "text": "Zodra de zon opkwam, <w>vingen</w> de boeren hun werk op het land <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "As soon as the sun rose, the farmers <w>started</w> their work on the land.",
                                "fr": "Dès que le soleil s'est levé, les fermiers ont <w>commencé</w> leur travail dans les champs."
                            }
                        }
                    ],
                    "synonyms": [
                        "starten",
                        "aanpakken",
                        "ondernemen"
                    ],
                    "antonyms": [
                        "voltooien",
                        "afronden"
                    ],
                    "common_phrases": [
                        "werkzaamheden aanvangen",
                        "meteen aanvangen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To actively begin performing a task or activity.",
                        "fr": "Commencer activement à exécuter une tâche ou une activité."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "commence",
