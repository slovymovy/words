                                "target_senses": [
                                    {
                                        "sense_id": "03a9283a-ffb4-3614-b815-ace3e16e0534",
                                        "entry_id": "591b1e35-da32-3243-a628-58e6f035414d",
                                        "glosses": [
                                            "Schicht aus Nervenzellen im Inneren des Auges, die Lichtimpulse in Nervenimpulse umwandelt und diese an das Gehirn leitet, womit Sehen ermöglicht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c20f416-c1ba-40bb-b4c1-a34c78fb73ad",
                                                "sense_id": "03a9283a-ffb4-3614-b815-ace3e16e0534",
                                                "text": "Die Netzhaut enthält Photorezeptoren, Stäbchen für das Hell-dunkel- und Zapfen für das Farbsehen."
                                            },
                                            {
                                                "example_id": "ac61fdc8-bb98-43ed-9976-deec15bf6eaf",
                                                "sense_id": "03a9283a-ffb4-3614-b815-ace3e16e0534",
                                                "text": "„Die Forscher erhoffen sich für die Zukunft, Blinden mit krankhaft geschädigter Netzhaut durch Silizium-Sehprothesen wieder zum Sehen zu verhelfen.“"
                                            },
                                            {
                                                "example_id": "b8873dfd-a595-4a34-b014-24c79ca21e09",
                                                "sense_id": "03a9283a-ffb4-3614-b815-ace3e16e0534",
                                                "text": "„Das Muster und die Farben scheinen sich auf die Netzhaut zu brennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
