                    {
                        "sense_id": "cecb2705-e3f4-3232-bfbf-ba52ca2b54e8",
                        "entry_id": "525282e2-c38a-3ba6-8f92-02e4a713ab67",
                        "glosses": [
                            "A listing of people who have died during a specific period of time."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "38e9a983-9f75-48d6-a919-ed7b80c68254",
                                "sense_id": "cecb2705-e3f4-3232-bfbf-ba52ca2b54e8",
                                "text": "Voltaire and Rousseau died in 1778, d'Alembert in 1783, and Diderot in 1784, while leading salonnières Mesdames du Deffand and d'Épinay passed away in 1780 and 1783. Beneath this sombre necrology, important shifts were occurring in the workings of the public sphere and in the sites in which opinion was constructed."
                            },
                            {
                                "example_id": "3d9dcd5e-1573-43f5-8812-d008ce2f1539",
                                "sense_id": "cecb2705-e3f4-3232-bfbf-ba52ca2b54e8",
                                "text": "2006 Marc Fisher; We Loved That Airline To Death; Washington Post\nThe fare structure is one reason Independence Air has joined a necrology of low-cost carriers that stretches over four decades."
                            }
                        ]
                    },
