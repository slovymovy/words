                "senses": [
                    {
                        "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                        "entry_id": "7c573b2c-9ea5-35e3-8074-8c36dda26671",
                        "glosses": [
                            "D'une couleur semblable à celle de l'émeraude."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "note": "Cet adjectif est surtout utilisé dans la nomenclature zoologique",
                        "examples": [
                            {
                                "example_id": "8175fac8-87ed-4594-aac2-3783122fed3b",
                                "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                                "text": "[…], & le mettez en lieu froid, & se formeront de beaux cristaux émeraudins , vuidez par inclination le menstrue resté , faites évaporer & cristaliser comme devant, tant que vous ayez le vitriol du verdet en couleur d'émeraude, […]."
                            },
                            {
                                "example_id": "ae14c196-8d58-4903-8e5a-ff3b7402f074",
                                "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                                "text": "Mâle: Bec assez long, droit, aigu; calotte bleue; corps en dessus d'un vert doré; parties inférieures d'un vert émeraudin; bas-ventre gris; rectrices bleu d'acier."
                            },
                            {
                                "example_id": "ad624018-1a6a-4c2a-ba2e-a544e076a807",
                                "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                                "text": "Le mâle a le plumage noir de velours, à reflets pourpres ; la gorge recouverte d'un plastron échancré vert émeraude; la tête écailleuse et émeraudine; les plumes des flancs lâches, violet ponceau, et frangées de cuivre."
                            },
                            {
                                "example_id": "2376b91a-69ff-462f-a36d-c6f692e9c55e",
                                "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                                "text": "Dans les cheveux émeraudins des oliviers,\nLes cigales riaient."
                            },
                            {
                                "example_id": "f28ed488-fc85-4118-8ae1-e0df77819ae1",
                                "sense_id": "93bcf9cc-ebb5-3ccb-8d89-b82663b1b833",
                                "text": "Le même nid sert pour plusieurs couvées. La couleur des petits est d'abord d'un vineux grisâtre avec des raies fauves comme maillées. Les taches émeraudines n'apparaissent que dans la livrée adulte."
                            }
                        ]
                    }
