                "senses": [
                    {
                        "sense_id": "b7b2809c-55ab-31cd-9a82-07804a68ab60",
                        "entry_id": "d1f6390d-c958-36dc-9abd-3a7462935a1d",
                        "glosses": [
                            "грузовик ГАЗ-66"
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b08e29b5-eb17-4dc3-9b5f-0caccae635bd",
                                "sense_id": "b7b2809c-55ab-31cd-9a82-07804a68ab60",
                                "text": "Мы дошли до того места, где в прошлый раз встретили застрявших на шишиге мужиков."
                            }
                        ]
                    },
                    {
                        "sense_id": "41828ce9-35ed-30af-93eb-c9d6c5826956",
                        "entry_id": "d1f6390d-c958-36dc-9abd-3a7462935a1d",
                        "glosses": [
                            "устар. нечистый, сатана, бес, чёрт; злой кикимора или домовой, нечистая сила, которого обычно поселяют в овине; овинный домовой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea8a0e1-4715-4c9f-8f84-8b47ecba1311",
                                "sense_id": "41828ce9-35ed-30af-93eb-c9d6c5826956",
                                "text": "Шишига свадьбу играет"
                            },
                            {
                                "example_id": "8d8059cd-5281-40f6-b7dd-3238b643f103",
                                "sense_id": "41828ce9-35ed-30af-93eb-c9d6c5826956",
                                "text": "Шишига его смутил."
                            },
                            {
                                "example_id": "67aa4b73-11e3-4526-9180-b030cbdf3915",
                                "sense_id": "41828ce9-35ed-30af-93eb-c9d6c5826956",
                                "text": "Так из лесу любая шишига выйдет, скажет, что брат, а сама потом косточки обгложет."
                            }
                        ]
                    },
                    {
                        "sense_id": "905d2554-5f18-3f00-9937-07a4a99df072",
                        "entry_id": "d1f6390d-c958-36dc-9abd-3a7462935a1d",
                        "glosses": [
                            "устар., рег. (вят.) шиш, праздный шалопай"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
