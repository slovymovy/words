                                "target_lang_word": "正派",
                                "target_lang_sense_clarification": "品行端正"
                            },
                            {
                                "target_lang_word": "体面",
                                "target_lang_sense_clarification": "有教养，合乎礼节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a88a85cc-4168-3f9e-bc20-7c8f43f905c0",
                    "sense_definition": "Of a sufficiently large or significant size or amount.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality_quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent a <w>decent</w> amount of time working on this project.",
                            "target_lang_translations": {
                                "ru": "Мы потратили <w>прили́чное</w> количество времени на работу над этим проектом.",
                                "zh": "我们花在项目上的时间<w>相当</w>多。"
                            }
                        },
                        {
                            "text": "There is a <w>decent</w> chance that we will win the game.",
                            "target_lang_translations": {
                                "ru": "Есть <w>неплохо́й</w> шанс, что мы выиграем игру.",
                                "zh": "我们有<w>相当</w>大的机会赢得比赛。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "decent amount",
                        "decent size",
                        "decent number"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно большого или значительного размера или количества.",
                        "zh": "数量或规模足够大或相当可观。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прили́чный",
                                "target_lang_sense_clarification": "значительный"
                            },
                            {
                                "target_lang_word": "соли́дный",
                                "target_lang_sense_clarification": "большой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相当",
                                "target_lang_sense_clarification": "程度或数量可观"
                            },
                            {
                                "target_lang_word": "可观",
                                "target_lang_sense_clarification": "数量大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2fef27f-89c2-3c11-bda5-f9e4d0f5efc7",
                    "sense_definition": "Wearing enough clothes to be seen by other people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wait a moment, I am not <w>decent</w> yet!",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подождите минутку, я еще не <w>оде́та</w>!",
                                "zh": "请等一下，我还没<w>穿戴整齐</w>！"
                            }
                        },
                        {
                            "text": "She shouted through the door to ask if I was <w>decent</w>.",
                            "target_lang_translations": {
                                "ru": "Она крикнула через дверь, чтобы спросить, <w>оде́т</w> ли я.",
                                "zh": "她在门外喊着问我是否已经<w>穿戴整齐</w>了。"
                            }
                        }
