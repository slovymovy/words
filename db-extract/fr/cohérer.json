                "senses": [
                    {
                        "sense_id": "4cb35254-dcce-3833-9161-e6b60b5996fe",
                        "entry_id": "73eac45f-ca69-3690-9c40-3cc3b9ed39b7",
                        "glosses": [
                            "Devenir cohérent."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "58b017d6-1d54-418e-9a51-e9d0203c6907",
                                "sense_id": "4cb35254-dcce-3833-9161-e6b60b5996fe",
                                "text": "Une seconde question me taraude, comment faire cohérer ma GDB avec la base de données attributaire sous MySQL?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4eaff628-778a-3ba4-a29a-128ff31b6fd0",
                        "entry_id": "73eac45f-ca69-3690-9c40-3cc3b9ed39b7",
                        "glosses": [
                            "Faire devenir cohérent."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "62dedd1e-128e-4b62-9484-824e00f8497c",
                                "sense_id": "4eaff628-778a-3ba4-a29a-128ff31b6fd0",
                                "text": "Mais pour les cohérer et les intégrer dans la présente problématique, il a fallu les soumettre à un travail de remaniement, les synthétiser et les approfondir."
                            }
                        ]
                    },
                    {
                        "sense_id": "3b2c3ce5-11b7-32b4-969d-5db937b24efe",
                        "entry_id": "73eac45f-ca69-3690-9c40-3cc3b9ed39b7",
                        "glosses": [
                            "S’agglomérer, devenir cohérents entre eux."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "bb8e38a8-76ac-4c85-b449-2f1c9171fcb2",
                                "sense_id": "3b2c3ce5-11b7-32b4-969d-5db937b24efe",
                                "text": "La femme française, figure idéale, lieu d’identification imaginaire, objet autour duquel vont se cohérer d’autres désirs sociaux."
                            }
                        ]
                    }
