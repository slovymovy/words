                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3128d5-1546-440e-afd0-88f3ca7c9a4e",
                                "sense_id": "539bf5b9-95d4-3b2c-8ca3-a19f4187899d",
                                "text": "Als de minister-president van Nederland spreekt over 'undertakers' terwijl hij 'ondernemers' bedoelt is er sprake van een taalprobleem."
                            },
                            {
                                "example_id": "aa597538-e18c-463a-b917-fedde3ad9534",
                                "sense_id": "539bf5b9-95d4-3b2c-8ca3-a19f4187899d",
                                "text": "Toch is Oud-Crooswijk ook anno 2021 een van de armste wijken van Rotterdam en Nederland. Nog altijd hebben veel mensen moeite met rondkomen, groeien kinderen op in armoede en zijn er taalproblemen. En dan zijn de effecten van de corona-pandemie nog niet eens bekend."
                            }
                        ]
