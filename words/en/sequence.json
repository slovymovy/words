                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "секвенция",
                                "target_lang_sense_clarification": "жанр песнопения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sekans",
                                "target_lang_sense_clarification": "dini müzik formu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "继叙咏",
                                "target_lang_sense_clarification": "天主教弥撒中的一种圣咏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a0127dcf-e42d-3a91-a438-83e003f6e86a",
                    "sense_definition": "To arrange something in a specific order.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to <w>sequence</w> the files by date.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>упорядочить</w> файлы по дате.",
                                "tr": "Dosyaları tarihe göre <w>sıralamamız</w> gerekiyor.",
                                "zh": "我们需要按日期对文件进行<w>排序</w>。"
                            }
                        },
                        {
