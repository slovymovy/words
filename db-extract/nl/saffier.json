                ],
                "translations": [
                    {
                        "translation_id": "5b68c5fd-7b0f-4625-9607-dc55b5070c2e",
                        "source_entry_id": "8661f03e-9acb-3e18-a7b6-638b619f1335",
                        "source_sense_id": "a9c3f863-db48-36ea-b02d-6b9fcf7e3d0d",
                        "source_sense_description": "een kostbare, transparante blauwe edelsteensoort die een variant is van korund (α-Al₂O₃)",
                        "target_lang_word": "Saphir",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saphir",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cab4baa6-ed0f-366c-915e-9dadc56c7e00",
                                        "entry_id": "f6ecb09f-c996-3a08-84cc-f812113888d9",
                                        "glosses": [
                                            "besonders blaue, aber auch gelbe, grüne, violette und weiße/farblose Varietät des Minerals Korund"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261fa2a7-d48f-45e8-9d62-4e5148b57e31",
                                                "sense_id": "cab4baa6-ed0f-366c-915e-9dadc56c7e00",
                                                "text": "„Beim Abbau der Rubine, Saphire und Zirkone geben sich die Machthaber von Pailin weniger geheimnisvoll.“"
                                            },
                                            {
                                                "example_id": "312e016e-43d0-464c-b220-3372df716856",
                                                "sense_id": "cab4baa6-ed0f-366c-915e-9dadc56c7e00",
                                                "text": "„Umgeben ist die von goldenen Pagoden gesäumte Stadt von Seitentälern, wo in Hunderten oft kleinflächigen Stollen und Schächten Rubine und Saphire abgebaut werden, aber auch Quarz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                        "entry_id": "f6ecb09f-c996-3a08-84cc-f812113888d9",
                                        "glosses": [
                                            "Stück des oder Schmuckstein aus dem unter [1] genannten (besonders blauen) Korund"
                                        ],
                                        "tags": [
                                            "Mineralogie",
                                            "Mineralurgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7b7c26-ed58-4d43-9bfc-7606aafbf6a5",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "Der größte jemals geschliffene Saphir ist der „Stern von Indien“."
                                            },
                                            {
                                                "example_id": "29b37d99-0bec-4243-92f5-06f8010d775f",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Sein Himmel oder Dach besteht aus den klarsten Saphiren, hie und da untermischt mit glänzenden Topasen …“"
                                            },
                                            {
                                                "example_id": "92a1eba3-de85-44b7-a99a-e54d521a3e1a",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Die Flusen am Saphir mußte man dann und wann runterpusten.“"
                                            },
                                            {
                                                "example_id": "1d5a9ec1-bebc-4595-9858-cde7a4bb0408",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Sie streifte die Ringe an ihrer Linken ab und steckte den Saphir an den Ringfinger.“"
                                            },
                                            {
                                                "example_id": "eaf3f247-45d2-461d-8d48-5b0d6291b7e0",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Sie hat sich richtig herausgeputzt, zum ersten Mal sehe ich außer dem Ehering einen kleinen blauen Saphir an ihrer Hand.“"
                                            },
                                            {
                                                "example_id": "f7638453-f911-4472-b1c3-ee82f9df34e9",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Aus den Saphiren, die in allen Regenbogenfarben aus dieser Mine geschürft werden, kreiert Thomas Frieden mit seinem 25-köpfigen Team an Schmuckdesignern, Goldschmieden, Juwelenfassern und Edelsteinschleifern die Rainbow Collection: «Um die Regenbogenlinien für die Armbänder und Colliers zusammenzustellen, benötigen wir eine Auswahl von über 1000 Rohsteinen in den allerfeinsten Zwischentönen.»“"
                                            },
                                            {
                                                "example_id": "7682de68-6170-4f22-be28-69b0cf6bf692",
                                                "sense_id": "085fd815-c485-361f-900b-635e323a3694",
                                                "text": "„Verschwunden ist auch der goldene Armreif, den er seiner Frau einmal aus Usbekistan mitgebracht hat, und ein Ring, den sie vom Zahnarzt Krause, ihrem Liebhaber vor seiner Zeit, einmal geschenkt bekommen hat – mit einem Saphir in der Mitte, ringsherum kleine Brillanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "18fc5644-28d5-3b1f-8bae-409e6b58cb48",
                                        "entry_id": "f6ecb09f-c996-3a08-84cc-f812113888d9",
                                        "glosses": [
                                            "Abtastnadel, deren Spitze aus dem unter [1] genannten Korund besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b57fd7e-86ec-4d41-a4b3-d8641d9dc619",
                                                "sense_id": "18fc5644-28d5-3b1f-8bae-409e6b58cb48",
                                                "text": "„Da gräbt bei der Schallaufnahme ein kleiner spitzer Saphir jene geheimnisvollen Rillen in weiches Wachs.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "005f819c-5cdc-46df-9347-e72eb2bd852e",
                        "source_entry_id": "8661f03e-9acb-3e18-a7b6-638b619f1335",
