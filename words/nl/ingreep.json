                    "sense_id": "6cb0153a-318a-3d39-a668-e2e6e814aa79",
                    "sense_definition": "Een actieve handeling waarbij men zich ergens mee bemoeit om een situatie te veranderen of een probleem op te lossen.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "intervention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De overheid deed een noodzakelijke <w>ingreep</w> om de economie te redden.",
                            "target_lang_translations": {
                                "en": "The government carried out a necessary <w>intervention</w> to save the economy.",
                                "ru": "Правительство осуществило необходимое <w>вмешательство</w> для спасения экономики.",
                                "fr": "Le gouvernement a fait une <w>intervention</w> nécessaire pour sauver l'économie."
                            }
                        },
                        {
                            "text": "Zonder deze harde <w>ingreep</w> was de situatie volledig uit de hand gelopen.",
                            "target_lang_translations": {
                                "en": "Without this drastic <w>intervention</w>, the situation would have gotten completely out of hand.",
                                "ru": "Без этого жесткого <w>вмешательства</w> ситуация полностью вышла бы из-под контроля.",
                                "fr": "Sans cette <w>mesure</w> radicale, la situation aurait totalement échappé à tout contrôle."
                            }
                        }
                    ],
                    "synonyms": [
                        "interventie",
                        "tussenkomst",
                        "maatregel"
