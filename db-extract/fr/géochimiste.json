                "senses": [
                    {
                        "sense_id": "e00dced0-3fab-3fee-a7dc-8205b0af9e5a",
                        "entry_id": "28cf362f-7474-3ff0-8f90-c83e7da35ecd",
                        "glosses": [
                            "Spécialiste de géochimie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41e01684-af4d-4b97-a842-c87687da151a",
                                "sense_id": "e00dced0-3fab-3fee-a7dc-8205b0af9e5a",
                                "text": "Ministre de l’éducation, de la recherche et de la technologie dans le gouvernement Lionel Jospin de 1997 à 2000, Claude Allègre, géochimiste de formation, a publié de nombreux ouvrages de vulgarisation scientifique et a pris des positions controversées sur le réchauffement climatique."
                            },
                            {
                                "example_id": "79536f18-ecf5-4d70-ac85-0bc4b53a9c52",
                                "sense_id": "e00dced0-3fab-3fee-a7dc-8205b0af9e5a",
                                "text": "«Les vents et les courants poussent la glace arctique sur les côtes canadiennes», explique Robert Newton, géochimiste à l’Université Columbia, que La Presse a joint à New York."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e19aede9-f40e-4924-930c-0e88ca74160f",
                        "source_entry_id": "28cf362f-7474-3ff0-8f90-c83e7da35ecd",
                        "source_sense_id": "e00dced0-3fab-3fee-a7dc-8205b0af9e5a",
                        "target_lang_word": "Geochemiker",
