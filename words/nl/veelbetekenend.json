            "senses": [
                {
                    "sense_id": "28b8c095-2afe-33f7-a479-2e9d30b69379",
                    "sense_definition": "rijk van inhoud maar arm aan woorden, vaak een verborgen boodschap overbrengend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expressie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wierp me een <w>veelbetekenende</w> blik toe toen de leraar de klas verliet.",
                            "target_lang_translations": {
                                "en": "He gave me a <w>meaningful</w> look when the teacher left the classroom."
                            }
                        },
                        {
                            "text": "Na zijn opmerking viel er een <w>veelbetekenende</w> stilte in de vergaderruimte.",
                            "target_lang_translations": {
                                "en": "After his remark, a <w>pregnant</w> silence fell in the meeting room."
                            }
                        }
                    ],
                    "synonyms": [
                        "suggestief",
                        "beladen",
                        "expressief"
                    ],
                    "antonyms": [
                        "betekenisloos",
                        "leeg"
