                                                "example_id": "5ce037bc-2f6e-4089-9684-d930e9040dee",
                                                "sense_id": "959777ae-5245-3227-a165-26c064dcb950",
                                                "text": "Nearly every employer in my field has similar terms (they all come out of a legal boiler mill somewhere)."
                                            },
