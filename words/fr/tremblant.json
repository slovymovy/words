    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "488af806-bb44-376d-9349-30acbcc97e15",
                    "sense_definition": "Qui tremble, qui est agité de petits mouvements involontaires ou d'oscillations.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il tenait la lettre avec une main <w>tremblante</w> sans oser l'ouvrir.",
                            "target_lang_translations": {
                                "en": "He held the letter with a <w>trembling</w> hand, not daring to open it.",
                                "ru": "Он держал письмо <w>дрожащей</w> рукой, не решаясь его открыть.",
                                "de": "Er hielt den Brief mit einer <w>zitternden</w> Hand und wagte nicht, ihn zu öffnen.",
                                "es": "Sostenía la carta con una mano <w>temblorosa</w>, sin atreverse a abrirla.",
                                "zh": "他用<w>颤抖的</w>手拿着那封信，不敢打开。"
                            }
                        },
                        {
                            "text": "Après cette dispute, elle répondit d'une voix <w>tremblante</w> et troublée.",
                            "target_lang_translations": {
                                "en": "After that argument, she answered in a <w>trembling</w> and troubled voice.",
                                "ru": "После этой ссоры она ответила <w>дрожащим</w> и взволнованным голосом.",
                                "de": "Nach diesem Streit antwortete sie mit <w>bebender</w> und aufgewühlter Stimme.",
                                "es": "Tras aquella discusión, respondió con voz <w>temblorosa</w> y turbada.",
                                "zh": "争吵过后，她用<w>颤抖的</w>声音回答，显得很慌乱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frémissant",
                        "vacillant",
                        "chevrotant"
                    ],
                    "antonyms": [
                        "ferme",
                        "stable",
                        "assuré"
                    ],
                    "common_phrases": [
                        "voix tremblante",
                        "mains tremblantes",
                        "d'un pas tremblant"
                    ],
                    "target_lang_definitions": {
                        "en": "Shaking or quivering with small involuntary movements or oscillations.",
                        "ru": "Дрожащий, колеблющийся от мелких непроизвольных движений или колебаний.",
                        "de": "Durch kleine, unwillkürliche Bewegungen oder Schwingungen gekennzeichnet, die man nicht kontrollieren kann. Vor allem bei Händen, Stimme oder Körper gebräuchlich.",
                        "es": "Que tiembla o se agita con pequeños movimientos involuntarios u oscilaciones.",
                        "zh": "形容身体、声音或物体不由自主地小幅度抖动或摆动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trembling",
                                "target_lang_sense_clarification": "involuntary body shaking"
                            },
                            {
                                "target_lang_word": "shaky",
                                "target_lang_sense_clarification": "unsteady from nerves or weakness"
                            },
                            {
                                "target_lang_word": "quivering",
