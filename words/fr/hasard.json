                    "frequency": "Middle",
                    "semantic_group_id": "aleatoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un heureux <w>hasard</w> que nous soyons arrivés exactement au même moment."
                        },
                        {
                            "text": "Quel curieux <w>hasard</w> de vous croiser ici après toutes ces années passées à l'étranger !"
