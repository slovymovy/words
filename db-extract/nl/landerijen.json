                        "examples": [
                            {
                                "example_id": "281777a9-f9e3-4233-89a2-35137da52d0e",
                                "sense_id": "1267a778-b790-3d90-b80d-c7f58c6f1243",
                                "text": "Boeren krijgen voortaan een vergoeding als zij het water van hun landerijen opvangen in bassins en niet meer in zee lozen, zei premier Malcolm Turnbull vandaag. Het moet voorkomen dat meststoffen het water in het unieke natuurgebied vervuilen."
                            },
                            {
                                "example_id": "d3a9877f-4a9a-42ae-854e-ebf9972e7191",
                                "sense_id": "1267a778-b790-3d90-b80d-c7f58c6f1243",
                                "text": "Het Zoetermeerse topmodel Romee Strijd en haar vriend Laurens van Leeuwen - de zoon van EO-presentator Bert van Leeuwen - hebben het razend drukke New York verruild voor de rust van de Nederlandse landerijen. Het verliefde stel liet zich vandaag tijdens een lachbui vastleggen voor een blauwe molen op een onbekende locatie."
                            }
                        ]
                    }
