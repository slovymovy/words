                "senses": [
                    {
                        "sense_id": "8486fb83-8cce-3487-9ac0-528fc41fabd5",
                        "entry_id": "91f3cc26-6c45-3973-b11b-724326ffdad3",
                        "glosses": [
                            "middeleeuws vrachtschip dat vooral door de Hanze werd gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfa35c0-b3a3-45ba-a39f-21451c1ea105",
                                "sense_id": "8486fb83-8cce-3487-9ac0-528fc41fabd5",
                                "text": "Op de bodem van de haven bij het Overijsselse Kampen is een scheepswrak ontdekt. Archeologen sluiten niet uit dat het om het wrak van een 14e-eeuwse kogge gaat, een zeilschip dat in de tijd van de Hanzesteden werd gebruikt, aldus Rijkswaterstaat vrijdag."
                            },
                            {
                                "example_id": "98c38c48-18ec-447f-9e54-b800c8f5932b",
                                "sense_id": "8486fb83-8cce-3487-9ac0-528fc41fabd5",
                                "text": "Eind november moet het onderzoek naar de kogge klaar zijn. De nu gevonden kogge is aangetroffen vlak bij de werf van de Kamper Kogge, een reconstructie van het oude handelsschip uit 1998."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "405fe41c-53aa-43a6-ac00-464ab111f976",
                        "source_entry_id": "91f3cc26-6c45-3973-b11b-724326ffdad3",
                        "source_sense_id": "8486fb83-8cce-3487-9ac0-528fc41fabd5",
                        "source_sense_description": "middeleeuws vrachtschip dat vooral door de Hanze werd gebruikt",
                        "target_lang_word": "cog",
