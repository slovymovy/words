                        "target_lang_word": "protektionistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protektionistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df1e5814-e228-3586-82b4-65f8dcc265ff",
                                        "entry_id": "6b91a0f5-62a4-3098-8110-0222a315fc3c",
                                        "glosses": [
                                            "(die Wirtschaft eines Staates) vor der Konkurrenz aus dem Ausland schützend; auf Protektionismus beruhend"
                                        ],
                                        "tags": [
                                            "Wirtschaftspolitik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c71362ce-ab7b-4f24-848f-fd05a977cc86",
                                                "sense_id": "df1e5814-e228-3586-82b4-65f8dcc265ff",
                                                "text": "Der US-amerikanische Präsident ist zu einer protektionistischen Politik im Stande."
                                            },
                                            {
                                                "example_id": "8acf9def-62ff-4d49-95f6-4304501265c8",
                                                "sense_id": "df1e5814-e228-3586-82b4-65f8dcc265ff",
                                                "text": "Die europäischen Staaten werfen der US-amerikanischen Politik protektionistische Tendenzen vor."
                                            },
                                            {
                                                "example_id": "ebdc205e-c73a-4761-8e0f-bb5799da305a",
                                                "sense_id": "df1e5814-e228-3586-82b4-65f8dcc265ff",
                                                "text": "Eine protektionistische Politik begünstigt die heimische Wirtschaft, indem sie zum Beispiel ausländische Waren mit Schutzzöllen belegt."
                                            },
                                            {
                                                "example_id": "addfda7f-2629-4874-b010-e0b0bc2d44b0",
                                                "sense_id": "df1e5814-e228-3586-82b4-65f8dcc265ff",
                                                "text": "„Die erzwungene Aufhebung protektionistischer Schranken bei bleibendem staatlichen Dirigismus brachte viele Betriebe in Bedrängnis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
