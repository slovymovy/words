                    "frequency": "Low",
                    "semantic_group_id": "lichamelijke_pijn_of_letsel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij die val heb ik mij behoorlijk <w>bezeerd</w>.",
                            "target_lang_translations": {
