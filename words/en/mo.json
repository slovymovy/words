        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8534c0c5-0d6b-3a3a-878d-9bc086b3667e",
                    "sense_definition": "A short period of time; a moment.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be with you in a <w>mo</w>.",
                            "target_lang_translations": {
                                "ru": "Я буду с тобой через <w>минутку</w>.",
                                "es": "Estaré contigo en un <w>momento</w>."
                            }
                        },
                        {
                            "text": "Hang on a <w>mo</w>, I just need to grab my coat.",
                            "target_lang_translations": {
                                "ru": "Подожди <w>секунду</w>, мне только нужно захватить пальто.",
                                "es": "Espera un <w>segundo</w>, solo tengo que coger mi abrigo."
                            }
                        }
                    ],
                    "synonyms": [
                        "moment",
                        "second",
                        "minute",
                        "sec",
                        "tick"
                    ],
                    "common_phrases": [
                        "in a mo",
                        "wait a mo",
                        "hang on a mo",
                        "half a mo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in British and Australian English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий промежуток времени; момент.",
                        "es": "Un breve período de tiempo; un momento."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "момент",
                                "target_lang_sense_clarification": "короткое время"
                            },
                            {
                                "target_lang_word": "секунда",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "минутка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательное"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "momento",
                                "target_lang_sense_clarification": "período breve"
                            },
                            {
                                "target_lang_word": "segundo",
                                "target_lang_sense_clarification": "instante, uso coloquial"
                            },
                            {
                                "target_lang_word": "minuto",
                                "target_lang_sense_clarification": "tiempo muy corto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9da8fd2-4cb5-3dc1-9b6c-a0411261300d",
                    "sense_definition": "Initialism of modus operandi: a particular way or method of doing something, especially one that is characteristic or well-established (often used in criminal contexts).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police are studying the burglar's <w>MO</w> to predict his next move.",
                            "target_lang_translations": {
                                "ru": "Полиция изучает <w>почерк</w> взломщика, чтобы предсказать его следующий шаг.",
                                "es": "La policía está estudiando el <w>modus operandi</w> del ladrón para predecir su próximo paso."
                            }
                        },
                        {
                            "text": "Her <w>MO</w> is to befriend people before asking them for a loan.",
                            "target_lang_translations": {
                                "ru": "Её <w>тактика</w> — подружиться с людьми, прежде чем просить у них взаймы.",
                                "es": "Su <w>método</w> es hacerse amiga de la gente antes de pedirles un préstamo."
                            }
                        }
                    ],
                    "synonyms": [
                        "method",
                        "technique",
                        "approach",
                        "pattern"
                    ],
                    "common_phrases": [
                        "standard MO",
                        "criminal MO"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура от modus operandi: особый образ действий или метод, особенно характерный или устоявшийся (часто используется в криминалистике).",
                        "es": "Sigla de modus operandi: una forma o método particular de hacer algo, especialmente característico o arraigado (a menudo usado en contextos policiales o criminales)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почерк",
                                "target_lang_sense_clarification": "характерный стиль (о преступнике)"
                            },
                            {
                                "target_lang_word": "метод",
                                "target_lang_sense_clarification": "способ действия"
                            },
                            {
                                "target_lang_word": "образ действий",
                                "target_lang_sense_clarification": "modus operandi"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "modus operandi",
                                "target_lang_sense_clarification": "modo característico de obrar"
                            },
                            {
                                "target_lang_word": "método",
                                "target_lang_sense_clarification": "forma de actuar"
                            },
                            {
                                "target_lang_word": "patrón",
                                "target_lang_sense_clarification": "pauta de comportamiento"
                            }
                        ]
                    }
                },
                {
