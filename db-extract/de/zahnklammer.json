                        "sense_id": "dd36dcf9-452f-30b8-92ef-ae89cbc2c171",
                        "entry_id": "6cf6dcdc-4be5-39a7-afca-78d5604f557c",
                        "glosses": [
                            "künstlicher Aufsatz an Gebissen, um Fehlstellungen beziehungsweise die Ausrichtung der Zähne oder/und der Kiefer zu verbessern"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "1a42fbb4-921a-476a-b403-b9e1d76a5933",
                                "sense_id": "dd36dcf9-452f-30b8-92ef-ae89cbc2c171",
                                "text": "„Die zerbrochenen Zahnklammern lagen auf der Pressholzplatte wie ausgemusterte Exponate in einem Museum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02091edd-6953-4f40-bb16-9ff54ca5d9d6",
                        "source_entry_id": "6cf6dcdc-4be5-39a7-afca-78d5604f557c",
                        "source_sense_id": "dd36dcf9-452f-30b8-92ef-ae89cbc2c171",
                        "source_sense_description": "Zahnmedizin: künstlicher Aufsatz an Gebissen",
                        "target_lang_word": "broche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "broche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f4a3bec-3156-3d52-be2d-3bf65ba7a1cf",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige pointue que l’on passe au travers d’une volaille ou d’une pièce de viande que l’on souhaite faire rôtir, pour la faire tourner au-dessus de la flamme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70085a26-30b2-4fe7-885a-15957b514058",
                                                "sense_id": "7f4a3bec-3156-3d52-be2d-3bf65ba7a1cf",
                                                "text": "Elle sursauta, voulut pivoter dans sa direction, et son coude heurta la fragile pyramide de gâteaux à la broche qui s’effondra dans un bruit sourd."
                                            },
                                            {
                                                "example_id": "faa8473f-9781-41dc-8eed-3d8e2a2fe64d",
                                                "sense_id": "7f4a3bec-3156-3d52-be2d-3bf65ba7a1cf",
                                                "text": "Il faudrait encore un tour de broche. : se dit lorsque la viande n’est pas assez rôtie."
                                            },
                                            {
                                                "example_id": "a4d4771b-c014-4a09-96bf-e0c3fc632e76",
                                                "sense_id": "7f4a3bec-3156-3d52-be2d-3bf65ba7a1cf",
                                                "text": "À six ans, je gagnais ma vie à trier des chiffons ; pour me faire dépêcher, on me piquait le dos avec une broche… vous savez, une broche à enfiler les gigots, les poulets."
                                            },
                                            {
                                                "example_id": "caffd6bb-840d-4b0c-b089-518d043d875e",
                                                "sense_id": "7f4a3bec-3156-3d52-be2d-3bf65ba7a1cf",
                                                "text": "Dans tous les cas, il s’agit de viande – de veau, poulet, agneau ou bœuf – marinée dans des épices ou des aromates, du lait, du citron, coupée en lamelles et montée sur une broche verticale rotative pour être cuite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d53f8e7b-03e8-309e-a83f-6fde7f03bb28",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige de fer recevant la bobine dans les filatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848444e0-a02e-44b7-a6bd-0832ee7e218e",
                                                "sense_id": "d53f8e7b-03e8-309e-a83f-6fde7f03bb28",
                                                "text": "Broches à filer le coton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a0c909f-8dff-3c3f-9e38-fff3579ba18e",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige métallique utilisée en chirurgie pour consolider ou fixer un os fracturé, une articulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1719de4a-d1f5-406a-9852-08ffe640b8b7",
                                                "sense_id": "4a0c909f-8dff-3c3f-9e38-fff3579ba18e",
                                                "text": "Après son accident, on lui a posé des broches sur sa fracture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4fc86fd-4a29-3233-8ef4-0a6556e8c0eb",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Long piton muni d’un anneau utilisé dans la neige et la glace, ou en escalade artificielle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b44becd-fd50-3a03-b836-0c1979c92a08",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Outil utilisé par les maçons pour casser les matériaux. Outil en forme de burin dont la tige est pointue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fa6d952e-8d0b-31f1-9348-e5d0ebbf8b17",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige de métal fixée latéralement sur les anciennes munitions et percutant l’amorce."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43232d5f-0683-4efd-9b65-f3e63c02b7f5",
                                                "sense_id": "fa6d952e-8d0b-31f1-9348-e5d0ebbf8b17",
                                                "text": "Fusils à broche. Cartouche à broche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af572508-250f-3cc9-8c43-2b53355d92f7",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Cheville ou tige servant à enfiler des objets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab4fa3d1-e80f-3690-8325-0b82e1711eb4",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige constituant la partie mâle d’une connexion électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "744b98fb-e7bd-39c6-a144-3c82bf66d389",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Tige à l’intérieur du pêne d’une serrure, lorsque la clef est creuse."
                                        ],
                                        "tags": [
                                            "Serrurerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb4719e0-a57f-3b55-9df7-e0572790fcb6",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Cheville pour boucher le trou fait au foret dans un tonneau. On la nomme aussi esquive"
                                        ],
                                        "tags": [
                                            "Tonnellerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0cf1027-85de-3bc1-90d7-2d6d1c845934",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Partie tournante (portant un mandrin, une pointe de tour, une fraise, etc.) d’une machine-outil, servant à usiner un trou dans une pièce."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Aiguille à tricoter."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "108cd09e-6fbd-4c8c-bf9a-0d0179a5daaf",
                                                "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                                "text": "Broches à tricoter."
                                            },
                                            {
                                                "example_id": "34293f5a-09d0-432f-857a-8df078c568e0",
                                                "sense_id": "6b6537fb-e888-3b5e-8602-ecdcc0bfa744",
                                                "text": "Elle les voulait aussi heureux que s’ils avaient eu leur mère. Sa tendresse la rendait adroite et inventive. Elle, qui ne savait tricoter qu’aux broches, avait appris un point de crochet et leur avait fait à chacun, pour l’hiver, un joli manteau de laine bleue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c9533f0-bc78-3976-b118-14397184cce9",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Éperon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b4ce5c4-78d4-3e34-a966-d41fa40ca369",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Bijou muni d’une longue épingle et d’un fermoir, servant à attacher un châle, un col, ou à garnir un corsage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91463243-7104-4d36-bcb0-924b3c7d0175",
                                                "sense_id": "1b4ce5c4-78d4-3e34-a966-d41fa40ca369",
                                                "text": "Une broche de diamants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Fil de fer, parfois d'autres métaux."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9fc198-38b5-443a-b03e-43edcb7ddcf1",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "L’État fédéral, c’est la broche qui tient les morceaux du Canada ensemble."
                                            },
                                            {
                                                "example_id": "63351978-fae2-49ae-b145-4a489384f84b",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "Fixer avec de la broche."
                                            },
                                            {
                                                "example_id": "4111bc8f-1a6a-4b08-a175-9b3b9094d9b6",
                                                "sense_id": "89986370-1eb0-36ec-86ba-0a7782c8745b",
                                                "text": "D'la broche de brass, ça fait pareil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "336d85aa-39ff-38fc-8567-cd4f90bc2998",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Fil de fer, parfois d'autres métaux.",
                                            "Agrafe."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd076dc-4255-4adc-81ec-fb74f10a5bac",
                                                "sense_id": "336d85aa-39ff-38fc-8567-cd4f90bc2998",
                                                "text": "Le lieutenant passa l'extrémité de sa lame sous une agrafe plantée sous un des souliers du défunt […]. La broche, comme on dit au Québec, retenait encore une minuscule étiquette que Larouche ramena dans la paume de sa main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "043fd1fb-a170-3a2a-ba6d-1940f1801127",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Au pluriel : défenses du sanglier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcfbc3e7-0f29-4d46-a61c-3492dca1a519",
                                                "sense_id": "043fd1fb-a170-3a2a-ba6d-1940f1801127",
                                                "text": "Les broches du sanglier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ed0a8d-55df-3be5-84e9-fc3ff430a470",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Au pluriel : premiers bois du chevreuil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a5a54a7-5c69-405e-b787-46310c179b65",
                                                "sense_id": "61ed0a8d-55df-3be5-84e9-fc3ff430a470",
                                                "text": "C’est bien plutôt des chevreuils que vient le danger, car la fougue d’un jeune brocard ne recule pas devant la masse d’un grand cerf, et ses broches peuvent lui infliger des blessures irréparables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26362c6-f1aa-35ad-9448-2984ea160873",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Dents."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c660a5-5732-4047-891d-5329c37e3b6a",
                                                "sense_id": "f26362c6-f1aa-35ad-9448-2984ea160873",
                                                "text": "Il n'a plus de broches dans la gargue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd3bb1ef-3611-3536-abd4-8f70fe2e2cac",
                                        "entry_id": "2ecc2879-48ee-36e8-8b9d-8d62c3dc7666",
                                        "glosses": [
                                            "Bracket vestibulaire nommé aussi bague"
                                        ],
