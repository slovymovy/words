                {
                    "sense_id": "19cb8dde-db21-367a-9d6e-120e594acad3",
                    "sense_definition": "Een uitdrukking van afkeer, ergernis of soms speelse waardering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heeft die <w>verdraaide</w> bengel me toch nog mat gezet!",
                            "target_lang_translations": {
                                "fr": "Ce <w>maudit</w> gamin m'a quand même mis échec et mat !"
                            }
                        },
                        {
                            "text": "Waar is die <w>verdraaide</w> sleutel nu weer gebleven?",
                            "target_lang_translations": {
