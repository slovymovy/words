                    {
                        "translation_id": "752a3c57-1d22-4a3a-af1b-2c050a4b25fd",
                        "source_entry_id": "15717b10-2964-3bf5-b706-be412d3f47db",
                        "source_sense_id": "33dd4f31-26dd-330b-9d25-2b617f09ada2",
