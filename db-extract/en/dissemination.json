                "senses": [
                    {
                        "sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                        "entry_id": "0049e74d-e06c-3529-aa08-15ed8e866b44",
                        "glosses": [
                            "The act of disseminating, or the state of being disseminated; diffusion for propagation and permanence; a scattering or spreading abroad, as of ideas, beliefs, etc."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d049cd7b-9d41-4a05-81fa-9206ed127390",
                                "sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                                "text": "There was a third class, small indeed when compared to those vast multitudes actuated by fanaticism or interest, but destined to exercise the most beneficial and lasting influence—the reflecting and theoretic few, who saw in universal freedom the only tie between man and his kind—the only rational hope whereon to ground the dissemination of equitable principles among the human race."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "904360ed-5f5a-4799-b95f-46ff9fddbd2b",
                        "source_entry_id": "0049e74d-e06c-3529-aa08-15ed8e866b44",
                        "source_sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                        "source_sense_description": "act of disseminating",
                        "target_lang_word": "verspreiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verspreiding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9b7e0e75-24b1-386a-98a7-0e580fa30cb8",
                                        "entry_id": "8061d700-1456-376f-a87c-582e0de8d5a5",
                                        "glosses": [
                                            "het over meerdere plekken verdelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7cb0bd2-b8a0-40d4-90fc-71cb361d3212",
                                                "sense_id": "9b7e0e75-24b1-386a-98a7-0e580fa30cb8",
                                                "text": "Om verspreiding van het virus te voorkomen, worden de kippen op locatie afgemaakt door de Nederlandse Voedsel- en Warenautoriteit. Vanwege het grote aantal dieren verwacht de dienst daar wel enige tijd mee bezig te zullen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27810bc6-5fca-4a20-b9e3-b69ffa8c5d25",
                        "source_entry_id": "0049e74d-e06c-3529-aa08-15ed8e866b44",
                        "source_sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                        "source_sense_description": "act of disseminating",
                        "target_lang_word": "verbreiding",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbreiding",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d8ea8c5c-332d-34e7-998b-e0aca69f0619",
                                        "entry_id": "c2dd0609-c74f-3504-8f48-c66a1629e29f",
                                        "glosses": [
                                            "het iets verspreiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2262143-322c-4211-8dd9-239ff9fe1357",
                                                "sense_id": "d8ea8c5c-332d-34e7-998b-e0aca69f0619",
                                                "text": "Pierre pakte zijn schrift en begon te lezen: «Tot de verbreiding van de zuivere waarheid en het bevorderen van de triomf van de deugd, las hij, moeten we de mensen zuiveren van vooroordelen, leefregels verspreiden die stroken met de geest van de tijd, de opvoeding van de jeugd op ons nemen, onverbrekelijke banden aangaan met de wijste mensen, op moedige en tegelijkertijd verstandige manier bijgeloof, ongeloof en domheid bestrijden, en een verbond vormen uit de mensen die ons toegewijd zijn en die onderling verbonden zijn door een zelfde doel en die macht en kracht bezitten."
                                            },
                                            {
                                                "example_id": "9936fcfe-5541-4c75-b08b-b7e2e6c0757a",
                                                "sense_id": "d8ea8c5c-332d-34e7-998b-e0aca69f0619",
                                                "text": "In Nederland is zo'n werkwijze verboden. \"Maar dat mogen de Australiërs, Amerikanen en Britten wel.\" Guijt pleit voor het invoeren van deze manier van opereren, omdat het probleem met de verbreiding van internet alleen maar groter wordt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afccd669-afba-40d3-b5c6-d7168f6a1763",
                        "source_entry_id": "0049e74d-e06c-3529-aa08-15ed8e866b44",
                        "source_sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                        "source_sense_description": "act of disseminating",
                        "target_lang_word": "dissémination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dissémination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35ce6c93-3820-3aa8-a212-062c2a51e99a",
                                        "entry_id": "b6724871-bfe4-3acb-8162-581c313d473d",
                                        "glosses": [
                                            "Dispersion des diaspores."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a4cca2e-bb01-4c63-afe6-26db06335c5c",
                                                "sense_id": "35ce6c93-3820-3aa8-a212-062c2a51e99a",
                                                "text": "Les Angiospermes ont des modes de dissémination très variés : si nous songeons aux arbres d'abord, nous trouvons les graines légères des Peupliers que le vent transporte au loin grâce à leurs houppes de poils, […]."
                                            },
                                            {
                                                "example_id": "b3511fb0-944f-4426-b19c-937b99716d19",
                                                "sense_id": "35ce6c93-3820-3aa8-a212-062c2a51e99a",
                                                "text": "Chez le coprin, ce sont les spores produites immédiatement après la fécondation qui assurent la dissémination."
                                            },
                                            {
                                                "example_id": "33e69500-2a06-4971-aadf-2edc1c5c4e72",
                                                "sense_id": "35ce6c93-3820-3aa8-a212-062c2a51e99a",
                                                "text": "La dissémination des graines par les animaux ou zoochorie est fréquente. La zoochorie permet la dissémination des graines sur de grandes distances. Par exemple, les graines de moabi sont mangées par les animaux (éléphant), celles de Maesopsis par le calao, les noix sont stockées par les rongeurs, les petites graines par les fourmis, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2edf0688-73ef-3a17-a70b-13c8a52b710c",
                                        "entry_id": "b6724871-bfe4-3acb-8162-581c313d473d",
                                        "glosses": [
                                            "Action de disséminer ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700eb58c-d970-4cfb-b086-6f0090e944bf",
                                                "sense_id": "2edf0688-73ef-3a17-a70b-13c8a52b710c",
                                                "text": "Selon toute apparence, la dissémination des animaux fixés est toujours due à des œufs qui, sortis du sein de la mère, vont éclore au loin, et qui, dans l’immense majorité des cas, donnent naissance à des larves, d’abord libres et mobiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf8358b4-9da7-3bb6-a5d6-9cffaf57f9e0",
                                        "entry_id": "b6724871-bfe4-3acb-8162-581c313d473d",
                                        "glosses": [
                                            "Répartition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105a495c-9f74-4f8a-b3e7-65a132d7311b",
                                                "sense_id": "cf8358b4-9da7-3bb6-a5d6-9cffaf57f9e0",
                                                "text": "Ces aiguilles sont droites ou recourbées et leur dissémination varie suivant le genre de laine que l'on doit carder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "085d13b8-3397-3096-aa17-ac143ca2e287",
                                        "entry_id": "b6724871-bfe4-3acb-8162-581c313d473d",
                                        "glosses": [
                                            "Processus de propagation, de diffusion ou de dispersion d'agents pathogènes tels que des virus, des bactéries ou d'autres agents infectieux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3048add0-bafa-460c-9d95-b787e65bcb75",
                                                "sense_id": "085d13b8-3397-3096-aa17-ac143ca2e287",
                                                "text": "L’affection ne représente donc pas une menace létale. Mais le mode de vie grégaire des mandrills favorise la dissémination des pathologies transmissibles. Pas question donc de risquer la contamination, les mesures s’imposent."
                                            },
                                            {
                                                "example_id": "ad3d3713-fe9c-48de-90df-d6b6e1ba745e",
                                                "sense_id": "085d13b8-3397-3096-aa17-ac143ca2e287",
                                                "text": "Lors de la traversée par les cellules épithéliales ou par les cellules transporteuses d'antigène, la dissémination virale est probablement plus lente ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6b2794f-56b5-4e1e-bfff-b81c35caa302",
                        "source_entry_id": "0049e74d-e06c-3529-aa08-15ed8e866b44",
                        "source_sense_id": "3937d646-5735-3b1d-b150-6295c0d4e899",
                        "source_sense_description": "act of disseminating",
                        "target_lang_word": "Verbreitung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbreitung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "die (bewusste oder unbewusste) Handlung des Verbreitens; eine Sache weitergeben und somit vervielfachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0b4f0b6-5c79-4bf6-9b79-f0df5951eafe",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung von pornographischen Dateien ist nicht erlaubt."
                                            },
                                            {
                                                "example_id": "e97490e3-4348-4b0d-8bee-7e689898a1d6",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "Die Verbreitung der Krankheit muss schnellstmöglich verhindert werden."
                                            },
                                            {
                                                "example_id": "1c624f3f-8a1b-4753-920e-3eb7459a874f",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Ein CIA-Spion, der schon zwanzig Jahre dabei war, hatte mitgeholfen, die Verbreitung von Massenvernichtungswaffen zu verhindern.“"
                                            },
                                            {
                                                "example_id": "de144ce8-1e0c-47c1-b6b5-8c0f2794023e",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Die in der Septuaginta enthaltenen, aber von der jüdischen Gemeinde in den Kanon nicht aufgenommenen Schriften bezeichnet man als Apokryphen, d. h. als verborgene, von der öffentlichen Verbreitung ausgeschlossene Schriften.“"
                                            },
                                            {
                                                "example_id": "a337cf52-53c4-4431-b443-bc46cc98fa7b",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Doch mit Zensur und Zeitungsverboten konnte die Verbreitung der Nachrichten aus Österreich natürlich nicht unterbunden werden.“"
                                            },
                                            {
                                                "example_id": "c561c365-20e5-417d-ac2a-117e69668242",
                                                "sense_id": "8eb64f6a-326c-30b8-b5d0-4a9a709ae231",
                                                "text": "„Flächendeckende Verbreitung erfuhr es dann durch die Pornoindustrie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                        "entry_id": "0b27632f-26b6-3fb4-9329-d2e12f1fbdf0",
                                        "glosses": [
                                            "der Zustand, in einem bestimmtem Raum oder in einem gewissen Maße verbreitet zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a506a9-1007-4e97-b0f7-a141b186b735",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Bei einer so weiten Verbreitung ist es kein Wunder, dass auch Prominente betroffen sind.“"
                                            },
                                            {
                                                "example_id": "c0a20a7a-d07e-432c-9cd7-faad5c4ba546",
                                                "sense_id": "fac39a23-84df-39a4-8b79-f77e64af3d5c",
                                                "text": "„Die Verbreitung von Cannabis ist in den Niederlanden sogar geringer als in Ländern, die eine repressive Drogenpolitik verfolgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
