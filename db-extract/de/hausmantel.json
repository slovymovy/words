                "senses": [
                    {
                        "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                        "entry_id": "b9c65e92-2603-38b4-9578-56428924977c",
                        "glosses": [
                            "nur im Haus getragenes, bequemes Kleidungsstück für den ganzen Körper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc1a7f58-9dec-4ce0-8fdf-5513a7ba60ae",
                                "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                                "text": "„Dann legt sie in aller Ruhe, als wäre sie allein, ihre Kleidung ab und zieht einen Hausmantel an.“"
                            },
                            {
                                "example_id": "e7eb8179-df79-4771-b0c0-34e171b8f46f",
                                "sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                                "text": "„Außerdem wählte sie einen schwarzen Hausmantel aus Seide, den sie zusammen mit dem Negligé an einen Haken im Badezimmer hängte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22153a32-1d03-420a-8361-d8017b7c2b16",
                        "source_entry_id": "b9c65e92-2603-38b4-9578-56428924977c",
                        "source_sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                        "source_sense_description": "nur im Haus getragenes, bequemes Kleidungsstück für den ganzen Körper",
                        "target_lang_word": "peignoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "peignoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Sorte de vêtement de dessus que l’on jette sur ses épaules, quand on fait sa toilette, quand on se peigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5d4651-e233-4e79-b04d-e3c0e3cc2c2b",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Liane s’était contentée d’un simple peignoir de mérinos grisâtre avec devantiau (tablier) noir, fichu à grands ramages, et ce gracieux petit bonnet rond qui s’appelle une canipette."
                                            },
                                            {
                                                "example_id": "f94020f8-3601-4738-80b1-356ad5080177",
                                                "sense_id": "8c592086-b407-32c5-a9ae-00dbe7e57928",
                                                "text": "Arlette a promis de décorer la table avec des fleurs. Aussi, le lendemain, dès l’aube, est-elle dans le jardin, en peignoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement à peu près semblable qu’on met en sortant du bain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492cd3ba-48df-45f4-9f73-4374d6e34c0a",
                                                "sense_id": "7d007961-bee7-3ce3-aac7-8ba046766dab",
                                                "text": "J’attrapai un peignoir et décrochai le combiné fixé au mur, à côté des W-C."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                        "entry_id": "c599c968-eaa1-35be-82ef-4d36fcdfc442",
                                        "glosses": [
                                            "Vêtement d’intérieur ; déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492ffe98-6b5b-4192-affa-d10375e828fc",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Une Liménienne déjeûne le matin, avec son mari en petit peignoir à la française, ses cheveux retroussés absolument comme nos dames de Paris."
                                            },
                                            {
                                                "example_id": "497a42e8-d545-448d-b9ef-8553e6aea31e",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "Quand elle achetait soit des corsets, soit des peignoirs, soit des pantalons, elle voulait toujours que ce fût moi qui passasse avec elle dans la chambre au fond et qui les lui essayasse."
                                            },
                                            {
                                                "example_id": "0e0f74eb-dd6c-4d5d-8c39-d440ff18764c",
                                                "sense_id": "20722737-402c-3850-877c-26672e755c40",
                                                "text": "[…] : pour peu qu’il y eût de l’électricité dans l’air ou que Och eût joué des parties du Vaisseau Fantôme, les Teutes s’assombrissaient, d’autres tentaient de s’aller coucher et chassées par l’insomnie revenaient en peignoir dans le petit salon des veillées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0324a7eb-73c8-40cd-9654-f61cb4a71e73",
                        "source_entry_id": "b9c65e92-2603-38b4-9578-56428924977c",
                        "source_sense_id": "5632f796-8023-316e-9ce1-d7df5f8bb03a",
                        "source_sense_description": "nur im Haus getragenes, bequemes Kleidungsstück für den ganzen Körper",
                        "target_lang_word": "robe de chambre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robe de chambre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                        "entry_id": "4b1b2dcb-6318-3a71-9954-2fd9c42c46c1",
                                        "glosses": [
                                            "Vêtement que l’on porte chez soi en déshabillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c62bb8c-a0a8-41da-930c-da484fb8e189",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "On court se mettre en pantoufles et en robe de chambre pour popoter avec lui au coin du feu."
                                            },
                                            {
                                                "example_id": "203b4f19-53e4-4ba3-8310-9ee423f06f14",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "La vue du lit en désordre, du pyjama abandonné sur une chaise, d’une robe de chambre suspendue dans la salle de bain, l’émut pourtant."
                                            },
                                            {
                                                "example_id": "dd240f95-4a08-424f-9b2b-eac5e757686c",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "Laurence avait une amazone vert-bouteille pour se promener à cheval, une robe en étoffe commune à canezou orné de brandebourgs pour aller à pied, et chez elle une robe de chambre en soie."
                                            },
                                            {
                                                "example_id": "d889ce1c-5e56-4648-b983-3360578d1b80",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "Aussi svelte et bien coiffée, dans une robe de chambre bien moulante, que son aînée est foutue comme l’as de pique, dans son peignoir de bain en tissu-nounours, et peignée avec un clou, de surcroît."
                                            },
                                            {
                                                "example_id": "f1794008-2605-48e7-b0d1-bbcc7c49b32a",
                                                "sense_id": "c81083f7-8c6f-3059-ac5a-95c5b9ca7fdc",
                                                "text": "À la vue du plaid fleuri qui recouvre sa couche, et qu’elle a assorti aux rideaux et à sa robe de chambre, je réalise soudain le sens de l’expression « border l’insomniaque », de même que l’importance du Viagra dans une vie de couple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
