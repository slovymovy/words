                        "entry_id": "f686c205-1576-32a9-b8b2-2edbafcfb0b5",
                        "glosses": [
                            "Donner un caractère réciproque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6314d473-aff5-4b88-9764-40d0808ea0ba",
                                "sense_id": "2208fb33-36a8-3f83-b870-1b3cb9dbc080",
                                "text": "C'est peut-être une façon de réciproquiser tout ça et faire semblant que c'est une relation normale et balancée."
                            }
                        ]
                    },
                    {
                        "sense_id": "92265752-5817-3b2d-ba93-213d1bfc9587",
                        "entry_id": "f686c205-1576-32a9-b8b2-2edbafcfb0b5",
                        "glosses": [
                            "Rendre la pareille, réciproquer, faire la même chose que son interlocuteur."
                        ],
                        "tags": [],
                        "examples": [
