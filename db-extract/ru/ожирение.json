                                        "sense_id": "155ea3bf-2dcf-358f-b415-4b4b2e68fb50",
                                        "entry_id": "ba529533-11d9-3d08-9c44-8df26341aab2",
                                        "glosses": [
                                            "The state of being obese."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049a6f4d-3a4a-4d4f-bd2c-1032e207177d",
                                                "sense_id": "155ea3bf-2dcf-358f-b415-4b4b2e68fb50",
                                                "text": "While the majority of individuals with severe obesity are able to maintain eucapnia, a significant minority will develop obesity hypoventilation syndrome (OHS), characterized by alveolar hypoventilation (PaCO 2 > 45 mmHg) unexplained by other disorders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03c0c772-e32c-49af-9cea-18e06d046808",
                        "source_entry_id": "fea479a4-7841-37b4-8171-b74e5bb17c4b",
