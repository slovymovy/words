                "senses": [
                    {
                        "sense_id": "ff3f5754-af69-3533-a7da-425bb96e667b",
                        "entry_id": "39e2b3c1-f2b6-3769-9c70-7c53d69983ce",
                        "glosses": [
                            "zo recht als een kaars, zonder enige bocht of buiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b202986-e802-41d8-9543-92c63c9a58b8",
                                "sense_id": "ff3f5754-af69-3533-a7da-425bb96e667b",
                                "text": "De lange en kaarsrechte polderweg was slaapverwekkend voor de automobilisten."
                            },
                            {
                                "example_id": "a9d5ef0c-5f76-461d-8546-f18e637ddef3",
                                "sense_id": "ff3f5754-af69-3533-a7da-425bb96e667b",
                                "text": "Hoe vaak heb ik het niet gezegd: rug recht. Je rug kaarsrecht houden. En als een prinses moet je staan.' Nu nam de balletjuf de houding van een prinses aan. Ze strekte haar rug, drukte haar borsten naar voren, strekte haar nek als een giraffe, draaide haar armen in een elegante cirkel. Tot ze onbeweeglijk stond te stralen als een wassen beeld. Van een levende juf was ze overgegaan in een levenloze pop. Met veel ontzag keken we naar haar. Niemand durfde iets te zeggen. Maar dat was ook niet de bedoeling, natuurlijk."
                            }
                        ]
                    }
                ],
