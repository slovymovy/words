                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Emplacement ordinairement fermé et couvert, destiné à l’emmagasinement et à la vente d’objets d’une utilité première, qui s’y vendent en forte partie, presque toujours pour l’approvisionnement des magasins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cf99a5-81f4-42a5-86aa-02a9f388c20c",
                                "sense_id": "a00a75b9-053e-3aae-8822-fb33bcb08edd",
                                "text": "[…], il avait chaussé de gros souliers à clous et il s'était coiffé d'un chapeau à larges bords comme les forts de la halle."
                            }
                        ]
                    },
                    {
                        "sense_id": "81571ed5-d175-39af-bd9e-39cffc35aa60",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Place publique, ordinairement couverte, où se tiennent les marchés ou les foires."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6920b961-c416-31a1-a731-685b57b25978",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Magasin public où les personnes qui font un même commerce enferment leurs marchandises."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02fedd6e-ef56-39b6-95cf-2ea9f4cfbdd7",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Le quartier des Halles, à Paris, dont les marchandes étaient connues pour leur langage cru et grossier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2d2592-3bb1-4558-b00a-bc75b624524f",
                                "sense_id": "02fedd6e-ef56-39b6-95cf-2ea9f4cfbdd7",
                                "text": "« Ardez un peu cette mauricaude, il lui faut des marquis pour l’aider à descendre de charrette, » fit intérieurement la Sérafine dans un style peu digne du ton maniéré et précieux qu’elle affectait en parlant ; mais le dépit, entre femmes, emploie volontiers les métaphores de la halle et de la grève, fussent-elles duchesses ou grandes coquettes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef8b532c-bab2-363f-ba83-fb0bc31a7d2e",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Grande salle vide ou meublée de façon rudimentaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4ae4215d-6f08-3fdb-8779-f8e816d54a28",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Salle dans laquelle se pratique un sport."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "04ce78fe-3104-3c2b-8384-0c559a6a966c",
                        "entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "glosses": [
                            "Atelier où l’on fond du verre, où l’on coule des glaces."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3091198-c479-4c9a-9983-77784ab21f77",
                        "source_entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "source_sense_description": "Magasin public où les personnes qui font un même commerce enferment leurs marchandises (2)",
                        "target_lang_word": "Markthalle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Markthalle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b27a07d-f0f3-390b-adfd-77fb6134ec07",
                                        "entry_id": "bcff3cf7-c18b-3761-b716-6edefa42be43",
                                        "glosses": [
                                            "großes Gebäude, in dem Waren an Verkaufsständen verkauft werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c88939f9-234c-4bd9-b660-26fbfc7c4e27",
                                                "sense_id": "8b27a07d-f0f3-390b-adfd-77fb6134ec07",
                                                "text": "In der Innenstadt steht eine Markthalle, wo Fisch und Gemüse verkauft wird."
                                            },
                                            {
                                                "example_id": "94cf25bc-fdaf-49a9-95a5-7106fca839db",
                                                "sense_id": "8b27a07d-f0f3-390b-adfd-77fb6134ec07",
                                                "text": "„Dann ging es zu den Markthallen.“"
                                            },
                                            {
                                                "example_id": "811fd2f3-4a0d-4441-b237-91d7b1682dfc",
                                                "sense_id": "8b27a07d-f0f3-390b-adfd-77fb6134ec07",
                                                "text": "„Vor der geschlossenen Markthalle, die die Deutschen vermutlich in irgendwelche Magazine umgewandelt hatten, standen Kleinhändler mit Körben voller Ware.“"
                                            },
                                            {
                                                "example_id": "b0fac492-9d11-47c0-8fbe-b561440b2bd1",
                                                "sense_id": "8b27a07d-f0f3-390b-adfd-77fb6134ec07",
                                                "text": "„Ich schlenderte durch die Straßen, vorbei an alten Häusern, durch eine Markthalle, die bereits Feierabend gemacht hatte, über einen Platz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f105ffa-f9a0-4ac2-a582-821ec1c166c8",
                        "source_entry_id": "028f23ee-3077-3478-a573-43d5c6acb1af",
                        "source_sense_description": "Magasin public où les personnes qui font un même commerce enferment leurs marchandises (2)",
                        "target_lang_word": "street market",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "street market",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95b836f0-afae-3121-94cf-1764967d5b63",
                                        "entry_id": "13132fa1-5fc2-3205-8ab1-309bdedce625",
                                        "glosses": [
                                            "A temporary public market, normally set up outdoors on certain days of the week, often, but not always, in a street. Sometimes they can be found in a car park or in a market square."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a08005-d2dd-469c-8ee6-4eb533afba49",
                                                "sense_id": "95b836f0-afae-3121-94cf-1764967d5b63",
                                                "text": "The backbone of the old Cockney kingdom of Lambeth used to be Lambeth Walk, the famous old street market that runs parallel to the river behind Lambeth Road."
                                            },
                                            {
                                                "example_id": "6a814bc6-6167-4827-8315-2b0acc27a601",
                                                "sense_id": "95b836f0-afae-3121-94cf-1764967d5b63",
                                                "text": "Buy a bog-standard one at the street market in Souk Chaaria, near the Musee de Marrakech."
                                            },
                                            {
                                                "example_id": "22b9e205-7c2f-473c-9951-873ab6bbae12",
                                                "sense_id": "95b836f0-afae-3121-94cf-1764967d5b63",
                                                "text": "It was not the custom of London consumers to walk any distance for their food, or any other goods. As a result of this and the inability of the London County Council to establish a single authority to regulate existing markets and establish properly regulated new ones when the need arose, the irregular street market set up in densely populated districts was a feature of the capital. In 1891 there were 112, all unauthorised, and containing 5,292 stalls, of which 65 percent were set aside for the sale of perishable commodities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
