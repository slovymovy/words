                        "sense_id": "afec90e7-bca9-30ab-a65d-9da75c88212c",
                        "entry_id": "5304a92c-5e60-3ad0-9e6f-d0d2a0367e58",
                        "glosses": [
                            "Archaic spelling of ache."
                        ],
                        "tags": [
                            "alt-of",
