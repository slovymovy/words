{
    "word_family": [
        "sordidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fa3dc998-eb3f-3d12-9f2c-1737dec8e944",
                    "sense_definition": "Dirty or squalid.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lived in a <w>sordid</w> apartment with broken windows and peeling paint.",
                            "target_lang_translations": {
                                "ru": "Они жили в <w>грязной</w> квартире с разбитыми окнами и облупившейся краской."
                            }
                        },
                        {
                            "text": "The <w>sordid</w> conditions of the alleyway made everyone avoid walking there at night.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>убогого</w> состояния переулка все старались не ходить там по ночам."
                            }
                        }
                    ],
                    "synonyms": [
                        "unclean"
                    ],
                    "common_phrases": [
                        "sordid conditions",
                        "sordid apartment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грязный, неопрятный или запущенный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грязный",
                                "target_lang_sense_clarification": "о физически грязном, неухоженном месте или состоянии"
                            },
                            {
                                "target_lang_word": "убогий",
                                "target_lang_sense_clarification": "о бедном, жалком и запущенном жилище"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ac7825a-9278-3b20-8c32-6fe1cda1d6af",
                    "sense_definition": "Morally degrading or ignoble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "immoral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newspaper revealed the <w>sordid</w> details of the politician's secret life.",
                            "target_lang_translations": {
                                "ru": "Газета раскрыла <w>постыдные</w> подробности тайной жизни политика."
                            }
                        },
                        {
                            "text": "He felt ashamed to be involved in such a <w>sordid</w> business deal.",
                            "target_lang_translations": {
                                "ru": "Ему было стыдно участвовать в такой <w>низкой</w> сделке."
                            }
                        }
                    ],
                    "antonyms": [
                        "noble",
                        "honorable"
                    ],
                    "common_phrases": [
                        "sordid details",
                        "sordid business"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально низкий, постыдный или порочный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "о подлом, недостойном поведении"
                            },
                            {
                                "target_lang_word": "постыдный",
                                "target_lang_sense_clarification": "о чем-то, вызывающем стыд или осуждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caf1ef22-91c4-38f8-8cbf-1b39aebcb2fc",
                    "sense_definition": "Grasping, stingy, or avaricious.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "greedy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>sordid</w> desire for wealth led him to cheat his own family.",
                            "target_lang_translations": {
                                "ru": "Его <w>корыстное</w> стремление к богатству заставило его обмануть собственную семью."
                            }
                        },
                        {
                            "text": "The merchant was known for his <w>sordid</w> habits and refusal to pay fair wages.",
                            "target_lang_translations": {
                                "ru": "Торговец был известен своими <w>жадными</w> привычками и отказом платить справедливую зарплату."
                            }
                        }
                    ],
                    "antonyms": [
                        "generous",
                        "charitable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скупой, алчный или корыстный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корыстный",
                                "target_lang_sense_clarification": "стремящийся к личной выгоде, часто нечестным путем"
                            },
                            {
                                "target_lang_word": "жадный",
                                "target_lang_sense_clarification": "чрезмерно стремящийся к накоплению богатства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "043e1a8c-a1b3-3373-8e96-d1dc326acc43",
                    "sense_definition": "Of a dull or dirty color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant had <w>sordid</w> leaves that looked brownish and unhealthy.",
                            "target_lang_translations": {
                                "ru": "У растения были <w>тусклые</w> листья, которые выглядели коричневыми и нездоровыми."
                            }
                        },
                        {
                            "text": "The old fabric had faded to a <w>sordid</w> grey over many years.",
                            "target_lang_translations": {
                                "ru": "За многие годы старая ткань выцвела до <w>грязновато-серого</w> цвета."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тусклого, грязного или неприятного цвета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тусклый",
                                "target_lang_sense_clarification": "о цвете, лишенном яркости и свежести"
                            },
                            {
                                "target_lang_word": "грязноватый",
                                "target_lang_sense_clarification": "о цвете с неприятным серым или коричневым оттенком"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}