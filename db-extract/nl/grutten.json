                                        "glosses": [
                                            "Grain mondé et moulu grossièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82f92946-38b7-4e1b-bc38-c33e40cc718d",
                                                "sense_id": "4d5c96b3-4bbb-34a1-9319-e29baf3fe4df",
                                                "text": "Gruau d’avoine, d’orge, de froment. Farine de gruau."
                                            },
                                            {
                                                "example_id": "13dcdf37-e035-42bf-aec3-c662ce620201",
                                                "sense_id": "4d5c96b3-4bbb-34a1-9319-e29baf3fe4df",
                                                "text": "à côté d’un beurre éblouissant de fraîcheur, le gros pain bis du villageois et le pain de gruau doré, cher à l’estomac blasé de l’habitant des villes"
                                            },
                                            {
                                                "example_id": "f4ab9209-cb0e-4b58-8635-0c6c8476a9dd",
                                                "sense_id": "4d5c96b3-4bbb-34a1-9319-e29baf3fe4df",
                                                "text": "Aigre, et pourtant cordiale, la voix de Mistress O’Molloy nous convia à un abondant déjeuner de gruau d’avoine, d’œufs au lard, de pommes de terre et de compotes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23e47e39-c200-365a-88d5-4a12c717a18e",
                                        "entry_id": "a3b921da-1bc0-3222-bccc-f506c93dce2b",
                                        "glosses": [
