                "senses": [
                    {
                        "sense_id": "961e5bfd-7a35-355e-83a1-c29c6c818991",
                        "entry_id": "439a91e4-6429-3ff8-ad3e-af2124e264fc",
                        "glosses": [
                            "Wortart, mit der eine Handlung (z.B. spielen, lachen, werfen), ein Zustand (glänzen, sich auflösen) oder ein Geschehen (regnen, schneien) ausgedrückt wird."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64ed2dbe-ee27-43a8-9179-8aee7035a7eb",
                                "sense_id": "961e5bfd-7a35-355e-83a1-c29c6c818991",
                                "text": "In dem Satz „Ich gehe nach Hause“ ist „gehe“ das Aussagewort."
                            },
                            {
                                "example_id": "f92f8d78-e87e-43be-b76d-2988749e1225",
                                "sense_id": "961e5bfd-7a35-355e-83a1-c29c6c818991",
                                "text": "Aussagewort kann man so verstehen, dass diese Wörter einen wesentlichen Teil der Satzaussage ausmachen.."
                            },
                            {
                                "example_id": "96cfd0b7-b386-48db-9d92-cac6f8717939",
                                "sense_id": "961e5bfd-7a35-355e-83a1-c29c6c818991",
                                "text": "Aussagewörter konjugieren nach Person, Numerus, Tempus und Modus."
                            }
                        ],
