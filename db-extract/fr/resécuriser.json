                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f2752e3-44a5-408c-9771-f8193181b255",
                                "sense_id": "68d94fc1-df1a-32d9-ad3f-e6cdfe370079",
                                "text": "Le Pentagone a d’ailleurs été contraint de dépenser plusieurs centaines de millions de dollars pour resécuriser son réseau."
                            },
                            {
                                "example_id": "e5b65a57-0876-435d-9a3f-b2feeaa2b57c",
                                "sense_id": "68d94fc1-df1a-32d9-ad3f-e6cdfe370079",
                                "text": "C'est la clé de la reprise en main de l 'autorité et un moyen de resécuriser la population."
                            },
                            {
                                "example_id": "631196d7-c623-44ab-9397-e822744b2577",
                                "sense_id": "68d94fc1-df1a-32d9-ad3f-e6cdfe370079",
                                "text": "De manière lapidaire, je dirais que les régions doivent assurer des compétences qui contribuent à «resécuriser» nos concitoyens."
                            }
                        ]
                    }
