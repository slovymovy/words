                ],
                "senses": [
                    {
                        "sense_id": "4b3e0b22-1b9e-39a0-a973-d94a6d2ea51f",
                        "entry_id": "6875d388-64c4-3541-97f6-ce6d3450acf7",
                        "glosses": [
                            "комп. жарг. элемент графического интерфейса, небольшая картинка, представляющая приложение, файл, каталог, окно, компонент операционной системы, устройство и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "becb821f-1c81-4fd3-9807-653077bfbcf6",
                                "sense_id": "4b3e0b22-1b9e-39a0-a973-d94a6d2ea51f",
                                "text": "При нажатии на маленькие иконки фотоаппарата, размешенные в разных участках планов, появляются фотографии настенных экспозиций и экспонатов музея."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4069e4f9-0a90-4943-80a3-3b09f807a18d",
                        "source_entry_id": "6875d388-64c4-3541-97f6-ce6d3450acf7",
                        "source_sense_id": "4b3e0b22-1b9e-39a0-a973-d94a6d2ea51f",
                        "target_lang_word": "icon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "icon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89a4adca-fcc4-396c-8742-89c9461f589c",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "An image, symbol, picture, portrait, or other representation usually as an object of religious devotion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8164ce4a-f168-3997-93b8-551bab83ebcb",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A type of religious painting portraying a saint or scene from Scripture, often done on wooden panels."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2d35b1-3368-4950-b70c-db15b4a7a5cf",
                                                "sense_id": "8164ce4a-f168-3997-93b8-551bab83ebcb",
                                                "text": "Last week the Archdiocese sent emmissaries to investigate the icon and decided that the tears were not a hoax, Father Koufos said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A person or thing that is the best example of a certain profession or some doing."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297e0326-6307-4220-992d-d96b3085a05f",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "That man is an icon in the business; he personifies loyalty and good business sense."
                                            },
                                            {
                                                "example_id": "a3aba1af-87b2-4578-9bb6-868333c0ac1a",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "Only a handful of rock musicians have become genuine icons - larger-than-life symbolic figures whose personal triumphs and vicissitudes seem to mirror the ups and downs of rock as a whole, and sometimes of the society that nurtures it. Often, rock icons become the objects of personality cults that tend to overshadow their musical accomplishments."
                                            },
                                            {
                                                "example_id": "22781430-9dd8-4c59-81fc-ed80a49d4319",
                                                "sense_id": "a2785472-a570-3dba-9925-50cd61e14b1f",
                                                "text": "Barbie is viewed as an icon of American culture in her new biography, Barbie: Her Life and Times (Crown, $25), written by Billy Boy, a clothing and jewelry designer in Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A small picture that represents something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e85a3c17-624a-4790-b75b-19a35ad1e5f4",
                                                "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                                "text": "Click the loudspeaker icon to configure audio settings."
                                            },
                                            {
                                                "example_id": "ad5ef221-8897-48d6-b5e7-d91348f1fc83",
                                                "sense_id": "48a83ca1-3675-3ee2-9565-7787134fddde",
                                                "text": "The program's most quintessentially Macintoshian feature, one as yet unique among spreadsheets, is its icon bar, which resides at the top of the screen just below the standard menu bar. It contains 21 icons, each of which allows the user to perform a specified function with but a few clicks of the mouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1f2c81-c51b-327c-94a7-5eaacdf4cead",
                                        "entry_id": "f75327f7-8ae5-338b-9fa0-f6a6fc22838d",
                                        "glosses": [
                                            "A small picture that represents something.",
                                            "An image used to represent a user; an avatar or profile picture."
                                        ],
