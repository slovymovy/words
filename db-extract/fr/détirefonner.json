                "senses": [
                    {
                        "sense_id": "b271f359-114a-3fc4-8fe3-6cc96fc0c1a3",
                        "entry_id": "816891bc-bb26-3cdf-9092-0948b491cb3e",
                        "glosses": [
                            "Enlever les tire-fond qui fixent les rails."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f455eba-0fc9-4c22-af0a-7693a39b6329",
                                "sense_id": "b271f359-114a-3fc4-8fe3-6cc96fc0c1a3",
                                "text": "Avec mes hommes, j'ai commencé à détirefonner la voie (nos clés, cette fois, étaient enroulées de chiffons) en laissant en place quatre tire-fond, afin que puisse passer le train de voyageurs qui précédait le convoi."
                            },
                            {
                                "example_id": "5eba8f1d-2c65-43cc-8486-0981f6798370",
                                "sense_id": "b271f359-114a-3fc4-8fe3-6cc96fc0c1a3",
                                "text": "J’ai donc eu une idée géniale : plutôt que de préparer une explosion qui risquait de mal tourner pour moi, j’allais mener à bien la rupture de voie en déclissant et en détirefonnant un couple de rails."
                            }
                        ]
                    }
