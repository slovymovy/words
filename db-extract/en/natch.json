                "senses": [
                    {
                        "sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                        "entry_id": "7eded231-c1e5-3bb8-b1bf-51575327a8cd",
                        "glosses": [
                            "Naturally; of course."
                        ],
                        "tags": [
                            "colloquial",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7cb41db2-9654-4acb-9a34-510c94eaaf1c",
                                "sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                                "text": "The Queen was seen wearing a hat when she visited Ascot, natch."
                            },
                            {
                                "example_id": "f2e2e3ec-21dd-434a-bd2a-61595f2ed62f",
                                "sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                                "text": "[Bug:] You can parry and thrust wittily at a press conference?\n [Dog:] Natch."
                            },
                            {
                                "example_id": "ceccfeb0-e5e9-4eec-b9de-ded1b3ae8478",
                                "sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                                "text": "Engineers held morning meetings sitting in rainbow-colored beanbags, took lunch gratis at the corporate sushi bar and unwound in the afternoon with craft brews from the office keg (nitrogen chilled, natch)."
                            },
                            {
                                "example_id": "823fe74f-becd-4a84-9df8-fb2003872f28",
                                "sense_id": "20935c59-4f45-3ffb-ab41-2418df9edd68",
                                "text": "The size of Trump’s penis? Somewhere between 6-7cm. All of this is foretold in Revelation 6:7, natch."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "028efb45-33e8-4b4d-b3ee-8cec58e1b893",
                        "source_entry_id": "7eded231-c1e5-3bb8-b1bf-51575327a8cd",
