                                    {
                                        "sense_id": "3f6ce763-275b-3e7c-910c-887dd299af0d",
                                        "entry_id": "89606681-2d0d-3942-8a75-5096ef2e9b42",
                                        "glosses": [
                                            "Synonym of mustard gas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a68f17e4-304f-4cd7-82a0-20bf3de1d8a5",
                                                "sense_id": "3f6ce763-275b-3e7c-910c-887dd299af0d",
                                                "text": "In the pre-war years the production of yperite was prepared at 6 plants in Moscow, Chapaevsk, Stalingrad, Dzerzhinsk, Berezniki and Stalinogorsk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
