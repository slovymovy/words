                            "text": "De winnaar van de wedstrijd ontving een gouden <w>penning</w> voor zijn prestatie.",
                            "target_lang_translations": {
                                "en": "The winner of the competition received a gold <w>medal</w> for his achievement."
                            }
                        },
                        {
                            "text": "Er werd een speciale <w>penning</w> geslagen ter gelegenheid van het jubileum.",
                            "target_lang_translations": {
                                "en": "A special <w>medallion</w> was struck to mark the anniversary."
                            }
                        }
                    ],
                    "synonyms": [
                        "medaille",
                        "munt"
                    ],
                    "common_phrases": [
                        "penning slaan",
                        "gouden penning"
                    ],
                    "target_lang_definitions": {
                        "en": "A metal object in the shape of a coin, usually intended as a souvenir or award."
                    },
                    "translations": {
