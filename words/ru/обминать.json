{
    "word_family": [
        "мять",
        "обмять",
        "обминание",
        "разминать",
        "сминать",
        "помять",
        "вминать"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32cbe27b-b3b1-334e-8679-ac93cff5c392",
                    "sense_definition": "уплотнять или осаживать что-либо, приминая кругом или сверху",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "физическое воздействие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пекарь начал аккуратно <w>обминать</w> подошедшее тесто, чтобы выпустить лишний газ.",
                            "target_lang_translations": {
                                "en": "The baker began to gently <w>punch down</w> the risen dough to release excess gas."
                            }
                        },
                        {
                            "text": "Во время посадки саженца нужно осторожно <w>обминать</w> землю вокруг корней руками.",
                            "target_lang_translations": {
                                "en": "When planting a sapling, you need to carefully <w>tamp down</w> the soil around the roots with your hands."
                            }
                        }
                    ],
                    "synonyms": [
                        "приминать",
                        "уминать"
                    ],
                    "common_phrases": [
                        "обминать тесто",
                        "обминать землю"
                    ],
                    "target_lang_definitions": {
                        "en": "to compress, compact, or press down around or on top (e.g. dough or soil)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "punch down",
                                "target_lang_sense_clarification": "dough"
                            },
                            {
                                "target_lang_word": "tamp down",
                                "target_lang_sense_clarification": "earth, soil"
                            },
                            {
                                "target_lang_word": "press down",
                                "target_lang_sense_clarification": "general"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc438b1-b449-3cdd-a0c8-5e2bfd08c906",
                    "sense_definition": "делать что-либо мягким, податливым, разминая со всех сторон",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "физическое воздействие",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед началом работы мастер стал <w>обминать</w> глину до полной однородности.",
                            "target_lang_translations": {
                                "en": "Before starting the work, the craftsman began to <w>knead</w> the clay until it was completely smooth."
                            }
                        },
                        {
                            "text": "Ребёнок любил подолгу <w>обминать</w> пластилин в тёплых ладонях перед лепкой фигур.",
                            "target_lang_translations": {
                                "en": "The child liked to <w>work</w> the modeling clay in warm palms for a long time before sculpting figures."
                            }
                        }
                    ],
                    "synonyms": [
                        "разминать",
                        "мять"
                    ],
                    "common_phrases": [
                        "обминать глину",
                        "обминать пластилин"
                    ],
                    "target_lang_definitions": {
                        "en": "to soften and make pliable by kneading or working with hands"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knead",
                                "target_lang_sense_clarification": "clay, dough, putty"
                            },
                            {
                                "target_lang_word": "work",
                                "target_lang_sense_clarification": "material into pliable state"
                            },
                            {
                                "target_lang_word": "soften",
                                "target_lang_sense_clarification": "by pressing or squeezing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7893b863-ac8b-3af5-80bd-24c1c6eb1e2d",
                    "sense_definition": "придавать удобную форму обуви или одежде в процессе носки",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "одежда и обувь",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новые кожаные сапоги жали, и приходилось постепенно <w>обминать</w> их дома.",
                            "target_lang_translations": {
                                "en": "The new leather boots pinched, and he had to gradually <w>break</w> them <w>in</w> at home."
                            }
                        },
                        {
                            "text": "Солдат долго пытался <w>обминать</w> жесткие армейские ботинки перед длинным маршем.",
                            "target_lang_translations": {
                                "en": "The soldier tried for a long time to <w>break in</w> the stiff army boots before the long march."
                            }
                        }
                    ],
                    "synonyms": [
                        "разбивать",
                        "разносить"
                    ],
                    "common_phrases": [
                        "обминать сапоги",
                        "обминать обувь"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to break in footwear or clothing by wearing and shaping it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break in",
                                "target_lang_sense_clarification": "shoes, boots, clothing"
                            },
                            {
                                "target_lang_word": "wear in",
                                "target_lang_sense_clarification": "footwear"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73f384d0-4125-3979-911f-9e2aa9f32e00",
                    "sense_definition": "подвергая трудностям или жизненным испытаниям, делать кого-либо более уступчивым, сговорчивым",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "воздействие на человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Суровая армейская служба и дисциплина быстро начали <w>обминать</w> упрямого новобранца.",
                            "target_lang_translations": {
                                "en": "Harsh army service and discipline quickly began to <w>break</w> the stubborn recruit."
                            }
                        },
                        {
                            "text": "Трудности первых лет работы стали постепенно <w>обминать</w> его гордый и резкий характер.",
                            "target_lang_translations": {
                                "en": "The difficulties of the first years of work gradually began to <w>soften</w> his proud and harsh character."
                            }
                        }
                    ],
                    "synonyms": [
                        "ломать",
                        "подчинять"
                    ],
                    "common_phrases": [
                        "обминать характер"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to make someone more compliant, pliant, or yielding through hardships or discipline"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tame",
                                "target_lang_sense_clarification": "temper, stubborn person"
                            },
                            {
                                "target_lang_word": "break",
                                "target_lang_sense_clarification": "someone's stubbornness or will"
                            },
                            {
                                "target_lang_word": "soften",
                                "target_lang_sense_clarification": "disposition or pride"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d7f7d54-70f9-397a-bedb-82749d9451bd",
                    "sense_definition": "подвергая невзгодам или испытаниям, лишать свежести, сил; изнурять, трепать",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "воздействие на человека",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тяжелая и беспросветная жизнь продолжала беспощадно <w>обминать</w> старика все эти долгие годы.",
                            "target_lang_translations": {
                                "en": "A hard and bleak life continued to mercilessly <w>wear down</w> the old man through all those long years."
                            }
                        },
                        {
                            "text": "Постоянные тревоги и ночные смены начали заметно <w>обминать</w> ещё молодую женщину.",
                            "target_lang_translations": {
                                "en": "Constant anxiety and night shifts began to visibly <w>take a toll on</w> the still young woman."
                            }
                        }
                    ],
                    "synonyms": [
                        "трепать",
                        "изнурять"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "переносное разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to wear down, exhaust, or take a toll on someone's appearance or vitality through hardships"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wear down",
                                "target_lang_sense_clarification": "exhaust or age someone"
                            },
                            {
                                "target_lang_word": "take a toll on",
                                "target_lang_sense_clarification": "health or youth"
                            },
                            {
                                "target_lang_word": "weather",
                                "target_lang_sense_clarification": "make aged or worn"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}