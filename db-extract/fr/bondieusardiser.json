                "senses": [
                    {
                        "sense_id": "0bbd051b-e9ce-3074-a5c8-9b4070b9f3ed",
                        "entry_id": "26c90688-523a-38eb-aba1-caabe51f3f5f",
                        "glosses": [
                            "Donner un caractère bondieusard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13d8c6d6-beef-4827-a9ad-b3dca84c7551",
                                "sense_id": "0bbd051b-e9ce-3074-a5c8-9b4070b9f3ed",
                                "text": "Si vous tenez absolument à bondieusardiser la jeunesse, de quel Dieu comptez-vous lui enseigner l’existence ?"
                            },
                            {
                                "example_id": "1e670245-e35f-43ba-9169-fe2ac95f3808",
                                "sense_id": "0bbd051b-e9ce-3074-a5c8-9b4070b9f3ed",
                                "text": "Ce sont les hommes qui ont brisé l'unité. Ce n'est ni Dieu, ni Abraham, ni Moïse, ni Jacob, ni Jésus, ni Mahomet. Ce sont les hommes et leurs religions mal fagotées, mal apprises, mal comprises, déformées, sécularisées, anarchisées, pouvoirdisées, bondieusardisées !"
                            }
                        ]
                    }
                ],
