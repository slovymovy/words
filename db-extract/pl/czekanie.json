                    }
                ],
                "translations": [
                    {
                        "translation_id": "77470916-fa73-4daf-83b4-6c09305514d6",
                        "source_entry_id": "f05db278-9713-386f-bd0a-532d090cba9f",
                        "source_sense_id": "ce48b0c9-2e38-3db8-bed2-fd42a7a4b273",
                        "target_lang_word": "waiting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waiting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e405b2a7-5e3a-35b0-afc3-62c5b2cb4bc2",
                                        "entry_id": "3dab00f4-abae-3cb0-ad41-84e7020d5213",
                                        "glosses": [
                                            "present participle and gerund of wait"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4aee5f4e-935a-42d8-bd8c-9d862d4dd0a0",
                                                "sense_id": "e405b2a7-5e3a-35b0-afc3-62c5b2cb4bc2",
                                                "text": "Your guest has been waiting for you. (progressive) They hurried into the waiting car. (participle used as adjective)"
                                            },
                                            {
                                                "example_id": "3845bc7e-708c-418c-be7a-8b3ec6f8bb3e",
                                                "sense_id": "e405b2a7-5e3a-35b0-afc3-62c5b2cb4bc2",
                                                "text": "At the far end of the houses the head gardener stood waiting for his mistress, and he gave her strips of bass to tie up her nosegay. This she did slowly and laboriously, with knuckly old fingers that shook."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "waiting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e76a49cd-60d8-3680-a6bb-86e69bae4391",
                                        "entry_id": "075a0201-f99d-39ef-8e35-597caad92967",
                                        "glosses": [
                                            "Watching, observation; keeping watch, guarding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3deae8ca-972e-36f1-92db-47f05a046ef6",
                                        "entry_id": "075a0201-f99d-39ef-8e35-597caad92967",
                                        "glosses": [
                                            "The act of staying or remaining in expectation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0823cb6d-0c81-4d89-8a27-8509b897263b",
                                                "sense_id": "3deae8ca-972e-36f1-92db-47f05a046ef6",
                                                "text": "Waiting for any news in a waiting room. (gerund)"
                                            },
                                            {
                                                "example_id": "88fd9fc7-2d15-4ff7-be83-8984db883202",
                                                "sense_id": "3deae8ca-972e-36f1-92db-47f05a046ef6",
                                                "text": "In all ages, men have fought over words, without waiting to know what the words really signified."
                                            },
                                            {
                                                "example_id": "ca3fcdf4-63ef-49ac-84ae-b1740fcf162b",
                                                "sense_id": "3deae8ca-972e-36f1-92db-47f05a046ef6",
                                                "text": "There was an awful waiting in the earth, / As if a mystery greatened to its birth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84690b1d-4412-389a-b502-0b479a341205",
                                        "entry_id": "075a0201-f99d-39ef-8e35-597caad92967",
                                        "glosses": [
                                            "Attendance, service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "483af1c6-c429-4366-bea9-3268c5b94c3c",
                                                "sense_id": "84690b1d-4412-389a-b502-0b479a341205",
                                                "text": "But it had never occurred to him that he should live in any other than what he would have called an ordinary way, with green glasses for hock, and excellent waiting at table."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c87088-28de-43bc-94f3-d5ff62a1f5fe",
                        "source_entry_id": "f05db278-9713-386f-bd0a-532d090cba9f",
                        "source_sense_id": "ce48b0c9-2e38-3db8-bed2-fd42a7a4b273",
                        "target_lang_word": "Wartezeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wartezeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                        "entry_id": "c0db52e0-7617-3931-a83b-a770323fcf64",
                                        "glosses": [
                                            "die Zeit, die bis zu einem geplanten Ereignis vergeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "776ddedf-2f20-4395-b1c9-1ca2139ee621",
                                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                                "text": "„Normal sind Wartezeiten von bis zu fünf Monaten.“"
                                            },
                                            {
                                                "example_id": "9458f275-d9be-4e77-846d-dfb9dc602d87",
                                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                                "text": "„Holländer zeigen immer diese stoische Ruhe, wenn etwas schiefläuft, ob es nun um den Nahverkehr, die Wartezeiten im Krankenhaus oder chronische Stromausfälle geht.“"
                                            },
                                            {
                                                "example_id": "2c2e3067-c929-4418-aaf8-633d72ca31ef",
                                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                                "text": "„Wer aktuell nach Dänemark ein- oder ausreisen möchte, muss gelegentlich mit Wartezeiten an den Grenzübergängen rechnen.“"
                                            },
                                            {
                                                "example_id": "67d455e3-4e2b-4602-81b4-1982b6b8798b",
                                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                                "text": "„Nach sechs Wochen Wartezeit kam der Lama endlich.“"
                                            },
                                            {
                                                "example_id": "3c2771a9-7aea-429d-91a9-4941e1020081",
                                                "sense_id": "23d17583-b523-3ca5-9992-fb246b365f35",
                                                "text": "„Von Zeit zu Zeit wandte er sich, in die Hände klatschend, zum Kapellmeister, damit dieser den Einsatz zu einer Polka oder einer Mazurka gebe, um die Wartezeit zu überbrücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
