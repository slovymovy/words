                "senses": [
                    {
                        "sense_id": "188e0c7a-1648-3d0c-bddd-a44f7e4eaa1a",
                        "entry_id": "f43d7a96-cb46-3baa-8f79-e19e414bd353",
                        "glosses": [
                            "Infirmier ou sage-femme spécialisé en puériculture, dans les soins apportés aux nouveau-nés, aux nourrissons et aux enfants malades."
                        ],
                        "tags": [
                            "Puériculture"
                        ],
                        "examples": [
                            {
                                "example_id": "bccd1144-d30d-4ffc-b588-729953231474",
                                "sense_id": "188e0c7a-1648-3d0c-bddd-a44f7e4eaa1a",
                                "text": "Comme la matrone pour la sage-femme, la voisine déjà mère et surtout la grand-mère sont, pour le puériculteur, des rivales dont il faut combattre les préceptes pour asseoir le pouvoir médical."
                            },
                            {
                                "example_id": "72022f36-0f7e-4248-94bf-edbbe29a9dc7",
                                "sense_id": "188e0c7a-1648-3d0c-bddd-a44f7e4eaa1a",
                                "text": "Dans les structures d’accueil dédié à la petite enfance, les hommes sont très peu nombreux. La Ville de Liège compte environ 350 puéricultrices parmi lesquelles on trouve seulement… quatre puériculteurs."
                            }
                        ]
                    }
