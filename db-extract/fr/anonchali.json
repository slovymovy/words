                        "examples": [
                            {
                                "example_id": "e9f47210-7275-46ac-af8b-ff147c3455bb",
                                "sense_id": "aab56868-9b70-3880-ad26-fef25118b780",
                                "text": "En attendant, le mutisme obstiné de Désirée, ses allures anonchalies, son indifférence toujours croissante à soigner les plats, jetèrent Vatard dans des rages sourdes qui compromirent ses digestions."
                            },
                            {
                                "example_id": "7c631dca-9953-4bcd-9f57-f716ebccd786",
                                "sense_id": "aab56868-9b70-3880-ad26-fef25118b780",
                                "text": "Au moment de rentrer, de se baigner dans l’intimité du ménage, ils souriaient, anonchalis d’avance, et une langueur leur descendait des reins aux jambes, et leurs étreintes cherchaient des objets moins rugueux et moins inertes."
                            }
                        ]
                    }
