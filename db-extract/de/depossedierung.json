                ],
                "senses": [
                    {
                        "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                        "entry_id": "9faa25fc-d19a-34f2-98e8-ddd956f3aa30",
                        "glosses": [
                            "Entfernung, Entzug der Machtstellung oder von Territorium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37218128-da3a-493f-ac53-282e88f8072b",
                                "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                                "text": "„In der Depossedierung der Autorität ist immer eine Frage nach dem inneren Recht der Autorität lebendig.“"
                            },
                            {
                                "example_id": "728b5a65-823f-42f1-8d53-d9c6163efa52",
                                "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                                "text": "„Der Intellektuelle, der sich als aristokratischer Ästhetizist gebärdet, lebt selbst in latenter Marginalisierung und drohender Depossedierung.“"
                            },
                            {
                                "example_id": "012de639-5b0b-46e6-9b13-5038b901a5ef",
                                "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                                "text": "„Das Königreich Italien beruhte auf der Depossedierung einer Reihe italienischer Fürstenhäuser.“"
                            },
                            {
                                "example_id": "0e0a25c2-e757-43f3-8f67-76ef9a9addac",
                                "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                                "text": "„Aber auch den feudalistischen Staat, der nichts mehr besitzt als gewaltsam usurpierte Ausbeuterrechte, ereilt das Schicksal neuerlicher Depossedierung.“"
                            },
                            {
                                "example_id": "8dc1ce20-a4a1-4929-86e6-8e6301ac9f90",
                                "sense_id": "4ee560be-5d19-370f-b29f-367aa6636f9e",
                                "text": "„Nun ist allerdings nicht zu verkennen, dass die Abmeierungen und Depossedierungen der Bauern und die Einziehung der bäuerlichen Güter durch die Herren, besonders zur Zeit des Verfalles des Lehenswesens, als die Herren zur Selbstbewirtschaftung ihrer Güter übergingen, massenhaft stattgefunden haben […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
