                        ],
                        "form": "транспара́нтах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9875804-c227-3392-b9f2-fb7a781b2f00",
                        "entry_id": "ec2bc09f-bc79-314b-8e7d-4074aa37bec6",
                        "glosses": [
                            "широкая полоса материи (изначально прозрачной) с лозунгом или изображением, обычно используется на демонстрациях"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "62a64912-21a8-3555-8c9f-e0b2ebe59539",
                        "entry_id": "ec2bc09f-bc79-314b-8e7d-4074aa37bec6",
                        "glosses": [
                            "разлинованный чёрными жирными линиями лист, подкладываемый под нелинованную бумагу так, чтобы линии, просвечивая, заменяли собой линовку для ровного письма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0565ab-d21f-485f-83e9-b55cd0960c06",
                                "sense_id": "62a64912-21a8-3555-8c9f-e0b2ebe59539",
                                "text": "Воскресенья он обычно проводил, читая романы приключений или же линуя транспаранты, которые потом дарил сослуживцам."
                            }
                        ]
                    },
                    {
                        "sense_id": "1237b5b5-d298-33b8-ad48-69bf50715efe",
                        "entry_id": "ec2bc09f-bc79-314b-8e7d-4074aa37bec6",
                        "glosses": [
                            "изображение на прозрачном материале, подсвеченное сзади"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28025a60-1083-4913-94f3-0fcf87cae2e2",
                                "sense_id": "1237b5b5-d298-33b8-ad48-69bf50715efe",
                                "text": "Эта картина в свое время так поразила наивную петербургскую публику, что многим тогда казалось, будто для достижения эффекта мастер должен был непременно прибегнуть к транспаранту, к освещению сзади и спереди и т.п. “шарлатанским фокусам”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6e597ae-fe1d-499b-b601-ec3f799e9f39",
                        "source_entry_id": "ec2bc09f-bc79-314b-8e7d-4074aa37bec6",
                        "source_sense_description": "широкая полоса материи с лозунгом",
                        "target_lang_word": "banderole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banderole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe967e4-ae69-3e29-a55b-00ba1e18e7b7",
                                        "entry_id": "f86daed9-81e3-3a42-8663-ec68904a1c16",
                                        "glosses": [
                                            "Petit bande d’étoffe flottante en forme de flamme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b29444f0-a2e4-4b11-8f56-6f09dc9241cf",
                                                "sense_id": "9fe967e4-ae69-3e29-a55b-00ba1e18e7b7",
                                                "text": "Un vaisseau avec ses banderoles."
                                            },
                                            {
                                                "example_id": "a8627c12-e366-4a20-b5a0-347746a42cb4",
                                                "sense_id": "9fe967e4-ae69-3e29-a55b-00ba1e18e7b7",
                                                "text": "La tente du chef était ornée de banderoles."
                                            },
                                            {
                                                "example_id": "50a71f7c-b829-4772-951b-7d74a98b3334",
                                                "sense_id": "9fe967e4-ae69-3e29-a55b-00ba1e18e7b7",
                                                "text": "Un pain bénit orné de petites banderoles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f45fe429-fe52-3882-872b-83629359de4b",
                                        "entry_id": "f86daed9-81e3-3a42-8663-ec68904a1c16",
                                        "glosses": [
                                            "Bande de tissu naturel ou synthétique sur laquelle sont portées des inscriptions notamment politiques, syndicales, publicitaires…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "918417a2-10c4-40a4-8daf-06891c1d5cc8",
                                                "sense_id": "f45fe429-fe52-3882-872b-83629359de4b",
                                                "text": "Quelque temps après que l’équipe de SDV eût fini d’installer la salle, les anti-éoliens regroupés sous l’égide de la FSPE se rassemblèrent devant le clocher en exhibant des banderoles « Non aux éoliennes ! »"
                                            },
                                            {
                                                "example_id": "0c32eade-f1cb-4049-9a66-cc307ed5efa6",
                                                "sense_id": "f45fe429-fe52-3882-872b-83629359de4b",
                                                "text": "L’avion passait et repassait au-dessus de la plage en tirant derrière lui une banderole publicitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bd2cc82-a96a-3d7d-afa0-a5e5d59e0d5d",
                                        "entry_id": "f86daed9-81e3-3a42-8663-ec68904a1c16",
                                        "glosses": [
                                            "Bande de carton léger (ou autre matière) servant à grouper plusieurs produits."
                                        ],
                                        "tags": [
                                            "Emballage"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "564b03d0-02bc-37e0-8b25-bd3487554f14",
                                        "entry_id": "f86daed9-81e3-3a42-8663-ec68904a1c16",
                                        "glosses": [
                                            "Sorte de phylactère, relié à un personnage et contenant le texte de ses paroles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75fd2e8-909d-4ade-83ef-d34a8ee5b88a",
                                                "sense_id": "564b03d0-02bc-37e0-8b25-bd3487554f14",
                                                "text": "Les deux amants magnifiques avaient une conversation essentielle à l’aide de banderoles ondulées qui leur sortaient de la bouche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77216252-e8e1-3dc5-b45c-0973a0aad745",
                                        "entry_id": "f86daed9-81e3-3a42-8663-ec68904a1c16",
                                        "glosses": [
                                            "Paroles dites sans y croire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06564c54-d89e-4352-9d6d-67c68517d05d",
                                                "sense_id": "77216252-e8e1-3dc5-b45c-0973a0aad745",
                                                "text": "« Tu n’as pas du tout envie de mourir. C’est de la banderole. Tu vas voir que tu as envie au contraire d’un bel éclair à la Chantilly. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ff62505-ea2a-469c-a1d1-7184a974fc32",
                        "source_entry_id": "ec2bc09f-bc79-314b-8e7d-4074aa37bec6",
                        "source_sense_description": "разлинованный чёрными жирными линиями лист",
                        "target_lang_word": "guide-âne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guide-âne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6dfd85f-949d-3793-8f69-13ba28da8467",
                                        "entry_id": "68f4b314-525c-397e-9b47-af14ae4177c3",
                                        "glosses": [
                                            "Petit livre élémentaire qui contient des instructions, des règles propres à guider dans un travail, dans l’exercice d’un art, d’une profession, etc."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6962c508-8463-475e-afcd-ef578a7d3f62",
                                                "sense_id": "d6dfd85f-949d-3793-8f69-13ba28da8467",
                                                "text": "Il suffit, pour élucider définitivement la première question, de rappeler la fameuse \"Note pour toutes les armées\", signée Joffre. Ce guide-âne, qu'au lendemain des premiers revers, après les batailles de Sarrebourg, de Morhange, des Ardennes, de Charleroi, le G.Q.G. était forcé d'édicter, le 24 aout 1914, à l'adresse des cadres de toutes armes, quel plus clair aveu d'une faillite de l'éducation militaire proprement dite ?"
                                            },
                                            {
                                                "example_id": "3b06e841-1df7-49ce-9f5d-7f2c2b411a9e",
                                                "sense_id": "d6dfd85f-949d-3793-8f69-13ba28da8467",
                                                "text": "À mesure que j”écris, le plan que je m'étais tracé m'échappe et l’on dirait que plus je regarde en moi-même plus tout ce que je vois devient confus, les thèmes que j’avais cru primitivement distinguer se révélant inconsistants et arbitraires, comme si ce classement n’était en fin de compte qu'une sorte de guide-âne abstrait, voire un simple procédé de composition esthétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69f0d12c-01a7-36f3-b769-a67af3451b2c",
                                        "entry_id": "68f4b314-525c-397e-9b47-af14ae4177c3",
                                        "glosses": [
                                            "Petit livre qui contient l'ordre des fêtes et offices religieux"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1b6be31-1710-3737-8fe7-049803195986",
                                        "entry_id": "68f4b314-525c-397e-9b47-af14ae4177c3",
                                        "glosses": [
                                            "Feuille de papier sur laquelle sont tracées des lignes horizontales que l'on peut voir en transparence quand on pose une feuille par-dessus et qui permet d'écrire droit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9f95494-e69d-3729-848d-1ac9b1f4d99a",
                                        "entry_id": "68f4b314-525c-397e-9b47-af14ae4177c3",
                                        "glosses": [
                                            "Couteau à deux lames servant à découper les dents des peignes. Une des lames coupe tandis que l'autre trace la découpe suivante."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
