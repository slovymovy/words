                "senses": [
                    {
                        "sense_id": "b61442b5-3a0b-3df5-b239-c7cc112b15c4",
                        "entry_id": "aa68a18a-0179-3ab6-96cd-35eeec05110c",
                        "glosses": [
                            "schriftliche Auseinandersetzung mit einer oder mehreren Entscheidungsinstanzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e301b17e-ce4c-490b-9ca7-27b898b479df",
                                "sense_id": "b61442b5-3a0b-3df5-b239-c7cc112b15c4",
                                "text": "„Innerhalb der Vereinigten Staaten hörte der Papierkrieg zwar nicht auf, aber er war doch wesentlich humaner als in den europäischen Nachbarstaaten des Dritten Reiches.“"
                            },
                            {
                                "example_id": "aaa9b805-5f5a-450c-8bf1-5565ff281e05",
                                "sense_id": "b61442b5-3a0b-3df5-b239-c7cc112b15c4",
                                "text": "„Wenn er einfach blieb, konnten die Vorgesetzten seine Versetzung zwar erzwingen, aber dazu müssten sie Stellung beziehen, was einen schmutzigen Papierkrieg zur Folge hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68818433-e958-462e-a1ec-77da1a642850",
                        "source_entry_id": "aa68a18a-0179-3ab6-96cd-35eeec05110c",
                        "source_sense_id": "b61442b5-3a0b-3df5-b239-c7cc112b15c4",
