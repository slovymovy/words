                                        "glosses": [
                                            "Celui qui écrit des annales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9470588-d544-4ab6-bb72-3a4c8c10ebab",
                                                "sense_id": "9b99fc6d-f751-3549-a818-21e6607d421c",
                                                "text": "C’est regrettable, car ils l’eussent racontée, l’un avec la précision d’un annaliste, l’autre avec cette poésie instinctive dont sont empreintes ses relations de voyage."
                                            },
                                            {
                                                "example_id": "b2e33b7c-3046-4b20-811e-1fba2e8e0d33",
                                                "sense_id": "9b99fc6d-f751-3549-a818-21e6607d421c",
                                                "text": "Allez donc dire cette billevesée à nos annalistes !"
                                            },
                                            {
                                                "example_id": "ede5e164-f138-4961-a25b-bd820752cab5",
                                                "sense_id": "9b99fc6d-f751-3549-a818-21e6607d421c",
                                                "text": "C’est l’annaliste L. Calpurnius Pison (suivi par Denys) qui, à la suite de calculs chronologiques, faisait de Tarquin l’Ancien l’aïeul de Lucius."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
