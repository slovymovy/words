                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa208b64-bf87-4421-993e-0004f4cd48be",
                                "sense_id": "4835ac72-2239-305f-8601-50877094f09f",
                                "text": "„1676 war Birmingham kaum ein Marktflecken. Gerbereien und Eisenschmieden gab es aber daselbst schon Jahrhunderte früher.“"
                            },
                            {
                                "example_id": "583ce46a-5ea7-46d5-a70e-a330c5cda216",
                                "sense_id": "4835ac72-2239-305f-8601-50877094f09f",
                                "text": "„In den Holzkohlemeilern, Schmelzhütten und Eisenschmieden verbrannten die Wälder, und abgeholzt standen sie in den Städten herum.“"
                            }
                        ],
