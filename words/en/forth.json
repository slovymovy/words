                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened animals began to peek <w>forth</w> their burrows once the predator had left.",
                            "target_lang_translations": {
                                "ru": "Напуганные животные начали выглядывать <w>из</w> своих нор, как только хищник ушел."
                            }
                        },
                        {
                            "text": "He watched the smoke rise <w>forth</w> the chimney into the cold winter air.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как дым поднимается <w>из</w> трубы в холодный зимний воздух."
                            }
                        }
                    ],
                    "traits": [
