                    {
                        "translation_id": "65baeedc-1942-4ec1-950a-55d5765becef",
                        "source_entry_id": "98a66092-ae98-3b73-a44b-4c37a334adad",
                        "source_sense_description": "Lepisma saccharina",
                        "target_lang_word": "Silberfischchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silberfischchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdf81acf-e564-3508-9c3f-d94c49f57557",
                                        "entry_id": "7853937b-5e98-3b31-a1f2-d389f6a8d14c",
                                        "glosses": [
                                            "ein flügelloses Insekt , das in Häusern lebt"
                                        ],
                                        "tags": [
                                            "Entomologie",
                                            "Lepisma saccharinum"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3be977e-c347-4ad7-8fca-d6fc1d5bd9a3",
                                                "sense_id": "cdf81acf-e564-3508-9c3f-d94c49f57557",
                                                "text": "Silberfischchen fressen gern Zucker."
                                            },
                                            {
                                                "example_id": "166b3878-ae89-4238-992f-f4ae6e4f13cf",
                                                "sense_id": "cdf81acf-e564-3508-9c3f-d94c49f57557",
                                                "text": "„Wir hatten gemeinsam geduscht und schauderten beim Anblick der Myriaden von Silberfischchen, die das Badezimmer bevölkerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dd7a987-4bed-40c0-b252-9a4fb68e4bbf",
                        "source_entry_id": "98a66092-ae98-3b73-a44b-4c37a334adad",
                        "source_sense_description": "Lepisma saccharina",
                        "target_lang_word": "Fischchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb886a3-c211-36b0-8886-a5e27cf80f46",
                                        "entry_id": "b9cf96f7-a54b-32bf-ae8c-79aca07ed896",
                                        "glosses": [
                                            "kleiner Fisch"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2ddd3-c905-4b05-ae4f-904f7c09e3ae",
                                                "sense_id": "8bb886a3-c211-36b0-8886-a5e27cf80f46",
                                                "text": "Nur ein winziges Fischchen ging an die Angel."
                                            },
                                            {
                                                "example_id": "34983d2d-96c9-4303-997b-6895fb3a19e0",
                                                "sense_id": "8bb886a3-c211-36b0-8886-a5e27cf80f46",
                                                "text": "„Damit beugte sie sich wieder über ihre Unterlagen, obwohl die Zahlen wie Fischchen vor ihren Augen hin- und herschwammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14e25e88-d25d-35dd-b8a2-4b62fa65fd1c",
                                        "entry_id": "b9cf96f7-a54b-32bf-ae8c-79aca07ed896",
                                        "glosses": [
                                            "flügelloses Insekt aus der Ordnung Zygentoma"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b96fb6d-225e-4ee5-86b3-87e75f37afa2",
                                                "sense_id": "14e25e88-d25d-35dd-b8a2-4b62fa65fd1c",
                                                "text": "Die Fischchen (Zygentoma) sind eine Ordnung der Insekten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                        "entry_id": "b9cf96f7-a54b-32bf-ae8c-79aca07ed896",
                                        "glosses": [
                                            "magnetisches, meist mit Glas überzogenes Stäbchen zum Rühren von Flüssigkeiten mit einem Magnetrührer"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b848f4-6bfa-4e2f-a0d4-f9d43832871e",
                                                "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                                "text": "Mithilfe von Fischchen lassen sich Stoffe auch in geschlossenen Behältern vermischen."
                                            },
                                            {
                                                "example_id": "3c81b7b9-3af6-4606-a330-c620ad39bc41",
                                                "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                                "text": "„Magnetrührer mit Fischchen“"
                                            },
                                            {
                                                "example_id": "f7dfef42-8be2-459f-932f-980eea5f72f3",
                                                "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                                "text": "„Fischchen in den Erlenmeyerkolben geben und auf Magnetrührer stellen“"
                                            },
                                            {
                                                "example_id": "f7713b00-d597-4188-8d24-b031bb558dff",
                                                "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                                "text": "„Nach dem Abgießen der Waschflüssigkeit wurde der Inhalt beider Kolben mittels magnetischem Fischchen und Rührgerät unter Zugabe von einigen Milliliter einer Trypsin-EDTA-Lösung soweit verdaut, dass sich der Großteil der Zellen aus seinem Zellverband löste […]“"
                                            },
                                            {
                                                "example_id": "a4ecbb31-f787-4129-9552-7162cd8ab20b",
                                                "sense_id": "d705e7ed-9ea6-383e-ba92-7e0d8d01d56e",
                                                "text": "„Der Magnetrüher wurde auf höchste Stufe gestellt, das Fischchen war trapezförmig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
