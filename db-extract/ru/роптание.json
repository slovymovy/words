                                            "onomatopoeic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "160e0d2f-c382-3ccd-a9c7-dfc53565bb00",
                                        "entry_id": "b7845685-d692-31c7-a42f-d497978c6537",
                                        "glosses": [
                                            "The sound made by a hungry stomach."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "77fe03ab-39c2-3253-a2f5-6baf5aedbfcd",
                                        "entry_id": "b7845685-d692-31c7-a42f-d497978c6537",
                                        "glosses": [
                                            "A surly complaint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f049b67-115d-4205-a318-010d0ac8fa54",
                                                "sense_id": "77fe03ab-39c2-3253-a2f5-6baf5aedbfcd",
                                                "text": "That whiner is never without a grumble to share."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grumble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12762797-e322-335e-9eb3-0315ca7ba47b",
                                        "entry_id": "90f9a8e5-15af-3e29-a85c-210673fb6de6",
                                        "glosses": [
                                            "To make a low, growling or rumbling noise, like a hungry stomach or certain animals."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c18ab6b-f88f-4453-bb55-403f6060508e",
                                                "sense_id": "12762797-e322-335e-9eb3-0315ca7ba47b",
                                                "text": "The distant thunder grumbles."
                                            },
                                            {
                                                "example_id": "8d61d7a5-c58c-46fa-930c-649cba74f9c5",
                                                "sense_id": "12762797-e322-335e-9eb3-0315ca7ba47b",
                                                "text": "It made his stomach grumble in protest to think the mule was eating, and here he was worrying about her with an empty belly of his own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25025054-a5e3-3912-a688-1fae0ca61b3d",
                                        "entry_id": "90f9a8e5-15af-3e29-a85c-210673fb6de6",
                                        "glosses": [
                                            "To complain; to murmur or mutter with discontent; to make ill-natured complaints in a low voice and a surly manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab676f39-ddba-4942-96d0-2c7238df0c97",
                                                "sense_id": "25025054-a5e3-3912-a688-1fae0ca61b3d",
                                                "text": "He grumbles about the food constantly, but has yet to learn to cook."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2ae2259-d693-3c34-9150-3dc4344be32e",
                                        "entry_id": "90f9a8e5-15af-3e29-a85c-210673fb6de6",
                                        "glosses": [
                                            "To utter in a grumbling fashion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "225fd4bf-e1fc-4e9d-ab15-79dbda7e959f",
                                                "sense_id": "f2ae2259-d693-3c34-9150-3dc4344be32e",
                                                "text": "He grumbled that there was no grain \"in the country\" and that people were talking instead of working to provide it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
