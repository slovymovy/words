        "de-extract.jsonl": [
            {
                "entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                "word": "akcyjnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [
                    {
                        "form_id": "701e4548-6373-4707-8e21-5c27444a4ed7",
                        "entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                        "tags": [
                            "positive"
                        ],
                        "form": "akcyjnie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd191c2a-d200-396f-8499-0a99eddf9d2b",
                        "entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                        "glosses": [
                            "einmalig und von kurzer Dauer; vorläufig, planlos, unüberlegt"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75dfb09d-190a-4089-aff6-5096e9a34db9",
                        "source_entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                        "source_sense_id": "cd191c2a-d200-396f-8499-0a99eddf9d2b",
                        "source_sense_description": "einmalig und von kurzer Dauer; vorläufig, planlos, unüberlegt",
                        "target_lang_word": "vorläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                        "entry_id": "1e32a1d8-0b52-3b52-ac0d-2621fd31694f",
                                        "glosses": [
                                            "nicht endgültig, bis zu einer späteren Festlegung gültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e662726-e720-484f-8df3-a090647b81be",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "Das hier soll nur eine vorläufige Lösung sein."
                                            },
                                            {
                                                "example_id": "0e709f96-84a0-4734-ab89-857d72f31f04",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "f78c568c-d9e7-4bd7-bf7e-608727c43be7",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                        "entry_id": "79c35e8a-7bf5-374a-b885-cfd3bf0b821e",
                                        "glosses": [
                                            "fürs Erste, bis auf Weiteres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b7c8de-be16-4a42-a61f-3b784d138505",
                                                "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                                "text": "Wir müssen uns vorläufig mit einer kleinen Wohnung zufrieden geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a5e23a3-bcd3-4bb7-86b8-290dd746c600",
                        "source_entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                        "source_sense_id": "cd191c2a-d200-396f-8499-0a99eddf9d2b",
                        "source_sense_description": "einmalig und von kurzer Dauer; vorläufig, planlos, unüberlegt",
                        "target_lang_word": "planlos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planlos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                        "entry_id": "ba507b28-b750-3f1f-8c0a-fc208857a6c3",
                                        "glosses": [
                                            "ziellos, aufs Geratewohl, unüberlegt, ohne Struktur, ohne System, ohne Plan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28641c47-b00e-44bd-8f58-16003af584e0",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Sein planloses Herangehen an dieses Projekt ließ es dann auch scheitern."
                                            },
                                            {
                                                "example_id": "906c5bbe-44d9-4213-97c5-efae5dcfb82d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "„Wie kann man nur so planlos sein, sich so überhaupt keine Gedanken machen? Du bist mir ein Rätsel!“"
                                            },
                                            {
                                                "example_id": "ca43e1cd-330a-4a06-861d-928be380a77d",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Über eine Milliarde US-Dollar sind nach Angaben des neuen Finanzministers Hoshiar Zebari seit Juni an schiitische Milizen geflossen. Das Geld sei planlos verteilt worden, die Vorgängerregierung von Nuri Al-Maliki habe darüber nicht Buch geführt."
                                            },
                                            {
                                                "example_id": "105dd2b7-05fd-4c69-a72a-05b8201c663f",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Von dem Tor erholte sich Kamerun lange nicht. Noch planloser wurde der Ball nach vorne gedroschen und in Trauben aus Abwehrspielern hineingedribbelt."
                                            },
                                            {
                                                "example_id": "45039e7e-ec2f-4007-b1af-b8a9e19f9195",
                                                "sense_id": "b81bf00d-c9df-3e88-ad10-7a63b3cd537e",
                                                "text": "Marschbefehle erreichen die Truppe, sie muss Stellungen ausheben, die sie gleich wieder verlässt, um weiter – planlos – durch menschenleere und doch unter Artilleriebeschuss liegende Wasserlandschaften zu ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9768d002-fd08-49c9-8d38-5733460dbc22",
                        "source_entry_id": "736c1da7-82d1-3454-a441-a0c2af7a8349",
                        "source_sense_id": "cd191c2a-d200-396f-8499-0a99eddf9d2b",
                        "source_sense_description": "einmalig und von kurzer Dauer; vorläufig, planlos, unüberlegt",
                        "target_lang_word": "unüberlegt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unüberlegt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                        "entry_id": "061898f8-9e74-3743-b3a5-73eda78ecbf6",
                                        "glosses": [
                                            "ohne vorheriges Nachdenken, nicht überdacht"
                                        ],
                                        "tags": [
                                            "no-comparative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95fb1a4a-cee8-4044-8de1-dc8d91acf3eb",
                                                "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                                "text": "Wir können uns keine weiteren unüberlegten Aktionen leisten."
                                            },
                                            {
                                                "example_id": "917b4d97-7314-4dd8-887c-c3d0baeeb704",
                                                "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                                "text": "„In einer Erklärung betonte Seitz, die Äußerung sei weder ein Ausrutscher, ‚ein unüberlegtes Posting noch die Aktion eines Mitarbeiters‘ gewesen, sondern ‚ein von mir selbst bewusst erstellter und geplanter Beitrag‘.“"
                                            },
                                            {
                                                "example_id": "3a8a4483-ce44-4765-81e1-439bad54b67f",
                                                "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                                "text": "„Die Verbraucherzentrale Hessen warnt Kunden vor unüberlegten Vertragsabschlüssen mit dubiosen Vermittlern von Stromlieferverträgen.“"
                                            },
                                            {
                                                "example_id": "eab9f899-0364-4020-b39f-4bb370fe41b1",
                                                "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                                "text": "„Das trieb sie zu weiteren noch unüberlegteren und gefährlicheren Aktionen innerhalb und außerhalb des Landes.“"
                                            },
                                            {
                                                "example_id": "cb6d72fb-2fd9-4ece-804e-a55869c0a535",
                                                "sense_id": "52216f58-fea4-37ed-a873-89b2d9f15e57",
                                                "text": "„Das war die dümmste, schwachsinnigste und unüberlegteste Entscheidung meines Lebens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
