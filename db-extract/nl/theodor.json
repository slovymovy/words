                                            {
                                                "example_id": "2f5c2ceb-2578-4832-a6d3-a584b49f7a28",
                                                "sense_id": "4e8faef5-d0a6-3cb0-a903-689cf2aa8956",
                                                "text": "The Tory hard right is in the ascendancy, and a fascist street movement – led by convicted fraudster Tommy Robinson – represents a growing threat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d560b888-0fae-31bd-9e95-d43373951c85",
                                        "entry_id": "60c51bac-2932-38f4-88f6-825e3edddc8d",
