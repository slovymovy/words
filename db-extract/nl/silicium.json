                                        "glosses": [
                                            "elemento chimico solido, di colore grigio scuro con riflessi bluastri, facente parte del gruppo dei metalloidi, avente numero atomico 14, peso atomico 28,0855 e simbolo chimico Si; è il principale componente di vetro, cemento, ceramica e silicone, e si usa anche per produrre componenti elettronici"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2caa43fc-3c68-42ac-a409-0ca5b4c8e04a",
                                                "sense_id": "567d386d-3c52-3510-bd4c-88ef43ff993c",
                                                "text": "l'atomo di silicio ha quattordici protoni nel nucleo e quattordici elettroni al di fuori di quest'ultimo"
                                            },
                                            {
                                                "example_id": "8f2d753f-edd6-4c8d-8d82-623756e96d17",
                                                "sense_id": "567d386d-3c52-3510-bd4c-88ef43ff993c",
                                                "text": "si potrebbe dire che il silicio è identificabile anche con il colore verde-acqua visibile guardando alcuni vetri"
                                            }
                                        ]
                                    }
                                ]
                            }
