                    },
                    {
                        "translation_id": "513bc513-2460-4ff0-9e59-612a06c70985",
                        "source_entry_id": "3a04f5b9-15ff-3535-9a47-a2230abc3927",
                        "source_sense_id": "b96e5401-0b50-3637-a655-479bfdb83db1",
                        "source_sense_description": "with a wide view",
                        "target_lang_word": "panoramique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panoramique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                        "entry_id": "f3c2792c-3e42-3713-953a-9b2f5c1a806f",
                                        "glosses": [
                                            "Qui permet d’embrasser l’ensemble d’une ville, d’un paysage, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0752b096-0966-4986-8584-243d30d8c19c",
                                                "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                                "text": "Il vient de me vendre un violon lahorien et un dessin panoramique de Lahore, fait par un natif."
                                            },
                                            {
                                                "example_id": "c3388bdf-a350-4a9b-afe9-1f12732e5af9",
                                                "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                                "text": "Nous regardons l’appareil panoramique de M. Marteus, si parfaitement employé par M. Lerebours, comme un progrès réel."
                                            },
                                            {
                                                "example_id": "83ec606b-b8df-4021-af82-ee4e93952c1e",
                                                "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                                "text": "Je comprends alors que ces dix images doivent « théoriquement » se réunir en une seule pour constituer une vue panoramique. Malheureusement il n’en est rien ; aucune n’est à la même hauteur que sa voisine, ça danse terriblement."
                                            },
                                            {
                                                "example_id": "1757c11c-9913-4487-9d82-8d0fe8de022d",
                                                "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                                "text": "Rappelons que la radiographie panoramique est une technique particulière de tomographie."
                                            },
                                            {
                                                "example_id": "fb99f028-6535-49e7-80ea-671b9080c088",
                                                "sense_id": "f4023825-3026-3fc8-bc88-9b6914c73a8d",
                                                "text": "Jardin dickinsonien –\nUn enchevêtrement\nde tiges, feuilles et fleurs\nde sucepin,\nvenant\nd’un herbier iridescent,\nenvahit\nle jardin panoramique\n…\nde ma vitre givrée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e64650ed-5573-3944-af5e-d81fe3245954",
                                        "entry_id": "f3c2792c-3e42-3713-953a-9b2f5c1a806f",
                                        "glosses": [
                                            "Qui embrasse un ensemble par l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c2c9927-4d10-443b-b671-e9fe8dfd0de0",
                                                "sense_id": "e64650ed-5573-3944-af5e-d81fe3245954",
                                                "text": "[…], c’est toujours la même erreur qui se fait jour : celle de croire que, pour voir peu à peu apparaître la régularité, l’ordre, la marche logique, dans les faits sociaux, il faut sortir de leur détail, essentiellement irrégulier, et s’élever très haut jusqu’à embrasser d’une vue panoramique de vastes ensembles ; […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "panoramique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eae35b09-7182-31db-9e30-fba541053a6e",
                                        "entry_id": "e984e22b-56f7-3ac3-89e1-2a705202a203",
                                        "glosses": [
                                            "Mouvement de prise de vue audiovisuelle, consistant à un pivotement horizontal, vertical voire diagonale de la caméra (ou du caméscope) autour d'un axe fixe (en général un pied, parfois une personne dans le cas d'une prise de vue réalisée à l'épaule)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81955e69-bfff-4406-b577-c6843fca1946",
                                                "sense_id": "eae35b09-7182-31db-9e30-fba541053a6e",
                                                "text": "Il suffit de se rappeler un critère de base : plus la focale est longue, plus le panoramique doit être lent. Autrement dit, il faut plutôt panoter avec un grand-angle qu'avec un téléobjectif."
                                            },
                                            {
                                                "example_id": "3c4bc7c7-f9fa-4f94-a5de-f67d75f634ac",
                                                "sense_id": "eae35b09-7182-31db-9e30-fba541053a6e",
                                                "text": "Le panoramique est une solution qui permettra de tout voir. Techniquement, tous les appareils conviennent, mais si vous êtes équipé d'un appareil expert, l'exposition pourra être mieux contrôlée."
                                            },
                                            {
                                                "example_id": "8a55abf0-6189-4ea1-9309-f8c8aa546109",
                                                "sense_id": "eae35b09-7182-31db-9e30-fba541053a6e",
                                                "text": "Nous avons constaté que les panoramiques avaient tendance à être sur-utilisés pour des déplacements d’un objet à l'autre sans que ne soient prises en compte la nécessité, la durée et la longueur du mouvement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "panoramique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa377b90-d49e-332d-9f43-e79f8703fb47",
                                        "entry_id": "70118051-132d-3084-9028-e92e99243db0",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de panoramiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1a833ac-e3d2-4c7c-a9b4-16498ba10d79",
                                                "sense_id": "fa377b90-d49e-332d-9f43-e79f8703fb47",
                                                "text": "Je panoramique, en pensée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3d25454-9b41-3254-b61e-25a46da8ce5f",
                                        "entry_id": "70118051-132d-3084-9028-e92e99243db0",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de panoramiquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f3866a-144b-41d8-b2b3-a5f0e9339ffb",
                                                "sense_id": "e3d25454-9b41-3254-b61e-25a46da8ce5f",
                                                "text": "Il choisit un autre angle, photographie encore et encore. Puis il « panoramique », saisit la pente qui descend vers la cabane, la perspective du vallon encaissé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bcb2f2d-1ec0-3b27-a73f-35a52cf1cb2e",
                                        "entry_id": "70118051-132d-3084-9028-e92e99243db0",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de panoramiquer."
                                        ],
