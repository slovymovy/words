                            {
                                "example_id": "574ed177-13c6-49c7-96da-cbeb1b30e799",
                                "sense_id": "7daf4d9f-6605-3772-b143-aba8c9394e13",
                                "text": "Geef mijn portie maar aan fikkie. - Ik moet er niets van hebben."
                            }
                        ]
                    },
                    {
                        "sense_id": "e363e19e-864d-38e3-854f-2999b6d86e79",
                        "entry_id": "c1be4659-0018-38b8-a71b-dae6cf577480",
                        "glosses": [
                            "verkleinwoord enkelvoud van het zelfstandig naamwoord fik",
                            "vuurtje"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "71b274e8-1b1a-4509-9e49-7462750498fb",
                                "sense_id": "e363e19e-864d-38e3-854f-2999b6d86e79",
                                "text": "Je noemde problemen met Flip? Ja, die ontpopte zich tot een echte pyromaan. Als hij psychotisch was ging hij fikkie stoken."
                            },
                            {
                                "example_id": "485c00eb-4aca-4443-8a19-ac9fb6fbf689",
                                "sense_id": "e363e19e-864d-38e3-854f-2999b6d86e79",
                                "text": "Fikkie stoken is een lokale hobby en zo ook voor onze nieuwe buurman die op een zondagmiddag vreselijk grote brandstapels aanstak."
                            },
                            {
                                "example_id": "28b66fb1-566b-4965-a87a-cb42dd38ef6e",
                                "sense_id": "e363e19e-864d-38e3-854f-2999b6d86e79",
                                "text": "Het duurt nog een maand of twee maar dan is het voor de kinderen alweer 'grote vakantie'. Een periode waar ik als kind tien maanden per jaar reikhalzend naar uitkeek en als ouder tegenop. Want waar ik vroeger zes weken letterlijk in rook liet opgaan met fikkie stoken en belletje trekken moeten kinderen nu vooral 'iets leuks doen'."
                            }
                        ]
                    }
