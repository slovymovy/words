    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4232f7f5-0ea9-3b18-bb13-3e0941e24f22",
                    "sense_definition": "Verbindet als Kopula das Subjekt mit einer Eigenschaft, einem Zustand oder einer Identität.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "copula",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mein Bruder <w>ist</w> Lehrer an einer Grundschule in Berlin."
                        },
                        {
                            "text": "Das Wetter heute <w>ist</w> wirklich sehr schön und sonnig."
                        }
                    ],
                    "common_phrases": [
                        "gut gelaunt sein",
                        "glücklich sein",
                        "fertig sein"
                    ]
                },
                {
                    "sense_id": "952fe37a-8d92-3538-8d1a-02ea4585ffcc",
                    "sense_definition": "Dient als Hilfsverb zur Bildung der zusammengesetzten Vergangenheitszeiten bei Verben der Bewegung oder Zustandsänderung.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "auxiliary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir <w>sind</w> gestern sehr spät nach Hause gekommen."
                        },
                        {
                            "text": "Der kleine Junge <w>ist</w> im letzten Jahr schnell gewachsen."
                        }
                    ],
                    "common_phrases": [
                        "angekommen sein",
                        "eingeschlafen sein"
                    ]
                },
                {
                    "sense_id": "84afced7-1d1e-3a55-aaa6-0806b8bf5edd",
                    "sense_definition": "Sich an einem bestimmten Ort befinden oder anwesend sein.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Meine Eltern <w>sind</w> zurzeit im Urlaub in Spanien."
                        },
                        {
                            "text": "Wo <w>bist</w> du denn gerade mit deinen Freunden?"
                        }
                    ],
                    "common_phrases": [
                        "zu Hause sein",
                        "in der Nähe sein",
                        "an Ort und Stelle sein"
                    ]
                },
                {
                    "sense_id": "ca062006-bcc6-30e9-98cc-ff6773fd3930",
                    "sense_definition": "Drückt unpersönlich mit Dativobjekt ein körperliches oder seelisches Befinden aus.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Spaziergang im Schnee <w>ist</w> mir ziemlich kalt."
                        },
                        {
                            "text": "Ihm <w>war</w> während der langen Autofahrt plötzlich sehr schlecht."
                        }
                    ],
                    "common_phrases": [
                        "kalt sein",
                        "warm sein",
                        "schlecht sein",
                        "schwindelig sein"
                    ]
                },
                {
                    "sense_id": "2f55c327-836c-3fd3-a749-57ee51d41fca",
                    "sense_definition": "In einer Reihenfolge oder bei einem Spiel an der Reihe sein.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "turn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jetzt <w>bist</w> du an der Reihe mit Würfeln."
                        },
                        {
                            "text": "Wer <w>ist</w> als Nächster bei der Kasse dran?"
                        }
                    ],
                    "common_phrases": [
                        "an der Reihe sein",
                        "dran sein"
                    ]
                },
                {
                    "sense_id": "7b59c145-87f4-3686-bc31-1d7252fdee9f",
                    "sense_definition": "Existieren, vorkommen oder am Leben sein.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Solange unsere Großmutter noch <w>ist</w>, besuchen wir sie jedes Wochenende."
                        },
                        {
                            "text": "Manchmal frage ich mich, was ohne diese Erfindung gewesen <w>wäre</w>."
                        }
                    ],
                    "synonyms": [
                        "bestehen",
                        "leben"
                    ]
                },
                {
                    "sense_id": "3de6368b-51ce-38c8-bcde-4c4b63cffe70",
                    "sense_definition": "Mit Dativ und Präposition: Lust oder Neigung zu etwas verspüren.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heute Abend <w>ist</w> mir überhaupt nicht nach einer lauten Party."
                        },
                        {
                            "text": "Den Kollegen <w>war</w> nach der langen Besprechung zumute nach einer Pause."
                        }
                    ],
                    "common_phrases": [
                        "nach etwas zumute sein"
                    ]
                },
                {
                    "sense_id": "d2440071-5b81-3495-81f2-99e7c2c3d120",
                    "sense_definition": "Beim Fangenspiel die Rolle des Fängers innehaben.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe dich berührt, also <w>bist</w> du jetzt!"
                        },
                        {
                            "text": "Beim Fangen wollte Paul gestern nicht mehr derjenige <w>sein</w>, der sucht."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "überwiegend in der Kindersprache gebraucht"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "11a4bc34-866d-3add-a335-cb3d73a2a3ca",
