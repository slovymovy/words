                "senses": [
                    {
                        "sense_id": "ff56ca0c-ff96-3f6f-8536-82bb9d4299fc",
                        "entry_id": "81cfa0d7-26a9-3f43-a837-8fc704b3f9ee",
                        "glosses": [
                            "stable, stabling"
