                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "shop_counter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verkoper legde het kledingstuk netjes op de <w>toog</w>.",
                            "target_lang_translations": {
                                "fr": "Le vendeur a posé le vêtement soigneusement sur le <w>comptoir</w>."
                            }
                        },
                        {
                            "text": "Er stond een lange rij klanten voor de <w>toog</w> van de bakker.",
                            "target_lang_translations": {
                                "fr": "Il y avait une longue file de clients devant le <w>comptoir</w> de la boulangerie."
                            }
