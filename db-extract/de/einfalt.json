                "translations": [
                    {
                        "translation_id": "c59f3e93-ef36-4887-b43f-d4bb15166385",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                        "source_sense_description": "geistiges Unvermögen",
                        "target_lang_word": "naïveté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naïveté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0deeb38-ffc3-326a-b678-35053029a8c8",
                                        "entry_id": "8fcc7833-7483-3c1f-8562-110573fbcd25",
                                        "glosses": [
                                            "Ingénuité, simplicité d’une personne qui manifeste naturellement ses opinions et ses sentiments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd21c8e-ba19-4023-8b69-bd2b4f848a5f",
                                                "sense_id": "d0deeb38-ffc3-326a-b678-35053029a8c8",
                                                "text": "On ne peut, par exemple, comprendre la conduite de Robespierre quand on le compare aux politiciens d’aujourd’hui ; […] ; quand il lui fallut prendre des résolutions suprêmes et se défendre contre la Convention, il se montra d’une naïveté qui confine à la niaiserie."
                                            },
                                            {
                                                "example_id": "60565827-56f7-4a9b-8eb5-255d936e911d",
                                                "sense_id": "d0deeb38-ffc3-326a-b678-35053029a8c8",
                                                "text": "Simulait-elle l’espièglerie, la naïveté pour mieux le captiver, le capturer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46879ba0-740e-3570-a1f0-cd384b00af52",
                                        "entry_id": "8fcc7833-7483-3c1f-8562-110573fbcd25",
                                        "glosses": [
                                            "Simplicité naturelle et gracieuse avec laquelle une chose est exprimée ou représentée selon la vérité ou la vraisemblance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44919e69-689b-47ea-988b-950f24f93874",
                                                "sense_id": "46879ba0-740e-3570-a1f0-cd384b00af52",
                                                "text": "On a généralement traité Aucassin comme un conte populaire, dont il fallait mettre en lumière la grâce un peu simplette et la naïveté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38158153-f7e2-30b9-b329-fdb5437ede13",
                                        "entry_id": "8fcc7833-7483-3c1f-8562-110573fbcd25",
                                        "glosses": [
                                            "Simplicité niaise ou défaut de retenue dans l’expression de sentiments qu’on aurait intérêt à cacher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a7aafa-0b29-4a21-ba0f-b76b7fe24efb",
                                                "sense_id": "38158153-f7e2-30b9-b329-fdb5437ede13",
                                                "text": "Son orgueil est d’une naïveté comique, d’une naïveté risible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a15618a-6121-381e-a3b2-7ef0e9e1abfa",
                                        "entry_id": "8fcc7833-7483-3c1f-8562-110573fbcd25",
                                        "glosses": [
                                            "Propos, expressions qui échappent par ignorance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ebb6c8-5ed9-416a-a5cf-6ac3214b9074",
                                                "sense_id": "7a15618a-6121-381e-a3b2-7ef0e9e1abfa",
                                                "text": "Les jeunes personnes sont sujettes à dire des naïvetés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "241795c7-30a9-4d0a-9e2f-09342b8f9aca",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                        "source_sense_description": "geistiges Unvermögen",
                        "target_lang_word": "простота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "простота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "свойство по значению прилагательного простой; отсутствие сложности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6026efb0-5748-4a4a-9537-38c5fdbb25ab",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Представить ясные черты // Провинцияльной простоты."
                                            },
                                            {
                                                "example_id": "52879a7b-50c1-458c-abeb-5decb9298d99",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "— Бедная! Они … хотят воспользоваться её простотою!"
                                            },
                                            {
                                                "example_id": "aa7b6d96-956b-4144-83e6-5023efdc7c45",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Прямотою и простотою чувства она походила на ребёнка."
                                            },
                                            {
                                                "example_id": "10f6e2d0-88f4-485f-86fd-e28475898ab8",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Тётушки же нежно любили своего племянника и наследника, и он любил их, любил их старомодность, и простоту жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5421985-e046-304c-b349-9b0a91b4639f",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "перен. естественность в поведении, обращении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a12503-bd6c-4112-9119-742385df3619",
                                                "sense_id": "b5421985-e046-304c-b349-9b0a91b4639f",
                                                "text": "По характеру, по воспитанию Борису Николаевичу изначально была свойственна простота."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e136336-896f-37fc-890c-ddcf0695b2f8",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "перен., : простодушие, простосердечие, доверчивость, неискушённость; глупость, скудоумие"
                                        ],
                                        "tags": [
                                            "в пословицах и поговорках, напр., «простота хуже воровства», «с простоты люди пропадают», «простите на глупости, не осудите на простоте»!"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "231a4ac6-0868-4913-b131-abd9488f8f0d",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                        "source_sense_description": "geistiges Unvermögen",
                        "target_lang_word": "наивность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "наивность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e302da32-841b-3b77-b425-d3fb26770205",
                                        "entry_id": "17f925e8-4d89-3f29-bbbd-15c6644fb9b2",
                                        "glosses": [
                                            "свойство по значению прилагательного наивный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f17e626-8da2-433e-a995-6d48be72d090",
                                                "sense_id": "e302da32-841b-3b77-b425-d3fb26770205",
                                                "text": "Иногда муж благосклонно исполнял все желания её и даже снисходительно ей улыбался, как улыбаются баловнику-дитяти, которому не хотят отказать в иной странной прихоти, боясь преждевременно и враждебно смутить его наивность."
                                            },
                                            {
                                                "example_id": "1d58c510-5601-4d8e-aeee-84e3542f6c7d",
                                                "sense_id": "e302da32-841b-3b77-b425-d3fb26770205",
                                                "text": "Такое странное впечатление производило на графа это соединение наивности и отсутствия всего условного с свежей красотой, что несколько раз в промежутки разговора, когда он молча смотрел ей в глаза или на прекрасные линии рук и шеи, ему приходило в голову с такой силой желание вдруг схватить её на руки и расцеловать, что он серьезно должен был удерживаться."
                                            },
                                            {
                                                "example_id": "e250ae99-c10a-41b2-9a5b-01eaa76cb6bb",
                                                "sense_id": "e302da32-841b-3b77-b425-d3fb26770205",
                                                "text": "Русская сказка, обращаясь в кругу эпических воззрений народа, принимая склад и обычные выражения песенного эпоса, отличается замечательною свежестью поэтических красок, первобытною наивностью, спокойным и однообразным течением."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92dc54b8-306e-3636-ae5b-58932140d372",
                                        "entry_id": "17f925e8-4d89-3f29-bbbd-15c6644fb9b2",
                                        "glosses": [
                                            "проявление такого свойства, наивный поступок или наивные слова"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c0acc94-9bab-4760-ba21-3d8565ced973",
                                                "sense_id": "92dc54b8-306e-3636-ae5b-58932140d372",
                                                "text": "Вот к каким печальным результатам приводит эта милая юношеская наивность, это простодушное стремление любви к чему и как попало, лишь бы любить, а там — хоть пропади и разрушься весь мир."
                                            },
                                            {
                                                "example_id": "4305a20d-3380-4967-92b2-1307bfdb985b",
                                                "sense_id": "92dc54b8-306e-3636-ae5b-58932140d372",
                                                "text": "Одета она была до наивности пёстро и плохо: красная сетка покрывала её волосы, платье из полинялого голубого атласа давило ей грудь, толстые шведские перчатки восходили до острых локтей; да и где ж было ей, дочери какого-нибудь бергамского пастуха, знать, как одеваются парижские камелии!"
                                            },
                                            {
                                                "example_id": "b027cb15-e4e2-4143-8207-469321ef77b0",
                                                "sense_id": "92dc54b8-306e-3636-ae5b-58932140d372",
                                                "text": "Были, как водится, поминки, но простенькие: три гостьи — приятельницы покойной, я да Лена. Гости выпили водки, вспомнили добродушие покойницы и расплакались. Дошло до наивностей. — Петр Иваныч, ты останься с Леночкой ночевать."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ce5f23c-f539-4ac8-bbbc-71cf08be19dd",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "3eca149d-8a0c-3c54-a628-2abeb2728c43",
                        "source_sense_description": "geistiges Unvermögen",
                        "target_lang_word": "простодушие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "простодушие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "47da21db-8476-390f-9b4f-d02a0a2eb4b8",
                                        "entry_id": "57beca20-188b-326b-a13e-747c34098199",
                                        "glosses": [
                                            "бесхитростная, наивная доверчивость, чистосердечие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2285a7-9069-4261-81bc-9a666f268573",
                                                "sense_id": "47da21db-8476-390f-9b4f-d02a0a2eb4b8",
                                                "text": "Самый тонкий плут, самая опытная кокетка с трудом могли бы его провесть, а сам себя он ежедневно обманывал с простодушием ребёнка."
                                            },
                                            {
                                                "example_id": "85cf7117-848a-49bb-91b7-dbe94d21cd86",
                                                "sense_id": "47da21db-8476-390f-9b4f-d02a0a2eb4b8",
                                                "text": "Когда же она говорила: «полноте, граф, вы шутите» и т. п., голос её, немного горловой, звучал таким наивным простодушием и смешною глупостью, что, глядя на неё, действительно приходило в голову, что это не женщина, а цветок, и не розан, а какой-то дикий, бело-розовый пышный цветок без запаха, выросший один из девственного снежного сугроба в какой-нибудь очень далёкой земле."
                                            },
                                            {
                                                "example_id": "46b27d3a-446f-4046-8188-2057e3e556ee",
                                                "sense_id": "47da21db-8476-390f-9b4f-d02a0a2eb4b8",
                                                "text": "Желая выразить чьё-нибудь простодушие или доброту, говорят: «У него голубиная душа»."
                                            },
                                            {
                                                "example_id": "a15332dc-7320-4587-8d76-7d8e71a5a6fb",
                                                "sense_id": "47da21db-8476-390f-9b4f-d02a0a2eb4b8",
                                                "text": "После обеда мой кавалерист подошёл ко мне с бокалом, обнял меня и с военным простодушием сказал мне на ухо: «Да зачем же вы русский?!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84603df8-d14f-4b3f-91f3-bb8905969f12",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "08709e13-3466-3f01-b276-11b6d599814c",
                        "source_sense_description": "Schlichtheit, Unverdorbenheit des Gemütes",
                        "target_lang_word": "скромность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "скромность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c127a6-223d-3473-a6b9-3c02b7308db9",
                                        "entry_id": "fe819f23-8a79-3f54-8ea1-595ae56c3703",
                                        "glosses": [
                                            "свойство по значению прилагательного скромный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d0575c-4b3b-4274-8e89-fe11de42cbb5",
                                                "sense_id": "c1c127a6-223d-3473-a6b9-3c02b7308db9",
                                                "text": "Его нисколько не задевала вопиющая скромность обстановки."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a110557d-32c2-3c7f-a9a4-4da02a244fa4",
                                        "entry_id": "fe819f23-8a79-3f54-8ea1-595ae56c3703",
                                        "glosses": [
                                            "скромное поведение, скромный образ жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58c2f728-4768-4c58-9680-6f77a072a0d3",
                                                "sense_id": "a110557d-32c2-3c7f-a9a4-4da02a244fa4",
                                                "text": "Мысль и труд, величие и скромность — сочетания, характеризующие и жизнь, и научное творчество Марии Склодовской-Кюри."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b93f0e10-7655-4fc4-8a85-55817cbd52e3",
                        "source_entry_id": "a7f110bb-13fa-3ab7-932e-2b33d729045a",
                        "source_sense_id": "08709e13-3466-3f01-b276-11b6d599814c",
                        "source_sense_description": "Schlichtheit, Unverdorbenheit des Gemütes",
                        "target_lang_word": "простота",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "простота",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "свойство по значению прилагательного простой; отсутствие сложности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6026efb0-5748-4a4a-9537-38c5fdbb25ab",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Представить ясные черты // Провинцияльной простоты."
                                            },
                                            {
                                                "example_id": "52879a7b-50c1-458c-abeb-5decb9298d99",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "— Бедная! Они … хотят воспользоваться её простотою!"
                                            },
                                            {
                                                "example_id": "aa7b6d96-956b-4144-83e6-5023efdc7c45",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Прямотою и простотою чувства она походила на ребёнка."
                                            },
                                            {
                                                "example_id": "10f6e2d0-88f4-485f-86fd-e28475898ab8",
                                                "sense_id": "6acb8bfd-d37a-3dad-9c8a-22a6bc0ce25e",
                                                "text": "Тётушки же нежно любили своего племянника и наследника, и он любил их, любил их старомодность, и простоту жизни."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5421985-e046-304c-b349-9b0a91b4639f",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "перен. естественность в поведении, обращении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61a12503-bd6c-4112-9119-742385df3619",
                                                "sense_id": "b5421985-e046-304c-b349-9b0a91b4639f",
                                                "text": "По характеру, по воспитанию Борису Николаевичу изначально была свойственна простота."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e136336-896f-37fc-890c-ddcf0695b2f8",
                                        "entry_id": "d8513089-ddeb-3cbe-b996-713fd3189bf9",
                                        "glosses": [
                                            "перен., : простодушие, простосердечие, доверчивость, неискушённость; глупость, скудоумие"
                                        ],
                                        "tags": [
                                            "в пословицах и поговорках, напр., «простота хуже воровства», «с простоты люди пропадают», «простите на глупости, не осудите на простоте»!"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
