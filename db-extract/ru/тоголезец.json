                                        "glosses": [
                                            "A person from Togo or of Togolese descent."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02c3c86-9f87-4e6d-a68a-5b20c9799bc4",
                                                "sense_id": "69dd6640-90be-37ec-b45c-724dc29f14c9",
                                                "text": "Grunitzky was educated locally and abroad (receiving one of the first scholarships ever granted to a Togolese), studying mathematics and obtaining an engineering degree (1937). Upon his return to Togo, Grunitzky joined the civil service[…]"
                                            }
                                        ]
                                    }
