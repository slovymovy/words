                        "glosses": [
                            "een balie bij de ingang van allerlei instellingen, zoals hotels, kantoren en overheidsinstellingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1ab43a-5b37-44fc-8996-a6217c71a348",
                                "sense_id": "83a77dca-4815-3498-80f3-f0f7eaf8e628",
                                "text": "Ze pakte de sleutels van de receptiebalie en kletste verder terwijl ze de trap op liepen."
                            },
                            {
                                "example_id": "a854f89f-cb4b-4a13-8011-bfc4d806888d",
                                "sense_id": "83a77dca-4815-3498-80f3-f0f7eaf8e628",
                                "text": "Het apparaat, waarmee mensen met hartproblemen kunnen worden geholpen, hangt op een zichtbare plek achter de receptiebalie. Daar kunnen alle personeelsleden van Het Sportpark er snel en makkelijk bij."
                            },
                            {
                                "example_id": "dcd12907-e984-43fc-8338-bb0450e98202",
                                "sense_id": "83a77dca-4815-3498-80f3-f0f7eaf8e628",
                                "text": "Al die privépakketjes stapelen zich snel op in postkamer of achter de receptiebalie. Niet alle werkgevers kunnen dat waarderen. In hetzelfde onderzoek van Multiscope geeft ruim de helft van de ondervraagden aan dat ze hun pakjes niet (meer) op werk kunnen laten bezorgen. Hun baas verbiedt deze optie."
                            }
                        ]
                    }
