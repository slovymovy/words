                                        "entry_id": "2d87e43a-2d2f-3654-826a-fb74503eb815",
                                        "glosses": [
                                            "The act of one who dithers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52ad6e74-1223-4822-9624-e9c59ab9d45d",
                                                "sense_id": "6edd62f6-7010-395c-8762-83abf7bda3d3",
                                                "text": "Even though it became clear as early as 1766 that a separate policy for Quebec was required, eight long years of delays and ditherings lay between that recognition and actual legislation in the Quebec Act."
                                            }
                                        ]
