    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "183e2e45-5727-3437-bcfe-13a79957e03d",
                    "sense_definition": "To frighten someone greatly or fill them with extreme fear.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "frighten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden loud explosion in the middle of the night began to <w>terrify</w> the sleeping residents.",
                            "target_lang_translations": {
                                "ru": "Внезапный громкий взрыв посреди ночи начал <w>ужасать</w> спящих жителей."
                            }
                        },
                        {
                            "text": "The thought of losing his job would <w>terrify</w> him because he had a large family to support.",
                            "target_lang_translations": {
                                "ru": "Мысль о потере работы могла <w>ужаснуть</w> его, так как ему нужно было содержать большую семью."
                            }
                        }
                    ],
                    "synonyms": [
                        "frighten",
                        "scare",
                        "petrify",
                        "horrify",
                        "alarm"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe",
                        "reassure",
                        "calm"
                    ],
                    "common_phrases": [
                        "terrify the audience",
                        "terrify the children",
                        "absolutely terrify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно напугать кого-либо или вселить крайний ужас."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасать",
                                "target_lang_sense_clarification": "вызывать чувство сильного страха"
                            },
                            {
                                "target_lang_word": "ужаснуть",
                                "target_lang_sense_clarification": "сильно испугать в конкретный момент"
                            },
                            {
                                "target_lang_word": "терроризировать",
                                "target_lang_sense_clarification": "держать в постоянном страхе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b197a9bb-326c-392b-a5c2-c7fec69b3c87",
                    "sense_definition": "To use threats or fear to intimidate or menace someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intimidate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator used his secret police to <w>terrify</w> any citizens who dared to speak against the regime.",
                            "target_lang_translations": {
                                "ru": "Диктатор использовал свою тайную полицию, чтобы <w>запугивать</w> любых граждан, осмелившихся высказаться против режима."
                            }
                        },
                        {
                            "text": "The gang tried to <w>terrify</w> the local shopkeepers into paying for protection.",
                            "target_lang_translations": {
                                "ru": "Банда пыталась <w>запугать</w> местных лавочников, чтобы те платили за защиту."
                            }
                        }
                    ],
                    "synonyms": [
                        "intimidate",
                        "menace",
                        "browbeat",
                        "bully"
                    ],
                    "common_phrases": [
                        "terrify into submission",
                        "terrify the witnesses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать угрозы или страх, чтобы запугать или угрожать кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запугивать",
                                "target_lang_sense_clarification": "внушать страх угрозами"
                            },
                            {
                                "target_lang_word": "запугать",
                                "target_lang_sense_clarification": "сделать робким с помощью угроз"
                            },
                            {
                                "target_lang_word": "терроризировать",
                                "target_lang_sense_clarification": "применять насилие или угрозы для подчинения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3db3cf4d-f2e0-3a1d-9c57-4814f833798b",
                    "sense_definition": "To make something appear terrible or fearsome.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "make_terrible",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark shadows and eerie music served to <w>terrify</w> the atmosphere of the old mansion.",
                            "target_lang_translations": {
                                "ru": "Темные тени и жуткая музыка служили тому, чтобы <w>наводить ужас</w> на атмосферу старого особняка."
                            }
                        },
                        {
                            "text": "The artist used jagged lines and dark colors to <w>terrify</w> the landscape in his painting.",
                            "target_lang_translations": {
                                "ru": "Художник использовал зазубренные линии и темные цвета, чтобы сделать пейзаж на своей картине <w>устрашающим</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо ужасающий или грозный вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наводить ужас",
                                "target_lang_sense_clarification": "делать атмосферу пугающей"
                            },
                            {
                                "target_lang_word": "устрашать",
                                "target_lang_sense_clarification": "придавать грозный вид"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}