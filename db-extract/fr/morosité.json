                                        "glosses": [
                                            "het somber zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3202a349-59e1-49c8-9b81-5d3f4b4ac2b3",
                                                "sense_id": "a9b2b3dc-032c-387e-9e7b-02fced87c01b",
                                                "text": "De berigten vandaar werden hoe langer hoe verschrikkelijker; thans had ik op mijne beurt uren van somberheid en akelige droomen..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2583127-d90f-4b57-961b-49b3362e7414",
