                ],
                "senses": [
                    {
                        "sense_id": "f354f54e-5bd0-3d11-9f8f-4b1c66b43d27",
                        "entry_id": "12dd920a-a93d-322d-a40e-33a124bbd414",
                        "glosses": [
                            "A line on a chart linking rock of the same age (as determined from isotope ratios)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9122497b-c675-4621-8750-46653c20ca97",
                                "sense_id": "f354f54e-5bd0-3d11-9f8f-4b1c66b43d27",
                                "text": "Recapitulating, any suite of comagmatic rocks with an age t defines an isochron if its members all had the same initial ^{₈₇}Sr/^{₈₆}Sr ratio and if it was closed to both Rb and Sr since crystallization occurred and neither element was introduced from any extraneous source.[…]In this way, whole-rock Rb-Sr isochrons can produce rather reliable age data for rock samples."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f9baf81-ac0c-3cbd-99a8-debc60d9b58a",
                        "entry_id": "12dd920a-a93d-322d-a40e-33a124bbd414",
                        "glosses": [
                            "A collection of points (such as a manifold), each point representing a set of initial conditions for a given dynamical system, such that every set results in the same long-term behaviour of the system."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6bba738-4780-40b9-a4ac-f058cb6e097e",
                                "sense_id": "6f9baf81-ac0c-3cbd-99a8-debc60d9b58a",
                                "text": "The entire plane is foliated by isochrons."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05d9a734-64fb-45d8-b5a4-6f1e253fc68a",
                        "source_entry_id": "12dd920a-a93d-322d-a40e-33a124bbd414",
                        "source_sense_description": "line on a chart linking rock of the same age",
                        "target_lang_word": "Isochrone",
