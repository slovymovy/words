                ],
                "senses": [
                    {
                        "sense_id": "1cf2e62a-fab1-379d-8872-5dc47230428b",
                        "entry_id": "2c97c95d-30e2-3907-924f-806c4452f3a3",
                        "glosses": [
                            "weibliche Person, die von einer anderen betreut/vertreten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d47f72ac-d1aa-403a-a3c8-c9708c7d30c7",
                                "sense_id": "1cf2e62a-fab1-379d-8872-5dc47230428b",
                                "text": "Ihre Klientinnen stammen vorwiegend aus der Mittelschicht."
                            },
                            {
                                "example_id": "de3c9ca2-144d-44ca-a942-d6905c018127",
                                "sense_id": "1cf2e62a-fab1-379d-8872-5dc47230428b",
                                "text": "„Es handle sich darum, nahm er den Faden wieder auf, daß die Gegenseite mit dunklen Verdächtigungen ehewidrigen Verhaltens seiner Klientin arbeite, bei denen auch Roberts Name aufgetaucht sei.“"
                            }
                        ],
