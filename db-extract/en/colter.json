                    {
                        "sense_id": "452eb534-e8c7-31e6-9779-0f126b08861f",
                        "entry_id": "231873b4-3d99-3c9c-bd53-db227cc1d000",
                        "glosses": [
                            "Alternative spelling of coulter."
                        ],
                        "tags": [
                            "US",
