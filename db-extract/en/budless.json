                        "examples": [
                            {
                                "example_id": "d850c461-ed7c-4c28-9ff8-a71f9dca5d64",
                                "sense_id": "31fef2bf-75d2-3cd5-82a5-f9d9faba7397",
                                "text": "But now it was afternoon--which, we all know, brings a somewhat more depressing air--and the budless thickets stood so close, so still, Saul became conscious that his load was a corpse."
                            },
                            {
                                "example_id": "b771d1d4-f6fc-4daa-b57d-ce9bee7fcb75",
                                "sense_id": "31fef2bf-75d2-3cd5-82a5-f9d9faba7397",
                                "text": "For hours we thus toiled up pathways seemingly fitter for goats than men, where leafless trees were bending destitute of life and helpless towards the valley, as the keen wind went sighing, moaning, wailing through their bare boughs and budless twigs."
                            },
                            {
                                "example_id": "71bcd45b-3661-48ed-b5a8-427f47f7d7de",
                                "sense_id": "31fef2bf-75d2-3cd5-82a5-f9d9faba7397",
                                "text": "THE POND Gray were the rushes Beside the budless bushes, Green-patched the pond."
                            }
                        ]
