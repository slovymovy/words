                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ad707f5-6962-42b6-b688-d71d999615b0",
                                "sense_id": "9ab879f0-fa59-3c83-81cb-844895f4cc72",
                                "text": "Ce geste aboutit à une UNIFICATION ultra-personnalisante, ultra-déterminante et ultra-différenciante, des éléments au sein d’un Foyer commun; — effet spécifique de l’AMOUR."
                            },
                            {
                                "example_id": "3f1bb6e7-6edc-4463-a237-e8ca0ed77c86",
                                "sense_id": "9ab879f0-fa59-3c83-81cb-844895f4cc72",
                                "text": "L’activance maximale : l’Avenir ultra-personnalisant et irréversible."
                            },
                            {
                                "example_id": "96312fc9-bd70-457e-873a-b27ab720966b",
                                "sense_id": "9ab879f0-fa59-3c83-81cb-844895f4cc72",
                                "text": "Nous ne pouvons pas, quant à nous, suivre le Père Schneider dans cette voie ultra-personnalisante et, à notre sens, féodale, des « puissances politiques »."
                            }
                        ]
