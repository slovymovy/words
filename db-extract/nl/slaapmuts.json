                                            {
                                                "example_id": "ac5b3b48-ab2b-475f-9918-33645ef3d3a9",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
                                                "text": "Even better than breakfast, though, is nightcapping at the Waffle House . Nightcapping happens after the bars close, but before the southern sunrise: the hours when their jukeboxes play “Freebird” on a continual loop, […]"
                                            },
                                            {
                                                "example_id": "28622363-13cb-4888-8e48-db0ad9c82b2e",
                                                "sense_id": "f897b97c-bae8-3d97-82d0-8e7d0c31270a",
