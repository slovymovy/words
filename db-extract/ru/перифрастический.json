                ],
                "senses": [
                    {
                        "sense_id": "6c1ac9f6-f582-3ff3-a20e-8b1b7d52b49c",
                        "entry_id": "11a9583b-a832-34ac-9287-83d4ce984a16",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным перифраза"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6ee8738-d9a6-4d23-8a7a-053b0df75696",
                                "sense_id": "6c1ac9f6-f582-3ff3-a20e-8b1b7d52b49c",
                                "text": "С помощью таких перефрастических интерпретаций подлинное переживание замещается образами и словами, подчерпнутыми из другого источника, а так же воззрениями, идеями и формами, которые выросли не на нашей почве и связаны не с нашим сердцем, но лишь с нашей головой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf9bde32-6797-4bef-9209-3d2a73aebf5e",
                        "source_entry_id": "11a9583b-a832-34ac-9287-83d4ce984a16",
                        "source_sense_id": "6c1ac9f6-f582-3ff3-a20e-8b1b7d52b49c",
                        "target_lang_word": "periphrastisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periphrastisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dfa93af-9b1b-32e1-b89c-c49ba5deae2f",
                                        "entry_id": "7ba92be5-6d86-3077-a2fe-69f98bfecdb1",
                                        "glosses": [
                                            "in Form einer Umschreibung, einer Periphrase"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "292a75e2-6fe4-413a-a700-088ccbd18159",
                                                "sense_id": "9dfa93af-9b1b-32e1-b89c-c49ba5deae2f",
                                                "text": "„Formale Kriterien allein scheinen bei den periphrastischen Formen nicht weiterzuhelfen; es müssen inhaltliche Besonderheiten der Kategorien herangezogen werden.“"
                                            },
                                            {
                                                "example_id": "418ec3e5-2372-444d-8aee-eb7ca056d39c",
                                                "sense_id": "9dfa93af-9b1b-32e1-b89c-c49ba5deae2f",
                                                "text": "„Anscheinend wurden die periphrastischen Verben beim Übergang von einer jüdischen Varietät des Französischen zum Jiddischen als Lehnübersetzung in die neue Sprache übernommen, bei der das hebräisch-aramäische Wort beibehalten und die Hilfsverben übersetzt wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
