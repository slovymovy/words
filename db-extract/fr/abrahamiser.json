                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d84fbb1-fdc6-4b7b-8a2f-5f741791dc61",
                                "sense_id": "7a9a729b-7160-31a8-8fb1-85502a3ee4a6",
                                "text": "Dans un contexte de polémique contre le judaïsme médinois, la parole coranique va finir par « abrahamiser » la cité."
                            },
                            {
                                "example_id": "9100dd97-8351-49b3-bd6c-f605f81af069",
                                "sense_id": "7a9a729b-7160-31a8-8fb1-85502a3ee4a6",
                                "text": "Elle a repris toutes les accusations qu’elle avait déjà exposées lorsqu’il lui avait annoncé son arrivée : il ne pensait qu’à sa mère, il était le petit chéri à sa maman, il était en train d’abrahamiser avenir sur l’autel de son lamentable passé."
                            }
                        ]
                    }
