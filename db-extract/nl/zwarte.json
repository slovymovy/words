        "nl-extract.jsonl": [
            {
                "entry_id": "bc8ac353-d1ac-327c-b3b7-df196dcd66b5",
                "word": "zwarte",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fea22a69-bea2-3562-bc7c-2892473ba307",
                        "entry_id": "bc8ac353-d1ac-327c-b3b7-df196dcd66b5",
                        "glosses": [
                            "verbogen vorm van de stellende trap van zwart"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "f65206a4-68e6-45ba-b1f9-3bd0a12aa635",
                                "sense_id": "fea22a69-bea2-3562-bc7c-2892473ba307",
                                "text": "\"Een zwarte dag voor de horeca\", zegt chef-kok Rik van de Laar over het overlijden van Boer. Hij begon op 16-jarige leeftijd in De Librije, het eerste en bekendste restaurant van Boer, werkte er zeven jaar en runt inmiddels twee restaurants in Den Haag."
                            },
                            {
                                "example_id": "5279d3b7-c16b-4f6e-8d9b-740ebf1cf53f",
                                "sense_id": "fea22a69-bea2-3562-bc7c-2892473ba307",
                                "text": "Terwijl ik een tweede blikje opentrok zag ik opeens in de verte een zwarte rookpluim."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "71d578fd-ca10-3bf3-b392-4c3af53a236c",
                "word": "zwarte",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "65e72b95-648b-36d6-9d59-77f7a0c6930a",
                        "entry_id": "71d578fd-ca10-3bf3-b392-4c3af53a236c",
                        "glosses": [
                            "persoon van volledige of gedeeltelijke Sub-Saharaans Afrikaanse afkomst"
                        ],
                        "tags": [
                            "metonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "267c2f94-3e03-4c43-9ac1-7ffe5c9c89bd",
                                "sense_id": "65e72b95-648b-36d6-9d59-77f7a0c6930a",
                                "text": "Toen hij tijdens de Amerikaanse Burgeroorlog door de regering-Lincoln werd geraadpleegd, adviseerde hij dat zwarten, als ze werden bevrijd uit de slavernij, gescheiden moesten blijven van witte mensen, omdat ze daar nooit vreedzaam tussen zouden kunnen wonen."
                            },
                            {
                                "example_id": "fc843990-b137-4b6e-9dad-dd59b54f7d2e",
                                "sense_id": "65e72b95-648b-36d6-9d59-77f7a0c6930a",
                                "text": "dat de Sheernes een Fransse Commissievaarder met 4 Stukken had bemagtigd, een ander met 8 doen stranden en verbrand, en een Schip van Guinéé met 200 Zwarten komende, hernomen"
                            },
                            {
                                "example_id": "984e0c2e-030b-45d9-b7a0-97915d5f2a4a",
                                "sense_id": "65e72b95-648b-36d6-9d59-77f7a0c6930a",
                                "text": "Helaas worden zwarten soms nog steeds niet geaccepteerd in de Westerse wereld."
                            }
                        ]
                    },
                    {
                        "sense_id": "e4c385be-cdbd-3819-9408-76c0e4ab6d0a",
                        "entry_id": "71d578fd-ca10-3bf3-b392-4c3af53a236c",
                        "glosses": [
                            "bijnaam voor een persoon die in de Tweede Wereldoorlog met de nazi's collaboreert, als lid van de Zwarte Brigade Dietsche Militie"
                        ],
                        "tags": [
                            "metonymie",
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "37953639-9645-499f-86a3-5d3859002046",
                                "sense_id": "e4c385be-cdbd-3819-9408-76c0e4ab6d0a",
                                "text": "Die keuze kwam hem duur te staan. Nauwelijks waren de nazi’s najaar 1944 uit België verdreven of Victor Leemans werd net als andere ‘zwarten’, zoals collaborateurs heetten, gearresteerd. Zijn huis werd leeggehaald, hijzelf gevangen gezet."
                            },
                            {
                                "example_id": "8766aa03-e12f-47d1-b6c1-f3a19d4f30ce",
                                "sense_id": "e4c385be-cdbd-3819-9408-76c0e4ab6d0a",
                                "text": "In de laatste weken waren nog slechts een VIJFTAL personen de hoofdpersonnagen en de meerderheid van die personen stonden in den aktieven weerstand, BINST DAT DE VIJAND IN ONS LAND WAS. Die worden herhaaldelijk aangevallen, maar de zwarten, de collaborateurs, die laten zij met rust."
                            }
                        ]
                    }
                ],
