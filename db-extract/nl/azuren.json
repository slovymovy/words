        "nl-extract.jsonl": [
            {
                "entry_id": "c4ce1ddd-ae86-3572-a561-4493dddd9a0f",
                "word": "azuren",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75efbad8-6bcf-3c30-8eb9-6fcffc178bbc",
                        "entry_id": "c4ce1ddd-ae86-3572-a561-4493dddd9a0f",
                        "glosses": [
                            "met een diepblauwe kleur zoals die van de halfedelsteen lapis lazuli (    )"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c10533-df93-46f8-8bad-513e3954a699",
                                "sense_id": "75efbad8-6bcf-3c30-8eb9-6fcffc178bbc",
                                "text": "Zomerhits zijn natuurlijk ook soms gewoon lekker fout. De goeie gaan over een ontluikende liefde tussen de zandkorrels aan een azuren zee, maar de beste gaan juist helemaal nergens over."
                            },
                            {
                                "example_id": "ba30aafa-c508-4d24-a341-002bf7fa45ba",
                                "sense_id": "75efbad8-6bcf-3c30-8eb9-6fcffc178bbc",
                                "text": "Alle tijd voor de liefde dus. Omdat het bruidspaar de eerste nacht wil doorbrengen in een afgelegen vuurtoren, tuffen Chiara en Ivan op een bootje door de azuren zee, langs verborgen baaien waar ze allicht wellustig op de warme kiezels verstrengeld raken."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d84c567-ab06-3eb7-a72e-6c1f8dac8e6d",
                        "entry_id": "c4ce1ddd-ae86-3572-a561-4493dddd9a0f",
                        "glosses": [
                            "blauw zoals dat op wapenschilden wordt gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba958c1-b391-49d5-952f-eb1bb9b3cba7",
                                "sense_id": "4d84c567-ab06-3eb7-a72e-6c1f8dac8e6d",
                                "text": "De paal is keel en verwijst naar de weg naar Opende en kruist de azuren balk, die symbool staat voor de nog stromende Feanster Feart."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d6d4164-9e47-4c68-9898-80b6c9b05007",
                        "source_entry_id": "c4ce1ddd-ae86-3572-a561-4493dddd9a0f",
                        "source_sense_id": "75efbad8-6bcf-3c30-8eb9-6fcffc178bbc",
                        "source_sense_description": "met een diepblauwe kleur",
                        "target_lang_word": "azure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "azure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4296c1af-b74b-3966-a27e-07a9bbd151a4",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "The clear blue colour of the sky; also, a pigment or dye of this colour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e2ed2fb-7da8-4f02-b168-8927c0f4329c",
                                                "sense_id": "4296c1af-b74b-3966-a27e-07a9bbd151a4",
                                                "text": "In robes of azure."
                                            },
                                            {
                                                "example_id": "5cea0dfd-9b02-48e9-a121-20a683bd5d78",
                                                "sense_id": "4296c1af-b74b-3966-a27e-07a9bbd151a4",
                                                "text": "For our blues we have the azures and ceruleans, lapis lazulis, the light and dusty, the powder blues, the deeps: royal, sapphire, navy, and marine […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4975780-b82d-3a74-a00f-93b49a308a21",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "A blue colour on a coat of arms, represented in engraving by horizontal parallel lines."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6524d2-7da2-4cdc-9027-b4a8441c7bb3",
                                                "sense_id": "a4975780-b82d-3a74-a00f-93b49a308a21",
                                                "text": "Berington of Chester (on the authority of Harleian manuscript No. 1535) is said to bear a plain shield of azure. Personally I doubt this coat of arms […]"
                                            },
                                            {
                                                "example_id": "fa4e019a-485d-443d-b38e-8295e1bacde0",
                                                "sense_id": "a4975780-b82d-3a74-a00f-93b49a308a21",
                                                "text": "In Bb [Glover's Roll], the conventional letter B is used to indicate azure in most items."
                                            },
                                            {
                                                "example_id": "37a12d02-c8c4-49fe-85e0-9c1cf9d507b1",
                                                "sense_id": "a4975780-b82d-3a74-a00f-93b49a308a21",
                                                "text": "Sir Henry \"Hotspur\" Percy: before 1399: or, a lion rampant azure, differentiated with a label gules (a blue lion rampant on a field of gold, differentiated with a red label signifying the first-born son) […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d26ea219-245b-378e-98ec-981863ba713b",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "The unclouded sky; the blue vault above."
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9294900d-c09e-415d-b589-8eb94aed75cb",
                                                "sense_id": "d26ea219-245b-378e-98ec-981863ba713b",
                                                "text": "Not like those steps / On heaven's azure."
                                            },
                                            {
                                                "example_id": "8cd932af-402b-4b17-853a-a12161b87133",
                                                "sense_id": "d26ea219-245b-378e-98ec-981863ba713b",
                                                "text": "Not a single cloud mars the flawless azure; / Not a shadow moves o'er the moveless crops; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b84df2a-826e-39ae-859f-f0dd6d450572",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "Any of various widely distributed lycaenid butterflies of the genus Celastrina."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "17bd11f3-c5a7-3130-9f0b-cf3f3c1f3808",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "Any of various Australasian lycaenid butterflies of the genus Ogyris."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93cacd4b-f497-30d0-9152-95ec247c6361",
                                        "entry_id": "27414d4f-72a5-3eee-acaf-b72452c406c0",
                                        "glosses": [
                                            "Lapis lazuli."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "azure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5703f5b8-1a39-31a3-b84f-b2aa2dc7ca34",
                                        "entry_id": "0d6a8a46-829b-3663-a907-167c6046d051",
                                        "glosses": [
                                            "Sky blue; resembling the clear blue colour of the unclouded sky."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8d7eb11-5d6e-4631-b308-fcf25a1da617",
                                                "sense_id": "5703f5b8-1a39-31a3-b84f-b2aa2dc7ca34",
                                                "text": "When Britain first, at Heaven's command / Arose from out the azure main."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "278af571-6c9f-33d5-b71a-efd8c3355781",
                                        "entry_id": "0d6a8a46-829b-3663-a907-167c6046d051",
                                        "glosses": [
                                            "Cloudless."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c78d2656-bab6-3012-93eb-98789a6342d1",
                                        "entry_id": "0d6a8a46-829b-3663-a907-167c6046d051",
                                        "glosses": [
                                            "In blazon, of the colour blue."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6acf1d97-6397-496f-8988-265f3f3e6426",
                                                "sense_id": "c78d2656-bab6-3012-93eb-98789a6342d1",
                                                "text": "‘I forget your coat of arms.’\n‘A human foot d’or, in a field azure; the foot crushes a serpent rampant whose fangs are imbedded in the heel.’"
                                            },
                                            {
                                                "example_id": "4fb46030-eea8-4011-8fa8-65ff121f34ff",
                                                "sense_id": "c78d2656-bab6-3012-93eb-98789a6342d1",
                                                "text": "On the fesse are two bars wavy azure for waterways."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "azure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78634f12-2907-3b39-bd08-2f7a5a393209",
                                        "entry_id": "e6dfc40c-1c95-3cb0-9754-071bee271238",
                                        "glosses": [
                                            "To colour blue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4718154-debc-4298-8d5f-0f3cac33809e",
                                                "sense_id": "78634f12-2907-3b39-bd08-2f7a5a393209",
                                                "text": "Our readers are aware that much of the sugar sold in many countries goes through an azuring treatment; blue is added to granulated sugar with the view of making it appear whiter than it actually is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7ab53d5-46ff-411d-95ee-5414ee4c5a09",
                        "source_entry_id": "c4ce1ddd-ae86-3572-a561-4493dddd9a0f",
                        "source_sense_id": "75efbad8-6bcf-3c30-8eb9-6fcffc178bbc",
                        "source_sense_description": "met een diepblauwe kleur",
                        "target_lang_word": "sky blue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sky blue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b699f96f-9fe7-3383-8be7-9c1def53a713",
                                        "entry_id": "dd19c8e3-b3af-3342-9369-21da0d43881c",
                                        "glosses": [
                                            "Of a vibrant light blue colour, like that of the sky on a fine day."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcb811a-9ac6-4304-b054-e78c1334d3cf",
                                                "sense_id": "b699f96f-9fe7-3383-8be7-9c1def53a713",
                                                "text": "“Hi! Kostandi!” called out an old sailor in a sky-blue cloak. “How are things with you?”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sky blue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6435dd3-3496-3c03-af77-3c61be7fcb83",
                                        "entry_id": "c81f4517-e4b6-35d7-a1f4-d2df60b93ea1",
                                        "glosses": [
                                            "A vibrant light blue colour, like that of the sky on a fine day."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                        "entry_id": "c81f4517-e4b6-35d7-a1f4-d2df60b93ea1",
                                        "glosses": [
                                            "Milk excessively diluted with water, or from which the cream was too closely skimmed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "603bf857-49f7-4e43-8f3c-68ab38625f0d",
                                                "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                                "text": "Hence, Suffolk dairy wives run mad for cream,\n And leave their milk with nothing but the name;\n Its name derision and reproach pursue,\n And strangers tell of three-times-skimm'd sky-blue."
                                            },
                                            {
                                                "example_id": "a51de9e3-ba47-48ac-b277-5d67e0597fba",
                                                "sense_id": "8a91ef33-4197-3c99-a36c-99146685b10e",
                                                "text": "To be sure, your Aunt Betsey lives in a brick house, and has a sight of furniture, […] yet she has all her bread to buy by the loaf, and the milk is sky-blue; as to cream, I don't believe they ever heard on't."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
