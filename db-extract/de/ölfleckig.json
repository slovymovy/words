                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb6e28d-26f6-499e-b909-56f978938d51",
                                "sense_id": "fc406ac0-62f0-3fb5-8d22-7152b71306e2",
                                "text": "„Draußen stand er auf dem rissigen, ölfleckigen Pflaster.“"
                            },
                            {
                                "example_id": "eb0c2b65-f59b-452f-9217-7bb45d5dca2e",
                                "sense_id": "fc406ac0-62f0-3fb5-8d22-7152b71306e2",
                                "text": "„Er zog die leichten Sachen aus und wechselte in eine dicke Cordhose, ein ölfleckiges braunes Flanellhemd und eine wattierte Segeltuchjacke, dazu Wanderstiefel aus Leder.“"
                            }
                        ],
