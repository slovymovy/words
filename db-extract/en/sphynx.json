                    },
                    {
                        "translation_id": "468d859b-1aca-4c67-942c-f8608b1dc54c",
                        "source_entry_id": "142379ff-9e88-3eb9-b6b8-88e702349bd3",
                        "source_sense_id": "98215800-f866-34ed-99ee-40c226b2bff1",
                        "source_sense_description": "cat",
                        "target_lang_word": "Sphinx",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sphinx",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Statue eines männlichen Löwen mit einem Menschenkopf beziehungsweise auch einem Kopf des Widders, Falken und Sperbers"
                                        ],
                                        "tags": [
                                            "ägyptische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fcc254e-aee8-4dc9-bfff-ad46454b11a1",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Die meisten als Sphinx bezeichneten Statuen stellen einen König oder Pharao als Sonnengott, Horus oder auch andere ägyptische Götter dar, andere fungierten in liegender Form als Wächterfiguren vor Tempeleingängen.“"
                                            },
                                            {
                                                "example_id": "14f05788-275e-437c-bb3a-0ea83dfb4f8d",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Die Mumienabteilung ist das Herz des Ägyptischen Museums, vorher mussten wir an Sphinxen und Göttern vorbei, die entweder keinen Kopf oder keinen Rumpf mehr hatten, aber auch an Nachbauten von Streitwagen, für die ich ein größeres Faible besitze.“"
                                            },
                                            {
                                                "example_id": "c80d9c6c-7a76-4b62-9f42-852fd62f5512",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„So gilt der Widder als Symboltier des Amun, und zu den großen Amun-Tempeln von Karnak und Luxor führen heute zum Teil noch gut erhaltene steinerne Alleen von widdergestaltigen Sphingen.“"
                                            },
                                            {
                                                "example_id": "181362a4-6ded-4e58-a1f5-c06681609e9b",
                                                "sense_id": "764dc40e-7b0e-3503-8044-36bb2d5eafa8",
                                                "text": "„Ihr Haar war gelackt wie eine ägyptische Sphinx; sie war stark geschminkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52d0e022-11c4-390c-b2bc-3e476135fcee",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "bekanntes Bauwerk aus dem Alten Ägypten"
                                        ],
                                        "tags": [
                                            "Große Sphinx von Gizeh"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ae7d64-d388-4ff4-8006-cd3d031d309d",
                                                "sense_id": "52d0e022-11c4-390c-b2bc-3e476135fcee",
                                                "text": "Seit mehr als vier Jahrtausenden ragt der Sphinx aus dem Sand der ägyptischen Wüste."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Statue eines geflügelten Löwen mit dem Kopf einer Frau beziehungsweise auch eine Frau mit den Tatzen und Brüsten einer Löwin"
                                        ],
                                        "tags": [
                                            "griechische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b218c6e-b847-4e34-96ea-25ad14679a01",
                                                "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                                "text": "„Die Sphinx galt als Dämon der Zerstörung und des Unheils.“"
                                            },
                                            {
                                                "example_id": "1bf306fa-eac5-499b-a15d-8b1cd0e11a37",
                                                "sense_id": "f387a27c-8f52-3b9b-af00-9d78b5689080",
                                                "text": "„Henrik Ibsen brachte es dahin, jahrelang zu einer bestimmten Stunde in einem bestimmten Stuhl und in einem bestimmten Café in München Sphinx zu spielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af033ba9-15f0-35aa-9084-c8f7a33e23f2",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Gattung der Schwärmer, einer Unterart der Schmetterlinge"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "66c5d239-9b1c-3c9c-810b-d28de838bc79",
                                        "entry_id": "384abf1d-0e8a-36a3-a078-e0d02985222b",
                                        "glosses": [
                                            "Hauskatzenrasse mit nur leichtem Flaum als Fell"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bde57cbc-e086-47e0-b525-9c79ee6a77d3",
                        "source_entry_id": "142379ff-9e88-3eb9-b6b8-88e702349bd3",
