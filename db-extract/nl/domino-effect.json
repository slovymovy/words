                "senses": [
                    {
                        "sense_id": "569049e4-9539-39e6-b163-7af3ee9d3ae0",
                        "entry_id": "d23aba61-d573-310c-90f9-f79a018d288f",
                        "glosses": [
                            "het verschijnsel dat in een rij dominostenen de laatste steen omvalt, met als gevolg dat alle andere stenen ook omvallen"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e7a49436-498b-3d9b-aa34-dd1f8aad3f94",
                        "entry_id": "d23aba61-d573-310c-90f9-f79a018d288f",
                        "glosses": [
                            "niet te stoppen aaneenschakeling van meestal ongewenste gebeurtenissen, die alle het logische gevolg zijn van één eerdere gebeurtenis"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "121c80d4-0e86-4223-b57c-e91d3b17d361",
                                "sense_id": "e7a49436-498b-3d9b-aa34-dd1f8aad3f94",
                                "text": "Zal de brexit een domino-effect hebben?"
                            },
                            {
                                "example_id": "67e7faa6-8919-4a4b-841a-5c2e52a25f4f",
                                "sense_id": "e7a49436-498b-3d9b-aa34-dd1f8aad3f94",
                                "text": "Het rapport concludeert dat de gevolgen van klimaatverandering verergeren. Het is belangrijk dat we ons daaraan aanpassen, maar dat wordt steeds lastiger, onder meer door domino-effecten van verschillende klimaatrisico's."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bb05474-cdb0-4082-b082-2bcc55236a1c",
                        "source_entry_id": "d23aba61-d573-310c-90f9-f79a018d288f",
                        "source_sense_id": "569049e4-9539-39e6-b163-7af3ee9d3ae0",
                        "target_lang_word": "Dominoeffekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dominoeffekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a8385f4-7ed2-3eac-8dbf-e63a571652ab",
                                        "entry_id": "4c69ac5a-fa2f-36b4-9844-3cf0288196c9",
                                        "glosses": [
                                            "ein (meist schlechtes) Ereignis löst in einer Kettenreaktion immer mehr gleichartige Ereignissen aus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d47e8a-0169-44c8-95b4-761d35c4af04",
                                                "sense_id": "6a8385f4-7ed2-3eac-8dbf-e63a571652ab",
                                                "text": "In der Wirtschaft besteht ein Dominoeffekt darin, dass bei einem Konkurs eines Betriebes oft viele andere in Mitleidenschaft gezogen werden."
                                            },
                                            {
                                                "example_id": "03812bd7-f260-45f1-90d4-e68921cb6a66",
                                                "sense_id": "6a8385f4-7ed2-3eac-8dbf-e63a571652ab",
                                                "text": "„Dieser sogenannte Dominoeffekt – bei einem Schließen von Norden nach Süden – wird seit Wochen in der Region diskutiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c14e6d97-ef19-42b8-bea3-2397b92b0566",
                        "source_entry_id": "d23aba61-d573-310c-90f9-f79a018d288f",
                        "source_sense_id": "569049e4-9539-39e6-b163-7af3ee9d3ae0",
                        "target_lang_word": "domino effect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "domino effect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c79bfc-7daa-38d9-a76f-0849a5303b55",
                                        "entry_id": "0e7c91f2-3f48-304d-b36d-173c7c2dcb57",
                                        "glosses": [
                                            "The situation in which one event sets off a chain of additional events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e52e9e16-160b-4c96-852a-32b2df59ed47",
                                                "sense_id": "e2c79bfc-7daa-38d9-a76f-0849a5303b55",
                                                "text": "While the move has, for now, calmed fears of a repeat of a 2008-style domino effect, the merger has left Switzerland with a new megabank on Paradeplatz square."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0199c2ff-7518-36df-9bfd-ff15ace35a11",
                                        "entry_id": "0e7c91f2-3f48-304d-b36d-173c7c2dcb57",
                                        "glosses": [
                                            "The theory that, if South Vietnam became communist, it would be followed by Cambodia, Laos, additional Southeast Asian countries, other Asian countries, and likely even elsewhere."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41175ce7-9376-4fb1-9d53-173a1ee9509f",
                        "source_entry_id": "d23aba61-d573-310c-90f9-f79a018d288f",
                        "source_sense_id": "569049e4-9539-39e6-b163-7af3ee9d3ae0",
                        "target_lang_word": "effet domino",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effet domino",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca7e519b-fdcc-3d83-b7b6-a7cf73925d4a",
                                        "entry_id": "59793106-ab94-3f6c-85d4-75340805cdd1",
                                        "glosses": [
                                            "Entraînement d’événements de proche en proche à partir d’un premier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de436b7d-5658-4f1e-98c3-c481dcc4a2fe",
                                                "sense_id": "ca7e519b-fdcc-3d83-b7b6-a7cf73925d4a",
                                                "text": "Alors Liane, qu’au cours de ma vie je n’avais jamais vue pleurer, éclata en sanglots. Elle mit ses mains devant ses yeux et par un effet de contagion d’une rapidité sidérante, semblable à la chute des dominos placés les uns derrière les autres, tous les convives présents à table, ou presque, se mirent à pleurer."
                                            },
                                            {
                                                "example_id": "e8894496-b7e3-4e49-baae-e8ccb4e90691",
                                                "sense_id": "ca7e519b-fdcc-3d83-b7b6-a7cf73925d4a",
                                                "text": "Nos émissions de gaz à effet de serre déclenchent un effet domino, dans lequel nous ne changeons pas seulement la température. L’augmentation de la chaleur favorise l’évaporation de l’eau du sol, ce qui entraîne des sécheresses, des feux de forêt et des vagues de chaleur dans des endroits normalement secs ou des pluies massives et des inondations dans des zones généralement humides."
                                            },
                                            {
                                                "example_id": "0c906e9f-a922-4802-a978-3f1761958e40",
                                                "sense_id": "ca7e519b-fdcc-3d83-b7b6-a7cf73925d4a",
                                                "text": "C’est une obligation légale pour un site Seveso comme Lubrizol de prévoir l’effet domino de tout incendie, qu’il vienne de l’intérieur ou de l’extérieur."
                                            },
                                            {
                                                "example_id": "464bfbca-53f8-4b93-992d-db40c6e4efd1",
                                                "sense_id": "ca7e519b-fdcc-3d83-b7b6-a7cf73925d4a",
                                                "text": "C’est l’ effet « domino » du Brexit, insiste un pêcheur à la retraite qui connait bien le phénomène. « On voit les bateaux bretons lors du passage des soles, en début d’année », poursuit-il."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
