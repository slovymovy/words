{
    "word_family": [
        "macroeconomics",
        "macrobiotic",
        "macroscopic",
        "macrocosm",
        "macronutrient"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6bd4f770-eb24-3f2a-9e5d-93ed7e68fa70",
                    "sense_definition": "A single instruction or script that expands automatically into a set of instructions to perform a particular task, often used to automate repetitive actions in software.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "computer_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I created a <w>macro</w> to automatically format the monthly report in the spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Я создал <w>макрос</w>, чтобы автоматически отформатировать ежемесячный отчет в таблице.",
                                "zh": "我创建了一个<w>宏</w>，用于自动格式化电子表格中的月度报告。"
                            }
                        },
                        {
                            "text": "Using a keyboard <w>macro</w> can save you a lot of time on repetitive data entry.",
                            "target_lang_translations": {
                                "ru": "Использование клавиатурного <w>макроса</w> может сэкономить вам много времени при повторяющемся вводе данных.",
                                "zh": "使用键盘<w>宏</w>可以节省大量重复输入数据的时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "script",
                        "shortcut"
                    ],
                    "common_phrases": [
                        "run a macro",
                        "record a macro",
                        "keyboard macro"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компьютерный алгоритм, скрипт или последовательность команд, используемые для автоматизации повторяющихся задач.",
                        "zh": "一种自动执行一系列指令的脚本或程序，常用于自动化软件中的重复性任务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макрос",
                                "target_lang_sense_clarification": "наиболее употребительный термин в IT"
                            },
                            {
                                "target_lang_word": "макрокоманда",
                                "target_lang_sense_clarification": "формальный технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏",
                                "target_lang_sense_clarification": "计算机领域最常用的术语"
                            },
                            {
                                "target_lang_word": "宏指令",
                                "target_lang_sense_clarification": "更正式的计算机技术术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7be3cea2-30a0-314a-919e-9f38896e0f12",
                    "sense_definition": "Short for <w>macronutrient</w>; a type of food required in large amounts in the diet, specifically protein, carbohydrates, and fat.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Athletes often count their <w>macros</w> to ensure they are getting enough protein for muscle recovery.",
                            "target_lang_translations": {
                                "ru": "Спортсмены часто считают свои <w>макронутриенты</w> (БЖУ), чтобы убедиться, что получают достаточно белка для восстановления мышц.",
                                "zh": "运动员经常计算他们的<w>宏量营养素</w>，以确保摄入足够的蛋白质来促进肌肉恢复。"
                            }
                        },
                        {
                            "text": "You can enjoy a treat as long as it fits your daily <w>macros</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете позволить себе угощение, если оно вписывается в вашу дневную норму <w>БЖУ</w>.",
                                "zh": "只要不超出你每日的<w>宏量营养素</w>配额，你就可以享用零食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "count macros",
                        "fit your macros",
                        "daily macros"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of macronutrient"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Питательные вещества, необходимые организму в больших количествах: белки, жиры и углеводы.",
                        "zh": "指人体饮食中需要大量摄入的营养素，即蛋白质、碳水化合物和脂肪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макронутриенты",
                                "target_lang_sense_clarification": "полный термин"
                            },
                            {
                                "target_lang_word": "БЖУ",
                                "target_lang_sense_clarification": "аббревиатура (белки, жиры, углеводы), часто используемая в контексте подсчета калорий"
                            },
                            {
                                "target_lang_word": "макросы",
                                "target_lang_sense_clarification": "сленг, калька с английского"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏量营养素",
                                "target_lang_sense_clarification": "营养学中的正式术语"
                            },
                            {
                                "target_lang_word": "三大营养素",
                                "target_lang_sense_clarification": "指代蛋白质、脂肪和碳水化合物的常用说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26411f64-4b7e-3c26-810b-96f4134eef9e",
                    "sense_definition": "Short for <w>macroeconomics</w>; the study or analysis of the economy as a whole, including factors like inflation and growth.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The current <w>macro</w> environment is challenging due to rising inflation rates.",
                            "target_lang_translations": {
                                "ru": "Текущая <w>макроэкономическая</w> обстановка сложна из-за растущей инфляции.",
                                "zh": "由于通货膨胀率上升，当前的<w>宏观</w>经济环境充满挑战。"
                            }
                        },
                        {
                            "text": "Investors are worried about global <w>macro</w> risks affecting the stock market.",
                            "target_lang_translations": {
                                "ru": "Инвесторы обеспокоены глобальными <w>макроэкономическими</w> рисками, влияющими на фондовый рынок.",
                                "zh": "投资者担心影响股市的全球<w>宏观</w>风险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "macro trends",
                        "macro outlook",
                        "global macro"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of macroeconomics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к макроэкономике; анализ экономики в целом.",
                        "zh": "指宏观经济学，即对整体经济（如通货膨胀和经济增长）的研究或分析。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макроэкономика",
                                "target_lang_sense_clarification": "существительное, название дисциплины"
                            },
                            {
                                "target_lang_word": "макроэкономический",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏观经济",
                                "target_lang_sense_clarification": "指代宏观经济学或宏观经济状况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6c67f2c-0cbf-37a3-bb05-26e35cf1f7c7",
                    "sense_definition": "Short for <w>macro lens</w>; a camera lens designed for taking photographs at very close range to capture fine details.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used a <w>macro</w> to capture the intricate patterns on the butterfly's wings.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал <w>макрообъектив</w>, чтобы запечатлеть сложные узоры на крыльях бабочки.",
                                "zh": "摄影师使用<w>微距镜头</w>捕捉到了蝴蝶翅膀上复杂的图案。"
                            }
                        },
                        {
                            "text": "If you want to shoot close-ups of flowers, you should invest in a good <w>macro</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы хотите снимать крупные планы цветов, вам стоит вложиться в хороший <w>макрообъектив</w>.",
                                "zh": "如果你想拍摄花卉特写，你应该投资一个好的<w>微距镜头</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "macro shot",
                        "shoot in macro"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "ellipsis of macro lens"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объектив или режим съемки для фотографирования мелких объектов крупным планом.",
                        "zh": "指微距镜头或微距摄影模式，用于拍摄极近距离的细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макрообъектив",
                                "target_lang_sense_clarification": "оборудование"
                            },
                            {
                                "target_lang_word": "макросъёмка",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "макро",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "微距镜头",
                                "target_lang_sense_clarification": "摄影器材"
                            },
                            {
                                "target_lang_word": "微距",
                                "target_lang_sense_clarification": "指代微距摄影或微距模式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "959c56c4-3bd1-3eba-b4b0-9ade64370108",
                    "sense_definition": "Short for <w>macromanagement</w>; a management style focusing on the big picture rather than details.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "management",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His style is pure <w>macro</w>; he sets the goals and leaves the execution to us.",
                            "target_lang_translations": {
                                "ru": "Его стиль — чистый <w>макроменеджмент</w>; он ставит цели и оставляет исполнение нам.",
                                "zh": "他的风格纯粹是<w>宏观管理</w>；他设定目标，而将执行留给我们。"
                            }
                        },
                        {
                            "text": "Effective <w>macro</w> requires trusting your team to handle the daily operations.",
                            "target_lang_translations": {
                                "ru": "Эффективный <w>макроменеджмент</w> требует доверия к команде в вопросах ежедневных операций.",
                                "zh": "有效的<w>宏观管理</w>需要信任团队去处理日常运营。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of macromanagement"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль управления, сосредоточенный на общей стратегии, а не на мелких деталях.",
                        "zh": "一种侧重于整体战略而非具体细节的管理风格。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макроменеджмент",
                                "target_lang_sense_clarification": "термин управления"
                            },
                            {
                                "target_lang_word": "общее руководство",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏观管理",
                                "target_lang_sense_clarification": "管理学中的术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "10a41c28-b5d8-327b-871f-3492d484bf65",
                    "sense_definition": "Very large in scope, scale, or extent; relating to the general or broad view.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_scale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to analyze the problem at a <w>macro</w> level before worrying about the details.",
                            "target_lang_translations": {
                                "ru": "Нам нужно проанализировать проблему на <w>макроуровне</w>, прежде чем беспокоиться о деталях.",
                                "zh": "在担心细节之前，我们需要在<w>宏观</w>层面上分析这个问题。"
                            }
                        },
                        {
                            "text": "The <w>macro</w> perspective reveals trends that are invisible when looking at individual cases.",
                            "target_lang_translations": {
                                "ru": "<w>Глобальная</w> перспектива выявляет тенденции, невидимые при рассмотрении отдельных случаев.",
                                "zh": "从<w>宏观</w>角度来看，可以发现那些在观察个案时无法察觉的趋势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "large-scale",
                        "broad",
                        "global"
                    ],
                    "antonyms": [
                        "micro"
                    ],
                    "common_phrases": [
                        "macro level",
                        "macro view",
                        "macro scale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой по масштабу или охвату; относящийся к общему, глобальному уровню.",
                        "zh": "范围或规模非常大；涉及整体或广阔的视角。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макро-",
                                "target_lang_sense_clarification": "приставка для сложных слов (напр. макроуровень)"
                            },
                            {
                                "target_lang_word": "глобальный",
                                "target_lang_sense_clarification": "синоним по смыслу"
                            },
                            {
                                "target_lang_word": "масштабный",
                                "target_lang_sense_clarification": "синоним по смыслу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏观的",
                                "target_lang_sense_clarification": "形容词，表示大范围的"
                            },
                            {
                                "target_lang_word": "全局的",
                                "target_lang_sense_clarification": "指代整体视角"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48769017-1083-3e3c-93a9-4b7ef72d0bf2",
                    "sense_definition": "Short for <w>macrobiotic</w>; relating to a diet focused on whole grains and vegetables.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nutrition_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She follows a <w>macro</w> diet to improve her overall health and energy.",
                            "target_lang_translations": {
                                "ru": "Она придерживается <w>макробиотической</w> диеты для улучшения здоровья и энергии.",
                                "zh": "她遵循<w>宏观饮食</w>法来改善整体健康和精力。"
                            }
                        },
                        {
                            "text": "The restaurant offers several <w>macro</w> bowls with brown rice and fermented vegetables.",
                            "target_lang_translations": {
                                "ru": "Ресторан предлагает несколько <w>макробиотических</w> боулов с бурым рисом и ферментированными овощами.",
                                "zh": "这家餐厅提供几种配有糙米和发酵蔬菜的<w>宏观饮食</w>碗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "macro diet",
                        "macro bowl"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of macrobiotic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к макробиотике (системе питания).",
                        "zh": "指宏观饮食法，一种以全谷物和蔬菜为主的饮食方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "макробиотический",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宏观饮食",
                                "target_lang_sense_clarification": "指代宏观饮食法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6293c369-2bd5-3926-bdc5-d4ae601094e6",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Macro</w> was known for his contributions to the local historical society.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Макро</w> был известен своим вкладом в местное историческое общество.",
                                "zh": "<w>马科</w>先生以对当地历史协会的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We are looking for records of the <w>Macro</w> family in the archives.",
                            "target_lang_translations": {
                                "ru": "Мы ищем записи о семье <w>Макро</w> в архивах.",
                                "zh": "我们正在档案中寻找<w>马科</w>家族的记录。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Макро",
                                "target_lang_sense_clarification": "транслитерация имени собственного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马科",
                                "target_lang_sense_clarification": "姓氏的音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}