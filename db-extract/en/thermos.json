                        "target_lang_word": "Thermoskanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermoskanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48c791ae-2625-3237-92b4-17cf4d21a18b",
                                        "entry_id": "b3801e2b-dc4c-3c4c-a298-24a03f41c734",
                                        "glosses": [
                                            "Isolierkanne des Herstellers Thermos®"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "745fd490-e311-327d-9e3c-1bfd5d01feab",
                                        "entry_id": "b3801e2b-dc4c-3c4c-a298-24a03f41c734",
                                        "glosses": [
                                            "Als Deonym auch Gattungsbegriff für Isolierkannen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d30e243a-ea16-4589-8196-d9555874c20f",
                                                "sense_id": "745fd490-e311-327d-9e3c-1bfd5d01feab",
                                                "text": "„Jetzt - im Nachhinein - war mir klar, dass ich mich immer schon gefragt hatte, wieso Thermoskannen in der US-Bildsprache immer grün waren. In Europa war mir bis dahin noch keine grüne Thermoskanne unter gekommen.“"
                                            },
                                            {
                                                "example_id": "cebbf036-dd5a-43dc-83bc-c54568a486a3",
                                                "sense_id": "745fd490-e311-327d-9e3c-1bfd5d01feab",
                                                "text": "„Mit unterschiedlichen Materialien wird der Austausch von Energie verringert, ein Gebäude also so angelegt oder verändert, dass es wie eine Thermoskanne die gewünschte Temperatur möglichst lange im Inneren speichert und somit wenig Energie nach außen abgibt oder von dort aufnimmt.“"
                                            },
                                            {
                                                "example_id": "28925b2b-860b-442c-9923-297a158f583c",
                                                "sense_id": "745fd490-e311-327d-9e3c-1bfd5d01feab",
                                                "text": "„Mein erster Sport war Langlauf. Verschneite finnische Wälder, kalte Luft in der Lunge, warmer Saft aus der Thermoskanne.“"
                                            },
                                            {
                                                "example_id": "b5ecb3bf-21e3-48d9-a7bd-c441616e5f4f",
                                                "sense_id": "745fd490-e311-327d-9e3c-1bfd5d01feab",
                                                "text": "„Ans Fenster stellte sie auf ein Tischchen zwei große Thermoskannen mit Tee und Gebäck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
