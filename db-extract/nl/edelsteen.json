                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1beb387b-327d-4b49-9abd-a6af98bfcf98",
                                                "sense_id": "5c292d2a-6901-343a-936b-20e202b2a9c7",
                                                "text": "2025, Associated Press, Crochet gets 1st career shutout and complete game as Red Sox beat Rays for 9th straight win by Associated Press,\nHe didn’t walk a batter in his 100-pitch gem"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed0a440-ab3b-3fc9-8c57-93c03cc66ac8",
