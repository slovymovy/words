                        "cross_references": [
                            {
                                "target_word": "Θάλασσα Μπάρεντς",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "0e91242e-8107-3bf6-8b4d-1694255281e1",
                                        "entry_id": "af18d223-6ead-3d0a-8699-dff0c9a7c737",
                                        "glosses": [
                                            "θάλασσα της Ευρώπης, τμήμα του Αρκτικού Ωκεανού"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f91f4fac-3d2a-4de3-9d0e-79a0f1b1a23b",
                                                "sense_id": "0e91242e-8107-3bf6-8b4d-1694255281e1",
                                                "text": "※ Η Θάλασσα Μπάρεντς, στον ανατολικό Αρκτικό Ωκεανό, παρουσιάζει μια πολύ πλούσια βιοποικιλότητα: εδώ ζουν μερικές από τις μεγαλύτερες αποικίες θαλάσσιων πτηνών στον κόσμο, πολυάριθμοι κοραλλιογενείς βυθοί, θαλάσσιοι ελέφαντες, φάλαινες και πολικές αρκούδες.",
                                                "translation": "Άντζελα Λάζου Dean, Θάλασσα Μπάρεντς: «Ερημώνοντας» και την τελευταία γωνιά του πλανήτη…, greenpeace.org, 16 Μαρτίου 2016"
                                            },
                                            {
                                                "example_id": "cec1becc-110f-42b1-959a-69229e305c42",
                                                "sense_id": "0e91242e-8107-3bf6-8b4d-1694255281e1",
                                                "text": "※ Δεκαεπτά άνθρωποι αγνοούνται μετά τη βύθιση αλιευτικού σκάφους στην Θάλασσα Μπάρεντς στον Αρκτικό Ωκεανό σήμερα, μεταδίδουν ρωσικά πρακτορεία ειδήσεων, επικαλούμενα τις ρωσικές υπηρεσίες αντιμετώπισης εκτάκτων καταστάσεων.",
                                                "translation": "Ρωσία: Βυθίστηκε αλιευτικό στη Θάλασσα Μπάρεντς - 17 αγνοούμενοι, Έθνος, 28 Δεκεμβρίου 2020"
                                            },
                                            {
                                                "example_id": "2def2150-002f-4d6c-9585-98e0f2415eda",
                                                "sense_id": "0e91242e-8107-3bf6-8b4d-1694255281e1",
                                                "text": "※ Για τη Θάλασσα Μπάρεντς στον Αρκτικό Ωκεανό, απέπλευσαν ρωσικά πυρηνικά υποβρύχια, όπου θα πραγματοποιήσουν ασκήσεις, μετά την απόφαση Πούτιν να θέσει σε κατάσταση συναγερμού τις πυρηνικές δυνάμεις της χώρας, ως απάντηση στις κυρώσεις που δέχθηκε από τη Δύση, μετά την εισβολή ρωσικών στρατευμάτων στην Ουκρανία.",
                                                "translation": "Ρωσία: Ασκήσεις με πυρηνικά υποβρύχια στη θάλασσα του Μπάρεντς, naftemporiki.gr, 1 Μαρτίου 2022"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
