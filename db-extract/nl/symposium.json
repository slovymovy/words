                                        "entry_id": "c9cf0cce-a574-35c4-9f92-a632e2695e27",
                                        "glosses": [
                                            "gemeinsames, geselliges (Wein-)Trinken im alten Griechenland, bei dem auch improvisierte Reden zu bestimmten Themen gehalten wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f04d219c-edd8-451f-acbf-cdf90bccae38",
                                                "sense_id": "5c3baaad-8e24-3808-b147-b118ad4d2eb4",
                                                "text": "Bei einem Symposion wurde der erste Schluck Wein zu Ehren des guten Geistes Daimon aus einem edlen Kantharos getrunken."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
