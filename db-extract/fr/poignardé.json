                    {
                        "sense_id": "01d6c255-e250-336d-b5cc-068735ab467f",
                        "entry_id": "a6daa13d-0b34-35e1-af73-88d7f807ae52",
                        "glosses": [
                            "Traversé par un objet pointu, en parlant d’un support, tel qu’une étoffe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98da8a78-52a4-4376-9f63-b8c5ddba8248",
                                "sense_id": "01d6c255-e250-336d-b5cc-068735ab467f",
                                "text": "Derrière l’homme d’équipe, Lady Diana paraît : symphonie en gris perle, depuis le petit chapeau poignardé d’une barrette de diamants jusqu’au bout des souliers en peau de serpent assortis, sans oublier le foulard camaïeu qui cache à demi dans ses plis soyeux le sautoir très orienté."
                            }
                        ]
                    }
