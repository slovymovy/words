                        "examples": [
                            {
                                "example_id": "f640e568-7769-4a85-b647-6a2d67dac81b",
                                "sense_id": "794f6ab5-8c03-3f6a-bd76-9499daf6bdfd",
                                "text": "Meine Nachbarin hat Pflegegrad 3 und erhält Unterstützung von einem ambulanten Pflegedienst."
                            },
                            {
                                "example_id": "47a6428d-b4f8-4510-aa81-bc66ec075649",
                                "sense_id": "794f6ab5-8c03-3f6a-bd76-9499daf6bdfd",
                                "text": "„Mit dem Zweiten Pflegestärkungsgesetz wurden die bisherigen drei Pflegestufen sowie die zusätzliche Feststellung der eingeschränkten Alltagskompetenz durch fünf Pflegegrade ersetzt.“"
                            },
                            {
                                "example_id": "78c7c295-2596-4b9e-9f8b-847ea500606d",
                                "sense_id": "794f6ab5-8c03-3f6a-bd76-9499daf6bdfd",
                                "text": "„Pflegebedürftige erhalten nach der Schwere der Beeinträchtigungen der Selbständigkeit oder der Fähigkeiten einen Grad der Pflegebedürftigkeit (Pflegegrad).“"
                            }
                        ],
