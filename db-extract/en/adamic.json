                        "glosses": [
                            "Of, relating to, or resembling the Biblical character Adam."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "16177955-0ab9-4bd9-95fd-fadd9fa55c39",
                                "sense_id": "f1eab332-f467-3246-9ff1-80eb8fa576f1",
                                "text": "The story of the man who was bathing at the time, and ran out in Adamic costume, has been told too often, and for a fictional individual he has become altogether too notorious; […]"
                            },
                            {
                                "example_id": "b902375a-6ad4-4d8c-a919-80868de4c985",
                                "sense_id": "f1eab332-f467-3246-9ff1-80eb8fa576f1",
                                "text": "As a consequence of the primeval peripety, the Adamic fall narrated in Genesis 3, […]"
                            }
                        ]
                    }
