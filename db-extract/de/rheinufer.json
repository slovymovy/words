                "senses": [
                    {
                        "sense_id": "a47ebb56-1b3b-31d0-ae3b-52844321a793",
                        "entry_id": "b5fdbdb4-8417-31b1-8803-ed4d152822d0",
                        "glosses": [
                            "Ufer des Rheins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4881edc-9ec6-4c1f-9d6c-bfd629487b55",
                                "sense_id": "a47ebb56-1b3b-31d0-ae3b-52844321a793",
                                "text": "„Alle drei, so soll man es wohl deuten, sind hier am Rheinufer miteinander vereint, in einem Gespräch oder Schweigen.“"
                            },
                            {
                                "example_id": "2017312a-544c-42d3-812d-2e934eb27278",
                                "sense_id": "a47ebb56-1b3b-31d0-ae3b-52844321a793",
                                "text": "„Zu den Buchsteinen von unseren Spaziergängen am Rheinufer kamen jetzt auch Holzstücke, vor allem, wenn Vater Rhein und seine Wellengesellen gut vorgearbeitet hatten.“"
                            },
                            {
                                "example_id": "2df57306-b3a7-4ca2-9eac-0008e3e815ce",
                                "sense_id": "a47ebb56-1b3b-31d0-ae3b-52844321a793",
                                "text": "„In der Mittagspause macht er regelmäßig einen Dauerlauf am Rheinufer.“"
                            },
                            {
                                "example_id": "54b5f7ce-db72-42dc-b72d-8b17476e784a",
                                "sense_id": "a47ebb56-1b3b-31d0-ae3b-52844321a793",
                                "text": "„Manchmal fahren wir auch über eine Brücke hinüber zum anderen Rheinufer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
