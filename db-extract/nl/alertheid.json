                "senses": [
                    {
                        "sense_id": "2c463651-7e00-33fb-bee4-7b3ee45802c6",
                        "entry_id": "dfd18c06-1249-3aa7-9a76-e77fbdfdd868",
                        "glosses": [
                            "het alert zijn; het oplettend zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2463e326-f838-4e2b-9c98-f562decf06be",
                                "sense_id": "2c463651-7e00-33fb-bee4-7b3ee45802c6",
                                "text": "Extra alertheid gevraagd."
                            },
                            {
                                "example_id": "f40607d7-8ee2-4e2d-83dd-63ae5cc3aa99",
                                "sense_id": "2c463651-7e00-33fb-bee4-7b3ee45802c6",
                                "text": "Het meest voorkomende scenario waarin het voor de hand ligt dat de ene partner een inkomen verdient terwijl de andere dat niet doet, is wanneer het stel een kind of kinderen heeft voor wie moet worden gezorgd; dat gaat immers gepaard met een huiselijk leven dat om voortdurende alertheid vraagt als het gaat om de schoonmaak, boodschappen doen, koken, wassen, vouwen, opruimen, en de kat naar de dierenarts en de kinderen naar de tandarts brengen."
                            },
                            {
                                "example_id": "9052feb6-1bb1-4cdd-a5d5-a5d9bfecc101",
                                "sense_id": "2c463651-7e00-33fb-bee4-7b3ee45802c6",
                                "text": "De commissie stelde 'dat de zes jonge klokkenluiders meer moed, alertheid en speurzin hebben getoond dan zittende hoogleraren'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff250e16-d98a-493f-b466-442f4123b4ed",
                        "source_entry_id": "dfd18c06-1249-3aa7-9a76-e77fbdfdd868",
                        "source_sense_id": "2c463651-7e00-33fb-bee4-7b3ee45802c6",
                        "target_lang_word": "Wachsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wachsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                        "entry_id": "50794a6d-8723-339c-98c7-5c020b882447",
                                        "glosses": [
                                            "Einstellung/Verhalten, Geschehnisse aufmerksam zu verfolgen, wachsam zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ef812e-f49e-4b4c-98ff-60b0ca92920a",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„In der Nacht, als wir uns vor Kap Trafalgar befanden, kam der Kapitän während der Mittelwache an Deck, rief das Vordeck an und befahl größte Wachsamkeit, da wir durch Lord Collingwoods Flotte segeln mussten.“"
                                            },
                                            {
                                                "example_id": "98eac034-8ad7-4756-9e3d-ed0ae8e817b5",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "[COVID-19-Pandemie:] „Nach weiteren Corona-Fällen gilt fortan ‚erhöhte Wachsamkeit‘ im Main-Kinzig-Kreis in Nachbarschaft Frankfurts.“"
                                            },
                                            {
                                                "example_id": "c92fca6a-44c5-4db3-a463-cafbada718f8",
                                                "sense_id": "d34b5141-46e2-3870-8451-3d02ab585966",
                                                "text": "„Weil der Löwe der ägyptischen Mythologie zufolge die Augen immer offen hat, ist er die Verkörperung der Wachsamkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e8ebb9-dc41-4978-a1f9-88c3cbb32ef0",
                        "source_entry_id": "dfd18c06-1249-3aa7-9a76-e77fbdfdd868",
