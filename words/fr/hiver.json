            "senses": [
                {
                    "sense_id": "e682245c-2ad8-3bbc-9e0a-87f86e7f4b3a",
                    "sense_definition": "Une des quatre saisons de l'année, située entre l'automne et le printemps, caractérisée par les températures les plus basses.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "saison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>hiver</w>, les journées sont beaucoup plus courtes et froides."
                        },
                        {
                            "text": "Nous aimons partir à la montagne pendant l'<w>hiver</w> pour skier."
                        }
                    ],
                    "synonyms": [
                        "saison froide"
                    ],
                    "antonyms": [
                        "été"
                    ],
                    "common_phrases": [
                        "en hiver",
                        "cet hiver",
                        "plein hiver"
                    ]
                },
                {
                    "sense_id": "8fcf026b-09f6-39b3-938c-4d654e9d1f1c",
                    "sense_definition": "Le froid intense ou le climat rigoureux propre à cette saison.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "froid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un rude <w>hiver</w> a provoqué d'importants dégâts dans les vergers."
                        },
                        {
                            "text": "Les animaux de la forêt ont souffert de cet <w>hiver</w> glacial."
                        }
                    ],
                    "common_phrases": [
                        "rude hiver"
                    ]
                },
                {
                    "sense_id": "1cd5aeb2-fc62-36f8-9249-7927dbf58b87",
                    "sense_definition": "Nombre des années vécues, en parlant de l'âge d'une personne âgée.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "age",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux berger portait fièrement le poids de ses quatre-vingts <w>hivers</w>."
                        },
                        {
                            "text": "Cet homme sage avait vu passer plus de quatre-vingt-dix <w>hivers</w>."
                        }
                    ]
                }
            ]
        }
