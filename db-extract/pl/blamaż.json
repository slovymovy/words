                                                "example_id": "7b1c4dac-c2b0-455d-a381-64a49cb54cea",
                                                "sense_id": "0df5de70-c36b-34f8-b35c-b335f64a60df",
                                                "text": "Schalke se o vítězství nad Plzní muselo třást a od blamáže ho zachránil až ostrostřelec Klaas-Jan Huntelaar, který zaznamenal hattrick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92044301-e0b4-4b7e-b04d-746d6546b498",
                        "source_entry_id": "bd866171-deea-30fd-b7a9-0e7540a0f2d4",
                        "source_sense_id": "66adba27-bc3c-328e-a5c2-1abb937b368e",
                        "target_lang_word": "Blamage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blamage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                        "entry_id": "cdcab708-143a-34c4-abde-beda902478d8",
                                        "glosses": [
                                            "Beschämung, Situation, die zu einem Gesichtsverlust führt, die peinlich ist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0dffb69-c7d1-474a-a11d-17391acfaa99",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "Der Sturz von der Bühne war eine echte Blamage."
                                            },
                                            {
                                                "example_id": "486a374b-2f26-4c9b-ad33-042a6c3e0df3",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Das war aber weit gefehlt und eine Blamage für Herrn Schutt, denn nichts, was Herr Caroli von sich gab, entstammte dem Büchmann.“"
                                            },
                                            {
                                                "example_id": "bc4115fd-d843-4c56-ad60-e23d9cab5abd",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Niemand würde kommen, sagten sie, um mich anzuhören, und das würde eine demütigende Blamage für mich werden.“"
                                            },
                                            {
                                                "example_id": "0ded1529-e28a-490b-970a-e4af9bd26364",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Keine Regierung hätte es geschafft, einen solchen Modernisierungsschub herbeizuführen, wenn nicht die Aussicht auf internationales Prestige oder auch eine internationale Blamage gewunken hätte.“"
                                            },
                                            {
                                                "example_id": "e9551bae-8a37-4a6f-865d-f30e5411bf80",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Die zweite scheinbare Blamage erlitt Gall bei einem Besuche in einem Gefängnis, wo er in der Kanzlei einen Sträfling nach seiner Schädelform als technisches Genie diagnostiziert hatte.“"
                                            },
                                            {
                                                "example_id": "b1baf80a-3336-4412-aaa5-eb00ef582705",
                                                "sense_id": "ef2bcbe8-942f-3099-ac30-4ffd631bde8c",
                                                "text": "„Wir hatten Angst, dass die Jungen nicht kommen würden, dass wir nicht richtig tanzen können und dass das Ganze letztendlich eine Blamage wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a6f6778-c438-4d4f-bd20-ec39c1d0c909",
                        "source_entry_id": "bd866171-deea-30fd-b7a9-0e7540a0f2d4",
                        "source_sense_id": "66adba27-bc3c-328e-a5c2-1abb937b368e",
                        "target_lang_word": "компрометация",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "компрометация",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e98381e4-0425-312c-9c64-59340e4437ea",
                                        "entry_id": "972bd79b-f069-3025-b782-953f821d96bd",
                                        "glosses": [
                                            "книжн. действие по значению гл. компрометировать; нанесение вреда репутации, доброму имени кого-либо, выставление в неблаговидном свете"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52dae88-7a19-4a38-a7bd-e784ed9d09f4",
                                                "sense_id": "e98381e4-0425-312c-9c64-59340e4437ea",
                                                "text": "— Гравелот ударил Ван-Конета за оскорбление женщины, — продолжал Галеран, — и если я допускаю, что сигары были подброшены с намерением избегнуть компрометации, возможной после того, как побитый уклонился от дуэли, то любой юрист вправе толковать это как совпадение."
                                            },
                                            {
                                                "example_id": "796f8bcb-98de-4c6e-bdbb-9513aa8d0724",
                                                "sense_id": "e98381e4-0425-312c-9c64-59340e4437ea",
                                                "text": "Вы знаете, что немецкая социал-демократия своим вотумом о кредитах на войну скомпрометировала интернациональный социализм, что Вандервельде усилил эту компрометацию и что еще раньше поведение таких социалистов, как Вивиани, Мильеран, Бриан э цетера, тоже обнаружили, как бессильна и как, в то же время, печально гибка этика социалистов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12ab6e2b-e843-3249-8288-5a66e69ee7d1",
                                        "entry_id": "972bd79b-f069-3025-b782-953f821d96bd",
                                        "glosses": [
                                            "спец. в системах информационной защиты — событие, связанное с получением кем-либо несанкционированного доступа к защищённым данным, утерей носителя закрытого ключа шифрования, несанкционированным копированием и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70fb7d4-4dac-477c-9491-427f3fbd4870",
                                                "sense_id": "12ab6e2b-e843-3249-8288-5a66e69ee7d1",
                                                "text": "Компрометация секретного ключа участника системы ДБО — событие, определенное владельцем секретного ключа как ознакомление неуполномоченным лицом (лицами) с его секретным ключом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
