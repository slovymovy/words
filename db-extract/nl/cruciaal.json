                                            {
                                                "example_id": "9ce04acb-a40d-41a0-9618-3abdbd874ae3",
                                                "sense_id": "148929dd-dfef-33a6-917f-ed0174de55fb",
                                                "text": "Schreibt deine Freundin morgen die entscheidende Prüfung?"
                                            },
                                            {
                                                "example_id": "1914a570-1c7f-494b-afc6-b3eaf34bd009",
                                                "sense_id": "148929dd-dfef-33a6-917f-ed0174de55fb",
                                                "text": "„Die Konsolidierung der Ausgaben ist die entscheidendste Aufgabe der kommenden Monate und Jahre, die über Sein oder Nicht-Sein der Unternehmen entscheiden wird.“"
                                            },
                                            {
                                                "example_id": "57d745b2-9535-4e29-b69d-f372c71930cc",
                                                "sense_id": "148929dd-dfef-33a6-917f-ed0174de55fb",
                                                "text": "„Die persönlichen Gegenstände waren es, die den Archäologen schließlich die entscheidenden Hinweise auf die Herkunft der Angreifer gaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2050e682-dabc-3053-8f35-bb0f408b0814",
                                        "entry_id": "67f60247-68bd-3375-baed-89848183b72e",
                                        "glosses": [
                                            "sehr wichtig, bedeutsam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30d4d8cd-7520-428b-a52b-2b10866cc42c",
                                                "sense_id": "2050e682-dabc-3053-8f35-bb0f408b0814",
                                                "text": "„Vielmehr sollten die Kinder gemeinsam kochen und backen, das Handwerk und damit auch eine Kulturtechnik erlernen. Spaß statt Angst vor dem Essen - das ist entscheidend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
