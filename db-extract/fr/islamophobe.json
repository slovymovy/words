        "fr-extract.jsonl": [
            {
                "entry_id": "d86bac02-a0ae-3555-8803-2a6aedf87c22",
                "word": "islamophobe",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "017f1bf3-eafb-46f3-b29a-91ffec9ac4a3",
                        "entry_id": "d86bac02-a0ae-3555-8803-2a6aedf87c22",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "islamophobes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                        "entry_id": "d86bac02-a0ae-3555-8803-2a6aedf87c22",
                        "glosses": [
                            "Qui rejette, craint ou déteste l’islam."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0768bc62-74aa-4451-b652-bb5e8187e601",
                                "sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                                "text": "Fouad Alaoui, président de l'UOIF, deuxième mouvement représentatif des musulmans en France et réputé proche des Frères musulmans, a fustigé ce week-end un « climat islamophobe galopant »."
                            },
                            {
                                "example_id": "edf06775-ba97-4838-9801-2f8e6c67bcaa",
                                "sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                                "text": "Par exemple sur les violences islamophobes, y compris les violences symboliques comme la dégradation de mosquées, elles sont concentrées dans un triangle qui part de Toulouse, qui va à Lyon et ensuite à Marseille."
                            },
                            {
                                "example_id": "17778a97-44ba-494a-80c1-8e75c01dbc2a",
                                "sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                                "text": "Le Parti de la liberté (PVV) de Geert Wilders, connu pour ses positions islamophobes, a remporté les élections législatives des Pays-Bas en gagnant 37 des 150 sièges au parlement, selon des résultats presque complets."
                            },
                            {
                                "example_id": "dd2d7fa5-d59f-4de2-9206-3b82494cf3d4",
                                "sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                                "text": "Deux pôles sont identifiés : l’un plutôt porté sur les propos à connotations antisémites (comme Alain Soral), l’autre sur les interventions à connotations islamophobes et négrophobes (Éric Zemmour)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddb3cdb7-b7c6-4d51-8599-0ba2bc627693",
                        "source_entry_id": "d86bac02-a0ae-3555-8803-2a6aedf87c22",
                        "source_sense_id": "46c067e2-0159-3138-94c0-97b67490c658",
                        "source_sense_description": "qui rejette l'islam",
                        "target_lang_word": "islamfeindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "islamfeindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                        "entry_id": "949d4be3-0ef7-378c-956e-97fd6c0a8003",
                                        "glosses": [
                                            "sehr deutlich, sehr negativ gegenüber der Religion des Islams eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ab9ef3a-a88c-4b37-a32f-b07a39903092",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Die Initiatoren schüren mit ausländerfeindlicher Hetze und islamfeindlicher Agitation Vorurteile und Ängste.“"
                                            },
                                            {
                                                "example_id": "d0e6c9fe-e037-42ca-8c59-fb65853302c1",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Eine der islamfeindlichsten Aktionen des Westens war nach Meinung der IPW die Unterstützung, die westliche Medien der anti-islamischen Politik Gorbatschows zukommen ließen.“"
                                            },
                                            {
                                                "example_id": "4b0b4c96-8602-4583-b10d-54e3fdf0b605",
                                                "sense_id": "3c48d521-2749-37e1-8d3b-29ade5acb41c",
                                                "text": "„Liebe Userinnen und User, versuchen Sie doch bitte, Ihre unterschiedlichen Positionen zum Nahostkonflikt auszutauschen – ohne sich antisemitisch oder islamfeindlich zu äußern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a1aa55b-565a-4bb8-8126-144aa1a3dbb5",
                        "source_entry_id": "d86bac02-a0ae-3555-8803-2a6aedf87c22",
