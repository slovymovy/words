                    {
                        "translation_id": "99bce99c-8e06-4c4b-9e75-4158d5f731bb",
                        "source_entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "source_sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                        "source_sense_description": "Agrément accompagné de délicatesse",
                        "target_lang_word": "kindness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "The state of being kind."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b64ef6-5462-418a-8af6-4e71ad930cc9",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "Jamie's kindness is legendary, so much that people have taken advantage of her."
                                            },
                                            {
                                                "example_id": "f9b2b7d7-ef5b-47b7-8b3a-7ef7986e4d5d",
                                                "sense_id": "3dc852ab-1965-3f0d-99e7-dc282f54121d",
                                                "text": "If attending to your childhood wounds and responding with kindness feels selfish, it is important to remember that compassion for oneself often makes people more compassionate to others, Lev said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                        "entry_id": "c96eba70-ee76-3630-a286-7398193bcd26",
                                        "glosses": [
                                            "An instance of kind or charitable behaviour."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c828946f-6ab7-4e60-84b3-67ae6975cb42",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "How can I thank you for your many kindnesses?"
                                            },
                                            {
                                                "example_id": "891af2e3-a28b-4c81-bd15-09d0a1fe2f68",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "Do me a kindness and leave."
                                            },
                                            {
                                                "example_id": "bb3885f8-fea5-4449-a2bf-a24340da0ca8",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "i'm going to turn a blind eye to this misdemeanour, out of the kindness of my heart."
                                            },
                                            {
                                                "example_id": "f61e6fa4-502f-4f9e-8b88-d09025a0a72e",
                                                "sense_id": "cde269c3-91d6-355d-9700-4cfbf1ad8036",
                                                "text": "They are grateful for kindnesses that they may have received."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4246f8e5-e417-4d77-8e67-f4fed840b733",
                        "source_entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
                        "source_sense_id": "ada4a935-135c-3d8e-9e00-21ab9f61db44",
                        "source_sense_description": "Agrément accompagné de délicatesse",
                        "target_lang_word": "geniality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geniality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0e57bf9-af7b-310a-8f82-6e6902d8e21d",
                                        "entry_id": "2f45e0c2-0162-38e3-bf01-f7692b985b9b",
                                        "glosses": [
                                            "The quality of being genial; friendly cheerfulness; warmth of disposition and manners."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e52bd1f5-96a3-4a30-993f-0241564f1b73",
                                                "sense_id": "c0e57bf9-af7b-310a-8f82-6e6902d8e21d",
                                                "text": "Sometimes this throat uttered Yes, sometimes it uttered No; sometimes it made inquiries about a time worn denizen of the place. Once it surprised her notions by remarking upon the friendliness and geniality written in the faces of the hills around."
                                            },
                                            {
                                                "example_id": "4f4060ec-ce30-4126-8470-4c8d25495395",
                                                "sense_id": "c0e57bf9-af7b-310a-8f82-6e6902d8e21d",
                                                "text": "[…] and yet there was such a wilful geniality about him, such a strenuous air of being off duty and forgetting his rank, that no one was ever quite at ease in his presence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1dd9e3b-6409-4293-ab2f-b797b9a1ba20",
                        "source_entry_id": "d15975e0-4dad-3b9a-951f-0f790b727599",
