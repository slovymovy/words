{
    "word_family": [
        "quibbler"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "938a29a1-9e34-34f6-850c-64d01162f599",
                    "sense_definition": "A minor complaint or objection based on trivial details or word ambiguity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was excellent, despite a few minor <w>quibbles</w> about the formatting."
                        },
                        {
                            "text": "We offer a no-<w>quibble</w> refund policy if you are not satisfied with the product."
                        }
                    ],
                    "synonyms": [
                        "objection",
                        "complaint",
                        "criticism"
                    ],
                    "common_phrases": [
                        "minor quibble",
                        "no-quibble refund"
                    ]
                },
                {
                    "sense_id": "ade7221d-105e-3b56-903b-5aa0a79d2478",
                    "sense_definition": "A play on words or a pun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wordplay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author used a clever <w>quibble</w> to hide the true meaning of the sentence."
                        },
                        {
                            "text": "His speech was filled with a <w>quibble</w> here and there to keep the audience amused."
                        }
                    ],
                    "synonyms": [
                        "pun",
                        "wordplay"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely historical or literary."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a34d914f-8237-375d-aec6-a91fb5dca718",
                    "sense_definition": "To argue or complain about small, unimportant matters.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent hours <w>quibbling</w> over the exact wording of the contract."
                        },
                        {
                            "text": "It is not worth <w>quibbling</w> over such insignificant details when the deadline is tomorrow."
                        }
                    ],
                    "synonyms": [
                        "squabble",
                        "bicker",
                        "nitpick"
                    ],
                    "common_phrases": [
                        "quibble over"
                    ]
                },
                {
                    "sense_id": "a973ed9a-0a1f-32f9-93c3-7c0a7d5c3414",
                    "sense_definition": "To challenge or dispute a specific detail in a petty way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant <w>quibbled</w> the small charge on the final bill."
                        },
                        {
                            "text": "He <w>quibbled</w> every item on the invoice just to be difficult."
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "challenge"
                    ]
                }
            ]
        }
    ]
}