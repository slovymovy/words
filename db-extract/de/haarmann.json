                ],
                "senses": [
                    {
                        "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                        "entry_id": "2fd54e4e-dc0d-31ef-9193-e437dc97e04c",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d9c117-596b-4be1-99a8-55523e9471fc",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haarmann kommt, geht der Herr Haarmann.“"
                            },
                            {
                                "example_id": "4b55103d-00b7-40f1-911f-5b84476070ca",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Haarmann kommt und geht."
                            },
                            {
                                "example_id": "9b210688-5c45-41f8-9d0a-1b3fb45e6413",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Haarmanns kamen, sahen und siegten."
                            },
                            {
                                "example_id": "1b88ae9a-a5e8-4d97-bd9e-aea6d609dc77",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Frau Haarmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "45f7bdf1-4512-4a61-8c6d-e63f4ef6406d",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Herr Haarmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bf2e1105-3511-4289-aa70-a148bdb4d337",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Die Haarmanns kommen heute aus dem Teutoburger Wald."
                            },
                            {
                                "example_id": "8e5b2de3-00a5-4c1e-8bc5-c84a93ddd5d3",
                                "sense_id": "e76614c5-eed4-33b0-83c5-c5140d0ce779",
                                "text": "Der Haarmann trägt nie die Schals, die die Haarmann ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
