                    {
                        "sense_id": "b2c60135-5ae4-330b-a932-6824fc9a1a17",
                        "entry_id": "b066c776-e43d-303a-9f39-1df5abdfadef",
                        "glosses": [
                            "in den 1850er Jahren entwickelte und bis 1929 so bezeichnete Schriftsprache des Norwegischen, die auf den im Volk gesprochenen Dialekten beruhte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a42e2122-0832-464a-8f49-b388e8401c7c",
                                "sense_id": "b2c60135-5ae4-330b-a932-6824fc9a1a17",
                                "text": "„Landsmål wurde 1885 mit dem Dänischen gleichgestellt und verbreitete sich schnell als Schulsprache und allgemeine Gebrauchssprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "20db9ef8-1ab6-4c42-8cba-24a72557c9dc",
                        "source_entry_id": "b066c776-e43d-303a-9f39-1df5abdfadef",
                        "source_sense_id": "b2c60135-5ae4-330b-a932-6824fc9a1a17",
                        "target_lang_word": "Landsmål",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landsmål",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f4b522-d838-3284-a6fe-47d4e9d026fd",
                                        "entry_id": "85588b5c-f5af-369d-972a-8b5ed1410936",
                                        "glosses": [
                                            "A written standard for Norwegian created by Ivar Aasen in the mid-1800s; predecessor to Nynorsk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1bf41e6-7e3a-4635-adda-f86c380b2ed3",
                                                "sense_id": "f1f4b522-d838-3284-a6fe-47d4e9d026fd",
                                                "text": "Political parties had to tailor their programmes according to the taste of the electorate on the basis of the Riksmål/Landsmål controversy."
                                            },
                                            {
                                                "example_id": "ad99aede-8f4f-4c49-b57f-85837dc6c246",
                                                "sense_id": "f1f4b522-d838-3284-a6fe-47d4e9d026fd",
                                                "text": "In 1885, Landsmål won official recognition from the government; in 1929 it was renamed Nynorsk (\"new Norwegian\")."
                                            },
                                            {
                                                "example_id": "6d0992d0-46de-4ae6-8d81-5bc0be4fd2e4",
                                                "sense_id": "f1f4b522-d838-3284-a6fe-47d4e9d026fd",
                                                "text": "Diphthongs were allowed as options in many words, often rendering them identical to the Landsmål forms but deviating from upper-middle-class speech: ben > bein ‘bone, leg’ (Landsmål: bein), løv > lauv ‘leaf’ (Landsmål: lauv). In Riksmål with optional forms, many other frequently-used words were also altered from forms which reflected upper-middle-class speech to those which were identical with Landsmål:[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
