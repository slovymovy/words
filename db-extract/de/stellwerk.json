                        "form": "das Stellwerk"
                    },
                    {
                        "form_id": "b9107468-5897-4185-910d-a03f59fb2091",
                        "entry_id": "c28064b5-4acf-3999-9728-eded15a2c85c",
                        "tags": [
                            "accusative",
