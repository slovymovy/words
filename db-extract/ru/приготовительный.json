                        "target_lang_word": "hazırlık",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hazırlık",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a5ea578-7acf-336d-b10a-0b100a96c226",
                                        "entry_id": "99c2e4eb-928d-37e4-96e6-12a4d9355fa6",
                                        "glosses": [
                                            "hazırlanmak için gereken şeyler veya durumlar bütünü"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278b1a64-97d6-4197-ab54-a29fddbf0813",
                                                "sense_id": "4a5ea578-7acf-336d-b10a-0b100a96c226",
                                                "text": "Hazırlıkların uzun zamandır devam ettiğinden, kimi ayrıntılardan öteden beri haberdardım."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae1797f1-8f33-3f91-a99c-dff76e8deeab",
