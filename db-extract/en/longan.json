                "translations": [
                    {
                        "translation_id": "387eb83e-75c4-4b14-bc65-8d9d91da228c",
                        "source_entry_id": "d96a3147-b07b-3338-bbf4-af7a36eef016",
                        "source_sense_description": "tree",
                        "target_lang_word": "longanier",
