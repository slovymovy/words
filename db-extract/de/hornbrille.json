                "senses": [
                    {
                        "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                        "entry_id": "93bb682f-df05-3994-8e48-8f99bfda1775",
                        "glosses": [
                            "Sehhilfe mit einem klobigen, breiten, ursprünglich aus Horn, heute auch aus Kunststoff gefertigten Rahmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99a4c7f5-d021-4267-a390-64be1573f932",
                                "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                                "text": "Hornbrillen erfreuen sich als Modeaccessoire heute wieder großer Beliebtheit."
                            },
                            {
                                "example_id": "e4f1cbcb-68d5-48c2-8a48-99e55d3856c8",
                                "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                                "text": "„Ein älterer kleiner Herr mit Hornbrille erscheint drüben, sie ist sofort bei ihm.“"
                            },
                            {
                                "example_id": "ba866a8a-4e0c-4fad-b7ca-39b7ec4cf340",
                                "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                                "text": "„Mit seiner Hornbrille und seinem Bart unter der schwarzen Strickmütze wäre er in Berlin als Hipster durchgegangen.“"
                            },
                            {
                                "example_id": "704178b0-bdba-4b2a-8fed-715ece402f8a",
                                "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                                "text": "„Er trug nämlich ziemlich defekte Gamaschen und eine Manchesterweste, deren Schöße länger waren als seine Joppe, dazu Strippenhaar, Klapphut und Hornbrille.“"
                            },
                            {
                                "example_id": "ff9e1075-6982-4ff1-a09d-5a1ffa58b913",
                                "sense_id": "292e3d2b-ee72-3355-97f1-59a3c6ab97ac",
                                "text": "„Levin zog eine schwarze Hornbrille aus der Tasche und sah ihr nach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
