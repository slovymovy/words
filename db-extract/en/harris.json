                        "sense_id": "ec0fb805-ca3c-34f4-9977-6369a269f5c7",
                        "entry_id": "02689520-d5ab-30ef-b145-9f6b314c1d2f",
                        "glosses": [
                            "An English and Welsh surname originating as a patronymic."
