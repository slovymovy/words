                        "entry_id": "4bcd3d41-088c-3d25-a0be-c57f99626e6f",
                        "glosses": [
                            "Alternative form of gridler (“singing beggar”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "e2a36afe-a105-4b54-a7f9-024c1e4c4af9",
                                "sense_id": "dde8c1f7-add3-3b5b-a564-b53f5065baac",
                                "text": "A griddler begs between the sunset and evening prayers and might sing if his voice is good."
                            },
                            {
                                "example_id": "9167a033-a628-44bf-a8a6-e9daf1148ba2",
                                "sense_id": "dde8c1f7-add3-3b5b-a564-b53f5065baac",
                                "text": "You're a griddler, ain't you? There's a gal here now, a first-rate 'un. You two'd do well together."
                            },
                            {
                                "example_id": "95add0e9-740e-4c93-bcd0-7af97a465792",
                                "sense_id": "dde8c1f7-add3-3b5b-a564-b53f5065baac",
                                "text": "You hardly ever hear a griddler sing a lively song."
                            }
                        ]
                    }
