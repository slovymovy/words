                "senses": [
                    {
                        "sense_id": "ab2a57b7-7d75-3f51-8e18-5eb6dd2067c1",
                        "entry_id": "cb9bf6d5-5fc9-3163-9d0e-b03e23abb3c0",
                        "glosses": [
                            "Vergewaltiger, der mehrere Vergewaltigungen in einer Serie begeht oder begangen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c44d53-8546-4c74-bd20-8c6764ebe6aa",
                                "sense_id": "ab2a57b7-7d75-3f51-8e18-5eb6dd2067c1",
                                "text": "„Nach dem 16. Oktober gab es jeden Tag mehr Beweise dafür, dass Obara ein Serienvergewaltiger war und auch etwas mit Lucies Verschwinden zu tun hatte.“"
                            },
                            {
                                "example_id": "85e872d9-f787-45b4-b211-f73422bfc3d9",
                                "sense_id": "ab2a57b7-7d75-3f51-8e18-5eb6dd2067c1",
                                "text": "„Ich sage immer, dass die meisten Sexualmörder und Serienvergewaltiger Fachleute in Dominanz, Manipulation und Kontrolle werden, denselben Fähigkeiten, die ich in einem anderen Zusammenhang zu beherrschen versuchte.“"
                            },
                            {
                                "example_id": "fd6ede2b-94e1-4692-936c-1675dc23cce3",
                                "sense_id": "ab2a57b7-7d75-3f51-8e18-5eb6dd2067c1",
                                "text": "„Persönlich nehme ich es Mr. Casey sehr übel, dass er mich als Serienvergewaltiger und Mörder hinstellt.“"
                            },
                            {
                                "example_id": "742bb110-e6fb-4cda-81a6-5b92ae53e333",
                                "sense_id": "ab2a57b7-7d75-3f51-8e18-5eb6dd2067c1",
                                "text": "„›Es gab in der Stadt also einen Serienvergewaltiger, und keiner wusste davon.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
