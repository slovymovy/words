                    "frequency": "Middle",
                    "semantic_group_id": "variabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vols ont été retardés à cause des <w>caprices</w> de la météo."
                        },
                        {
                            "text": "Leur récolte dépendait entièrement des <w>caprices</w> du temps."
