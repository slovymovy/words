                            },
                            {
                                "target_word": "listón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bf56658d-fd40-3646-b5fc-b1aea6556faf",
                                        "entry_id": "278a344f-954c-33a7-9cea-b215c5df69d5",
                                        "glosses": [
                                            "Dicho de un bovino, que tiene una lista más clara de pelaje a lo largo de la columna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a63379-3790-4921-a171-451e8b4bb57c",
                                                "sense_id": "bf56658d-fd40-3646-b5fc-b1aea6556faf",
