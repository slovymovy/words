                "senses": [
                    {
                        "sense_id": "ae053688-618d-378b-916d-01fef34ae0d1",
                        "entry_id": "62568b8a-6586-3468-8577-1ae945b6570a",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft der von Kaffee stammt; explizite Zuordnung eines natürlichen Geruchsstoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c1fdbbf-1642-4c65-b7f2-df1fc403c48c",
                                "sense_id": "ae053688-618d-378b-916d-01fef34ae0d1",
                                "text": "„Derselbe Kaffeegeruch wird umso besser benotet, je professioneller die Kaffeemaschine aussieht.“"
                            },
                            {
                                "example_id": "66831a44-c454-4e82-a9d3-9be945541410",
                                "sense_id": "ae053688-618d-378b-916d-01fef34ae0d1",
                                "text": "„Kaffeegeruch am Morgen, schwitzende Menschen in der U-Bahn - wer seinen Geruchssinn verliert, dem ist das egal.“"
                            },
                            {
                                "example_id": "0ea4c29c-e01f-4994-b005-4438721516e2",
                                "sense_id": "ae053688-618d-378b-916d-01fef34ae0d1",
                                "text": "„Der aromatische Kaffeegeruch kurz nach dem Aufstehen – das gibt vielen den richtigen Koffeinkick, um in den Tag zu starten.“"
                            },
                            {
                                "example_id": "9a9fef05-9121-4fdb-9374-c768fd58115d",
                                "sense_id": "ae053688-618d-378b-916d-01fef34ae0d1",
                                "text": "„Ungewöhnliche viele Menschen mit Anzügen kreuzten den Weg der Studierenden, ein Waffel- und Kaffeegeruch lag in der Luft und ein reges Treiben war rund um die Tentoria zu beobachten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
