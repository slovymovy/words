                "forms": [
                    {
                        "form_id": "d9ccc695-1840-468b-bc8d-24836ec809d9",
                        "entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "superfétatoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ec44d3c-2291-31b8-b177-c00c9714d596",
                        "entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "glosses": [
                            "Qualifie la naissance d’un second enfant après le premier et dans un écart de temps qui dénote une superfécondation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0878d614-5a39-43ee-9535-d53c748a1fda",
                                "sense_id": "4ec44d3c-2291-31b8-b177-c00c9714d596",
                                "text": "[…] les jumeaux superfétatoires qui trahissent une conduite impudique, empreinte d’animalité […]. La naissance simultanée de plus de deux enfants, par contre, semble avoir suscité des sentiments très partagés."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b864e76-5eab-3ce0-8974-11c85aa4f953",
                        "entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "glosses": [
                            "Qui est superflu, inutilement ajouté, qui vient en sus, de façon peu naturelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6379fef0-55be-472f-b7e6-95d86805b47c",
                                "sense_id": "7b864e76-5eab-3ce0-8974-11c85aa4f953",
                                "text": "Or voilà qu’en prime Julie sait cuisiner. Détail superfétatoire?"
                            },
                            {
                                "example_id": "9572291f-d33c-4e5a-8766-4c4864b1be79",
                                "sense_id": "7b864e76-5eab-3ce0-8974-11c85aa4f953",
                                "text": "Des normes superfétatoires à Hérouxville (en référence au « code de vie » de la municipalité)"
                            },
                            {
                                "example_id": "0132d181-70ba-4539-b9f8-a370959d65db",
                                "sense_id": "7b864e76-5eab-3ce0-8974-11c85aa4f953",
                                "text": "Il est inutile, également, de compléter l’énoncé d’une règle par des précisions précédées de « notamment » lorsque l’état du droit se suffit à lui-même et que ces précisions sont superfétatoires."
                            },
                            {
                                "example_id": "9bbff15e-0c30-4c14-8244-d1e3e01fc92c",
                                "sense_id": "7b864e76-5eab-3ce0-8974-11c85aa4f953",
                                "text": "Quant à ceux dont le but est de profiter financièrement au max des locataires, pourquoi leur offrir le droit superfétatoire de refuser une cession de bail?"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8596fe4-9ce6-376c-883e-9f122f60fd52",
                        "entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "glosses": [
                            "Qualifie une lettre ajoutée à un nom de lieu sans raison étymologique ; ce genre d’ajout pouvant résulter de modes ou de l’ignorance de l’origine du nom. ^([1])"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58152916-9f74-4629-82b3-6f7219e1df36",
                        "source_entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "target_lang_word": "überflüssig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "überflüssig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                        "entry_id": "57421a3c-218a-37b2-acd4-98c02042cbf2",
                                        "glosses": [
                                            "nicht nötig, über das notwendige Maß hinaus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7b2753c-c6f5-4112-b84c-ba6459d8f16e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "Deine Kommentare finde ich überflüssig."
                                            },
                                            {
                                                "example_id": "802364c2-b57b-485b-842c-e827f2dc6c2f",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Bei Prolaktinomen zeigt eine medikamentöse Therapie oft Erfolg und eine Operation ist überflüssig.“"
                                            },
                                            {
                                                "example_id": "b564eb12-24c7-451a-b54b-b01546f4bb26",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Ausgangspunkt ist dabei die Frage, ob der Erste Weltkrieg im Grunde überflüssig war.“"
                                            },
                                            {
                                                "example_id": "edd61bf1-1cd4-4421-b06e-bda3420c232e",
                                                "sense_id": "a81f8bfa-1eac-3e36-a3a1-000f374b7abc",
                                                "text": "„Die riesige Wärmepumpe soll einen wesentlichen Teil dazu beitragen, das alte Kohlekraftwerk in der Stadt überflüssig zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73981bb1-6089-4569-8a02-21427fbae2dd",
                        "source_entry_id": "a225975a-49f6-39fe-972c-ba76737c383f",
                        "target_lang_word": "superfluous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superfluous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                        "entry_id": "0d4a640d-b010-30a1-9949-2e95d86eff2b",
                                        "glosses": [
                                            "In excess of what is required or sufficient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77362d98-2f9e-44e6-9adf-eb10b1229484",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "With a full rain suit, carrying an umbrella may be superfluous."
                                            },
                                            {
                                                "example_id": "35ad54e6-a8c0-48a7-a66b-d7855c96647e",
                                                "sense_id": "4913de38-778a-3e25-a37c-5ee8282c39c4",
                                                "text": "Then I began to play in timid fashion, venturing only twenty or thirty gulden at a time. Meanwhile, I observed and took notes. It seemed to me that calculation was superfluous, and by no means possessed of the importance which certain other players attached to it, even though they sat with ruled papers in their hands, whereon they set down the coups, calculated the chances, reckoned, staked, and—lost exactly as we more simple mortals did who played without any reckoning at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
