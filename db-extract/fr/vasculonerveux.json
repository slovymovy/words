                        "sense_id": "10c58c5a-a0bb-3679-8ec3-b16d66616fe0",
                        "entry_id": "fb458c14-0f6f-3d1d-8188-51e57ffd84a8",
                        "glosses": [
                            "Composé de vaisseaux et de nerfs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d29cf442-58ec-4e04-a31a-d293eb267114",
                                "sense_id": "10c58c5a-a0bb-3679-8ec3-b16d66616fe0",
                                "text": "Le périoste postérieur est déchiré et la portion distale du fût fémoral est déplacée en arrière avec un risque de lésion vasculonerveuse."
                            },
                            {
                                "example_id": "dd57a5b2-c776-4bc8-b3f9-c31f17d89351",
                                "sense_id": "10c58c5a-a0bb-3679-8ec3-b16d66616fe0",
                                "text": "Les lésions vasculonerveuses lors d’une ostéotomie autour du genou sont rendues possibles en raison de la proximité du paquet vasculaire poplité et du nerf fibulaire commun."
                            },
                            {
                                "example_id": "9e73e0cc-315f-4a12-be09-58e2a4d05360",
                                "sense_id": "10c58c5a-a0bb-3679-8ec3-b16d66616fe0",
                                "text": "Voie d’abord postéromédiale et rapport intime avec le paquet vasculonerveux tibial postérieur."
                            }
                        ]
                    }
