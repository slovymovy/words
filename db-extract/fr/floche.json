                                "target_senses": [
                                    {
                                        "sense_id": "fd02a0ff-1bd8-35e5-a51f-884581014906",
                                        "entry_id": "65936635-29bb-3d9b-9283-7a0ce217713c",
                                        "glosses": [
                                            "een borstelachtige versiering"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3948ed6-20e4-47e9-8c2b-28be5216789d",
                                                "sense_id": "fd02a0ff-1bd8-35e5-a51f-884581014906",
                                                "text": "De rand van het gordijn was afgezet met kwastjes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d28fc73-ce00-3ae7-a4a9-77a9c2ccdb5a",
                                        "entry_id": "65936635-29bb-3d9b-9283-7a0ce217713c",
                                        "glosses": [
                                            "steel met borstel, gebruikt voor uiteenlopende doeleinden"
                                        ],
                                        "tags": [
                                            "schilderkunst",
                                            "huishouden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0547c0f8-3149-41a0-b811-f84c09d3c6a1",
                                                "sense_id": "4d28fc73-ce00-3ae7-a4a9-77a9c2ccdb5a",
                                                "text": "De schilder maakte zijn kwasten schoon voordat hij ze opborg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a43b352-c7a3-3374-920b-e38a9012442e",
                                        "entry_id": "65936635-29bb-3d9b-9283-7a0ce217713c",
                                        "glosses": [
                                            "een vreemd of vervelend iemand"
                                        ],
                                        "tags": [
                                            "informal",
                                            "pejorative",
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9403d8d5-ebb7-4133-a896-c6bfeb9659f2",
                                                "sense_id": "3a43b352-c7a3-3374-920b-e38a9012442e",
                                                "text": "Wat een rare kwast is hij toch!"
                                            },
                                            {
                                                "example_id": "9ee507d7-1e95-44a2-bf58-c6f86eea450f",
                                                "sense_id": "3a43b352-c7a3-3374-920b-e38a9012442e",
                                                "text": "De Fransen, die onverdraaglijk hooghartige kwasten, hadden gekregen wat ze verdienden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bcab6f7-e390-35d3-b366-6f6a90e2ef55",
                                        "entry_id": "65936635-29bb-3d9b-9283-7a0ce217713c",
                                        "glosses": [
                                            "een onregelmatigheid in de nerf van een stuk hout ontstaan door het insluiten van een zijtak in het hout van de stam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316607ec-4da4-4689-bbc9-a9e6db3cf7b5",
                                                "sense_id": "8bcab6f7-e390-35d3-b366-6f6a90e2ef55",
                                                "text": "Deze kwast maakt dit dure stuk buxus onbruikbaar voor het vervaardigen van een muziekinstrument."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bab0384-4b59-3fee-aafc-f3ee37e68343",
                                        "entry_id": "65936635-29bb-3d9b-9283-7a0ce217713c",
                                        "glosses": [
                                            "zelfgemaakte limonade van uitgeperste citroen, water en suiker naar smaak"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb4ec965-68f9-4c86-95a1-4f3112dfdd38",
                                                "sense_id": "4bab0384-4b59-3fee-aafc-f3ee37e68343",
                                                "text": "Op deze bloedhete dag was het heerlijk eens kwast te drinken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
