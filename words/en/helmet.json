{
    "word_family": [
        "helm",
        "unhelmeted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f47a50be-90ee-300f-ab42-634322d3beee",
                    "sense_definition": "A hard, protective hat used by soldiers, police officers, firefighters, motorcyclists, or sports players to protect the head from injury.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must always wear a <w>helmet</w> when you ride a bicycle on the road.",
                            "target_lang_translations": {
                                "ru": "Вы всегда должны надевать <w>шлем</w>, когда едете на велосипеде по дороге.",
                                "zh": "在公路上骑自行车时，你必须一直戴着<w>头盔</w>。"
                            }
                        },
                        {
                            "text": "The construction worker put on his safety <w>helmet</w> before entering the building site.",
                            "target_lang_translations": {
                                "ru": "Строитель надел защитную <w>каску</w> перед входом на строительную площадку.",
                                "zh": "那名建筑工人在进入工地前戴上了安全<w>帽</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "helm",
                        "hard hat"
                    ],
                    "common_phrases": [
                        "wear a helmet",
                        "crash helmet",
                        "bicycle helmet",
                        "safety helmet",
                        "put on a helmet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый защитный головной убор, используемый солдатами, полицейскими, пожарными, мотоциклистами или спортсменами для защиты головы от травм.",
                        "zh": "用于保护头部、防止受伤的坚硬防护帽，常见于士兵、警察、消防员、摩托车手或运动员等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлем",
                                "target_lang_sense_clarification": "спортивный, мотоциклетный, исторический"
                            },
                            {
                                "target_lang_word": "каска",
                                "target_lang_sense_clarification": "строительная, военная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "头盔",
                                "target_lang_sense_clarification": "一般指骑车、摩托车、运动等使用的护头装备"
                            },
                            {
                                "target_lang_word": "安全帽",
                                "target_lang_sense_clarification": "尤指工地等场合佩戴的防护帽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "856a51b7-9b47-37c7-bd55-901b4a761b3f",
