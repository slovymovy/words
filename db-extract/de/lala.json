                        "entry_id": "fea9323b-905a-3177-b4c8-8ac5da73a7b7",
                        "glosses": [
                            "einigermaßen, leidlich, okay, mäßig gut"
                        ],
                        "tags": [
                            "umgangssprachlich;",
                            "in der Wendung „so lala“"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce2e4c8-acc4-41dd-9ff8-4c972258caa8",
                                "sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                                "text": "„Wie war denn die Theaterpremiere?“ – „So lala.“"
                            },
                            {
                                "example_id": "1e82c18e-5518-4e2c-8bab-8086a89b392a",
                                "sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                                "text": "„Wie geht es dir heute?“ – „So lala halt.“"
                            },
                            {
                                "example_id": "cbe7110a-c2ff-4dd3-82f3-0c6d7581e55b",
                                "sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                                "text": "Meine Freundinnen fanden die Lesung so lala."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6700dd95-3436-466b-b827-e0bf54bb5374",
                        "source_entry_id": "fea9323b-905a-3177-b4c8-8ac5da73a7b7",
                        "source_sense_id": "e399368e-584c-37e4-9c0a-f4efbdb24e19",
                        "source_sense_description": "umgangssprachlich; in der Wendung „so lala“: einigermaßen, leidlich, okay, mäßig gut",
                        "target_lang_word": "so-so",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so-so",
