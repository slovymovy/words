                "senses": [
                    {
                        "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                        "entry_id": "a46a04bd-1004-3f6f-9f91-56c426497845",
                        "glosses": [
                            "Propriété de la redstone de Minecraft qui permet aux distributeurs, aux droppers et aux pistons d’être activés par tout ce qui pourrait activer l’espace au-dessus d’eux peu importe ce qui se trouve réellement dans cet espace."
                        ],
                        "tags": [
                            "Jeux vidéo"
                        ],
                        "examples": [
                            {
                                "example_id": "e5a33537-2b5c-448b-a8cc-2fda3396550b",
                                "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                                "text": "Contrairement à Java Edition, Bedrock Edition ne prend pas en charge la quasi-connectivité. Les systèmes qui utilisent des mécanismes comme les commutateurs Block Update Detector (BUD) ne fonctionneront pas."
                            },
                            {
                                "example_id": "b08b9d02-fcc0-438f-be94-8c4fd4f438c8",
                                "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                                "text": "Il utilise quand même la quasi-connectivité des fils hein"
                            },
                            {
                                "example_id": "18e3cf5c-30b4-494c-9006-0bf4323889af",
                                "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                                "text": "au moins un truc où je suis plus calé que les profs :') \"m'sieur vous connaissez la quasi-connectivité ?\""
                            },
                            {
                                "example_id": "79c65d5f-86ad-4f5e-96a2-3434b6f4c471",
                                "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                                "text": "RedShort #04 : Les RÉCEPTEURS et la QUASI-CONNECTIVITÉ"
                            },
                            {
                                "example_id": "0abca9dc-513e-4932-963e-c15409f46838",
                                "sense_id": "79befe4f-36ed-311f-9ead-e1a953c3e084",
                                "text": "Ouais! Incroyablement décevant et risible que Bedrock ne dispose pas de quasi-connectivité alors que Legacy Console en a."
                            }
                        ]
                    }
