                "entry_id": "b33b40e0-e093-3d4f-906e-c8aea8ad31f2",
                "word": "heartache",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d48e68ef-ce16-41db-b783-b3f4588d20d0",
                        "entry_id": "b33b40e0-e093-3d4f-906e-c8aea8ad31f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "heartaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                        "entry_id": "b33b40e0-e093-3d4f-906e-c8aea8ad31f2",
                        "glosses": [
                            "Emotional distress or pain, often caused by a loved one or their absence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a66e2cfa-79af-4ea4-9805-6a76fa395c55",
                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                "text": "[…]: to dye, to ſleepe, / No more; and by a ſleepe, to ſay we end / The Heart-ake, and the thouſand Naturall ſhockes / That Fleſh is heyre too?"
                            },
                            {
                                "example_id": "5b00a6d9-97a6-44a7-836b-c41696fd71a1",
                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                "text": "“Well done, sister! I honour your esprit du corps. When I am a wife, I mean to be just as staunch myself; and I wish my friends in general would be so too. It would save me many a heart ache.”"
                            },
                            {
                                "example_id": "71b13c71-28a4-4819-a641-e4d9cec440c4",
                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                "text": "She was carrying an armful of Bibles for her class, and such was her view of life that events which produced heartache in others wrought beatific smiles upon her—an enviable result, although, in the opinion of Angel, it was obtained by a curiously unnatural sacrifice of humanity to mysticism."
                            },
                            {
                                "example_id": "a328044d-a496-4dc0-aacb-7c67b5b6da30",
                                "sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                                "text": "Heaven knows what pains the author has been at, what bitter experiences he has endured and what heartache suffered, to give some chance reader a few hours' relaxation or to while away the tedium of a journey."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cd977a9-5021-45a9-ad2e-493c9a928e56",
                        "source_entry_id": "b33b40e0-e093-3d4f-906e-c8aea8ad31f2",
                        "source_sense_id": "a8617e33-2d86-36ad-818a-6eadd0f37a2c",
                        "source_sense_description": "emotional distress or pain",
                        "target_lang_word": "hartzeer",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hartzeer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "79f81e9d-a6d7-3c3e-a4de-846c9fee2906",
                                        "entry_id": "003ca396-9156-3388-a12a-e72caffeb686",
                                        "glosses": [
                                            "emotionele pijn die ontstaat door het verlies van een geliefd persoon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb19518d-17a7-48ef-ab75-fe711fa56e74",
                                                "sense_id": "79f81e9d-a6d7-3c3e-a4de-846c9fee2906",
                                                "text": "En zo raak ik mijn dochter weer kwijt. Hoeveel hartzeer kan één man verdragen?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67d4c455-0132-3843-81ad-91b3a3c4b5ba",
                                        "entry_id": "003ca396-9156-3388-a12a-e72caffeb686",
                                        "glosses": [
                                            "ergens geestelijk onder lijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac654811-8656-4206-a773-0ec91869095d",
                                                "sense_id": "67d4c455-0132-3843-81ad-91b3a3c4b5ba",
                                                "text": "Ik ga aan boord en vind een zitplaats naast het raam aan de stuurboord kant van de helikopter. Vijf minuten later, en Kailahun ligt achter me, met het geluk en het hartzeer van de afgelopen maand. Ik weet dat ik hier nooit terug zal komen, maar ik weet ook dat ik deze plaats nooit helemaal achter me zal laten. Ik kijk toe hoe de stad plaats maakt voor een groen tapijt van bomen en dan val ik opvallend genoeg in slaap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
