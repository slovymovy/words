                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f029090-07a7-302b-b1c5-a8f1e142929a",
                        "entry_id": "2ee9f4ba-79f9-381d-87c0-2818bec9dbc5",
                        "glosses": [
                            "Domestication et élevage des abeilles dans le but d’en obtenir certains produits (comme le miel, la cire, la gelée royale ou la propolis) ou services (comme la pollinisation)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede1f712-1f27-4667-9f2b-f86ebc3974ae",
                                "sense_id": "1f029090-07a7-302b-b1c5-a8f1e142929a",
                                "text": "Les plantations d’eucalyptus ont permis le développement d’une apiculture importante dans certaines zones du Maroc."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b474505b-55b4-432e-9627-0c74635d1f60",
                        "source_entry_id": "2ee9f4ba-79f9-381d-87c0-2818bec9dbc5",
                        "source_sense_id": "1f029090-07a7-302b-b1c5-a8f1e142929a",
                        "target_lang_word": "Imker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Imker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                        "entry_id": "c9839a3a-e27f-3a25-85be-0fe93934ba31",
                                        "glosses": [
                                            "Person, die sich beruflich oder nebenberuflich mit Honiggewinnung und/oder der Zucht und Aufzucht von Bienenköniginnen befasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "064f974f-9f24-4c43-ae41-1eebe9c1c8fb",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "Der Imker schleudert den Honig aus den Bienenwaben."
                                            },
                                            {
                                                "example_id": "2049df2d-c5b9-4241-af02-c023e7b7a32f",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "„Maschmann begann 1947 mit der Bienenzucht, weil die britischen Soldaten für jeden Imker zum Füttern zwei Pfund Zucker extra freigaben.“"
                                            },
                                            {
                                                "example_id": "be780cbd-4012-499d-a0e9-2978c0f9bae8",
                                                "sense_id": "12cf4fe4-6324-3abe-bab3-3057ed576a45",
                                                "text": "„Das Aus- und Einfliegen der Bienen ist doch anders als in lebendigen Stöcken, und dem Imker fällt es auf, dass der Geruch und die Geräusche doch nicht die gleichen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55257208-4afc-4ab2-a19d-6bd2f6749189",
