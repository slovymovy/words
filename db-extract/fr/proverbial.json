                        "translation_id": "4e56d477-884c-4f33-8760-2e344804532e",
                        "source_entry_id": "ad0533fc-3691-360a-a12f-a8071a27d6b8",
                        "target_lang_word": "sprichwörtlich",
                        "target_lang_code": "de",
