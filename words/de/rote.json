                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In den Medien wurde die engagierte Politikerin oft als überzeugte <w>Rote</w> bezeichnet.",
                            "target_lang_translations": {
                                "en": "In the media, the committed politician was often described as a staunch <w>red</w>.",
                                "ru": "В средствах массовой информации эту активную женщину-политика часто называли убеждённой <w>красной</w>.",
                                "nl": "In de media werd de geëngageerde politica vaak als een overtuigde <w>rode</w> omschreven.",
                                "pl": "W mediach zaangażowana polityczka była często określana jako zagorzała <w>czerwona</w>.",
                                "fr": "Dans les médias, la femme politique engagée était souvent qualifiée de <w>rouge</w> convaincue.",
                                "it": "Nei media l'impegnata politica veniva spesso descritta come una convinta <w>rossa</w>.",
                                "cs": "V médiích byla tato angažovaná politička často označována za přesvědčenou <w>rudou</w>.",
                                "tr": "Medyada bu azimli kadın siyasetçi sık sık kararlı bir <w>kızıl</w> olarak tanımlandı.",
                                "es": "En los medios, la comprometida política a menudo era descrita como una <w>roja</w> convencida.",
                                "zh": "在媒体报道中，这位积极投身政治的女性常被称为坚定的<w>红色分子</w>。"
                            }
                        },
                        {
                            "text": "Als bekennende <w>Rote</w> setzte sie sich zeit ihres Lebens für die Arbeiterbewegung ein.",
                            "target_lang_translations": {
                                "en": "As an avowed <w>red</w>, she campaigned for the labor movement throughout her life.",
                                "ru": "Будучи открытой <w>красной</w>, она всю жизнь выступала в поддержку рабочего движения.",
                                "nl": "Als verklaarde <w>rode</w> zette zij zich haar leven lang in voor de arbeidersbeweging.",
                                "pl": "Jako zdeklarowana <w>czerwona</w> przez całe życie angażowała się w ruch robotniczy.",
                                "fr": "En tant que <w>rouge</w> déclarée, elle s'est engagée toute sa vie en faveur du mouvement ouvrier.",
                                "it": "Come dichiarata <w>rossa</w>, si è impegnata per tutta la vita a favore del movimento operaio.",
                                "cs": "Jako deklarovaná <w>rudá</w> se po celý život zasazovala o dělnické hnutí.",
                                "tr": "Kendisini açıkça bir <w>kızıl</w> olarak tanımlayarak tüm yaşamı boyunca işçi hareketi için mücadele etti.",
                                "es": "Como <w>roja</w> confesa, luchó toda su vida por el movimiento obrero.",
                                "zh": "作为一名公开的<w>左翼人士</w>，她毕生致力于工人运动。"
                            }
                        }
