                                    {
                                        "sense_id": "405de3be-cdc6-3996-9f36-45139aff7f88",
                                        "entry_id": "aecfab6d-de2a-3ec3-aac2-82efbdbd5475",
                                        "glosses": [
                                            "Action d’éliminer ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2353948e-45be-4e97-bd64-abc71a1d66dd",
                                                "sense_id": "405de3be-cdc6-3996-9f36-45139aff7f88",
                                                "text": "L’élimination de l’arme chimique est un objectif difficile à atteindre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ce94396-9a2a-3ee3-9580-cf8465fdfb7a",
                                        "entry_id": "aecfab6d-de2a-3ec3-aac2-82efbdbd5475",
                                        "glosses": [
                                            "Opération qui consiste à combiner ensemble, par addition, soustraction ou division, plusieurs équations renfermant plusieurs inconnues, de manière à en déduire une équation résultante qui ne renferme qu’une inconnue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "358ed96e-353e-30b8-8222-3063c4228294",
                                        "entry_id": "aecfab6d-de2a-3ec3-aac2-82efbdbd5475",
                                        "glosses": [
                                            "Abréviation de course à l’élimination."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a71ecfb-23cb-4e84-82a4-6994bb74a499",
                                                "sense_id": "358ed96e-353e-30b8-8222-3063c4228294",
                                                "text": "J’ai fait une mauvaise élimination, c’est la première à ce niveau-là et ça frottait vraiment sale. Bon j’ai montré que j’étais assez fort quand même."
                                            }
                                        ]
                                    }
                                ]
                            }
