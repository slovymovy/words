                ],
                "senses": [
                    {
                        "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                        "entry_id": "8d3ef359-6f59-31eb-bd92-7cea349f7af6",
                        "glosses": [
                            "ein postalisch abgeschlossenes Sammelgebiet, in dem bei einer Abstimmung durch Wahlen die Gebietszugehörigkeit zu einem Staat festgelegt wurde"
                        ],
                        "tags": [
                            "Philatelie"
                        ],
                        "examples": [
                            {
                                "example_id": "a6a95cce-af9d-43fa-a4ea-0473305b9a74",
                                "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                                "text": "Das Sammelgebiet Geschichte und Philatelie der deutschen Abstimmungsgebiete setzt historische und fundierte philatelistische Kenntnisse voraus."
                            },
                            {
                                "example_id": "f730e77f-d011-4f10-8114-d425d62641b1",
                                "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                                "text": "In Deutschland waren die bekanntesten Abstimmungsgebiete: Saargebiet (Saarland), Eupen-Malmedy, Nordschleswig, Ostpreußen, Westpreußen und Oberschlesien (Schlesien)."
                            },
                            {
                                "example_id": "b052bcce-10f5-4c3e-8b09-c1b3f60291ae",
                                "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                                "text": "In Österreich waren die Abstimmungsgebiete: Südkärnten (Kärnten) und das Burgenland."
                            },
                            {
                                "example_id": "c6e13c28-db55-4f70-9ea1-cb2568ab2545",
                                "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                                "text": "„Das damalige Abstimmungsgebiet Allenstein entsprach in etwa dem heutigen Masuren.“"
                            },
                            {
                                "example_id": "ae6d78e3-6d1e-42fd-aef0-f7aee6f74edd",
                                "sense_id": "17a2129a-ad19-3072-b9b6-89bac2fa604e",
                                "text": "„Die am 10.2.1920 in der Zone I beziehungsweise am 4.3.1920 in der Zone II stattfindende Abstimmung (Entente-Sitz war Flensburg) ergab eine Teilung des schleswigschen Abstimmungsgebietes zwischen dem Deutschen Reich und Dänemark, worauf Dänemark am 19.5. die ihm zufallende I. Zone sofort übernahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
