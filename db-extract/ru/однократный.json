                                        "examples": [
                                            {
                                                "example_id": "5c3aa0b5-c722-41ea-baf1-c85a4c69e629",
                                                "sense_id": "6a2d5368-4e62-384b-8b50-ec50ea0f25de",
                                                "text": "A onze heures il arrivait à Fresnay-les-Chaumes, déjeunait à l’unique bouchon de ce hameau de Pithiviers-le-Vieil, d'un chanteau de pain bis et d'un hareng saur, additionnés d'un petit vin du pays qui lui fit faire une de ces grimaces !"
                                            },
                                            {
                                                "example_id": "c9f6df18-73ff-4ed2-8302-5018650b32c7",
                                                "sense_id": "6a2d5368-4e62-384b-8b50-ec50ea0f25de",
                                                "text": "Pour unique réponse, Geisha s'étira paresseusement et demanda une cigarette."
                                            },
                                            {
                                                "example_id": "b1006d88-edfa-4a06-893b-01d7bd7b866e",
                                                "sense_id": "6a2d5368-4e62-384b-8b50-ec50ea0f25de",
                                                "text": "On ne trouve plus ce livre, j’en ai l’unique exemplaire qui reste."
                                            },
                                            {
                                                "example_id": "263c70c0-2da4-4e63-ba20-4483155f381a",
                                                "sense_id": "6a2d5368-4e62-384b-8b50-ec50ea0f25de",
                                                "text": "Mon unique soin. Son unique préoccupation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4792081a-fbea-350b-a7c3-ddcfdf699b04",
                                        "entry_id": "cb396c22-0195-3815-b6ce-0e24d46af642",
                                        "glosses": [
                                            "Désigne un objet mathématique qui est le seul à vérifier une propriété, éventuellement à transformations près."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e42366-7a3e-4af1-bee4-75e59da9b923",
                                                "sense_id": "4792081a-fbea-350b-a7c3-ddcfdf699b04",
                                                "text": "À isomorphisme près, il existe un unique groupe cyclique de cardinal 4."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95dec0f9-312a-3326-b066-e9b1701768db",
                                        "entry_id": "cb396c22-0195-3815-b6ce-0e24d46af642",
                                        "glosses": [
                                            "Qui est de beaucoup au-dessus des autres et auquel les autres ne peuvent être comparés."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "461969a3-01de-4eee-a008-5df5c606d3ed",
                                                "sense_id": "95dec0f9-312a-3326-b066-e9b1701768db",
                                                "text": "Ce peintre, ce musicien est unique en son genre. C’est un homme unique. Une élégance unique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "539f4896-db9f-350f-b9af-c1401406e135",
                                        "entry_id": "cb396c22-0195-3815-b6ce-0e24d46af642",
                                        "glosses": [
                                            "Se dit d’un homme ridicule, d’un extravagant, pour dire qu’il n’a pas son semblable."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c505564-9f80-4491-a079-7ea8e8a88596",
                                                "sense_id": "539f4896-db9f-350f-b9af-c1401406e135",
                                                "text": "Vous êtes unique."
                                            }
                                        ]
                                    }
                                ]
                            },
