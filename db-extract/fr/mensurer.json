                "senses": [
                    {
                        "sense_id": "d9b17507-b83d-31d8-9101-04798a223897",
                        "entry_id": "0673b0aa-1f96-3934-b2cb-a8b062ad1b8c",
                        "glosses": [
                            "Soumettre à la mensuration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa2fb8c-e94e-46e8-b1b7-6e8cde4d94dd",
                                "sense_id": "d9b17507-b83d-31d8-9101-04798a223897",
                                "text": "Mensurer un malfaiteur lors de son incarcération."
                            },
                            {
                                "example_id": "6685f32e-ed6d-4d18-9b12-cf42b46449a7",
                                "sense_id": "d9b17507-b83d-31d8-9101-04798a223897",
                                "text": "Il n'est pas toujours facile, même quand on est connu de ceux qu'on veut examiner, de les décider à se laisser mensurer ou photographier, à plus forte raison quand on a affaire à des inconnus, à des fous, à des ignorants."
                            },
                            {
                                "example_id": "2a5ea6a1-abf7-497f-8213-39556ba4805b",
                                "sense_id": "d9b17507-b83d-31d8-9101-04798a223897",
                                "text": "Mais le but principal que je poursuivais en utilisant cette méthode était de mensurer des fibres isolées."
                            },
                            {
                                "example_id": "57066cf6-8cac-491e-a0ea-dbf88045efe7",
                                "sense_id": "d9b17507-b83d-31d8-9101-04798a223897",
                                "text": "On la tua, on l’empailla et on la fit mensurer par Buffon."
                            }
                        ]
                    }
