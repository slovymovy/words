                                        "glosses": [
                                            "geologisch tijdperk waarin de mensachtigen zich ontwikkelen, eerste tijdvak van het periode quartair, van 2.588.000 tot 11.700 jaar geleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c418c5f-b595-4641-9079-bbf0ebe945b6",
                                                "sense_id": "a47130d7-1742-33da-be17-d5f64675dd33",
                                                "text": "In de voorlaatste ijstijd van het pleistoceen baanden uit Scandinavië afkomstige lobben landijs zich een weg door Overijssel."
                                            }
                                        ]
                                    }
                                ]
                            },
