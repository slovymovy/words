                        "source_sense_description": "sauer gewordene und durch spezielle Bakterien dickgelegte Milch",
                        "target_lang_word": "простокваша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "простокваша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f992caf5-d789-3436-8897-d651a7f12234",
                                        "entry_id": "380f0bfc-c849-35ff-860c-7ef05f07dddc",
                                        "glosses": [
                                            "кулин. кисломолочный продукт, представляющий собой густое закисшее молоко"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33872a5a-6c51-4ebb-9e6f-7032f66d7f0b",
                                                "sense_id": "f992caf5-d789-3436-8897-d651a7f12234",
                                                "text": "Иосаф Платонович и жена его были теперь дома: они сидели в маленькой дачной зальце и ели из одной общей стеклянной чаши простоквашу!"
                                            },
                                            {
                                                "example_id": "aca13412-7185-496d-aa40-7572227e9397",
                                                "sense_id": "f992caf5-d789-3436-8897-d651a7f12234",
                                                "text": "На станциях приходилось сидеть по четыре дня, питаться яичницей и простоквашей."
                                            },
                                            {
                                                "example_id": "efcc0f56-4e9c-4460-b548-607e2ca184e2",
                                                "sense_id": "f992caf5-d789-3436-8897-d651a7f12234",
                                                "text": "В окрошках мясных или овощных хлебный квас можно заменить молочной сывороткой, простоквашей или квашеным молоком."
                                            },
                                            {
                                                "example_id": "c956e199-1bd4-40dd-8e62-82a59354b9b9",
                                                "sense_id": "f992caf5-d789-3436-8897-d651a7f12234",
                                                "text": "Она приказала мне слазить в погреб и поставить для дяди на холод кринку простокваши."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
