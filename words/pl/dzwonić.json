    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c515180-e763-342a-95bc-9d571d94bf34",
                    "sense_definition": "Telefonować, próbować nawiązać połączenie telefoniczne z inną osobą lub instytucją.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <dzwonić> do mamy codziennie wieczorem.",
                            "target_lang_translations": {
                                "ru": "Я должен <звонить> маме каждый вечер.",
                                "en": "I have to <call> my mom every evening.",
                                "zh": "我每天晚上都得给妈妈<w>打电话</w>。"
                            }
                        },
                        {
                            "text": "Kiedy będziesz <dzwonić> w sprawie tej pracy?",
                            "target_lang_translations": {
                                "ru": "Когда ты будешь <звонить> по поводу этой работы?",
                                "en": "When are you going to <call> about this job?",
                                "zh": "你打算什么时候为了那份工作<w>打电话</w>咨询？"
                            }
                        },
                        {
                            "text": "Wczoraj wieczorem <w>dzwoniłam</w> do ciebie trzy razy, ale nie odbierałeś.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером я <w>звонила</w> тебе три раза, но ты не брал трубку.",
                                "en": "I <w>called</w> you three times yesterday evening, but you didn't answer.",
                                "zh": "昨天晚上我给你<w>打了</w>三次<w>电话</w>，但你都没接。"
                            }
                        }
                    ],
                    "synonyms": [
                        "telefonować"
                    ],
                    "common_phrases": [
                        "dzwonić do kogoś",
                        "dzwonić na policję",
                        "dzwonić po taksówkę",
                        "dzwonić w sprawie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звонить, пытаться установить телефонную связь с другим человеком или учреждением.",
                        "en": "To call or try to make a telephone connection with someone or an institution.",
                        "zh": "打电话；尝试与他人或机构通过电话取得联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "по телефону"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "call",
                                "target_lang_sense_clarification": "to telephone someone"
                            },
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "to telephone someone (chiefly UK/Commonwealth)"
                            },
                            {
                                "target_lang_word": "phone",
                                "target_lang_sense_clarification": "to call someone by telephone"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打电话",
                                "target_lang_sense_clarification": "通过电话通话或呼叫"
                            },
                            {
                                "target_lang_word": "致电",
                                "target_lang_sense_clarification": "较正式的打电话"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5538b32f-703e-3190-a421-fd0f24c4d84d",
                    "sense_definition": "Wydawać głośny dźwięk (o telefonie, budziku lub dzwonku szkolnym).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sound_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Twój telefon <dzwoni> już od minuty, odbierz go.",
                            "target_lang_translations": {
                                "ru": "Твой телефон <звонит> уже минуту, ответь.",
                                "en": "Your phone has been <ringing> for a minute, answer it.",
                                "zh": "你的手机已经<w>响</w>了一分钟了，快接吧。"
                            }
                        },
                        {
                            "text": "Rano budzik <dzwoni> o siódmej, ale nie chcę wstawać.",
                            "target_lang_translations": {
                                "ru": "Утром будильник <звонит> в семь, но я не хочу вставать.",
                                "en": "In the morning my alarm clock <rings> at seven, but I don't want to get up.",
                                "zh": "早上闹钟七点就<w>响</w>了，但我不想起床。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "telefon dzwoni",
                        "budzik dzwoni",
                        "dzwonić na przerwę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий звук (о телефоне, будильнике или школьном звонке).",
                        "en": "To emit a ringing sound (of a phone, alarm clock, or school bell).",
                        "zh": "（电话、闹钟或下课铃等）响铃，发出声响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "издавать звук"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "of a phone, bell, or alarm"
                            },
                            {
                                "target_lang_word": "go off",
                                "target_lang_sense_clarification": "of an alarm clock or timer"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "响",
                                "target_lang_sense_clarification": "发出铃声或声响"
                            },
                            {
                                "target_lang_word": "鸣响",
                                "target_lang_sense_clarification": "发出响声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73c1d437-3d77-3600-b263-6e37570b06ef",
                    "sense_definition": "Używać dzwonka (zazwyczaj przy wejściu do domu), aby zasygnalizować swoje przybycie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listonosz <dzwonił> do drzwi, ale nikogo nie było w domu.",
                            "target_lang_translations": {
                                "ru": "Почтальон <звонил> в дверь, но никого не было дома.",
                                "en": "The mail carrier <rang> the doorbell, but no one was home.",
                                "zh": "邮递员<w>按了门铃</w>，但家里没有人。"
                            }
                        },
                        {
                            "text": "Nie lubię, gdy ktoś <dzwoni> do bramy późno w nocy.",
                            "target_lang_translations": {
                                "ru": "Я не люблю, когда кто-то <звонит> в ворота поздно ночью.",
                                "en": "I don't like it when someone <buzzes> the gate late at night.",
                                "zh": "我不喜欢有人深夜在大门口<w>按铃</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dzwonić do drzwi",
                        "dzwonić dzwonkiem"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать звонок (обычно у входа в дом), чтобы сообщить о своем приходе.",
                        "en": "To use a bell or doorbell (usually at a door or gate) to signal arrival.",
                        "zh": "按门铃（通常在门口以告知有人到来）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звонить",
                                "target_lang_sense_clarification": "в дверь"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "the doorbell or buzzer"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按门铃",
                                "target_lang_sense_clarification": "按门上的铃示意到来"
                            },
                            {
                                "target_lang_word": "按铃",
                                "target_lang_sense_clarification": "按响铃铛"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6877006-444e-38cb-a8a1-12478bbe9508",
                    "sense_definition": "Wydawać metaliczny odgłos poprzez uderzanie o siebie twardych przedmiotów.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Było tak zimno, że aż zęby <dzwoniły> mi z mrozu.",
                            "target_lang_translations": {
                                "ru": "Было так холодно, что у меня даже зубы <стучали> от мороза.",
                                "en": "It was so cold that my teeth were <chattering> from the frost.",
                                "zh": "天气太冷了，冻得我的牙齿直<w>打颤</w>。"
                            }
                        },
                        {
                            "text": "Strażnik szedł korytarzem i głośno <dzwonił> kluczami.",
                            "target_lang_translations": {
                                "ru": "Охранник шел по коридору и громко <звенел> ключами.",
                                "en": "The guard was walking down the hallway, loudly <jingling> his keys.",
                                "zh": "警卫走在走廊上，把钥匙晃得<w>叮当作响</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "szczękać",
                        "brzęczeć"
                    ],
                    "common_phrases": [
                        "dzwonić kluczami",
                        "zęby dzwonią",
                        "dzwonić monetami"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать металлический звук при ударе твердых предметов друг о друга.",
                        "en": "To produce a metallic rattling sound when hard objects strike against each other.",
                        "zh": "（硬物相碰等）发出叮当声或金属碰撞声；（牙齿等）打颤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "издавать звон"
                            },
                            {
                                "target_lang_word": "бренчать",
                                "target_lang_sense_clarification": "ключами или монетами"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "jingle",
                                "target_lang_sense_clarification": "keys or coins"
                            },
                            {
                                "target_lang_word": "clink",
                                "target_lang_sense_clarification": "metallic or glass objects colliding"
                            },
                            {
                                "target_lang_word": "chatter",
                                "target_lang_sense_clarification": "teeth from cold"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叮当作响",
                                "target_lang_sense_clarification": "金属或硬物碰击发出清脆声"
                            },
                            {
                                "target_lang_word": "打颤",
                                "target_lang_sense_clarification": "形容牙齿冻得咯咯作响"
                            },
                            {
                                "target_lang_word": "碰响",
                                "target_lang_sense_clarification": "使物品发出碰撞声"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c6672282-5619-3244-b836-1294e35098f2",
                    "sense_definition": "Odczuwać nieprzyjemny szum lub pisk wewnątrz uszu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po głośnym koncercie przez godzinę <dzwoniło> mi w uszach.",
                            "target_lang_translations": {
                                "ru": "После громкого концерта у меня час <звенело> в ушах.",
                                "en": "After the loud concert, my ears were <ringing> for an hour.",
                                "zh": "听完那场嘈杂的音乐会后，我足足<w>耳鸣</w>了一个小时。"
                            }
                        },
                        {
                            "text": "Jeśli ciągle <dzwoni> ci w głowie, powinieneś iść do lekarza.",
                            "target_lang_translations": {
                                "ru": "Если у тебя постоянно <звенит> в голове, тебе следует пойти к врачу.",
                                "en": "If you constantly have <ringing> in your head, you should see a doctor.",
                                "zh": "如果你的脑子一直<w>嗡嗡作响</w>，你应该去看医生。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dzwonić w uszach"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущать неприятный шум или писк внутри ушей.",
                        "en": "To experience an unpleasant buzzing or ringing sensation inside the ears.",
                        "zh": "感到耳鸣，耳朵或脑袋嗡嗡作响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звенеть",
                                "target_lang_sense_clarification": "в ушах"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "ring",
                                "target_lang_sense_clarification": "of ears experiencing tinnitus or buzzing"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳鸣",
                                "target_lang_sense_clarification": "耳内感到嗡嗡或尖锐声响"
                            },
                            {
                                "target_lang_word": "嗡嗡作响",
                                "target_lang_sense_clarification": "脑中或耳中响"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}