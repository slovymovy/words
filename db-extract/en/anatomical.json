                                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                                "text": "Observations, recherches, travaux anatomiques. Préparations, démonstrations anatomiques. Sujet anatomique."
                                            },
                                            {
                                                "example_id": "d372e44b-0c49-4f86-ba8c-b9d5f2c27add",
                                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                                "text": "La constitution anatomique du cerveau, son architecture, sa structure nous sont en partie connues aujourd’hui."
                                            },
                                            {
                                                "example_id": "a9343033-c1f4-476a-b49c-6ed50f1d885e",
                                                "sense_id": "c35a83e9-ff3e-3044-8f79-c456953bd4ee",
                                                "text": "— À cette foire de Bordeaux, je suis entré un jour au « musée Dupuytren ». C’étaient des pièces anatomiques en cire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c565d1d-86d4-396f-9781-1205854689bd",
                                        "entry_id": "adc9e3de-e57a-324a-a576-e11ddb34df79",
                                        "glosses": [
                                            "Qui s'adapte à la forme du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
