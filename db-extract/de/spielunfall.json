                ],
                "senses": [
                    {
                        "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                        "entry_id": "c3535348-9dac-341b-9fcb-1832751a94af",
                        "glosses": [
                            "Ereignis beim Spielen, das eine Schädigung zur Folge hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be060e5c-6503-4595-ad93-bc3f8fed4724",
                                "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                                "text": "„Das Kind kann im Schutze der entschärften Verkehrsarrangements folgenlos Irrtümer begehen, Fehlentscheidungen fällen; trotzdem werden die Spielunfälle hautnah, mit dem eigenen Körper, erlebt.“"
                            },
                            {
                                "example_id": "2e2031dd-f1cd-49cb-a3f0-30dd06f4c74d",
                                "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                                "text": "„Die Verletzungen des Kindes hätten lebensnah und zwanglos mit der Unfalldarstellung der Eltern erklärt werden können. Derartige Spielunfälle seien geradezu typisch für Kinder.“"
                            },
                            {
                                "example_id": "cc734b50-4d09-411c-b971-4186e8bd473b",
                                "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                                "text": "„Besonders Kinder sind oft schwer zu bewegen, nach Spielunfällen den wahren Hergang anzugeben.“"
                            },
                            {
                                "example_id": "15369eed-a9fd-435b-9ee0-0282a52dbd76",
                                "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                                "text": "„Das vierjährige Mädchen erlag am Dienstag in Phoenix schweren Verletzungen, die das Kind tags zuvor bei einem Spielunfall im Haus seiner Mutter erlitten hatte.“"
                            },
                            {
                                "example_id": "968e779f-7665-464e-9e1c-204d15782f97",
                                "sense_id": "7ce3c06a-8489-3557-9d6e-0f06095a4f6a",
                                "text": "„Bei einem Spielunfall hat sich ein fast zweijähriger Knabe am Freitagnachmittag, 27.9.2019, in Brüttisellen ZH schwere Verletzungen zugezogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
