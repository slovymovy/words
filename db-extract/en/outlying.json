                        ],
                        "form": "more outlying"
                    },
                    {
                        "form_id": "d727ba4f-7998-41bb-84ab-41ba481bede2",
                        "entry_id": "bf4068c7-06da-39c6-8dad-95fd11f40acc",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most outlying"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4b64add-f64c-3e77-8298-ed8e4755ab2c",
                        "entry_id": "bf4068c7-06da-39c6-8dad-95fd11f40acc",
                        "glosses": [
                            "Relatively remote from some central location."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "302340ab-1a36-467b-8678-94fac6e1a606",
                                "sense_id": "b4b64add-f64c-3e77-8298-ed8e4755ab2c",
                                "text": "The more outlying villages were never visited by their member of parliament."
                            },
                            {
                                "example_id": "cc3e81bc-040b-411f-8590-7de7ed76f17e",
                                "sense_id": "b4b64add-f64c-3e77-8298-ed8e4755ab2c",
                                "text": "During the first year or so of British Railways, some of the simpler and more obvious inter-regional transfers of outlying sections were effected, such as those of the London, Tilbury & Southend Railway from the London Midland Region to the Eastern Region; the South Wales lines of the former L.M.S.R. to the Western Region; the Carlisle-Silloth branch (an L.N.E.R. legacy of a North British \"border raid\") to the London Midland, and so on."
                            },
                            {
                                "example_id": "357cc34a-8f6a-443e-87b5-1cdd5195440d",
                                "sense_id": "b4b64add-f64c-3e77-8298-ed8e4755ab2c",
                                "text": "Lorries collect the milk from the various outlying farms, whence it is taken to the district distribution centre to undergo pasteurisation."
                            },
                            {
                                "example_id": "42324884-dd40-45b6-929f-00d8d59395ea",
                                "sense_id": "b4b64add-f64c-3e77-8298-ed8e4755ab2c",
                                "text": "The causeways were laid as hard paths for heavily laden pack-animals bringing in wool from outlying hamlets and farms."
                            }
                        ]
                    },
                    {
                        "sense_id": "93b3b150-89d8-3d5f-a30e-02b4ddc4e748",
                        "entry_id": "bf4068c7-06da-39c6-8dad-95fd11f40acc",
                        "glosses": [
                            "Located outside of some boundary or limit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "752faef2-3ac5-4a66-b13b-54daa3c39a7d",
                                "sense_id": "93b3b150-89d8-3d5f-a30e-02b4ddc4e748",
                                "text": "When the map was redrawn after the war, our cousin found herself living in outlying territory."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5bde48a1-ad28-463c-a74f-27093e2876c2",
                        "source_entry_id": "bf4068c7-06da-39c6-8dad-95fd11f40acc",
                        "source_sense_description": "relatively remote from some central location",
                        "target_lang_word": "удалённый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
