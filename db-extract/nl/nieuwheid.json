                                    {
                                        "sense_id": "9545da33-2eac-322f-b56b-8681a0f698d3",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "The state of being new or novel; newness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "950359cb-aaed-4459-8343-c94c911c33ea",
                                                "sense_id": "9545da33-2eac-322f-b56b-8681a0f698d3",
                                                "text": "Men In Black 3 lacks the novelty of the first film, and its take on the late ’60s feels an awful lot like a psychedelic dress-up party, all broad caricatures and groovy vibes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e43e7e7-8d7e-3e95-a31a-8b8742ae1fbf",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "A new product; an innovation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "926ee183-18bb-4014-b94f-97ec4da2631a",
                                                "sense_id": "4e43e7e7-8d7e-3e95-a31a-8b8742ae1fbf",
                                                "text": "Reconciling profound enquiry with clearness, and truth with novelty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b63b5454-bcc7-34c2-814a-dabfa8802f6b",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "A small mass-produced trinket."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2de17473-3a7c-3edb-8101-5bed1864ed0d",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "In novelty theory, newness, density of complexification, and dynamic change as opposed to static habituation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                        "entry_id": "6d33dcb3-1b6d-31e4-94eb-3774655dfcc7",
                                        "glosses": [
                                            "An opening move played for the first time ever (in high-level chess)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e01089-2461-489b-be62-3d6cc9149dc2",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "Topalov has unveiled some interesting novelties lately, but there was nothing unusual in his opening here. Sasikiran played the Nimzo-Indian, and Topalov replied with probably the most classical continuation."
                                            },
                                            {
                                                "example_id": "43648ded-cb47-4765-b8d2-d9dcc110cc5b",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "It's not often a novelty comes as early as move seven nowadays, but in the latest round of the German Bundesliga, a recently discovered seventh move was employed to win a lovely game."
                                            },
                                            {
                                                "example_id": "47a616fb-08e3-4516-ab83-a3c9e0007111",
                                                "sense_id": "fc07456b-fce3-371e-9b2b-beb9d4fcab81",
                                                "text": "The Russian champion still did very well. Nepomniachtchi was only a wildcard, yet played with full force including an interesting novelty in the much analysed Berlin Wall Ruy Lopez."
                                            }
                                        ]
                                    }
                                ]
                            },
