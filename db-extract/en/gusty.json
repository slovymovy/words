                                    {
                                        "sense_id": "3004f8cb-9a28-3782-a86e-be61867c7d38",
                                        "entry_id": "66c0f55d-e7d6-334d-88f0-a41c6a0a3774",
                                        "glosses": [
                                            "von plötzlich auftretenden, starken Windstößen geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19b1d16-d116-482d-997f-efe1fd406669",
                                                "sense_id": "3004f8cb-9a28-3782-a86e-be61867c7d38",
                                                "text": "„Das trockene Wetter, hohe Temperaturen, böiger Wind könnten jederzeit wieder die Situation verschärfen, hieß es auf Anfrage beim Katastrophenstab.“"
                                            },
                                            {
                                                "example_id": "62c868ba-d762-415a-8880-ceb5652becf0",
                                                "sense_id": "3004f8cb-9a28-3782-a86e-be61867c7d38",
                                                "text": "„Es war so eisig wie nie bei minus 17 Grad, es waren böige Verhältnisse, das war alles andere als ein Wohlfühlrennen zum Abschluss in Zhangjiakou.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d0c1a89-92d0-4549-94c8-e178f4287a96",
