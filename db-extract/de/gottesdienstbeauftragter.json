                    },
                    {
                        "form_id": "009c515c-98c3-4032-a0fb-7d904c0f9142",
                        "entry_id": "9f466a94-1063-376c-aba3-748334689d08",
                        "tags": [
                            "feminine"
                        ],
                        "form": "Gottesdienstbeauftragte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e991c041-b113-3e51-9ced-63e62aece643",
                        "entry_id": "9f466a94-1063-376c-aba3-748334689d08",
                        "glosses": [
                            "Agent pastoral laïc chargé de présider à des célébrations de la parole (service religieux sans eucharistie) dans l’Église catholique romaine (célébrant, officiant)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5254de92-c25d-4820-8142-542b6819728c",
                                "sense_id": "e991c041-b113-3e51-9ced-63e62aece643",
                                "text": "Wenn jedoch im Ausnahmefall aus besonderen Gründen mit Zustimmung des Ortsbischofs die Wort-Gottes-Feier mit einer Kommunionfeier verbunden ist, kommen dem Gottesdienstbeauftragten folgende Aufgaben zu: – die Gemeinde zur Kommunion einzuladen, – ihr die Kommunion, gegebenenfalls zusammen mit Kommunionhelfern/Kommunionhelferinnen zu reichen, – die gemeinsame Danksagung zu halten.",
                                "translation": "Si, cependant, de manière exceptionnelle et pour des raisons particulières, la célébration de la parole se fait avec la distribution de la sainte communion sur autorisation de l’évêque du lieu, il revient au célébrant laïc : – d’inviter l’assemblée à la communion, – de distribuer la communion, éventuellement ensemble avec les auxiliaires, – de mener la prière de l’action de grâce commune."
                            }
                        ]
                    }
                ],
