                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c21bcadc-9b5a-45b1-bbdb-a866c6fe9c9a",
                                "sense_id": "a91ae90a-ad9b-3ebc-8d99-eaa0d0e04c55",
                                "text": "„Jij bent niet net als alle anderen”, zei Milena lachend. Als ze lachte werd haar ademhaling een zomerwind. Nu was ik helemaal rustig. Ik dacht: waarom heb ik me eigenlijk ongerust gemaakt? Het doet er niet toe dat ik niet net als anderen ben.”"
                            },
                            {
                                "example_id": "cc187150-dfda-48c0-86b4-089f9cc5a3c2",
                                "sense_id": "a91ae90a-ad9b-3ebc-8d99-eaa0d0e04c55",
                                "text": "De stormachtige zomerwind die dinsdag vooral de Nederlandse kust teisterde, veroorzaakte op diverse fronten problemen."
                            }
                        ]
                    }
