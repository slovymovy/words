                "senses": [
                    {
                        "sense_id": "63399928-5873-324a-9eb2-c2fff14b261a",
                        "entry_id": "b83a4945-4612-3e04-8b4b-de8a95499e8f",
                        "glosses": [
                            "Zaun aus Stacheldraht zum Abgrenzen eines Grundstücks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c4e225f-67cb-46cc-9638-0c6736e9e59b",
                                "sense_id": "63399928-5873-324a-9eb2-c2fff14b261a",
                                "text": "Die Weide war mit einem Stacheldrahtzaun umzäunt."
                            },
                            {
                                "example_id": "16cf597e-3f5c-4fb2-90c5-bc30ed5e7e90",
                                "sense_id": "63399928-5873-324a-9eb2-c2fff14b261a",
                                "text": "Wenn man sich in einem Stacheldrahtzaun verheddert, ist das eine sehr schmerzhafte Angelegenheit."
                            },
                            {
                                "example_id": "68e66da2-6f6c-45f6-9f34-c69dcbe8c635",
                                "sense_id": "63399928-5873-324a-9eb2-c2fff14b261a",
                                "text": "„In die Stacheldrahtzäune waren überall Durchgänge eingeschnitten worden.“"
                            },
                            {
                                "example_id": "21beb96e-bdc8-490a-a9a2-dc3a56c75466",
                                "sense_id": "63399928-5873-324a-9eb2-c2fff14b261a",
                                "text": "„Ein hügeliges Gelände voller Steinbrocken war von hohen Stacheldrahtzäunen umgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
