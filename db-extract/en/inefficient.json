                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c6ad771-9507-4d1e-894a-697fc367abf8",
                                "sense_id": "609f46f3-b499-3778-abac-b780b7c7135b",
                                "text": "Celery is an inefficient food."
