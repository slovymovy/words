                        "target_lang_word": "луддит",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "луддит",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bd3ad3ac-4bf9-326e-8399-ca26102ea478",
                                        "entry_id": "beb889d1-7ffd-3916-91c7-7a2c64767814",
                                        "glosses": [
                                            "истор. участник группы английских рабочих, протестовавших в начале 1800-х годов против изменений, которые повлекли промышленный переворот, и считавший, что его рабочему месту угрожает опасность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c99f6b82-300b-4fbf-becb-7c142ffcd8c3",
                                                "sense_id": "bd3ad3ac-4bf9-326e-8399-ca26102ea478",
                                                "text": "В целом, творчество физиков новой генерации подтверждает тезис Ч. П. Сноу о том, что интеллектуалы — это «прирождённые луддиты»."
                                            }
                                        ]
                                    }
                                ]
                            }
