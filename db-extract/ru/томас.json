                "translations": [
                    {
                        "translation_id": "42f1369e-74d6-49f3-a02f-e819133e9d4c",
                        "source_entry_id": "0b6beda6-dbe5-3e34-a3a3-e8cc80ff536e",
                        "target_lang_word": "Thomas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thomas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc339d0-f402-3fb2-8b2c-a69289e3d30e",
                                        "entry_id": "7d140847-a28a-3bab-b816-0ae52f9545c1",
                                        "glosses": [
                                            "An infidel or doubter."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c49c771-cf78-43dd-af91-bc5a67177446",
                                                "sense_id": "1bc339d0-f402-3fb2-8b2c-a69289e3d30e",
                                                "text": "[…] and if the surgeons do not preserve you, and place you on view, in pickle, they ought to, for the sake of historical doubters, for no one will believe that there ever was a man like you, unless you yourself are somewhere around to prove them Thomases."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Thomas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b078511c-0348-34f8-8a1d-27d0c2375f47",
                                        "entry_id": "b751654c-144c-3e0f-90ed-055288d08f87",
                                        "glosses": [
                                            "An Apostle, best remembered for doubting the resurrection of Jesus."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c08e6f23-4116-402e-b13c-fd69a73b8e5e",
                                                "sense_id": "b078511c-0348-34f8-8a1d-27d0c2375f47",
                                                "text": "But Thomas, one of the twelve, called Didymus, was not with them when Jesus came. The other disciples therefore said unto him, We have seen the LORD. But he said unto them, Except I shall see in his hands the print of the nails, and put my finger into the print of the nails, and thrust my hand into his side, I will not believe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb75f14f-3723-3231-8b75-1e03661906d3",
                                        "entry_id": "b751654c-144c-3e0f-90ed-055288d08f87",
                                        "glosses": [
                                            "A male given name from Aramaic of biblical origin, popular since the 13th century."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cfd026c-b299-43d4-b38d-b1464047e6fd",
                                                "sense_id": "eb75f14f-3723-3231-8b75-1e03661906d3",
                                                "text": "\"Good,—that's a whack. What's your name?\" / \"Becky Thatcher. What's yours? Oh, I know. It's Thomas Sawyer.\" / \"That's the name they lick me by. I'm Tom when I'm good. You call me Tom, will you?\""
                                            },
                                            {
                                                "example_id": "e19e50f7-3e42-492c-99bc-b0190513f7d7",
                                                "sense_id": "eb75f14f-3723-3231-8b75-1e03661906d3",
                                                "text": "- - - goodness we scarcely have a name for the baby yet now all of you must take a vote, all of you, but let's have a nice simple name like Thomas don't you think I hate elaborate names, do please all of you vote for Thomas...\""
                                            },
                                            {
                                                "example_id": "6a583f94-5617-4495-adb3-1c02c3c24ae9",
                                                "sense_id": "eb75f14f-3723-3231-8b75-1e03661906d3",
                                                "text": "In 2019, BfV President Thomas Haldenwang said members showed “clear evidence of an anti-immigration and particularly anti-Muslim attitude,” which is contrary to Germany’s democratic principles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "530d3c68-0734-3430-a73c-deea31840e58",
                                        "entry_id": "b751654c-144c-3e0f-90ed-055288d08f87",
                                        "glosses": [
                                            "A common surname originating as a patronymic."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "078e7566-2280-4b60-b534-87156a7df7e5",
                                                "sense_id": "530d3c68-0734-3430-a73c-deea31840e58",
                                                "text": "The reappearance of Dylan and Caitlin Thomas brought her the excitement again of literary gatherings and much uninhibited partying.²²³ For a woman of 41 the Thomases represented fun and an opportunity not to play second fiddle to a disapproving husband who was very clear as to what he wanted but not sensitive to her social needs."
                                            },
                                            {
                                                "example_id": "b467ed31-13ea-4446-9585-71044670a5af",
                                                "sense_id": "530d3c68-0734-3430-a73c-deea31840e58",
                                                "text": "CBS, the BBC's US news partner, said that VOA employees were notified in an email by Crystal Thomas, the USAGM human resources director."
                                            },
                                            {
                                                "example_id": "e929f512-91cb-434b-aad7-7eedb9646df8",
                                                "sense_id": "530d3c68-0734-3430-a73c-deea31840e58",
                                                "text": "Born on a US military base, the son of a US citizen father serving in the Army, Jermaine Thomas never considered he might not be American."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "088ee85a-7892-3933-8e80-89f59ff496fa",
                                        "entry_id": "b751654c-144c-3e0f-90ed-055288d08f87",
                                        "glosses": [
                                            "A number of places in the United States:",
                                            "An unincorporated community in Bureau County, Illinois."
                                        ],
