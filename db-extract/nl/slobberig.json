                ],
                "senses": [
                    {
                        "sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                        "entry_id": "2b3a3ea7-655d-3ac5-a809-acceac838e53",
                        "glosses": [
                            "van kleding: dat ze te ruim zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bcbaf38-a3ab-4b39-bcd6-9fd8b14622ec",
                                "sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                                "text": "Creatief directeur Glenn Martens ontwierp hoge, slobberig om de benen zittende versies die tot het kruis reiken, gedragen door zowel mannen als vrouwen. „Een paar Uggs aantrekken voelt alsof je je voet in een pot warme boter steekt”, zei Martens in het persbericht. „Ik dacht: waarom zou ik dat gevoel niet versterken door je volledige been erin onder te dompelen?”"
                            },
                            {
                                "example_id": "95923bd9-465b-44ed-a93a-6638ffc7d8a2",
                                "sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                                "text": "Er zijn hokjes in gebouwd waar je je kunt omkleden, maar dat vinden de meeste mensen maar gedoe. Dus stuit ik niet zelden op bejaarde mannen in slobberige onderbroeken die staan te stuntelen met hun joggingbroek."
                            },
                            {
                                "example_id": "91cbef49-e3c7-41d6-8fc0-e83f967fc0c9",
                                "sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                                "text": "Dezelfde krant en de zusterbladen hebben de afgelopen maanden geprobeerd alle breuklijnen in de gespleten familie Markle ten eigen voordele uit te buiten, maar stelt nu dat het voor Thomas niet makkelijk zal zijn om de Queen te ontmoeten, zijn slobberige t-shirt te verruilen voor een jacquet en de aandacht te trekken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65ffbfc3-f7dc-457b-afba-8f92ed8ef24c",
                        "source_entry_id": "2b3a3ea7-655d-3ac5-a809-acceac838e53",
                        "source_sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                        "target_lang_word": "slovenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slovenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9825a168-6ca2-3897-8126-5ede5fb0df36",
                                        "entry_id": "0b12633b-b4ac-3d5b-873d-fd67fcee605a",
                                        "glosses": [
                                            "Having an untidy appearance; unkempt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e9f3cc5-1450-4b5c-9c07-32beef682271",
                                                "sense_id": "9825a168-6ca2-3897-8126-5ede5fb0df36",
                                                "text": "The same marks of indolence appeared in the care of his person; for every part of his dress was generally in disorder; and, though he was well made and handsome, yet his slovenly appearance made him disgustful to every one."
                                            },
                                            {
                                                "example_id": "0109ed30-2b21-4c62-8e44-7220686abedc",
                                                "sense_id": "9825a168-6ca2-3897-8126-5ede5fb0df36",
                                                "text": "Which would you sooner employ, a boy who was plainly, yet neatly clad, or one who had a slovenly appearance, though dressed in fine clothes?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d60c24bc-3a4f-3f81-9755-7796ddf09643",
                                        "entry_id": "0b12633b-b4ac-3d5b-873d-fd67fcee605a",
                                        "glosses": [
                                            "Dirty, unwashed; disorderly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ce254a0-489d-3227-b7c6-f19bb8002001",
                                        "entry_id": "0b12633b-b4ac-3d5b-873d-fd67fcee605a",
                                        "glosses": [
                                            "Careless or negligent; sloppy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "180ad990-7a2c-4dce-8e62-d831a8d358c7",
                                                "sense_id": "2ce254a0-489d-3227-b7c6-f19bb8002001",
                                                "text": "You say my pamphlet betrays the most slovenly rashness. But where is your proof?"
                                            },
                                            {
                                                "example_id": "60a1061d-9320-4976-8572-3028a0518234",
                                                "sense_id": "2ce254a0-489d-3227-b7c6-f19bb8002001",
                                                "text": "British goods have often been despatched in such careless and slovenly fashion that they arrived half broken. The same goods supplied by Germans were packed with such admirable care that they reached their destination quite safely."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slovenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3dcc172-49c4-36e8-a83e-4a28ee552423",
                                        "entry_id": "e05522f8-a81d-3896-b456-ce645f086144",
                                        "glosses": [
                                            "In a slovenly manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ceb1850-ee3b-4e4e-b5c1-221a7c87a89f",
                        "source_entry_id": "2b3a3ea7-655d-3ac5-a809-acceac838e53",
                        "source_sense_id": "131066aa-cffd-3e56-a92d-6ebdb1f395b5",
                        "target_lang_word": "baggy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baggy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a586210e-e1d2-360f-b10d-45d1b6d8a01a",
                                        "entry_id": "f1a615e6-ffb7-31a0-b745-492fc17943c3",
                                        "glosses": [
                                            "Of clothing, very loose-fitting, so as to hang away from the body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74153a3a-c5c6-4350-bb12-85efc0104621",
                                                "sense_id": "a586210e-e1d2-360f-b10d-45d1b6d8a01a",
                                                "text": "When the YSL designer finally got to present Sunday, after the show tent pitched on a race course had been deemed unsafe, he had a surprise in store: the longest, bell-bottom pants since the start of the 1970s — and the baggiest since rapper chic."
                                            },
                                            {
                                                "example_id": "9f2f2b1f-bb1f-4576-ad35-5f417cb93695",
                                                "sense_id": "a586210e-e1d2-360f-b10d-45d1b6d8a01a",
                                                "text": "The only way to safely avoid looking like a hipster, so far as I can tell, is to dress in oversize mesh jerseys bearing the logos of sports teams. Or to wear the blandest, baggiest, beige-est clothes possible, like a middle-aged tourist."
                                            },
                                            {
                                                "example_id": "4f20f0bb-df9e-4e45-9fd6-fcd06ea6bec9",
                                                "sense_id": "a586210e-e1d2-360f-b10d-45d1b6d8a01a",
                                                "text": "He’d made some of the company’s baggiest-ever pants in response, and even baggier ones were in the works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00b84bad-6945-3a71-aab9-e8c0ab267a04",
                                        "entry_id": "f1a615e6-ffb7-31a0-b745-492fc17943c3",
                                        "glosses": [
                                            "Of or relating to a British music genre of the 1980s and 1990s, influenced by Madchester and psychedelia and associated with baggy clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d4ed55-f8de-4901-8264-6f8825e627f0",
                                                "sense_id": "00b84bad-6945-3a71-aab9-e8c0ab267a04",
                                                "text": "Pop historian Jon Savage listens to the best of the Stone Roses and their contemporaries – from Baby Ford to the Sabres of Paradise – and creates the perfect set of baggy playlists"
                                            },
                                            {
                                                "example_id": "dfaeb008-c519-4aa7-b241-0190ca80dc76",
                                                "sense_id": "00b84bad-6945-3a71-aab9-e8c0ab267a04",
                                                "text": "The Birmingham band – now a five-piece after multi-instrumentalist James Balmont joined them – have ditched the loose and baggy guitar pop of 2013’s Where the Heaven Are We? in favour of psych-pop that contorts itself into pulsing Balearic acid house and motorik rhythms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c54ff0dd-cc09-3dcd-a77b-ba12166a8af5",
                                        "entry_id": "f1a615e6-ffb7-31a0-b745-492fc17943c3",
                                        "glosses": [
                                            "Of writing, etc.: overwrought; flabby; having too much padding."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22f9f846-4064-4da9-8f8d-02249a2266fe",
                                                "sense_id": "c54ff0dd-cc09-3dcd-a77b-ba12166a8af5",
                                                "text": "a baggy book"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baggy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce320c6c-9048-3ea7-bfc6-aee925f26822",
                                        "entry_id": "7ef4cf82-ffeb-38ba-9b1a-c5d3e9e3847d",
                                        "glosses": [
                                            "A member of the 1980/90s British music and fashion movement."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb1cb669-f7f3-4ba3-958d-7cb2fe6a8427",
                                                "sense_id": "ce320c6c-9048-3ea7-bfc6-aee925f26822",
                                                "text": "I said dad you're a shabby / You run around and groove like a baggy / You're only here just out of habit"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "baggy",
