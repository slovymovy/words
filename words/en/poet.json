{
    "word_family": [
        "poetry",
        "poetic",
        "poetess",
        "poetize",
        "poetical"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4752efc3-b985-36b6-8fcd-f689a98751e8",
                    "sense_definition": "A person who writes poems.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The famous <w>poet</w> recited a beautiful verse about nature.",
                            "target_lang_translations": {
                                "ru": "Известный <w>поэт</w> прочитал красивое стихотворение о природе.",
                                "zh": "那位著名的<w>诗人</w>朗诵了一首关于大自然的美丽诗篇。"
                            }
                        },
                        {
                            "text": "She dreams of becoming a <w>poet</w> and publishing a book someday.",
                            "target_lang_translations": {
                                "ru": "Она мечтает стать <w>поэтом</w> и однажды опубликовать книгу.",
                                "zh": "她梦想着有一天能成为一名<w>诗人</w>并出版一本书。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bard"
                    ],
                    "common_phrases": [
                        "famous poet",
                        "romantic poet",
                        "modern poet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который пишет стихи",
                        "zh": "创作诗歌的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поэт",
                                "target_lang_sense_clarification": "автор стихотворных произведений"
                            },
                            {
                                "target_lang_word": "поэтесса",
                                "target_lang_sense_clarification": "женщина-поэт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诗人",
                                "target_lang_sense_clarification": "创作诗歌的作家"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efe159ff-dee8-39d0-a36c-81f65c60b7ca",
                    "sense_definition": "A person with a creative or romantic imagination.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>poet</w> at heart, always seeing the magic in ordinary days.",
                            "target_lang_translations": {
                                "ru": "В душе он <w>поэт</w>, всегда видящий волшебство в обычных днях.",
                                "zh": "他内心是一位<w>诗人</w>，总能在平凡的日子里发现奇迹。"
                            }
                        },
                        {
                            "text": "You need the soul of a <w>poet</w> to appreciate this landscape fully.",
                            "target_lang_translations": {
                                "ru": "Нужна душа <w>поэта</w>, чтобы полностью оценить этот пейзаж.",
                                "zh": "你需要拥有<w>诗人</w>般的灵魂才能充分领略这片风景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dreamer",
                        "visionary"
                    ],
                    "antonyms": [
                        "realist",
                        "pragmatist"
                    ],
                    "common_phrases": [
                        "poet at heart",
                        "true poet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек с творческим или романтическим воображением",
                        "zh": "具有创造力或浪漫想象力的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поэт",
                                "target_lang_sense_clarification": "мечтатель, романтик (переносное значение)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诗人",
                                "target_lang_sense_clarification": "指具有浪漫气质或艺术情怀的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}