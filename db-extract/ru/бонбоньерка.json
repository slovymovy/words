                                        "entry_id": "1ec2b267-c22e-312d-bdcd-a0efbb80c5d5",
                                        "glosses": [
                                            "A box of chocolates or similar confectionary"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
