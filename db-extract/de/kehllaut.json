                ],
                "senses": [
                    {
                        "sense_id": "9369c90b-6450-3c34-9f81-8ad211fd7186",
                        "entry_id": "491cd3d9-16f7-3731-af9e-ef902c1d3d99",
                        "glosses": [
                            "Sprachlaut, der im Bereich der Kehle artikuliert wird"
                        ],
                        "tags": [
                            "Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "aac27719-fd4e-4ce2-a778-112b4209288b",
                                "sense_id": "9369c90b-6450-3c34-9f81-8ad211fd7186",
                                "text": "„Abgesehen davon ist die spanische Sprache unbestreitbar eine der schönsten der Welt, klangreich, kraftvoll, majestätisch, ›ore rotundo‹ (mit gerundetem Mund) ausgesprochen und für den Wohlklang erhabenster Poesie geeignet; sie käme in Bezug auf die Musikalität der italienischen gleich, hätte sie nicht die drei Kehllaute, die ihre Anmut stören, trotz allem was die Spanier sagen mögen, die natürlich anderer Ansicht sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "780d0b1f-39f0-3d47-a49a-6dd9afc1511d",
                        "entry_id": "491cd3d9-16f7-3731-af9e-ef902c1d3d99",
                        "glosses": [
                            "Laut, der aus der Kehle hervorgestoßen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3594965-6584-4ada-9d3a-baec460fe2c5",
                                "sense_id": "780d0b1f-39f0-3d47-a49a-6dd9afc1511d",
                                "text": "„Der Kissi gab einen misstrauischen Kehllaut von sich, während Samoura unentwegt in seiner Sprache auf ihn einredete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
