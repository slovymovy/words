    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8c5f5626-6103-3740-8144-0ec8ca6ec634",
                    "sense_definition": "Apparition surnaturelle ou fantôme d'une personne décédée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surnaturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux château isolé était hanté par le <w>spectre</w> d'un chevalier disparu."
                        },
                        {
                            "text": "Dans cette histoire fantastique, plusieurs <w>spectres</w> apparaissent à minuit dans la forêt."
                        }
                    ],
                    "synonyms": [
                        "fantôme",
                        "apparition",
                        "revenant"
                    ]
                },
                {
                    "sense_id": "0c811720-ea73-3eae-832f-d36e9341544c",
                    "sense_definition": "Ensemble des composantes d'un rayonnement réparties selon leur fréquence ou longueur d'onde.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réfraction de la lumière à travers un prisme révèle le <w>spectre</w> des couleurs."
                        },
                        {
                            "text": "L'œil humain ne perçoit qu'une partie infime du <w>spectre</w> électromagnétique complet."
                        }
                    ],
                    "common_phrases": [
                        "spectre visible",
                        "spectre électromagnétique",
                        "spectre lumineux"
                    ]
                },
                {
                    "sense_id": "f5a2b165-9ff0-3bb8-a4b1-dcc415f158b7",
                    "sense_definition": "Menace redoutée ou perspective effrayante qui semble peser sur un groupe ou une situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "menace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les analystes financiers s'inquiètent du <w>spectre</w> d'une crise économique mondiale."
                        },
                        {
                            "text": "Le traité de paix a finalement éloigné le <w>spectre</w> de la guerre."
                        }
                    ],
                    "synonyms": [
                        "menace",
                        "hantise"
                    ],
                    "common_phrases": [
                        "spectre de la guerre",
                        "spectre du chômage",
                        "spectre de la crise"
                    ]
                },
                {
                    "sense_id": "bec31e04-c638-30a3-b972-0efd44cae5df",
                    "sense_definition": "Éventail continu ou série variée d'éléments, d'idées ou de possibilités.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "etendue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette formation universitaire couvre un très large <w>spectre</w> de compétences numériques."
                        },
                        {
                            "text": "L'enquête rassemble des témoignages venant de tout le <w>spectre</w> politique."
                        }
                    ],
                    "synonyms": [
                        "éventail",
                        "gamme",
                        "palette"
                    ],
                    "common_phrases": [
                        "large spectre",
                        "spectre politique"
                    ]
                },
                {
                    "sense_id": "82569bc2-1bb5-388f-bc8c-3432656d2e67",
                    "sense_definition": "Ensemble des agents pathogènes ou infectieux sensibles à un traitement médical spécifique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "medecine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a prescrit un antibiotique à large <w>spectre</w> pour soigner l'infection."
                        },
                        {
                            "text": "L'activité de cette molécule présente un <w>spectre</w> d'action particulièrement ciblé."
                        }
                    ],
                    "common_phrases": [
                        "spectre d'action",
                        "large spectre"
                    ]
                },
                {
                    "sense_id": "c69011fc-9a00-35ae-8197-c78499dac416",
                    "sense_definition": "Personne d'une pâleur ou d'une maigreur extrême qui effraie par son apparence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Affaibli par une longue maladie, le patient ressemblait désormais à un véritable <w>spectre</w>."
                        },
                        {
                            "text": "Cet homme dénutri n'était plus que l'ombre d'un <w>spectre</w> errant dans les rues."
                        }
                    ],
                    "synonyms": [
                        "squelette"
                    ]
                },
                {
                    "sense_id": "c73929c3-1ce3-3e62-8729-e89f48150ac5",
                    "sense_definition": "Souvenir obsédant ou évocation persistante de personnes disparues ou d'événements passés.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>spectres</w> des combattants tombés au front hantaient encore ses nuits d'hiver."
                        },
                        {
                            "text": "Dans cette vieille maison abandonnée survit le <w>spectre</w> d'un passé tragique."
                        }
                    ],
                    "synonyms": [
                        "souvenir",
                        "ombre"
                    ]
                },
                {
                    "sense_id": "f1e28d63-2652-3bfd-8bf9-2b12cbc1488c",
                    "sense_definition": "Création trompeuse de l'esprit, idée chimérique qui n'a aucun fondement dans le réel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce discours alarmiste ne fait que dresser des <w>spectres</w> pour effrayer les électeurs crédules."
                        },
                        {
                            "text": "Il s'épuise à combattre un <w>spectre</w> forgé de toutes pièces par son anxiété."
                        }
                    ],
                    "synonyms": [
                        "chimère",
                        "illusion"
                    ],
                    "antonyms": [
                        "réalité"
                    ]
                },
                {
                    "sense_id": "f7e132c9-9f4e-367b-b9e5-67fcfe3df794",
                    "sense_definition": "En mathématiques, ensemble des valeurs propres associées à une matrice ou à un opérateur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'étudiant en master calcule le <w>spectre</w> de cet opérateur linéaire auto-adjoint."
                        },
                        {
                            "text": "Le <w>spectre</w> d'une matrice symétrique réelle est toujours formé de nombres réels."
                        }
                    ],
                    "common_phrases": [
                        "spectre d'une matrice",
                        "spectre d'un opérateur"
                    ]
                }
            ]
        }
    ]
}