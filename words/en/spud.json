    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3cc7b1e-d748-3120-8d69-0e2afe71085a",
                    "sense_definition": "A potato.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon <w>peeling</w> <w>spuds</w> for the large family dinner.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, чистя <w>картошку</w> для большого семейного ужина."
                            }
                        },
                        {
                            "text": "He served a delicious <w>roast</w> <w>spud</w> alongside the main course.",
                            "target_lang_translations": {
                                "ru": "Он подал вкусную запеченную <w>картофелину</w> к основному блюду."
                            }
                        }
                    ],
                    "synonyms": [
                        "potato",
                        "tater"
                    ],
                    "common_phrases": [
                        "peeling spuds",
                        "roast spud",
                        "sack of spuds"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common informal term for potato"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Картофель или отдельный клубень картофеля."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "картофелина",
                                "target_lang_sense_clarification": "отдельный клубень"
                            },
                            {
                                "target_lang_word": "картошка",
                                "target_lang_sense_clarification": "разговорное название овоща"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "513d1fdf-6051-391d-8099-604ae056a0fb",
                    "sense_definition": "A hole in a sock.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He noticed a <w>giant</w> <w>spud</w> in his sock where his heel had been rubbing against the shoe.",
                            "target_lang_translations": {
                                "ru": "Он заметил огромную <w>дырку</w> в носке там, где пятка терлась об обувь."
                            }
                        },
                        {
                            "text": "She spent the evening <w>darning</w> a <w>spud</w> to make the socks wearable again.",
                            "target_lang_translations": {
                                "ru": "Она провела вечер, штопая <w>дырку</w>, чтобы носки снова можно было носить."
                            }
                        }
                    ],
                    "synonyms": [
                        "hole"
                    ],
                    "common_phrases": [
                        "giant spud",
                        "spud in a sock"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal British or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дырка в носке, обычно на пятке или пальцах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дырка",
                                "target_lang_sense_clarification": "в носке"
                            },
                            {
                                "target_lang_word": "прореха",
                                "target_lang_sense_clarification": "в одежде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "864fb2f5-0193-3a00-b0ac-e7cca63cfee1",
                    "sense_definition": "A tool, similar to a spade, used for digging out weeds or bark.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener used a <w>hand</w> <w>spud</w> to remove the deep-rooted thistles from the lawn.",
                            "target_lang_translations": {
                                "ru": "Садовник использовал ручную <w>мотыгу</w>, чтобы удалить глубоко укоренившийся чертополох с газона."
                            }
                        },
                        {
                            "text": "He spent a happy day in the garden <w>with</w> a <w>spud</w> clearing the overgrown paths.",
                            "target_lang_translations": {
                                "ru": "Он провел счастливый день в саду с <w>сапой</w>, расчищая заросшие дорожки."
                            }
                        }
                    ],
                    "synonyms": [
                        "spade",
                        "chisel"
                    ],
                    "common_phrases": [
                        "hand spud",
                        "barking spud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, похожий на узкую лопату или долото, используемый для удаления сорняков или коры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мотыга",
                                "target_lang_sense_clarification": "сельскохозяйственный инструмент"
                            },
                            {
                                "target_lang_word": "сапа",
                                "target_lang_sense_clarification": "инструмент для прополки"
                            },
                            {
                                "target_lang_word": "лопатка",
                                "target_lang_sense_clarification": "узкая садовая"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7021c2df-fb39-3a85-b162-152bad03a515",
                    "sense_definition": "Anything short and thick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "description",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was stamping his feet and waving his <w>little</w> <w>spuds</w> of fists in anger.",
                            "target_lang_translations": {
                                "ru": "Ребенок топал ногами и в гневе размахивал своими маленькими <w>кулачками-коротышками</w>."
                            }
                        },
                        {
                            "text": "He had short, thick fingers that looked like <w>spuds</w>.",
                            "target_lang_translations": {
                                "ru": "У него были короткие толстые пальцы, похожие на <w>картофелины</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spuds of fists"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо короткое и толстое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коротышка",
                                "target_lang_sense_clarification": "о предмете или пальцах"
                            },
                            {
                                "target_lang_word": "обрубок",
                                "target_lang_sense_clarification": "о чем-то коротком и толстом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bc419ea-5e1d-321c-9468-b5f8e7d97c72",
                    "sense_definition": "To begin drilling an oil well; to drill by moving the drill bit up and down.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drilling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew is ready to <w>spud</w> <w>in</w> the new well early tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Бригада готова <w>забурить</w> новую скважину завтра рано утром."
                            }
                        },
                        {
                            "text": "When a well is <w>spudded</w>, the drilling assembly must be carefully secured.",
                            "target_lang_translations": {
                                "ru": "Когда скважина <w>забуривается</w>, буровая установка должна быть тщательно закреплена."
                            }
                        }
                    ],
                    "synonyms": [
                        "drill"
                    ],
                    "common_phrases": [
                        "spud in",
                        "spud a well"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in oil industry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать бурение нефтяной скважины; бурить методом ударного бурения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забуривать",
                                "target_lang_sense_clarification": "начинать бурение скважины"
                            },
                            {
                                "target_lang_word": "начинать проходку",
                                "target_lang_sense_clarification": "в нефтедобыче"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "678c3134-9351-3049-b926-1bbf518b1bf9",
                    "sense_definition": "To dig up weeds with a <w>spud</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gardening_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the morning <w>spudding</w> <w>thistles</w> in the back pasture.",
                            "target_lang_translations": {
                                "ru": "Он провел утро, <w>выпалывая</w> чертополох на дальнем пастбище."
                            }
                        },
                        {
                            "text": "It is much easier to <w>spud</w> the weeds when the ground is soft after the rain.",
                            "target_lang_translations": {
                                "ru": "Гораздо проще <w>подрезать</w> сорняки, когда земля мягкая после дождя."
                            }
                        }
                    ],
                    "synonyms": [
                        "weed",
                        "dig"
                    ],
                    "common_phrases": [
                        "spudding thistles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выкапывать сорняки с помощью специального садового инструмента."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подрезать",
                                "target_lang_sense_clarification": "сорняки мотыгой"
                            },
                            {
                                "target_lang_word": "полоть",
                                "target_lang_sense_clarification": "с помощью инструмента"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "ac4c5630-0984-355f-9d9f-d52b5402f64f",
                    "sense_definition": "A game for three or more players involving throwing and catching a ball to eliminate players.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "game_or_sport_name",
                    "examples": [
                        {
                            "text": "The children gathered in the park to <w>play</w> <w>spud</w> during their lunch break.",
                            "target_lang_translations": {
                                "ru": "Дети собрались в парке, чтобы <w>поиграть в спад</w> во время обеденного перерыва."
                            }
                        },
                        {
                            "text": "In a <w>game</w> <w>of</w> <w>spud</w>, you have to be quick to catch the ball.",
                            "target_lang_translations": {
                                "ru": "В <w>игре в спад</w> нужно быть быстрым, чтобы поймать мяч."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play spud",
                        "game of spud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детская игра с мячом, в которой игроки стараются не быть выбитыми."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "название игры"
                            }
                        ]
                    }
                }
            ]
        }
    ]
