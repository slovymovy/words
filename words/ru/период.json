    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d644bac6-5356-3468-bf13-46ceb46517b9",
                    "sense_definition": "Промежуток времени, этап или стадия какого-либо процесса, жизни или истории.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time_interval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня сейчас сложный <w>период</w> в жизни, но я справлюсь.",
                            "target_lang_translations": {
                                "en": "I'm going through a difficult <w>period</w> in my life right now, but I'll cope.",
                                "zh": "我目前正处于人生的困难<w>时期</w>，但我会挺过去的。"
                            }
                        },
                        {
                            "text": "Этот <w>период</w> времени был очень важным для развития страны.",
                            "target_lang_translations": {
                                "en": "This <w>period</w> of time was very important for the country's development.",
                                "zh": "这一<w>时期</w>对国家的发展至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "отрезок",
                        "эпоха",
                        "этап",
                        "время"
                    ],
                    "common_phrases": [
                        "период времени",
                        "трудный период",
                        "переходный период",
                        "летний период",
                        "отчётный период"
                    ],
                    "target_lang_definitions": {
                        "en": "A length of time, stage, or phase of a process, life, or history.",
                        "zh": "一段时间、阶段或过程、生活或历史的时期。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "general time interval"
                            },
                            {
                                "target_lang_word": "time",
                                "target_lang_sense_clarification": "duration or era"
                            },
                            {
                                "target_lang_word": "phase",
                                "target_lang_sense_clarification": "stage of development"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "时期",
                                "target_lang_sense_clarification": "较长的时间段"
                            },
                            {
                                "target_lang_word": "阶段",
                                "target_lang_sense_clarification": "发展过程中的环节"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "246e3634-0006-3a1a-8e73-f237cb41298c",
                    "sense_definition": "Отрезок времени, за который заканчивается какой-либо повторяющийся процесс (цикл).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "time_interval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Земля совершает полный оборот вокруг Солнца за определённый <w>период</w>.",
                            "target_lang_translations": {
                                "en": "The Earth completes a full revolution around the Sun in a specific <w>period</w>.",
                                "zh": "地球绕太阳公转一周需要特定的<w>周期</w>。"
                            }
                        },
                        {
                            "text": "Учёные точно измерили <w>период</w> полураспада этого элемента.",
                            "target_lang_translations": {
                                "en": "Scientists accurately measured the half-life <w>period</w> of this element.",
                                "zh": "科学家精确测量了该元素的半衰<w>周期</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "цикл",
                        "фаза"
                    ],
                    "common_phrases": [
                        "период обращения",
                        "период колебаний",
                        "период полураспада"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "физика"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The length of time required for a repeating process (cycle) to complete.",
                        "zh": "重复过程（循环）完成所需的时间长度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "period",
                                "target_lang_sense_clarification": "physics/cycles"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "周期",
                                "target_lang_sense_clarification": "物理或循环过程的时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf6beed3-8ac8-38f5-90cf-95de5f0e2339",
                    "sense_definition": "Отдельная часть матча в некоторых спортивных играх (например, в хоккее).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наша команда выиграла первый <w>период</w> со счётом два ноль.",
                            "target_lang_translations": {
                                "en": "Our team won the first <w>period</w> with a score of two-nil.",
                                "zh": "我们队以二比零赢下了第一<w>节</w>。"
                            }
                        },
                        {
                            "text": "Судья объявил короткий перерыв между <w>периодами</w>.",
                            "target_lang_translations": {
                                "en": "The referee announced a short break between <w>periods</w>.",
                                "zh": "裁判宣布在各<w>节</w>之间进行短暂休息。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "первый период",
                        "третий период",
                        "конец периода"
                    ],
                    "traits": [
