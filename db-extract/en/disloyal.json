                                "target_word": "ontrouw",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "564fe8cd-518c-3079-a093-737b4562f8a6",
                                        "entry_id": "df50d175-d531-35b6-9679-c368375a83ff",
                                        "glosses": [
                                            "gedrag dat niet loyaal is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2a0562f-2798-4628-b12c-a1f913047638",
                                                "sense_id": "564fe8cd-518c-3079-a093-737b4562f8a6",
                                                "text": "Zijn ontrouw kwam hem duur te staan."
                                            },
                                            {
                                                "example_id": "ec211734-f7e0-447e-a70a-303bb8137faa",
                                                "sense_id": "564fe8cd-518c-3079-a093-737b4562f8a6",
                                                "text": "Eén ding stond namelijk onomstotelijk vast. Er had namelijk geen bewijsmateriaal kunnen ontstaan indien mevrouw Curtholmen zich niet, zoals iedereen in de rechtszaal had kunnen constateren, met hart en ziel aan haar ontrouw had gewijd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ontrouw",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "020be559-9938-39f0-b24e-fdf5e4bb03c3",
                                        "entry_id": "821cef30-1718-3d16-9bb5-0371d923b247",
                                        "glosses": [
                                            "gebrek aan loyaliteit vertonend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53a1bf6-81b2-4732-9ca6-91151d762cf3",
                                                "sense_id": "020be559-9938-39f0-b24e-fdf5e4bb03c3",
                                                "text": "De ontrouwe soldaten werden gevangengenomen en voor de krijgsraad gesleept."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ff6955d-800a-48e8-8f50-69a06dfbe74c",
                        "source_entry_id": "86f278e2-a7af-354a-8a22-aa85d012a0ac",
