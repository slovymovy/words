                ],
                "senses": [
                    {
                        "sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
                        "entry_id": "551aac76-3e14-30d6-893e-bb62554ade6d",
                        "glosses": [
                            "als Park gestaltetes Gelände"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ad25b6e-f8bb-4b2c-95b8-c7baae9b1b77",
                                "sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
                                "text": "„Die Parkanlagen und sonstigen Grünflächen wurden mit Kartoffeln und Kohl bepflanzt.“"
                            },
                            {
                                "example_id": "cfc773b1-0625-43e0-b177-ee159179eb7d",
                                "sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
                                "text": "„Jetzt bogen wir auch noch von der erleuchteten Straße ab und sausten in eine finstere Parkanlage hinein.“"
                            },
                            {
                                "example_id": "f76f8e90-0f52-4067-9476-ceaee9b06dae",
                                "sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
                                "text": "„Man findet ihn später bewußtlos in einer Parkanlage.“"
                            },
                            {
                                "example_id": "0d4bd245-ef4c-4cd4-bacc-402b51dc7df0",
                                "sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
                                "text": "„Es ist gebaut wie eine eckige Klammer, deren beide Enden dem Besucher abgewandt in die Parkanlage weisen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "293690e8-c776-4ab6-b140-29a8abbcabb4",
                        "source_entry_id": "551aac76-3e14-30d6-893e-bb62554ade6d",
                        "source_sense_id": "81b41f73-721d-37e8-95d0-e8fba3d3765c",
