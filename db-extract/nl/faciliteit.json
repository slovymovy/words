                ],
                "translations": [
                    {
                        "translation_id": "d7ae669a-198b-44ec-bbd1-bf36110410df",
                        "source_entry_id": "b34935d9-b138-301b-89db-24182d273a47",
                        "source_sense_id": "b2f283fe-47ee-3a86-a5da-ba322fb5b13f",
                        "source_sense_description": "een voorziening",
                        "target_lang_word": "Vorkehrung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorkehrung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48dda81e-80c2-3572-b09c-249f766ce316",
                                        "entry_id": "2e9c11eb-67d9-334a-b79f-f810ecfc228e",
                                        "glosses": [
                                            "Maßnahme, um etwas zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9832afd0-18d0-4ee9-a916-5d9db792ff9c",
                                                "sense_id": "48dda81e-80c2-3572-b09c-249f766ce316",
                                                "text": "Die nötigen Vorkehrungen wurden zeitnah getroffen."
                                            },
                                            {
                                                "example_id": "1a2d90ff-307e-44d2-a322-123cd711e009",
                                                "sense_id": "48dda81e-80c2-3572-b09c-249f766ce316",
                                                "text": "„Folgende Maßnahmen und Vorkehrungen traf ich, um meinen Haß gegen den Schurken zu befriedigen und mir ein ganz sicheres Alibi für den Fall zu verschaffen, daß ich ihn etwa umbrachte, wie ich es gern getan hätte.“"
                                            },
                                            {
                                                "example_id": "8ea9dadf-f89a-41a8-a49e-b7470b7ebe2e",
                                                "sense_id": "48dda81e-80c2-3572-b09c-249f766ce316",
                                                "text": "„Die Sonne hatte bereits ihre Mittagshöhe erreicht, als die Häuptlinge das Council-Wigwam verließen, um die große Versammlung im Freien zu halten, zu der nun alle Vorkehrungen getroffen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ffd6e0e-3805-4d13-94e2-20ff240cf379",
                        "source_entry_id": "b34935d9-b138-301b-89db-24182d273a47",
                        "source_sense_id": "b2f283fe-47ee-3a86-a5da-ba322fb5b13f",
                        "source_sense_description": "een voorziening",
                        "target_lang_word": "facilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e3f8b80-2782-3ed4-857e-ea48a5a02c06",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Qualité de ce qui est fait ou employé sans peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3cfbe2c-6d2b-46e6-8fd2-921e433130e0",
                                                "sense_id": "6e3f8b80-2782-3ed4-857e-ea48a5a02c06",
                                                "text": "La tendreté est la facilité avec laquelle la viande est coupée et broyée au cours de la mastication."
                                            },
                                            {
                                                "example_id": "d1064783-bf5a-42a1-98ae-2ef291e21086",
                                                "sense_id": "6e3f8b80-2782-3ed4-857e-ea48a5a02c06",
                                                "text": "Cela est de la plus grande facilité. - La facilité d’un expédient, d’un moyen. - La facilité d’une méthode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "938f721e-8735-3eb2-bc22-6d6cfa002434",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Moyen qui permet d’exécuter sans peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d0187a-1fb0-47ad-8ade-952e39f1fb3a",
                                                "sense_id": "938f721e-8735-3eb2-bc22-6d6cfa002434",
                                                "text": "Nous aurons la facilité de nous voir tous les jours. - Les désirs s’amortissent par la facilité de les satisfaire. - Vous l’obtiendrez avec facilité. - Cela peut se faire avec facilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65e82c3-9405-38f4-a997-68f9acd381f5",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            ", Commodités, délais accordés à un acheteur, à un débiteur."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "673a60e4-ce3b-4b2b-b72a-76c660e975f6",
                                                "sense_id": "e65e82c3-9405-38f4-a997-68f9acd381f5",
                                                "text": "La Tchéquie devient protectorat de Bohême-Moravie, et, quoique indépendante sous la houlette de Mgr Tizo, la Slovaquie a consenti d'importantes facilités stratégiques au Reich."
                                            },
                                            {
                                                "example_id": "29def195-070c-47bc-8390-e9f30c4afdbc",
                                                "sense_id": "e65e82c3-9405-38f4-a997-68f9acd381f5",
                                                "text": "Grâce à ces deux sources régulières de revenu, aussi minimes fussent-elles, je savais que je pourrais obtenir quelques facilités de caisse à la banque locale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "347bce38-5dfc-32c9-bdf0-43a0a9b6bb02",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Disposition naturelle ou acquise, grâce à laquelle on exécute quelque chose sans peine, sans effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28c5270b-a3bf-4905-b0f7-b7880d935c7c",
                                                "sense_id": "347bce38-5dfc-32c9-bdf0-43a0a9b6bb02",
                                                "text": "Se mouvoir avec facilité. - Marcher, courir avec facilité. - Donner de la facilité aux mouvements. - Cet enfant commence à parler avec facilité."
                                            },
                                            {
                                                "example_id": "25ac7ba9-4a30-4bfb-8647-da356d934fb3",
                                                "sense_id": "347bce38-5dfc-32c9-bdf0-43a0a9b6bb02",
                                                "text": "Cet orateur improvise avec une rare facilité. - Écrire avec facilité. - Il a une grande facilité à parler, à s’exprimer. - On n’a toujours que trop de facilité à mal faire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d0220-e13a-35cf-b7a8-42d541ae53ac",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Aptitude à concevoir, à produire, à travailler facilement."
                                        ],
                                        "tags": [
                                            "Souvent"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11a89dfb-a433-4407-b203-ded3fb240356",
                                                "sense_id": "a32d0220-e13a-35cf-b7a8-42d541ae53ac",
                                                "text": "Défiez-vous de votre facilité. - Il y a une facilité malheureuse."
                                            },
                                            {
                                                "example_id": "5270a009-5ee5-490f-9bd0-37b44441799f",
                                                "sense_id": "a32d0220-e13a-35cf-b7a8-42d541ae53ac",
                                                "text": "Cet enfant n’a aucune facilité. - Cet écrivain, ce peintre a une grande facilité, une facilité prodigieuse. - Acquérir de la facilité."
                                            },
                                            {
                                                "example_id": "8713bb50-6e56-4e0c-adb8-4fcb474fc9cc",
                                                "sense_id": "a32d0220-e13a-35cf-b7a8-42d541ae53ac",
                                                "text": "Facilité d’esprit, de conception. - Facilité d’élocution. - Facilité d’exécution, de composition, de pinceau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68189905-656a-3332-9576-13d5a2bb325c",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Manière dont on exécute une chose sans peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83bd07ed-9f08-4732-9ef3-9f1882b49c09",
                                                "sense_id": "68189905-656a-3332-9576-13d5a2bb325c",
                                                "text": "Il lui arrivait même de s'émerveiller de la facilité, de la promptitude avec laquelle il avait illuminé ces arcanes, hier encore ténébreux et rébarbatifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc209d2e-1db7-3296-8537-654f13929f62",
                                        "entry_id": "8dfce84f-ec66-3774-bca5-b4c3bec51bf5",
                                        "glosses": [
                                            "Tendance à se plier aux circonstances, à se prêter à ce que l’on attend de vous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc400943-c927-436c-8b20-5388902eee03",
                                                "sense_id": "cc209d2e-1db7-3296-8537-654f13929f62",
                                                "text": "Il me fit souvenir d’un passage des Mémoires de Richelieu. « Il vaut mieux aux affaires de l’État, un homme corrompu que celui dont la facilité est extrême, parce que le sujet corrompu ne se peut toujours laisser gagner par ses intérêts qui ne se rencontrent pas toujours, au lieu que le facile est emporté par tous ceux […] qui le pressent. » Si l’incorruptibilité de Léon Bourgeois était hors de question, sa facilité était extrême…"
                                            },
                                            {
                                                "example_id": "c14e41ca-3c60-46ac-98b5-56dc465d586e",
                                                "sense_id": "cc209d2e-1db7-3296-8537-654f13929f62",
                                                "text": "On m’apprenait également le latin, l’allemand - l’anglais n’existait pas encore à l’époque ou, du moins, était considéré par ma mère comme une facilité commerciale à l’usage des gens de peu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "facilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "edccf4e5-6b65-334a-8e85-a976cdaf31fc",
                                        "entry_id": "3e2de80c-bc40-3463-959c-43ce2d9c01f9",
                                        "glosses": [
                                            "Participe passé masculin singulier de faciliter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ecc00a1-3aef-464c-9ba3-9bed985af9e7",
                                                "sense_id": "edccf4e5-6b65-334a-8e85-a976cdaf31fc",
                                                "text": "Sa mauvaise destinée n’a cessé qu’à Berlin, où le ministre français lui a facilité son retour en France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
