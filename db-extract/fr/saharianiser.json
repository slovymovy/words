                "senses": [
                    {
                        "sense_id": "bf43ce69-767c-3471-b947-eaecf1f6e0c0",
                        "entry_id": "5428a235-ee3e-38e7-a415-e18831b16be3",
                        "glosses": [
                            "Donner un caractère saharien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7186f2cb-6112-4eea-abe9-ee9bc9ce314d",
                                "sense_id": "bf43ce69-767c-3471-b947-eaecf1f6e0c0",
                                "text": "Il avait à ce sujet conçu un projet grandiose, à l’exemple de ce qui s’est passé en Palestine pour saharianiser tous les ruchers peuplés d’abeilles telliennes et ceci à partir des ruchers d’élevage implantés au coeur même des oasis."
                            },
                            {
                                "example_id": "4a2b9eb5-3ff6-4404-bc0c-12660e520d77",
                                "sense_id": "bf43ce69-767c-3471-b947-eaecf1f6e0c0",
                                "text": "Prochainement: Le nouveau DSK est arrivé. La France saharianisée."
                            },
                            {
                                "example_id": "22d7393d-0dc9-4898-bcfc-cde1ecf57e90",
                                "sense_id": "bf43ce69-767c-3471-b947-eaecf1f6e0c0",
                                "text": "Cela commence avec le son sec et « saharianisé » d'une vieille guitare électrique Gretsch et se poursuit avec sept titres chantés en bambara, deux en français, tous de sa composition, et une étonnante, sombre et admirable reprise en anglais de « The Man I Love \" de Billie Holiday."
                            }
                        ]
                    }
