        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "5ea88668-dea3-394f-8414-526af91ae3ac",
                    "sense_definition": "Anything whatsoever; any part or amount.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Is there <w>aught</w> I can do to help you?",
                            "target_lang_translations": {
                                "pl": "Czy mogę ci w <w>czymkolwiek</w> pomóc?"
                            }
                        },
                        {
                            "text": "For <w>aught</w> I know, they might have already left for the airport.",
                            "target_lang_translations": {
                                "pl": "O ile mi wiadomo, mogli już wyjechać na lotnisko."
                            }
                        }
                    ],
                    "synonyms": [
                        "anything"
                    ],
                    "antonyms": [
                        "naught"
                    ],
                    "common_phrases": [
                        "for aught I know"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This word is rarely used in modern English and is mostly found in literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Cokolwiek; jakakolwiek część lub ilość. Słowo przestarzałe."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cokolwiek",
                                "target_lang_sense_clarification": "używane w znaczeniu 'cokolwiek'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea251f47-1113-378f-8bdc-8bca6dbcdc34",
                    "sense_definition": "The number zero.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zero",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather was born in nineteen <w>aught</w> five.",
                            "target_lang_translations": {
                                "pl": "Mój dziadek urodził się w roku dziewiętnaście <w>zero</w> pięć."
                            }
                        },
                        {
                            "text": "He wrote an <w>aught</w> on the chalkboard to represent the missing value.",
                            "target_lang_translations": {
                                "pl": "Napisał <w>zero</w> na tablicy, aby oznaczyć brakującą wartość."
                            }
                        }
                    ],
                    "synonyms": [
                        "zero",
                        "nought"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Commonly used in older contexts to refer to the digit zero."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Cyfra lub liczba zero."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "zero",
                                "target_lang_sense_clarification": "cyfra lub liczba 0"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7118824-ebc6-3d31-bd69-53d4044d09f6",
                    "sense_definition": "A very small amount or a tiny part.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His promises were not worth <w>aught</w>.",
                            "target_lang_translations": {
                                "pl": "Jego obietnice nie były warte ani <w>krztyny</w> zaufania."
                            }
                        },
                        {
                            "text": "She cared not <w>aught</w> for their opinion.",
                            "target_lang_translations": {
                                "pl": "Ani <w>odrobinę</w> nie dbała o ich zdanie."
                            }
                        }
                    ],
                    "synonyms": [
