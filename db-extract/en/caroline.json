                    {
                        "translation_id": "60c2d1dd-2e96-469e-a0fd-117af0817342",
                        "source_entry_id": "b57d6c6c-edc1-3789-977a-0179d202cb5a",
                        "source_sense_id": "84b2370e-1b74-3ff1-9713-a9ef6eb317ae",
