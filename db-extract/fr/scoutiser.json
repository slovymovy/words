                "senses": [
                    {
                        "sense_id": "c0d2f17d-e9e1-3e93-a394-93e7b91d6db2",
                        "entry_id": "0fdc8720-6d55-3a9f-92ed-5f75c004c1de",
                        "glosses": [
                            "Donner un caractère scout à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8af94a73-adbf-41a4-bfb1-2f1fbb0d6d91",
                                "sense_id": "c0d2f17d-e9e1-3e93-a394-93e7b91d6db2",
                                "text": "Sur le plan pratique, les unionistes cherchent à « scoutiser » les habitudes des sections cadettes afin de les intégrer aux programmes des troupes."
                            },
                            {
                                "example_id": "501949f5-73e7-4dbb-9f65-97a1514ab9da",
                                "sense_id": "c0d2f17d-e9e1-3e93-a394-93e7b91d6db2",
                                "text": "Il rappelait le « primat de l’Action catholique sur tout le reste » et la « nécessité d'une petite dictature des évêques en ce sens » pour éviter de « scoutiser toute la jeunesse »."
                            }
                        ]
                    }
