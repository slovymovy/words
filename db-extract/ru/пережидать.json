                "senses": [
                    {
                        "sense_id": "a714f922-5517-3022-9e09-55ef00eeec1e",
                        "entry_id": "4b7ae44e-f1c5-36e4-a00b-3c0702e6ac0f",
                        "glosses": [
                            "ожидать окончания чего-либо неприятного или неблагоприятного"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c718421-7a71-4523-ae72-666416d7a910",
                                "sense_id": "a714f922-5517-3022-9e09-55ef00eeec1e",
                                "text": "Видно, привыкла к подобным вспышкам и научилась пережидать, когда гнев шефа схлынет."
                            },
                            {
                                "example_id": "394614d6-7a91-4441-b82f-d6fbaeb2f7ad",
                                "sense_id": "a714f922-5517-3022-9e09-55ef00eeec1e",
                                "text": "Он ничего не сказал своей возлюбленной, а стал терпеливо пережидать зиму."
                            }
                        ]
                    }
                ],
