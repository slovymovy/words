                "entry_id": "01ff3e9c-9f2f-3eff-9682-90bfacf2b75d",
                "word": "russule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07f71422-8145-459e-b4dd-9a524546cef4",
                        "entry_id": "01ff3e9c-9f2f-3eff-9682-90bfacf2b75d",
