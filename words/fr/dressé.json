                    "sense_id": "8183c6b7-8820-3047-98d0-2fe60e76a75c",
                    "sense_definition": "Qui est placé verticalement ou maintenu droit ; érigé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le monument <w>dressé</w> au centre du village commémore les soldats disparus.",
                            "target_lang_translations": {
                                "en": "The monument <w>erected</w> in the centre of the village commemorates the missing soldiers.",
                                "ru": "Памятник, <w>воздвигнутый</w> в центре деревни, увековечивает память пропавших без вести солдат.",
                                "de": "Das in der Dorfmitte <w>errichtete</w> Denkmal erinnert an die vermissten Soldaten.",
                                "es": "El monumento <w>erigido</w> en el centro del pueblo conmemora a los soldados desaparecidos.",
                                "zh": "村子中央<w>竖立</w>的纪念碑纪念着失踪的士兵。"
                            }
                        },
                        {
                            "text": "Le chien avait le poil <w>dressé</w> sur le dos en entendant ce bruit.",
                            "target_lang_translations": {
                                "en": "The dog's hair stood <w>erect</w> on its back when it heard that noise.",
                                "ru": "У собаки на спине шерсть <w>стояла дыбом</w>, когда она услышала этот шум.",
                                "de": "Als der Hund dieses Geräusch hörte, war sein Fell auf dem Rücken <w>gesträubt</w>.",
                                "es": "El perro tenía el pelo <w>erizado</w> en el lomo al oír ese ruido.",
                                "zh": "听到这声音，狗背上的毛都<w>竖起</w>来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "debout",
                        "érigé"
                    ],
                    "antonyms": [
                        "couché",
                        "abaissé"
                    ],
                    "common_phrases": [
                        "poil dressé",
                        "tête dressée"
                    ],
                    "target_lang_definitions": {
