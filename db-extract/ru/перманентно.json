        "ru-extract.jsonl": [
            {
                "entry_id": "093c6534-ce4a-3604-8626-765f64a89240",
                "word": "перманентно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1b5e2578-98cf-32f8-bdd8-7b0801e66337",
                        "entry_id": "093c6534-ce4a-3604-8626-765f64a89240",
                        "glosses": [
                            "книжн. наречие к перманентный; непрерывно, постоянно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "b55106a0-4592-488f-9208-1aa4b69a506a",
                                "sense_id": "1b5e2578-98cf-32f8-bdd8-7b0801e66337",
                                "text": "Почему на фоне перманентно хороших новостей для массовой аудитории гостелеканалов растет беспокойство в элитах?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae0f83aa-5a25-445e-aec4-50bb0bbd574e",
                        "source_entry_id": "093c6534-ce4a-3604-8626-765f64a89240",
                        "source_sense_id": "1b5e2578-98cf-32f8-bdd8-7b0801e66337",
                        "target_lang_word": "permanently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "permanently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62e1883f-6105-3139-a5e6-f944dae30935",
                                        "entry_id": "07399069-df6f-345f-a44d-64922570eb3c",
                                        "glosses": [
                                            "In a permanent manner; lastingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0246e159-c699-4b84-9f0b-88f2de7e1c3d",
                                                "sense_id": "62e1883f-6105-3139-a5e6-f944dae30935",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner. He could not be induced to remain permanently at Mohair because Miss Trevor was at Asquith, but he appropriated a Hempstead cart from the Mohair stables and made the trip sometimes twice in a day."
                                            },
                                            {
                                                "example_id": "7df95ba0-65c3-4f6a-a273-c544ac0f21f7",
                                                "sense_id": "62e1883f-6105-3139-a5e6-f944dae30935",
                                                "text": "ADAS are aimed to assist the drivers, who always remain responsible for vehicle control and shall permanently monitor the environment and vehicle/system performance Informal document GRVA-18-07/Rev.2, Proposal for amendments to ECE/TRANS/WP.29/GRVA/2024/2, UN Regulation on uniform provisions concerning the approval of vehicles with regard to Driver Control Assistance Systems, UNECE, 22-26 January 2024"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f91c64d-ad03-3ff9-91de-f10ff13dd622",
                                        "entry_id": "07399069-df6f-345f-a44d-64922570eb3c",
                                        "glosses": [
                                            "Forever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f703b56-daca-4b4a-978a-90c2a423b930",
                                                "sense_id": "1f91c64d-ad03-3ff9-91de-f10ff13dd622",
                                                "text": "Necromancers were thought to have the power of restoring activity to the dead, either temporarily or permanently[.]"
                                            },
                                            {
                                                "example_id": "0ed1e702-6d61-4c1d-9181-79161cfa5227",
                                                "sense_id": "1f91c64d-ad03-3ff9-91de-f10ff13dd622",
                                                "text": "Friday’s vote has permanently redefined the kilogram and sent Le Grand K into retirement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36ba311f-fc6b-4035-8878-6954503da65e",
                        "source_entry_id": "093c6534-ce4a-3604-8626-765f64a89240",
                        "source_sense_id": "1b5e2578-98cf-32f8-bdd8-7b0801e66337",
                        "target_lang_word": "constantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "157e0abe-7a1e-3337-8402-59cfe7738528",
                                        "entry_id": "bf0c0ba7-5be2-3e7d-9346-e515c7e09f6c",
                                        "glosses": [
                                            "With steadfastness; with resolve; in loyalty, faithfully."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f61600d-029e-427b-81b1-fd66b82897c2",
                                                "sense_id": "157e0abe-7a1e-3337-8402-59cfe7738528",
                                                "text": "Agrippa and the rest of his weeping friends earnestly besought him […] not to offer violence unto himself, ‘with a settled resolution he desired again they would approve of his good intent, and not seek to dehort him from it’; and so constantly died."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fc7f35c-db27-358e-88d4-2756e611b071",
                                        "entry_id": "bf0c0ba7-5be2-3e7d-9346-e515c7e09f6c",
                                        "glosses": [
                                            "In a constant manner; occurring continuously; persistently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f949e457-356b-422b-9605-3d8f8028d702",
                                                "sense_id": "0fc7f35c-db27-358e-88d4-2756e611b071",
                                                "text": "For most people, this sacrifice is made easily and instinctively. Not so for otroverts, who are neither willing nor able to passively adopt the social scripts that others do. To the otrovert, who is constantly engaged with the choices and consequences of their individual life, social norms follow a circular logic: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "883dd714-c190-36ba-bd44-a05c7de59394",
                                        "entry_id": "bf0c0ba7-5be2-3e7d-9346-e515c7e09f6c",
                                        "glosses": [
                                            "Recurring regularly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0785ab-5e6a-47e4-b062-33db3190baa3",
                                                "sense_id": "883dd714-c190-36ba-bd44-a05c7de59394",
                                                "text": "I find that I am constantly reminding you to feed your pets."
                                            },
                                            {
                                                "example_id": "aaed4267-e1a1-436e-81aa-3073a6df79f2",
                                                "sense_id": "883dd714-c190-36ba-bd44-a05c7de59394",
                                                "text": "Japanese retail stores have strove to, and have succeeded in, fulfilling these severe demands, and in doing so, have constantly had to innovate both technologically and institutionally in order to keep up with the competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cee734c-845f-37e7-a300-30336e7d3306",
                                        "entry_id": "bf0c0ba7-5be2-3e7d-9346-e515c7e09f6c",
                                        "glosses": [
                                            "In an unchangeable or invariable manner; in every case."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
