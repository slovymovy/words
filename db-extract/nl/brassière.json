                                                "sense_id": "60416f07-8d95-372c-a4af-0eba9f9d204b",
                                                "text": "„Ein Büstenhalter nach dem anderen wurde derart zappelnd vorgeführt.“"
                                            },
                                            {
                                                "example_id": "cc7a308e-25a7-4b87-a3e7-242c01f863aa",
                                                "sense_id": "60416f07-8d95-372c-a4af-0eba9f9d204b",
                                                "text": "„Sie schlüpft mit den Armen in die Träger eines Büstenhalters und wendet ihm den Rücken zu, damit er ihn schließt.“"
                                            },
                                            {
                                                "example_id": "db43b9a9-d0ec-4a18-8211-138be5195163",
                                                "sense_id": "60416f07-8d95-372c-a4af-0eba9f9d204b",
                                                "text": "„Sie trug weiße Shorts und einen Büstenhalter, und ihr Haar war in einem Pferdeschwanz zusammengefaßt.“"
                                            }
