                                    {
                                        "sense_id": "1002a10d-901f-3caf-84cc-703d03711099",
                                        "entry_id": "0b6f8f72-b8f4-3b00-94f0-904219dcd813",
                                        "glosses": [
                                            "de richting waarin de zon ondergaat"
                                        ],
                                        "tags": [
                                            "windstreek"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5240f8b7-2ff0-4951-a6d1-1e58837fb979",
                                                "sense_id": "1002a10d-901f-3caf-84cc-703d03711099",
                                                "text": "Den Haag is de eerste stad in Nederland die zo'n verbod invoerde. Sinds 1 januari zijn er geen fossiele reclames in bushokjes of op straat meer te zien. Het gaat bijvoorbeeld om reclames voor vliegreizen en cruisevakanties. De reisbranche was het niet eens met het verbod en spande een kort geding aan, schrijft Omroep West."
                                            },
                                            {
                                                "example_id": "6610b1b5-050c-46c7-a731-8220ff1a1a3f",
                                                "sense_id": "1002a10d-901f-3caf-84cc-703d03711099",
                                                "text": "Zo was de eenvoudige monnik uit Myra, die in de vierde eeuw plotseling in de geschiedenis kwam als de weldoener van alle mensen - en er korte tijd later weer uit verdween - nu in oost en west bekend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
