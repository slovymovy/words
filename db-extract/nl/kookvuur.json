                        "glosses": [
                            "vuur dat speciaal geschikt is om eten op te bereiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c24b56c-daf4-4d82-b218-8eb363db4478",
                                "sense_id": "419fdc5e-30df-367e-bebf-fbb04366e416",
                                "text": "Hoewel ouders er misschien niet altijd bij stilstaan, zijn de allerkleinsten nu eenmaal constant op ontdekkingstocht. De eettafel, het aanrecht, het kookvuur én jouw warme kop thee: alles wat er interessant uitziet, ontkomt niet aan de grijpgrage handjes van een peuter."
                            },
                            {
                                "example_id": "af804220-1247-4d12-89cb-88b4617ffdd3",
                                "sense_id": "419fdc5e-30df-367e-bebf-fbb04366e416",
                                "text": "De keukens bevonden zich net onder het oppervlak. Een uniek afvoersysteem van lange, ondergrondse schoorstenen leidde de rook van de kookvuren naar plekken honderden meters verderop. Zo kon de keuken geheim blijven."
                            }
                        ]
                    }
