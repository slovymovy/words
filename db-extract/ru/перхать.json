                        "source_sense_id": "679e584a-a6d7-3289-b1ee-008ae15db249",
                        "target_lang_word": "se racler la gorge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se racler la gorge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4a8a5cf-d27b-3966-b0ea-1de6fcb73091",
                                        "entry_id": "45e7c631-27ad-315b-bd53-1072867523f7",
                                        "glosses": [
                                            "S’éclaircir la voix en éliminant les mucosités qui empêchent une bonne diction."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5669ece-1d46-4998-8b6f-ed625f33fdd3",
                                                "sense_id": "c4a8a5cf-d27b-3966-b0ea-1de6fcb73091",
                                                "text": "Il s’arrêta pour se racler la gorge et me redemander du tabac."
                                            },
                                            {
                                                "example_id": "29188683-cc8c-410d-9c59-3cfd00623c0d",
                                                "sense_id": "c4a8a5cf-d27b-3966-b0ea-1de6fcb73091",
                                                "text": "Nascha se racla bruyamment la gorge pour couvrir la voix du padre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a3ff676-9537-4ef5-94a0-c7177ecf18ab",
                        "source_entry_id": "fa00345c-9909-3596-a459-fc54b06e758b",
                        "source_sense_id": "679e584a-a6d7-3289-b1ee-008ae15db249",
                        "target_lang_word": "graillonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graillonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc5fb13a-bcf3-3dfb-9164-734305de757d",
                                        "entry_id": "66fdd2fa-e565-3c30-9195-bb8a95b9815c",
                                        "glosses": [
                                            "Prendre en cuisant une odeur de graillon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa820ffa-8670-43bd-9289-8d42780bebc2",
                                                "sense_id": "dc5fb13a-bcf3-3dfb-9164-734305de757d",
                                                "text": "Ce ragoût a graillonné."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                        "entry_id": "66fdd2fa-e565-3c30-9195-bb8a95b9815c",
                                        "glosses": [
                                            "Faire effort pour expectorer les mucosités qui embarrassent la gorge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e6bd0c8-c6d3-48f8-8127-ce4827cb1562",
                                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                                "text": "Comme on allait se mettre à table, M. Follenvie reparut, et de sa voix graillonnante il prononça: « L'officier prussien fait demander à Mlle Élisabeth Rousset si elle n'a pas encore changé d'avis. »"
                                            },
                                            {
                                                "example_id": "db8ddbeb-3934-4e42-9cfd-9fca64b6cd37",
                                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                                "text": "Bah, pour vous expliquer, graillonna-t-il, c’est plutôt dur."
                                            },
                                            {
                                                "example_id": "c6691cf9-18ce-474e-a0a6-70a0bc25dd4a",
                                                "sense_id": "d541343f-eadb-3d32-b8fd-40aa40cd6aec",
                                                "text": "Les filles d’auberge, à force de tousser dans les fumées, graillonnent souvent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
