                ],
                "senses": [
                    {
                        "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                        "entry_id": "f2cfb1b7-db99-3fe7-93d7-6e9da64f0c9f",
                        "glosses": [
                            "vorgetäuschte Diskussion / vorgetäuschter Streit (beispielsweise um Aufmerksamkeit zu erregen, um von einem Thema abzulenken)"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "cb9fd7a5-a04e-4777-8f6a-ebecf443c5ed",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Die Debatte um einen möglichen Austritt Griechenlands aus der Eurozone ist heftig, aber ein Scheingefecht. Letztlich will niemand einen 'Grexit'.“"
                            },
                            {
                                "example_id": "a55220a4-9dd6-4160-8b4b-37ce32d84f50",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Das Gefecht um die beste Ausrüstung ist ein Scheingefecht, das nur spärlich verdeckt, woran es wirklich fehlt: An dem Eingeständnis, dass die Bundeswehr in Afghanistan nicht so weitermachen kann wie bisher.“"
                            },
                            {
                                "example_id": "40f5ef8e-78d3-4b93-b023-e09de417677e",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Annegret Kramp-Karrenbauer, die saarländische Ministerpräsidentin, […] hat gesagt: »Wir dürfen uns da keine Scheingefechte über das Kooperationsverbot liefern. Wir müssen das Thema „Bildung“ voranbringen.«“"
                            },
                            {
                                "example_id": "95b5e146-7a4d-486b-a087-14d16c34947a",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Die meisten unabhängigen Beobachter sehen in dem Streit ein Scheingefecht, angezettelt von der Staatsanwaltschaft.“"
                            },
                            {
                                "example_id": "dd8a0b04-1a82-417e-972b-720ea6c677e8",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Der Vater sei unschuldig, er, der Sohn, habe alles gefälscht. Der Vater widerspricht: zu so etwas sei sein Sohn gar nicht fähig. Die Presse behauptet, das sei nur ein Scheingefecht, beide seien schuldig.“"
                            },
                            {
                                "example_id": "d83a459f-61b0-470e-b4c6-34cdc40ecf45",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„[…] vielleicht sind die Jugendlichen einfach schlauer geworden und haben etwas aus den vergangenen Protesten gelernt. Sie konzentrieren sich nicht mehr auf Nebenschauplätze und lassen sich nicht auf Scheingefechte ein.“"
                            },
                            {
                                "example_id": "3ffc7cf0-4532-4a9b-97e5-9483dfabb217",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Im ungünstigsten Szenario müsste die Schweiz gesperrte Gelder an gestürzte Machthaber zurückgeben – nach Jahren juristischer Scheingefechte, die einzig der Verschleppung des Verfahrens dienen.“"
                            },
                            {
                                "example_id": "b1195733-0516-4686-a912-d03778cd6e8c",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Also mehr Europa statt zurück zum nationalen Egoismus? Die Frage ist, ob dieser Zug nicht schon längst abgefahren ist - und ob in europäischen Hauptstädten wie Berlin längst nur noch Scheingefechte ausgetragen werden darüber, wie viel Fiskalpakt man denn nun zulassen will.“"
                            },
                            {
                                "example_id": "0f34619d-c5fb-4393-9fb3-f095ef0b16aa",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Die Debatte um mögliche Obergrenzen für Flüchtlinge in Deutschland ist nach Einschätzung des Rechtswissenschaftlers Daniel-Erasmus Khan lediglich ein Scheingefecht. Obergrenzen verstießen ganz einfach gegen das Grundgesetz und verletzten das hohe und zu schützende Gut des Asyls.“"
                            },
                            {
                                "example_id": "718b22d8-7d7d-4b5c-9505-d04343b737a8",
                                "sense_id": "f100734a-a6b0-3aea-b28a-5fb8ab8586e3",
                                "text": "„Beobachter sehen in der Klage von Raman Schlemmer ein letztes juristisches Scheingefecht, um die Werke seines Großvaters Oskar Schlemmer weiter unter Verschluss zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96e6e461-a88c-35fb-90fa-9904c537a52a",
                        "entry_id": "f2cfb1b7-db99-3fe7-93d7-6e9da64f0c9f",
                        "glosses": [
