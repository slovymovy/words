                                    {
                                        "sense_id": "b50b0000-5666-3d83-b00e-24a42897d4fb",
                                        "entry_id": "63129921-c01c-338d-9e07-0a40b5c7ed9c",
                                        "glosses": [
                                            "van een persoon of zaak dat die mensen kalm en minder bang maakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd32a9aa-40c8-4144-b9e5-f5073475518b",
                                                "sense_id": "b50b0000-5666-3d83-b00e-24a42897d4fb",
                                                "text": "Zijn rustgevende stem zorgde ervoor dat niemand in paniek raakte."
                                            },
                                            {
                                                "example_id": "79b591bb-dcae-4302-a929-153f4767098d",
                                                "sense_id": "b50b0000-5666-3d83-b00e-24a42897d4fb",
                                                "text": "Dit weekend zitten tienduizenden Nederlanders te turen naar hun tuin of balkon, voor de nationale tuinvogeltelling. Het is groepswetenschap, maar ook bezigheidstherapie. Vogels tellen lijkt op schaapjes tellen: rustgevend."
                                            },
                                            {
                                                "example_id": "8f5bcbdb-04d0-4cc1-94f6-4e2bf99c2411",
                                                "sense_id": "b50b0000-5666-3d83-b00e-24a42897d4fb",
                                                "text": "Veel mensen gebruiken rustgevende medicijnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e7471db-62ae-4f27-87f4-f8f29f76252f",
