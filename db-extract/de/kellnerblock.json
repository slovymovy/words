                ],
                "senses": [
                    {
                        "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                        "entry_id": "a996e93e-398b-378b-b7cc-d7a74da02e88",
                        "glosses": [
                            "Block eines Kellners, auf dem er Bestellungen der Restaurantgäste aufnimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b56b289-73b8-4950-beb8-c1c3a52c2fa6",
                                "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                                "text": "„Ein Testament ist auch auf einem Kellnerblock rechtens.“"
                            },
                            {
                                "example_id": "618e6d40-5d28-4257-969b-2532d67b3a2f",
                                "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                                "text": "„Wenn es beispielsweise die Rechnung für die Weihnachtsgans ausschließlich auf dem Bierdeckel oder Kellnerblock gibt, sollte man das nicht einfach so akzeptieren.“"
                            },
                            {
                                "example_id": "f9a21f47-1a37-475c-bc8f-a4568836a034",
                                "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                                "text": "„Auf dem Tresen im Frühstücksraum liegen Kellnerblock und Kugelschreiber, am Empfang steht ein Blumenstrauß, im Saunabereich stehen Liegen, teilweise sogar mit Handtüchern bereit und es riecht nach Kräuteraufguss.“"
                            },
                            {
                                "example_id": "b788b093-358b-4edf-a901-a4eeecd395f4",
                                "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                                "text": "„Die Brauerei schickt keine Kellnerblöcke mehr.“"
                            },
                            {
                                "example_id": "32ac69ea-a83a-4da9-8775-53c6f714a89e",
                                "sense_id": "b9a8d5ae-1bc0-3bb3-9b15-b5cbf3e6d613",
                                "text": "„Neben Kettensägen und Rucksäcken findet sich auch kurioses Diebesgut darunter, etwa Kellnerblöcke mit der Aufschrift \"Jägermeister\", die laut Polizei \"vermutlich aus einem Einbruch im Gastronomiebereich\" stammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
