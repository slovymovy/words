                "senses": [
                    {
                        "sense_id": "e1f0963b-5ecf-35b8-a62f-37baa5da0a8c",
                        "entry_id": "8e1f9062-7f68-3365-8ba4-58f7af8b9c8a",
                        "glosses": [
                            "(gitterartiges) Geflecht aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba7d09a1-61ec-4180-aa77-52d1512182ac",
                                "sense_id": "e1f0963b-5ecf-35b8-a62f-37baa5da0a8c",
                                "text": "„Grosser Beliebtheit erfreut sich dieses innovative Kunststoffgitter bei Kunden, die wirklich Qualität suchen, sowie ein System, das immer und bei jeder Temperatur leicht montierbar ist und Temperaturschwankungen ausgleicht.“"
                            },
                            {
                                "example_id": "7751cf58-e40b-4cfe-8f9c-3be81ffcdfce",
                                "sense_id": "e1f0963b-5ecf-35b8-a62f-37baa5da0a8c",
                                "text": "„Das Kunststoffgitter wird über eine Schicht Sand, Asphalt oder einer feinen Binderschicht gelegt, die über einer wasserdichten Membran auf der Brückenplattform gelegt worden ist.“"
                            },
                            {
                                "example_id": "c3a55eb0-f9b1-4a4b-a029-5afa4e6c85a6",
                                "sense_id": "e1f0963b-5ecf-35b8-a62f-37baa5da0a8c",
                                "text": "„Der seit Monaten aus Sicherheitsgründen gesperrte Steg durch den Auenwald von Gut Eichthal soll mit einem Kunststoffgitter endlich verkehrssicher gemacht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
