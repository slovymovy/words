                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transhumanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82906872-5b00-3979-b8a5-c5895cb6659c",
                                        "entry_id": "4723966e-7b7a-34fc-bf80-581608b6d88a",
                                        "glosses": [
                                            "The state of being transhuman."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4eb822d-69c8-40f0-8191-28279f82fa94",
                                                "sense_id": "82906872-5b00-3979-b8a5-c5895cb6659c",
                                                "text": "It was a way, Sean, of interrogating our very humanity—and our transhumanity; a way of enquiring what we might change into. That's the only possible true deep reason for colonization."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c9b619-9486-34a8-80b6-dcfc6278505e",
                                        "entry_id": "4723966e-7b7a-34fc-bf80-581608b6d88a",
                                        "glosses": [
                                            "Transhumans collectively."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f07ec63b-7cf1-4631-a75d-b2a823edbf07",
                                                "sense_id": "74c9b619-9486-34a8-80b6-dcfc6278505e",
                                                "text": "You don't need me to safeguard the future of Carter-Zimmerman on your behalf. Or the future of transhumanity. You can do it in person."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
