                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ee1f028-5048-39d8-89d9-82c2adf0c231",
                                        "entry_id": "0d93a55d-0141-3a8e-99e2-51b1635d0163",
                                        "glosses": [
                                            "An item that is typically old and of dubious quality or poor condition."
                                        ],
