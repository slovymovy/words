                                "sense_id": "ffefee7b-b328-35f8-b192-3820397f9778",
                                "text": "Aussi pour dire que j'espère que je ne fais pas partie des personnes à déwhitelister."
                            },
                            {
                                "example_id": "5af0720a-7282-45e9-972e-095466892213",
                                "sense_id": "ffefee7b-b328-35f8-b192-3820397f9778",
                                "text": "Alors, peux-tu me déwhitelister stp ?"
                            },
                            {
                                "example_id": "7b979561-c5e3-4886-9b58-24e46ea37196",
                                "sense_id": "ffefee7b-b328-35f8-b192-3820397f9778",
                                "text": "Si vous avez été absent depuis plus de deux mois, vous avez automatiquement été déwhitelisté du serveur."
                            }
                        ]
