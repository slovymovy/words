                    "sense_id": "18a6e634-e71f-30cc-84e5-8f34ce657eec",
                    "sense_definition": "An abbreviation for 'as hell', used to emphasize an adjective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That movie was funny <w>ash</w>.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был <w>чертовски</w> смешным.",
                                "zh": "那部电影<w>极其</w>搞笑。",
                                "es": "Esa película era <w>increíblemente</w> divertida."
                            }
                        },
                        {
                            "text": "I am tired <w>ash</w> after that long run.",
                            "target_lang_translations": {
                                "ru": "Я <w>адски</w> устал после этой длинной пробежки.",
                                "zh": "跑了那么久，我<w>极其</w>疲惫。",
