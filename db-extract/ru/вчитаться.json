                                            "Monnaie de la Turquie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "721c8d83-6771-45d0-b37c-d53ff31a669a",
