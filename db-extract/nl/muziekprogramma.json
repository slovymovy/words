                        "examples": [
                            {
                                "example_id": "7d586093-7752-4776-8ab6-b15a20c41d1f",
                                "sense_id": "0f1197f6-e23b-3d42-ab38-f2b811a44bd6",
                                "text": "Muziekshow The Voice komt ook in Afghanistan op de televisie. Mediabedrijf Moby Group in Dubai heeft de rechten gekocht van Talpa, dat The Voice heeft ontwikkeld en al in ruim vijftig landen heeft verkocht. Moby Group heeft ook al een ander muziekprogramma op de Afghaanse tv."
                            },
                            {
                                "example_id": "a248da85-5312-4732-b1a0-f5093ca80542",
                                "sense_id": "0f1197f6-e23b-3d42-ab38-f2b811a44bd6",
                                "text": "Dick Clark, een icoon van de Amerikaanse televisie, is op 82-jarige leeftijd in een ziekenhuis in Californië overleden. Clark werd vooral beroemd door zijn langlopende muziekprogramma American Bandstand, waarmee hij de rock-'n'-roll in de Amerikaanse huiskamers bracht."
                            }
                        ]
                    }
