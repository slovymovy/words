    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "85760595-bd17-3bc3-a3b5-fd16d9e03a61",
                    "sense_definition": "A deep crack, chasm, or fissure in the ground or a surface.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earthquake caused a large <w>rift</w> in the middle of the road.",
                            "target_lang_translations": {
                                "it": "Il terremoto ha causato una grande <w>spaccatura</w> nel mezzo della strada."
                            }
                        },
                        {
                            "text": "Geologists studied the deep <w>rift</w> in the Earth's surface to understand tectonic movements.",
                            "target_lang_translations": {
                                "it": "I geologi hanno studiato la profonda <w>fessura</w> nella superficie terrestre per comprendere i movimenti tettonici."
                            }
                        }
                    ],
                    "synonyms": [
                        "chasm",
                        "fissure",
                        "crevice"
                    ],
                    "common_phrases": [
                        "deep rift"
                    ],
                    "target_lang_definitions": {
                        "it": "Una profonda spaccatura, voragine o fessura nel terreno o in una superficie."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "spaccatura",
                                "target_lang_sense_clarification": "termine generale per una rottura o fessura"
