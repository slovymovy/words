{
    "word_family": [
        "frôlement",
        "frôleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "94a45e15-f7c9-3b34-b717-4cc5ad6c7cf0",
                    "sense_definition": "Toucher très légèrement en passant ou passer extrêmement près de quelque chose ou de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contact_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a eu peur quand une voiture est venue le <w>frôler</w> à vive allure."
                        },
                        {
                            "text": "Une brise légère semblait <w>frôler</w> les feuilles des arbres dans le jardin silencieux."
                        }
                    ],
                    "synonyms": [
                        "effleurer",
                        "raser"
                    ],
                    "common_phrases": [
                        "frôler les murs",
                        "frôler le sol",
                        "frôler la peau"
                    ]
                },
                {
                    "sense_id": "5ad6f02b-43b5-38c5-b4cc-f97c35c295a3",
                    "sense_definition": "Être tout près d'un état extrême, d'un danger ou d'un échec ; approcher de très près.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proximite_figuree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune alpiniste a <w>frôlé</w> la mort lors de son ascension hivernale en montagne."
                        },
                        {
                            "text": "Cette remarque maladroite a bien failli <w>frôler</w> le ridicule devant toute l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "friser",
                        "avoisiner"
                    ],
                    "common_phrases": [
                        "frôler la mort",
                        "frôler la catastrophe",
                        "frôler le drame",
                        "frôler le ridicule"
                    ]
                },
                {
                    "sense_id": "8a349d42-3ec7-3d30-a186-214468e3251f",
                    "sense_definition": "Passer à proximité immédiate d'un corps céleste sans entrer en collision avec lui.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astronomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un immense astéroïde va <w>frôler</w> la Terre sans causer le moindre dégât matériel."
                        },
                        {
                            "text": "L'engin spatial a pu <w>frôler</w> la planète rouge afin de recueillir des données précises."
                        }
                    ],
                    "common_phrases": [
                        "frôler la Terre",
                        "frôler une planète"
                    ]
                }
            ]
        }
    ]
}