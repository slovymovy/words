                                "target_senses": [
                                    {
                                        "sense_id": "cda2a266-0dc2-33d6-b786-adc681de5533",
                                        "entry_id": "70c5707f-7b42-33b4-a3cf-49aad121e777",
                                        "glosses": [
                                            "erstmals im antiken Griechenland beschriebene, sagenhafte Insel im hohen Norden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66642b4-8220-4cb4-b049-aa871cc24db9",
                                                "sense_id": "cda2a266-0dc2-33d6-b786-adc681de5533",
                                                "text": "„Ein Geologe fand ihn in Grönland unter Gletschereis, in der Miozän-Schicht. Wer weiß? Er mag einem Zauberer im Thule der Vorzeit gehört haben.“"
                                            }
                                        ],
