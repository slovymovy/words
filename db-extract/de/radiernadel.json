                ],
                "senses": [
                    {
                        "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                        "entry_id": "706c4661-6d9b-3110-a630-8f99382858c0",
                        "glosses": [
                            "spitz zulaufendes Werkzeug aus Stahl, das zur Erstellung von Gravuren und Radierungen verwendet wird"
                        ],
                        "tags": [
                            "Handwerk",
                            "Drucktechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "557abeee-fd09-4ff3-b45c-1f1af4500ca5",
                                "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                                "text": "„Diese linearen Strukturen zieht die Natur selbst, der Künstler tritt zurück, legt Radiernadel, Messer oder Pinsel beiseite.“"
                            },
                            {
                                "example_id": "66c89b13-62bf-431d-ba5b-807be73dd594",
                                "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                                "text": "„Nach einer Einführung in die Technik der Kaltnadelradierung, bei der die Zeichnung mit Hilfe einer Radiernadel aus Stahl direkt in die Druckplatte geritzt wird, können sich die Teilnehmer selbst in der Technik versuchen.“"
                            },
                            {
                                "example_id": "05175df0-0140-44af-8e4e-35641aedebcb",
                                "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                                "text": "„Eine weitere Möglichkeit ist, erst das Ei einzufärben und dann mit einer Radiernadel zu bearbeiten.“"
                            },
                            {
                                "example_id": "b44f8b5e-c29d-4f73-a2c2-ce55196f71ea",
                                "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                                "text": "„Vorgezeichnete Motive wurden mittels Radiernadeln in Rhenalon-Platten geritzt, mit Farbe bestrichen und mithilfe der Druckerpresse auf echtes Büttenpapier gedruckt.“"
                            },
                            {
                                "example_id": "9f8e5707-754e-4a5b-a533-300c404e7017",
                                "sense_id": "136eb4cb-efc5-309c-94a0-dce439c38fbc",
                                "text": "„Das disziplinierte und farbarme grafische Arbeiten mit Druckplatte und Radiernadel lag ihr jedoch nicht sonderlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
