                                                "example_id": "5e2fd887-7903-4b2c-a457-33ab2324d801",
                                                "sense_id": "7f68f689-a24d-3128-bbd1-82bf6347be95",
                                                "text": "Die Naturschutzorganisation IUCN warnt, dass 60 Prozent aller Affenarten in den nächsten 25 Jahren aussterben könnten."
                                            },
                                            {
                                                "example_id": "cd145a53-398b-47a4-a438-252fe0b09b23",
                                                "sense_id": "7f68f689-a24d-3128-bbd1-82bf6347be95",
                                                "text": "„Je wärmer die Erde wird, desto mehr Arten sterben aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
