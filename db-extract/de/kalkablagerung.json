                "senses": [
                    {
                        "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                        "entry_id": "ca5306f1-80f0-3c3c-ac40-6a5397e7bcc9",
                        "glosses": [
                            "Einlagerung von Kalksalzen in Kalzium aufnehmenden Körpergeweben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bcc6379-fc60-4f3b-bee5-b1ac07d68524",
                                "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                                "text": "Kalkablagerungen in den Arterien, die zu Herzinfarkt und Schlaganfall führen können, gelten als Zivilisationskrankheit."
                            },
                            {
                                "example_id": "fa2fa8b2-3088-437d-83ed-011ff7e0c996",
                                "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                                "text": "Kalkablagerungen führen nicht zwangsläufig zu Problemen."
                            },
                            {
                                "example_id": "5de5bb79-c447-41ef-b9de-ed84548af376",
                                "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                                "text": "Kalkablagerungen in den Gelenken können von einer Störung des Calciumstoffwechsels herrühren, aber das macht bei weitem nicht alle Fälle von Pseudogicht plausibel."
                            },
                            {
                                "example_id": "1dc8452b-b823-4675-a1c1-89c221a8127d",
                                "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                                "text": "Lebensgefährlich können Kalkablagerungen in den Schlagadern werden."
                            },
                            {
                                "example_id": "80554f68-7a73-4e91-a90c-bae825cf116e",
                                "sense_id": "031a395d-6702-34d9-80f7-6c940ac8b1e5",
                                "text": "Durch Probeexzision gewonnene mikroskopische Präparate zeigen[,] dass die Kalkablagerung wohl ausschliesslich in den Bindegewebsbündeln der Kutis der Faszien und anderer bindegewebiger Körperstellen vor sich gegangen ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                        "entry_id": "ca5306f1-80f0-3c3c-ac40-6a5397e7bcc9",
                        "glosses": [
                            "Ablagerung von porösem Kalkstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27fa19af-9e2d-4aa5-a8e6-1ff8dfdfa79e",
                                "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                                "text": "Die erste Wahl, um Kalkablagerungen zu entfernen, ist Essig."
                            },
                            {
                                "example_id": "55afc873-caa2-4ea8-9abe-a8685602875e",
                                "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                                "text": "Durch den Einbau von Dosiergeräten (Eingabegeräte von Phosphaten) wird der Kalkbestandteil auch bei Wassererwärmung stabilisiert, die Kalkablagerung wird vermieden."
                            },
                            {
                                "example_id": "8c6b12e7-2978-4af4-bcdc-ee1331d334cb",
                                "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                                "text": "Kalkablagerungen in Heizungs- oder Warmwassergeräten sind eine ärgerliche Sache."
                            },
                            {
                                "example_id": "b31421d3-3117-49a6-9c3b-322d9128fa8c",
                                "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                                "text": "Geräte mit ungeregelter Brauchwasserbereitung erreichen die eingestellte Wassertemperatur durch Kalkablagerungen nicht mehr."
                            },
                            {
                                "example_id": "165b273c-9627-4e41-b15c-3166c8917c90",
                                "sense_id": "08eece77-15d4-3ea6-99c6-6b1a056be02e",
                                "text": "Wie sich das Klima in der Arktis in den vergangenen 500.000 Jahren verändert hat, erforscht die Geologin Gina Moseley mit Hilfe von Kalkablagerungen aus Höhlen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
