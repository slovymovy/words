                        "source_sense_id": "f5153ed6-8ff5-36a6-9e28-f342aa14f29e",
                        "target_lang_word": "trivial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trivial",
