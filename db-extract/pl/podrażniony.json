                "senses": [
                    {
                        "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                        "entry_id": "2ee5099d-914b-3a27-8f64-d8fddf1f650a",
                        "glosses": [
                            "będący objawem podrażnienia"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "4b32f9c4-7114-4c79-a1d9-8cfc4cac9d88",
                                "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                                "text": "Byłem pełen zazdrości, rozczarowań, podrażnionej dumy"
                            },
                            {
                                "example_id": "c7ac3e95-0658-4955-9c78-7f0dffec1374",
                                "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                                "text": "Nie potrzebujesz przekonywać się — odparł trochę podrażnionym tonem pan Smolicki"
                            },
                            {
                                "example_id": "2a569654-4b14-4e84-91f0-d439e9af40d6",
                                "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                                "text": "Hanka zmusiła go podrażnionym głosem, aby jej wysłuchał"
                            },
                            {
                                "example_id": "88924b75-c892-4c81-83ee-574958c4a481",
                                "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                                "text": "Dobiegł go głos człowieka, który dowodził podrażnionym tonem: — …A skąd będzie pochodził Mesjasz, nie wiemy"
                            },
                            {
                                "example_id": "34d8fd2a-2931-4ddd-9900-3e10555ef4a8",
                                "sense_id": "ef573207-4cb9-351d-ac24-c255d289ffdd",
                                "text": "„Janek!” W tamtym pokoju odezwał się podrażniony bas babci, a za chwilę Janek ukazał się w drzwiach"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2ae7c815-547a-3dcc-81ec-0885c1e0050f",
                        "entry_id": "2ee5099d-914b-3a27-8f64-d8fddf1f650a",
                        "glosses": [
                            "będący rezultatem podrażnienia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b891cff0-b9bb-4aa6-9dcf-2e697ba0f640",
                                "sense_id": "2ae7c815-547a-3dcc-81ec-0885c1e0050f",
                                "text": "Absolutnie niezbędna jest pielęgnacja podrażnionej skóry od razu po zakończeniu golenia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
