                                                "sense_id": "9f27fe81-c4e2-3a5d-a92c-d3f93bc481b2",
                                                "text": "Unemployment was reported at 5.2% in May, up from 4.9% in April."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54ea8e42-b0be-3c95-a5f4-39ce9b816c69",
                                        "entry_id": "6f4fa60b-a5c9-3286-9e90-e5ccedf3dbf7",
                                        "glosses": [
                                            "A type of joblessness due to a particular economic mechanism."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5be4d4be-a6af-40aa-8baf-6a06bb9d403d",
                                                "sense_id": "54ea8e42-b0be-3c95-a5f4-39ce9b816c69",
                                                "text": "All unemployments, seasonal, frictional, cyclical, classical, whatever, mean that you're out of work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "612ac011-2298-35ca-af94-ebc252c5c40c",
                                        "entry_id": "6f4fa60b-a5c9-3286-9e90-e5ccedf3dbf7",
                                        "glosses": [
                                            "An instance or period of joblessness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "229f91d4-a67d-431f-a3e1-20a4ee911cb9",
                                                "sense_id": "612ac011-2298-35ca-af94-ebc252c5c40c",
