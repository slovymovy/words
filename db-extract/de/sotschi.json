                                "target_senses": [
                                    {
                                        "sense_id": "7074c297-649f-3db2-81ff-fb7e863432b7",
                                        "entry_id": "523ddb06-e5df-371f-89a8-79c2d744e2b8",
                                        "glosses": [
                                            "A city in Krasnodar Krai, Russia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81b487f5-5ceb-4a3e-9f84-0b6d21fef58e",
                                                "sense_id": "7074c297-649f-3db2-81ff-fb7e863432b7",
                                                "text": "According to Russian deputy prime minister Dmitrii Kozak, every ruble spent on preparations for the Sochi Olympics has been justified."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a060b8b8-05f1-4778-af39-e9143c3c8dee",
                        "source_entry_id": "7cb14381-37a3-37f3-85ea-136d22814762",
                        "source_sense_id": "adbdcdd3-8298-3f5e-b9a2-7951640a08c7",
                        "source_sense_description": "Stadt in der russischen Region Krasnodar im Föderationskreis Südrussland",
                        "target_lang_word": "Sotchi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sotchi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "36ca3222-8536-37b2-8dcd-0054923b4a9b",
                                        "entry_id": "35928608-e4a2-390d-952b-be2afed4491e",
                                        "glosses": [
                                            "Ville balnéaire du kraï de Krasnodar en Russie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "954be168-bcc1-49be-b54b-7ff172253bd1",
                                                "sense_id": "36ca3222-8536-37b2-8dcd-0054923b4a9b",
                                                "text": "J’ai hâte de quitter Sotchi, où je m’ennuie, et à Sébastopol j’espère retrouver T…, poursuivre notre délicieuse aventure."
                                            },
                                            {
                                                "example_id": "0ba659b8-737e-4585-8daa-b9eeb7b656b3",
                                                "sense_id": "36ca3222-8536-37b2-8dcd-0054923b4a9b",
                                                "text": "Si le monde entier va découvrir Sotchi à partir du 7 février, jour de l’ouverture des Jeux olympiques d’hiver, pour les Russes, cette ville de 370 000 habitants, nichée au cœur de l’Europe, est un lieu de villégiature apprécié et reconnu depuis le début du XXᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a30cfb4c-41b0-33e4-8e70-bb33f0e04661",
                                        "entry_id": "35928608-e4a2-390d-952b-be2afed4491e",
                                        "glosses": [
                                            "Affluent de la mer Noire prenant source dans les montagnes du Caucase."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2115367-d6d5-45aa-bfcd-dd97ee349e05",
                                                "sense_id": "a30cfb4c-41b0-33e4-8e70-bb33f0e04661",
                                                "text": "Le 25 mars, jour de l’Annonciation, à midi, nous avons pris sans tirer un seul coup de feu l’ancien fort Navaguine, renommé poste de Sotchi. Au rythme des tambours, le premier bataillon du régiment Tchernomorski en a fait sa caserne. Mon détachement s’est concentré autour du fort, établissant un camp à l’embouchure de la rivière Sotchi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
