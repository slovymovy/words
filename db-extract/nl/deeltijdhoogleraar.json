                        "examples": [
                            {
                                "example_id": "bcc518a9-ecd9-457f-a2c5-e0d140412d8a",
                                "sense_id": "5dcd274d-56ed-3345-8555-303e18812718",
                                "text": "De oncoloog Bernards werkt bij het Nederlandse Kanker Instituut in Amsterdam en hij is deeltijdhoogleraar in Utrecht. Hij is volgens de KNAW een van de internationale pioniers in het onderzoek naar genetische verschillen tussen tumoren."
                            },
                            {
                                "example_id": "694fb1dd-07d9-4f9d-9415-d48bee02cced",
                                "sense_id": "5dcd274d-56ed-3345-8555-303e18812718",
                                "text": "Huisarts Van der Linde twijfelt al jaren aan het medisch nut van de griepprik die de overheid gratis aan grote groepen Nederlanders beschikbaar stelt. Het RIVM is de rijksinstelling die over de griepprikken gaat. Roel Coutinho, directeur van het RIVM Centrum voor Infectieziektebestrijding, werkt als deeltijdhoogleraar samen met farmaceutische bedrijven. Van der Linde heeft hem beticht van belangenverstrengeling."
                            },
                            {
                                "example_id": "b6f92e5b-786c-4f20-81c3-827b1f5eeacc",
                                "sense_id": "5dcd274d-56ed-3345-8555-303e18812718",
                                "text": "De oud-CDA-minister Ab Klink wordt deeltijdhoogleraar 'Zorg, arbeid en politieke sturing' aan de faculteit Sociale Wetenschappen van de Vrije Universiteit in Amsterdam."
                            }
                        ]
                    }
