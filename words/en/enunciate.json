{
    "word_family": [
        "enunciation",
        "enunciator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7475152b-1d3b-3953-80ee-456797d95d21",
                    "sense_definition": "To articulate or pronounce words clearly and distinctly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "articulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must <w>enunciate</w> all the syllables clearly so the audience can understand you.",
                            "target_lang_translations": {
                                "zh": "你必须把每个音节都<w>清晰发音</w>，这样听众才能听懂。"
                            }
                        },
                        {
                            "text": "The actor practiced how to <w>enunciate</w> every word to improve his stage performance.",
                            "target_lang_translations": {
                                "zh": "为了提升舞台表现力，这位演员练习了如何<w>吐字清晰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate",
                        "pronounce"
                    ],
                    "antonyms": [
                        "mumble"
                    ],
                    "common_phrases": [
                        "enunciate clearly",
                        "enunciate words"
                    ],
                    "target_lang_definitions": {
                        "zh": "清晰地发音或吐字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "清晰发音",
                                "target_lang_sense_clarification": "指说话时发音清楚，不含糊。"
                            },
                            {
                                "target_lang_word": "吐字清晰",
                                "target_lang_sense_clarification": "指说话时每个字都说得清楚。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df55d90f-7560-3b42-b48d-f93d6ea284d3",
                    "sense_definition": "To produce speech sounds with clarity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "articulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>enunciate</w> when you speak so that everyone in the back can hear.",
                            "target_lang_translations": {
                                "zh": "请说话时<w>发音</w>清楚些，这样坐在后面的人才能听见。"
                            }
                        },
                        {
                            "text": "It is important to <w>enunciate</w> properly during a formal presentation.",
                            "target_lang_translations": {
                                "zh": "在正式演讲中，<w>发音</w>准确非常重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate"
                    ],
                    "antonyms": [
                        "mumble"
                    ],
                    "common_phrases": [
                        "enunciate properly"
                    ],
                    "target_lang_definitions": {
                        "zh": "清晰地发出语音。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "发音",
                                "target_lang_sense_clarification": "指发出语音的动作。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afc943bc-288c-35db-9c0e-1164b18f2953",
                    "sense_definition": "To state something in a definite or systematic manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor <w>enunciated</w> a new theory regarding the origins of the universe.",
                            "target_lang_translations": {
                                "zh": "教授<w>阐述</w>了一项关于宇宙起源的新理论。"
                            }
                        },
                        {
                            "text": "The committee <w>enunciated</w> a clear policy to address the growing concerns of the staff.",
                            "target_lang_translations": {
                                "zh": "委员会<w>明确提出</w>了一项清晰的政策，以解决员工日益增长的担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "articulate",
                        "formulate",
                        "state"
                    ],
                    "common_phrases": [
                        "enunciate a theory",
                        "enunciate a policy"
                    ],
                    "target_lang_definitions": {
                        "zh": "明确地阐述或系统地提出某事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "阐述",
                                "target_lang_sense_clarification": "指详细地说明理论或观点。"
                            },
                            {
                                "target_lang_word": "明确提出",
                                "target_lang_sense_clarification": "指正式地提出政策或主张。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63fc8bb1-db41-3390-a5bc-3919c8b27c6c",
                    "sense_definition": "To announce or proclaim something publicly or formally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leader <w>enunciated</w> the great doctrines of the movement to the gathered crowd.",
                            "target_lang_translations": {
                                "zh": "领导人向聚集的人群<w>宣告</w>了该运动的伟大教义。"
                            }
                        },
                        {
                            "text": "He <w>enunciated</w> his vision for the future during the annual conference.",
                            "target_lang_translations": {
                                "zh": "他在年度会议上<w>宣布</w>了他对未来的愿景。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proclaim",
                        "announce",
                        "declare"
                    ],
                    "target_lang_definitions": {
                        "zh": "公开或正式地宣布、宣告。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宣布",
                                "target_lang_sense_clarification": "指正式地向公众告知。"
                            },
                            {
                                "target_lang_word": "宣告",
                                "target_lang_sense_clarification": "指庄重地宣布。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}