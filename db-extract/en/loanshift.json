                "senses": [
                    {
                        "sense_id": "7aad6608-07f0-31eb-8514-c3a6ae1f7c72",
                        "entry_id": "9b3f3188-7f74-32b8-81d5-34824587aa66",
                        "glosses": [
                            "The situation in which a word changes or extends its meaning under the influence of another language."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f72c6fd8-22b0-4bfd-97ae-d3f9340cffa8",
                                "sense_id": "7aad6608-07f0-31eb-8514-c3a6ae1f7c72",
                                "text": "As linguists, anthropologists, and others involved in translation realize, the boundaries of exchange between languages are not impermeable to loanshift of meanings (Lehiste 1988:20)."
                            },
                            {
                                "example_id": "65e10469-4f41-423c-8aa7-ccac2305ed6b",
                                "sense_id": "7aad6608-07f0-31eb-8514-c3a6ae1f7c72",
                                "text": "The writer found 40 data that were categorized as Indonesian borrowing words of loanword type. However, the writer did not find any data which belong to loanshift."
                            },
                            {
                                "example_id": "414c4a09-2b71-4a27-b324-0f4e8130e3cb",
                                "sense_id": "7aad6608-07f0-31eb-8514-c3a6ae1f7c72",
                                "text": "Loan translation is the only borrowing process for loanshift."
                            }
                        ]
                    },
                    {
                        "sense_id": "12174778-9f20-350f-9449-a521a3cd94fd",
                        "entry_id": "9b3f3188-7f74-32b8-81d5-34824587aa66",
                        "glosses": [
                            "A word whose meaning has changed in this way."
                        ],
                        "tags": [
                            "countable",
