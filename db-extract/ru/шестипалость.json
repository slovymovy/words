                                                "sense_id": "900712bc-2b0b-3e9d-817d-fae897206494",
                                                "text": "Le Royaume de Suède."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2e3a018-329d-315e-ae5a-129188783474",
                                        "entry_id": "de84f265-ebd3-312c-8949-37e1ff5dcb64",
                                        "glosses": [
                                            "(Le + nom commun + nom propre) Attribut du nom propre suivant."
                                        ],
                                        "tags": [],
