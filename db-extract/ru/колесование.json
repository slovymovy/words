                        "source_sense_id": "8487e97a-5093-3cfe-81c9-17f0a7aa0987",
                        "target_lang_word": "Rad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86c345a4-945a-32c8-b882-21a57d29a027",
                                        "entry_id": "fb6524ce-ba51-3896-bedc-0c5e0aad85b5",
                                        "glosses": [
                                            "rundes Bauteil, das um seine Achse rotiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85f89afa-d47c-4cf0-94ed-97ed11cc755a",
                                                "sense_id": "86c345a4-945a-32c8-b882-21a57d29a027",
                                                "text": "Ein Fahrrad hat zwei Räder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c20f34a6-8f21-3f16-800e-be1881d694d3",
                                        "entry_id": "fb6524ce-ba51-3896-bedc-0c5e0aad85b5",
                                        "glosses": [
                                            "Fahrrad"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f41fdf3-0f95-4701-930a-39cb11681b66",
                                                "sense_id": "c20f34a6-8f21-3f16-800e-be1881d694d3",
                                                "text": "Ich fahre immer mit dem Rad zur Arbeit."
                                            },
                                            {
                                                "example_id": "36e42aa9-cb1e-4dcf-a0c8-0d67892c98a6",
                                                "sense_id": "c20f34a6-8f21-3f16-800e-be1881d694d3",
                                                "text": "„Fahrräder zu leihen war kein Problem, und pro Rad kostete es nur eine Krone für einen ganzen Tag.“"
                                            },
                                            {
                                                "example_id": "ab680856-0172-412c-ad5a-168785fa7071",
                                                "sense_id": "c20f34a6-8f21-3f16-800e-be1881d694d3",
                                                "text": "„Am Nachmittag hatten wir eine wunderschöne Spazierfahrt mit dem Rad unternommen, die Modolell mit seinem sportlichen Fahrstil anführte, und ich hielt mich bei der Rückfahrt zu unserer Unterkunft dicht hinter ihm.“"
                                            },
                                            {
                                                "example_id": "c1698b88-3548-47eb-9d72-400bb415e4a1",
                                                "sense_id": "c20f34a6-8f21-3f16-800e-be1881d694d3",
                                                "text": "„Am Abend haben Papa und ich dann die Räder zum Bahnhof von Traben-Trarbach gebracht und beim Bahnhofsvorsteher abgegeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cad49e66-6364-3f4c-ac5f-1c71e34f7373",
                                        "entry_id": "fb6524ce-ba51-3896-bedc-0c5e0aad85b5",
                                        "glosses": [
                                            "Hinrichtungsgerät in der Form eines Rades^([1])"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a3f9f9-f479-44bf-ad76-2800606bdaca",
                                                "sense_id": "cad49e66-6364-3f4c-ac5f-1c71e34f7373",
                                                "text": "Das Rad war eine grausame Bestrafung für Gesetzesbrecher."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e9638566-ead5-3cbf-b083-c39ab8da403f",
                                        "entry_id": "fb6524ce-ba51-3896-bedc-0c5e0aad85b5",
                                        "glosses": [
                                            "aufgestellte, fächerförmig gespreizte Schwanzfedern bei bestimmten Vögeln (zum Beispiel beim Pfau)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e451ec-192b-4b6d-9dbb-7aff324814f0",
                                                "sense_id": "e9638566-ead5-3cbf-b083-c39ab8da403f",
                                                "text": "Der Pfau schlägt ein Rad."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "050ff63c-c6f3-3f94-a622-31ca7b061ad9",
                                        "entry_id": "fb6524ce-ba51-3896-bedc-0c5e0aad85b5",
                                        "glosses": [
                                            "kurz für Radschlag, eine Übung beim Geräteturnen"
                                        ],
                                        "tags": [
                                            "Turnen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "655715c7-69c2-490e-909c-8e844691f9ff",
                                                "sense_id": "050ff63c-c6f3-3f94-a622-31ca7b061ad9",
                                                "text": "Petra übt seit Monaten das Rad auf dem Schwebebalken."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3765a3f3-2807-386c-b913-723cfb8dd16d",
                                        "entry_id": "ca249381-25bf-38dc-a8ce-a3a8bd167e43",
                                        "glosses": [
