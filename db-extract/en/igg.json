                "senses": [
                    {
                        "sense_id": "5826870d-19a2-3471-83c8-8b61aa2787b7",
                        "entry_id": "5c30898b-3e54-3e8a-abb1-b38b3ac687d6",
                        "glosses": [
                            "To ignore deliberately."
                        ],
                        "tags": [
                            "colloquial",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1282decb-5272-4aea-8659-a6b003c27bc1",
                                "sense_id": "5826870d-19a2-3471-83c8-8b61aa2787b7",
                                "text": "1953, Langston Hughes, ‘Simple Takes a Wife’, in 2002, Donna Sullivan Harper (editor), The Collected Works of Langston Hughes: The Early Simple Stories, Volume 7, page 202,\nBut not knowing my own mind, I made it hard for Mabel, keeping late hours, igging her, and playing Cherie. Then, one day while Mabel was at work, I packed my clothes and left."
                            },
                            {
                                "example_id": "6baf1992-e841-451b-bbe9-21dce053b002",
                                "sense_id": "5826870d-19a2-3471-83c8-8b61aa2787b7",
                                "text": "I mean you can know that the little yalla boys and girls or the med and dent students are “igging” you and be igged and conscious (to the degree you are conscious) of it, […]"
                            },
                            {
                                "example_id": "3ff10430-4a99-44e5-8106-44909198a9d2",
                                "sense_id": "5826870d-19a2-3471-83c8-8b61aa2787b7",
                                "text": "I was tryin' to give it back to him, but he doesn't speak to me anymore. I keep trying.. but he keeps iggin' me."
                            },
                            {
                                "example_id": "321b639c-f1cb-4afe-9703-0edabe251181",
                                "sense_id": "5826870d-19a2-3471-83c8-8b61aa2787b7",
                                "text": "Ig is obsolete. Ig always conveyed an action and an attitude. At one time, to be igged was the worst attitude someone could convey to you without directly speaking to you. It was an insult, a slight. But being igged has lost its weight."
                            }
                        ]
                    }
                ],
