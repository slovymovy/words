                        "glosses": [
                            "ruimte waarin een schilder werkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f30cb27d-c706-4a85-a745-b5d63baa8fac",
                                "sense_id": "22d7b455-ea48-31ca-9408-a804a0d1f036",
                                "text": "De Warhammerlegers, compleet met een half schildersatelier om de soldaatjes en hun wapentuig te verven."
                            },
                            {
                                "example_id": "9b9e939e-015d-4177-a30b-85fa8f5f8cb3",
                                "sense_id": "22d7b455-ea48-31ca-9408-a804a0d1f036",
                                "text": "AtelierZ bewijst elke dag hoe maatschappelijk nuttig deze voorziening is voor een kwetsbare groep mensen. Het is een werkplaats van Aveleijn, waar mensen met een verstandelijke beperking dagbesteding combineren met een gezellige sfeer. AtelierZ bestaat uit een kunstwerkplaats, een cadeau/decoatelier en een schildersatelier. Elke dag komen er gemiddeld 35 cliënten om hun creativiteit de ruimte te geven onder leiding van dertig vrijwilligers."
                            }
                        ]
                    }
