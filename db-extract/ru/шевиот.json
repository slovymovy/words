                    },
                    {
                        "translation_id": "5231a9ae-8dca-4bc5-925d-a535a33d5155",
                        "source_entry_id": "24db97f2-1a9c-3431-a03b-bc2e1c151949",
                        "source_sense_description": "ткань",
                        "target_lang_word": "cheviote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheviote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c689ace6-3be5-315a-9aa3-23e6365a1444",
                                        "entry_id": "8a329f2d-1bf3-36db-8c63-bf351c1913e6",
                                        "glosses": [
                                            "Laine d’agneau d’Écosse, de cheviot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252d6451-ed49-4a5c-aa7c-eebb58da7c54",
                                                "sense_id": "c689ace6-3be5-315a-9aa3-23e6365a1444",
                                                "text": "Nous faisons entrer dans nos étoffes de la soie, du cachemire, de l’alpaga, de la cheviote et du poil de chèvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                        "entry_id": "8a329f2d-1bf3-36db-8c63-bf351c1913e6",
                                        "glosses": [
                                            "Étoffe faite avec cette laine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba452dd4-b956-4137-b18c-a3e174a323b6",
                                                "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                                "text": "Nous citerons comme exemple, occasion unique, 2000 pièces cheviote croisée, mélange vigogne, nouveauté de la saison…"
                                            },
                                            {
                                                "example_id": "753d8069-0bb2-4dbc-b6b5-bd73fd4f00ba",
                                                "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                                "text": "Il paraissait échappé du collège, était pauvrement vêtu d’un petit veston de cheviote lui étreignant les hanches, dépassant à peine la chute des reins."
                                            },
                                            {
                                                "example_id": "06438e98-d8f8-4cbe-86c2-a07aa58604e7",
                                                "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                                "text": "Il alla vers une armoire et sortit un complet de souple cheviote sombre, de coupe parfaite, point fatigué."
                                            },
                                            {
                                                "example_id": "ca325eb0-e3fb-4bbd-a828-fc13c3c4dbc3",
                                                "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                                "text": "Tel le soldat promis aux grades les plus hauts sent, sur sa grossière tunique, germer les étoiles de son commandement futur, il percevait d’avance la caresse des cheviotes fines, des robes de chambre soyeuses et des toiles légères."
                                            },
                                            {
                                                "example_id": "16adda80-0903-4dd4-92a6-d07ea4fce26e",
                                                "sense_id": "556ab1a4-e714-3664-a083-1a1aec44cff7",
                                                "text": "Elle rit, malicieuse, se tord en couleuvre et froisse sa peau délicate à la cheviote du veston, aux durs boutons de corozo…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
