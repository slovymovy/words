                        "examples": [
                            {
                                "example_id": "d7981f41-a8c3-47a0-af62-ab9c38c16695",
                                "sense_id": "89fb81bd-0a40-3060-93af-0bcc7a470b8e",
                                "text": "„Die Stones sollten in Australien und Neuseeland insgesamt sechs Konzerte ihrer Welttournee geben.“"
                            },
                            {
                                "example_id": "941635ab-96e7-42cc-af1f-7056efdc5eeb",
                                "sense_id": "89fb81bd-0a40-3060-93af-0bcc7a470b8e",
                                "text": "„Asarenka jammert auf hohem Niveau, als Multimillionärin hat sie beste Voraussetzungen, die Kinderbetreuung für ein Berufs- und Familienleben auf Welttournee zu organisieren.“"
                            },
                            {
                                "example_id": "6fbea0d6-da6d-4dbb-8dc7-7953e212edc1",
                                "sense_id": "89fb81bd-0a40-3060-93af-0bcc7a470b8e",
                                "text": "„1959 wurde [Ernst Haeusserman] Burgdirektor, in seine Ära fiel die Welttournee des Burgtheaters 1968.“"
                            }
                        ],
