                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d528234-60fe-4956-bdbc-c7099dd0a7da",
                                "sense_id": "5f45e797-8f63-395d-830a-9ab2c07b57de",
                                "text": "Les dix premiers bioéléments par ordre d’importance décroissante sont : le carbone, l’hydrogène, l’oxygène, l’azote, le soufre, le phosphore, le potassium, le calcium, le fer et le magnésium."
                            },
                            {
                                "example_id": "6bafd83c-f64a-4c14-9e7d-ace3fa867163",
                                "sense_id": "5f45e797-8f63-395d-830a-9ab2c07b57de",
                                "text": "Dans le sol, lieu des interactions entre la géosphère et la biosphère, les bioéléments sont particulièrement concernés."
                            }
                        ]
                    }
