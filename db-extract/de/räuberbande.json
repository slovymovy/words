                ],
                "senses": [
                    {
                        "sense_id": "e1ea33e4-5a9e-33f2-864c-ca70562ff1e4",
                        "entry_id": "06e13c3e-ddaf-3789-821c-367fa3dff23e",
                        "glosses": [
                            "kriminelle Gruppe von Personen, die gemeinsam auf Raub aus sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704b31e2-a246-4bfe-9778-3dc6989cc500",
                                "sense_id": "e1ea33e4-5a9e-33f2-864c-ca70562ff1e4",
                                "text": "„Schon im elften Jahrhundert gab es überall in Deutschland riesige Räuberbanden, denen die Reichspolizei nicht gewachsen war.“"
                            },
                            {
                                "example_id": "60157800-309b-4176-b1cd-628fed45a57b",
                                "sense_id": "e1ea33e4-5a9e-33f2-864c-ca70562ff1e4",
                                "text": "„Da gibt es auch Räuberbanden, Falschmünzerbanden, Bettlerbanden, Schlösser mit unterirdischen Kellern und Mörderherbergen.“"
                            },
                            {
                                "example_id": "b738c602-b49f-44cc-9716-f93a5653149a",
                                "sense_id": "e1ea33e4-5a9e-33f2-864c-ca70562ff1e4",
                                "text": "„Die Kompanie hauste wie eine Räuberbande: Sie beschlagnahmte in großem Stil das Vieh der Afrikaner und verdrängte diese nach und nach vom fruchtbarsten Land.“"
                            },
                            {
                                "example_id": "81dc0793-3b5d-46fe-9a97-c29f9a653f7d",
                                "sense_id": "e1ea33e4-5a9e-33f2-864c-ca70562ff1e4",
                                "text": "„Er hatte unterm Direktorium dem Hauptmann einer Räuberbande, David de La Bazoque, gehört, der gefangengenommen und sogleich getötet worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
