                                                "sense_id": "f0ddf72b-ea0c-37ad-82a6-2d7686f6b8e7",
                                                "text": "De snaar trilde totdat de harpist deze met zijn hand afdempte."
                                            },
                                            {
                                                "example_id": "6fc1b87e-2e9a-44a9-9556-0da817e718c2",
                                                "sense_id": "f0ddf72b-ea0c-37ad-82a6-2d7686f6b8e7",
                                                "text": "Ik stond te trillen op mijn benen."
                                            },
                                            {
                                                "example_id": "e4e1535c-27eb-4b91-9b3c-092c7fcf865e",
                                                "sense_id": "f0ddf72b-ea0c-37ad-82a6-2d7686f6b8e7",
                                                "text": "Zijn armen en benen beginnen te trillen van de inspanning en van, vermoedelijk, de angst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac6f22a4-591f-45b8-a811-00eaacb178a2",
                        "source_entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
