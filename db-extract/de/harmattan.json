                "senses": [
                    {
                        "sense_id": "42ae67d7-f244-33d5-bede-3bceb98242d7",
                        "entry_id": "181186e5-6d01-39c0-9d6f-e27b1b863ffb",
                        "glosses": [
                            "trockener Wind, der als Nordostpassat von der Sahara zur westafrikanischen Küste weht"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "a564e7d8-8b76-4c59-ba57-d2e13862cf2c",
                                "sense_id": "42ae67d7-f244-33d5-bede-3bceb98242d7",
                                "text": "„Aber der Harmattan, der Wind, der Enugu von November bis August mit seiner Anwesenheit beehrte, machte ihm einen Strich durch die Rechnung.“"
                            },
                            {
                                "example_id": "b73a964a-d5dd-405e-ab26-b3b6e8633448",
                                "sense_id": "42ae67d7-f244-33d5-bede-3bceb98242d7",
                                "text": "„Ich habe keine Ahnung, wie man Geschichten erzählt, sagt er, ich würde nur drauflosreden, wie der Harmattan, der einfach nur weht und Staub aufwirbelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
