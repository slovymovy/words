                        "examples": [
                            {
                                "example_id": "89517f7c-257b-427a-89cb-746e27e0ce16",
                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                "text": "„Ich will Bubatz statt Babys. Mir geht es nicht darum, meine Verantwortung aus der Kleinfamilie in die Wirtschaft zu verlagern, sondern sie abzugeben, zugunsten eines spaßigen Lifestyles, gefüttert mit dem Drive […]“"
                            },
                            {
                                "example_id": "d955037d-93bb-4aa1-aa55-3859ccc3f444",
                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                "text": "„Wäre bestimmt ein gutes Zeichen, wenn man außer legales Bubatz nächstes Jahr nichts einführen muss.“"
                            },
                            {
                                "example_id": "2bcdeec6-d015-4e93-b910-baf846aeafb9",
                                "sense_id": "8ec9a428-6d89-38ee-9e26-3bebef50fb26",
                                "text": "Schicke mir mal den Bubatz."
                            }
                        ],
