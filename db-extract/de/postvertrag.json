                "senses": [
                    {
                        "sense_id": "4cd2e78a-9c88-3ada-a044-c4b8931d1499",
                        "entry_id": "50a1764a-75c0-39f9-8301-62df737c84ba",
                        "glosses": [
                            "rechtlich bindende Vereinbarung hinsichtlich des Postverkehrs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "023bb497-30eb-47ba-ac9b-ea05b52814b4",
                                "sense_id": "4cd2e78a-9c88-3ada-a044-c4b8931d1499",
                                "text": "„Mit den ehemaligen Gegnern im Deutschen Krieg von 1866, Bayern, Württemberg und Österreich, wurden ebenso wie mit Luxemburg Postverträge geschlossen, sodass Sendungen zum jeweils gültigen Inlandsporto befördert werden konnten.“"
                            },
                            {
                                "example_id": "19544f79-0446-42df-8856-06348cb88d1e",
                                "sense_id": "4cd2e78a-9c88-3ada-a044-c4b8931d1499",
                                "text": "„Sie wurden mit dem am 14. Dezember 1801 zwischen Frankreich und Thurn und Taxis abgeschlossenen Postvertrag vereinbart und können auf Briefen ab September 1802 vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
