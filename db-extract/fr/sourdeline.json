                "senses": [
                    {
                        "sense_id": "70e18831-887c-3848-afac-ed5512d018f6",
                        "entry_id": "21886cbf-fbea-3d2b-80bb-01f8f4b0f4a3",
                        "glosses": [
                            "Sorte de musette d’origine italienne, munie d’un soufflet et de quatre chalumeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c3553ff-e66f-443e-904d-94964825485d",
                                "sense_id": "70e18831-887c-3848-afac-ed5512d018f6",
                                "text": "On a attribué l’invention de la sourdeline à Jean-Baptiste Riva, à dom Julio & à Vincenze."
                            },
                            {
                                "example_id": "13b1f474-83fb-4350-845a-94a71ceab118",
                                "sense_id": "70e18831-887c-3848-afac-ed5512d018f6",
                                "text": "… puis il tira de son sac une de ces petites cornemuses à bourdon court et historié, que l’on appelait alors sourdelines, et qui étaient employées dans la musique de chambre."
                            },
                            {
                                "example_id": "ad4ea4a7-2797-4a9c-82fc-5361f8f2397f",
                                "sense_id": "70e18831-887c-3848-afac-ed5512d018f6",
                                "text": "La sourdeline (sordellina) fut une cornemuse savante, gonflée avec un soufflet, mise au point à la fin du XVIe siècle en Italie et jouée principalement au XVIIe siècle."
                            }
                        ]
                    }
                ],
