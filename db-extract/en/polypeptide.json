                ],
                "senses": [
                    {
                        "sense_id": "415e36ea-cc07-34a0-b1b1-e3b55a2b1358",
                        "entry_id": "da3b945a-eaeb-3079-888e-cb143e4055fb",
                        "glosses": [
                            "Any polymer of (same or different) amino acids joined via peptide bonds."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b4ba569d-fe4b-3fd3-99c0-616907645832",
                        "entry_id": "da3b945a-eaeb-3079-888e-cb143e4055fb",
                        "glosses": [
                            "Any such polymer that is not folded into a secondary structure of a protein."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c1ae096a-6f7c-3367-a9b1-63e5d2f9fe5f",
                        "entry_id": "da3b945a-eaeb-3079-888e-cb143e4055fb",
                        "glosses": [
                            "A small protein containing up to 100 amino acids; see also oligopeptide."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6661486f-ec7f-4628-8997-6b56652443af",
                        "source_entry_id": "da3b945a-eaeb-3079-888e-cb143e4055fb",
                        "source_sense_description": "organic chemistry: any polymer amino acids joined via peptide bonds",
                        "target_lang_word": "polypeptide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polypeptide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                        "entry_id": "70be622a-1337-3881-91fb-65aed6513d07",
                                        "glosses": [
                                            "Polymère linéaire composé d’un grand nombre (10 à 30) d’acides aminés liés par des liaisons peptidiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ec87f4c-fe2c-4aca-8ab6-c30dcf24be32",
                                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                                "text": "Cette séquence constitue la carte d’identité d’un polypeptide."
                                            },
                                            {
                                                "example_id": "3d4a3fbc-9ecd-4199-8852-ec10a3d72b79",
                                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                                "text": "Les protéines sont formées par un ou plusieurs polypeptides."
                                            },
                                            {
                                                "example_id": "44d4df8a-75d0-4e6d-9430-ce05717897a2",
                                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                                "text": "Les FGF constituent une famille de sept polypeptides (FGF1 à FGF7) mitogènes pour les fibroblastes, sauf FGF 7."
                                            },
                                            {
                                                "example_id": "4174642e-fd08-40f2-930d-a7eb1b7af167",
                                                "sense_id": "06da89cf-399e-3ed9-9daf-182efe2e4104",
                                                "text": "Certains antibiotiques sont des polypeptides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "051b4230-c002-4f3e-8515-631ad3b5c61d",
