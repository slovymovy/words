                    {
                        "sense_id": "51d6affd-01b1-3e57-832a-1520fdcb9bd5",
                        "entry_id": "44a8e8c3-83bf-3b87-914e-c19237ac34b6",
                        "glosses": [
                            "de omtrek, het silhouet van een voorwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18eca7fc-8592-47b2-85db-f3eccf492286",
                                "sense_id": "51d6affd-01b1-3e57-832a-1520fdcb9bd5",
                                "text": "Het veelgehoorde cliché dat auto’s steeds meer op elkaar gaan lijken, is de laatste jaren zeker van toepassing in de Golf-klasse. Of je nou het silhouet neemt van een Alfa Romeo Giulietta of de buitenlijnen van een Renault Mégane of Opel Astra, alle autofabrikanten lijken voor hun compacte middenklassers over hetzelfde sjabloon te beschikken."
                            }
                        ]
                    },
                    {
                        "sense_id": "399ec29c-b023-3726-a5c5-318fab5a93ce",
                        "entry_id": "44a8e8c3-83bf-3b87-914e-c19237ac34b6",
                        "glosses": [
                            "telefoonlijn die het gebouw verlaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5701b250-8b7d-4ef4-917d-de877165fd70",
                                "sense_id": "399ec29c-b023-3726-a5c5-318fab5a93ce",
                                "text": "Na lang zeuren werd toegezegd dat op 16 september een monteur langs zou komen. Die kwam, maar vertrok onverrichter zake omdat er geen buitenlijn aanwezig was."
                            }
                        ]
                    },
                    {
                        "sense_id": "68ec9575-7414-3e9e-a07e-56de1d60eeca",
                        "entry_id": "44a8e8c3-83bf-3b87-914e-c19237ac34b6",
                        "glosses": [
                            "de buitenste grens van een speelveld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1187273-715c-488c-8308-cc778b91eafc",
                                "sense_id": "68ec9575-7414-3e9e-a07e-56de1d60eeca",
                                "text": "Situaties waarbij de bal over de buitenlijn wordt geschoten worden opgeëist door beide partijen. Zelfs een blinde kan zien wie de bal het laatst heeft geraakt, maar nee iedereen steekt zijn hand op. Mij, Mij, Mij. Het lijken de meeuwen uit Nemo wel."
                            }
                        ]
                    },
                    {
                        "sense_id": "989a2163-c436-34a6-827e-b5a3987e5012",
                        "entry_id": "44a8e8c3-83bf-3b87-914e-c19237ac34b6",
                        "glosses": [
                            "collectie die speciaal gemaakt is voor gebruik buitenshuis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95fb1ad-8773-4918-8a67-b7c1a9ea01cc",
                                "sense_id": "989a2163-c436-34a6-827e-b5a3987e5012",
                                "text": "Van romantische loveseats en klassieke hardhouten banken tot zomers gekleurde hippe loungestoeltjes en bergen fijne kussens en accessoires: de hoofdstad kreeg gisteren het allereerste voorproefje van de lente die het Zweedse Woonwarenhuis met zijn nieuwe buitenlijn voor ogen heeft."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b32bae1-03ff-387e-9e97-b7a66f0b13c0",
                        "entry_id": "44a8e8c3-83bf-3b87-914e-c19237ac34b6",
                        "glosses": [
                            "buslijn buiten de stand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e00ae371-cd40-4715-8080-b8fd7a79a53b",
                                "sense_id": "8b32bae1-03ff-387e-9e97-b7a66f0b13c0",
                                "text": "Martien Laponder laat zijn versnelling nog eens gieren. Zat buitenlijnen zijn al geschrapt, vindt ook hij."
                            }
                        ]
                    }
