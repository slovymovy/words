                "senses": [
                    {
                        "sense_id": "5629c816-34a5-3787-9323-448302d19867",
                        "entry_id": "7c459299-3e1f-32fc-a88b-99a85fe66f03",
                        "glosses": [
                            "Teig aus Mehl, Wasser, etwas Salz und Hefe als Triebmittel"
                        ],
                        "tags": [
                            "Austrian German",
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "b1511433-5d1a-4566-821d-bc7931ee06e8",
                                "sense_id": "5629c816-34a5-3787-9323-448302d19867",
                                "text": "„Bereitwillig zeichnet Enzo Diagramme auf die Servietten, um zu illustrieren, wann der Germteig seinen Höhe(!)punkt überschreitet.“"
                            },
                            {
                                "example_id": "67da44b1-7b7d-4385-bd4c-aa064ea78399",
                                "sense_id": "5629c816-34a5-3787-9323-448302d19867",
                                "text": "„Wie ein roter Faden ziehen sich folgende Rezept-Grundlagen durch die Europaregion Donau-Moldau und damit auch durch die neue Kochbroschüre 2013: Erdäpfel(teig), Germteig, Fischgerichte, Mohn, Waldpilze, Waldbeeren, Kirschen/Weichseln, Äpfel, robuste Gartengemüse (zum Beispiel Kraut oder Sellerie) beziehungsweise auch Bier als würzige Koch-Zutat.“"
                            },
                            {
                                "example_id": "599112cb-c55a-4ddb-93c5-56a0990861b5",
                                "sense_id": "5629c816-34a5-3787-9323-448302d19867",
                                "text": "„Das Rezept wird mit einem Germteig zubereitet und gelingt bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
