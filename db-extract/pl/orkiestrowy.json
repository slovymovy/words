                "senses": [
                    {
                        "sense_id": "3b4c8019-c1d3-37ff-a7ea-d1c097fc4d4a",
                        "entry_id": "47f8a13f-4252-375d-bc8b-6f784de6ed34",
                        "glosses": [
                            "związany z orkiestrą, wchodzący w jej skład; przeznaczony na orkiestrę"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f26bfa-cb99-48dd-8ce0-e191d4eeca44",
                                "sense_id": "3b4c8019-c1d3-37ff-a7ea-d1c097fc4d4a",
                                "text": "Prócz dzieł z fortepianem jako solistą Chopin nie napisał żadnego utworu orkiestrowego."
                            },
                            {
                                "example_id": "45d8a39f-c9b3-4482-9b72-9c632ac308f4",
                                "sense_id": "3b4c8019-c1d3-37ff-a7ea-d1c097fc4d4a",
                                "text": "Kanał orkiestrowy Teatru Operowego w Bayreuth mieści się w większej części pod sceną przykryty nią jak dachem, dlatego widzowie praktycznie nie widzą orkiestry."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66628362-fa9c-4170-ae00-7603891359b4",
                        "source_entry_id": "47f8a13f-4252-375d-bc8b-6f784de6ed34",
                        "source_sense_id": "3b4c8019-c1d3-37ff-a7ea-d1c097fc4d4a",
                        "target_lang_word": "orchestral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orchestral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "59c53092-1757-3c31-9fc0-e8a4c2730e7e",
                                        "entry_id": "5164de4c-7a6c-3635-8bd3-eb97918707c9",
                                        "glosses": [
                                            "Relating to an orchestra or to music played by an orchestra."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "272c644b-a0a3-4c7e-86c0-26629b7cafa2",
                                                "sense_id": "59c53092-1757-3c31-9fc0-e8a4c2730e7e",
                                                "text": "orchestral music/piece/sound"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orchestral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77376044-706c-3f2e-bd75-5fe1229471b4",
                                        "entry_id": "aa4abf56-1e27-3c08-9ecd-0ebd16823f17",
                                        "glosses": [
                                            "An orchestral performance."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b671c4b-1841-43d0-9139-a2daf921f7ce",
                                                "sense_id": "77376044-706c-3f2e-bd75-5fe1229471b4",
                                                "text": "The ABC would have top-billing for the orchestral concerts and Williamsons for the recitals; we would go for a three-guinea top for the orchestrals, at that time a record; the ABC would do the front of house and the banking; [...]"
                                            },
                                            {
                                                "example_id": "5988fe31-fa80-4c07-8afb-bf3d3f475dba",
                                                "sense_id": "77376044-706c-3f2e-bd75-5fe1229471b4",
                                                "text": "I also enjoy, still using music as an analogy, when Nature segues from quieter contemplative pieces featuring fog and overcast and rain to the full orchestrals of storms: booming tympani of thunder, cymbal crashes of lightning, full-brass of wind ..."
                                            },
                                            {
                                                "example_id": "ab69644d-7100-4640-96e8-81a08387dda7",
                                                "sense_id": "77376044-706c-3f2e-bd75-5fe1229471b4",
                                                "text": "Classical composers like Alexander Reinagle, Rayner Taylor, and Susannah Haswell Rowson made their names in the 18th century, while the 19th century was given over to English opera, religious orchestrals, and gospel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
