                "senses": [
                    {
                        "sense_id": "985865d3-d2b0-3cfc-9c3e-e32ad75f3ec2",
                        "entry_id": "5c2c3a5d-0845-3f44-9c8b-d18409e3a1e8",
                        "glosses": [
                            "Donner un caractère métamathématique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e11a3d59-a020-4116-85ba-4dc2943b7ff6",
                                "sense_id": "985865d3-d2b0-3cfc-9c3e-e32ad75f3ec2",
                                "text": "Tandis que Hilbert maintenait une stricte division entre problèmes et méthodes mathématiques d’une part, problèmes et méthodes métamathématiques de l’autre, que formaliser fût métamathématiser ne prêtait à conséquence que pour les logiciens."
                            },
                            {
                                "example_id": "f6209f7d-7ab9-44b8-bc88-0d0ac9d3db7d",
                                "sense_id": "985865d3-d2b0-3cfc-9c3e-e32ad75f3ec2",
                                "text": "Nous pourrions prendre d’abord l’exemple de la mathématique et de son impuissance à se « métamathématiser » ou à se théoriser elle-même."
                            }
                        ]
                    }
                ],
