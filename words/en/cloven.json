    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "032df14e-9161-31f1-b6e2-fbaf82732590",
                    "sense_definition": "Split or divided into two parts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "split",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The animal left <w>cloven</w> hoof prints in the soft mud near the river.",
                            "target_lang_translations": {
                                "pl": "Zwierzę zostawiło <w>rozszczepione</w> ślady kopyt w miękkim błocie przy rzece."
                            }
                        },
                        {
                            "text": "The snake flicked its <w>cloven</w> tongue as it sensed movement in the grass.",
                            "target_lang_translations": {
                                "pl": "Wąż wysunął swój <w>rozwidlony</w> język, wyczuwając ruch w trawie."
                            }
                        }
                    ],
                    "synonyms": [
                        "split",
                        "divided",
                        "forked"
                    ],
                    "antonyms": [
                        "joined",
                        "united"
                    ],
                    "common_phrases": [
                        "cloven hoof"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozdzielony lub podzielony na dwie części."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozszczepiony",
                                "target_lang_sense_clarification": "odnoszące się do czegoś, co zostało podzielone na dwie części"
                            },
                            {
                                "target_lang_word": "rozwidlony",
                                "target_lang_sense_clarification": "odnoszące się do kształtu, który rozdziela się na dwa końce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe2efeeb-16b3-3180-adbb-1025c251f8fb",
                    "sense_definition": "Past participle of <w>cleave</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy axe had <w>cloven</w> the log into two equal pieces.",
                            "target_lang_translations": {
                                "pl": "Ciężki topór <w>rozłupał</w> kłodę na dwie równe części."
                            }
                        },
                        {
                            "text": "The ship had <w>cloven</w> the waves as it sailed through the stormy sea.",
                            "target_lang_translations": {
                                "pl": "Statek <w>rozciął</w> fale, płynąc przez wzburzone morze."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Imiesłów bierny czasownika 'cleave' (rozłupywać, rozcinać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozłupany",
                                "target_lang_sense_clarification": "wynik działania rozłupania czegoś twardego"
                            },
                            {
                                "target_lang_word": "rozcięty",
                                "target_lang_sense_clarification": "wynik działania rozcięcia czegoś"
                            }
                        ]
                    }
                }
            ]
        }
