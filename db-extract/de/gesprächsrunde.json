                "senses": [
                    {
                        "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                        "entry_id": "e31ddcc0-96cf-365d-b45e-9d9163e40bf6",
                        "glosses": [
                            "Zusammenkunft mehrerer Personen, die etwas diskutieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a358c49a-ee54-4557-8639-521d3d59bf09",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "Ich langweile mich tödlich in diesen Gesprächsrunden."
                            },
                            {
                                "example_id": "6cb8a2f1-c00b-457d-9341-9f568776b4e4",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "Bei der Gesprächsrunde […] war auch der NPD-Politiker Sascha Roßmüller anwesend."
                            },
                            {
                                "example_id": "27b5387c-bd5b-4bc9-abcc-6364f99a9ec8",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "Von einem Scheitern der Gespräche wollte man von pakistanischer Seite nicht sprechen, sondern hofft auf die nächste Gesprächsrunde, die in Delhi stattfinden wird."
                            },
                            {
                                "example_id": "75662191-4298-4988-9256-903541ca3408",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "EU-Verhandlungsführer Michel Barnier wird über den Auftakt der ersten Gesprächsrunde informieren […]"
                            },
                            {
                                "example_id": "e0953e85-7108-40e9-b656-f24f1e629e87",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "Prominente und unbekannte Menschen nehmen im Nachtcafé [einer TV-Sendung] gleichberechtigt an der Gesprächsrunde teil und tauschen ihre Standpunkte zum besprochenen Thema aus."
                            },
                            {
                                "example_id": "76e03ab4-6de2-4bd1-9bea-d767922de990",
                                "sense_id": "d236f414-321f-3822-a90b-02ba71527fd0",
                                "text": "Der Russland-Beauftragte der Bundesregierung Gernot Erler schlug am Dienstag (29.04.2014) vor, eine erneute Genfer Gesprächsrunde mit Russland zu starten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
