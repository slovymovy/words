                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1742803e-e0b8-4d45-93a4-35212f00e463",
                                                "sense_id": "25938521-04ea-34c9-807d-faf58cc43120",
                                                "text": "Es war noch ein Betrag von vierundzwanzig Euro offen."
                                            },
                                            {
                                                "example_id": "3788f7eb-04ba-47c5-bcf3-c4595dfdf8c8",
                                                "sense_id": "25938521-04ea-34c9-807d-faf58cc43120",
                                                "text": "„Und rings um den Thron standen vierundzwanzig Throne und auf den Thronen saßen vierundzwanzig Älteste in weißen Gewändern und mit goldenen Kränzen auf dem Haupt.“"
                                            },
                                            {
                                                "example_id": "083f977c-edfc-46c4-8e48-b9c218853028",
                                                "sense_id": "25938521-04ea-34c9-807d-faf58cc43120",
                                                "text": "„Welche Kraft treibt denn nun aber die Uhr, sei es vierundzwanzig Stunden lang oder vierzehn Tage lang?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5af0e67-a77f-36ae-9af1-03515ec632f4",
                                        "entry_id": "b167ae66-7cbd-351d-a8e5-9f2080da2e45",
                                        "glosses": [
                                            "vierundzwanzig Jahre (alt)"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb293ee-7037-4461-941d-03ce068fbdc5",
                                                "sense_id": "a5af0e67-a77f-36ae-9af1-03515ec632f4",
                                                "text": "Mit vierundzwanzig war er bereits Firmenchef."
                                            },
                                            {
                                                "example_id": "29e82f98-1b58-4818-890e-83906d889d9f",
                                                "sense_id": "a5af0e67-a77f-36ae-9af1-03515ec632f4",
                                                "text": "„Ich war vierundzwanzig und im Grunde ein kleines Mädchen wie sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
