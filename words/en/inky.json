    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "05e08696-2618-3dff-8f1b-b0ec4cd91eab",
                    "sense_definition": "Of the colour of ink, especially black ink; extremely dark.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "darkness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers got lost in the forest under an <w>inky</w> black sky.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы заблудились в лесу под <w>чернильно-черным</w> небом."
                            }
                        },
                        {
                            "text": "She stared into the <w>inky</w> darkness of the deep ocean water.",
                            "target_lang_translations": {
                                "ru": "Она всматривалась в <w>непроглядную</w> тьму глубоких океанских вод."
                            }
                        }
                    ],
                    "synonyms": [
                        "dark",
                        "black",
                        "murky"
                    ],
                    "antonyms": [
                        "bright",
                        "clear"
                    ],
                    "common_phrases": [
                        "inky darkness",
                        "inky black sky"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цвета чернил, особенно черных; чрезвычайно темный, непроглядно-черный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернильный",
                                "target_lang_sense_clarification": "о цвете, темноте"
                            },
                            {
                                "target_lang_word": "чернильно-черный",
                                "target_lang_sense_clarification": "очень темный"
                            },
                            {
                                "target_lang_word": "непроглядный",
                                "target_lang_sense_clarification": "о темноте, небе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0047564-b3d1-3e0c-8d8b-21e67460133f",
                    "sense_definition": "Spattered or stained with ink.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stained",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy tried to hide his <w>inky</w> fingers behind his back.",
                            "target_lang_translations": {
                                "ru": "Школьник пытался спрятать за спину свои <w>испачканные чернилами</w> пальцы."
                            }
                        },
                        {
                            "text": "She wiped her <w>inky</w> hands on a piece of scrap paper.",
                            "target_lang_translations": {
                                "ru": "Она вытерла свои <w>чернильные</w> руки о клочок бумаги."
                            }
                        }
                    ],
                    "common_phrases": [
                        "inky fingers",
                        "inky hands"
                    ],
                    "target_lang_definitions": {
