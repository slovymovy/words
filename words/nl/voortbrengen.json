                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "produceren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn harde werk zal uiteindelijk een prachtig resultaat <w>voortbrengen</w>.",
                            "target_lang_translations": {
