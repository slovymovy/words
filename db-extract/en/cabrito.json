                        "examples": [
                            {
                                "example_id": "4d75a276-d911-4d05-a0a2-02ac73c20850",
                                "sense_id": "337dbda6-0078-34eb-9ab9-fbf45d476e87",
                                "text": "Mutton rivaled beef in prominence until this century, and cabrito, or kid, remains a major food in Nuevo León."
                            },
                            {
                                "example_id": "689e8f34-4fe3-4cf3-9b78-c6194031c2cb",
                                "sense_id": "337dbda6-0078-34eb-9ab9-fbf45d476e87",
                                "text": "Mr. Dean O. Smith, who is the game warden in the Dripping Springs area, barbecues the cabrito for us, and what a treat that is! Cabrito is a very young Spanish goat between one and a half and two years old."
                            },
                            {
                                "example_id": "ae6c0033-9f62-4341-97f3-4ab9a4803142",
                                "sense_id": "337dbda6-0078-34eb-9ab9-fbf45d476e87",
                                "text": "Consuela and Sullivan had been cooking all night so there was plenty of beef and cabrito."
                            }
                        ]
