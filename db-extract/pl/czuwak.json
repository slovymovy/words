                                "target_senses": [
                                    {
                                        "sense_id": "b1c98e14-6597-3492-9e7b-93e354f01443",
                                        "entry_id": "5ce26059-832f-3ec5-9585-48c3987e323c",
                                        "glosses": [
                                            "A switch that ensures a fail-safe condition by automatically triggering an action (for instance, to stop a machine or vehicle) if a specified input from the operator is not made or is altered."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79f469cf-fbd1-492c-8487-8b8c01b65856",
                                                "sense_id": "b1c98e14-6597-3492-9e7b-93e354f01443",
                                                "text": "Holonyms: device, machine"
                                            },
                                            {
                                                "example_id": "9c2cc24b-8a67-4afc-b787-2f47d79024ce",
                                                "sense_id": "b1c98e14-6597-3492-9e7b-93e354f01443",
                                                "text": "This seat is equipped with a dead man's switch. As the theory goes, \"if the driver stops sitting, the machine is quitting.\""
                                            },
                                            {
                                                "example_id": "d711dcd5-4859-473a-9e7a-050c0151cc59",
                                                "sense_id": "b1c98e14-6597-3492-9e7b-93e354f01443",
                                                "text": "P.S. What about using a disc collection with a specific weight as a dead man's switch? Or making up a new format out of rare, esoteric, or even thaumaturgical materials, and using the anomaly to duplicate them? Or..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
