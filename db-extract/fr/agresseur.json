                                "target_senses": [
                                    {
                                        "sense_id": "477c415a-6ff3-32c4-83cf-8aeaa05c15f5",
                                        "entry_id": "cbfe487f-809d-3da7-9a97-1100ec2e0450",
                                        "glosses": [
                                            "неол. тот, кто склонен к абьюзу; человек, который осознанно или неосознанно использует приёмы насилия (психологического, физического, финансового и др.) над личностью другого человека"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ca6f38-e9bf-43e7-ad0a-0929fe31cdb6",
                                                "sense_id": "477c415a-6ff3-32c4-83cf-8aeaa05c15f5",
                                                "text": "И вот, определив якобы врага и первоисточник всех бед и проблем, на абьюзера радостно списывают все страдашки, переживашки и прочие жизненные неприятности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
