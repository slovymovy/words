                    }
                ],
                "senses": [
                    {
                        "sense_id": "80ca96cb-fe85-3fa3-a6a7-2aa32815fe44",
                        "entry_id": "a63065fb-874f-3335-aa39-7be3906b290d",
                        "glosses": [
                            "An opinion formed before obtaining adequate evidence, especially as the result of bias or prejudice."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "750c9848-36a8-4d4e-b3b5-a6f4d964a11f",
                                "sense_id": "80ca96cb-fe85-3fa3-a6a7-2aa32815fe44",
                                "text": "With many of the more general preconceptions of socialist thought the connection of their more practical proposals is by no means at once obvious, and in consequence many men who believe themselves to be determined opponents of that system of thought become in fact effective spreaders of its ideas."
                            },
                            {
                                "example_id": "7b53dfdb-c91f-46e1-9807-f1cea09126fe",
                                "sense_id": "80ca96cb-fe85-3fa3-a6a7-2aa32815fe44",
                                "text": "He told RAIL: \"We had no preconceptions, but you would assume a newer train to have better air quality than an older one. We found that was not necessarily the case."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5c87786-0348-3ea6-9216-2e1bbe968e8c",
                        "entry_id": "a63065fb-874f-3335-aa39-7be3906b290d",
                        "glosses": [
                            "A prejudice that prevents rational consideration of an issue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "144e6f5f-e1a0-4927-813b-6cd43eb4883e",
                        "source_entry_id": "a63065fb-874f-3335-aa39-7be3906b290d",
