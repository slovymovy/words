                    },
                    {
                        "form_id": "ffd76ab6-5060-4286-a0e2-de722e994332",
                        "entry_id": "77bf624c-517c-396a-a30d-daecd8aa3b1c",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind blutbesudelt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "033c6559-f157-3f0b-bb13-a0e0a0e7ae76",
                        "entry_id": "77bf624c-517c-396a-a30d-daecd8aa3b1c",
                        "glosses": [
                            "durch Blut verdreckt, verunreinigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "747f7c9e-4e81-4c6a-a0e2-1e300a98312e",
                                "sense_id": "033c6559-f157-3f0b-bb13-a0e0a0e7ae76",
                                "text": "„Alle schrien auf, als plötzlich eine riesige Ratte aus dem blutbesudelten Bettzeug auftauchte, über den Boden davonlief und in einem neuen Loch in der Nähe verschwand.“"
                            },
                            {
                                "example_id": "c98452d2-d662-4f5a-8a0f-b390c2d01d54",
                                "sense_id": "033c6559-f157-3f0b-bb13-a0e0a0e7ae76",
                                "text": "„Plomb stemmte sich ruckartig vom Diwan hoch, stolperte ein paar Schritte nach vorn und rieb die blutbesudelte Handfläche an der Vorderseite seines Hemdes, als wolle er die Visionen fortwischen, die er erblickt hatte.“"
                            },
                            {
                                "example_id": "524e34a7-adc7-443d-af99-2f4a444c4b31",
                                "sense_id": "033c6559-f157-3f0b-bb13-a0e0a0e7ae76",
                                "text": "„Sie sahen wie Metzger aus: blutbesudelt.“"
                            },
                            {
                                "example_id": "8c04661c-5934-4815-9870-61a98aea9b1a",
                                "sense_id": "033c6559-f157-3f0b-bb13-a0e0a0e7ae76",
                                "text": "„Dann drang der blutbesudelte Löffel in das andere Auge, das noch schneller heraussprang.“"
                            },
                            {
