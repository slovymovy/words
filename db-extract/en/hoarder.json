                                        "entry_id": "c9d615fd-90b3-3bc5-ae84-94494ce1bb22",
                                        "glosses": [
                                            "eine Person, die zwanghaft nicht mehr benötigte Gegenstände sammelt und dadurch in ihrem Lebensbereich eine enorme Unordnung schafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e5892de-d4f7-4abb-b42a-a7c6c919aee7",
                                                "sense_id": "5c58da51-716f-36e4-bcde-75a3535b9f35",
                                                "text": "Messies haben schwerwiegende Probleme, die eigene Wohnung in Ordnung zu halten."
                                            },
                                            {
                                                "example_id": "d09561cb-d306-4ceb-99dc-d2237d6f9d6f",
                                                "sense_id": "5c58da51-716f-36e4-bcde-75a3535b9f35",
                                                "text": "„In der RTL 2-Sendung „Das Messie-Team - Start in ein neues Leben“ räumen der Entrümpelungsprofi Dennis Karl und die Messie-Therapeutin Sabina Hankel-Hirtz das Leben von Messies auf. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
