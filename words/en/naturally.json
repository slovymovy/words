                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Naturally</w>, I was very happy to hear the good news.",
                            "target_lang_translations": {
                                "ru": "<w>Естественно</w>, я был очень рад услышать хорошие новости.",
                                "zh": "<w>当然</w>，听到这个好消息我非常高兴。",
                                "nl": "<w>Natuurlijk</w> was ik erg blij om het goede nieuws te horen.",
                                "pl": "<w>Oczywiście</w>, bardzo się ucieszyłem, słysząc te dobre wieści.",
                                "de": "<w>Natürlich</w> habe ich mich sehr gefreut, die guten Nachrichten zu hören.",
                                "fr": "<w>Naturellement</w>, j'étais très heureux d'apprendre cette bonne nouvelle.",
                                "it": "<w>Naturalmente</w>, sono stato molto felice di sentire la buona notizia.",
                                "cs": "<w>Samozřejmě</w>, že jsem měl velkou radost, když jsem slyšel tu dobrou zprávu.",
                                "tr": "<w>Doğal olarak</w>, iyi haberleri duyduğuma çok sevindim.",
                                "es": "<w>Naturalmente</w>, me alegré mucho al escuchar las buenas noticias."
                            }
                        },
                        {
                            "text": "She <w>naturally</w> wanted to see her family again after so long.",
                            "target_lang_translations": {
                                "ru": "Она, <w>естественно</w>, хотела снова увидеть свою семью после столь долгой разлуки.",
                                "zh": "分别这么久，她<w>当然</w>想再见到家人。",
                                "nl": "Ze wilde <w>natuurlijk</w> haar familie weer zien na zo'n lange tijd.",
                                "pl": "Po tak długim czasie <w>naturalnie</w> chciała znów zobaczyć swoją rodzinę.",
                                "de": "Sie wollte ihre Familie nach so langer Zeit <w>natürlich</w> wiedersehen.",
                                "fr": "Elle voulait <w>naturellement</w> revoir sa famille après si longtemps.",
                                "it": "Lei <w>naturalmente</w> voleva rivedere la sua famiglia dopo così tanto tempo.",
                                "cs": "Po tak dlouhé době chtěla <w>přirozeně</w> znovu vidět svou rodinu.",
                                "tr": "O kadar zamandan sonra ailesini tekrar görmeyi <w>doğal olarak</w> istiyordu.",
                                "es": "Ella, <w>por supuesto</w>, quería volver a ver a su familia después de tanto tiempo."
                            }
                        }
