{
    "word_family": [
        "revoilà",
        "voici"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aebb7180-9273-39b1-8aa2-dc02e0480b27",
                    "sense_definition": "Sert à montrer, présenter ou désigner quelqu'un ou quelque chose qui arrive ou se trouve à portée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "presentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voilà</w> votre café et l'addition, monsieur."
                        },
                        {
                            "text": "Le train arrive enfin en gare, le <w>voilà</w> !"
                        }
                    ],
                    "synonyms": [
                        "voici"
                    ],
                    "common_phrases": [
                        "le voilà",
                        "en voilà",
                        "me voilà"
                    ]
                },
                {
                    "sense_id": "cf3f292b-2254-32ea-9236-db4f83b6608f",
                    "sense_definition": "Sert à faire référence à ce qui vient d'être dit ou expliqué, ou à conclure une déclaration.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voilà</w> tout ce que nous savons sur cette affaire."
                        },
                        {
                            "text": "C'est une bonne proposition et <w>voilà</w> pourquoi nous l'acceptons."
                        }
                    ],
                    "antonyms": [
                        "voici"
                    ],
                    "common_phrases": [
                        "voilà pourquoi",
                        "voilà tout",
                        "et voilà"
                    ]
                },
                {
                    "sense_id": "baab7c48-d95f-317e-adfc-ee64b9b97ef4",
                    "sense_definition": "Exprime l'achèvement d'une action ou constate un état de fait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "constat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le travail est terminé, <w>voilà</w> qui est fait !"
                        },
                        {
                            "text": "Après des heures d'attente, nous <w>voilà</w> enfin arrivés."
                        }
                    ],
                    "common_phrases": [
                        "voilà qui est fait",
                        "nous voilà"
                    ]
                },
                {
                    "sense_id": "7130e03d-4a72-3a3a-94e1-6dc74b1c1c77",
                    "sense_definition": "Marque le caractère soudain, inattendu ou surprenant d'un événement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soudainete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant notre promenade en forêt, <w>voilà</w> qu'une pluie torrentielle a commencé à tomber."
                        },
                        {
                            "text": "Alors que tout semblait calme, <w>voilà</w> que le téléphone se met à sonner."
                        }
                    ],
                    "common_phrases": [
                        "voilà que"
                    ]
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "eaf04dcd-f1c4-3870-9764-b5d46c359dbb",
                    "sense_definition": "Indique une durée écoulée depuis un moment du passé jusqu'au présent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Voilà</w> deux semaines que nous n'avons pas de ses nouvelles."
                        },
                        {
                            "text": "Il est parti vivre à l'étranger, <w>voilà</w> trois ans de cela."
                        }
                    ],
                    "synonyms": [
                        "il y a"
                    ],
                    "common_phrases": [
                        "voilà des années",
                        "voilà bien longtemps"
                    ]
                }
            ]
        }
    ]
}