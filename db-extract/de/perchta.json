                "senses": [
                    {
                        "sense_id": "b7845b6c-3fd8-3cf3-9ead-721d0c10597b",
                        "entry_id": "57218b49-c5ca-39a4-9347-4dcb1184c673",
                        "glosses": [
                            "Sagengestalt, die Faulheit bestraft und Fleiß und Hilfsbereitschaft belohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f38dbbf3-fe5b-4977-b180-ece83f154979",
                                "sense_id": "b7845b6c-3fd8-3cf3-9ead-721d0c10597b",
                                "text": "„Nachdem nun die Percht oder Perchta als eine der Hekate oder der Diana durchaus gleichzusetzende Figur in Verdacht steht, gilt es zu prüfen, ob dies anhand weiterer Merkmale zu verifizieren ist.“"
                            },
                            {
                                "example_id": "651a4a48-6b67-4dd7-bef5-e3f5f305b29d",
                                "sense_id": "b7845b6c-3fd8-3cf3-9ead-721d0c10597b",
                                "text": "„Was ist eigentlich der Unterschied zwischen Krampus und Perchte? Ursprünglich gab es eine klare Trennung zwischen den beiden, optisch wie auch im Handeln. Perchten sind die Gesellen der Sagengestalt Frau Perchta, die aus der germanischen und slawischen Mythologie stammt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
