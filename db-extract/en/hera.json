                                    {
                                        "sense_id": "e4c2dfb1-d1e8-358f-88ac-fd394a1b49ed",
                                        "entry_id": "4d44f2c5-bda5-3a5b-939f-dcd9b7b64ebc",
                                        "glosses": [
                                            "Déesse du mariage et de la fécondité, sœur et épouse de Zeus."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e58da774-611c-4bf0-aad9-76e647edd70a",
                                                "sense_id": "e4c2dfb1-d1e8-358f-88ac-fd394a1b49ed",
                                                "text": "Un ballet de nymphes qui folâtrent, butinent, marivaudent, en une chorégraphie champêtre qui me fait penser aux fêtes antiques dont me parlait mon professeur au collège, où les hétaïres et les muses dansaient à la gloire de la déesse Héra, de Zeus ou de Dionysos, quelque part dans la ville de Pyrrha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d78d8044-4fa7-433e-9cb9-4018a882e781",
                        "source_entry_id": "4e083cf6-0daa-3960-9822-187833afba3a",
                        "source_sense_id": "29c62718-866f-3bdf-8179-f0dddd1dbc15",
                        "source_sense_description": "queen of the gods, wife of Zeus",
                        "target_lang_word": "Hera",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hera",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b6d8655-afbd-3130-9ef3-cbc5e9d5873c",
                                        "entry_id": "7d3354fc-8fc5-30aa-9057-3564c89432a2",
                                        "glosses": [
                                            "höchste der olympischen Götter, Schwester und Gattin des Zeus"
                                        ],
                                        "tags": [
                                            "antike",
                                            "griechische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05559286-1ff5-40f7-aff6-626d62ec5891",
                                                "sense_id": "5b6d8655-afbd-3130-9ef3-cbc5e9d5873c",
                                                "text": "„Es folgt die Geschichte des Kronos, der mit Rhea Hestia, Demeter, Hera, Hades, Poseidon und Zeus zu Kindern hat.“"
                                            },
                                            {
                                                "example_id": "a90b0d0e-12b5-4028-9fd0-9d9a81340d83",
                                                "sense_id": "5b6d8655-afbd-3130-9ef3-cbc5e9d5873c",
                                                "text": "„Eine Frucht der Empörung Heras gegen Zeus war Hephaistos selbst, ein Sohn, den sie nach Hesiod in Zorn und Wetteifer mit Zeus ohne ihn, aus sich selbst erzeugt und geboren hat, allerdings einen hinkenden und häßlichen, den sie nach einem Mythologem selber von sich geschleudert hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a71dd6f-005b-468f-a852-f653c9bcc3f4",
