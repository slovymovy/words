    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27918db2-295a-39f5-be84-984fe4a777a2",
                    "sense_definition": "Iets ernstig beschadigen of toetakelen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beschadigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto was zwaar <w>gehavend</w> na het ongeluk op de snelweg.",
                            "target_lang_translations": {
                                "fr": "La voiture était lourdement <w>endommagée</w> après l'accident sur l'autoroute."
                            }
                        },
                        {
                            "text": "Het schip kwam <w>gehavend</w> uit de zware storm op zee.",
                            "target_lang_translations": {
                                "fr": "Le navire est sorti <w>abîmé</w> de la violente tempête en mer."
                            }
                        }
                    ],
                    "synonyms": [
                        "beschadigen",
                        "toetakelen"
                    ],
                    "common_phrases": [
                        "zwaar gehavend"
                    ],
                    "target_lang_definitions": {
                        "fr": "Endommager ou abîmer gravement quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "endommager",
                                "target_lang_sense_clarification": "terme général pour causer des dommages"
                            },
                            {
                                "target_lang_word": "abîmer",
                                "target_lang_sense_clarification": "rendre moins bon ou détériorer"
                            },
                            {
                                "target_lang_word": "maltraiter",
                                "target_lang_sense_clarification": "dans le sens de laisser des traces physiques visibles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b10de53-b87e-349b-8e46-386c09caed3e",
                    "sense_definition": "Een haven binnenvaren.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "varen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het vrachtschip zal morgenochtend de haven <w>havenen</w>.",
                            "target_lang_translations": {
                                "fr": "Le cargo va <w>entrer au port</w> demain matin."
                            }
                        },
                        {
                            "text": "Na een lange reis konden de zeelieden eindelijk <w>havenen</w>.",
                            "target_lang_translations": {
                                "fr": "Après un long voyage, les marins ont enfin pu <w>accoster</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanmeren",
                        "binnenlopen"
                    ],
                    "antonyms": [
                        "uitvaren"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Dit werkwoord wordt in deze betekenis nauwelijks nog gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Entrer dans un port avec un navire."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "entrer au port",
                                "target_lang_sense_clarification": "action de naviguer vers l'intérieur d'un port"
                            },
                            {
                                "target_lang_word": "accoster",
                                "target_lang_sense_clarification": "s'approcher d'un quai pour s'y arrêter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}