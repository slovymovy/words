                    {
                        "sense_id": "f09b85f0-5348-33b7-9e1f-4c9ed3ec344f",
                        "entry_id": "4749f5f3-1076-3ec8-961c-ab5738c626b1",
                        "glosses": [
                            "Personne qui se prétend archéologue, mais n’en possède pas les compétences et propose des théories fantaisistes."
                        ],
                        "tags": [
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "4d9ef36b-1486-4d64-a7d6-ac527c6792b7",
                                "sense_id": "f09b85f0-5348-33b7-9e1f-4c9ed3ec344f",
                                "text": "Comme les fameuses « pyramides vertes », dans la petite ville de Visoko, en Bosnie-Herzégovine, censées avoir des pouvoirs anti-Covid-19, selon l’homme d’affaires et pseudo-archéologue, Semir Osmanagic."
                            },
                            {
                                "example_id": "20579793-6cfc-4a27-8624-87e62c29d180",
                                "sense_id": "f09b85f0-5348-33b7-9e1f-4c9ed3ec344f",
                                "text": "Quelle trame idéologique anime les pseudo-archéologues ou les promoteurs de cette archéologie romantique que vous dénoncez ?"
                            },
                            {
                                "example_id": "36ab1107-8eec-457b-a8fa-c9926e10edac",
                                "sense_id": "f09b85f0-5348-33b7-9e1f-4c9ed3ec344f",
                                "text": "L’inventaire regroupe des données factuelles et d'autres présumées, voir inventées par les pseudo–archéologues."
                            }
                        ]
                    }
                ],
