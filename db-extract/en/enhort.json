                ],
                "senses": [
                    {
                        "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                        "entry_id": "781a65ed-2369-3391-86b4-04ef3b2a1aae",
                        "glosses": [
                            "To encourage, to insist upon."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "45157191-f596-4792-b101-ad2d7b632ef0",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "I have nothing more to add at present, but once more to enhort You, not to mind the barkings of Your envious contrymen."
                            },
                            {
                                "example_id": "6fb362ab-3d33-495e-83de-e05167359600",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "which enhorts and commands them to invoke impartially the criminal laws within the bounds of full enforcement."
                            },
                            {
                                "example_id": "b1471218-0aa8-44ca-9c97-a26859c4c630",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "They enhorted them to make trial of the Gospel since they would find their account in so doing."
                            },
                            {
                                "example_id": "9505b009-9e5e-4983-932a-5392f443b0f1",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "But they were set apart from the congregation, and Paul is pictured as devoting his last visit not to enhorting the whole church but to caucusing with its leadership."
                            },
                            {
                                "example_id": "3fb91edf-9976-41e0-9f02-958426b40f97",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "His followers are not members of a sect or cult, but people of all walks of life, cultural backgrounds and religions, for Baba enhorts us to seek the underlying unity and divinity in ourselves, in others and in our lives."
                            },
                            {
                                "example_id": "53d0e9fd-96a6-4132-8dc1-0d64cf88fd31",
                                "sense_id": "aacb8912-40d3-3731-b60f-97f6a4dec549",
                                "text": "It is of such great effect and virtue, moreover, Saint John in his Apocalypse enhorts us to buy braised gold in order to be rich."
                            }
                        ]
                    }
                ],
