                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "80eb89b1-0fff-3422-a510-20bb4a59b130",
                        "entry_id": "57607f81-c78f-3d83-b12e-01cd143e488a",
                        "glosses": [
                            "разг., сниж. макияж"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe19c33-bb62-4aaa-bd85-096506d03441",
                                "sense_id": "80eb89b1-0fff-3422-a510-20bb4a59b130",
                                "text": "А я пошла в туалет, умылась, марафет весь смыла."
                            }
                        ]
                    },
                    {
                        "sense_id": "4ab8005d-078b-3df2-b5da-45a4d7bf2a1d",
                        "entry_id": "57607f81-c78f-3d83-b12e-01cd143e488a",
                        "glosses": [
                            "разг., сниж. хороший, ухоженный внешний вид девушки, женщины; красота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02469182-71ea-4c9e-b1e0-937050644a92",
                                "sense_id": "4ab8005d-078b-3df2-b5da-45a4d7bf2a1d",
                                "text": "Я вся намылилась, марафет навела, в большом порядке пришла к тебе девочка!"
                            }
                        ]
                    }
                ],
