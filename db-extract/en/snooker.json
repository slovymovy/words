                        "cross_references": [
                            {
                                "target_word": "Snooker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "96480008-2f59-3207-bbfe-6d3ffeb96594",
                                        "entry_id": "79681bba-edaa-3e3d-81ee-3cf75a16fd88",
                                        "glosses": [
                                            "Disziplin des Billards, bei der nacheinander 15 rote Bälle im Wechsel mit jeweils einem der sechs andersfarbigen Bälle und anschließend die sechs Farben von Gelb bis Schwarz mit dem weißen Spielball gelocht werden müssen"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3987e9f-6c6e-4cf1-a80b-a09989136db6",
                                                "sense_id": "96480008-2f59-3207-bbfe-6d3ffeb96594",
                                                "text": "Snooker wird mit zweiundzwanzig Bällen gespielt."
                                            },
                                            {
                                                "example_id": "0b0696ef-a5ba-4190-8c4c-ade3fa381542",
                                                "sense_id": "96480008-2f59-3207-bbfe-6d3ffeb96594",
                                                "text": "Traditionell ist Snooker vor allem in Großbritannien beliebt, jedoch gewinnt es auch in anderen Ländern immer mehr Fans."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a6b4085c-9b6e-362e-9de1-f395ad243719",
                                        "entry_id": "79681bba-edaa-3e3d-81ee-3cf75a16fd88",
                                        "glosses": [
                                            "eine Spielsituation beim Snookerspiel, bei der der Spielball den nächsten anzuspielenden Ball nicht auf direktem Wege erreichen kann oder aber ihn nicht an einer beliebigen Stelle treffen kann, weil er von anderen Bällen teilweise verdeckt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478871c0-14db-4bc3-bfa9-30f6b983237c",
                                                "sense_id": "a6b4085c-9b6e-362e-9de1-f395ad243719",
                                                "text": "Wird bei einem Snooker ein Foul begangen, so kann der Gegner entweder die Situation selbst übernehmen oder den foulenden Spieler den Stoß wiederholen beziehungsweise die Situation übernehmen lassen."
                                            },
                                            {
                                                "example_id": "87c95d1f-e2de-4f63-8546-108eaf55999e",
                                                "sense_id": "a6b4085c-9b6e-362e-9de1-f395ad243719",
                                                "text": "Benötigt ein Spieler Snooker, so ist er auf Foulpunkte angewiesen, um den Frame noch zu gewinnen."
                                            },
                                            {
                                                "example_id": "4c347b7c-4592-4feb-89e8-43c7a40a5585",
                                                "sense_id": "a6b4085c-9b6e-362e-9de1-f395ad243719",
                                                "text": "„Der 31. Frame des Finales der Weltmeisterschaft lief, als Mark Selby beim Stand von 16:14 den weißen Spielball dicht hinter Schwarz verstecken wollte, um seinen Gegner in eine schwierige Situation zu zwingen, kurz also: um einen Snooker zu legen.“"
                                            },
                                            {
                                                "example_id": "8b45b87f-8c99-4c66-bb8e-c7178e7ea886",
                                                "sense_id": "a6b4085c-9b6e-362e-9de1-f395ad243719",
                                                "text": "„Außerdem besagt die Definition, dass nur ein Ball, der nicht angespielt werden darf, einen Snooker verursachen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
