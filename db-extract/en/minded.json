                "senses": [
                    {
                        "sense_id": "e95153b5-1396-3973-9ac4-194e89cc2408",
                        "entry_id": "50b83e60-7310-3a34-85d3-d4ee8006c7df",
                        "glosses": [
                            "Having or exemplifying a mind of the stated type, nature or inclination."
                        ],
                        "tags": [
                            "in-compounds"
                        ],
                        "examples": [
                            {
                                "example_id": "625ac152-8d12-4430-9201-e4c99f72ed98",
                                "sense_id": "e95153b5-1396-3973-9ac4-194e89cc2408",
                                "text": "a fair-minded decision by a traditionally minded Pope."
                            },
                            {
                                "example_id": "747b1b08-40c0-4c08-98e6-25fc3b66fa49",
                                "sense_id": "e95153b5-1396-3973-9ac4-194e89cc2408",
                                "text": "literary-minded/literature-minded/two-minded"
                            },
                            {
                                "example_id": "790db4f5-37d8-4fb8-bc19-28bfefebc357",
                                "sense_id": "e95153b5-1396-3973-9ac4-194e89cc2408",
                                "text": "Downtown merchants can’t condone sending the spend-minded to Lancaster Mall, where they can park without fear in mega-macadam lots."
                            }
                        ]
                    },
                    {
                        "sense_id": "53faaa48-114c-39b4-ba85-63737a507a9f",
                        "entry_id": "50b83e60-7310-3a34-85d3-d4ee8006c7df",
                        "glosses": [
                            "Having a preference for doing something; having a likelihood, or disposition to carry out an act."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a3baa3-e6d5-463a-819c-1166033a7eab",
                                "sense_id": "53faaa48-114c-39b4-ba85-63737a507a9f",
                                "text": "I am minded to refuse the request."
                            },
                            {
                                "example_id": "96855c5c-1b91-426c-a64a-72cfad4721d8",
                                "sense_id": "53faaa48-114c-39b4-ba85-63737a507a9f",
                                "text": "Order another drink if you are so minded"
                            },
                            {
                                "example_id": "fcb51bdb-079d-4cf4-a425-791fc74cb745",
                                "sense_id": "53faaa48-114c-39b4-ba85-63737a507a9f",
                                "text": "He seems minded to go ahead with the plan."
                            },
                            {
                                "example_id": "ebdf420d-fa8f-4235-95c7-c79cf545b365",
                                "sense_id": "53faaa48-114c-39b4-ba85-63737a507a9f",
                                "text": "But Transport Secretary Heidi Alexander instead said she was \"minded to approve\" the plans, and extended a decision deadline to the end of October."
                            }
                        ]
                    }
                ],
