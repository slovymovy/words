                {
                    "sense_id": "e23737c8-1359-34f7-bfd8-20f9f10b5dee",
                    "sense_definition": "Несчастье, горе, крайне тяжёлое или неприятное событие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Настоящая <w>беда</w> пришла в их дом совершенно внезапно.",
                            "target_lang_translations": {
                                "en": "Real <w>misfortune</w> came to their house quite suddenly.",
                                "fr": "Un véritable <w>malheur</w> a frappé leur maison de manière tout à fait inattendue."
                            }
                        },
                        {
                            "text": "Потерять ключи — это маленькая неприятность, а не <w>беда</w>.",
                            "target_lang_translations": {
                                "en": "Losing keys is a small nuisance, not a <w>disaster</w>.",
                                "fr": "Perdre ses clés, c'est un petit désagrément, pas une <w>catastrophe</w>."
                            }
                        },
                        {
                            "text": "Если ты немного опоздаешь, это не <w>беда</w>.",
                            "target_lang_translations": {
                                "en": "If you are a little late, it's no <w>trouble</w>.",
                                "fr": "Si tu as un peu de retard, ce n'est pas un <w>drame</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "несчастье",
                        "горе",
                        "бедствие",
                        "катастрофа",
                        "трагедия"
                    ],
                    "antonyms": [
                        "счастье",
                        "удача"
                    ],
                    "common_phrases": [
                        "не беда",
                        "попасть в беду",
                        "выручить из беды",
                        "натворить бед",
                        "пришла беда"
                    ],
                    "target_lang_definitions": {
                        "en": "Misfortune, grief, or an extremely difficult or unpleasant event.",
                        "fr": "Malheur, événement pénible, douloureux ou grave."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "trouble",
                                "target_lang_sense_clarification": "general difficulty, distress, or dangerous situation"
                            },
                            {
                                "target_lang_word": "misfortune",
                                "target_lang_sense_clarification": "bad luck or an unlucky event"
                            },
                            {
                                "target_lang_word": "disaster",
                                "target_lang_sense_clarification": "a sudden accident or catastrophe"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "malheur",
                                "target_lang_sense_clarification": "événement pénible, mauvaise fortune"
                            },
                            {
                                "target_lang_word": "catastrophe",
                                "target_lang_sense_clarification": "événement tragique, grand désastre"
                            },
                            {
                                "target_lang_word": "ennui",
                                "target_lang_sense_clarification": "problème ou désagrément (souvent dans les tournures comme « pas grave »)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54119871-446b-3da4-80ec-cc973377e61a",
                    "sense_definition": "Очень много, огромное количество кого-либо или чего-либо.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Народу на городской площади собралось — <w>беда</w>!",
                            "target_lang_translations": {
                                "en": "The people gathered in the town square — <w>an awful lot</w>!",
                                "fr": "Il y avait un <w>monde fou</w> rassemblé sur la place de la ville !"
                            }
                        },
                        {
                            "text": "Грибов в лесу в этом году — просто <w>беда</w>.",
                            "target_lang_translations": {
                                "en": "Mushrooms in the forest this year — simply <w>tons</w>.",
                                "fr": "Il y a des champignons dans la forêt cette année, c'est <w>incroyable le nombre</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "уйма",
                        "тьма",
                        "видимо-невидимо"
                    ],
                    "common_phrases": [
