                    {
                        "sense_id": "4d77c375-4638-322b-baa5-9383504d20e4",
                        "entry_id": "ee7e2dbb-c12d-31d8-8e48-80be340afc7c",
                        "glosses": [
                            "A musical composition suitable for such a dance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3206930f-da44-48ac-adbe-ae432c5264fb",
                                "sense_id": "4d77c375-4638-322b-baa5-9383504d20e4",
                                "text": "\"These damned Lindys!\" bubbled Janice. \"Don't they play anything for old married folks?\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e49949a3-ba1b-3db3-b87a-87de4ff9d3c5",
                        "entry_id": "ee7e2dbb-c12d-31d8-8e48-80be340afc7c",
                        "glosses": [
                            "Ellipsis of Lindy Hop"
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "f04bb5fa-a533-4bc9-98d7-9a369c60df72",
                                "sense_id": "e49949a3-ba1b-3db3-b87a-87de4ff9d3c5",
                                "text": "The Lindy Hop picked up where the Charleston left off, with the first swing-outs, breakaways and \"shine steps\" added to a basic off-beat two-step. In its early days the Lindy flourished only in lower strata of society."
                            }
                        ]
                    }
