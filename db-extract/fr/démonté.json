                "senses": [
                    {
                        "sense_id": "1e5a13a0-3a98-3311-8c55-ae35d4823d96",
                        "entry_id": "3682729b-a2ef-3582-a299-f35513392c0d",
                        "glosses": [
                            "Qualifie une mer fortement agitée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1c6f19-81ed-4769-b527-cdac93398c27",
                                "sense_id": "1e5a13a0-3a98-3311-8c55-ae35d4823d96",
                                "text": "Comment allait se passer notre amerrissage sur une mer aussi démontée ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "57423ebf-b7cb-3c32-80ca-3c7c988bb653",
                        "entry_id": "3682729b-a2ef-3582-a299-f35513392c0d",
                        "glosses": [
                            "Cheval dont le cavalier a été jeté à terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed53829-d385-4921-8e38-04bccd2189d9",
                                "sense_id": "57423ebf-b7cb-3c32-80ca-3c7c988bb653",
                                "text": "Encore quelques foulées, et il serait à portée du Cercle de Justice. Mais, sur son chemin, un cheval démonté qui courait au hasard lui fit perdre quelques secondes par le détour auquel il l’obligea."
                            }
                        ]
                    },
                    {
                        "sense_id": "39dcb6e3-e284-3519-8490-b3e084f20ac4",
                        "entry_id": "3682729b-a2ef-3582-a299-f35513392c0d",
                        "glosses": [
                            "Décontenancé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5d956400-db17-4c52-8cdb-e9d1e8b5199b",
                                "sense_id": "39dcb6e3-e284-3519-8490-b3e084f20ac4",
                                "text": "Le jeune homme était démonté. Du moment qu’on lui avait coupé son élan, il ne s’y retrouvait plus. Et pourtant il n’avait pas perdu contenance."
                            }
                        ]
                    }
