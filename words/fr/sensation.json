{
    "word_family": [
        "sensationnel",
        "sensationnalisme",
        "sensationnaliste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17416a22-7a68-3ebf-b2f3-82ad1a95238f",
                    "sense_definition": "Impression physique produite sur un organe sensoriel par un stimulus extérieur ou corporel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En touchant la neige pour la première fois, l'enfant a ressenti une <w>sensation</w> très vive de froid."
                        },
                        {
                            "text": "Ce tissu doux procure une agréable <w>sensation</w> sur la peau."
                        }
                    ],
                    "synonyms": [
                        "perception",
                        "impression"
                    ],
                    "common_phrases": [
                        "sensation de froid",
                        "sensation de brûlure"
                    ]
                },
                {
                    "sense_id": "0a1df6ba-66df-37be-8fdc-bb6e8e0af701",
                    "sense_definition": "Impression morale, sentiment diffus ou état psychologique éprouvé par une personne consciente.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue promenade dans les bois, j'ai éprouvé une profonde <w>sensation</w> de bien-être."
                        },
                        {
                            "text": "Elle avait la désagréable <w>sensation</w> d'être observée dans la pièce sombre."
                        }
                    ],
                    "synonyms": [
                        "impression"
                    ],
                    "common_phrases": [
                        "sensation de bien-être",
                        "sensation de vide"
                    ]
                },
                {
                    "sense_id": "8ca18308-a146-3b89-9f11-8d4ccebdef70",
                    "sense_definition": "Effet de vive curiosité, de surprise ou d'étonnement suscité dans un groupe ou au sein du public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "effet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son arrivée inattendue à la cérémonie a fait une immense <w>sensation</w> auprès des invités."
                        },
                        {
                            "text": "La parution de ce roman polémique a provoqué une véritable <w>sensation</w> dans tout le pays."
                        }
                    ],
                    "common_phrases": [
                        "faire sensation"
                    ]
                }
            ]
        }
    ]
}