                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04cf664c-b8fc-3fdb-b79c-0b508cd355a3",
                                        "entry_id": "37f7ea3c-7dca-338c-9d10-538ba3e1d572",
                                        "glosses": [
                                            "Relatif à Montréal, ville et métropole du Québec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f1d4bf1-66ce-4b12-bdf7-f8ed334aa763",
                                                "sense_id": "04cf664c-b8fc-3fdb-b79c-0b508cd355a3",
                                                "text": "L'âge moyen auquel les nourrissons de la région montréalaise font leurs nuits a été recherché et sa relation avec le mode d’allaitement au sein ou au biberon."
                                            },
                                            {
                                                "example_id": "da84c652-569f-4f66-8a0e-488ea08da77f",
                                                "sense_id": "04cf664c-b8fc-3fdb-b79c-0b508cd355a3",
                                                "text": "Le tribunal montréalais avait été saisi dans le cadre de deux recours collectifs intentés depuis 1998 et représentant plus d’un million de Québécois dont certains fumaient depuis les années 1960."
                                            },
                                            {
                                                "example_id": "4b6de5fd-f71c-4608-a084-edaa96111ad4",
                                                "sense_id": "04cf664c-b8fc-3fdb-b79c-0b508cd355a3",
                                                "text": "« J’aimerais un spectacle très artistique plutôt qu’un défilé de clichés nationaux. Je préfère qu’on nous transporte dans un café parisien par l’art visuel et la musique, plutôt que de voir 100 danseurs déguisés en croissants », résume Vincent Dessureault, animateur radio montréalais, grand amateur des cérémonies d’ouverture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "136280b3-d657-303e-8792-59f75cce07eb",
                                        "entry_id": "37f7ea3c-7dca-338c-9d10-538ba3e1d572",
                                        "glosses": [
