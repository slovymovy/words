    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc3216ee-f2e7-3b7e-b494-b89716bac112",
                    "sense_definition": "Через небольшой промежуток времени; в ближайшем будущем.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_future",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Скоро</w> придёт поезд и мы поедем домой.",
                            "target_lang_translations": {
                                "en": "The train will arrive <w>soon</w> and we will go home.",
                                "zh": "火车<w>很快</w>就会到，我们要回家了。"
                            }
                        },
                        {
                            "text": "Мы очень <w>скоро</w> увидимся с нашими друзьями.",
                            "target_lang_translations": {
                                "en": "We will see our friends very <w>soon</w>.",
                                "zh": "我们<w>很快</w>就能见到朋友们了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "в ближайшее время"
                    ],
                    "antonyms": [
                        "нескоро"
                    ],
                    "common_phrases": [
                        "очень скоро",
                        "совсем скоро",
                        "как скоро"
                    ],
                    "target_lang_definitions": {
                        "en": "After a short period of time; in the near future.",
                        "zh": "在不久的将来；很快。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "soon",
                                "target_lang_sense_clarification": "in the near future"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很快",
                                "target_lang_sense_clarification": "指时间上距离现在很近"
                            },
                            {
                                "target_lang_word": "不久",
                                "target_lang_sense_clarification": "指时间间隔短"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16e7832c-603b-313c-bd40-0c2a8e61c285",
                    "sense_definition": "Быстро, с большой скоростью.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speed_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он бормотал слова необыкновенно <w>скоро</w> и неразборчиво.",
                            "target_lang_translations": {
                                "en": "He mumbled words unusually <w>fast</w> and indistinctly.",
                                "zh": "他嘟囔着词句，说得异常<w>迅速</w>且含糊不清。"
                            }
                        },
                        {
                            "text": "Работа продвигалась <w>скоро</w> благодаря помощи коллег.",
                            "target_lang_translations": {
                                "en": "The work progressed <w>quickly</w> thanks to the help of colleagues.",
                                "zh": "多亏了同事们的帮助，工作进展得非常<w>快</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "споро"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устар."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Quickly, with great speed.",
                        "zh": "迅速地，以很快的速度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quickly",
                                "target_lang_sense_clarification": "at a rapid pace"
                            },
                            {
                                "target_lang_word": "fast",
                                "target_lang_sense_clarification": "moving with speed"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迅速",
                                "target_lang_sense_clarification": "动作或过程很快"
                            },
                            {
                                "target_lang_word": "快",
                                "target_lang_sense_clarification": "速度高"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe354b45-51d2-3eb3-96b5-b59c3fbe68c5",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>скорый</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наше расставание было неизбежно и <w>скоро</w>.",
                            "target_lang_translations": {
                                "en": "Our parting was inevitable and <w>quick</w>.",
                                "zh": "我们的离别是不可避免且<w>迅速</w>的。"
                            }
                        },
                        {
                            "text": "Это решение слишком <w>скоро</w> и необдуманно.",
                            "target_lang_translations": {
                                "en": "This decision is too <w>hasty</w> and ill-considered.",
                                "zh": "这个决定太<w>仓促</w>且欠考虑了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short form of the adjective 'skoryy' (quick, hasty).",
                        "zh": "形容词“迅速的”或“仓促的”的短语形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "quick",
                                "target_lang_sense_clarification": "short in duration"
                            },
                            {
                                "target_lang_word": "hasty",
                                "target_lang_sense_clarification": "rash or ill-considered"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迅速",
                                "target_lang_sense_clarification": "指动作或过程快"
                            },
                            {
                                "target_lang_word": "仓促",
                                "target_lang_sense_clarification": "指行动匆忙、考虑不周"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}