                "translations": [
                    {
                        "translation_id": "025200c7-e202-43ab-8873-07aa704aa33c",
                        "source_entry_id": "d3774700-ee61-3e52-ab07-5e08b88d234e",
                        "source_sense_id": "2d358d61-6e90-32cc-817b-4fdfed7ebdb8",
                        "source_sense_description": "sich nach dem Öffnen wieder verschließen lassend; wiederverschließbar",
                        "target_lang_word": "wiederverschließbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wiederverschließbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                        "entry_id": "0de8d9f1-60b3-30ac-a38d-bf27f14e625d",
                                        "glosses": [
                                            "so, dass es wieder verschlossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5c7b52-556d-46ac-9146-23bc468e406e",
                                                "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                                "text": "„Selbsterklärend können wiederverschließbare Verpackungen beliebig oft geöffnet und wieder verschlossen werden.“"
                                            },
                                            {
                                                "example_id": "2fec4fde-193e-4e64-a04e-3a45d9201340",
                                                "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                                "text": "„Die Verpackung ist wiederverschließbar: man kann sie immer wieder öffnen und schließen; sozusagen eine Eigenschaft oder Beschaffenheit der Verpackung.“"
                                            },
                                            {
                                                "example_id": "e1a56bca-d1bd-4d81-8c8f-e4df6a48982b",
                                                "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                                "text": "„Alles in einer praktischen, wiederverschließbaren Box - damit nichts verloren geht!“"
                                            },
                                            {
                                                "example_id": "734d2800-2b14-47be-88f1-6a25519e8ecf",
                                                "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                                "text": "„Die Magbalube-Tube ist wiederverschließbar und enthält 21,25 Gramm Fett.“"
                                            },
                                            {
                                                "example_id": "2f5b3d71-f05d-4950-845b-6e9c23f8c793",
                                                "sense_id": "58148318-2c9d-3838-a64b-8c080511b04a",
                                                "text": "„ISTAD Beutel sind wiederverschließbar und können immer wieder benutzt werden.“"
                                            }
                                        ],
