                ],
                "senses": [
                    {
                        "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                        "entry_id": "7176623c-19a3-3979-b213-5bad1876412b",
                        "glosses": [
                            "Playful raillery; banter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ccc19551-6c5f-44d1-9367-a38a51198175",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "I am persuaded, if all gay badinage were prefaced by an explanation, it would be infinitely better received."
                            },
                            {
                                "example_id": "cf55c338-6ae4-4392-9b83-356978ef90ca",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "Your badinage so airy, / Your manner arbitrary, / Are out of place / When face to face / With an influential Fairy."
                            },
                            {
                                "example_id": "bec9003f-0bf8-4d54-ab73-dfb2dc03c216",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "\"[…] God knows that if you were only safely married to Jacob I would not care how much you saw of Henri; but as you are not, I think these badinages are very ill-timed and take your mind off the principal business.\""
                            },
                            {
                                "example_id": "d9661d26-f9e1-4a61-bf47-d8fbbb7059db",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "[…] take the word 'barnshoot'—a corruption of the Hindustani word bahinchut. A vile and unforgivable insult in India, this word is a piece of gentle badinage in England."
                            },
                            {
                                "example_id": "300edbb6-c0c3-4d6e-b926-10df5cf43f05",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "[Talia:] You'll forgive me if I'm not in the mood for your usual badinage."
                            },
                            {
                                "example_id": "3c3282d7-7922-4da4-8863-3544b7ef5875",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "\"No, this was more a night of bellowed barbed badinage, boisterous BS, outrageous declamations and defiant roars.\""
                            },
                            {
                                "example_id": "16018dc0-d286-4ffc-8b60-aefcbe55da7d",
                                "sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
                                "text": "Described at the time as \"photographic badinages\" the photographs in Die Erotik in der Photographie include one of a nude model stretched out languidly on a bearskin […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e057339a-757d-42aa-8184-721010f2c50b",
                        "source_entry_id": "7176623c-19a3-3979-b213-5bad1876412b",
                        "source_sense_id": "b0c2d468-ea94-3e2f-9414-0aa719397f2c",
