                "forms": [],
                "senses": [
                    {
                        "sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                        "entry_id": "f28428d2-bd31-328c-8321-4a87c13a9e22",
                        "glosses": [
                            "aanzien, respect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "686a41f7-e93f-4945-8a6c-285a5b552871",
                                "sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                                "text": "De trainer is sterk gestegen in mijn achting."
                            },
                            {
                                "example_id": "fc9d3366-3006-470e-b8eb-22a3693f7b45",
                                "sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                                "text": "De held werd met veel achting behandeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "caf6a5c4-6d63-45a7-b0d2-bddc0a75dc0d",
                        "source_entry_id": "f28428d2-bd31-328c-8321-4a87c13a9e22",
                        "source_sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                        "source_sense_description": "aanzien",
                        "target_lang_word": "Achtung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achtung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "Respekt, Ehrfurcht und/oder Wertschätzung vor jemandem oder etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a7b8c4b-a1bf-4fba-be95-e2f8baa3db77",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Warum bringst du ihr gegenüber keine Achtung auf?"
                                            },
                                            {
                                                "example_id": "28a3de3b-dcb5-40de-8497-ce28d9441847",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Dieser Tatsache sollte gebührend Achtung geschenkt werden."
                                            },
                                            {
                                                "example_id": "3f54d920-f736-4282-8216-3600e408f207",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Dieser Kriminelle hat keine Achtung vor dem Gesetz."
                                            },
                                            {
                                                "example_id": "745dce06-cf80-4c81-871b-cb0dcb3bcc71",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "Peters Kollegen empfanden ihm gegenüber ein hohes Maß an \"Achtung\"."
                                            },
                                            {
                                                "example_id": "eb762405-87a9-414e-a019-bae4f9b2972f",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "„So stark seine Verachtung der Journaille, so stark war seine Achtung vor formaler Pressefreiheit.“"
                                            },
                                            {
                                                "example_id": "5f7125a1-c79f-49aa-a2d7-8fbe462e8f0c",
                                                "sense_id": "fc4746c5-0ab9-39f6-bace-409c1c7cc852",
                                                "text": "„Wieland zeigt in seinen Dialogen, dass man eine Kontroverse mit Achtung vor dem, der anderer Meinung ist, austragen kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "Ausruf oder Aufschrift, um Vorsicht oder Aufmerksamkeit zu bewirken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc6d6952-34f3-4715-9125-dbf7a3e90f49",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, Stufe!"
                                            },
                                            {
                                                "example_id": "ff34fb7c-cb11-43b4-a6c8-f061a6dd7f76",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, Lebensgefahr!"
                                            },
                                            {
                                                "example_id": "31adb995-872b-4346-8ce5-9391b3672213",
                                                "sense_id": "4a63187e-9fa9-37ef-abc8-75909901c4e9",
                                                "text": "Achtung, eine wichtige Durchsage!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                        "entry_id": "fef4e5e2-6bc9-36a1-b8bd-d1c838fe5d02",
                                        "glosses": [
                                            "aufgepasst"
                                        ],
                                        "tags": [
                                            "als Kommando"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da882129-733c-4c1f-9e3b-8345aa1bb517",
                                                "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                                "text": "Achtung, präsentiert das Gewehr!"
                                            },
                                            {
                                                "example_id": "c29e5a4f-87a4-4ae2-a9bd-b139e53b8446",
                                                "sense_id": "2356bf20-f89b-387a-9263-476b37734450",
                                                "text": "Achtung, stillgestanden!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ef615e8-57e4-4742-9be7-708d043461a8",
                        "source_entry_id": "f28428d2-bd31-328c-8321-4a87c13a9e22",
                        "source_sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                        "source_sense_description": "aanzien",
                        "target_lang_word": "esteem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esteem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edc749fc-f110-3e19-99ed-ed3e42f02bf7",
                                        "entry_id": "5b04655f-38ed-38f0-b92d-464c6b470c4b",
                                        "glosses": [
                                            "Assessment, estimation, or regard; especially; favourable estimation or regard."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99047bdd-41f4-410b-8755-6adbf587f2bd",
                                                "sense_id": "edc749fc-f110-3e19-99ed-ed3e42f02bf7",
                                                "text": "We hold her in high esteem."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "esteem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ad11d34-043a-3e11-9c7e-e75d30d2bec8",
                                        "entry_id": "ed6420cb-fdaf-31a3-a44d-94593adf9369",
                                        "glosses": [
                                            "To set a high value on; to regard with respect or reverence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "265b3e9f-cbdb-47be-a9e1-cf4c71675bc1",
                                                "sense_id": "8ad11d34-043a-3e11-9c7e-e75d30d2bec8",
                                                "text": "Will he esteem thy riches?"
                                            },
                                            {
                                                "example_id": "1cbc0f0e-aa5c-43c0-bd03-14ebb479e532",
                                                "sense_id": "8ad11d34-043a-3e11-9c7e-e75d30d2bec8",
                                                "text": "You talk kindlier: we esteem you for it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8971efe8-f956-33e2-a005-f7885f852f9e",
                                        "entry_id": "ed6420cb-fdaf-31a3-a44d-94593adf9369",
                                        "glosses": [
                                            "To regard something as valuable; to prize."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6cf4dd46-8381-3627-8cc3-4cc66ac19faa",
                                        "entry_id": "ed6420cb-fdaf-31a3-a44d-94593adf9369",
                                        "glosses": [
                                            "To look upon something in a particular way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "455e52d9-e602-42a3-9e88-ba96da4afe28",
                                                "sense_id": "6cf4dd46-8381-3627-8cc3-4cc66ac19faa",
                                                "text": "Then he forsook God, which made him, and lightly esteemed the Rock of his salvation."
                                            },
                                            {
                                                "example_id": "ebd435e1-c516-42ac-9731-fb859a07ab4a",
                                                "sense_id": "6cf4dd46-8381-3627-8cc3-4cc66ac19faa",
                                                "text": "Thou shouldest (gentle reader) esteem his censure and authority to be of the more weighty credence."
                                            },
                                            {
                                                "example_id": "99311ec5-32d2-4ea4-938c-68ad887b37cf",
                                                "sense_id": "6cf4dd46-8381-3627-8cc3-4cc66ac19faa",
                                                "text": "Famous men, whose scientific attainments were esteemed hardly less than supernatural."
                                            },
                                            {
                                                "example_id": "0d603878-5ba4-42f8-b7a0-b2a200c41bc8",
                                                "sense_id": "6cf4dd46-8381-3627-8cc3-4cc66ac19faa",
                                                "text": "And greatly do I respect the solid character, — a blockhead, thou wilt say; yes, but a well-conditioned blockhead, and the best-conditioned, — who esteems all ‘Customs once solemnly acknowledged’ to be ultimate, divine, and the rule for a man to walk by, nothing doubting, not inquiring farther."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02686a70-fe93-3b66-854f-71402608f487",
                                        "entry_id": "ed6420cb-fdaf-31a3-a44d-94593adf9369",
                                        "glosses": [
                                            "To judge; to estimate; to appraise"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "124eb1dc-ee2c-432e-97fd-aedee139608b",
                                                "sense_id": "02686a70-fe93-3b66-854f-71402608f487",
                                                "text": "The Earth, which I esteem unable to reflect the rays of the Sun."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b0c218c-2298-4de4-b693-e85a3d99a033",
                        "source_entry_id": "f28428d2-bd31-328c-8321-4a87c13a9e22",
                        "source_sense_id": "49c787fc-eb4e-335a-bd19-b1f516f652dc",
                        "source_sense_description": "aanzien",
                        "target_lang_word": "estime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "estime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                        "entry_id": "f5392171-299a-395f-bba4-23ec47d4d3d9",
                                        "glosses": [
                                            "Opinion favorable que l’on a de quelqu’un, fondée sur la connaissance de son mérite, de ses bonnes qualités, de ses vertus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "541fb315-7188-4be8-a5ac-a82db831f6aa",
                                                "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                                "text": "Quoiqu'elle fût certaine de conserver un grand empire sur Victor et d'avoir obtenu son estime pour toujours, elle craignait l'influence des passions sur un homme si nul et si vaniteusement irréfléchi."
                                            },
                                            {
                                                "example_id": "d306d34f-2b3e-4c12-88a9-c17b349a4787",
                                                "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                                "text": "L'empereur Napoléon Ier a souvent répété qu'il avait coutume d'accorder trois sortes d'estime, qu'il répartissait de la manière suivante : estime de caractère; estime de confiance, estime de talent."
                                            },
                                            {
                                                "example_id": "e0b95c6d-735f-48c0-8c1b-bac8a091db9a",
                                                "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                                "text": "Ce vaurien de Mablot, ce dégoûtant, ce saligaud ! Et lui qui le tenait en si haute estime, lui qui avait tant chanté ses louanges !"
                                            },
                                            {
                                                "example_id": "19a9d475-06fe-44e3-b7d5-f73e07793a28",
                                                "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                                "text": "J’estime que j’ai droit à l’estime de moi !"
                                            },
                                            {
                                                "example_id": "8c45dfb1-4fe3-4e7a-9085-848fe63d2775",
                                                "sense_id": "2c5d5d19-77bf-3936-9828-d17309a3b22e",
                                                "text": "Le « tuteur de résilience » peut-être toute personne qui va apporter aide, affection et estime à la personne blessée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06eb96dd-4ac6-3d17-bea4-8125e60bf17a",
                                        "entry_id": "f5392171-299a-395f-bba4-23ec47d4d3d9",
                                        "glosses": [
                                            "Cas que l’on fait de certaines choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abf781d-1a20-4e8a-b0b7-3deb0f9ad3a2",
                                                "sense_id": "06eb96dd-4ac6-3d17-bea4-8125e60bf17a",
                                                "text": "Les sciences étaient en grande estime chez ce peuple."
                                            },
                                            {
                                                "example_id": "3cf6b43f-d60e-493f-8876-64e2fbc60cbd",
                                                "sense_id": "06eb96dd-4ac6-3d17-bea4-8125e60bf17a",
                                                "text": "— Un succès d’estime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffeb3857-846b-3c13-8196-61d2bee95d51",
                                        "entry_id": "f5392171-299a-395f-bba4-23ec47d4d3d9",
                                        "glosses": [
                                            "Calcul approximatif que le pilote fait tous les jours de la distance parcourue par le navire, afin de juger à peu près du lieu où l’on est et du chemin qu’on a fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a1799c-9f3c-42fe-9ffa-2c305f1158d1",
                                                "sense_id": "ffeb3857-846b-3c13-8196-61d2bee95d51",
                                                "text": "La terre, d'après l'estime, ne devait pas être éloignée; elle restait complétement cachée par une brume basse et humide."
                                            },
                                            {
                                                "example_id": "7cf8b404-e5b7-4c6d-be7f-2d6e9c3b8568",
                                                "sense_id": "ffeb3857-846b-3c13-8196-61d2bee95d51",
                                                "text": "La brise avait été nettement plus favorable et mon estime me donnait 97 milles parcourus vers le Sud en quarante-huit heures."
                                            },
                                            {
                                                "example_id": "d130257d-5e7e-490c-ad1d-54cf25c68f61",
                                                "sense_id": "ffeb3857-846b-3c13-8196-61d2bee95d51",
                                                "text": "Bellonte fit de la navigation à l'estime plus que de la navigation que nous appellerons scientifique, ou encore marine. Connaissant notre vitesse, et en tenant compte des minutes qui se déroulaient, je changeais le cap pour prendre celui que Bellonte inscrivait sur une petite feuille de papier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "estime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "542bbcc0-b525-37bd-a14a-0484a630883b",
                                        "entry_id": "d13e5485-e176-3dbb-893d-f91f1b9fdbf2",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de estimer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea3bf72d-7f8b-4dc9-8136-c5fa5a1524bf",
                                                "sense_id": "542bbcc0-b525-37bd-a14a-0484a630883b",
                                                "text": "J’estime que j’ai droit à l’estime de moi !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcb81587-a05a-38fc-a16d-697069fb56e5",
                                        "entry_id": "d13e5485-e176-3dbb-893d-f91f1b9fdbf2",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de estimer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d460e01-b4c1-4d55-bf50-367582ac7341",
                                                "sense_id": "bcb81587-a05a-38fc-a16d-697069fb56e5",
                                                "text": "Il estime que, pourvu que l’on ne touche pas aux principes, on peut accepter des compromis, mais en acculant les Britanniques à se montrer plus clairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cff481af-4b44-35f6-a8cd-16b955d74dbe",
                                        "entry_id": "d13e5485-e176-3dbb-893d-f91f1b9fdbf2",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de estimer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dacfb2c6-4eff-3d88-8c89-4bf3a40162e6",
                                        "entry_id": "d13e5485-e176-3dbb-893d-f91f1b9fdbf2",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de estimer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5008bc94-d599-4499-bbe9-3d1739a3c09e",
                                                "sense_id": "dacfb2c6-4eff-3d88-8c89-4bf3a40162e6",
                                                "text": "Que le président de cet organisme estime souhaitable une construction fédérale dont ladite commission formerait l’ossature, c’est archinaturel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89e5c371-f265-31c8-8cab-bb22aab327c4",
