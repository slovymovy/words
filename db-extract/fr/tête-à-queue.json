                                                "sense_id": "3e41847b-a7cf-32e2-b8b0-244cf5deabd9",
                                                "text": "The Formula One driver spun out on a tight curve."
                                            },
                                            {
                                                "example_id": "5ade6633-d3fc-421d-b718-7e2411b70b4c",
                                                "sense_id": "3e41847b-a7cf-32e2-b8b0-244cf5deabd9",
                                                "text": "Bob accidentally spun out his Mercedes when he hit a patch of black ice."
