                    {
                        "form_id": "93a303ec-4eb9-4a6b-be75-9272abd5805a",
                        "entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                        "tags": [
                            "feminine"
                        ],
                        "form": "sociale-démocrate"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                        "entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                        "glosses": [
                            "Partisan de la social-démocratie ; socialiste non marxiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4da5f1-ee02-4646-90c8-2c847b55c725",
                                "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                                "text": "Pendant que dans l'économie communiste le Gosplan était substitué à la « main invisible » du marché, le keynésianisme tempéré, combinant le rôle de l'État et celui du marché, inspirait la pensée des démocrates américains et des sociaux-démocrates européens."
                            },
                            {
                                "example_id": "4767a9cb-789f-4df2-bc49-b50eef4b4a47",
                                "sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                                "text": "Ils pensent qu'il faut investir ici, fabriquer ici, créer de emplois de qualité ici, ce qui est essentiel pour les sociaux-démocrates."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7c1ff43-3c75-3fe4-b05f-b9e0f92931e2",
                        "entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                        "glosses": [
                            "Membre ou partisan d'un parti membre de la Deuxième Internationale ; en principe socialiste marxiste."
                        ],
                        "tags": [
                            "Marxism"
                        ],
                        "note": "Dans ce cas le pluriel social-démocrates est utilisé car le terme « social » est considéré comme l'apocope de « socialiste »",
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e69cd47-0187-4b5d-8143-10cd013b7768",
                        "source_entry_id": "30384d3b-a0ed-3f65-83a9-62dd52d1a34e",
                        "source_sense_id": "c06138ed-c736-39b6-8e69-e6fbf0152aa3",
                        "source_sense_description": "Partisan de la social-démocratie",
                        "target_lang_word": "Sozialdemokrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sozialdemokrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                        "entry_id": "9fa52261-be54-3da4-967d-51014967c2da",
                                        "glosses": [
                                            "Anhänger der Sozialdemokratie, Anhänger oder Mitglied einer sozialdemokratischen Partei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa0a410-9a5d-4b70-bc56-ddf68e4b93b8",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Auch wenn das Staatsbild der Sozialdemokraten erheblichen Veränderungen unterlag und unterliegt, so lässt sich heute sagen, dass die Sozialdemokraten den Staat in der sozialen Hauptverantwortung sehen.“"
                                            },
                                            {
                                                "example_id": "0cb8756b-0db6-4037-b7d9-96fa7f0f9b93",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Aber im Zweifel sollte für Sozialdemokraten heute die Annahme gelten, dass die Verbesserung oder auch nur die Bewahrung des Erreichten ohne fortschreitende Veränderung undenkbar ist.“"
                                            },
                                            {
                                                "example_id": "e4bcb16f-0f23-46eb-89b8-cc3330ea788a",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„Sogar unter Sozialdemokraten gab es Verfechter eines Krieges gegen das zaristische Russland.“"
                                            },
                                            {
                                                "example_id": "04fa5419-8d4f-4066-b2cc-ff01bbd13426",
                                                "sense_id": "fa8de262-f09e-33c9-90b9-3cb60eea9317",
                                                "text": "„So gut standen die Sozialdemokraten schon lange nicht mehr da.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
