            {
                "entry_id": "60d8e8a2-8058-33d7-9c87-3b035a1d0de8",
                "word": "ich",
                "pos": "pron",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                        "entry_id": "60d8e8a2-8058-33d7-9c87-3b035a1d0de8",
                        "glosses": [
                            "I."
                        ],
                        "tags": [
                            "obsolete",
                            "personal"
                        ],
                        "examples": [
                            {
                                "example_id": "630927af-37de-4747-a96a-f0c7ee79f0bd",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "\"Behold,\" she sayd, \"and se How bright I am of ble! Ich am not cast away, That can my husband say, [...]\""
                            },
                            {
                                "example_id": "fb02de21-379c-421f-913f-1dbbf227efe1",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "My maysters, ich am an old man, and halfe blinde, […]"
                            },
                            {
                                "example_id": "b8fee1c0-fc5d-406a-9a37-5f8c003ff746",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "With cap and knee, ich will serve thee, what should ich more declare."
                            },
                            {
                                "example_id": "3bfaa349-c0bb-4d9d-b4ca-b0356af78bc0",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "Kissyng and lying ich see is all one:\nAnd chave no mony, chul tell true therfore."
                            },
                            {
                                "example_id": "44b64551-fe38-4b19-aea3-fdd1f79d0531",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "Dost thinke 'chill labor to be poore, No no, ich haue a-doe..Ich will a plundering too."
                            },
                            {
                                "example_id": "e84b28d9-7da7-4937-9ba4-d3c58fb78312",
                                "sense_id": "f2cc62cf-5bb4-32f8-9a19-cae772127b06",
                                "text": "Ich, a Word us'd for I in the Weſtern Parts of England."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
