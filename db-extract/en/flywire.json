                        "examples": [
                            {
                                "example_id": "73b6dbe1-8334-489c-94d3-0f4e001cd442",
                                "sense_id": "33888c94-04eb-3e24-a94c-abda1bd85d5d",
                                "text": "He noticed for the first time that the fellow was naked. He had taken little notice of him in the darkened room, and afterwards had seen him only through the fly-wire door."
                            },
                            {
                                "example_id": "3e38a999-1173-45d6-a6da-d0e8241a92b4",
                                "sense_id": "33888c94-04eb-3e24-a94c-abda1bd85d5d",
                                "text": "For a moment, she feared he would, like a new puppy, burst through the flywire."
                            },
                            {
                                "example_id": "845abd48-ac80-483e-b370-59472073cfab",
                                "sense_id": "33888c94-04eb-3e24-a94c-abda1bd85d5d",
                                "text": "He stood in the deep shadow of the open doorway, holding the flywire back with one hand and watching them get out and stretch their limbs in the sun."
