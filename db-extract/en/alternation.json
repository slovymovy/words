                        "examples": []
                    },
                    {
                        "sense_id": "7811a3cd-d2d3-350f-b551-9af1ae2e6928",
                        "entry_id": "6a92050f-5d39-3ad4-b561-20a939f6eec2",
                        "glosses": [
                            "A construct in a regular expression that can match any of several specified subexpressions."
