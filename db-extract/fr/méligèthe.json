                        "glosses": [
                            "Méligèthe du colza, coléoptère qui mange les fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea05d73-3424-42b3-8184-1970d002672c",
                                "sense_id": "e4dd0487-60e5-3329-b6ac-78a6bc6013fc",
                                "text": "Cette culture craint les coitrons au printemps et un insecte, la méligèthe, qui ronge l’intérieur des fleurs : ne pas la laisser trop se multiplier."
                            },
                            {
                                "example_id": "88e9143d-78f4-4837-bbde-81cefa9383f7",
                                "sense_id": "e4dd0487-60e5-3329-b6ac-78a6bc6013fc",
                                "text": "Contrairement aux apparences, le technicien de recherche de 25 ans ne part pas à la chasse aux papillons, mais tente d’attraper des méligèthes pour les compter. Ces insectes ravageurs mangent les boutons de colza avant qu’ils n’éclosent."
                            }
                        ]
                    }
