                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "5c2d2629-0e82-45c4-993f-ebdc9fcffb14",
                                "sense_id": "a3c70f25-fd51-380c-b034-3f17c6f2d2af",
                                "text": "1875, translation of The Lamplighter by Maria Susanna Cummins.\nAmalia gevoelde het gegronde van dit bezwaar; want hoewel jufvrouw Ellis gedurende hunne afwezigheid te huis zou blijven, wist zij dat deze vrouw, zelfs al mogt zij gewillig zijn om Geertrui onder haar hoede te nemen, een zeer ongeschikt persoon zou zijn om het meisje in den tijd harer eerste droefheid te troosten.",
                                "translation": "Amalia understood this objection was justified; because even though miss Ellis would stay at home during their absence, she knew this woman, even if she would be willing to take Geertrui in her care, would be a very unsuitable person to comfort the girl during her initial mourning time.",
                                "english": "Amalia understood this objection was justified; because even though miss Ellis would stay at home during their absence, she knew this woman, even if she would be willing to take Geertrui in her care, would be a very unsuitable person to comfort the girl during her initial mourning time."
                            }
                        ]
                    },
                    {
