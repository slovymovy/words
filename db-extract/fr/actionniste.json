                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c19c92ed-9686-4f67-819f-5034f0471d2f",
                        "source_entry_id": "359f8117-1cb7-3632-b52e-66514eaba34e",
