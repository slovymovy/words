                            {
                                "example_id": "fbf90a16-50b0-4fe8-90e1-d78eb5552d95",
                                "sense_id": "53ccd5b6-a09a-333b-b1d4-db4c9d55865c",
                                "text": "De regionale omroepen beginnen vandaag weer hun gezamenlijke inzamelingsactie voor voedselbanken. Het is de tweede keer dat tijdens de actieperiode op allerlei plekken in de provincies houdbare producten worden ingezameld. Ook kunnen mensen geld doneren."
                            },
                            {
                                "example_id": "08ee5a79-2363-4cbd-a291-1e7dfff3ac51",
                                "sense_id": "53ccd5b6-a09a-333b-b1d4-db4c9d55865c",
                                "text": "De Actie loopt door tot en met 14 oktober 2021 (hierna “Actieperiode”). Deelname is enkel mogelijk in de Actieperiode."
                            }
                        ]
