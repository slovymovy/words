                "senses": [
                    {
                        "sense_id": "65c6f4f4-910d-36e9-9fdf-559611da2486",
                        "entry_id": "449564de-fae8-3848-9480-3afa6cd73ca0",
                        "glosses": [
                            "Ausgabe von Mitteilungen des Leistungsstandes von Schülern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59cabd0d-da70-48a4-846d-7d5001315b4d",
                                "sense_id": "65c6f4f4-910d-36e9-9fdf-559611da2486",
                                "text": "„Das Erstgericht räumte dem Vater in Abänderung der bisherigen Regelung dieses Recht in den Semesterferien eines jeden Jahres beginnend mit Samstag nach der Zeugnisverteilung 10.00 Uhr bis zum darauf folgenden Samstag 20.00 Uhr ein.“"
                            },
                            {
                                "example_id": "3f208f6f-6800-4655-8eb2-b22777504bf9",
                                "sense_id": "65c6f4f4-910d-36e9-9fdf-559611da2486",
                                "text": "„An ihrem letzten Schultag vor der heutigen Zeugnisverteilung sitzen die Kinder in der Volksschule Ziedlergasse im 23. Wiener Gemeindebezirk im Kreis und singen.“"
                            },
                            {
                                "example_id": "ee4ca6d5-d37c-4a02-9e87-07808fa141af",
                                "sense_id": "65c6f4f4-910d-36e9-9fdf-559611da2486",
                                "text": "„Für viele Münchner fallen letzter Schul- und erster Ferientag aufs gleiche Datum, die Kinder werden einfach direkt nach der Zeugnisverteilung in die vollbepackte Reisekarosse geladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
