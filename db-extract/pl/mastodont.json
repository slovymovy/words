                "senses": [
                    {
                        "sense_id": "4fe68e81-2e67-3c4b-be44-71cb81a1e714",
                        "entry_id": "656a6f0a-793b-3f58-9109-c909ab27356a",
                        "glosses": [
                            "słoniopodobne zwierzę kopalne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aafce994-da9f-44ba-8e3f-cc52d7d8eb15",
                                "sense_id": "4fe68e81-2e67-3c4b-be44-71cb81a1e714",
                                "text": "Naukowcy odkryli nowe gatunki mamuta i mastodonta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4a0cb685-8cba-3a70-878e-f532526d8ca4",
                        "entry_id": "656a6f0a-793b-3f58-9109-c909ab27356a",
                        "glosses": [
                            "osoba wykonująca zawód dłużej niż średnia"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "532ff254-1294-38b1-96bb-9b603f1199f5",
                        "entry_id": "656a6f0a-793b-3f58-9109-c909ab27356a",
                        "glosses": [
                            "głównie osoba żyjąca dawnymi obyczajami, stylem myślenia"
                        ],
                        "tags": [
                            "metaphoric",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3b0292cb-f794-49ec-876f-2e4a93c3fa91",
                                "sense_id": "532ff254-1294-38b1-96bb-9b603f1199f5",
                                "text": "Odszedł na Wieczne Łowy jako stary człowiek - stary wiekiem, stary ideami, których bronił, mastodont cywilizacji, po której zostało tak niewiele."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7eafe596-e64e-4709-9dcb-a260e18ce971",
                        "source_entry_id": "656a6f0a-793b-3f58-9109-c909ab27356a",
                        "source_sense_id": "4fe68e81-2e67-3c4b-be44-71cb81a1e714",
                        "target_lang_word": "mastodon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mastodon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                                        "glosses": [
                                            "Extinct elephant-like mammal of the genus †Mammut that flourished worldwide from Miocene through Pleistocene times; differs from elephants and mammoths in the form of the molar teeth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e25794e-8d41-4d58-8563-4ffef4af58ed",
                                                "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                                                "text": "When, exactly, Europeans first stumbled upon the bones of an American mastodon is unclear. An isolated molar unearthed in a field in upstate New York was sent off to London in 1705; it was labeled the “tooth of a Giant”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                                        "glosses": [
                                            "Anything awkwardly large or unwieldy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266300bf-d949-401c-9c2b-4c64d59f6c95",
                                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                                "text": "The battery is dying, and Natalia's iPhone charger doesn't fit my mastodon of a phone anyway."
                                            },
                                            {
                                                "example_id": "cc8f2d08-7aeb-433a-a0b2-2a36b1b99d6c",
                                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                                "text": "Nor does it work for governance: the policy has become such a mastodon that we can't adapt it quickly enough to different regions or different circumstances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
