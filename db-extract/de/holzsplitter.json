                        "cross_references": [
                            {
                                "target_word": "écharde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a7c23fc-ecfe-334c-a47b-ac76f4ec7b1d",
                                        "entry_id": "adda1b8d-03f0-300f-8e1f-03b45b8e15b8",
                                        "glosses": [
                                            "Piquant de chardon ou petit éclat piquant de matériau rigide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27747241-872a-4907-8d80-0bbafec6d89e",
                                                "sense_id": "5a7c23fc-ecfe-334c-a47b-ac76f4ec7b1d",
                                                "text": "On lui a tiré une écharde du pied."
                                            },
                                            {
                                                "example_id": "137d151d-ec68-4eda-b22a-f56f2a9f87a8",
                                                "sense_id": "5a7c23fc-ecfe-334c-a47b-ac76f4ec7b1d",
                                                "text": "Il lui entra une écharde sous l’ongle."
                                            },
                                            {
                                                "example_id": "0a008b23-1de5-4668-b2dd-fdb8bef08db7",
                                                "sense_id": "5a7c23fc-ecfe-334c-a47b-ac76f4ec7b1d",
                                                "text": "Au moment où j’entreprends de ranger le tas en fagot, une écharde se plante entre l’ongle et la pulpe de mon index."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9971089c-f73c-3006-a080-019b4fd76aa8",
                                        "entry_id": "adda1b8d-03f0-300f-8e1f-03b45b8e15b8",
                                        "glosses": [
                                            "Embarras, souvenir douloureux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b39464a6-4bca-4120-a356-eceda3b911a9",
                                                "sense_id": "9971089c-f73c-3006-a080-019b4fd76aa8",
                                                "text": "Cet homme qui évidemment n’aimait pas les enfants en fit dix à sa femme, dont deux morts en bas âge et deux infirmes dont l’existence lui fut peut-être un écharde."
                                            },
                                            {
                                                "example_id": "0a9e7b02-4cc9-4706-81ba-726f8faaeee7",
                                                "sense_id": "9971089c-f73c-3006-a080-019b4fd76aa8",
                                                "text": "Pour un temps la peur s’était extraite comme une écharde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc96437-2c63-3bed-9c36-fc3a7c5773e5",
                                        "entry_id": "adda1b8d-03f0-300f-8e1f-03b45b8e15b8",
                                        "glosses": [
                                            "Synonyme de épinoche à trois épines."
                                        ],
