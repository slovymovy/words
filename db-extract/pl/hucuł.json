                                        "glosses": [
                                            "этногр. представитель горцев Карпат, этнической группы украинцев"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "613ccd20-306c-4fca-8c8c-59e2dd57a26f",
                                                "sense_id": "1c12b746-42f4-3f78-a2d0-6afa62910273",
                                                "text": "На самом западе Украины есть историческая область Гуцульщина, в ней живут гуцулы — особая этническая группа славян."
                                            },
                                            {
                                                "example_id": "55dfd204-f327-412b-8af8-beb77882e214",
                                                "sense_id": "1c12b746-42f4-3f78-a2d0-6afa62910273",
                                                "text": "Самый вид гуцула надолго поселяет уныние."
                                            },
                                            {
                                                "example_id": "05499760-fdcf-4afb-827d-fbdb929ea497",
                                                "sense_id": "1c12b746-42f4-3f78-a2d0-6afa62910273",
                                                "text": "Ну и гуцулы хороши, с павлиньим пером на соломенной шляпе, дерутся до последнего."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
