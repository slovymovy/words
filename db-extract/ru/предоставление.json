                                        "sense_id": "38a10a32-3862-31a8-93be-d161d45fc20e",
                                        "entry_id": "0e75d89e-8c19-3402-b236-48097fd33744",
                                        "glosses": [
                                            "Vorgang des Zuteilens, Aufteilens, Verteilens, Anweisens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75754c3-b4e2-44e1-8e9d-57607ec4fec4",
                                                "sense_id": "38a10a32-3862-31a8-93be-d161d45fc20e",
                                                "text": "Bei der Zuteilung der Lebensmittel wurde betrogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                        "entry_id": "0e75d89e-8c19-3402-b236-48097fd33744",
                                        "glosses": [
                                            "das Zugeteilte, die Ration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011f13a5-a5c4-4e64-82a8-8ed3f3de2567",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "Die Zuteilung umfasste 100 Gramm Brot."
                                            },
                                            {
                                                "example_id": "26e890ff-5b65-4b10-ac80-54958a5aa033",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "„Da die Lebensmittelkarten von den Kommunen den jeweiligen Lieferungen entsprechend ausgegeben wurden, unterschieden sich die offiziellen Zuteilungen von Ort zu Ort.“"
                                            },
                                            {
                                                "example_id": "08f3550a-8662-477c-be05-d9eabd667115",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "„Die Reichsmark, die den Arbeitern und Angestellten ausbezahlt wurde, spielte demgegenüber keine Rolle, mit ihr konnte man nur noch die amtlichen Zuteilungen auf Lebensmittelkarte und Kleiderkarte bezahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c16cd44-dd33-42e4-97d1-8a2a9c64301b",
                        "source_entry_id": "fda2818a-752d-300e-bcbc-eb8267fd237e",
                        "source_sense_id": "6344b0eb-2d1f-3d1a-a793-f6c82c269624",
                        "target_lang_word": "octroi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "octroi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01ee515f-d469-373f-bb74-525968adcec7",
                                        "entry_id": "a826eac2-1a19-36a4-9ac9-ba395c896695",
                                        "glosses": [
                                            "Action d’octroyer."
                                        ],
                                        "tags": [
                                            "Histoire de la chancellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc8490d4-732e-4d66-ad97-b5b17e1fe18d",
                                                "sense_id": "01ee515f-d469-373f-bb74-525968adcec7",
                                                "text": "L'octroi du droit de propriété aux juifs n'alla pas sans provoquer des protestations de la part du pape Étienne III."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51471c24-a64f-36f4-b9ab-db466b45980a",
                                        "entry_id": "a826eac2-1a19-36a4-9ac9-ba395c896695",
                                        "glosses": [
                                            "Ce qu’on octroie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39883a0-9d6e-4554-84e1-f9ea3a5a4d1f",
                                                "sense_id": "51471c24-a64f-36f4-b9ab-db466b45980a",
                                                "text": "Révoquer un octroi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1271102-4767-351b-8b30-1ab01a12a982",
                                        "entry_id": "a826eac2-1a19-36a4-9ac9-ba395c896695",
                                        "glosses": [
                                            "Certains droits que les villes étaient autorisées à lever sur les denrées qui entraient dans leur enceinte et dont elles affectaient le produit au budget municipal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8894de59-0720-4875-bb4c-d457c203ff05",
                                                "sense_id": "e1271102-4767-351b-8b30-1ab01a12a982",
                                                "text": "Dans tous les pays du monde les savons de ménage sont parfumés, sauf en France, parce que des droits d'octroi frappent un peu partout les savons parfumés."
                                            },
                                            {
                                                "example_id": "f884d7b2-85a5-4001-b637-f0a83a20e335",
                                                "sense_id": "e1271102-4767-351b-8b30-1ab01a12a982",
                                                "text": "Il vous faudra y louer un chantier, payer patente et des impositions, payer les droits de navigation, ceux d’octroi, faire les frais de débardage et de mise en pile, enfin avoir un agent comptable…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee420065-dca7-3ab6-a29e-f2d3a4e3a355",
                                        "entry_id": "a826eac2-1a19-36a4-9ac9-ba395c896695",
                                        "glosses": [
                                            "Administration chargée de percevoir ces droits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0af7415-7216-4b5b-9041-2eb80dad51fd",
                                                "sense_id": "ee420065-dca7-3ab6-a29e-f2d3a4e3a355",
                                                "text": "L’octroi de Paris. — Employé de l’octroi. — Bureau de l’octroi."
                                            },
                                            {
                                                "example_id": "044a7bec-5c03-4e1b-92d0-ac7f6e39b177",
                                                "sense_id": "ee420065-dca7-3ab6-a29e-f2d3a4e3a355",
                                                "text": "Comme cela arrive souvent le samedi vers trois heures, les abords de la porte de Bercy étaient encombrés, et sur le quai, en quatre files, les voitures s’entassaient à la queue leu leu : haquets chargés de fûts, tombereaux de charbon ou de matériaux, charrettes de foin ou de paille, qui tous, sous un clair et chaud soleil de juin, attendaient la visite de l’octroi, pressés d’entrer dans Paris à la veille du dimanche."
                                            },
                                            {
                                                "example_id": "6c5448f1-6442-4bf8-a1a2-424abcef8e12",
                                                "sense_id": "ee420065-dca7-3ab6-a29e-f2d3a4e3a355",
                                                "text": "C’était un de ces bureaux d’octroi de petit canton qui se sont réfugiés au centre du bourg, par peur des contrebandiers et qui déconcertent les fraudeurs par leurs glycines et leurs jasmins, comme des percepteurs souriants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c713376e-ee45-3cf7-b78f-442a1120b6df",
                                        "entry_id": "a826eac2-1a19-36a4-9ac9-ba395c896695",
                                        "glosses": [
                                            "Bâtiment dans lequel cette administration prélevait ces taxes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bfcc3b7-9ac7-4766-8ffd-156d783a583e",
                                                "sense_id": "c713376e-ee45-3cf7-b78f-442a1120b6df",
                                                "text": "En réalité, au delà de l'octroi, sans interruption perceptible, s'étale une zone de grosses communes industrielles où la population est de 65 000 âmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
