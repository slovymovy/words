                ],
                "senses": [
                    {
                        "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                        "entry_id": "5a86e790-470c-3c26-8c73-ae82c12870bd",
                        "glosses": [
                            "durch Überlagerung von regelmäßigen Mustern entstehender optischer Effekt, wobei ein anderes, ebenfalls periodisches Muster von besonderer Struktur zustande kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8ce6c94-f428-4a85-a53b-eeea2c20a128",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Beim Bild der englischen Königin hat er mit versetzten Druckplatten gearbeitet, so dass es unscharf ist und ein Moiré-Effekt als Verfremdung entsteht, die das Bild dem Zugriff des Betrachters entziehen soll.“"
                            },
                            {
                                "example_id": "aae95d17-5446-4a46-9453-b144932ef761",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Sie arbeiten mit Farbverschiebungen, Perspektiven -Verzerrungen und mit dem irritierenden Moiré-Effekt, bei dem der Blick nicht existente Schatten und Kräuselungen wahrnimmt, wenn parallele oder periodische Linien übereinandergelagert werden.“"
                            },
                            {
                                "example_id": "8700423e-c165-49e3-8df3-64aab910b7a1",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Der Moiré-Effekt hingegen wird durch einfaches Verschieben von übereinandergelagerten Mustern eher entzaubert.“"
                            },
                            {
                                "example_id": "695b807c-31d4-4aed-923a-26ec09b74d95",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Auf dem Weg dorthin spannen sie eine Art Zelt aus Videobändern auf, in dem sich ein Moiré-Effekt zeigt, bekannt von klein karierten Sakkos im Fernsehbild, auf denen sich neue Linien und Formen zu bilden scheinen.“"
                            },
                            {
                                "example_id": "67b5c68b-dbb4-4977-8133-301a40717636",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Die so entstehende Überlagerung sehr homogener Raster kann zu Abbildungsfehlern führen, insbesondere dem gefürchteten Moiré-Effekt, hervorgerufen durch die Kanten feiner Muster.“"
                            },
                            {
                                "example_id": "14184f16-4b1a-4d8f-8eb2-63e8d8c5e21f",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Wer das schon einmal mit seinem Smartphone gemacht hat, hat sich vermutlich über den Moiré-Effekt, dieses Flimmern im Bild, geärgert.“"
                            },
                            {
                                "example_id": "9fb45a3a-b305-4eab-9425-a673eba579b1",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Durch Illumination von unten erhält sie eine irreale Komponente, der Moiré-Effekt täuscht eine Drehbewegung vor.“"
                            },
                            {
                                "example_id": "3a000264-e400-453f-925c-218b0c998e7e",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Der Leser darf dabei an das gemusterte Gewebe denken, an das Moiré-Papier, an die durch fehlerhafte Passung erzeugten Muster beim Mehrfarbendruck oder auch an den unerwünschten Moiré-Effekt auf Fernsehbildschirmen.“"
                            },
                            {
                                "example_id": "e94067a7-cf50-46c6-9250-f7a9d62cae6a",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Gerade darin besteht der Moiré-Effekt der Missoni-Pullover: dass sich vorhandene Raster und Linien übereinanderlegen und ein neues Muster erzeugen.“"
                            },
                            {
                                "example_id": "1a800eac-270d-4505-9cfb-ca6b9e6bf2dc",
                                "sense_id": "a46ab034-f8be-30f6-b8ad-64cbbdf20dec",
                                "text": "„Dort werden Bildschirme verwendet, die mit den besonderen Lichtverhältnissen in einer Studioumgebung zurechtkommen und beim Abfilmen Überlagerungen von feinen Rastern (Moiré-Effekt) verhindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
