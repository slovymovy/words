{
    "word_family": [
        "stoof",
        "stoofpot",
        "stoverij",
        "stuiven",
        "stof"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04210f6a-0eaf-3268-969e-4bd41052fb73",
                    "sense_definition": "Over een vrij laag vuur iets afgesloten in enig vocht gaar laten worden.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lust je <w>gestoofde</w> peertjes bij het avondeten?",
                            "target_lang_translations": {
                                "en": "Would you like <w>stewed</w> pears with dinner?"
                            }
                        },
                        {
                            "text": "We moeten het vlees urenlang zachtjes <w>stoven</w> voor een lekkere smaak.",
                            "target_lang_translations": {
                                "en": "We need to <w>stew</w> the meat gently for hours for a delicious flavor."
                            }
                        }
                    ],
                    "synonyms": [
                        "smoren",
                        "sudderen"
                    ],
                    "common_phrases": [
                        "vlees zachtjes stoven",
                        "peertjes stoven"
                    ],
                    "target_lang_definitions": {
                        "en": "To cook something slowly in a closed pot with a small amount of liquid over low heat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stew",
                                "target_lang_sense_clarification": "to cook slowly in liquid"
                            },
                            {
                                "target_lang_word": "braise",
                                "target_lang_sense_clarification": "to cook meat or vegetables slowly in a covered pot with a little liquid"
                            },
                            {
                                "target_lang_word": "simmer",
                                "target_lang_sense_clarification": "to cook gently just below the boiling point"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "55105831-9417-3bd2-b44f-41e4157304f5",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>stoof</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stoof_plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het museum stonden verschillende oude <w>stoven</w> die vroeger werden gebruikt om voeten te warmen.",
                            "target_lang_translations": {
                                "en": "In the museum, there were several old <w>foot stoves</w> that were used in the past to warm feet."
                            }
                        },
                        {
                            "text": "De houten <w>stoven</w> waren gevuld met warme kooltjes.",
                            "target_lang_translations": {
                                "en": "The wooden <w>foot warmers</w> were filled with warm coals."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of the noun 'stoof' (foot stove / foot warmer)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "foot stoves",
                                "target_lang_sense_clarification": "traditional wooden boxes with hot coals inside used to warm feet"
                            },
                            {
                                "target_lang_word": "foot warmers",
                                "target_lang_sense_clarification": "devices or boxes used to keep feet warm"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c293d3aa-fae8-3780-a721-d076d0617107",
                    "sense_definition": "Meervoud verleden tijd van <w>stuiven</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stuiven_past",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zodra de deur openging, <w>stoven</w> de kinderen luidruchtig naar buiten.",
                            "target_lang_translations": {
                                "en": "As soon as the door opened, the children <w>rushed</w> outside noisily."
                            }
                        },
                        {
                            "text": "De paarden <w>stoven</w> in galop over het droge zandpad.",
                            "target_lang_translations": {
                                "en": "The horses <w>dashed</w> in a gallop over the dry sandy path."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural past tense of the verb 'stuiven' (to rush, dash, or scatter like dust)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rushed",
                                "target_lang_sense_clarification": "moved quickly and suddenly in a group"
                            },
                            {
                                "target_lang_word": "dashed",
                                "target_lang_sense_clarification": "ran or moved suddenly and rapidly"
                            },
                            {
                                "target_lang_word": "scattered",
                                "target_lang_sense_clarification": "moved quickly in different directions"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}