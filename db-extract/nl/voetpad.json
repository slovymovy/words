                "senses": [
                    {
                        "sense_id": "31b227b5-b919-3e0e-afb1-03595804dc20",
                        "entry_id": "233a893e-864a-3cc8-8980-525a5c0261d1",
                        "glosses": [
                            "smalle weg waarop mensen kunnen lopen, maar niet rijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17350fa7-f419-42a2-b8d5-10cd19b8ba5a",
                                "sense_id": "31b227b5-b919-3e0e-afb1-03595804dc20",
                                "text": "Het voetpad dat naar de vuurtoren op Vlieland leidt, is onlangs vernoemd naar Liesbeth List. De in 2020 overleden zangeres groeide op het Waddeneiland op."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae9ca7f9-0c75-3d4e-a337-8773bf2621d6",
                        "entry_id": "233a893e-864a-3cc8-8980-525a5c0261d1",
                        "glosses": [
                            "verhoogde of gemarkeerde strook langs een rijweg waar mensen kunnen lopen"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ebacf531-048c-4c5d-924f-1cd5e79e6f00",
                        "source_entry_id": "233a893e-864a-3cc8-8980-525a5c0261d1",
                        "source_sense_id": "31b227b5-b919-3e0e-afb1-03595804dc20",
                        "source_sense_description": "een pad voor voetgangers",
                        "target_lang_word": "Fußweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                        "entry_id": "0492bdeb-bc8e-3f98-9bca-4240d81881c9",
                                        "glosses": [
                                            "(durch eine Markierung ausgewiesener) Weg, der von Fußgängern und Fußgängerinnen benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ebb60e-dbce-425d-8953-b6018f68a38f",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Der Fahrer schritt voraus auf einem in den Schnee gestapften Fußweg.“"
                                            },
                                            {
                                                "example_id": "2aa086a6-d9f2-4955-ba2c-466931559b44",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Dahinter führt ein Fußweg nach rechts ab, auf dem bist du in zehn Minuten am Wasser.“"
                                            },
                                            {
                                                "example_id": "29369365-45e4-42e1-807d-cdecea0241d9",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Prediger Feller kommt über den Fußweg von der Chaussee, wo sonst die Schafe entlangkommen, abends, wenn die Schwalben zum letzten Mal in den Wind schießen, und jetzt ist es Vormittag, späte, Vormittag, wo die Schwalben noch einmal kurz unterwegs sind, ehe es heiß wird.“"
                                            },
                                            {
                                                "example_id": "75aba4e6-408a-478f-95a1-b177a786a747",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Über die ganzen und halben Inseln und über das Wasser aber laufen rot und dunkelblau und orange die Linien der Subway von damals, hübsch verknotet im südlichen Manhattan und um die Straße Jay in Brooklyn, ungeschickt in Kurven gerundet oder geradezu eckig seitwärts strebend, wie Fußwege im Wald.“"
                                            },
                                            {
                                                "example_id": "db04b607-4513-4e90-b1eb-e41c472ca524",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Wie sie keine Geh- und Räderspuren kennen, keine weichen Fußwege an ihrem Rande entlang als Übergang zur Vegetation, keine Seitenpfade ins Tal hinunter, so entraten sie des Milden, Sänftigenden, Uneckigen von Dingen, an denen Hände oder deren unmittelbare Werkzeuge das ihre getan haben.“"
                                            },
                                            {
                                                "example_id": "01bbf8e9-1b6d-465b-b206-050e1f368f1a",
                                                "sense_id": "6abed6f2-1bd8-337e-8d1b-f4cd5f0f00bc",
                                                "text": "„Erst droben, wo der Hügel sich rundet, um drüben in die nächste Senke abzufallen, wurde sie langsamer. Da zweigt der Fußweg ab. Den nahm sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                        "entry_id": "0492bdeb-bc8e-3f98-9bca-4240d81881c9",
                                        "glosses": [
                                            "(durch eine Bordsteinkante von der Fahrbahn abgegrenzter, erhöhter) Weg für Fußgänger und Fußgängerinnen, der entlang einer Straße führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41fa9206-26b4-4f2a-99db-a48e4dfaa94a",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "„Dicht an dicht stehen auf den Fußwegen der Innenstadt Verkaufsstände, Autos und Kleintransporter.“"
                                            },
                                            {
                                                "example_id": "1b813172-c28b-4626-8cd4-9d4385f7a388",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "Kinder, die jünger als acht Jahre sind, müssen mit dem Rad auf dem Fußweg fahren."
                                            },
                                            {
                                                "example_id": "c55aa243-2586-40f8-84d9-753729d51d69",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "„In den Europäervierteln glänzen moderne, helle Wohnhochhäuser, Villengruppen und schaufensterreiche Geschäftsstraßen mit breiten Fußwegen, von Blumenbeeten und Baumreihen eingezäunten Fahrbahnen, auf denen chromblitzende, neueste amerikanische und französische Automodelle die Ochsenkarren und Maultiere der Araber verdrängen.“"
                                            },
                                            {
                                                "example_id": "d3aec065-0175-4554-9cd9-f66dd1b0a6ba",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "„Beide haben sich an das Eisengeländer gelehnt, das den Fußweg von der Straße trennt.“"
                                            },
                                            {
                                                "example_id": "c7ab404a-1bed-4d07-a925-30a99d73401c",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "„Ich parkte mit einem Hinterrad auf dem Fußweg.“"
                                            },
                                            {
                                                "example_id": "bba4996b-91ca-44f4-a224-fb30b8f2c0cc",
                                                "sense_id": "081b147f-35de-3d5f-a708-59ea1acacf7b",
                                                "text": "„Ich erwiderte, mir wäre doch aufgefallen, dass sie die Fußwege in jeder Straße nur auf einer Seite reinigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                        "entry_id": "0492bdeb-bc8e-3f98-9bca-4240d81881c9",
                                        "glosses": [
                                            "Wegstrecke, die zu Fuß zurückgelegt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e033a6-4118-4982-a14f-486f7bee1c28",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "Bis zur Hütte ist es noch ein Fußweg von eineinhalb Stunden."
                                            },
                                            {
                                                "example_id": "e92fd2ad-3f74-440a-921b-3d35ea50cd72",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Ein Fußweg von zehn Kilometern heißt – freiwillig genossen – Spaziergang.“"
                                            },
                                            {
                                                "example_id": "fbe224f9-86fd-4a11-ac09-b1d28c8eb5f6",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Da gut befahrbare Pisten bis an den Rand des Waldes führen, kann man hier nach ein bis anderthalb Stunden Fußweg unter Anleitung erfahrener Führer mit Sicherheit freilebende, riesige Berggorillas sehen und auch fotografieren, aus nicht zu großem Abstand.“"
                                            },
                                            {
                                                "example_id": "f16100f1-6e89-444f-82e3-14575b47d466",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Von der Nikolaikirche sind es nur fünf Minuten Fußweg zur Thomaskirche.“"
                                            },
                                            {
                                                "example_id": "d0e360c7-3f20-424b-94ec-618cb1cf2a36",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Besonders kritisch seien längere Anmarschrouten für die ältere Bevölkerung: ‚2000 Meter Luftlinie - das ist gleich ein Fußweg von drei bis dreieinhalb Kilometern zum nächsten Postschalter.‘“"
                                            },
                                            {
                                                "example_id": "39dea253-a355-4c51-ac56-d1c08e61c6bb",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Bis jetzt müssen die Lehrkräfte oft bei Dunkelheit lange Fußwege von und zum Unterricht zurücklegen.“"
                                            },
                                            {
                                                "example_id": "d529219a-5cfd-4ca2-bcf4-bd4f859c517c",
                                                "sense_id": "654f5345-2d01-37fb-9f84-55a3d4cd5977",
                                                "text": "„Die Innenstadt sei so klein, daß Fußwege von fünf Minuten zuzumuten seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
