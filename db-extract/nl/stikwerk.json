                        "examples": [
                            {
                                "example_id": "4fd173da-43cb-4521-b54d-3ac8dfce6f5f",
                                "sense_id": "820f2b5d-b724-3545-bbe7-3242728487c1",
                                "text": "In het interieur levert Infiniti drie ontwerpstijlen: City Black (dat zwarte bekleding combineert met paars stikwerk), Cafe Teak (waarbij de cabine in zwart en bruin is uitgevoerd) en Gallery White (met wit leer en rode accenten)."
                            },
                            {
                                "example_id": "6dc3dd7f-4969-48ed-9ed9-dc494cc7e6c7",
                                "sense_id": "820f2b5d-b724-3545-bbe7-3242728487c1",
                                "text": "De koers van de Hongkongse lingerieproducent Top Form International, waarin Van de Velde een belang van 16,4% heeft, zakte de voorbije twee weken met ongeveer 20% na een tegenvallende trading update. Top Form produceert ongeveer de helft van de verkochte lingerie van Van de Velde. Top Form levert enkel het stikwerk."
                            }
                        ]
