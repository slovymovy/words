                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bac0d475-974c-418c-a4ab-145046ae2985",
                                                "sense_id": "b6f8c081-47c8-34ce-ae49-625997663b25",
                                                "text": "Don’t lap your soup like that! You look like a dog."
                                            },
                                            {
                                                "example_id": "5497c543-5ae5-46ba-9fc8-1e8b74196bea",
                                                "sense_id": "b6f8c081-47c8-34ce-ae49-625997663b25",
                                                "text": "They'll take suggestion as a cat laps milk."
                                            },
                                            {
                                                "example_id": "9f3fa162-6306-4053-b16d-363e5d703fde",
                                                "sense_id": "b6f8c081-47c8-34ce-ae49-625997663b25",
                                                "text": "The dogs by the River Nilus's side, being thirsty, lap hastily […]as they run along the shore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fde6e585-a651-3e11-bfcd-ecc28b2e0194",
                                        "entry_id": "816954fe-5b05-34a6-9e8d-724e201c1d3a",
                                        "glosses": [
                                            "To wash against a surface with a splashing sound; to swash."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8e17da1-f37e-4ed2-99c6-487030ea0800",
                                                "sense_id": "fde6e585-a651-3e11-bfcd-ecc28b2e0194",
                                                "text": "I heard the ripple washing in the reeds, / And the wild water lapping on the crag."
                                            }
                                        ]
                                    }
