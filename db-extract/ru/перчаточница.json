                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ef5fd9-fb83-4805-988a-d3bb830d1349",
                                "sense_id": "34ede9cc-b817-3c0a-a125-825efebf38fc",
                                "text": "Альфред идёт на бульвар, забывши, что он хотел купить почтовой бумаги; вместо того он вспомнил, что у него нет перчаток, и идёт к перчаточнице."
                            },
                            {
                                "example_id": "36541376-f88e-4617-8d40-cabb6e04fee7",
                                "sense_id": "34ede9cc-b817-3c0a-a125-825efebf38fc",
                                "text": "«Не продадите ли, перчаточница, перчатки бразильцу?»"
                            }
                        ]
                    }
