                        "entry_id": "ab79fd5e-df59-3548-9f41-3b8992f108c9",
                        "glosses": [
                            "Action de resserrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d70248c-1d65-4247-9ab5-5526cfae7105",
                                "sense_id": "f9f80b11-1d8c-3154-a9c7-8f934f7d38eb",
                                "text": "Un desserrage partiel prudent est indiqué, en assurant le patient qu’un resserrage ultérieur sera toujours possible en cas de reprise de poids."
                            },
                            {
                                "example_id": "3530399a-513c-44de-80cd-fcfdc223c525",
                                "sense_id": "f9f80b11-1d8c-3154-a9c7-8f934f7d38eb",
                                "text": "On peut donc être amené lors du resserrage à imposer au goujon une tension supérieure à celle qu’il subissait initialement."
                            },
                            {
                                "example_id": "de5f6e3b-dbf8-4f20-b386-b1b26e20bd38",
                                "sense_id": "f9f80b11-1d8c-3154-a9c7-8f934f7d38eb",
                                "text": "Celle-ci peut être parfois éliminée par un resserrage, si l’assemblage n’est pas du type bride à bride."
                            }
                        ]
                    }
                ],
