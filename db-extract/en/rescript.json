                                        "entry_id": "4b1c0004-97a0-30ec-b0af-c124867bdc4e",
                                        "glosses": [
                                            "schriftlicher, amtlicher Erlass"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
