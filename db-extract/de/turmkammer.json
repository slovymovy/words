                "senses": [
                    {
                        "sense_id": "e7a2a6d4-0424-3096-b5b4-181eba0bf8fd",
                        "entry_id": "fcce68a4-b82e-30ea-bdf5-360e63be6b33",
                        "glosses": [
                            "kleiner, einfacher Raum in einem Turm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75f67e33-3a98-4154-8d03-8cf6d08b080e",
                                "sense_id": "e7a2a6d4-0424-3096-b5b4-181eba0bf8fd",
                                "text": "„Vom oberen Schlossboden gelangt man an eine kupferbeschlagene Eisentür aus dem Jahr 1610, die in eine kleine quadratische Turmkammer führt.“"
                            },
                            {
                                "example_id": "55f6c638-a544-47b0-bd87-9d9237c14b14",
                                "sense_id": "e7a2a6d4-0424-3096-b5b4-181eba0bf8fd",
                                "text": "„Den Weg in die geheime Turmkammer haben CRC und seine drei Gefährten durchaus nicht freiwillig gewählt.“"
                            },
                            {
                                "example_id": "528b1f39-cf94-40f2-8bca-b4ef261c249a",
                                "sense_id": "e7a2a6d4-0424-3096-b5b4-181eba0bf8fd",
                                "text": "„Ich stieg in die Turmkammer empor, in der Jesus vierzig Tage lang der Versuchung des Teufels widerstanden haben soll, und trat auf den schmalen Streifen eines Balkons hinaus, von dem ich auf Jericho hinabblicken konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
