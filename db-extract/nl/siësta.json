                                            {
                                                "example_id": "188f9b76-4181-4094-a948-bae2170a67a3",
                                                "sense_id": "500c5e36-4849-38d9-aa79-774363c38243",
                                                "text": "The regulators were caught napping by the financial collapse."
                                            },
                                            {
                                                "example_id": "9789fc06-195d-4821-8d62-4ca4a5f46cbd",
                                                "sense_id": "500c5e36-4849-38d9-aa79-774363c38243",
                                                "text": "I took thee napping, unprepared."
                                            }
                                        ]
                                    }
                                ]
