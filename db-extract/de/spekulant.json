                        "form": "den Spekulanten"
                    },
                    {
                        "form_id": "3742ff9a-1e64-4e08-90dc-1f7e9be36d16",
                        "entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spekulanten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                        "entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                        "glosses": [
                            "jemand, der spekuliert; jemand, der preiswert einkauft und auf steigende Preise hofft, um zu einem höheren Preis zu verkaufen, er geht dabei das Risiko ein, dass der Preis fällt und er ein Verlustgeschäft macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387d23a7-a858-4e7a-b31b-1d8096a380b8",
                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                "text": "„Glücksritter und Spekulanten nehmen unter dem Schutz des Militärs nun verlassene Landgüter, Geschäfte und Häuser in Besitz.“"
                            },
                            {
                                "example_id": "9670a178-570e-43ea-ada5-9104295a9046",
                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                "text": "Der Spekulant verlor sein gesamtes Vermögen durch den rapide fallenden Goldpreis."
                            },
                            {
                                "example_id": "7a50ec33-934d-4db0-a3a4-c2f48c5f6dcb",
                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                "text": "Die Spekulanten treiben die Preise für Baugrund in die Höhe."
                            },
                            {
                                "example_id": "5fad9d3c-8c52-4e89-8260-f52af6511d5c",
                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                "text": "„Er hat entweder seine zwei Webstühle ganz und gar gekauft oder auf Kredit genommen und zahlt soundso viel wöchentlich für sie; oder er hat sie gepachtet, wahrscheinlich von seinem Hausbesitzer, der ein Bauherr und Spekulant ist.“"
                            },
                            {
                                "example_id": "719c243c-3949-44f6-82fa-6d186a0d903b",
                                "sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                                "text": "„Tewjes zweite Geschichte erscheint 1899, und zu diesem Zeitpunkt ist der Spekulant schon ein alter Bekannter des Publikums.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5931e2e-7512-49a1-bfb7-e407c8fc5478",
                        "source_entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                        "source_sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                        "target_lang_word": "speculator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a42721e-be46-3e82-9ddd-f61f115c43ac",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who speculates; an observer; a contemplator."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95efa7a9-0d61-4859-9b9a-8b66273ecca6",
                                                "sense_id": "8a42721e-be46-3e82-9ddd-f61f115c43ac",
                                                "text": "a bold and paradoxical speculator"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who forms theories; a theorist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9db585a-80db-4375-93a6-6213f5fd736e",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "[…] in things of Fact, the People are as much to be believed, as the most subtle Philosophers and Speculators, since here sense is the Judge."
                                            },
                                            {
                                                "example_id": "e65fc3ea-f0b7-4a43-8974-2089329b9bdc",
                                                "sense_id": "e8a1f541-c2a8-33fc-afb4-53377c80f7e9",
                                                "text": "For, in the earlier part of the seventeenth century, a speculator who had dared to affirm that the human soul is by its nature mortal, and does, in the great majority of cases, actually die with the body, would have been burned alive in Smithfield."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6fada7e-6265-30f0-8855-834242636684",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "One who speculates; as in investing, one who is willing to take volatile risks upon invested principal for the potential of substantial returns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8640c2c-368c-3066-8811-ea2c44f2c589",
                                        "entry_id": "d904bffe-1187-3d2a-8370-0dc3507654df",
                                        "glosses": [
                                            "Synonym of field goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a1108a0-4ef5-4f74-b8e2-2768feaa718d",
                        "source_entry_id": "93efb60e-a7b0-3247-9c9b-e78fceea46a9",
                        "source_sense_id": "8aabd113-f426-3bbd-a735-0f658811d0f1",
                        "target_lang_word": "спекулянт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "спекулянт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a67153d8-eaf1-3861-b474-0feb7fed600d",
                                        "entry_id": "8acdc79e-cd0f-3196-8fd6-0e0a0e1a2b0b",
                                        "glosses": [
                                            "предприниматель, покупающий что-либо с целью перепродажи и получения выгоды, а не для собственного потребления"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b32acbc-7f50-46b9-ae46-f1ec32c174c4",
                                                "sense_id": "a67153d8-eaf1-3861-b474-0feb7fed600d",
                                                "text": "Два дня продолжались ее старания, на третий достали ложу, уступленную каким-то спекулянтом за безумные деньги."
                                            },
                                            {
                                                "example_id": "b64cf98e-daf1-4542-b874-50a5335a5aa9",
                                                "sense_id": "a67153d8-eaf1-3861-b474-0feb7fed600d",
                                                "text": "Эксперт по операциям с ценными бумагами (не учёный-экономист, но опытный биржевой спекулянт)..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad2ef4fc-51bb-32d6-823c-fa77a5073694",
                                        "entry_id": "8acdc79e-cd0f-3196-8fd6-0e0a0e1a2b0b",
                                        "glosses": [
                                            "неодобр. человек, использующий обстоятельства в своих целях"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
