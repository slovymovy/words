                        "entry_id": "791a119b-6b06-3014-82f4-f24ca3608060",
                        "glosses": [
                            "Enlever l'aubier de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d994fed7-11d7-453e-923f-3b59641cf8e5",
                                "sense_id": "bac224bc-79ec-3f1e-a9d0-80f8fed989fb",
                                "text": "Il est indispensable de désaubiérer, c'est-à-dire d'enlever l'aubier des bois ronds, car c'est la partie la plus périssable."
                            },
                            {
                                "example_id": "47ee2ce0-56d8-4f12-99a9-71f6fcd4539f",
                                "sense_id": "bac224bc-79ec-3f1e-a9d0-80f8fed989fb",
                                "text": "En Côte-d'Ivoire, l'obligation de désaubiérer conduit à n'abattre que de gros arbres de plus de 80 cm de diamètre sur écorce."
                            }
                        ]
                    }
