                "senses": [
                    {
                        "sense_id": "c5249b47-e95c-37d6-81f3-2790f24332c1",
                        "entry_id": "9832fa40-089a-3e1f-98fe-12ab4c1dddd2",
                        "glosses": [
                            "Qui n’est en relation avec un corps que par un autre interposé."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "33e85c7e-c35a-4908-9a2e-427048b173ee",
                                "sense_id": "c5249b47-e95c-37d6-81f3-2790f24332c1",
                                "text": "Depuis longtemps, la lettre de change avait été comprise par lui dans toutes ses conséquences immédiates et médiates."
                            },
                            {
                                "example_id": "31a8536d-ebd7-4e80-a72e-c9120b79baf2",
                                "sense_id": "c5249b47-e95c-37d6-81f3-2790f24332c1",
                                "text": "La distinction des pensées ou connoissances, en médiates & immédiates prouve encore moins la prétendue imperceptibilité des pensées."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1b29c4c-2532-3a1f-a583-4d9ab96c6fc1",
                        "entry_id": "9832fa40-089a-3e1f-98fe-12ab4c1dddd2",
                        "glosses": [
                            "Se dit d’une personne ou d’une chose qui est en relation avec une autre par un intermédiaire."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7f2e74d9-f3ca-4af4-90be-5e36bdf898dd",
                                "sense_id": "a1b29c4c-2532-3a1f-a583-4d9ab96c6fc1",
                                "text": "Au contraire, un message diffusé par un mass media quelconque est toujours « lointain » et général , médiat et dans une plus ou moins grande mesure « impersonnel »."
                            }
                        ]
                    },
                    {
                        "sense_id": "d6ff84fd-2752-3489-bd23-939216ccc186",
                        "entry_id": "9832fa40-089a-3e1f-98fe-12ab4c1dddd2",
                        "glosses": [
                            "Qualifiait des princes allemands qui ne tenaient pas leurs possessions directement de l’empereur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffe774ca-fb43-4e72-8b3f-dfde8e0c2e8a",
                                "sense_id": "d6ff84fd-2752-3489-bd23-939216ccc186",
                                "text": "Prince, comte médiat. Dans les dernières années du Saint Empire (1803-1806), puis dans la Confédération germanique (1815-1866), prince, comte qui avait été à la tête d’un État jadis souverain,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d86f64e-37c3-4ed9-812e-8a980bcb9d4f",
