                        ],
                        "form": "den Kolumnisten"
                    },
                    {
                        "form_id": "51c54e49-e893-4f75-bcba-11ff0c32f6f6",
                        "entry_id": "75cc625d-5ae5-3927-95bd-b6d80e3a7f54",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kolumnisten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                        "entry_id": "75cc625d-5ae5-3927-95bd-b6d80e3a7f54",
                        "glosses": [
                            "Autor eines kurzen, regelmäßig erscheinenden, journalistischen Beitrags in einer Zeitung oder einer Zeitschrift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85685c59-604b-47b0-842a-0b42972aeed0",
                                "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                                "text": "Der Kolumnist der überregionalen Zeitung genießt in der Öffentlichkeit hohes Ansehen."
                            },
                            {
                                "example_id": "e2bcc709-e8ce-4e28-971e-c91453dd2836",
                                "sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                                "text": "„In jenen Tagen besuchten viele Leute die Cafés an der Kreuzung Boulevard Montparnasse und Boulevard Raspail, um gesehen zu werden, und in gewisser Weise nahmen solche Lokale die Kolumnisten vorweg, als den täglichen Ersatz für Unsterblichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f5299fe-e36d-4811-a5db-2be4bf4141a2",
                        "source_entry_id": "75cc625d-5ae5-3927-95bd-b6d80e3a7f54",
                        "source_sense_id": "af2d13a8-9ec2-35d2-a3ec-f8536ad09865",
                        "source_sense_description": "Autor von Kolumnen",
                        "target_lang_word": "columnist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "columnist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                        "entry_id": "91da554b-12cb-3cb4-8dfb-3548a167a708",
                                        "glosses": [
                                            "A regular writer of a column, such as in a magazine or newspaper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd08776-e5f4-41e5-b306-bff48f3e0127",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a sports columnist"
                                            },
                                            {
                                                "example_id": "675968fb-937b-4d0d-a9ef-b01aa348f82d",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a news columnist"
                                            },
                                            {
                                                "example_id": "484fe5d7-07d3-4400-8f7c-5abe9610757d",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "a sporadic columnist"
                                            },
                                            {
                                                "example_id": "a60260b5-e449-43ee-a306-3d0169131d1a",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "Ann Landers, who sometimes wrote her columns from her bathtub, called herself “the general manager of the world,” which pretty much describes the types of questions an advice columnist might be called upon to answer."
                                            },
                                            {
                                                "example_id": "4350188b-ab4d-4138-a15a-ea9a90863407",
                                                "sense_id": "fde4e47b-a7f7-3884-9c4a-5bafc0e11cc9",
                                                "text": "As soon as it was suggested that it was considering the Swedish model – in which men are criminalised for buying sex, but the women working in prostitution are decriminalised – a slew of prominent male columnists started arguing against this infringement on a man's right to purchase a woman's body."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
