                "senses": [
                    {
                        "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                        "entry_id": "e728b7d5-2eef-3688-9373-dc6cfb65d13d",
                        "glosses": [
                            "Verringerung von Gewinnchancen, Einschränkung gegenüber einem Gegenspieler in einem Wettspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b94ee26-fbc8-4922-a93f-709b94948143",
                                "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                                "text": "„Als effektive Maßnahme hat sich in diesen Fällen die Einsetzung eines Unparteiischen, eines Schiedsrichters, erwiesen, der streng über die Einhaltung der Regeln wacht und grobe Regelverletzungen in empfindliche Spielnachteile verwandelt.“"
                            },
                            {
                                "example_id": "8f63612f-14be-470d-8462-02c567fcbc41",
                                "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                                "text": "„Greife ein Spielnachteil hingegen über das Spiel, insbesondere über die Spieldauer hinaus, dann sei er dem Recht nicht entzogen.“"
                            },
                            {
                                "example_id": "e7981392-172f-4d73-8368-3e398e8da241",
                                "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                                "text": "„Die Distanz des Spiels zum realen Leben wird auch durch die Art der Strafen markiert, die bei Übertretung der Spielregeln drohen. Sie sind Spiel-Strafen, das heißt sie haben nur innerhalb des Spiels ihren Sinn: sie bringen einen Spielnachteil, keinen realen Lebensnachteil […]."
                            },
                            {
                                "example_id": "41eaf492-7310-44c9-88f5-283e60c9768d",
                                "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                                "text": "„Der Ursprung dieser Regelung liegt in der Herkunft des Polos: In heißen und sonnigen Ländern konnte das blendende Licht ein echter Spielnachteil sein.“"
                            },
                            {
                                "example_id": "7da0b514-5455-4839-93e3-165fe2192d44",
                                "sense_id": "09f671a0-e759-378a-beb5-20a2af20dfa6",
                                "text": "„Die Truhen können einen Edelstein enthalten oder einen Spielvorteil bzw. einen Spielnachteil für Mitspieler verursachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
