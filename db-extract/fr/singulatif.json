                "senses": [
                    {
                        "sense_id": "d995d80c-1d56-3824-bf43-ca98b0dcdb79",
                        "entry_id": "75d0702e-11ab-3ccc-bf0b-85485ecf3ed3",
                        "glosses": [
                            "Qui n’a lieu qu’une seule fois."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "edb7e42f-d37b-31c4-89f1-eefca73a5f4b",
                        "entry_id": "75d0702e-11ab-3ccc-bf0b-85485ecf3ed3",
                        "glosses": [
                            "Qui est singulier et qui provient d’une forme plurielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25b5148f-f286-4ab6-babb-d5488a8fcb0b",
                                "sense_id": "edb7e42f-d37b-31c4-89f1-eefca73a5f4b",
                                "text": "Une paire de ciseaux est la forme singulative du mot ciseaux."
                            },
                            {
                                "example_id": "7c2beb9a-001e-4fc6-bf1a-048e0695b04d",
                                "sense_id": "edb7e42f-d37b-31c4-89f1-eefca73a5f4b",
                                "text": "Les langues peuvent exprimer morphologiquement la catégorie de la collectivité. Elles utilisent à cette fin soit des morphèmes singulatifs, soit des morphèmes collectifs, soit les deux à la fois."
                            },
                            {
                                "example_id": "7550aab6-2eb6-4c44-93d1-906fc54a7296",
                                "sense_id": "edb7e42f-d37b-31c4-89f1-eefca73a5f4b",
                                "text": "Certains substantifs bretons désignent des groupes d’éléments, et quand il faut désigner un seul des éléments de ces groupes, on ajoute au nom collectif un suffixe singulatif /-ən/. — (Loïc Cheveau, Approche phonologique, morphologique et syntaxique du breton du Grand Lorient (basvannetais), thèse de linguistique, Université Rennes 2, 2007, page 119.)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "268253d9-5f3e-48cf-9851-4986f96a19c8",
                        "source_entry_id": "75d0702e-11ab-3ccc-bf0b-85485ecf3ed3",
                        "target_lang_word": "singulative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "singulative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad3f7b13-a79a-3818-ad16-3c857fad92fa",
                                        "entry_id": "8ba9f14a-52a5-3d87-bbb6-0e574ced93dc",
                                        "glosses": [
                                            "Of or pertaining to a grammatical form or construction that expresses the individuation of a single referent from a mass noun."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87993929-69e7-470d-88cb-150d5a35fa19",
                                                "sense_id": "ad3f7b13-a79a-3818-ad16-3c857fad92fa",
                                                "text": "English doesn't have a singulative number in general, but many uncountable nouns have usual singulative constructions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "singulative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5e54e6-9b6d-3e55-aa5b-498845b6ccf5",
                                        "entry_id": "127cb4f9-ec7f-3beb-8736-b6428dd342e7",
                                        "glosses": [
                                            "A singulative form or construction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65ea0dd9-e86a-4441-a112-226c0c70c989",
                                                "sense_id": "eb5e54e6-9b6d-3e55-aa5b-498845b6ccf5",
                                                "text": "The singulative of \"cattle\" is \"a head of cattle\"."
                                            },
                                            {
                                                "example_id": "36e29a74-e700-4137-9ccf-d487f849f729",
                                                "sense_id": "eb5e54e6-9b6d-3e55-aa5b-498845b6ccf5",
                                                "text": "The singulative of \"scissors\" is \"a pair of scissors\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
