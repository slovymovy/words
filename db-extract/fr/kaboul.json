                                        "entry_id": "a9da87dd-ce47-30a0-8115-f44fba854c60",
                                        "glosses": [
                                            "Hauptstadt und größte Stadt von Afghanistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8221ed74-368a-4a72-acd4-1195dbf9af3c",
                                                "sense_id": "37e0cf55-eee4-3b01-a9dd-d38762e32dfd",
                                                "text": "Kabul ist die Hauptstadt von Afghanistan."
                                            },
                                            {
                                                "example_id": "695c57e8-88fe-47d9-9d4f-aa4919127920",
                                                "sense_id": "37e0cf55-eee4-3b01-a9dd-d38762e32dfd",
                                                "text": "In Kabul leben über 50 % Tadschiken, ca. 25 % Hazara und ca. 20 % Paschtunen."
                                            },
                                            {
                                                "example_id": "d2699229-42c7-4987-8513-405a0d22d79d",
                                                "sense_id": "37e0cf55-eee4-3b01-a9dd-d38762e32dfd",
                                                "text": "Das heutige Kabul ist in zunehmendem Maße durch Kriminalität und islamistische Gewalt geprägt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
