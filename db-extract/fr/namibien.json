                "senses": [
                    {
                        "sense_id": "099990ba-bd46-36f6-b288-44de24f3336f",
                        "entry_id": "144b4ff1-3d0e-3743-9214-29e59272e715",
                        "glosses": [
                            "Qui a un rapport avec la Namibie ou ses habitants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2207bd7a-054f-4705-aee7-021f52049de7",
                                "sense_id": "099990ba-bd46-36f6-b288-44de24f3336f",
                                "text": "Le président namibien, qui participera lundi et mardi à Nice au 25e sommet Afrique-France, a été réélu en novembre dernier pour un second mandat à la tête de son pays."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08920792-cf12-4a58-9f32-4d24a18eb467",
                        "source_entry_id": "144b4ff1-3d0e-3743-9214-29e59272e715",
                        "source_sense_id": "099990ba-bd46-36f6-b288-44de24f3336f",
                        "target_lang_word": "namibisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "namibisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53a7b3f2-e669-35e2-8751-5b32ba852781",
                                        "entry_id": "9bb78359-60ac-33ee-b121-084872517488",
                                        "glosses": [
                                            "Namibia betreffend, aus Namibia kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aff84f2-09ba-4082-a265-8bbb60b38d5e",
                                                "sense_id": "53a7b3f2-e669-35e2-8751-5b32ba852781",
                                                "text": "„Ausführlich beschrieben werden besonders interessante Tiere und Pflanzen wie die in der namibischen Wüste wachsende Welwitschia oder die Arktische Hummel, eines der am nördlichsten lebenden Insekten der Welt.“"
                                            },
                                            {
                                                "example_id": "1d699248-2d3c-42dd-b6f2-f61070eeaedd",
                                                "sense_id": "53a7b3f2-e669-35e2-8751-5b32ba852781",
                                                "text": "„Im namibischen Parlament haben Oppositionspolitiker schwere Vorwürfe gegen die Regierung in Windhoek erhoben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f85f7754-323d-4d32-b146-dbe3c81ee716",
