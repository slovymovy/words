                                        "sense_id": "bd0535bd-15f3-3587-8d1d-5b75e79fbdb2",
                                        "entry_id": "cb3205c6-2f99-388d-a5dd-d1ed3b0bf3bd",
                                        "glosses": [
                                            "Of, or relating to a technocrat or technocracy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4913a410-c519-4834-b260-567c82bd4899",
                                                "sense_id": "bd0535bd-15f3-3587-8d1d-5b75e79fbdb2",
                                                "text": "However, given the state of actual agreed-on knowledge, central banks’ proclamations of detailed technocratic ability to manipulate delicate frictions is really not justified."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ecef2feb-3953-432c-b756-171da70db381",
                        "source_entry_id": "66143ec3-636b-35a8-baa0-568b4b019126",
                        "source_sense_id": "2cda022b-faaf-3a5d-9c4c-6997da904ecb",
                        "target_lang_word": "tecnocrático",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
