                                            },
                                            {
                                                "example_id": "1b9edf43-9ff0-46ea-9698-53e30086a2e0",
                                                "sense_id": "fe956090-0526-3be0-89b5-f67089494aec",
                                                "text": "Patrick remarqua que ses artères métacarpiennes dorsales étaient bleu ciel sur le dos de ses mains pâles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bleu ciel",
                                "target_lang_code": "fr",
