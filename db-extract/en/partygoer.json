                        "entry_id": "d29f9013-b1c2-3320-9281-036a89d3f8bc",
                        "glosses": [
                            "Someone who attends a party or parties."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430553d6-9b7e-48ca-9ab6-05614850e286",
                                "sense_id": "d8ae404f-1f1b-3f74-9d22-5226d5838d24",
                                "text": "The partygoers, in turn, blamed the police for overaggressiveness."
                            },
                            {
                                "example_id": "f781bb8c-b462-46a5-807e-ca99a31487fd",
                                "sense_id": "d8ae404f-1f1b-3f74-9d22-5226d5838d24",
                                "text": "Faith should be a matter of arduous struggle and self-doubt, but the partygoer wants the experience to be easy, immediate and elevating."
                            },
                            {
                                "example_id": "65d1f322-730f-4c9b-b818-8382324a258d",
                                "sense_id": "d8ae404f-1f1b-3f74-9d22-5226d5838d24",
                                "text": "My eyes flickered to the door behind him as sounds of partygoers being loud and ruckusy ebbed and flowed, cutting through this little world we'd created in the laundry room."
                            }
                        ]
                    }
                ],
