                    },
                    {
                        "translation_id": "c579abd8-d1e5-412c-b151-9877d96e107c",
                        "source_entry_id": "bb896d7e-4ecb-3395-9abe-7738b6c6cbe5",
                        "target_lang_word": "piassava",
