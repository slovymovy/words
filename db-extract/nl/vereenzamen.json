                "senses": [
                    {
                        "sense_id": "8b3f187d-e8c9-364d-bd03-fe16b2edab06",
                        "entry_id": "625e3191-bef9-3325-be8c-095ef81c91c8",
                        "glosses": [
                            "to become lonely"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d221b514-5b02-421f-94e3-b0743a62f8cd",
                                "sense_id": "8b3f187d-e8c9-364d-bd03-fe16b2edab06",
                                "text": "Oudere mensen kunnen zich na verloop van tijd vereenzamen als ze weinig sociale contacten hebben.",
                                "translation": "Elderly people can become lonely over time if they have few social contacts.",
                                "english": "Elderly people can become lonely over time if they have few social contacts."
                            },
                            {
                                "example_id": "0ab83ffc-6ff6-4727-baa8-525d17213400",
                                "sense_id": "8b3f187d-e8c9-364d-bd03-fe16b2edab06",
                                "text": "Na zijn scheiding begon hij zich steeds meer te vereenzamen.",
                                "translation": "After his divorce, he started becoming lonely more and more.",
                                "english": "After his divorce, he started becoming lonely more and more."
                            },
                            {
                                "example_id": "3f40d099-34e8-4349-8c21-8ca3bd55579e",
                                "sense_id": "8b3f187d-e8c9-364d-bd03-fe16b2edab06",
                                "text": "Door zijn drukke werkschema begon hij zich te vereenzamen, omdat hij weinig tijd had voor sociale interactie.",
                                "translation": "Due to his busy work schedule, he began becoming lonely as he had little time for social interaction.",
                                "english": "Due to his busy work schedule, he began becoming lonely as he had little time for social interaction."
                            }
                        ]
                    }
                ],
