                            }
                        },
                        {
                            "text": "Na de wedstrijd kwam er een <w>horde</w> fans het veld op rennen.",
                            "target_lang_translations": {
                                "fr": "Après le match, une <w>horde</w> de fans a couru sur le terrain."
                            }
                        }
                    ],
                    "synonyms": [
