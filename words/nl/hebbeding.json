    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e9716e19-6834-3119-84b9-49ac4e24536f",
                    "sense_definition": "een aantrekkelijk voorwerp dat men graag wil bezitten, vaak zonder dat het echt noodzakelijk of nuttig is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gadget",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwste smartwatch is een echt <w>hebbeding</w> voor technologieliefhebbers.",
                            "target_lang_translations": {
                                "en": "The latest smartwatch is a real <w>must-have</w> for technology enthusiasts."
                            }
                        },
                        {
                            "text": "In die winkel verkopen ze allerlei leuke <w>hebbedingen</w> voor in de keuken.",
                            "target_lang_translations": {
                                "en": "In that shop, they sell all kinds of nice <w>gadgets</w> for the kitchen."
                            }
                        }
                    ],
                    "synonyms": [
                        "gadget",
                        "gizmo",
                        "snuisterij"
                    ],
                    "common_phrases": [
                        "een echt hebbeding",
                        "leuke hebbedingen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor gadgets of decoratieve items"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "an attractive object that one would like to own, often without it being truly necessary or useful"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "must-have",
                                "target_lang_sense_clarification": "something highly desirable to own"
                            },
                            {
                                "target_lang_word": "gadget",
                                "target_lang_sense_clarification": "a small mechanical or electronic device"
                            },
                            {
                                "target_lang_word": "collectible",
                                "target_lang_sense_clarification": "an item valued by collectors"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce5f18b8-e32f-38bf-95df-ce26835e80be",
                    "sense_definition": "een voorwerp van weinig waarde of nut; een prul",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "junk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De zolder lag vol met oude <w>hebbedingen</w> die eigenlijk gewoon weggegooid konden worden.",
                            "target_lang_translations": {
                                "en": "The attic was full of old <w>knick-knacks</w> that could actually just be thrown away."
                            }
                        },
                        {
                            "text": "Ik wil geen geld uitgeven aan zo'n waardeloos <w>hebbeding</w> van de kermis.",
                            "target_lang_translations": {
                                "en": "I don't want to spend money on such a worthless <w>trinket</w> from the fair."
                            }
                        }
                    ],
                    "synonyms": [
                        "snuisterij"
                    ],
                    "common_phrases": [
                        "waardeloos hebbeding"
                    ],
                    "target_lang_definitions": {
                        "en": "an object of little value or use; a trifle or piece of junk"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knick-knack",
                                "target_lang_sense_clarification": "a small worthless object, especially a household ornament"
                            },
                            {
                                "target_lang_word": "trinket",
                                "target_lang_sense_clarification": "a small ornament or item of jewelry that is of little value"
                            },
                            {
                                "target_lang_word": "bauble",
                                "target_lang_sense_clarification": "a small, showy trinket or decoration"
                            }
                        ]
                    }
                }
            ]
        }
    ]
