                                        "sense_id": "70b7814e-f929-3ce9-bf57-b1f59a11228d",
                                        "entry_id": "aaafdc42-fae1-371d-ac31-eb004e4bb623",
                                        "glosses": [
                                            "Person, die für die Hege und den Schutz des Wildes in einem Jagdrevier zuständig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002048da-d34f-4e9b-8cca-eb1434dfefde",
                                                "sense_id": "70b7814e-f929-3ce9-bf57-b1f59a11228d",
                                                "text": "Zu den Aufgaben von Jagdaufseherinnen und Jagdaufsehern gehört es, die Tiere des Waldes vor Wilderern zu schützen."
                                            },
                                            {
                                                "example_id": "f5298302-36ca-43fc-ad44-1cb20db520e2",
                                                "sense_id": "70b7814e-f929-3ce9-bf57-b1f59a11228d",
                                                "text": "„Im Anschluß an die Erlegung der beiden Füchse Isoleus und Isolina verbreitete sich im Dorf rasch die Kunde, der Jagdaufseher habe den verlassenen Otterbau am Südhang des Baumwerder als ihre Räuberhöhle festgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
