{
    "word_family": [
        "triteness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ee430a18-b492-3a5d-a835-f8d8b654bc99",
                    "sense_definition": "Lacking originality or freshness due to being overused or repeated too often; hackneyed or cliché.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overused",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Giving cut flowers on a first date has become a rather <w>trite</w> gesture.",
                            "target_lang_translations": {
                                "ru": "Дарить срезанные цветы на первом свидании стало довольно <w>банальным</w> жестом."
                            }
                        },
                        {
                            "text": "The movie plot was so predictable and filled with <w>trite</w> dialogue that I almost fell asleep.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма был настолько предсказуемым и наполненным <w>избитыми</w> диалогами, что я чуть не уснул."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackneyed",
                        "cliché",
                        "banal",
                        "stale"
                    ],
                    "antonyms": [
                        "original",
                        "fresh",
                        "novel"
                    ],
                    "common_phrases": [
                        "trite remark",
                        "trite phrase",
                        "trite dialogue",
                        "trite expression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый оригинальности или новизны из-за слишком частого употребления или повторения; банальный, шаблонный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банальный",
                                "target_lang_sense_clarification": "лишённый оригинальности"
                            },
                            {
                                "target_lang_word": "избитый",
                                "target_lang_sense_clarification": "слишком часто повторяемый, неоригинальный"
                            },
                            {
                                "target_lang_word": "шаблонный",
                                "target_lang_sense_clarification": "трафаретный, лишённый индивидуальности"
                            },
                            {
                                "target_lang_word": "затасканный",
                                "target_lang_sense_clarification": "утративший свежесть от чрезмерного использования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4c205d8-7300-336d-bf8c-36a4a2473c43",
                    "sense_definition": "So self-evident or well-established in legal or formal contexts as to be beyond debate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>trite</w> law that a contract requires clear agreement from both parties to be valid.",
                            "target_lang_translations": {
                                "ru": "Является <w>общеизвестной правовой нормой</w>, что для действительности договора требуется однозначное согласие обеих сторон."
                            }
                        },
                        {
                            "text": "It is <w>trite</w> to observe that a mere disagreement with a ruling does not prove bias.",
                            "target_lang_translations": {
                                "ru": "<w>Самоочевидно</w>, что простое несогласие с решением не доказывает предвзятости."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-evident",
                        "uncontroversial",
                        "obvious"
                    ],
                    "antonyms": [
                        "disputable",
                        "contentious"
                    ],
                    "common_phrases": [
                        "trite law",
                        "trite observation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очевидный, общеизвестный и не подлежащий сомнению (преимущественно в юридическом или формальном контексте)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общеизвестный",
                                "target_lang_sense_clarification": "не подлежащий сомнению, азбучный"
                            },
                            {
                                "target_lang_word": "самоочевидный",
                                "target_lang_sense_clarification": "не требующий доказательств"
                            },
                            {
                                "target_lang_word": "азбучный",
                                "target_lang_sense_clarification": "базовый, непреложный в праве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17d2babf-1db4-39e9-a137-001b85120b2a",
                    "sense_definition": "A denomination of coinage in ancient Greece equal to one third of a stater.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays a rare electrum <w>trite</w> minted in ancient Lydia.",
                            "target_lang_translations": {
                                "ru": "В музее представлена редкая электроновая <w>трита</w>, отчеканенная в древней Лидии."
                            }
                        },
                        {
                            "text": "Archaeologists uncovered an ancient Greek <w>trite</w> coin near the ruins of the temple.",
                            "target_lang_translations": {
                                "ru": "Археологи обнаружили древнегреческую монету-<w>триту</w> неподалёку от руин храма."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ancient trite"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трита (древнегреческая монета достоинством в одну треть статера)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трита",
                                "target_lang_sense_clarification": "древняя монета в 1/3 статера"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c96a5043-d381-3bfe-afd2-6bcba92df586",
                    "sense_definition": "In Ancient Greek musical theory, the lower-pitched of the two movable notes in the higher tetrachord of a lyre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his treatise, the scholar explained the exact position of the <w>trite</w> within the Greek scale.",
                            "target_lang_translations": {
                                "ru": "В своём трактате учёный объяснил точное положение <w>триты</w> в древнегреческом звукоряде."
                            }
                        },
                        {
                            "text": "Tuning the <w>trite</w> correctly was essential for achieving the traditional Dorian mode.",
                            "target_lang_translations": {
                                "ru": "Правильная настройка <w>триты</w> имела решающее значение для получения традиционного дорийского лада."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Ancient Greek musical theory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трита (в древнегреческой теории музыки — нижняя из подвижных ступеней в верхнем тетрахорде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трита",
                                "target_lang_sense_clarification": "ступень верхнего тетрахорда"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}