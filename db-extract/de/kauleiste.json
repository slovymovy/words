                                    {
                                        "sense_id": "d9b78dae-c883-3573-8fd2-a2c8f53ba813",
                                        "entry_id": "4dc20c7f-3845-3c4c-9c41-02d3fbc8894c",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de boucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4fa180e-4ef4-43df-99dd-0c92f0b39266",
                                                "sense_id": "d9b78dae-c883-3573-8fd2-a2c8f53ba813",
                                                "text": "Un système de crochets et de cordes est aménagé à la partie inférieure du couvercle et sur la paroi interne du tonneau pour y déposer les objets à stériliser ou à déverminiser ; on bouche les interstices avec de la glaise, du feutre mouillé ou des chiffons mouillés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28fb7bf7-127d-3b4d-885f-0ce8a0612413",
                                        "entry_id": "4dc20c7f-3845-3c4c-9c41-02d3fbc8894c",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de boucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb2211b6-6a65-3d02-8098-3934471fde34",
                                        "entry_id": "4dc20c7f-3845-3c4c-9c41-02d3fbc8894c",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de boucher."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddee6a99-bd27-41cb-99f5-cb192b83f3f4",
                                                "sense_id": "fb2211b6-6a65-3d02-8098-3934471fde34",
                                                "text": "Pour peu que les baigneurs se plaignent et que l’on bouche les riveaux, les prairies de Nauzan et de Bernezac redeviendront des marais insalubres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a261e2-3940-3bd9-a696-e10abeeeb9ba",
                                        "entry_id": "4dc20c7f-3845-3c4c-9c41-02d3fbc8894c",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de boucher."
                                        ],
