                    {
                        "sense_id": "433c7711-34ab-3d66-8786-3fe27fe942d8",
                        "entry_id": "910fb2e4-aeef-3415-a8f0-c22dd8f68561",
                        "glosses": [
                            "lokal und zeitlich gehäuftes Auftreten der Krankheit Typhus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cd5881-e60d-4820-a1d2-7d35f877cda6",
                                "sense_id": "433c7711-34ab-3d66-8786-3fe27fe942d8",
                                "text": "„Die Universität war im Grunde geschlossen, und jeder Arzt der Medizinischen Fakultät half mit im Kampfe gegen die Typhusepidemie.“"
                            },
                            {
                                "example_id": "1a0a50a8-15c6-47d7-91e1-e7969f4105df",
                                "sense_id": "433c7711-34ab-3d66-8786-3fe27fe942d8",
                                "text": "„Die Rote-Kreuz-Berichte schildern eine plötzliche Typhusepidemie und deuten selbst in ihren vorsichtigen Formulierungen eine Vergiftung von außen als einzige Erklärung für diesen Ausbruch an.“"
                            },
                            {
                                "example_id": "e1a0b720-336b-4958-b10f-3c5c94f17b4f",
                                "sense_id": "433c7711-34ab-3d66-8786-3fe27fe942d8",
                                "text": "„Er besaß vierzehn Morgen Farmland im Ventura-County, ausgedörrt und wertlos, das er als Ruhesitz für seine Eltern gekauft hatte - aber sie hatten ihm einen Strich durch die Rechnung gemacht, als sie 44 bei einer Typhusepidemie abgekratzt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
