            "senses": [
                {
                    "sense_id": "3d15f80a-e27e-31d1-8c58-035898eac9a1",
                    "sense_definition": "informatie, een verhaal of een gebeurtenis mondeling of schriftelijk overbrengen aan iemand anders",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communicatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb het gisteren aan hem <w>verteld</w> tijdens de lunch.",
                            "target_lang_translations": {
                                "en": "I <w>told</w> him about it yesterday during lunch.",
                                "ru": "Я <w>рассказал</w> ему об этом вчера во время обеда."
                            }
                        },
                        {
                            "text": "Kun je een verhaal <w>vertellen</w> over je vakantie in Frankrijk?",
                            "target_lang_translations": {
                                "en": "Can you <w>tell</w> a story about your holiday in France?",
                                "ru": "Можешь <w>рассказать</w> историю о своем отпуске во Франции?"
                            }
                        }
                    ],
                    "synonyms": [
                        "zeggen"
                    ],
                    "common_phrases": [
                        "verhaal vertellen",
                        "mop vertellen",
                        "sprookje vertellen",
                        "de waarheid vertellen"
                    ],
                    "target_lang_definitions": {
                        "en": "To convey information, a story, or an event to someone else, either orally or in writing.",
                        "ru": "передавать информацию, историю или событие кому-либо другому в устной или письменной форме"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tell",
                                "target_lang_sense_clarification": "to narrate or convey information"
                            },
                            {
                                "target_lang_word": "narrate",
                                "target_lang_sense_clarification": "to relate a story or series of events"
                            },
                            {
                                "target_lang_word": "relate",
                                "target_lang_sense_clarification": "to tell in a descriptive way"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "рассказывать",
                                "target_lang_sense_clarification": "повествовать о событиях или историях"
                            },
                            {
                                "target_lang_word": "сообщать",
                                "target_lang_sense_clarification": "передавать информацию или сведения"
                            },
                            {
                                "target_lang_word": "поведать",
                                "target_lang_sense_clarification": "рассказать что-то важное или личное"
                            }
                        ]
