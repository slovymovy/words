                    {
                        "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                        "entry_id": "56d4ce0d-3cbf-366a-af32-eb0e58bfa67e",
                        "glosses": [
                            "To generate intermediate frames in an animated sequence so as to give the appearance of smooth movement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a31fad7-29c3-4d02-b2e1-42beca29f533",
                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                "text": "The two most important and advanced ingredients of today's animation are tweening and morphing."
                            },
                            {
                                "example_id": "11f4dd77-d1c3-4007-93fc-383958573ba7",
                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                "text": "Simple motion tweening moves your objects in a straight line from here to there.[…]You can also combine frame-by-frame animation with tweened animation."
                            },
                            {
                                "example_id": "b88eba12-f797-49bd-88bc-249bf90713c2",
                                "sense_id": "9bbedc38-e76a-3237-a302-33e5174d222c",
                                "text": "The first parameter is the object that you want to tween, and the second parameter is the amount of time you want it to take in seconds."
                            }
                        ]
                    }
                ],
