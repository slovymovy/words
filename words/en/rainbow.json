                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker performed a perfect <w>rainbow</w> to get past the defender.",
                            "target_lang_translations": {
                                "ru": "Нападающий выполнил идеальную <w>радугу</w>, чтобы обойти защитника.",
                                "zh": "前锋完成了一个完美的<w>彩虹过人</w>动作，甩开了防守队员。"
                            }
