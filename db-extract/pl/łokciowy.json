                                    },
                                    {
                                        "sense_id": "8660c473-532f-3f01-bdcb-ae8bad760e70",
                                        "entry_id": "e2e93020-8e86-34cc-8f0b-5d1355515b43",
                                        "glosses": [
                                            "Du côté de la main ou de l’avant-bras proche de l’ulna."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90480c75-ae53-4f1c-9ac8-a88a7ad7fec0",
                                                "sense_id": "8660c473-532f-3f01-bdcb-ae8bad760e70",
                                                "text": "Statistiquement, c’est habituellement du côté ulnaire que cette artère dominante est retrouvée pour l’index et le troisième doigt, du côté radial pour les quatrième et cinquième doigts."
                                            },
                                            {
                                                "example_id": "da64c056-2793-4d09-9328-82188b0b95bb",
                                                "sense_id": "8660c473-532f-3f01-bdcb-ae8bad760e70",
                                                "text": "Le nerf ulnaire est parfois surnommé petit juif."
                                            },
                                            {
                                                "example_id": "08c21482-7483-40c0-a83d-1448fb80815c",
                                                "sense_id": "8660c473-532f-3f01-bdcb-ae8bad760e70",
                                                "text": "Le muscle fléchisseur ulnaire du carpe (anciennement appelé muscle cubital antérieur) est un muscle de la loge antérieur de l’avant-bras."
                                            },
                                            {
                                                "example_id": "cdcbd585-e27f-4014-894f-115d558fdfee",
                                                "sense_id": "8660c473-532f-3f01-bdcb-ae8bad760e70",
                                                "text": "Le muscle extenseur ulnaire du carpe (anciennement appelé muscle cubital postérieur) est un muscle de la loge postérieure de l’avant-bras."
                                            }
                                        ]
                                    }
                                ]
                            }
