                        "sense_id": "2f567640-5e0b-34a3-b83a-b1e291452d1d",
                        "entry_id": "e63c7912-edb9-337b-9289-479b3da62594",
                        "glosses": [
                            "Mitgliedschaft, die nur für eine einzelne Person gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41ea3b7-56b2-4f20-a825-d00638590158",
                                "sense_id": "2f567640-5e0b-34a3-b83a-b1e291452d1d",
                                "text": "„2016 hat man die Beiträge angehoben: von 18 auf 22 Euro für die Einzelmitgliedschaft und von 25 auf 30 Euro für Ehepaare; Jugendliche sind bis 18 Jahre frei.“"
                            },
                            {
                                "example_id": "a0931da1-45d7-4dff-b370-449863e39b1a",
                                "sense_id": "2f567640-5e0b-34a3-b83a-b1e291452d1d",
                                "text": "„Gutscheine gehen immer, aber es gibt Alternativen. Zum Beispiel eine schnelle Anmeldung als Mitglied im Kölnischen Kunstverein - für 52 Euro bekommt man eine Einzelmitgliedschaft, eine ermäßigte Mitgliedschaft gibt es für 20 Euro.“"
                            }
                        ],
