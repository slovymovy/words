                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c52772d3-f9ae-4fd2-81b7-01ef6b61afdb",
                                                "sense_id": "544d2279-6f5f-37c8-bf04-192a635e2d24",
                                                "text": "The sad stories of fire from heaven, the burning of his sheep, etc., […] were sad arrests to his troubled spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3960d20-aaf3-30d8-a0d9-fc9112c13714",
                                        "entry_id": "26495b91-2413-306f-a6ba-bbbff5281c5e",
