                        "sense_id": "597811e3-40ab-3f52-a8d6-fe9ddfe69804",
                        "entry_id": "6489025d-f542-35ad-a840-9359f3186cfc",
                        "glosses": [
                            "Very amusing; that entertains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1ec14b-3862-4049-b3d9-dc26264700cf",
                                "sense_id": "597811e3-40ab-3f52-a8d6-fe9ddfe69804",
                                "text": "The smiths themselves were a grand lot of fellows, full of a robust, and sometimes Rabelaisian sense of humour, and between \"heats,\" they could be most entertaining."
                            },
                            {
                                "example_id": "74537023-475f-4865-b593-687fc65b77c7",
                                "sense_id": "597811e3-40ab-3f52-a8d6-fe9ddfe69804",
                                "text": "Sunderland came back from two goals down to earn a point from an entertaining encounter with West Brom."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "353ba35c-1a3a-483c-8da9-122353e46722",
