                        "glosses": [
                            "haven waarin vooral handelsgoederen worden verwerkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75c8014d-79f7-43bc-8c8f-210e22ef1360",
                                "sense_id": "85612185-0b1a-3002-8dc2-9b1896b3f19b",
                                "text": "Ook in de handelshaven van het stadje heeft de sanering toegeslagen."
                            },
                            {
                                "example_id": "1f6f23f3-ae5f-4e8c-a73d-31d888f0f728",
                                "sense_id": "85612185-0b1a-3002-8dc2-9b1896b3f19b",
                                "text": "Drie dagen lang worden havenbeschermingsoefeningen uitgevoerd in de haven van Rotterdam. De Koninklijke Marine, Dienst Speciale Interventies (DSI), het Havenbedrijf Rotterdam, Politie eenheid Rotterdam en de Veiligheidsregio Rotterdam-Rijnmond werken samen om sterker op te kunnen treden bij acute dreiging. De bekende handelshaven wordt als goed oefenpunt beschouwd, omdat de haven een belangrijk aanvoerpunt is voor Europa. Morgen wordt de oefening afgesloten."
                            }
                        ]
                    }
