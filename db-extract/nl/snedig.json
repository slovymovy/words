                        "entry_id": "94e3f3bf-3129-3958-b620-a234a4931c20",
                        "glosses": [
                            "van opmerkingen dat ze snel gemaakt worden en op de situatie van toepassing zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7844d151-6b8e-409d-b95f-c0503bda1cb1",
                                "sense_id": "786ae106-a4a5-3dfa-8159-87751bd55e77",
                                "text": "Toen de dierenactivist klaagde over de onmenselijke behandeling van varkens, maakte de boer de snedige opmerking dat varkens geen mensen zijn."
                            },
                            {
                                "example_id": "99c3e59b-702b-48b4-87fc-078f860c477e",
                                "sense_id": "786ae106-a4a5-3dfa-8159-87751bd55e77",
                                "text": "Zo was Poulettes snedige journalistenjargon nu eenmaal en je moest niet lichtgeraakt zijn in haar gezelschap."
                            }
                        ]
                    }
