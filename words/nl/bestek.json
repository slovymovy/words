{
    "word_family": [
        "bestekbak",
        "besteklade"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "710d84b0-1e98-3f8d-9732-d98ca1e57b14",
                    "sense_definition": "De messen, vorken en lepels die men gebruikt om te eten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "eetgerei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil jij het <w>bestek</w> alvast op de tafel leggen voor het avondeten?",
                            "target_lang_translations": {
                                "en": "Would you mind putting the <w>cutlery</w> on the table for dinner already?"
                            }
                        },
                        {
                            "text": "Als je soep eet heb je alleen een lepel nodig als <w>bestek</w>.",
                            "target_lang_translations": {
                                "en": "If you eat soup, you only need a spoon as <w>cutlery</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "couvert"
                    ],
                    "common_phrases": [
                        "het bestek neerleggen",
                        "zilveren bestek"
                    ],
                    "target_lang_definitions": {
                        "en": "The knives, forks, and spoons used for eating."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cutlery",
                                "target_lang_sense_clarification": "eating utensils"
                            },
                            {
                                "target_lang_word": "silverware",
                                "target_lang_sense_clarification": "eating utensils, especially in US English"
                            },
                            {
                                "target_lang_word": "flatware",
                                "target_lang_sense_clarification": "eating utensils"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ae63526-d7a0-320f-b253-8a36a85d3609",
                    "sense_definition": "Een afgebakend plan, kader of de reikwijdte van een bepaalde opzet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kader_plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mochten wij de huidige maatregelen wijzigen, dan dient dat binnen het <w>bestek</w> van deze richtlijn te gebeuren.",
                            "target_lang_translations": {
                                "en": "Should we amend the current measures, this must be done within the <w>scope</w> of this directive."
                            }
                        },
                        {
                            "text": "Dit voorstel valt helaas buiten het <w>bestek</w> van ons huidige onderzoek.",
                            "target_lang_translations": {
                                "en": "Unfortunately, this proposal falls outside the <w>scope</w> of our current research."
                            }
                        }
                    ],
                    "synonyms": [
                        "kader"
                    ],
                    "common_phrases": [
                        "binnen het bestek van"
                    ],
                    "target_lang_definitions": {
                        "en": "A defined plan, framework, or the scope of a particular setup."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scope",
                                "target_lang_sense_clarification": "range of view, outlook, or application"
                            },
                            {
                                "target_lang_word": "framework",
                                "target_lang_sense_clarification": "a structure or set of rules"
                            },
                            {
                                "target_lang_word": "context",
                                "target_lang_sense_clarification": "the circumstances or setting"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1c0f465-acfd-39f0-bcc2-e083749421a6",
                    "sense_definition": "Een gedetailleerde beschrijving van een uit te voeren bouwwerk, inclusief materialen en voorwaarden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bouwplan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>bestek</w> was gelukkig op tijd klaar zodat men direct kon beginnen met bouwen.",
                            "target_lang_translations": {
                                "en": "Fortunately, the <w>specifications</w> were ready on time so that construction could begin immediately."
                            }
                        },
                        {
                            "text": "De aannemer bestudeerde het <w>bestek</w> nauwkeurig om de kosten te berekenen.",
                            "target_lang_translations": {
                                "en": "The contractor studied the <w>specifications</w> carefully to calculate the costs."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bestek en tekening"
                    ],
                    "target_lang_definitions": {
                        "en": "A detailed description of a construction project to be executed, including materials and conditions."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "specifications",
                                "target_lang_sense_clarification": "detailed description of construction requirements"
                            },
                            {
                                "target_lang_word": "specs",
                                "target_lang_sense_clarification": "informal term for specifications"
                            },
                            {
                                "target_lang_word": "bill of quantities",
                                "target_lang_sense_clarification": "document detailing materials and labor in construction"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "647e1462-ea40-33a1-9af8-1e01bf70cd8b",
                    "sense_definition": "De dagelijkse bepaling of berekening van de positie van een schip op zee.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "navigatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De stuurman hield nauwkeurig het <w>bestek</w> bij tijdens de storm.",
                            "target_lang_translations": {
                                "en": "The mate kept an accurate record of the <w>reckoning</w> during the storm."
                            }
                        },
                        {
                            "text": "Na de meting kon de kapitein het <w>bestek</w> op de kaart intekenen.",
                            "target_lang_translations": {
                                "en": "After the measurement, the captain was able to plot the <w>position</w> on the chart."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bestek opmaken"
                    ],
                    "target_lang_definitions": {
                        "en": "The daily determination or calculation of a ship's position at sea."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "day's work",
                                "target_lang_sense_clarification": "nautical calculation of a ship's position"
                            },
                            {
                                "target_lang_word": "reckoning",
                                "target_lang_sense_clarification": "calculation of a ship's position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}