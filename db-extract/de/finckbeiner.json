                ],
                "senses": [
                    {
                        "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                        "entry_id": "c33b3e98-bdc8-3271-b809-60ae167b6261",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e46db67a-734b-41d1-995a-2937e9263082",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Frau Finckbeiner ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ba8b25d5-585e-443e-9935-8afcb8bea5db",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Herr Finckbeiner wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1f6a5298-7bf3-4a39-ac35-3ea66f053601",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Die Finckbeiners fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d156fbdc-3721-4e86-870a-3b35dac17493",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Der Finckbeiner trägt nie die Schals, die die Finckbeiner ihm strickt."
                            },
                            {
                                "example_id": "bc5c95b1-d86f-4278-800a-dbb2684785e4",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finckbeiner kommt, geht der Herr Finckbeiner.“"
                            },
                            {
                                "example_id": "f5ac8350-3eeb-453a-ba00-d654bbe7418f",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Finckbeiner kommt und geht."
                            },
                            {
                                "example_id": "3ea52a75-ca09-40fe-9264-e46cb9f2c25b",
                                "sense_id": "4453599c-0c85-3ec1-a897-fb72bf67fe5c",
                                "text": "Finckbeiners kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
