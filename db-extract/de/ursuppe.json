                ],
                "senses": [
                    {
                        "sense_id": "25e38e84-5f96-3344-8231-c25aad570a10",
                        "entry_id": "e07fc4bc-b30a-3f65-90f0-893b9699f620",
                        "glosses": [
                            "das Wasser des Urozeans² mit allen darin gelösten organischen und anorganischen Stoffen, das als Medium für die präbiotisch-chemische und später auch für die biologische Evolution angesehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02612702-66a5-4658-9289-b9db880aeb54",
                                "sense_id": "25e38e84-5f96-3344-8231-c25aad570a10",
                                "text": "Das Leben, wie wir es kennen, ist wohl in der Ursuppe entstanden."
                            },
                            {
                                "example_id": "7f5b0863-86c8-404d-a3e1-d1440c05c211",
                                "sense_id": "25e38e84-5f96-3344-8231-c25aad570a10",
                                "text": "„Im Verlauf von Millionen Jahren wird der Regen chemische Stoffe ins Meer gespült haben, wo viele auf Kohlenstoff basierende Substanzen entstanden. Das Ergebnis war ein viel versprechendes Gebräu, die so genannte »Ursuppe«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43a2466f-e88c-4526-94d4-a5d0bdfc9da4",
                        "source_entry_id": "e07fc4bc-b30a-3f65-90f0-893b9699f620",
                        "source_sense_id": "25e38e84-5f96-3344-8231-c25aad570a10",
                        "target_lang_word": "primeval soup",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primeval soup",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab56aabe-6f46-3d7c-be54-96200a1cf6ae",
                                        "entry_id": "816a5ce0-305e-39b3-8fdc-ec0a6e7bb8e1",
                                        "glosses": [
                                            "The supposed liquid mixture of organic compounds which, under the influence of ultraviolet light, lightning etc., gave rise to the first self-replicating structures and, eventually, to life."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
