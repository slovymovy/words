                            {
                                "example_id": "d38021f6-d744-4edc-a2e4-061b71865343",
                                "sense_id": "61b1f3b4-e0d5-3bd6-8454-a08ffdd393db",
                                "text": "De getuige gaf geen juiste afspiegeling van wat er was gebeurd."
                            },
                            {
                                "example_id": "f1134a3b-3fc7-419d-a197-bfa6c53e4669",
                                "sense_id": "61b1f3b4-e0d5-3bd6-8454-a08ffdd393db",
                                "text": "Haar zwakke en deprimerende ‘oké’ was een lichte afspiegeling van de apathische toestand waarin ze zich ineens bevond."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0aae05a0-b7a7-4990-9598-caf3426eef0c",
                        "source_entry_id": "29bbd47f-bd82-39fb-8b4c-0f8c3c26d167",
                        "source_sense_id": "61b1f3b4-e0d5-3bd6-8454-a08ffdd393db",
                        "target_lang_word": "Widerspiegelung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Widerspiegelung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad536c31-0eb6-3a36-a5c0-e157445cfb20",
                                        "entry_id": "9cde7a8d-5b7c-31c9-a963-1991be0eee51",
                                        "glosses": [
                                            "Vorgang und Ergebnis des Reflektierens/Widerspiegelns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7bf56e6-607b-4dc2-aafc-fd1d18f28de6",
                                                "sense_id": "ad536c31-0eb6-3a36-a5c0-e157445cfb20",
                                                "text": "„Alle diese kunstvoll ausgeheckten Anschläge, die sich gegenseitig durchkreuzten und verwirrten, waren nichts anderes als die getreue Widerspiegelung dessen, was zwangsmässig geschehen musste, in den höchsten Sphären der Armee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "594e6fbf-b964-4aad-bd22-5d50140b2e9c",
                        "source_entry_id": "29bbd47f-bd82-39fb-8b4c-0f8c3c26d167",
                        "source_sense_id": "61b1f3b4-e0d5-3bd6-8454-a08ffdd393db",
                        "target_lang_word": "reflection",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reflection",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d9a05a6-f1de-3e95-a0d3-835f5c2c48b8",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The act of reflecting or the state of being reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04accaef-5b08-3a53-8d65-2dc9e3f535d9",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The property of a propagated wave being thrown back from a surface (such as a mirror)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Something, such as an image, that is reflected."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f049bd06-037c-4698-8e82-5855b570b943",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "The dog barked at his own reflection in the mirror."
                                            },
                                            {
                                                "example_id": "fada00df-0069-4381-b16b-ac431e3f859f",
                                                "sense_id": "39485565-099e-387b-8983-6531d2e54442",
                                                "text": "A body of black that carried no reflection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "Careful thought or consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "642fc9da-1073-467f-bfcc-1aca32e4159d",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "After careful reflection, I have decided not to vote for that proposition."
                                            },
                                            {
                                                "example_id": "c2e42dd5-b911-4dc2-a15a-9dfd14287fe4",
                                                "sense_id": "2e446014-0858-36e7-927d-d2a836500b52",
                                                "text": "But Richmond, his grandfather's darling, after one thoughtful glance cast under his lashes at that uncompromising countenance appeared to lose himself in his own reflections."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5a0e80-9377-4914-80f6-d2ca735cab39",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Our recent results are a reflection of the progress we've made as a team."
                                            },
                                            {
                                                "example_id": "8596d24a-1480-4e82-a4ed-e8d67d373d28",
                                                "sense_id": "2a98e8b6-ce5f-31c8-a788-5ab948a3763a",
                                                "text": "Zuckerberg said last month that the name change was a reflection of how much Facebook had evolved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "A representative manifestation or outcome of a condition, trend or trait.",
                                            "Used to make an implied criticism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "209d4a4b-ef36-4d22-b4b1-6eb9e33dd7fb",
                                                "sense_id": "26e47bea-06fc-3804-b69c-ca70c2b863e7",
                                                "text": "It is a reflection on his character that he never came back to see them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The process or mechanism of determining the capabilities of an object at run-time."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f713b35-1477-44de-b3e2-dc9a724c2e46",
                                                "sense_id": "f635385d-64fa-3950-b7fc-1b034fca1fba",
                                                "text": "DynamicMBeanFacade uses Java's reflection API to introspect the managed resource and discover data type information for attributes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e18a4f05-9b6e-31d4-8594-bd0377670c51",
                                        "entry_id": "833323a2-eeda-3812-b036-8ae358f52c9d",
                                        "glosses": [
                                            "The folding of a part; a fold."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c31c7361-d6ea-4fde-9cb8-3759c538c311",
                        "source_entry_id": "29bbd47f-bd82-39fb-8b4c-0f8c3c26d167",
                        "source_sense_id": "61b1f3b4-e0d5-3bd6-8454-a08ffdd393db",
                        "target_lang_word": "réflexion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réflexion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2b111a-9abc-3c65-b82b-72cad8f67f6c",
                                        "entry_id": "8755c224-ea8e-38a6-9a05-f8ab5e9377ee",
                                        "glosses": [
                                            "Phénomène par lequel les rayons lumineux, caloriques, les ondes sonores, lorsqu’ils rencontrent une surface, sont renvoyés dans une autre direction."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67c186ed-7c3e-44b8-b419-180c2c2205c4",
                                                "sense_id": "ef2b111a-9abc-3c65-b82b-72cad8f67f6c",
                                                "text": "Un peu plus tard j’aperçus dans le sud un merveilleux reflet vert qui était la réflexion dans le ciel du peu profond lagon de l’atoll d’Anaa, le plus peuplé du groupe."
                                            },
                                            {
                                                "example_id": "38721822-cb4e-466c-a6d4-c10e68b6f099",
                                                "sense_id": "ef2b111a-9abc-3c65-b82b-72cad8f67f6c",
                                                "text": "La réflexion des rayons lumineux. La réflexion du son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6a7ee5-85c1-3d55-9f5b-5fd1add78103",
                                        "entry_id": "8755c224-ea8e-38a6-9a05-f8ab5e9377ee",
                                        "glosses": [
                                            "Transformation de symétrie orthogonale, analogique au sens 1."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ae603c-f298-4fcc-83c6-d8e406ffa606",
                                                "sense_id": "2d6a7ee5-85c1-3d55-9f5b-5fd1add78103",
                                                "text": "Parmi les symétries courantes, on peut citer la réflexion (ou symétrie orthogonale) et la symétrie centrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                        "entry_id": "8755c224-ea8e-38a6-9a05-f8ab5e9377ee",
                                        "glosses": [
                                            "Action de l’esprit qui réfléchit, méditation sérieuse, considération attentive sur quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5472141-3fab-4428-9d6f-720afbace07c",
                                                "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                                "text": "Elle était heureuse simplement, sans réflexion et sans autre désir que celui de voir son bonheur durer éternellement."
                                            },
                                            {
                                                "example_id": "01eb2084-01e6-44b6-8d58-90e33266f203",
                                                "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                                "text": "Sur le chemin du retour, vers notre maison, je musardai pour me donner loisir de la réflexion."
                                            },
                                            {
                                                "example_id": "090e8621-5e93-4fd7-8029-7c8b65dd8d62",
                                                "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                                "text": "Toute augmentation de l’activité réflexive, stimule, par nature, les tendances schizoïdes. La réflexion est un isolement."
                                            },
                                            {
                                                "example_id": "218a75ea-c605-44c0-945d-feb091b365f5",
                                                "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                                "text": "La question était si importante qu'elle méritait réflexion. Certes, je savais où j'allais, mais devais-je le lui dire ?"
                                            },
                                            {
                                                "example_id": "c0b2c049-2d30-4ff9-9ea8-3d049cf5493c",
                                                "sense_id": "2259df5a-99f8-355d-b5f5-c2da5d4056a3",
                                                "text": "— […]. En fait elle est aussi nulle que toi.\nBennett réfléchit quelques temps, en se demandant comment on quantifiait la nullité.\n— Peut-être même encore plus nulle, dit-il au bout d'un moment de réflexion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ca1e60a-ecf7-3422-aaae-7fd7ec82df7b",
                                        "entry_id": "8755c224-ea8e-38a6-9a05-f8ab5e9377ee",
                                        "glosses": [
                                            "Pensée qui résulte de cette action de l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43900198-1704-471a-9ab1-bb4a29ab9ccb",
                                                "sense_id": "2ca1e60a-ecf7-3422-aaae-7fd7ec82df7b",
                                                "text": "Il y avait beau temps, au lavoir communal ou sous les auvents d’aisseaux qu’on échangeait d’oreille à oreille de petites réflexions et qu’on se faisait part d’observations particulières […]"
                                            },
                                            {
                                                "example_id": "358a4aa6-a2e2-4cc5-9d80-f66c91509c08",
                                                "sense_id": "2ca1e60a-ecf7-3422-aaae-7fd7ec82df7b",
                                                "text": "Protiste en m’entendant divaguer de la sorte, il s’est fait la réflexion que je venais sûrement de retomber malade."
                                            },
                                            {
                                                "example_id": "97370087-fb6c-4f96-8f4e-476a32b59741",
                                                "sense_id": "2ca1e60a-ecf7-3422-aaae-7fd7ec82df7b",
                                                "text": "Cette réflexion, parce qu’elle me paraît naturelle et paraîtra telle à tous les plébéiens de l’armée, sera affligeante pour nos beaux Messieurs s’ils me lisent."
                                            },
                                            {
                                                "example_id": "b6ae2d3b-7ebc-4e9f-91d3-c339071d64eb",
                                                "sense_id": "2ca1e60a-ecf7-3422-aaae-7fd7ec82df7b",
                                                "text": "Pour la énième fois, je me fis la réflexion que, depuis un certain temps, je brûlais la chandelle par les deux bouts. En fait, j’étais au bord du surmenage professionnel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a00772be-bc58-3ae2-9bb1-f6adc1a9c1a4",
                                        "entry_id": "8755c224-ea8e-38a6-9a05-f8ab5e9377ee",
                                        "glosses": [
                                            "Capacité d’un programme à examiner sa propre structure, voire à s’auto-modifier lors de son exécution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbad86c5-150d-4fb6-8545-5ad78633d0ac",
                                                "sense_id": "a00772be-bc58-3ae2-9bb1-f6adc1a9c1a4",
                                                "text": "La réflexion structurelle consiste à réifier le code d’un programme et tous les types abstraits accessibles par ce programme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
