                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обступа́вши"
                    },
                    {
                        "form_id": "50cb84b9-6297-49ea-b88e-d7df03a56714",
                        "entry_id": "23fe295d-73e7-3b4a-85fb-528cbf9a4d36",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… обступа́ть"
