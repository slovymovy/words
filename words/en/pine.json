{
    "word_family": [
        "piney",
        "pinewood",
        "pineapple",
        "piny"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "327d5e5a-492a-3629-90c5-f815efc3b4f4",
                    "sense_definition": "Any coniferous evergreen tree of the genus Pinus, typically having needle-shaped leaves and producing cones.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "botany_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The northern slopes of the mountain were covered mainly in <w>pine</w>.",
                            "target_lang_translations": {
                                "ru": "Северные склоны горы были покрыты в основном <w>сосной</w>.",
                                "zh": "山的北坡主要覆盖着<w>松树</w>。"
                            }
                        },
                        {
                            "text": "We sat under a tall <w>pine</w> tree to escape the hot afternoon sun.",
                            "target_lang_translations": {
                                "ru": "Мы сидели под высокой <w>сосной</w>, спасаясь от жаркого полуденного солнца.",
                                "zh": "我们坐在高大的<w>松树</w>下，躲避午后炎热的阳光。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pine tree"
                    ],
                    "common_phrases": [
                        "pine forest",
                        "pine cone",
                        "pine needles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Род вечнозеленых хвойных деревьев, обычно имеющих игловидные листья и шишки.",
                        "zh": "松属的常绿针叶树，通常有针状叶和球果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосна",
                                "target_lang_sense_clarification": "дерево"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松树",
                                "target_lang_sense_clarification": "树木"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cac603b1-a2c7-3e16-bca5-7ed150b1fce8",
                    "sense_definition": "The soft, light-colored wood obtained from a pine tree, often used for making furniture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "botany_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a simple kitchen table made of knotty <w>pine</w>.",
                            "target_lang_translations": {
                                "ru": "Она купила простой кухонный стол из сучковатой <w>сосны</w>.",
                                "zh": "她买了一张用多节<w>松木</w>做的简易餐桌。"
                            }
                        },
                        {
                            "text": "The floorboards were made of <w>pine</w> and creaked whenever we walked on them.",
                            "target_lang_translations": {
                                "ru": "Половицы были сделаны из <w>сосны</w> и скрипели всякий раз, когда мы по ним ходили.",
                                "zh": "地板是用<w>松木</w>做的，我们走在上面时总是吱吱作响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pinewood"
                    ],
                    "common_phrases": [
                        "pine furniture",
                        "knotty pine",
                        "pine table"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая светлая древесина сосны, часто используемая для изготовления мебели.",
                        "zh": "从松树上获取的浅色软木，常用于制作家具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сосна",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松木",
                                "target_lang_sense_clarification": "木材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3fd4cb3-36d7-3861-a24c-ebb07da6a7b1",
                    "sense_definition": "The bench where sports players sit when they are not playing in the game.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The injured player had to ride the <w>pine</w> for the rest of the season.",
                            "target_lang_translations": {
                                "ru": "Травмированному игроку пришлось полировать <w>скамейку запасных</w> до конца сезона.",
                                "zh": "受伤的球员本赛季剩下的时间只能坐<w>冷板凳</w>。"
                            }
                        },
                        {
                            "text": "If you don't practice hard, you will end up sitting on the <w>pine</w> during the finals.",
                            "target_lang_translations": {
                                "ru": "Если не будешь усердно тренироваться, в финале будешь сидеть на <w>скамейке запасных</w>.",
                                "zh": "如果你不刻苦训练，决赛时你就只能坐<w>冷板凳</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ride the pine",
                        "hit the pine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Скамейка, на которой сидят игроки, когда не участвуют в игре.",
                        "zh": "体育比赛中替补队员坐的席位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скамейка запасных",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冷板凳",
                                "target_lang_sense_clarification": "体育俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0fe5d5c-9750-3f0d-9c2c-b5c7805f82dc",
                    "sense_definition": "A pineapple.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In older literature, a pineapple was often simply referred to as a <w>pine</w>.",
                            "target_lang_translations": {
                                "ru": "В старой литературе ананас часто называли просто <w>ананасом</w> (pine).",
                                "zh": "在旧文学中，<w>菠萝</w>常被简称为pine。"
                            }
                        },
                        {
                            "text": "She placed the exotic <w>pine</w> on the table as a centerpiece for the feast.",
                            "target_lang_translations": {
                                "ru": "Она поставила экзотический <w>ананас</w> на стол в качестве главного украшения пира.",
                                "zh": "她把那个异国情调的<w>菠萝</w>放在桌子中央，作为宴席的装饰。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "short for pineapple"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ананас.",
                        "zh": "菠萝（旧称）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ананас",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菠萝",
                                "target_lang_sense_clarification": "水果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f03c95d-b49a-31c9-8d41-92c08c96eee8",
                    "sense_definition": "A bar counter or bartop.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender stood behind the <w>pine</w> serving drinks to the customers.",
                            "target_lang_translations": {
                                "ru": "Бармен стоял за <w>стойкой</w>, разливая напитки клиентам.",
                                "zh": "酒保站在<w>吧台</w>后为顾客倒酒。"
                            }
                        },
                        {
                            "text": "I'll be working behind the <w>pine</w> all night, so come say hello.",
                            "target_lang_translations": {
                                "ru": "Я буду работать за <w>стойкой</w> всю ночь, так что заходи поздороваться.",
                                "zh": "我整晚都会在<w>吧台</w>工作，过来打个招呼吧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "behind the pine"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Барная стойка.",
                        "zh": "酒吧的柜台。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барная стойка",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吧台",
                                "target_lang_sense_clarification": "酒吧设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0543c561-f38a-374a-bac0-16e41264f88a",
                    "sense_definition": "A feeling of painful longing or deep sadness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>pine</w> for her homeland after being away for so many years.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала глубокую <w>тоску</w> по родине, прожив столько лет вдали.",
                                "zh": "离家多年后，她对故乡感到深深的<w>思念</w>。"
                            }
                        },
                        {
                            "text": "The song expressed the <w>pine</w> of a lover who had been left behind.",
                            "target_lang_translations": {
                                "ru": "Песня выражала <w>тоску</w> возлюбленного, которого бросили.",
                                "zh": "这首歌表达了被抛弃的恋人内心的<w>思念</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "longing",
                        "yearning"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство мучительной тоски или глубокой печали.",
                        "zh": "一种痛苦的渴望或深沉的悲伤感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тоска",
                                "target_lang_sense_clarification": "чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "思念",
                                "target_lang_sense_clarification": "情感"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "edad779d-1320-3bad-a78a-90cf5004a2e4",
                    "sense_definition": "To feel a very strong desire or sadness because you miss someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laura was <w>pining</w> for her boyfriend all the time he was away at college.",
                            "target_lang_translations": {
                                "ru": "Лора <w>тосковала</w> по своему парню всё то время, пока он был в колледже.",
                                "zh": "劳拉在男友上大学期间一直都在<w>想念</w>他。"
                            }
                        },
                        {
                            "text": "He continued to <w>pine</w> for the days when he was young and carefree.",
                            "target_lang_translations": {
                                "ru": "Он продолжал <w>тосковать</w> по тем дням, когда был молод и беззаботен.",
                                "zh": "他依然<w>渴望</w>回到年轻时无忧无虑的日子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "yearn",
                        "long"
                    ],
                    "common_phrases": [
                        "pine for",
                        "pine over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать очень сильное желание или грусть из-за того, что вы скучаете по кому-то или чему-то.",
                        "zh": "因思念某人或某物而感到强烈的渴望或忧伤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тосковать",
                                "target_lang_sense_clarification": "скучать"
                            },
                            {
                                "target_lang_word": "изнывать",
                                "target_lang_sense_clarification": "сильно желать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "想念",
                                "target_lang_sense_clarification": "思念"
                            },
                            {
                                "target_lang_word": "渴望",
                                "target_lang_sense_clarification": "强烈愿望"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3398fa03-a34c-381a-afe5-0969739bc177",
                    "sense_definition": "To become weak, lose health, or waste away, often due to intense sadness or distress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion_pine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without sunlight and water, the plant began to <w>pine</w> and wither.",
                            "target_lang_translations": {
                                "ru": "Без солнечного света и воды растение начало <w>чахнуть</w> и вянуть.",
                                "zh": "没有阳光和水，植物开始<w>枯萎</w>凋谢。"
                            }
                        },
                        {
                            "text": "The prisoner seemed to <w>pine</w> away in the dark, damp cell.",
                            "target_lang_translations": {
                                "ru": "Казалось, заключенный <w>угасал</w> в темной сырой камере.",
                                "zh": "囚犯似乎在阴暗潮湿的牢房里日渐<w>憔悴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "languish",
                        "droop"
                    ],
                    "common_phrases": [
                        "pine away"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слабеть, терять здоровье или угасать, часто из-за сильной печали или страданий.",
                        "zh": "因极度悲伤或痛苦而变得虚弱、消瘦或衰竭。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чахнуть",
                                "target_lang_sense_clarification": "слабеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "憔悴",
                                "target_lang_sense_clarification": "因忧虑而消瘦"
                            },
                            {
                                "target_lang_word": "枯萎",
                                "target_lang_sense_clarification": "指植物或人的衰竭"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7c6f6fdc-3f22-30c0-be4e-3a82c910671c",
                    "sense_definition": "A surname.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pine</w> is the new mathematics teacher at our local high school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Пайн</w> — новый учитель математики в нашей местной средней школе.",
                                "zh": "<w>派恩</w>先生是我们当地高中的新数学老师。"
                            }
                        },
                        {
                            "text": "I have an appointment with Dr. <w>Pine</w> tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "У меня прием у доктора <w>Пайна</w> завтра утром.",
                                "zh": "我明天早上预约了<w>派恩</w>医生。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пайн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "派恩",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}