                        "sense_id": "21bd4231-1b88-36b9-a0fe-2f35ff1ff8bf",
                        "entry_id": "c4d5df6c-6b21-347a-996d-9048a0f22ead",
                        "glosses": [
                            "Qui est relatif à une adjudication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2f99e16-34c0-44f3-9338-2987ff1e5c4b",
                                "sense_id": "21bd4231-1b88-36b9-a0fe-2f35ff1ff8bf",
                                "text": "Si le pouvoir adjudicateur décide de déclarer la procédure sans suite pour cause d’infructuosité, il choisit alors en toute opportunité entre l'organisation d'une nouvelle procédure d'appel d'offres et le recours à la procédure avec négociation ou le dialogue compétitif."
                            }
                        ]
                    }
