                    {
                        "translation_id": "6f0385f5-ad3e-4845-a4ca-d7430c2e3432",
                        "source_entry_id": "7257f043-b2af-385d-9015-5e95d9f05326",
                        "source_sense_id": "346cb7e1-4406-32ea-b10f-a46229ba8de5",
