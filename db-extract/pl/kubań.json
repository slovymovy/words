                    },
                    {
                        "translation_id": "21b5dd0c-b224-4167-a459-47c533068b68",
                        "source_entry_id": "78c8c0be-f8c9-3015-b756-30ef6dcc67af",
                        "source_sense_id": "36facd3d-f113-36bc-8c1d-550a6d62de9e",
                        "target_lang_word": "Kubáň",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5386f9bc-0a39-4e9e-be84-fc73143ef920",
                        "source_entry_id": "78c8c0be-f8c9-3015-b756-30ef6dcc67af",
                        "source_sense_id": "36facd3d-f113-36bc-8c1d-550a6d62de9e",
                        "target_lang_word": "Kouban",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kouban",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "432b7c53-fe07-3734-bbe4-29973fc34430",
                                        "entry_id": "22f4f8a9-2471-39d9-8b22-661751431f02",
                                        "glosses": [
                                            "Fleuve se jetant dans la mer Noire, situé au nord du Caucase et à l’est de la mer d’Azov."
                                        ],
                                        "tags": [
                                            "Cours d’eau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a768732b-8040-4ff1-807d-3bf6c46c708b",
                                                "sense_id": "432b7c53-fe07-3734-bbe4-29973fc34430",
                                                "text": "De l’Ukraine occidentale au Kazakhstan, en passant par la Volga et le Kouban (Russie), des millions de personnes succombent dans un total huis clos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f85fe1f2-89b6-3f07-896d-f3cf579b526f",
                                        "entry_id": "22f4f8a9-2471-39d9-8b22-661751431f02",
                                        "glosses": [
                                            "Région drainée par ce fleuve."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ed6ca28-42cc-4046-8c8d-0d96dc3715a9",
                                                "sense_id": "f85fe1f2-89b6-3f07-896d-f3cf579b526f",
                                                "text": "La collectivisation stalinienne, prévue dans le premier Plan quinquennal (1928-1932) comprend une campagne de dékoulakisation qui a amené la déportation, l’incarcération, et la mort, par famine, de cinq millions de paysans, particulièrement en Ukraine et dans le Kouban."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63e1b346-ba98-4928-9391-7944602137c2",
                        "source_entry_id": "78c8c0be-f8c9-3015-b756-30ef6dcc67af",
                        "source_sense_id": "36facd3d-f113-36bc-8c1d-550a6d62de9e",
                        "target_lang_word": "Kuban",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuban",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7f4ce81-7dba-3247-9f32-9fa2655b7200",
                                        "entry_id": "aafab82d-ffb2-3f74-9872-ffba829e0c5b",
                                        "glosses": [
                                            "dem Elbrus entspringender und ins Asowsche Meer mündender, rund 870 Kilometer langer Fluss im nördlichen Kaukasus, Russland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a8f3e69-b105-41f5-8517-363703e799d9",
                                                "sense_id": "c7f4ce81-7dba-3247-9f32-9fa2655b7200",
                                                "text": "„Mit gut 200.000 deutschen und rumänischen Soldaten erreichte die 17. Armee im März 1943 das Mündungsgebiet des Kubans am Ostufer des Asowschen Meeres, dem das Führerhauptquartier in Erinnerung an das antike Siedlungsgebiet der Goten den hochtrabenden Namen ‚Gotenkopf‘ gegeben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09904cb-90c9-4ea0-8678-713aeaef6b36",
                        "source_entry_id": "78c8c0be-f8c9-3015-b756-30ef6dcc67af",
                        "source_sense_id": "36facd3d-f113-36bc-8c1d-550a6d62de9e",
                        "target_lang_word": "Кубань",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Кубань",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb5f08b-2d8d-34be-ac28-3c4235f47fa8",
                                        "entry_id": "de31ba42-24c8-30eb-9468-f2e570089af3",
                                        "glosses": [
                                            "река, одна из самых крупных водных артерий Кавказа, берущая начало на северо-западных склонах горы Эльбрус из слияния рек Учкулан и Уллукам, впадающая в Азовское море в Темрюкском районе Краснодарского края, протекающая по территориям Карачаево-Черкесии, Ставропольского и Краснодарского краёв"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f679d1b-1fd6-45c4-a7ae-eb93e6c81dd5",
                                                "sense_id": "8bb5f08b-2d8d-34be-ac28-3c4235f47fa8",
                                                "text": "За Мышиной тропой ― кабардинский аул Хумаринский, а за ним ― осетинский аул Георгиевско-Осетинский, на левом берегу Кубани, около впадения в Кубань её левого притока Теберды и правого Мары."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cb55d20-1047-371d-ac2e-dcc1a894dc5e",
                                        "entry_id": "de31ba42-24c8-30eb-9468-f2e570089af3",
                                        "glosses": [
                                            "истор. историческая область ХIХ начала XX в. на Северном Кавказе в долине реки Кубань 1 и её притоков, на территории современного Краснодарского края и Республики Адыгея"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a9ff96e-b48e-4fd3-810b-d82a5719507a",
                                                "sense_id": "9cb55d20-1047-371d-ac2e-dcc1a894dc5e",
                                                "text": "Видно, враг оставляет всю Кубань и бежит без задержки к Ростову."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "130c3221-751d-34b3-86bd-dbaa64c8788d",
                                        "entry_id": "de31ba42-24c8-30eb-9468-f2e570089af3",
                                        "glosses": [
                                            "разг. Краснодарский край"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6bf70d-8e13-4d53-be98-ffb850746425",
                                                "sense_id": "130c3221-751d-34b3-86bd-dbaa64c8788d",
                                                "text": "Одновременно губернатор Кубани напрочь отказался от планов «реэмиграции» армян в Армению, озвученных его заместителем Леонидом Баклицким на мартовском совещании в Абинске."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
