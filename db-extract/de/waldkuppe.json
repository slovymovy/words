                                "example_id": "40ad9452-0961-40ab-aa7a-f7d605697de0",
                                "sense_id": "38aee22f-f897-39b9-9628-1e0b51441558",
                                "text": "„Zwiebeltürme und weißfingrige Spitztürme mit Schieferlanzen ragen über die Waldkuppen.“"
                            }
