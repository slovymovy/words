                                "target_senses": [
                                    {
                                        "sense_id": "d70e0f44-d547-301a-b826-987b53a1b7fc",
                                        "entry_id": "8df7403c-c0e2-3638-a55c-ab026c9ccc05",
                                        "glosses": [
                                            "A car of this brand, reputably high-performance and expensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4929c177-d7ae-44bf-a961-32171208aedc",
                                                "sense_id": "d70e0f44-d547-301a-b826-987b53a1b7fc",
                                                "text": "Mom drives an Accord, which is quite a surprise if you think about it. I guess that says something about her response to fame. Anyone can drive a Porsche once they have the cash."
                                            },
                                            {
                                                "example_id": "4e8083b5-4963-4c93-adff-38d5510d3c12",
                                                "sense_id": "d70e0f44-d547-301a-b826-987b53a1b7fc",
                                                "text": "a male undergoing a garden-variety mid-life crisis is disturbed not by his sexual appetites but by the lack of variety in his sexual partners. He is disturbed not by the crass materialism of his life but by the fact that he is still driving a Ford when he could and should be driving a Porsche."
                                            },
                                            {
                                                "example_id": "b7bb0d74-8e1a-4424-a1a5-b78fa6e89db0",
                                                "sense_id": "d70e0f44-d547-301a-b826-987b53a1b7fc",
                                                "text": "I'm unstoppable / I'm a Porsche with no brakes / I'm invincible / Yeah, I win every single game"
                                            },
                                            {
                                                "example_id": "2dfece5a-fb9d-4188-ac85-d215609a4d0f",
                                                "sense_id": "d70e0f44-d547-301a-b826-987b53a1b7fc",
                                                "text": "I don't really want a white horse and carriage / I'm thinkin' more of white Porsches and karats"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
