                                    },
                                    {
                                        "sense_id": "b31ecbde-f842-3948-af04-82306ad171ff",
                                        "entry_id": "11543702-251d-387d-8292-589573daacf6",
                                        "glosses": [
                                            "To hunt at night using a lamp, during which bright lights are used to dazzle the hunted animal or to attract insects for capture."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6def0fa4-47f2-3acd-b5d0-d10398863dc4",
                                        "entry_id": "11543702-251d-387d-8292-589573daacf6",
                                        "glosses": [
                                            "To hang out or chill; to do nothing in particular."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e939a17c-6345-4d0c-85a3-3e3e2b1b96a2",
                                                "sense_id": "6def0fa4-47f2-3acd-b5d0-d10398863dc4",
                                                "text": "I'm in my Flavmobile cold lamping. I took a G upstate cold camping. To the Poconos, we call a hideaways. A bag of franks and a bag of Frito-Lays."
                                            }
                                        ]
                                    },
                                    {
