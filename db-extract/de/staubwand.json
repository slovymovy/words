                    {
                        "sense_id": "fdfb1680-2609-3cf0-9d7a-1ecc4a549979",
                        "entry_id": "4412dac8-4141-34f3-b346-d3dad28049cf",
                        "glosses": [
                            "eine Wand, die zum Schutz gegen Staubimmissionen errichtet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a832a2c-27bb-47b1-a88a-efe7d9bf0b5c",
                                "sense_id": "fdfb1680-2609-3cf0-9d7a-1ecc4a549979",
                                "text": "„Dann wird eine sogenannte Staubwand errichtet, eine Wand aus Pressspanplatten, vor der werden die Bücherregale wieder aufgebaut und die Bücher wieder eingeräumt.“"
                            },
                            {
                                "example_id": "1bc6adad-ca36-420a-9649-bbe8709d5496",
                                "sense_id": "fdfb1680-2609-3cf0-9d7a-1ecc4a549979",
                                "text": "„Ihre rostbraunen Staubwände und die für Besucher begehbaren Siloeinbuchtungen erzeugen das gewünschte Spannungsverhältnis zwischen den UrbanArt-Kunstwerken und der rauen Industriearchitektur des Eisenwerks.“"
                            }
                        ],
