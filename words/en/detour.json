{
    "word_family": [
        "detourist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7710e994-c968-3666-93f6-87aa5662dcf5",
                    "sense_definition": "A temporary alternative route used when the usual road is closed for repairs or blocked.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "route_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>detour</w> because of the road construction ahead.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось поехать в <w>объезд</w> из-за дорожных работ впереди."
                            }
                        },
                        {
                            "text": "The GPS suggested a quick <w>detour</w> to avoid the heavy traffic on the highway.",
                            "target_lang_translations": {
                                "ru": "GPS предложил быстрый <w>объезд</w>, чтобы избежать плотного движения на шоссе."
                            }
                        }
                    ],
                    "synonyms": [
                        "diversion",
                        "bypass"
                    ],
                    "common_phrases": [
                        "take a detour",
                        "scenic detour",
                        "road closed detour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Временный альтернативный маршрут, используемый, когда обычная дорога закрыта на ремонт или заблокирована."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объезд",
                                "target_lang_sense_clarification": "альтернативный путь для транспорта"
                            },
                            {
                                "target_lang_word": "обход",
                                "target_lang_sense_clarification": "путь в обход препятствия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93184537-78fa-34ae-8494-247263e00b16",
                    "sense_definition": "A deviation from a direct course or original route.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "route_deviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During our walk home, we made a slight <w>detour</w> through the park to see the flowers.",
                            "target_lang_translations": {
                                "ru": "По дороге домой мы сделали небольшой <w>крюк</w> через парк, чтобы посмотреть на цветы."
                            }
                        },
                        {
                            "text": "His career path took a major <w>detour</w> when he decided to study art instead of law.",
                            "target_lang_translations": {
                                "ru": "Его карьерный путь сделал крутой <w>поворот</w>, когда он решил изучать искусство вместо юриспруденции."
                            }
                        }
                    ],
                    "synonyms": [
                        "deviation",
                        "digression"
                    ],
                    "common_phrases": [
                        "make a detour",
                        "slight detour"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отклонение от прямого курса или первоначального маршрута."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крюк",
                                "target_lang_sense_clarification": "лишнее расстояние при движении окольным путем"
                            },
                            {
                                "target_lang_word": "окольный путь",
                                "target_lang_sense_clarification": "дорога в обход"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "смена направления или курса"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "98549335-cc00-31c2-9500-1fd30476614a",
                    "sense_definition": "To travel by an alternative, longer route instead of the direct one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_detour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>detour</w> around the flooded area to reach the hotel safely.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось <w>объехать</w> затопленный район, чтобы благополучно добраться до отеля."
                            }
                        },
                        {
                            "text": "The hikers decided to <w>detour</w> through the forest to avoid the steep hill.",
                            "target_lang_translations": {
                                "ru": "Пешие туристы решили <w>обойти</w> крутой холм через лес."
                            }
                        }
                    ],
                    "synonyms": [
                        "deviate",
                        "bypass"
                    ],
                    "common_phrases": [
                        "detour around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться по альтернативному, более длинному маршруту вместо прямого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объезжать",
                                "target_lang_sense_clarification": "ехать в обход"
                            },
                            {
                                "target_lang_word": "объехать",
                                "target_lang_sense_clarification": "совершить объезд"
                            },
                            {
                                "target_lang_word": "делать крюк",
                                "target_lang_sense_clarification": "идти или ехать более длинным путем"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9eb5bd5e-42ea-3c4e-aa74-cc04600660ae",
                    "sense_definition": "To direct or send traffic or people along an alternative route.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to_detour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police officers were stationed at the intersection to <w>detour</w> traffic away from the accident.",
                            "target_lang_translations": {
                                "ru": "На перекрестке дежурили полицейские, чтобы <w>направлять</w> транспорт в объезд места аварии."
                            }
                        },
                        {
                            "text": "The city plans to <w>detour</w> buses during the annual street festival next weekend.",
                            "target_lang_translations": {
                                "ru": "В следующие выходные во время ежегодного уличного фестиваля город планирует <w>пустить</w> автобусы в объезд."
                            }
                        }
                    ],
                    "synonyms": [
                        "divert",
                        "reroute"
                    ],
                    "common_phrases": [
                        "detour traffic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Направлять движение транспорта или людей по альтернативному маршруту."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "направлять в обход",
                                "target_lang_sense_clarification": "пускать транспорт по другому пути"
                            },
                            {
                                "target_lang_word": "пустить в объезд",
                                "target_lang_sense_clarification": "перенаправить движение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}