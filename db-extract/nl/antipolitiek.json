                        "sense_id": "b42946db-bc4d-3015-a003-760f6a5bf148",
                        "entry_id": "627874bd-94c3-37d0-8551-9937074d068e",
                        "glosses": [
                            "tegen de gewone politieke manier van doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a66d3b1-a08b-4154-b40c-36cb0d0b4e29",
                                "sense_id": "b42946db-bc4d-3015-a003-760f6a5bf148",
                                "text": "Hij denkt dat de oproep tot burgerlijke ongehoorzaamheid luider is dan ooit. \"De antipolitieke gevoelens zijn er niet minder om geworden.\""
                            },
                            {
                                "example_id": "116c871d-8961-4be2-857b-a809c8230a1b",
                                "sense_id": "b42946db-bc4d-3015-a003-760f6a5bf148",
                                "text": "\"Het gaat niet om rechts of links. Het is antipolitiek\", stelt hij. \"We zien kiezers die bereid zijn op een onorthodox figuur te stemmen, buiten het partijkader, omdat ze een alternatief zoeken. Dat leidt tot onvoorspelbaarheid in de politiek.\""
                            }
                        ]
                    }
