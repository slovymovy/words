                ],
                "senses": [
                    {
                        "sense_id": "62eb31c2-e32a-36d1-bba1-b435705846e8",
                        "entry_id": "13174a83-5eb7-35eb-8e41-00a3571005da",
                        "glosses": [
                            "die Uhrzeit oder der Zeitpunkt, zu der jemand, oder auch ein Zug, ein Flugzeug oder Ähnliches irgendwo fahrplanmäßig ankommt beziehungsweise ankommen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40bb9364-a934-45de-9b5c-ce58145683a0",
                                "sense_id": "62eb31c2-e32a-36d1-bba1-b435705846e8",
                                "text": "„Das liegt an der günstigen Ankunftszeit in den Staaten.“"
                            },
                            {
                                "example_id": "b51bd7cc-ca60-4cad-a5e0-ca9a498352ef",
                                "sense_id": "62eb31c2-e32a-36d1-bba1-b435705846e8",
                                "text": "„Die Ankunftszeit wird zwischen 13 und 15 Uhr liegen, während dieser Zeit können die Oldtimer in der dann für andere Fahrzeuge gesperrten Bahnhofsstraße besichtigt werden.“"
                            },
                            {
                                "example_id": "86031231-9dd9-42a9-9dfb-8a0ea1d565cc",
                                "sense_id": "62eb31c2-e32a-36d1-bba1-b435705846e8",
                                "text": "„Im US-Staat Florida wurde die Ankunftszeit des Hurrikans auf Montag terminiert.“"
                            },
                            {
                                "example_id": "d89efc86-ea29-46f0-b907-23180af9e1c6",
                                "sense_id": "62eb31c2-e32a-36d1-bba1-b435705846e8",
                                "text": "„Schlechte und schlammige Wege, auf denen der Postillion - und manchmal auch die Mitreisenden - in die Speichen greifen mussten, Reparaturen, Wetterkapriolen und Raubüberfälle machten die Ankunftszeiten unberechenbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
