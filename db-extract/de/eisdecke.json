                "senses": [
                    {
                        "sense_id": "5a2c7596-51de-3aab-b4b9-a2d35cefe6f5",
                        "entry_id": "da53350e-ffa8-3d46-a631-b607e5ef6b54",
                        "glosses": [
                            "etwas bedeckende Schicht aus gefrorenem Wasser (Eis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ea8b0a4-692b-4dfa-bd05-b17e2c249b7a",
                                "sense_id": "5a2c7596-51de-3aab-b4b9-a2d35cefe6f5",
                                "text": "„Der Wostoksee im Osten der Antarktis ist der größte bekannte See, der komplett unter einer Eisdecke liegt.“"
                            },
                            {
                                "example_id": "d4e1c7ac-f9a3-4df9-ab29-7a08bb77778b",
                                "sense_id": "5a2c7596-51de-3aab-b4b9-a2d35cefe6f5",
                                "text": "„Obwohl der Grant-See zugefroren war, wurde das Granithaus weiter mit Wasser versorgt, da das Loch ja ein Stück unter der Eisdecke lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
