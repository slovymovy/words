                                "sense_id": "e4c6dabd-f235-3b25-b965-f4114b142d3d",
                                "text": "De soldaat hanteerde het machinegeweer met precisie.",
                                "translation": "The soldier handled the machine gun with precision.",
                                "english": "The soldier handled the machine gun with precision."
                            },
                            {
