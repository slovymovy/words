                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d226010-55bf-4b64-bcb0-a44ab8253f33",
                        "source_entry_id": "45aa5a9f-8a63-356f-af9e-e7f0a86fc8a8",
                        "source_sense_description": "the act of blocking",
                        "target_lang_word": "блокиро́вка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "блокиро́вка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb933bb9-d030-363d-980e-3a082c9567c6",
                                        "entry_id": "39de1e41-405c-3375-a88f-4050cfbbadbb",
                                        "glosses": [
                                            "предотвращение какого-либо действия; препятствование использованию чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48cbd386-5c99-4165-95d4-f27cf0251256",
                                                "sense_id": "eb933bb9-d030-363d-980e-3a082c9567c6",
                                                "text": "Правда, блокировка телефона по коду IMEA может производиться только при наличии соответствующего официального запроса правоохранительных органов."
                                            },
                                            {
                                                "example_id": "f1ebcf89-fb3f-40fd-8b09-8038f94c5970",
                                                "sense_id": "eb933bb9-d030-363d-980e-3a082c9567c6",
                                                "text": "Применение ног для блокировки ударов руками часто бывает неэффективной из-за разности в скорости движения рук и ног, а также приводит к необходимости к высокому подъёму ног, что сказывается на устойчивости и является нерациональной тратой сил."
                                            },
                                            {
                                                "example_id": "79aedbad-d7f7-45c5-acaf-449f07dec911",
                                                "sense_id": "eb933bb9-d030-363d-980e-3a082c9567c6",
                                                "text": "Но прелесть тут не только в небольшом усилии, а ещё и в отличной информативности; машина не только эффективно тормозит, но и позволяет чётко контролировать блокировку колёс даже на скользкой дороге."
                                            },
                                            {
                                                "example_id": "cf5356e3-63cb-420d-a12d-c486b1d292bd",
                                                "sense_id": "eb933bb9-d030-363d-980e-3a082c9567c6",
                                                "text": "Поэтому будут судебные приставы, «маски-шоу», блокировка счёта в банке, новый директор, новый главбух и новый начальник охраны."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a1133a-e373-3d66-b17c-26b4ab7590d2",
                                        "entry_id": "39de1e41-405c-3375-a88f-4050cfbbadbb",
                                        "glosses": [
                                            "прогр. операция, обеспечивающая на определённое время монопольный доступ к какому-либо ресурсу (например, к переменной, таблице базы данных, файлу)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98ef3020-4dfc-419f-9c89-fb3a460cfb20",
                                                "sense_id": "d2a1133a-e373-3d66-b17c-26b4ab7590d2",
                                                "text": "Блокировка на уровне таблицы применяется при глобальных изменениях в отдельно взятой таблице."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f605d22b-9ee2-3a38-af8c-2bb249398035",
                                        "entry_id": "39de1e41-405c-3375-a88f-4050cfbbadbb",
                                        "glosses": [
                                            "информ. запрет на просмотр того или иного веб-сайта, пользование той или иной программой на территории того или иного государства, учреждения и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6798d0c2-b7ec-43a0-aa3c-7bc71008e002",
                                                "sense_id": "f605d22b-9ee2-3a38-af8c-2bb249398035",
                                                "text": "А ещё у нас заблокировано куча сайтов. У нас в универе тоже блокировка стоит на многие сайты… Но зато аська ― пожалуйста… Она, типа, не мешает учебному процессу."
                                            },
                                            {
                                                "example_id": "ec73f565-f79e-4f3d-9002-9cff9810e13e",
                                                "sense_id": "f605d22b-9ee2-3a38-af8c-2bb249398035",
                                                "text": "Роскомнадзор направил на блокировку страницу в «Википедии», содержащую информацию о наркотическом веществе. Это может привести к блокировке всего ресурса в России."
                                            },
                                            {
                                                "example_id": "be86f9f0-47d6-483b-b725-bcf8b93b3cd7",
                                                "sense_id": "f605d22b-9ee2-3a38-af8c-2bb249398035",
                                                "text": "Причины блокировки нам не известны. Никаких официальных уведомлений о проверке прокуратуры или требований удалить какой-либо противоправный контент мы не получали, как не получали и информации о заседании суда или о блокировке сайта. // Мы считаем эту скрытную блокировку актом государственной цензуры, цель которой — остановить нашу работу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e310c6-438b-38cd-bfeb-62fb4d908f99",
                                        "entry_id": "39de1e41-405c-3375-a88f-4050cfbbadbb",
                                        "glosses": [
                                            "информ. запрет участнику того или иного веб-сайта, форума и т. п. на любое участие в данном проекте"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
