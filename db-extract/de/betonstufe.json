                "senses": [
                    {
                        "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                        "entry_id": "991ed6ae-be32-3f25-8b9a-027d4085fbb8",
                        "glosses": [
                            "Stufe aus Beton"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9b36580-a833-4a4b-aa36-f15b26520a08",
                                "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                                "text": "„Die Holztreppe hatte man durch drei Betonstufen ersetzt und mir kam es so vor, als gäbe es eine Klingel anstelle des angelaufenen Türklopfers.“"
                            },
                            {
                                "example_id": "fbc9a972-d754-451c-9d48-88c630f61b38",
                                "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                                "text": "„Die Ranch war nicht nach Schema F erbaut, fügte sich aber gut in diesen langen Häuserblock ein. Preisbewusst, mit Holz- und Vinylverkleidung, drei Betonstufen vor der Haustür und schmiedeeisernem Geländer.“"
                            },
                            {
                                "example_id": "f0224dd3-cb51-4835-93f4-40843cb4743c",
                                "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                                "text": "„Sayyeds Lunge und Schenkel schmerzten, als er die bröckeligen Betonstufen erklomm.“"
                            },
                            {
                                "example_id": "93bfd137-c68d-478f-b5ff-bdbc086b7409",
                                "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                                "text": "„In den Hang eingelassene Betonstufen mit einem Geländer aus lackiertem Eisen führen hinunter zum Ufer.“"
                            },
                            {
                                "example_id": "f27d5485-3cf2-41aa-bfaa-8e4f60957190",
                                "sense_id": "d49d5e96-d31d-3197-85c6-4669acc52357",
                                "text": "„Dann nehme ich mein Jackett vom Haken und folge Dee Dee, die mit ihrem Blindenstock die Betonstufen hinauf zum Eingang tappt, wo Romeo (außer mir der einzige männliche Helfer) die Tür bewacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
