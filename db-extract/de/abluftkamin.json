                ],
                "senses": [
                    {
                        "sense_id": "039d4447-5929-3804-b20e-8af84bbbc435",
                        "entry_id": "c8ce26ac-1554-3928-b0af-c6389df49f45",
                        "glosses": [
                            "senkrechter Kamin zum Abführen von Abluft"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "cbc68263-89ad-4584-8161-69eb1dbc2c09",
                                "sense_id": "039d4447-5929-3804-b20e-8af84bbbc435",
                                "text": "„Der Zu- und Abluftkamin wurde durch einen Lichthof über das Dach geführt.“"
                            },
                            {
                                "example_id": "12c780ef-efcd-4d20-a421-e847654d3ee5",
                                "sense_id": "039d4447-5929-3804-b20e-8af84bbbc435",
                                "text": "„Da die Abluftvolumenströme von Drehrohrofen und Mahlanlage über hohe Abluftkamine in die Atmosphäre geleitet werden, können gesundheitsgefährliche Emissionen weitreichende Folgen haben.“"
                            },
                            {
                                "example_id": "d1b2c24f-c79c-4a26-89a4-e5d65fe93b59",
                                "sense_id": "039d4447-5929-3804-b20e-8af84bbbc435",
                                "text": "„Diese Internationale Norm legt Anforderungen fest und enthält Leitlinien für die Untersuchung der Hauptursachen für Überdruck, und für die Bestimmung einzelner Entlastungsraten sowie für die Auswahl und Bemessung von Entsorgungsystemen, einschließlich solcher Bauteile wie Rohrleitungen, Behälter, Gasfackeln und Abluftkamine.“"
                            },
                            {
                                "example_id": "e24acdf5-470d-4013-b608-ca0dfa61b356",
                                "sense_id": "039d4447-5929-3804-b20e-8af84bbbc435",
                                "text": "„In Sonderfällen, bei der Verwendung von Abluftkaminen, ist dies mit der zuständigen Brandbehörde abzustimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
