                {
                    "sense_id": "9acc24ab-9a53-33e5-8be8-574e9d7926c7",
                    "sense_definition": "present participle and gerund of <w>crow</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooster was <w>crowing</w> loudly at the break of dawn.",
                            "target_lang_translations": {
                                "ru": "Петух громко <w>кукарекал</w> на рассвете."
                            }
                        },
                        {
                            "text": "He could not stop <w>crowing</w> about his recent victory in the chess tournament.",
                            "target_lang_translations": {
                                "ru": "Он не мог перестать <w>хвастаться</w> своей недавней победой в шахматном турнире."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rooster crowing at dawn",
                        "crowing about success"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола crow (кукарекать, ликовать)."
                    },
                    "translations": {
