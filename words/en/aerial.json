{
    "word_family": [
        "aerially",
        "aerodynamic",
        "aeronautics",
        "aerospace"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5df18e16-3fde-33f9-a31d-e9312e53f79e",
                    "sense_definition": "Relating to or conducted by means of aircraft or vehicles that travel through the air.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military conducted an <w>aerial</w> survey of the border to monitor movement.",
                            "target_lang_translations": {
                                "ru": "Военные провели <w>воздушную</w> разведку границы для наблюдения за передвижениями.",
                                "zh": "军方对边境进行了<w>空中</w>勘测以监控动向。"
                            }
                        },
                        {
                            "text": "Modern logistics often rely on <w>aerial</w> photography to map out delivery routes.",
                            "target_lang_translations": {
                                "ru": "Современная логистика часто полагается на <w>аэрофотосъемку</w> для составления маршрутов доставки.",
                                "zh": "现代物流通常依靠<w>航拍</w>来规划配送路线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aerial photography",
                        "aerial view",
                        "aerial surveillance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к авиации или осуществляемый с помощью летательных аппаратов.",
                        "zh": "与航空有关的，或通过飞行器进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "связанный с авиацией"
                            },
                            {
                                "target_lang_word": "авиационный",
                                "target_lang_sense_clarification": "относящийся к самолетам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空中",
                                "target_lang_sense_clarification": "指在空中的活动"
                            },
                            {
                                "target_lang_word": "航空",
                                "target_lang_sense_clarification": "指与飞行器相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "129dc977-636a-391b-8cac-100c780647ed",
                    "sense_definition": "Positioned high up in the air or elevated above the ground.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>aerial</w> roots of the tropical trees hung down toward the forest floor.",
                            "target_lang_translations": {
                                "ru": "<w>Воздушные</w> корни тропических деревьев свисали до самой земли.",
                                "zh": "热带树木的<w>气生</w>根垂向森林地面。"
                            }
                        },
                        {
                            "text": "From our <w>aerial</w> position on the cliff, we could see the entire coastline.",
                            "target_lang_translations": {
                                "ru": "С нашей <w>высокой</w> позиции на утесе была видна вся береговая линия.",
                                "zh": "从我们在悬崖上的<w>高空</w>位置，可以看到整个海岸线。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aerial roots",
                        "aerial walkway"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный высоко в воздухе или поднятый над землей.",
                        "zh": "位于高处或悬浮在地面之上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "находящийся в воздухе"
                            },
                            {
                                "target_lang_word": "надземный",
                                "target_lang_sense_clarification": "расположенный выше уровня земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气生",
                                "target_lang_sense_clarification": "指植物根系等生长在空气中"
                            },
                            {
                                "target_lang_word": "高空",
                                "target_lang_sense_clarification": "指位置很高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e15f58b5-18a2-37bc-a4e5-60d859a05c3c",
                    "sense_definition": "Taking place in the air, especially involving impressive movement or displays.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The eagles performed a stunning <w>aerial</w> display during their mating ritual.",
                            "target_lang_translations": {
                                "ru": "Орлы продемонстрировали потрясающее <w>воздушное</w> шоу во время брачного ритуала.",
                                "zh": "老鹰在求偶仪式中展示了令人惊叹的<w>空中</w>表演。"
                            }
                        },
                        {
                            "text": "The pilot was famous for his <w>aerial</w> acrobatics at the annual summer show.",
                            "target_lang_translations": {
                                "ru": "Пилот был знаменит своей <w>воздушной</w> акробатикой на ежегодном летнем шоу.",
                                "zh": "那位飞行员以其在年度夏季展上的<w>空中</w>特技而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "aerial display",
                        "aerial acrobatics"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в воздухе, особенно включающий впечатляющие движения или зрелища.",
                        "zh": "在空中进行的，尤指包含令人印象深刻的动作或表演。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "происходящий в полете"
                            },
                            {
                                "target_lang_word": "акробатический",
                                "target_lang_sense_clarification": "связанный с трюками в воздухе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空中",
                                "target_lang_sense_clarification": "指在飞行中进行的动作"
                            },
                            {
                                "target_lang_word": "特技",
                                "target_lang_sense_clarification": "指高难度的空中表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60cfef45-c016-3c4b-8d73-691ef82ade92",
                    "sense_definition": "Consisting of air or gas; having a light or gaseous nature.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "composition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist studied the <w>aerial</w> substances released during the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал <w>газообразные</w> вещества, выделяющиеся в ходе химической реакции.",
                                "zh": "科学家研究了化学反应过程中释放出的<w>气态</w>物质。"
                            }
                        },
                        {
                            "text": "Ancient philosophers often debated whether the soul was an <w>aerial</w> or solid entity.",
                            "target_lang_translations": {
                                "ru": "Древние философы часто спорили о том, является ли душа <w>воздушной</w> или твердой сущностью.",
                                "zh": "古代哲学家经常争论灵魂究竟是<w>空气</w>般的还是实体的存在。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий из воздуха или газа; имеющий легкую или газообразную природу.",
                        "zh": "由空气或气体组成的；具有轻盈或气态性质的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "состоящий из воздуха"
                            },
                            {
                                "target_lang_word": "газообразный",
                                "target_lang_sense_clarification": "имеющий форму газа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "气态",
                                "target_lang_sense_clarification": "指物质的状态"
                            },
                            {
                                "target_lang_word": "空气",
                                "target_lang_sense_clarification": "指由空气构成的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05b103dc-96ee-33b2-a5e7-f5a0a2e34016",
                    "sense_definition": "Insubstantial, imaginary, or ethereal in nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed the rumors as <w>aerial</w> nonsense with no basis in reality.",
                            "target_lang_translations": {
                                "ru": "Он отверг эти слухи как <w>пустую</w> болтовню, не имеющую под собой никаких оснований.",
                                "zh": "他认为这些谣言是毫无根据的<w>虚幻</w>废话。"
                            }
                        },
                        {
                            "text": "The poet described the <w>aerial</w> spirits that supposedly haunted the old ruins.",
                            "target_lang_translations": {
                                "ru": "Поэт описывал <w>эфирных</w> духов, которые якобы обитали в старых руинах.",
                                "zh": "诗人描述了那些据称在旧废墟中游荡的<w>空灵</w>之魂。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нематериальный, воображаемый или неземной по своей природе.",
                        "zh": "本质上是虚无的、想象的或超凡脱俗的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эфирный",
                                "target_lang_sense_clarification": "бесплотный, неземной"
                            },
                            {
                                "target_lang_word": "воздушный",
                                "target_lang_sense_clarification": "легкий, призрачный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚幻",
                                "target_lang_sense_clarification": "指不切实际的"
                            },
                            {
                                "target_lang_word": "空灵",
                                "target_lang_sense_clarification": "指超凡脱俗的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a3990388-78fe-3723-a4d0-793030791fff",
                    "sense_definition": "A metal rod or wire used for receiving or transmitting radio or television signals.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to adjust the television <w>aerial</w> to get a clearer picture of the game.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось поправить телевизионную <w>антенну</w>, чтобы картинка матча стала четче.",
                                "zh": "我们不得不调整电视<w>天线</w>以获得更清晰的比赛画面。"
                            }
                        },
                        {
                            "text": "The storm blew down the radio <w>aerial</w> on top of the apartment building.",
                            "target_lang_translations": {
                                "ru": "Шторм повалил радио<w>антенну</w> на крыше жилого дома.",
                                "zh": "暴风雨吹倒了公寓楼顶的无线电<w>天线</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "antenna"
                    ],
                    "common_phrases": [
                        "television aerial",
                        "radio aerial"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Металлический стержень или провод, используемый для приема или передачи радио- или телевизионных сигналов.",
                        "zh": "用于接收或发射无线电或电视信号的金属杆或导线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "антенна",
                                "target_lang_sense_clarification": "устройство для приема сигналов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天线",
                                "target_lang_sense_clarification": "无线电信号接收装置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d62a9f2d-3efe-3d97-b015-16bb1f32533a",
                    "sense_definition": "A move in sports or dance where the performer leaves the ground completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maneuver",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The skateboarder landed a perfect <w>aerial</w> off the edge of the ramp.",
                            "target_lang_translations": {
                                "ru": "Скейтбордист выполнил идеальный <w>прыжок в воздухе</w> с края рампы.",
                                "zh": "滑板手从坡道边缘完美地完成了<w>腾空</w>动作。"
                            }
                        },
                        {
                            "text": "The swing dancers impressed the judges with several risky <w>aerials</w>.",
                            "target_lang_translations": {
                                "ru": "Танцоры свинга впечатлили судей несколькими рискованными <w>акробатическими элементами</w>.",
                                "zh": "摇摆舞者以几个高风险的<w>空中动作</w>打动了评委。"
                            }
                        }
                    ],
                    "synonyms": [
                        "air step",
                        "acrobatic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение в спорте или танцах, при котором исполнитель полностью отрывается от земли.",
                        "zh": "体育或舞蹈中表演者完全离开地面的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыжок",
                                "target_lang_sense_clarification": "элемент в воздухе"
                            },
                            {
                                "target_lang_word": "акробатический элемент",
                                "target_lang_sense_clarification": "трюк в полете"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "空中动作",
                                "target_lang_sense_clarification": "指腾空的技巧"
                            },
                            {
                                "target_lang_word": "腾空",
                                "target_lang_sense_clarification": "指离开地面的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7951be68-c9c1-30ec-8e65-15d038dd9cf4",
                    "sense_definition": "A photograph taken from an aircraft or other flying object.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city planners examined the <w>aerials</w> to decide where to build the new park.",
                            "target_lang_translations": {
                                "ru": "Градостроители изучили <w>аэроснимки</w>, чтобы решить, где разбить новый парк.",
                                "zh": "城市规划者检查了<w>航拍照片</w>，以决定在哪里建造新公园。"
                            }
                        },
                        {
                            "text": "We looked at historical <w>aerials</w> to see how the coastline had changed over time.",
                            "target_lang_translations": {
                                "ru": "Мы просмотрели исторические <w>снимки с воздуха</w>, чтобы увидеть, как со временем изменилась береговая линия.",
                                "zh": "我们查看了历史<w>航拍图</w>，以观察海岸线随时间的变化。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фотография, сделанная с самолета или другого летающего объекта.",
                        "zh": "从飞机或其他飞行物体上拍摄的照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аэроснимок",
                                "target_lang_sense_clarification": "фото с высоты"
                            },
                            {
                                "target_lang_word": "аэрофотосъемка",
                                "target_lang_sense_clarification": "процесс или результат съемки с воздуха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "航拍照片",
                                "target_lang_sense_clarification": "从空中拍摄的影像"
                            },
                            {
                                "target_lang_word": "航空摄影",
                                "target_lang_sense_clarification": "指拍摄行为或结果"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}