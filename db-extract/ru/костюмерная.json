                                "target_senses": [
                                    {
                                        "sense_id": "16e213bb-f190-350e-bfe1-3790aecdf911",
                                        "entry_id": "dbfa0b4b-e07c-308f-85a0-265e223c20c9",
                                        "glosses": [
                                            "To act as a wardrobe department, to provide clothing or sets of clothes."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85e99fa-83de-4aac-a9a4-d4e59d35fa6b",
                                                "sense_id": "16e213bb-f190-350e-bfe1-3790aecdf911",
                                                "text": "[…] impressed with the quality of the talent and production, good wardrobing and speedy pacing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "203d169c-be38-3c36-80c5-b507830ad5b0",
                                        "entry_id": "dbfa0b4b-e07c-308f-85a0-265e223c20c9",
                                        "glosses": [
                                            "Ordering a clothing item online and returning it for a refund after having worn it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bfc3576-e8ba-476f-a4f6-f65e28ba4ec6",
                                                "sense_id": "203d169c-be38-3c36-80c5-b507830ad5b0",
                                                "text": "Wardrobing, the act of buying a nice piece of clothing, wearing it once, and returning it, is an $8.8 billion problem for the retail industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6ca4097-ee6c-3269-b107-0c703731720e",
                                        "entry_id": "dbfa0b4b-e07c-308f-85a0-265e223c20c9",
                                        "glosses": [
                                            "Ordering multiple sizes of the same clothing item online and returning all but the one that fits best."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2551c3f4-4cbb-4a9a-be98-36ee2e174566",
                                                "sense_id": "e6ca4097-ee6c-3269-b107-0c703731720e",
                                                "text": "Wardrobing is where people will order the same thing in three different sizes to see which one fits and then they return the other two, not realizing that those other two most of the time don’t go back on that retailer’s shelves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f1853c9-2891-40dd-8936-46eb6de91006",
                        "source_entry_id": "b4a83f6c-976f-3e11-b3cb-72893786ed45",
                        "source_sense_id": "0667bd3e-9c8e-3c02-b360-6163cc8e6565",
                        "target_lang_word": "Garderobe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Garderobe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b18a6fa8-45db-3958-8a49-dbc5aff32665",
                                        "entry_id": "18324c76-743a-3b20-b1f1-2cb63e3e2bae",
                                        "glosses": [
                                            "die gesamte Oberbekleidung, die eine Person trägt oder besitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57494c7-8ccd-454d-97ce-c3be0d14ee57",
                                                "sense_id": "b18a6fa8-45db-3958-8a49-dbc5aff32665",
                                                "text": "Die Garderobe dieses Herrn scheint mir sehr veraltet zu sein."
                                            },
                                            {
                                                "example_id": "d2b40692-bca9-4c98-b14e-893da235afc8",
                                                "sense_id": "b18a6fa8-45db-3958-8a49-dbc5aff32665",
                                                "text": "„Nach Ukkis Garderobe zu schließen beträgt ihre durchschnittliche Tragedauer mindestens dreißig Jahre.“"
                                            },
                                            {
                                                "example_id": "27527f49-9549-465b-978c-3f26aff1f1ff",
                                                "sense_id": "b18a6fa8-45db-3958-8a49-dbc5aff32665",
                                                "text": "„Norette, das Zweitmädchen, war bei Mutter im Schlafzimmer, servierte ihr das Frühstück und besprach mit ihr Garderobe und Kosmetik.“"
                                            },
                                            {
                                                "example_id": "4d12b5c1-c5b2-4927-b513-f4b874ae7a7e",
                                                "sense_id": "b18a6fa8-45db-3958-8a49-dbc5aff32665",
                                                "text": "„Es war von Ralph Lauren in Beverly Hills, dem Ort, wo sie am liebsten einkaufte, wenn wir Onkel Rolf besuchten, die teuersten Teile aus ihrer Garderobe stammten von dort.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                        "entry_id": "18324c76-743a-3b20-b1f1-2cb63e3e2bae",
                                        "glosses": [
                                            "ein Raum, in dem Besucher einer Veranstaltung oder eines Museums ihre Kleidung aufbewahren können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e49bad4e-cbc0-4aba-a6fb-fac4fa3db04f",
                                                "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                                "text": "Gib deine Jacke doch bei der Garderobe ab."
                                            },
                                            {
                                                "example_id": "58ecd811-e6e4-4313-a545-17f4d72708bb",
                                                "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                                "text": "„In der Nähe der Garderobe im Seitensaal blies eine Kapelle vom Balkon herunter.“"
                                            },
                                            {
                                                "example_id": "f3085035-b5b1-4132-8383-c99e7b459ecc",
                                                "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                                "text": "„Georg und Riesenfeld kämpfen an der Garderobe um ihre Hüte.“"
                                            },
                                            {
                                                "example_id": "5ad74e9f-ed8f-486e-81de-dbbd5314647c",
                                                "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                                "text": "„In der kleinen Garderobe holte ich die wunderschöne Dame ein.“"
                                            },
                                            {
                                                "example_id": "967c8b64-6317-4c06-a222-972d28c3103f",
                                                "sense_id": "ee1c9577-2746-38fd-9303-632ffc6e1fcb",
                                                "text": "„Ich saß vor der Garderobe und genoss den Sonnenschein nach einem kurzen Platzregen, als Lemmy um die Ecke bog. Wir schauten uns kurz an, dann legte es die Rocklegende der Länge nach hin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                        "entry_id": "18324c76-743a-3b20-b1f1-2cb63e3e2bae",
                                        "glosses": [
                                            "Umkleideraum für Akteure in einem Theater oder Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b8f2d0c-7837-437f-b3b2-c8470eeb912b",
                                                "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                                "text": "Falls du den Hauptdarsteller suchst; der befindet sich noch in der Garderobe."
                                            },
                                            {
                                                "example_id": "8de838a6-412b-41ae-9ad9-b8f2e02cce78",
                                                "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                                "text": "„Draußen auf See hatte er sich ausgemalt, wie er in ihrer Garderobe auf sie warten würde, mit dem Schminkkasten spielend oder im Gespräch mit ihrer Garderobiere, bis Elaine von der Bühne kam.“"
                                            },
                                            {
                                                "example_id": "feb539b0-ddab-46c4-ae8c-514a65fee668",
                                                "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                                "text": "„Ich gesellte mich wieder zu Abate Gama, der mir natürlich versicherte, ich hätte dem Marschall sehr gefallen, und ging dann ebenfalls in die Oper; dort gelangte ich mit Hilfe eines Testone in die Garderobe Teresas, die sich gerade von ihrer hübschen Zofe ankleiden ließ.“"
                                            },
                                            {
                                                "example_id": "c0823bff-0411-40e8-8cd1-7f24b9022343",
                                                "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                                "text": "„Eine Familienministerin stand nach dem Konzert vor Grönemeyers Garderobe.“"
                                            },
                                            {
                                                "example_id": "f909d3ec-0feb-415d-946b-39f909d364df",
                                                "sense_id": "e135d012-525a-339a-8e4c-21c499365b30",
                                                "text": "„U2-Sänger Bono sitzt in seiner Garderobe, er steckt bereits in seiner kompletten Bühnen-Montur – in einem knallengen schwarzen Lederdress, im Gesicht eine überdimensionale Sonnenbrille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "66a84f2a-5fd0-3645-ac59-93e3ed79b38d",
                                        "entry_id": "18324c76-743a-3b20-b1f1-2cb63e3e2bae",
                                        "glosses": [
                                            "ein Möbelstück zur Aufbewahrung von Kleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a921b9c3-3502-41fd-b884-9b65f64767fc",
                                                "sense_id": "66a84f2a-5fd0-3645-ac59-93e3ed79b38d",
                                                "text": "Ich habe beim Antiquitätenhändler eine wunderschön verarbeitete Garderobe erstanden."
                                            },
                                            {
                                                "example_id": "530ba946-e215-4265-bb3a-52e621882ba6",
                                                "sense_id": "66a84f2a-5fd0-3645-ac59-93e3ed79b38d",
