{
    "word_family": [
        "slingshot"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d9cfc0fa-1c7a-33be-8331-55b95cdc22ab",
                    "sense_definition": "A supportive bandage worn around the neck to hold an injured arm or hand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore his arm in a <w>sling</w> after breaking his wrist.",
                            "target_lang_translations": {
                                "cs": "Po zlomenině zápěstí nosil ruku v <w>závěsu</w>."
                            }
                        },
                        {
                            "text": "The doctor put his arm in a <w>sling</w> to keep it still.",
                            "target_lang_translations": {
                                "cs": "Doktor mu dal ruku do <w>závěsu</w>, aby ji udržel v klidu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "arm in a sling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Podpůrný obvaz nošený kolem krku k zafixování poraněné ruky nebo paže."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "závěs",
                                "target_lang_sense_clarification": "zdravotnická pomůcka pro zafixování končetiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b144029-c252-3e59-8fa3-3cfa3987dd84",
                    "sense_definition": "A strap used to carry a firearm over the shoulder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "support_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier adjusted the <w>sling</w> on his rifle before marching.",
                            "target_lang_translations": {
                                "cs": "Voják si před pochodem upravil <w>popruh</w> na pušce."
                            }
                        },
                        {
                            "text": "He carried the heavy gun using a leather <w>sling</w>.",
                            "target_lang_translations": {
                                "cs": "Těžkou zbraň nesl pomocí koženého <w>popruhu</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rifle sling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Popruh používaný k nošení střelné zbraně přes rameno."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "popruh",
                                "target_lang_sense_clarification": "řemen pro nošení zbraně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5965070a-eef0-3c51-9676-6a0c57eb3abd",
                    "sense_definition": "A fabric carrier worn on the body to hold a baby.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "support_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother carried her baby in a soft <w>sling</w> while shopping.",
                            "target_lang_translations": {
                                "cs": "Matka nesla své dítě při nákupech v měkkém <w>šátku</w>."
                            }
                        },
                        {
                            "text": "Using a baby <w>sling</w> keeps the infant close to the parent.",
                            "target_lang_translations": {
                                "cs": "Používání <w>nosítka</w> udržuje kojence v blízkosti rodiče."
                            }
                        }
                    ],
                    "common_phrases": [
                        "baby sling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Látkový nosič nošený na těle k nošení dítěte."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "šátek na nošení dětí",
                                "target_lang_sense_clarification": "látková pomůcka pro nošení kojenců"
                            },
                            {
                                "target_lang_word": "nosítko",
                                "target_lang_sense_clarification": "obecnější termín pro pomůcku k nošení dětí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0259e2e-2c1c-300f-9a52-34c8b544effc",
                    "sense_definition": "A primitive weapon consisting of a strap used to throw stones.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weapon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient warrior used a <w>sling</w> to defend the city walls.",
                            "target_lang_translations": {
                                "cs": "Starověký bojovník používal k obraně městských hradeb <w>prak</w>."
                            }
                        },
                        {
                            "text": "He practiced with his <w>sling</w> until he could hit a target from far away.",
                            "target_lang_translations": {
                                "cs": "Cvičil se svým <w>prakem</w>, dokud se netrefil do cíle z velké dálky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Primitivní zbraň skládající se z popruhu používaného k vrhání kamenů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prak",
                                "target_lang_sense_clarification": "starověká zbraň pro vrhání kamenů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2fd0dbd-120d-307e-9f3a-d65bae3dcea1",
                    "sense_definition": "A mixed alcoholic drink containing a spirit and sweetened water.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bartender prepared a classic gin <w>sling</w> for the guest.",
                            "target_lang_translations": {
                                "cs": "Barman připravil hostovi klasický gin <w>sling</w>."
                            }
                        },
                        {
                            "text": "They enjoyed a refreshing Singapore <w>sling</w> on the hotel terrace.",
                            "target_lang_translations": {
                                "cs": "Na hotelové terase si vychutnali osvěžující Singapore <w>sling</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gin sling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Míchaný alkoholický nápoj obsahující lihovinu a slazenou vodu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sling",
                                "target_lang_sense_clarification": "typ míchaného nápoje (přejaté slovo)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4a380829-43d2-3fad-8c73-74bfa7ef8c1a",
                    "sense_definition": "To throw something with a wide, arcing motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "throw",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>sling</w> his heavy bag over his shoulder.",
                            "target_lang_translations": {
                                "cs": "Rozhodl se <w>přehodit</w> si těžkou tašku přes rameno."
                            }
                        },
                        {
                            "text": "The boy tried to <w>sling</w> a stone across the wide river.",
                            "target_lang_translations": {
                                "cs": "Chlapec se pokusil <w>mrštit</w> kamenem přes širokou řeku."
                            }
                        }
                    ],
                    "synonyms": [
                        "throw",
                        "toss",
                        "hurl"
                    ],
                    "common_phrases": [
                        "sling over shoulder"
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco hodit širokým, obloukovým pohybem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přehodit",
                                "target_lang_sense_clarification": "hodit něco přes rameno nebo přes překážku"
                            },
                            {
                                "target_lang_word": "mrštit",
                                "target_lang_sense_clarification": "prudce hodit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e94a091-be8a-3034-b11d-9ece220e407e",
                    "sense_definition": "To sell or distribute goods, often illegally.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the man for <w>slinging</w> illegal substances on the corner.",
                            "target_lang_translations": {
                                "cs": "Policie zatkla muže za to, že na rohu <w>kšeftoval</w> s nelegálními látkami."
                            }
                        },
                        {
                            "text": "He was caught <w>slinging</w> stolen goods to unsuspecting tourists.",
                            "target_lang_translations": {
                                "cs": "Byl přistižen, jak <w>prodává</w> kradené zboží nic netušícím turistům."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used in the context of illegal drug trade."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Prodávat nebo distribuovat zboží, často nelegálně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozkrádat",
                                "target_lang_sense_clarification": "neformální výraz pro nelegální prodej"
                            },
                            {
                                "target_lang_word": "kšeftovat",
                                "target_lang_sense_clarification": "nelegální obchodování"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}