                                "example_id": "09fd4558-5a10-430a-945f-bbc1fd2d3371",
                                "sense_id": "dd5f1e78-31a0-3127-9724-9443a9828514",
                                "text": "Le corbeau mangeait pour soixante marks par semaine."
                            }
                        ]
                    },
