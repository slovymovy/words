                "senses": [
                    {
                        "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                        "entry_id": "26ed3f78-e449-3e26-aba2-350f647e52a2",
                        "glosses": [
                            "Rollenspiel, das eine Situation mit Arzt und Patient zum Inhalt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5c0c17-021b-488a-a624-724521d73aee",
                                "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                                "text": "„Von den Familien- und Doktorspielen über Bauspiele und Figurenarrangements […] bis hin zu überkommenen Reigentexten […] gibt es hier eine Serie von Spielen, die zur Veranschaulichung dieses Deutungsvorschlags dienen können.“"
                            },
                            {
                                "example_id": "7fa21cf1-921b-4e0e-bd66-8fa4e6e45182",
                                "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                                "text": "„Die Einstellung des Erwachsenen zum Spiel des Kindes scheint ambivalent: einerseits wird das Spielverhalten inhaltlich und formal stark kontrolliert: z. B. sind sexuelle Inhalte tabuisiert und müssen heimlich gespielt werden wie Doktorspiele […].“"
                            },
                            {
                                "example_id": "0dc1b9f7-28b6-4c6d-b1a5-a7da85b99265",
                                "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                                "text": "„1948 enthüllten die berühmten Studien Alfred C. Kinseys, dass Sexualspiele unter Kindern völlig normal sind: Unter den 10jährigen […] beteiligten sich demnach 36,6 % der Kinder an hetero- und homosexuellen Doktorspielen.“"
                            },
                            {
                                "example_id": "3b6d675c-fe58-40e2-bc5f-4fde8c4134d5",
                                "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                                "text": "„In Kindertagesstätten sollten Doktorspiele oder Kuscheleinheiten zwischen Kindern beispielsweise viel stärker akzeptiert und durch Rückzugsorte ermöglicht werden.“"
                            },
                            {
                                "example_id": "e544a0df-14ce-41a7-852b-879b07eb7e17",
                                "sense_id": "fd8516cb-d6f7-345c-b840-3f983188c9de",
                                "text": "„In der katholischen Kita soll es zu sexuellen Übergriffen und Gewaltdrohungen unter Kindern gekommen sein, die in ihrem Ausmaß über alterstypische Doktorspiele hinausgingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
