                        "form": "taquineries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5609fd86-c519-3cf9-86d4-4df9c25cc716",
                        "entry_id": "d98720b1-5af2-3c78-837d-4bf6d4019284",
                        "glosses": [
                            "Caractère de celui qui est taquin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e7338c8-c261-4ae2-a9e3-afeaff5f9cd6",
                                "sense_id": "5609fd86-c519-3cf9-86d4-4df9c25cc716",
                                "text": "Il est d’une taquinerie insupportable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9afa081a-98a3-30b8-b3af-53c335c6bc3f",
                        "entry_id": "d98720b1-5af2-3c78-837d-4bf6d4019284",
                        "glosses": [
                            "Action de celui qui taquine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f92862d-77b3-47ca-bd3b-476728c45c44",
                                "sense_id": "9afa081a-98a3-30b8-b3af-53c335c6bc3f",
                                "text": "Camille Moûtier était vite devenu un très mauvais élève. En effet, les punitions et les mauvaises notes étaient bien plus faciles à supporter que les mille taquineries des camarades."
                            },
                            {
                                "example_id": "014606e6-cdc5-4c61-a0f4-64fbc10e6888",
                                "sense_id": "9afa081a-98a3-30b8-b3af-53c335c6bc3f",
                                "text": "Et comme elle ouvrait toujours sous mes yeux ce que je ne devais pas toucher, une taquinerie me fit dire : « Vous avez de bien mauvaises habitudes, mademoiselle, quand vous êtes toute seule."
                            },
                            {
                                "example_id": "8526d4ff-ddcb-46e7-83dc-e9544ab7807f",
                                "sense_id": "9afa081a-98a3-30b8-b3af-53c335c6bc3f",
                                "text": "Le « combisme » devint synonyme d'une politique grossière de taquinerie antireligieuse."
                            },
                            {
                                "example_id": "e103defb-ce82-44ad-bc23-7636c2dad5d9",
                                "sense_id": "9afa081a-98a3-30b8-b3af-53c335c6bc3f",
                                "text": "Nous jouions une ample comédie aux cent sketches divers : le flirt, les malentendus vite dissipés, les taquineries débonnaires et les gronderies gentilles, le dépit amoureux, les cachotteries tendres et la passion."
                            }
                        ]
                    }
                ],
