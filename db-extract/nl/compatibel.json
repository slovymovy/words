                                        "entry_id": "4d6b2ac9-a28a-3b87-aedb-8557af1e7aa9",
                                        "glosses": [
                                            "Capable of easy interaction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5066744-173b-4ffd-856d-0c23de88bb04",
                                                "sense_id": "d66ab58a-1bff-37cc-bb19-764c00e47b2f",
                                                "text": "This printer isn't compatible with my computer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12fc3ed3-c195-317d-aa6c-b10e92c7a558",
                                        "entry_id": "4d6b2ac9-a28a-3b87-aedb-8557af1e7aa9",
                                        "glosses": [
                                            "Able to get along well."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "101d17d8-528e-483e-b3cd-45779b513904",
                                                "sense_id": "12fc3ed3-c195-317d-aa6c-b10e92c7a558",
                                                "text": "My neighbours and I are not very compatible: they're loud and I'm an introvert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb16ec4-d024-3e14-ae52-8679d43a7389",
                                        "entry_id": "4d6b2ac9-a28a-3b87-aedb-8557af1e7aa9",
                                        "glosses": [
                                            "Consistent; congruous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "174a9560-d986-465b-8af9-ca0a2b88e5f8",
                                                "sense_id": "2fb16ec4-d024-3e14-ae52-8679d43a7389",
                                                "text": "His actions were compatible with his sermons."
                                            },
                                            {
                                                "example_id": "4c374bda-2ac2-43b5-bf2a-535a2e027721",
                                                "sense_id": "2fb16ec4-d024-3e14-ae52-8679d43a7389",
                                                "text": "She was like a Beardsley Salome, he had said. And indeed she had the narrow eyes and the high cheekbone of that creature, and as nearly the sinuosity as is compatible with human symmetry."
                                            }
                                        ]
                                    }
                                ]
                            },
