                                        "tags": [
                                            "adverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c52af0-b1f4-4cc9-8bd9-2db0cafb96cb",
                                                "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
                                                "text": "Was er uns anbot, war ganz schön heftig."
                                            },
                                            {
                                                "example_id": "599d8aaa-ef12-424f-9d78-32fab2a9a7a4",
                                                "sense_id": "f9f677e4-b3e1-3549-878e-d36ae1588c3e",
