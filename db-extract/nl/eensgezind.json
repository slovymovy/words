                ],
                "senses": [
                    {
                        "sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                        "entry_id": "ad99caf0-2c61-365b-bca2-b62f1a53e28e",
                        "glosses": [
                            "dezelfde mening en doel hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9b92ae-b736-413b-b051-164941388628",
                                "sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                                "text": "- De tweelingbroers waren erg eensgezind en droegen vaak dezelfde kleding."
                            },
                            {
                                "example_id": "24f9f665-9578-427c-8745-63d678037738",
                                "sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                                "text": "- Omdat de leden van de politieke partij geen eensgezinde mening hadden verloren ze de verkiezingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4fa2be49-9845-4439-9afe-18f7f738e72b",
                        "source_entry_id": "ad99caf0-2c61-365b-bca2-b62f1a53e28e",
                        "source_sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                        "source_sense_description": "dezelfde mening hebbend",
                        "target_lang_word": "einmütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einmütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7320b2-885d-32ea-b5be-c4e5cd137a03",
                                        "entry_id": "cd1aa3ff-8a53-3a98-b4e0-ac52054f944e",
                                        "glosses": [
                                            "hinsichtlich der Meinung übereinstimmend, völlig gleich"
                                        ],
                                        "tags": [
                                            "gehoben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03c8ebd-1414-445f-8ad8-56dc3676827e",
                                                "sense_id": "bb7320b2-885d-32ea-b5be-c4e5cd137a03",
                                                "text": "„Das drohende Blutvergießen zwischen Romanen und Germanen, zwischen Gegnern und Freunden des Kaisers konnte noch einmal verhindert werden, denn Vater und Sohn zeigten sich dem Volke einmütig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c3d6861-37c5-43bf-9684-95e91d6072bb",
                        "source_entry_id": "ad99caf0-2c61-365b-bca2-b62f1a53e28e",
                        "source_sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                        "source_sense_description": "dezelfde mening hebbend",
                        "target_lang_word": "einträchig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d58919ba-2f97-4f9a-9f65-81627d98dbae",
                        "source_entry_id": "ad99caf0-2c61-365b-bca2-b62f1a53e28e",
                        "source_sense_id": "5e45928c-087c-3b18-a275-dd9593113830",
                        "source_sense_description": "dezelfde mening hebbend",
                        "target_lang_word": "unanimous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unanimous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                        "entry_id": "2b6cb24f-97ba-37ff-a50a-97e17bbb6553",
                                        "glosses": [
                                            "Based on unanimity, assent or agreement."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9aae442-3a2e-478e-b33e-966cd581ebde",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "The debate went on for hours, but in the end the decision was unanimous."
                                            },
                                            {
                                                "example_id": "98adb036-7fbb-4415-b10f-f15a689dbe44",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "That of their small force, some of the soldiers were superannuated, others invalid; therefore, since the course to be pursued was left discretional, their unanimous advice was, to remain where they were, and fortify themselves as strongly as possible."
                                            },
                                            {
                                                "example_id": "3ba1d0cc-11d7-4d10-92fd-a2cde14edbd0",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "Under court tradition, a new justice is usually assigned a relatively uncontroversial opinion that is often, although not always, unanimous."
                                            },
                                            {
                                                "example_id": "ff3dfcea-ca7f-47a6-876b-502e4e8653ec",
                                                "sense_id": "4f9a6bfa-458b-3f63-8f27-5944fa215c1d",
                                                "text": "That was followed by a Florida Supreme Court ruling that found the jury must be unanimous to impose the death penalty, and Florida lawmakers adopted the unanimity requirement soon after."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb18559-350f-3d45-a7c9-3dcc0cd4cf87",
                                        "entry_id": "2b6cb24f-97ba-37ff-a50a-97e17bbb6553",
                                        "glosses": [
                                            "Sharing the same views or opinions, and being in harmony or accord."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150cecf0-dc17-4e9d-afd4-f9bada069083",
                                                "sense_id": "adb18559-350f-3d45-a7c9-3dcc0cd4cf87",
                                                "text": "We were unanimous: the President had to go."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
