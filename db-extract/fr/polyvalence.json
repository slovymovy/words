                                "target_senses": [
                                    {
                                        "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                        "entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                                        "glosses": [
                                            "The property of being versatile or having many different abilities."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b601a28-5efa-4745-bed5-ff711a90764a",
                                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                                "text": "Those are the sort of women who polish a young man the most, and who give him that habit of complaisance, and that flexibility and versatility of manners which prove of great use to him with men, and in the course of business."
                                            },
                                            {
                                                "example_id": "9d7bff12-d9ae-46fc-960a-760c216872b2",
                                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                                "text": "We broke up our tests into three categories — performance, durability and versatility — so we could compare the different features of each jacket against the others directly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
