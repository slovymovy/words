                ],
                "senses": [
                    {
                        "sense_id": "b6e8ea3a-199a-3843-96d4-420d704f038d",
                        "entry_id": "77edeb18-7137-3903-9061-12f57f742e8d",
                        "glosses": [
                            "Besucher der Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc353c5-5c96-4241-b121-f2b62743400a",
                                "sense_id": "b6e8ea3a-199a-3843-96d4-420d704f038d",
                                "text": "Die Kirchenbesucher sammelten sich vor der Kirche, um gemeinsam einzutreten."
                            },
                            {
                                "example_id": "ff8160dd-7552-4612-a54d-61b72a7981a6",
                                "sense_id": "b6e8ea3a-199a-3843-96d4-420d704f038d",
                                "text": "„Hin und wieder besuchen die Schwestern den Gottesdienst in der Liebfrauenkirche, wobei Benno, dem jüngsten Ministranten dort, aber auch anderen Kirchenbesuchern auffällt, dass sie nie zur Kommunion gehen.“"
                            },
                            {
                                "example_id": "95e339ac-a3ad-4e06-8c07-da8c0420d15c",
                                "sense_id": "b6e8ea3a-199a-3843-96d4-420d704f038d",
                                "text": "„Deshalb ging ich nach ihr aus dem Hause, begab mich gleich in die Kirche ›de la Soledad‹ und stellte mich hinter die Tür der Sakristei, weil ich von dort aus alle Kirchenbesucher sah, ohne selbst gesehen zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
