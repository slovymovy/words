                                "target_senses": [
                                    {
                                        "sense_id": "86c4a06e-b583-34cf-8b8c-ab4a24f46e36",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Pertaining only to a part of something; partial."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fb00233-3321-35a3-8016-01e077742756",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Specific; discrete; concrete."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8510d966-7fa8-4df5-a9f1-ace462fe5b0b",
                                                "sense_id": "9fb00233-3321-35a3-8016-01e077742756",
                                                "text": "I couldn't find the particular model you asked for, but I hope this one will do."
                                            },
                                            {
                                                "example_id": "16bf0d6e-483e-4b68-b802-82f93ced6e63",
                                                "sense_id": "9fb00233-3321-35a3-8016-01e077742756",
                                                "text": "We knew it was named after John Smith, but nobody knows which particular John Smith."
                                            },
                                            {
                                                "example_id": "6272e79d-2e10-4c15-9ba2-19665e68cfc3",
                                                "sense_id": "9fb00233-3321-35a3-8016-01e077742756",
                                                "text": "I could a tale unfold whose lightest word / Would harrow up thy soul, freeze thy young blood, / Make thy two eyes, like stars, start from their spheres, / Thy knotted and combined locks to part / And each particular hair to stand on end"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfffc5f3-e835-3aa5-9638-357d82a8ddaf",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Specialised; characteristic of a specific person or thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79ed91b3-a96b-4b23-b6bf-f355732b5fa3",
                                                "sense_id": "bfffc5f3-e835-3aa5-9638-357d82a8ddaf",
                                                "text": "I don't appreciate your particular brand of cynicism."
                                            },
                                            {
                                                "example_id": "e27f13ea-5401-4ac5-b9b6-a1f975c2d2a3",
                                                "sense_id": "bfffc5f3-e835-3aa5-9638-357d82a8ddaf",
                                                "text": "wheresoever one plant draweth such a particular juice out of the earth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60e2bfae-0559-36ed-b3ca-72aeb756b4df",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Known only to an individual person or group; confidential."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e474e0e-9902-43a5-86ee-a67b71ddbea8",
                                                "sense_id": "60e2bfae-0559-36ed-b3ca-72aeb756b4df",
                                                "text": "or these domesticke and particular broiles, Are not the question heere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c284f57-fd58-3086-b90e-48424a2535e1",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Distinguished in some way; special (often in negative constructions)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cebfa01-8b5c-4351-82b4-152c110429f5",
                                                "sense_id": "8c284f57-fd58-3086-b90e-48424a2535e1",
                                                "text": "He brought no particular news."
                                            },
                                            {
                                                "example_id": "f26580ba-e7f3-41e3-b5d4-733668a50fe6",
                                                "sense_id": "8c284f57-fd58-3086-b90e-48424a2535e1",
                                                "text": "She was the particular belle of the party."
                                            },
                                            {
                                                "example_id": "914aca9d-49fc-404d-94b2-4af3884921ba",
                                                "sense_id": "8c284f57-fd58-3086-b90e-48424a2535e1",
                                                "text": "My five favorite places are, in no particular order, New York, Chicago, Paris, San Francisco and London."
                                            },
                                            {
                                                "example_id": "ee7c3123-967b-45bc-8b07-879e8a245584",
                                                "sense_id": "8c284f57-fd58-3086-b90e-48424a2535e1",
                                                "text": "I didn't have any particular interest in the book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96f132e7-0f6e-3a82-8444-a7265dc276f1",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Of a person, concerned with, or attentive to, details; fastidious."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2826c18-dba7-4c1f-a502-ce1465f1a9c4",
                                                "sense_id": "96f132e7-0f6e-3a82-8444-a7265dc276f1",
                                                "text": "He is very particular about his food and if it isn't cooked to perfection he will send it back."
                                            },
                                            {
                                                "example_id": "502a8078-04e3-4e70-9a60-f57870fbd7a3",
                                                "sense_id": "96f132e7-0f6e-3a82-8444-a7265dc276f1",
                                                "text": "These women are more particular about their appearance."
                                            },
                                            {
                                                "example_id": "ee043c13-b260-4184-831c-b877f46ed2e7",
                                                "sense_id": "96f132e7-0f6e-3a82-8444-a7265dc276f1",
                                                "text": "There is a scraper as well as a mat, and Mrs. Challenger is most particular."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d3f9697-a739-35cc-a435-dcad98439d95",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Concerned with, or attentive to, details; minute; circumstantial; precise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d16b42-db4f-4a07-b805-b8231a14d5e5",
                                                "sense_id": "9d3f9697-a739-35cc-a435-dcad98439d95",
                                                "text": "a full and particular account of an accident"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2fc1501-8086-392b-9ec3-b1b2d7c2ff23",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Containing a part only; limited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4937a8-5ca7-4ec2-b148-848a45d95693",
                                                "sense_id": "b2fc1501-8086-392b-9ec3-b1b2d7c2ff23",
                                                "text": "a particular estate, or one precedent to an estate in remainder"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1ce6f5-21eb-3b15-9abc-ffb6d1f6bd6e",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Holding a particular estate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec80eb7d-3d84-420a-b84e-904356100376",
                                                "sense_id": "eb1ce6f5-21eb-3b15-9abc-ffb6d1f6bd6e",
                                                "text": "a particular tenant"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99e05581-fda1-394c-adac-aa16791bff58",
                                        "entry_id": "228e5147-ed9d-39f5-99cf-deba53cb0e79",
                                        "glosses": [
                                            "Forming a part of a genus; relatively limited in extension; affirmed or denied of a part of a subject."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9e04c00-3b5b-461b-b0a4-ecd822ff114a",
                                                "sense_id": "99e05581-fda1-394c-adac-aa16791bff58",
                                                "text": "a particular proposition, opposed to \"universal\", e.g. (particular affirmative) \"Some men are wise\"; (particular negative) \"Some men are not wise\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "particular",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7458ea47-f0a9-32f3-ba0c-75c2169db0e8",
                                        "entry_id": "19c20047-6dec-3350-8ad3-79ec128c1dc0",
                                        "glosses": [
                                            "A small individual part of something larger; a detail, a point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "304ffd2d-243a-48c5-b135-dca1eff77fe0",
                                                "sense_id": "7458ea47-f0a9-32f3-ba0c-75c2169db0e8",
                                                "text": "I did not omit even our Sports and Paſtimes, or any other Particular which I thought might redound to the Honour of my Country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "521d9c03-40e2-3d6f-a4d5-04d797851e0f",
                                        "entry_id": "19c20047-6dec-3350-8ad3-79ec128c1dc0",
                                        "glosses": [
                                            "A person's own individual case."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043ff869-622e-4e44-bcd7-323ddaa14ae8",
                                                "sense_id": "521d9c03-40e2-3d6f-a4d5-04d797851e0f",
                                                "text": "Since philosophy could never find any way for tranquillity that might be generally good, let every man in his particular seeke for it."
                                            },
                                            {
                                                "example_id": "d89c1f07-d83a-46a8-952e-b4d1da66b819",
                                                "sense_id": "521d9c03-40e2-3d6f-a4d5-04d797851e0f",
                                                "text": "temporal blessings, whether such as concern the public[…]or such as concern our particular"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1cd02f1-00d0-3912-b371-e3a097f9ea62",
                                        "entry_id": "19c20047-6dec-3350-8ad3-79ec128c1dc0",
                                        "glosses": [
                                            "A particular case; an individual thing as opposed to a whole class. (Opposed to generals, universals.)"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c899860-683e-44ed-ae11-19021b60eb69",
                                                "sense_id": "a1cd02f1-00d0-3912-b371-e3a097f9ea62",
                                                "text": "When we examine common words, we find that, broadly speaking, proper names stand for particulars, while other substantives, adjectives, prepositions, and verbs stand for universals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
