                                            {
                                                "example_id": "e397d1ae-7be0-4d22-886d-837af9dd3e2a",
                                                "sense_id": "8de63f99-1315-3964-b54b-ad8d078a58c5",
                                                "text": "Spiel nicht den Samariter, du wirst nur ausgenutzt werden."
                                            }
