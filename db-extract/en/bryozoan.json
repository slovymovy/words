                                        "sense_id": "298619f1-31ce-310c-b18b-011f87b2bcdb",
                                        "entry_id": "b51f5486-d53f-3af3-8765-04e604fdca73",
                                        "glosses": [
                                            "dim. tant. benaming voor dieren uit de stam Bryozoa, hoogstens 1 millimeter grote waterdiertjes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f9c971b-64ab-4b84-a5c3-403d65bb61d9",
                                                "sense_id": "298619f1-31ce-310c-b18b-011f87b2bcdb",
                                                "text": "En inderdaad, één graad Celsius opwarming maakt veel verschil voor de kustdiertjes. Maar de gevolgen zijn totaal anders dan voorspeld. Eén soort mosdiertje profiteerde, en nam de boel over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "650ea9b1-2544-47ad-a0d5-3f38249c971a",
                        "source_entry_id": "b34c6bda-7fd9-3969-b675-51384e876811",
                        "source_sense_id": "616c1a31-396a-317e-8eca-ba5187d9f515",
                        "source_sense_description": "invertebrate in the phylum Bryozoa",
                        "target_lang_word": "ectoprocte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ectoprocte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ce070f6-21af-3fc4-b1b4-71c474337101",
                                        "entry_id": "bae58064-9e68-3ac4-8be6-c4829edc8266",
                                        "glosses": [
                                            "Métazoaire triploblastique et cœlomate vivant en colonie (de là le synonyme de polyzoaire) et ressemblant collectivement à une mousse aquatique (de là le synonyme de bryozoaire)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be1f2e17-b9a9-4704-98c9-5975cb0e787d",
                                                "sense_id": "3ce070f6-21af-3fc4-b1b4-71c474337101",
                                                "text": "Le zoïde, animal élémentaire de taille millimétrique, a grossièrement l’aspect d’un énorme estomac replié en « U » dans sa loge, avec d’un côté la tête entourée d’un panache de tentacules appelé lophophore, au milieu duquel s’ouvre la bouche. L’œsophage prolonge la bouche vers l’estomac qui remonte de l’autre côté vers le rectum. L’anus s’ouvre à l’extérieur des tentacules, d’où le nom de ectoprocte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
