                                "example_id": "978551d9-439f-49c4-be61-363a28f7da75",
                                "sense_id": "1b293b3a-10e6-33ca-8ed5-7d284095cc03",
                                "text": "Anybody who does anything in the way of business, if he can but write his name, is a “merchant;” and especially when an address is getting up by agitators of elastic conscience, content to procure an array of demonstrants numerous, if not select."
                            },
                            {
                                "example_id": "f20a01d7-dada-45a1-a173-d135ce4ea2db",
                                "sense_id": "1b293b3a-10e6-33ca-8ed5-7d284095cc03",
                                "text": "A report from London announced that the Italian Embassy had given out the statement that in many towns the shops were closed while crowds of demonstrants paraded shouting, “Long live America! Down with Wilson!”"
                            },
                            {
                                "example_id": "24529cc9-48f0-4e84-896b-f9a1ba66e19d",
                                "sense_id": "1b293b3a-10e6-33ca-8ed5-7d284095cc03",
                                "text": "One demonstrant, with his face twisted in anger, was shouting the Japanese equivalent of “lemme at ’em.”"
                            }
                        ]
