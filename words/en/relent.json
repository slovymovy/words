    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d1365e7-b799-33cc-9f31-4553224598f9",
                    "sense_definition": "To abandon or mitigate a harsh intention or cruel treatment; to become more mild or compassionate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soften attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had planned to ground his son for a month, but <w>relented</w> and decided to give him a stern lecture instead.",
                            "target_lang_translations": {
                                "ru": "Он планировал оставить сына под домашним арестом на месяц, но <w>смягчился</w> и решил вместо этого прочитать ему строгую нотацию.",
                                "tr": "Oğluna bir ay ev hapsi vermeyi planlamıştı, ama <w>yumuşadı</w> ve bunun yerine ona sert bir ders vermeye karar verdi."
                            }
                        },
                        {
                            "text": "After seeing her tears, the judge began to <w>relent</w> and offered a lighter sentence.",
                            "target_lang_translations": {
                                "ru": "Увидев её слёзы, судья начал <w>смягчаться</w> и предложил более мягкий приговор.",
                                "tr": "Gözyaşlarını gördükten sonra yargıç <w>insafa gelmeye</w> başladı ve daha hafif bir ceza teklif etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "yield",
                        "soften",
                        "capitulate",
                        "give in"
                    ],
                    "antonyms": [
                        "persist"
                    ],
                    "common_phrases": [
                        "finally relent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от сурового намерения или жестокого обращения; стать более мягким или сострадательным.",
                        "tr": "Sert bir niyetten veya acımasız bir tutumdan vazgeçmek; daha yumuşak veya merhametli davranmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смягчиться",
                                "target_lang_sense_clarification": "стать более снисходительным"
                            },
                            {
                                "target_lang_word": "сжалиться",
                                "target_lang_sense_clarification": "проявить сострадание"
                            },
                            {
                                "target_lang_word": "уступить",
                                "target_lang_sense_clarification": "перестать настаивать на своем"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yumuşamak",
                                "target_lang_sense_clarification": "tutum veya kararda daha merhametli olmak"
                            },
                            {
                                "target_lang_word": "insafa gelmek",
                                "target_lang_sense_clarification": "acıyıp katı tutumundan vazgeçmek"
                            },
                            {
                                "target_lang_word": "pes etmek",
                                "target_lang_sense_clarification": "ısrara dayanamayıp kabul etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4599c998-56a9-3030-bd38-46fe73ba4d0f",
                    "sense_definition": "To become less severe, intense, or strong; to slacken or abate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decrease intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We waited for the storm to <w>relent</w> before we ventured outside.",
                            "target_lang_translations": {
                                "ru": "Мы ждали, пока шторм <w>утихнет</w>, прежде чем рискнули выйти на улицу.",
                                "tr": "Dışarı çıkma cesaretini göstermeden önce fırtınanın <w>dınmesini</w> bekledik."
                            }
                        },
                        {
                            "text": "The heat showed no sign it would <w>relent</w> during the long afternoon.",
                            "target_lang_translations": {
                                "ru": "Жара не подавала признаков того, что она <w>ослабнет</w> в течение этого долгого дня.",
                                "tr": "Sıcaklık, uzun öğleden sonra boyunca <w>hafifleyeceğine</w> dair hiçbir belirti göstermedi."
                            }
                        }
                    ],
                    "synonyms": [
                        "abate",
                        "slacken",
                        "subside",
                        "ease"
                    ],
                    "antonyms": [
                        "intensify"
                    ],
                    "common_phrases": [
                        "refuse to relent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать менее суровым, интенсивным или сильным; ослабнуть или утихнуть.",
                        "tr": "Şiddeti, yoğunluğu veya gücü azalmak; dindirilmek veya yatışmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "утихать",
                                "target_lang_sense_clarification": "о буре или ветре"
                            },
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "о жаре или интенсивности"
                            },
                            {
                                "target_lang_word": "смягчаться",
                                "target_lang_sense_clarification": "о погоде или условиях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dincelmek",
                                "target_lang_sense_clarification": "şiddeti hafiflemek"
                            },
                            {
                                "target_lang_word": "yatışmak",
                                "target_lang_sense_clarification": "fırtına veya sıcaklığın azalması"
                            },
                            {
                                "target_lang_word": "hızını kesmek",
                                "target_lang_sense_clarification": "etkisini yitirmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "722c2f11-4b32-3be3-8eb9-5f692ce82dd5",
                    "sense_definition": "To become less rigid or hard; to soften or melt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical softening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frozen ground began to <w>relent</w> as the spring sun warmed the valley.",
                            "target_lang_translations": {
                                "ru": "Мерзлая земля начала <w>оттаивать</w>, когда весеннее солнце согрело долину.",
                                "tr": "Bahar güneşi vadiyi ısıttıkça donmuş toprak <w>çözülmeye</w> başladı."
                            }
                        },
                        {
                            "text": "Certain salts will <w>relent</w> and turn to liquid when kept in a damp cellar.",
                            "target_lang_translations": {
                                "ru": "Некоторые соли <w>размягчаются</w> и превращаются в жидкость при хранении в сыром подвале.",
                                "tr": "Bazı tuzlar nemli bir mahzende tutulduğunda <w>yumuşar</w> ve sıvıya dönüşür."
                            }
                        }
                    ],
                    "synonyms": [
                        "soften",
                        "thaw",
                        "dissolve"
                    ],
                    "antonyms": [
                        "harden",
                        "freeze"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in a physical sense of softening or melting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать менее жестким или твердым; размягчиться или растаять.",
                        "tr": "Daha az sert veya katı hale gelmek; yumuşamak veya erimek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оттаивать",
                                "target_lang_sense_clarification": "о замерзшей почве"
                            },
                            {
                                "target_lang_word": "размягчаться",
                                "target_lang_sense_clarification": "становиться менее твердым"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yumuşamak",
                                "target_lang_sense_clarification": "fiziksel sertliğini kaybetmek"
                            },
                            {
                                "target_lang_word": "çözülmek",
                                "target_lang_sense_clarification": "donmuş bir şeyin erimeye başlaması"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91511dfd-c7fb-3f2a-8afe-0229d258f1db",
                    "sense_definition": "A stay, stop, or delay in progress or action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pistons of this engine moved without <w>relent</w> throughout the entire journey.",
                            "target_lang_translations": {
                                "ru": "Поршни этого двигателя двигались без <w>остановки</w> на протяжении всего пути.",
                                "tr": "Bu motorun pistonları tüm yolculuk boyunca <w>durmaksızın</w> hareket etti."
                            }
                        },
                        {
                            "text": "She continued her journey and did not rest until she arrived without <w>relent</w> at the border.",
                            "target_lang_translations": {
                                "ru": "Она продолжала свой путь и не отдыхала, пока не прибыла без <w>передышки</w> к границе.",
                                "tr": "Yolculuğuna devam etti ve <w>mola vermeden</w> sınıra varana kadar dinlenmedi."
                            }
                        }
                    ],
                    "synonyms": [
                        "pause",
                        "stop",
                        "delay",
                        "cessation"
                    ],
                    "common_phrases": [
                        "without relent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановка, прекращение или задержка в прогрессе или действии.",
                        "tr": "Bir eylem veya ilerlemede duraksama, ara veya gecikme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передышка",
                                "target_lang_sense_clarification": "пауза в действии"
                            },
                            {
                                "target_lang_word": "остановка",
                                "target_lang_sense_clarification": "прекращение движения"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mola",
                                "target_lang_sense_clarification": "kısa süreli duraklama"
                            },
                            {
                                "target_lang_word": "duraklama",
                                "target_lang_sense_clarification": "kesinti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fe8ef64b-ee88-3a75-b98e-a299b3a4bfe5",
                    "sense_definition": "Characterized by being softhearted or yielding.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was known to be a <w>relent</w> man who often forgave his enemies.",
                            "target_lang_translations": {
                                "ru": "Король был известен как <w>мягкосердечный</w> человек, который часто прощал своих врагов.",
                                "tr": "Kral, düşmanlarını sık sık affeden <w>yumuşak kalpli</w> bir adam olarak bilinirdi."
                            }
                        },
                        {
                            "text": "Her <w>relent</w> nature made it difficult for her to enforce strict rules.",
                            "target_lang_translations": {
                                "ru": "Её <w>уступчивый</w> характер мешал ей вводить строгие правила.",
                                "tr": "Onun <w>uysal</w> yapısı, katı kuralları uygulamasını zorlaştırıyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "softhearted",
                        "yielding",
                        "lenient"
                    ],
                    "antonyms": [
                        "relentless",
                        "obdurate"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "the adjective form is no longer in common use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся мягкосердечностью или уступчивостью.",
                        "tr": "Yumuşak kalpli veya uysal olma niteliği gösteren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкосердечный",
                                "target_lang_sense_clarification": "добрый и сострадательный"
