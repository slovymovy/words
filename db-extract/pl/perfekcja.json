                                                "sense_id": "8f2c8bf4-5a4b-33d0-a3d8-faa1ca42c7d2",
                                                "text": "No tongue can her perfections tell",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3fcec9f-cb4a-3c55-be8f-2968c911f132",
                                        "entry_id": "b4bf226e-11e4-3b88-8839-b2bc3f653f1d",
                                        "glosses": [
