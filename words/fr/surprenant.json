                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En <w>surprenant</w> ses amis dans le salon, elle a fait rire tout le monde.",
                            "target_lang_translations": {
                                "en": "By <w>surprising</w> her friends in the living room, she made everyone laugh.",
                                "ru": "<w>Застигнув</w> друзей <w>врасплох</w>, в гостиной она рассмешила всех.",
                                "de": "Indem sie ihre Freunde im Wohnzimmer <w>überraschte</w>, brachte sie alle zum Lachen.",
                                "es": "Al <w>sorprender</w> a sus amigos en el salón, hizo reír a todos.",
                                "zh": "她在客厅里<w>突袭</w>朋友们，逗得大家都笑了。"
                            }
                        },
                        {
                            "text": "Il a remporté la partie en <w>surprenant</w> son adversaire dès les premiers coups.",
                            "target_lang_translations": {
                                "en": "He won the game by <w>surprising</w> his opponent from the first few shots.",
                                "ru": "Он выиграл партию, <w>застигнув</w> соперника <w>врасплох</w> уже с первых ударов.",
                                "de": "Er gewann die Partie, indem er seinen Gegner schon bei den ersten Schlägen <w>überraschte</w>.",
                                "es": "Ganó la partida al <w>sorprender</w> a su rival desde los primeros golpes.",
                                "zh": "他从前几个回合就<w>突袭</w>对手，赢得了比赛。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of the verb meaning to catch someone off guard.",
                        "ru": "Причастие настоящего времени от глагола, означающего застать кого-либо врасплох.",
                        "de": "Partizip Präsens des Verbs überraschen, das ausdrückt, dass man jemanden unvorbereitet trifft.",
                        "es": "Forma del verbo sorprender que expresa la acción de tomar a alguien desprevenido.",
                        "zh": "通过突然出现或突然行动，使某人措手不及、感到意外。"
