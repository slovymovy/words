                "translations": [
                    {
                        "translation_id": "e85f6272-731c-4c37-aad0-8ded3432b8d5",
                        "source_entry_id": "e11b8f27-786e-3d0d-a656-235b6c4e09c2",
                        "source_sense_id": "2ffc4aab-58c2-3663-a814-08eaf9bea0f8",
                        "target_lang_word": "Mandel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "der essbare Same einer ungenießbaren Steinfrucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3af4103a-5192-496f-9d10-5b26d993b87b",
                                                "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                                "text": "Aus Mandeln macht man Marzipan."
                                            },
                                            {
                                                "example_id": "ef7e1ec1-3291-41b8-82c3-2c7b6332394e",
                                                "sense_id": "33999bd8-cbe2-352d-9b54-93d8f5a136b9",
                                                "text": "„Die Teilnehmer des Hochzeitszuges überschütteten die Zuschauer mit kandierten Mandeln, dem traditionellen Hochzeitskonfekt, und türmten die übriggebliebenen Mandeln zu süßen weißen Bergen auf dem Brautbett auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b18e1ed7-1cd9-3477-97f8-eb9635abe525",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "der Baum, an dem ^([1]) wächst"
                                        ],
                                        "tags": [
                                            "Prunus dulcis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "742f4a2e-9009-40d6-95d2-1dda4b8d616c",
                                                "sense_id": "b18e1ed7-1cd9-3477-97f8-eb9635abe525",
                                                "text": "Die Mandeln blühen im März."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                        "entry_id": "cf4a2381-9f35-3bbf-a432-07191b290c4a",
                                        "glosses": [
                                            "Lymphknoten am Übergang von der Mundhöhle zum Rachen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21863f0c-312c-4552-adde-239d37931f45",
                                                "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                                "text": "Meine Mandeln mussten entfernt werden."
                                            },
                                            {
                                                "example_id": "df510d10-07f7-4a12-a7d4-0d91b1b554b7",
                                                "sense_id": "a22e7d83-aa05-360f-bffc-deb7076200b9",
                                                "text": "„Im Krankenhaus kriegte Renate die Mandeln raus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15057e4e-763e-33ef-85ff-024b76ed0f3a",
                                        "entry_id": "0685307b-6fa3-37b9-8a70-ab557da958fe",
                                        "glosses": [
                                            "altes Mengenmaß von 15 oder 16 Stück"
                                        ],
                                        "tags": [
                                            "beide Plurale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb9068fd-01fa-4a1d-833c-ee2f8b9b00c4",
                                                "sense_id": "15057e4e-763e-33ef-85ff-024b76ed0f3a",
                                                "text": "„Ohngefähr dritthalb Schock [goldene Eier gefunden]“ - „Allerliebster Papageno, Ihr ließt mir wohl eine Mandel zukommen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9b211a1-c50b-3edf-a479-8a289c34acf5",
                                        "entry_id": "0685307b-6fa3-37b9-8a70-ab557da958fe",
                                        "glosses": [
                                            "auf dem Feld zusammengelegte Garben (meist 15)"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ed21e63-7c31-45c1-bc83-f33e8383f3a2",
                                                "sense_id": "b9b211a1-c50b-3edf-a479-8a289c34acf5",
                                                "text": "im Fuldaischen fanden wir die Mandeln auf dem Felde und zwischen Hanau und Frankfurt nur noch die Stoppeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mandel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                        "entry_id": "bd759c93-5e80-3ef8-a65b-bbed261c270f",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a120674-400c-49a4-ad2e-de7c3148a843",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Frau Mandel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "9d8dda96-0cc6-4668-9f57-28335f706a62",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Herr Mandel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "20399659-f39d-484c-8fe0-3e9d496fa22f",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Die Mandels fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "0f40e1c0-1024-43fa-abc0-f4fe67fb7800",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Der Mandel trägt nie die Schals, die die Mandel ihm strickt."
                                            },
                                            {
                                                "example_id": "f6e06d0a-e65d-40ef-a312-bfc280f580b9",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mandel kommt, geht der Herr Mandel.“"
                                            },
                                            {
                                                "example_id": "ce5ff72b-9df5-45ed-977a-c909f966bab3",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Mandel kommt und geht."
                                            },
                                            {
                                                "example_id": "2adbf181-fc01-4a58-bba6-271f8d343227",
                                                "sense_id": "59af2a68-ee6e-3003-a666-5044e88fb110",
                                                "text": "Mandels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d14e032-fca2-42fb-8553-ac92c7b10c74",
                        "source_entry_id": "e11b8f27-786e-3d0d-a656-235b6c4e09c2",
                        "source_sense_id": "2ffc4aab-58c2-3663-a814-08eaf9bea0f8",
