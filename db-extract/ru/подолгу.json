                                "target_senses": [
                                    {
                                        "sense_id": "d853e5dc-ada3-3dff-80d8-9a54d9495d11",
                                        "entry_id": "5aac37d4-c8e0-342b-85d4-eab8276681d7",
                                        "glosses": [
                                            "über einen großen Zeitraum hinweg"
