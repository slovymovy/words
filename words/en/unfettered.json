{
    "word_family": [
        "fetter",
        "unfetter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1cea9d6-dded-3db0-bcb2-adb337526c09",
                    "sense_definition": "Not restricted, limited, or constrained by rules or authority.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "free_unrestricted",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist felt inspired and enjoyed <w>unfettered</w> creative freedom during her retreat.",
                            "target_lang_translations": {
                                "es": "La artista se sintió inspirada y disfrutó de una libertad creativa <w>sin trabas</w> durante su retiro."
                            }
                        },
                        {
                            "text": "Economists debated whether an <w>unfettered</w> market could solve the housing crisis without government intervention.",
                            "target_lang_translations": {
                                "es": "Los economistas debatieron si un mercado <w>libre de restricciones</w> podría resolver la crisis de vivienda sin intervención gubernamental."
                            }
                        }
                    ],
                    "synonyms": [
                        "untrammeled",
                        "unconstrained",
                        "unrestrained",
                        "unrestricted",
                        "unbridled"
                    ],
                    "antonyms": [
                        "fettered"
                    ],
                    "common_phrases": [
                        "unfettered access",
                        "unfettered growth",
                        "unfettered power"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no está limitado, restringido o coartado por normas o autoridades."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sin trabas",
                                "target_lang_sense_clarification": "libre de impedimentos o barreras"
                            },
                            {
                                "target_lang_word": "sin restricciones",
                                "target_lang_sense_clarification": "completamente libre, sin límites"
                            },
                            {
                                "target_lang_word": "irrestricto",
                                "target_lang_sense_clarification": "formal; sin limitaciones ni condiciones"
                            },
                            {
                                "target_lang_word": "libre",
                                "target_lang_sense_clarification": "carente de ataduras o restricciones"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7accf83-a987-3d62-9377-18656fcc5f34",
                    "sense_definition": "Not bound by physical chains, shackles, or manacles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_bonds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner rubbed his wrists in relief once his hands were finally <w>unfettered</w>.",
                            "target_lang_translations": {
                                "es": "El prisionero se frotó las muñecas aliviado una vez que sus manos quedaron por fin <w>desencadenadas</w>."
                            }
                        },
                        {
                            "text": "The blacksmith struck the iron until the captive stood completely <w>unfettered</w>.",
                            "target_lang_translations": {
                                "es": "El herrero golpeó el hierro hasta que el cautivo quedó completamente <w>sin grilletes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unshackled",
                        "unchained",
                        "unbound"
                    ],
                    "antonyms": [
                        "fettered"
                    ],
                    "common_phrases": [
                        "unfettered limbs"
                    ],
                    "target_lang_definitions": {
                        "es": "Que no está atado o sujeto por cadenas, grilletes o esposas físicas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desencadenado",
                                "target_lang_sense_clarification": "liberado de cadenas"
                            },
                            {
                                "target_lang_word": "sin grilletes",
                                "target_lang_sense_clarification": "físicamente desatado de cepos o ataduras"
                            },
                            {
                                "target_lang_word": "desatado",
                                "target_lang_sense_clarification": "libre de ligaduras físicas"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c67cfa6f-bd3e-3360-aefa-434880cee61f",
                    "sense_definition": "simple past and past participle of <w>unfetter</w>",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_bonds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard stepped forward and <w>unfettered</w> the prisoner before opening the door.",
                            "target_lang_translations": {
                                "es": "El guardia dio un paso al frente y <w>desencadenó</w> al prisionero antes de abrir la puerta."
                            }
                        },
                        {
                            "text": "After years of oppression, the movement had finally <w>unfettered</w> the nation's creative spirit.",
                            "target_lang_translations": {
                                "es": "Tras años de opresión, el movimiento finalmente había <w>liberado</w> el espíritu creativo de la nación."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Pasado simple y participio del verbo unfetter: liberar de cadenas, trabas o ataduras."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desencadenó",
                                "target_lang_sense_clarification": "liberó de cadenas (pasado simple)"
                            },
                            {
                                "target_lang_word": "liberó",
                                "target_lang_sense_clarification": "quitó las ataduras o restricciones (pasado simple)"
                            },
                            {
                                "target_lang_word": "desencadenado",
                                "target_lang_sense_clarification": "participio de desencadenar"
                            },
                            {
                                "target_lang_word": "liberado",
                                "target_lang_sense_clarification": "participio de liberar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}