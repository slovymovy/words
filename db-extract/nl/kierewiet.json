                "forms": [
                    {
                        "form_id": "055e38a3-a0aa-429a-a91f-9aa7f7a6313e",
                        "entry_id": "6a849c5d-aad2-3e41-9259-bb74f5912b23",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "kierewiets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bfdb5cf-52e5-3391-8f46-6efa221c54b2",
                        "entry_id": "6a849c5d-aad2-3e41-9259-bb74f5912b23",
                        "glosses": [
                            "helemaal gek en verward"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2da7ce10-d312-4a41-917f-c6c4f411baff",
                                "sense_id": "8bfdb5cf-52e5-3391-8f46-6efa221c54b2",
                                "text": "„Het vervelende van tv-mensjes is dat ze zeg maar allemaal het idee hebben dat de kijker achterlijk is. Dat er 700.000 mensen helemaal kierewiet zijn."
                            },
                            {
                                "example_id": "044b7081-025e-461d-a6d9-2a20c0fc9a6b",
                                "sense_id": "8bfdb5cf-52e5-3391-8f46-6efa221c54b2",
                                "text": "Dat hoogopgeleide, knappe vrouwen als bosjes vielen voor de vlotte babbel van ’neparts’ Mehmet A. is niet zo gek. De werkloze Turk, die zichzelf gepromoveerd had tot thoraxchirurg, wist het allemaal overtuigend te brengen. Journaliste Esther Wemmers sprak één van zijn slachtoffer: \"Hij maakt vrouwen helemaal kierewiet.\""
                            },
                            {
                                "example_id": "b6d45d68-ab1b-49fc-971b-a7444a8021a6",
                                "sense_id": "8bfdb5cf-52e5-3391-8f46-6efa221c54b2",
                                "text": "Mijn haar is nu vier dagen aan het uitvallen. Vooral tijdens het douchen verlies ik hele plukken tegelijk, maar ik ben bij lange na nog niet kaal. Hoeveel haar heeft een mens in godsnaam Ik word er helemaal kierewiet van."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "156df680-33de-4add-92b5-1d2d55ccdb3e",
                        "source_entry_id": "6a849c5d-aad2-3e41-9259-bb74f5912b23",
                        "source_sense_id": "8bfdb5cf-52e5-3391-8f46-6efa221c54b2",
                        "target_lang_word": "bonkers",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bonkers",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "792d54de-aad4-3283-b2da-9db7d4abb536",
                                        "entry_id": "6ef2e4e7-75d0-38a3-b09e-50d76e64d963",
                                        "glosses": [
                                            "Mad; crazy."
                                        ],
                                        "tags": [
                                            "British",
                                            "especially",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "035b041e-8d4f-47c4-869a-bfb9961b3fa0",
                                                "sense_id": "792d54de-aad4-3283-b2da-9db7d4abb536",
                                                "text": "[A]nd we should remind ourselves that it is absolutely bonkers that we elect judges at all; that system is used almost nowhere else on earth[.]"
                                            },
                                            {
                                                "example_id": "c1bb3dfc-cd98-416b-bdcf-d7829f1d5c9a",
                                                "sense_id": "792d54de-aad4-3283-b2da-9db7d4abb536",
                                                "text": "\"They are turning people off travelling. And the removal of catering on such a long-distance route is just bonkers.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bonkers",
                                "target_lang_code": "en",
                                "target_senses": [
