                ],
                "senses": [
                    {
                        "sense_id": "bff622ad-1aa8-3354-ad95-987e3d748bf5",
                        "entry_id": "543b9119-4c47-376e-b9d3-cf01c6863c77",
                        "glosses": [
                            "mehrere Leuchtmittel an einem gemeinsamen Träger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "386d51dc-2c2b-4d74-a543-e01ac6754561",
                                "sense_id": "bff622ad-1aa8-3354-ad95-987e3d748bf5",
                                "text": "Weihnachtsbäume werden gerne mit Lichterketten geschmückt."
                            },
                            {
                                "example_id": "0bdaaf7c-e5b4-4c38-82a6-8e37e0c006e1",
                                "sense_id": "bff622ad-1aa8-3354-ad95-987e3d748bf5",
                                "text": "„Es ist früher Abend, überall leuchten bunte Lichterketten, auf den Straßen drängen sich die Autos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "37a176e5-92aa-3714-b64e-f5540cdf9dfc",
                        "entry_id": "543b9119-4c47-376e-b9d3-cf01c6863c77",
                        "glosses": [
                            "Ausdrucksform der friedlichen Demonstration mit brennenden Kerzen oder anderen Lichtquellen in der Hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd37f35-a671-4f44-a39f-498cc51a495f",
                                "sense_id": "37a176e5-92aa-3714-b64e-f5540cdf9dfc",
                                "text": "„Und ich nahm zum ersten Mal in meinem Leben an einer Lichterkette teil.“"
                            },
                            {
                                "example_id": "3496e56c-ffa0-4ee7-866d-f8d20c562346",
                                "sense_id": "37a176e5-92aa-3714-b64e-f5540cdf9dfc",
                                "text": "„Mit Kerzen in den Händen bildeten Menschen gegen 19 Uhr eine Lichterkette gegen Fremdenfeindlichkeit um den Innnenstadtring.“"
                            },
                            {
                                "example_id": "b407f233-27be-4da2-808d-09040ac49bdf",
                                "sense_id": "37a176e5-92aa-3714-b64e-f5540cdf9dfc",
                                "text": "„Noch gab es die Lichterketten in Deutschland nicht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69920dfa-fa6f-4561-9893-71317f3e4c51",
                        "source_entry_id": "543b9119-4c47-376e-b9d3-cf01c6863c77",
