                "senses": [
                    {
                        "sense_id": "5ba74d00-9e6f-3db6-8c60-0dcf188938da",
                        "entry_id": "4c941a98-542e-3477-a871-70513d5314f7",
                        "glosses": [
                            "Approaching death; about to die; dying; expiring."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "bef512f3-7e70-4064-b313-3db9dd4c9fee",
                                "sense_id": "5ba74d00-9e6f-3db6-8c60-0dcf188938da",
                                "text": "These moribund shapes were free as air—and nearly as thin."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc91fb1a-1bdb-38c7-9dcc-4bf0f96671c1",
                        "entry_id": "4c941a98-542e-3477-a871-70513d5314f7",
                        "glosses": [
                            "Almost obsolete; nearing an end."
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
