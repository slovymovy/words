                    {
                        "sense_id": "bf8233e2-a890-33a7-b2f7-e488cdcc8f0d",
                        "entry_id": "7d6dc3e5-473e-3c45-b163-7668239eb83a",
                        "glosses": [
                            "Côte assez pentue mais courte, raidillon."
