            {
                "entry_id": "26ce33a0-2619-37cc-b35a-f7de09f2be9e",
                "word": "maïeutique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1b5b2770-6418-4542-a7af-81a1cc67b553",
                        "entry_id": "26ce33a0-2619-37cc-b35a-f7de09f2be9e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "maïeutiques"
