                "senses": [
                    {
                        "sense_id": "a579d285-1423-3031-be20-0d400b3b0320",
                        "entry_id": "1587482f-d0ab-3819-95cf-434c7ae2564b",
                        "glosses": [
                            "der Sonnabend der Karwoche; der Tag zwischen Karfreitag und Ostersonntag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff0084a-145a-46b7-8af1-364d22e7b123",
                                "sense_id": "a579d285-1423-3031-be20-0d400b3b0320",
                                "text": "Früher wurde der Karsonnabend in Gedenken an die Grabesruhe Christi als liturgiefreier Tag begangen."
                            },
                            {
                                "example_id": "ed159e4c-3345-4d44-b37b-1f9592d8efd8",
                                "sense_id": "a579d285-1423-3031-be20-0d400b3b0320",
                                "text": "Heute wird der Karsonnabend oft als Tag der Osterwache mit der Weihe der Osterkerze und des Taufwassers gefeiert."
                            },
                            {
                                "example_id": "aae23162-3c16-4032-be99-8d0e55dbb71c",
                                "sense_id": "a579d285-1423-3031-be20-0d400b3b0320",
                                "text": "In diesem Jahrhundert waren bisher alle Karsonnabende sonnig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
