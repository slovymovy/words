                                "target_senses": [
                                    {
                                        "sense_id": "1312e248-0e5e-37a4-aa07-57611ce5a487",
                                        "entry_id": "c20e0023-abd5-35eb-8640-0f70fcf39292",
                                        "glosses": [
                                            "A female persecutor."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2dcc3d1-fff3-42d4-a975-16ea6209bcda",
                                                "sense_id": "1312e248-0e5e-37a4-aa07-57611ce5a487",
                                                "text": "...and Madame de la Perriere — cruel to me when I was a little thing, a child, at her school, is my persecutrix still."
                                            },
                                            {
                                                "example_id": "e21362c4-0fc8-42ae-8b4b-adb9104230f9",
                                                "sense_id": "1312e248-0e5e-37a4-aa07-57611ce5a487",
                                                "text": "She is the grand-daughter of poor Caroline Matilda, and he the grandson of her persecutrix, the Dowager Queen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
