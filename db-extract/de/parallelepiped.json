                "senses": [
                    {
                        "sense_id": "a81c5a11-c295-3883-8dee-bdd9a83e262a",
                        "entry_id": "15f059ae-063a-32c8-b345-0896bfa85e31",
                        "glosses": [
                            "geometrischer Körper, dessen Seitenflächen sechs paarweise kongruente, parallel liegende Parallelogramme sind"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "ccca5823-deaa-4809-9985-613c406714d9",
                                "sense_id": "a81c5a11-c295-3883-8dee-bdd9a83e262a",
                                "text": "„Ein Parallelepiped hat zwölf Kanten, von denen je vier parallel verlaufen und untereinander gleich lang sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e0b151a-2e3d-45d4-aa31-109ddcfcba14",
                        "source_entry_id": "15f059ae-063a-32c8-b345-0896bfa85e31",
                        "source_sense_id": "a81c5a11-c295-3883-8dee-bdd9a83e262a",
                        "target_lang_word": "parallelepiped",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parallelepiped",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a95d8952-9b4f-366a-a4bc-01f2b921d558",
                                        "entry_id": "bb66e52b-3d0a-3ca8-8d99-19a6b3db01b6",
                                        "glosses": [
                                            "A solid figure, having six faces, all parallelograms, all opposite faces being similar and parallel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db338df5-b6e4-4c3c-987d-c0e093fe13a4",
                                                "sense_id": "a95d8952-9b4f-366a-a4bc-01f2b921d558",
                                                "text": "A cuboid is a rectangular parallelepiped."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92bc6242-c2ed-489f-adaf-46d9bff0a664",
                        "source_entry_id": "15f059ae-063a-32c8-b345-0896bfa85e31",
                        "source_sense_id": "a81c5a11-c295-3883-8dee-bdd9a83e262a",
                        "target_lang_word": "parallélépipède",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parallélépipède",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2414dd1c-c1a8-3a76-aa1a-b8d7ffed7965",
                                        "entry_id": "f05fc6ac-c663-3fff-b61c-0b1766a4ea9f",
                                        "glosses": [
                                            "Forme tridimensionnelle à six faces (hexaèdre) qui sont toutes des parallélogrammes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28e65650-08a7-4831-aaf8-6464ea0aa11d",
                                                "sense_id": "2414dd1c-c1a8-3a76-aa1a-b8d7ffed7965",
                                                "text": "Le volume d’un parallélépipède quelconque a pour mesure le produit de sa base par sa hauteur."
                                            },
                                            {
                                                "example_id": "137f8f85-dedf-472e-b68e-b3631dd64119",
                                                "sense_id": "2414dd1c-c1a8-3a76-aa1a-b8d7ffed7965",
                                                "text": "Si les trois arêtes a, b, c étaient égales entre elles, le parallélépipède se réduirait à un cube […]."
                                            },
                                            {
                                                "example_id": "fcd47224-ccea-46c2-88b4-6b6130caefc9",
                                                "sense_id": "2414dd1c-c1a8-3a76-aa1a-b8d7ffed7965",
                                                "text": "Un parallélépipède à une dimension est un segment et son 1-volume est simplement sa longueur. Un parallélépipède à deux dimensions est un parallélogramme et son 2-volume est généralement appelé aire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ef6b90b-2ce1-38b8-a3a8-d901952e5333",
                                        "entry_id": "f05fc6ac-c663-3fff-b61c-0b1766a4ea9f",
                                        "glosses": [
                                            "Volume ou objet qui a les caractéristiques géométriques du parallélépipède."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1855ac5-3e9a-4b34-ae4b-b0e769bd12cf",
                                                "sense_id": "5ef6b90b-2ce1-38b8-a3a8-d901952e5333",
                                                "text": "Sur cette montagne se trouvent plusieurs lacs. Les rochers sont en majeure partie des cylindres ou des parallélépipèdes de rocs fendus […]."
                                            },
                                            {
                                                "example_id": "0007b7d3-c941-42ad-81bd-5db06c373938",
                                                "sense_id": "5ef6b90b-2ce1-38b8-a3a8-d901952e5333",
                                                "text": "Il en était à plusieurs clopes quand elle ressortit de son immeuble, un cube de huit étages aussi beau qu’une boîte de lessive mais avec beaucoup plus d’ouvertures. Un cube ? crut-il bon de rectifier in petto ; un parallélépipède, plus exactement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0942c4c4-afb7-4ac3-9f74-0432e876df5d",
                        "source_entry_id": "15f059ae-063a-32c8-b345-0896bfa85e31",
                        "source_sense_id": "a81c5a11-c295-3883-8dee-bdd9a83e262a",
