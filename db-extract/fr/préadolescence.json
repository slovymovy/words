                                "sense_id": "7843d836-d825-3a94-aefb-3f9cc9be5209",
                                "text": "La préadolescence couvre environ les deux années qui précèdent la puberté."
                            },
                            {
                                "example_id": "e81ba2e3-e172-47f0-b181-fdcfb6682a0b",
                                "sense_id": "7843d836-d825-3a94-aefb-3f9cc9be5209",
                                "text": "La préadolescence concerne les enfants entre 8 et 12 ans environ."
                            }
                        ]
                    }
