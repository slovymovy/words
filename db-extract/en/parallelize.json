                "senses": [
                    {
                        "sense_id": "eb715090-82e4-3a22-af27-1e9560eb4df3",
                        "entry_id": "e1f27442-4f01-3d1c-a489-3a73f1ae8da4",
                        "glosses": [
                            "To make parallel (to each other)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba1724e-d51b-4fc3-8355-6c9bb1f87bbc",
                                "sense_id": "eb715090-82e4-3a22-af27-1e9560eb4df3",
                                "text": "Care must be taken lest the machine parallelize the fibers."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dce148f-01bd-327f-b84f-a76db9be04b3",
                        "entry_id": "e1f27442-4f01-3d1c-a489-3a73f1ae8da4",
                        "glosses": [
                            "To make to execute in parallel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "920508cf-a653-4644-a0dd-16f02f81d200",
                                "sense_id": "9dce148f-01bd-327f-b84f-a76db9be04b3",
                                "text": "The programmers had to learn how to parallelize their algorithms."
                            },
                            {
                                "example_id": "24c92773-dc6f-4a2d-9ee1-bdfa8cbb3fb3",
                                "sense_id": "9dce148f-01bd-327f-b84f-a76db9be04b3",
                                "text": "We present a general method to parallelize branch & bound algorithms on transputer networks and an application of this method to solve symmetric traveling salesman problems by a best first branch & bound strategy."
                            }
                        ]
                    },
                    {
                        "sense_id": "91976573-2795-3522-a145-23db070a79d9",
                        "entry_id": "e1f27442-4f01-3d1c-a489-3a73f1ae8da4",
                        "glosses": [
                            "To treat as if parallel; to draw parallels between."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "343e7180-c7d3-4c21-a910-7c66a4733b5e",
                                "sense_id": "91976573-2795-3522-a145-23db070a79d9",
                                "text": "They erroneously parallelized the symptoms of the two diseases."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11a74611-2a80-4424-98a0-e59be68a621c",
                        "source_entry_id": "e1f27442-4f01-3d1c-a489-3a73f1ae8da4",
                        "source_sense_description": "make parallel",
                        "target_lang_word": "paralléliser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paralléliser",
