                ],
                "senses": [
                    {
                        "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                        "entry_id": "a2fa48cb-84da-357a-af94-ef2cfa2f0572",
                        "glosses": [
                            "Fachgebiet der Informationstechnologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924facfc-3194-4843-9197-5fe7e0a9f62f",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„In Zeiten des Fachkräftemangels, der insbesondere den IT-Bereich erfasst, ist das keine einfache Aufgabe.“"
                            },
                            {
                                "example_id": "5917b5e6-3a4d-4ccd-8458-0b0ecd17cdbf",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Ein Großteil der jungen Gründer beschäftigt sich mit innovativen Ideen aus dem IT-Bereich, häufig handelt es sich aber auch um neue Produkte in der Lebensmittelbranche oder im Gesundheitswesen.“"
                            },
                            {
                                "example_id": "0c8acb8f-ac37-4abb-a4b2-bb0378be70b7",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Trotz der nach wie vor geringen Frauenquote im IT-Bereich ist das Geschlechterverhältnis in Bezug auf die fünf Branchen mit dem höchsten Index-Wert absolut gesehen sehr ausgeglichen: Neben vier Millionen Frauen seien hier rund 3,9 Millionen Männer tätig.“"
                            },
                            {
                                "example_id": "13864e03-326f-463a-9f91-6acacec4c6f3",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Auch im IT-Bereich, wenn es um sensible Daten geht, deren Verluste ein paar Millionen kosten können, braucht es zumindest präzise Vorgaben und auch eine regelmäßige Qualitätskontrolle.“"
                            },
                            {
                                "example_id": "a797147d-320f-473c-a6df-7b4dd97c935d",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Naab hatte Politikwissenschaft und vergleichende Religionswissenschaft studiert und war als Lehrer angestellt, Bay hat im IT-Bereich für die Deutsche Bahn gearbeitet.“"
                            },
                            {
                                "example_id": "5706e920-c960-4242-9686-8c4393c65bf3",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Mehr Arbeitsplätze sind dagegen, wenig überraschend, im IT-Bereich zu erwarten, dort, wo die Fortschritte der Digitalisierung erdacht und konstruiert werden.“"
                            },
                            {
                                "example_id": "9f5f8d7b-3293-4b3b-8e4c-1586d8b32a9a",
                                "sense_id": "d2aa17bd-b52a-3230-a93e-5f51c3974c55",
                                "text": "„Im IT-Bereich sei nicht nur das fachliche Können, sondern auch die Arbeitsweise entscheidend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
