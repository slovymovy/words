                                        "sense_id": "f4a901d0-5f02-31c9-accd-2c029a74b9fe",
                                        "entry_id": "230ac6e6-efae-3590-82bb-58d6728bc6bd",
                                        "glosses": [
                                            "in de toestand van een vrouw wanneer er in haar baarmoeder een bevruchting heeft plaatsgevonden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e57b19e-c448-48bd-8132-da7d29908553",
                                                "sense_id": "f4a901d0-5f02-31c9-accd-2c029a74b9fe",
                                                "text": "Als ik zo afwezig was plaagde ze me vroeger wel eens door tussen neus en lippen te melden dat ze zwanger was, waarbij ik uit afwezigheid niet eens opkeek."
                                            },
                                            {
                                                "example_id": "e525c59c-d7cf-4e17-9419-7665b18f90a9",
                                                "sense_id": "f4a901d0-5f02-31c9-accd-2c029a74b9fe",
                                                "text": "Ironisch genoeg kon ik geen woorden vinden om hem te vertellen dat ik hem miste, dat er rare dingen gebeurden met Quick, dat mijn beste vriendin zwanger was en dat ik me net een onbeholpen puber voelde."
                                            },
                                            {
                                                "example_id": "738a0865-6267-40c5-a87d-9a2695e58cc7",
                                                "sense_id": "f4a901d0-5f02-31c9-accd-2c029a74b9fe",
                                                "text": "Sarah draaide zich paniekerig om, en Olive zag aan haar bolle buik dat ze zwanger was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99a8589f-f7a9-3496-a58d-553a5a26ee01",
                                        "entry_id": "230ac6e6-efae-3590-82bb-58d6728bc6bd",
                                        "glosses": [
                                            "zo vol met iets dat het te verwachten valt dat het eruit gaat komen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70157193-3d3a-4cf7-92f6-b91f4d9c8ddd",
                                                "sense_id": "99a8589f-f7a9-3496-a58d-553a5a26ee01",
                                                "text": "Hoewel het die nacht al zwaar had geregend, was de lucht nog steeds dicht en donker, zwanger van water. Hij omhulde me, en ik kon bijna niet ademhalen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zwanger",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "295bdaed-3f16-3f8a-a948-1756b0f5fcdf",
                                        "entry_id": "947a8b3e-c994-3c72-8e2a-9a3f45430eb8",
