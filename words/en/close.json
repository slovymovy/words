    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70aac00f-36e2-365e-8d47-be1b0fc6b3fc",
                    "sense_definition": "To move something so that it covers an opening, hole, or gap; to shut.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "shutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>close</w> the door behind you when you leave.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>закройте</w> за собой дверь, когда будете уходить.",
                                "pl": "Proszę <w>zamknij</w> za sobą drzwi, kiedy będziesz wychodzić."
                            }
                        },
                        {
                            "text": "Jim <w>closed</w> his eyes and tried to sleep.",
                            "target_lang_translations": {
                                "ru": "Джим <w>закрыл</w> глаза и попытался уснуть.",
                                "pl": "Jim <w>zamknął</w> oczy i próbował zasnąć."
                            }
                        }
                    ],
                    "synonyms": [
                        "shut"
                    ],
                    "antonyms": [
                        "open"
                    ],
                    "common_phrases": [
                        "close the door",
                        "close your eyes",
                        "close a window"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переместить что-либо так, чтобы закрыть отверстие или проход; затворить.",
                        "pl": "Przesunąć coś tak, aby zakryć otwór, dziurę lub szczelinę; zamknąć."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "дверь, окно, глаза (несов. вид)"
                            },
                            {
                                "target_lang_word": "закрыть",
                                "target_lang_sense_clarification": "дверь, окно, глаза (сов. вид)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zamykać",
                                "target_lang_sense_clarification": "drzwi, okno, oczy (niedokonany)"
                            },
                            {
                                "target_lang_word": "zamknąć",
                                "target_lang_sense_clarification": "drzwi, okno, oczy (dokonany)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d58c5e58-c512-3ea4-815d-34ec4bf557af",
                    "sense_definition": "To bring something to an end; to finish or conclude.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chairman <w>closed</w> the meeting after a short speech.",
                            "target_lang_translations": {
                                "ru": "Председатель <w>закрыл</w> собрание после короткой речи.",
                                "pl": "Przewodniczący <w>zamknął</w> spotkanie po krótkim przemówieniu."
                            }
                        },
                        {
                            "text": "We hope to <w>close</w> the deal by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся <w>закрыть</w> сделку к концу недели.",
                                "pl": "Mamy nadzieję <w>domknąć</w> interes do końca tygodnia."
                            }
                        }
                    ],
                    "synonyms": [
                        "finish",
                        "end",
                        "wrap up"
