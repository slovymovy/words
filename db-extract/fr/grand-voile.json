                ],
                "senses": [
                    {
                        "sense_id": "ef652806-23cc-39de-965e-5a106e8214cd",
                        "entry_id": "31e274d3-9670-3545-951d-dc67bf8a72f6",
                        "glosses": [
                            "Voile de forme triangulaire, maintenue d’un côté par le mât, et de l’autre sur la bôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d364a74-c77a-4260-b4be-d23bbb3a8fb6",
                                "sense_id": "ef652806-23cc-39de-965e-5a106e8214cd",
                                "text": "Il y avait beaucoup de lumières sur la mer, et le vent régulier et violent qui soufflait, après avoir contourné le promontoire, poussait devant lui un sloop dont la grand-voile et le spinnaker étaient totalement déployés."
                            },
                            {
                                "example_id": "e81fe6bd-d3cf-427a-9dbc-47f35a4b3c17",
                                "sense_id": "ef652806-23cc-39de-965e-5a106e8214cd",
                                "text": "Je largue le hale-bas de grand-voile, lâche un peu de bras afin que le spi vienne sous la grand-voile. La situation est rétablie après quelques minutes d'effort."
                            }
                        ]
                    },
                    {
                        "sense_id": "833a25c3-e555-3590-98b6-5bbdf66cc5ed",
                        "entry_id": "31e274d3-9670-3545-951d-dc67bf8a72f6",
                        "glosses": [
                            "la plus grande voile à la base du grand-mât."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
