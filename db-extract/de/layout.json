                                "target_senses": [
                                    {
                                        "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Modèle réduit d’un ouvrage d’art, esquisse d’ensemble (d’un panneau décoratif, par exemple)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca8cb99-042e-4f5d-a0f3-b70a1c623af7",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Les lourdes bâtisses de Trondjem, à l'allure guindée, semblent placées provisoirement comme des maquettes de monuments à venir. Elles font penser à ces villes artificielles que les favoris de Catherine de Russie semaient sur ses pas."
                                            },
                                            {
                                                "example_id": "822e451a-b464-4fed-8402-cf65936801b6",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Je vais fabriquer une maquette de couplets pour y adapter ma mélodie."
                                            },
                                            {
                                                "example_id": "b25f22d0-95d1-4ffb-ba95-56288800c07e",
                                                "sense_id": "1ab7bca8-174d-3636-a70a-b7f1680e1a6e",
                                                "text": "Cette reconstitution de ce que j’ai dû éprouver est pareille à une maquette en carton reproduisant en un modèle réduit ce qu’avaient pu être les bâtiments, les maisons, les temples, les rue, les places et les jardins d’une ville engloutie…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1dc3b4c-d351-3f45-bd32-0d3b01ce0b9a",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Projet permettant de donner l’aperçu le plus juste de ce que sera la réalisation, destiné à permettre le montage des pages (ou des écrans et dialogues, dans le cas d’un logiciel)."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a969dfb-db95-3d18-8eeb-0d8de4dad10c",
                                        "entry_id": "0f52c496-ca81-32a0-b0b9-6e1a95b075e8",
                                        "glosses": [
                                            "Réalisation sous forme de montage expérimental d’un circuit électronique destiné à l’intégration."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
