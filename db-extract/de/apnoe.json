                    {
                        "translation_id": "e4ca5774-9c91-4d5d-92b2-1cf9165854ae",
                        "source_entry_id": "7e71176a-219b-3572-a251-153cbba2a0f3",
                        "source_sense_id": "8fc01e7f-a830-35b4-a5b5-d84d94daac95",
                        "source_sense_description": "Medizin: Atemlähmung, Atemstillstand",
                        "target_lang_word": "apnea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apnea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b840b74-e9fb-3469-9f67-b9776a12b93a",
                                        "entry_id": "f034833a-6e4f-3f57-8ec0-2269128bdb62",
                                        "glosses": [
                                            "The cessation of breathing, most often in reference to transient instances thereof during sleep."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
