                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ordre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au <w>commandement</w> de halte, tous les marcheurs se sont arrêtés d'un seul bloc."
                        },
                        {
                            "text": "Le sergent a hurlé un <w>commandement</w> pour aligner les nouvelles recrues dans la cour."
                        }
                    ],
                    "synonyms": [
                        "mot d'ordre"
                    ],
                    "common_phrases": [
