                    {
                        "sense_id": "dde15a3a-ff17-3280-b1e0-3e94a9e494d2",
                        "entry_id": "b0c03c5b-c51f-3f26-bc77-145595d99cb8",
                        "glosses": [
                            "een strand waar het gebruikelijk en toegestaan is naakt te baden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b5c6752-d2d3-435b-be31-e23326a0b44c",
                                "sense_id": "dde15a3a-ff17-3280-b1e0-3e94a9e494d2",
                                "text": "We zijn vanmiddag naar het naaktstrand geweest."
                            },
                            {
                                "example_id": "eb948e73-32bf-4c99-ae3f-f6dffaa77b11",
                                "sense_id": "dde15a3a-ff17-3280-b1e0-3e94a9e494d2",
                                "text": "Omdat ik nog nooit op een naaktstrand of naturistencamping was geweest, merkte ik voor het eerst hoe natuurlijk het voelt om zonder kleren door de natuur te lopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12225c6d-0bc8-4bc7-b6fd-377959de836a",
                        "source_entry_id": "b0c03c5b-c51f-3f26-bc77-145595d99cb8",
                        "source_sense_id": "dde15a3a-ff17-3280-b1e0-3e94a9e494d2",
                        "source_sense_description": "een strand waar het gebruikelijk en toegestaan is naakt te baden",
                        "target_lang_word": "FKK-Strand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "FKK-Strand",
