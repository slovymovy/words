                "senses": [
                    {
                        "sense_id": "5e3e8311-7669-33d2-897e-04eb25089d69",
                        "entry_id": "789ae3e7-464f-3ad5-b448-bc5df04b244d",
                        "glosses": [
                            "Rakete, die den für ihren Flug benötigten Treibstoff in fester Form mit sich führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "358c00a1-decc-45aa-b781-aa52338f673b",
                                "sense_id": "5e3e8311-7669-33d2-897e-04eb25089d69",
                                "text": "„Als Ursache der Katastrophe konnte ein Schaden an einem Dichtungsring der Feststoffrakete ermittelt werden.“"
                            },
                            {
                                "example_id": "51e7699c-0ba7-486c-8416-6637d663111f",
                                "sense_id": "5e3e8311-7669-33d2-897e-04eb25089d69",
                                "text": "„Die Triebwerke von Flüssigtreibstoff-Raketen, wie sie Nordkorea und Iran besitzen, brennen rund vier Minuten lang, die von fortschrittlicheren Feststoffraketen nur rund 170 Sekunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
