                ],
                "senses": [
                    {
                        "sense_id": "d4e9c245-35df-3eca-b783-6e918a092b41",
                        "entry_id": "d310bf88-d503-3318-9db5-2071495ee6d2",
                        "glosses": [
                            "Chien de taille imposante souvent à l’origine employé à la garde des troupeaux."
                        ],
                        "tags": [
                            "Cynologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d94f8e06-b5c2-4a65-82c8-48a0f6090864",
                                "sense_id": "d4e9c245-35df-3eca-b783-6e918a092b41",
                                "text": "Le bruit de cette chute souleva une tempête de jappements féroces parmi tous les dogues, mâtins et molosses qui faisaient ripaille à la ronde."
                            },
                            {
                                "example_id": "9456f5e8-f150-4e67-abb4-835fc925d4cb",
                                "sense_id": "d4e9c245-35df-3eca-b783-6e918a092b41",
                                "text": "La presse de gauche guette mon petit Albert, je le sais : j’ai mes espions. Ces gens-là vont bondir sur cette calomnie comme des molosses sur une charogne."
                            },
                            {
                                "example_id": "8396b346-da7a-4c7d-a8d6-1d44aebdc98d",
                                "sense_id": "d4e9c245-35df-3eca-b783-6e918a092b41",
                                "text": "Les molosses se taisent! L'auraient-ils déjà mis en pièces?"
                            }
                        ]
                    },
                    {
                        "sense_id": "2ad1ed16-f14b-3793-ac98-b33aa731b032",
                        "entry_id": "d310bf88-d503-3318-9db5-2071495ee6d2",
                        "glosses": [
                            "(Par analogie) Chauve-souris de très grande taille de la famille des molossidés (Molossidae) dont le museau est renflé comme celui d'un dogue."
                        ],
                        "tags": [
                            "Chiroptérologie"
                        ],
                        "examples": []
                    },
