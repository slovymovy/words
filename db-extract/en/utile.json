                        "glosses": [
                            "A theoretical unit of measure of utility, for indicating a supposed quantity of satisfaction derived from an economic transaction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6013f542-7388-43da-8f80-81bb6e3074b5",
                                "sense_id": "1c0e5406-25ac-38c1-8db6-08fd7bb17dc3",
                                "text": "Rational agents always maximize the number of utiles procured; that is, they will always choose those outcomes which promise to produce the most utiles."
                            },
                            {
                                "example_id": "49a438c8-c913-454f-af28-b499042eb250",
                                "sense_id": "1c0e5406-25ac-38c1-8db6-08fd7bb17dc3",
                                "text": "[T]he ‘happiness utile’ does not exist, at least not yet."
                            }
