{
    "word_family": [
        "verwringen",
        "wringen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "805868de-b35b-3a66-b62d-67c47fb82805",
                    "sense_definition": "Vervormd of verdraaid door fysieke of mentale kracht, niet meer in de oorspronkelijke vorm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het ongeluk lag het metaal van de auto <w>verwrongen</w> op de weg.Het was een verschrikkelijk gezicht om het <w>verwrongen</w> metaal van de auto te zien. ",
                            "target_lang_translations": {
                                "en": "After the accident, the metal of the car lay <w>twisted</w> on the road. It was a terrible sight to see the <w>twisted</w> metal of the car."
                            }
                        },
                        {
                            "text": "Hij keek naar mij met een <w>verwrongen</w> gezicht van de pijn.",
                            "target_lang_translations": {
                                "en": "He looked at me with a face <w>contorted</w> in pain."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervormd",
                        "verdraaid"
                    ],
                    "common_phrases": [
                        "verwrongen metaal",
                        "verwrongen beeld",
                        "verwrongen gezicht"
                    ],
                    "target_lang_definitions": {
                        "en": "Deformed or twisted by physical or mental force, no longer in its original shape."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twisted",
                                "target_lang_sense_clarification": "physically or metaphorically contorted"
                            },
                            {
                                "target_lang_word": "distorted",
                                "target_lang_sense_clarification": "altered from true shape or meaning"
                            },
                            {
                                "target_lang_word": "warped",
                                "target_lang_sense_clarification": "bent out of shape"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "422dd76b-28fe-3820-8dcf-0fb3b614d085",
                    "sense_definition": "Voltooid deelwoord van <w>verwringen</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De krachtige wind heeft het hek helemaal <w>verwrongen</w>. Hij heeft zijn enkel <w>verwrongen</w> tijdens het voetballen.",
                            "target_lang_translations": {
                                "en": "The strong wind completely <w>twisted</w> the fence. He <w>sprained</w> his ankle playing soccer."
                            }
                        },
                        {
                            "text": "De hevige storm heeft de stalen constructie volledig <w>verwrongen</w>.",
                            "target_lang_translations": {
                                "en": "The severe storm completely <w>warped</w> the steel structure."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'verwringen' (to twist or distort)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twisted",
                                "target_lang_sense_clarification": "past participle of twist"
                            },
                            {
                                "target_lang_word": "distorted",
                                "target_lang_sense_clarification": "past participle of distort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "114b3fab-c284-3755-8374-cc09e4a4f007",
                    "sense_definition": "Verleden tijd meervoud van <w>verwringen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen zij de ijzeren staven <w>verwrongen</w>, veroorzaakte dat veel lawaai.",
                            "target_lang_translations": {
                                "en": "When they <w>twisted</w> the iron bars, it caused a lot of noise."
                            }
                        },
                        {
                            "text": "De werkmannen <w>verwrongen</w> het oude hekwerk om het makkelijker mee te kunnen nemen.",
                            "target_lang_translations": {
                                "en": "The workmen <w>bent</w> the old fencing to take it away more easily."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past tense plural of 'verwringen' (to twist or distort)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "twisted",
                                "target_lang_sense_clarification": "past tense plural of twist"
                            },
                            {
                                "target_lang_word": "distorted",
                                "target_lang_sense_clarification": "past tense plural of distort"
                            }
                        ]
                    }
                }
            ]
        }
    ]
