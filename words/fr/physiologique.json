            "senses": [
                {
                    "sense_id": "677cc000-a1bc-35c0-9508-ae53408f5e70",
                    "sense_definition": "Qui concerne les besoins physiques vitaux et élémentaires de l'organisme.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dormir suffisamment est un besoin <w>physiologique</w> indispensable pour préserver sa santé."
                        },
                        {
                            "text": "La soif et la faim sont des besoins <w>physiologiques</w> essentiels pour rester en vie."
                        }
                    ],
                    "common_phrases": [
                        "besoin physiologique",
                        "besoins physiologiques"
                    ]
                },
                {
                    "sense_id": "c83980aa-5eb3-3bb3-8e0c-9800a76acbec",
                    "sense_definition": "Qui relève d'un état ou d'un processus normal et naturel de l'organisme, par opposition à une maladie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chez le nouveau-né, une légère jaunisse dans les premiers jours est souvent <w>physiologique</w>."
                        },
                        {
                            "text": "Le médecin confirme que cette réaction corporelle est totalement <w>physiologique</w> après un effort intense."
                        }
                    ],
                    "antonyms": [
                        "pathologique"
                    ],
                    "common_phrases": [
                        "sérum physiologique"
                    ]
                },
                {
                    "sense_id": "24f95b50-edc6-3e55-9801-98aeb7d05d71",
                    "sense_definition": "Qui concerne le fonctionnement des organes ou des systèmes biologiques d'un organisme vivant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le froid intense provoque une réaction <w>physiologique</w> immédiate pour limiter la perte de chaleur."
                        },
                        {
                            "text": "L'entraînement régulier entraîne une adaptation <w>physiologique</w> favorable de l'appareil respiratoire."
                        }
                    ],
                    "antonyms": [
                        "psychologique"
                    ],
                    "common_phrases": [
                        "réaction physiologique",
                        "processus physiologique",
                        "mécanisme physiologique"
                    ]
                },
                {
                    "sense_id": "214d43ce-595d-36f4-b35e-2cfadc486c92",
                    "sense_definition": "Qui appartient à la physiologie, science qui étudie les fonctions et les propriétés des organes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce laboratoire universitaire mène une recherche <w>physiologique</w> avancée sur la mémoire humaine."
                        },
                        {
                            "text": "Les scientifiques ont formulé plusieurs lois <w>physiologiques</w> pour expliquer ces phénomènes complexes."
