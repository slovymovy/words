                                "target_senses": [
                                    {
                                        "sense_id": "8e0d0df2-e2e1-383f-8e10-9c0fa9ed94e1",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "A person who oversees and directs the work of others; a supervisor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "711a3637-3945-4273-a08a-b7009ddc8f0c",
                                                "sense_id": "8e0d0df2-e2e1-383f-8e10-9c0fa9ed94e1",
                                                "text": "The boss of the company was going to Spain for work."
                                            },
                                            {
                                                "example_id": "1bb9deb0-0cad-4890-b283-52754a7dc3c8",
                                                "sense_id": "8e0d0df2-e2e1-383f-8e10-9c0fa9ed94e1",
                                                "text": "February 18, 2018, Dawn Pine, Strategies for Dealing with a Bad Boss\nwe have some vindictive people as bosses, and you don’t want to be the target of their wrath."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59108ce2-6f63-3249-8107-86f077c55f57",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "A person in charge of a business or company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907d8ea2-46c3-4065-8282-7c318a5e623c",
                                                "sense_id": "59108ce2-6f63-3249-8107-86f077c55f57",
                                                "text": "Chat turned to whisper when the boss entered the conference room."
                                            },
                                            {
                                                "example_id": "7da62684-8f6f-4ac0-8c41-b1a04a208433",
                                                "sense_id": "59108ce2-6f63-3249-8107-86f077c55f57",
                                                "text": "My boss complains that I'm always late to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f11c5882-72e9-3b97-9a2d-8085fdde8f53",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "A leader, the head of an organized group or team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c365732-4ed5-4e34-ab72-de4e2e985dbf",
                                                "sense_id": "f11c5882-72e9-3b97-9a2d-8085fdde8f53",
                                                "text": "They named him boss because he had good leadership skills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bce93feb-fa84-35e6-92de-c63f20a869a0",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "The head of a political party in a given region or district."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "316a7164-9656-419e-8ec7-f7041be300b1",
                                                "sense_id": "bce93feb-fa84-35e6-92de-c63f20a869a0",
                                                "text": "He is the Republican boss in Kentucky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b0bee2-00b9-3fc7-8bb6-2d105799c66a",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "A term of address to a man, especially a customer, but also sometimes to a friend or acquaintance of equal standing."
                                        ],
                                        "tags": [
                                            "India",
                                            "Multicultural-London-English",
                                            "Philippines",
                                            "especially",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f561c965-ea46-4e18-9ec5-f0509e7ce0eb",
                                                "sense_id": "14b0bee2-00b9-3fc7-8bb6-2d105799c66a",
                                                "text": "Good to see you, boss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0077808e-37c7-3faa-9fd7-5ce8f8aa1095",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "An enemy, often at the end of a level, that is particularly challenging and must be beaten in order to progress."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1be36cf8-563d-4e47-9270-456a38db342a",
                                                "sense_id": "0077808e-37c7-3faa-9fd7-5ce8f8aa1095",
                                                "text": "Cuphead built a reputation for difficulty before release, but its boss battles are mostly about recognizing patterns than getting lucky against unfair bosses. Watching players ace their way through the game’s bosses is a spellbinding reminder that even tough games can be defeated easily with hard work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9105e96f-6903-346e-8128-a3a5e5a6aeef",
                                        "entry_id": "e1ed92a5-6036-3fd4-888f-6d530a71978c",
                                        "glosses": [
                                            "Wife."
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c98845-c1da-452e-bd41-991744a3003c",
                                                "sense_id": "9105e96f-6903-346e-8128-a3a5e5a6aeef",
                                                "text": "There's no olive oil; will sunflower oil do? — I'll have to run that by the boss."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boss",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "14395db3-e501-36d4-ae45-1b76a1b3000c",
                                        "entry_id": "b20a3983-83a4-39c6-87a9-2b239733327a",
                                        "glosses": [
                                            "To exercise authoritative control over; to tell (someone) what to do, often repeatedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7247ea8-330f-45f7-99d4-2cfa0997f2f2",
                                                "sense_id": "14395db3-e501-36d4-ae45-1b76a1b3000c",
                                                "text": "By YOU last night’s journey was actually bossed / Without you, I’m certain, we’d all have been lost."
                                            },
                                            {
                                                "example_id": "d028abf9-522c-4052-8e6b-90e93b9971cf",
                                                "sense_id": "14395db3-e501-36d4-ae45-1b76a1b3000c",
                                                "text": "His sisters bossed him and spoiled him. All their lives he was to go on being their little brother, who could do no wrong, because he was the baby; [...]"
                                            },
                                            {
                                                "example_id": "15fed309-a34b-4120-a61e-aeeff3766ce5",
                                                "sense_id": "14395db3-e501-36d4-ae45-1b76a1b3000c",
                                                "text": "She bossed him, and he's never gotten over it. She still orders him around, and instead of telling her to go soak her head, he just says 'Yes, ma'am' as weak as a newborn jellyfish [...]"
                                            },
                                            {
                                                "example_id": "f2bf0e28-5ed6-4011-971b-753d1d44dd1c",
                                                "sense_id": "14395db3-e501-36d4-ae45-1b76a1b3000c",
                                                "text": "For if, on the one hand, I bossed him and showed him what to do and how to do it, [...]"
