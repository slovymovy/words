                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8a4fe1d-30d4-3185-a53b-9b9ca25efbc6",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "Payment made to a writer, composer, inventor etc for the sale or use of intellectual property, invention etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61161d6a-df82-3646-bc63-e2805eaa7b66",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "To make more money from a book than it cost to run an advertising campaign for it; to make enough in royalties to cover the advance a book received."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4c39323-dd70-47eb-acbb-c258b928d653",
                                                "sense_id": "61161d6a-df82-3646-bc63-e2805eaa7b66",
                                                "text": "Until the total of advances in that contract has been earned out by royalties from any or all books in that contract, the author will not receive additional royalties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                                        "entry_id": "5a1e2eca-3151-30aa-aaf3-a9dfebec7566",
                                        "glosses": [
                                            "Someone in a privileged position."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd62f197-7c00-4ace-ae6e-176eadaa1ef0",
                                                "sense_id": "29ccb755-321d-37d5-aafb-ce0fb51fcec1",
                                                "text": "England will have another manager for the next World Cup, Hodgson’s reign will be defined by a result comparable to losing to the United States in the 1950 World Cup and the now-familiar inquest will begin again in a country that likes to see itself as football royalty."
                                            },
