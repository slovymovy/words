                        "entry_id": "426b6f93-2094-3f61-b90c-008b386f9908",
                        "glosses": [
                            "Person, die sich nicht an einer Wahl beteiligt, obwohl sie ein Stimmrecht hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a9a508-50bf-492a-8f6c-5bd121da8424",
                                "sense_id": "e8bf2a04-c475-3b02-b73f-98d788ec8564",
                                "text": "Der hohe Anteil der Nichtwähler sorgte für eine niedrige Wahlbeteiligung."
                            },
                            {
                                "example_id": "3d54bb45-515b-4dc3-a585-8961eeb0ae97",
                                "sense_id": "e8bf2a04-c475-3b02-b73f-98d788ec8564",
                                "text": "Viele Nichtwähler halten die etablierten Parteien für austauschbar."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
