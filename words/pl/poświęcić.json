{
    "word_family": [
        "poświęcać",
        "poświęcenie",
        "poświęcony",
        "święcić",
        "święty",
        "świątynia"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e089cd0b-f1fc-327c-9274-227f80ee5a9d",
                    "sense_definition": "Przeznaczyć czas, uwagę lub środki na realizację określonego celu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "devote_resources",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę <poświęcić> więcej czasu na naukę języka polskiego.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <посвятить> больше времени изучению польского языка.",
                                "zh": "我必须<w>花</w>更多时间学习波兰语。"
                            }
                        },
                        {
                            "text": "Nauczyciel <poświęcił> uczniowi dużo uwagi, aby wytłumaczyć trudny temat.",
                            "target_lang_translations": {
                                "ru": "Учитель <уделил> ученику много внимания, чтобы объяснить трудную тему.",
                                "zh": "老师<w>给予</w>了学生很多关注，以便解释这个难题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "przeznaczyć"
                    ],
                    "antonyms": [
                        "zmarnować",
                        "stracić"
                    ],
                    "common_phrases": [
                        "poświęcić czas",
                        "poświęcić uwagę",
                        "poświęcić chwilę",
                        "poświęcić środki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделить время, внимание или ресурсы для достижения определенной цели.",
                        "zh": "为实现特定目标而投入时间、注意力或资源。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвятить",
                                "target_lang_sense_clarification": "время, ресурсы"
                            },
                            {
                                "target_lang_word": "уделить",
                                "target_lang_sense_clarification": "внимание, время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投入",
                                "target_lang_sense_clarification": "时间、精力"
                            },
                            {
                                "target_lang_word": "花",
                                "target_lang_sense_clarification": "时间、金钱"
                            },
                            {
                                "target_lang_word": "给予",
                                "target_lang_sense_clarification": "关注、时间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f425b912-98a9-3ac3-8c31-9cb24800b041",
                    "sense_definition": "Zrezygnować z czegoś cennego lub ważnego dla dobra innej osoby lub sprawy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sacrifice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Żołnierze byli gotowi <poświęcić> swoje życie w obronie ojczyzny.",
                            "target_lang_translations": {
                                "ru": "Солдаты были готовы <пожертвовать> своими жизнями ради защиты родины.",
                                "zh": "士兵们为了保卫祖国，做好了<w>牺牲</w>生命的准备。"
                            }
                        },
                        {
                            "text": "Ona postanowiła <poświęcić> swoją karierę dla dobra rodziny.",
                            "target_lang_translations": {
                                "ru": "Она решила <пожертвовать> своей карьерой ради блага семьи.",
                                "zh": "她决定为了家庭的利益而<w>牺牲</w>自己的事业。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ofiarować",
                        "oddać"
                    ],
                    "antonyms": [
                        "zachować",
                        "oszczędzić"
                    ],
                    "common_phrases": [
                        "poświęcić życie",
                        "poświęcić karierę",
                        "poświęcić wszystko",
                        "poświęcić dla dobra"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отказаться от чего-то ценного или важного ради блага другого человека или дела.",
                        "zh": "为了他人的利益或某种事业而放弃珍贵或重要的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пожертвовать",
                                "target_lang_sense_clarification": "чем-то ради чего-то"
                            },
                            {
                                "target_lang_word": "отдать",
                                "target_lang_sense_clarification": "жизнь, всё"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牺牲",
                                "target_lang_sense_clarification": "放弃利益、生命"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa29595d-f663-3b47-9c6c-c69b7df9e256",
                    "sense_definition": "Oddać się całkowicie jakiejś działalności, idei lub opiece nad kimś (używane z zaimkiem \"się\").",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "devote_self",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po studiach mój brat postanowił <poświęcić> się pracy naukowej.",
                            "target_lang_translations": {
                                "ru": "После учебы мой брат решил <посвятить> себя научной работе.",
                                "zh": "大学毕业后，我弟弟决定<w>投身于</w>科学研究工作。"
                            }
                        },
                        {
                            "text": "Matka musiała <poświęcić> się opiece nad chorym dzieckiem.",
                            "target_lang_translations": {
                                "ru": "Мать должна была <посвятить> себя уходу за больным ребенком.",
                                "zh": "母亲不得不<w>献身于</w>照顾生病的孩子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "oddać się",
                        "zaangażować się"
                    ],
                    "common_phrases": [
                        "poświęcić się pracy",
                        "poświęcić się rodzinie",
                        "poświęcić się bez reszty",
                        "poświęcić się nauce"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью отдать себя какой-либо деятельности, идее или заботе о ком-то.",
                        "zh": "全身心投入到某项活动、理念或照顾某人中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвятить",
                                "target_lang_sense_clarification": "себя (делу, семье)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投身于",
                                "target_lang_sense_clarification": "事业、工作"
                            },
                            {
                                "target_lang_word": "致力于",
                                "target_lang_sense_clarification": "研究、事业"
                            },
                            {
                                "target_lang_word": "献身于",
                                "target_lang_sense_clarification": "事业、理想"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c12b00e-60a7-35f0-8439-b0bf39ca56ce",
                    "sense_definition": "Odprawić obrzęd religijny nad czymś lub kimś, aby nadać temu charakter sakralny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W Wielką Sobotę idziemy do kościoła, aby <poświęcić> pokarmy.",
                            "target_lang_translations": {
                                "ru": "В Великую Субботу мы идем в церковь, чтобы <освятить> еду.",
                                "zh": "圣周六我们去教堂<w>祝圣</w>食物。"
                            }
                        },
                        {
                            "text": "Biskup przyjechał do parafii, żeby uroczyście <poświęcić> nowy kościół.",
                            "target_lang_translations": {
                                "ru": "Епископ приехал в приход, чтобы торжественно <освятить> новую церковь.",
                                "zh": "主教来到教区，庄严地<w>祝圣</w>了新教堂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pobłogosławić",
                        "wyświęcić"
                    ],
                    "antonyms": [
                        "zbezcześcić"
                    ],
                    "common_phrases": [
                        "poświęcić pokarmy",
                        "poświęcić kościół",
                        "poświęcić wodę",
                        "ksiądz poświęcił"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совершить религиозный обряд над чем-то или кем-то, чтобы придать этому священный характер.",
                        "zh": "对某物或某人进行宗教仪式，使其具有神圣的性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освятить",
                                "target_lang_sense_clarification": "церковь, пищу, воду"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "祝圣",
                                "target_lang_sense_clarification": "教堂、圣物"
                            },
                            {
                                "target_lang_word": "开光",
                                "target_lang_sense_clarification": "宗教物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b94b8bb2-4d34-3978-9a26-b61f347953fb",
                    "sense_definition": "Zadedykować komuś dzieło artystyczne lub naukowe jako wyraz uznania.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dedicate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Autor zdecydował <poświęcić> swoją najnowszą powieść zmarłej żonie.",
                            "target_lang_translations": {
                                "ru": "Автор решил <посвятить> свой последний роман покойной жене.",
                                "zh": "作者决定将他最新的小说<w>题献</w>给已故的妻子。"
                            }
                        },
                        {
                            "text": "Ten wiersz chcę <poświęcić> wszystkim ludziom walczącym o wolność.",
                            "target_lang_translations": {
                                "ru": "Это стихотворение я хочу <посвятить> всем людям, борющимся за свободу.",
                                "zh": "我想把这首诗<w>献给</w>所有为自由而战的人们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "zadedykować"
                    ],
                    "common_phrases": [
                        "poświęcić książkę",
                        "poświęcić wiersz",
                        "poświęcić utwór",
                        "poświęcić pamięci"
                    ],
                    "target_lang_definitions": {
                        "ru": "Адресовать кому-либо художественное или научное произведение в знак признания.",
                        "zh": "将艺术或科学作品献给某人，以示敬意。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвятить",
                                "target_lang_sense_clarification": "книгу, произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "题献",
                                "target_lang_sense_clarification": "书籍、作品"
                            },
                            {
                                "target_lang_word": "献给",
                                "target_lang_sense_clarification": "作品、礼物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}