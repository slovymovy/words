                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détritus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45dd6ab6-0e96-3bff-8fcb-807ed3ddf6c5",
                                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                                        "glosses": [
                                            "Débris de matières organiques ou amas de ces débris."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d6a3e3-d037-488c-89d7-ab296a71a192",
                                                "sense_id": "45dd6ab6-0e96-3bff-8fcb-807ed3ddf6c5",
                                                "text": "Détritus de végétaux, d’animaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff6d3580-aea2-3600-bb13-65f7f1180b38",
                                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                                        "glosses": [
                                            "Ces matériaux réduits à l’état de poussière ou de boue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d39839dd-b489-3c0b-b807-5fc30d75bd91",
                                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                                        "glosses": [
                                            "Ordure, déchet, objet dont on n’a plus l’usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91099f20-67c3-491f-8ba9-245c76f0edc6",
                                                "sense_id": "d39839dd-b489-3c0b-b807-5fc30d75bd91",
                                                "text": "Au coin du Marché-aux-Poissons, elle tourna, passa devant les pierres d’étal où gisaient encore des détritus puants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7188a247-bd10-3342-8676-555d9d367efd",
                                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                                        "glosses": [
                                            "Débris de roches."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5425b78-8d4d-39f9-8334-9a47dc3fc4ea",
                                        "entry_id": "2260d467-fb70-30a9-8e75-bb6d0a8a1537",
                                        "glosses": [
                                            "Déchet provenant de la nécrose d’un tissu à la suite d’un traumatisme ou d’une infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9bee1e6-2f63-4099-99ab-1d0ca519616e",
                        "source_entry_id": "1c08497f-dedd-3c76-88dc-e65f364dcc65",
                        "source_sense_id": "b8452558-5225-3c60-98e2-72823a1571e4",
                        "target_lang_word": "останки",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "останки",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                        "entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                                        "glosses": [
                                            "тело покойного; прах, труп"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33c1bd09-5233-4139-abab-36370c7ad905",
                                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                                "text": ".. останки покойника бросаются в нарочно сделанную для того яму, и место для нового очищается."
                                            },
                                            {
                                                "example_id": "f2fe7058-a36a-4251-a363-8704a6459994",
                                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                                "text": "Тело её было разрублено пополам, а несчастные останки повешены на уличном фонаре."
                                            },
                                            {
                                                "example_id": "711890fd-661a-4b3a-b681-4a694cc7ef69",
                                                "sense_id": "867760ae-54f5-3185-ab37-517c1026f083",
                                                "text": "Эти останки были вынуты из склепа и поставлены в другой гроб, царски украшенный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                                        "entry_id": "b6fe9b69-bba8-3b31-92e7-1fc9b9c2218a",
                                        "glosses": [
                                            "то, что осталось, сохранилось от чего-либо; остатки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee4fe13-1f7d-41ca-a11c-7beaa8ef8644",
                                                "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                                                "text": "Но запомнились не останки самолёта, а то, как раненый летчик всё время просил пить."
                                            },
                                            {
                                                "example_id": "9a0726f3-8f8e-442a-b70f-11c8114c7901",
                                                "sense_id": "34abfecb-8cc5-3483-bc82-4b04e52eeb7a",
                                                "text": "Всё это было. А теперь останки парка, руины построек. Всё надо начинать заново."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
