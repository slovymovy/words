                        "examples": [
                            {
                                "example_id": "4f39b48d-ace5-488b-b7d2-d94fcad6c858",
                                "sense_id": "931789a2-5f8b-3e35-879a-aa0dbe63eb61",
                                "text": "This happened in New Zealand; but as they were all killed—and eaten, except him who was converted into an anthropophagistic necklace—we must ask who brought the story to London?"
                            },
                            {
                                "example_id": "87941ffd-2120-42ad-ad27-d0d5f66ea763",
                                "sense_id": "931789a2-5f8b-3e35-879a-aa0dbe63eb61",
                                "text": "Now it must not be supposed that Mrs. Jones was a lady of ghost-like or anthropophagistic habit, for it was only a story by the above title, and it was being mentally digested, when Mr. Jones spoke without lifting his eyes from the paper […]"
                            },
                            {
                                "example_id": "28101b48-6d78-4574-9c0f-4a00859b136c",
                                "sense_id": "931789a2-5f8b-3e35-879a-aa0dbe63eb61",
                                "text": "In true anthropophagistic fashion, an apparently domesticated cultural subject trumps its more powerful opponent by feigning a retreat."
                            }
                        ]
                    }
