                                "target_senses": [
                                    {
                                        "sense_id": "b976a56c-cd49-3a1e-a251-97fded99d513",
                                        "entry_id": "20d4f8c3-e739-371c-ac13-141cbb74a17a",
                                        "glosses": [
                                            "The pointing of a weapon, as a gun, a dart, or an arrow, or object, in the line of direction with the object intended to be struck; the line of fire; the direction of anything, such as a spear, a blow, a discourse, a remark, towards a particular point or object, with a view to strike or affect it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5989bada-7d7c-41f2-be1d-f9a79ca7c9df",
                                                "sense_id": "b976a56c-cd49-3a1e-a251-97fded99d513",
                                                "text": "to take aim"
                                            },
                                            {
                                                "example_id": "1510c308-d259-4a25-b8f5-c0e125b91f4f",
                                                "sense_id": "b976a56c-cd49-3a1e-a251-97fded99d513",
                                                "text": "Take time with the aim of your gun."
                                            },
                                            {
                                                "example_id": "6487ab97-934a-4af3-815b-08bb78929d6a",
                                                "sense_id": "b976a56c-cd49-3a1e-a251-97fded99d513",
                                                "text": "2012, \"The Legend of the Gobblewonker\", season 1, episode 2 of Gravity Falls, spoken by Grunkle Stan, voiced by Alex Hirsch\nMy ex-wife still misses me, but her aim is getting better!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc2d226c-6e41-3b42-97fb-62a36ec7ced2",
                                        "entry_id": "20d4f8c3-e739-371c-ac13-141cbb74a17a",
                                        "glosses": [
                                            "The point intended to be hit, or object intended to be attained or affected."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd6ec283-2cf6-3025-8eb5-ff698a38b081",
                                        "entry_id": "20d4f8c3-e739-371c-ac13-141cbb74a17a",
                                        "glosses": [
                                            "Intention or goal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28929120-0498-40dd-8644-643dc2e10af3",
                                                "sense_id": "fd6ec283-2cf6-3025-8eb5-ff698a38b081",
                                                "text": "My number one aim in life is to make money to make my parents, siblings, and kids happy."
                                            },
                                            {
                                                "example_id": "389260a5-530f-4788-a80a-1ded692be375",
                                                "sense_id": "fd6ec283-2cf6-3025-8eb5-ff698a38b081",
                                                "text": "There is no doubt at all that this is the future of machinery, and just as trees grow while the country gentleman is asleep, so while Humanity will be amusing itself, or enjoying cultivated leisure—which, and not labour, is the aim of man—or making beautiful things, or reading beautiful things, or simply contemplating the world with admiration and delight, machinery will be doing all the necessary and unpleasant work."
                                            },
                                            {
                                                "example_id": "37b64aa5-808a-48ca-a597-40877d4c7dbb",
                                                "sense_id": "fd6ec283-2cf6-3025-8eb5-ff698a38b081",
                                                "text": "As a matter of fact the Enlightment culture was based on a philosophy inspired to an ethical laicism whose aim was to create a better society based on principles such as solidarity, equality of rights and duties, and full freedom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb6d22e-a135-3c3d-b2cc-bf639a6fbf1e",
                                        "entry_id": "20d4f8c3-e739-371c-ac13-141cbb74a17a",
                                        "glosses": [
                                            "The ability of someone to aim straight; one’s faculty for being able to hit a physical target."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45055706-1a6d-4304-b417-3527518ab3bd",
                                                "sense_id": "dfb6d22e-a135-3c3d-b2cc-bf639a6fbf1e",
                                                "text": "The police officer has excellent aim, always hitting the bullseye in shooting practice."
                                            },
                                            {
                                                "example_id": "9f22c456-d8d3-4de5-8c2f-399addd2603e",
                                                "sense_id": "dfb6d22e-a135-3c3d-b2cc-bf639a6fbf1e",
                                                "text": "He has a bad aim, so he decided to join archery classes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bb64548-4528-34ed-8996-5ac2fc87b1e1",
                                        "entry_id": "20d4f8c3-e739-371c-ac13-141cbb74a17a",
                                        "glosses": [
                                            "Conjecture; guess."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e86cd04d-4e0b-4ef1-81c9-56dea608d57f",
                                                "sense_id": "1bb64548-4528-34ed-8996-5ac2fc87b1e1",
                                                "text": "What you would work me to, I have some aim."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aim",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e9f9bfe-ed59-3d85-b45a-ea2e50e74148",
                                        "entry_id": "f1d06524-d961-3eb4-9642-d44bc9b054e0",
                                        "glosses": [
                                            "To point or direct a missile, or a weapon which propels as missile, towards an object or spot with the intent of hitting it"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7846849-0daa-4a24-b717-ef31b3b01226",
                                                "sense_id": "2e9f9bfe-ed59-3d85-b45a-ea2e50e74148",
                                                "text": "He aimed at the target, but the arrow flew straight over it."
                                            },
                                            {
                                                "example_id": "fff1c8a4-2175-4375-90be-184bcc0a1e54",
                                                "sense_id": "2e9f9bfe-ed59-3d85-b45a-ea2e50e74148",
                                                "text": "He aimed the gun at him and he held his hands up in surrender."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b348ca7-d18e-306f-8549-a2ab12452a3a",
                                        "entry_id": "f1d06524-d961-3eb4-9642-d44bc9b054e0",
                                        "glosses": [
                                            "To direct the intention or purpose; to attempt the accomplishment of a purpose; to try to gain; to endeavor;—followed by at, or by an infinitive"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a392e7c3-eb0f-4862-9a23-06956c465be8",
                                                "sense_id": "6b348ca7-d18e-306f-8549-a2ab12452a3a",
                                                "text": "to aim at a pass"
                                            },
                                            {
                                                "example_id": "ca983bf5-efeb-4bf0-ad7f-10b63c9f1f62",
                                                "sense_id": "6b348ca7-d18e-306f-8549-a2ab12452a3a",
                                                "text": "to aim to do well in life"
                                            },
                                            {
                                                "example_id": "4f7d0bcf-50b5-4e70-945c-159d17d94b6f",
                                                "sense_id": "6b348ca7-d18e-306f-8549-a2ab12452a3a",
                                                "text": "The stories did not seem to me to touch life. They were plainly intended to have a bracing moral effect, and perhaps had this result for the people at whom they were aimed."
                                            },
                                            {
                                                "example_id": "d62ff109-3677-40e2-941c-1012bfde9363",
                                                "sense_id": "6b348ca7-d18e-306f-8549-a2ab12452a3a",
                                                "text": "Risk is everywhere.[…]For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you. “The Norm Chronicles”[…]aims to help data-phobes find their way through this blizzard of risks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4b15539-8cf5-3315-8f2c-39fcc50de33a",
                                        "entry_id": "f1d06524-d961-3eb4-9642-d44bc9b054e0",
                                        "glosses": [
                                            "To direct or point (e.g. a weapon), at a particular object; to direct, as a missile, an act, or a proceeding, at, to, or against an object"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6442de1b-ccb7-4739-a0c8-e848540f32cb",
                                                "sense_id": "a4b15539-8cf5-3315-8f2c-39fcc50de33a",
                                                "text": "to aim an arrow at the deer"
                                            },
                                            {
                                                "example_id": "48ef6e81-2502-497a-a712-2b6d07b67b24",
                                                "sense_id": "a4b15539-8cf5-3315-8f2c-39fcc50de33a",
                                                "text": "She aimed a punch at her ex-boyfriend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6d3d2c2-5d20-3922-8f4c-113c7e14deac",
                                        "entry_id": "f1d06524-d961-3eb4-9642-d44bc9b054e0",
                                        "glosses": [
                                            "To direct (something verbal) towards a certain person, thing, or group"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afab31ba-f7d9-47d9-b1e0-bd15efd2528b",
                                                "sense_id": "e6d3d2c2-5d20-3922-8f4c-113c7e14deac",
                                                "text": "to aim a satirical comment at Communists in general"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54a776df-7f13-3281-81cb-422b7e43399d",
                                        "entry_id": "f1d06524-d961-3eb4-9642-d44bc9b054e0",
                                        "glosses": [
                                            "To guess or conjecture."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9af472be-570e-499e-9530-44f71b3748a9",
                                                "sense_id": "54a776df-7f13-3281-81cb-422b7e43399d",
                                                "text": "But, good my lord, do it so cunningly / That my discovery be not aimed at;"
                                            }
                                        ]
                                    }
                                ]
