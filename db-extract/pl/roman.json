                                                "example_id": "86d03904-acbc-423a-a5a9-77781cb84a18",
                                                "sense_id": "91f5199c-49bc-3ee5-b910-1220fbaa596c",
                                                "text": "„Die Poesie als Dienerin der Beredsamkeit: dies war auch der didaktische Grundsatz von Christian Weise, der als Rektor des Gymnasiums zu Zittau und als Verfasser von Schauspielen, Romanen und zahlreichen Lehrbüchern gleichzeitig mit Thomasius und vielleicht wirkungsvoller noch als dieser der deutschen Stilbildung im 18. Jahrhundert den Weg gewiesen hat.“"
                                            },
                                            {
                                                "example_id": "558d6f01-5c0e-4a1c-8e0b-cc355d0b5f5e",
                                                "sense_id": "91f5199c-49bc-3ee5-b910-1220fbaa596c",
                                                "text": "„In Göschens Verlagsbüro in Grimma saß Seume auf glühenden Kohlen, über Oden von Klopstock und Romane von Wieland gebeugt, manchmal hochfahrend, häufig niedergedrückt.“"
                                            },
                                            {
                                                "example_id": "764aff0f-abfe-465b-90bc-8311206838d2",
                                                "sense_id": "91f5199c-49bc-3ee5-b910-1220fbaa596c",
                                                "text": "„In seinen Romanen und Erzählungen macht sich allerdings nur eine gemäßigt aufklärerische Haltung bemerkbar, an der ein breites Publikum kaum Anstoß nehmen konnte.“"
                                            },
                                            {
                                                "example_id": "33d2021a-9a37-4fe3-a413-6d38779b20bf",
                                                "sense_id": "91f5199c-49bc-3ee5-b910-1220fbaa596c",
                                                "text": "„Dieser Roman ist eigentlich kein Roman, sondern ein überbordendes Märchen, eine absurde Jetset-Story, eine dick aufgetragene Sinnsuche, die in Österreich beginnt und auf dem Mount Everest endet, wo hoch oben auf dem Gipfel die Erkenntnis liegt oder die Verzweiflung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                        "entry_id": "38edc488-970e-316b-bb88-0307ba920e3b",
                                        "glosses": [
                                            "ein konkretes Werk in der Form eines Romans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eb27f3d-60e1-4eca-8a16-aea543cd14ec",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "Ich leih' dir den Roman aus, den musst du lesen!"
                                            },
                                            {
                                                "example_id": "4e214343-7a64-4df5-99e1-7b61f55219ec",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "Der Suhrkamp–Sammelband „Tauben im Gras. Das Treibhaus. Der Tod in Rom“ enthält drei Romane von Wolfgang Koeppen."
                                            },
                                            {
                                                "example_id": "a6e65a05-32ab-4392-950b-af4f545a0d11",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "„Romane, Sachbücher und Werke zu westafrikanischen Kulturen füllten die Wandregale.“"
                                            },
                                            {
                                                "example_id": "92347f06-275b-42e7-8c2c-eb4ff502a67e",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "„Aber ich bin mir fast sicher, dass ich bessere Romane hervorbringen würde, wäre das geistige Klima um mich herum nur ein wenig fruchtbarer.“"
                                            },
                                            {
                                                "example_id": "e5bb4a59-2b0d-496f-b8ab-aba27d26ee05",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "„Ihr zweiter Roman ist erfüllt vom eisigen Grauen einer scheiternden Sinnsuche.“"
                                            },
                                            {
                                                "example_id": "552c1a8c-e9c6-4ecb-8212-127c4a2ea870",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "„Der Roman trifft einen Nerv der Nachkriegsdeutschen.“"
                                            },
                                            {
                                                "example_id": "5205c4f4-0579-40ce-b5df-b5251e747c92",
                                                "sense_id": "062bcdea-2f8b-3fe7-89a1-e72b8c17a8fe",
                                                "text": "„Dieser Roman ist eigentlich kein Roman, sondern ein überbordendes Märchen, eine absurde Jetset-Story, eine dick aufgetragene Sinnsuche, die in Österreich beginnt und auf dem Mount Everest endet, wo hoch oben auf dem Gipfel die Erkenntnis liegt oder die Verzweiflung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Roman",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "895cb7a6-173f-3ea9-9afa-5722ea1d1019",
                                        "entry_id": "b25c08db-3a04-34bc-8137-7bcc3c7136ec",
