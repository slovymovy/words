                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99f2cf7-1b98-46cf-b29e-cb579653ca02",
                                "sense_id": "f0ec24c9-9917-360d-b9df-6dba681c76db",
                                "text": "L'abdomen embreloqué d'une demi-douzaine de cachets de montre, cliquetant à chaque pas comme les sonnettes d'une mule."
                            },
                            {
                                "example_id": "e146c0b2-fbe0-4bf7-a764-d484669e2d86",
                                "sense_id": "f0ec24c9-9917-360d-b9df-6dba681c76db",
                                "text": "Tournez camisoles de force, bures, cilices, linceuls à gros grains, habits d’oripeau, pendeloques embreloquées, hardes hardies, sapes tapageuses, négligés fanfiolés, chemises sans col, caracos, guimpes, guêpières, basquines, blouses, tabliers, salopettes, sarraux…"
                            }
                        ]
                    }
