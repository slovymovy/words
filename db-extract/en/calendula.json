                        "entry_id": "ce59e32b-f5c1-3fe3-a178-2755ae908130",
                        "glosses": [
                            "Any plant of the genus Calendula, with yellow or orange flowers, often called marigolds."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a3cd688f-5643-4828-834c-c71b6acea14e",
                                "sense_id": "042efaba-6e49-386a-ac6a-58448e9f01d5",
                                "text": "Their dressing room could barely contain all the bouquets they received. Nina gave the largest and brightest, full of zinnias and calendula, to Mother when she came backstage afterward—looking, in her maternal way, even more proud than usual, not just of Nina but of Vera, too."
                            }
                        ]
