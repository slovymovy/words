                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kelner przyniósł nam porcelanowy <w>czajnik</w> pełen aromatycznego naparu.",
                            "target_lang_translations": {
                                "ru": "Официант принёс нам фарфоровый <w>заварочный чайник</w>, полный ароматного настоя.",
                                "en": "The waiter brought us a porcelain <w>teapot</w> full of aromatic brew.",
                                "nl": "De ober bracht ons een porseleinen <w>theepot</w> vol aromatische thee.",
                                "de": "Der Kellner brachte uns eine <w>Teekanne</w> aus Porzellan voller aromatischem Aufguss.",
                                "fr": "Le serveur nous a apporté une <w>théière</w> en porcelaine remplie d'une infusion aromatique.",
                                "it": "Il cameriere ci ha portato una <w>teiera</w> di porcellana piena di infuso aromatico.",
                                "cs": "Číšník nám přinesl porcelánovou <w>konvici</w> plnou aromatického nálevu.",
                                "tr": "Garson bize içi aromatik çay dolu porselen bir <w>demlik</w> getirdi.",
                                "es": "El camarero nos trajo una <w>tetera</w> de porcelana llena de una infusión aromática."
                            }
                        },
                        {
                            "text": "W tym małym <w>czajniku</w> herbata parzy się najlepiej.",
                            "target_lang_translations": {
                                "ru": "В этом маленьком <w>заварочном чайнике</w> чай заваривается лучше всего.",
                                "en": "Tea brews best in this small <w>teapot</w>.",
                                "nl": "In deze kleine <w>theepot</w> trekt de thee het best.",
                                "de": "In dieser kleinen <w>Teekanne</w> zieht der Tee am besten.",
                                "fr": "C'est dans cette petite <w>théière</w> que le thé infuse le mieux.",
                                "it": "In questa piccola <w>teiera</w> il tè si infonde al meglio.",
                                "cs": "V této malé <w>konvičce</w> se čaj louhuje nejlépe.",
                                "tr": "Çay en iyi bu küçük <w>demlikte</w> demlenir.",
                                "es": "En esta pequeña <w>tetera</w> es donde mejor se prepara el té."
                            }
