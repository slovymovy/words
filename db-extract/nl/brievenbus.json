                    {
                        "form_id": "da4fccb2-ca13-4f63-85b6-000fd59a828e",
                        "entry_id": "53c8b078-5d0d-35da-81f6-3344251dc623",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "brievenbusjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79557e41-a251-3398-be56-6f7da317f884",
                        "entry_id": "53c8b078-5d0d-35da-81f6-3344251dc623",
                        "glosses": [
                            "een bus aan de openbare straat of in het postkantoor waarin post gedeponeerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1802ee27-a203-4383-8d55-a0c2787103e5",
                                "sense_id": "79557e41-a251-3398-be56-6f7da317f884",
                                "text": "We gaan eens even onze brievenbus lichten."
                            }
                        ]
                    },
                    {
                        "sense_id": "91523fb8-c838-3fc9-acac-864035cb605d",
                        "entry_id": "53c8b078-5d0d-35da-81f6-3344251dc623",
                        "glosses": [
                            "een opening in de voordeur of een bus aan de voorkant van het huis voor de post"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3dbcb392-89a0-465a-9638-83d36afb16a0",
                                "sense_id": "91523fb8-c838-3fc9-acac-864035cb605d",
                                "text": "O, ik hoor net een brief door onze brievenbus vallen."
                            },
                            {
                                "example_id": "21471803-9906-44b1-931e-e1b793070dee",
                                "sense_id": "91523fb8-c838-3fc9-acac-864035cb605d",
                                "text": "Hij kreeg hierdoor te maken met onder meer doodsbedreigingen en bommeldingen op de faculteit. In 2009 blikte de criminoloog in gesprek met het Leids Universitair Weekblad Mare terug op die periode. \"Ik schermde zo goed mogelijk mijn gezin af, maar dat lukte natuurlijk slecht.\" Zo kreeg hij ook telefonisch bedreigingen en werd er poep door de brievenbus gegooid."
                            }
                        ]
                    },
                    {
                        "sense_id": "7325ab48-ee70-3ce3-9464-8e20e2e51744",
                        "entry_id": "53c8b078-5d0d-35da-81f6-3344251dc623",
                        "glosses": [
                            "ruimte die ontstaat tussen het net en het blok van de verdedigende ploeg wanneer deze de handen te ver van het net positioneert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "013184e1-eaa3-4edb-97cb-885040bcd303",
                                "sense_id": "7325ab48-ee70-3ce3-9464-8e20e2e51744",
                                "text": "Servië scoorde meteen een punt door de bal bij Brazilië in de brievenbus te slaan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "feaead27-225b-4e0e-95f6-61a3b5298cae",
                        "source_entry_id": "53c8b078-5d0d-35da-81f6-3344251dc623",
                        "target_lang_word": "Briefkasten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Briefkasten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                        "entry_id": "1f403d20-eba5-3c04-8955-e43cc71dfd37",
                                        "glosses": [
                                            "öffentlicher Behälter zum Einwurf von Postsendungen, die versendet werden sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edaf802-cb73-4ee5-a92b-4c356e911f09",
                                                "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                                "text": "Der Briefkasten steht am Straßenrand."
                                            },
                                            {
                                                "example_id": "07680f50-48b7-4fbe-b5a4-6d0aa6401c7e",
                                                "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                                "text": "Auf dem Heimweg wirft die Sekretärin die Geschäftspost in den Briefkasten."
                                            },
                                            {
                                                "example_id": "91fe7fb3-7943-486e-b0ed-b22816573aaf",
                                                "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                                "text": "„Da es zu dieser Zeit in Wien noch keine Briefkästen gab, wurde die Post mehrmals am Tag durch Briefträger eingesammelt, die sich auf ihren Stadtrundgängen durch eine laute Klapper bemerkbar machten.“"
                                            },
                                            {
                                                "example_id": "7c98c8d5-fd9c-4eea-b1ee-4ef8f2279d94",
                                                "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                                "text": "„Neben dem Briefkasten der äußeren Mauer blieb er erschöpft stehen, atmete krampfhaft, wandte sich um und rammte die Stirn gegen die Steine.“"
                                            },
                                            {
                                                "example_id": "4abfe633-c919-4d8f-a748-be796c29028b",
                                                "sense_id": "9e3823e1-33e7-3c92-b838-cbfa358ede98",
                                                "text": "„Der Weg zum Glück beginnt im Dunkel hinter dem Schlitz des Briefkastens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                        "entry_id": "1f403d20-eba5-3c04-8955-e43cc71dfd37",
                                        "glosses": [
                                            "privater, bei Häusern/Gebäuden angebrachter, kleinerer Behälter zum Empfangen von Postsendungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cdd13b3-98a1-44d6-81a6-94ef125369de",
                                                "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                                "text": "Der Brief mit den Versicherungsunterlagen hat nicht in den Briefkasten gepasst, deshalb musste der Postbote klingeln."
                                            },
                                            {
                                                "example_id": "c2fa5104-e1df-4491-a3a3-8ff1a37f4e9c",
                                                "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                                "text": "„Bobby hob die Klappe des Briefkastens und drückte sein Ohr an den Spalt.“"
                                            },
                                            {
                                                "example_id": "67eb73fa-bb67-4a2c-be51-a9791f54ad68",
                                                "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                                "text": "„Die Lösung war ein Briefkasten, den ich an einem schmiedeeisernen Gartenzaun befestigte, der sich in der Nähe meines früheren Beobachtungspostens befand.“"
                                            },
                                            {
                                                "example_id": "0d7985ed-949c-4ba2-aafe-637e30479442",
                                                "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                                "text": "„Kaum ist er dem Ortsnetz angeklemmt und fernmündlich erreichbar, schon füllt sich sein Briefkasten mit Drucksachen voll zwingender Fürsorglichkeit.“"
                                            },
                                            {
                                                "example_id": "4ce74a41-8f02-40ef-be40-63dbc0942a5c",
                                                "sense_id": "448a8f66-2d9a-35fc-89d9-88bcebf32c9b",
                                                "text": "„Elsa findet den Namen auf dem Briefkasten, aber nicht auf der Schelle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
