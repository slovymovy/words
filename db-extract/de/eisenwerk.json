                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4cc8ab6-d7ce-4e37-bb58-7e6c1d5ad9d4",
                        "source_entry_id": "07df9ede-8353-3bdd-9604-884dfd0808d1",
                        "source_sense_id": "598f735e-fb05-306a-bb4d-9b9220d85cd6",
                        "source_sense_description": "Gesamtheit eiserner Gegenstände",
                        "target_lang_word": "ironwork",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ironwork",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                        "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                                        "glosses": [
                                            "Anything made wholly or largely of iron, especially when used for decoration."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03699289-21f3-4a1e-9fcb-cc15c0e0cd91",
                                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                                "text": "The weight of the wrought-ironwork in each of the trusses is 460 tons, inclusive of the longitudinal and cross girders weighing 130 tons."
                                            },
                                            {
                                                "example_id": "bae93d13-7ad7-4dec-98b6-17e24b40676b",
                                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                                "text": "The gate itself has sideposts of rustic stonework, each topped by a large Baroque vase; these sideposts are joined by elaborate floral ironwork with a coat of arms and a coronet in the centre[…]"
                                            },
                                            {
                                                "example_id": "337bb2b6-75d3-4e46-9a02-cc2252d0ccae",
                                                "sense_id": "966184ad-8c61-395f-9c2a-40eae6aacbe2",
                                                "text": "But instead, the distinctive ironwork and glass platform awnings have been carefully refurbished, while making them compatible with the overhead wiring. Kettering's island Platform 2/3 is especially noteworthy. Although it dates from 1879, when the station was enlarged to four platforms, the same original (1857) patterns for the delicate cast-ironwork seem to have been used - […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "565a2d6e-a4e4-3982-b42e-0524cc7ff88b",
                                        "entry_id": "77d649f6-112e-3dc9-a9b6-d299757563ad",
                                        "glosses": [
                                            "An ironworks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
