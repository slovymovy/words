{
    "word_family": [
        "polar",
        "polarity",
        "polarize",
        "bipolar",
        "poleward"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "23dc2154-7bfd-3f27-9379-56b7bd5722c4",
                    "sense_definition": "Either of the two points on the earth's surface around which it rotates (the North Pole and the South Pole).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_ends",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Penguins are found near the South <w>Pole</w>.",
                            "target_lang_translations": {
                                "ru": "Пингвины обитают недалеко от Южного <w>полюса</w>.",
                                "zh": "企鹅生活在南<w>极</w>附近。"
                            }
                        },
                        {
                            "text": "Explorers faced extreme cold while trying to reach the North <w>Pole</w>.",
                            "target_lang_translations": {
                                "ru": "Исследователи столкнулись с сильным холодом, пытаясь достичь Северного <w>полюса</w>.",
                                "zh": "探险家们在试图到达北<w>极</w>时面临着极度的严寒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "North Pole",
                        "South Pole",
                        "from pole to pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух точек на поверхности Земли, вокруг которых она вращается (Северный и Южный полюс).",
                        "zh": "地球表面上地球绕其旋转的两点之一（北极和南极）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полюс",
                                "target_lang_sense_clarification": "географический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极点",
                                "target_lang_sense_clarification": "地理极点"
                            },
                            {
                                "target_lang_word": "极",
                                "target_lang_sense_clarification": "地理极点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d07660ea-a638-309c-8c7f-49bc776d8c21",
                    "sense_definition": "A person from Poland or of Polish descent.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "group_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My neighbour is a <w>Pole</w> who moved here five years ago.",
                            "target_lang_translations": {
                                "ru": "Мой сосед — <w>поляк</w>, который переехал сюда пять лет назад.",
                                "zh": "我的邻居是一位五年前搬到这里的<w>波兰人</w>。"
                            }
                        },
                        {
                            "text": "Many <w>Poles</w> celebrate Christmas with a traditional twelve-dish supper.",
                            "target_lang_translations": {
                                "ru": "Многие <w>поляки</w> празднуют Рождество традиционным ужином из двенадцати блюд.",
                                "zh": "许多<w>波兰人</w>会用传统的十二道菜晚餐来庆祝圣诞节。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "capitalized"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек родом из Польши или польского происхождения.",
                        "zh": "波兰人或波兰裔人士。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поляк",
                                "target_lang_sense_clarification": "мужской род"
                            },
                            {
                                "target_lang_word": "полька",
                                "target_lang_sense_clarification": "женский род"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波兰人",
                                "target_lang_sense_clarification": "国籍或族裔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "59a37bde-9964-31bd-b95d-b67f14769adb",
                    "sense_definition": "A long, slender piece of wood, metal, or other material used for support, display, or construction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The flag fluttered from the top of a tall wooden <w>pole</w>.",
                            "target_lang_translations": {
                                "ru": "Флаг развевался на вершине высокого деревянного <w>шеста</w>.",
                                "zh": "旗帜在又高又长的木<w>杆</w>顶端飘扬。"
                            }
                        },
                        {
                            "text": "Firefighters quickly slid down the brass <w>pole</w> to reach the trucks.",
                            "target_lang_translations": {
                                "ru": "Пожарные быстро соскользнули вниз по латунному <w>шесту</w>, чтобы добраться до машин.",
                                "zh": "消防员迅速顺着黄铜<w>杆</w>滑下，赶往消防车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shaft",
                        "rod",
                        "post",
                        "staff"
                    ],
                    "common_phrases": [
                        "flag pole",
                        "totem pole",
                        "telegraph pole",
                        "barge pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный тонкий кусок дерева, металла или другого материала, используемый для опоры, демонстрации или строительства.",
                        "zh": "用于支撑、展示或建筑的长而细的木头、金属或其他材料制成的杆子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столб",
                                "target_lang_sense_clarification": "опора"
                            },
                            {
                                "target_lang_word": "шест",
                                "target_lang_sense_clarification": "длинная палка"
                            },
                            {
                                "target_lang_word": "жердь",
                                "target_lang_sense_clarification": "тонкий ствол дерева"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杆",
                                "target_lang_sense_clarification": "长条状支撑物"
                            },
                            {
                                "target_lang_word": "柱",
                                "target_lang_sense_clarification": "竖立的支撑物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85181eef-48da-3c0d-b454-547849fc8a76",
                    "sense_definition": "A long, thin rod used for fishing.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat on the dock with his fishing <w>pole</w> in the water.",
                            "target_lang_translations": {
                                "ru": "Он сидел на пристани, опустив свою <w>удочку</w> в воду.",
                                "zh": "他坐在码头上，把<w>鱼竿</w>伸进水里。"
                            }
                        },
                        {
                            "text": "My grandfather gave me his old bamboo <w>pole</w> to catch trout.",
                            "target_lang_translations": {
                                "ru": "Дедушка подарил мне свою старую бамбуковую <w>удочку</w>, чтобы ловить форель.",
                                "zh": "祖父给了我他那根旧竹制<w>鱼竿</w>去钓鳟鱼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rod"
                    ],
                    "common_phrases": [
                        "fishing pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный тонкий прут, используемый для рыбной ловли.",
                        "zh": "用于钓鱼的长而细的竿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удочка",
                                "target_lang_sense_clarification": "рыболовная снасть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鱼竿",
                                "target_lang_sense_clarification": "钓鱼工具"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e005baaf-faf1-33a9-a75b-635918c4c264",
                    "sense_definition": "One of the two opposing points of a magnet where the magnetic force is strongest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group_ends",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Opposite magnetic <w>poles</w> attract each other, while like ones repel.",
                            "target_lang_translations": {
                                "ru": "Противоположные магнитные <w>полюса</w> притягиваются, а одноименные отталкиваются.",
                                "zh": "异性<w>磁极</w>相互吸引，同性则相互排斥。"
                            }
                        },
                        {
                            "text": "The needle of a compass always points towards the magnetic <w>pole</w>.",
                            "target_lang_translations": {
                                "ru": "Стрелка компаса всегда указывает на магнитный <w>полюс</w>.",
                                "zh": "指南针的指针总是指向<w>磁极</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "magnetic pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух противоположных точек магнита, где магнитная сила наиболее велика.",
                        "zh": "磁体上磁力最强的两个相反点之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полюс",
                                "target_lang_sense_clarification": "магнитный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁极",
                                "target_lang_sense_clarification": "物理学概念"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0652625a-92f2-3cd7-9bf2-757195e86b5c",
                    "sense_definition": "A long flexible implement used by athletes to jump over a high bar.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "group_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete gripped the <w>pole</w> tightly before starting his run.",
                            "target_lang_translations": {
                                "ru": "Спортсмен крепко сжал <w>шест</w> перед началом разбега.",
                                "zh": "运动员在起跑前紧紧握住了<w>撑杆</w>。"
                            }
                        },
                        {
                            "text": "Modern vaulting <w>poles</w> are made of fiberglass or carbon fiber.",
                            "target_lang_translations": {
                                "ru": "Современные <w>шесты</w> для прыжков изготавливаются из стекловолокна или углеродного волокна.",
                                "zh": "现代撑杆跳用的<w>撑杆</w>是由玻璃纤维或碳纤维制成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pole vault"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный гибкий снаряд, используемый спортсменами для прыжков через высокую планку.",
                        "zh": "运动员用于撑杆跳高的长而有弹性的器械。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шест",
                                "target_lang_sense_clarification": "спортивный снаряд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撑杆",
                                "target_lang_sense_clarification": "体育器械"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27c0fc86-cb8e-35c5-b774-c738ef065f8c",
                    "sense_definition": "Either of two opposite or contrasting extremes of opinion, emotion, or quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_ends",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their views on politics are <w>poles</w> apart.",
                            "target_lang_translations": {
                                "ru": "Их взгляды на политику находятся на разных <w>полюсах</w>.",
                                "zh": "他们在政治上的观点截然相反，处于两个<w>极端</w>。"
                            }
                        },
                        {
                            "text": "Love and hate are often considered opposite <w>poles</w> of human emotion.",
                            "target_lang_translations": {
                                "ru": "Любовь и ненависть часто считают противоположными <w>полюсами</w> человеческих эмоций.",
                                "zh": "爱与恨常被视为人类情感的两个对立<w>极端</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "poles apart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из двух крайностей во мнениях, эмоциях или качествах.",
                        "zh": "观点、情感或品质的两个相反或对比的极端之一。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полюс",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "крайность",
                                "target_lang_sense_clarification": "противоположность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极端",
                                "target_lang_sense_clarification": "对立面"
                            },
                            {
                                "target_lang_word": "两极",
                                "target_lang_sense_clarification": "对比的极端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45a1ce5d-8ea0-3b8a-a540-01cc07fb9bb1",
                    "sense_definition": "A terminal on a battery or electric circuit where current enters or leaves.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_ends",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must connect the red wire to the positive <w>pole</w> of the battery.",
                            "target_lang_translations": {
                                "ru": "Вы должны подключить красный провод к положительному <w>полюсу</w> аккумулятора.",
                                "zh": "你必须把红线连接到电池的正<w>极</w>上。"
                            }
                        },
                        {
                            "text": "Corrosion on the battery <w>poles</w> can prevent the car from starting.",
                            "target_lang_translations": {
                                "ru": "Коррозия на <w>полюсах</w> аккумулятора может помешать запуску автомобиля.",
                                "zh": "电池<w>接线柱</w>上的腐蚀可能会导致汽车无法启动。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "positive pole",
                        "negative pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контакт на батарее или в электрической цепи, где входит или выходит ток.",
                        "zh": "电池或电路中电流进入或离开的端点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полюс",
                                "target_lang_sense_clarification": "электрический"
                            },
                            {
                                "target_lang_word": "клемма",
                                "target_lang_sense_clarification": "контакт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "电极",
                                "target_lang_sense_clarification": "电气端点"
                            },
                            {
                                "target_lang_word": "接线柱",
                                "target_lang_sense_clarification": "连接端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23684022-66f1-35da-a4d7-734a99c3cf42",
                    "sense_definition": "The most favorable starting position in a motor race, usually on the inside of the front row.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_ends",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a fantastic qualifying lap, the driver started on <w>pole</w>.",
                            "target_lang_translations": {
                                "ru": "После фантастического квалификационного круга гонщик стартовал с <w>поула</w>.",
                                "zh": "在完成了一圈精彩的排位赛后，这位车手获得了<w>杆位</w>。"
                            }
                        },
                        {
                            "text": "Taking <w>pole</w> position gave him a clear advantage going into the first corner.",
                            "target_lang_translations": {
                                "ru": "Завоевание <w>поул</w>-позиции дало ему явное преимущество перед первым поворотом.",
                                "zh": "占据<w>杆位</w>使他在进入第一个弯道时拥有明显的优势。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pole position",
                        "on pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая выгодная стартовая позиция в автогонках, обычно на внутренней стороне первого ряда.",
                        "zh": "赛车运动中最有利的起跑位置，通常在第一排内侧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поул",
                                "target_lang_sense_clarification": "гонки"
                            },
                            {
                                "target_lang_word": "поул-позишн",
                                "target_lang_sense_clarification": "термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杆位",
                                "target_lang_sense_clarification": "赛车术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "91a01e6b-d9cc-3aa3-ae14-b71c0b83dbb3",
                    "sense_definition": "To push or propel a boat or raft using a long pole.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guide <w>poled</w> the canoe silently through the shallow swamp.",
                            "target_lang_translations": {
                                "ru": "Гид <w>толкал шестом</w> каноэ тихо через мелкое болото.",
                                "zh": "向导用长杆<w>撑</w>着独木舟，悄无声息地穿过浅滩沼泽。"
                            }
                        },
                        {
                            "text": "They <w>poled</w> the raft down the river because the current was too slow.",
                            "target_lang_translations": {
                                "ru": "Они <w>толкали шестами</w> плот вниз по реке, так как течение было слишком медленным.",
                                "zh": "因为水流太慢，他们用长杆<w>撑</w>着木筏顺流而下。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкать или перемещать лодку, отталкиваясь длинным шестом.",
                        "zh": "用长杆撑动船或木筏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкать шестом",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "идти на шестах",
                                "target_lang_sense_clarification": "способ передвижения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "撑",
                                "target_lang_sense_clarification": "用杆推动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "cb6e30a7-e02b-3256-abd1-c068df15e9b2",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Pole</w> signed the register at the hotel.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Поул</w> расписался в журнале отеля.",
                                "zh": "波尔先生在酒店登记处签了名。"
                            }
                        },
                        {
                            "text": "We are looking for a family named <w>Pole</w> in the directory.",
                            "target_lang_translations": {
                                "ru": "Мы ищем семью по фамилии <w>Поул</w> в справочнике.",
                                "zh": "我们正在名录里寻找一个姓波尔的家庭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Поул",
                                "target_lang_sense_clarification": "имя собственное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "波尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}