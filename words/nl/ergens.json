                {
                    "sense_id": "acfed0bb-0eb5-377a-a308-d4c74d6c69a2",
                    "sense_definition": "In zeker opzicht of op een onbestemde manier; vaak gebruikt om een gevoel of mening te nuanceren.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "modal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ergens</w> begrijp ik wel waarom hij zo boos reageerde.",
                            "target_lang_translations": {
                                "en": "<w>In a way</w> I do understand why he reacted so angrily.",
                                "ru": "<w>Где-то</w> я понимаю, почему он так сердито отреагировал.",
                                "de": "<w>Irgendwie</w> verstehe ich schon, warum er so wütend reagiert hat.",
                                "it": "<w>In un certo senso</w> capisco perché abbia reagito così arrabbiato.",
                                "pl": "<w>Gdzieś</w> rozumiem, dlaczego zareagował tak gniewnie.",
                                "fr": "<w>Quelque part</w>, je comprends pourquoi il a réagi si violemment.",
                                "cs": "<w>Někde</w> uvnitř chápu, proč reagoval tak rozzlobeně.",
                                "tr": "<w>Bir bakıma</w> neden bu kadar öfkeli tepki verdiğini anlıyorum.",
                                "es": "<w>En cierto modo</w> entiendo por qué reaccionó tan enfadado.",
                                "zh": "<w>在某种程度上</w>，我理解他为什么反应那么生气。"
                            }
                        },
                        {
                            "text": "Ik vind het <w>ergens</w> toch wel jammer dat we niet zijn gegaan.",
                            "target_lang_translations": {
                                "en": "I find it <w>somehow</w> a pity that we didn't go.",
                                "ru": "Мне <w>отчасти</w> всё же жаль, что мы не пошли.",
                                "de": "Ich finde es <w>gewissermaßen</w> doch schade, dass wir nicht gegangen sind.",
                                "it": "Trovo che sia <w>in qualche modo</w> un peccato che non siamo andati.",
                                "pl": "<w>Poniekąd</w> szkoda mi, że nie poszliśmy.",
                                "fr": "Je trouve <w>d'une certaine manière</w> que c'est dommage qu'on n'y soit pas allés.",
                                "cs": "Přijde mi to <w>tak trochu</w> škoda, že jsme nešli.",
                                "tr": "Gitmediğimiz için <w>bir bakıma</w> yine de üzgünüm.",
                                "es": "Me parece <w>en parte</w> una lástima que no hayamos ido.",
                                "zh": "我觉得我们没去，<w>多少</w>还是有点遗憾。"
                            }
                        }
