                "forms": [],
                "senses": [
                    {
                        "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                        "entry_id": "2588ca82-72f6-3264-97e7-e88b1ed8cbcb",
                        "glosses": [
                            "À l’extérieur ; au-dehors."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66941970-3aa0-4846-a520-68860055d5f5",
                                "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                                "text": "Le problème des maisons transportables est chose résolue par ici. Huit solides gaillards indigènes nous ont apporté, l'une après l'autre, sur leurs épaules, trois grandes paillotes où nous allons nous loger extérieurement au village."
                            },
                            {
                                "example_id": "2ab31ba5-a0d2-45ae-bca5-ba3ccdd18dbb",
                                "sense_id": "037d4cbb-4c27-3fd4-a6a5-907a84a8d3fe",
                                "text": "Sous l’influence de notre foi, l’Univers est susceptible, sans changer extérieurement de traits, de s’assouplir, de s’animer, de se sur-animer."
                            }
                        ]
                    },
                    {
                        "sense_id": "584bcb7f-6d02-31b4-a18d-11aeddc1a568",
                        "entry_id": "2588ca82-72f6-3264-97e7-e88b1ed8cbcb",
                        "glosses": [
                            "De façon apparente, mais pas nécessairement en réalité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "10a4acb3-3b66-4aa7-b4bb-4754bb340cf1",
                                "sense_id": "584bcb7f-6d02-31b4-a18d-11aeddc1a568",
                                "text": "Malheur si nous ne l’honorons qu’extérieurement !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad493524-2b12-4c86-904a-10a1e913f0b0",
                        "source_entry_id": "2588ca82-72f6-3264-97e7-e88b1ed8cbcb",
