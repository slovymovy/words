                                                "example_id": "fa4d6bec-41f1-4bf0-8f32-2ce91b75b2cc",
                                                "sense_id": "33f08447-38bb-3f92-b454-40871b941c57",
                                                "text": "Door een onregelmatigheid in de draaisnelheid van de platenspeler was de kwaliteit van de muziek niet zo goed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
