            "senses": [
                {
                    "sense_id": "e60c33b0-3fd0-34fd-afe7-ed4118611a54",
                    "sense_definition": "Eine Regel, ein Gesetz oder eine Vereinbarung brechen und sich nicht daran halten.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "regelbruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wer zu schnell fährt, <w>verstößt</w> eindeutig gegen die geltenden Verkehrsregeln."
                        },
                        {
                            "text": "Er wusste genau, dass sein Verhalten gegen das Gesetz <w>verstoßen</w> würde."
                        }
                    ],
                    "synonyms": [
                        "verletzen",
                        "übertreten",
                        "missachten",
                        "zuwiderhandeln"
                    ],
                    "antonyms": [
                        "befolgen",
                        "einhalten",
                        "achten"
                    ],
                    "common_phrases": [
                        "gegen das Gesetz verstoßen",
                        "gegen die Regeln verstoßen"
                    ]
                },
                {
                    "sense_id": "29c6841a-cfc1-3013-9293-2c24bf05be7b",
                    "sense_definition": "Jemanden aus einer Gemeinschaft, Familie oder Gruppe ausschließen und keinen Kontakt mehr wollen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ausschluss",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der junge Mann wurde von seiner Familie <w>verstoßen</w>, weil er einen anderen Weg wählte."
                        },
                        {
                            "text": "Im Mittelalter wurden manche Menschen aus ihrer Gemeinschaft <w>verstoßen</w> und mussten alleine leben."
                        }
                    ],
                    "synonyms": [
                        "ausschließen",
                        "verbannen",
                        "verjagen"
                    ],
                    "antonyms": [
                        "aufnehmen",
                        "integrieren"
                    ],
                    "common_phrases": [
                        "von der Familie verstoßen",
                        "aus der Gemeinschaft verstoßen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d4cfc64-bc2e-36df-b032-ac4caef28360",
                    "sense_definition": "Das Ausführen einer Handlung nach dem Verb <w>verstoßen</w>; die Missachtung oder der Ausschluss.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das vorsätzliche <w>Verstoßen</w> gegen interne Richtlinien führte zu einer sofortigen Abmahnung."
                        },
                        {
                            "text": "Ein wiederholtes <w>Verstoßen</w> gegen die Hausordnung kann eine fristlose Kündigung rechtfertigen."
                        }
                    ],
                    "common_phrases": [
                        "vorsätzliches Verstoßen",
                        "wiederholtes Verstoßen"
                    ]
                }
            ]
        }
    ]
