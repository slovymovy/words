                "senses": [
                    {
                        "sense_id": "ad825936-f682-3066-af35-1fa6d41c81be",
                        "entry_id": "7d30803b-18d6-38c6-942f-89c3a0885292",
                        "glosses": [
                            "vor allem Eisen enthaltendes Gestein oder Mineralgemenge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd67133-848d-4b90-ae67-2548c2392794",
                                "sense_id": "ad825936-f682-3066-af35-1fa6d41c81be",
                                "text": "«China ist weltweit der grösste Abnehmer von Eisenerz.»"
                            },
                            {
                                "example_id": "1d2ec4f4-fbca-4055-857a-4383523f5623",
                                "sense_id": "ad825936-f682-3066-af35-1fa6d41c81be",
                                "text": "„Bis zu drei Öfen brannten in ihren Werkstätten gleichzeitig; aus Eisenerz, Kupfer und Zinn schmiedeten und gossen sie hier Waffen, Werkzeuge und Schmuck.“"
                            },
                            {
                                "example_id": "d43be0b1-ae88-4fb2-af12-68d43267bcae",
                                "sense_id": "ad825936-f682-3066-af35-1fa6d41c81be",
                                "text": "„Schmiede recycelten Altmetall, vermutlich weil sie kein Eisenerz mehr hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
