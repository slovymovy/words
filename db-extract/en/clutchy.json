                        "examples": [
                            {
                                "example_id": "294da830-8259-4daf-9ec3-14efe65a97ff",
                                "sense_id": "7e58eaa5-ca1c-32ca-b942-bf543becb710",
                                "text": "You're triangulated when a clutchy, cloying kissy-poo couple uses you like a decorative backdrop to their perpetual prom night, when you're just supposed to sit there like a sexless old aunt and say, \"Oh, you two.\""
                            },
                            {
                                "example_id": "106fc2a9-c88b-4606-855c-c97774f1160e",
                                "sense_id": "7e58eaa5-ca1c-32ca-b942-bf543becb710",
                                "text": "It is unavoidable that culture and biology dance together, sometimes in a graceful and seamless tango and at other times a clutchy foxtrot, stepping on each other's toes."
                            }
