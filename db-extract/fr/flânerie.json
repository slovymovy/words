                    }
                ],
                "senses": [
                    {
                        "sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                        "entry_id": "46ce62e1-bd47-3e22-adb3-517c4cd2a970",
                        "glosses": [
                            "Action de flâner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ff3dcf-1165-42ab-9d98-dcbc25156e09",
                                "sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                                "text": "Dans une de ses précédentes flâneries, il avait remarqué là un vieux jardin hanté d’un vieux homme et d’une vieille femme, et dans ce jardin un pommier passable. …"
                            },
                            {
                                "example_id": "272fd45d-3b40-45f0-bcf9-e86584993db2",
                                "sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                                "text": "La principale occupation entre les repas consistait, pour mon ami Vincent Desflemmes, en longues flâneries par les rues, par les boulevards, par les quais et plus généralement par toutes les artères de la capitale."
                            },
                            {
                                "example_id": "cb92e0b6-5ac4-4efe-8f41-65575070ccc0",
                                "sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                                "text": "La chanson des lèvres a fait place à je ne sais quelle musique mécanique; la flânerie — ce sourire de la démarche — a cédé le pas à la presse et à l'essoufflement."
                            },
                            {
                                "example_id": "105f7be0-91ae-48e1-b789-df076300c5a7",
                                "sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                                "text": "Cette fantasmagorie, où elle apparaît tantôt comme un paysage, tantôt comme une chambre, semble avoir inspiré par la suite le décor des grands magasins, qui mettent ainsi la flânerie même au service de leur chiffre d’affaires."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "331c0299-f69a-4e19-be7b-fc860615ef7f",
                        "source_entry_id": "46ce62e1-bd47-3e22-adb3-517c4cd2a970",
                        "source_sense_id": "c35449f1-e3d5-3df5-a9f3-1541464bcb81",
                        "target_lang_word": "Bummel",
