                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86be41e6-50ca-3580-9f70-7cd88d6f5350",
                                        "entry_id": "c3bdd4f2-a285-3468-b0f7-f68f1055e085",
                                        "glosses": [
                                            "A milk-colored, somewhat viscous Mexican alcoholic drink made from the fermented sap of certain agave plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f962b9f9-2b86-4bf4-b560-abd73a34a6d7",
                                                "sense_id": "86be41e6-50ca-3580-9f70-7cd88d6f5350",
                                                "text": "You went by the sour stink of pulque saloons; they gave you a water glass of cactus juice in there, two cents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a553323-7164-4e72-b78a-4a9a110ac3ee",
                        "source_entry_id": "516dcf04-becb-3847-acc1-7a38dbc08427",
                        "source_sense_id": "92b25019-3e23-3373-ac38-632e58e550e8",
                        "source_sense_description": "alkoholisches Getränk aus Mexiko, gewonnen aus vergorenem Agavensaft",
                        "target_lang_word": "pulque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pulque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8584b8ea-23c0-3685-9afd-da4d29b430c4",
                                        "entry_id": "41817a8b-25be-338b-8bcd-f0356a27c88b",
                                        "glosses": [
                                            "Jus d'agave (aguamiel) fermenté, qui est employé comme boisson au Mexique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "186ef55e-8481-49b1-afd1-1eb749597a1f",
                                                "sense_id": "8584b8ea-23c0-3685-9afd-da4d29b430c4",
                                                "text": "Elle n'osait rien dire quand on nous faisait boire du pulque le samedi pour nous saoûler."
                                            },
                                            {
                                                "example_id": "ccb56309-6a7b-4f50-a55d-5776a6ac9ba1",
                                                "sense_id": "8584b8ea-23c0-3685-9afd-da4d29b430c4",
                                                "text": "Les jours de fête\nQuand les indiens et les vaqueros s’enivrent de whisky et de pulque\nDorypha danse\nAu son de la guitare mexicaine\nHabaneras si entraînantes\nQu’on vient de plusieurs lieues pour l’admirer"
                                            },
                                            {
                                                "example_id": "f406ce16-332f-4891-a730-29eea1446787",
                                                "sense_id": "8584b8ea-23c0-3685-9afd-da4d29b430c4",
                                                "text": "Qu’on pense seulement à l’art de la cuisine au Mexique : à tous les ingrédients qui ont été créés ici et répandus dans le monde, de la cacahuète au chocolat, des haricots et du maïs au piment et à ses trente variétés, à la tomate, à l’avocat, au pulque et au tequila."
                                            },
                                            {
                                                "example_id": "892e3ec8-d83f-41e5-b443-7c7a011c3ce1",
                                                "sense_id": "8584b8ea-23c0-3685-9afd-da4d29b430c4",
                                                "text": "Des représentations murales semblaient figurer des consommations de pulque, et l’on avait également trouvé des récipients pouvant corroborer l'idée d'une telle consommation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
