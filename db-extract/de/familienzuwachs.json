                                "example_id": "adf8f930-2c2e-46ce-a0b7-b0707fb94ab3",
                                "sense_id": "177a1fe6-635f-368f-9569-d64195434d5b",
                                "text": "„An einer Haltestelle wartet eine Dame, die sichtlich Familienzuwachs entgegensieht.“"
                            },
                            {
                                "example_id": "0a2663cc-719b-46ce-8301-789395f6486f",
                                "sense_id": "177a1fe6-635f-368f-9569-d64195434d5b",
                                "text": "„Unser Kapitän schenkte noch ferner Rum und Whisky aus, nahm dafür Hirsch-, Elen- und Biberbälge ein, und, einen frischen Familienzuwachs ausgenommen, ereignete sich nichts, das besondern Aufzeichnens wert gewesen wäre.“"
                            }
