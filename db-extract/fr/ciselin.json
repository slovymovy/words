                        ],
                        "examples": [
                            {
                                "example_id": "32bd96a7-6ca7-455a-8a55-78fecead78e4",
                                "sense_id": "c2c5861e-fb46-37a1-8b62-3656485e690c",
                                "text": "L’air léger, à haute dose d’oxygène, le changement de régime alimentaire, les bols de lait bourru absorbés à la porte de l’étable et puisés à même le ciselin, le poids de la fatigue accumulée durant l’année citadine, la tension nerveuse privée d’objet qui tout à coup se détend."
                            },
                            {
                                "example_id": "3506bbd1-cd08-4c53-b192-c65892425f80",
                                "sense_id": "c2c5861e-fb46-37a1-8b62-3656485e690c",
                                "text": "Je pris moi-même un ciselin pour l’aider."
                            },
                            {
                                "example_id": "52a2abd5-e1e1-4a64-ad48-00ea619cca76",
                                "sense_id": "c2c5861e-fb46-37a1-8b62-3656485e690c",
                                "text": "Révolte contenue longtemps dans le silence. Ou subitement c’était l’explosion. Parce qu’une vache avait envoyé un coup de queue dans le ciselin de lait pendant la traite."
                            }
                        ]
                    }
