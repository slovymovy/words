                        "first",
                        "initial",
                        "opening",
                        "starting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий первую часть или стадию чего-либо.",
                        "zh": "描述某事物的第一部分或阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "начальный",
                                "target_lang_sense_clarification": "первый, исходный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "初始的",
