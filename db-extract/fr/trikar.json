                    {
                        "sense_id": "9ef98bda-7d49-340e-824e-89462b925b56",
                        "entry_id": "a7ccbb94-bec8-38a0-8967-49e268101b4d",
                        "glosses": [
                            "Décrit une personne qui agit de manière voyante, peu discrète lors d'une action interdite ou secrète, qui multiplie les chances de se faire trikar."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e3adcaed-b583-403d-9efe-d0c38b9e1cd5",
                                "sense_id": "9ef98bda-7d49-340e-824e-89462b925b56",
                                "text": "T'es vraiment trikar quand tu fumes en cachette."
                            },
                            {
                                "example_id": "0300fd07-8b70-4ca6-9360-fff247832d17",
                                "sense_id": "9ef98bda-7d49-340e-824e-89462b925b56",
                                "text": "Ils sont tellement trikar qu'ils vont attirer l'attention de tout le monde."
                            },
                            {
                                "example_id": "08dc244d-93ac-4cda-bdb7-c7e3d9c7f94a",
                                "sense_id": "9ef98bda-7d49-340e-824e-89462b925b56",
                                "text": "Quand elle essaie de mentir elle est trop trikar."
                            },
                            {
                                "example_id": "be314e9e-abd4-4976-a656-7fd13e25427b",
                                "sense_id": "9ef98bda-7d49-340e-824e-89462b925b56",
                                "text": "Ils cachent leur bigos sous l'oreiller, pas trikar!"
                            }
                        ]
                    }
                ],
