                ],
                "senses": [
                    {
                        "sense_id": "4275a435-b4eb-348d-9fda-769a4d7e66d2",
                        "entry_id": "224e40bf-e27d-3c86-b482-293fc35bd3d4",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "308c5fbc-989a-4c1b-8873-190bd92703db",
                                "sense_id": "4275a435-b4eb-348d-9fda-769a4d7e66d2",
                                "text": "Mam na imię Hanna i jestem pielęgniarką z zamiłowania"
                            },
                            {
                                "example_id": "25f54619-5d1f-402b-b270-fe828307d193",
                                "sense_id": "4275a435-b4eb-348d-9fda-769a4d7e66d2",
                                "text": "Hanna Banaszak jest polską wokalistką jazzową i piosenkarką o zmysłowym, pełnym seksapilu głosie."
                            },
                            {
                                "example_id": "96a399a7-2846-4463-945c-908e7ff6ebee",
                                "sense_id": "4275a435-b4eb-348d-9fda-769a4d7e66d2",
                                "text": "Anny i Hanny dzień swej patronki, czyli imieniny, obchodzą 26 lipca, a także 9 czerwca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bbff821-58f8-453f-a6e3-5e794b90ffcd",
                        "source_entry_id": "224e40bf-e27d-3c86-b482-293fc35bd3d4",
                        "source_sense_id": "4275a435-b4eb-348d-9fda-769a4d7e66d2",
                        "target_lang_word": "Hannah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hannah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2d60a5f-0b0b-337b-a610-5f2c80b96bdb",
                                        "entry_id": "15b06411-56b2-3023-a4a3-f211f12d7e7c",
                                        "glosses": [
                                            "Mother of the prophet Samuel in the Old Testament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e23923-2c03-4a7e-a4be-e182eef29618",
                                                "sense_id": "c2d60a5f-0b0b-337b-a610-5f2c80b96bdb",
                                                "text": "Then said Elkanah her husband to her, Hannah, why weepest thou? and why eatest thou not? and why is thy heart grieved? am I not better to thee than ten sons?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03f94b0f-fb30-3da0-ad10-27eee491b66b",
                                        "entry_id": "15b06411-56b2-3023-a4a3-f211f12d7e7c",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f18b66b-0676-4906-89cf-2bad0fc3f458",
                                                "sense_id": "03f94b0f-fb30-3da0-ad10-27eee491b66b",
                                                "text": "\"What about Hannah Schreiber?\"\nHe smiled, flashing some gold in his mouth. \"How do you like that name? She was only a girl, but she had an old lady's name. - - -"
                                            },
                                            {
                                                "example_id": "74d9d01c-970d-4d43-b3ac-5a58c8af7406",
                                                "sense_id": "03f94b0f-fb30-3da0-ad10-27eee491b66b",
                                                "text": "She could buy pretty clothes for a girl and plait her hair with ribbons. And she could call her a nice, old-fashioned, middle-class name like Sarah or Emma or Hannah."
                                            },
                                            {
                                                "example_id": "86d7e2e2-1160-4582-8758-528cc4b58e2c",
                                                "sense_id": "03f94b0f-fb30-3da0-ad10-27eee491b66b",
                                                "text": "I wish it were like the movies, the name something silly, CanDee or Bambie, something you could roll your eyes at. Misti with two hearts over the I's. But it's Hannah, which is a real woman, presumably like me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c34a979-3f7c-3c10-9e7e-6303f7b55b10",
                                        "entry_id": "15b06411-56b2-3023-a4a3-f211f12d7e7c",
                                        "glosses": [
                                            "A place name in the United States, which could be from the given name or surname:",
                                            "An unincorporated community in Douglas County, Georgia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "951a2c00-f95d-398c-bf38-05c9923626dc",
                                        "entry_id": "15b06411-56b2-3023-a4a3-f211f12d7e7c",
