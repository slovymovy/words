                ],
                "senses": [
                    {
                        "sense_id": "b4468247-5186-39fd-b798-164c8f5ba7a7",
                        "entry_id": "0bc3fd61-642d-3d9b-b37c-5a009c6ac242",
                        "glosses": [
                            "Refroidir excessivement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b005aaa-33d5-4874-bd8c-0be54e20cfd4",
                                "sense_id": "b4468247-5186-39fd-b798-164c8f5ba7a7",
                                "text": "Faites attention à ne pas surrefroidir (ou surchauffer !) mais essayez de rendre votre sensation à la maison confortable aux visiteurs."
                            },
                            {
                                "example_id": "886b0238-72e5-4fe7-9c41-01dc3cad6943",
                                "sense_id": "b4468247-5186-39fd-b798-164c8f5ba7a7",
                                "text": "Ce type de purgeur n`a pas besoin de surrefroidir et il est capable d’évacuer la quantité de condensat produite sans retard."
                            },
                            {
                                "example_id": "b34066e4-382a-46d0-b536-5f90a79b026c",
                                "sense_id": "b4468247-5186-39fd-b798-164c8f5ba7a7",
                                "text": "Ce phénomène permet de surrefroidir l’eau des pores située au-dessous d’une lentille de glace en pleine expansion."
                            },
                            {
                                "example_id": "7f29352b-6dfd-4373-81e1-f08003e9a607",
                                "sense_id": "b4468247-5186-39fd-b798-164c8f5ba7a7",
                                "text": "Mais avec LEAR de nouvelles méthodes avaient été mises au point pour \"surrefroidir\" les antiprotons jusqu’à quelques degrés au voisinage du zéro absolu."
                            }
                        ]
                    },
                    {
