                "senses": [
                    {
                        "sense_id": "bb8112fa-ce57-36cf-a4e3-441effaeb62c",
                        "entry_id": "25a45af1-545c-362c-83bf-606dafe3f9f0",
                        "glosses": [
                            "лингв. устойчивая ассоциация в языковом сознании говорящего, которую вызывает употребление какого-либо слова, выражения в определённом значении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dcfe51e-8e04-4b2c-b611-7ca10984a273",
                                "sense_id": "bb8112fa-ce57-36cf-a4e3-441effaeb62c",
                                "text": "Это явление, однако, по-разному окрашено в различных культурах, и самое слово «смех» приобретает в несхожих языках то одни, то другие коннотации."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afad17c9-8533-424f-bc6a-381ad04a5f17",
                        "source_entry_id": "25a45af1-545c-362c-83bf-606dafe3f9f0",
                        "source_sense_id": "bb8112fa-ce57-36cf-a4e3-441effaeb62c",
                        "target_lang_word": "connotation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connotation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                        "entry_id": "3667e8e4-405d-31fd-95f5-48b0d17c75c5",
                                        "glosses": [
                                            "A meaning of a word or phrase that is suggested or implied, as opposed to a denotation, or literal meaning. A characteristic of words or phrases, or of the contexts that words and phrases are used in."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2e9403b-20d9-4f77-867e-0b03f58a3bc0",
                                                "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                                "text": "The word \"advisedly\" has a connotation of \"wisely\", although it denotes merely \"intentionally\" and \"deliberately.\""
                                            },
                                            {
                                                "example_id": "e35605d5-1f7e-4d3a-a83c-3e7a0302cb01",
                                                "sense_id": "b458ccee-6a1c-30ab-820c-4510c23d2d9d",
                                                "text": "The word \"happy\" has a positive connotation, while \"sad\" has a negative connotation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2dd9b65-1220-3721-a049-46138db51322",
                                        "entry_id": "3667e8e4-405d-31fd-95f5-48b0d17c75c5",
                                        "glosses": [
                                            "The attribute or aggregate of attributes connoted by a term, contrasted with denotation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29cf6620-bcc4-4645-accf-241ef13c7894",
                                                "sense_id": "b2dd9b65-1220-3721-a049-46138db51322",
                                                "text": "The two expressions \"the morning star\" and \"the evening star\" have different connotations but the same denotation (i.e. the planet Venus)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
