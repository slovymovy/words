                        "form": "das Umspannwerk"
                    },
                    {
                        "form_id": "0ad3dc43-00d9-43a2-b8c2-b0e4c06dd983",
                        "entry_id": "e621ba6a-5ac4-31d7-a44a-43400bb8829c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Umspannwerke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                        "entry_id": "e621ba6a-5ac4-31d7-a44a-43400bb8829c",
                        "glosses": [
                            "Anlage zum Transformieren des elektrischen Stroms (beispielsweise von 380.000 Volt auf 110.000 Volt)"
                        ],
                        "tags": [
                            "Stromversorgung"
                        ],
                        "examples": [
                            {
                                "example_id": "cee95247-a854-46ad-b7ee-4ffb69444c2e",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "Da das Umspannwerk nicht weit entfernt war, wurde uns eine Elektroheizung genehmigt."
                            },
                            {
                                "example_id": "08163bfd-7589-4711-aa7c-9a07e5b141ba",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„Umspannwerke sind die Knotenpunkte unserer Stromversorgung - vergleichbar mit Autobahnkreuzen im Straßennetz.“"
                            },
                            {
                                "example_id": "0ff7a785-22bb-486d-8022-4595b8f73ae5",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„Dass der Bedarf an Umspannwerken so stark gestiegen ist, liegt an der Energiewende.“"
                            },
                            {
                                "example_id": "5c8f6aee-5f13-4ae0-a44f-a5a9bb02cf61",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„Das Umspannwerk in Handewitt umfasst bei der Eröffnung 2020 etwa 20 Hektar. Nach nur zwei Jahren musste es bereits erweitert werden.“"
                            },
                            {
                                "example_id": "d6d45578-0a85-4a30-bed8-e11117b11bce",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„Der Übertragungsnetzbetreiber Tennet unterhält derzeit 22 Umspannwerke in Schleswig-Holstein. Ihre Anzahl wird sich laut Unternehmen in den nächsten Jahren verdoppeln.“"
                            },
                            {
                                "example_id": "f35aba27-9dd5-44d7-9eec-8fd57d652e54",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„»[…] mir wurde von Experten versichert, dass jeder, der ein Handy in der Hosentasche trägt sich mehr Elektrosmog aussetzt als durch ein Umspannwerk.«“"
                            },
                            {
                                "example_id": "689f7184-4dde-4808-8fff-648a489123e0",
                                "sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                                "text": "„Gegen ein geplantes Umspannwerk in den Gemeinden Agethorst und Mehlbek (Kreis Steinburg) formiert sich Widerstand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b414c4bd-4453-4dbc-b960-c92f9da99371",
                        "source_entry_id": "e621ba6a-5ac4-31d7-a44a-43400bb8829c",
                        "source_sense_id": "d6df8f0f-4583-3556-93b1-75ea67dd8aa1",
                        "source_sense_description": "Stromversorgung: Anlage zum Transformieren des Stroms",
                        "target_lang_word": "transformer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transformer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cbec282-4939-3846-99ff-c91491da6494",
                                        "entry_id": "ad620833-f53d-3032-ae23-00f83f65e2ab",
                                        "glosses": [
                                            "Something that transforms, changing its own or another thing's shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67cce2ae-3cbc-399f-9034-014cd69ec28e",
                                        "entry_id": "ad620833-f53d-3032-ae23-00f83f65e2ab",
                                        "glosses": [
                                            "A static device that transfers electric energy from one circuit to another by magnetic coupling; primarily used to transfer energy between different voltage levels, which allows the most appropriate voltages for power generation, transmission and distribution to be chosen separately."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8577e277-afa7-463d-9f6c-c3123a6dfdc1",
                                                "sense_id": "67cce2ae-3cbc-399f-9034-014cd69ec28e",
                                                "text": "While initial reports Thursday traced the glow to a transformer explosion or a fire, Mr. McGee said there was no fire, and there were no transformers involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30083424-dcf4-369c-ae4e-180d6bd03172",
                                        "entry_id": "ad620833-f53d-3032-ae23-00f83f65e2ab",
                                        "glosses": [
                                            "A neural network architecture composed of layers of attention which takes sequences of tokens (representing text, images, audio, or other modalities) as input."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bbb0221-de73-4d01-b95c-8449cfdb7c02",
                                                "sense_id": "30083424-dcf4-369c-ae4e-180d6bd03172",
                                                "text": "Transformer is a deep machine learning model based on the encoder–decoder network architecture and is used primarily in the field of NLP."
                                            },
                                            {
                                                "example_id": "c813f628-92ad-42fd-85c5-65f12316a0be",
                                                "sense_id": "30083424-dcf4-369c-ae4e-180d6bd03172",
                                                "text": "The transformer helped machine-learning systems improve at a much faster pace, leading directly to last year’s release of ChatGPT and the attendant boom in interest around AI. (Transformers are the “T” in ChatGPT.)"
                                            },
                                            {
                                                "example_id": "6a791410-ed9f-4f0d-87d0-7ceae5230cbc",
                                                "sense_id": "30083424-dcf4-369c-ae4e-180d6bd03172",
                                                "text": "Privately, many at Google have bristled at criticism of its AI credentials, in particular given that it incubated the underlying technology and released it publicly in the 2017 transformers paper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfcf1b5-67b1-33a8-931a-7305ecdccec6",
                                        "entry_id": "ad620833-f53d-3032-ae23-00f83f65e2ab",
                                        "glosses": [
                                            "Alternative letter-case form of Transformer."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
