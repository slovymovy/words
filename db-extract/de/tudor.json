                                        "glosses": [
                                            "Anyone who lived in the Tudor era of England."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952601b0-9018-46f7-aa6f-a2acb13c5b02",
                                                "sense_id": "6c608627-55a2-38d2-b87b-f8472b022845",
                                                "text": "The Tudors ate far more meat than we do today, and the king ate more than most."
                                            },
                                            {
                                                "example_id": "96408036-6a11-4090-ba85-fca59394215a",
                                                "sense_id": "6c608627-55a2-38d2-b87b-f8472b022845",
                                                "text": "The Tudors mostly made theirs with whatever homegrown vegetables they could grow themselves, from lettuces and cucumbers, to onions and even plant and flower seeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f3bd95-6b27-3e97-b811-353e4981abd5",
