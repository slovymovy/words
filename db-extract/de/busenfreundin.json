                        "examples": [
                            {
                                "example_id": "b3d96737-2db4-4584-89e4-7f45adb6a55f",
                                "sense_id": "6d11038d-a5ec-3c44-836d-bd7bc5d492a0",
                                "text": "„Hätte die Busenfreundin Edita nicht ihre Konditorlehre beenden wollen, sie wären beide sofort aufgebrochen.“"
                            },
                            {
                                "example_id": "56613dd0-783f-4a59-8eed-ff61d250326f",
                                "sense_id": "6d11038d-a5ec-3c44-836d-bd7bc5d492a0",
                                "text": "„Eine ihrer Busenfreundinnen saß neben ihr.“"
                            },
                            {
                                "example_id": "1447cecb-7522-470b-8726-46e50e44b33f",
                                "sense_id": "6d11038d-a5ec-3c44-836d-bd7bc5d492a0",
                                "text": "„Ich habe eine Busenfreundin, mit der ich über Männer rede, Freunde, mit denen ich neue Restaurants der Stadt ausprobiere, und Walker, die mich auf Partys begleiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
