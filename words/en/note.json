                },
                {
                    "sense_id": "c4595375-5b5e-36d1-95ef-a303d20b13b6",
                    "sense_definition": "A particular quality, feeling, or atmosphere that can be sensed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "quality_mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>note</w> of sadness in her voice when she spoke.",
                            "target_lang_translations": {
                                "ru": "В её голосе звучала <w>нотка</w> грусти, когда она говорила.",
                                "zh": "她说话时声音里带着一丝<w>意味</w>深长的忧伤。"
                            }
                        },
                        {
                            "text": "The meeting ended on a positive <w>note</w> with everyone agreeing.",
