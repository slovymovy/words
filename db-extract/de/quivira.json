                "senses": [
                    {
                        "sense_id": "d39a9ab6-8dfc-321e-9701-e61340edb408",
                        "entry_id": "075e7505-b427-3dd0-98b7-5aab175d6e44",
                        "glosses": [
                            "historische, unterschiedlich verortete Region in Nordamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fcf9158-8090-4098-919f-623d31456afb",
                                "sense_id": "d39a9ab6-8dfc-321e-9701-e61340edb408",
                                "text": "„Nizas Bericht erinnerte an die sagenhaften Sieben Städte von Cíbola und Quivira, die in zeitgenössischer Ritterliteratur Verbreitung fanden.“"
                            },
                            {
                                "example_id": "d4eefc2a-0ff6-474a-afc3-fb101f95dd2f",
                                "sense_id": "d39a9ab6-8dfc-321e-9701-e61340edb408",
                                "text": "„Nun ist das alles für einen Ethnologen natürlich so etwas wie ein alter Hut - ähnlich wie die langlebigen Legenden von verborgenen reichen Städten und längst vergessenen Volksstämmen, die unter den Pueblo- und Prärieindianern kursieren und Coronado vor Jahrhunderten zu seiner vergeblichen Suche nach dem sagenumwobenen Quivira verleiteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
