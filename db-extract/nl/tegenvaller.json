                "senses": [
                    {
                        "sense_id": "e6bdea8b-ecfd-3a18-b20b-a8559cb99ca6",
                        "entry_id": "b0b4c5dc-0fb6-3380-8d8b-67c4793041f6",
                        "glosses": [
