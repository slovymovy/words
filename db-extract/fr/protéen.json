                        "source_sense_id": "f0fec598-9ddc-3204-8243-9a67afd9a1d0",
                        "target_lang_word": "protean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protean",
