                                        "entry_id": "9ef058ec-28a9-33ee-8361-b8a588cee3a2",
                                        "glosses": [
                                            "A person from Chad or of Chadian descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de783a6-6f2d-4f08-87c8-6bc27376fd17",
                                                "sense_id": "ea4f378a-3e94-326b-b20a-1c18749d10d5",
                                                "text": "He is one of the tens of thousands of Chadians who fled last year’s fighting in Libya and are now back in their homeland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
