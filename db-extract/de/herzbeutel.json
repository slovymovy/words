                    {
                        "translation_id": "cfb99fbd-bab6-466a-aeba-6ba30ca5ed39",
                        "source_entry_id": "11303b11-7634-3429-b599-96bb19142613",
                        "source_sense_id": "a3b2cd16-88ec-31e6-b460-0c06f8b082e3",
                        "target_lang_word": "pericardio",
                        "target_lang_code": "es",
