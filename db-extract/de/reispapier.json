                    },
                    {
                        "translation_id": "6b55375a-aa86-4bff-a311-e66aaa941530",
                        "source_entry_id": "853aa925-7aa9-3e5f-87a9-653ffd5ed55f",
                        "source_sense_id": "1ca2b984-82f2-3ad9-9e36-7b0a48aa4fac",
                        "source_sense_description": "Papier aus dem Wurzelmark von Reis",
                        "target_lang_word": "papier de riz",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "papier de riz",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e86e5ed-7eaf-3073-a86f-6f1e0d0904fc",
                                        "entry_id": "b4588973-6fe3-3f4d-a83a-af4ee066cb1e",
                                        "glosses": [
                                            "Fine lame blanche légèrement translucide de moelle du tronc d’aralie à papier de Chine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bbb6542-0e4a-42fe-9fe4-c802dec3edaf",
                                                "sense_id": "8e86e5ed-7eaf-3073-a86f-6f1e0d0904fc",
                                                "text": "Quelques élégantes en forment des collections [d’éventails] du plus grand prix ; nous en avons vu une qui en comptait plus de cent de différents styles ; il y en avait de tout pays et de toute époque : ivoire, écaille, bois de santal, paillettes, gouaches du temps de Louis XIV et de Louis XV, papier de riz de Japon et de la Chine, rien n’y manquait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1ebc803e-627a-4996-ba79-5b1a6078ae4d",
                        "source_entry_id": "853aa925-7aa9-3e5f-87a9-653ffd5ed55f",
                        "source_sense_id": "1ca2b984-82f2-3ad9-9e36-7b0a48aa4fac",
