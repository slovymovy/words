                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b52b30a-f4d3-449b-aef5-74ad952ec10a",
                        "source_entry_id": "141d586c-a157-3742-ae96-185cb9473655",
                        "source_sense_id": "824f7ceb-aa9f-31ad-8c47-8fe826824a4e",
                        "target_lang_word": "tumult",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tumult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b97dd9b2-3c19-3bf2-8bf3-ba41808adc55",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "Confused, agitated noise as made by a crowd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b7d4638-d9c2-4e7c-bd94-5d411ef44a44",
                                                "sense_id": "b97dd9b2-3c19-3bf2-8bf3-ba41808adc55",
                                                "text": "Till in loud tumult all the Greeks arose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "Violent commotion or agitation, often with confusion of sounds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a44b4e3e-2009-4651-b5e1-773a13ade2ba",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "the tumult of the elements"
                                            },
                                            {
                                                "example_id": "aa8577ef-2c79-48b1-9efb-b6e56dc248ba",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "the tumult of the spirits or passions"
                                            },
                                            {
                                                "example_id": "fa23f013-63d8-4e68-beb2-7d0584af35e1",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "This is what I wanted my story 'Snapshot' to sound like — a very cold surface, with heat and passion beneath. The icy surface is going to break and you're totally engulfed in the tumult."
                                            },
                                            {
                                                "example_id": "f619fe9b-01ef-4f7b-b730-ebd109a7a6b0",
                                                "sense_id": "e679704a-5811-3038-a222-b9eea2893d45",
                                                "text": "Football is a game of tumult and glory, of small disappointments and lingering dreams, and Mata has played long enough at the highest level to appreciate these truths."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1293b94-cae9-380c-af57-d7d635b857ab",
                                        "entry_id": "2f815fab-bb5a-3419-9279-607fedac6d04",
                                        "glosses": [
                                            "A riot or uprising."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tumult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19506ea4-6506-3167-92d8-9e414282101c",
                                        "entry_id": "596e26fd-3cff-347b-a783-eb98b8af24a5",
                                        "glosses": [
                                            "To make a tumult; to be in great commotion."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a27a64c7-d3da-4c46-9f79-a2b6dc7ed387",
                                                "sense_id": "19506ea4-6506-3167-92d8-9e414282101c",
                                                "text": "Importuning and tumulting even to the fear of a revolt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e8abf0-db63-4591-ba25-e511a1d47c33",
                        "source_entry_id": "141d586c-a157-3742-ae96-185cb9473655",
                        "source_sense_id": "824f7ceb-aa9f-31ad-8c47-8fe826824a4e",
                        "target_lang_word": "Tumult",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tumult",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97e38a57-d574-388d-9f95-9fc28e80e683",
                                        "entry_id": "3fb0d455-610e-3aa3-9400-3cf659fde1b5",
                                        "glosses": [
                                            "lautstarkes Chaos, Gewimmel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14a0f0b-09da-47ee-b68b-226b7bcc3063",
                                                "sense_id": "97e38a57-d574-388d-9f95-9fc28e80e683",
                                                "text": "„Als sie sich geschlossen weigerten, riss dem obersten Richter der Geduldsfaden, und im Gerichtssaal brach Tumult aus.“"
                                            },
                                            {
                                                "example_id": "9b26ccd7-9699-44a2-a9a0-d7994579dfcc",
                                                "sense_id": "97e38a57-d574-388d-9f95-9fc28e80e683",
                                                "text": "„Aber dann bricht der Tumult los.“"
                                            },
                                            {
                                                "example_id": "fc3dc075-dfb8-45fe-82a5-397363ea01b1",
                                                "sense_id": "97e38a57-d574-388d-9f95-9fc28e80e683",
                                                "text": "„Die letzte Inkarnation des Imperiums, die österreichisch-ungarische Doppelmonarchie, zerfiel in dramatischer Weise im Tumult des Ersten Weltkriegs.“"
                                            },
                                            {
                                                "example_id": "304f59f7-a39d-4a86-a18b-c551c9d992c8",
                                                "sense_id": "97e38a57-d574-388d-9f95-9fc28e80e683",
                                                "text": "„Einige Augenblicke vorher hatte Fürst Andrej Pierre lächelnd auf einen kleinen Tumult aufmerksam gemacht, den er schon von weitem am Dienstboteneingang bemerkt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e92b26ad-8a4f-39f5-bc77-964a4a4b5620",
                                        "entry_id": "3fb0d455-610e-3aa3-9400-3cf659fde1b5",
                                        "glosses": [
                                            "aufgeregte, handgreifliche, unkontrollierbare Auseinandersetzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a4c431-28cc-4c9b-ba94-da27d635b04b",
                                                "sense_id": "e92b26ad-8a4f-39f5-bc77-964a4a4b5620",
                                                "text": "In Kairo finden dieser Tage täglich Tumulte statt."
                                            },
                                            {
                                                "example_id": "7f474803-9f63-41ed-8388-82ae5ff63957",
                                                "sense_id": "e92b26ad-8a4f-39f5-bc77-964a4a4b5620",
                                                "text": "„Die Zweiteilung Panamas hatte immer wieder zu diplomatischen Problemen geführt, und schon 1964 war es zu Tumulten gekommen, bei denen 21 zivile Panamaer und vier amerikanische Soldaten zu Tode gekommen waren.“"
                                            },
                                            {
                                                "example_id": "b89f6270-11ec-48d1-ac6f-e4fc12ceebac",
                                                "sense_id": "e92b26ad-8a4f-39f5-bc77-964a4a4b5620",
                                                "text": "„In dem allgemeinen Tumult verlangte Volkmar schreiend, ich solle mich entschuldigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
