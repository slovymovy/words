                        "cross_references": [
                            {
                                "target_word": "entanglement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4ddb84-83ef-362f-82f5-d1b1f1104034",
                                        "entry_id": "81f607f7-4afb-3644-bd62-0ed9e143e187",
                                        "glosses": [
                                            "The act of entangling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11009818-4a3f-4206-b396-bc717832a51f",
                                                "sense_id": "7b4ddb84-83ef-362f-82f5-d1b1f1104034",
                                                "text": "The most notorious of these was his entanglement of the Soviet Union in the Cuban missile crisis, against the advice of the military, who held him responsible for their embarrassing inability to frighten the USA because he had failed[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e45e22e-35a4-3ddb-a51c-c829e73f5930",
                                        "entry_id": "81f607f7-4afb-3644-bd62-0ed9e143e187",
                                        "glosses": [
                                            "The state or condition of being entangled; intricate and confused involution.",
                                            "The condition of being deeply involved and intricated (with politics, a group, another person, etc.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf7b18f-902d-439e-b0db-0a06d145ac33",
                                                "sense_id": "9e45e22e-35a4-3ddb-a51c-c829e73f5930",
                                                "text": "The Letters' account of Dolghurucki's hopeless entanglement in the politics of the imperial accession resonated with her readers, and Vigor's story becomes a minor set piece of Russian histories in the eighteenth century."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d1e4bde-bef3-37fc-b956-024579bae8f0",
                                        "entry_id": "81f607f7-4afb-3644-bd62-0ed9e143e187",
                                        "glosses": [
                                            "The state or condition of being entangled; intricate and confused involution.",
                                            "The condition, or an instance, of being romantically or sexually involved with another person; an affair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f718b7a-e6e6-4861-8793-fe540d4b9ca0",
                                                "sense_id": "9d1e4bde-bef3-37fc-b956-024579bae8f0",
                                                "text": "For quotations using this term, see Citations:entanglement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a01bc512-7826-3bac-9c72-e462f6f5615d",
                                        "entry_id": "81f607f7-4afb-3644-bd62-0ed9e143e187",
                                        "glosses": [
                                            "That which entangles; an involvement, a complication; an intricacy; a perplexity.",
                                            "An obstruction placed in front or on the flank of a fortification, to impede an enemy's approach."
