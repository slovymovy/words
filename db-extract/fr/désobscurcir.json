                "senses": [
                    {
                        "sense_id": "dc910001-3b0b-32e5-b490-df4552376d93",
                        "entry_id": "da1a8c71-a857-3531-97d9-a2f8bf21efc1",
                        "glosses": [
                            "Rendre moins obscur, éclaircir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "828c2241-79e3-40cf-a22e-0d3ef2c8b1cd",
                                "sense_id": "dc910001-3b0b-32e5-b490-df4552376d93",
                                "text": "Ainsi, il n'y a pas que les guérisseurs du corps qui sont concernés mais nous tous, selon tout ce que nous pouvons faire pour désobscurcir l'esprit, pour enlever, écarter tous les facteurs d'ignorance, de confusion, d'erreur, de refus."
                            },
                            {
                                "example_id": "0f0d592e-9c52-4e38-b7ea-80ec29b9d5b0",
                                "sense_id": "dc910001-3b0b-32e5-b490-df4552376d93",
                                "text": "Par le biais de la linguistique comparée, Guthrie a largement contribué à désobscurcir l'histoire ancienne du Zaïre méridional."
                            }
                        ]
                    }
