                                    {
                                        "sense_id": "77d69dc5-a4d3-3c17-9bee-832a4fb60904",
                                        "entry_id": "35ad9f6a-af13-368f-8a88-ea5c66dee92c",
                                        "glosses": [
                                            "изъян, порча, повреждение; недостаток, несовершенство, отклонение от нормы или должного"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85bdef24-dd8f-4247-bb62-1435e1308103",
                                                "sense_id": "77d69dc5-a4d3-3c17-9bee-832a4fb60904",
                                                "text": "У этого человека много дефектов."
                                            },
                                            {
                                                "example_id": "d70f93fb-ab19-4f08-b452-75dfb98ea27f",
                                                "sense_id": "77d69dc5-a4d3-3c17-9bee-832a4fb60904",
                                                "text": "К чему говорить «дефекты», когда можно сказать недочёты, или недостатки, или пробелы?"
                                            },
                                            {
                                                "example_id": "03b44dd9-38dc-468f-8b67-e5a746e9dad8",
                                                "sense_id": "77d69dc5-a4d3-3c17-9bee-832a4fb60904",
                                                "text": "Товар имеет некоторые дефекты."
                                            },
                                            {
                                                "example_id": "ae517fca-8086-496a-b728-a565c7928066",
                                                "sense_id": "77d69dc5-a4d3-3c17-9bee-832a4fb60904",
                                                "text": "Крупный дефект проекта."
                                            }
                                        ]
