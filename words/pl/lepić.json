    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c8bf0ceb-1b93-3fd2-93a0-3add2a61ce3b",
                    "sense_definition": "formować coś z plastycznego materiału, takiego jak glina, plastelina, ciasto lub śnieg",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ksztaltowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdą zimę dzieci chętnie <w>lepią</w> wielkiego bałwana przed domem.",
                            "target_lang_translations": {
                                "ru": "Каждую зиму дети с удовольствием <w>лепят</w> большого снеговика перед домом."
                            }
                        },
                        {
                            "text": "Babcia razem z wnukami od rana <w>lepi</w> smaczne pierogi na obiad.",
                            "target_lang_translations": {
                                "ru": "Бабушка вместе с внуками с самого утра <w>лепит</w> вкусные вареники на обед."
                            }
                        }
                    ],
                    "synonyms": [
                        "formować"
                    ],
                    "common_phrases": [
                        "lepić bałwana",
                        "lepić pierogi",
                        "lepić z gliny"
                    ],
                    "target_lang_definitions": {
                        "ru": "создавать, придавать форму чему-либо из пластичного материала (глины, пластилина, теста или снега)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лепить",
                                "target_lang_sense_clarification": "из глины, пластилина, снега или теста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d658f8c-0a09-3686-ad39-1db6895569af",
                    "sense_definition": "przyczepiać lub mocować coś do jakiejś powierzchni za pomocą kleju",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klejenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Młodzi aktywiści wieczorem <w>lepili</w> ogłoszenia na słupach i tablicach informacyjnych.",
                            "target_lang_translations": {
                                "ru": "Молодые активисты вечером <w>клеили</w> объявления на столбах и досках для информации."
                            }
                        },
                        {
                            "text": "Nie powinieneś <w>lepić</w> tych plakatów bezpośrednio na świeżo pomalowanej ścianie.",
                            "target_lang_translations": {
                                "ru": "Тебе не следует <w>клеить</w> эти плакаты прямо на свежевыкрашенную стену."
                            }
                        }
                    ],
                    "synonyms": [
                        "kleić",
                        "przyklejać"
                    ],
                    "common_phrases": [
                        "lepić plakaty"
                    ],
                    "target_lang_definitions": {
                        "ru": "прикреплять или фиксировать что-либо на поверхности с помощью клея"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клеить",
                                "target_lang_sense_clarification": "прикреплять с помощью клея"
                            },
                            {
                                "target_lang_word": "приклеивать",
                                "target_lang_sense_clarification": "прикреплять к поверхности"
                            },
                            {
                                "target_lang_word": "лепить",
                                "target_lang_sense_clarification": "разг., приклеивать, наклеивать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee0f595f-fe28-33f3-b432-1fe81ac35b77",
                    "sense_definition": "być lepkim lub przylegać do czegoś wskutek obecności kleistej substancji",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przyleganie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po rozlaniu słodkiego soku cały stół bardzo nieprzyjemnie się <w>lepi</w>.",
                            "target_lang_translations": {
                                "ru": "После пролитого сладкого сока весь стол очень неприятно <w>липнет</w>."
                            }
                        },
                        {
                            "text": "Po całym dniu ciężkiej pracy fizycznej jego koszula <w>lepiła</w> się do pleców.",
                            "target_lang_translations": {
                                "ru": "После целого дня тяжёлой физической работы его рубашка <w>липла</w> к спине."
                            }
                        }
                    ],
                    "synonyms": [
                        "lgnąć"
                    ],
                    "common_phrases": [
                        "lepić się od potu"
                    ],
                    "target_lang_definitions": {
                        "ru": "быть липким или приставать к чему-либо из-за клейкого вещества"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "липнуть",
                                "target_lang_sense_clarification": "быть липким, прилипать к чему-либо"
                            },
                            {
                                "target_lang_word": "прилипать",
                                "target_lang_sense_clarification": "приставать к поверхности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
