                        "cross_references": [
                            {
                                "target_word": "кирасирский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1288f087-cf3c-3afb-81f5-10caa6868d36",
                                        "entry_id": "a3cfb172-2184-3efe-897c-8a819666c6e6",
                                        "glosses": [
                                            "истор., воен. относящийся к кирасиру"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af32a80a-7b53-403f-911c-f21b5b353e28",
                                                "sense_id": "1288f087-cf3c-3afb-81f5-10caa6868d36",
                                                "text": "Тогда кирасирский его величества полк двинулся для удержания атаки."
                                            },
                                            {
                                                "example_id": "4a62b087-1108-4b12-8cf5-f08a90fdcacf",
                                                "sense_id": "1288f087-cf3c-3afb-81f5-10caa6868d36",
                                                "text": "Вдоль по Новой Басманной скакал молодой кирасирский офицер, сопровождаемый несколькими казаками."
                                            },
                                            {
                                                "example_id": "dae18817-9d9b-46ea-a156-1d9d1f47ee54",
                                                "sense_id": "1288f087-cf3c-3afb-81f5-10caa6868d36",
                                                "text": "Тут важно выступает строй кирасирский; здесь пронеслись гусары, там летят уланы, а вот идет прекрасная, стройная, грозная пехота наша!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
