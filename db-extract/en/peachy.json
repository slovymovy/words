                                            "singular"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a92cb495-8d7c-4971-a30f-f1648d396b30",
                        "source_entry_id": "a945ab45-bb4b-3113-986e-1f321e0f55db",
