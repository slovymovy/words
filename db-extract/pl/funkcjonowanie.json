                                "target_senses": [
                                    {
                                        "sense_id": "6dc03031-e363-34de-956c-e016980053b6",
                                        "entry_id": "d4ddfafb-be63-38f0-a66d-72cfbffacacf",
                                        "glosses": [
                                            "To function improperly."
