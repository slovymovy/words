                        "glosses": [
                            "to curse, to swear, to cuss (using the word чёрт (čort, “devil”) or related terms)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a127a3dc-dcf8-4808-ba8e-046950d2db91",
                                "sense_id": "5b2efc02-7025-362a-882c-aec153238e51",
                                "text": "Грым перевёл взгляд на сле́дующий лист, расте́рянно пробежа́л по нему́ глаза́ми и чертыхну́лся. Сле́дующие пять и́ли шесть страни́ц бы́ли вы́рваны.",
                                "translation": "Grim looked across to the next page, ran his eyes over it in bewilderment and cursed. The next five or six pages had been torn out.",
                                "english": "Grim looked across to the next page, ran his eyes over it in bewilderment and cursed. The next five or six pages had been torn out."
                            }
                        ]
                    }
