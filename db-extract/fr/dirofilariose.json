                        "glosses": [
                            "Maladie parasitaire due à diverses espèces de nématode du genre Dirofilaria, qui infecte les mammifères dont l'Homme."
                        ],
                        "tags": [
                            "Médecine vétérinaire"
                        ],
                        "examples": [
                            {
                                "example_id": "9e1de437-defb-4298-a17d-9d76da03eed0",
                                "sense_id": "83c6ffab-7ee3-357f-b61c-0dae19c00fab",
                                "text": "La dirofilariose est une maladie parasitaire ; le parasite est un nématode qui se loge dans le ventricule droit du cœur et dans l’artère pulmonaire."
                            },
                            {
                                "example_id": "6e37f8e7-6e0a-4918-ae74-fe4366f27e71",
                                "sense_id": "83c6ffab-7ee3-357f-b61c-0dae19c00fab",
                                "text": "Autre maladie parasitaire également transmise par un moustique présent sur le pourtour méditerranéen : la dirofilariose, ou vers du cœur."
                            }
                        ]
                    }
