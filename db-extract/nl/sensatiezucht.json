                        "glosses": [
                            "een overdreven, onbedwingbare behoefte om spannende zaken mee te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bfe6dee-83b5-4398-89fb-bfd4dc944157",
                                "sense_id": "efd54096-e4ef-3c9e-b3d1-7ce895547fe7",
                                "text": "\"Ik ben geraakt. Kwaad. Ik vind het onbegrijpelijk dat mensen vanuit hun emotie of vanuit sensatiezucht klakkeloos zo’n bericht overnemen.\""
                            },
                            {
                                "example_id": "e697bcd1-531f-4b76-a50e-23d277272fd1",
                                "sense_id": "efd54096-e4ef-3c9e-b3d1-7ce895547fe7",
                                "text": "Voortijdig lekken van niet-geanalyseerd materiaal, zonder context, leidt tot voorbarige conclusies, schending van privacy, sensatiezucht en voyeurisme, stelt de vereniging."
                            },
                            {
                                "example_id": "88119541-abd6-4118-b4a5-479b101a3706",
                                "sense_id": "efd54096-e4ef-3c9e-b3d1-7ce895547fe7",
                                "text": "Nadat een aanwezige journalist erover had gepubliceerd zei hij dat hij de uitspraak had gedaan \"uit frustratie over de sensatiezucht in mediaberichten over het bedrijf waar ik trots op ben\". De uitspraak was volgens Michael niet serieus bedoeld."
                            }
                        ]
                    }
