                "senses": [
                    {
                        "sense_id": "08113323-c8c9-34b1-986e-31f11becefd1",
                        "entry_id": "3e155e06-a84e-3ead-8f5c-a2d979c59b7a",
                        "glosses": [
                            "L'un des différents types de cancer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5008a14-3cda-4255-8ccd-91251878701b",
                                "sense_id": "08113323-c8c9-34b1-986e-31f11becefd1",
                                "text": "Eine europaweite Studie zeigte, dass Dickdarmkrebs bei Menschen zwischen 20 und 29 um acht Prozent zugenommen hat. (...) Insgesamt ist die Krebsart die zweithäufigste in Europa.",
                                "translation": "Une étude paneuropéenne a montré que le cancer du côlon avait augmenté de 8 % chez les personnes âgées de 20 à 29 ans. (...) Globalement, ce type de cancer est le deuxième le plus fréquent en Europe."
                            },
                            {
                                "example_id": "2ea78548-4d91-4738-9500-35b4107f8f39",
                                "sense_id": "08113323-c8c9-34b1-986e-31f11becefd1",
                                "text": "Kaffee soll auch das Risiko für chronische Erkrankungen wie Typ-2-Diabetes, Herz-Kreislauf-Erkrankungen und verschiedene Krebsarten reduzieren.",
                                "translation": "Le café est censé de réduire également le risque de maladies chroniques telles que le diabète de type 2, les maladies cardiovasculaires et divers types de cancer."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b03330-4ad7-3be2-9466-940fb6927cb1",
