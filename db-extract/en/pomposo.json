                "senses": [
                    {
                        "sense_id": "4352a4a4-3ac7-3856-a1cd-7fc8bae96022",
                        "entry_id": "d2bc998e-e22c-3190-b38b-77ec348a6e01",
                        "glosses": [
                            "An arrogant, boastful or self-important person."
                        ],
                        "tags": [
                            "dated",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ce198df0-ff11-4e6e-b461-c7e6f93924cb",
                                "sense_id": "4352a4a4-3ac7-3856-a1cd-7fc8bae96022",
                                "text": "I have heard that this pomposo, this braggart, is a Yankee trick too; that he has the front of a lion, the liver of the chicken."
                            },
                            {
                                "example_id": "61103867-a677-4ebb-a4ef-44738dc4515c",
                                "sense_id": "4352a4a4-3ac7-3856-a1cd-7fc8bae96022",
                                "text": "After all, it isn't amusing for the grand seigneurs, the pomposos, of the art-dealing world to have their opinions first questioned and then disproved again and again by someone so much younger and, according to their standards, so much less equipped."
                            },
                            {
                                "example_id": "da8cc8ee-aaf6-449a-8a5b-dcbf888bc240",
                                "sense_id": "4352a4a4-3ac7-3856-a1cd-7fc8bae96022",
                                "text": "The book's sheer joy lies in her hour-by-hour outwitting the young pomposo, resulting in a frustrated entry in his journal on Sunday morning."
                            }
                        ]
                    }
                ],
