                    "frequency": "Middle",
                    "semantic_group_id": "dragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij liep de hele middag met zware zakken aardappelen te <w>sjouwen</w>.",
                            "target_lang_translations": {
                                "en": "He spent the whole afternoon <w>lugging</w> heavy bags of potatoes around."
                            }
                        },
                        {
