                                "target_senses": [
                                    {
                                        "sense_id": "56e8a597-22c3-3cf7-9681-416640d961a3",
                                        "entry_id": "85465270-c78e-36c3-a818-00c0b7230c88",
                                        "glosses": [
                                            "An animal which is able to consume both plants (like a herbivore) and meat (like a carnivore)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72ce9f1-889e-4af1-b61f-82f72057499f",
                                                "sense_id": "56e8a597-22c3-3cf7-9681-416640d961a3",
                                                "text": "Bears are omnivores: they can eat plants, but they also eat fish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f278760-dc2a-4737-af8e-12806b3fe38a",
                        "source_entry_id": "c0cd4c82-5952-31a8-8999-cb96401658a2",
                        "source_sense_id": "9a88a306-d5af-3965-9e4f-e5a079eb525a",
