                    {
                        "translation_id": "d25a44fa-42d3-4fb3-89b7-5006fa6c6ce4",
                        "source_entry_id": "dc9d8672-1eae-32a6-b7ae-8e34a022355a",
                        "source_sense_id": "14358c83-acd8-32a4-a442-929f2efb00cd",
                        "source_sense_description": "Het zielenleven betreffend voor zover dit door sociale factoren beïnvloed wordt",
                        "target_lang_word": "psychosozial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psychosozial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c59b8916-0301-36a7-8116-032c8598884a",
                                        "entry_id": "a7c8be94-4890-350c-8b4d-217005bd71aa",
                                        "glosses": [
                                            "soziale Gegebenheiten betreffend, die die Psyche beeinflussen"
                                        ],
                                        "tags": [
                                            "Sozialpsychologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96b4d5b2-a84a-4b84-aa3a-a0b223485310",
                                                "sense_id": "c59b8916-0301-36a7-8116-032c8598884a",
                                                "text": "Eine Gruppe erhielt Heroin, die andere wurde mit Methadon behandelt. Beide Gruppen wurden regelmäßig medizinisch betreut und erhielten eine psychosoziale Begleittherapie."
                                            },
                                            {
                                                "example_id": "6538a540-ef6c-4041-9c1b-5673d4315564",
                                                "sense_id": "c59b8916-0301-36a7-8116-032c8598884a",
                                                "text": "Grundsätzlich ist es ihr Ziel, die Betroffenen durch Beratung und Begleitung psychosozial zu stabilisieren."
                                            },
                                            {
                                                "example_id": "14a9288b-7d9d-442e-91dc-6553b1f947de",
                                                "sense_id": "c59b8916-0301-36a7-8116-032c8598884a",
                                                "text": "\"Wir konnten damit erstmals auf molekularer Ebene bestätigen, dass negative psychosoziale Einflüsse die Verbreitung des Krebses beschleunigen\", deutet der Forscher das Ergebnis."
                                            },
                                            {
                                                "example_id": "174622cf-f01b-4ec1-abe7-185bfd2251f4",
                                                "sense_id": "c59b8916-0301-36a7-8116-032c8598884a",
                                                "text": "Obwohl oft traumatisiert, werden sie [die Flüchtlingskinder] nicht ausreichend medizinisch und psychosozial betreut, und Jugendhilfe wird ihnen höchstens bis zum 16. Lebensjahr gewährt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76aba79d-f76d-4d40-abb6-8f7789e59ab0",
                        "source_entry_id": "dc9d8672-1eae-32a6-b7ae-8e34a022355a",
                        "source_sense_id": "14358c83-acd8-32a4-a442-929f2efb00cd",
