                        ]
                    },
                    {
                        "translation_id": "10b64860-a97b-4766-8e19-97d5e22642ab",
                        "source_entry_id": "19ea3266-bab1-3f9b-a56c-4e8ad991ffdc",
                        "source_sense_id": "9655c234-510e-38e2-81de-4a12e52b2764",
                        "source_sense_description": "in geordende, kalme opeenvolging van het een op het ander overgaand",
                        "target_lang_word": "progressif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progressif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "809da7e4-a070-3702-bb00-dc04306c11da",
                                        "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                                        "glosses": [
                                            "Qui porte en avant, qui relève du progrès."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46250c31-bb65-401f-922f-cfc2c940650a",
                                                "sense_id": "809da7e4-a070-3702-bb00-dc04306c11da",
                                                "text": "Les lames de Tolède d’aujourd’hui valent donc celles d’autrefois ; le secret de la trempe n’est pas perdu, mais le secret de la forme : il ne manque vraiment aux ouvrages modernes que cette petite chose, si méprisée des gens progressifs, pour soutenir la comparaison avec les anciens, une épée moderne n’est qu’un outil, une épée du seizième siècle est à la fois un outil et un joyau."
                                            },
                                            {
                                                "example_id": "7c838b0e-a7f4-462d-9185-7d89e2a7567f",
                                                "sense_id": "809da7e4-a070-3702-bb00-dc04306c11da",
                                                "text": "Les Barbares ne créèrent point de sociétés progressives ; ils étaient peu nom­breux et presque partout ils se substituèrent simplement aux anciens grands seigneurs, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2506befd-d67b-34b6-a5b6-f605183830ba",
                                        "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                                        "glosses": [
                                            "Qualifie la marche, le mouvement en avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4ca5fef-f373-425c-9ed0-612bd4717019",
                                                "sense_id": "2506befd-d67b-34b6-a5b6-f605183830ba",
                                                "text": "Le mouvement progressif des animaux."
                                            },
                                            {
                                                "example_id": "60d427b5-a5cf-4a77-af00-c96772b89a08",
                                                "sense_id": "2506befd-d67b-34b6-a5b6-f605183830ba",
                                                "text": "L’huître est privée du mouvement progressif."
                                            },
                                            {
                                                "example_id": "7dcb2a12-beb3-4a91-a425-164f96cdbfb3",
                                                "sense_id": "2506befd-d67b-34b6-a5b6-f605183830ba",
                                                "text": "Le mouvement progressif de la Lune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7da85e52-8763-3a35-a5d1-843547563a47",
                                        "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                                        "glosses": [
                                            "Qui s’avance, qui se développe par degrés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100057da-dbae-47da-bfa4-129802455011",
                                                "sense_id": "7da85e52-8763-3a35-a5d1-843547563a47",
                                                "text": "Des hommes tels que Galilée ou Carnot, qui possédaient à un degré extraordinaire cette Intelligence des Analogies, ont ainsi créé l’Énergétique par généralisations progressives, prudentes et hardies tout ensemble, de relations expérimentales et de réalités sensibles."
                                            },
                                            {
                                                "example_id": "aa196206-2181-4685-afc3-1937f8dbc5c1",
                                                "sense_id": "7da85e52-8763-3a35-a5d1-843547563a47",
                                                "text": "Une natalité insuffisante et, on va le voir, une mortalité trop forte se conjuguent pour marquer le déclin progressif de la population de ce département."
                                            },
                                            {
                                                "example_id": "59b0b0a9-8814-4c30-b39d-b15eb9554097",
                                                "sense_id": "7da85e52-8763-3a35-a5d1-843547563a47",
                                                "text": "Mais la plupart subissent des métamorphoses qui définissent les insectes hétéromorphes ; elles sont progressives dans le type hétérométabole, et se font par étapes dans le type holométabole qui est le plus fréquent et le plus important."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c5aa1b-e9b5-3d18-aef2-427ff8de75bf",
                                        "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                                        "glosses": [
                                            "Qualifie un impôt dont la proportion s’élève à mesure qu’augmente la grandeur de la chose imposée."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6e5d67a-b797-48e2-9e77-a5f681b4fa8d",
                                                "sense_id": "78c5aa1b-e9b5-3d18-aef2-427ff8de75bf",
                                                "text": "L’impôt progressif sur le revenu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc0b4c31-1dcb-3024-b075-48e191655770",
                                        "entry_id": "2bde5122-e025-3043-b12a-fb49f2278729",
                                        "glosses": [
                                            "Qui envahit successivement les différentes parties du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0f7326-de53-4fa7-b23f-1499cbf1edf9",
                                                "sense_id": "fc0b4c31-1dcb-3024-b075-48e191655770",
                                                "text": "Paralysie progressive."
                                            }
                                        ]
                                    },
                                    {
