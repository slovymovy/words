                        "glosses": [
                            "En France, juge des libertés et de la détention, qui est chargé de statuer pour le placement en détention provisoire, ou en cas de demandes de mise en liberté."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "504dec84-7fb0-4274-b397-692bae9a7e2d",
                                "sense_id": "3cf0af9e-6ca9-35d0-ada8-bf6d8f40665f",
                                "text": "Il a finalement été remis en liberté par le juge des libertés et de la détention (JLD) et sera jugé pour violences aggravées le 18 septembre."
                            },
                            {
                                "example_id": "1637ea20-afa6-4178-9644-2955f2ca9a20",
                                "sense_id": "3cf0af9e-6ca9-35d0-ada8-bf6d8f40665f",
                                "text": "Le juge des libertés et de la détention (JLD) est un magistrat expérimenté du siège du tribunal judiciaire."
                            },
                            {
                                "example_id": "734c4b41-4a75-4bd3-9d2c-052e11cca56d",
                                "sense_id": "3cf0af9e-6ca9-35d0-ada8-bf6d8f40665f",
                                "text": "Le JLD est incompétent pour se prononcer sur la mise en œuvre d'une décision médicale distincte de la procédure de soins psychiatriques sans consentement."
                            }
                        ]
                    }
