                    },
                    {
                        "translation_id": "5fe4d755-48a4-4a4a-b841-c99a5b59eef5",
                        "source_entry_id": "7aedd1f7-1df3-3552-ba24-6b3f7653e01c",
                        "source_sense_id": "8d773f50-4191-3e5e-bcb6-e3067cd8e78b",
                        "target_lang_word": "rich",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rich",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "888beeee-3772-33c2-93c8-829389bb29e5",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Wealthy: having a lot of money and possessions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b030bc7d-6883-4ea8-b8f9-91209ec2d862",
                                                "sense_id": "888beeee-3772-33c2-93c8-829389bb29e5",
                                                "text": "“A very welcome, kind, useful present, that means to the parish. By the way, Hopkins, let this go no further. We don't want the tale running round that a rich person has arrived. Churchill, my dear fellow, we have such greedy sharks, and wolves in lamb's clothing.[…]”"
                                            },
                                            {
                                                "example_id": "c2e14ece-00cd-4460-803c-18292125d7e3",
                                                "sense_id": "888beeee-3772-33c2-93c8-829389bb29e5",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. […]"
                                            },
                                            {
                                                "example_id": "6c5ca07d-6310-44d1-9f0a-fa7cbb800bc5",
                                                "sense_id": "888beeee-3772-33c2-93c8-829389bb29e5",
                                                "text": "The richest person in the world got even richer Friday, with Musk’s net worth hitting a record $347.8 billion, Bloomberg reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36477923-82b7-39a8-8631-aff6819df467",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Having an intense fatty or sugary flavour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2645770e-6814-4772-867e-5a7a413f2795",
                                                "sense_id": "36477923-82b7-39a8-8631-aff6819df467",
                                                "text": "a rich dish; rich cream or soup; rich pastry"
                                            },
                                            {
                                                "example_id": "5f8ee2a1-2247-4f44-921f-334624f2bc0e",
                                                "sense_id": "36477923-82b7-39a8-8631-aff6819df467",
                                                "text": "It is the richest food I have ever eaten, and for this reason I soon learned to partake of it sparingly."
                                            },
                                            {
                                                "example_id": "2a9d5f2c-e629-4b75-8960-d2f6f799212a",
                                                "sense_id": "36477923-82b7-39a8-8631-aff6819df467",
                                                "text": "1709-1710, Thomas Baker, Reflections on Learning\nHigh sauces and rich spices are fetch'd from the Indies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41f187a5-9256-3e7d-a0b8-78006649acce",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Remunerative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56a703da-2225-49c1-a973-16e5a2606d1a",
                                                "sense_id": "41f187a5-9256-3e7d-a0b8-78006649acce",
                                                "text": "All racists I grew up with have rich jobs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Plentiful, abounding, abundant, fulfilling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d32292-1bc5-4547-83c1-b5114c644003",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "a rich treasury; a rich entertainment; a rich crop"
                                            },
                                            {
                                                "example_id": "129c8ba4-bfb9-4c87-af09-41b409a9dabb",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "rich in fiber; rich in traditions"
                                            },
                                            {
                                                "example_id": "5f7e637a-9451-42d7-a9d8-37957cac3ada",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "Tho' my Date of mortal Life be short, it shall be glorious; / Each minute shall be rich in some great action."
                                            },
                                            {
                                                "example_id": "cda1481e-fe97-4328-9745-a5bd2e8ab3e9",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "The gorgeous East with richest hand / Showers on her kings barbaric pearl and gold."
                                            },
                                            {
                                                "example_id": "0c66335f-a4bc-4791-a2db-f88d443ae964",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "For countries with rich culinary traditions that date back to the Aztecs and Incas, Mexico and Peru have developed quite a taste for modern food fashions. Mexicans quaff more fizzy drinks than any other country; Peru has the highest density of fast-food joints in the world."
                                            },
                                            {
                                                "example_id": "849a023b-d763-4e03-b9ac-b4bda0c73f4c",
                                                "sense_id": "d8e6ce32-a14f-3e92-9f7e-a9ee19bf89fe",
                                                "text": "Sham Shui Po might be one of Hong Kong’s poorest neighbourhoods but it has a rich immigrant history and a glut of fantastic street-food joints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c31d310-8bd9-393b-9132-32c7cf0759fc",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Yielding large returns; productive or fertile; fruitful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f927266-60dd-44d1-8216-3cf577322040",
                                                "sense_id": "4c31d310-8bd9-393b-9132-32c7cf0759fc",
                                                "text": "rich soil or land; a rich mine"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8138ec02-c7e1-30f5-9aaf-e02ab6839079",
                                        "entry_id": "47c12815-ddf1-3736-837a-c8aecd0897c8",
                                        "glosses": [
                                            "Composed of valuable or costly materials or ingredients; procured at great outlay; highly valued; precious; sumptuous; costly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d5cff7-8739-444c-b024-13fb56174085",
                                                "sense_id": "8138ec02-c7e1-30f5-9aaf-e02ab6839079",
                                                "text": "a rich endowment; a rich dress; rich silk or fur; rich presents"
                                            },
                                            {
                                                "example_id": "e37e2727-4332-4035-ad06-ac4f89e632a4",
                                                "sense_id": "8138ec02-c7e1-30f5-9aaf-e02ab6839079",
                                                "text": "rich and various gems",
                                                "translation": "Comus",
                                                "english": "Comus"
