                ],
                "senses": [
                    {
                        "sense_id": "fbf6c480-ca44-37bf-ae1a-3fad01fba174",
                        "entry_id": "4bf5313f-c3d0-3662-89f9-6f27b34f75c3",
                        "glosses": [
                            "Nombre ordinal qui répond à l’adjectif numéral nonante."
                        ],
                        "tags": [
                            "Belgique",
                            "Suisse",
                            "Congo-Kinshasa",
                            "Acadie"
                        ],
                        "examples": [
                            {
                                "example_id": "5b7f5282-1a98-4c85-9507-26e3305bb2bd",
                                "sense_id": "fbf6c480-ca44-37bf-ae1a-3fad01fba174",
                                "text": "Que dire d’un goal à la nonantième minute de la demi-finale d’une coupe du monde de football, aucune opinion ne pourrait émerger sous les flots d’adrénaline, de prolactine, d’ocytocine et de sérotonine."
                            },
                            {
                                "example_id": "64f37d1c-fe3b-435d-862b-48d188aaac45",
                                "sense_id": "fbf6c480-ca44-37bf-ae1a-3fad01fba174",
                                "text": "Le nonantième précède le nonante-et-unième et suit le quatre-vingt-neuvième."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cf3586a-c309-3853-bd2e-808a7b6cf596",
                        "entry_id": "4bf5313f-c3d0-3662-89f9-6f27b34f75c3",
                        "glosses": [
                            "Fraction obtenue en divisant nonante fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d25ac585-2abc-4b69-9e6d-3784f7f1a0e7",
                                "sense_id": "8cf3586a-c309-3853-bd2e-808a7b6cf596",
                                "text": "Donnez-moi le nonantième de ce gâteau."
                            }
                        ]
                    }
