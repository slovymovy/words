                    }
                ],
                "translations": [
                    {
                        "translation_id": "12b1e579-9f5f-45cb-b95d-e81f0b9df3a9",
                        "source_entry_id": "47804763-d2d0-3916-8d2a-5049f002d44a",
                        "source_sense_id": "189461ef-0db0-362f-926d-19872f010925",
                        "target_lang_word": "saltwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saltwater",
