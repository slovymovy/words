                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot warned that the plane was coming in <w>hot</w> for the landing.",
