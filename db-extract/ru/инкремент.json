                        "entry_id": "bea803d1-1d98-38f5-a70a-9debb2ba077d",
                        "glosses": [
                            "прогр., физ. увеличение (на определённую величину), приращение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d37d4533-822a-4ded-ad3e-9e7164cb4b04",
                                "sense_id": "4d736cd2-e55a-3ec1-be0c-96f1c4429606",
                                "text": "Получено дисперсионное уравнение для инкремента нарастания малых амплитудных возмущений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
