                "senses": [
                    {
                        "sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                        "entry_id": "d702f200-f5be-3c07-888c-2ccc7a193024",
                        "glosses": [
                            "osoba mająca autyzm"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "a617fd4a-9b5d-4ee0-a26d-0979a6e80eb0",
                                "sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                                "text": "Dziś jego nazwisko funkcjonuje jako rzeczownik opisujący „autystów wysokofunkcjonujących” i nikt nie mówi już o eksterminacji „życia niewartego życia”"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f77a0e66-d346-43e1-aca2-3a3d09f30f8a",
                        "source_entry_id": "d702f200-f5be-3c07-888c-2ccc7a193024",
                        "source_sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                        "target_lang_word": "autistic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Having autism, or pertaining to autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b344ac0-b08f-4f64-a4b2-eb1cae634213",
                                                "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                                "text": "Barry is... well, what? Borderline autistic and obsessive-compulsive, with serious anger management issues and a dangerous behavioural disorder that in the real world would get him a one-way ticket to the rubber room."
                                            },
                                            {
                                                "example_id": "d8c8e215-361f-4a78-9306-8cdf9a790c76",
                                                "sense_id": "1debd59b-82a2-3573-8ebf-6b87499d30d5",
                                                "text": "Yet because of the history and proliferation of the supercrip in films in television shows – not only with autism but supercrips with other disabilities as well – viewers are primed for the supercrip autistic and are therefore not expecting (in some ways) a view of autism that comes across to many in the autism community as more realistic or honest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c81da4d-0108-3c19-b3f0-f201328243a9",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Socially inept, self-absorbed, or stupid."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96570c4c-41c6-37cd-89ae-b281edf31ee0",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Characterized by abnormal and unhealthy focus or persistence, and unhealthy hatred of opposition or criticism. Obsessive."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b506d28-409b-491f-8441-8b0f3844e295",
                                                "sense_id": "96570c4c-41c6-37cd-89ae-b281edf31ee0",
                                                "text": "imagine being this autistic over a fictional character"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b99ff04-869b-39d8-b429-609aa7a7c91e",
                                        "entry_id": "3813e459-1211-34a3-8d64-7ead2fa23529",
                                        "glosses": [
                                            "Lame, uncool, stupid."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "offensive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "autistic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                        "entry_id": "f4e565f3-8adf-3b1d-a29a-3232a0b0849a",
                                        "glosses": [
                                            "A person who has autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83dfaf13-65da-4fc2-b5a3-75c2c74895b9",
                                                "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                                "text": "If our definition of empathy were to require we take the human cognitive norm (overwhelmingly influenced by neurotypical cognition) as the absolute standard by which to measure empathy, then indeed we would have to conclude autistics do not instinctively possess a good sense of empathy."
                                            },
                                            {
                                                "example_id": "b68c7966-17a9-47e0-956b-f9f6f76fc479",
                                                "sense_id": "9873ae36-4522-30ba-bd05-8fdd79177281",
                                                "text": "After reading this book, medical professionals should be able to develop an understanding of some of the challenges that autistics are experiencing during the COVID-19 pandemic."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57eb3a8b-bd9f-448c-ba3a-693f4b8bdaa8",
                        "source_entry_id": "d702f200-f5be-3c07-888c-2ccc7a193024",
                        "source_sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                        "target_lang_word": "autist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                        "entry_id": "3acf3730-19a5-328b-9587-26bce027e049",
                                        "glosses": [
                                            "An autistic person, a person with autism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf75d12-9b28-4a06-9296-2829a74ccef0",
                                                "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                                "text": "Most autists are not artists, as most artists are not autists; but in the chance of their coming together […] there must, I think, be an interaction between the two, so that the art takes on some of the strengths and weaknesses of autism […]"
                                            },
                                            {
                                                "example_id": "afa1ec17-627e-428f-a94c-0ec645efb161",
                                                "sense_id": "7754e8dc-6cf9-325b-8620-6daff1296305",
                                                "text": "Like children and animals, autists have relatively rudimentary conceptual lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcdf9892-8965-3b62-a9ba-1c7e7a5eb19f",
                                        "entry_id": "3acf3730-19a5-328b-9587-26bce027e049",
                                        "glosses": [
                                            "A person characterized by abnormal and unhealthy focus or persistence, low self-awareness and unhealthy hatred of opposition or criticism."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "derogatory",
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2ae60b-5670-4e16-bc85-b74375881b22",
                                                "sense_id": "fcdf9892-8965-3b62-a9ba-1c7e7a5eb19f",
                                                "text": "autists arguing about 'muh graphics'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a83ff5f-818a-45ec-828c-ac6ccc352b65",
                        "source_entry_id": "d702f200-f5be-3c07-888c-2ccc7a193024",
                        "source_sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                        "target_lang_word": "autista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autista",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4fceaad0-8e01-38e3-971d-f01089060519",
                                        "entry_id": "33a6b127-a57d-337d-b69a-bf9f04625b55",
                                        "glosses": [
                                            "osoba postižená autismem"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8495fbfb-ff28-468f-9c1b-b57de94201d0",
                        "source_entry_id": "d702f200-f5be-3c07-888c-2ccc7a193024",
                        "source_sense_id": "cafea31d-9407-3841-ad42-516f5a45c8ea",
                        "target_lang_word": "autiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                        "entry_id": "73e21df6-adc6-39c3-9957-44de55566112",
                                        "glosses": [
                                            "Qualifie une personne présentant des caractéristiques relevant de l'autisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d05430d-89be-466e-bf28-269c1a367ac9",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Si nous savons que les fonctions cognitives de l’enfant autiste sont gravement perturbées et qu’il ne différencie guère l’animé de l’inanimé, il n’en est pas de même pour le faux self."
                                            },
                                            {
                                                "example_id": "950b386a-6fff-471a-9813-ecc5adf84f60",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Quand l'activité langagière de l'enfant autiste s'est bien développée vont coexister des capacités combinatoires nuancées et la tendance à utiliser des morceaux de discours écholaliques."
                                            },
                                            {
                                                "example_id": "d6a2485b-7aab-4dd9-bb8b-0b3ef9512305",
                                                "sense_id": "44452b1d-ca81-3b96-bfcc-2c7d95de9d85",
                                                "text": "Chaque personne autiste organise son cerveau d’une façon qui lui est propre. On est capables de dégager des lois générales, mais on n’arrive pas pour le moment à faire une classification qui est assez performante"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                        "entry_id": "73e21df6-adc6-39c3-9957-44de55566112",
                                        "glosses": [
                                            "Qualifie une personne physique ou morale qui ne perçoit pas les sentiments ou les intentions d’autrui."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e26198-6ac3-4680-b88a-ca087c43c81e",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Née d’un sentiment d'infériorité humiliant, une telle idée doit être surcompensée, transformée en sentiment de supériorité, jusqu’à faire surgir une allophobie autiste que l’individu égaré s'applique à lui-même dans une exaspération schizothyme."
                                            },
                                            {
                                                "example_id": "1174e261-efbb-4650-80df-81dc904e435c",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Je ne suis pas autiste, je vois bien les difficultés …. Je ne suis pas jusqu'au-boutiste, pas enfermé dans une certitude, mais il y a une chose que je constate, c'est qu'il n'y a pas d'alternative"
                                            },
                                            {
                                                "example_id": "3c1a45ed-8b31-43eb-b114-bcbeba4a63e9",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Ces derniers jours, on a souvent qualifié le régime algérien d’autiste. C’est porter préjudice aux gens atteints de cette maladie dont certains développent une intelligence exceptionnelle et une sensibilité hors du commun."
                                            },
                                            {
                                                "example_id": "8f0ed507-4c83-4d4d-8a5d-6adf0b95990d",
                                                "sense_id": "848c0da6-1e44-321c-be07-dd23ef242584",
                                                "text": "Le gouvernement « n’est pas autiste » : la maladresse du ministre du Travail Jean-Pierre Farandou, pour laquelle il a fait son mea culpa, est une illustration du regard déformé que porte encore la société sur le handicap, selon des experts."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "autiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a642090-cd8b-3a67-a019-bc3fb738adde",
                                        "entry_id": "8a4f2606-73a4-35c2-b5a6-0ac31531c3ec",
                                        "glosses": [
                                            "Personne ayant de l’autisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dd9a670-71e6-4718-aeed-d667a65fc39b",
                                                "sense_id": "7a642090-cd8b-3a67-a019-bc3fb738adde",
                                                "text": "Il ne faut pas croire que les autistes ont des stéréotypies et que les non-autistes n’en ont pas. Les stéréotypies des personnes non autistes passent simplement pour naturelles, sont mieux acceptées socialement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
