                                    },
                                    {
                                        "sense_id": "2ca0a73d-77a2-3573-9684-75c292155730",
                                        "entry_id": "f52467ee-213f-3b55-afeb-8aa5ef0be946",
                                        "glosses": [
                                            "„Intervall von sieben Tönen“"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055a4c5c-1edb-4093-a22b-cec3e245012a",
                                                "sense_id": "2ca0a73d-77a2-3573-9684-75c292155730",
                                                "text": "„Die verminderten Terzen, die kleinen Septimen verschleifen sich über das Baumwollfeld bis zum Farmhaus hin.“"
                                            },
                                            {
                                                "example_id": "aba8217a-b4e6-4ee6-a54f-40e2c15c7975",
                                                "sense_id": "2ca0a73d-77a2-3573-9684-75c292155730",
                                                "text": "„Dann aber erhob sich mit einem Male ein förmlicher Sturm, aus dem Orchester schollen chromatische Tonleitern und Akkorde in der kleinen Septime, und nun liefen alle wieder durcheinander und schleppten einen der Leute auf der Bühne hinter die Kulissen, und der Vorhang fiel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77ece46e-9e35-477f-9d45-32099d64b9e9",
                        "source_entry_id": "a4310330-92b2-33c9-b89f-a870f89fd4ad",
                        "target_lang_word": "septième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "septième",
