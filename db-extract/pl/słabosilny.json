                "senses": [
                    {
                        "sense_id": "1083b8d2-8e9c-3025-93b2-496e95e4bde8",
                        "entry_id": "42881f61-41f7-33ea-be86-fbfbe50d7f1a",
                        "glosses": [
                            "osłabiony, słabawy, nie odznaczający się nadmierną siłą fizyczną; niewydolny, słabujący"
                        ],
                        "tags": [
                            "dialectal",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "b363ccd3-7775-4425-8136-897be06e961c",
                                "sense_id": "1083b8d2-8e9c-3025-93b2-496e95e4bde8",
                                "text": "Sierota jezdem słabosilna, bronić się nie mogłam."
                            },
                            {
                                "example_id": "526122a1-6ed8-40e2-b65b-2d2b5c1d8658",
                                "sense_id": "1083b8d2-8e9c-3025-93b2-496e95e4bde8",
                                "text": "Każden pętak mógł go potem ile chciał sobaczyć, a on palcem nawet nie mógł ruszyć, taki się zrobił słabosilny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
