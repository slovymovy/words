                                "sense_id": "8fcb70fb-64c7-3a17-ac89-350d71c513e2",
                                "text": "Der Fachmann gewährte ihr ein Einblick in das Innenleben ihres kaputten Computer."
                            }
                        ],
                        "sense_index_json": "\"2\""
