                                        "entry_id": "fcbc9523-7e3f-3b83-b0d3-c4645ad5d16f",
                                        "glosses": [
                                            "Any of many species of marine invertebrates in the class Anthozoa, most of which build hard calcium carbonate skeletons and form colonies, or a colony belonging to one of those species."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2434fee1-c280-306f-ad02-df00cc1e3992",
                                        "entry_id": "fcbc9523-7e3f-3b83-b0d3-c4645ad5d16f",
                                        "glosses": [
                                            "A hard substance made of the skeletons of these organisms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41b9d6fd-9e0a-3dbe-9802-c0acd3b70b08",
                                        "entry_id": "fcbc9523-7e3f-3b83-b0d3-c4645ad5d16f",
                                        "glosses": [
                                            "A somewhat yellowish orange-pink color; the color of red coral (Corallium rubrum) of the Mediterranean Sea, commonly used as an ornament or gem."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e25e8b58-01fd-4f94-bb4c-63373213e56e",
                                                "sense_id": "41b9d6fd-9e0a-3dbe-9802-c0acd3b70b08",
                                                "text": "The coral faded even from her lips, till they were as white as Leo's face, and quivered pitifully."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979a4782-ba3f-3abf-9702-251bdf202b47",
                                        "entry_id": "fcbc9523-7e3f-3b83-b0d3-c4645ad5d16f",
                                        "glosses": [
                                            "The ovaries of a cooked lobster; so called from their color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab8c4ac6-604f-3484-91ea-85f5fa88eba0",
                                        "entry_id": "fcbc9523-7e3f-3b83-b0d3-c4645ad5d16f",
                                        "glosses": [
                                            "A piece of coral, usually fitted with small bells and other appurtenances, used by children as a plaything."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409436b0-aa70-4e26-b968-a4207db31cdc",
                                                "sense_id": "ab8c4ac6-604f-3484-91ea-85f5fa88eba0",
                                                "text": "On the very chair which I used to occupy when I was at work Marian was sitting now, with the child industriously sucking his coral upon her lap."
                                            }
                                        ]
                                    }
                                ]
