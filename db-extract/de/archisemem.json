                                "target_senses": [
                                    {
                                        "sense_id": "63f95c1e-f1f3-3d20-a07f-5febe500a1a3",
                                        "entry_id": "7169509d-0c64-3423-88f7-81003c9fa19a",
                                        "glosses": [
                                            "Lexème représentant, sur le plan du signifiant, des sèmes communs à deux ou plusieurs unités lexicales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3fb5caba-02d3-4b22-a10c-297d34609984",
                                                "sense_id": "63f95c1e-f1f3-3d20-a07f-5febe500a1a3",
                                                "text": "Les structures onomasiologiques de différentes sortes ont cela de commun qu’elles reposent toutes sur une dimension de ressemblance : elles sont toutes organisées à la base de traits sémantiques communs aux unités lexicales qui les composent. Ces traits communs sont identiques à ceux qui constituent l’archisémème de la structure et confèrent à toute la structure l’homogénéité conceptuelle."
                                            }
                                        ]
