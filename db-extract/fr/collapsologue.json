                        "glosses": [
                            "Spécialiste en collapsologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e73db57e-43d7-4bc2-a82b-08aa44118794",
                                "sense_id": "c824af01-243a-3fe8-83c2-441a4f566870",
                                "text": "A l’instar d’Yves Cochet, de nombreux théoriciens, regroupés sous le nom de « collapsologues » étudient depuis plusieurs années l’effondrement possible de notre civilisation industrielle."
                            },
                            {
                                "example_id": "c3e3437d-37c2-47ea-9d4d-52fbd1f1d6f3",
                                "sense_id": "c824af01-243a-3fe8-83c2-441a4f566870",
                                "text": "Les collapsologues se trompent, à mon sens, d’échelle de temps. L’effondrement n’est pas imminent. Je nous vois plutôt griller à petit feu."
                            },
                            {
                                "example_id": "673a6937-5c82-43f3-9751-5f02d4636858",
                                "sense_id": "c824af01-243a-3fe8-83c2-441a4f566870",
                                "text": "C’est ce qu’on souhaitait depuis des années avec les camarades collapsologues."
                            }
                        ]
                    }
                ],
