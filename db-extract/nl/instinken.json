        "nl-extract.jsonl": [
            {
                "entry_id": "4b7279ab-deb8-3253-8f6d-27042ad3869d",
                "word": "instinken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "645e8470-1181-3ab9-847e-1626a48c852c",
                        "entry_id": "4b7279ab-deb8-3253-8f6d-27042ad3869d",
                        "glosses": [
                            "voor de mal gehouden zijn; zich hebben laten beetnemen"
                        ],
                        "tags": [
                            "ergative"
                        ],
                        "examples": [
                            {
                                "example_id": "f128668d-8e7b-48b1-8500-d8c3834247bc",
                                "sense_id": "645e8470-1181-3ab9-847e-1626a48c852c",
                                "text": "Ik ben er met 1 april weer ingestonken."
                            },
                            {
                                "example_id": "56f49741-15b9-4f1a-8607-b23f77c32286",
                                "sense_id": "645e8470-1181-3ab9-847e-1626a48c852c",
                                "text": "Uiterlijk doet er in de praktijk natuurlijk overal toe. Dus erkennen dat we er allemaal onontkoombaar instinken, dat is pas echt stoer."
                            },
                            {
                                "example_id": "64aa480c-a20c-4e56-9b7f-8cd5d79d1a4b",
                                "sense_id": "645e8470-1181-3ab9-847e-1626a48c852c",
                                "text": "Iedereen protesteert wel braaf bij een concert of op een online-petitie, maar bijna niemand weigert de rekening te betalen voor de banken. Op maatschappelijk niveau en op individueel niveau via hoge hypotheekrentes en lage spaarrentes blijven we er allemaal instinken. We zijn inderdaad een braaf pragmatisch volk. We nodigen met ons gedrag de bancaire sector uit om dezelfde truc nog eens uit te halen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e03b65a-2156-44e2-ac6a-09272a7372ee",
                        "source_entry_id": "4b7279ab-deb8-3253-8f6d-27042ad3869d",
                        "source_sense_id": "645e8470-1181-3ab9-847e-1626a48c852c",
                        "source_sense_description": "ergatief voor de mal gehouden zijn; zich hebben laten beetnemen",
