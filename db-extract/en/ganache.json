    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                "word": "ganache",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2257c379-41de-4c3a-9994-1f3a808a4a1c",
                        "entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                        "tags": [
                            "plural"
                        ],
                        "form": "ganaches"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ab81b2b-096b-3ea8-a6a9-a9ee3e52d090",
                        "entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                        "glosses": [
                            "A rich sauce, made of chocolate and cream, used also as the filling of truffles, and as a glaze."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "064c4c4a-b3f7-478a-aa37-b288c2e17521",
                                "sense_id": "2ab81b2b-096b-3ea8-a6a9-a9ee3e52d090",
                                "text": "The centers of truffles are typically a ganache, which is most often simply a mixture of chocolate and cream. The recipes will direct you to chop the chocolate finely—do not overlook this step!"
                            },
                            {
                                "example_id": "09d44aee-cfe9-4d34-9349-6774627e34ac",
                                "sense_id": "2ab81b2b-096b-3ea8-a6a9-a9ee3e52d090",
                                "text": "She scoops a grassy, barely sweet green-tea sorbet onto white chocolate ganache, and garnishes it with coin-size meringues that break easily, then strings syrupy, candied yuzu zest across it all."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c9dd8ff-f845-31d2-af10-f2eafe05b670",
                        "entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                        "glosses": [
                            "A kind of surcoat with short cap sleeves."
                        ],
                        "tags": [
                            "countable",
                            "historical",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a5fa9c91-78c2-45df-b836-584fbf0d19b7",
                                "sense_id": "2c9dd8ff-f845-31d2-af10-f2eafe05b670",
                                "text": "M. Viollet-le-Duc says the ganache, which he considers a beautiful and simple garment, disappeared at the end of the fourteenth century. M. Quicherat makes brief mention of it as a surcoat without sleeves or girdle , and neither ..."
                            },
                            {
                                "example_id": "f29455b2-9e37-4bbd-b35c-bb5f6375edaf",
                                "sense_id": "2c9dd8ff-f845-31d2-af10-f2eafe05b670",
                                "text": ", The Medieval Wedding Planner, Lyle MacPherson\nMale clothing was worn in layers of a tunic, cote, or cotte with a surcoat over a linen shirt. […] a long sleeveless tunic. When sleeves (and sometimes a hood) were added, the cyclas became a ganache (a cap-sleeved surcoat, usually shown with hood of matching color) or a gardcorps (a long, generous-sleeved travelling robe)."
                            },
                            {
                                "example_id": "27e96971-a6a1-4f96-8927-4860cea89d9c",
                                "sense_id": "2c9dd8ff-f845-31d2-af10-f2eafe05b670",
                                "text": "2001, John Steane, The Archaeology of Power: England and Northern Europe, AD 800-1600, Tempus Pub Limited\nIlluminated miniatures show them in long robes of plain or rayed material, hoods and coifs. […] shows a man 6ft in length dressed in a ganache or tabard with two tongues or labels at the neck and a coif tied round his head."
                            },
                            {
                                "example_id": "d05a4411-9e9c-4a77-a21f-295cee42bbd6",
                                "sense_id": "2c9dd8ff-f845-31d2-af10-f2eafe05b670",
                                "text": "Cranston plucked at the ganache, the over-robe Bohun wore, tied round the middle with a ribbon. 'You've lost weight?' 'Bellum intestinum,' Bohun whispered, picking up the tankard. 'War within! There's something wrong with my gut, ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "c19029be-527b-3bd9-b1cb-6ca162b189d4",
                        "entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                        "glosses": [
                            "A fool"
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1113df2e-bd8d-41ea-b9a7-7b346fd78ff5",
                        "source_entry_id": "1d2bd756-35ba-34f0-ab62-b14b92c67991",
                        "source_sense_description": "sauce",
                        "target_lang_word": "ganache",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ganache",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0f54f4a-7247-3e41-96b2-ef3e28085ba9",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Partie inférieure et postérieure de la mâchoire inférieure des quadrupèdes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660d4ad0-963d-4ab3-a9bd-99001ad04c8f",
                                                "sense_id": "f0f54f4a-7247-3e41-96b2-ef3e28085ba9",
                                                "text": "La tête est débarrassée des longs poils couvrant la ganache, le toupet, les oreilles, pour la faire paraître plus dégagée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52c1c96b-581f-34d4-a88e-4949c2d84b7c",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Visage."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33b703d5-a333-4cbf-af69-c3ae94ae834c",
                                                "sense_id": "52c1c96b-581f-34d4-a88e-4949c2d84b7c",
                                                "text": "L’homme s’est foutu un coup de fusil dans la ganache et on a vendu la moutarde et le sel à l’encan."
                                            },
                                            {
                                                "example_id": "c22685cb-aa05-492a-a9ac-3be681db1e42",
                                                "sense_id": "52c1c96b-581f-34d4-a88e-4949c2d84b7c",
                                                "text": "De l'autre côté de la claire-voie, ils virent entrer les malabars l'un derrière l'autre, dans une lumière dansante qui dévoilait par éclipses leurs gros corps balourds et leurs vilaines ganaches de crapules."
                                            },
                                            {
                                                "example_id": "0a6435e7-29f4-403f-82f7-d288335aaf88",
                                                "sense_id": "52c1c96b-581f-34d4-a88e-4949c2d84b7c",
                                                "text": "Comme chaque fois que je nippais en milord, costume en cashmere, les pieds campés dans des Richelieu, j'avais une pensée pour le beau-père de mon ami P., un voyou de la vieille école, que je n'avais vu que trois fois dans ma vie, mais dont la ganache m'avait imposé le respect pour toujours."
                                            },
                                            {
                                                "example_id": "a9b47364-7b06-4826-af94-6c7c29e0bc53",
                                                "sense_id": "52c1c96b-581f-34d4-a88e-4949c2d84b7c",
                                                "text": "« Scientifique », « scientifique », est-ce que j'ai la ganache d'Albert Einstein ? Hein ? Vous faites chier, à pénave comme des branques tout l’temps !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60ed6d4d-b717-39a4-abc7-c7e5f2bb1a85",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Personne sans intelligence et sans énergie."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e877798-ec80-4202-be6a-d902b058f23a",
                                                "sense_id": "60ed6d4d-b717-39a4-abc7-c7e5f2bb1a85",
                                                "text": "Mais vous avez eu assez de jugement pour être d’une tristesse morne quand elle a, en quelque sorte, dit à son digne père : ─ Vous êtes une ganache."
                                            },
                                            {
                                                "example_id": "a5fe740c-56d1-4f90-9660-341766ab1a71",
                                                "sense_id": "60ed6d4d-b717-39a4-abc7-c7e5f2bb1a85",
                                                "text": "Est-il tombé dans le panneau ! (...) Absurde crétin ! (...) Et comme il donnait dans mes platitudes ! Ça m'amusait. Je me disais : Ganache ! Va, je te tiens. Je te lèche les pattes ce matin ! Je te rongerai le cœur ce soir !"
                                            },
                                            {
                                                "example_id": "075ebe8b-e65a-4f41-b8a4-3d960a6de73b",
                                                "sense_id": "60ed6d4d-b717-39a4-abc7-c7e5f2bb1a85",
                                                "text": "Mais la plus forte tête du salon jaune était à coup sûr le commandant Sicardot, le beau-père d’Aristide. Taillé en Hercule, le visage rouge brique, couturé et planté de bouquets de poil gris, il comptait parmi les plus glorieuses ganaches de la grande armée."
                                            },
                                            {
                                                "example_id": "4b338756-c5ed-42a4-9601-e0539460875d",
                                                "sense_id": "60ed6d4d-b717-39a4-abc7-c7e5f2bb1a85",
                                                "text": "Il y avait vraiment une malédiction du Ciel sur les ganaches de sacristie qui n’appréhendaient pas de manier une plume. Leur encre se muait aussitôt en une pâte, en un galipot, en une poix qui engluaient tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74e150be-f270-30e6-821d-d5255614f917",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Nappage à base de chocolat et de crème fraîche."
                                        ],
                                        "tags": [
                                            "Pâtisserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21aaa2cc-2d0e-46b3-9edf-fd96ba441db2",
                                                "sense_id": "74e150be-f270-30e6-821d-d5255614f917",
                                                "text": "La légende raconte qu’en 1850, un apprenti pâtissier renversa malencontreusement un pot de crème de lait dans une bassine de chocolat fondu. Pour dissimuler sa maladresse, il mélangea le tout, mais son patron avait l’œil vif, il s’aperçut rapidement de la supercherie et, après avoir qualifié son apprenti de ganache, goûta, curieux, le mélange. Il fut conquis et appela malicieusement cette découverte : ganache."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63b25b6-bfbc-3745-85dd-93ed50a0aa30",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Vieillard stupide et crédule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2611d054-9ba3-4c22-adbe-7400aec1379f",
                                                "sense_id": "f63b25b6-bfbc-3745-85dd-93ed50a0aa30",
                                                "text": "L’Héritier est en train de se faire un nom : il tâtonne et cherche à se caser ; je crois qu’il ne fera pas mal de se jeter dans les ganaches prématurées."
                                            },
                                            {
                                                "example_id": "2dc2585a-89d7-4969-9f0e-5be29aa91674",
                                                "sense_id": "f63b25b6-bfbc-3745-85dd-93ed50a0aa30",
                                                "text": "— Je connais Janet qui joue les ganaches au théâtre. J’ai voulu être acteur et faire les ganaches aussi… Voilà comment l’idée m’est venue. Je n’ai même pas fait exprès au commencement, je t’assure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "268f3354-c5a2-3358-9219-1b12c456677a",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Fauteuil capitonné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "792ca73f-056c-4449-b0bb-8d838ca53a7d",
                                                "sense_id": "268f3354-c5a2-3358-9219-1b12c456677a",
                                                "text": "Edgard (à part) : – Eh bien, la voilà qui s’installe dans la ganache à maman !"
                                            },
                                            {
                                                "example_id": "054b83b1-7ea9-4acc-a40b-3f6dac58141b",
                                                "sense_id": "268f3354-c5a2-3358-9219-1b12c456677a",
                                                "text": "Frankland mit la lettre dans sa poche, alluma un cigare et s'étendit dans une ganache, le véritable siége pour rêver ou dormir.",
                                                "translation": "Revue Britannique, mars 1875"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c1bc0b7-2371-3ed6-a1f8-4e6f66403989",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Cachexie dont un des symptômes est un gonflement sous la mandibule."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "831d10a8-cb3a-3891-b3ea-e8cc259911cd",
                                        "entry_id": "6f584e60-e43a-3131-a739-078c0ade40c8",
                                        "glosses": [
                                            "Boisson faite avec de l'arquebuse et de l'eau de noix."
                                        ],
                                        "tags": [
                                            "Lyonnais"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d97e8b3-6090-4ae0-a43b-d5e5c6094a61",
                                                "sense_id": "831d10a8-cb3a-3891-b3ea-e8cc259911cd",
                                                "text": "À Paris, pas à Lyon, sans ça nous l'aurons invité à boire une ganache au bar d'à côté ; nous lui aurions parlé des canailleries commises par lui après le 18 mars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
