                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "015fc890-ce37-4030-ac64-8ea8f5263c6f",
                                "sense_id": "c79e9a29-14fa-3699-9e95-43533cc1cbd4",
                                "text": "Im Französischen wird der Gravis auch zur Unterscheidung von Homophonen genutzt, z. B. bei « la » und « là »."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
