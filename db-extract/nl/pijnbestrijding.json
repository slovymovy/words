                                "example_id": "4eb2db24-18f7-4c82-bf61-714253afdd37",
                                "sense_id": "573c3ad7-7381-3c3f-8951-d458182df303",
                                "text": "De pijn van gordelroos is soms met goede pijnbestrijding te verminderen, maar vaak ook niet."
                            },
