                    }
                ],
                "senses": [
                    {
                        "sense_id": "93a080f2-d1ff-36e1-882a-e2bf7a4d6b7d",
                        "entry_id": "5ce4f7ff-90e5-3813-ba86-00d508ab1d94",
                        "glosses": [
                            "разрушить потоком воды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3683bd31-eb33-4883-9e37-cd9552f5f076",
                                "sense_id": "93a080f2-d1ff-36e1-882a-e2bf7a4d6b7d",
                                "text": "Вода размыла насыпь и бурно клокотала в проране."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb5353a0-ac73-4f03-bc02-2d1e22f0317b",
                        "source_entry_id": "5ce4f7ff-90e5-3813-ba86-00d508ab1d94",
                        "source_sense_id": "93a080f2-d1ff-36e1-882a-e2bf7a4d6b7d",
                        "target_lang_word": "éroder",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éroder",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "514eed5c-c03b-352a-a350-41d5d51270b0",
                                        "entry_id": "bb2488fa-696f-312c-8e53-4bd4a0e42015",
                                        "glosses": [
                                            "Ronger. Détruire ou défaire très progressivement."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5612d8f-2142-44f9-aae3-119859368974",
                                                "sense_id": "514eed5c-c03b-352a-a350-41d5d51270b0",
                                                "text": "L’eau érode le lit des rivières."
                                            },
                                            {
                                                "example_id": "1a4db68e-c668-4eef-baf8-ea961c2aa704",
                                                "sense_id": "514eed5c-c03b-352a-a350-41d5d51270b0",
                                                "text": "[Je me suis installé] dans un fauteuil que j’avais chéri autrefois et pratiquement érodé à mes formes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c969367-d632-4855-a7bb-d116c0412059",
                        "source_entry_id": "5ce4f7ff-90e5-3813-ba86-00d508ab1d94",
                        "source_sense_id": "93a080f2-d1ff-36e1-882a-e2bf7a4d6b7d",
                        "target_lang_word": "raviner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raviner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "502237f3-10e5-3f79-ad27-6b60382e4d54",
                                        "entry_id": "1ac2ad5f-a862-336d-9197-539b6490590d",
                                        "glosses": [
                                            "Creuser de sillons profonds, des ravines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b1de212-d808-4d42-bb69-593513f3affa",
                                                "sense_id": "502237f3-10e5-3f79-ad27-6b60382e4d54",
                                                "text": "Sur les pentes de quelques monticules, le sol fut absolument raviné et la croûte blanche mise à nu."
                                            },
                                            {
                                                "example_id": "5d285a29-0999-47a7-89b7-1a9775a5694e",
                                                "sense_id": "502237f3-10e5-3f79-ad27-6b60382e4d54",
                                                "text": "Au fond de la place, la butte se dresse ravinée, couverte d’une herbe lépreuse, fanée comme du velours râpé, jaunâtre ou plutôt incolore."
                                            },
                                            {
                                                "example_id": "d2d92075-78f9-45b0-9937-d337ea8561c2",
                                                "sense_id": "502237f3-10e5-3f79-ad27-6b60382e4d54",
                                                "text": "Octobre fut d’abord splendide, un automne ardent, une chaude passion d’été dans une maturité large, sans un nuage au ciel ; puis, le temps se gâta, des vents terribles soufflèrent, un dernier orage ravina les pentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "babdac5f-4c5a-30bf-9a0a-3dc72db4e6b9",
                                        "entry_id": "1ac2ad5f-a862-336d-9197-539b6490590d",
                                        "glosses": [
                                            "Causer des rides."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9614ec27-efe5-405b-97f4-8fa38bb57beb",
                                                "sense_id": "babdac5f-4c5a-30bf-9a0a-3dc72db4e6b9",
                                                "text": "Les larmes avaient surtout raviné la figure d’Hubert. Il avait cette expression laide et touchante de quand il était enfant, à l’époque où Isa, le prenant sur ses genoux, lui disait : « Mais c’est un vrai chagrin qu’il a, mon petit garçon… »"
                                            },
                                            {
                                                "example_id": "ad69e6c9-30a3-4de1-8d11-be644de1ab02",
                                                "sense_id": "babdac5f-4c5a-30bf-9a0a-3dc72db4e6b9",
                                                "text": "La mer m’avait raviné le visage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e2d0e9c-a551-4e0b-b15c-055aaab68b76",
                        "source_entry_id": "5ce4f7ff-90e5-3813-ba86-00d508ab1d94",
                        "source_sense_id": "93a080f2-d1ff-36e1-882a-e2bf7a4d6b7d",
                        "target_lang_word": "détremper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détremper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                        "entry_id": "e6091826-ce64-3707-9eb1-8945e56c6632",
                                        "glosses": [
                                            "Délayer ou plonger un solide dans un liquide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa7131d-e91c-4fd7-8099-f8c525819821",
                                                "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                                "text": "Détremper de la farine avec des œufs et du lait."
                                            },
                                            {
                                                "example_id": "18576c26-d92f-47a9-be55-ca7348e08544",
                                                "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                                "text": "Au Moyen-Âge, on détrempait du vermillon avec de la glaire battue pour obtenir un pigment rouge vif."
                                            },
                                            {
                                                "example_id": "49fb6794-1b2c-4286-bfa4-95d65da8273c",
                                                "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                                "text": "Ces fruits trop mûrs détremperont la pâte de ta tarte."
                                            },
                                            {
                                                "example_id": "b15634d8-769f-4259-b393-2746ee8e92a8",
                                                "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                                "text": "Pour réchampir les moulures, on broie les couleurs à l'huile de noix et on détrempe à l'essence; on applique deux couches généralement plus foncées que le fond."
                                            },
                                            {
                                                "example_id": "b4d92fb4-de9b-4a23-bb42-090491ae8d74",
                                                "sense_id": "c7c56178-d823-31b6-9e98-2ac4aa77ce59",
                                                "text": "En conséquence, ces malheureux firent l’acquisition d’une corde neuve, une belle corde de cinquante mètres, parfaitement anodine en apparence. Dans le feu des préparatifs, ils omirent en outre de la détremper préalablement pour la débarrasser de son empois et l’emportèrent telle quelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "détremper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0fc3ef40-51b9-3fdf-b00f-51bb4ca41a43",
                                        "entry_id": "dc9f6741-abc4-3666-abc3-b10701cca05f",
                                        "glosses": [
                                            "Débarrasser un métal de la trempe, en le faisant rougir au feu et en le laissant refroidir peu à peu."
                                        ],
                                        "tags": [],
                                        "examples": [
