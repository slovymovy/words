                "senses": [
                    {
                        "sense_id": "e16cbe22-61e5-3e20-819f-299b7268b6c7",
                        "entry_id": "0c57d3f8-6a8b-3502-91fe-d9637417e613",
                        "glosses": [
                            "хим. то же, что диоксид"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fb791e5-3e50-4216-bf69-3e9e5465df8b",
                                "sense_id": "e16cbe22-61e5-3e20-819f-299b7268b6c7",
                                "text": "При этом при строгом подборе состава газовой атмосферы исключаются вредные газы, окись азота и двуокись серы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1c721064-eaf1-4858-b163-b365274fd0e8",
                        "source_entry_id": "0c57d3f8-6a8b-3502-91fe-d9637417e613",
                        "source_sense_id": "e16cbe22-61e5-3e20-819f-299b7268b6c7",
                        "target_lang_word": "dioxide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dioxide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                        "entry_id": "38e3df1b-8060-3b47-94f8-144ff121d1f2",
                                        "glosses": [
                                            "Any oxide containing two oxygen atoms in each molecule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82da96e-b26e-457d-8b15-e8295ea156f0",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Discoid lesions and minor subacute involvement may be controlled by freezing with carbon dioxide or a course of atabrine."
                                            },
                                            {
                                                "example_id": "7800605a-f637-4cdc-907f-df2502702f49",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Kruban is a tidally-locked Venusian hothouse, its surface perpetually obscured by clouds of sulfur and carbon dioxides."
                                            },
                                            {
                                                "example_id": "38bcf9de-e8e4-4361-b878-96d427f17450",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    }
                                ]
                            }
