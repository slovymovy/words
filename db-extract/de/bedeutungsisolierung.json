                "senses": [
                    {
                        "sense_id": "86eaf785-2749-3685-bc27-e2df0c2e47c5",
                        "entry_id": "84fc5485-629a-3e14-bb50-fe01bf08c2c9",
                        "glosses": [
                            "Prozess und Ergebnis von Bedeutungswandel, die dazu führen, dass die Bedeutung eines Wortes nicht mehr aus der Bedeutung seiner Bestandteile (Konstituenten) erschlossen werden kann."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515b312f-9578-4863-93e8-a29a17a5bccd",
                                "sense_id": "86eaf785-2749-3685-bc27-e2df0c2e47c5",
                                "text": "Ein Wort wie Salbader (Schwätzer) weist einen hohen Grad von Bedeutungsisolierung auf: aus den Konstituenten „Sal“ und „Bader“ lässt sich die Bedeutung des Wortes nicht herleiten."
                            },
                            {
                                "example_id": "e10c806a-8546-485f-ac32-1bbeaa5cc80a",
                                "sense_id": "86eaf785-2749-3685-bc27-e2df0c2e47c5",
                                "text": "Viele Wörter weisen eine mit der Zeit zunehmende Bedeutungsisolierung auf."
                            },
                            {
                                "example_id": "717109e0-37de-4b6a-b6f1-c977577c8072",
                                "sense_id": "86eaf785-2749-3685-bc27-e2df0c2e47c5",
                                "text": "Der Begriff Bedeutungsisolierung weist darauf hin, dass Wörter, deren Bedeutung sich nicht aus der Bedeutung ihrer Bestandteile herleiten lässt, dadurch auch nicht mehr zu anderen Wörtern in Beziehung gesetzt werden können und daher isoliert erscheinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
