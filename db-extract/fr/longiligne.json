                                        "glosses": [
                                            "Slender and long of limb; lanky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21149822-804b-4095-8b92-837349ca6a01",
                                                "sense_id": "14005553-1164-34b5-b10d-6c8406aefca6",
                                                "text": "For an accountant, Robert had a rangy appearance."
                                            },
                                            {
                                                "example_id": "03bc6e75-2bed-4836-8623-d420ae925c6f",
                                                "sense_id": "14005553-1164-34b5-b10d-6c8406aefca6",
                                                "text": "Her African violets weren't getting enough sun and became rangy."
                                            },
                                            {
                                                "example_id": "8862da5c-9a7b-4f84-aa67-2f2de4db4f8c",
                                                "sense_id": "14005553-1164-34b5-b10d-6c8406aefca6",
                                                "text": "Janet Gwilherm, who was presently dwarfing the duty desk — she was tall and rangy, like a basketball player — whacked the intercom button and announced herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890a6d95-cee0-35ad-b8af-c4e4322ff346",
