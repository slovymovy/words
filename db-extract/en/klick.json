                "senses": [
                    {
                        "sense_id": "5f427f9a-4cc9-3ce7-9c94-c6dfb22e661c",
                        "entry_id": "3ee33fe1-137a-3a88-b853-082a01c56e3a",
                        "glosses": [
                            "A kilometer."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "eace45ad-2341-4d88-930d-551b41fd77e9",
                                "sense_id": "5f427f9a-4cc9-3ce7-9c94-c6dfb22e661c",
                                "text": "Several klicks closer, the ruins of the City of Poets rose jaggedly against the skyline."
                            },
                            {
                                "example_id": "94fdf913-5ffd-4db6-87f3-eb1abed37ebd",
                                "sense_id": "5f427f9a-4cc9-3ce7-9c94-c6dfb22e661c",
                                "text": "an asteroid between one and three kilometers wide had slammed into the ground at fifteen klicks per second."
                            },
                            {
                                "example_id": "f290bd54-c070-4c50-952f-a8c9225fff85",
                                "sense_id": "5f427f9a-4cc9-3ce7-9c94-c6dfb22e661c",
                                "text": "Chief, can you hear me?...(static) My bird's down. Half a klick -(static)- downriver from your position."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2dd99bc-2026-3dfd-8dbe-2b799434ae77",
                        "entry_id": "3ee33fe1-137a-3a88-b853-082a01c56e3a",
                        "glosses": [
                            "Kilometres per hour."
                        ],
