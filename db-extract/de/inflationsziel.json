                "senses": [
                    {
                        "sense_id": "99eeaffc-a868-310a-ba8f-6a2d3f45b006",
                        "entry_id": "c68f53c0-b3b7-3cbe-8097-3e580b2a4136",
                        "glosses": [
                            "Wert für die Inflationsrate, dessen Erreichung angestrebt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab385f3d-30b4-4c90-a097-0099a54e1e4a",
                                "sense_id": "99eeaffc-a868-310a-ba8f-6a2d3f45b006",
                                "text": "„Im Gegensatz zur EZB ist die … Fed nicht nur zur Sicherung der Preisstabilität verfpflichtet. Sie muss darüber hinaus auch das Wirtschaftswachstum und die Beschäftigung im Auge haben. Auf der Suche nach einer neuen Strategie entschied sich die Fed gegen ein direktes Inflationsziel, weil sie der Ansicht war, dieses Konzept lasse sich mit ihrem direkten Auftrag nicht vereinbaren.“"
                            },
                            {
                                "example_id": "8e754598-1f7c-448e-a8ba-c6337867e0ad",
                                "sense_id": "99eeaffc-a868-310a-ba8f-6a2d3f45b006",
                                "text": "„Bereits in den Jahren vor Corona haben Notenbanken ihre Bilanzen ausgeweitet und mehr Geld bereitgestellt, so auch die EZB, um ihr Inflationsziel zu erreichen.“"
                            },
                            {
                                "example_id": "80e2ac5c-8bfc-46dc-abab-518f045d39d0",
                                "sense_id": "99eeaffc-a868-310a-ba8f-6a2d3f45b006",
                                "text": "„Aber in welche Richtung dürfte dieses Inflationsziel verschoben werden, wenn Lagarde es jetzt in den Blick nehmen will?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
