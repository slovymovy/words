                    {
                        "sense_id": "b7763055-98e5-3e59-8716-118ef6f3e35e",
                        "entry_id": "5cdb39ba-238c-3a5e-9e7e-60aeea573078",
                        "glosses": [
                            "Projet d’acte du Parlement du Royaume-Uni ou de pays membres du Commonwealth (e.g. dans les assemblées législatives du Canada aux niveaux tant fédéral que provincial, en Australie, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867ba8bd-1dda-4799-8968-b67132ff9e64",
                                "sense_id": "b7763055-98e5-3e59-8716-118ef6f3e35e",
                                "text": "Tout au plus, lorsqu’un bill relatif à quelques une de ces matières est présenté au parlement, ceux qui sollicitent le bill, viennent-ils préalablement en conférer avec le ministre, et demander son appui."
                            },
                            {
                                "example_id": "e0a15b09-e37b-4a6e-ba48-e5af6261b6a8",
                                "sense_id": "b7763055-98e5-3e59-8716-118ef6f3e35e",
                                "text": "L’Angleterre, après de longues enquêtes, vient par le bill de 1834, d’abolir l’esclavage ; les avantages du travail libre ont été constatés à ses yeux."
                            }
                        ]
                    }
                ],
