                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                        "entry_id": "9de3d09e-b3eb-37ae-b320-c10dad79ed9e",
                                        "glosses": [
                                            "Gesamtumfang der Straftaten"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b7e54b-93ca-470c-9fb9-5a755078ae4a",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Auch organisatorisch rüsten die Rechtsextremen offenbar auf: Im Bereich der rechtsextrem motivierten Kriminalität sind laut Bundesinnenministerium seit 2001 elf Fälle von kriminellen Vereinigungen und acht Fälle von terroristischen Vereinigungen registriert.“"
                                            },
                                            {
                                                "example_id": "f198137b-389c-46e9-8435-d2d6539768cc",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Die Frage, wie die Kriminalität bei Frauen einzuschätzen sei, war im Dezember 1788 noch lange nicht beantwortet.“"
                                            },
                                            {
                                                "example_id": "c63c3373-6b9b-471c-bb4e-61c93c5dc3d5",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Noch am Bahnhof hatte er mich gefragt, ob es nicht gefährlich sei, nachts durch Berlin spazieren zu gehen, und wie es um die Kriminalität in der deutschen Hauptstadt bestellt sei.“"
                                            },
                                            {
                                                "example_id": "6824b96b-374f-4c5c-a486-517e8a89f6a4",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Die Kindersterblichkeit und die Kriminalität sind niedriger, der Lebensstandard ist höher.“"
                                            },
                                            {
                                                "example_id": "71df5750-faf5-4e7b-b0e6-e59a5cbdce41",
                                                "sense_id": "9ff1102e-0b53-3562-81ba-2625d309c562",
                                                "text": "„Seine millionenschweren Manipulationen werteten die Staatsanwälte in ihrem Plädoyer jedenfalls nicht als organisierte Kriminalität, sondern als dreistes Bubenstück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
