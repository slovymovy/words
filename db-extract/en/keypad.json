                                        "entry_id": "3da6e3a2-4850-35b9-9c07-06bc4970cb44",
                                        "glosses": [
                                            "Fläche, auf der mit Zeichen versehene Tasten platziert sind, mit denen Daten eingegeben oder Prozesse ausgelöst werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c93c630-e604-4eed-9014-3e03a0c5552a",
                                                "sense_id": "1f5f5eda-1b0b-3aa4-82bd-bbc3e8b7b2ff",
                                                "text": "„Sobald sie durch die Tür waren, drehte John sich um, schloss sie und tippte auf dem roten Tastenfeld, um sie zu verriegeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
