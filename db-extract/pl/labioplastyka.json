                    {
                        "sense_id": "6b83a05d-8156-373d-a3f5-17268db51965",
                        "entry_id": "7f818ad7-5fd9-3006-ba99-e184454d4d0c",
                        "glosses": [
                            "zabieg korekty wyglądu lub wielkości warg sromowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "337de73b-0a92-4d8f-b6b2-4da3f65630d4",
                                "sense_id": "6b83a05d-8156-373d-a3f5-17268db51965",
                                "text": "W Wielkiej Brytanii w 2008 roku liczba zabiegów labioplastyki (zmniejszenia warg sromowych) wzrosła o 70 punktów procentowych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "754f7b24-2359-436a-a3bc-5027e3efe401",
                        "source_entry_id": "7f818ad7-5fd9-3006-ba99-e184454d4d0c",
                        "source_sense_id": "6b83a05d-8156-373d-a3f5-17268db51965",
                        "target_lang_word": "labiaplasty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labiaplasty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "083521dd-7f89-346a-add0-732577ce0249",
                                        "entry_id": "2b2a39bb-a26b-32a6-b5ef-f5ea8fd4f519",
                                        "glosses": [
                                            "The moulding or shaping of the labia minora and/or labia majora."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27909b09-e6d8-4a5f-87c0-461cd2414155",
                                                "sense_id": "083521dd-7f89-346a-add0-732577ce0249",
                                                "text": "Many doctors performing labiaplasties were never taught vulvar anatomy—leaving some patients scarred and unable to feel sexual pleasure."
                                            },
                                            {
                                                "example_id": "d3a6ff44-aedb-47a6-a44e-2b15795c279e",
                                                "sense_id": "083521dd-7f89-346a-add0-732577ce0249",
                                                "text": "Labiaplasty—surgery for reshaping or resizing the inner labia—is the fastest growing type of plastic surgery in the world: in 2016, 45 per cent more labiaplasty procedures were carried out than in 2015, […]"
                                            },
                                            {
                                                "example_id": "409f92b5-32ba-4353-ad43-83eceb789a98",
                                                "sense_id": "083521dd-7f89-346a-add0-732577ce0249",
                                                "text": "When performed poorly, a labiaplasty — a procedure to reduce the size of the labia minora, and one of the fastest-growing cosmetic surgeries worldwide — can also damage nerves, leading to genital pain and loss of sexual sensation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
