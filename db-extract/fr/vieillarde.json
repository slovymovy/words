                        "form": "vieillard"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                        "entry_id": "ecd0b76f-a8a3-3a7c-8e08-772905fecf89",
                        "glosses": [
                            "Femme très âgée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fc6e64f-1f3a-4fe5-9f8d-d168952f6b1d",
                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                "text": "La mort brillait par son absence : décéder, ce n’était pas mourir, la métamorphose de cette vieillarde en dalle funéraire ne me déplaisait pas."
                            },
                            {
                                "example_id": "7d9ac1f9-24d3-4365-9d52-725d3a0c26b7",
                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                "text": "Au beau milieu de cette conversation, le berger revint accompagné d’une vieillarde qui n’avait pas perdu tous les attraits de sa jeunesse. La vieillarde nous salua et nous lui rendîmes le salut."
                            },
                            {
                                "example_id": "0b998cb6-fe22-41d3-b366-65b599caea9f",
                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                "text": "Sur une petite chaise roulante, un garçon de douze ans, beau comme un cœur ; derrière lui, sa mère, une jeune femme de trente-cinq ans, que l'épuisement avait changé en vieillarde avec des yeux d'enfant."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1565b34e-8730-493a-bd8f-30c9fe977556",
                        "source_entry_id": "ecd0b76f-a8a3-3a7c-8e08-772905fecf89",
                        "source_sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                        "target_lang_word": "Greisin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Greisin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                        "entry_id": "6dacb0bf-f15c-36e1-bb19-b0c0f9810d46",
                                        "glosses": [
                                            "sehr alte Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90dae83b-b58c-4946-a891-84efc9f57b35",
                                                "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                                "text": "Hermine und ich sahen uns erst 60 Jahre nach dem Abitur wieder, als wir schon Greisinnen waren."
                                            },
                                            {
                                                "example_id": "51a07b0c-9153-4fda-9498-94205364e1b5",
                                                "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                                "text": "„Die schöne Fahrt in der alten Droschke, auf die sich die Greisin so gefreut hatte, war ihr schon nach zehn Minuten zuviel.“"
                                            },
                                            {
                                                "example_id": "0e82527a-a8c8-4a40-834c-137fa734c828",
                                                "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                                "text": "„Wie eine Greisin sah sie aus, von Kopf bis Fuß uralt.“"
                                            },
                                            {
                                                "example_id": "97e7db29-f502-4d02-9739-b68a69f26695",
                                                "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                                "text": "„Serena, die Greisin, zeigte auf ein apokalyptisch schönes Panorama.“"
                                            },
                                            {
                                                "example_id": "5baaa264-1410-4df4-8f6b-20c0896c214e",
                                                "sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                                                "text": "„Warum Afonso gleich mit den ersten fetten Regentropfen Schutz suchte, wusste er nicht. Warum ausgerechnet bei den Greisinnen? Wusste er auch nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "412586a1-9f61-4be2-a54f-55546677cf4e",
                        "source_entry_id": "ecd0b76f-a8a3-3a7c-8e08-772905fecf89",
                        "source_sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
