                    {
                        "sense_id": "d64caf06-6dae-3538-8e6f-8bcae88bc4a2",
                        "entry_id": "416e3d00-3c84-3527-86c5-1fdb2be34783",
                        "glosses": [
                            "The quantity of a brew made in a single batch."
                        ],
                        "tags": [
