                    "frequency": "Middle",
                    "semantic_group_id": "precepte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les fidèles s'efforcent de respecter chaque <w>commandement</w> transmis par les textes sacrés."
                        },
                        {
                            "text": "Le prêtre a rappelé le premier <w>commandement</w> au cours de son sermon dominical."
                        }
                    ],
                    "synonyms": [
                        "précepte",
                        "loi",
                        "règle"
                    ],
                    "common_phrases": [
