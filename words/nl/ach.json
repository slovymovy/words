{
    "word_family": [],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "3651f503-5c98-36c1-8b30-456fd1527023",
                    "sense_definition": "Een uitroep die medelijden, verbazing of lichte ontzetting uitdrukt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w>, wat ontzettend jammer dat je niet naar het feestje kunt komen.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w>, what a great shame that you can't come to the party."
                            }
                        },
                        {
                            "text": "Heeft hij echt zijn been gebroken? <w>Ach</w> nee toch!",
                            "target_lang_translations": {
                                "en": "Did he really break his leg? <w>Oh</w> no!"
                            }
                        }
                    ],
                    "synonyms": [
                        "och",
                        "ach gossie"
                    ],
                    "common_phrases": [
                        "ach nee toch",
                        "ach wat zielig"
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation expressing pity, surprise, or slight dismay."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "general exclamation of surprise or pity"
                            },
                            {
                                "target_lang_word": "ah",
                                "target_lang_sense_clarification": "expression of sympathy or realization"
                            },
                            {
                                "target_lang_word": "poor thing",
                                "target_lang_sense_clarification": "used to express pity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "199a17bd-2b89-3ef5-9780-155d9b7c41e3",
                    "sense_definition": "Wordt gebruikt om aan te geven dat iets niet zo belangrijk of ernstig is.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relativering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w>, maak je geen zorgen over die kleine fout in de brief.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w>, don't worry about that small mistake in the letter."
                            }
                        },
                        {
                            "text": "<w>Ach</w> kom op, het is maar een spelletje en niet het einde van de wereld.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w> come on, it's only a game and not the end of the world."
                            }
                        }
                    ],
                    "synonyms": [
                        "vooruit",
                        "kom"
                    ],
                    "common_phrases": [
                        "ach kom op",
                        "ach laat maar"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate that something is not very important or serious."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "dismissive or reassuring tone"
                            },
                            {
                                "target_lang_word": "well",
                                "target_lang_sense_clarification": "used to introduce a relativizing statement"
                            },
                            {
                                "target_lang_word": "come on",
                                "target_lang_sense_clarification": "used to encourage someone not to worry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb7cde18-21b1-35c2-99db-fa1a358cb73d",
                    "sense_definition": "Een uitroep van irritatie of ongeduld.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irritatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ach</w>, hou toch eens op met dat constante geklaag over het weer.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w>, just stop that constant complaining about the weather."
                            }
                        },
                        {
                            "text": "<w>Ach</w> man, je weet helemaal niet waar je het over hebt.",
                            "target_lang_translations": {
                                "en": "<w>Oh</w> man, you have no idea what you're talking about."
                            }
                        }
                    ],
                    "synonyms": [
                        "bah",
                        "hè"
                    ],
                    "common_phrases": [
                        "ach hou op",
                        "ach man"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele, geërgerde context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation of irritation or impatience."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "oh",
                                "target_lang_sense_clarification": "sharp tone of annoyance"
                            },
                            {
                                "target_lang_word": "good grief",
                                "target_lang_sense_clarification": "expression of exasperation"
                            },
                            {
                                "target_lang_word": "for heaven's sake",
                                "target_lang_sense_clarification": "stronger expression of impatience"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}