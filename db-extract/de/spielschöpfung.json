                "senses": [
                    {
                        "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                        "entry_id": "6cd832e4-59b7-3f02-a712-3921240b88ee",
                        "glosses": [
                            "kreative Neugestaltung einer Spielform oder eines Spielgeschehens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36c28865-62e4-4757-88eb-65182c7f8bb4",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Die beiden kleinen Spielschöpfungen dieses Heftes beruhen auf Fabeln, die in vielen unserer Fibeln oder Grundschullesebüchern enthalten sind und schon deshalb gerne gespielt werden.“"
                            },
                            {
                                "example_id": "973af031-fc0e-4ce4-8d4e-5fecb1c097f0",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Es will keine Spielrezepte liefern, die man ohne viel eigenes Nachdenken ‚abspielen’ kann, wohl aber Impulse geben, wie man zu eigenen Spielschöpfungen und kreativen Veränderungen im Spiel kommen kann.“"
                            },
                            {
                                "example_id": "b0a0dd8a-d49e-4789-9c53-0e8873278990",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Dann lag es vor ihnen, das Meistwerk der Spielschöpfung – der Ball.“"
                            },
                            {
                                "example_id": "d9c161fa-1ccc-468d-a68c-7f0fdb5da602",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Bei den Kleinen sind die Wort- und Spielschöpfungen des gebürtigen Ostberliners beliebt.“"
                            },
                            {
                                "example_id": "8fbcc7e3-9318-494c-a761-1661c1241803",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Unterhaltet mich, ihr Götter der Spielschöpfung.“"
                            },
                            {
                                "example_id": "9b5912c8-921f-4135-ade0-a4c1c9a4ec83",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„[…] darüber hinaus erhalten die Spieldichtungen Wiemers ihren besonderen Wert, weil er immer neue Spielformen findet, in die er seine Gedanken hineingießt. Das erkenne man aus seinen Spielschöpfungen. Die Brote von Stein, Der Stern der Weisen, Der Kalendermann, der ewig jungen Zauberziehharmonika und dem hier vorliegenden Krippenspiel mit den vier Boten.“"
                            },
                            {
                                "example_id": "cad5cbf9-ca20-46d0-b64b-6dc96cf9ac3f",
                                "sense_id": "9f77c72f-5154-3969-99a1-b700980a8f30",
                                "text": "„Die Grafiken zeigen sowohl tradierte Spiele als auch neue Spielschöpfungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
