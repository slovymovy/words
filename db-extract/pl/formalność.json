                "senses": [
                    {
                        "sense_id": "dab5e80f-81f9-36b3-8914-07c1f20c555e",
                        "entry_id": "eac54741-3545-33cd-b88f-aabf4e553d8a",
                        "glosses": [
                            "czynność wykonywana według przepisów, urzędowo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683b94d4-9b35-45ba-a081-d9771279580b",
                                "sense_id": "dab5e80f-81f9-36b3-8914-07c1f20c555e",
                                "text": "Załatwiłem wszystkie formalności związane z rejestracją samochodu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "63d31dc2-a9e3-3ad9-9e77-bc5bb17cff50",
                        "entry_id": "eac54741-3545-33cd-b88f-aabf4e553d8a",
                        "glosses": [
                            "czynność konieczna, ale nieistotna albo bardzo prosta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b68313c-05dc-4801-b05a-8925f5d1ee4e",
                                "sense_id": "63d31dc2-a9e3-3ad9-9e77-bc5bb17cff50",
                                "text": "Egzamin na prawo jazdy był dla mnie czystą formalnością."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9286fe9f-7652-4416-8883-ea62bf7036ca",
                        "source_entry_id": "eac54741-3545-33cd-b88f-aabf4e553d8a",
                        "source_sense_id": "dab5e80f-81f9-36b3-8914-07c1f20c555e",
                        "target_lang_word": "formality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "formality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "The state of being formal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "038fe986-feac-4e68-9584-77fbf87a458a",
                                                "sense_id": "29f91ae9-7056-31cc-b130-e0d75e7a356c",
                                                "text": "[S]uch an one […] recalls as a vision of Paradise the land he has learnt to love; he exaggerates the insalubrity of a northern climate; he bewails the wretched formality of our civilised life, and so, back to the distant solitudes flies his recollection like a dove to the wilderness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbfd038-34fb-38c7-9e39-797513f6149f",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "Something said or done as a matter of form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "A customary ritual without substance, real consequence, or unique meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ab4b6f-fc87-433f-aa5e-8152d71c368d",
                                                "sense_id": "a09a9cc8-d6f9-3fd4-9a42-ecccac545f40",
                                                "text": "The examination for priesthood is no mere formality, so we have to study well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1089fb1-342b-3d23-ba7d-2ec7c94aadbf",
                                        "entry_id": "c4ffd979-d3b7-391f-9109-eba3185f13c0",
                                        "glosses": [
                                            "A specific requirement for obtaining a legal status, conducting a transaction, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "383ee51e-a0f0-4b7b-9693-f6a8e2516f93",
                        "source_entry_id": "eac54741-3545-33cd-b88f-aabf4e553d8a",
                        "source_sense_id": "dab5e80f-81f9-36b3-8914-07c1f20c555e",
                        "target_lang_word": "формальность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "формальность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9cae34cc-d0c8-318b-b028-eede2fdba655",
                                        "entry_id": "23e180e6-e17e-3c55-899a-23dbb2415e70",
                                        "glosses": [
                                            "свойство по значению прилагательного формальный; склонность к соблюдению внешней стороны дела в ущерб существенной его части, сути"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26352885-0e49-47be-8b45-c326f4e5133c",
                                                "sense_id": "9cae34cc-d0c8-318b-b028-eede2fdba655",
                                                "text": "Если учесть высокую стоимость, формальность и недифференцированность процесса, можно сделать вывод о том, что гражданское судопроизводство в целом является малодоступным и недостаточно эффективным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ab4eac0-c2f2-39e7-b1b2-d161f4adc8ef",
                                        "entry_id": "23e180e6-e17e-3c55-899a-23dbb2415e70",
                                        "glosses": [
                                            "действие или условие, установленное каким-либо правилом, законом и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a26010dd-8f43-4af2-a19f-bfad5cd39512",
                                                "sense_id": "9ab4eac0-c2f2-39e7-b1b2-d161f4adc8ef",
                                                "text": "Теперь уже я думаю, может, действительно свадьба — это формальность, особенно когда вслед за пышной свадьбой люди с годами отдаляются и нередко ещё «пышнее» разводятся."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
