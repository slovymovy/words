                ],
                "senses": [
                    {
                        "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                        "entry_id": "93e33a66-77f2-3a7b-91b6-5fd26f934f3c",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129118a7-4a26-4ecf-8c18-7341764835d2",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Keplers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "ac1b4998-e2e3-4f9b-a11f-1f6555224bda",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Frau Kepler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "16578d4b-1ded-465f-9479-cb85e8ccf8c8",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Herr Kepler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4be7ef79-d71c-4cc5-bfca-1f1f9e04c77e",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Die Keplers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "90b23ee2-82a4-4cd5-bd16-c444dd6d263d",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Der Kepler trägt nie die Schals, die die Kepler ihm strickt."
                            },
                            {
                                "example_id": "8eb8795f-9db2-4e6b-9a48-58ddc263262e",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kepler kommt, geht der Herr Kepler.“"
                            },
                            {
                                "example_id": "01953be0-781a-4c59-a6c9-7e0150e7d911",
                                "sense_id": "cb0a4ce7-dce7-3542-bd71-2c9f8f064af5",
                                "text": "Kepler kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
