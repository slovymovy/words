                "senses": [
                    {
                        "sense_id": "7de103a3-3e05-3629-a233-b40f54f4776e",
                        "entry_id": "d9fdfed7-2064-3672-aed3-cb4f0c9b3e49",
                        "glosses": [
                            "Auftraggeberin eines Anwalts oder eines Steuerberaters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b329984c-efae-4eb5-bfc0-ec07bd4a7c55",
                                "sense_id": "7de103a3-3e05-3629-a233-b40f54f4776e",
                                "text": "Meine Mandantin kann ein lückenloses Alibi für die Tatzeit vorweisen."
                            },
                            {
                                "example_id": "44146399-8de0-49f9-b24f-bd67c7740351",
                                "sense_id": "7de103a3-3e05-3629-a233-b40f54f4776e",
                                "text": "„Er dreht sich zu seiner Mandantin.“"
                            },
                            {
                                "example_id": "6cefc6a6-b130-4d39-ac16-af12268ed2a6",
                                "sense_id": "7de103a3-3e05-3629-a233-b40f54f4776e",
                                "text": "„Er redete etwas brüchig und nicht ohne Genugtuung, sich vor seiner Mandantin sonnen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
