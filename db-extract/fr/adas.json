                            {
                                "example_id": "34703ee6-c982-4a79-8a96-0ab8605012ae",
                                "sense_id": "69d0866e-c7fe-34b5-b269-73978c6fa14a",
                                "text": "les systèmes d’aide à la conduite (DCAS), qui constituent un sous-ensemble des systèmes avancés d’aide à la conduite (ADAS)."
                            },
