                        "examples": [
                            {
                                "example_id": "0c6b6cbf-488f-4e5e-8c71-e04e2a747617",
                                "sense_id": "5237166f-257a-308b-8fbf-53bb356e2952",
                                "text": "And Merlin answered, 'Overquick art thou / To catch a loathly plume fallen from the wing / Of that foul bird of rapine whose whole prey / Is man's good name: he never wronged his bride."
                            },
                            {
                                "example_id": "a9406238-9f0d-4ae3-8630-e0154d55f36c",
                                "sense_id": "5237166f-257a-308b-8fbf-53bb356e2952",
                                "text": "Then I slipped away and paid marked and honorific courtesy to Bederhof's wife and Bederhof's daughters, tall girls, not over-quick to be married, somehow quite inevitable if one considered Bederhof himself."
                            },
                            {
                                "example_id": "13a494e7-c39b-493d-be7e-d569c11b45a8",
                                "sense_id": "5237166f-257a-308b-8fbf-53bb356e2952",
                                "text": "It is really, as Johnson himself saw, an elliptical expression, and was due to an overquick wit, the sire of many an Irish bull."
                            }
                        ]
                    }
