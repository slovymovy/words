                "senses": [
                    {
                        "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                        "entry_id": "8dc12e36-5967-32d3-a069-75126ff1cb8e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02648f1b-2bb3-454b-8535-d5fc9b012f3b",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Frau Herzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1146b166-2151-4f82-90eb-b75e3ca88a4e",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Herr Herzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "811ef3db-9780-4451-badc-22c0f3c0d20d",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Die Herzles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "649d69b7-7b8b-4cd8-8f8b-f5328a2d88ec",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Der Herzle trägt nie die Pullover, die die Herzle ihm strickt."
                            },
                            {
                                "example_id": "8a5eee4d-81a7-4c78-9ca0-8967936cb79d",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herzle kommt, geht der Herr Herzle.“"
                            },
                            {
                                "example_id": "b9b9bd2a-ee42-4771-af94-3cb19f036c39",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Herzle kommt und geht."
                            },
                            {
                                "example_id": "9b8dc037-5c01-4fcb-861c-08f52ec0df8f",
                                "sense_id": "91269bc3-ad23-3215-a531-b58cee9d7db1",
                                "text": "Herzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
