                        "examples": [
                            {
                                "example_id": "c5bc2fca-639b-4c00-bd7b-98712a0a8127",
                                "sense_id": "d9956711-a72e-313d-bd45-fc3a039c04d6",
                                "text": "„Kim saß auf dem Sofa, die Knie bis zum Kinn hochgezogen, in der Hand die fünfte Tasse Lavendeltee.“"
                            },
                            {
                                "example_id": "c60db5bf-9b45-4c7b-9867-3f65ab8cd9a8",
                                "sense_id": "d9956711-a72e-313d-bd45-fc3a039c04d6",
                                "text": "„Ihre Mutter fühlte sich vorhin nicht gut, also hat Carolin sie am späten Nachmittag mit einer Tasse Lavendeltee zu Bett gebracht.“"
                            },
                            {
                                "example_id": "1c2c41b0-1ed6-44cc-bbc6-b6e81424944b",
                                "sense_id": "d9956711-a72e-313d-bd45-fc3a039c04d6",
                                "text": "„Mit einer großen Kanne Lavendeltee für alle kann man in der Erstversorgung nichts falsch machen.“"
                            },
                            {
                                "example_id": "60d79986-f4ec-4461-aa68-e2502ab3e404",
                                "sense_id": "d9956711-a72e-313d-bd45-fc3a039c04d6",
                                "text": "„Das schmale Zimmer war kaum größer als sein Büro, es roch nach Wachs und Lavendeltee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
