                        "form": "Abruzzaise"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b933ccd7-1e98-3bf0-913c-c1bf3fc0c74c",
                        "entry_id": "8efd0c14-43a1-3140-9849-1a82e783c82c",
                        "glosses": [
                            "Habitant ou originaire de la région italienne des Abruzzes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fd1a37-6f7e-461e-b3fe-d75cfcaa8c0b",
                                "sense_id": "b933ccd7-1e98-3bf0-913c-c1bf3fc0c74c",
                                "text": "Pour ma part, les Abruzzais ont été une découverte extraordinaire : à cette époque-là, ils gardaient encore un sens très fort de la tradition, dans tous ses aspects."
                            },
                            {
                                "example_id": "400b846a-6374-4220-98fb-3c6da16fd54a",
                                "sense_id": "b933ccd7-1e98-3bf0-913c-c1bf3fc0c74c",
                                "text": "Alors ils appelèrent un tireur d'élite, un Abruzzais capable d’éteindre les cigarettes des Autrichiens, quand il était en forme."
                            }
                        ]
                    }
                ],
