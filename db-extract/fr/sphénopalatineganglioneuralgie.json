                ],
                "senses": [
                    {
                        "sense_id": "a5842383-4ef7-36a7-9682-aead3cd37c7d",
                        "entry_id": "402564fb-15e7-3551-81c2-6e75b7b8b2d4",
                        "glosses": [
                            "Douleur aiguë et spontanée localisée dans les nerfs du ganglion ptérygopalatin (ou sphénopalatin), provoquée par l'ingestion d'un aliment froid, comme de la glace ou de l'eau fraîche."
                        ],
                        "tags": [
                            "Par plaisanterie"
                        ],
                        "examples": [
                            {
                                "example_id": "bc084de6-bdfd-4b96-8cfa-9f5942cfe305",
                                "sense_id": "a5842383-4ef7-36a7-9682-aead3cd37c7d",
                                "text": "Romo précise que ce phénomène est communément appelé gel cérébral (en anglais), bien que son nom technique soit sphénopalatineganglioneuralgie."
                            },
                            {
                                "example_id": "cb8035a3-c0ac-44c4-b876-73a84d624c2d",
                                "sense_id": "a5842383-4ef7-36a7-9682-aead3cd37c7d",
                                "text": "Sphénopalatineganglioneuralgie: nom scientifique du fait de manger quelque chose trop froid trop vite, et d'avoir mal à la tête après."
                            }
                        ]
                    }
                ],
                "translations": [
