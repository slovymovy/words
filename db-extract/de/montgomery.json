                "senses": [
                    {
                        "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                        "entry_id": "2cd9635e-0747-3741-82b5-82a3fa42f2c6",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a82a441-c070-4406-93f1-7b7d2bca904f",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Frau Montgomery ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e4bddb1a-f0e3-4ba1-8a0b-5c03720e9246",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Herr Montgomery wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "56999afd-6d5f-4d75-8839-2bd37ab8ba07",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Die Montgomerys fliegen heute nach Sri Lanka."
                            },
                            {
                                "example_id": "407e6f8f-63dc-4028-81e2-811221d17719",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Der Montgomery trägt nie die Pullover, die die Montgomery ihm strickt."
                            },
                            {
                                "example_id": "4cd06c4b-c3a8-4e55-8898-29d0b371ccd2",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Montgomery kommt, geht der Herr Montgomery.“"
                            },
                            {
                                "example_id": "c5ad293c-5ed9-4c7c-83ad-a10b23208f90",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Montgomery kommt und geht."
                            },
                            {
                                "example_id": "6e1ca313-7e28-4a5f-b3fd-e5cdbf5c897a",
                                "sense_id": "a2e8e012-041d-3079-a0fb-c0f5fdbfd46f",
                                "text": "Montgomerys kamen, sahen und siegten."
                            }
                        ],
