                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab386801-157c-4e22-b0e4-27f1b86179d6",
                                "sense_id": "0e9683da-bd78-37ed-8c05-61bbac7b9efe",
                                "text": "Onder meer de bond van autoproducenten, de bekende ondernemer Richard Branson van Virgin en drankenproducent Diageo willen dat Groot-Brittannië in de EU blijft."
                            },
                            {
                                "example_id": "7703ee98-9cc2-41bd-ad13-c3144a6abbcd",
                                "sense_id": "0e9683da-bd78-37ed-8c05-61bbac7b9efe",
                                "text": "De drankenproducent maakt dus een doorstart. De productie- en bottelactiviteiten worden gekocht door drankenproducent Avandis, een samenwerkingsverband van drie drankenbedrijven."
                            },
                            {
                                "example_id": "854f0529-5fad-4d79-b6db-86253ef368d5",
                                "sense_id": "0e9683da-bd78-37ed-8c05-61bbac7b9efe",
                                "text": "De maker van onder meer Wicky-drinks gaat nieuwe aandelen uitgeven, naast de verkoop van aandelen van de huidige eigenaren. Dat zijn de IJslandse investeringsmaatschappij 3i en de Britse eigenaar van drankenproducent Gerber. De beursgang is binnenkort, maar afhankelijk van de marktomstandigheden, zegt het bedrijf."
                            }
                        ]
