                ],
                "senses": [
                    {
                        "sense_id": "e1963160-0316-3c0b-9b53-5048edac6d7e",
                        "entry_id": "1a800d58-ae92-324c-945e-36ea9d2c4a65",
                        "glosses": [
                            "Réaliser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bc910b9-2581-4a65-8d8d-05233daca05d",
                                "sense_id": "e1963160-0316-3c0b-9b53-5048edac6d7e",
                                "text": "En d’autres termes, de même que le comédien Henri Tisot invente dans les années 1960 l’autocirculation, la monnaie et le crédit américains autoréalisent leur évolution, s'autointermédient et s’autorégulent avec les grandes banques centrales d’Europe et d'Asie comme prêteurs en dernier ressort et comme stabilisateurs automatiques, phénomène observé en 2007-2008."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc25eb23-e2d7-3440-90ee-495fe2f55ad4",
                        "entry_id": "1a800d58-ae92-324c-945e-36ea9d2c4a65",
                        "glosses": [
                            "Se produire parce que ça a été prédit."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "8516ed99-411d-486e-b346-be45e976d625",
                                "sense_id": "bc25eb23-e2d7-3440-90ee-495fe2f55ad4",
                                "text": "Il s'agit d'un état où toutes les croyances s'autoréalisent."
                            },
                            {
                                "example_id": "d4a28e7e-20da-4aaa-9009-6ef3b71c0a68",
                                "sense_id": "bc25eb23-e2d7-3440-90ee-495fe2f55ad4",
                                "text": "Il arrive néanmoins que ces croyances en matière de genre s'autoréalisent."
                            }
                        ]
                    }
                ],
