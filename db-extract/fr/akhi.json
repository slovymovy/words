                                    },
                                    {
                                        "sense_id": "ce0c56a4-c35f-34ff-9f06-52471417b92a",
                                        "entry_id": "3f96adf9-b0ed-394b-af4d-de44e628e2c7",
                                        "glosses": [
                                            "Someone, usually male, who aggressively evangelizes a person, concept or technology."
