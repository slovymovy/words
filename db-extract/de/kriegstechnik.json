                "senses": [
                    {
                        "sense_id": "9409c97f-0017-3ed4-b1ee-d37bebe60df8",
                        "entry_id": "5e2da195-5740-3d96-8f32-a878d8af4e43",
                        "glosses": [
                            "technisches Gerät, das im Krieg eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "939c09fa-4dea-458d-9cfa-d4a7f4525c94",
                                "sense_id": "9409c97f-0017-3ed4-b1ee-d37bebe60df8",
                                "text": "„Auch militärische Reformen soll Oba Ewedo durchgeführt haben: eine Verbesserung der Waffen und der Kriegstechnik; neue Pfeile und Schwerter seien eingeführt worden, ebenso habe man Pferde eingesetzt.“"
                            },
                            {
                                "example_id": "2b80b9dd-70e5-4a3d-8cf5-34f02a4836c9",
                                "sense_id": "9409c97f-0017-3ed4-b1ee-d37bebe60df8",
                                "text": "„Und doch blieb die Verwaltungskunst selten im Schritt mit der Kriegstechnik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d4684698-d845-32b5-b43f-4c3aefb503c3",
                        "entry_id": "5e2da195-5740-3d96-8f32-a878d8af4e43",
                        "glosses": [
                            "militärische Fertigkeit, über die jemand verfügt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96ce4757-c40e-4a66-bbcf-cbf1af9cf525",
                                "sense_id": "d4684698-d845-32b5-b43f-4c3aefb503c3",
                                "text": "„Ihr Herrschaftsstil und ihre Kriegstechnik ließen sich von vielen regionalen Herrschern später nachahmen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
