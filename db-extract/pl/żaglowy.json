                    },
                    {
                        "translation_id": "3b293619-64c6-4371-9ca9-e9c0e049a106",
                        "source_entry_id": "6cc01aeb-c056-3c48-a100-98e8e9b2cd0c",
                        "source_sense_id": "7ee32015-8d0a-3a07-8f31-72c8fd27918b",
                        "target_lang_word": "Segel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Segel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                        "entry_id": "bdf3cf54-be26-3bb6-bdb1-c16111ddf117",
                                        "glosses": [
                                            "Stück Stoff zur Nutzung des Windes für die Fortbewegung von Schiffen, Fluggeräten und Fahrzeugen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ad1c8a4-c388-4e3a-bb70-c5f9ce3b1aeb",
                                                "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                                "text": "Mit Segeln werden Segelboote angetrieben."
                                            },
                                            {
                                                "example_id": "c93b8dc5-3cee-4163-904f-fc0c2fc6dc9f",
                                                "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                                "text": "„Die Matrosen holten das Hauptmarssegel und das Großsegel ein, sodass nur noch die Segel des Fockmastes die Diligent vorantrieben.“"
                                            },
                                            {
                                                "example_id": "134104eb-118d-4042-a5bc-e748a0b3f93b",
                                                "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                                "text": "„Unsere Segel waren bereits angeschlagen, als am Kai der Konsignator, gefolgt von einem anderen Kaufmann, erschien, der wiederum in Begleitung eines Jünglings war, welcher anscheinend ebenfalls aufs Schiff kommen wollte.“"
                                            },
                                            {
                                                "example_id": "255b08a4-1377-42c0-8b4b-5d39ed851ab4",
                                                "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                                "text": "„Der Gleitschirmflieger benötigt Geschicklichkeit für das Aufziehen seines Segels, Sensibilität für das Schirmverhalten im Fluge und die Auf- und Abwindströmungen.“"
                                            },
                                            {
                                                "example_id": "0545fc3f-4978-489a-94a5-ee1bb894eb21",
                                                "sense_id": "c3e35398-c58c-3959-9cc6-e61debbb762f",
                                                "text": "„Mit vollen Segeln hielt das Boot auf das Granithaus zu und blieb dabei immer 1 sm von der Küste entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
