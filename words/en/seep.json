                            {
                                "target_lang_word": "sızmak",
                                "target_lang_sense_clarification": "düşünce veya duygunun yavaşça yer etmesi"
                            },
                            {
                                "target_lang_word": "işlemek",
                                "target_lang_sense_clarification": "içine yerleşmek, nüfuz etmek"
                            },
                            {
                                "target_lang_word": "nüfuz etmek",
                                "target_lang_sense_clarification": "iç kısımlara kadar yayılmak"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "постепенно распространяться (о слухах, чувствах)"
                            },
                            {
                                "target_lang_word": "проникать",
                                "target_lang_sense_clarification": "входить в сознание или среду"
