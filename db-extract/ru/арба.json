                ],
                "senses": [
                    {
                        "sense_id": "519b9f9d-18c3-33fe-9f61-c96ffa118d35",
                        "entry_id": "e6e36dca-8436-3064-b724-f7f5cb8ef00c",
                        "glosses": [
                            "araba (a horse- or bullock-drawn cart with two large wheels)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df44bb3f-ebcd-483c-a1ba-567be21bb9a3",
                                "sense_id": "519b9f9d-18c3-33fe-9f61-c96ffa118d35",
                                "text": "В доро́гу ше́ствие гото́во, / И тро́нулась арба́. За ней / Адехи сле́дуют суро́во, / Смиря́я молча пыл коне́й...",
                                "translation": "On the road the procession is ready and the cart has set off. The Adyge men follow grimly after it, silently subduing the ardor of the horses...",
                                "english": "On the road the procession is ready and the cart has set off. The Adyge men follow grimly after it, silently subduing the ardor of the horses..."
                            },
                            {
                                "example_id": "1862024b-c75f-4bcc-94a1-2ce63545f2c5",
                                "sense_id": "519b9f9d-18c3-33fe-9f61-c96ffa118d35",
                                "text": "Пррава! — крича́л во всё го́рло Само́йленко, когда́ попада́лась навстре́чу арба́ и́ли абха́зец верхо́м на осле́.",
                                "translation": "\"Keep r-r-right!\" Samoilenko shouted at the top of his lungs whenever they met a native cart or an Abkhazian riding a donkey.",
                                "english": "\"Keep r-r-right!\" Samoilenko shouted at the top of his lungs whenever they met a native cart or an Abkhazian riding a donkey."
                            },
                            {
                                "example_id": "e13bbf2d-fb5c-423a-9613-d0a5ed502257",
                                "sense_id": "519b9f9d-18c3-33fe-9f61-c96ffa118d35",
                                "text": "[…] краси́во изгиба́ясь под тя́жестью хле́ба, она́ побежа́ла че́рез двор к гумну́, шмыгну́ла че́рез плете́нь и, окуну́вшись в о́блако золоти́стой поло́вы, скры́лась за а́рбами.",
                                "translation": "[…] swaying gracefully under the weight of the bread, she ran across the yard to the threshing-floor, darted over the hurdle, and, wrapt in a cloud of golden chaff, vanished behind the carts.",
                                "english": "[…] swaying gracefully under the weight of the bread, she ran across the yard to the threshing-floor, darted over the hurdle, and, wrapt in a cloud of golden chaff, vanished behind the carts."
                            }
                        ]
                    }
