                        "examples": [
                            {
                                "example_id": "1bd0231e-ee8e-413a-a6a3-bca8db34ef39",
                                "sense_id": "957bb459-8785-3b24-96bc-5e740e6e5d9a",
                                "text": "„Wir müssen das Geld, von dem ich ihnen erzählt habe, überweisen. Von dem Geheimkonto.“"
                            },
                            {
                                "example_id": "f64c03de-4022-41de-befa-b25b99d4e1be",
                                "sense_id": "957bb459-8785-3b24-96bc-5e740e6e5d9a",
                                "text": "„Immerhin war ihr Großvater der Undercover-Bankier, der für sie Gelder von A nach B transferierte und Geheimkonten unterhielt, ohne dass die falschen Leute davon Wind bekamen.“"
                            }
                        ],
