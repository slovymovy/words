                                "target_senses": [
                                    {
                                        "sense_id": "80d685a4-f4a7-35a1-a057-4f6c0765c78f",
                                        "entry_id": "c939525b-559e-322b-8623-04abe93b5377",
                                        "glosses": [
                                            "A piece of cloth used to cover the head; a bandana."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55c550b4-8e1a-47fd-9fce-3ec9ba0d0670",
                                                "sense_id": "80d685a4-f4a7-35a1-a057-4f6c0765c78f",
                                                "text": "And mamma in her kerchief, and I in my cap, / Had just settled down for a long winter's nap […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kerchief",
                                "target_lang_code": "en",
                                "target_senses": [
