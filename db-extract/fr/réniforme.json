                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146da8d0-38b8-420f-af7c-1658a7c617d4",
                                                "sense_id": "78c2fa56-6929-3e02-b7bb-f912d48861bc",
                                                "text": "Am Eingang stand eine tropische Pflanze mit nierenförmigen Blättern."
                                            },
                                            {
                                                "example_id": "67a1d39c-79b7-4976-aa98-b8213eef8d49",
                                                "sense_id": "78c2fa56-6929-3e02-b7bb-f912d48861bc",
                                                "text": "„Ich rechne damit, dass zehn Spieler zusammenkommen, und wir sitzen an einem nierenförmigen Tisch um den Bankhalter herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0842da5-0667-4d08-b5bf-3386cc15a744",
                        "source_entry_id": "f6f64c96-f0d5-306c-b3fc-cbf9185d2bfa",
