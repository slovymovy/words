                "senses": [
                    {
                        "sense_id": "f35fc3ad-c8df-32d6-a3cb-f62b1607f7ce",
                        "entry_id": "73974919-d065-3bfc-8465-4e5448b34b8f",
                        "glosses": [
                            "ein kleiner Muff oder eine Art Stulpen für Unterarme und Hände, die die Finger frei lassen (Pulswärmer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fbaffd-8a52-4433-a880-a250024a7920",
                                "sense_id": "f35fc3ad-c8df-32d6-a3cb-f62b1607f7ce",
                                "text": "„Sollen wir dir etwas mitbringen? Warte, – ich stricke dir ein paar Müffchen! Mit hübscher, bunter Wolle! Du sollst selbst sagen, wie du sie haben willst. Na, nun sag’ mir mal, wie sie sein sollen!“"
                            },
                            {
                                "example_id": "6251153c-4a78-47fa-932f-69affac61131",
                                "sense_id": "f35fc3ad-c8df-32d6-a3cb-f62b1607f7ce",
                                "text": "„Aber während sie Handschuhe und Müffchen aussuchte, bescherte mir das unabwendbare Schicksal etwas, das mich vier Jahre später in eine höchst beklagenswerte Lage brachte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
