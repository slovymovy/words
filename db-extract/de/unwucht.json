                "senses": [
                    {
                        "sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
                        "entry_id": "556a7d6a-0202-3d33-ab77-9896995a0fe5",
                        "glosses": [
                            "Abweichung vom Schwerpunkt während der Bewegung um sich selbst (Rotation); Verlagerung des Masseschwerpunktes weg vom Zentrum, wodurch ein ungleichmäßiges Laufen entsteht"
                        ],
                        "tags": [
                            "Mechanik"
                        ],
                        "examples": [
                            {
                                "example_id": "82dde444-66b7-4c17-866a-40498acb47e7",
                                "sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
                                "text": "Unwuchten sind nicht nur ein negativer Effekt, sie werden in der Technik auf vielen Gebieten auch bewusst genutzt."
                            },
                            {
                                "example_id": "0a843816-f000-418f-a981-0549e09a6a11",
                                "sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
                                "text": "Bei verschiedenen Drehzahlen macht sich die Unwucht verschieden bemerkbar."
                            },
                            {
                                "example_id": "138f4225-af49-44e6-97d2-536cca679fcb",
                                "sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
                                "text": "Jeder Rotor, auch einer aus einer Serienproduktion, hat eine, wenn auch kleine, Unwucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8a9856e-e58a-44dc-88cd-6489b98a3490",
                        "source_entry_id": "556a7d6a-0202-3d33-ab77-9896995a0fe5",
                        "source_sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
                        "target_lang_word": "unbalance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbalance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                        "entry_id": "ea31637d-6143-3efc-bd62-2a8d9ac39d6d",
                                        "glosses": [
                                            "To cause to be out of balance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "282853c9-012a-45ef-9df6-8c313e9eca86",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "If you put that weight on the edge of the tray, it will unbalance it and dump all of the dishes on the floor."
                                            },
                                            {
                                                "example_id": "5ee4be66-2f44-4b9c-bd6b-b28e75a3dff1",
                                                "sense_id": "60ea2cc6-393d-3d6c-a088-74d51e9e2b47",
                                                "text": "Or, finally, might our awful situation prey upon and unbalance our minds? A group of insane folk upon a dead world!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "082e12c4-e666-4712-889a-2082ca7092b1",
                        "source_entry_id": "556a7d6a-0202-3d33-ab77-9896995a0fe5",
                        "source_sense_id": "06e65aad-859f-34b6-af36-3d982ffc1cea",
