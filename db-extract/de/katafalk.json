                                "target_senses": [
                                    {
                                        "sense_id": "e847c862-2fc3-36ea-a9c5-9830b02e43a6",
                                        "entry_id": "aeaf354c-d7c7-318e-b48b-838795ccca21",
                                        "glosses": [
                                            "Estrado elevado y con frecuencia ricamente ornamentado sobre el cual se coloca el féretro en los funerales solemnes."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f250408-7d7a-4fd6-9b24-4312393e7102",
                                                "sense_id": "e847c862-2fc3-36ea-a9c5-9830b02e43a6",
                                                "text": "En ella, en fin, y colocadas las tres urnas en un suntuoso catafalco, iluminado con cien blandones, celebráronse las solemnes honras y oración fúnebre, concluyendo tan solemnísimo acto, a las cinco de la tarde con las descargas de fusilería y el incesante estampido del cañón."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "54b02ef1-4ac7-349b-b220-cf4b05cc7ba9",
                                        "entry_id": "aeaf354c-d7c7-318e-b48b-838795ccca21",
                                        "glosses": [
                                            "Figuradamente, cosa grande y aparatosa."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751fc6e9-20f8-431d-9236-a042fc8300ad",
                                                "sense_id": "54b02ef1-4ac7-349b-b220-cf4b05cc7ba9",
                                                "text": "Trabajar en placa supone todo un ceremonial. La cámara para sacar ese tipo de fotos es un catafalco enorme, viejo y una vez que ponés la placa ya no ves más nada a través de la lente."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
