                {
                    "sense_id": "39b0d030-9cdc-3a32-a2d5-2cc85594f4d2",
                    "sense_definition": "Difficult to explain or understand; strange or odd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "strange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The milk tastes <w>funny</w> so I think it has gone bad.",
                            "target_lang_translations": {
                                "ru": "У молока <w>странный</w> вкус, поэтому я думаю, что оно испортилось.",
                                "nl": "De melk smaakt <w>raar</w>, dus ik denk dat hij bedorven is.",
                                "pl": "Mleko smakuje <w>dziwnie</w>, więc myślę, że się zepsuło.",
                                "de": "Die Milch schmeckt <w>komisch</w>, also ich glaube, sie ist schlecht geworden.",
                                "fr": "Le lait a un goût <w>bizarre</w>, donc je pense qu'il a tourné.",
                                "it": "Il latte ha un sapore <w>strano</w>, quindi penso che sia andato a male.",
                                "cs": "To mléko chutná <w>divně</w>, takže si myslím, že se zkazilo.",
                                "tr": "Sütün <w>tuhaf</w> bir tadı var, bu yüzden bozulduğunu düşünüyorum.",
                                "es": "La leche sabe <w>raro</w>, así que creo que se ha echado a perder.",
                                "zh": "这牛奶味道<w>奇怪</w>，我想是变质了。"
                            }
                        },
                        {
                            "text": "I have a <w>funny</w> feeling that I forgot to lock the door.",
                            "target_lang_translations": {
                                "ru": "У меня <w>странное</w> предчувствие, что я забыл запереть дверь.",
                                "nl": "Ik heb een <w>vreemd</w> gevoel dat ik de deur ben vergeten op slot te doen.",
                                "pl": "Mam <w>dziwne</w> przeczucie, że zapomniałem zamknąć drzwi.",
                                "de": "Ich habe ein <w>seltsames</w> Gefühl, dass ich vergessen habe, die Tür abzuschließen.",
                                "fr": "J'ai l'impression <w>bizarre</w> d'avoir oublié de verrouiller la porte.",
                                "it": "Ho la <w>strana</w> sensazione di aver dimenticato di chiudere la porta a chiave.",
                                "cs": "Mám <w>zvláštní</w> pocit, že jsem zapomněl zamknout dveře.",
                                "tr": "İçimde kapıyı kilitlemeyi unuttuğuma dair <w>garip</w> bir his var.",
                                "es": "Tengo el <w>extraño</w> presentimiento de que olvidé cerrar la puerta con llave.",
                                "zh": "我有一种<w>奇怪</w>的预感，觉得自己忘了锁门。"
                            }
                        }
                    ],
