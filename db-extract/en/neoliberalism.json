                    {
                        "sense_id": "5f16bb48-ef51-3746-9bb2-f30cb389e0ca",
                        "entry_id": "ab5bb33e-cbae-3023-b08d-2f6077344f19",
                        "glosses": [
                            "新自由主義"
                        ],
                        "tags": [
                            "常貶義"
