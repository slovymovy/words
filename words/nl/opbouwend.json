                    "sense_id": "01700b3c-6ee4-32b6-95e3-5dfd45149d90",
                    "sense_definition": "met de bedoeling om iets of iemand te verbeteren of te helpen groeien; constructief",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "positieve invloed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar gaf altijd <w>opbouwende</w> kritiek op het ingeleverde werk van zijn studenten.",
                            "target_lang_translations": {
                                "ru": "Учитель всегда высказывал <w>конструктивную</w> критику по поводу сданных работ своих учеников."
                            }
                        },
                        {
                            "text": "Zij probeert tijdens de vergadering steeds een <w>opbouwende</w> bijdrage te leveren aan de discussie.",
                            "target_lang_translations": {
                                "ru": "Во время собрания она всегда старается вносить <w>конструктивный</w> вклад в дискуссию."
                            }
                        }
                    ],
                    "synonyms": [
                        "constructief",
                        "nuttig",
                        "leerzaam",
                        "welwillend"
                    ],
                    "antonyms": [
                        "afbrekend"
                    ],
                    "common_phrases": [
                        "opbouwende kritiek",
                        "opbouwende bijdrage"
                    ],
                    "target_lang_definitions": {
                        "ru": "направленный на улучшение, развитие или помощь; конструктивный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конструктивный",
                                "target_lang_sense_clarification": "о критике, вкладе или подходе"
                            },
                            {
                                "target_lang_word": "созидательный",
                                "target_lang_sense_clarification": "направленный на созидание и развитие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13e0dc03-8779-3b94-aa7c-baf6085600f6",
                    "sense_definition": "betrokken bij de organisatie, ontwikkeling of start van een aanval of proces",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "procesontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De coach koos bewust voor een <w>opbouwende</w> middenvelder om het spel te versnellen.",
