{
    "word_family": [
        "kakałko",
        "kakaowy",
        "kakaowiec"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13cb2b6d-cefb-3f42-9048-e813642f12cc",
                    "sense_definition": "Napój sporządzony z proszku kakaowego zalanego mlekiem lub wodą",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na śniadanie dzieci często piją ciepłe <kakao> z mlekiem.",
                            "target_lang_translations": {
                                "ru": "На завтрак дети часто пьют теплое <w>какао</w> с молоком.",
                                "zh": "孩子们早餐常喝热<w>可可</w>牛奶。"
                            }
                        },
                        {
                            "text": "W zimowe wieczory lubię przygotować sobie gorące <kakao>.",
                            "target_lang_translations": {
                                "ru": "Зимними вечерами я люблю готовить себе горячее <w>какао</w>.",
                                "zh": "冬天的晚上我喜欢给自己冲一杯热<w>可可</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gorące kakao",
                        "kubek kakao",
                        "pić kakao",
                        "kakao na mleku"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, приготовленный из порошка какао с молоком или водой",
                        "zh": "由可可粉加牛奶或水冲调而成的饮料"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какао",
                                "target_lang_sense_clarification": "напиток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可可",
                                "target_lang_sense_clarification": "可可饮料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c53e0222-fb59-32c6-b86c-93bb79086369",
                    "sense_definition": "Ciemny proszek z nasion kakaowca używany do wyrobów cukierniczych i napojów",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do upieczenia tego ciasta potrzebne jest gorzkie <kakao>.",
                            "target_lang_translations": {
                                "ru": "Для выпечки этого пирога нужно горькое <w>какао</w>.",
                                "zh": "烤这个蛋糕需要用到苦味<w>可可粉</w>。"
                            }
                        },
                        {
                            "text": "Posypała wierzch deseru cienką warstwą ciemnego <kakao>.",
                            "target_lang_translations": {
                                "ru": "Она посыпала верх десерта тонким слоем темного <w>какао</w>.",
                                "zh": "她在甜点表面撒了一层薄薄的深色<w>可可粉</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ciemne kakao",
                        "łyżeczka kakao",
                        "ciasto z kakao",
                        "naturalne kakao"
                    ],
                    "target_lang_definitions": {
                        "ru": "Темный порошок из семян какао, используемый для кондитерских изделий и напитков",
                        "zh": "用于制作甜点和饮料的深色可可豆粉末"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какао",
                                "target_lang_sense_clarification": "порошок"
                            },
                            {
                                "target_lang_word": "какао-порошок",
                                "target_lang_sense_clarification": "кулинарный ингредиент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可可粉",
                                "target_lang_sense_clarification": "烹饪原料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9731e73-c5e2-3a44-84fb-6ad42a8fb548",
                    "sense_definition": "Ziarno drzewa kakaowego lub (potocznie) sama ta roślina",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plantacje <kakao> znajdują się głównie w strefie klimatu równikowego.",
                            "target_lang_translations": {
                                "ru": "Плантации <w>какао</w> находятся в основном в экваториальной климатической зоне.",
                                "zh": "<w>可可</w>种植园主要分布在赤道气候带。"
                            }
                        },
                        {
                            "text": "Ceny surowego <kakao> na giełdach światowych znacznie wzrosły.",
                            "target_lang_translations": {
                                "ru": "Цены на сырое <w>какао</w> на мировых биржах значительно выросли.",
                                "zh": "国际市场上生<w>可可豆</w>的价格大幅上涨。"
                            }
                        }
                    ],
                    "synonyms": [
                        "kakaowiec"
                    ],
                    "common_phrases": [
                        "ziarno kakao",
                        "uprawa kakao",
                        "plantacja kakao"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зерно шоколадного дерева или (разг.) само это растение",
                        "zh": "可可树的种子或指代该植物本身"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какао",
                                "target_lang_sense_clarification": "растение или бобы"
                            },
                            {
                                "target_lang_word": "какао-бобы",
                                "target_lang_sense_clarification": "семена"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可可豆",
                                "target_lang_sense_clarification": "植物种子"
                            },
                            {
                                "target_lang_word": "可可树",
                                "target_lang_sense_clarification": "植物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7653719-94c7-3d63-9d53-e5e3a4d19b41",
                    "sense_definition": "Pospolite lub wulgarne określenie odbytu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Użył wulgarnego słowa oznaczającego <kakao>, co oburzyło słuchaczy.",
                            "target_lang_translations": {
                                "ru": "Он использовал вульгарное слово, обозначающее <w>задний проход</w>, что возмутило слушателей.",
                                "zh": "他用了个指代<w>屁眼</w>的粗俗词汇，这让听众感到愤慨。"
                            }
                        },
                        {
                            "text": "W slangu młodzieżowym słowo <kakao> bywa używane w obraźliwym kontekście.",
                            "target_lang_translations": {
                                "ru": "В молодежном сленге слово <w>какао</w> иногда используется в оскорбительном контексте.",
                                "zh": "在青少年俚语中，这个词有时会被用作侮辱性称呼，指代<w>屁眼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "odbyt"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубое или вульгарное название заднего прохода",
                        "zh": "指代肛门的粗俗用语"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задний проход",
                                "target_lang_sense_clarification": "прост./вульг.: анус"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "屁眼",
                                "target_lang_sense_clarification": "粗俗用语"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}