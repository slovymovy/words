                ],
                "senses": [
                    {
                        "sense_id": "b14788a1-8787-3644-b3eb-e9e32734894f",
                        "entry_id": "78e7c191-a249-3a32-b9d3-e8532c7e80e5",
                        "glosses": [
                            "zweithöchster Dienstgrad von Heer und Luftwaffe, unter dem Marschall der DDR und über dem Generaloberst nicht gleichwertig mit General of the Army"
                        ],
                        "tags": [
                            "Nationale Volksarmee"
                        ],
                        "examples": [
                            {
                                "example_id": "34cf16b3-ccf9-4f37-98b0-6932c6900ad7",
                                "sense_id": "b14788a1-8787-3644-b3eb-e9e32734894f",
                                "text": "Mit der DDR ging auch der Dienstgrad des Armeegenerals unter."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e5592ffa-d859-3dbf-9ca6-ef4cd4e81b7c",
                        "entry_id": "78e7c191-a249-3a32-b9d3-e8532c7e80e5",
                        "glosses": [
                            "General im Range eines Armeegenerals, im weiteren Sinne jeder eine Armee führende General"
                        ],
                        "tags": [
                            "Nationale Volksarmee"
                        ],
                        "examples": [
                            {
                                "example_id": "da23facf-5642-48ca-914b-ab97bbab37d6",
                                "sense_id": "e5592ffa-d859-3dbf-9ca6-ef4cd4e81b7c",
                                "text": "„In einem Fall bot ein Armeegeneral an, sie im Hubschrauber mitzunehmen.“"
                            },
                            {
                                "example_id": "b9e66d97-3a89-40bb-8384-b68d2fdf5b84",
                                "sense_id": "e5592ffa-d859-3dbf-9ca6-ef4cd4e81b7c",
                                "text": "„Ein Khan loyaler Kommandeur machte Anhänger eines Armeegenerals dafür verantwortlich.“"
                            },
                            {
                                "example_id": "0e73ffe4-a1f6-4d64-b498-24c592f0b346",
                                "sense_id": "e5592ffa-d859-3dbf-9ca6-ef4cd4e81b7c",
                                "text": "„Doch gerade durch diesen Vorstoß hoffte er den alleinherrschsüchtigen Armeegeneral für sich einzunehmen.“"
                            },
                            {
                                "example_id": "bb456d4c-2488-4949-9449-b615b72e6793",
                                "sense_id": "e5592ffa-d859-3dbf-9ca6-ef4cd4e81b7c",
                                "text": "„Gleichzeitig wurde ein anderer Armeegeneral zum Chef des Generalstabes ernannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
