                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "786a0c2a-fac4-3fdb-a36c-ac8d35cbe8a0",
                                        "entry_id": "6209e057-3b42-3241-8f95-5cd0ed690e4a",
                                        "glosses": [
                                            "A word that passed from language A into language B and thence back into language A. Such words may have changed in meaning and/or form."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a86157b-aaf2-43d5-b4b1-6587c1d2f906",
                                                "sense_id": "786a0c2a-fac4-3fdb-a36c-ac8d35cbe8a0",
                                                "text": "The word flan itself is a relatively recent addition to English, adopted on our behalf from French by the chef Alexis Soyer (a Frenchman working in England), but in that form it is in fact simply a reborrowing of a word which originally crossed the Channel in the 13th century as flawn, denoting some sort of custard tart or cheesecake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0a5f295-a388-37aa-8e52-0d700c2317ec",
                                        "entry_id": "6209e057-3b42-3241-8f95-5cd0ed690e4a",
                                        "glosses": [
                                            "Something reborrowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae21226f-1954-4c49-bcee-d7b7dbcf6bc6",
                                                "sense_id": "e0a5f295-a388-37aa-8e52-0d700c2317ec",
                                                "text": "The borrower will usually argue that the accordion should be considered as a reborrowing of debt already repaid, and therefore should be a redraw of tranche A first."
                                            }
                                        ]
                                    }
                                ]
                            },
