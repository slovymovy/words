                "senses": [
                    {
                        "sense_id": "8414dd88-a30d-3919-af6d-4b83b4ff503b",
                        "entry_id": "05fabb16-d0bb-3085-9222-72bb69bf140b",
                        "glosses": [
                            "Dokument, das Ablauf und Ergebnis einer Durchsuchung schildert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba938943-11bd-4489-808e-4b98fb4e9cc3",
                                "sense_id": "8414dd88-a30d-3919-af6d-4b83b4ff503b",
                                "text": "„Er hielt die Funde nichtsdestotrotz für bemerkenswert und notierte sie im Durchsuchungsbericht.“"
                            },
                            {
                                "example_id": "81c899c5-ee34-472a-9b9b-3bac59dfd4c9",
                                "sense_id": "8414dd88-a30d-3919-af6d-4b83b4ff503b",
                                "text": "„Neuneinhalb Stunden brauchten die Fahnder, um sich halbwegs einen Überblick zu schaffen, heißt es im Durchsuchungsbericht.“"
                            },
                            {
                                "example_id": "b3be8735-d3f5-4520-9fe4-93d4837e6a0d",
                                "sense_id": "8414dd88-a30d-3919-af6d-4b83b4ff503b",
                                "text": "„Stattdessen will das Gericht Auszüge aus einem Durchsuchungsbericht vorlesen und Fotos daraus zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
