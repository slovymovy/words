{
    "word_family": [
        "savantism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7f875ee-59f3-3850-903b-35edf8f09d21",
                    "sense_definition": "A person, often with mental disabilities, who is exceptionally gifted in a specific area of activity, such as music or mathematics.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>savant</w> could play complex classical piano pieces after hearing them only once.",
                            "target_lang_translations": {
                                "ru": "Юный <w>савант</w> мог исполнять сложные классические фортепианные произведения, услышав их всего один раз."
                            }
                        },
                        {
                            "text": "He was a mathematical <w>savant</w> who could calculate prime numbers instantly in his head.",
                            "target_lang_translations": {
                                "ru": "Он был математическим <w>савантом</w>, способным мгновенно вычислять простые числа в уме."
                            }
                        }
                    ],
                    "synonyms": [
                        "idiot savant"
                    ],
                    "common_phrases": [
                        "mathematical savant",
                        "musical savant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, часто с особенностями развития, обладающий выдающимися способностями в узкой области, например, в музыке или математике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "савант",
                                "target_lang_sense_clarification": "человек с синдромом саванта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8532e8fc-4e45-36c3-8027-5b4d4d0a545a",
                    "sense_definition": "A person of great learning, especially one who is highly knowledgeable in literature or science.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intellectual_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university invited a distinguished <w>savant</w> to lecture on ancient civilizations.",
                            "target_lang_translations": {
                                "ru": "Университет пригласил выдающегося <w>ученого</w> прочитать лекцию о древних цивилизациях."
                            }
                        },
                        {
                            "text": "As a respected <w>savant</w> in his field, his opinions were highly valued by the scientific community.",
                            "target_lang_translations": {
                                "ru": "Как уважаемый <w>ученый</w> в своей области, он высоко ценился научным сообществом за свое мнение."
                            }
                        }
                    ],
                    "synonyms": [
                        "erudite",
                        "expert"
                    ],
                    "common_phrases": [
                        "distinguished savant",
                        "scientific savant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ученый, человек с глубокими познаниями, особенно в области литературы или науки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ученый",
                                "target_lang_sense_clarification": "человек, занимающийся наукой"
                            },
                            {
                                "target_lang_word": "эрудит",
                                "target_lang_sense_clarification": "человек с обширными познаниями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6b806e7-795b-339a-82af-d00d4ee88811",
                    "sense_definition": "A person who is considered eminent because of their outstanding achievements.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intellectual_ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Nobel laureate was celebrated as a true <w>savant</w> of modern medicine.",
                            "target_lang_translations": {
                                "ru": "Лауреат Нобелевской премии был признан настоящим <w>светилом</w> современной медицины."
                            }
                        },
                        {
                            "text": "She became a <w>savant</w> of the literary world after publishing her groundbreaking research.",
                            "target_lang_translations": {
                                "ru": "Она стала признанным <w>экспертом</w> в литературном мире после публикации своего новаторского исследования."
                            }
                        }
                    ],
                    "synonyms": [
                        "expert"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выдающийся деятель, признанный эксперт в своей области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эксперт",
                                "target_lang_sense_clarification": "специалист в определенной области"
                            },
                            {
                                "target_lang_word": "светило",
                                "target_lang_sense_clarification": "выдающийся ученый или деятель"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "dcb1349b-7314-32ea-a6f1-cd1976b64547",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The historical documents were signed by a man named Jean <w>Savant</w>.",
                            "target_lang_translations": {
                                "ru": "Исторические документы были подписаны человеком по имени Жан <w>Саван</w>."
                            }
                        },
                        {
                            "text": "We looked up the genealogy of the <w>Savant</w> family in the local archives.",
                            "target_lang_translations": {
                                "ru": "Мы изучили генеалогию семьи <w>Саван</w> в местных архивах."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Саван",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}