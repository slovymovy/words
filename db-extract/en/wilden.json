                    {
                        "sense_id": "ef23adeb-19d1-3785-a384-dbf8d9596355",
                        "entry_id": "0c98d308-26cc-3977-89f3-c68743cd4a19",
                        "glosses": [
                            "to make or become wild or wilder"
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6ff13edd-c62d-4a7b-90f0-bd35d4d8f83a",
                                "sense_id": "ef23adeb-19d1-3785-a384-dbf8d9596355",
                                "text": "The glorification of the business-man which is the effect of the present government's capital profits, expense account and pension fund policies is ‘wildening’ our capitalism."
                            },
                            {
                                "example_id": "5321b6d3-9e7f-4d92-bb3b-8d23821c73d6",
                                "sense_id": "ef23adeb-19d1-3785-a384-dbf8d9596355",
                                "text": "His alembic furnished Highland spring water. We sat for a while in companionable silence. The weather wildened."
                            },
                            {
                                "example_id": "58caac3f-391b-4598-816d-39d94f73e624",
                                "sense_id": "ef23adeb-19d1-3785-a384-dbf8d9596355",
                                "text": "In any event, our relations with Dorthillion have become poor since the ways have wildened."
                            }
                        ]
                    }
