                    {
                        "sense_id": "5106c2e7-6ab2-3cdc-be01-966318d87cd4",
                        "entry_id": "a8f4b8a7-317d-3b9e-acd4-17f47391ace7",
                        "glosses": [
                            "Betrachtungsweise vom menschlichen Standpunkt aus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4574a2d-3f7f-455d-bc8a-222c3b6d9dbe",
                                "sense_id": "5106c2e7-6ab2-3cdc-be01-966318d87cd4",
                                "text": "Will man mit Nietzsche die Überwindung der Anthropozentrizität denken und will man ihr gegen Nietzsche eine andere Ausgestaltung geben, hat man, wie er es in den genannten Worten Zarathustras gesagt hat, ein Seher – man könnte auch sagen ‚Visionär‘ – zu sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
