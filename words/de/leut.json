            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd1ae26c-9f8c-3334-bdc7-b7fd1ff47e7b",
                    "sense_definition": "Kurz- bzw. mundartliche Form von <w>Leute</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heute sind wieder viele fremde <w>Leut</w> in der Stadt unterwegs.",
                            "target_lang_translations": {
                                "ru": "Сегодня в городе снова ходит много чужих <w>людей</w>."
                            }
                        },
                        {
                            "text": "Die alten <w>Leut</w> auf dem Dorf wissen noch ganz genau über die Geschichte Bescheid.",
                            "target_lang_translations": {
                                "ru": "Старые <w>люди</w> в деревне до сих пор прекрасно помнят эту историю."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "mundartlich verkürzte Form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткая или диалектная форма слова «Leute» (люди, народ)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "люди",
                                "target_lang_sense_clarification": "во множественном числе, разговорная/диалектная форма"
                            },
                            {
                                "target_lang_word": "народ",
                                "target_lang_sense_clarification": "разговорно, о людях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84c73600-8ced-3928-9b3d-543554698cdc",
                    "sense_definition": "Einzelne Person oder menschliches Individuum, im Singular gebraucht",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_individual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Schimpf nicht über die Nachbarn, du bist schließlich auch nur ein <w>Leut</w>.",
                            "target_lang_translations": {
                                "ru": "Не ругай соседей, ты ведь в конце концов тоже всего лишь <w>человек</w>."
                            }
                        },
                        {
                            "text": "Sie war ein sehr altes <w>Leut</w>, das stets freundlich zu den Kindern im Hof grüßte.",
                            "target_lang_translations": {
                                "ru": "Она была очень старым <w>человеком</w>, который всегда приветливо здоровался с детьми во дворе."
                            }
                        }
                    ],
                    "synonyms": [
                        "Mensch",
                        "Person"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "oberdeutsch, veraltend"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный человек или индивид (в единственном числе, диалектное/устаревающее)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "человек",
                                "target_lang_sense_clarification": "в единственном числе"
                            },
                            {
                                "target_lang_word": "личность",
                                "target_lang_sense_clarification": "индивидуум, субъект"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f16a8856-ac3c-3e8e-8efa-1543dc51f6c2",
                    "sense_definition": "Mensch als Angehöriger eines Rechtsverbandes, vor allem im Mittelalter in abhängiger Stellung zu einem Herrn",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Leut</w> war an die Scholle gebunden und leistete dem Herrn Frondienste.",
                            "target_lang_translations": {
                                "ru": "<w>Крепостной</w> был прикреплён к земле и отбывал барщину в пользу господина."
                            }
                        },
                        {
                            "text": "Im mittelalterlichen Rechtssystem stand der <w>Leut</w> zwischen den Freien und den Leibeigenen.",
                            "target_lang_translations": {
                                "ru": "В средневековой правовой системе <w>зависимый человек</w> занимал положение между свободными и крепостными."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historischer Rechtsbegriff"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зависимый человек в средневековой правовой системе, подданный феодала"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепостной",
                                "target_lang_sense_clarification": "зависимый крестьянин"
                            },
                            {
                                "target_lang_word": "зависимый человек",
                                "target_lang_sense_clarification": "в средневековом праве"
                            },
                            {
                                "target_lang_word": "подданный",
                                "target_lang_sense_clarification": "феодала"
                            }
                        ]
                    }
                }
            ]
        }
