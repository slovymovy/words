                ],
                "senses": [
                    {
                        "sense_id": "b95cdd93-43df-3d9f-9d35-9989ea724f98",
                        "entry_id": "984dc9b8-e9c1-3c59-9d54-9951e69dd2a6",
                        "glosses": [
                            "Causing physical or mental agony."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3daa307-f5d8-46f7-8a68-5fda85207f93",
                                "sense_id": "b95cdd93-43df-3d9f-9d35-9989ea724f98",
                                "text": "It was an agonizing twenty-minute wait for the results."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91758fe2-7405-4ecd-a304-3c8ff5901f5a",
                        "source_entry_id": "984dc9b8-e9c1-3c59-9d54-9951e69dd2a6",
                        "source_sense_id": "b95cdd93-43df-3d9f-9d35-9989ea724f98",
                        "source_sense_description": "causing agony",
                        "target_lang_word": "agonisant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agonisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81dc34ed-5653-3011-9922-04600b4fc270",
                                        "entry_id": "db98aaea-bed7-35f1-9a64-75bd2b576f4b",
                                        "glosses": [
                                            "Qui est à l’agonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e01133-c15c-477c-b19f-499673461ee1",
                                                "sense_id": "81dc34ed-5653-3011-9922-04600b4fc270",
                                                "text": "Voit-elle la grimace agonisante d’un membre quelconque de la famille Kinck, […] ?"
                                            },
                                            {
                                                "example_id": "da68eebd-a007-4900-a919-5e0181fc6c2d",
                                                "sense_id": "81dc34ed-5653-3011-9922-04600b4fc270",
                                                "text": "Ceci nous permet de dire que l’insecte agonisant contient encore 50,2 % de son poids en eau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agonisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                        "entry_id": "dcb88654-8808-3619-89f0-2dd24ce65532",
                                        "glosses": [
                                            "Celui qui est à l’agonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5d43f9-e1e2-42ef-a380-168c1d609412",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Il était pieds nus, habillé d’une longue robe noire sur laquelle on avait cousu à la place du cœur une croix bleue et rouge. C’est l’insigne de la confrérie des Agonisants."
                                            },
                                            {
                                                "example_id": "b42277b6-6573-4b68-81a0-f5d6667a6fa4",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Oui, l’agonisant est plutôt esprit que matière ; voilà pourquoi, à l’heure suprême, les hommes les plus athées sont revenus aux croyances éternelles et aux vérités de révélation."
                                            },
                                            {
                                                "example_id": "4aee0dc0-06cc-43ec-9528-3e014dd4422a",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Elle n’avait point osé courir chercher un prêtre, malgré sa grande envie ; et elle récitait elle-même les prières des agonisants, elle priait ardemment le bon Dieu, pour qu’il pardonnât à monsieur et que monsieur allât droit en paradis."
                                            },
                                            {
                                                "example_id": "5e7848b9-f58c-4384-a308-76b488eaa494",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Une d’entre elles, qui avait apporté un gros livre de messe, l’ouvrit à une page marquée et lut les prières des agonisants. Les autres répétaient les répons."
                                            },
                                            {
                                                "example_id": "dd5c4de6-da7f-4ff7-ba5b-8ee28895bf6f",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Tout s'est fait lent, comme des réflexes d'agonisant."
                                            },
                                            {
                                                "example_id": "e658af7e-5971-4772-aade-722801dd27d0",
                                                "sense_id": "bf1a9834-075b-364a-a40d-6c84270e42c4",
                                                "text": "Vous n’avez réclamé ni gloire ni les larmes\nNi l’orgue ni la prière aux agonisants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "agonisant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e45af20-a935-37ee-a8ae-2101be309006",
                                        "entry_id": "8dd7eca8-5cbd-37b7-89bc-2cb56a7728ae",
                                        "glosses": [
                                            "Participe présent du verbe agoniser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1acf2429-a0bf-421d-8a7b-7244c2185a45",
                                                "sense_id": "2e45af20-a935-37ee-a8ae-2101be309006",
                                                "text": "En entrant dans l’abri sommaire, fait de roseaux tressés sur une armature en bois cintré, il découvrit la femme allongée, agonisant dans une mare visqueuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e42abdca-5c83-472a-95bf-906c656bce0b",
                        "source_entry_id": "984dc9b8-e9c1-3c59-9d54-9951e69dd2a6",
                        "source_sense_id": "b95cdd93-43df-3d9f-9d35-9989ea724f98",
