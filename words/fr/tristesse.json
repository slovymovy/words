                {
                    "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                    "sense_definition": "État affectif douloureux, sentiment de peine ou d'abattement moral causé par un événement pénible ou une déception.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle ressentait une immense <w>tristesse</w> après le départ de sa meilleure amie."
                        },
                        {
                            "text": "Il n'a pas pu cacher sa <w>tristesse</w> en apprenant la mauvaise nouvelle."
                        }
                    ],
                    "antonyms": [
                        "joie"
                    ],
                    "common_phrases": [
                        "grande tristesse",
                        "pleurer de tristesse",
                        "sentiment de tristesse"
                    ]
                },
                {
                    "sense_id": "7670c4ea-e295-3c5a-83be-4add7a74c074",
                    "sense_definition": "Caractère morne, lugubre ou mélancolique de ce qui inspire de la peine ou de l'ennui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ambiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La pluie continue ajoutait à la <w>tristesse</w> de ce paysage d'hiver."
                        },
                        {
                            "text": "La <w>tristesse</w> de cette pièce sans fenêtres rendait l'atmosphère très pesante."
                        }
                    ],
                    "common_phrases": [
                        "tristesse du paysage"
                    ]
                }
            ]
