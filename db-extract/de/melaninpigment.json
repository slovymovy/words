                "senses": [
                    {
                        "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                        "entry_id": "111a58e2-6af1-3a93-9162-65235c1e87c1",
                        "glosses": [
                            "weit verbreitetes dunkelbraunes bis schwarzes oder gelbliches bis rötliches Farbstoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3db51c48-ecd1-4568-ac6a-e01b7b6f7880",
                                "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                                "text": "„Melanozyten können wenig bis viel Melaninpigment enthalten und so die hellere oder dunkAbb.“"
                            },
                            {
                                "example_id": "6dab4e1d-9926-4e41-b6b7-2d2a3a2442ee",
                                "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                                "text": "„Dringend Strahlen tiefer ein, werden sie von Melaninpigment in der Haut absorbiert und in Wärme verwandelt.“"
                            },
                            {
                                "example_id": "efb0b0d7-8202-4563-a3dc-6ca5186d7fba",
                                "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                                "text": "„Forscher hatten zuvor in Fossilien bereits Melanosomen gefunden, in denen Melaninpigment hergestellt und aufbewahrt wird.“"
                            },
                            {
                                "example_id": "d3a5463e-4b13-4e64-8954-47d18b94ba9f",
                                "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                                "text": "„Nach vielen Jahren der Sonneneinstrahlung können die Melaninpigmente verklumpen und ovale oder runde Flecken bilden.“"
                            },
                            {
                                "example_id": "8d114444-9d38-4d57-808e-323cfe1a66f7",
                                "sense_id": "01e3bbf1-0d84-3eb8-be0f-4262a190a433",
                                "text": "„Phenylalanin ist auch die Ausgangssubstanz von Melaninpigmenten (Sommerbräune), das zum Schutz gegen die schädigende Wirkung von UV-Strahlung gebildet wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
