        "nl-extract.jsonl": [
            {
                "entry_id": "85fab9ae-c3ae-347c-b87e-351f2136b7e3",
                "word": "gevlij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "420a939f-c295-38ea-b735-5befd9e1300e",
                        "entry_id": "85fab9ae-c3ae-347c-b87e-351f2136b7e3",
                        "glosses": [
                            "comfortabele nabijheid, in: in het ~ in goede persoonlijke verhouding, in de gunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162a67ae-e8c8-4908-8b33-aa21fc0c4ded",
                                "sense_id": "420a939f-c295-38ea-b735-5befd9e1300e",
                                "text": "Hij slaagde erin bij haar in het gevlij te komen en dit was het begin van een amoureus avontuur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3920f51-9214-4dec-b079-364343e81828",
                        "source_entry_id": "85fab9ae-c3ae-347c-b87e-351f2136b7e3",
                        "source_sense_id": "420a939f-c295-38ea-b735-5befd9e1300e",
                        "target_lang_word": "someone's good side",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "eaa530b1-d0a3-4d8e-9e48-48218cf6a5db",
                        "source_entry_id": "85fab9ae-c3ae-347c-b87e-351f2136b7e3",
                        "source_sense_id": "420a939f-c295-38ea-b735-5befd9e1300e",
                        "target_lang_word": "favor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "favor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a063864-17ce-3a3d-ab16-7e961cfefe64",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "A kind or helpful deed; an instance of voluntarily assisting (someone)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c48ba6c-824b-4708-b41a-5665eb5296ed",
                                                "sense_id": "9a063864-17ce-3a3d-ab16-7e961cfefe64",
                                                "text": "He did me a favor when he took the time to drive me home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "Goodwill; benevolent regard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139a8f88-1bfb-47af-8d6f-4ea4f2bca1d6",
                                                "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                                                "text": "She enjoyed the queen's favor."
                                            },
                                            {
                                                "example_id": "a85c7a1b-a6a9-48ac-9991-d9c4c4bac6d7",
                                                "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                                                "text": "to fall out of favor"
                                            },
                                            {
                                                "example_id": "28b58e88-0efc-4953-ad62-dcf5af7866a7",
                                                "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                                                "text": "Then came a maid with hand-bag and shawls, and after her a tall young lady.[…]She looked around expectantly, and recognizing Mrs. Cooke's maid[…]Miss Thorn greeted her with a smile which greatly prepossessed us in her favor."
                                            },
                                            {
                                                "example_id": "7f614476-e4cc-4f11-9afa-8ef806ff226b",
                                                "sense_id": "593ce089-c899-3f8c-8df6-8528c551029c",
                                                "text": "Samara: She confuses her victims, twists their feelings. They will do anything for her favor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "A small gift; a party favor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40505272-b915-43d0-9aac-eb21142c0e72",
                                                "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                                                "text": "At the holiday dinner, the hosts had set a favor by each place setting."
                                            },
                                            {
                                                "example_id": "2269c39d-6746-46c4-bb5a-b0504d6fc09e",
                                                "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                                                "text": "A marriage favour is a bunch or knot of white ribbons or white flowers worn at a wedding."
                                            },
                                            {
                                                "example_id": "fe9da39f-0e20-49d2-b060-1392d7226548",
                                                "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                                                "text": "Here, Fluellen; wear thou this favour for me and\nstick it in thy cap: when Alencon and myself were\ndown together, I plucked this glove from his helm […]"
                                            },
                                            {
                                                "example_id": "8d85f5cf-3834-472d-86f7-bb38bee8e631",
                                                "sense_id": "3a137c6e-4cfc-3fea-84da-75ec2331344d",
                                                "text": "The rain drove into the bride and bridegroom's faces as they passed to the chariot. The postilions' favours draggled on their dripping jackets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eef3b6c4-e036-35b6-9a04-240462c97fd5",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "Mildness or mitigation of punishment; lenity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e40d70e0-b453-4baa-9d8f-60aa64495aa3",
                                                "sense_id": "eef3b6c4-e036-35b6-9a04-240462c97fd5",
                                                "text": "I could not discover the lenity and favour of this sentence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e18bed18-348b-3be3-b329-a2e5950e1ca9",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "The object of regard; person or thing favoured."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de45a1a2-623e-4c2f-b17e-42aae61f996c",
                                                "sense_id": "e18bed18-348b-3be3-b329-a2e5950e1ca9",
                                                "text": "All these his wondrous works, but chiefly man, / His chief delight and favour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03487364-a95c-38d2-b164-d06aef65ec24",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "Appearance; look; countenance; face."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b591ab1e-19cb-4951-b36b-52b75a76e764",
                                                "sense_id": "03487364-a95c-38d2-b164-d06aef65ec24",
                                                "text": "This boy is fair, of female favour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1faf9b10-f846-3cd2-87a3-e459af2ae00c",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "Partiality; bias"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4502c4d6-dc0f-3a3e-94a2-fdb59d3c5066",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "A letter, a written communication."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fbca935-e483-4aaf-a39c-01d9160c63ae",
                                                "sense_id": "4502c4d6-dc0f-3a3e-94a2-fdb59d3c5066",
                                                "text": "I will now take some notice of your last favour; but being so far behind-hand with you, must be brief."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8757301-a5b8-3aa1-9cc9-2b1d586d1d9d",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "A resemblance, likeness."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a81b106b-d29b-3b4a-9dae-160cd1cb5470",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "Anything worn publicly as a pledge of a woman's favor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd2f777-2733-4439-ba8c-5868d69e7d09",
                                                "sense_id": "a81b106b-d29b-3b4a-9dae-160cd1cb5470",
                                                "text": "James probably saw the family treasures, which included a little pair of gloves embroidered with pearls and the device of a lion, a lady's favour, said to have been taken from Harry Hotspur before the battle of Otterburn in 1388."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                        "entry_id": "11de03cc-595d-3f14-9824-722aed8248f3",
                                        "glosses": [
                                            "A ribbon or similar small item that is worn as an adornment, especially in celebration of an event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ae7ea5c-bbb7-4746-970b-37d12a3e771e",
                                                "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                                "text": "The bride favors, or true love knots, ancient symbols of love, faith, and friendship, pointing out the indisssoluble tie of affection and duty, did not, as might be supposed, take their name of true love knots from the words \"true\" and \"love,\", but from the Danish verb \"Trulofa,\" that is, \"I plight my troth of faith.\" These knots were formerly distributed in great abundance; were worn in the hats by gentlemen, and consisted of variously colored ribbons, which were chosen by the bride and her maids, sometimes after long and serious discussions."
                                            },
                                            {
                                                "example_id": "67906494-4a91-4720-b7cb-8746ea9a889a",
                                                "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                                "text": "Of all the new war cotillion favors yet devised there is hardly anything more novel than these. Aigrettes that are bunches of ribbons, red, white and blue, designed to be pinned in the hair at once, make up another favor."
                                            },
                                            {
                                                "example_id": "f4e5e716-7730-42ea-810f-ac9e5090e926",
                                                "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                                "text": "Since the good news young folk—and old, too, for that matter—bedeck themselves with favors. Charms hand pendent from the watch chain, from neck pins."
                                            },
                                            {
                                                "example_id": "8f056eed-c852-47e6-8ef0-8e58e98b6449",
                                                "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                                "text": "We can and should borrow choice items, such as bell pads, favors and flowered hats , which can easily be adapted […]"
                                            },
                                            {
                                                "example_id": "31de9563-265c-4669-bbcd-95eeb6a04ccc",
                                                "sense_id": "74db3063-e95b-3fa0-912c-eacd8bfbd2f7",
                                                "text": "[…] honor was bestowed upon the latter because he was the proud possessor of luxurious blond hair and had the most beautiful single curl tied with a ribbon. The lovelock was thereafter called a cadcnettc and the ribbon bowknots, favors."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "favor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01e5812f-6038-37ee-8d86-f07961ab5a60",
                                        "entry_id": "30c6a6c6-7a7f-3181-8018-7338c60d0a63",
                                        "glosses": [
                                            "To look upon fondly; to prefer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288605fd-2201-4f0f-a640-d3839a23f438",
                                                "sense_id": "01e5812f-6038-37ee-8d86-f07961ab5a60",
                                                "text": "And the angel came in unto her, and said, Hail, thou that art highly favored, the Lord is with thee: blessed art thou among women."
                                            },
                                            {
                                                "example_id": "c4e8ee72-d14a-445f-ace2-5bfffbb302be",
                                                "sense_id": "01e5812f-6038-37ee-8d86-f07961ab5a60",
                                                "text": "Even in an era when individuality in dress is a cult, his clothes were noticeable. He was wearing a hard hat of the low round kind favoured by hunting men, and with it a black duffle-coat lined with white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063e2b0c-e65d-3f91-8685-6d913b84660d",
                                        "entry_id": "30c6a6c6-7a7f-3181-8018-7338c60d0a63",
                                        "glosses": [
                                            "To use more often."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9883c7f3-8e63-4350-a39a-6ff3dad3903f",
                                                "sense_id": "063e2b0c-e65d-3f91-8685-6d913b84660d",
                                                "text": "[…] alone, without having to favor his right, uninjured leg, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d29c609-b141-3c85-82e1-1aa5143b4570",
                                        "entry_id": "30c6a6c6-7a7f-3181-8018-7338c60d0a63",
                                        "glosses": [
                                            "To encourage, conduce to"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d6a528a-bc9d-4892-94d6-77f379266e3b",
                                                "sense_id": "1d29c609-b141-3c85-82e1-1aa5143b4570",
                                                "text": "These [boys being groomed as prostitutes] are sold by their parents (sometimes stolen from them), about the age of 4, and educated, while they are also subjected to a special physical training, which includes massage of the gluteal regions to favor development, dilatation of the anus, and epilation (which is not, however, practised by Chinese women)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9c85c43-b883-3ec0-8097-78a19d623487",
                                        "entry_id": "30c6a6c6-7a7f-3181-8018-7338c60d0a63",
                                        "glosses": [
                                            "To do a favor [noun sense 1] for; to show beneficence toward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e569fba-8c33-47db-b0e6-ac7e991e5c08",
                                                "sense_id": "e9c85c43-b883-3ec0-8097-78a19d623487",
                                                "text": "Would you favor us with a poetry reading?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c709b71a-c48a-3ed8-bdbb-e92f63e436f0",
                                        "entry_id": "30c6a6c6-7a7f-3181-8018-7338c60d0a63",
                                        "glosses": [
                                            "To resemble; especially, to look like (another person)."
                                        ],
                                        "tags": [
                                            "in dialects"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b561ea3-91d4-4b58-87ac-dda6837e91cf",
                                                "sense_id": "c709b71a-c48a-3ed8-bdbb-e92f63e436f0",
                                                "text": "‘Mandy?’ he said, and stared at the girl. ‘Don't favor her too much.’ ‘Favors her dad,’ Latha said, and looked at him."
                                            },
                                            {
                                                "example_id": "7a580669-ee7f-4045-9f31-cc58954278ba",
                                                "sense_id": "c709b71a-c48a-3ed8-bdbb-e92f63e436f0",
                                                "text": "[…] chamomile and apples? Those particular smellalikes tested our imagination. Yet much of what he said was right on the mark. The scent of sweet peas, for instance, does indeed favor that of wisteria."
                                            },
                                            {
                                                "example_id": "75300491-e865-4fee-bdcf-acfc38c45ad4",
                                                "sense_id": "c709b71a-c48a-3ed8-bdbb-e92f63e436f0",
                                                "text": "The way things repeat themselves, across time — not just in the replications and recombinations of family and place (\"He favors his momma, she favors her daddy\"), but in the accretion of like patterns […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
