                        ],
                        "form": "créatrices"
                    },
                    {
                        "form_id": "7f6474ac-5d1f-49b2-8c66-fce0824e709e",
                        "entry_id": "e8a6d158-58bb-3064-b118-591bedd58907",
                        "tags": [
                            "masculine"
                        ],
                        "form": "créateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b487d63-36cc-37fb-ae92-1ff6abe02154",
                        "entry_id": "e8a6d158-58bb-3064-b118-591bedd58907",
                        "glosses": [
                            "Celle qui crée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a496ce07-9cd1-47dd-886f-27f4956f8f82",
                                "sense_id": "1b487d63-36cc-37fb-ae92-1ff6abe02154",
                                "text": "Diane von Fùrstenberg est la seule créatrice inscrite dans le Guinness des records, grâce aux 5 millions de robes portefeuille vendues, la célèbre « wrap dress» sur laquelle elle a construit son empire."
                            },
                            {
                                "example_id": "3ef345cf-8682-4a67-9496-cbefbae4f7a4",
                                "sense_id": "1b487d63-36cc-37fb-ae92-1ff6abe02154",
                                "text": "« Pour serrer les prix, nous misons sur la vente directe dans notre shop à Paris ou en ligne, et sur l’utilisation au maximum de pièces standards du marché dont la fiabilité a été approuvée », explique Amélie Guicheney, l’une des créatrices."
                            },
                            {
                                "example_id": "099d53b9-509f-4d6c-aab5-7ad9c65ab432",
                                "sense_id": "1b487d63-36cc-37fb-ae92-1ff6abe02154",
                                "text": "Â 17 ans, j’ai rencontré une personne qui réalisait, au même âge, qu’elle était en situation d’intersexuation, racontait Yaël Langmann, la créatrice, scénariste et coréalisatrice de Chair tendre, lors d’un entretien à Séries Mania."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f6b7c0f-2fe9-4303-8427-2bd5a35368d4",
                        "source_entry_id": "e8a6d158-58bb-3064-b118-591bedd58907",
                        "source_sense_id": "1b487d63-36cc-37fb-ae92-1ff6abe02154",
                        "target_lang_word": "creator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbda5067-3ad0-3d30-beb6-aa70882ebb79",
                                        "entry_id": "53bd47af-7c2a-3dd2-b071-cbe002bf44a2",
                                        "glosses": [
                                            "Something or someone which creates or makes something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad40e49a-d645-4e2c-b7af-565a68155755",
                                                "sense_id": "cbda5067-3ad0-3d30-beb6-aa70882ebb79",
                                                "text": "Kenneth E. Iverson was the creator of APL."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                        "entry_id": "53bd47af-7c2a-3dd2-b071-cbe002bf44a2",
                                        "glosses": [
                                            "Ellipsis of content creator, someone who regularly produces and publishes content on social media, especially of a monetizable nature."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c96419cb-ba9d-41bd-ad0c-be4e31475899",
                                                "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                                "text": "creator economy"
                                            },
                                            {
                                                "example_id": "bc469ca4-3c55-47f3-8e15-0956dff82b7c",
                                                "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                                "text": "People have viewed his videos more than 13 billion times. And last year as the pandemic raged, he became the most-subscribed YouTube creator in the country."
                                            },
                                            {
                                                "example_id": "38b741a6-4acf-4bce-868b-498768747672",
                                                "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                                "text": "The video shows TikTok creator Harrison Pawluk approaching the woman, Maree, in a public shopping centre."
                                            },
                                            {
                                                "example_id": "060f1af1-1bce-4696-bcab-b2f957d0cc93",
                                                "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                                "text": "She wore crimson leggings, a stack of candy-colored beaded necklaces, and a black sweatshirt that read SELF-EMPLOYED because she is a full-time influencer — or “creator,” as it is more polite to say in this part of town."
                                            },
                                            {
                                                "example_id": "8fe0f2e7-6980-4f8d-95a1-b484a947e3e6",
                                                "sense_id": "5327971e-d010-384f-bacb-ed0140f0fe73",
                                                "text": "Her days are spent sending messages to her fans, who pay $30 a month to see her explicit videos and chat to her online; she aims to have sex with another creator (a collaboration) about once a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ac7bc4d-cc08-3c06-88a2-fb38a11c9a00",
                                        "entry_id": "53bd47af-7c2a-3dd2-b071-cbe002bf44a2",
                                        "glosses": [
                                            "The deity that created the world."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1857d080-3598-300e-9b6c-d75bb861e8dd",
                                        "entry_id": "53bd47af-7c2a-3dd2-b071-cbe002bf44a2",
                                        "glosses": [
                                            "A player who creates opportunities for their team to score goals; a playmaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f43d78a-49a7-4fef-b7f7-ad5430342457",
                                                "sense_id": "1857d080-3598-300e-9b6c-d75bb861e8dd",
                                                "text": "Hernández is not a creator and suffered from a lack of service in previous seasons."
                                            },
                                            {
                                                "example_id": "f4c25e5e-f1bd-4f0c-8845-cfdc6246713b",
                                                "sense_id": "1857d080-3598-300e-9b6c-d75bb861e8dd",
                                                "text": "There have been times this season when it seemed Liverpool were trying to reinvent Salah, the scorer supreme, as a creator and this was a sudden reminder of his greatest strength."
                                            },
                                            {
                                                "example_id": "401aaefa-f268-48e8-bda1-675f105fce9b",
                                                "sense_id": "1857d080-3598-300e-9b6c-d75bb861e8dd",
                                                "text": "As such, when Doncic was on the court, Brunson was a secondary facilitator and more of a finisher than a creator."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
