{
    "word_family": [
        "покидать",
        "покинутый"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "41d3daaf-4c77-34c0-87d1-31944b82e161",
                    "sense_definition": "Уйти или уехать из какого-либо места, помещения или страны; перестать находиться где-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы были вынуждены срочно <покинуть> здание из-за пожарной тревоги.",
                            "target_lang_translations": {
                                "en": "We were forced to urgently <leave> the building due to a fire alarm.",
                                "pl": "Byliśmy zmuszeni pilnie <w>opuścić</w> budynek z powodu alarmu pożarowego."
                            }
                        },
                        {
                            "text": "Мой друг решил навсегда <покинуть> страну и переехать в Европу.",
                            "target_lang_translations": {
                                "en": "My friend decided to <leave> the country forever and move to Europe.",
                                "pl": "Mój przyjaciel postanowił na zawsze <w>opuścić</w> kraj i przeprowadzić się do Europy."
                            }
                        }
                    ],
                    "synonyms": [
                        "уйти",
                        "оставить",
                        "уехать"
                    ],
                    "antonyms": [
                        "остаться",
                        "прийти",
                        "поселиться"
                    ],
                    "common_phrases": [
                        "покинуть страну",
                        "покинуть дом",
                        "покинуть помещение",
                        "покинуть город"
                    ],
                    "target_lang_definitions": {
                        "en": "To go away or depart from a place, building, or country; to stop being somewhere.",
                        "pl": "Opuścić lub wyjechać z jakiegoś miejsca, budynku lub kraju; przestać gdzieś przebywać."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "To go away from a place"
                            },
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "To depart from a place (formal or literary)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "opuścić",
                                "target_lang_sense_clarification": "miejsce, budynek, kraj"
                            },
                            {
                                "target_lang_word": "wyjechać z",
                                "target_lang_sense_clarification": "kraju, miasta"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e1ffd8b-fec3-30af-9a0a-d28abaf9bed1",
                    "sense_definition": "Оставить кого-либо одного, прекратить отношения или совместную жизнь с кем-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не мог <покинуть> семью в такой трудный для всех момент.",
                            "target_lang_translations": {
                                "en": "He could not <leave> his family at such a difficult moment for everyone.",
                                "pl": "Nie mógł <w>opuścić</w> rodziny w tak trudnym dla wszystkich momencie."
                            }
                        },
                        {
                            "text": "Настоящие друзья никогда не должны <покинуть> тебя в беде.",
                            "target_lang_translations": {
                                "en": "Real friends should never <leave> you in trouble.",
                                "pl": "Prawdziwi przyjaciele nigdy nie powinni <w>opuścić</w> cię w potrzebie."
                            }
                        }
                    ],
                    "synonyms": [
                        "бросить",
                        "оставить"
                    ],
                    "antonyms": [
                        "остаться"
                    ],
                    "common_phrases": [
                        "покинуть семью",
                        "покинуть друзей",
                        "покинуть в беде"
                    ],
                    "target_lang_definitions": {
                        "en": "To leave someone alone; to end a relationship or life together with someone.",
                        "pl": "Zostawić kogoś samego, zakończyć relację lub wspólne życie z kimś."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "To separate from someone"
                            },
                            {
                                "target_lang_word": "forsake",
                                "target_lang_sense_clarification": "To abandon or renounce someone"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "opuścić",
                                "target_lang_sense_clarification": "rodzinę, bliskich"
                            },
                            {
                                "target_lang_word": "porzucić",
                                "target_lang_sense_clarification": "zostawić kogoś w trudnej sytuacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2bea72b-11f0-3b1c-a669-8938e2db6005",
                    "sense_definition": "Перестать заниматься какой-либо деятельностью, уйти с должности или из организации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Директор объявил о своём решении <покинуть> пост в конце этого года.",
                            "target_lang_translations": {
                                "en": "The director announced his decision to <leave> his post at the end of this year.",
                                "pl": "Dyrektor ogłosił swoją decyzję o <w>odejściu</w> ze stanowiska pod koniec tego roku."
                            }
                        },
                        {
                            "text": "Известный спортсмен решил <покинуть> большой спорт после серьёзной травмы.",
                            "target_lang_translations": {
                                "en": "The famous athlete decided to <quit> professional sports after a serious injury.",
                                "pl": "Znany sportowiec postanowił <w>porzucić</w> wielki sport po poważnej kontuzji."
                            }
                        }
                    ],
                    "synonyms": [
                        "оставить",
                        "уйти",
                        "бросить"
                    ],
                    "antonyms": [
                        "остаться"
                    ],
                    "common_phrases": [
                        "покинуть пост",
                        "покинуть должность",
                        "покинуть сцену",
                        "покинуть ряды"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop an activity; to withdraw from a position, job, or organization.",
                        "pl": "Przestać zajmować się jakąś działalnością, odejść ze stanowiska lub z organizacji."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "To end membership or employment"
                            },
                            {
                                "target_lang_word": "resign",
                                "target_lang_sense_clarification": "To voluntarily leave a position"
                            },
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "To stop an activity or job"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odejść z",
                                "target_lang_sense_clarification": "pracy, organizacji, sportu"
                            },
                            {
                                "target_lang_word": "opuścić",
                                "target_lang_sense_clarification": "stanowisko, urząd"
                            },
                            {
                                "target_lang_word": "porzucić",
                                "target_lang_sense_clarification": "działalność, karierę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5cf72b3-4050-34c5-ae99-be31fe0faadd",
                    "sense_definition": "Исчезнуть, перестать ощущаться или присутствовать (о силах, чувствах, состояниях).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К вечеру последние силы <покинули> уставших путников, и они остановились на ночлег.",
                            "target_lang_translations": {
                                "en": "By evening, the last of their strength had <left> the tired travelers, and they stopped for the night.",
                                "pl": "Pod wieczór ostatnie siły <w>opuściły</w> zmęczonych wędrowców i zatrzymali się na nocleg."
                            }
                        },
                        {
                            "text": "Надежда на успех не <покинула> команду даже после первого поражения.",
                            "target_lang_translations": {
                                "en": "Hope for success did not <leave> the team even after the first defeat.",
                                "pl": "Nadzieja na sukces nie <w>opuściła</w> zespołu nawet po pierwszej porażce."
                            }
                        }
                    ],
                    "synonyms": [
                        "оставить",
                        "уйти"
                    ],
                    "antonyms": [
                        "сохраниться"
                    ],
                    "common_phrases": [
                        "силы покинули",
                        "надежда покинула",
                        "вдохновение покинуло"
                    ],
                    "target_lang_definitions": {
                        "en": "To disappear or cease to be present (referring to strength, feelings, or states).",
                        "pl": "Zniknąć, przestać być odczuwanym lub obecnym (o siłach, uczuciach, stanach)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "To pass from or stop affecting"
                            },
                            {
                                "target_lang_word": "forsake",
                                "target_lang_sense_clarification": "To abandon (often of hope or luck)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "opuścić",
                                "target_lang_sense_clarification": "o siłach, nadziei"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}