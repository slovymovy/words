                "senses": [
                    {
                        "sense_id": "22bd2251-c947-38ec-b0f2-541bb7b68d01",
                        "entry_id": "1b6e2a35-42b2-3553-88b2-b23f1d93f9fe",
                        "glosses": [
                            "Gémir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2519098f-2182-4b79-994c-c226dec9d8e9",
                                "sense_id": "22bd2251-c947-38ec-b0f2-541bb7b68d01",
                                "text": "On se console avec cette idée : le lendemain on regémit encore ; mais comme on a contracté l'habitude, la douleur s'atténue, et chacun prend patience."
                            },
                            {
                                "example_id": "efb7957f-6597-470f-93ed-a4605e6331f2",
                                "sense_id": "22bd2251-c947-38ec-b0f2-541bb7b68d01",
                                "text": "Ruisselant, il émergea de sa cuvette, sans égard pour le parquet ciré et, à nouveau, se rua sur le piano dont il fit regémir l'âme."
                            }
                        ]
                    }
