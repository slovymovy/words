                "senses": [
                    {
                        "sense_id": "89c1c7b6-dfa6-3f2c-ac40-2b920a1d33a2",
                        "entry_id": "48e1cd32-f2cf-3260-b758-f644f33f5763",
                        "glosses": [
                            "Verluste bei bewaffneten Konflikten"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "2c416bf3-f2e4-4382-95c1-7f31c671778c",
                                "sense_id": "89c1c7b6-dfa6-3f2c-ac40-2b920a1d33a2",
                                "text": "„Die Herrscherfamilie betrachtete den Angriff auf ihren Legitimitätsanspruch als so gravierend, dass sie die Besetzung unter Einsatz aller zur Verfügung stehenden Gewaltmittel und unter Hinnahme eines hohen Blutzolls beendete.“"
                            },
                            {
                                "example_id": "79558c79-0603-47af-bfec-360d166d0f9c",
                                "sense_id": "89c1c7b6-dfa6-3f2c-ac40-2b920a1d33a2",
                                "text": "„Ein Mann hatte in diesem Kampf ein Auge verloren, er hatte, mit anderen Worten, einen Blutzoll entrichtet, und es ging nicht so sehr um Moral oder Sühne und wie diese europäischen Dinge hießen - eine Rechnung war offen.“"
                            },
                            {
                                "example_id": "942e7c39-7f74-4864-9e8b-bfb69a2d49e2",
                                "sense_id": "89c1c7b6-dfa6-3f2c-ac40-2b920a1d33a2",
                                "text": "„Für die eifersüchtelnde Rivalität der Marschälle zahlte die Rote Armee einen hohen Blutzoll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d55a1ee2-a6af-4435-8fe6-c53e8437f9dc",
