                    },
                    {
                        "translation_id": "f66987df-9a25-46c0-bcf1-feed2416eb34",
                        "source_entry_id": "efe7b12e-9f1c-320e-8cb0-3f5685eb76e3",
                        "source_sense_id": "f0c49c30-e88c-332e-b7fb-3e706ef903b0",
                        "source_sense_description": "practitioner of judo",
                        "target_lang_word": "judoka",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judoka",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6136d420-6e27-3459-be30-2ee6ad132016",
                                        "entry_id": "a7468a91-a9d9-3aab-a27c-77741f0f4357",
                                        "glosses": [
                                            "Sportif pratiquant le judo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0b2198e-0650-4204-9123-cc419188a541",
                                                "sense_id": "6136d420-6e27-3459-be30-2ee6ad132016",
                                                "text": "Les judokas français ont décroché deux médailles du bronze sous les yeux du Président."
                                            },
                                            {
                                                "example_id": "477d2930-2167-4b3d-b3a1-4f41bae204f1",
                                                "sense_id": "6136d420-6e27-3459-be30-2ee6ad132016",
                                                "text": "La judoka Amy Cotton a terminé au cinquième rang chez les moins de 78kg dimanche au Grand Prix de Baku, en Azerbaïdjan, récoltant au passage des points précieux pour le processus de qualifications en vue des Jeux olympiques de Londres."
                                            },
                                            {
                                                "example_id": "277c30f3-cba5-491f-8cdc-cf1bd0dbf310",
                                                "sense_id": "6136d420-6e27-3459-be30-2ee6ad132016",
                                                "text": "La judoka chinoise Wen Tong, contrôlée positive au clenbutérol au soir de son sacre mondial (+78 kg) en 2009, peut conserver son titre après avoir été blanchie par le Tribunal arbitral du sport (TAS) mercredi pour un vice de procédure, selon un communiqué du TAS."
                                            },
                                            {
                                                "example_id": "e2fd78e7-9a9d-424d-bcb3-d95dfe67053a",
                                                "sense_id": "6136d420-6e27-3459-be30-2ee6ad132016",
                                                "text": "Absente du tournoi de Fukuoka (et de Bâle, épreuve pour laquelle le directeur technique francophone Bernard Tambour ne l’avait pas proposée), la judoka voit ainsi également menacée sa sélection pour le tournoi de Paris (du 7 au 9 février)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94b18335-986f-4b46-8f87-0d4cd45888c1",
                        "source_entry_id": "efe7b12e-9f1c-320e-8cb0-3f5685eb76e3",
                        "source_sense_id": "f0c49c30-e88c-332e-b7fb-3e706ef903b0",
                        "source_sense_description": "practitioner of judo",
                        "target_lang_word": "judokate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "judokate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                        "entry_id": "88c05ae0-f004-3bd2-9fc5-9e9c12e824f8",
                                        "glosses": [
                                            "Sportive pratiquant le judo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba1a87b-3c82-4395-8ea2-954f67302f0f",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Le père de la judokate avait menacé lundi de retirer sa fille du tournoi olympique féminin des +78 kg si elle n'était pas autorisée à porter le voile durant son combat."
                                            },
                                            {
                                                "example_id": "7c2fc609-29ba-4ded-aca8-983108daf74c",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "En revanche, la judokate Gévrise Emane (-63 kg), championne du monde et d’Europe, a connu une terrible désillusion après sa défaite en quart de finale face à une adversaire mongole. Elle a quitté le tatami en larmes."
                                            },
                                            {
                                                "example_id": "d2f15a43-edad-4f7c-ba41-c0efe2f9f4bf",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Cette semaine, suite à la traditionnelle séance du Conseil, c'est la judokate Frédérique Jossinet qui a été amenée à faire son maigre baluchon."
                                            },
                                            {
                                                "example_id": "612b115d-2fda-43e0-a80e-d79c30b719ae",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Les règlements sont les règlements, dira-t-on à Sports Canada. Peut-être, mais il y a des fois où il faut pouvoir interpréter ces règlements, et ce serait bien qu’on puisse le faire dans le cas de la judokate de Québec."
                                            },
                                            {
                                                "example_id": "618c5976-bfed-49cf-a96f-1f3e4034aa40",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Parfois, le coeur de l’entraîneur s’emballe avec plus d’intensité que pour une autre des judokates dont il s’occupe."
                                            },
                                            {
                                                "example_id": "2a58be71-f0a4-4b9e-a879-9057a41f33bc",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Quand la judokate Ulla Weerbrouck a gagné une médaille d’or aux Jeux olympiques d’Atlanta en 1996, c’était un peu comme si toute la Belgique l’emportait."
                                            },
                                            {
                                                "example_id": "de04e4d1-59be-4d46-9e2a-31ef48520f97",
                                                "sense_id": "ed8014cb-cd36-3164-b9d3-a74d8b51d88b",
                                                "text": "Nicole Flagothier, Heidi Rakels et Ulla Werbrouck, trois de nos meilleures judokates, se sont envolées hier midi à destination du Japon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feccd046-5426-4724-a318-d21e7f0d59d3",
                        "source_entry_id": "efe7b12e-9f1c-320e-8cb0-3f5685eb76e3",
                        "source_sense_id": "f0c49c30-e88c-332e-b7fb-3e706ef903b0",
                        "source_sense_description": "practitioner of judo",
                        "target_lang_word": "Judoka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judoka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fa8cfe2d-c679-3f84-938e-15932724c2ca",
                                        "entry_id": "913eaddd-2589-31ff-99d1-49ba2a9aaf54",
                                        "glosses": [
                                            "Person, die den Sport oder die Kampfkunst Judo betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "966b75ac-5a65-4e5e-9f92-3e6edb00480d",
                                                "sense_id": "fa8cfe2d-c679-3f84-938e-15932724c2ca",
                                                "text": "Bei den letzten Olympischen Spielen haben die Judokas viele Medaillen gewonnen."
                                            },
                                            {
                                                "example_id": "5616d477-d7fe-484f-8947-aa5a48047962",
                                                "sense_id": "fa8cfe2d-c679-3f84-938e-15932724c2ca",
                                                "text": "„Karl Joswig konnte und wollte er nicht als Hindernis ansehen, da Eddi Sillus es allein übernommen hatte, mit unserem Lieblingswärter fertig zu werden - Eddi, der schon früh den Meistergürtel der nordwestdeutschen Judokas erworben hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
