                "senses": [
                    {
                        "sense_id": "04b670f5-504a-3a2d-942a-b9160298bf09",
                        "entry_id": "a1ce4afd-2e16-34ff-a75c-035d06819f94",
                        "glosses": [
                            "имеющий узкое горлышко"
                        ],
                        "tags": [
                            "о сосуде"
                        ],
                        "examples": [
                            {
                                "example_id": "13e13eaf-2c17-40e1-9c1b-ecad383a5151",
                                "sense_id": "04b670f5-504a-3a2d-942a-b9160298bf09",
                                "text": "Он извлёк из-за жилета крошечный узкогорлый графинчик и рюмку и поставил их перед Кашинцевым."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ab25237-73d4-31a9-b0d3-5356634f471d",
                        "entry_id": "a1ce4afd-2e16-34ff-a75c-035d06819f94",
                        "glosses": [
                            "перен., разг. имеющий узкий вход, проход"
                        ],
                        "tags": [
                            "о заливе, бухте"
                        ],
                        "examples": [
                            {
                                "example_id": "cdac53d0-460e-4f5b-a385-65ee9dc83e7c",
                                "sense_id": "5ab25237-73d4-31a9-b0d3-5356634f471d",
                                "text": "В уме моем быстро проносится стих Гомера об узкогорлой черноморской бухте, в которой Одиссей видел кровожадных листригонов."
                            }
                        ]
                    }
