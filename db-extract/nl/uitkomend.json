        "nl-extract.jsonl": [
            {
                "entry_id": "b78e2000-df42-3f11-a469-e1329f9c6179",
                "word": "uitkomend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1bac5d08-6414-3373-96cb-61ad5a0db2eb",
                        "entry_id": "b78e2000-df42-3f11-a469-e1329f9c6179",
                        "glosses": [
                            "naar buiten komend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c7f115-22d9-4d17-9ff6-baf719329e1b",
                                "sense_id": "1bac5d08-6414-3373-96cb-61ad5a0db2eb",
                                "text": "Hij wipte de bal fraai over de uitkomende Borussia Dortmund-doelman Roman Bürki heen en maakte het af middels een halve omhaal: 2-0."
                            },
                            {
                                "example_id": "664c7e2b-2bf4-4739-901d-d78d3a313908",
                                "sense_id": "1bac5d08-6414-3373-96cb-61ad5a0db2eb",
                                "text": "Na drie minuten ging hij niet vrijuit bij een loopactie van Michel Vlap, die de uitkomende Timon Wellenreuther verraste met een prachtige voetbeweging."
                            }
                        ]
                    },
                    {
                        "sense_id": "dfa7aff3-1c00-3680-9ad8-559266fe6a9a",
                        "entry_id": "b78e2000-df42-3f11-a469-e1329f9c6179",
                        "glosses": [
                            "deelnemend, spelend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6afbf2d5-4b5b-41c9-8224-19ae3bd044f8",
                                "sense_id": "dfa7aff3-1c00-3680-9ad8-559266fe6a9a",
                                "text": "De spelers van de in de tweede divisie uitkomende Hardenbergers kunnen er in Derksens ogen niks van."
                            },
                            {
                                "example_id": "5282ef6a-503a-464f-a4d5-cc99e7d43d47",
                                "sense_id": "dfa7aff3-1c00-3680-9ad8-559266fe6a9a",
                                "text": "In de klasse tot 90 kilogram verloor Jesper Smink de strijd om het brons. De voor Spanje uitkomende judoka Nikoloz Sherazadisjvili was hem met ippon de baas."
                            }
                        ]
                    }
