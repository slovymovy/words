                "senses": [
                    {
                        "sense_id": "e7d813d7-5e03-36a2-8b8d-a23bcd12b2f7",
                        "entry_id": "26cff5dd-2eb3-31ff-a911-cf8948f04481",
                        "glosses": [
                            "in godsnaam: een uitdrukking van vertwijfeling, afsmeking of ergernis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "952be0c1-12c3-45a7-9062-cd1472f7153f",
                                "sense_id": "e7d813d7-5e03-36a2-8b8d-a23bcd12b2f7",
                                "text": "Maar als hij weer de boot in zou gaan met wiskunde, zou zijn vader hem doodslaan, beweerde hij. Thuis had hij gezegd dat het goed ging met wiskunde, want wat moest hij in godsnaam zeggen."
                            },
                            {
                                "example_id": "43aa47d0-654a-4bcb-b908-a547dbe0045d",
                                "sense_id": "e7d813d7-5e03-36a2-8b8d-a23bcd12b2f7",
                                "text": "Wat heeft dit er in godsnaam mee te maken?"
                            },
                            {
                                "example_id": "4a33189c-282a-42c8-ab2f-7f115590c9b5",
                                "sense_id": "e7d813d7-5e03-36a2-8b8d-a23bcd12b2f7",
                                "text": "En wat kon hij daar in godsnaam op antwoorden? Ze had een grote fles cognac in huis. En wat maakte het uit, het was nog vroeg."
                            }
                        ]
                    }
                ],
