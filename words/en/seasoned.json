                {
                    "sense_id": "2892fcdf-85a8-3476-9504-43b07521978e",
                    "sense_definition": "Having salt, herbs, spices, or other flavourings added to improve the taste.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef served a bowl of well <w>seasoned</w> soup to the guests.",
                            "target_lang_translations": {
                                "pl": "Szef kuchni podał gościom miskę dobrze <w>doprawionej</w> zupy."
                            }
                        },
                        {
                            "text": "You can add cooked vegetables to the <w>seasoned</w> rice for extra flavour.",
                            "target_lang_translations": {
                                "pl": "Możesz dodać ugotowane warzywa do <w>przyprawionego</w> ryżu, aby uzyskać lepszy smak."
                            }
                        }
                    ],
                    "synonyms": [
                        "flavoured",
                        "spiced"
                    ],
                    "antonyms": [
                        "unseasoned",
                        "bland"
                    ],
                    "common_phrases": [
                        "highly seasoned",
                        "well seasoned"
                    ],
                    "target_lang_definitions": {
                        "pl": "mający dodatek soli, ziół, przypraw lub innych dodatków smakowych dla poprawy smaku"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przyprawiony",
                                "target_lang_sense_clarification": "o potrawie z dodatkiem przypraw"
                            },
                            {
                                "target_lang_word": "doprawiony",
                                "target_lang_sense_clarification": "odpowiednio zaprawiony smakiem"
                            }
                        ]
