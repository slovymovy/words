                    {
                        "sense_id": "1cf61f3f-9403-383c-9636-7a4e801f8892",
                        "entry_id": "519e97bd-6704-3060-bb3e-3d1252185e56",
                        "glosses": [
                            "verbogen vorm van de overtreffende trap van oud"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "00691cf2-140b-4560-8932-45a5479432c9",
                                "sense_id": "1cf61f3f-9403-383c-9636-7a4e801f8892",
                                "text": "Mooie uitzichten, dorpen, kerken en pleintjes en de oudste olijvenpersfabriek van de streek."
                            },
                            {
                                "example_id": "cf23d32b-2bfb-4a80-ae44-01deae7feddc",
                                "sense_id": "1cf61f3f-9403-383c-9636-7a4e801f8892",
                                "text": "Ik vertel Nikki over de keer dat Casper en ik namens Van Alphen & Zoon samen de jaarlijkse MUHM bezochten, de grootste en oudste vastgoedbeurs van Europa, traditioneel gehouden in het Palais des Festivals in Cannes."
                            },
                            {
                                "example_id": "8da1f6ed-5d31-40ef-8adb-21a8102479e2",
                                "sense_id": "1cf61f3f-9403-383c-9636-7a4e801f8892",
                                "text": "Met mijn 43 jaar was ik duidelijk de oudste van het stel, de rest leek ergens tussen de twintig en vijfentwintig."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
