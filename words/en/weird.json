                                "target_lang_word": "怪癖",
                                "target_lang_sense_clarification": "独特的古怪习惯"
                            },
                            {
                                "target_lang_word": "古怪",
                                "target_lang_sense_clarification": "指代某种异于常人的特质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b9f53df-e4c2-3f3e-9e36-8fec7a95e35b",
                    "sense_definition": "Fate or destiny.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fate_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero went forth to meet his <w>weird</w>.",
                            "target_lang_translations": {
                                "ru": "Герой отправился навстречу своему <w>ро́ку</w>.",
                                "tr": "Kahraman, kendi <w>kaderiyle</w> yüzleşmek için yola çıktı.",
                                "zh": "英雄出发去迎接他的<w>宿命</w>。"
                            }
                        },
                        {
                            "text": "He felt he could not escape his <w>weird</w>.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что не может уйти от своей <w>судьбы́</w>.",
                                "tr": "Kendi <w>yazgısından</w> kaçamayacağını hissetti.",
                                "zh": "他感到自己无法逃脱<w>命运</w>的安排。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fate",
                        "destiny",
                        "doom"
                    ],
                    "traits": [
