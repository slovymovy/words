                ],
                "senses": [
                    {
                        "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                        "entry_id": "51818d44-b3b7-35a6-b604-20165f1da960",
                        "glosses": [
                            "zentraler, zumeist auf einem Markt stehender, senkrechter, gestalteter Pfeiler der das Marktrecht der Stadt symbolisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5b8e007-ac04-4039-a5b1-1b84254d4143",
                                "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                                "text": "„Obwohl Marktsäulen eigentlich hoheitsrechtliche Denkmäler darstellen, wurden diese mit dem Pranger zusammengelegt, da eine Unterscheidung zwischen dem Pranger als Zeichen der Gerichtsbarkeit und der Marktsäule, als Zeichen der Marktfreiheit, schwer zu definieren ist.“"
                            },
                            {
                                "example_id": "284c01b4-8d9e-4d3d-a4d7-90c92f388204",
                                "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                                "text": "„Die alte Marktsäule mit dem alten Marktbrunnen zeugen von der Vergangenheit.“"
                            },
                            {
                                "example_id": "875d0ddb-e1a1-461a-9b1f-08e6362727d8",
                                "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                                "text": "„Die mittelalterliche „Marktsäule” soll erinnern an die Stadtrechte seit 1273, an den Bürgerfleiß mit eigenen „Marktrechten” in einem Marktflecken, der Mittelpunkt eines großen Verwaltungsbezirkes mit Sitz auf der Burg Wassenberg war."
                            },
                            {
                                "example_id": "52dd6797-a772-4ccd-827d-5bb91b2bc0c6",
                                "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                                "text": "„1957 Auftrag der Gemeinde, anlässlich der Wiederverleihung des Marktrechtes eine Marktsäule mit Wappen zu gestalten.“"
                            },
                            {
                                "example_id": "d3c872b0-7ac8-455d-a109-596f4a85ca8e",
                                "sense_id": "d9ead804-f222-3dab-9b27-bb3f95079e12",
                                "text": "„Die Marktsäule symbolisiert das mittelalterliche Marktrecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
