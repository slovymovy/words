        "fr-extract.jsonl": [
            {
                "entry_id": "89f78a72-9aaf-3905-a0a8-651e2fdab894",
                "word": "scoumoune",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "14c28c5c-e6e3-4fb4-b0c4-4515e5b132cd",
                        "entry_id": "89f78a72-9aaf-3905-a0a8-651e2fdab894",
                        "tags": [
