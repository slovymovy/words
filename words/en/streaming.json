{
    "word_family": [
        "stream",
        "streamer",
        "streamline",
        "mainstream",
        "downstream",
        "upstream"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ab54bcb9-d966-371d-a95f-41284da415d8",
                    "sense_definition": "Present participle and gerund of <w>stream</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tears were <w>streaming</w> down her face as she laughed.",
                            "target_lang_translations": {
                                "ru": "Слёзы <w>текли</w> по её лицу, когда она смеялась.",
                                "zh": "她大笑时，眼泪止不住地顺着脸颊<w>流</w>了下来。"
                            }
                        },
                        {
                            "text": "The morning sunlight came <w>streaming</w> through the open window.",
                            "target_lang_translations": {
                                "ru": "Утренний солнечный свет <w>струился</w> через открытое окно.",
                                "zh": "晨光透过开着的窗户<w>涌入</w>室内。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола stream.",
                        "zh": "动词 stream 的现在分词和动名词形式，表示流淌、涌入或倾泻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течь",
                                "target_lang_sense_clarification": "двигаться потоком"
                            },
                            {
                                "target_lang_word": "литься",
                                "target_lang_sense_clarification": "течь струей"
                            },
                            {
                                "target_lang_word": "струиться",
                                "target_lang_sense_clarification": "плавно течь (о свете или жидкости)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流淌",
                                "target_lang_sense_clarification": "液体流动"
                            },
                            {
                                "target_lang_word": "涌入",
                                "target_lang_sense_clarification": "光线或人群倾泻、涌动"
                            },
                            {
                                "target_lang_word": "流",
                                "target_lang_sense_clarification": "眼泪等液体流出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c36b97e4-ffe2-3fdb-829a-ae2d5f0f4fdc",
                    "sense_definition": "The continuous transmission of digital audio or video for immediate playback without permanent storage.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "digital_media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We subscribed to a new <w>streaming</w> service to watch the latest movies.",
                            "target_lang_translations": {
                                "ru": "Мы подписались на новый сервис <w>стриминга</w>, чтобы смотреть последние фильмы.",
                                "zh": "我们订阅了一个新的<w>流媒体</w>服务来看最新的电影。"
                            }
                        },
                        {
                            "text": "The quality of the <w>streaming</w> depends heavily on your internet speed.",
                            "target_lang_translations": {
                                "ru": "Качество <w>стриминга</w> сильно зависит от скорости вашего интернета.",
                                "zh": "<w>流媒体</w>播放的质量很大程度上取决于你的网速。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "streaming service",
                        "live streaming",
                        "video streaming",
                        "music streaming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывная передача цифрового аудио или видео для немедленного воспроизведения без постоянного сохранения.",
                        "zh": "（音频或视频的）流式传输，流媒体播放。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стриминг",
                                "target_lang_sense_clarification": "технология передачи данных"
                            },
                            {
                                "target_lang_word": "потоковое вещание",
                                "target_lang_sense_clarification": "трансляция контента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流媒体",
                                "target_lang_sense_clarification": "流式多媒体传输技术"
                            },
                            {
                                "target_lang_word": "流式传输",
                                "target_lang_sense_clarification": "数据连续传输技术"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5bfc9be-9af5-3ff8-8595-9bfce8001c59",
                    "sense_definition": "The practice of grouping students into classes based on their academic ability.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "education_grouping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school adopted <w>streaming</w> to help students learn at a pace that suits them.",
                            "target_lang_translations": {
                                "ru": "Школа внедрила <w>распределение по потокам</w>, чтобы помочь ученикам учиться в подходящем для них темпе.",
                                "zh": "学校采取了<w>按能力分班</w>的方式，以帮助学生按适合自己的节奏学习。"
                            }
                        },
                        {
                            "text": "Critics argue that academic <w>streaming</w> can disadvantage students placed in lower groups.",
                            "target_lang_translations": {
                                "ru": "Критики утверждают, что академическое <w>распределение по группам</w> может поставить в невыгодное положение учеников, попавших в более слабые группы.",
                                "zh": "批评人士认为，学业<w>分流制</w>可能会让分在较差班级的学生处于不利地位。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tracking"
                    ],
                    "common_phrases": [
                        "academic streaming",
                        "ability streaming"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика распределения учеников по классам на основе их академических способностей.",
                        "zh": "（按学生能力）分流，分层编班，按能力分班。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распределение по потокам",
                                "target_lang_sense_clarification": "в образовании"
                            },
                            {
                                "target_lang_word": "дифференцированное обучение",
                                "target_lang_sense_clarification": "педагогический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "按能力分班",
                                "target_lang_sense_clarification": "教育体制中的分流制度"
                            },
                            {
                                "target_lang_word": "分流制",
                                "target_lang_sense_clarification": "按学业能力分流"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "778f8d33-2bdb-336e-a3e5-492ec736f181",
                    "sense_definition": "The act of flowing or moving continuously in a current.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "flowing_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>streaming</w> of the crowd through the narrow gates was unstoppable.",
                            "target_lang_translations": {
                                "ru": "<w>Поток</w> толпы через узкие ворота был неудержим.",
                                "zh": "人群穿过狭窄大门的<w>涌动</w>势不可挡。"
                            }
                        },
                        {
                            "text": "He watched the steady <w>streaming</w> of rain against the glass.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал за непрерывным <w>течением</w> дождя по стеклу.",
                                "zh": "他看着雨水在玻璃上持续不断的<w>流淌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс непрерывного течения или движения в потоке.",
                        "zh": "流动，涌动，连绵不断的涌流。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "течение",
                                "target_lang_sense_clarification": "процесс движения жидкости"
                            },
                            {
                                "target_lang_word": "поток",
                                "target_lang_sense_clarification": "движущаяся масса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涌动",
                                "target_lang_sense_clarification": "人群或物体的连绵流动"
                            },
                            {
                                "target_lang_word": "流淌",
                                "target_lang_sense_clarification": "液体的流动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "609d97b0-000f-3f06-8a03-a5ca658a5939",
                    "sense_definition": "The process of working alluvial deposits to extract ore.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mining_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners used <w>streaming</w> to separate the tin from the riverbed soil.",
                            "target_lang_translations": {
                                "ru": "Шахтёры использовали <w>промывку</w>, чтобы отделить олово от грунта русла реки.",
                                "zh": "矿工们利用<w>淘洗</w>的方法把锡从河床泥沙中分离出来。"
                            }
                        },
                        {
                            "text": "Traditional <w>streaming</w> methods have largely been replaced by modern machinery.",
                            "target_lang_translations": {
                                "ru": "Традиционные методы <w>промывки</w> были в значительной степени заменены современным оборудованием.",
                                "zh": "传统的<w>水力淘选</w>方法已基本被现代机械所取代。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mining context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс обработки аллювиальных отложений для извлечения руды.",
                        "zh": "（采矿中用流水冲选冲积砂矿以提取矿石的）淘选，淘洗。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промывка",
                                "target_lang_sense_clarification": "горное дело"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "淘洗",
                                "target_lang_sense_clarification": "用水冲洗冲积砂矿"
                            },
                            {
                                "target_lang_word": "水力淘选",
                                "target_lang_sense_clarification": "重力选矿方法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "710384bd-5635-3507-a8c6-b8f09cb94419",
                    "sense_definition": "Flowing or moving in continuous succession, like fluid in a stream.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flowing_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She stayed home from work because she had a <w>streaming</w> cold.",
                            "target_lang_translations": {
                                "ru": "Она осталась дома и не пошла на работу, потому что у неё был <w>сильный</w> насморк.",
                                "zh": "她因为得了<w>流涕不止的</w>重感冒而待在家里没有上班。"
                            }
                        },
                        {
                            "text": "He wiped his <w>streaming</w> eyes with a tissue after chopping onions.",
                            "target_lang_translations": {
                                "ru": "Он вытер свои <w>слезящиеся</w> глаза салфеткой после нарезки лука.",
                                "zh": "切完洋葱后，他用纸巾擦了擦<w>流泪不止的</w>眼睛。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flowing",
                        "running"
                    ],
                    "common_phrases": [
                        "streaming cold",
                        "streaming eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Текущий или движущийся непрерывной чередой, подобно жидкости в ручье.",
                        "zh": "不断流淌的；不断流泪或流鼻涕的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "текущий",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "слезящийся",
                                "target_lang_sense_clarification": "о глазах"
                            },
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о насморке (переносное значение)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流涕不止的",
                                "target_lang_sense_clarification": "形容重感冒等流鼻涕状态"
                            },
                            {
                                "target_lang_word": "流泪不止的",
                                "target_lang_sense_clarification": "形容眼睛大量流泪"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}