                                    {
                                        "sense_id": "2b05c359-15b2-3bc8-9013-5dfdb4fd251a",
                                        "entry_id": "b8a72b04-9b2c-38dc-9f16-7a55be3af35f",
                                        "glosses": [
                                            "een eicel voordat het eerste poollichaampje gevormd wordt"
                                        ],
