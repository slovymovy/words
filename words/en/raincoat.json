    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ec31933-7291-38e2-8782-e5c586b26ef7",
                    "sense_definition": "A waterproof coat to be worn in the rain.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't forget to bring your <w>raincoat</w> because the weather forecast predicts heavy showers this afternoon.",
                            "target_lang_translations": {
                                "ru": "Не забудь взять свой <w>дождевик</w>, потому что прогноз погоды обещает сильные ливни сегодня днем."
                            }
                        },
                        {
                            "text": "She put on a yellow <w>raincoat</w> to stay dry while walking to the bus stop.",
                            "target_lang_translations": {
                                "ru": "Она надела желтый <w>плащ</w>, чтобы не промокнуть по дороге к автобусной остановке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "yellow raincoat",
                        "waterproof raincoat",
                        "wear a raincoat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Водонепроницаемое пальто или накидка, предназначенные для защиты от дождя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дождевик",
                                "target_lang_sense_clarification": "непромокаемая накидка или легкое пальто"
                            },
                            {
                                "target_lang_word": "плащ",
                                "target_lang_sense_clarification": "верхняя одежда из плотной или непромокаемой ткани"
                            },
                            {
                                "target_lang_word": "макинтош",
                                "target_lang_sense_clarification": "прорезиненный плащ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "206eadb4-6c06-3ccb-b924-017680199880",
                    "sense_definition": "A condom.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contraception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The song lyrics mentioned using a <w>raincoat</w> as a metaphor for practicing safe sex.",
                            "target_lang_translations": {
                                "ru": "В тексте песни упоминалось использование <w>дождевика</w> как метафора безопасного секса."
                            }
                        },
                        {
                            "text": "In some informal contexts, people might use the word <w>raincoat</w> when they are talking about protection.",
                            "target_lang_translations": {
                                "ru": "В некоторых неформальных контекстах люди могут использовать слово <w>дождевик</w>, когда говорят о защите."
                            }
                        }
                    ],
                    "synonyms": [
                        "condom",
                        "rubber"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal metaphorical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сленговое обозначение презерватива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резинка",
                                "target_lang_sense_clarification": "разговорный сленг для контрацепции"
                            },
                            {
                                "target_lang_word": "чехол",
                                "target_lang_sense_clarification": "метафорическое сленговое название"
                            }
                        ]
                    }
                }
            ]
        }
    ]
