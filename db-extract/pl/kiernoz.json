                "senses": [
                    {
                        "sense_id": "7b545312-34c2-3e5d-b83c-b87d6f0c2490",
                        "entry_id": "429b7c17-8785-37d7-9ebd-832379e032ee",
                        "glosses": [
                            "samiec świni domowej"
                        ],
                        "tags": [
                            "zootechn."
                        ],
                        "examples": [
                            {
                                "example_id": "5ddbd3a3-6247-402d-be17-6a451d952b82",
                                "sense_id": "7b545312-34c2-3e5d-b83c-b87d6f0c2490",
                                "text": "Razu jednego zjechał tu z rycerstwem i pachołkami wielki Książę na polowanie i ubili niesłychanej wielkości kiernoza"
                            },
                            {
                                "example_id": "007be7f1-ba16-4109-8280-22844fe329ae",
                                "sense_id": "7b545312-34c2-3e5d-b83c-b87d6f0c2490",
                                "text": "Patrzajże zasię na koszt a na dziwną utratę wymyślnych potraw naszych, jeśliże to nie jest wielka przyczyna niepobożnego żywota naszego (…) Patrz na owy rozmaite przysmaki, co je sapory zowią, a prawie sapory, bo chłop po nich sapi, ożarszy się, jako w barłogu kiernoz"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
