                        "form_id": "4d0415b3-4d9d-4853-b1c1-eab332f85e09",
                        "entry_id": "ec56d021-c784-343d-b014-e5e8015cf887",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "chimpanseetjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5cb3fb7-53f4-372d-b528-e32c0b437b01",
                        "entry_id": "ec56d021-c784-343d-b014-e5e8015cf887",
                        "glosses": [
                            "Pan troglodytes een Afrikaanse mensaap. Zijn nauwste verwant is de dwergchimpansee of bonobo (Pan paniscus). Beide chimpansees worden beschouwd als de nauwste nog levende verwanten van de mens. Sommige wetenschappers beschouwen de relatie tussen mens en chimpansee op basis van DNA-onderzoek als nauw genoeg om de chimpansee en de bonobo net als de mens in het geslacht Homo te plaatsen"
                        ],
                        "tags": [
                            "primaten"
                        ],
                        "examples": [
                            {
                                "example_id": "65f881e2-5532-4610-8587-6f9541413999",
                                "sense_id": "b5cb3fb7-53f4-372d-b528-e32c0b437b01",
                                "text": "Chimpansees zijn nauwer verwant aan mensen dan aan gorilla's."
                            },
                            {
                                "example_id": "9c164c9b-34a6-4f33-b56c-f949e23b4cb4",
                                "sense_id": "b5cb3fb7-53f4-372d-b528-e32c0b437b01",
                                "text": "Chimpanseemannetjes vermoorden soms ook leden van naburige groepen om hun eigen territorium uit te breiden. Daarbij vermoorden ze vaak jonge dieren omdat die een gemakkelijker doelwit zijn"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01e04ba3-ecd9-47d4-91a6-3e506294063c",
                        "source_entry_id": "ec56d021-c784-343d-b014-e5e8015cf887",
                        "source_sense_id": "b5cb3fb7-53f4-372d-b528-e32c0b437b01",
                        "source_sense_description": "Pan troglodytes, de meest aan de mens verwante mensaap, leeft in Centraal-Afrika",
                        "target_lang_word": "Schimpanse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schimpanse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55623548-f377-39fd-a387-ca94d4739747",
                                        "entry_id": "086d0cc0-7cd7-3555-b37c-44769f39c15c",
                                        "glosses": [
                                            "Vertreter der gleichnamigen Gattung von Menschenaffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff240631-ad77-46fb-b86e-3dc85c06a900",
                                                "sense_id": "55623548-f377-39fd-a387-ca94d4739747",
                                                "text": "„Dass Schimpansen heute als machiavellische Machtfanatiker gelten und Bonobos als Kreuzung zwischen Dalai Lama und Alice Schwarzer, ließ sich in den Frühjahren der Primatologie keineswegs vorhersehen. Denn zunächst waren Schimpansen Sympathieträger – dank Jane Goodall, die 1960 begann, sie in der Wildnis zu erforschen. … Goodall war schockiert, als ihre geliebten Schimpansen um 1974 begannen, einander zu töten. … Die Primatologen-Pionierin war ehrlich genug, Aggressionen detailgetreu zu dokumentieren … “"
                                            },
                                            {
                                                "example_id": "28e00c83-23e0-4305-9144-71cae9529caf",
                                                "sense_id": "55623548-f377-39fd-a387-ca94d4739747",
                                                "text": "„Quicklebendige Schimpansen wurden innerhalb von dreißig Sekunden durch Stimulierung ihres Septumbereiches in Schlaf versetzt.“"
                                            },
                                            {
                                                "example_id": "78c6de63-ac96-49e1-ac4f-26525266986e",
                                                "sense_id": "55623548-f377-39fd-a387-ca94d4739747",
                                                "text": "„Zwei Schimpansen, die einander nie gesehen, nie mit einander gekämpft und einander nie die Läuse aus dem Pelz gesucht haben, wissen nicht, ob sie einander über den Weg trauen können, ob es sich lohnt, dem anderen zu helfen, oder welcher der beiden in der Rangordnung über dem anderen steht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37b7d60e-86b7-4ad1-bf46-1f29a476c9ce",
                        "source_entry_id": "ec56d021-c784-343d-b014-e5e8015cf887",
