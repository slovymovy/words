                    {
                        "translation_id": "a392158b-bed2-46a6-aa76-00e1e67016fd",
                        "source_entry_id": "6036d06f-61a8-34c3-8cdd-42cb319810bb",
                        "source_sense_id": "7e1fb040-2055-3253-b9b8-945f5ebc3105",
                        "target_lang_word": "skep",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e18f7de8-9b52-3f49-96ec-54dfd1c28b07",
                                        "entry_id": "bfb6ae91-1981-3120-ae04-10697fe0477a",
                                        "glosses": [
                                            "A basket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67b13155-c909-4275-a224-75ba926709b6",
                                                "sense_id": "e18f7de8-9b52-3f49-96ec-54dfd1c28b07",
                                                "text": "Old women crouched over bags of Siamese rice, skeps of red and green peppers, purple egg-plants, bristly rambutans, pineapples, durians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30c9ae1e-8f59-39da-bcb1-479304cae7fc",
                                        "entry_id": "bfb6ae91-1981-3120-ae04-10697fe0477a",
                                        "glosses": [
                                            "A beehive made of straw or wicker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d4491cb-d11f-4a3f-9fb5-f46d13fbc088",
                                                "sense_id": "30c9ae1e-8f59-39da-bcb1-479304cae7fc",
                                                "text": "Three of the hives had been overturned and the others had been rocked to and fro. The modern hive is a fearful thing to upset; the combs are not static as in a skep, but hang loosely: when the hive is overturned they smash and pile up like a telescoped train."
                                            },
                                            {
                                                "example_id": "90da667d-4fbd-42ec-98be-5645f0c9e2b7",
                                                "sense_id": "30c9ae1e-8f59-39da-bcb1-479304cae7fc",
                                                "text": "He prised a skep from its stool and held it out, inverted, showing the dirty wreck of combs, with the vile grubs spinning their cocoons."
                                            },
                                            {
                                                "example_id": "e89ad1da-6136-445a-88da-2f9b39a197c2",
                                                "sense_id": "30c9ae1e-8f59-39da-bcb1-479304cae7fc",
                                                "text": "She installs seven skeps at the furthest edge of the garden; on warm July days it is possible to hear the restless rumble of the bees from the house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "skep",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "119d4835-2c79-3680-b91a-67e49fb1edec",
                                        "entry_id": "bc00eb8e-1ded-3057-a4a5-585a4321f971",
                                        "glosses": [
                                            "To transfer (bees) into a skep."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
