                                "target_senses": [
                                    {
                                        "sense_id": "bcfbf8a3-b5b7-3d4f-86a8-cc3fb3bd6846",
                                        "entry_id": "9d319f50-e661-37f2-bf14-814b0b233bb2",
                                        "glosses": [
                                            "Pays d’Asie, bordé à l’ouest par l’océan Indien et la Birmanie, au nord-est par le Laos, à l'est par le Cambodge et au sud par le golfe de Thaïlande et la Malaisie, et dont la capitale est Bangkok."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9006cdcd-0fd8-4c90-ae66-24153006f1de",
                                                "sense_id": "bcfbf8a3-b5b7-3d4f-86a8-cc3fb3bd6846",
                                                "text": "Joséphine Japy, Jérôme Commandeur, François Damiens et Benoît Magimel l’ont accompagné, en Thaïlande, pour ce film aussi spectaculaire que drôle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12bc51c1-a47b-4316-82bb-974104f7ce72",
                        "source_entry_id": "2b5763f0-3aba-350e-8ffe-8532aae50a3b",
                        "source_sense_description": "country in Southeast Asia",
