                    {
                        "translation_id": "68e51f19-fe29-4a52-8010-3aec66c819ca",
                        "source_entry_id": "75fc1ba3-f2d5-3ea2-a685-4449a7763024",
                        "source_sense_id": "d6762689-8cef-3ba9-be25-1f03353bb82a",
                        "target_lang_word": "identifier",
