                                        "sense_id": "b0d23ff0-f103-3b4f-a133-1106d70ca9ef",
                                        "entry_id": "cd790592-29d8-3725-b370-e312467a4c1d",
                                        "glosses": [
                                            "Warning of bad consequences: ill-boding; portentous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f1e5b87-aa3f-4226-a03b-d080193f4d6f",
                                                "sense_id": "b0d23ff0-f103-3b4f-a133-1106d70ca9ef",
                                                "text": "dire omens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24861e4a-e44d-3cbf-acf5-5799df668c4f",
                                        "entry_id": "cd790592-29d8-3725-b370-e312467a4c1d",
                                        "glosses": [
                                            "Requiring action to prevent bad consequences: urgent, pressing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c08fb4d-97ee-4f9f-b27c-34c8ef31c5c2",
                                                "sense_id": "24861e4a-e44d-3cbf-acf5-5799df668c4f",
                                                "text": "dire need (of)"
                                            },
                                            {
                                                "example_id": "703f2c13-3f1b-41ac-b95f-32782264b732",
                                                "sense_id": "24861e4a-e44d-3cbf-acf5-5799df668c4f",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains.[…]But out of sight is out of mind. And that, together with the inherent yuckiness of the subject, means that many old sewers have been neglected and are in dire need of repair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9683684c-c260-3c93-8718-d96a277e1689",
                                        "entry_id": "cd790592-29d8-3725-b370-e312467a4c1d",
                                        "glosses": [
                                            "Expressing bad consequences: dreadful; dismal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6afc2d3b-6109-44b0-82a0-9dee787d8c8d",
                                                "sense_id": "9683684c-c260-3c93-8718-d96a277e1689",
                                                "text": "dire consequences;  to be in dire straits"
                                            },
                                            {
                                                "example_id": "626f09f8-9d55-4db0-a4a1-02cb99e95039",
                                                "sense_id": "9683684c-c260-3c93-8718-d96a277e1689",
                                                "text": "Cristiana Paşca Palmer, the executive secretary of the UN Convention on Biological Diversity, said the destruction of the world’s biggest rainforest was a grim reminder that a fresh approach needed to stabilise the climate and prevent ecosystems from declining to a point of no return, with dire consequences for humanity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9c044e-7e67-3484-bb57-57ae80839514",
                                        "entry_id": "cd790592-29d8-3725-b370-e312467a4c1d",
                                        "glosses": [
                                            "Bad in quality, awful, terrible."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8c9892e-a417-45ba-9dc9-234daff83ddf",
                                                "sense_id": "1e9c044e-7e67-3484-bb57-57ae80839514",
                                                "text": "His dire blunder allowed her to checkmate him with her next move."
                                            },
                                            {
                                                "example_id": "d68438e0-3034-493c-ace1-551d81dc1124",
                                                "sense_id": "1e9c044e-7e67-3484-bb57-57ae80839514",
                                                "text": "A second Norwich goal in four minutes arrived after some dire Newcastle defending. Gosling gave the ball away with a sloppy back-pass, allowing Crofts to curl in a cross that the unmarked Morison powered in with a firm, 12-yard header."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38222d73-f973-3d3c-b79d-3378e689a843",
                                        "entry_id": "cd790592-29d8-3725-b370-e312467a4c1d",
                                        "glosses": [
                                            "Ferocious and of intimidating appearance, like a dire wolf."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
