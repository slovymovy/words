                "senses": [
                    {
                        "sense_id": "8a63e15d-e95e-3f91-8b09-381e30ace7df",
                        "entry_id": "a2b8c554-4714-3be1-90e0-685cf3bdee62",
                        "glosses": [
                            "Donner un caractère archéologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35c0fcc0-a8e0-4dd9-9d8d-6c67bd71c583",
                                "sense_id": "8a63e15d-e95e-3f91-8b09-381e30ace7df",
                                "text": "Un catalogage est fréquemment (pas toujours, c’est le cas par exemple des collectionneurs) un acte a posteriori, qui risque d’archéologiser une fois pour toutes les matériaux déposés."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d11f0e3-f78b-373c-ae6d-5fccc03dc7b9",
                        "entry_id": "a2b8c554-4714-3be1-90e0-685cf3bdee62",
                        "glosses": [
                            "Pratiquer l’archéologie."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "56ec8351-b1d5-425a-8d5e-20dc3509a0de",
                                "sense_id": "6d11f0e3-f78b-373c-ae6d-5fccc03dc7b9",
                                "text": "Je ne prétends pas posséder toutes ces bonnes qualités, mais (et pour cause) j’opte pour cette façon d’archéologiser, et laisse à mes doctes collègues tous les traités des Caylus, des Winkelmann et des Montfaucon."
                            }
                        ]
                    }
