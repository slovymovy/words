                                    {
                                        "sense_id": "dab60407-958e-3a07-9ca1-beadfe5fd628",
                                        "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                                        "glosses": [
                                            "Méthode descriptive des sciences sociales consistant à observer et à décrire, sur le terrain, les modes de vie, pratiques et représentations d’un groupe humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3baa28d-77ab-4084-99b2-36a4fca19b41",
                                                "sense_id": "dab60407-958e-3a07-9ca1-beadfe5fd628",
                                                "text": "Rien de moins étonnant, dès lors, que de retrouver notre infatigable voyageur visitant de 1855 à 1857 tout l'ouest du Tibet en compagnie des frères Schlagintweit, et rapportant de cette exploration de curieuses observations d'ethnographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921a8160-7cec-3c3e-bba1-5f2606eb143a",
                                        "entry_id": "fcdc41b5-e8c2-3bef-854f-8466b8095336",
                                        "glosses": [
                                            "Le rapport ou l’étude résultant de ce travail."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "632beadc-d9dd-4fc1-96cd-987eb8cb8bf2",
                                                "sense_id": "921a8160-7cec-3c3e-bba1-5f2606eb143a",
                                                "text": "Il est certain que les représentations iconographiques ou littéraires permettent de mettre en lumière une ethnographie parisienne."
                                            }
                                        ]
                                    }
                                ]
                            },
