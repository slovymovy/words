                            {
                                "example_id": "9fa52d1f-f90d-4046-a8ce-cbfe2b4472ab",
                                "sense_id": "45ed4287-e27e-318f-ae87-04710e08e983",
                                "text": "Maar volgens de NZa laat de praktijk zien dat er sinds 2013 geen grote problemen zijn ontstaan bij het gehandicaptenvervoer. De continuïteit van zorg loopt geen gevaar en de minimumkwaliteit van het vervoer is niet in het geding, aldus de NZa. Ze gaan de tarieven pas in 2019 opnieuw bekijken. Volgens de gehandicaptenorganisaties is dat te laat."
                            },
                            {
                                "example_id": "df5114ad-fe7b-4842-9174-92b92c4f01bf",
                                "sense_id": "45ed4287-e27e-318f-ae87-04710e08e983",
                                "text": "Een soort SnappCar maar dan speciaal voor gehandicaptenvervoer."
                            },
                            {
                                "example_id": "0cbf7be1-a942-4727-a0cc-924a54a66fec",
                                "sense_id": "45ed4287-e27e-318f-ae87-04710e08e983",
                                "text": "VGN-directeur Schirmbeck: \"De vergoedingen voor gehandicaptenvervoer aan onze leden worden meer dan gehalveerd en zijn niet meer kostendekkend. Het gevolg is dat het vervoer moet stoppen, waardoor cliënten in een volstrekt isolement terechtkomen.\""
                            }
                        ]
