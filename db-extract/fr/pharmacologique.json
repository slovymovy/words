                            {
                                "example_id": "49794209-6ff6-420a-9913-8a8bc8ecf28a",
                                "sense_id": "6398fda8-47e3-3d0a-af0f-f3b423d555df",
                                "text": "Le rôle du Conseil du médicament est de formuler des recommandations au ministre au sujet des médicaments à inscrire sur la liste des produits pharmacologiques couverts par le régime d'assurance publique."
                            },
                            {
                                "example_id": "b26c0831-f70f-4742-b987-0fd62944cdaa",
                                "sense_id": "6398fda8-47e3-3d0a-af0f-f3b423d555df",
                                "text": "Le traitement hygiéno-diététique de l’ulcère gastroduodénal a été balayé par le traitement pharmacologique."
                            },
                            {
                                "example_id": "d8c72c97-ab1f-4127-b116-5124de0cf344",
                                "sense_id": "6398fda8-47e3-3d0a-af0f-f3b423d555df",
                                "text": "Il est le plus souvent considéré comme l’émergence d’une pensée médicale et pharmacologique dans un univers religieux ou magique."
                            }
                        ]
