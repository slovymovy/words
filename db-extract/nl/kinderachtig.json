                ],
                "senses": [
                    {
                        "sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                        "entry_id": "f5653e04-5a97-3e6d-9849-61304707ff00",
                        "glosses": [
                            "zich niet als volwassene gedragend alsof men nog een kind is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1387fa7-5256-47a3-b572-1536300f3326",
                                "sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                                "text": "Hij is een grote kerel, maar hij kan soms de kinderachtigste streken uithalen."
                            },
                            {
                                "example_id": "d4fb0325-e2b4-4f93-8368-481881875963",
                                "sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                                "text": "Wij waren een cocktail van uitersten (in willekeurige volgorde): rustig, uitgesproken en luidruchtig. Drugs, alcohol en water. Wild, voorzichtig en nieuwsgierig. Levend in het verleden in het heden en in de toekomst. De entertainer, de charmeur en de verleider. Kinderachtig, zorgzaam en met een luisterend oor. Totaal geen overeenkomsten."
                            },
                            {
                                "example_id": "a41b5c5c-b3c1-417a-9027-a3ebcc405ac0",
                                "sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                                "text": "Het is onduidelijk wie de video heeft gemaakt. De tv-zender waarop de video te zien was, schreef op Facebook te zijn gehackt. Zelensky plaatste snel na het verschijnen van de nepvideo een echte video op Instagram. Hij noemt de deepfake daarin een \"kinderachtige Russische provocatie\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70555c45-ad1c-4a04-ac60-8796fbe9313c",
                        "source_entry_id": "f5653e04-5a97-3e6d-9849-61304707ff00",
                        "source_sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                        "source_sense_description": "zich niet als volwassene gedragend alsof men nog een kind is",
                        "target_lang_word": "kindisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kindisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e4081c-3533-3f73-8db4-8c3a5ece6d01",
                                        "entry_id": "32622d52-81e6-33d6-9aae-7e77feac4e00",
                                        "glosses": [
                                            "sich wie ein kleines Kind verhaltend"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7e23638-0872-4a01-99df-10505ad833f2",
                                                "sense_id": "d3e4081c-3533-3f73-8db4-8c3a5ece6d01",
                                                "text": "Obwohl er bereits auf die vierzig zugeht, kann er manchmal so kindisch sein, dass man kein normales Gespräch mit ihm führen kann."
                                            },
                                            {
                                                "example_id": "ada64c31-7cb9-4d92-b9d8-bffb8f74c77a",
                                                "sense_id": "d3e4081c-3533-3f73-8db4-8c3a5ece6d01",
                                                "text": "Hier auf dem Dom in einem Karussell zu sitzen, bereitete ihr ein kindisches Vergnügen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9af0e9d-944a-4b9a-b19c-e4095efae932",
                        "source_entry_id": "f5653e04-5a97-3e6d-9849-61304707ff00",
                        "source_sense_id": "b4d9cdb7-ef5e-3325-a1b0-d2c47fe70083",
                        "source_sense_description": "zich niet als volwassene gedragend alsof men nog een kind is",
                        "target_lang_word": "childish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "childish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "608b5e49-1f02-39b3-81a4-22a49d9e1190",
                                        "entry_id": "88da9a64-8ae3-35ca-813a-28d80ccacb1c",
                                        "glosses": [
                                            "Immature in thought or behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ca4da54-61a5-4964-92f1-cb0bf88439ae",
                                                "sense_id": "608b5e49-1f02-39b3-81a4-22a49d9e1190",
                                                "text": "Your childish temper tantrums are not going to change my decision on this matter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                        "entry_id": "88da9a64-8ae3-35ca-813a-28d80ccacb1c",
                                        "glosses": [
                                            "Suitable for or expected of a child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab1c81a-f3c6-455b-bfea-1415295d2920",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "This game is very childish."
                                            },
                                            {
                                                "example_id": "bc258e84-226a-4eb4-ad81-ccb085a977a7",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "She remembered, too, when, after a long childish illness, her father had carried her in his arms to the garden, […]"
                                            },
                                            {
                                                "example_id": "d1f4b3f1-908a-400a-b562-f6856742b936",
                                                "sense_id": "79e8af5e-50b7-3da3-b321-00fdbc639ae5",
                                                "text": "As I walked to and fro daily between Southwark and Blackfriars, and lounged about at meal-times in obscure streets, the stones of which may, for anything I know, be worn at this moment by my childish feet, I wonder how many of these people were wanting in the crowd that used to come filing before me in review again, to the echo of Captain Hopkins’s voice!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0f0288cb-9d3c-45db-9c18-bad7cf77f997",
                        "source_entry_id": "f5653e04-5a97-3e6d-9849-61304707ff00",
