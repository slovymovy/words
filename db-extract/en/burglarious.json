                        "examples": [
                            {
                                "example_id": "eca649fe-b4f1-49f8-b84b-1b60e0b7fa05",
                                "sense_id": "6b140781-842f-3e6b-8368-7cfadc9b4dbe",
                                "text": "At nine o'clock on such a morning, the place of business of Pubsey and Co. was not the liveliest object even in Saint Mary Axe--which is not a very lively spot--with a sobbing gaslight in the counting-house window, and a burglarious stream of fog creeping in to strangle it through the keyhole of the main door."
                            },
                            {
                                "example_id": "0b239dca-5065-47b6-b296-7fc5328d3103",
                                "sense_id": "6b140781-842f-3e6b-8368-7cfadc9b4dbe",
                                "text": "He felt what a great advantage it was to be forewarned of the impending danger, since being forewarned was forearmed, as with the help of the police he could prepare for his burglarious visitors."
                            },
                            {
                                "example_id": "5e17457f-a76d-46f8-9a3e-af21ec03ae42",
                                "sense_id": "6b140781-842f-3e6b-8368-7cfadc9b4dbe",
                                "text": "One evening I was sitting at dinner in a fashionable street in New York, close to Central Park, when I was startled by a distinctly burglarious noise at the window."
                            },
                            {
                                "example_id": "f36c0e66-9df0-48a4-9094-d27419d2f4d8",
                                "sense_id": "6b140781-842f-3e6b-8368-7cfadc9b4dbe",
                                "text": "Of the various burglarious proceedings he had heard of picking the trolls’ pockets seemed the least difficult, so at last he crept behind a tree just behind William."
                            }
                        ]
                    }
