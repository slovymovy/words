                "entry_id": "125ba490-1265-3be0-9afe-f5b381ba2844",
                "word": "afjagen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "dbd58700-6547-31c7-bba7-a1bb9914c7d4",
                        "entry_id": "125ba490-1265-3be0-9afe-f5b381ba2844",
                        "glosses": [
                            "met veel snelheid, inspanning en behendigheid iets of iemand uitputten en iets uit handen nemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74a31757-63a7-4c5e-964c-28be14182212",
                                "sense_id": "dbd58700-6547-31c7-bba7-a1bb9914c7d4",
                                "text": "Groningen kreeg in de 2e minuut direct al twee goede schietkansen, voor eerst Zeefuik en daarna Tjaronn Chery. Die kansen kwamen voort uit het fel afjagen van de Leeuwarder defensie."
                            },
                            {
                                "example_id": "e54d0165-4570-4e87-98e2-e6c95f09ef16",
                                "sense_id": "dbd58700-6547-31c7-bba7-a1bb9914c7d4",
                                "text": "Waar Bosz zijn ploeg de tegenstander graag wil zien afjagen, gebeurde het omgekeerde."
                            },
                            {
                                "example_id": "e859f420-a588-4e71-bde8-8bdc6963ac03",
                                "sense_id": "dbd58700-6547-31c7-bba7-a1bb9914c7d4",
                                "text": "Al van begin af aan was de intentie van de ploeg van Jurgen Klopp duidelijk: afjagen en Arsenal niet in het spel laten komen."
                            }
                        ]
                    }
                ],
