                        "encadrer une porte"
                    ]
                },
                {
                    "sense_id": "fe113ac6-2c4a-3a60-ac75-2a1045e661fd",
                    "sense_definition": "Réglementer et fixer des règles strictes pour limiter ou organiser un domaine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement souhaite voter une loi afin de mieux <w>encadrer</w> les loyers."
                        },
                        {
                            "text": "Il est urgent d'<w>encadrer</w> l'usage de cette nouvelle technologie pour éviter les abus."
                        }
                    ],
                    "common_phrases": [
                        "encadrer les prix",
                        "encadrer les loyers",
                        "encadrer une pratique"
                    ]
                },
                {
                    "sense_id": "8cf7bde2-9f91-30e7-946f-976349214b55",
                    "sense_definition": "Supporter ou tolérer une personne (utilisé presque exclusivement à la forme négative).",
