                "senses": [
                    {
                        "sense_id": "23f95ee7-6955-3f55-9435-067375ce3fa6",
                        "entry_id": "272b1327-7eb0-3dbd-b313-e09fc28cd481",
                        "glosses": [
                            "Se décongeler tout seul."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13f0170e-11ac-4e40-a85d-0a45ba30cf6c",
                                "sense_id": "23f95ee7-6955-3f55-9435-067375ce3fa6",
                                "text": "J'ai oublié de vous expliquer qu'ici les frigos, si on les met au max, ils auto-décongèlent."
                            },
                            {
                                "example_id": "bc0f3ee4-7595-4977-8a8b-d42162a4e223",
                                "sense_id": "23f95ee7-6955-3f55-9435-067375ce3fa6",
                                "text": "Les pisse-froid devront s'auto-décongeler."
                            },
                            {
                                "example_id": "955a10b7-8933-4686-ae6e-d1a982be9343",
                                "sense_id": "23f95ee7-6955-3f55-9435-067375ce3fa6",
                                "text": "Auto-décongeler au réfrigérateur la technologie fait en sorte que l'élément de réfrigération ne soit pas couvert de glace, permettant à l'appareil de travailler au mieux de ses possibilités."
                            }
                        ]
                    }
