                    {
                        "sense_id": "cbc9995b-067a-3d94-ad63-17e36816dedc",
                        "entry_id": "e8dbd9ae-cfcc-383a-82cc-e54d71ebd7c3",
                        "glosses": [
                            "Nickname given to several models of dive bomber produced by Curtiss during World War II."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da8e5446-f835-4e55-93da-cab784433f42",
                                "sense_id": "cbc9995b-067a-3d94-ad63-17e36816dedc",
                                "text": "The Helldiver is another aircraft whose contribution to the final Allied victory is often underestimated."
                            },
                            {
                                "example_id": "f2a34f08-624e-4345-acc7-c393445d2e27",
                                "sense_id": "cbc9995b-067a-3d94-ad63-17e36816dedc",
                                "text": "The most numerous Allied dive-bomber of World War II, the Helldiver endured a prolonged gestation period to mature into one of the best aircraft of its type."
                            },
                            {
                                "example_id": "5e031f71-4eb5-4994-a18c-056f1dff30cd",
                                "sense_id": "cbc9995b-067a-3d94-ad63-17e36816dedc",
                                "text": "Pilots who flew the new Helldivers thought highly of the plane, but its reputation of being a poor handling airplane was already set in the minds of naval aviators."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "70b753fa-b8f7-35b7-ac4f-f799746b6cf9",
                "word": "helldiver",
