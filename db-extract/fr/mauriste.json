                        "glosses": [
                            "Moine bénédictin français, d'une congrégation connue pour le haut niveau de son érudition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e83fd534-d3fc-4cc8-941e-601b11188f41",
                                "sense_id": "fbf3a1ad-9f30-3c82-91c3-6ccf0f68f6fe",
                                "text": "Paradoxalement, un mauriste se mettait à défendre l’orthodoxe augustinisme d’un texte communément tenu pour janséniste, et il le faisait en recourant massivement à des justifications thomistes."
                            },
                            {
                                "example_id": "8ed3b432-d312-41d8-9536-af4a4cf78e91",
                                "sense_id": "fbf3a1ad-9f30-3c82-91c3-6ccf0f68f6fe",
                                "text": "La mal nommée expression « travail de bénédictin » se rapporte aux travaux d'érudition des moines mauristes, les fondateurs de la science historique aux XVIIe-XVIIIe siècles, emportés par la Révolution."
                            }
                        ]
