                                    {
                                        "sense_id": "161f9185-a675-35be-88b8-eaf5f4c6ac04",
                                        "entry_id": "99e90f19-9ee0-3ded-a397-608ff3b56088",
                                        "glosses": [
                                            "Relatif à l’Algérie, à ses habitants ou à sa culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09f40943-540a-431e-a21d-4428a900007d",
                                                "sense_id": "161f9185-a675-35be-88b8-eaf5f4c6ac04",
                                                "text": "Hortense tendit au jeune homme en rougissant une jolie bourse algérienne qui contenait soixante pièces d’or."
                                            },
                                            {
                                                "example_id": "7ba7cff6-0078-44fd-a143-691104fb49ac",
                                                "sense_id": "161f9185-a675-35be-88b8-eaf5f4c6ac04",
                                                "text": "Mais il fera immédiatement connaître au Doyen Duguit sa décision de demander sa mutation à Alger, pour raison de santé, le climat algérien se rapprochant davantage de celui qu’il avait connu en Égypte que celui de Bordeaux."
                                            },
                                            {
                                                "example_id": "acd3744c-e511-4e73-a221-c3dce7d57174",
                                                "sense_id": "161f9185-a675-35be-88b8-eaf5f4c6ac04",
                                                "text": "Tous les admirateurs de l’écrivain se souviennent également des difficultés inénarrables qu’il connut avec le Pouvoir algérien lorsqu’il tenta cette longue et difficile expérience de théâtre populaire en arabe algérien.",
                                                "translation": "Arnaud, Actualité de Kateb Yacine, L’Harmattan, 1993, page 7"
                                            },
                                            {
                                                "example_id": "0bead2d3-ffdf-4aaa-a193-86d06a4eaa14",
                                                "sense_id": "161f9185-a675-35be-88b8-eaf5f4c6ac04",
                                                "text": "La presse indigénophile a joué un rôle déterminant dans la formation de la presse «indigène» et de la conscience politique des intellectuels algériens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7186303-540e-3d85-a00e-02e1c1efb8cf",
                                        "entry_id": "99e90f19-9ee0-3ded-a397-608ff3b56088",
                                        "glosses": [
                                            "Relatif à la régence d'Alger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867f424e-35c0-498e-a0f1-a81382d1fe4e",
                                                "sense_id": "c7186303-540e-3d85-a00e-02e1c1efb8cf",
                                                "text": "la France de son droit exclusif de péche dans les eaux de la Régence, droit dont elle jouissait depuis cent cinquante ans et qu’elle avait cependant conservé avec le gouvernement algérien"
                                            }
                                        ]
                                    }
