                        "source_entry_id": "d669fdea-042c-36a0-bf5b-770123c74298",
                        "source_sense_id": "bbdbd1d7-7533-3f4b-bbd6-13a7c4235402",
                        "target_lang_word": "phylogenetic",
                        "target_lang_code": "en",
