                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a42053cb-30f6-4cf8-bf71-77c532928682",
                        "entry_id": "c105bc6f-1b74-3160-bb9d-0c57123e73b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "golmons"
                    },
                    {
                        "form_id": "580c2be9-98c0-4376-a089-9a95e27296b0",
                        "entry_id": "c105bc6f-1b74-3160-bb9d-0c57123e73b5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "golmonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "041db41e-36c8-3d47-aeec-a5a447d7f0dd",
                        "entry_id": "c105bc6f-1b74-3160-bb9d-0c57123e73b5",
                        "glosses": [
                            "(Injurieux envers un groupe ethnique) Personne dénuée d'intelligence, de jugement, de bon sens."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "cabf713b-32fe-426f-9650-3a70e384cb13",
                                "sense_id": "041db41e-36c8-3d47-aeec-a5a447d7f0dd",
                                "text": "Et bien sûr, vous n'invitez personne ! C'est entendu ? Personne ! Ah, et j'oubliais : pas de pétards ici, ni aucune drogue d'ailleurs ! Que je ne sente pas l'odeur du cannabis demain à l'ouverture. — J'ai pigé, j'suis pas un golmon !"
                            },
                            {
                                "example_id": "e1ba29f5-fd6f-489a-9c0e-2a61e9bc09dc",
                                "sense_id": "041db41e-36c8-3d47-aeec-a5a447d7f0dd",
                                "text": "On reste là, à s'observer comme deux gros golmons amateurs ne sachant pas quoi faire ni par où commencer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52edada3-c1db-426d-9dad-4be3f43c0457",
                        "source_entry_id": "c105bc6f-1b74-3160-bb9d-0c57123e73b5",
                        "source_sense_id": "041db41e-36c8-3d47-aeec-a5a447d7f0dd",
                        "target_lang_word": "idiot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of low general intelligence."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6128c31-8a73-4b7c-81e6-5593c6a7045c",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "Only an idiot would fail this exam."
                                            },
                                            {
                                                "example_id": "508bfb32-043f-48be-957d-116415cb8e3a",
                                                "sense_id": "2d4142f4-b076-3230-bbbd-2e6d655c5295",
                                                "text": "After failing a hat-trick of exams, the teacher called him an idiot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person who makes stupid decisions; a fool."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0bb3dd6-682e-468d-91b8-e646d373b678",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "He thought people who don't like cricket are idiots. He later got into fights with people who like footabll."
                                            },
                                            {
                                                "example_id": "2b758441-1b8a-4e2c-a2d5-c49b480c7a83",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "We think that people who cycle without a helmet are idiots."
                                            },
                                            {
                                                "example_id": "ce90f186-69c0-4498-b756-6399e93b8679",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“He’s an idiot – in terms of saying that. Everybody knows this. Everybody knows it. Nobody doubts it,” Biden said."
                                            },
                                            {
                                                "example_id": "7b8285ec-e4fa-4269-a273-e4e76cef8485",
                                                "sense_id": "53ef83e5-1b37-35ce-be41-e5df58193180",
                                                "text": "“One of the things that you write so beautifully, and your stuff is so fun to read, but you write about Trump, quote, ‘The way that you build a truly vicious nationalist movement is to wed a relatively small core of belligerent idiots to a much larger group of opportunists and spineless fellow travelers whose primary function is to turn a blind eye to things,’” Kennedy said, reading Taibbi’s own writing back to him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                        "entry_id": "5caa5447-c87a-3c3a-84f2-109635201945",
                                        "glosses": [
                                            "A person of the lowest intellectual standing, a person who lacks the capacity to develop beyond the mental age of a normal four-year-old; a person with an IQ below 30."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed94fe7c-d445-4c4b-96b1-9293a559b9dd",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "Idiots were thought to be peculiarly under the care of the Deity, and it was believed that those who treated them kindly would be blessed."
                                            },
                                            {
                                                "example_id": "e449e471-554f-408e-a706-0595f64c12f5",
                                                "sense_id": "111d41a7-15d2-3dff-9e2c-f7cc630ce39b",
                                                "text": "It is an offence for a man to have unlawful sexual intercourse with a woman whom he knows to be an idiot or imbecile."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "idiot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d199d7ae-0277-3c21-9db9-d05f42baf0ce",
                                        "entry_id": "ff137029-fa92-3de5-9556-09a8586bbf0e",
                                        "glosses": [
                                            "Idiotic, stupid."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
