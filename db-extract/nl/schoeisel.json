                                    {
                                        "sense_id": "bdd92b9c-a99e-394b-8005-c2ee5df07e43",
                                        "entry_id": "a661cd9c-5362-34ce-bdee-7ee4e7fedf50",
                                        "glosses": [
                                            "Sturdy footwear."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bddc3d2-0bbc-4a31-adaa-692c0a8daede",
                                                "sense_id": "bdd92b9c-a99e-394b-8005-c2ee5df07e43",
                                                "text": "It was rumored to be the haunt of grubby drunks, rubby-dubs we called them; they were said to drink rubbing alcohol and sleep in telephone booths and vomit on your shoes in the streetcar. But now it’s art galleries and bookshops, boutiques filled with black clothing and weird footgear, the saw-toothed edge of trend."
                                            }
                                        ]
