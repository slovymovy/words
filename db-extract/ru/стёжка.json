                        "entry_id": "7942549d-992b-31bc-81d8-15406f3faae6",
                        "glosses": [
                            "разг. уменьш. к стежь; дорожка, тропинка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae0ddac8-6c72-41a9-9057-b111a55510fe",
                                "sense_id": "42b466a1-3b8e-39c8-9d5c-928351c879c9",
                                "text": "Побегу по мятой стёжке // На приволь зелёных лех, // Мне навстречу, как серёжки, // Прозвенит девичий смех."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8ae3715-102a-3d3f-96dc-7bde8035a29a",
                        "entry_id": "7942549d-992b-31bc-81d8-15406f3faae6",
                        "glosses": [
                            "разг., перен. следы зверей, птиц, оставляемые на снегу, песке и т. п."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4009035a-4e46-47bb-a3d0-ef87b80aa385",
                        "source_entry_id": "7942549d-992b-31bc-81d8-15406f3faae6",
                        "source_sense_description": "дорожка, тропинка",
                        "target_lang_word": "Steig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b51df05-a9ce-3fcf-8e10-4ae6bbfede3a",
                                        "entry_id": "643175af-7815-34a1-844a-db8a57ad9d90",
                                        "glosses": [
                                            "einfacher Weg in einem steilen Gelände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0948fc2-3955-4624-bad4-34d209a0507a",
                                                "sense_id": "2b51df05-a9ce-3fcf-8e10-4ae6bbfede3a",
                                                "text": "„Er drehte sich um und ging den Steig hinunter, den wir zusammen heraufgekommen waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b1010e4-cb5a-45f8-85f4-526f3c03a894",
                        "source_entry_id": "7942549d-992b-31bc-81d8-15406f3faae6",
                        "source_sense_description": "дорожка, тропинка",
                        "target_lang_word": "Stieg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f4a3149b-385c-4844-9b09-31fbe82b1e31",
                        "source_entry_id": "7942549d-992b-31bc-81d8-15406f3faae6",
                        "source_sense_description": "дорожка, тропинка",
                        "target_lang_word": "Pfad",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfad",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                        "entry_id": "f7b0a3c8-0c87-3d50-9944-25408a1206f1",
                                        "glosses": [
                                            "schmaler Weg, der nur von Fußgängern benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0cc826-fccb-49da-ac8b-7d8de2523c20",
                                                "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                                "text": "Ein verwachsener Pfad führte zu der Hütte."
                                            },
                                            {
                                                "example_id": "ef31fed8-eb23-4c97-bba9-001097881235",
                                                "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                                "text": "„Kurze, mit Bohlen befestigte Pfade führen von den Landebrücken zur Hauptstraße, die teilweise nur wenige Dutzend Meter hinter dem Strand verläuft.“"
                                            },
                                            {
                                                "example_id": "8572759f-002c-464e-9f02-f0042feab488",
                                                "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                                "text": "„Anschließend stieg Freiligrath vom Drachenfels den steilen Pfad nach Honnef hinab, fand die Stadt aber als künftigen Wohnort nicht geeignet, da sie ihm zu weit vom Ufer des Flusses entfernt lag.“"
                                            },
                                            {
                                                "example_id": "b8f51c13-e51a-463f-bfa5-cbd94cc8c7c0",
                                                "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                                "text": "„Sie verließen die Winston Street und gelangten auf einen Pfad, der sich zwischen einigen hohen schwarzen Bäumen dahinschlängelte.“"
                                            },
                                            {
                                                "example_id": "f6d3717a-8b0a-482a-8a5d-7b8e399c1f0f",
                                                "sense_id": "802208bf-865b-302c-aa72-954b69aaefdb",
                                                "text": "„Während Hugo erzählte, waren wir auf überwachsenen Pfaden rheinaufwärts gewandert, Haus Bürgel entgegen, wie Bertram wusste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a42136c-e370-3f0a-8af5-c3d462253cc3",
                                        "entry_id": "f7b0a3c8-0c87-3d50-9944-25408a1206f1",
                                        "glosses": [
                                            "eine Folge von Knotenverbindungen in einem Graphen"
                                        ],
                                        "tags": [
                                            "Graphentheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2e6939-63fc-4064-924e-ca855c2906db",
                                                "sense_id": "0a42136c-e370-3f0a-8af5-c3d462253cc3",
                                                "text": "Es existiert nur ein Pfad zwischen den Knoten A und B."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b7a124ef-a98d-3807-adc1-a49e715548dd",
                                        "entry_id": "f7b0a3c8-0c87-3d50-9944-25408a1206f1",
                                        "glosses": [
