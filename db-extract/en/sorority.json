                        "glosses": [
                            "A group of girls or women associated for a common purpose; a sisterhood."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                        "entry_id": "b9ddddef-d5df-36e5-8917-ff71e6bc537e",
                        "glosses": [
                            "A social organization of female students at a college or university; usually identified by Greek letters."
                        ],
                        "tags": [
                            "Philippines",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "aae7af97-ea41-4fa3-98b4-ba5b2f23e1af",
                                "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                                "text": "Every day is a party at this sorority!"
                            },
                            {
                                "example_id": "fbd4cbc8-e354-4727-8681-6c428c7f28f7",
                                "sense_id": "bd36b902-a513-3c84-919b-b2af6475aeb1",
                                "text": "And Florida State University suspended all frats and sororities for two months after the November 2017 death of Pi Kappa Phi pledge Andrew Coffey, which has since been determined to have been due to hazing, according to police. […] When Jo Hannah Burch pledged a sorority at Young Harris College, a private liberal arts college in North Georgia, she too was looking to meet new people."
                            }
                        ]
                    }
