                ],
                "senses": [
                    {
                        "sense_id": "4e02274d-8784-344f-bfbc-1247e7bc8511",
                        "entry_id": "0625caea-694c-34af-a0b1-eff4d796224d",
                        "glosses": [
                            "Substance purgative."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b74a26-69ec-4b15-a24c-6594a55bfefb",
                                "sense_id": "4e02274d-8784-344f-bfbc-1247e7bc8511",
                                "text": "Le polypode, sorte de fougère, est un purgatif doux, cholagogue qui agit bien dans les constipations par insuffisance biliaire."
                            },
                            {
                                "example_id": "739ab29f-5d6c-4739-b35e-384063794d8f",
                                "sense_id": "4e02274d-8784-344f-bfbc-1247e7bc8511",
                                "text": "Une femme de dix-sept ans, non réglée, d'un tempérament nerveux, affectée d'une mélancolie à la suite de souffrances morales, avait été soumise sans succès, pendant plus de deux mois, aux purgatifs, aux antiphlogistiques et aux nervins."
                            },
                            {
                                "example_id": "0c153d83-8e99-43ab-8c0f-63be8736573c",
                                "sense_id": "4e02274d-8784-344f-bfbc-1247e7bc8511",
                                "text": "Le sulfate de soude est un purgatif."
                            },
                            {
                                "example_id": "29c4eaa4-9ef6-4643-ac28-4e51106e7cf7",
                                "sense_id": "4e02274d-8784-344f-bfbc-1247e7bc8511",
                                "text": "On faisait autrefois un grand usage des purgatifs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
