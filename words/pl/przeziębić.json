{
    "word_family": [
        "przeziębienie",
        "ziębić",
        "ziębnięcie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "308c542e-6730-365f-9a69-5d8ef75d32ad",
                    "sense_definition": "zachorować w wyniku nadmiernego ochłodzenia organizmu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "choroba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Łatwo <w>przeziębić</w> się, gdy wychodzisz na dwór bez czapki.",
                            "target_lang_translations": {
                                "en": "It is easy to <w>catch a cold</w> when you go outside without a hat."
                            }
                        },
                        {
                            "text": "Wczoraj zmarzłem na przystanku i teraz boję się, że <w>przeziębię</w> się na dobre.",
                            "target_lang_translations": {
                                "en": "I got freezing cold at the bus stop yesterday and now I'm afraid I'll <w>catch a cold</w> for real."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przeziębić się"
                    ],
                    "target_lang_definitions": {
                        "en": "To become ill as a result of the body becoming too cold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch a cold",
                                "target_lang_sense_clarification": "To contract a viral respiratory infection."
                            },
                            {
                                "target_lang_word": "get a cold",
                                "target_lang_sense_clarification": "To become sick with a cold."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e840900-bdbb-3e7a-93c6-31d2aeb17e11",
                    "sense_definition": "spowodować u kogoś chorobę wskutek narażenia na działanie zimna",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "choroba",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dziecko <w>przeziębiło</w> nogi w mokrych butach.",
                            "target_lang_translations": {
                                "en": "The child <w>caught a chill</w> in their feet from wearing wet shoes."
                            }
                        },
                        {
                            "text": "Nie stój tak długo na wietrze, bo <w>przeziębisz</w> sobie gardło.",
                            "target_lang_translations": {
                                "en": "Don't stand in the wind for so long, or you'll <w>catch a chill</w> in your throat."
                            }
                        }
                    ],
                    "common_phrases": [
                        "przeziębić nogi",
                        "przeziębić gardło"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone to become ill by exposing them to cold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "give someone a cold",
                                "target_lang_sense_clarification": "To transmit a cold to someone."
                            },
                            {
                                "target_lang_word": "catch a chill",
                                "target_lang_sense_clarification": "To become ill or feel unwell due to exposure to cold."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cf8b9b2-8cdd-3b39-af53-4917703179e3",
                    "sense_definition": "nadmiernie oziębić coś lub kogoś",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temperatura",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zbyt mocno <w>przeziębił</w> pomieszczenie, włączając klimatyzację na maksimum.",
                            "target_lang_translations": {
                                "en": "He <w>overcooled</w> the room by turning the air conditioning to the maximum."
                            }
                        },
                        {
                            "text": "Musimy uważać, żeby nie <w>przeziębić</w> delikatnych roślin podczas przymrozków.",
                            "target_lang_translations": {
                                "en": "We must be careful not to <w>chill</w> the delicate plants during the frost."
                            }
                        }
                    ],
                    "synonyms": [
                        "wychłodzić"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something or someone excessively cold."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overcool",
                                "target_lang_sense_clarification": "To cool something too much."
                            },
                            {
                                "target_lang_word": "chill",
                                "target_lang_sense_clarification": "To make something cold, often to a point of discomfort or damage."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}