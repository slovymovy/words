                    {
                        "form_id": "527d1450-33a4-4ee9-bca9-15deb414d539",
                        "entry_id": "e4c8535a-1234-3a3c-9222-0e78697fcf1a",
                        "tags": [],
                        "form": "Hetmanat"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88c009e6-6f26-39cb-b5d3-ce829b4dce37",
                        "entry_id": "e4c8535a-1234-3a3c-9222-0e78697fcf1a",
                        "glosses": [
                            "Dignité de l’hetman, chef élu chez les cosaques d’Ukraine (de 1649 à 1764)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c7ad6d5-c909-4d91-b325-207ab8a9e6b3",
                                "sense_id": "88c009e6-6f26-39cb-b5d3-ce829b4dce37",
                                "text": "Plus tard il [Mazeppa] acquit l’estime et l’amitié de Pierre 1ᵉʳ, ami de tous les talents, qui le décora du cordon de Saint-André, l’appela au conseil privé et lui conserva l’hetmanat."
                            }
                        ]
                    },
                    {
                        "sense_id": "30f32477-8e0b-3040-a9c3-ac1d344a3e49",
                        "entry_id": "e4c8535a-1234-3a3c-9222-0e78697fcf1a",
                        "glosses": [
                            "Période de détention du pouvoir par un hetman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "521c78f6-b46f-4e57-a674-f6d33854e9af",
                                "sense_id": "30f32477-8e0b-3040-a9c3-ac1d344a3e49",
                                "text": "Mazeppa avait créé pour son service personnel une compagnie de gardes du corps appelés serduques ; d’immenses richesses, patiemment acquises durant son hetmanat, lui permettaient ces façons opulentes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c118a61b-a5a1-3a77-8319-9860441ac8e3",
                        "entry_id": "e4c8535a-1234-3a3c-9222-0e78697fcf1a",
                        "glosses": [
                            "Organisation politique, sociale et territoriale articulée autour des hetmans ; période historique des hetmanats en Ukraine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a99cf6f-5190-4587-9310-5a479b4b6283",
                                "sense_id": "c118a61b-a5a1-3a77-8319-9860441ac8e3",
                                "text": "Les premières tentatives d’organisation d’un pogrom eurent lieu sous l’hetmanat, quand des troupes allemandes étaient cantonnées en Ukraine."
                            },
                            {
                                "example_id": "b4e2bb69-1787-4aa6-b109-8bfe892ef358",
                                "sense_id": "c118a61b-a5a1-3a77-8319-9860441ac8e3",
                                "text": "À côté de ce corps administratif, l’organisation particulière de l’Armée, qui comprenait officiellement 30 000 Cosaques, fut maintenue et l’hetmanat continua à jouir également de son autonomie économique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f3bb1e2-61db-44a4-9ab7-5fca49ba0660",
                        "source_entry_id": "e4c8535a-1234-3a3c-9222-0e78697fcf1a",
