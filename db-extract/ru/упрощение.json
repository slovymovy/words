                    {
                        "translation_id": "c74da45a-bcea-43f9-85cc-593cc019ff6b",
                        "source_entry_id": "acddfefc-c469-3191-8c10-2c9131fd8930",
                        "source_sense_description": "действие или состояние по значению гл. упрощать, упрощаться, упростить, упроститься",
                        "target_lang_word": "Vereinfachung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vereinfachung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                        "entry_id": "1c6df80d-11d6-305e-8e22-040e2d412aea",
                                        "glosses": [
                                            "Vorgang, etwas einfacher oder weniger kompliziert zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda5553c-5542-4a99-a220-10a570382b74",
                                                "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                                "text": "Sie fordern eine Vereinfachung des Steuersystems."
                                            },
                                            {
                                                "example_id": "3d895a8e-5a9e-42ac-9139-0ca001a6e7bc",
                                                "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                                "text": "„Die Vereinfachung des Baurechts muss nach Auffassung Scharfs mit einer vollständigen Digitalisierung der Bauämter einhergehen.“"
                                            },
                                            {
                                                "example_id": "60207df2-fb07-4706-82e4-44d025a8c106",
                                                "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                                "text": "„Mit dem Paket von zehn Einzelvereinbarungen wird unter anderem die weltweite Vereinfachung von Zollabwicklungen im grenzüberschreitenden Warenverkehr angestrebt.“"
                                            },
                                            {
                                                "example_id": "c1d64dbd-f734-4f4f-9c82-2077b5588376",
                                                "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                                "text": "„Sachsens Wirtschaftsminister Martin Dulig hat angesichts der Ausbreitung des Coronavirus im Bundesrat auf eine möglichst schnelle Vereinfachung der Regelungen zur Kurzarbeit gedrängt.“"
                                            },
                                            {
                                                "example_id": "539b61ce-d4e3-4183-be8c-0e491b2cb4bd",
                                                "sense_id": "2c0440bf-b970-3741-9ea5-7994f8a2c1b1",
                                                "text": "[Der Fußballtrainer Sepp Herberger] „»hatte ein Talent der Vereinfachung, wie Konrad Adenauer in der Politik. Er konnte die kompliziertesten Dinge ganz einfach sagen.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "386409bf-9d78-32f0-b845-fd8e9873fc42",
                                        "entry_id": "1c6df80d-11d6-305e-8e22-040e2d412aea",
                                        "glosses": [
                                            "Darstellung, die zu sehr vereinfacht wurde und somit der Komplexität des Gegenstandes nicht mehr gerecht wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a99a1f-d3f1-460f-a26c-6db1e8dfa5c3",
                                                "sense_id": "386409bf-9d78-32f0-b845-fd8e9873fc42",
                                                "text": "Mit einer solchen Vereinfachung wird man der Komplexität der Sache nicht gerecht. Und man kann schon überhaupt keine Lösungsansätze auf solch einem allgemeinen und theoretischen Niveau diskutieren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72c9a914-fb63-4ae9-a0d0-ceeffe1bd4a0",
                        "source_entry_id": "acddfefc-c469-3191-8c10-2c9131fd8930",
                        "source_sense_description": "действие или состояние по значению гл. упрощать, упрощаться, упростить, упроститься",
