                                "example_id": "c4bad5fd-b7cc-4a43-b861-a377a5f9b61b",
                                "sense_id": "a98e255f-25c1-3034-8620-cc027a9d6089",
                                "text": "Il comprend un masque et une combinaison NBC (Nucléaire Biologique et Chimique) doublée de charbon de bois, des bottes en caoutchouc, des gants, des produits décontaminants et des médicaments contre l’anthrax et l’agent neurotoxique VX."
                            },
                            {
                                "example_id": "de50b918-1b02-418a-9cf6-e94c2368a4b0",
                                "sense_id": "a98e255f-25c1-3034-8620-cc027a9d6089",
                                "text": "Elle veut limiter la prolifération des missiles et des armes NBC aux effets dévastateurs sur l'humanité."
                            }
                        ]
