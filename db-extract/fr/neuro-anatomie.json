                    {
                        "sense_id": "b93ed3e1-425e-38c2-ae63-10e6782b3c8a",
                        "entry_id": "7d48581c-cb4a-332c-aba8-beca9a9c737b",
                        "glosses": [
                            "Branche de l’anatomie consacrée à la description du système nerveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e630d88-9b93-462e-9c48-54f6556b78a8",
                                "sense_id": "b93ed3e1-425e-38c2-ae63-10e6782b3c8a",
                                "text": "Les domaines d'application sont liés à la neuro-anatomie (neuro-radiologie et neurochirurgie), mais les recherches et développements peuvent aussi s'appliquer à d'autres régions de l'anatomie."
                            },
                            {
                                "example_id": "fb499b96-59fd-4af9-80e9-a0991c168201",
                                "sense_id": "b93ed3e1-425e-38c2-ae63-10e6782b3c8a",
                                "text": "Un brin de neuroanatomie des voies visuelles s’impose. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 25)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2660d771-d1d9-47a9-8c6d-1241d888df9b",
                        "source_entry_id": "7d48581c-cb4a-332c-aba8-beca9a9c737b",
                        "source_sense_id": "b93ed3e1-425e-38c2-ae63-10e6782b3c8a",
