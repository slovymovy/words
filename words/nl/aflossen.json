    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1524a737-288c-3a87-ab6c-802dbcc93b0f",
                    "sense_definition": "geheel of gedeeltelijk terugbetalen van een schuld",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financiën",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moest haar schuld nog <w>aflossen</w>.",
                            "target_lang_translations": {
                                "en": "She still had to <w>pay off</w> her debt."
                            }
                        },
                        {
                            "text": "Hij leefde na drie jaar een lening <w>aflossen</w> nu schuldenvrij met zijn gezin in de natuur.",
                            "target_lang_translations": {
                                "en": "After three years of <w>paying off</w> a loan, he now lived debt-free with his family in nature."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugbetalen",
                        "vereffenen",
                        "afbetalen"
                    ],
                    "antonyms": [
                        "lenen",
                        "verschuldigd zijn"
                    ],
                    "common_phrases": [
                        "lening aflossen",
                        "hypotheek aflossen",
                        "schuld aflossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To pay back a debt in full or in part."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pay off",
                                "target_lang_sense_clarification": "to fully repay a debt or loan"
                            },
                            {
                                "target_lang_word": "repay",
                                "target_lang_sense_clarification": "to give back money owed"
                            },
                            {
                                "target_lang_word": "redeem",
                                "target_lang_sense_clarification": "to pay off a mortgage or debt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0bd9b2e-5257-3ca5-bd9f-0f0213ab8634",
                    "sense_definition": "de plaats innemen van iemand anders om een taak over te nemen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>loste</w> de bewaker <w>af</w> na een lange dienst van acht uur.",
                            "target_lang_translations": {
                                "en": "He <w>relieved</w> the guard after a long eight-hour shift."
                            }
                        },
                        {
                            "text": "De soldaten <w>lossen</w> elkaar elke vier uur <w>af</w> bij de poort.",
                            "target_lang_translations": {
                                "en": "The soldiers <w>relieve</w> each other every four hours at the gate."
                            }
                        }
                    ],
                    "synonyms": [
                        "vervangen",
                        "ontzetten",
                        "overnemen"
                    ],
                    "common_phrases": [
                        "elkaar aflossen",
                        "de wacht aflossen"
                    ],
                    "target_lang_definitions": {
                        "en": "To take someone's place in order to take over a task or duty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to take over a shift or post from someone"
                            },
                            {
                                "target_lang_word": "replace",
                                "target_lang_sense_clarification": "to take the place of someone"
                            },
                            {
                                "target_lang_word": "take over from",
                                "target_lang_sense_clarification": "to assume control or responsibility from another"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "362b476a-d3bc-31f6-83b3-0264d6d92ac3",
                    "sense_definition": "het afvuren van een schot of projectiel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wapens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaat <w>loste</w> een schot in de lucht om de menigte te waarschuwen.",
                            "target_lang_translations": {
                                "en": "The soldier <w>fired</w> a shot into the air to warn the crowd."
                            }
                        },
                        {
                            "text": "Zonder aarzelen <w>loste</w> hij het fatale schot op het doelwit.",
                            "target_lang_translations": {
                                "en": "Without hesitation, he <w>fired</w> the fatal shot at the target."
                            }
                        }
                    ],
                    "synonyms": [
                        "afvuren",
                        "schieten"
                    ],
                    "common_phrases": [
                        "schot aflossen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of firing a shot or projectile."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fire",
                                "target_lang_sense_clarification": "to discharge a weapon or shot"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "to release or fire a weapon"
                            }
                        ]
                    }
                }
            ]
        }
    ]
