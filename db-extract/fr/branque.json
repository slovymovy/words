                "senses": [
                    {
                        "sense_id": "7e57006a-2bbf-3323-9150-558419bfa00f",
                        "entry_id": "08fffb7f-4dfd-33b0-924f-251acafaa3b7",
                        "glosses": [
                            "Qui est un peu idiot ou stupide."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "eeb530e3-1dec-4fcd-9855-8d35723c5712",
                                "sense_id": "7e57006a-2bbf-3323-9150-558419bfa00f",
                                "text": "Je me sentais un peu branque, la minute d’après, seulabre dans la bagnole de Pierrot."
                            },
                            {
                                "example_id": "3bd11220-0452-4d24-b907-6fd03d187b69",
                                "sense_id": "7e57006a-2bbf-3323-9150-558419bfa00f",
                                "text": "Les deux potes en restaient tout branques, avec, dans l’esprit de Tony, un élément dominant d’inquiétude aux causes informulables sur le coup, une impression tarte."
                            },
                            {
                                "example_id": "44c6128c-f82c-4baf-b4f6-d4751070ae71",
                                "sense_id": "7e57006a-2bbf-3323-9150-558419bfa00f",
                                "text": "Il se trouve bien branque de se démener comme il le fait."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b65e3d7d-6d5b-308a-a614-3f0a1dafb3ea",
                "word": "branque",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5788f8a5-8b38-463b-ae90-41dc130b7d30",
                        "entry_id": "b65e3d7d-6d5b-308a-a614-3f0a1dafb3ea",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "branques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                        "entry_id": "b65e3d7d-6d5b-308a-a614-3f0a1dafb3ea",
                        "glosses": [
                            "Personne stupide, très naïve ou qui manque de sérieux ou de compétence."
                        ],
                        "tags": [
                            "familiar",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "7dd32ff2-b2f1-4bca-bf36-e891b74b7b31",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "Cette vieille branque met tant d’ardeur dans sa rumba hot qu’on dirait tout le temps qu’elle va faire péter sa robe."
                            },
                            {
                                "example_id": "c038bd7e-7388-4ebe-982a-e9109e55f05b",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "– […] Pour que vous ne me preniez pas pour un branque et aussi… hum… Je vous connais, Burma…"
                            },
                            {
                                "example_id": "4984439b-fad6-461b-a6db-bf4d1fc6bd37",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "Quel branque !, Non, mais quel branque !\nQue signifie le terme branque ?\nBranque, connard, bouché à l'émeri !"
                            },
                            {
                                "example_id": "cf9eb3e5-51e1-4c08-8a35-6dbb5aa39763",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "On se glisse parmi ces bons branques, c’est le tremplin qui nous intéresse, on se paie des périlleux avant, des sauts de l’ange, pas spécialement impec mais on se marre."
                            },
                            {
                                "example_id": "db7ae178-3890-4a69-aca1-0430f43df401",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "« Scientifique », « scientifique », est-ce que j'ai la ganache d'Albert Einstein ? Hein ? Vous faites chier, à pénave comme des branques tout l’temps !"
                            },
                            {
                                "example_id": "364c859e-6bcf-4155-8341-add33852bb66",
                                "sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                                "text": "Une supposition : qu'ils aient comme Malraux, …, Qu'ils aient comme ce branque, Compté la musique pour moins que zéro, …, M'auraient collé au mur avec ou sans bandeau"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "514b3202-1d43-4c21-8d67-e660eb14590c",
                        "source_entry_id": "b65e3d7d-6d5b-308a-a614-3f0a1dafb3ea",
                        "source_sense_id": "b8d0a222-401e-39be-8a55-80df90482741",
                        "target_lang_word": "daft",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daft",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                        "entry_id": "1431ce98-2a4a-3e7d-9f4c-131956e641d5",
                                        "glosses": [
                                            "Foolish, silly, stupid."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06d57c1c-730e-4f6f-a070-56390035e72d",
                                                "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                                "text": "a daft idea"
                                            },
                                            {
                                                "example_id": "eefc971d-6b40-4446-8187-a530b3ad05c2",
                                                "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                                "text": "Thou art the daftest fuill that ever I saw. / Trows thou, man, be the law to get remeid / Of men of kirk? Na, nocht till thou be deid.",
                                                "translation": "You are the daftest fool that ever I saw. / Trust you, man, by the law to get a remedy / From men of the church? No, not till you are dead.",
                                                "english": "You are the daftest fool that ever I saw. / Trust you, man, by the law to get a remedy / From men of the church? No, not till you are dead."
                                            },
                                            {
                                                "example_id": "160ebc2c-b741-4543-b006-5e17a96dbb93",
                                                "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                                "text": "So that if a boor complains of a broken-head, or a beer-seller of a broken can, or a daft wench does but squeak loud enough to be heard above her breath, a soldier of honour shall be dragged, not before his own court-martial, who can best judge of and punish his demerits, but before a base mechanical burgo-master, who shall menace him with the rasp-house, the cord, and what not, as if he were one of their own mean, amphibious, twenty-breeched boors."
                                            },
                                            {
                                                "example_id": "822ac766-d14d-4aba-8677-67c14a331706",
                                                "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                                "text": "In case you haven't heard of them [the Taipings], I must tell you that they were another of those incredible phenomena that made China the topsy-turvey mess it was, like some fantastic land from Gulliver, where everything was upside down and out of kilter. Talk about moonbeams from cucumbers; the Taipings were even dafter than that."
                                            },
                                            {
                                                "example_id": "a2f9577e-b3c2-4ba4-b24b-e25f2d3f62bd",
                                                "sense_id": "a16977b0-ccb5-38de-9bdb-b1a97df7dc4c",
                                                "text": "You haven't exactly been playing the master tactician through all this, but that seems the daftest course you could possibly have taken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02756c14-cc32-3078-b9e8-614e72878c7d",
                                        "entry_id": "1431ce98-2a4a-3e7d-9f4c-131956e641d5",
                                        "glosses": [
                                            "Crazy, insane, mad."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "Ireland",
                                            "New-Zealand",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32e87772-4460-4c7d-8e02-1fdd53ff6c62",
                                                "sense_id": "02756c14-cc32-3078-b9e8-614e72878c7d",
                                                "text": "\"Ow, he is just a wood harum-scarum creature, that wad never take to his studies;—daft, sir, clean daft.\" / […] / \"[W]owff—a wee bit by the East-Nook or sae; it's a common case—the ae half of the warld thinks t'other daft. I have met with folks in my day, that thought I was daft mysell;[…]\" / \"I cannot make out a word of his cursed brogue,\" said the Cumbrian justice; \"can you, neighbour—eh? What can he mean by deft?\" / \"He means mad\", said the party appealed to, thrown off his guard by impatience of this protracted discussion."
                                            },
                                            {
                                                "example_id": "8ca05b61-f2b3-4c43-a8e6-6e5371a223ba",
                                                "sense_id": "02756c14-cc32-3078-b9e8-614e72878c7d",
                                                "text": "The boy gathered himself up, shook his shaggy head, and, said, in a piteous tone: 'Davie's daft!' 'Davie's daft!' He then kicked the poor idiot till his cries attracted the attention of the guests, some of whom immediately came to the spot: […]"
                                            },
                                            {
                                                "example_id": "8770e6bc-bbce-4865-99a3-173d72fdee00",
                                                "sense_id": "02756c14-cc32-3078-b9e8-614e72878c7d",
                                                "text": "‘It’s a lee [lie],’ says the man; ‘she’s either drunk or daft.’ / ‘Me drunk, you ill-tongued vagabond!’ says my Auntie Kirsty, who couldna bear such a reproach on her good name, ‘I’m a’ but blackfasting this day from either meat or drink; you had better no meddle wi’ my character.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "452a9a69-9def-3c85-9666-f461f732ffb2",
                                        "entry_id": "1431ce98-2a4a-3e7d-9f4c-131956e641d5",
                                        "glosses": [
                                            "Gentle, meek, mild."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0f61cdd-97e6-425e-adbc-af4e3f602e97",
                                                "sense_id": "452a9a69-9def-3c85-9666-f461f732ffb2",
                                                "text": "There's mirth in the barn and the ha', the ha', / There's mirth in the barn and the ha': / There's quaffing and laughing, / And dancing and daffing; / And our young bride's daftest of a', of a', / And our young bride's daftest of a'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
