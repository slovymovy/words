                            {
                                "example_id": "82f8e4f6-317d-48fb-a9f7-0c683946ecab",
                                "sense_id": "a4d93725-0add-37e7-86cb-c0e57ee6355b",
                                "text": "Ces alphabets neufs sont en lettres latines : Atélégraf, ou bien Aposta (écrits ainsi), c’est de l’abkhasien, […]."
                            },
                            {
                                "example_id": "09747183-c927-4904-9aa7-548fbe397e18",
                                "sense_id": "a4d93725-0add-37e7-86cb-c0e57ee6355b",
                                "text": "Du régime soviétique date également l’existence de l’abkhasien écrit. Cette langue ne se transmettait jusqu’ici qu’oralement, comme les vieilles légendes populaires."
                            }
                        ]
