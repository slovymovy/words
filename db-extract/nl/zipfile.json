                        "examples": [
                            {
                                "example_id": "1e7f4df7-b806-4d9d-8d30-c481e9868219",
                                "sense_id": "23b7813d-b40b-3fb1-9536-d55f0fd3b0df",
                                "text": "Bol.com heeft zijn klanten laten weten: „Wij adviseren iedereen die een e-mail met een zip-file [sic!] uit onze naam ontvangt, de bijlage niet te openen en de e-mail direct te verwijderen.”"
                            },
                            {
                                "example_id": "35319198-2881-4a37-adf8-93bdfd1ff617",
                                "sense_id": "23b7813d-b40b-3fb1-9536-d55f0fd3b0df",
                                "text": "Tussen december en juni zijn 250.000 computers en 50.000 Facebook-accounts met malware geïnfecteerd door spamnetwerk Lecpetex. Na samenwerking van Facebook en Griekse opsporingsdiensten zijn vorige week twee arrestaties verricht. Het ging om besmettingen in Griekenland, Polen, Noorwegen, India, Portugal en de Verenigde Staten. Slachtoffers ontvingen privéberichten met een zipfile. Eenmaal geopend werd er software geïnstalleerd, om zo inloggegevens buit te maken."
                            }
                        ]
                    }
