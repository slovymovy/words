                ],
                "senses": [
                    {
                        "sense_id": "f38b24e9-d6d9-3702-9df6-ab7e139d0671",
                        "entry_id": "b8ec75d6-848a-32a9-92a8-defa60378669",
                        "glosses": [
                            "Sorte de voiture hippomobile, équipée de banquettes sur le dessus, tirée par quatre chevaux et qui assurait les transports entre les villes."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "42120449-a9f3-4755-a18c-bccad6f2daeb",
                                "sense_id": "f38b24e9-d6d9-3702-9df6-ab7e139d0671",
                                "text": "Aussitôt, le mail-coach reprit à droite la route circulaire qui prolongeait les rivages de la baie, et se dirigea vers la petite ville d’Éden, distante de cinq milles."
                            },
                            {
                                "example_id": "6755f73c-c6a4-4bdd-85b9-6c9e895e14f1",
                                "sense_id": "f38b24e9-d6d9-3702-9df6-ab7e139d0671",
                                "text": "Un mail-coach qui revenait du Mesnil a tourné le barrage par la rue Vernet. A quatre mètres de hauteur sur le second siège, une dame a jeté les yeux dans un entresol sans défiance, […]."
                            },
                            {
                                "example_id": "b6c9d321-d0c7-4021-970e-bb2f78ffebba",
                                "sense_id": "f38b24e9-d6d9-3702-9df6-ab7e139d0671",
                                "text": "Nous étions perchés sur un grand mail-coach à quatre chevaux, qui fait le service entre Stronachlacher sur le lac Katrine et Inversnaid sur le lac Lhomond. Le robuste cocher portait, sur le veston rouge des estampes anglaises de 1840, un ample caoutchouc vert, étincelant sous le ruissellement de la pluie."
                            }
                        ]
                    }
