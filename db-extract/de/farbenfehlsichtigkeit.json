                "senses": [
                    {
                        "sense_id": "c599e64c-c9a6-3b6f-94f0-fbc3207f3135",
                        "entry_id": "d1efd818-89d0-3a00-9c3c-0738963cb361",
                        "glosses": [
                            "meist erbliche Anomalie der Netzhaut, bei der Farben falsch wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42e44db-4e04-4c06-8049-ff79e6007384",
                                "sense_id": "c599e64c-c9a6-3b6f-94f0-fbc3207f3135",
                                "text": "„Das Eyeborg ermöglicht damit Blinden und Personen mit Farbenfehlsichtigkeit die Wahrnehmung von Farben mithilfe von akustischen Signalen.“"
                            },
                            {
                                "example_id": "ab05a381-8b2f-4c7d-bb9d-f9a561a61139",
                                "sense_id": "c599e64c-c9a6-3b6f-94f0-fbc3207f3135",
                                "text": "„Sie leiden nur seltener unter Farbenfehlsichtigkeit und sind eher fähig, größere Farbvariationen zu sehen.“"
                            },
                            {
                                "example_id": "72a255ef-c6f6-4e7a-b646-b7d56934d081",
                                "sense_id": "c599e64c-c9a6-3b6f-94f0-fbc3207f3135",
                                "text": "„Die Farbenfehlsichtigkeit, häufig als Rot-Grün-Schwäche bekannt, kommt sogar relativ häufig vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
