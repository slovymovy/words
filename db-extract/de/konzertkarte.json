                "senses": [
                    {
                        "sense_id": "a21a0f2e-22ba-3ebd-b78a-9710491bd4f0",
                        "entry_id": "e4279685-fe80-395f-ad11-b10ecd4686ce",
                        "glosses": [
                            "Eintrittskarte, die zum Besuch eines Konzerts berechtigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afad6542-9f25-495c-8a45-3a0e9f962d36",
                                "sense_id": "a21a0f2e-22ba-3ebd-b78a-9710491bd4f0",
                                "text": "„Laut ‚Standard‘ wurden in Japan Reisen zum ‚Concert for Europe‘ angeboten, in denen die Konzertkarte nicht inkludiert war.“"
                            },
                            {
                                "example_id": "49c61f42-c6cc-447b-b425-4ef971a10236",
                                "sense_id": "a21a0f2e-22ba-3ebd-b78a-9710491bd4f0",
                                "text": "„Vor und nach dem Konzert kann an Tischen gegessen und getrunken werden. Die Konsumation ist in der Konzertkarte von 20 Franken nicht inbegriffen, kostet aber nur wenig.“"
                            },
                            {
                                "example_id": "a5a5b4b9-c4d3-4a60-a30b-49e5bc8f4454",
                                "sense_id": "a21a0f2e-22ba-3ebd-b78a-9710491bd4f0",
                                "text": "„Wer nicht zu den Glücklichen gehört, die sich früh günstige Konzertkarten sichern konnten, muss sich seine Elbphilharmonie-Experience irgendwie anders erkaufen, etwa im Restaurant ‚The Saffron‘ in der siebten Etage des Hotels ‚The Westin‘.“"
                            },
                            {
                                "example_id": "a2bed318-81bf-49ff-a494-5b81427bcc81",
                                "sense_id": "a21a0f2e-22ba-3ebd-b78a-9710491bd4f0",
                                "text": "„Früher hatte er manchmal Geld für Konzertkarten ausgegeben, aber meistens hatte er von Mutter deren Freikarten bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
