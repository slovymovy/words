                    },
                    {
                        "translation_id": "192f273f-2068-4095-810d-4fead483ec94",
                        "source_entry_id": "6e685367-aa53-3fc4-aec2-7409a90e57a1",
                        "source_sense_id": "241a8653-1099-3c42-8b3b-3de7c21bde3f",
                        "source_sense_description": "Medizin: Muskelschicht des Herzens",
                        "target_lang_word": "myocarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myocarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6a74a34-d680-32b0-923b-125df0eee72d",
                                        "entry_id": "59c78d59-e422-39b9-8683-8c1e05da9cb0",
                                        "glosses": [
                                            "Partie musculaire du cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2977a7-da0e-48ae-991a-2fd0af4251c4",
                                                "sense_id": "b6a74a34-d680-32b0-923b-125df0eee72d",
                                                "text": "Ces symptômes correspondent sans doute à des lésions du myocarde ou du péricarde qui ont été constatées en effet quelquefois."
                                            },
                                            {
                                                "example_id": "7fbb2dd7-e42c-4374-ba58-352cbc105cfb",
                                                "sense_id": "b6a74a34-d680-32b0-923b-125df0eee72d",
                                                "text": "J’apprends que la digitaline est un hétéroside très toxique qui produit un accroissement de l’amplitude des battements du cœur, un ralentissement du rythme cardiaque, une diminution de l’excitabilité du myocarde et de la conductibilité auriculo-ventriculaire."
                                            },
                                            {
                                                "example_id": "46003cff-9dcc-4d8b-92d7-98fadcb1d7d0",
                                                "sense_id": "b6a74a34-d680-32b0-923b-125df0eee72d",
                                                "text": "L’athérosclérose se produit quand des dépôts graisseux s'accumulent sur la paroi des artères, entraînant leur rétrécissement et une perte d’élasticité. Elle compte parmi les principales causes d'infarctus du myocarde et d'accidents vasculaires cérébraux (AVC)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "860f77ae-b7ce-45bb-a481-4a6a10507fcf",
                        "source_entry_id": "6e685367-aa53-3fc4-aec2-7409a90e57a1",
                        "source_sense_id": "241a8653-1099-3c42-8b3b-3de7c21bde3f",
