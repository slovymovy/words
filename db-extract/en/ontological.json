    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ba9d5961-d9dc-304f-b211-e0c68c4a1381",
                "word": "ontological",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                        "entry_id": "ba9d5961-d9dc-304f-b211-e0c68c4a1381",
                        "glosses": [
                            "Of or relating to ontology."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "878502ee-375e-4080-ac9f-5806561531ff",
                                "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                                "text": "A curious thing about the ontological problem is its simplicity. It can be put in three Anglo-Saxon monosyllables: ‘What is there?’ It can be answered, moreover, in a word—‘Everything’—and everyone will accept this answer as true."
                            },
                            {
                                "example_id": "bf9834ad-f090-4692-bf28-55d3f631575c",
                                "sense_id": "937de27e-2f9a-381c-a233-195af0400557",
                                "text": "Applying a critical discourse analysis to MM, this thesis argues that far-right media portrays any challenge to the status quo, be it demographic, political, cultural, or social, as threatening to ontological security by utilizing a Positive Self and Negative Other dichotomy."
                            }
                        ]
                    },
                    {
                        "sense_id": "159197b7-2af0-3cd2-baf6-0ded685f1cd3",
                        "entry_id": "ba9d5961-d9dc-304f-b211-e0c68c4a1381",
                        "glosses": [
                            "Of or pertaining to the nature of being or existence."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8cf92e79-d7bb-4aae-9124-1e931226a8d7",
                                "sense_id": "159197b7-2af0-3cd2-baf6-0ded685f1cd3",
                                "text": "Such is the human ontological imagination, and such is the convincingness of what it brings to birth. Unpicturable beings are realized, and realized with an intensity almost like that of an hallucination."
                            }
                        ]
                    }
                ],
