                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2bc5a611-1b73-4571-a83e-18e00c292f40",
                                "sense_id": "c0452e75-35ae-394a-837b-f472e6c6c8f4",
                                "text": "„Sie erzählten Heldengeschichten, ergingen sich über das bevorstehende Ende des Zaren aller Reußen und waren guter Dinge.“"
                            },
                            {
                                "example_id": "f673fb4b-2cb9-404b-b813-aa2e296b37b7",
                                "sense_id": "c0452e75-35ae-394a-837b-f472e6c6c8f4",
                                "text": "„Als Amerikaner wuchs ich mit den Heldengeschichten unserer Vorväter auf, die für Freiheit und Demokratie gekämpft haben, für die Befreiung der Sklaven ihr Leben opferten und die Welt von den Nazis befreiten.“"
                            },
                            {
                                "example_id": "f4d08da1-91e7-45a8-aea6-3ad40c284c1d",
                                "sense_id": "c0452e75-35ae-394a-837b-f472e6c6c8f4",
                                "text": "„Es war keine Heldengeschichte, die sich in den Jahren nach dem Krieg im geschrumpften und Not leidenden Deutschland abspielte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
