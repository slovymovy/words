                                        "examples": [
                                            {
                                                "example_id": "7491e692-63b2-4335-8477-5d5304c06f2c",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "In the end, why not be happy with both, with the BMXes and the pentathlons, with the swans of synchro and the Quasimodos of wrestling? Sweet."
                                            },
                                            {
                                                "example_id": "e204fa0c-9692-474c-9f55-09be299120aa",
                                                "sense_id": "d5487c8e-d575-3bf5-88ec-f0db1dfc27a3",
                                                "text": "Dwindling interest and a reputation for being outdated couldn’t change modern pentathlon. A brief video clip of a coach punching a horse at the Tokyo Olympics has altered it forever."
                                            }
                                        ]
                                    }
