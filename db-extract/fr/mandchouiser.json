                "senses": [
                    {
                        "sense_id": "40644a32-ba4e-3788-9047-60f299c8211b",
                        "entry_id": "2fd6c965-a6ec-3f03-911f-fa78a16fb28f",
                        "glosses": [
                            "Donner un caractère mandchou à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4120c44-9fc8-49b0-a9ff-77d09a1653fb",
                                "sense_id": "40644a32-ba4e-3788-9047-60f299c8211b",
                                "text": "Aucune tentative n’a été faite de « mandchouiser » la population, ni même le mandarinat, parce que, là comme ailleurs, le prestige des souverains reposait sur la différence et non la similitude."
                            },
                            {
                                "example_id": "b1a1d627-ca25-499f-86db-fe9a76db5314",
                                "sense_id": "40644a32-ba4e-3788-9047-60f299c8211b",
                                "text": "Non seulement les Chinois n’ont pas été «mandchouisés», « mongolisés », ou «tartarisés» mais ce sont au contraire les Mandchous, les Mongols et les autres qui se sont sinisés."
                            }
                        ]
                    }
                ],
