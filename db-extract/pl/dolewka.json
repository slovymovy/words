                    {
                        "sense_id": "543bee05-d94b-3e86-a2cd-c28b79d148d3",
                        "entry_id": "b85931be-2bb1-397c-a2b8-a8c430720c2e",
                        "glosses": [
                            "dodatkowa porcja zupy lub napoju"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "c9f19df0-a175-4877-b90f-2aa8f445a71d",
                                "sense_id": "543bee05-d94b-3e86-a2cd-c28b79d148d3",
                                "text": "Dlaczego nie chciałeś dolewki grzybowej?"
                            },
                            {
                                "example_id": "88b50611-2897-4cb3-ae93-23e01f24db55",
                                "sense_id": "543bee05-d94b-3e86-a2cd-c28b79d148d3",
                                "text": "Pójdę jeszcze po dolewkę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb553d41-65a1-4841-b340-7f95cf513cbf",
                        "source_entry_id": "b85931be-2bb1-397c-a2b8-a8c430720c2e",
                        "source_sense_id": "543bee05-d94b-3e86-a2cd-c28b79d148d3",
                        "target_lang_word": "refill",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "534323d3-5fbe-3570-8e19-ec62b006d324",
                                        "entry_id": "4398601d-1a58-36cc-a613-79f68ca92664",
                                        "glosses": [
                                            "That which serves to refill or replace something.",
                                            "An additional helping of food or drink at reduced cost."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad334b7d-a5d3-427e-8cde-bcf4060b5d0b",
                                                "sense_id": "534323d3-5fbe-3570-8e19-ec62b006d324",
                                                "text": "Today it is $2 for a coffee, with free refills throughout the day."
                                            },
                                            {
                                                "example_id": "060b9401-3b36-47cd-a065-e53475407545",
                                                "sense_id": "534323d3-5fbe-3570-8e19-ec62b006d324",
                                                "text": "\"Oh, gosh,\" he groaned, \"and I'd have given anything for a refill of that suet! It was the wizardest muck we've had this week.\""
                                            },
                                            {
                                                "example_id": "4726087d-05f4-4aaf-b3e1-646ecc49735d",
                                                "sense_id": "534323d3-5fbe-3570-8e19-ec62b006d324",
                                                "text": "Ippudo, which operates 50 ramen shops across the country, is offering endless free noodle refills for a fortnight from election day on Sunday until 24 July, the Mainichi Shimbun said, provided they could show proof that they had voted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25988e3-5e75-3cee-bca6-8d7b13c91e71",
                                        "entry_id": "4398601d-1a58-36cc-a613-79f68ca92664",
                                        "glosses": [
                                            "That which serves to refill or replace something.",
                                            "Refuelling, fuel to refill an empty fuel tank (of a vehicle or machine) or other fuel container."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672c4696-debf-45d1-8ce0-50ac4fd68888",
                                                "sense_id": "e25988e3-5e75-3cee-bca6-8d7b13c91e71",
                                                "text": "Tank's empty. We need to go for a refill."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08c08e7e-0020-3795-88f3-04415ed17159",
                                        "entry_id": "4398601d-1a58-36cc-a613-79f68ca92664",
                                        "glosses": [
                                            "That which serves to refill or replace something.",
                                            "A product intended to replace the used contents of a container or the exhausted supply of a device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50569466-5fa6-4bb7-8e5a-33aebcf44abd",
                                                "sense_id": "08c08e7e-0020-3795-88f3-04415ed17159",
                                                "text": "We're cutting back. No new printers or pens, just refills."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6890e9bf-5944-3a12-8359-9e080dbdf0eb",
                                        "entry_id": "4398601d-1a58-36cc-a613-79f68ca92664",
                                        "glosses": [
                                            "That which serves to refill or replace something.",
                                            "A repeat of a prescription."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                        "entry_id": "4398601d-1a58-36cc-a613-79f68ca92664",
                                        "glosses": [
                                            "An act or process of refilling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c81cdf4-612b-4a93-92f5-fd9984e5aef8",
                                                "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                                "text": "capillary refill"
                                            },
                                            {
                                                "example_id": "80161233-38f4-40bb-8ba4-dcdc3cf55360",
                                                "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                                "text": "[…] the modified UHI correlation captures 80 percent of the total data and thus provides a conservative estimate of the heat transfer during UHI refill."
                                            },
                                            {
                                                "example_id": "be4eef76-db77-49ee-866a-7c3de7853b38",
                                                "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                                "text": "After refill, start engine and observe installed fittings and valve to make certain there are no leaks."
                                            },
                                            {
                                                "example_id": "d018680e-7024-494e-a10a-8e21dda32fc2",
                                                "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                                "text": "Of course, the most efficient, money-saving option of all is straightforward refill. Ecover launched a redesign of their refill system in health food shops in 2009, which they're hoping to distribute more widely soon."
                                            },
                                            {
                                                "example_id": "5f9abde6-ebcc-49d2-a6cd-979e6466f664",
                                                "sense_id": "4eb3b529-afc3-3eb9-a740-80779578939c",
                                                "text": "During refill, the drop generator acts like a simple fluid mechanical oscillator"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "refill",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9f76b7-6e3d-311f-8e7f-40aa2bbbd43b",
                                        "entry_id": "ae7e1ece-1913-3d9b-9719-4f97dd58210c",
                                        "glosses": [
                                            "To fill up once again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cd6db68-a1cf-4c81-859f-5c1f30053796",
                                                "sense_id": "0a9f76b7-6e3d-311f-8e7f-40aa2bbbd43b",
                                                "text": "Can you refill my cup please? I've finished my coffee."
                                            }
                                        ]
                                    },
