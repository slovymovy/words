                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весь преподавательский <w>состав</w> собрался в зале для важного совещания.",
                            "target_lang_translations": {
                                "en": "The entire teaching <w>staff</w> gathered in the hall for an important meeting.",
                                "zh": "全体教职<w>人员</w>聚集在礼堂参加重要会议。",
                                "de": "Das gesamte Lehr<w>personal</w> versammelte sich im Saal für eine wichtige Besprechung."
                            }
