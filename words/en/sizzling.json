                    "sense_id": "91b19ad4-20a6-306f-aed2-306782699fa5",
                    "sense_definition": "Hot enough to make a hissing sound.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sizzling</w> pan was placed carefully on the wooden table.",
                            "target_lang_translations": {
                                "cs": "<w>Syčící</w> pánev byla opatrně položena na dřevěný stůl."
                            }
                        },
                        {
                            "text": "We could hear the <w>sizzling</w> meat cooking over the open fire.",
                            "target_lang_translations": {
                                "cs": "Slyšeli jsme <w>syčící</w> maso, které se peklo na otevřeném ohni."
                            }
                        }
                    ],
                    "synonyms": [
                        "hot",
                        "searing"
                    ],
                    "common_phrases": [
                        "sizzling pan"
                    ],
                    "target_lang_definitions": {
