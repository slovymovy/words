                ],
                "senses": [
                    {
                        "sense_id": "0a896d69-e40e-3137-aeac-3c3163bca2c5",
                        "entry_id": "a384a5dd-6d0e-3149-8269-f91b4016f78c",
                        "glosses": [
                            "The area of central nervous system that includes all higher nervous centers, enclosed within the skull and continuous with the spinal cord; synonym of brain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5c47573-afaf-4262-a1c7-8c9d014e24f7",
                                "sense_id": "0a896d69-e40e-3137-aeac-3c3163bca2c5",
                                "text": "Meronyms: prosencephalon, telencephalon, diencephalon; mesencephalon; rhombencephalon, metencephalon, myelencephalon"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17734b86-c4ac-4bd4-a6f9-756feb0b7f9d",
                        "source_entry_id": "a384a5dd-6d0e-3149-8269-f91b4016f78c",
                        "source_sense_id": "0a896d69-e40e-3137-aeac-3c3163bca2c5",
                        "source_sense_description": "brain",
                        "target_lang_word": "encéphale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encéphale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d8b1907-dbe5-3f8a-a798-0a1ea403e8c7",
                                        "entry_id": "4a4b3d06-c26f-3e92-b397-c2ce4f17734a",
                                        "glosses": [
                                            "Ensemble des centres du système nerveux central qui sont contenus dans la cavité du crâne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f321adf-9819-4e78-bedf-3c2fe19e052f",
                                                "sense_id": "3d8b1907-dbe5-3f8a-a798-0a1ea403e8c7",
                                                "text": "L’importance des altérations pathologiques de l’encéphale a donné lieu à de vives discussions, et l’on est encore loin d’être d’accord aujourd’hui."
                                            },
                                            {
                                                "example_id": "f3f7d43c-6333-409d-90af-327df5e26c62",
                                                "sense_id": "3d8b1907-dbe5-3f8a-a798-0a1ea403e8c7",
                                                "text": "La lésion unilatérale d’un grand nombre de parties de l’encéphale peut déterminer chez le sujet qui en est affecté, des mouvements involontaires de rotation, mouvements qui varient avec le siège et la profondeur de l’altération."
                                            },
                                            {
                                                "example_id": "001f1b1f-0bbb-492b-bba2-74679b80a425",
                                                "sense_id": "3d8b1907-dbe5-3f8a-a798-0a1ea403e8c7",
                                                "text": "L’ossification de membrane concerne la plus grande part de la voûte et de la face. La croissance des os de la voûte répond à l'augmentation du volume de l’encéphale sous-jacent."
                                            },
                                            {
                                                "example_id": "e8b48eb4-00c1-4229-be16-a3a3e669a4e0",
                                                "sense_id": "3d8b1907-dbe5-3f8a-a798-0a1ea403e8c7",
                                                "text": "La flottablilité donnée par le LCR réduit le poids effectif de l’encéphale de 97 %."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a92a5b-d547-3287-bb7c-e47c84e2fe76",
                                        "entry_id": "4a4b3d06-c26f-3e92-b397-c2ce4f17734a",
                                        "glosses": [
                                            "Tête."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3bf8786-9800-4a5a-9d32-65dac7cdafab",
                                                "sense_id": "46a92a5b-d547-3287-bb7c-e47c84e2fe76",
                                                "text": "C’est une marche triomphale,\nune ruée, une rafale\nà travers tout mon encéphale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
