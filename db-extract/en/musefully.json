                        "glosses": [
                            "In a museful manner, musingly, pensively."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e890f865-4494-4a42-b686-a6eebaea1b18",
                                "sense_id": "a2ac1200-50c0-3dba-bc88-b11bd826027d",
                                "text": "Diana’s face was clearly before him through the deluge; now in single features, the dimple running from her mouth, the dark bright eyes and cut of eyelids, and nostrils alive under their lightning; now in her whole radiant smile, or musefully listening, nursing a thought."
                            },
                            {
                                "example_id": "1ae27ebd-a55f-4c2a-9e40-f5ee33c44302",
                                "sense_id": "a2ac1200-50c0-3dba-bc88-b11bd826027d",
                                "text": "He spoke more musefully, in a slightly higher-pitched voice, and appeared to be in no hurry to reach those definite conclusions at which his cousin arrived—somewhat long-windedly but always with the end well in view."
                            },
                            {
                                "example_id": "268add66-1499-46a8-aeef-bd2b92b944f2",
                                "sense_id": "a2ac1200-50c0-3dba-bc88-b11bd826027d",
                                "text": "Phil, with his musefully mordant views of life, views he invariably expressed with not-a-consonant-wasted economy, could always make me laugh, even during moments that by all rights should make us shudder."
                            }
                        ]
                    }
