                                "target_senses": [
                                    {
                                        "sense_id": "ca5eecb1-8753-3d30-a5b6-2a148dcf6b5b",
                                        "entry_id": "a4fb422f-9728-3353-a9ab-4cdda0464bef",
                                        "glosses": [
                                            "ztráta mravní hodnoty a odpovědnosti, mravní rozklad a uvolnění kázně"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528e1def-5871-4d11-b15c-a18b531027f1",
                                                "sense_id": "ca5eecb1-8753-3d30-a5b6-2a148dcf6b5b",
                                                "text": "Tak umřel náš účetní šikovatel Vaněk, vzbudiv svou poslední větou panický strach u nepřítele, který se domníval, že bráně našemu přechodu přes řeku, odřezuje nás od zásobovacích bodů, způsobuje nám brzké vyhladovění a tím i demoralizaci v našich řadách."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17efb87d-21f4-4fd0-82e3-d13fdb8c11b5",
                        "source_entry_id": "1bc12068-2469-390b-873a-4313924d514f",
                        "source_sense_id": "09c3b9d7-03e1-399f-900e-676d551810fe",
                        "target_lang_word": "démoralisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démoralisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f963d13-8510-3c35-8e15-17f54d2b9581",
                                        "entry_id": "5ebe1f66-fc9c-33fa-9d2b-c23d3f54f239",
                                        "glosses": [
                                            "Action de démoraliser ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e459727-3d3c-4fd0-82e0-62612eb39ab3",
                                                "sense_id": "8f963d13-8510-3c35-8e15-17f54d2b9581",
                                                "text": "Même les raisons qui, aujourd'hui, riveraient une femme de cœur au sort de son époux, la vieillesse, la maladie, le départ pour le front, étaient cyniquement alléguées par elles pour quitter leur foyer ; et, symptôme plus grave de démoralisation, elles ne choquaient plus une opinion inhumaine et blasée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
