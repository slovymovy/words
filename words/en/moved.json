                            },
                            {
                                "target_lang_word": "пошевелился",
                                "target_lang_sense_clarification": "о физическом движении тела"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "mudado",
                                "target_lang_sense_clarification": "sobre cambiar de residencia"
                            },
                            {
                                "target_lang_word": "movido",
                                "target_lang_sense_clarification": "sobre cambiar la posición de un objeto"
                            },
                            {
                                "target_lang_word": "trasladado",
                                "target_lang_sense_clarification": "sobre cambiar algo de un lugar a otro"
