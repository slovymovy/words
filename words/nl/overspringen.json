{
    "word_family": [
        "sprong",
        "springer",
        "springing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ce584b0f-aa6a-34b2-b8cd-5cf3cbfadaa4",
                    "sense_definition": "van het een op het andere springen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "springen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze hield een zwavelstok bij de smeulende kolen, een vonk <w>sprong</w> <w>over</w>.",
                            "target_lang_translations": {
                                "it": "Avvicinò un fiammifero ai carboni ardenti, una scintilla <w>scoccò</w>."
                            }
                        },
                        {
                            "text": "Na jaren van vriendschap <w>sprong</w> de vonk eindelijk <w>over</w> tussen hen.",
                            "target_lang_translations": {
                                "it": "Dopo anni di amicizia, tra loro è finalmente <w>scoccata</w> la scintilla."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vonk springt over"
                    ],
                    "target_lang_definitions": {
                        "it": "Passare da un punto all'altro, spesso riferito a scintille o sentimenti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "scoccare",
                                "target_lang_sense_clarification": "riferito a una scintilla o all'inizio di un sentimento"
                            },
                            {
                                "target_lang_word": "passare",
                                "target_lang_sense_clarification": "riferito al trasferimento di qualcosa da un oggetto all'altro"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8553b740-74dd-30e3-8c3a-69471af1577d",
                    "sense_definition": "iets overslaan of niet behandelen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "overslaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De docent besloot om dit moeilijke hoofdstuk te <w>overspringen</w>.",
                            "target_lang_translations": {
                                "it": "L'insegnante ha deciso di <w>saltare</w> questo capitolo difficile."
                            }
                        },
                        {
                            "text": "Tijdens het lezen <w>sprong</w> hij per ongeluk een hele pagina <w>over</w>.",
                            "target_lang_translations": {
                                "it": "Mentre leggeva, ha <w>saltato</w> accidentalmente un'intera pagina."
                            }
                        }
                    ],
                    "synonyms": [
                        "overslaan"
                    ],
                    "target_lang_definitions": {
                        "it": "Omettere o saltare una parte di un testo o di un argomento."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "saltare",
                                "target_lang_sense_clarification": "omettere intenzionalmente o accidentalmente una parte"
                            },
                            {
                                "target_lang_word": "tralasciare",
                                "target_lang_sense_clarification": "non trattare un argomento o una sezione"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8c6e9b2-1a0a-31c0-89ea-0f3e7afb8386",
                    "sense_definition": "boven iets uitsteken of vooruitsteken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "uitsteken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De balk <w>sprong</w> duidelijk <w>over</w> de muur heen.",
                            "target_lang_translations": {
                                "it": "La trave <w>sporgeva</w> chiaramente oltre il muro."
                            }
                        },
                        {
                            "text": "Het metaal <w>sprong</w> aan de zijkant <w>over</w> de rand.",
                            "target_lang_translations": {
                                "it": "Il metallo <w>sporgeva</w> dal bordo sul lato."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitsteken"
                    ],
                    "target_lang_definitions": {
                        "it": "Sporgere o estendersi oltre un limite o un bordo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "sporgere",
                                "target_lang_sense_clarification": "essere in rilievo o uscire dal filo di una superficie"
                            },
                            {
                                "target_lang_word": "sovrastare",
                                "target_lang_sense_clarification": "estendersi al di sopra di qualcosa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}