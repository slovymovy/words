                                    {
                                        "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                        "entry_id": "10e2f611-11a3-3d72-b85e-aed602c410b8",
                                        "glosses": [
                                            "vorausblickend vor dem erforderlichen Zeitpunkt planen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1266b82e-ce49-46cb-83fd-b40bdddafbf8",
                                                "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                                "text": "Damit der Erholung im Urlaub nichts entgegensteht, sollten Beschäftigte ihre Ferienzeit vorplanen."
                                            },
                                            {
                                                "example_id": "dd05b97e-e681-4fc9-9525-32b7996d00a0",
                                                "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                                "text": "Das Land hatte argumentiert, dass der Beamte im Schichtdienst seine Dienstzeiten so vorplanen könne, dass es keinen zeitlichen Konflikte mit dem Mandat in der Politik gibt."
                                            },
                                            {
                                                "example_id": "74bb4215-a525-49d0-adba-69010ea5db12",
                                                "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                                "text": "Wer längere Strecken unterwegs ist, muss beim Laden vorplanen."
                                            },
                                            {
                                                "example_id": "a3ff376f-37e5-46a5-a95b-8fa3c99882bd",
                                                "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                                "text": "Der Snow Dome in Bispingen hat vorgeplant und den Strom schon lange eingekauft."
                                            },
                                            {
                                                "example_id": "781d2d72-a8f4-4434-8156-c5622c6b6655",
                                                "sense_id": "92aa56cf-5885-39a4-bf6a-918ce82d68a0",
                                                "text": "Da in der Eventbranche stets langfristig vorgeplant werden muss, ist es auch heuer zu zahlreichen Absagen von Konzerten und diversen Festen gekommen."
                                            }
                                        ],
