                ],
                "senses": [
                    {
                        "sense_id": "6693942d-12d8-3019-93a4-a96b231e8267",
                        "entry_id": "1d048216-cb57-3569-a0fb-99912472c54f",
                        "glosses": [
                            "Capreolus capreolus mannetjes ree"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a32919c-f919-4657-8c80-5cbfe5638d40",
                                "sense_id": "6693942d-12d8-3019-93a4-a96b231e8267",
                                "text": "Daarom mogen in heel Nederland vanaf 1 mei reebokken worden afgeschoten, dat voorkomt ongevallen. Omdat Overijssel een zeer reeënrijke provincie is mag het hier al vanaf 1 april. Jaarlijks worden er in heel Nederland tussen de 15.000 en 20.000 reeën afgeschoten."
                            },
                            {
                                "example_id": "09ca9130-ca71-4db9-bd16-408ee61290b9",
                                "sense_id": "6693942d-12d8-3019-93a4-a96b231e8267",
                                "text": "De reebok werd in het kader van het project Ruimte voor aaseters in de natuur neergelegd. Kadavers zijn schaars, schrijven de deelnemende natuurorganisaties op hun website. Aangereden wild wordt vaak vernietigd en ook in natuurgebieden worden dode dieren opgeruimd. Door verkeersslachtoffers terug te plaatsen, hopen de organisaties dat grote aaseters weer terugkeren in de natuur."
                            }
                        ]
                    },
                    {
                        "sense_id": "80e19fce-3100-304e-8017-898c6de8fbd7",
                        "entry_id": "1d048216-cb57-3569-a0fb-99912472c54f",
                        "glosses": [
                            "vlees van een reebok"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e702e97-91de-494b-9de5-431492ea75bc",
                                "sense_id": "80e19fce-3100-304e-8017-898c6de8fbd7",
                                "text": "Het hoofdgerecht is een ouderwets smulbord: sappige filet van reebok en grove stoof met een stamppotje van spruiten en kweeperenmosterd."
                            }
                        ]
                    },
                    {
                        "sense_id": "65007631-d372-3d7f-8f29-fd965e87bf2d",
                        "entry_id": "1d048216-cb57-3569-a0fb-99912472c54f",
                        "glosses": [
                            "merk sportkleding"
                        ],
                        "tags": [
                            "schoeisel"
                        ],
                        "examples": [
                            {
                                "example_id": "a5fb3673-3cbf-4a5c-bbaa-ed9ccbc1ef56",
                                "sense_id": "65007631-d372-3d7f-8f29-fd965e87bf2d",
                                "text": "Taekwang was een van de vele bedrijven die produceerden voor giganten als Nike, Adidas en Reebok. Maar Park besefte snel dat hij niet alleen goedkope arbeidskrachten moest inzetten, maar ook computertechnologie die toeliet om verfijndere schoenen te maken."
                            }
                        ]
                    }
