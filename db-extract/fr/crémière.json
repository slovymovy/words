                        "sense_id": "24533d1e-cacc-3eee-aa75-4118fc29c317",
                        "entry_id": "fa64b60f-db2f-39a4-a726-c0e959ddd471",
                        "glosses": [
                            "Celle qui est spécialisée dans le commerce des produits laitiers (crème, mais aussi lait, beurre et fromage)."
                        ],
                        "tags": [
                            "Laiterie"
                        ],
                        "examples": [
                            {
                                "example_id": "06aa5b92-d79d-469a-954e-c2a3233ba9d0",
                                "sense_id": "24533d1e-cacc-3eee-aa75-4118fc29c317",
                                "text": "La nouvelle crémière, était une personne d’une cinquantaine d’années, débordante d’embonpoint."
                            }
                        ]
                    },
                    {
                        "sense_id": "c297cbad-8220-36eb-9e0e-590461402319",
                        "entry_id": "fa64b60f-db2f-39a4-a726-c0e959ddd471",
                        "glosses": [
                            "Pot à crème."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "239346ca-a0c1-499b-a1aa-1b3e5ca852e4",
                                "sense_id": "c297cbad-8220-36eb-9e0e-590461402319",
                                "text": "La crémière est un vase étroit ; un véritable pot à petite ouverture, afin que la crème qu’on y dépose se conserve fraîche."
                            },
                            {
                                "example_id": "1c980a5a-82b9-4b5d-92f3-47e8e9a2bb93",
                                "sense_id": "c297cbad-8220-36eb-9e0e-590461402319",
                                "text": "Dans le cas où la crème serait trop liquide, an la déposerait dans un vase appelé crémière, laquelle doit être munie, au niveau de son fond, d’une petite ouverture fermée par un fausset."
                            }
                        ]
                    }
