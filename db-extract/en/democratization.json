                                        "entry_id": "beef7f5f-ffb9-3520-819c-b8288b0d33d1",
                                        "glosses": [
                                            "Verwirklichung demokratischer Prinzipien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
