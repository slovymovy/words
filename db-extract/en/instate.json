                                    {
                                        "sense_id": "c50695a4-37e6-3c37-9412-3f29e92528f2",
                                        "entry_id": "cdf71ee7-e2f1-354f-89b8-f78629e024cf",
                                        "glosses": [
                                            "Establecer."
