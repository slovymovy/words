                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7b70427-3167-4168-968b-a16165763a98",
                                "sense_id": "608d75dd-d4ec-3ea7-bc4c-68d6fa1430fe",
                                "text": "Dora blijft staan en zet haar alarmlichten aan om de shovel ruimte te geven om te manoeuvreren."
                            },
                            {
                                "example_id": "31818f8f-f867-439b-9bbf-36a3cbcdd627",
                                "sense_id": "608d75dd-d4ec-3ea7-bc4c-68d6fa1430fe",
                                "text": "Als ik op de snelweg plots stil kom te staan, zet ik altijd mijn alarmlichten aan. Meestal ben ik dan de enige en dat begrijp ik niet. En ook: als ik rem, dan waarschuw ik altijd even door vlug achter elkaar tweemaal op mijn rem te trappen, met het oog op de remlichten."
                            }
                        ]
