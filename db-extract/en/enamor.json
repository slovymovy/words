                    },
                    {
                        "translation_id": "10ef300c-54e6-4a5f-85df-40c2233c89d7",
                        "source_entry_id": "ba9787c8-fa30-3b4b-9cd9-b92a438a70e8",
                        "source_sense_description": "to inflame with love",
                        "target_lang_word": "erobern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erobern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f8b6d49-cd00-3637-8fcd-d134ec897cf4",
                                        "entry_id": "6509f76e-0d89-31d4-a350-3c7c29571313",
                                        "glosses": [
                                            "ein fremdes Land in einem Krieg dem Feind wegnehmen und unter die eigene Herrschaft bringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "069a59bf-da41-414f-bfd9-d8fc407caa61",
                                                "sense_id": "1f8b6d49-cd00-3637-8fcd-d134ec897cf4",
                                                "text": "Eingeschworene Kampfgemeinschaft, deren Recht und Aufgabe sollte es sein, dem deutschen Volk im „natürlichen“ Daseinskampf der Völker den nötigen „Lebensraum“ zu erobern."
                                            },
                                            {
                                                "example_id": "411b9db1-0dc5-4253-bd4e-09de1418f58e",
                                                "sense_id": "1f8b6d49-cd00-3637-8fcd-d134ec897cf4",
                                                "text": "„Sein Plan war, zunächst von Bulgarien und dem griechischen Thrakien aus den europäischen Teil der Türkei zu erobern, Istanbul zu nehmen und den Bosporus zu überqueren, um weiter nach Anatolien vorzustoßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d3c21cf-15e5-3c23-85b8-b0a423fc6c9f",
                                        "entry_id": "6509f76e-0d89-31d4-a350-3c7c29571313",
                                        "glosses": [
                                            "jemand anderen für sich selbst günstig stimmen, einnehmen, gewinnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42300e8e-e95b-4475-89bb-5c10272cd528",
                                                "sense_id": "7d3c21cf-15e5-3c23-85b8-b0a423fc6c9f",
                                                "text": "„Lächeln von süßsauer bis jovial eroberte die Gesichter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
