                        "glosses": [
                            "In a lasting manner, in a way that persists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2ee52a-ee5c-4bfd-ba02-b3e700aec7dd",
                                "sense_id": "105e8e11-72a1-3d88-8a8b-37fad47e9f40",
                                "text": "Only by good diplomacy will we lastingly establish peace."
                            }
                        ]
                    }
