                                "sense_id": "8360a295-a6e7-3bc0-a2ce-ddd6b5704777",
                                "text": "Steve Davis plays snooker professionally."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ce34719-7cfb-34cc-9f58-6b15261eba31",
                        "entry_id": "7447d1ad-b62a-3e05-91a4-b2d288f86028",
                        "glosses": [
                            "In a professional manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2562fd2-d930-441d-adaa-b835053755ca",
                                "sense_id": "7ce34719-7cfb-34cc-9f58-6b15261eba31",
                                "text": "You handled that customer's complaint very professionally."
                            },
                            {
                                "example_id": "5bf190e3-6c22-4492-9a3a-a4e4b80bb20e",
                                "sense_id": "7ce34719-7cfb-34cc-9f58-6b15261eba31",
                                "text": "There is no precredit compassion expressed in “Side Street”: In place of Ray’s protective, implied narrator there is the professionally gruff voice of Paul Kelly, an actor who specialized in coldly professional New York City police detectives."
                            }
                        ]
                    }
                ],
