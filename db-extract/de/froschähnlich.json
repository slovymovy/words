                ],
                "senses": [
                    {
                        "sense_id": "b9f6429e-63d4-32db-a8d4-519d8e4402b2",
                        "entry_id": "e8e97947-65f1-33a9-8bce-a4a06a410358",
                        "glosses": [
                            "einem Frosch ähnelnd, wie ein Frosch aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c651a4e7-95cf-4d6e-ad85-3badbeaf2375",
                                "sense_id": "b9f6429e-63d4-32db-a8d4-519d8e4402b2",
                                "text": "„Die Straße wird von einem klobigen, froschähnlichen Jeep-Ding von General Jim abgesperrt, aus dem intensives rotes und blaues Licht funkelt.“"
                            },
                            {
                                "example_id": "7bc70e54-0b16-4db5-b6f6-10fe0d16742b",
                                "sense_id": "b9f6429e-63d4-32db-a8d4-519d8e4402b2",
                                "text": "„Ich glaubte nicht, dass er in der Lage wäre, die Leiche zu transportieren oder in die froschähnliche Position mit gespreizten Beinen und gekrümmten Knien zu zwingen, in der man sie gefunden hatte.“"
                            },
                            {
