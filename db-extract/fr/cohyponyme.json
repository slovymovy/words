                                "target_senses": [
                                    {
                                        "sense_id": "34a1e584-637d-3b43-8fd9-c04e72cb4fcb",
                                        "entry_id": "ca2c0a89-96b3-30e4-a1b3-34b953cbff13",
                                        "glosses": [
                                            "A term (word or noun phrase) that shares a hypernym (or hypernymic noun phrase) with another: that is, one that names another type (kind) within the same class."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5942a0ac-8dcd-4068-909d-f996227c8f3f",
                                                "sense_id": "34a1e584-637d-3b43-8fd9-c04e72cb4fcb",
                                                "text": "The words oak, maple, spruce, and linden are coordinate terms beneath the hypernym of tree."
                                            },
                                            {
                                                "example_id": "fa07f16b-d855-479a-9883-13aa133f73e7",
                                                "sense_id": "34a1e584-637d-3b43-8fd9-c04e72cb4fcb",
                                                "text": "The terms HDA, LAMP, MDA, NASBA, RPA, SDA, and TMA are coordinate terms beneath the hypernymic term isothermal nucleic acid amplification test."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
