                ],
                "senses": [
                    {
                        "sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                        "entry_id": "f81b0bbb-4fda-3721-ae78-db014cbe4000",
                        "glosses": [
                            "het opnieuw met iets beginnen, waar men eerder mee gestopt was"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20a49a9a-033c-4f8d-853a-7c14fbe58247",
                                "sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                                "text": "Ook Van der Gaag was niet tevreden, getuige twee wissels bij de hervatting: Fabian Sporkslede en Gervane Kastaneer vervingen Arno Verschueren en Mounir El Allouchi. Maar de gifbeker bleek nog niet leeg voor de thuisploeg. Keeper Benjamin van Leer tastte in de 52ste minuut volledig mis bij een ongevaarlijk schot van Ahmed El Messaoudi en zag de bal tussen z'n handen door in het net rollen: 1-2."
                            },
                            {
                                "example_id": "e039c378-cc20-4c41-ab26-318eac598544",
                                "sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                                "text": "Na hervatting van de handel werden minnen voor de banken opgetekend tot meer dan 8 procent. De hoofdindex FTSE MIB in Milaan ging ruim 4 procent omlaag."
                            },
                            {
                                "example_id": "06f99797-7529-40ca-8b12-039395a258b2",
                                "sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                                "text": "De Europese aandelenbeurzen gingen woensdag over een breed front omlaag. De grondstoffenbedrijven behoorden tot de sterkste dalers door de aanhoudende handelszorgen. Daarnaast waren beleggers in afwachting van de hervatting van de handelsgesprekken tussen de Verenigde Staten en Canada."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2502d4ff-8fe4-4669-980f-13e39d67ec2b",
                        "source_entry_id": "f81b0bbb-4fda-3721-ae78-db014cbe4000",
                        "source_sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                        "target_lang_word": "resumption",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resumption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e6bccb9-248c-385d-b58a-d6226bbc6558",
                                        "entry_id": "1d0e90e5-13fb-3156-ad30-4a9f46aa17dd",
                                        "glosses": [
                                            "The act of resuming or starting something again."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff31a1ab-5443-4b16-a1c8-a7fe273406fe",
                                                "sense_id": "4e6bccb9-248c-385d-b58a-d6226bbc6558",
                                                "text": "And that supremacy was confirmed six minutes after the resumption with their second goal. Dzeko was again involved, slipping a neat pass through to the foraging Toure, who poked a right-foot finish past Butt."
                                            },
                                            {
                                                "example_id": "9b6cab4d-0fcf-4fc6-bcb4-d273b5791018",
                                                "sense_id": "4e6bccb9-248c-385d-b58a-d6226bbc6558",
                                                "text": "But Murphy remains upbeat about the longer-term prospect of recovery and a resumption of the record growth in passenger volumes experienced in the UK in the two decades following privatisation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b71274-59a4-3a65-8d46-620e9374a70c",
                                        "entry_id": "1d0e90e5-13fb-3156-ad30-4a9f46aa17dd",
                                        "glosses": [
                                            "eminent domain"
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76e2868f-5bc9-45bb-aeea-b928194615ce",
                        "source_entry_id": "f81b0bbb-4fda-3721-ae78-db014cbe4000",
                        "source_sense_id": "cf2a6e05-d702-3c7a-a83f-3dbde3fa4aba",
                        "target_lang_word": "repetition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
