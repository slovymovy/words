                    },
                    {
                        "translation_id": "53dc84cd-d2f4-49a6-8cd4-c70d45dcd4cb",
                        "source_entry_id": "47e987a0-a5b8-3d3c-8f97-fbd6459916e4",
                        "source_sense_id": "96a37543-af1c-35e2-93c8-8c66ff911d97",
                        "source_sense_description": "übertragen: Leidenschaft, tiefes Gefühl",
                        "target_lang_word": "heart and soul",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heart and soul",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24799a82-8232-3eab-a6da-c358ad1ac222",
                                        "entry_id": "3e696073-2ff9-3fc0-9458-549c4b802513",
                                        "glosses": [
                                            "The core of a thing; the most essential or important part."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "197d5935-10bc-4f19-a7d1-da109533b948",
                                                "sense_id": "24799a82-8232-3eab-a6da-c358ad1ac222",
                                                "text": "The heart and soul of any democracy is its electorate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0532c43e-ca21-3dd7-9a13-e2de7f9fd6fe",
                                        "entry_id": "3e696073-2ff9-3fc0-9458-549c4b802513",
                                        "glosses": [
                                            "Passion; true commitment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ca05479-858a-46fa-aaca-732a27bdf309",
                                                "sense_id": "0532c43e-ca21-3dd7-9a13-e2de7f9fd6fe",
                                                "text": "She put her heart and soul into the project."
                                            },
                                            {
                                                "example_id": "1c7a0890-8a46-4dbe-9756-5c58b5621aae",
                                                "sense_id": "0532c43e-ca21-3dd7-9a13-e2de7f9fd6fe",
                                                "text": "“I’m not going anywhere,” Mr. Biden said. “I know yesterday’s news was surprising and hard for you to hear,” he went on, “but it was the right thing to do. I know it’s hard because you poured your heart and soul into me to help us win this thing.”"
                                            }
                                        ]
                                    }
                                ]
                            },
