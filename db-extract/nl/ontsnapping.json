                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "escape",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d538b88-f503-3392-8ca8-d0fd51c8950d",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To get free; to free oneself."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc63ed32-92ed-4d4f-9d42-40ce44bc7b9f",
                                                "sense_id": "8d538b88-f503-3392-8ca8-d0fd51c8950d",
                                                "text": "The prisoners escaped by jumping over a wall."
                                            },
                                            {
                                                "example_id": "77de78ee-6d7a-4bc9-ab58-4566364cccc2",
                                                "sense_id": "8d538b88-f503-3392-8ca8-d0fd51c8950d",
                                                "text": "The factory was evacuated after toxic gases escaped from a pipe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To avoid (any unpleasant person or thing); to elude, get away from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3991d670-b649-4396-ab8d-256afc81d9e3",
                                                "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                                "text": "The children climbed out of the window to escape the fire."
                                            },
                                            {
                                                "example_id": "2ef7839a-777c-460a-b874-27f8403d6d40",
                                                "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                                "text": "He only got a fine and so escaped going to jail."
                                            },
                                            {
                                                "example_id": "1d641221-ee2e-4682-9392-cf3b650b4846",
                                                "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                                "text": "sailors that escaped the wreck"
                                            },
                                            {
                                                "example_id": "25f1d9d2-e85b-41d9-94b2-4b6e657e0061",
                                                "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                                "text": "Luiz was Chelsea's stand-out performer, although Ferguson also had a case when he questioned how the £21m defender escaped a red card after the break for a hack at Rooney, with the Brazilian having already been booked."
                                            },
                                            {
                                                "example_id": "dc373528-23d0-4dd0-9cf5-3daff5029660",
                                                "sense_id": "f86f8c8b-f677-337b-a83d-5039db52dbd3",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae133f29-325d-3c94-9667-ce449eb2f6fb",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To avoid capture; to get away with something, avoid punishment."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b02ff60-b730-48c3-a022-52b8f60150e6",
                                                "sense_id": "ae133f29-325d-3c94-9667-ce449eb2f6fb",
                                                "text": "Luckily, I escaped with only a fine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f14483d5-2ab6-3194-a736-675091c3e3f2",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To elude the observation or notice of; to not be seen or remembered by."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e3c3077-cdea-47f5-a69e-ccf8915bc69d",
                                                "sense_id": "f14483d5-2ab6-3194-a736-675091c3e3f2",
                                                "text": "The name of the hotel escapes me at present."
                                            },
                                            {
                                                "example_id": "28b2cba0-515e-4f28-8aad-3e8439e2d8d1",
                                                "sense_id": "f14483d5-2ab6-3194-a736-675091c3e3f2",
                                                "text": "The detective examined the crime scene, but one clue escaped his notice."
                                            },
                                            {
                                                "example_id": "6d15e73b-2f79-43e4-a0be-dee3e710e306",
                                                "sense_id": "f14483d5-2ab6-3194-a736-675091c3e3f2",
                                                "text": "c. 1698-1699 (year published) Edmund Ludlow, Memoirs\nThey escaped the search of the enemy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To cause (a single character, or all such characters in a string) to be interpreted literally, instead of with any special meaning it would usually have in the same context, often by prefixing with another character."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0400cbd4-366a-4c70-b5ef-a7e4e0c8326b",
                                                "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                                "text": "When using the \"bash\" shell, you can escape the ampersand character with a backslash."
                                            },
                                            {
                                                "example_id": "7ab3e49a-396c-4740-be28-32cc89512569",
                                                "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                                "text": "Brion escaped the double quote character on Windows by adding a second double quote within the literal."
                                            },
                                            {
                                                "example_id": "57c8df83-80d2-447c-a777-9d7b01d9a5b3",
                                                "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                                "text": "If the data for a URI component would conflict with the reserved purpose, then the conflicting data must be escaped before forming the URI."
                                            },
                                            {
                                                "example_id": "f09365b7-5524-45cb-ba22-458e0ed38d73",
                                                "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                                "text": "Character Data tags allow you to place complex strings as the text of an element—without the need to manually escape the string."
                                            },
                                            {
                                                "example_id": "e3652072-77ca-48b8-a2c3-428886c49794",
                                                "sense_id": "89b3f613-f136-371e-a0ee-e724b8e98347",
                                                "text": "Therefore, what follows is a list of typical output functions; your job is to determine if any of the functions print out tainted data that has not been passed through some sort of HTML escaping function."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "280a19a4-872a-3a00-af62-c8fb3b7f8b20",
                                        "entry_id": "5ab2cbc9-6d11-3e21-ba13-516033a5deac",
                                        "glosses": [
                                            "To halt a program or command by pressing a key (such as the \\\"Esc\\\" key) or combination of keys."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
