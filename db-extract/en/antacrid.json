                        "glosses": [
                            "Serving to correct acridness of the humours."
                        ],
                        "tags": [
                            "archaic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0aaa12ee-6142-42ce-9d66-45a8e7f5362f",
                                "sense_id": "5a5cfac4-3b35-3be3-95ed-0d1e26686181",
                                "text": "It is antacrid probably; is called a specific for the epilepsy, and all corrvulsive disorders; and commended also for vertigoes, apoplexies, pleurifies, quartans, worms, and I don't know what."
                            },
                            {
                                "example_id": "bd6bdb11-0d09-4a2b-84e0-b754f748b412",
                                "sense_id": "5a5cfac4-3b35-3be3-95ed-0d1e26686181",
                                "text": "Take extract of lead, mercurial ointment, antacrid cerate , of each an equal part. Incorporate them in a mortar or on a tile."
                            },
                            {
                                "example_id": "409bbc58-f115-4b18-bcf6-f63e9debeeea",
                                "sense_id": "5a5cfac4-3b35-3be3-95ed-0d1e26686181",
                                "text": "In syphilis, I directed the patient to take of the antacrid tincture 15 drops in a little water or sassafras tea, three times a day, and dress the chancres with the prepared calomel powder, covered with lint, twice a day."
                            }
                        ]
                    }
