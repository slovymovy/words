                "senses": [
                    {
                        "sense_id": "6126edea-47af-3e94-8c5c-2580d1f34ac8",
                        "entry_id": "dd0e2399-23a2-392d-bd1d-7b91ac05b6fc",
                        "glosses": [
                            "rhetorische Figur, Doppelreim mit vertauschten Anfangskonsonanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84f36d21-fa1d-430f-839b-1d5b310aa4b3",
                                "sense_id": "6126edea-47af-3e94-8c5c-2580d1f34ac8",
                                "text": "Schüttelreime werden gerne in humoristischen Gedichten verwendet."
                            },
                            {
                                "example_id": "bc217819-5a55-433e-bc6a-961b10905dbc",
                                "sense_id": "6126edea-47af-3e94-8c5c-2580d1f34ac8",
                                "text": "Ein beliebter Schüttelreim lautet: „Beim Boxen in der Meisterklasse schlägt man sich zu Kleistermasse.“"
                            },
                            {
                                "example_id": "d03851b0-8b08-40c4-9e8d-be1dddc2b0dd",
                                "sense_id": "6126edea-47af-3e94-8c5c-2580d1f34ac8",
                                "text": "„Der Schüttelreim gilt als umso besser und treffender, je kompakter und kürzer er ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
