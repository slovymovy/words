                        "glosses": [
                            "The act or process of deperming."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db19147a-e0af-45bf-9cd8-c042da187477",
                                "sense_id": "0c5b7117-f8c0-3328-a203-6189073da7d3",
                                "text": "Fortunately a very pronounced extension of life was found to be possible for wipes and deperms by making the initial current very strong so that, for example, a positive component was made a larger negative one before being reduced to zero […]"
                            },
                            {
                                "example_id": "cc5b1d52-3e58-4e5b-b1b1-68ac42a12f7e",
                                "sense_id": "0c5b7117-f8c0-3328-a203-6189073da7d3",
                                "text": "One interesting feature of the S/N 008A and S/N 009 data is that the residual moment after deperms one through three increased from 735 to 870 pole-cm for S/N 008A, but decreased from 854 to 659 pole-cm for S/N 009."
                            }
                        ]
                    }
                ],
