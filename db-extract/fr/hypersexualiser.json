                ],
                "senses": [
                    {
                        "sense_id": "aaf42835-12ff-3bd4-aded-306036c096e8",
                        "entry_id": "db432ecf-197d-38a7-9474-5a57632db32f",
                        "glosses": [
                            "Donner un caractère sexuel démesuré à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48be9469-480d-4a5a-98a7-40a258f1e51e",
                                "sense_id": "aaf42835-12ff-3bd4-aded-306036c096e8",
                                "text": "Un adolescent qui hypersexualise les relations est toujours, d'après mon expérience, dans une quête affective importante, quoi que méconnue."
                            },
                            {
                                "example_id": "92c372ad-626e-4cdc-9e73-eac04d6915fd",
                                "sense_id": "aaf42835-12ff-3bd4-aded-306036c096e8",
                                "text": "On hypersexualise, on désexualise ; on désexualise, on hypersexualise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1955d4df-3cb9-4166-8a51-b6aa6ab3f3dc",
                        "source_entry_id": "db432ecf-197d-38a7-9474-5a57632db32f",
                        "source_sense_id": "aaf42835-12ff-3bd4-aded-306036c096e8",
                        "target_lang_word": "hypersexualize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypersexualize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "394a4b1d-72ea-3e7b-8ee7-4fcf523c199c",
                                        "entry_id": "98dcf6d3-0a20-338d-b156-df881960efb8",
                                        "glosses": [
                                            "To make extremely sexual; to accentuate the sexuality of"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3019cda1-e1ec-49c1-9546-57803f7e5f8e",
                                                "sense_id": "394a4b1d-72ea-3e7b-8ee7-4fcf523c199c",
                                                "text": "Yet even as he stood as a not-so-benign emblem of black power, erotic and otherwise, the hypersexualized black male also became fodder for white exploitation."
                                            },
                                            {
                                                "example_id": "a97786e9-f832-44f1-9320-fe2455f01461",
                                                "sense_id": "394a4b1d-72ea-3e7b-8ee7-4fcf523c199c",
                                                "text": "[…]Gerwig was influenced by directors such as Max Ophüls and Jacques Tati, as if that confers greater legitimacy on a film using IP (intellectual property) to make money for a toy company that sells vacuous, hypersexualised dolls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "032afc9f-1a66-498e-b4fc-f79542ca19bf",
                        "source_entry_id": "db432ecf-197d-38a7-9474-5a57632db32f",
                        "source_sense_id": "aaf42835-12ff-3bd4-aded-306036c096e8",
                        "target_lang_word": "hypersexualise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypersexualise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f80a4b1-7400-3a06-9544-5d78ee570610",
                                        "entry_id": "56e83340-3fb2-3816-88bc-e3218187e70d",
                                        "glosses": [
                                            "Non-Oxford British English standard spelling of hypersexualize."
                                        ],
                                        "tags": [
                                            "UK",
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1dc78ea-b4fb-4df5-b074-b469c67d669c",
                                                "sense_id": "2f80a4b1-7400-3a06-9544-5d78ee570610",
                                                "text": "Jada's case happened within the wider context of a world that objectifies women, and hypersexualises black women, in particular, to the point of dehumanisation."
                                            },
                                            {
                                                "example_id": "42c6cc49-ab88-44f8-a9be-2ebc9bb21426",
                                                "sense_id": "2f80a4b1-7400-3a06-9544-5d78ee570610",
                                                "text": "Girls has been widely praised for its realistic portrayal of women in an industry that tends to underwrite and hypersexualise female characters."
                                            },
                                            {
                                                "example_id": "df0ed65a-c8e3-4683-b01d-69ddf30d0519",
                                                "sense_id": "2f80a4b1-7400-3a06-9544-5d78ee570610",
                                                "text": "[…]Gerwig was influenced by directors such as Max Ophüls and Jacques Tati, as if that confers greater legitimacy on a film using IP (intellectual property) to make money for a toy company that sells vacuous, hypersexualised dolls."
                                            },
                                            {
                                                "example_id": "ba219767-e6b5-4c97-8284-62bfd57bff6a",
                                                "sense_id": "2f80a4b1-7400-3a06-9544-5d78ee570610",
                                                "text": "Related subtrends such as balletcore, Barbiecore and regency-core have drawn criticism for hypersexualising innocence and encouraging women to dress for the male gaze."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
