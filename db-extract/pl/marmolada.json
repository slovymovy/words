                                        "entry_id": "00b17c63-fdff-3e76-819c-bb5c21620252",
                                        "glosses": [
                                            "A kind of jam made with citrus fruit, distinguished by being made slightly bitter by the addition of the peel and by partial caramelisation during manufacture. Most commonly made with Seville oranges, and usually qualified by the name of the fruit when made with other types of fruit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e5422e-0713-4e49-92d1-da97849ad8e7",
                                                "sense_id": "40d44a1c-b5e1-3cd7-a4a3-73f19b58d11d",
                                                "text": "lime marmalade"
                                            },
                                            {
                                                "example_id": "5836a98c-9351-4e16-9705-bea66f6fe6ce",
                                                "sense_id": "40d44a1c-b5e1-3cd7-a4a3-73f19b58d11d",
                                                "text": "thick cut marmalade"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ddabc1-2ea2-34ff-95ec-baab8128cbee",
                                        "entry_id": "00b17c63-fdff-3e76-819c-bb5c21620252",
                                        "glosses": [
                                            "Quince jam."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "539ada7f-853d-3e1a-bf39-4fedb090e802",
                                        "entry_id": "00b17c63-fdff-3e76-819c-bb5c21620252",
                                        "glosses": [
                                            "A cat having orange- or ginger-colored fur."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a6c8a59-b769-4682-857e-1ee83ac063b5",
                                                "sense_id": "539ada7f-853d-3e1a-bf39-4fedb090e802",
                                                "text": "We breed our marmalades for a modern taste. Gingers can be tiger-striped, splotched, or all one shade in a choice of spicy colors; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
