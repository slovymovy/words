        "fr-extract.jsonl": [
            {
                "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                "word": "Zurich",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "07097730-61c7-4036-9865-46da454c3241",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "tags": [],
                        "form": "Zürich"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "72ef1350-482a-38ca-a03a-35ec38096670",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "glosses": [
                            "Ville et commune de Suisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba3528d-afa2-4df4-aac1-0946c72ef94c",
                                "sense_id": "72ef1350-482a-38ca-a03a-35ec38096670",
                                "text": "Cette particularité semble confirmer nettement l'interprétation que donne l'éminent phytosociologue de Zurich, à savoir que le fauchage est défavorable aux Thérophytes."
                            },
                            {
                                "example_id": "dce283d3-a7a8-4e65-942e-f5b17a64c138",
                                "sense_id": "72ef1350-482a-38ca-a03a-35ec38096670",
                                "text": "Jed prit soudain conscience que Zurich n’était pas seulement la base d’opération d’une association qui euthanasiait les vieillards, mais aussi le lieu de résidence de personnes riches, et même très riches, parmi les plus riches du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "26e5cda9-0670-3dcb-8207-17ae069a2c5f",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "glosses": [
                            "Canton autour de cette ville."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "05655d29-d0f8-3799-93c7-c8fca3599939",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "glosses": [
                            "District de ce canton incluant la ville."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b2ab4768-facb-3b5c-a6ab-f488503ede97",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "glosses": [
                            "Ancien nom de la commune de Sidi Amar dans la wilaya de Tipaza en Algérie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5672db78-31b0-3efd-9e55-7a4cc315b04e",
                        "entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "glosses": [
                            "Village des Pays-Bas situé dans la commune de Sùdwest-Fryslân."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18ff8ec9-7077-43ac-8710-5107b6caddcc",
                        "source_entry_id": "42bc8a7a-08cc-3204-9d74-c26f91063b75",
                        "target_lang_word": "Zürich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zürich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                        "entry_id": "da73acbf-0dd4-36f7-b641-53d059a8f722",
                                        "glosses": [
                                            "größte Stadt in der Schweiz, gelegen an der Limmat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52135495-8c86-45ec-9b53-7ed3592bddcd",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "Die Stadt Zürich hat über 430.000 Einwohner."
                                            },
                                            {
                                                "example_id": "c77068cd-c037-4dc9-b393-aa0ad61b49db",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "Das Zürich der dreißiger Jahre hatte seinen ganz eigenen Charme."
                                            },
                                            {
                                                "example_id": "5eaae9ed-11a8-4d83-a589-ffd38d950696",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "„Rund tausend Kunden einer kleinen, feinen Bank in Zürich müssen nun fürchten, wegen Steuerhinterziehung belangt zu werden.“"
                                            },
                                            {
                                                "example_id": "bc826bcd-ff27-4afc-b581-db391493af8b",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "„In seiner Freude über die ergebene Aufmerksamkeit, mit der ich seinem Ammenmärchen lauschte, fragte er mich, wo ich wohne; ich antwortete, nirgends, denn ich sei zu Fuß von Zürich gekommen und gleich in die Kirche gegangen.“"
                                            },
                                            {
                                                "example_id": "7a33510e-c1e0-4b6b-acb4-f93e5ad90db7",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "„Am Polytechnikum in Zürich hätte Einstein eine fundierte mathematische Ausbildung erfahren können.“"
                                            },
                                            {
                                                "example_id": "84714135-45a0-4b9c-ad15-51d5f44641fe",
                                                "sense_id": "70d1f329-ee31-3b81-9bfe-f9685333fbae",
                                                "text": "„In Zürich will Klaus Mann eine Zeitschrift gründen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "30856e8d-c7c5-33d8-b236-9428f002a29c",
                                        "entry_id": "da73acbf-0dd4-36f7-b641-53d059a8f722",
                                        "glosses": [
                                            "Kanton im Nordosten der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dda548e5-42e1-41d0-8faa-1afd0bcba954",
                                                "sense_id": "30856e8d-c7c5-33d8-b236-9428f002a29c",
                                                "text": "Zürichs Kantonsverfassung trat am 1. Januar 2006 in Kraft."
                                            },
                                            {
                                                "example_id": "8540ca66-ff23-4f58-8462-dd1d8e6f8650",
                                                "sense_id": "30856e8d-c7c5-33d8-b236-9428f002a29c",
                                                "text": "„Das Schweizervolk und die Kantone Zürich, Bern, Luzern, Uri, Schwyz, Obwalden und Nidwalden, Glarus, Zug, Freiburg, Solothurn, Basel-Stadt und Basel-Landschaft, Schaffhausen, Appenzell Ausserrhoden und Appenzell Innerrhoden, St. Gallen, Graubünden, Aargau, Thurgau, Tessin, Waadt, Wallis, Neuenburg, Genf und Jura bilden die Schweizerische Eidgenossenschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
