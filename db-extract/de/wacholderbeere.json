                    {
                        "sense_id": "2cd6e449-143d-3901-bf62-343f7792f74c",
                        "entry_id": "0479d6d6-e929-301e-8d9d-8f07f48ddacc",
                        "glosses": [
                            "beerenförmige Zapfen des Wacholders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff01ce8b-584c-4876-b73a-8b24ca291c49",
                                "sense_id": "2cd6e449-143d-3901-bf62-343f7792f74c",
                                "text": "Wacholderbeeren werden als Gewürz genutzt."
                            },
                            {
                                "example_id": "bc3f4f03-327a-4f32-9cf0-0da574d4251f",
                                "sense_id": "2cd6e449-143d-3901-bf62-343f7792f74c",
                                "text": "„Geräucherter Speck wurde dafür gerieben und unter anderem mit Wacholderbeere, Kümmel und Lorbeer verfeinert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
