                        "source_sense_id": "3a9e7ea1-4c57-390c-89ef-80bc35da57f4",
                        "target_lang_word": "Wetzstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wetzstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "647b0492-59e2-357d-8801-621330cdb9f0",
                                        "entry_id": "08518098-d660-30f4-9203-96edbabe0a46",
                                        "glosses": [
                                            "aus mineralischen Bestandteilen zusammengesetzter flacher Stein zum Schleifen und Schärfen von Werkzeugen"
                                        ],
                                        "tags": [
                                            "Schleifwerkzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1faa78cd-8bcf-4915-ad23-0bdb1afea2a4",
                                                "sense_id": "647b0492-59e2-357d-8801-621330cdb9f0",
                                                "text": "Der Wetzstein sollte zum wetzen angefeuchtet sein."
                                            },
                                            {
                                                "example_id": "d0092e87-aa97-4d9e-8d34-0350656e7f8c",
                                                "sense_id": "647b0492-59e2-357d-8801-621330cdb9f0",
                                                "text": "„Er hockte auf seiner Pritsche und schärfte sein Grabenmesser an einem kleinen Wetzstein, den er aus der Tasche gezogen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fd7e4e4-24d9-420a-bd51-7a4951d542ac",
                        "source_entry_id": "d03b4922-ddc6-3ce2-aa42-a5c88b5cc11e",
                        "source_sense_id": "3a9e7ea1-4c57-390c-89ef-80bc35da57f4",
                        "target_lang_word": "Schleifstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schleifstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                                        "entry_id": "459cfd23-35ae-3597-9593-f56462fcf507",
                                        "glosses": [
                                            "Werkzeug zum Schleifen oder Schärfen von Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "414ddf56-2d45-4c76-b7cf-9026c81c125b",
                                                "sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                                                "text": "„Er war in den Anblick der Hände versunken, die sich über dem Schleifstein hin und her bewegten.“"
                                            },
                                            {
                                                "example_id": "b36c372f-b365-4080-ba72-314bb0364ebc",
                                                "sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                                                "text": "„Hinter dem Tor links lag ein riesiger Schleifstein, verwittert, nutzlos, die Achse gebrochen, gegen die Mauer eines Stalles gelehnt.“"
                                            },
                                            {
                                                "example_id": "32d16f46-889e-46e3-a4bf-f655e38ce72a",
                                                "sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                                                "text": "„Lichatschow stand auf, wühlte in einem Bündel herum, und bald darauf hörte Petja das kriegerische Geräusch von Stahl und Schleifstein.“"
                                            },
                                            {
                                                "example_id": "f306c2a6-c599-4084-89a0-ca3a81e6e048",
                                                "sense_id": "d0edef03-00a4-3a7d-a1e5-fff71f6bde9b",
                                                "text": "„Später am Morgen, als der Gemüsehändler von dem Ausrufen seiner Waren im Hof heiser geworden, der Bürstenbinder sichtlich betrunken, und der Scherenschleifer aus dem Geschlecht des Lumpengesindels mit seinem Schleifstein von Haustür zu Haustür zog, ging ein Mann durch Kopenhagens Straßen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "61a902cf-88a5-4437-8a86-7ecee04ad1c3",
                        "source_entry_id": "d03b4922-ddc6-3ce2-aa42-a5c88b5cc11e",
                        "source_sense_id": "3a9e7ea1-4c57-390c-89ef-80bc35da57f4",
