                        "source_sense_id": "ab48e746-e833-31aa-9206-c34ccc2866f8",
                        "target_lang_word": "Furunkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Furunkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "19d33476-355f-32a7-a22a-f176312a5b15",
                                        "entry_id": "ddbc2943-71a9-31ca-976c-90185c8fa259",
                                        "glosses": [
                                            "eine tiefe, eitrige Entzündung des Haarbalgs und des umliegenden Gewebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34c18353-ec4f-41d3-86e4-89399db5b1a1",
                                                "sense_id": "19d33476-355f-32a7-a22a-f176312a5b15",
                                                "text": "„Wenn sein Vater dann tatsächlich mit ihm sprach, schreckte Bobby zusammen, als hätte ihm gerade jemand ein Furunkel aufgestochen.“"
                                            },
                                            {
                                                "example_id": "775c70ff-7cd1-429c-bd9c-0925218c343e",
                                                "sense_id": "19d33476-355f-32a7-a22a-f176312a5b15",
                                                "text": "„Der kleine Horst bekam einen solchen Furunkel kurz nach der Geburt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0be89d2a-3411-487b-ae3a-0b111e2be7bf",
                        "source_entry_id": "12a3fceb-cb50-362d-af82-d7d39337df7c",
                        "source_sense_id": "ab48e746-e833-31aa-9206-c34ccc2866f8",
                        "target_lang_word": "фурункул",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фурункул",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "37497bba-6038-3fa5-bdfd-6ae446ca09c6",
                                        "entry_id": "c0090c47-ca7d-3859-8058-707d54a9beca",
                                        "glosses": [
                                            "мед. острое гнойно-некротическое воспаление волосяного фолликула, сальной железы и окружающей соединительной ткани"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3d71c9-1445-4ba0-9d72-df222cd43dd4",
                                                "sense_id": "37497bba-6038-3fa5-bdfd-6ae446ca09c6",
                                                "text": "Чтобы предотвратить появление фурункулов, поддерживайте чистоту тела и одежды всегда и везде."
                                            },
                                            {
                                                "example_id": "dbe10f17-b760-4c8f-be03-446142ffc356",
                                                "sense_id": "37497bba-6038-3fa5-bdfd-6ae446ca09c6",
                                                "text": "На её лбу сидел фурункул, величиной с грецкий орех."
                                            },
                                            {
                                                "example_id": "b52283e0-00fa-4729-af0e-7d28fb0972f9",
                                                "sense_id": "37497bba-6038-3fa5-bdfd-6ae446ca09c6",
                                                "text": "Молодые листья бузины, отваренные в молоке, применяют наружно как противовоспалительное средство при ожогах, фурункулах, опрелостях, воспалении геморроидальных узлов."
                                            },
                                            {
                                                "example_id": "b60feeba-a60c-4697-90eb-b4e41b9d6e9c",
                                                "sense_id": "37497bba-6038-3fa5-bdfd-6ae446ca09c6",
                                                "text": "В скрытый период на развитие вируса указывают ослабление реакции иммунной системы, фурункулы, изъязвление слизистой оболочки полости рта, половых органов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
