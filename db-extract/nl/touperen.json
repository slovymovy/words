                    {
                        "sense_id": "b04e445f-d533-3d09-aa52-3232f4f15be6",
                        "entry_id": "c14e4e6a-ccc4-3d5b-a6b6-d95dde736b43",
                        "glosses": [
                            "tegen het haar in kammen om het kapsel meer volume te laten krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6558e9c8-bec9-492c-a506-4b22a8a19a02",
                                "sense_id": "b04e445f-d533-3d09-aa52-3232f4f15be6",
                                "text": "De kappers van Aveda touperen het haar van de mannequins en draaien het in vlechten aan de zijkant van hun hoofd."
                            },
                            {
                                "example_id": "2a509c67-818a-4659-93fb-f22904d24707",
                                "sense_id": "b04e445f-d533-3d09-aa52-3232f4f15be6",
                                "text": "Toupeer lok per lok en gebruik hiervoor een kam met dicht op elkaar staande tandjes. Werk van achteren naar voren."
                            },
                            {
                                "example_id": "4cbf0fd3-352b-4d8a-b4b5-6be17c475931",
                                "sense_id": "b04e445f-d533-3d09-aa52-3232f4f15be6",
                                "text": "Maak eerst een strakke, hoge staart in het midden van uw kruin. Blaas er volume in met een verstevigende haarmousse en toupeer uw haren tot een wilde haardos."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
