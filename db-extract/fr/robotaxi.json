                ],
                "senses": [
                    {
                        "sense_id": "9709450e-0941-384c-b30a-41905b5acab3",
                        "entry_id": "86933169-6839-3392-befb-768a687edd64",
                        "glosses": [
                            "Voiture autonome, ou dotée de systèmes d’aide à la conduite, utilisée comme taxi."
                        ],
                        "tags": [
                            "Anglicism",
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "4c15b80a-4b90-45b1-81a1-61d5845100e6",
                                "sense_id": "9709450e-0941-384c-b30a-41905b5acab3",
                                "text": "Mais le développement du robotaxi a rencontré quelques embûches, en particulier liées aux inquiétudes des autorités réglementaires et du public concernant la sécurité."
                            },
                            {
                                "example_id": "d6872598-03ad-420e-a005-69373940ef09",
                                "sense_id": "9709450e-0941-384c-b30a-41905b5acab3",
                                "text": "C’est vrai pour tous les types de véhicules autonomes de niveau 4 : robotaxis, robonavettes, camions autonomes, robots de livraison, nettoyeurs autonomes de voirie, robots de surveillance, robots de distribution alimentaire. (...) Car beaucoup ignorent encore tout de ce qui se passe en ce moment à San Francisco (150 000 trajets payants par semaine avec un peu plus de 700 robotaxis) ou à Wuhan (près de 1 000 robotaxis en exploitation)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b64ae343-a652-4a2e-bea4-fe7d533f5a4d",
                        "source_entry_id": "86933169-6839-3392-befb-768a687edd64",
                        "source_sense_id": "9709450e-0941-384c-b30a-41905b5acab3",
                        "target_lang_word": "robotaxi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "robotaxi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                        "entry_id": "05cc57ce-d540-3fbd-93ec-b34fa0cf59d6",
                                        "glosses": [
                                            "A self-driving car that can be hired on a per-journey basis by passengers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c71048f-f2ad-4810-9d1d-b8c56d05164b",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "Self-driving Waymo car kills dog amid increasing concern over robotaxis [title]"
                                            },
                                            {
                                                "example_id": "cffeeecb-7fdc-447f-ab32-4991249d292b",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "This weekend, as videos of robotaxi malfunctions began appearing on social media, opponents say they are seeing their fears realized."
                                            },
                                            {
                                                "example_id": "6c84b71b-861d-4a40-b695-efe61a5c7eb1",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "Robotaxis aren’t perfect. But neither are humans. Some 46,000 people perished on America’s roads last year, a toll that far exceeds that of most other developed countries."
                                            },
                                            {
                                                "example_id": "3d73bd9d-84ea-4fb8-b164-20229e667346",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "San Francisco authorities and the company Cruise have offered conflicting accounts of an incident in which the fire department said two of the company’s robotaxis delayed an ambulance transporting a patient with critical injuries who later died at a hospital."
                                            },
                                            {
                                                "example_id": "d570ed90-b488-462d-bef3-e6e62a5ba43e",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "Toyota Motor Corp. will begin a self-driving transportation service in Odaiba, Tokyo, this summer using the technology of Level 4 autonomous driving — automated driving under certain conditions — with the aim of starting a driverless robotaxi business in the future, sources said."
                                            },
                                            {
                                                "example_id": "0f4e6aa5-e755-4d2a-835f-56414e1de2e7",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "Self-driving cars, also known as autonomous vehicles or, colloquially, robotaxis, have been driving the streets of San Francisco in some form since 2009 and have been operating commercially since last August."
                                            },
                                            {
                                                "example_id": "0c647209-20fb-4516-80c4-c2dfc1fb7e71",
                                                "sense_id": "5b04b364-1a11-34d2-b827-87f5ca00c2e6",
                                                "text": "Companies must not only prove that robotaxis are safe and reliable, but also need to secure tens of billions of dollars more in capital investment. Margins are also notoriously thin and the costs of operating a robotaxi service at scale are largely untested."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
