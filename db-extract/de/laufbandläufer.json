                "senses": [
                    {
                        "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                        "entry_id": "8a1767ac-472f-33ea-936f-283130faace6",
                        "glosses": [
                            "Person, die hauptsächlich oder bevorzugt auf einem Laufband läuft (statt draußen zu laufen/joggen)"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "afdb10eb-b716-4106-8611-c06a07344596",
                                "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                                "text": "„Ich bedauere die Laufbandläufer ein bisschen und nehme den Weg zum Einkausfzentrum.“"
                            },
                            {
                                "example_id": "3d43cbe2-20df-4f05-ae15-3b521990b5bd",
                                "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                                "text": "„Nichtsdestotrotz werde ich sicherlich nicht zum Schönwetter- oder Laufbandläufer.“"
                            },
                            {
                                "example_id": "da5126a2-24a0-426f-98b6-4b5e3bb5651d",
                                "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                                "text": "„Ich werde daher nun zum Laufbandläufer oder meine Laufrunden im kleinen Stadion drehen müssen, weil alle meine Hausstrecken hier in Kiel irgendwie einen Berg haben, da ich eigentlich immer unten an der Förde laufe.“"
                            },
                            {
                                "example_id": "a35e1576-18fd-41bd-94ea-4c45020eb1c1",
                                "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                                "text": "„Das war schön – sonst bin ich ja immer der Laufbandläufer – da sieht man eher weniger Möwen oder Menschen oder so.“"
                            },
                            {
                                "example_id": "6367048f-e07d-4e8d-b93f-8a32cec267a7",
                                "sense_id": "68e93220-41a0-326e-9750-121789a90941",
                                "text": "„Sei tapfer, lauf weiter im Matsch, verhöhne die Laufbandläufer ein wenig und wachse daran.;-)“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
