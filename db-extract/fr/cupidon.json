        "fr-extract.jsonl": [
            {
                "entry_id": "3a2cf12e-a55a-3018-ad56-7a8ec07fbf24",
                "word": "Cupidon",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a07daa04-d225-3de7-8d2b-7a7db2f7a374",
                        "entry_id": "3a2cf12e-a55a-3018-ad56-7a8ec07fbf24",
                        "glosses": [
                            "Dieu romain de la passion amoureuse."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "53d0a4ad-dafa-444b-91bd-367eb3861336",
                                "sense_id": "a07daa04-d225-3de7-8d2b-7a7db2f7a374",
                                "text": "Il y avait sur la pendule un petit Cupidon de bronze, qui minaudait en arrondissant les bras sous une guirlande dorée."
                            },
                            {
                                "example_id": "47efc022-766b-46d2-9d09-c1e36d9f0049",
                                "sense_id": "a07daa04-d225-3de7-8d2b-7a7db2f7a374",
                                "text": "— Morphée peut être resté en sa caverne, mais le petit dieu Cupidon est un rôdeur qui n’a pas besoin de lanterne pour savoir trouver une porte dans un corridor, répondit Léandre, espérant détourner les soupçons de son ennemi Scapin."
                            },
                            {
                                "example_id": "72621dd4-57cf-43db-93bc-135cda4cea72",
                                "sense_id": "a07daa04-d225-3de7-8d2b-7a7db2f7a374",
                                "text": "En Grèce antique, le Dieu de l’amour, Cupidon, conviait à des fêtes particulières, les Érotidies, qui n'avaient rien à voir avec les brutales et chancelantes Dionysiaques."
                            }
                        ]
                    },
                    {
                        "sense_id": "acbb8e1c-6805-36e4-8a68-64ff50917216",
                        "entry_id": "3a2cf12e-a55a-3018-ad56-7a8ec07fbf24",
                        "glosses": [
                            "Satellite naturel d’Uranus."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "02933383-9273-3ae8-9807-fd8eb930323c",
                        "entry_id": "3a2cf12e-a55a-3018-ad56-7a8ec07fbf24",
                        "glosses": [
                            "(763) Cupidon : Planète mineure."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "932d3d2c-1ec3-4fb9-a996-121c1d7c45c4",
                        "source_entry_id": "3a2cf12e-a55a-3018-ad56-7a8ec07fbf24",
                        "source_sense_description": "Dieu romain de la passion amoureuse",
                        "target_lang_word": "Cupid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cupid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31064d56-5bdb-3364-af62-0ce68da8dc79",
                                        "entry_id": "cc37a700-2e56-3b76-841f-52d7b510b8a2",
                                        "glosses": [
                                            "The god of love, son of Venus; sometimes depicted as a putto (a naked, winged boy with bow and arrow). The Roman counterpart of Eros."
                                        ],
                                        "tags": [
                                            "Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27249dad-20ca-47b2-a32d-855dfd9e4ed1",
                                                "sense_id": "31064d56-5bdb-3364-af62-0ce68da8dc79",
                                                "text": "The myth of Cupid and Psyche was one of the most influential romances in European culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205fb448-23de-3598-aa02-e81191c1324e",
                                        "entry_id": "cc37a700-2e56-3b76-841f-52d7b510b8a2",
                                        "glosses": [
                                            "Sudden love or desire; the personification of falling in love."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "478733a3-6f93-4e18-a3a9-7ab6707efd84",
                                                "sense_id": "205fb448-23de-3598-aa02-e81191c1324e",
                                                "text": "He was just walking down the street minding his own business when Cupid struck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80bd3e20-9e0d-3f13-92a6-e66ab7963cb4",
                                        "entry_id": "cc37a700-2e56-3b76-841f-52d7b510b8a2",
                                        "glosses": [
                                            "A moon of Uranus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e40d802-ac2b-4179-894a-c3ef70a8b83d",
                                                "sense_id": "80bd3e20-9e0d-3f13-92a6-e66ab7963cb4",
                                                "text": "Cupid is so small and far away that it can only be seen with the Hubble Space Telescope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eecf5b8-084d-3c23-aae2-42bc6aee68aa",
                                        "entry_id": "cc37a700-2e56-3b76-841f-52d7b510b8a2",
                                        "glosses": [
                                            "The sixth reindeer of Santa Claus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
