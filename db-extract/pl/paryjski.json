                                        "entry_id": "2e299cba-3961-31d5-9f0d-e29e7c190c0a",
                                        "glosses": [
                                            "Of or relating to the Greek island of Paros; (specifically), designating a type if fine white marble for which the island was renowned in antiquity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a54c5f11-31f8-46c6-8b47-66d6a7acf84c",
                                                "sense_id": "f21111d5-0ddc-3833-8cd9-ede0bcc8d58c",
                                                "text": "The girl was without a tinge of colour, but very fair; the soft white of the Parian marble strongly contrasted with hair of the most ebon black..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72ef4577-ce95-32a9-a0fc-5028cde09572",
                                        "entry_id": "2e299cba-3961-31d5-9f0d-e29e7c190c0a",
                                        "glosses": [
                                            "Designating or resembling a type of fine white porcelain resembling Parian marble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd725db6-94a3-4407-befd-eb8c9e3cc9f6",
                                                "sense_id": "72ef4577-ce95-32a9-a0fc-5028cde09572",
                                                "text": "Her eyes were wide open. There were morsels of liquid moonlight between their parian lids."
                                            }
                                        ]
                                    }
                                ]
                            }
