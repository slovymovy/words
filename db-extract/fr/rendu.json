        "fr-extract.jsonl": [
            {
                "entry_id": "2970c8dc-16df-3f8f-9891-8037966fd827",
                "word": "rendu",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f68d0514-38dd-4949-b97d-59ad5b7b401c",
                        "entry_id": "2970c8dc-16df-3f8f-9891-8037966fd827",
                        "tags": [
