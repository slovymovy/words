                    {
                        "sense_id": "5668493c-e86e-3641-8a66-5fe338e2123c",
                        "entry_id": "e768a491-d53e-3dec-83e4-f4be07903ba2",
                        "glosses": [
                            "grote kastanje, vrucht van de tamme kastanje, Castanea sativa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64a4b28-50a1-4478-b864-06c22b6bf419",
                                "sense_id": "5668493c-e86e-3641-8a66-5fe338e2123c",
                                "text": "De allermooiste kastanje is ongetwijfeld de marron, die één noot per bolster bevat. Zowel de kastanje als deze marron zijn de vruchten van de tamme kastanje."
                            },
                            {
                                "example_id": "0d625bd0-a398-49c1-8f8a-91b01a8a6e13",
                                "sense_id": "5668493c-e86e-3641-8a66-5fe338e2123c",
                                "text": "Ook uit de keuken van de Périgord is de marron aan het verdwijnen. Er zijn winig koks meer die het bos intrekken, voordat zij het eten gaan maken."
                            }
                        ]
                    }
                ],
