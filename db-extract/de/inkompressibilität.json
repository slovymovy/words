                        "entry_id": "f0b50547-3b00-3cce-a99c-b8706d146468",
                        "glosses": [
                            "physikalische Eigenschaft, sein Volumen unter Druck nicht zu verringern, nicht zusammenpressbar (inkompressibel) zu sein"
                        ],
