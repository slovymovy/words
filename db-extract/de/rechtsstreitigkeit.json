                "senses": [
                    {
                        "sense_id": "cf1f05bf-d8f4-3b73-a704-22642d0a056a",
                        "entry_id": "7b329cba-2f29-3052-9f4a-6ea096aa5a44",
                        "glosses": [
                            "anhaltende rechtliche Auseinandersetzung zwischen Personen oder Institutionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d58417a0-e1e6-40e6-8794-2467daa57883",
                                "sense_id": "cf1f05bf-d8f4-3b73-a704-22642d0a056a",
                                "text": "„GSC Research: In welchem Zusammenhang mit dieser Rechtsstreitigkeit ist das Engagement von Herrn Marseille in Sachsen-Anhalt zu sehen?“"
                            },
                            {
                                "example_id": "e2b97c2c-9e40-479a-8163-ccc15e87725a",
                                "sense_id": "cf1f05bf-d8f4-3b73-a704-22642d0a056a",
                                "text": "„Ausführlich dokumentiert ist die Rechtsstreitigkeit in Sachen Heinrich Böll (\"Therapie für Henscheid\", \"Kitsch und Dreck\"), die ihn fast an den Rand des finanziellen Ruins gebracht hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f626b79-7ac2-47ac-ba2f-2f209b450139",
