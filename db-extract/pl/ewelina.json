                        "examples": [
                            {
                                "example_id": "957afffd-c0e5-43f2-98c5-ed8435248f6c",
                                "sense_id": "36ac8ff4-0a64-3c0b-9d03-1fcca83b28e3",
                                "text": "Gdy Ewelina była moją dziewczyną, uważałem ją za najpiękniejszą na świecie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eabd488-1889-45ec-a566-40bd7573d9b1",
                        "source_entry_id": "5a874246-ab38-328f-8513-89a931875a14",
                        "source_sense_id": "36ac8ff4-0a64-3c0b-9d03-1fcca83b28e3",
                        "target_lang_word": "Evelyn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evelyn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad6c7f49-c372-374c-9785-ea1b8a234894",
                                        "entry_id": "046b9601-2af7-3905-be86-757f0e1189a3",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b84ea7f1-0578-4ccc-8ed8-6db3e0a4c89e",
                                                "sense_id": "ad6c7f49-c372-374c-9785-ea1b8a234894",
                                                "text": "Beautiful Evelyn Hope is dead! / Sit and watch by her side an hour."
                                            },
                                            {
                                                "example_id": "8e78d170-89c5-4b9f-acdb-5e884f05a06b",
                                                "sense_id": "ad6c7f49-c372-374c-9785-ea1b8a234894",
                                                "text": "\"I don't wear flowers,\" Evelyn Lilith said, and tossed the unwanted chain into the air, spearing it before it fell with a pellet from her unerring Daisy air-pistol. Destroying flowers with a Daisy, she served notice that she was not to be manacled, not even by a necklace: she was our capricious, whirligig Lill-of-the-Hill. And also Eve. The Adam's-apple of my eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb05673-eb6c-3f3b-9079-7061acb2e660",
                                        "entry_id": "046b9601-2af7-3905-be86-757f0e1189a3",
                                        "glosses": [
                                            "A surname originating as a matronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2d682cd9-8da2-39a0-a7d4-fca16ce6c045",
                                        "entry_id": "046b9601-2af7-3905-be86-757f0e1189a3",
                                        "glosses": [
                                            "A male given name transferred from the surname."
                                        ],
