                    {
                        "translation_id": "6ff3a97e-36a4-4d46-95f1-daf906a64ebc",
                        "source_entry_id": "5736e0f4-4d4d-3e97-9cf9-7fa9e38423b3",
                        "source_sense_id": "231940e5-c6ed-3729-a88d-b9f93d89ea8f",
                        "target_lang_word": "curcuma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curcuma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e7359a5-835d-307a-9f8e-64a2babf6d24",
                                        "entry_id": "bf413149-c529-3434-9b4f-41ad454a9c62",
                                        "glosses": [
                                            "Plante herbacée rhizomateuse nommée Curcuma longa, vivace, de la famille des Zingibéraceae (Zingibéracées) originaire du Sud de l’Asie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "925f4b99-8f36-4496-8630-a511a16a52ab",
                                                "sense_id": "6e7359a5-835d-307a-9f8e-64a2babf6d24",
                                                "text": "Elle était blême comme un branche de curcuma, on aurait pu lui taillader le visage et les mains, pas une goutte de sang n’en aurait jailli."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62c8f9e3-bf73-3f0e-8f00-22b2d8ac3204",
                                        "entry_id": "bf413149-c529-3434-9b4f-41ad454a9c62",
                                        "glosses": [
                                            "Épice tirée du rhizome de cette plante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8217f4d5-95ee-4e6c-b0e4-9cf900c648af",
                                                "sense_id": "62c8f9e3-bf73-3f0e-8f00-22b2d8ac3204",
                                                "text": "Il ne faut pas craindre d’épicer, même assez fortement, tous les mets ; le piment, le gingembre et le curcuma ou safran de l’Inde, sont en général préférables."
                                            },
                                            {
                                                "example_id": "1b7d6638-86e7-4b53-9a9a-fdc16f338b29",
                                                "sense_id": "62c8f9e3-bf73-3f0e-8f00-22b2d8ac3204",
                                                "text": "Lotte en chemise de chicons au curcuma, brunoise de céleri-rave, pommes acides et coriandre, oignons grelots, boudin noir et chou rouge…"
                                            },
                                            {
                                                "example_id": "d76a54b1-2dc2-461f-88d8-e8b9dec3e59b",
                                                "sense_id": "62c8f9e3-bf73-3f0e-8f00-22b2d8ac3204",
                                                "text": "En revanche, on en prend, de la graine, et à gogo : lin, chia, chanvre, pavot, sésame, tournesol, courge, sarrasin, fenouil ! Et des baies, d’açaï, de goji ! Et des poudres, guarana, curcuma, thé matcha !"
                                            }
                                        ]
                                    }
                                ]
                            },
