                            {
                                "example_id": "9da1ac40-53e6-477e-8e9f-3f0ae7612cfa",
                                "sense_id": "486af4d4-23e4-3679-8461-0f1c07d4e753",
                                "text": "W początkach islamu z minbaru przemawiał władca lub jego reprezentant, dziś zwykle teologowie i uczeni muzułmańscy"
                            }
