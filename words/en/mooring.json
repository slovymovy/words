    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "081f8fd9-3c03-3f3a-ab68-653f9a28abce",
                    "sense_definition": "A place where a boat or ship can be tied up or secured, or the ropes, chains, and anchors used to secure it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small fishing boat broke loose from its <w>mooring</w> during the heavy storm.",
                            "target_lang_translations": {
                                "it": "La piccola barca da pesca si è staccata dal suo <w>ormeggio</w> durante la violenta tempesta."
                            }
                        },
                        {
                            "text": "They decided to rent a permanent <w>mooring</w> in the harbor for the summer.",
                            "target_lang_translations": {
                                "it": "Hanno deciso di affittare un <w>ormeggio</w> permanente nel porto per l'estate."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boat mooring",
                        "permanent mooring"
                    ],
                    "target_lang_definitions": {
                        "it": "Luogo in cui un'imbarcazione può essere assicurata o legata, oppure le cime, catene e ancore utilizzate a tale scopo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ormeggio",
                                "target_lang_sense_clarification": "posto o attrezzi per ormeggiare"
                            },
                            {
                                "target_lang_word": "attracco",
                                "target_lang_sense_clarification": "punto o posto di ormeggio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56697edf-8376-3916-8ccc-fff5d0a1bd5d",
                    "sense_definition": "The act of securing a vessel with a cable, rope, or anchor.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Careful <w>mooring</w> of the yacht is essential before the incoming tide arrives.",
                            "target_lang_translations": {
                                "it": "Un attento <w>ormeggio</w> dello yacht è essenziale prima dell'arrivo dell'alta marea."
                            }
                        },
                        {
                            "text": "The crew assisted with the <w>mooring</w> of the ferry as it approached the dock.",
                            "target_lang_translations": {
                                "it": "L'equipaggio ha assistito durante l'<w>ormeggio</w> del traghetto mentre si avvicinava alla banchina."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "L'atto di assicurare un'imbarcazione tramite cavi, cime o un'ancora."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ormeggio",
                                "target_lang_sense_clarification": "l'atto di ormeggiare"
                            },
                            {
                                "target_lang_word": "attracco",
                                "target_lang_sense_clarification": "manovra o atto di attraccare"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "500f4183-2bd8-3247-9907-44a9a153d1aa",
                    "sense_definition": "An anchor or foundation providing stability, direction, or a sense of identity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moving to another country caused him to lose his cultural <w>mooring</w>.",
                            "target_lang_translations": {
                                "it": "Il trasferimento in un altro paese gli ha fatto perdere il suo <w>ancoraggio</w> culturale."
                            }
                        },
                        {
                            "text": "Her strong moral principles served as a <w>mooring</w> throughout difficult times.",
                            "target_lang_translations": {
                                "it": "I suoi saldi principi morali le sono serviti da <w>punto fermo</w> nei momenti difficili."
                            }
                        }
                    ],
                    "common_phrases": [
                        "moral mooring"
                    ],
                    "target_lang_definitions": {
