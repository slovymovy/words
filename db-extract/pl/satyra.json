                "senses": [
                    {
                        "sense_id": "7c186f95-3ce0-3909-8890-9968b4979856",
                        "entry_id": "26891559-20ee-3df0-b05a-a834b3e5500b",
                        "glosses": [
                            "gatunek literacki, tekst publicystyczny albo inna wypowiedź artystyczna, która ośmiesza i piętnuje przedstawione w utworze zjawiska, obyczaje, politykę, osoby, stosunki społeczne itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6994671b-7e3f-464e-bc6c-88cd5f4014ce",
                                "sense_id": "7c186f95-3ce0-3909-8890-9968b4979856",
                                "text": "Ich satyra ukazuje społeczeństwo za pomocą czarnego humoru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "d9efff5a-3397-3820-8a6e-d3140e1184fa",
                        "entry_id": "26891559-20ee-3df0-b05a-a834b3e5500b",
                        "glosses": [
                            "ogólnie: ośmieszanie, piętnowanie czegoś"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2b1adb8-56b6-41a4-87f2-0684d7857aec",
                        "source_entry_id": "26891559-20ee-3df0-b05a-a834b3e5500b",
                        "source_sense_id": "7c186f95-3ce0-3909-8890-9968b4979856",
                        "target_lang_word": "satire",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "satire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffdff484-c0b7-30ca-9ac5-91b775036d3b",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "A literary device of writing or art which principally ridicules its subject often as an intended means of provoking or preventing change or highlighting a shortcoming in the work of another. Imitation, humor, irony, and exaggeration are often used to aid this."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f259d0d0-2379-49ba-9e4c-7007e7721d13",
                                                "sense_id": "ffdff484-c0b7-30ca-9ac5-91b775036d3b",
                                                "text": "Satire deflates and debases. It is an art which topples greatness, undermines pretension and punishes pride by revealing the low in the pretendedly high, the filth in the pure, the folly in reason. This belittling trick deploys telescopic lenses which picture the human as lesser and lower, or as a machine or beast, driven by depraved desires. Satire reduces what purports to be subtly superior to a repertoire of stigmatizing symbols and cardboard cut-outs, turning character into caricature, signalled by exaggerated physiognomical distortions - the huge nose, gaping mouth and bloated belly, or comparable animalistic traits. In this humbling of the complex into the simplistic, satire finally reduces the mind, soul or spirit to that flesh which always bespeaks inferiority on the Chain of Being."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7a20306-b953-3e43-b3d6-8f7d35c7b5dd",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "A satirical work."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4571c644-7679-4012-8bb0-7f92e455d292",
                                                "sense_id": "d7a20306-b953-3e43-b3d6-8f7d35c7b5dd",
                                                "text": "a stinging satire of American politics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d5b9c2-5ede-362a-9ccf-dec470e4de96",
                                        "entry_id": "62ef30b7-9a47-312b-b220-bd7f2100d4f9",
                                        "glosses": [
                                            "Severity of remark."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a5cedbb-b688-4959-8e6d-dae68c8a6f6d",
                                                "sense_id": "47d5b9c2-5ede-362a-9ccf-dec470e4de96",
                                                "text": "CAESAR. No, by the gods! would that it had been! Vengeance at least is human. No, I say: those severed right hands, and the brave Vercingetorix basely strangled in a vault beneath the Capitol, were (with shuddering satire) a wise severity, a necessary protection to the commonwealth, a duty of statesmanship—follies and fictions ten times bloodier than honest vengeance!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d55ca0b-5b04-4fcf-bd1c-8fa1862b008e",
                        "source_entry_id": "26891559-20ee-3df0-b05a-a834b3e5500b",
                        "source_sense_id": "7c186f95-3ce0-3909-8890-9968b4979856",
                        "target_lang_word": "pasquinade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pasquinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d1ffdc6-8fcf-3611-af75-be3d127bf8be",
                                        "entry_id": "4761fc30-8d99-395d-ba9c-05ec1aa84d56",
                                        "glosses": [
                                            "A lampoon, originally as published in public; a satire or libel on someone."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f59cf6a-116c-41e8-830d-fa86906e322d",
                                                "sense_id": "3d1ffdc6-8fcf-3611-af75-be3d127bf8be",
                                                "text": "I thought the whole tale would shortly be served up in racy pasquinade—but Catherine, who might have said anything, didn't say a word."
                                            },
                                            {
                                                "example_id": "1f3c7b9b-a21d-4a62-970f-b3cc411b50cb",
                                                "sense_id": "3d1ffdc6-8fcf-3611-af75-be3d127bf8be",
                                                "text": "Queen Juana of Castile: Swear that you speak true./Cesare: I could place my palm on the Bible, but my oath would be a pasquinade./Queen Juana: Then swear on something else./Cesare: I would, if I believed in something other than myself./Queen Juana: A dishonest man would have taken the Bible, regardless of its meaning to him, and sworn until Sunday. I accept your word."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pasquinade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd744d0d-b313-39b3-b9e0-9c7bf6948dd7",
                                        "entry_id": "0674c3f2-8eeb-3bb1-94a8-05f9bd5e1210",
                                        "glosses": [
                                            "To satirize (someone) by using a pasquinade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7445fbe8-e5eb-402c-a76a-1a9d0fc98b88",
                                                "sense_id": "cd744d0d-b313-39b3-b9e0-9c7bf6948dd7",
                                                "text": "Chantilly was a quondam cobler of the Rue St. Denis, who, becoming stage-mad, had attempted the rôle of Xerxes, in Crebillon's tragedy so called, and been notoriously pasquinaded for his pains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2047846f-0e8f-430f-90b5-170252c629ce",
                        "source_entry_id": "26891559-20ee-3df0-b05a-a834b3e5500b",
