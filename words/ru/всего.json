                            },
                            {
                                "target_lang_word": "erst",
                                "target_lang_sense_clarification": "betont, dass etwas zeitlich noch nicht weit fortgeschritten ist"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "seulement",
