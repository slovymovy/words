                        "entry_id": "dd31127f-19e3-38c5-aba8-699a16a19e2f",
                        "glosses": [
                            "An extremely toxic lectin extracted from the castor bean."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3346062b-03d8-4c0a-94a0-de0e830eb46c",
                                "sense_id": "69a0a8b6-d3c5-3604-babf-5c2a21a8bafa",
                                "text": "It had to be one of three things: A hoax. Or anthrax, which meant I’d have to go on Cipro for a month. Or if it was ricin, I was dead, so bye-bye."
                            }
                        ]
                    }
                ],
