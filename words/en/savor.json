{
    "word_family": [
        "savory",
        "unsavory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "389d4776-f427-3c05-a437-9be5cf8150a1",
                    "sense_definition": "To enjoy or appreciate something completely, especially by taking time to experience it fully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enjoyment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat quietly on the porch to <w>savor</w> the peaceful sunset after a long day.",
                            "target_lang_translations": {
                                "de": "Sie saß ruhig auf der Veranda, um den friedlichen Sonnenuntergang nach einem langen Tag zu <w>auszukosten</w>."
                            }
                        },
                        {
                            "text": "We took our time to <w>savor</w> every bite of the delicious meal.",
                            "target_lang_translations": {
                                "de": "Wir nahmen uns Zeit, jeden Bissen des köstlichen Essens zu <w>genießen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "relish",
                        "enjoy",
                        "appreciate"
                    ],
                    "common_phrases": [
                        "savor the moment",
                        "savor the flavor"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas in vollen Zügen genießen oder auskosten, besonders indem man sich Zeit nimmt, es vollständig zu erleben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "auskosten",
                                "target_lang_sense_clarification": "etwas intensiv und bewusst genießen"
                            },
                            {
                                "target_lang_word": "genießen",
                                "target_lang_sense_clarification": "allgemeiner Begriff für Freude an etwas haben"
                            },
                            {
                                "target_lang_word": "auskosten",
                                "target_lang_sense_clarification": "sich Zeit nehmen, um einen Moment oder Geschmack voll auszukosten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8cafa986-ced5-3dd9-bb87-6c38713b0e67",
                    "sense_definition": "A distinctive taste or smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soup had a rich <w>savor</w> of fresh herbs and garlic.",
                            "target_lang_translations": {
                                "de": "Die Suppe hatte ein reiches <w>Aroma</w> von frischen Kräutern und Knoblauch."
                            }
                        },
                        {
                            "text": "The air in the bakery was filled with the sweet <w>savor</w> of warm bread.",
                            "target_lang_translations": {
                                "de": "Die Luft in der Bäckerei war erfüllt vom süßen <w>Duft</w> warmen Brotes."
                            }
                        }
                    ],
                    "synonyms": [
                        "flavor",
                        "aroma",
                        "taste"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This spelling is primarily used in American English as 'savor', while 'savour' is standard in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein charakteristischer Geschmack oder Geruch."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Geschmack",
                                "target_lang_sense_clarification": "der spezifische Sinneseindruck von Speisen"
                            },
                            {
                                "target_lang_word": "Aroma",
                                "target_lang_sense_clarification": "ein angenehmer, charakteristischer Duft oder Geschmack"
                            },
                            {
                                "target_lang_word": "Duft",
                                "target_lang_sense_clarification": "ein angenehmer Geruch"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}