                                "target_senses": [
                                    {
                                        "sense_id": "14d1965c-3ebb-34f1-b0f2-28bc7560a6c1",
                                        "entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
                                        "glosses": [
                                            "The net movement of solvent molecules, usually water, from a region of lower solute concentration to a region of higher solute concentration through a partially permeable membrane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                        "entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
                                        "glosses": [
                                            "Passive absorption or impartation of information, habits, etc.; the process of teaching or learning particular knowledge incidentally rather than consciously."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99a6e31-30e7-4acf-bca8-be1b6a2ef72d",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "Near-synonym: serendipity"
                                            },
                                            {
                                                "example_id": "b7cda480-a1ba-4508-ab02-3c1afaa102ff",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "I was reading about chickens, and I guess I learned about hawks through osmosis."
                                            },
                                            {
                                                "example_id": "34f4559a-27d9-48c1-9655-a6f77b2d23fd",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "At age fourteen, by a process of osmosis, of dirty jokes, whispered secrets and filthy ballads, Tristram learned of sex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de39a532-8a8e-4bed-b5f1-5a81ae9052e4",
                        "source_entry_id": "ce608610-6edc-3441-bb0a-c97f4cbba318",
                        "source_sense_id": "781d8a9c-b91d-3f33-a5bd-b6f6b58ad3ad",
                        "target_lang_word": "osmose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "osmose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "503988e3-e203-3e3d-868a-f1d516689155",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Échange entre deux solutions séparées par une membrane semi-perméable."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "046ba726-8765-40d4-83c7-5935eb1655bf",
                                                "sense_id": "503988e3-e203-3e3d-868a-f1d516689155",
                                                "text": "Les échanges opérés par osmose dépendent de la nature des solutions et de celle des membranes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19ac9dd0-8b06-3ab4-bac4-7983c6e83686",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Pénétration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2226f0e4-496e-4f53-8598-e5a774dfadc3",
                                                "sense_id": "19ac9dd0-8b06-3ab4-bac4-7983c6e83686",
                                                "text": "Son idéologie [de la bourgeoisie] s'écroule : elle justifiait la propriété par le travail et aussi par cette lente osmose qui diffuse dans l'âme des possédants les vertus des choses possédées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                        "entry_id": "0daeb6ec-8051-3a9a-b707-d1ddc5cf86cd",
                                        "glosses": [
                                            "Harmonie, mariage, parfait ensemble."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a161a91-6a51-4f48-a957-4e4b7c07f07a",
                                                "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                                "text": "C'est l'échange des sentiments parallèles, il y a communication inconsciente, osmose inaperçue."
                                            },
                                            {
                                                "example_id": "552426b2-d9f8-4157-a445-24bd9d89ab26",
                                                "sense_id": "27b856b1-ab1b-3316-9296-03d41045d389",
                                                "text": "À dix mètres sous moi, l'eau invisible. Entre l'eau et la brume, pas de frontière, la brume aussi lourde que l'eau, l'eau aussi irréelle que la brume. Passage dans un autre monde, transition par une osmose où toute forme ancienne est désagrégée et dissoute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
