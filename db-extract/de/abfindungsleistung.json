                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24b06c00-392b-4f0d-b92b-f2dd6ce98af8",
                                "sense_id": "1eb5e5e4-bb5a-340e-bbcc-12724cbcccbd",
                                "text": "„Das Arbeitsgericht Essen hat entschieden, dass die Beklagte nach einem Betriebsübergang zur Zahlung der vertraglich vereinbarten monatlichen Abfindungsleistung verpflichtet ist, da der Wortlaut des Aufhebungsvertrags eindeutig ist und keine Zweifel über die Vertragspartnerin lässt.“"
                            },
                            {
                                "example_id": "01ed9c58-1cbe-4640-9c81-afbfc6a1244f",
                                "sense_id": "1eb5e5e4-bb5a-340e-bbcc-12724cbcccbd",
                                "text": "„Die Gewerkschaft hatte im vorliegenden Fall für ihre Mitglieder im Sozialtarifvertrag Überbrückungs- und Abfindungsleistungen ausgehandelt.“"
                            },
                            {
                                "example_id": "701c94e8-be9d-4034-b4a3-6ef2ba3ce9e1",
                                "sense_id": "1eb5e5e4-bb5a-340e-bbcc-12724cbcccbd",
                                "text": "„Die hohe Besteuerung von Abfindungsleistungen habe in den Vereinigten Staaten dazu geführt, dass solche Zahlungen an ausscheidende Manager um ein Vielfaches gestiegen seien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
