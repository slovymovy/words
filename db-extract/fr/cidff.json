                            {
                                "example_id": "26f03850-e6fb-4730-882c-f3884d285834",
                                "sense_id": "da4f4d42-dd36-32af-a9cc-90cceac2011c",
                                "text": "Parmi elles, les 98 centres d’information sur le droit des femmes et des familles (CIDFF), ont un rôle local fondamental dans l’accès des victimes à leurs droits."
                            },
                            {
                                "example_id": "ea1dd904-1ce3-48ef-b952-0a7178f07c41",
                                "sense_id": "da4f4d42-dd36-32af-a9cc-90cceac2011c",
                                "text": "Afin de mieux comprendre le fonctionnement de la justice et des aides qui en découlent, je me suis rendue au CIDFF de Besançon."
                            },
                            {
                                "example_id": "a46c099a-4cb9-41c1-80f7-15f2edc6f44b",
                                "sense_id": "da4f4d42-dd36-32af-a9cc-90cceac2011c",
                                "text": "Les CIDFF aident chaque année des milliers de victimes de métropole et des Outre-mer à défendre leurs droits en justice et à lancer des procédures de divorces au civil ou de plaintes au pénal."
                            }
                        ]
