                                    {
                                        "sense_id": "a100bee5-bccb-30f1-9b2a-15fd77e10911",
                                        "entry_id": "36260071-b561-32a2-b314-9971c6ccffe7",
                                        "glosses": [
                                            "An alloy of over 90% aluminium, 4% copper and traces of manganese, magnesium, iron and silicon, widely used in the aircraft industry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c6db73-ef4a-49f0-8230-1229da471da1",
                                                "sense_id": "a100bee5-bccb-30f1-9b2a-15fd77e10911",
                                                "text": "Each Talgo unit for R.E.N.F.E. consists of five sections, the bodies of which are made of duralumin and are carried on two resilient wheels, running in roller bearings and situated under the rear end of each section."
                                            }
                                        ]
                                    }
