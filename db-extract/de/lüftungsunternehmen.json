                "senses": [
                    {
                        "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                        "entry_id": "f9686677-89e5-3816-bf0e-fc0b0d3f2520",
                        "glosses": [
                            "Gesellschaft, die in Produktion, Handel und Anlagenerrichtung im Bereich der Lüftungstechnik tätig ist oder Dienstleistungen erbringt, die damit verbunden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dab428-d5a5-4339-8d01-e76f7bf1c038",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "Es ist die Aufgabe der Lüftungsunternehmen, funktionierende Anlage zu planen, zu installieren und durch Wartung in ihrer Funktion aufrecht zu erhalten."
                            },
                            {
                                "example_id": "173d4a2e-4d5c-4688-a743-2caa8a1b807b",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "Es gibt Lüftungsunternehmen, die sich mit der Planung und baulichen Realisierung befassen und als Fachfirmen am Markt gelten."
                            },
                            {
                                "example_id": "315a58da-e28b-4669-83b6-375555f6f2ef",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "Wenn ein Ventilator in der Lüftungsanlage defekt ist, sollte man dem Lüftungsunternehmen, das die Lüftungsanlage installiert hat, Bescheid geben, damit die Reparatur erfolgt."
                            },
                            {
                                "example_id": "38e6f843-608a-4874-bc5a-f697b3a61d25",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "Es ist die Aufgabe des Lüftungsunternehmens, für Strom sparende Technik in der Lüftungstechnik zu sorgen."
                            },
                            {
                                "example_id": "f6466507-dfdf-4b43-895d-7613fa6c4a57",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "„Zum Beispiel hat ein Lüftungsunternehmen andere brandschutztechnische Sorgen als eine Elektrofirma oder ein Architekt.“"
                            },
                            {
                                "example_id": "ef31fda3-90ab-4013-b7de-54e4ce0f55c3",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "„Er ist Sanitärinstallateur, arbeitet für ein kleines Heizungs- und Lüftungsunternehmen in Aarau.“"
                            },
                            {
                                "example_id": "c2339406-1d42-4639-966a-651190fa7294",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "„Es wird empfohlen, in besonders schwierigen Fällen Bericht an die Reichsstelle für Lufthygiene und Lüftungswesen zu geben, die jederzeit bereit ist, die von Lüftungsunternehmen gemachten Vorschläge zu prüfen und zu begutachten.“"
                            },
                            {
                                "example_id": "de90371a-628c-4b7f-8c63-9d8353366e2a",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "„Der Verstorbene war Inhaber eines Heizungs- und Lüftungsunternehmens in Zürich.“"
                            },
                            {
                                "example_id": "52953a8c-a3c6-47f4-8e05-087ecb03e63e",
                                "sense_id": "5e36ea4e-f591-3964-992f-4c13c61b8c75",
                                "text": "„Simone Echtle leitet das Heizungs-, Sanitär- und Lüftungsunternehmen in der Schramberger Hebelstraße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
