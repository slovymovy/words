    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                "word": "autopilot",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2a081fb9-0952-49a9-9fd7-fdf977beaf4a",
                        "entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "tags": [
                            "plural"
                        ],
                        "form": "autopilots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c4fc477-54f4-340a-8178-e512aa65a347",
                        "entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "glosses": [
                            "A mechanical, electrical, or hydraulic system used to guide a vehicle without assistance from a human being."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "10f1c680-fc9c-40a2-8069-4da784ada18e",
                                "sense_id": "0c4fc477-54f4-340a-8178-e512aa65a347",
                                "text": "I set the autopilot to due south, so I could get some rest."
                            }
                        ]
                    },
                    {
                        "sense_id": "11f59c71-1c26-36a1-a9ad-b0831ec3d739",
                        "entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "glosses": [
                            "A state of mind where one no longer thinks about doing one's actions, but acts mechanically."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "figuratively",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2715af33-0ec1-4aba-bad5-5cd566bf9c9f",
                                "sense_id": "11f59c71-1c26-36a1-a9ad-b0831ec3d739",
                                "text": "I've been doing this 12 hours non-stop, and am so hungry and tired that I've stopped thinking: I'm now on autopilot."
                            },
                            {
                                "example_id": "ffadbfde-ee11-42ff-96b7-1bb3f346b7d2",
                                "sense_id": "11f59c71-1c26-36a1-a9ad-b0831ec3d739",
                                "text": "But while the wackiness gets exasperating fast (a running joke about Hazel’s father, played by Ray Romano on autopilot, having a sex doll for a wife is even unfunnier than it sounds), Milioti works overtime to keep us invested."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c975feb1-a564-416b-bbe9-19eeeb0fd076",
                        "source_entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "source_sense_description": "guiding system",
                        "target_lang_word": "automatische piloot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2b604766-eb85-42cf-9955-e858403c0e76",
                        "source_entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "source_sense_description": "guiding system",
                        "target_lang_word": "pilote automatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pilote automatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a4b20f5-c58b-3ec3-b4ae-abfca8724b99",
                                        "entry_id": "04a6cf56-9a4b-3e21-a3e3-24496321ac1b",
                                        "glosses": [
                                            ", Système électronique permettant de propulser un engin à moteur (avion ou bateau) suivant des ordres établis à l’avance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6879c247-c087-4b87-9d87-b0758359ae8a",
                                                "sense_id": "1a4b20f5-c58b-3ec3-b4ae-abfca8724b99",
                                                "text": "En cas de défaillance humaine dans le cockpit, le pilote automatique se met en marche tout seul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8dce89-66b5-39ba-b737-f651201fc294",
                                        "entry_id": "04a6cf56-9a4b-3e21-a3e3-24496321ac1b",
                                        "glosses": [
                                            "Manière désinvolte de conduire une voiture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4c34e4e-4feb-4504-92e8-01cf920b2cfb",
                                                "sense_id": "ec8dce89-66b5-39ba-b737-f651201fc294",
                                                "text": "Sur l’autoroute, je me mets sur pilote automatique et j’écoute les Quatre Saisons de Vivaldi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6150f141-26ba-3811-a4ce-74600976cd0b",
                                        "entry_id": "04a6cf56-9a4b-3e21-a3e3-24496321ac1b",
                                        "glosses": [
                                            "Façon d'être qui relève plus de réflexes semi-conscients que de choix conscients et réfléchis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22a608ef-1b66-4f2f-9ff2-4aef16158489",
                                                "sense_id": "6150f141-26ba-3811-a4ce-74600976cd0b",
                                                "text": "… quand j'ai le sentiment de vivre comme un robot, en mode pilote automatique du matin au soir."
                                            },
                                            {
                                                "example_id": "3c58f6bc-ea67-4fff-b166-0a87ba02cc70",
                                                "sense_id": "6150f141-26ba-3811-a4ce-74600976cd0b",
                                                "text": "Le PLQ, selon lui, « traverse une profonde crise identitaire », est sur le « pilote automatique » depuis cinq ans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20c93f40-99ef-4329-bdfa-83511359e1e5",
                        "source_entry_id": "fe2a75d7-c737-38ef-b4d4-ec0fb9f75da9",
                        "source_sense_description": "guiding system",
                        "target_lang_word": "Autopilot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autopilot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bbd5576-b57a-3488-8a20-feb261ab0ba7",
                                        "entry_id": "e1fb8d18-e1a9-3227-b896-268929b1f837",
                                        "glosses": [
                                            "Steuerungsanlage in Flugzeugen und Lenkflugkörpern, die automatisch den Kurs sowie die Fluglage reguliert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c3eca16-ed1b-4cfa-932f-d3b4c508a5c9",
                                                "sense_id": "2bbd5576-b57a-3488-8a20-feb261ab0ba7",
                                                "text": "Die Rakete wird von einem Autopiloten gelenkt."
                                            },
                                            {
                                                "example_id": "bbd869e3-e70d-4c60-aefa-49d707ae3c56",
                                                "sense_id": "2bbd5576-b57a-3488-8a20-feb261ab0ba7",
                                                "text": "„Keiner von uns verstand, was hier vor sich ging, aber insgeheim war ich erleichtert, dass ich zur Abwechslung mal auf Autopilot schalten durfte.“"
                                            },
                                            {
                                                "example_id": "7c3917a3-e89a-48e9-b018-2ef0cfb0a2b1",
                                                "sense_id": "2bbd5576-b57a-3488-8a20-feb261ab0ba7",
                                                "text": "„Das Auto hatte einen Autopiloten, und sobald wir auf der Schnellstraße waren, konnte mein Bruder die Hände vom Lenkrad nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
