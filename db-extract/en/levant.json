                                "target_senses": [
                                    {
                                        "sense_id": "7bdb6e78-8702-3283-a518-2d26de7877d8",
                                        "entry_id": "fe79e08e-7884-3dc6-8165-b52e87732276",
                                        "glosses": [
                                            "verzamelnaam voor de gebieden aan de oostelijke kust van de Middellandse Zee in Turkije, Syrië, Libanon en Israël/Palestina"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cae8c47-b7b7-408a-a80c-a8950f9d3ea7",
                                                "sense_id": "7bdb6e78-8702-3283-a518-2d26de7877d8",
                                                "text": "Wegens hun vondst in Tel Lachish vermoedt Felix Höflmayer c.s. nu dat het alfabet zich dus al verspreidde over de Levant vóór de Egyptische veroveringen in het gebied door farao Tutmosis III na 1457 v.Chr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3f11965-8490-3aff-b735-12b775290504",
                                        "entry_id": "fe79e08e-7884-3dc6-8165-b52e87732276",
                                        "glosses": [
                                            "verzamelnaam van de gebieden aan de Middellandse Zee oostelijk van Italië, of specifiek de zuidkust van het tegenwoordige Turkije met de havenstad Izmir (Smyrna)"
                                        ],
                                        "tags": [
                                            "historical",
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "004a77f5-2634-48d4-899b-1307c0ba43a3",
                                                "sense_id": "e3f11965-8490-3aff-b735-12b775290504",
                                                "text": "⧖ Van daer nae Napels drae,\nOf nae Venetia:\nDie Stadt van Venus hoogh vermaert,\nEn soo nae de Levant,\nBy yder wel bekant.\nTot Smirrena, soo leyt de vaert:\nDaer laden wy\nveel Balen Sy,\nEn meer kostelijcke Waren.\nDie wy dan brengen drae\nAl in Italia,\nDoor heen en weder varen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58ac9028-f099-412d-8edc-3c2fd78ca826",
                        "source_entry_id": "acc7d75c-19df-3cc6-a5cf-30c2a935892c",
                        "source_sense_id": "8f011bbb-d50a-3d9a-a159-0d1dd320e2c7",
                        "source_sense_description": "the countries bordering the eastern Mediterranean Sea",
                        "target_lang_word": "Levant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Levant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Région du monde composée du Liban, de la Syrie, d’Israël, de la Palestine, et de la Jordanie."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3f8a6a7-3d2d-4915-92be-05b67b7412d6",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "De Termes ne pouvant lui faire compter cette somme , lui envoya son neveu en otage , et il partit pour le Levant le 22 septembre , au moment où sa coopération eût été le plus nécessaire."
                                            },
                                            {
                                                "example_id": "a353467e-82bf-4700-bd04-43dfa4c25f3e",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "Des lois répressives furent édictées ; c'est ainsi qu'on défendit d’entrer et de mettre en vente en France des étoffes des Indes, de la Chine et du Levant."
                                            },
                                            {
                                                "example_id": "7d70de8d-b22c-4afe-95fd-02ad15ba082b",
                                                "sense_id": "3ba27927-fca5-3dc5-a271-592a834e53ff",
                                                "text": "L'État […]: ses structures et la légitimité de ses souverains sont attaqués du Levant à l'Asie du Sud-Ouest. Un conflit intérieur et son corollaire d'instabilité régionale peuvent donc faire craindre la balkanisation de la région et, par suite, une refonte de sa carte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "050d2e04-5207-309b-a866-4e39d615bea1",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Vent d’est soufflant en mer Méditerranée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa0296f7-689b-426a-8f55-8b8d355c1ccb",
                                                "sense_id": "050d2e04-5207-309b-a866-4e39d615bea1",
                                                "text": "Par ordre de fréquence décroissante, on observe ensuite les vents d’est, parmi lesquels le \"Levant\" et le \"Grigal\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d046dd8-3870-3ae7-ba03-144fcf9f505c",
                                        "entry_id": "42b54840-ad6c-3942-b4c5-3a725a305ed4",
                                        "glosses": [
                                            "Petite île le plus à l´est de l’archipel des îles d’Hyères dans le Var."
                                        ],
                                        "tags": [
                                            "Îles"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
