    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c2e58fa-ad08-377e-954d-077b1e9ae57a",
                "word": "stillness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7e605da3-9453-489e-9264-d4aa6c495019",
                        "entry_id": "4c2e58fa-ad08-377e-954d-077b1e9ae57a",
                        "tags": [
