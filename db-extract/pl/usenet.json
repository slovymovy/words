                                        "sense_id": "da540694-8bb4-3de3-ba18-a5c364d264c2",
                                        "entry_id": "50075ba8-af67-3224-96b7-aa89ec9f1958",
                                        "glosses": [
                                            "A world-wide distributed discussion system consisting of newsgroups that are classified hierarchically by subject."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b579d5c9-8b19-4e79-bd26-411871d8f097",
                                                "sense_id": "da540694-8bb4-3de3-ba18-a5c364d264c2",
                                                "text": "And as the Carnegie Mellon study is careful to point out, pornographic image files, despite their evident popularity, represent only about 3% of all the messages on the Usenet newsgroups, while the Usenet itself represents only 11.5% of the traffic on the Internet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
