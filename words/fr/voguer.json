                    ]
                },
                {
                    "sense_id": "e8b93a1d-dd4c-321d-a330-c76449d63274",
                    "sense_definition": "Avancer sur l'eau à la seule force des rames.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les marins <w>voguaient</w> en cadence pour faire progresser la galère."
