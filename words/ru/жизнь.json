                {
                    "sense_id": "436ce901-7230-3d0e-a724-e348ef06ab6c",
                    "sense_definition": "Запас здоровья персонажа или попытка для прохождения уровня в компьютерных играх",
                    "learner_level": "A2",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
