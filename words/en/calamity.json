{
    "word_family": [
        "calamitous",
        "calamously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7f7e964-5cbc-3ab6-8c93-e87b98e3cadc",
                    "sense_definition": "An event resulting in great loss, damage, or misery; a disaster.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disaster",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden collapse of the main bridge was a major <w>calamity</w> for the small island community.",
                            "target_lang_translations": {
                                "ru": "Внезапное обрушение главного моста стало крупным <w>бедствием</w> для небольшой островной общины.",
                                "pl": "Nagłe zawalenie się głównego mostu było wielką <w>katastrofą</w> dla tej małej wyspiarskiej społeczności."
                            }
                        },
                        {
                            "text": "They worked tirelessly to prevent a national <w>calamity</w> after the severe economic crash.",
                            "target_lang_translations": {
                                "ru": "Они неустанно работали, чтобы предотвратить национальную <w>катастрофу</w> после тяжелого экономического кризиса.",
                                "pl": "Pracowali niestrudzenie, aby zapobiec narodowej <w>klęsce</w> po poważnym krachu gospodarczym."
                            }
                        }
                    ],
                    "synonyms": [
                        "disaster",
                        "catastrophe",
                        "tragedy"
                    ],
                    "antonyms": [
                        "blessing",
                        "godsend"
                    ],
                    "common_phrases": [
                        "national calamity",
                        "major calamity",
                        "prevent a calamity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Событие, приводящее к большим потерям, разрушениям или несчастью; катастрофа.",
                        "pl": "Zdarzenie powodujące wielkie straty, zniszczenia lub cierpienie; katastrofa."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедствие",
                                "target_lang_sense_clarification": "крупное несчастье, катастрофическое событие"
                            },
                            {
                                "target_lang_word": "катастрофа",
                                "target_lang_sense_clarification": "событие с трагическими последствиями"
                            },
                            {
                                "target_lang_word": "несчастье",
                                "target_lang_sense_clarification": "беда, горестное событие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "klęska",
                                "target_lang_sense_clarification": "wielkie nieszczęście lub zniszczenie"
                            },
                            {
                                "target_lang_word": "katastrofa",
                                "target_lang_sense_clarification": "tragiczne w skutkach zdarzenie"
                            },
                            {
                                "target_lang_word": "kataklizm",
                                "target_lang_sense_clarification": "gwałtowne zdarzenie przynoszące ogromne zniszczenia"
                            },
                            {
                                "target_lang_word": "nieszczęście",
                                "target_lang_sense_clarification": "przykre, tragiczne zdarzenie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01e381eb-90de-3a1a-b449-97290b525630",
                    "sense_definition": "The state of deep distress, affliction, or adversity resulting from a disaster.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "distress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The war brought nothing but <w>calamity</w> and grief to the families living in the border towns.",
                            "target_lang_translations": {
                                "ru": "Война принесла только <w>беды</w> и горе семьям, живущим в приграничных городах.",
                                "pl": "Wojna przyniosła rodzinom mieszkającym w przygranicznych miasteczkach tylko <w>nieszczęście</w> i żal."
                            }
                        },
                        {
                            "text": "He faced the personal <w>calamity</w> of losing his life's work with remarkable courage.",
                            "target_lang_translations": {
                                "ru": "Он встретил личное <w>несчастье</w> — потерю дела всей своей жизни — с поразительным мужеством.",
                                "pl": "Stawił czoła osobistej <w>tragedii</w>, jaką była utrata dzieła jego życia, z niezwykłą odwagą."
                            }
                        }
                    ],
                    "synonyms": [
                        "adversity",
                        "misfortune",
                        "distress"
                    ],
                    "antonyms": [
                        "prosperity",
                        "happiness"
                    ],
                    "common_phrases": [
                        "personal calamity",
                        "state of calamity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние глубокого горя, страданий или невзгод, вызванное бедствием.",
                        "pl": "Stan głębokiego cierpienia, nieszczęścia lub przeciwności losu wynikający z katastrofy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бедствие",
                                "target_lang_sense_clarification": "тяжёлая, катастрофическая ситуация"
                            },
                            {
                                "target_lang_word": "беда",
                                "target_lang_sense_clarification": "крайне тяжёлое обстоятельство или несчастье"
                            },
                            {
                                "target_lang_word": "горе",
                                "target_lang_sense_clarification": "сильная глубокая печаль, несчастье"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "nieszczęście",
                                "target_lang_sense_clarification": "stan głębokiego smutku i trudnej sytuacji życiowej"
                            },
                            {
                                "target_lang_word": "klęska",
                                "target_lang_sense_clarification": "życiowe niepowodzenie lub stan wielkiego kryzysu"
                            },
                            {
                                "target_lang_word": "niedola",
                                "target_lang_sense_clarification": "ciężkie położenie, stan cierpienia i biedy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}