                                    {
                                        "sense_id": "f27bb0dd-bf42-3d13-a607-bc33aa2bca32",
                                        "entry_id": "2b9bf31e-e6fc-3bce-8132-8764eb316a99",
                                        "glosses": [
                                            "wat niet weggaat of verdwijnt; voor altijd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0fd36f-1768-4368-b4e8-315cfb197a7e",
                                                "sense_id": "f27bb0dd-bf42-3d13-a607-bc33aa2bca32",
                                                "text": "Hij is een blijvende waarde voor het Nederlandse elftal."
                                            },
                                            {
                                                "example_id": "f29bf7bf-f0f5-4872-8be9-7fdbee64c67b",
                                                "sense_id": "f27bb0dd-bf42-3d13-a607-bc33aa2bca32",
                                                "text": "Het is fijn om iets blijvends te maken."
                                            },
                                            {
                                                "example_id": "8d9add26-24c1-4381-b1a9-8ffb6a3221c4",
                                                "sense_id": "f27bb0dd-bf42-3d13-a607-bc33aa2bca32",
                                                "text": "Het echte, blijvende gevolg van de trail zou ik pas ontdekken als ik weer thuis was. Ik kon niet wachten om te zien wat wel en wat niet zou overblijven van mijn relaxte houding op mijn tocht. Hier op de berg was dat immers nog niet echt goed in te schatten."
                                            },
                                            {
                                                "example_id": "90bb1fca-6109-400c-8ebe-8dfbc81200ad",
                                                "sense_id": "f27bb0dd-bf42-3d13-a607-bc33aa2bca32",
                                                "text": "Veertig jaar na Live Aid is de internationale noodhulp blijvend veranderd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blijvend",
