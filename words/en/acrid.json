{
    "word_family": [
        "acridity",
        "acridly",
        "acridness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "770b12ee-dd24-3a01-9464-821231744e0a",
                    "sense_definition": "Sharp and harsh, or bitter and unpleasant to the taste or smell.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory_irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire produced an <w>acrid</w> cloud of thick smoke that filled the entire room.",
                            "target_lang_translations": {
                                "ru": "Огонь породил <w>едкое</w> облако густого дыма, заполнившее всю комнату."
                            }
                        },
                        {
                            "text": "She coughed after inhaling the <w>acrid</w> fumes coming from the chemical factory.",
                            "target_lang_translations": {
                                "ru": "Она закашлялась, вдохнув <w>едкие</w> испарения с химического завода."
                            }
                        }
                    ],
                    "synonyms": [
                        "pungent",
                        "bitter"
                    ],
                    "common_phrases": [
                        "acrid smoke",
                        "acrid smell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый, резкий или горький и неприятный на вкус или запах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "о запахе или дыме"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о запахе или вкусе"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о вкусе или запахе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "336ec209-1de0-375f-bdf3-0981d03f1847",
                    "sense_definition": "Causing physical heat and irritation to the skin or eyes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sensory_irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beetle protects itself by spraying <w>acrid</w> secretions at its predators.",
                            "target_lang_translations": {
                                "ru": "Жук защищается, распыляя на хищников свои <w>едкие</w> выделения."
                            }
                        },
                        {
                            "text": "The <w>acrid</w> fumes made her eyes sting and water.",
                            "target_lang_translations": {
                                "ru": "От <w>едких</w> испарений у нее защипало глаза и потекли слезы."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrosive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий жжение, химическое раздражение кожи или глаз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "вызывающий химическое раздражение или жжение"
                            },
                            {
                                "target_lang_word": "раздражающий",
                                "target_lang_sense_clarification": "о веществах, воздействующих на кожу или глаза"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf49365-70a0-3770-a2b2-4d9f476b4458",
                    "sense_definition": "Bitterly irritating or caustic in tone or behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "behavioral_irritation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two politicians engaged in an <w>acrid</w> debate that left the audience feeling uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Два политика вступили в <w>ожесточенные</w> дебаты, заставившие зрителей почувствовать себя неловко."
                            }
                        },
                        {
                            "text": "He is known for his <w>acrid</w> temper and often makes cutting remarks to his colleagues.",
                            "target_lang_translations": {
                                "ru": "Он известен своим <w>желчным</w> характером и часто отпускает колкие замечания в адрес коллег."
                            }
                        }
                    ],
                    "synonyms": [
                        "acrimonious",
                        "acerbic"
                    ],
                    "common_phrases": [
                        "acrid temper",
                        "acrid contempt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Злой, язвительный или резкий по тону или поведению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язвительный",
                                "target_lang_sense_clarification": "о тоне, замечаниях или поведении"
                            },
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "о характере, словах или споре"
                            },
                            {
                                "target_lang_word": "желчный",
                                "target_lang_sense_clarification": "о характере или высказываниях"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}