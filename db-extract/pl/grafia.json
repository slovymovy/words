                                        "entry_id": "289b725d-2dc0-3958-ba17-fadd30b8cea1",
                                        "glosses": [
                                            "Représentation graphique d’un mot, d’une finale, d’un phonème, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dda4059-f051-489c-8183-065ae4f4a7d2",
                                                "sense_id": "6b931d7f-03a3-302a-99a3-3e63b0ba9bb2",
                                                "text": "Je colorie. Cette activité permet de préciser une nouvelle fois les différentes graphies du son étudié."
                                            },
                                            {
                                                "example_id": "d9ff4fda-b5a7-4667-8912-f2465bbc7d72",
                                                "sense_id": "6b931d7f-03a3-302a-99a3-3e63b0ba9bb2",
                                                "text": "Le ms. d’Oxford, qui a servi de base pour mon édition du texte, offre à première vue une telle diversité de graphies et de formes qu’il semblerait inutile d’essayer de caractériser la langue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94ca9fe7-ee58-32d9-800b-14b3b31ccfa2",
                                        "entry_id": "289b725d-2dc0-3958-ba17-fadd30b8cea1",
                                        "glosses": [
                                            "Manière d’écrire un mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a32aac2-6e4d-4122-8ec6-236da91a488a",
                                                "sense_id": "94ca9fe7-ee58-32d9-800b-14b3b31ccfa2",
                                                "text": "Nénufar est une autre graphie de nénuphar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8775c1-2166-3763-a4e7-b032eb504cfd",
                                        "entry_id": "289b725d-2dc0-3958-ba17-fadd30b8cea1",
                                        "glosses": [
                                            "Mode de représentation écrite d’objets, faits ou idées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f8256bc-167c-3777-9e1e-d199bdf76062",
                                        "entry_id": "289b725d-2dc0-3958-ba17-fadd30b8cea1",
                                        "glosses": [
                                            "Façon dont s’inscrit quelque chose dans l’espace, comparable à un mode d’écriture."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "532b7444-d886-43d0-87fd-3c65150692a2",
                                                "sense_id": "6f8256bc-167c-3777-9e1e-d199bdf76062",
                                                "text": "chaque pas compté\nrévèle la graphie des pas passés\npréparant ceux qui\nviendront renouvelés\nd’un autre silence"
                                            }
                                        ]
                                    }
