                ],
                "senses": [
                    {
                        "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                        "entry_id": "409c9b63-4b91-3a61-8f89-6141e5af634c",
                        "glosses": [
                            "historisch: eine Provinz des Königreichs/Freistaats Preußen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a980822c-cb86-4720-ac6f-9651ee8062df",
                                "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                                "text": "Ostpreußens Hauptstadt war Königsberg."
                            },
                            {
                                "example_id": "8a0efed1-1f7c-45e6-be7a-f4b6b138932f",
                                "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                                "text": "„Mit graziöser Leichtigkeit plaudert er über die Geschichte Ostpreußens, von Sagen und Mythen.“"
                            },
                            {
                                "example_id": "cef10797-0895-4eb3-9584-c3dccbc1c90b",
                                "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                                "text": "„Fiete Kock sprach das Wort Ostpreußen so aus, wie andere Leute Ostern sagen.“"
                            },
                            {
                                "example_id": "da603e1f-a445-45df-93c5-cceb9113808f",
                                "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                                "text": "„Die besondere Geschichte jener Region, die später den Namen Ostpreußen erhalten sollte, begann vor fast acht Jahrhunderten.“"
                            },
                            {
                                "example_id": "d96e4a3e-f7d3-4866-8ca8-90ae4c2fde68",
                                "sense_id": "529151fb-fadb-3349-8068-5a3f27058474",
                                "text": "„Nicht nur in Ostpreußen, auch in Litauen stellten die Soldaten der Roten Armee ein gefürchtetes Feindbild dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
