                    },
                    {
                        "translation_id": "25632172-8916-49fc-88cf-8c2eaaa321cb",
                        "source_entry_id": "c858f027-2562-3eea-bf56-66199bd28b0d",
                        "source_sense_description": "Muslim scholar",
