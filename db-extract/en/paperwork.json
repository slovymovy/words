                    {
                        "translation_id": "d593f9e2-c5ae-45c6-958b-10b17df1f9c3",
                        "source_entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                        "source_sense_description": "work involving written documents",
                        "target_lang_word": "Schreibarbeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibarbeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2ff697a-008b-38dc-bf64-e1a6836e242d",
                                        "entry_id": "25c2a0ce-9c05-30e7-aa5d-48679da3050b",
                                        "glosses": [
                                            "Arbeit, die darin besteht, Schriftliches zu produzieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b256e2c-47b1-4d4b-adf0-6b8f681f456c",
                                                "sense_id": "e2ff697a-008b-38dc-bf64-e1a6836e242d",
                                                "text": "„Der Schreibunterricht verhalf vielen Frauen und Männern zu einem Ausdrucksvermögen in Wort und Schrift, das über das mechanische Ausfüllen vorgegebener Muster hinausging, insbesondere wenn sie selbst viel lasen und ihr Beruf mit viel Schreibarbeit verbunden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd6446ba-b03c-40c1-9295-dd4c45ac7cda",
                        "source_entry_id": "249230ab-b03e-3b3e-8f29-fffc52d30ade",
                        "source_sense_description": "work involving written documents",
                        "target_lang_word": "Papierkram",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Papierkram",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                        "entry_id": "69ea6080-bb28-38aa-b952-7931fb6a1af7",
                                        "glosses": [
                                            "Menge von Schriftstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32968e1-0066-496f-aaad-e064bb24051c",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Auf seinem Schreibtisch zu Hause stapelt sich der Papierkram, …“"
                                            },
                                            {
                                                "example_id": "1be1221c-be70-4092-ba78-6472aa37d8fb",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Aber irgendjemand muss die Hunderte Rechnungen überweisen, die Unterlagen für den Steuerberater vorbereiten, die Mahnungen schreiben, schlicht, den ganzen Papierkram bewältigen.“"
                                            },
                                            {
                                                "example_id": "33606b22-b712-4777-975c-10cd59c75385",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Trotzdem gab es noch jede Menge Stempel und Papierkram zu erledigen, bis ich endlich einreisen konnte.“"
                                            },
                                            {
                                                "example_id": "eb5b34c9-f09f-422f-9c19-3a9f743a8ae5",
                                                "sense_id": "cae31a8b-2ffc-36b4-a62c-9bf32539f377",
                                                "text": "„Sie saß in Papierkram vertieft bei Hörđur am Schreibtisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
