                    "frequency": "Middle",
                    "semantic_group_id": "feuer_loeschen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bevor wir schlafen gehen, sollten wir alle Kerzen im Wohnzimmer <w>auslöschen</w>."
                        },
                        {
                            "text": "Die Feuerwehr konnte das Feuer im Wald noch rechtzeitig <w>auslöschen</w>."
                        }
                    ],
                    "synonyms": [
