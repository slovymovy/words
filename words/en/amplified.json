                {
                    "sense_id": "7d6a5012-0562-368d-a6ac-d41a4d9c33be",
                    "sense_definition": "Having been made more intense, powerful, or louder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>amplified</w> sound of the guitar filled the entire stadium.",
                            "target_lang_translations": {
                                "ru": "<w>Усиленный</w> звук гитары заполнил весь стадион."
                            }
                        },
                        {
                            "text": "Her <w>amplified</w> voice echoed through the hall during the speech.",
                            "target_lang_translations": {
                                "ru": "Её <w>усиленный</w> голос эхом разносился по залу во время выступления."
                            }
