                ],
                "translations": [
                    {
                        "translation_id": "9d72df69-0736-4511-96a5-3b357ad305e8",
                        "source_entry_id": "e1ea6d23-efad-3aa1-ad54-c42fa9added8",
                        "source_sense_id": "3c7197bb-461d-365f-929a-786af7cffbcc",
                        "target_lang_word": "digitize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digitize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af754e31-a801-3575-aca1-9839ce43840f",
                                        "entry_id": "601fd188-708c-38d3-af7a-78af1f9e7f48",
                                        "glosses": [
                                            "To represent something (such as an image or sound) as a structured sequence of binary digits."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28db90a5-92a1-4d5b-982a-f36d256b83ef",
                                                "sense_id": "af754e31-a801-3575-aca1-9839ce43840f",
                                                "text": "When you digitize a visual image, you are translating it into digital signals so that it can be broken down into pixels and loaded into the computer."
                                            },
                                            {
                                                "example_id": "b5a0f317-6be4-4511-8109-4f0c7346fdd1",
                                                "sense_id": "af754e31-a801-3575-aca1-9839ce43840f",
                                                "text": "According to press releases and university librarians, Google plans to digitize and make available through its Google Books service approximately 15 million volumes within a decade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd9d730c-866f-30ff-bae1-8a7f132f5e74",
                                        "entry_id": "601fd188-708c-38d3-af7a-78af1f9e7f48",
                                        "glosses": [
                                            "To quantize a continuous or analog value; to convert it into a discrete value."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f260f689-57f0-3824-8d8e-f408d22cf4c6",
                                        "entry_id": "601fd188-708c-38d3-af7a-78af1f9e7f48",
                                        "glosses": [
                                            "To finger."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b105f6b-9fc6-4d1e-a9db-8775e230997e",
                                                "sense_id": "f260f689-57f0-3824-8d8e-f408d22cf4c6",
                                                "text": "to digitize a pen"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4c6d3e4-5706-4b86-bfba-9c033390edac",
                        "source_entry_id": "e1ea6d23-efad-3aa1-ad54-c42fa9added8",
                        "source_sense_id": "3c7197bb-461d-365f-929a-786af7cffbcc",
                        "target_lang_word": "digitalize",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digitalize",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560b40a1-f48d-3468-b3af-daf5f3dedccc",
                                        "entry_id": "61cacdf4-7c15-3c8e-8443-a7ff4b54a330",
                                        "glosses": [
                                            "Synonym of digitize."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab0cc003-7e22-4f84-a0b3-22395b5d544e",
                                                "sense_id": "560b40a1-f48d-3468-b3af-daf5f3dedccc",
                                                "text": "How to lawfully digitalize resources has become the principal issue in constructing digital libraries. To digitalize resources means to transform a document into digital format, which only adds a mode of using the resources but does not produce a new one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12e5212-458b-3244-a414-25bbaab75dd5",
                                        "entry_id": "61cacdf4-7c15-3c8e-8443-a7ff4b54a330",
                                        "glosses": [
                                            "To administer digitalis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25348aba-4b77-4a54-ab12-e868059c6cbc",
                                                "sense_id": "d12e5212-458b-3244-a414-25bbaab75dd5",
                                                "text": "The dosage should be sufficient to produce satisfactory digitalization but it is our impression that it is less hazardous to digitalize with moderate rapidity than by using a massive dose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
