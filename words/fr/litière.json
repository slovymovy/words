            "senses": [
                {
                    "sense_id": "379d1db4-4b48-3b76-96fd-91cae84e90d9",
                    "sense_definition": "Couche de paille, de copeaux ou de matière absorbante préparée pour le couchage ou les déjections des animaux.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut changer la <w>litière</w> du chat régulièrement pour éviter les mauvaises odeurs dans l'appartement."
                        },
                        {
                            "text": "Le fermier a étalé une épaisse couche de <w>litière</w> fraîche dans l'étable avant la nuit."
                        }
                    ],
                    "common_phrases": [
                        "litière pour chat",
                        "changer la litière",
                        "litière de paille"
                    ]
                },
                {
                    "sense_id": "a9bc2458-6242-3e7b-b731-a42abf55e962",
                    "sense_definition": "Ensemble des feuilles mortes et débris végétaux qui se décomposent à la surface du sol.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux insectes et petits invertébrés vivent cachés sous la <w>litière</w> forestière humide."
                        },
                        {
                            "text": "En automne, la décomposition lente de la <w>litière</w> enrichit naturellement le sol du sous-bois."
                        }
                    ],
                    "synonyms": [
                        "couverture morte"
                    ],
                    "common_phrases": [
                        "litière forestière",
                        "litière de feuilles"
                    ]
                },
                {
                    "sense_id": "7accdb7d-1404-3c0b-98f9-345d411635a7",
                    "sense_definition": "Moyen de transport historique fermé, sans roues, porté par des hommes ou des animaux de bât.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dignitaire malade traversait ses provinces installé dans une somptueuse <w>litière</w> portée par deux mules."
                        },
                        {
                            "text": "Les patriciens romains préféraient souvent la <w>litière</w> aux chariots pour circuler en ville sans secousses."
                        }
                    ],
                    "common_phrases": [
                        "voyager en litière"
                    ],
