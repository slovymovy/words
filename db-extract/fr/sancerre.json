                                        "entry_id": "702251b9-3dba-3a3e-b105-fb28d5cfd566",
                                        "glosses": [
                                            "A French wine from Sancerre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c82b4d8-e832-48a7-9c0f-1cd9fdc94402",
                                                "sense_id": "1889c43c-a5c6-3db5-a852-a91c9496a6ac",
                                                "text": "In the northern hemisphere, June 21 has the most daylight hours. Pack a picnic—a chilled bottle of Sancerre, cheese, olives, and a nice baguette—and hit the grassy knoll."
                                            },
                                            {
                                                "example_id": "f974553e-ad05-476d-8d80-aa417dbc1d32",
                                                "sense_id": "1889c43c-a5c6-3db5-a852-a91c9496a6ac",
                                                "text": "Lunch has been ruined, the Sancerre runs dry, but somehow, somehow, they’ll find a way to carry on."
                                            },
                                            {
                                                "example_id": "2a893b4b-54b6-4988-850f-9bfb102a9877",
                                                "sense_id": "1889c43c-a5c6-3db5-a852-a91c9496a6ac",
                                                "text": "When I finally careered into the right place, 30 minutes late, he was sitting alone, looking sharp in a Timothy Everest navy wool suit, eating an appetizer, which he called “a chickpea thing” and drinking a glass of Sancerre."
                                            }
                                        ]
                                    }
                                ]
