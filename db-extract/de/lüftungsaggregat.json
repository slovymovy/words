                "senses": [
                    {
                        "sense_id": "1238de95-a0d1-36ec-9ab2-ea107adeb2cb",
                        "entry_id": "d712fc84-220a-3dd4-b593-3ea89f2535c4",
                        "glosses": [
                            "kompakte Einheit aus mehreren Apparaten, Geräten oder Maschinen, zur Erfüllung einer bestimmten Lüftungsfunktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2c46b68-80b6-43a8-8621-42583822a761",
                                "sense_id": "1238de95-a0d1-36ec-9ab2-ea107adeb2cb",
                                "text": "„Gegenstand der Erfindung ist eine Montageanordnung für ein Lüftungsaggregat, die eine in einem Gebäude an der Decke eines Aufenthaltsraumes aufzuhängende oder auf ähnliche Weise zu befestigende im Wesentlichen horizontale Montageplatte aufweist, an welcher vorgesehen ist, das Lüftungsaggregat an der Unterseite der Montageplatte durch Aufhängen zu befestigen, wobei die Montageplatte mit Durchführungen versehen ist, die mit ihren oberseitigen Teilen der Montageplatte mit dem Lüftungskanalsystem des Gebäudes ineinandergreifen und dementsprechend mit ihren unterseitigen Teilen der Montageplatte mit Rohrstutzen des Lüftungsaggregats ineinandergreifen.“"
                            },
                            {
                                "example_id": "a15e073c-2c89-4808-88f5-dff1b5cc18d8",
                                "sense_id": "1238de95-a0d1-36ec-9ab2-ea107adeb2cb",
                                "text": "„Einzelne oder mehrere Lüftungsaggregate können bis zu einer Gesamtluftmenge (Zu- und Abluft) von 12'000 m³/h in Räumen mit geringer Brandgefährdung aufgestellt werden.“"
                            },
                            {
                                "example_id": "2d66c39d-775a-4abe-9a33-2a59cfdeefe9",
                                "sense_id": "1238de95-a0d1-36ec-9ab2-ea107adeb2cb",
                                "text": "„Beginnend nach dem Lüftungsaggregat, wird über eine Distanz von bis zu 30m, bei starker Verschmutzung mit einem elektrischen Bürsten-Reinigungssystem, der Schmutz gelöst und anschließend mit unseren Spezialpressluftdüsen zu unserer Staubfalle geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
