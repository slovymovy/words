                    "sense_id": "0bd3cc69-93dd-390a-bf5f-585c30a3cfda",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surnames",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Mr. <w>Topping</w>, who donated his entire book collection.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь мистера <w>Топпинга</w>, который пожертвовал всю свою книжную коллекцию."
                            }
                        },
                        {
                            "text": "We are meeting with the <w>Topping</w> family to discuss the property boundaries.",
                            "target_lang_translations": {
                                "ru": "Мы встречаемся с семьей <w>Топпинг</w>, чтобы обсудить границы собственности."
