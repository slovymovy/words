                    {
                        "translation_id": "ff43dd1f-e010-4ee6-90b2-2cb3b2c513c7",
                        "source_entry_id": "6fd55adb-8b69-3808-92a9-a3459f781df5",
                        "source_sense_id": "488e51ff-a1a1-34b3-999c-01124bb5eee6",
