{
    "word_family": [
        "demonstrate",
        "demonstration",
        "demonstrator",
        "demonstrative"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce6c8088-5001-3862-8ac8-9e0dbd295014",
                    "sense_definition": "Able to be proven or shown to be true by evidence or logic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "provable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is easily <w>demonstrable</w> that water extinguishes fire.",
                            "target_lang_translations": {
                                "zh": "水能灭火这一点是<w>可证明的</w>。"
                            }
                        },
                        {
                            "text": "The company failed to provide <w>demonstrable</w> proof of their claims.",
                            "target_lang_translations": {
                                "zh": "该公司未能为其主张提供<w>可证明的</w>证据。"
                            }
                        }
                    ],
                    "synonyms": [
                        "provable",
                        "verifiable"
                    ],
                    "antonyms": [
                        "indemonstrable",
                        "undemonstrable"
                    ],
                    "common_phrases": [
                        "demonstrable proof",
                        "demonstrable evidence"
                    ],
                    "target_lang_definitions": {
                        "zh": "可以通过证据或逻辑证明是真实的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可证明的",
                                "target_lang_sense_clarification": "指可以通过事实或逻辑验证的。"
                            },
                            {
                                "target_lang_word": "可验证的",
                                "target_lang_sense_clarification": "可以通过证据验证的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fe4ae45-7c68-34e7-9019-d228420da8c7",
                    "sense_definition": "A fact or thing that can be clearly proven or shown.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "provable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We deal here with imponderables rather than <w>demonstrables</w>.",
                            "target_lang_translations": {
                                "zh": "我们在这里处理的是不可估量的事物，而不是<w>可证明的事实</w>。"
                            }
                        },
                        {
                            "text": "The theory relies on several <w>demonstrables</w> that are widely accepted by scientists.",
                            "target_lang_translations": {
                                "zh": "该理论依赖于几个被科学家广泛接受的<w>可证明的事实</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "可以被清楚证明或展示的事实或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "可证明的事实",
                                "target_lang_sense_clarification": "指客观存在且能被验证的结论。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}