                "senses": [
                    {
                        "sense_id": "c26a2ec7-f43d-313a-9aa1-f2a344ae6246",
                        "entry_id": "45d9dc13-c6fe-312f-afcc-e7b7c4752b1e",
                        "glosses": [
                            "verblijfsruimte helemaal bovenin een gebouw, die daardoor beperkt is in grootte, bereikbaarheid en comfort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f3a27c2-9937-433b-80a0-04f4b9aa8431",
                                "sense_id": "c26a2ec7-f43d-313a-9aa1-f2a344ae6246",
                                "text": "Ik huurde er een dakkamer van twaalf vierkante meter."
                            },
                            {
                                "example_id": "cf43f638-c9f6-405b-a093-62e8e1a9f60f",
                                "sense_id": "c26a2ec7-f43d-313a-9aa1-f2a344ae6246",
                                "text": "Hij huurt het liefst dakkamers of kelders."
                            },
                            {
                                "example_id": "6425d9ec-be69-4c32-8bb6-ca5f0dca7ed8",
                                "sense_id": "c26a2ec7-f43d-313a-9aa1-f2a344ae6246",
                                "text": "Soms gingen we helemaal naar boven in de school, de ruime trap op naar de bovenste verdieping waar recht tegenover de laatste treden, in de grootste dakkamer, het lokaal was van Van der Erve, de tekenleraar."
                            },
                            {
                                "example_id": "38ef0cfe-00a1-4155-a354-add32855c8ea",
                                "sense_id": "c26a2ec7-f43d-313a-9aa1-f2a344ae6246",
                                "text": "De Delwailles moesten nu ook kleiner gaan wonen. Maar niet in de goedkope achterbuurten. Liever een paar dakkamertjes gehuurd in een nette straat, waar ook renteniershuizen lagen."
                            }
                        ]
                    }
