                        "examples": [
                            {
                                "example_id": "92e9e69b-07fa-47bd-9ffe-087584d25501",
                                "sense_id": "e69002f7-fb88-36d0-9ba2-2239a8997cb6",
                                "text": "After passing through Newbridge, where the cavalry barracks are, a 'kyar' took us to the Curragh Camp, where two or three thousand men only were then in camp."
                            },
                            {
                                "example_id": "1948d9b6-77b6-4673-b873-a3ce128862e3",
                                "sense_id": "e69002f7-fb88-36d0-9ba2-2239a8997cb6",
                                "text": "The first Bianconi Car started from Clonmel to Cahir, twelve miles, on the 5th of July, 1815, the fare was eighteenpence; but no one patronised it! Not a single passenger tried the car; the peasantry could walk gratis why pay for a \"kyar\"?"
                            }
                        ]
