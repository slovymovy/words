                "senses": [
                    {
                        "sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                        "entry_id": "ebda2cce-f20e-3de1-b676-a901148e02e7",
                        "glosses": [
                            "Unfähigkeit, Entscheidungen zu treffen oder getroffene Entscheidungen umzusetzen; Unzuverlässigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0df2ea-7788-40c3-b4ce-b1c3e27ce69f",
                                "sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                                "text": "Ist dies die Welt, von deren Wankelmut, Unzuverlässigkeit ich viel gehört und nichts empfunden habe?"
                            },
                            {
                                "example_id": "6751bca0-f005-47b5-b3e2-e2c06a5dca07",
                                "sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                                "text": "Durch Nichtstun, Furcht der Wahrheit nachzufragen, / Unschlüssigkeit, Mißtrauen, Wankelmut, / Mehr Böses oft als zehn Tyrannen tut: / Wer hat die Schuld? und wer ist zu beklagen?"
                            },
                            {
                                "example_id": "8964c15a-bf39-4092-9c59-d397aed7b0c2",
                                "sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                                "text": "Der samnitische Feldherr Lucius Cluentius kam herbei, der Stadt Entsatz zu bringen, allein er ward von Sulla zurückgewiesen, und als er, durch Keltenscharen verstärkt, seinen Versuch wiederholte, hauptsächlich durch den Wankelmut dieser unzuverlässigen Gesellen so vollständig geschlagen, daß sein Lager erobert und er selbst mit dem größten Teil der Seinigen auf der Flucht nach Nola zu niedergehauen ward."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b39e2f46-bc2a-4596-b7d3-5467e4f16b40",
                        "source_entry_id": "ebda2cce-f20e-3de1-b676-a901148e02e7",
                        "source_sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                        "source_sense_description": "Unfähigkeit, Entscheidungen zu treffen oder getroffene Entscheidungen umzusetzen; Unzuverlässigkeit",
                        "target_lang_word": "inconstancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inconstancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                        "entry_id": "4a5b3c7d-0776-3c1f-b989-33b28cd9c306",
                                        "glosses": [
                                            "Lack of constancy; lack of consistency in thought, emotion or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce0b96f9-e8e8-4d32-aac1-8a06c7ce1e20",
                                                "sense_id": "0cdb7e2f-a5b9-30d7-abd0-03a452ac8246",
                                                "text": "Although she loved him for many years, his inconstancy eventually drove her to another."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce8e1417-0bba-4024-870b-c389f00a6748",
                        "source_entry_id": "ebda2cce-f20e-3de1-b676-a901148e02e7",
                        "source_sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                        "source_sense_description": "Unfähigkeit, Entscheidungen zu treffen oder getroffene Entscheidungen umzusetzen; Unzuverlässigkeit",
                        "target_lang_word": "indécision",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indécision",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                                        "entry_id": "b9f708ad-ec5b-382d-8df5-4dc4451990b4",
                                        "glosses": [
                                            "Caractère d’un homme indécis, d'une femme indécise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7c3485b-2191-45f9-9ce2-d0d6ce9e5931",
                                                "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                                                "text": "Toby s’arrêta à l’endroit où cette dernière rue tourne dans Knight’s Place. Puis il se mit à courir en avant, en arrière, avec une de ses oreilles dressée et l’autre traînante : exactement l’image de l’indécision canine ! Enfin, il se mit à trottiner en rond, levant la tête vers nous de temps en temps, comme pour demander que l’on veuille bien comprendre son embarras."
                                            },
                                            {
                                                "example_id": "cc7ceebb-d38e-476d-8e03-8c44bb1a16ca",
                                                "sense_id": "4cef7b8a-562c-3c56-9216-0d36589aeec7",
                                                "text": "L’abstraction devient la puissance de réflexion, l’inaction une capacité à formuler les problèmes, l’inadaptation une polyvalence, l’indécision la certitude de l'incertain, la rhétorique un agir communicationnel, la complication la conscience de la complexité et l’achiffrisme s'évanouit dans l'usage commune d'une règle de trois appliquée à une langue des affaires qu'on apprend comme n'importe quelle langue."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "469ebe0b-549f-496c-a55e-731da9c3d409",
                        "source_entry_id": "ebda2cce-f20e-3de1-b676-a901148e02e7",
                        "source_sense_id": "d4a7d4a7-600f-3e21-87c5-82d3e36d7b75",
                        "source_sense_description": "Unfähigkeit, Entscheidungen zu treffen oder getroffene Entscheidungen umzusetzen; Unzuverlässigkeit",
                        "target_lang_word": "versatilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versatilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                        "entry_id": "2fd786c1-29a9-3956-8cf9-6164dcfebac1",
                                        "glosses": [
                                            "Caractère de ce qui est versatile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3fe1f19-03e6-429a-8cb6-0fd728b38e63",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "D’après les membres de sa famille, son humeur peut être sombre et changeante, bien que, d’après eux, son caractère ait beaucoup perdu de sa versatilité ces dernières années."
                                            },
                                            {
                                                "example_id": "f155fd26-4ff4-4225-9726-a63d312352d1",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "L’efficacité de la CAQ tient peut-être à sa versatilité. (Dans son sens français : « Qui change souvent et aisément de parti, d’opinion. »)"
                                            },
                                            {
                                                "example_id": "7eb85f16-8288-4035-8c7e-de91d904b7a8",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Une grande versatilité d’esprit, de sentiments."
                                            },
                                            {
                                                "example_id": "a46ac064-7532-4057-99ec-7f17725a3f96",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Il a beaucoup de versatilité dans le caractère, dans ses opinions."
                                            },
                                            {
                                                "example_id": "adba5cb0-f764-4bc3-89f4-d4c7236374ff",
                                                "sense_id": "2fd14379-fb37-3139-be29-59606e85516e",
                                                "text": "Tendant à briser les idées reçues sur la sexualité gay, cette étude montre que si les relations érotiques entre hommes restent dominées par une polarité de genre arrimée à la division des rôles sexuels – les hommes « réceptifs » étant socialement codés comme féminins, les « actifs » comme masculins -, la « versatilité » est désormais la situation la plus courante chez les hommes qui aiment les hommes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65785f76-707b-3484-a1f1-704594b3af85",
                                        "entry_id": "2fd786c1-29a9-3956-8cf9-6164dcfebac1",
                                        "glosses": [
                                            "Exprime l’affinité d’un terminal, mobile ou fixe, vis-à-vis des différents réseaux auxquels on peut le connecter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
