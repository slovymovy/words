                    "frequency": "Middle",
                    "semantic_group_id": "jardin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier taille régulièrement la <w>bordure</w> de buis qui longe l'allée principale."
                        },
                        {
                            "text": "Nous avons planté une jolie <w>bordure</w> de lavande tout autour du potager."
