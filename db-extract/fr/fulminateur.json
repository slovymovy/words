                        ],
                        "examples": [
                            {
                                "example_id": "fa36ee50-d8db-4576-abb6-714f9c094e7a",
                                "sense_id": "b4efd38f-9044-371e-9ac9-089c46b50032",
                                "text": "Il est vrai que celui-ci [Laurent le Magnifique] est mort lorsque notre philosophe [Pic de la Mirandole] va jusqu'à s'établir dans le couvent de Saint-Marc, place forte du fulminateur [Savonarole]."
                            },
                            {
                                "example_id": "d288d0e7-8b17-4ce9-b90a-291fdf1cf3f0",
                                "sense_id": "b4efd38f-9044-371e-9ac9-089c46b50032",
                                "text": "On immole sans cesse, aux traits du ridicule,\nLe grand fulminateur de la petite bulle."
                            }
                        ]
                    }
