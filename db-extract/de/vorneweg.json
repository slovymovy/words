                            "räumlich"
                        ],
                        "examples": [
                            {
                                "example_id": "d63ed897-cd59-4b6d-a690-15dbab38d8c8",
                                "sense_id": "358749ae-5168-34be-8953-71e251db7509",
                                "text": "Das Kind lief beim Osterspaziergang immer vorneweg, langsam folgten die Erwachsenen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3992b4d-1549-3daf-b527-ace6916d9f43",
                        "entry_id": "d8a60dfe-1070-3b82-893b-a5880762f822",
                        "glosses": [
                            "im Vorhinein, bevor etwas passieren soll"
                        ],
                        "tags": [
                            "temporal"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a1a037-70c7-4889-bf8a-e8ad1e8fb93a",
                                "sense_id": "a3992b4d-1549-3daf-b527-ace6916d9f43",
                                "text": "Lassen Sie mich das gleich vorneweg sagen: Ich bin hier als Privatperson."
                            },
                            {
                                "example_id": "6dfa5578-0ccc-459c-8ca3-1e2fe9231737",
                                "sense_id": "a3992b4d-1549-3daf-b527-ace6916d9f43",
                                "text": "Vorneweg gibt’s einen kleinen Salat."
                            },
                            {
                                "example_id": "0cad1b77-2c01-4452-b64b-47f995c47cf3",
                                "sense_id": "a3992b4d-1549-3daf-b527-ace6916d9f43",
                                "text": "„Ganz vorneweg: Die ach so schöne neue crossmediale Welt erfordert intensive Kommunikation, Koordination, Vernetzung sowie Schnittstellenoptimierung nach allen Seiten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "75f75065-8087-35db-a88d-7b688dbfac94",
                        "entry_id": "d8a60dfe-1070-3b82-893b-a5880762f822",
                        "glosses": [
                            "vor allem anderen, am meisten (betroffen), als Wichtigstes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99ffc28f-7183-4a66-bd1e-2d2f87cab6ee",
                                "sense_id": "75f75065-8087-35db-a88d-7b688dbfac94",
                                "text": "„Er erwartet natürlich, dass bei einem Freudenfest vorneweg das Thema des Christentums, die Freude der Auferstehung zu sehen ist, […].“"
                            }
                        ],
                        "sense_index_json": "\"3\""
