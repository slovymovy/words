                "senses": [
                    {
                        "sense_id": "46c0df13-7dce-3d39-bf00-27cc165bfaa8",
                        "entry_id": "b592cf8e-173a-3f7f-9484-c3db8d670478",
                        "glosses": [
                            "Stadt in der englischen Grafschaft Kent"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "141a1547-0f80-4f45-9e7b-3e1ad1beb42d",
                                "sense_id": "46c0df13-7dce-3d39-bf00-27cc165bfaa8",
                                "text": "Rochester liegt östlich von London."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "12ac7ab4-8a4b-336f-a3d6-8dfedcd855a8",
                        "entry_id": "b592cf8e-173a-3f7f-9484-c3db8d670478",
                        "glosses": [
                            "Stadt im US-Bundesstaat New York"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f088bb4-83e5-4852-af4c-d3a7b840815b",
                                "sense_id": "12ac7ab4-8a4b-336f-a3d6-8dfedcd855a8",
                                "text": "„Jahre später sagte mein Kollege Gregg McCrary während der Arbeit an den Arthur-Shawcross-Prostituiertenmorden in Rochester, New York, korrekt voraus, dass sich der Mörder als jemand herausstellen würde, den viele Polizisten gut kannten und der sie in ihren Lieblingslokalen begeistert aushorchte.“"
                            },
                            {
                                "example_id": "38ff9d13-b854-4b1b-9959-5c09671aaaa0",
                                "sense_id": "12ac7ab4-8a4b-336f-a3d6-8dfedcd855a8",
                                "text": "„Da Joseph in Kanada keine Arbeit fand, zog die Familie weiter südwärts bis in die Gegend von Rochester, New York, wo er sich spätestens 1831 als Küfer und Schreiner niederließ.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
