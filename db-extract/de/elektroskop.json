                    {
                        "sense_id": "81e84aa2-1ffa-35cf-8894-4a655b7925fd",
                        "entry_id": "51067bd3-a93b-3e5b-b9bc-cdbd8bf47b5f",
                        "glosses": [
                            "Gerät zum Nachweis elektrischer Ladungen und Spannungen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "6d992a7c-98fd-4f1a-a28e-d3573ae9b372",
                                "sense_id": "81e84aa2-1ffa-35cf-8894-4a655b7925fd",
                                "text": "„Sie sandten Strahlen aus und hatten, ebenso wie die Röntgenstrahlen, die ja sekundär entstanden, die Fähigkeit, Luft leitend zu machen; ein Elektroskop, das Becquerel in einigem Abstand von der Uranverbindung aufstellte, wurde von den „Uranstrahlen“ entladen.“"
                            }
