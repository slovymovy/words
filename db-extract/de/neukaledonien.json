                    {
                        "sense_id": "61bde8a2-b465-30b2-af59-1f8fb7f22974",
                        "entry_id": "71d88517-c70f-3eb7-b84c-3786a00e99b5",
                        "glosses": [
                            "Inselgruppe im Pazifik, autonomes französisches Überseegebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afd50e23-b3e4-4d31-9ed0-ac44beaf9077",
                                "sense_id": "61bde8a2-b465-30b2-af59-1f8fb7f22974",
                                "text": "Neukaledonien ist von finanziellen Zuschüssen Frankreichs abhängig."
                            },
                            {
                                "example_id": "6c02503b-656a-4d47-8137-35e3c94e8ffe",
                                "sense_id": "61bde8a2-b465-30b2-af59-1f8fb7f22974",
                                "text": "„Neukaledonien liegt zwischen dem 19. und 23. südlichen Breitengrad und damit in der tropischen Klimazone.“"
                            },
                            {
                                "example_id": "c82c6236-acfe-4b27-921f-e2a6931e97b0",
                                "sense_id": "61bde8a2-b465-30b2-af59-1f8fb7f22974",
                                "text": "„Neukaledonien hat in der Hauptstadt Nouméa eine Ausgangssperre verhängt und öffentliche Versammlungen verboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
