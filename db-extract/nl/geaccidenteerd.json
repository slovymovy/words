                                        ]
                                    },
                                    {
                                        "sense_id": "41cb5115-46fc-3a82-a476-101f78585a55",
                                        "entry_id": "f594aada-344e-3eaf-95d6-3c217e14c337",
                                        "glosses": [
                                            "Qualifie une personne atteinte dans son intégrité tant morale que physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493b9915-0f14-4367-a2bc-97c04f37eb13",
                                                "sense_id": "41cb5115-46fc-3a82-a476-101f78585a55",
                                                "text": "Cette personne a été accidentée à la suite d’une chute de vélo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e6f730-5441-3d0a-83c8-139f4ce1bf4b",
                                        "entry_id": "f594aada-344e-3eaf-95d6-3c217e14c337",
                                        "glosses": [
                                            "Se dit d’un objet ayant subi une dégradation à la suite d’un choc, d’un événement imprévu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
