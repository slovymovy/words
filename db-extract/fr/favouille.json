                    {
                        "sense_id": "50836e17-5cae-3371-bd34-3e4cd0b4cfe8",
                        "entry_id": "52d23903-dca5-3de3-804b-86ad175256ee",
                        "glosses": [
                            "Carcinus maenas ou crabe vert."
                        ],
                        "tags": [
                            "Provence"
                        ],
                        "examples": [
                            {
                                "example_id": "b0012d3d-2876-4fe3-9ffc-bbbe22aa2d2a",
                                "sense_id": "50836e17-5cae-3371-bd34-3e4cd0b4cfe8",
                                "text": "Les crabes communs (favouille) de moyenne grosseur, sont préférables ; on prendra plutôt des femelles, si cela est possible."
                            }
                        ]
                    },
                    {
                        "sense_id": "1057d288-07da-3bd8-8317-2cb78aa916ca",
                        "entry_id": "52d23903-dca5-3de3-804b-86ad175256ee",
                        "glosses": [
                            "Désigne une personne qui n'a pas beaucoup d'entendement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f21bab93-f1f3-4b54-a6c7-b3536ebb9a8b",
                                "sense_id": "1057d288-07da-3bd8-8317-2cb78aa916ca",
                                "text": "Son père hausse les épaules. Il lui dit : \" Il y a des moments, ma fille, tu es vraiment une favouille.\"\n Elle rit, elle lui demande : \"Comment sais-tu ça ?\" Il répond qu'il a des provençaux, parmi ses ouvriers. Ils lui ont expliqué que le mot favouille désigne un petit crabe pas très malin, ce qui est rare chez nos ancêtres supposés les plus reculés, et qu'à Marseille, à Bandol ou aux Saintes-Maries-de-la-Mer, on nomme ainsi quelqu'un qui n'a guère d'entendement."
                            }
                        ]
                    }
