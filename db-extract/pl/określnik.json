        "pl-extract.jsonl": [
            {
                "entry_id": "cf7f3817-6daa-3821-b8ba-a9f7ccb83f91",
                "word": "określnik",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fdbe0e15-0df0-326d-9a0c-d67f4c050fe4",
                        "entry_id": "cf7f3817-6daa-3821-b8ba-a9f7ccb83f91",
                        "glosses": [
                            "słowo lub wyrażenie określające"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f9334d6-db93-41a5-bed7-e27a6a07be18",
                        "source_entry_id": "cf7f3817-6daa-3821-b8ba-a9f7ccb83f91",
                        "source_sense_id": "fdbe0e15-0df0-326d-9a0c-d67f4c050fe4",
                        "target_lang_word": "determiner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "determiner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "Someone or something that determines, or helps to determine, something else.",
                                            "A factor that defines something, or one among several that define it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "974c854a-bc71-4e99-9c84-05b36213291f",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "Near-synonym: definer"
                                            },
                                            {
                                                "example_id": "31f0b0e2-9b2c-435d-a4d3-a9dbfd00fade",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "In quality management, the determiners of quality sometimes differ across use cases."
                                            },
                                            {
                                                "example_id": "9103ef97-90d7-4377-8a59-c4f7433fe465",
                                                "sense_id": "9504e63c-cedf-319b-aa78-f74bbfc701fe",
                                                "text": "The \"steel-yards\" and \"measures\" were the only determiners of weight and quantity — as the hour-glass and sun dial were of time — possessed at first (so far as appears) by the passengers of the Pilgrim ship […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "Someone or something that determines, or helps to determine, something else.",
                                            "Someone or something (especially a sentient agent) that determines; a decider of a disposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c506831a-1491-4ca0-bc93-13329e02d75c",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "The software is the determiner if no input is given before the prompt times out."
                                            },
                                            {
                                                "example_id": "704fa524-b976-463f-93fb-cc6df5b50552",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "Near-synonyms: decider, decisor, disposer, definer, arbiter, arbitrator, decisionmaker"
                                            },
                                            {
                                                "example_id": "e3e85424-9830-4d69-86d3-4e82756b82d0",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "He is the determiner [usually referring to God (in theological contexts) and job roles (in administrative contexts)]"
                                            },
                                            {
                                                "example_id": "f7961e6f-478c-4a08-a6b6-cfb7a04d4205",
                                                "sense_id": "84663489-2158-3df5-9d84-3655aea04171",
                                                "text": "Who is the determiner? [administratively or theologically]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "A member of a class of words functioning in a noun phrase to identify or distinguish a referent without describing or modifying it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f0d98f5-3464-4612-a6f5-155124feb309",
                                                "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                                "text": "Definite articles, indefinite articles, and cardinal numbers acting as quantifiers are types of determiners."
                                            },
                                            {
                                                "example_id": "07305908-b299-4ce1-a613-6a07d60fb56a",
                                                "sense_id": "1e1ff242-19fc-32e2-a4c7-166b63cb6818",
                                                "text": "Near-synonym: determinative (broadly synonymous)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                        "entry_id": "686bdcbe-dc4c-390d-a7c7-330528c02f9c",
                                        "glosses": [
                                            "A dependent function in a noun phrase that marks it as definite or indefinite. This function is usually filled by words in the determinative class but may be filled by other elements such as a genitive pronoun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8b89d7-f50c-4e31-8681-fcccd3abde4f",
                                                "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                                "text": "Near-synonym: determinative (broadly synonymous)"
                                            },
                                            {
                                                "example_id": "675b29b7-5cf1-465a-9c27-7119db39bc99",
                                                "sense_id": "ac838aa1-e712-33e2-b379-fa9811a37543",
                                                "text": "In the sentence \"Many people voted for him,\" the word many is a determiner."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8987e1b-b566-4d9d-a583-f75be1ee70b0",
                        "source_entry_id": "cf7f3817-6daa-3821-b8ba-a9f7ccb83f91",
                        "source_sense_id": "fdbe0e15-0df0-326d-9a0c-d67f4c050fe4",
                        "target_lang_word": "Bestimmungswort",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestimmungswort",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                        "entry_id": "5e3a1acc-3e95-30b1-b356-97fd57bfe7c3",
                                        "glosses": [
                                            "der Teil einer Zusammensetzung (eines Determinativkompositums), durch den das Grundwort eine spezielle Bedeutung erhält"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90d5a80f-5b11-444d-ba06-d3cd6d05d2ca",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "„Die Zusammenhänge der Wortfamilien wurden durch eine Anordnungsweise gewahrt, die nur die Grundwörter alphabetisch ordnet, die Bestimmungswörter aber innerhalb des Grundwortartikels alphabetisch anführt.“"
                                            },
                                            {
                                                "example_id": "4ae42069-f349-4728-8e88-fbeda0fcbe4c",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "In Komposita deutscher Herkunft steht das Bestimmungswort fast immer vorn, das Grundwort hinten. Ausnahmen sind Ortsteilbezeichnungen wie „Hamburg-Altona“ und einige andere Worttypen."
                                            },
                                            {
                                                "example_id": "f9843d84-cfee-447e-b6fe-5495ec9ea0e8",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "In Bestimmungswort ist Bestimmungs- das Bestimmungswort, -wort das Grundwort."
                                            },
                                            {
                                                "example_id": "49cc0d06-a31d-4081-9656-3131052eef22",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "„Der Durchkopplungsbindestrich verbindet die einzelnen Teile des Bestimmungsworts miteinander und diese mit dem Grundwort; oder es verbindet die einzelnen Teile des Grundworts miteinander und mit dem Bestimmungswort […]“"
                                            },
                                            {
                                                "example_id": "106f8665-92b5-4069-ae7a-ce0ffd4759fd",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "„In der herkömmlichen onomastischen Terminologie werden zusammengesetzte ON nach ihren Bestandteilen in Bestimmungs- (BW) und Grundwort (GW) getrennt, also der ON Regensburg als (BW) Regen-(s)- und (GW) -burg.“"
                                            },
                                            {
                                                "example_id": "911c0a0f-9603-4807-8dbe-531d323a8b01",
                                                "sense_id": "8ec77941-1f11-3a66-ab7a-6ab1547fd38a",
                                                "text": "„Komposita aus Grundwort und Bestimmungswort haben den Hauptakzent auf der Silbe des Bestimmungswortes, auf die der Akzent treffen würde, wenn es für sich allein stünde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
