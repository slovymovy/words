                        "glosses": [
                            "Keller, in dem gefoltert wird/wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0d0023a-31e8-4b0a-b8ce-efaaf009e61f",
                                "sense_id": "a8a32927-e63a-3c85-a7dc-89522255c748",
                                "text": "„Der Arzt und Chirurg mit dem Emigrantennamen Ravic (auf den letzten Seiten erfahren wir, daß sein eigentlicher Name Ludwig Fresenburg lautet) ist den Folterkellern der Gestapo und dem Konzentrationslager entkommen und lebt seit Jahren in Paris.“"
                            },
                            {
                                "example_id": "5b5a18d7-cb22-4947-8206-7fc3c93fb896",
                                "sense_id": "a8a32927-e63a-3c85-a7dc-89522255c748",
                                "text": "„Infolge der Misshandlungen in den Folterkellern des Schahs galt er als psychisch labil und wurde wegen seines auffälligen Verhaltens unter dem Spitznamen ›Ayatollah Ringo‹ bekannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
