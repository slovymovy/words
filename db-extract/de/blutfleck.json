                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Blutflecke"
                    },
                    {
                        "form_id": "98d9d35b-0861-424f-880e-7bf9d4f43e9a",
                        "entry_id": "416d2da8-48c9-3d9d-a105-f43bcb4d5cb1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Blutflecken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                        "entry_id": "416d2da8-48c9-3d9d-a105-f43bcb4d5cb1",
                        "glosses": [
                            "sichtbarer Rückstand von Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b322d19-f263-43c9-bdcc-edc9ed39f0fb",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Und damit wir bloß nicht davon reden, zeigt sie uns noch mal die beiden Litewkas ihrer beiden Söhne, die hat sie extra mitgebracht, zeigt uns die Schußlöcher und die Blutflecke im Schein der Kerze, ganz nah, immer näher…“"
                            },
                            {
                                "example_id": "2d77dda8-67e7-4304-bf73-d5747d7fdedc",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Ein großer Blutfleck auf der Brust sagte mir, daß es mit ihm zu Ende ging.“"
                            },
                            {
                                "example_id": "546f0e01-3348-4800-86ab-c01aa47da0ea",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Als Hamid auf die Straße trat, waren die Blutflecke noch da.“"
                            },
                            {
                                "example_id": "0e02e06f-21c2-4a03-94eb-e92c682e83d0",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Die kleine Welt unter dem Munitionswagen war nicht untergegangen, er konnte die Glieder bewegen, fand keine Blutflecken am Körper, keine Blutlachen im Gras.“"
                            },
                            {
                                "example_id": "28023bec-c861-42c1-a1e3-4ddf0559b507",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Das Pflaster war abgespritzt worden, doch wo Moss angeschossen worden war, konnte man noch Blutflecken auf dem Beton des Bürgersteigs sehen.“"
                            },
                            {
                                "example_id": "ae054a7b-cae9-4323-9bc9-3ba6cd3dd6b2",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Erst als er den Hörer wieder auflegte, bemerkte er die Blutflecken am Boden direkt vor der Arbeitsfläche.“"
                            },
                            {
                                "example_id": "49e246c2-c222-4c2c-9c59-8654022eef62",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Ich pisse in meine schwarze Hose mit den eingetrockneten Blutflecken, die mein Chef nicht ertragen kann.“"
                            },
                            {
                                "example_id": "d236e1dd-7be4-49b5-a1bd-711b62aa1b79",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Fragt mich doch mal, wie man Blutflecken aus einem Pelzmantel entfernt.“"
                            },
                            {
                                "example_id": "7ed2adc4-278d-4597-8174-bfb719331c28",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Die Feuerwehr spült mit dem Schlauch die Blutflecken weg, die Labortechniker fahren zu ihrem nächsten Einsatzort, und das Viertel erobert sich das Stückchen Asphalt zurück.“"
                            },
                            {
                                "example_id": "7fe0f18e-0699-426a-8f8b-f690756a7385",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Und er hat mir beigebracht, wie man Blutflecken beseitigt.“"
                            },
                            {
                                "example_id": "d4440bfc-7732-44fd-ab00-3d1aea6f6699",
                                "sense_id": "3518b8f2-c594-3d6d-9c7c-a274a300b7ab",
                                "text": "„Für einen Vierteldollar konnte Randall sich beim Anblick der Blutflecke auf den Sitzen gruseln und seine Finger in die Einschusslöcher stecken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
