                    },
                    {
                        "translation_id": "970f8e34-492a-4333-aaba-2476c1086478",
                        "source_entry_id": "b884a966-ffae-3f5a-a1f5-b7b3c8d61066",
                        "source_sense_id": "f947ea2f-55cb-3ef0-845d-d3945b710bc2",
                        "source_sense_description": "Regelung in einem Verhältniswahlrecht",
                        "target_lang_word": "kiesdrempel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kiesdrempel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "77cf0b20-a60a-338d-bf2e-b8051dcdf4b2",
                                        "entry_id": "fa433dd4-8a09-36ae-b27f-b0f011a98d36",
                                        "glosses": [
                                            "minimale aantal stemmen dat vereist is om verkozen te worden in een vertegenwoordiging"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b70ab62f-8f29-43a0-8357-9074caf69a49",
                                                "sense_id": "77cf0b20-a60a-338d-bf2e-b8051dcdf4b2",
                                                "text": "Er moet een „behoorlijk hoge kiesdrempel” komen om kleine partijen uit de Tweede Kamer te weren. Dat zegt minister Edith Schippers (Zorg, VVD) in een gesprek met deze krant. Ze wil „de ongezonde versnippering en verlamming” tegengaan."
                                            },
                                            {
                                                "example_id": "0a3a90b3-ddb6-44ed-99bc-2f090a71b1f0",
                                                "sense_id": "77cf0b20-a60a-338d-bf2e-b8051dcdf4b2",
                                                "text": "Voor de linkse politiek was het in Noordrijn-Westfalen sowieso een zwarte dag: de Grünen, coalitiepartner van de SPD, werden gehalveerd en houden maar 6 procent over. Die Linke haalde de kiesdrempel niet. Daarentegen klom de liberale FDP van 9 naar 12 procent, de beste uitslag ooit behaald in deze deelstaat. Ook de eurosceptische populisten van de AfD deden het met bijna 8 procent van de stemmen beter dan gedacht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0011e07f-acd1-3ca2-9fbd-ae3cf9a523c0",
                                        "entry_id": "fa433dd4-8a09-36ae-b27f-b0f011a98d36",
                                        "glosses": [
                                            "minimaal aantal stemmen dat vereist is om een stemming geldig te verklaren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564505ad-6ce5-4692-acfc-336be3c968e7",
                                                "sense_id": "0011e07f-acd1-3ca2-9fbd-ae3cf9a523c0",
                                                "text": "Bij een referendum in Rotterdam over het woonbeleid van de stad is woensdag de kiesdrempel niet gehaald. Om 21.00 uur sloten de stembureaus, op dat moment lag het opkomstpercentage net onder 17 procent, terwijl de kiesdrempel op 30 procent was vastgesteld."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
