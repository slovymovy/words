        "fr-extract.jsonl": [
            {
                "entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                "word": "commisération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9bbcfc16-3927-477b-a4e8-30bd1ac4878f",
                        "entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                        "tags": [
                            "plural"
                        ],
                        "form": "commisérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a75a2b6-9577-3b57-ae61-41cae13cf243",
                        "entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                        "glosses": [
                            "Sorte de pitié qu’on ressent pour ceux qui se sont rendus coupables de fautes, qui ont commis des actes contraires à la morale, à la religion."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "04716def-925d-43c7-bcad-ba7c61bb8b12",
                                "sense_id": "9a75a2b6-9577-3b57-ae61-41cae13cf243",
                                "text": "Ron et Hermione jetèrent à Harry un regard où se mêlaient l’exaspération et la commisération."
                            }
                        ]
                    },
                    {
                        "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                        "entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                        "glosses": [
                            "Fait d’éprouver de la miséricorde ; de partager la misère mentale d’autrui due à sa situation ; de compatir pour la souffrance physique ou morale d’un ou plusieurs autres individus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ac41c2-b265-4567-96e1-6b4dd0f4b5ff",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "Malgré mes efforts, le concours des places ne m'a pas été plus favorable que mes précédentes tentatives, après que le jury ait rejeté sans la moindre commisération ma candidature."
                            },
                            {
                                "example_id": "eccb859d-f189-454a-a3f0-e501ec1e8873",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "Un sentiment de commisération se peignit sur sa figure, et il jeta un regard de bienveillance sur les deux filles, […]."
                            },
                            {
                                "example_id": "6c6a7340-b1bc-4ac2-9da5-6a439133cabe",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "[…], aussi en vint-il au bout d’un instant à se persuader que le savant était fou. Il lui lança un regard de commisération en hochant la tête, …"
                            },
                            {
                                "example_id": "baf7adca-97f4-4004-99f1-4add67aa9f00",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "Alors un besoin lui vint de raconter la catastrophe à quelqu’un, d’exciter la commisération, de se rendre intéressant. Il prit une physionomie lamentable, poussa la porte de l’établissement et s’avança vers le comptoir où le patron trônait toujours."
                            },
                            {
                                "example_id": "1d8121a1-fd82-4ceb-ba01-e236cfe09884",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "Mais elle était assez réveillée pour voir le coup d’œil de commisération qu’il lui lança.— (Françoise Bouillot, Nous arrêterons le soleil, 2002, Seuil)"
                            },
                            {
                                "example_id": "13fe027f-919b-4819-a2f1-c9c78d79c9ab",
                                "sense_id": "74a867e9-02e8-3822-850a-f92a18a887c7",
                                "text": "Nous nous butons à une commisération de pure forme : « Schrecklich, schrecklich », disent-ils, puis à d’hypocrites doléances : « Comme on nous a menti ! » ; et enfin à l’insidieux raisonnement : « Mais pouvons-nous être responsables ? »"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe21538b-ead0-4e0e-bb76-2aec9167642d",
                        "source_entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                        "target_lang_word": "Mitleid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitleid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                        "entry_id": "ea32d431-034f-3f36-afb4-0b4bbdd501ec",
                                        "glosses": [
                                            "Gefühl der Anteilnahme, des Bedauerns gegenüber Menschen, die sich in einer unglücklichen Situation oder Verfassung befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b10037df-f202-4747-ad74-38368ae3597e",
                                                "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                                "text": "Sie hat großes Mitleid mit ihnen."
                                            },
                                            {
                                                "example_id": "83f9a718-ad5e-4a0b-a5f4-f9b950417182",
                                                "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                                "text": "„Mitleid mit ihr und mit sich selbst preßten ihm das Herz zusammen.“"
                                            },
                                            {
                                                "example_id": "9d82836c-4e21-409f-b6d4-fdc189ddf555",
                                                "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                                "text": "„Ihr Verhalten verriet weder Mitleid noch Mitgefühl.“"
                                            },
                                            {
                                                "example_id": "7071d1e1-4632-4bdf-b54a-0be4cb8faf8e",
                                                "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                                "text": "„Bis jetzt hatte Alice Schwarzer Mitleid mit mir.“"
                                            },
                                            {
                                                "example_id": "dfd24635-77ff-4745-9236-de1602f5dabd",
                                                "sense_id": "8bbaca5c-3de5-3f1d-9f74-103720f49807",
                                                "text": "„Das sagte ich und erweckte Mitleid damit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1f4ad51-b64d-43f2-9198-e9c1a9111dac",
                        "source_entry_id": "8115af67-a456-3f7b-9202-29eeb1a266f0",
                        "target_lang_word": "pity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                        "entry_id": "a02e521c-446c-31dc-8f15-a45a141cb74a",
                                        "glosses": [
                                            "A feeling of sympathy at the misfortune or suffering of someone or something."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26f98480-66dd-4baa-8c33-b274c5d35974",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "I can't feel any pity towards the gang, who got injured while attempting to break into a flat."
                                            },
                                            {
                                                "example_id": "2dc4d63f-e4a2-418a-9fe4-4585f548f7a7",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "take pity on someone"
                                            },
                                            {
                                                "example_id": "befedcac-13df-4d51-9de0-80b43358a919",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "He that hath pity upon the poor lendeth unto the Lord."
                                            },
                                            {
                                                "example_id": "9063cbf9-0cb0-4a37-b513-c95f9e70d59b",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "He[…]has no more pity in him than a dog."
                                            },
                                            {
                                                "example_id": "ffaac89c-ecad-4c11-8921-47d9e27301bf",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "The most usuall way to appease those minds we have offended […] is, by submission to move them to commiseration and pitty."
                                            },
                                            {
                                                "example_id": "55cc8ea3-9341-4d72-8578-022593e0c0fc",
                                                "sense_id": "33ad65dd-1533-353e-a7c2-85beab4700fe",
                                                "text": "Shepard: The Reapers are more advanced than we are. More powerful. More intelligent. They don't fear us, and they'll never take pity on us."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                        "entry_id": "a02e521c-446c-31dc-8f15-a45a141cb74a",
                                        "glosses": [
                                            "Something regrettable."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93a0756-8c0a-4115-9622-bd6a65f07bbd",
                                                "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                                "text": "It's a pity you're feeling unwell because there's a party on tonight."
                                            },
                                            {
                                                "example_id": "cb1e450b-6711-4a46-b87f-e8ff2e262e88",
                                                "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                                "text": "What a pity about the band breaking up. I loved them!"
                                            },
                                            {
                                                "example_id": "b2ce3697-f6ef-4d66-8908-b1de09d77e4c",
                                                "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                                "text": "It was a thousand pities."
                                            },
                                            {
                                                "example_id": "1c5b9145-62e9-4cf3-b360-5b0fcfb1bbca",
                                                "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                                "text": "What pity is it / That we can die but once to serve our country!"
                                            },
                                            {
                                                "example_id": "2d39cd0f-6551-4c00-ac94-f27435ef9c74",
                                                "sense_id": "b066c475-1b98-3daa-bd4b-1cc4b93f001f",
                                                "text": "It is a thousand pities that no more detailed records than those of the guard's journals are available, but enough is known to establish them firmly among the finest feats ever achieved by \"A3\" Pacifics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b428db49-d65a-38c9-81cc-c6d9a14761fb",
                                        "entry_id": "a02e521c-446c-31dc-8f15-a45a141cb74a",
                                        "glosses": [
                                            "Piety."
                                        ],
                                        "tags": [
                                            "Early",
                                            "Modern",
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d955b89-8135-48b8-b362-7fe8a0e7cb11",
                                                "sense_id": "b428db49-d65a-38c9-81cc-c6d9a14761fb",
                                                "text": "Euen so on the other syde a mans harte is contrite, when it is cutte with compunction, mollified with pitie and deuotion, moued with prayers and exhortation, is affraide by threatninges, allured by kindnes, ashamed of dishonesty, geuing place to Gods inspiration, […]"
                                            },
                                            {
                                                "example_id": "9b1fa253-7d06-437b-93d0-029c459a207c",
                                                "sense_id": "b428db49-d65a-38c9-81cc-c6d9a14761fb",
                                                "text": "A maruellous stoutnesse of a mans minde, accompanied vvith pitie tovvardes his countrie.\n When Lucius Scilla had ouercom by force of armes the Citie of Preyneste he gaue leaue and commission to the Souldiers that they should destroye it, and kyll all the Citizens sauing his Host, meaning with this good turne to shewe himselfe thankfull vnto hym, for manye curtesies receiued of hym at other times in his lodging. But that valiant Citizen hering of this commission, went foorth incontinently out of his house disguised & preasing in among other of his countrimen, sayd, that he had rather die, than owe his life to the destroyer of his countrie."
                                            },
                                            {
                                                "example_id": "c9d014e2-0e31-4c20-a6ef-2a864463ac72",
                                                "sense_id": "b428db49-d65a-38c9-81cc-c6d9a14761fb",
                                                "text": "The Church of Rome beyng moued neither with pitie, zeale, truth, reasõ, nor honesty, but onely with ambition and couetousnesse refuseth none, so they will shew thẽ selues to be of that Catholicke Church. Traytours, murtherers, theeues, coseners, cutters, adulters, baudes, strumpets and all other gracelesse persons may vpon the sayd cõditiõ haue safe accesse to Rome and be of that Church."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01fbb31a-3007-3216-b7fe-fb529436f001",
                                        "entry_id": "9e7d3654-a41e-3a17-be9f-d1a7509d956f",
                                        "glosses": [
                                            "To feel pity for (someone or something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee5b994-f9d2-451f-9ef1-be7e4a1de36a",
                                                "sense_id": "01fbb31a-3007-3216-b7fe-fb529436f001",
                                                "text": "You have got to pity the guy - he lost his wife, mother and job in the same month."
                                            },
                                            {
                                                "example_id": "13a48f7d-c8b6-46a1-9819-56cee928dabe",
                                                "sense_id": "01fbb31a-3007-3216-b7fe-fb529436f001",
                                                "text": "Like as a father pitieth his children, so the Lord pitieth them that fear him."
                                            },
                                            {
                                                "example_id": "48dd116d-bad2-46a2-9051-f2bc6f83bef6",
                                                "sense_id": "01fbb31a-3007-3216-b7fe-fb529436f001",
                                                "text": "Well! the King of France died pardoning & pitying all those who had tortured his Soul & Body, a great Pattern for us all."
                                            },
                                            {
                                                "example_id": "cdcead12-bb17-4337-abe3-1ed57e3fda29",
                                                "sense_id": "01fbb31a-3007-3216-b7fe-fb529436f001",
                                                "text": "Nor could she get round them on a single point, and I pitied her so much that I bought bread and wine off her to console her, and I let her overcharge me, and went out into the afterglow with her benediction, followed also by the farewells of the middle-class, who were now taking their coffee at little tables outside the house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "503e1439-9e2c-33d3-a84f-53f6292bfa59",
                                        "entry_id": "9e7d3654-a41e-3a17-be9f-d1a7509d956f",
                                        "glosses": [
                                            "To make (someone) feel pity; to provoke the sympathy or compassion of."
                                        ],
                                        "tags": [
                                            "regional",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6c944de-f1d7-48c0-b9f5-01c6230ce9c0",
                                                "sense_id": "503e1439-9e2c-33d3-a84f-53f6292bfa59",
                                                "text": "She lenger yet is like captiv'd to bee; / That even to thinke thereof it inly pitties mee."
                                            },
                                            {
                                                "example_id": "7ec15cc4-224c-4c1a-8fd7-fc764e00515c",
                                                "sense_id": "503e1439-9e2c-33d3-a84f-53f6292bfa59",
                                                "text": "It pitieth them to see her in the dust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb7ba41-fabb-30e1-9986-2788752c6f92",
                                        "entry_id": "7047ea79-3e7a-3de2-af66-a0258061b394",
