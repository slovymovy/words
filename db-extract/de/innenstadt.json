                                                "sense_id": "d078f2dc-45a9-34c8-8cee-9d04ec554f18",
                                                "text": "John walked every day to his downtown job."
                                            },
                                            {
                                                "example_id": "566c447c-5c88-4d3e-90ac-87a378458639",
                                                "sense_id": "d078f2dc-45a9-34c8-8cee-9d04ec554f18",
                                                "text": "“Human flesh got stuck to me,” he recalls now, as we sit in the ambulance control centre in downtown Karachi."
                                            }
