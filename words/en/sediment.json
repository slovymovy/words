            "senses": [
                {
                    "sense_id": "c4338b5a-4fe6-3d1d-a7a9-71432478a877",
                    "sense_definition": "Matter that settles to the bottom of a liquid, especially mineral or organic material deposited by water, wind, or glaciers.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Nile delta is composed of <w>sediment</w> that was washed down and deposited at the mouth of the river."
                        },
                        {
                            "text": "There was a thick layer of <w>sediment</w> at the bottom of the wine bottle."
                        }
                    ],
                    "synonyms": [
                        "deposit",
                        "dregs",
                        "silt"
                    ],
                    "common_phrases": [
                        "river sediment",
                        "layer of sediment"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d130cd52-af22-3eeb-9174-f8bb71a87eb1",
                    "sense_definition": "To settle to the bottom of a liquid as a deposit.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deposit_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fine particles slowly <w>sediment</w> when the water becomes still."
                        },
                        {
                            "text": "After being left undisturbed for hours, the suspended powder will <w>sediment</w> at the bottom of the flask."
                        }
                    ],
                    "synonyms": [
