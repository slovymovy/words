    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b783c5d2-6ac9-3542-a744-b862275c9875",
                "word": "refit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "db424666-3c63-41d2-bba2-716c14a257f1",
                        "entry_id": "b783c5d2-6ac9-3542-a744-b862275c9875",
                        "tags": [
                            "plural"
                        ],
                        "form": "refits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b9cebe3-a6c6-3394-b6fb-d4a124f6149f",
                        "entry_id": "b783c5d2-6ac9-3542-a744-b862275c9875",
                        "glosses": [
                            "The process of having something fitted again, repaired or restored."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fd5a44-958f-4aee-a65b-8720fec6efde",
                                "sense_id": "4b9cebe3-a6c6-3394-b6fb-d4a124f6149f",
                                "text": "The ship required a refit before setting out again."
                            },
                            {
                                "example_id": "dcb8eeba-fdaa-4c5b-85cc-bc085feed2b4",
                                "sense_id": "4b9cebe3-a6c6-3394-b6fb-d4a124f6149f",
                                "text": "At the start, the team removed the sides and the ceiling panels, alongside the seats. They then stripped out the cabling that runs through the carriage. Once that was done, the carriage would be ready for the refit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b5a471d8-0de1-3b2d-9cac-7c9c9a65052e",
