                {
                    "sense_id": "1c093e92-d441-3aba-9a8b-939c9766c68b",
                    "sense_definition": "Vendre des marchandises au rabais, généralement pendant les périodes de promotions ou de soldes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce magasin de prêt-à-porter <w>solde</w> tous ses manteaux d'hiver avant l'arrivée du printemps."
                        },
                        {
                            "text": "Le libraire a décidé de <w>solder</w> les anciens ouvrages pour faire de la place sur ses étagères."
                        }
                    ],
                    "synonyms": [
