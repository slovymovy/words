                    {
                        "translation_id": "bd8aeb09-4bad-48da-980d-649b3aed7980",
                        "source_entry_id": "9a96bced-63b9-358e-9d37-1dc4d453bb32",
                        "source_sense_id": "d6b3cab9-bfb7-3e6e-b829-f7446fdf20b5",
