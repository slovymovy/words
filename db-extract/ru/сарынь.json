                "senses": [
                    {
                        "sense_id": "05818398-bf85-3a9b-95bc-dc6160b9d030",
                        "entry_id": "87917da4-c1ac-3ef5-90df-ec1fd165cb6b",
                        "glosses": [
                            "толпа, сброд; сволочь, чернь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0747a7-f018-4431-b1c8-4d4cdc0066cb",
                                "sense_id": "05818398-bf85-3a9b-95bc-dc6160b9d030",
                                "text": "Разбойничий крик на Волге «Сарынь на кичку» не значил «бить всех». Слово «сарынь» (а не сарын) значит почти то же, что «сволочь». В понятии унизительном часто так и ныне называют артель бурлаков или толпу рабочих людей на расшивах и других судах, по Волге ходящих."
                            }
                        ]
                    }
