                        "sense_id": "7f6c4513-6b12-3634-85f8-5ce490ce74b8",
                        "entry_id": "57a70429-bf91-39c4-bed0-2d9ab986e0f8",
                        "glosses": [
                            "Élément chimique de numéro atomique 62 et de symbole Sm qui fait partie de la série chimique des lanthanides et des terres rares."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d1ec7f9a-be56-4209-81f6-a53ff6395476",
                                "sense_id": "7f6c4513-6b12-3634-85f8-5ce490ce74b8",
                                "text": "Marion Garçon s’est intéressée à des isotopes quasi stables de deux éléments chimiques, le samarium (Sm) et le néodyme (Nd)."
                            },
                            {
                                "example_id": "a45c5034-07c5-4f6d-8d71-4c3a08835c23",
                                "sense_id": "7f6c4513-6b12-3634-85f8-5ce490ce74b8",
                                "text": "Par chance, les minéraux qui les composent contiennent du samarium qui se substitue aisément au calcium et à l’aluminium."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb1abc5d-5d03-3be6-a3fd-53feb85910c8",
                        "entry_id": "57a70429-bf91-39c4-bed0-2d9ab986e0f8",
                        "glosses": [
                            "Métal pur de cet élément, très rare, argenté, relativement stable à l'air à température ambiante."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
