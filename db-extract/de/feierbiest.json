                "senses": [
                    {
                        "sense_id": "336f6b6e-0c6e-3974-b7b9-554398fc88e1",
                        "entry_id": "91e323be-371b-3dba-b42f-4b25eee16211",
                        "glosses": [
                            "Person, die Freude an ausgelassener Stimmung hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66832e5f-7d55-462b-bc36-b5d4ab94d292",
                                "sense_id": "336f6b6e-0c6e-3974-b7b9-554398fc88e1",
                                "text": "„Am Wochenende schlüpfte Frank Schmöller in zwei weitere Rollen: Er war am Samstag Spaßbremse und tags darauf Feierbiest.“"
                            },
                            {
                                "example_id": "e7391f35-714b-462e-ad3d-61e0f42c6612",
                                "sense_id": "336f6b6e-0c6e-3974-b7b9-554398fc88e1",
                                "text": "„Louis van Gaal präsentierte sich als ‚virtueller Meister‘ blendend gelaunt und verriet lachend: ‚Ich bin ein Feierbiest.‘“"
                            },
                            {
                                "example_id": "1893239a-cbef-45da-8748-00b66a37d80c",
                                "sense_id": "336f6b6e-0c6e-3974-b7b9-554398fc88e1",
                                "text": "„Die beiden entschieden sich letztlich für ihn, auch weil ich ihnen erzählte, dass dieser Töpperwien ein kaum zu bremsendes Feierbiest ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
