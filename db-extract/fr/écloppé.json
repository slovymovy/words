                        "examples": [
                            {
                                "example_id": "20f3fcf9-6f73-4767-8132-df7fc3d0dc26",
                                "sense_id": "d4964b54-1888-38cc-baf7-c23aaf0ced46",
                                "text": "« Rentrez dans vos chenils, canailles ! » s’écria le duc qui n’était pas tendre, à la vue de cette troupe écloppée."
                            },
                            {
                                "example_id": "98913fe4-d81d-4aea-8bf9-f5a3c7a91dee",
                                "sense_id": "d4964b54-1888-38cc-baf7-c23aaf0ced46",
                                "text": "Les traits tirés, le teint terreux, ils s’avançaient, les uns boitant affreusement, les autres courbés et vacillants, buttant à chaque pas contre les touffes de bruyère : tous écloppés, lamentables et boueux."
                            }
                        ]
                    }
