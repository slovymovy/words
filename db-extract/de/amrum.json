                "senses": [
                    {
                        "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                        "entry_id": "6487bf76-c170-37bf-bea7-7ff3e517abb9",
                        "glosses": [
                            "eine nordfriesische Insel vor der Westküste Schleswig-Holsteins"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "241e53ac-b84e-4911-9c77-5da0747bf8ed",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "Die Insel Amrum lebt vom Tourismus, der Landwirtschaft und der Fischerei."
                            },
                            {
                                "example_id": "b518fe74-8804-4dee-af86-fc96a969a4ad",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "Auf Amrum werden Verliebten und Hochzeitspaaren bei der Strandkorbvermietung Boyens Spezial-Strandkörbe geboten. Die sind mit Herzchen verziert, von Hand bemalt."
                            },
                            {
                                "example_id": "e54f3c0d-384e-4dfe-9748-b965d2e938ad",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "Unseren letzten Urlaub verbrachten wir auf Amrum."
                            },
                            {
                                "example_id": "6db7054d-db10-4353-b15f-4c45ad4d9e50",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "Amrum liegt in der Nordsee."
                            },
                            {
                                "example_id": "f47b3e30-186d-4ccf-93ab-9e5a80e92260",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "Das Lagerfeuer auf Amrum erlosch erst am frühen Morgen."
                            },
                            {
                                "example_id": "768b2a5e-12ad-40e3-911e-08e0abb46817",
                                "sense_id": "1d97c806-d68e-3d6f-8ccf-d306d7eaf197",
                                "text": "„Rettungskräfte haben fünf Wattwanderer zwischen den Inseln Amrum und Föhr aus akuter Lebensgefahr gerettet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
