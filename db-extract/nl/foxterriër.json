                        "entry_id": "e6ba6094-5d07-3115-b52d-03f2b3da5879",
                        "glosses": [
                            "naam voor twee verschillende hondenrassen: de gladharige foxterriër en de draadharige foxterriër, rassen speciaal gekweekt voor de vossenjacht"
                        ],
                        "tags": [],
