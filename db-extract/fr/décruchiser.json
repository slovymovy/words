                "senses": [
                    {
                        "sense_id": "e8c75230-04be-3964-8aaf-df01523e4e8c",
                        "entry_id": "1411ddf0-76f9-3826-b0dc-a6a01f15191a",
                        "glosses": [
                            "Faire perdre son caractère cruche à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc2fa98-60ff-4296-aca7-9f05eb343c1b",
                                "sense_id": "e8c75230-04be-3964-8aaf-df01523e4e8c",
                                "text": "Pourtant, on avait une Amanda qui se décruchisait ces derniers temps."
                            },
                            {
                                "example_id": "c3d77e16-9a29-4d91-b312-e9cad843ab5f",
                                "sense_id": "e8c75230-04be-3964-8aaf-df01523e4e8c",
                                "text": "Sookie va-t-elle se décruchiser?"
                            },
                            {
                                "example_id": "5c73d782-d761-44e8-b244-c5f5046d2a73",
                                "sense_id": "e8c75230-04be-3964-8aaf-df01523e4e8c",
                                "text": "Bizarrement j'aime de plus en plus la Sook' dans ces derniers épisodes, elle se décruchise gentiment ça fait plaisir et c'est très surprenant."
                            },
                            {
                                "example_id": "152223f3-b925-4c80-8a98-04cbb33c501d",
                                "sense_id": "e8c75230-04be-3964-8aaf-df01523e4e8c",
                                "text": "Je viens de finir la saison 3 et maintenant j'aime bien Sookie, je trouve qu'elle s'est \"décruchisée\""
                            }
                        ]
                    }
