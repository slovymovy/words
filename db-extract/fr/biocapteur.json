                "senses": [
                    {
                        "sense_id": "f5d50a0c-dded-3cd6-b839-1e82371aa81e",
                        "entry_id": "48e71b3a-ccb9-3316-8518-d9f04559b52d",
                        "glosses": [
                            "Dispositif d’analyse chimique qui comprend une molécule ou un complexe moléculaire biologiques reconnaissant un composé minéral ou organique, puis le transformant en une espèce chimique, ainsi qu’un capteur analytique détectant et quantifiant cette espèce.."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae5fdd15-5953-4837-975c-a748050b93fe",
                                "sense_id": "f5d50a0c-dded-3cd6-b839-1e82371aa81e",
                                "text": "En 1950, Leland Clarke créa le premier biocapteur dont le but était de mesurer la concentration en oxygène dissout dans le sang."
                            },
                            {
                                "example_id": "65afd206-1ce2-4720-8b24-09e74f7ed732",
                                "sense_id": "f5d50a0c-dded-3cd6-b839-1e82371aa81e",
                                "text": "Les biocapteurs constituent la seconde application en biochimie analytique du couplage des enzymes à un support."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "274dda45-2bdd-4956-ba29-11df2fe799c7",
                        "source_entry_id": "48e71b3a-ccb9-3316-8518-d9f04559b52d",
                        "source_sense_id": "f5d50a0c-dded-3cd6-b839-1e82371aa81e",
                        "target_lang_word": "biosensor",
