                ],
                "senses": [
                    {
                        "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                        "entry_id": "4d2e16a1-7588-3482-85c5-d05261df45f0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84186f36-23d0-4c65-8375-a37336305bf0",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Frau Eichele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "76cc0a3c-3e08-4508-8191-547b78f2bad2",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Herr Eichele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "24949563-b3bf-4a01-ae9c-d8464decef62",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Die Eicheles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "09db35f3-b4a3-4178-95ee-cb8392d033ce",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Der Eichele trägt nie die Pullover, die die Eichele ihm strickt."
                            },
                            {
                                "example_id": "682bc462-60b4-46c1-b653-7879294b9dfb",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eichele kommt, geht der Herr Eichele.“"
                            },
                            {
                                "example_id": "ca206db8-e0df-4186-9d7c-3a6a40d77430",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Eichele kommt und geht."
                            },
                            {
                                "example_id": "c1870310-153a-4f8b-88c9-e7370f8e48f8",
                                "sense_id": "7325ba41-591d-3bbf-9889-ad6d92e1fb97",
                                "text": "Eicheles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
