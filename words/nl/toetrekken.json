{
    "word_family": [
        "aantrekken",
        "uittrekken",
        "aantrekkingskracht"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "083d533b-2e79-3b70-ae32-d34ce48c7dc4",
                    "sense_definition": "iemand of iets naar zich toe laten komen, lokken of naar zich toe halen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "aantrekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politicus probeert meer kiezers naar zich <w>toe</w> te <w>trekken</w> voor de verkiezingen. Aandacht naar zich <w>toetrekken</w> doet hij erg goed.",
                            "target_lang_translations": {
                                "en": "The politician tries to <w>attract</w> more voters before the elections. He is very good at <w>drawing</w> attention to himself."
                            }
                        },
                        {
                            "text": "Het evenement wist veel bezoekers naar zich <w>toe</w> te <w>trekken</w>.",
                            "target_lang_translations": {
                                "en": "The event managed to <w>attract</w> many visitors."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantrekken",
                        "lokken"
                    ],
                    "antonyms": [
                        "afstoten"
                    ],
                    "common_phrases": [
                        "naar zich toetrekken",
                        "aandacht naar zich toetrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To cause someone or something to come towards oneself, to attract or draw towards oneself"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attract",
                                "target_lang_sense_clarification": "to draw attention, voters, or interest to oneself"
                            },
                            {
                                "target_lang_word": "draw",
                                "target_lang_sense_clarification": "to pull or attract people towards oneself"
                            },
                            {
                                "target_lang_word": "pull in",
                                "target_lang_sense_clarification": "to attract visitors or supporters"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19f69968-e525-38b2-9e93-6ae6cc2ef093",
                    "sense_definition": "iets door te trekken dichterbij halen of sluiten",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysiek_trekken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde de deur stevig naar zich <w>toe</w> <w>trekken</w> om de kou buiten te houden. Het was nodig de deur naar zich <w>toetrekken</w>.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>pull</w> the door firmly towards himself to keep out the cold. It was necessary to <w>pull</w> the door shut."
                            }
                        },
                        {
                            "text": "Zij ging de deken wat verder naar zich <w>toe</w> <w>trekken</w> toen ze het koud kreeg.",
                            "target_lang_translations": {
                                "en": "She started to <w>pull</w> the blanket closer to herself when she got cold."
                            }
                        }
                    ],
                    "synonyms": [
                        "dichttrekken"
                    ],
                    "antonyms": [
                        "duwen"
                    ],
                    "common_phrases": [
                        "naar zich toetrekken"
                    ],
                    "target_lang_definitions": {
                        "en": "To pull something closer to oneself or pull something shut"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pull towards oneself",
                                "target_lang_sense_clarification": "physically pulling an object closer"
                            },
                            {
                                "target_lang_word": "pull shut",
                                "target_lang_sense_clarification": "pulling a door towards oneself to close it"
                            },
                            {
                                "target_lang_word": "pull up",
                                "target_lang_sense_clarification": "drawing a blanket closer to oneself"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}