        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a2aeeb3e-92d2-3296-9fbc-abf87103893d",
                    "sense_definition": "Used to emphasize a statement or to confirm that something is actually true.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emphasis_confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I do <w>indeed</w> remember meeting you at the conference last year.",
                            "target_lang_translations": {
                                "ru": "Я <w>действительно</w> помню, как встретил вас на конференции в прошлом году.",
                                "nl": "Ik herinner me <w>inderdaad</w> dat ik u vorig jaar op de conferentie heb ontmoet.",
                                "pl": "<w>Rzeczywiście</w> pamiętam nasze spotkanie na zeszłorocznej konferencji.",
                                "de": "Ich erinnere mich <w>in der Tat</w> daran, Sie letztes Jahr auf der Konferenz getroffen zu haben.",
                                "fr": "Je me souviens <w>bien</w> de vous avoir rencontré à la conférence l'année dernière.",
                                "it": "Mi ricordo <w>davvero</w> di averti incontrato alla conferenza l'anno scorso.",
                                "cs": "Na naše setkání na loňské konferenci si <w>opravdu</w> vzpomínám.",
                                "tr": "Geçen yılki konferansta sizinle karşılaştığımı <w>gerçekten</w> hatırlıyorum.",
                                "es": "Sí que recuerdo <w>efectivamente</w> haberle conocido en la conferencia el año pasado.",
                                "zh": "我<w>确实</w>记得去年在会议上见过你。"
                            }
                        },
                        {
                            "text": "<w>Indeed</w>, the situation is much more complex than we first thought.",
                            "target_lang_translations": {
                                "ru": "<w>В самом деле</w>, ситуация гораздо сложнее, чем мы думали вначале.",
                                "nl": "<w>Inderdaad</w>, de situatie is veel complexer dan we aanvankelijk dachten.",
                                "pl": "<w>W istocie</w> sytuacja jest znacznie bardziej skomplikowana, niż początkowo sądziliśmy.",
                                "de": "<w>In der Tat</w> ist die Situation viel komplexer, als wir zuerst dachten.",
                                "fr": "<w>En effet</w>, la situation est bien plus complexe que ce que nous pensions au départ.",
                                "it": "<w>In effetti</w>, la situazione è molto più complessa di quanto pensassimo all'inizio.",
                                "cs": "Situace je <w>vskutku</w> mnohem složitější, než jsme si původně mysleli.",
                                "tr": "<w>Hakikaten</w>, durum ilk başta düşündüğümüzden çok daha karmaşık.",
                                "es": "<w>De hecho</w>, la situación es mucho más compleja de lo que pensábamos al principio.",
                                "zh": "<w>的确</w>，情况比我们最初想象的要复杂得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "actually",
                        "truly",
                        "certainly",
                        "really",
                        "in fact",
                        "definitely"
                    ],
                    "common_phrases": [
                        "yes indeed",
                        "indeed it is"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления утверждения или подтверждения того, что что-то действительно верно.",
                        "nl": "Gebruikt om een bewering te benadrukken of om te bevestigen dat iets daadwerkelijk waar is.",
                        "pl": "Używane do podkreślenia wypowiedzi lub potwierdzenia, że coś jest rzeczywiście prawdą.",
                        "de": "Wird verwendet, um eine Aussage zu betonen oder zu bestätigen, dass etwas tatsächlich wahr ist.",
                        "fr": "Utilisé pour insister sur une déclaration ou pour confirmer que quelque chose est bel et bien vrai.",
                        "it": "Usato per enfatizzare un'affermazione o per confermare che qualcosa è effettivamente vero.",
                        "cs": "Používá se ke zdůraznění tvrzení nebo k potvrzení, že je něco skutečně pravda.",
                        "tr": "Bir ifadenin doğruluğunu vurgulamak veya gerçekten doğru olduğunu onaylamak için kullanılır.",
                        "es": "Se utiliza para enfatizar una declaración o para confirmar que algo es realmente cierto.",
                        "zh": "用于强调陈述或确认某事确实属实。"
                    },
