                "senses": [
                    {
                        "sense_id": "d9cb02c4-ca04-3e95-97bf-8cca6ff20ece",
                        "entry_id": "be23c458-fa3d-3702-b83e-5b2ff4bcd5a7",
                        "glosses": [
                            "het cultiveren van land voor het voortbrengen van voedsel en andere nuttige producten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1237e9c0-77ba-4e68-93f0-77fb06ef7d8b",
                                "sense_id": "d9cb02c4-ca04-3e95-97bf-8cca6ff20ece",
                                "text": "Er zijn drie beroepssectoren, namelijk de landbouw, de industrie en de diensten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82396c54-0ae4-4d99-a2c4-0171090f1fb7",
                        "source_entry_id": "be23c458-fa3d-3702-b83e-5b2ff4bcd5a7",
                        "source_sense_id": "d9cb02c4-ca04-3e95-97bf-8cca6ff20ece",
                        "source_sense_description": "het cultiveren van land voor de voortbrengst van voedsel en andere nuttige producten",
                        "target_lang_word": "Landwirtschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Landwirtschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                        "entry_id": "5e819700-dca5-32d5-a45d-796933fb9a14",
                                        "glosses": [
                                            "zielgerichteter, wirtschaftlicher Anbau von Pflanzen (Ackerbau, Gartenbau, Obstbau, Weinbau) und die zielgerichtete, wirtschaftliche Nutzung und Zucht von domestizierten Tieren (Viehzucht)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e1466da-825c-441f-9982-2e07cf591935",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "In der Landwirtschaft muss man harte körperliche Arbeit verrichten können."
                                            },
                                            {
                                                "example_id": "18652682-6a1b-427d-a154-3cde02a5ff5f",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Die Landwirtschaft produziert Gemüse, Obst, Fleisch und Milch für unseren täglichen Bedarf.“"
                                            },
                                            {
                                                "example_id": "b19cd4fd-cc5f-408e-9f38-24e450ffd30c",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Das wenige, was die Landwirtschaft in diesem rauhen Klima hervorbrachte, wurde durch Forstwirtschaft und Tierhaltung, Handel und die Herstellung von Sieben ergänzt.“"
                                            },
                                            {
                                                "example_id": "35d6800d-0565-4405-bb6b-a2bf95ae5604",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Auch Viersen, in Friedenszeiten gut versorgt von der umliegenden Landwirtschaft, musste nun Kartoffeln zukaufen.“"
                                            },
                                            {
                                                "example_id": "d61fa0a8-f9f0-4912-ac6b-0a6b98d50995",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Er formt die Landwirtschaft um, vom Ackerbau für den Eigenbedarf zum Anbau von lukrativen Exportgütern, vor allem Kaffee.“"
                                            },
                                            {
                                                "example_id": "45a91228-c555-497b-94b1-03ff177615ed",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Die Landwirtschaft sollte florieren, und dafür brauchte man Pflanzen.“"
                                            },
                                            {
                                                "example_id": "dca9c5a2-90e0-48e9-a9da-43cf77eb1ecc",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Familie Doherty hat jahrhundertelang von der Landwirtschaft gelebt, aber im rauen Donegal waren die Erträge immer gering.“"
                                            },
                                            {
                                                "example_id": "7fbd08bc-a6b4-41a9-b4f5-bd31e839fe09",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Insolvenzen von kleinen bis mittelständischen Agrarbetrieben haben der Landwirtschaft in Wisconsin in den vergangenen Jahren schwer zugesetzt.“"
                                            },
                                            {
                                                "example_id": "4b68107d-9a92-4bcf-86f6-72a88853e603",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "[Schlagzeile:] „Die Landwirtschaft ist der größte Artenkiller“"
                                            },
                                            {
                                                "example_id": "b9303864-b977-4848-9ed0-b60ae880a4c1",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Lebewesen in Bächen und Flüssen werden Opfer von Giftstoffen aus der Landwirtschaft und das Grundwasser ist oft weit über die Grenzwerte belastet. Muss das sein?“"
                                            },
                                            {
                                                "example_id": "4c8bd7c6-7a15-4c45-b5e7-ae3a65974d1f",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Doch was am meisten besorgt, sind die Auswirkungen der Dürre auf die Landwirtschaft. Ohne Wasser verdorren die Felder, gibt es nichts mehr zu ernten.“"
                                            },
                                            {
                                                "example_id": "1309fa69-8d7f-4ba5-9855-4a90a15959d3",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Hitze, Trockenheit, Wassermangel: Der Klimawandel gefährdet die griechische Landwirtschaft. Für Bauern bedeutet das eine existenzielle Gefahr.“"
                                            },
                                            {
                                                "example_id": "7f207660-24c5-4d9c-8334-1799600722cf",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Als Zeichen der starken Rückkopplungsschleifen ist die Landwirtschaft selbst ein wichtiger Treiber für den Verlust der biologischen Vielfalt: Pestizide, Bodenerosion und Waldrodung zerstören Lebensräume und dezimieren Wildbestände.“"
                                            },
                                            {
                                                "example_id": "e8acf41e-7ade-4e06-9257-01e2fe09064c",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Nach der Annexion stoppte die Ukraine den Wasserfluss, was zu Problemen für die wasserintensive Landwirtschaft auf der Krim führte.“"
                                            },
                                            {
                                                "example_id": "c82ff667-0866-4e34-88cd-3cddb151cb99",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„So ist in den USA die Wahrscheinlichkeit an einer hitzebedingten Krankheit zu sterben bei Männern doppelt so hoch, wie bei Frauen. Denn körperlich schwere Arbeiten, etwa in der Landwirtschaft oder auf dem Bau, werden eher von Männern verrichtet.“"
                                            },
                                            {
                                                "example_id": "1d58e8aa-6d6a-4d93-956e-a1e329a4b251",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Durch Mechanisierung und Technisierung konnte die Landwirtschaft in den 1960 Jahren ihre Erträge enorm steigern.“"
                                            },
                                            {
                                                "example_id": "bb99f307-8951-4175-9ae0-6b79e663388a",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Welche gravierenden Folgen die zunehmende Industrialisierung der Landwirtschaft für Menschen und Umwelt haben kann, schildert der Autor besonders eindrücklich anhand der brasilianischen Cerrados.“"
                                            },
                                            {
                                                "example_id": "b084d175-b67e-4aed-9208-f3cc5259d4d9",
                                                "sense_id": "db0258f5-13f8-3904-92cd-ac7078491acc",
                                                "text": "„Der Aufbau einer regenerativen Landwirtschaft erfordert Zeit und die Bereitschaft, sich neues Wissen anzueignen, welches in der gängigen Ausbildung zum Landwirt nicht gelehrt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "def9eeb8-6eee-3d1a-b7c6-9d4cc44fd5f6",
                                        "entry_id": "5e819700-dca5-32d5-a45d-796933fb9a14",
                                        "glosses": [
                                            "Bauernhof, an dem Landwirtschaft^([1]) betrieben wird"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adfc75f7-f1ab-4ef3-902c-8e39a6114dfa",
                                                "sense_id": "def9eeb8-6eee-3d1a-b7c6-9d4cc44fd5f6",
                                                "text": "Wir hatten keine Landwirtschaft, aber einige meiner Mitschüler hatten eine."
                                            },
                                            {
                                                "example_id": "200b1dc4-28c4-45cb-8326-769688d7dad4",
                                                "sense_id": "def9eeb8-6eee-3d1a-b7c6-9d4cc44fd5f6",
                                                "text": "„Die Familie besitzt eine Landwirtschaft, welche vom Vater geführt wird, während die Mutter sich v.a. um die Erziehung der Kinder kümmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
