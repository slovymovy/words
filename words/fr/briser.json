    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3fe7151b-9e5b-3515-bbd4-80ffba682dd5",
                    "sense_definition": "Rompre, casser ou réduire en morceaux un objet solide.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "destruction_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant maladroit a fait tomber l'assiette et vient de la <w>briser</w> sur le carrelage."
                        },
                        {
                            "text": "Le vent violent a soufflé si fort qu'il a réussi à <w>briser</w> une vitre du salon."
                        }
                    ],
                    "synonyms": [
                        "casser",
                        "rompre"
                    ],
                    "common_phrases": [
                        "briser une vitre",
                        "briser en morceaux"
                    ]
                },
                {
                    "sense_id": "68f0d096-e9e9-33e4-bd32-53b1e963e661",
                    "sense_definition": "Interrompre brusquement quelque chose, mettre fin à un état ou à un élan abstrait.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interruption_abstraite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un cri soudain est venu <w>briser</w> le silence pesant de la nuit."
                        },
                        {
                            "text": "Est-ce vraiment une promesse solide si tu sais déjà que tu vas la <w>briser</w> ?"
                        }
                    ],
                    "synonyms": [
                        "rompre"
                    ],
                    "common_phrases": [
                        "briser le silence",
                        "briser une promesse"
                    ]
                },
                {
                    "sense_id": "57edefe5-4d88-38cf-998b-eeca93153ab2",
                    "sense_definition": "Anéantir moralement une personne, détruire sa volonté ou sa résistance psychologique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detresse_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette terrible épreuve a suffi pour <w>briser</w> le moral de toute la famille."
                        },
                        {
                            "text": "Les injustices répétées ont fini par <w>briser</w> sa volonté de continuer le combat."
                        }
                    ],
                    "common_phrases": [
                        "briser le moral",
                        "briser une personne"
                    ]
                },
                {
                    "sense_id": "465b5e2b-71af-3c18-b284-04e69b2a3018",
                    "sense_definition": "Fatiguer excessivement, courbaturer ou épuiser le corps par un effort ou une secousse rude.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "epuisement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce long trajet sur une route défoncée a fini par lui <w>briser</w> le dos."
                        },
                        {
                            "text": "Porter ces cartons lourds pendant des heures finit par <w>briser</w> les épaules des déménageurs."
                        }
                    ],
                    "common_phrases": [
                        "briser de fatigue",
                        "briser les membres"
                    ]
                },
                {
                    "sense_id": "c9894302-300e-30bc-93f8-1a9a34635c85",
                    "sense_definition": "En parlant des flots ou des vagues, se heurter violemment contre un obstacle en écumant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mer_vagues",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la tempête hivernale, les vagues furieuses venaient se <w>briser</w> contre la falaise."
                        },
                        {
                            "text": "Le marin observait les lames puissantes qui allaient se <w>briser</w> sur la digue du port."
                        }
                    ],
                    "common_phrases": [
                        "se briser sur les rochers",
                        "briser contre la falaise"
                    ]
                },
                {
                    "sense_id": "fb4816d5-edd3-317b-b73b-e311d6342e97",
                    "sense_definition": "S'arrêter, mettre fin à un discours ou à une discussion qui devient inopportune ou pénible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interruption_discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette querelle devient pénible pour tout le monde, alors <w>brisons</w> là immédiatement."
                        },
                        {
                            "text": "L'homme préféra <w>briser</w> là avant que le désaccord ne tourne à la dispute."
                        }
                    ],
                    "common_phrases": [
                        "brisons là",
                        "brisons là-dessus"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Principalement employé dans la locution « brisons là »"
                        }
                    ]
                }
            ]
        }
    ]
