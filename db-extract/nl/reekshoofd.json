                                    {
                                        "sense_id": "d3a96bac-2575-3863-95a5-773ce0cb89fd",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "Any propagative portion of a plant which may be sown, such as true seeds, seed-like fruits, tubers, or bulbs."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081aed8b-13e4-4327-a022-b7144c34f859",
                                                "sense_id": "d3a96bac-2575-3863-95a5-773ce0cb89fd",
                                                "text": "[…] for hungry birds have devoured ſeeds, and having moiſtened and warmed them in their bellies, a little after have dunged in the forky twiſtes of Trees, and together with their dung excluded the ſeed whole which erſt they had ſwallowed: and ſometimes it brings forth there where they dung it, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52be4266-bb34-335e-ad4e-23651096587f",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "Any propagative portion of a plant which may be sown, such as true seeds, seed-like fruits, tubers, or bulbs.",
                                            "A fertilized and ripened ovule, containing an embryonic plant."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d13f7f28-ebe5-3ae2-ab30-670de533b19f",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "Any propagative portion of a plant which may be sown, such as true seeds, seed-like fruits, tubers, or bulbs.",
                                            "Any small seed-like fruit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda693e2-3191-44ef-a051-bca44e9e0b66",
                                                "sense_id": "d13f7f28-ebe5-3ae2-ab30-670de533b19f",
                                                "text": "If you plant a seed in the spring, you may have a pleasant surprise in the autumn."
                                            },
                                            {
                                                "example_id": "886b5c8d-c8d9-4f66-8142-ce903695e472",
                                                "sense_id": "d13f7f28-ebe5-3ae2-ab30-670de533b19f",
                                                "text": "The exiguity and ſmallneſſe of ſome ſeeds extending to large productions is one of the magnalities of nature, ſomewhat illuſtrating the work of the Creation, and vaſt production from nothing."
                                            },
                                            {
                                                "example_id": "1ed62324-ead6-437e-b123-8f1adc6cb71f",
                                                "sense_id": "d13f7f28-ebe5-3ae2-ab30-670de533b19f",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, […]. In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4202c75d-9f81-3304-b8b2-0b33fdafd7ba",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "An amount of seeds that cannot be readily counted."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9834e5d1-c37f-4aef-94da-5ae222b420a9",
                                                "sense_id": "4202c75d-9f81-3304-b8b2-0b33fdafd7ba",
                                                "text": "The entire field was covered with geese eating the freshly sown seed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbf5d2ff-0414-389a-99c2-c24a96bf4e4c",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "A fragment of coral."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31ab44fb-01b9-3a37-a9a4-f3db8301d097",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "Semen."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c97e139-3381-4789-a44b-8c1aa41634d3",
                                                "sense_id": "31ab44fb-01b9-3a37-a9a4-f3db8301d097",
                                                "text": "A man must use his seed to start and raise a family."
                                            },
                                            {
                                                "example_id": "47182fa7-2740-46f7-b407-d55f79b719c5",
                                                "sense_id": "31ab44fb-01b9-3a37-a9a4-f3db8301d097",
                                                "text": "And if any mans seede of copulation goe out from him, then hee shall wash all his flesh in water, and bee vncleane vntill the Euen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d9a733-9aa6-357d-97de-c9848e92f8cf",
                                        "entry_id": "59e0d7b5-52a4-3085-aa11-5f1bcd635056",
                                        "glosses": [
                                            "A precursor."
