                                "sense_id": "7719057c-15fc-3eb4-a73e-e316f8313c80",
                                "text": "Infolge seiner schweren Erkrankung verstarb mein Nachbar letzten Montag."
                            },
                            {
                                "example_id": "0e1857fd-8516-42be-8a26-94ceb95f2ac9",
                                "sense_id": "7719057c-15fc-3eb4-a73e-e316f8313c80",
                                "text": "Der Permafrost in den Alpen taut infolge der Klimaerwärmung nach und nach auf."
                            },
                            {
                                "example_id": "4a903e5e-18cc-4f72-8020-7608ec260b75",
                                "sense_id": "7719057c-15fc-3eb4-a73e-e316f8313c80",
                                "text": "„Die Obergeschosse gingen infolge Brandes verloren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1750f9d-41e7-4e05-acb1-f12d3a7852e5",
                        "source_entry_id": "73a6dbc5-8905-3f80-b2bd-611cff9bdc04",
                        "source_sense_id": "7719057c-15fc-3eb4-a73e-e316f8313c80",
                        "source_sense_description": "Präposition mit Genitiv: als Folge (Konsequenz) eines oder mehrerer vorangegangener Ereignisse",
                        "target_lang_word": "due to",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "due to",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                        "entry_id": "93bf9f3d-db79-3e8d-9c45-dbafccc25524",
                                        "glosses": [
                                            "Caused by; resulting from; because of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1476a9f2-fc85-4bb6-a6d9-d0c5490b0977",
                                                "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                                "text": "Rising unemployment due to the economic downturn is spreading."
                                            },
                                            {
                                                "example_id": "372b76dd-3f7d-4c75-b43c-10761b2020f8",
                                                "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                                "text": "The carrier will be held financially responsible for any damage due to reckless handling."
                                            },
                                            {
                                                "example_id": "c73af14e-21cb-4db7-899e-7ec09844d24d",
                                                "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                                "text": "Due to the rising cost of ingredients, the company decided to change the recipe. [disjunctive use, sometimes proscribed]"
                                            },
                                            {
                                                "example_id": "d1f36e48-6011-4ac1-b8a2-646543cd8b7e",
                                                "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                                "text": "The accident was due to the breaking of one of the blades of the propeller on the left side."
                                            },
                                            {
                                                "example_id": "f0d0f181-d25c-4467-9d1b-10b4209f81fc",
                                                "sense_id": "66efb0c9-6d45-30d0-86de-41fe4f62c0c6",
                                                "text": "Where else in the world can you pre-order sushi and fondue on some of the trains, travel in family carriages equipped with mini-playgrounds, or use a request stop button at some small stations? Where else can you hear the announcement: \"The train at Platform 4 is ten minutes late due to an incident in another country,\" as I did once at the Swiss station of Spiez?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5866e2aa-4c50-39f1-ba20-d156f60a2561",
                                        "entry_id": "93bf9f3d-db79-3e8d-9c45-dbafccc25524",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see due, to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "084b3692-8adf-4594-a089-2297adc278a6",
                                                "sense_id": "5866e2aa-4c50-39f1-ba20-d156f60a2561",
                                                "text": "The steamship was due to arrive in the Port of New York tomorrow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62a6a2ec-5425-3617-9817-f304c0cc1f0f",
                                        "entry_id": "93bf9f3d-db79-3e8d-9c45-dbafccc25524",
                                        "glosses": [
                                            "(of a proof) from, written by"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e183cfd-ef4f-47a3-b2dd-2232224d3d5a",
                                                "sense_id": "62a6a2ec-5425-3617-9817-f304c0cc1f0f",
                                                "text": "The proof we provide is a nice indirect proof due to Euclid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
