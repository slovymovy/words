                        "cross_references": [
                            {
                                "target_word": "buddy-buddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a923ed-9a18-3140-b396-d1f677e0d44a",
                                        "entry_id": "f61331cd-f079-3d28-8d0d-8b8cc6b266ab",
                                        "glosses": [
                                            "Very friendly or expressing close familiarity with someone."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3753be94-3898-4032-997e-8cdfba913ed4",
                                                "sense_id": "d7a923ed-9a18-3140-b396-d1f677e0d44a",
                                                "text": "They're over there being all buddy-buddy with one another."
                                            },
                                            {
                                                "example_id": "13990447-d6bf-4a69-b00d-121620708f0a",
                                                "sense_id": "d7a923ed-9a18-3140-b396-d1f677e0d44a",
                                                "text": "I can personally imagine a scenario where, within a year, President Trump is on buddy-buddy terms again with Mexico. But you cannot unsee what happened over the last 48 hours."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "buddy-buddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd86eb1-3f2f-3951-9a25-be9c71d75679",
                                        "entry_id": "c33d5a45-7952-369e-bd4a-4b72c84580d0",
                                        "glosses": [
                                            "A close male friend."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
