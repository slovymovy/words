                "senses": [
                    {
                        "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                        "entry_id": "96d3f30b-09a0-300d-b6a4-95e2f518da6d",
                        "glosses": [
                            "bundeseinheitlich umgelegter Betrag (€/kWh/h/a) der von jedem Gasverbraucher zu zahlen ist; Kostenausgleich bei Netzbetreibern mit Biogas-Netzzugang"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "c5414a17-b576-4840-aee4-fd2fe2ae1add",
                                "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                                "text": "„Die Höhe der Biogasumlage ergibt sich, indem man die in einem Marktgebiet durch den Netzanschluss von Biogasanlagen entstandenen Wälzungskosten durch die Summe der voraussichtlich gebuchten bzw. bestellten jährlichen Ausspeisekapazität der marktgebietsaufspannenden Netzbetreiber teilt.“"
                            },
                            {
                                "example_id": "df71a7b6-076d-448b-8251-2e2bebedd82c",
                                "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                                "text": "„Gemäß der Novelle des § 20 b GasNEV wird mit Wirkung zum 01.01.2014 eine bundesweit einheitliche Biogasumlage eingeführt.“"
                            },
                            {
                                "example_id": "170d119a-9bff-4120-8d07-3ed84a6ed601",
                                "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                                "text": "„Durch die Neuregelung zur Biogasumlage werden einzelne Verbraucher belastet und andere entlastet.“"
                            },
                            {
                                "example_id": "096d7bce-d1e8-4092-81eb-02bf744a3bc6",
                                "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                                "text": "„Der Netzbetreiber kann die zusätzlichen Kosten über die Biogasumlage auf die Ausspeiseentgelte umlegen.“"
                            },
                            {
                                "example_id": "f38545e4-22e3-4fb5-a18e-4a7b4d6f1779",
                                "sense_id": "f90b3a99-524e-367f-adcd-cc305ed042e9",
                                "text": "„Bisher wurde die Biogasumlage in den beiden Marktgebieten getrennt erhoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
