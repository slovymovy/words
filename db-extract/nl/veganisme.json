                        "entry_id": "7d6cab6c-6db0-3a41-8094-6ca56ff7089a",
                        "glosses": [
                            "een levenswijze, die ernaar streeft voor zover mogelijk en uitvoerbaar alle vormen van exploitatie en wreedheid ten opzichte van dieren in verband met voeding, kleding, of enig ander doel, uit te sluiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecc65582-d130-40d9-a3d3-c187a2d71c1e",
                                "sense_id": "1d557a99-fe3a-3d7e-be90-9c8af4fdf112",
                                "text": "Niet iedere dierenliefhebber is een aanhanger van het veganisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2da7d029-e440-4145-82d1-3f6556ce5a59",
