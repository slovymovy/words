        "ru-extract.jsonl": [
            {
                "entry_id": "15e9094d-2b4b-3d53-a4c8-dceee68c860d",
                "word": "всерьёз",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4472a9b9-a8a7-3602-9863-cee86b53313c",
                        "entry_id": "15e9094d-2b4b-3d53-a4c8-dceee68c860d",
                        "glosses": [
                            "разг. серьёзно, не в шутку, не на шутку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494f2315-b35b-43d6-8ed2-cf653deb4e72",
                                "sense_id": "4472a9b9-a8a7-3602-9863-cee86b53313c",
                                "text": "Не принимай всерьёз его болтовню."
                            },
                            {
                                "example_id": "00eee486-1671-47a1-b06c-210916acc16a",
                                "sense_id": "4472a9b9-a8a7-3602-9863-cee86b53313c",
                                "text": "Всерьёз и надолго."
                            }
                        ]
                    },
                    {
                        "sense_id": "30c0c893-3d41-3e40-a1a2-c9a218a8576c",
                        "entry_id": "15e9094d-2b4b-3d53-a4c8-dceee68c860d",
                        "glosses": [
                            "разг. основательно, деловито"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28c85a8-9f52-483b-a6f1-700a116a3502",
                                "sense_id": "30c0c893-3d41-3e40-a1a2-c9a218a8576c",
                                "text": "Довольно гулять, пора всерьёз приняться за ученье."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7aaabb65-6727-4cca-a6c9-41a4ffee5fbf",
                        "source_entry_id": "15e9094d-2b4b-3d53-a4c8-dceee68c860d",
                        "target_lang_word": "seriously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seriously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "In a serious or literal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57392417-fc4f-42b9-b74d-651df7b4548c",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "He was hoping that we would take him seriously."
                                            },
                                            {
                                                "example_id": "1afed226-52ca-464b-a398-207d2ed59f33",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Jimmy jokingly called Bob a doofus. Bob took the insult seriously."
                                            },
                                            {
                                                "example_id": "1c457da0-e05a-46ce-a71f-a5088e8e7603",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "“I’ll qualify the statement, then,” she answered, with a laugh. “We have known each other for two ages—hers and mine. But seriously we are as dear to each other as sisters, and now that I am going to lose her I am almost heartbroken.”"
                                            },
                                            {
                                                "example_id": "34c956c3-5d8e-4465-8296-05892b09634c",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Masters and Johnson wanted their work to be taken seriously, and wanted to stay a step ahead of the morality police, so they tended to write in almost comically dense medicalese."
                                            },
                                            {
                                                "example_id": "2385b71f-eefe-45b7-8e12-d5e7789b0f85",
                                                "sense_id": "deae5271-cb9a-30bd-beb9-a77903a51279",
                                                "text": "Jeremy, meanwhile, was the fun-lover, like me, who didn't always take it too seriously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc7795f-2ac5-3971-8615-1eec4f26aa43",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Gravely; deeply; very much."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af27169b-3e5f-4ce9-937b-ac31ed10aa7e",
                                                "sense_id": "cfc7795f-2ac5-3971-8615-1eec4f26aa43",
                                                "text": "That was a seriously unpleasant thing to say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1a2961-8e78-32b5-bb7d-24f545967377",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Used to attempt to introduce a serious point in a less serious conversation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "685ba981-657c-48fc-9d8d-cd233a162b9b",
                                                "sense_id": "eb1a2961-8e78-32b5-bb7d-24f545967377",
                                                "text": "Now, seriously, why did you forget to feed the cat today?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d3ef40f-a21c-33b1-b0f3-f111ae9f9124",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "Used to call back to a previous point, in disbelief or for emphasis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "375f3e47-2794-44e7-a0aa-5e110d1631bc",
                                                "sense_id": "7d3ef40f-a21c-33b1-b0f3-f111ae9f9124",
                                                "text": "You baked ten (10) cakes. Seriously, why did you do that?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfc03800-9f78-3c7b-bc37-9bb323f820b5",
                                        "entry_id": "9da9ac80-5e43-3f79-9b7f-7c43e9dea7c8",
                                        "glosses": [
                                            "In an extreme or major way; majorly."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a7953eb-d255-40b7-a3a6-017e0acfc8e3",
                                                "sense_id": "cfc03800-9f78-3c7b-bc37-9bb323f820b5",
                                                "text": "Unless you're seriously strapped (armed), you're about to be not okay too."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daf50b55-a4e1-4bab-96b6-7d5c89120547",
                        "source_entry_id": "15e9094d-2b4b-3d53-a4c8-dceee68c860d",
                        "target_lang_word": "in earnest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in earnest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71337578-a548-360a-9e38-763a348658dc",
                                        "entry_id": "d0747bec-da38-3002-b574-4c1dba627b3d",
                                        "glosses": [
                                            "Sincere; determined; truthful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d12b1523-cdff-469d-bdfc-1d324279e4de",
                                                "sense_id": "71337578-a548-360a-9e38-763a348658dc",
                                                "text": "\"I wasn't in earnest. I only brought it in joke.\""
                                            },
                                            {
                                                "example_id": "fc94ff54-1ad3-4dda-97de-64a4806bd4e1",
                                                "sense_id": "71337578-a548-360a-9e38-763a348658dc",
                                                "text": "She replied, \"When did I ever tell you a lie ? I am in earnest.\""
                                            },
                                            {
                                                "example_id": "ec3671e5-38fa-4946-a009-a1b953153e5b",
                                                "sense_id": "71337578-a548-360a-9e38-763a348658dc",
                                                "text": "Samuel was stern, serious and deeply in earnest. He seldom smiled and never laughed. He was uncompromisingly religious, conscientious and morally unbending."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "in earnest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                        "entry_id": "0f82fb3e-8eed-371a-a438-8dd53a091a55",
                                        "glosses": [
                                            "With considerable commitment, determination, or effect; significantly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf35b832-0868-49ef-bfc8-097b3d10757a",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "It's snowing in earnest right now."
                                            },
                                            {
                                                "example_id": "71f397ee-a68b-4fb0-aecc-f84fba7b7851",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "The gentlemen wear swords, and may easily have pistols in their pockets—most likely have, indeed. If they fire at each other without effect, then they’ll draw, and go to work in earnest."
                                            },
                                            {
                                                "example_id": "e9b28244-11b0-4508-846c-d696ec28bb0d",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "But I see that if I were to live in a wilderness I should again be tempted to become a fisher and hunter in earnest."
                                            },
                                            {
                                                "example_id": "93af502a-64ae-4e45-967e-8312cace7218",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "He spoke in earnest of the importance of achieving academic excellence as well as winning football games."
                                            },
                                            {
                                                "example_id": "289fab7d-42d7-400f-90a0-73342087cd9a",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "The Northern Alliance attacked in earnest on Friday night, and the Afghan Taliban soldiers immediately switched sides, while their commanders jumped into pickup trucks and sped south."
                                            },
                                            {
                                                "example_id": "088e2a20-a227-489b-bdb8-51cc732127df",
                                                "sense_id": "e8ec8cfc-f9f8-34ab-b759-8c03b8e6bdb3",
                                                "text": "The dawn of the oil age was fairly recent. Although the stuff was used to waterproof boats in the Middle East 6,000 years ago, extracting it in earnest began only in 1859 after an oil strike in Pennsylvania. The first barrels of crude fetched $18 (around $450 at today’s prices)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eda9dbb-f06f-3e3f-9ad2-8e5591412bf1",
                                        "entry_id": "0f82fb3e-8eed-371a-a438-8dd53a091a55",
                                        "glosses": [
                                            "Having a sincere intent. (of a person)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabcf73b-68c3-4161-b14f-68494567b55b",
                                                "sense_id": "7eda9dbb-f06f-3e3f-9ad2-8e5591412bf1",
                                                "text": "He was talking in earnest, even though his speech carried an ironic tone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
