                                        "sense_id": "795bde1e-d29c-3057-8429-4144a96cc3c4",
                                        "entry_id": "235b61ee-788c-3f89-a033-c6ab29d9a45c",
                                        "glosses": [
                                            "A cocktail consisting of gin, Campari and vermouth, usually in equal parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0af99ea-4aa3-44cf-a614-fb011c270c46",
                                                "sense_id": "795bde1e-d29c-3057-8429-4144a96cc3c4",
                                                "text": "The main item on the agenda was alcohol, not food. [Gavin] Ewart began with several negronis (gin, vermouth, Campari), which is not an amateur’s drink, and carried on from there."
                                            },
                                            {
                                                "example_id": "e9eac575-a63c-41ec-b526-fbd7c15a0b8b",
                                                "sense_id": "795bde1e-d29c-3057-8429-4144a96cc3c4",
                                                "text": "A curly-haired 20-something sat down across the bar from us, opened a book, and ordered a bowl of olives and a negroni."
                                            }
                                        ]
                                    }
                                ]
                            }
