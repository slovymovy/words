                        "form": "aanzienlijks"
                    },
                    {
                        "form_id": "9d95f533-1719-46a8-a08e-432aac9c9630",
                        "entry_id": "c18ea284-7822-3fb4-8bf0-21ff5e3948d6",
                        "tags": [
                            "partitive",
                            "comparative"
                        ],
                        "form": "aanzienlijkers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                        "entry_id": "c18ea284-7822-3fb4-8bf0-21ff5e3948d6",
                        "glosses": [
                            "voornaam, groot, belangrijk, erg, niet te verwaarlozen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65eb594-872f-4dbb-a36a-6156740b6f04",
                                "sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                                "text": "Ze was een telg uit een van de aanzienlijkste families van Venetië."
                            },
                            {
                                "example_id": "57172519-40cb-40d9-b340-87ab0ce1b0d8",
                                "sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                                "text": "Met de handel in verdovende middelen zijn aanzienlijke bedragen gemoeid."
                            },
                            {
                                "example_id": "e98c49f7-f2d1-4a0e-bc35-8d25bc15e033",
                                "sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                                "text": "Ook zij was in het bezit van een aanzienlijke hoeveelheid gouden sieraden, zag Jeroen."
                            },
                            {
                                "example_id": "d4f5c4ab-44b1-4240-a5dc-b5a6d8bdc14d",
                                "sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                                "text": "Zijn broer Oscar had op miraculeuze wijze, zo het al geen goddelijke voorzienigheid was, een aanzienlijk vermogen in Afrika verworven."
                            }
                        ]
                    },
                    {
                        "sense_id": "7b20ab9a-87d6-338a-9af0-4d59b01313d8",
                        "entry_id": "c18ea284-7822-3fb4-8bf0-21ff5e3948d6",
                        "glosses": [
                            "in hoge mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69603089-9395-4d25-a3f2-3ae99292ef75",
                                "sense_id": "7b20ab9a-87d6-338a-9af0-4d59b01313d8",
                                "text": "Terwijl Rusland voor het eerst \"aanzienlijke verliezen\" in Oekraïne erkent, komen steeds meer details over gruwelijke daden van Russische militairen naar buiten."
                            },
                            {
                                "example_id": "8560ad33-65cd-4bbf-b4da-1de61fa0d460",
                                "sense_id": "7b20ab9a-87d6-338a-9af0-4d59b01313d8",
                                "text": "Wiebelend op een stoel waarvan één poot aanzienlijk korter is dan de andere, vraagt ze de man achter de bar of hij weet waar de rue du Pacha is, maar ze wordt niet wijzer van zijn instructies en loopt weer terug naar de moskee waar een paar Franse vrouwen giechelend voor de ingang doeken om hun blote benen wikkelen."
                            },
                            {
                                "example_id": "8aa4fba5-2da6-43c3-86f4-9a0dc6af0821",
                                "sense_id": "7b20ab9a-87d6-338a-9af0-4d59b01313d8",
                                "text": "De perrons zijn verlaten, in de hal zitten de reizigers op gepaste afstand van elkaar op de wachtbanken, die anders vol zijn. Deze hele week is het al rustiger dan normaal, maar deze vrijdag is het echt opvallend stil, zegt een NS-medewerker. Toch nemen ook nog aanzienlijk wat mensen wél de trein."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fb52345-dcf5-4277-939a-8211ab236d71",
                        "source_entry_id": "c18ea284-7822-3fb4-8bf0-21ff5e3948d6",
                        "source_sense_id": "fcee7663-0fe0-30db-a22b-ab58ad72c90c",
                        "source_sense_description": "voornáám, groot",
                        "target_lang_word": "considerable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "considerable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa80b9eb-552c-3b1a-8d37-4c41d4bcb4f1",
                                        "entry_id": "35cd78f7-aed9-36fa-bb54-e01c87a68100",
                                        "glosses": [
                                            "Significant; worth considering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e09f7c-747b-42a3-8068-8ac50608e449",
                                                "sense_id": "fa80b9eb-552c-3b1a-8d37-4c41d4bcb4f1",
                                                "text": "Soon I became a considerable figure in the music industry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                        "entry_id": "35cd78f7-aed9-36fa-bb54-e01c87a68100",
                                        "glosses": [
                                            "Large in amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c3c949-950d-4cc6-8ff8-0dec530b70b4",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            },
                                            {
                                                "example_id": "c9cc18a9-776e-4008-ac62-caf7b4902177",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "With the cutting out of the previous recovery times for electrification work, curtailment of station times and acceleration, considerable reductions have been made in the overall schedules."
                                            },
                                            {
                                                "example_id": "99ed914a-aca6-4904-8be9-1b96e37feadd",
                                                "sense_id": "adf6063c-e55e-3034-a4bd-932b7c8700e3",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "considerable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd4a28c-6c6f-3377-b70d-30884c477fb7",
                                        "entry_id": "dd47e0da-1962-321f-90a3-1425eb8b337c",
                                        "glosses": [
                                            "A thing to be considered, consideration."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "644474ef-b215-4d5c-bd43-83634d59a3a2",
                                                "sense_id": "8bd4a28c-6c6f-3377-b70d-30884c477fb7",
                                                "text": "Statistes and Politicians, unto whom Ragione di Stato, is the first considerable, as though it were their businesse to deceive people, as a Maxime, do hold, that truth is to be concealed from them […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
