                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f067281f-4d31-4b2f-ab6b-27b55f3db837",
                        "entry_id": "58980f3e-e602-35a9-8070-4bca5962fac1",
                        "tags": [
