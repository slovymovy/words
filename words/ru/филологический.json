    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d5f17ef2-2688-335d-a3f4-766d7f623b3d",
                    "sense_definition": "Связанный с филологией, изучением языка и литературы, или свойственный ей.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "филология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Студенты готовят подробный <w>филологический</w> анализ древнего текста для семинара.",
                            "target_lang_translations": {
                                "en": "The students are preparing a detailed <w>philological</w> analysis of the ancient text for the seminar."
                            }
                        },
                        {
                            "text": "Моя старшая сестра успешно окончила <w>филологический</w> факультет государственного университета.",
                            "target_lang_translations": {
                                "en": "My older sister successfully graduated from the <w>philology</w> faculty of the state university."
                            }
                        }
                    ],
                    "antonyms": [
                        "нефилологический"
                    ],
                    "common_phrases": [
                        "филологический факультет",
                        "филологический анализ",
                        "филологические науки"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to or characteristic of philology, the study of language and literature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "philological",
                                "target_lang_sense_clarification": "relating to philology"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92ee74ae-a0c8-3231-ab26-f06f68ea0b69",
                    "sense_definition": "В значении существительного: филологический факультет.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "филология",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После окончания школы она решила поступать на <w>филологический</w>.",
                            "target_lang_translations": {
                                "en": "After graduating from high school, she decided to apply to the <w>philology department</w>."
                            }
                        },
                        {
                            "text": "На третьем курсе на <w>филологическом</w> изучают историю зарубежной литературы.",
                            "target_lang_translations": {
                                "en": "In the third year at the <w>philology faculty</w>, they study the history of foreign literature."
