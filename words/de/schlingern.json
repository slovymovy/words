                {
                    "sense_id": "a6d1241a-e20f-3e64-9584-8ab72e55f3da",
                    "sense_definition": "unkontrolliert nach links und rechts von der Fahrtrichtung abweichen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der nassen Fahrbahn begann der voll beladene Lastwagen plötzlich zu <w>schlingern</w>."
                        },
                        {
                            "text": "Das Auto geriet außer Kontrolle und <w>schlingerte</w> direkt auf die Leitplanke zu."
                        }
                    ],
                    "synonyms": [
                        "schleudern",
                        "ausbrechen"
                    ],
                    "common_phrases": [
