                                                "example_id": "8d851eeb-de42-4db9-b50c-0dd5f0870003",
                                                "sense_id": "da76c4fd-7427-3a62-8bd8-d19ed1726e8e",
                                                "text": "(Follow me, don't follow me.) I've got my spine, I've got my orange crush.\n(Collar me, don't collar me.) I've got my spine, I've got my orange crush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd58617b-4c33-3390-80da-ee90cfcbe133",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To surround or encircle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11f46f2d-ee74-3e73-b920-bba7cf7d02a6",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To seize, capture or detain."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b735b4c6-04a7-3890-9d9f-8a6c4d7bb74d",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "836d36ff-f73c-4dfb-94d7-ffeb63d8326a",
                                                "sense_id": "b735b4c6-04a7-3890-9d9f-8a6c4d7bb74d",
                                                "text": "\"Ho, aboard the Salt Junk Sarah,\nRollin\" home across the line,\nThe Bo'sun collared the Captain's hat\nAnd threw it in the brine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95cd09f1-733e-36de-a457-61079037ecdc",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To preempt, control stringently and exclusively."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c0a3f1ca-58a2-3a38-b768-7ecd91409834",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To arrest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d95b35-3977-47f4-bb82-df2909e68cb0",
                                                "sense_id": "c0a3f1ca-58a2-3a38-b768-7ecd91409834",
                                                "text": "Britain’s police are especially zealous. Officers spend thousands of hours sifting through potentially offensive posts and arrest 30 people a day. Among those collared were a man who ranted about immigration on Facebook and a couple who criticised their daughter’s primary school."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49e49d0e-2d5a-33ad-8e22-088d31579f1a",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To bind in conversation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7665756-5a66-4d80-bb76-5bfe18cf6331",
                                                "sense_id": "49e49d0e-2d5a-33ad-8e22-088d31579f1a",
                                                "text": "I managed to collar Fred in the office for an hour."
                                            },
                                            {
                                                "example_id": "02399c4a-17f0-4607-904a-5057e2aec135",
                                                "sense_id": "49e49d0e-2d5a-33ad-8e22-088d31579f1a",
                                                "text": "They go in and lobby, collar the representatives and ask: are you for or against?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3988e7c-cf0c-3a2c-9046-165b8dbc9822",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To roll up (beef or other meat) and bind it with string preparatory to cooking."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26c7c907-d8c7-3fa2-b9bd-fa77cd58fb9e",
                                        "entry_id": "1a1507b9-9eda-368f-983d-237b7925cfc4",
                                        "glosses": [
                                            "To bind (a submissive) to a dominant under specific conditions or obligations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
