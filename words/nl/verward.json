            "senses": [
                {
                    "sense_id": "ab294214-1a51-3eae-b1c6-28c7d1d5abc8",
                    "sense_definition": "Geestelijk niet helder of in de war; niet goed wetend wat men moet doen of denken.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>verwarde</w> man wist niet meer waar hij woonde.",
                            "target_lang_translations": {
                                "en": "The <w>confused</w> man no longer knew where he lived.",
                                "ru": "<w>Растерянный</w> мужчина больше не знал, где он живёт.",
                                "fr": "L'homme <w>confus</w> ne savait plus où il habitait."
                            }
                        },
                        {
                            "text": "Ze keek me <w>verward</w> aan toen ik haar een vraag in het Frans stelde.",
                            "target_lang_translations": {
                                "en": "She looked at me <w>confused</w> when I asked her a question in French.",
                                "ru": "Она посмотрела на меня <w>растерянно</w>, когда я задал ей вопрос по-французски.",
                                "fr": "Elle m'a regardé d'un air <w>confus</w> quand je lui ai posé une question en français."
                            }
                        }
                    ],
                    "synonyms": [
                        "in de war"
                    ],
                    "antonyms": [
                        "helder",
                        "nuchter"
                    ],
                    "common_phrases": [
                        "verwarde indruk",
                        "verward overkomen",
                        "verwarde man"
                    ],
                    "target_lang_definitions": {
                        "en": "Mentally not clear or confused; uncertain about what to do or think.",
                        "ru": "Находящийся в замешательстве или сбитый с толку; не знающий точно, что делать или думать.",
                        "fr": "État mental de confusion ou de désorientation ; ne pas savoir clairement quoi faire ou penser."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "confused",
                                "target_lang_sense_clarification": "unable to think clearly"
                            },
                            {
                                "target_lang_word": "disoriented",
                                "target_lang_sense_clarification": "having lost one's sense of direction or position"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "растерянный",
                                "target_lang_sense_clarification": "неспособный ясно мыслить"
                            },
                            {
                                "target_lang_word": "сбитый с толку",
                                "target_lang_sense_clarification": "приведенный в замешательство"
                            },
                            {
                                "target_lang_word": "дезориентированный",
                                "target_lang_sense_clarification": "потерявший представление о месте или времени"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "confus",
                                "target_lang_sense_clarification": "incapable de penser clairement"
                            },
                            {
                                "target_lang_word": "désorienté",
                                "target_lang_sense_clarification": "ayant perdu ses repères"
                            },
                            {
                                "target_lang_word": "troublé",
                                "target_lang_sense_clarification": "dans un état de trouble émotionnel ou mental"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "338ae2c8-9baf-3eb2-9a40-47bfc4b0cfcc",
                    "sense_definition": "Door elkaar geraakt of zonder duidelijke structuur; niet netjes geordend.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de storm lagen de kabels <w>verward</w> op de grond.",
                            "target_lang_translations": {
                                "en": "After the storm, the cables lay <w>tangled</w> on the ground.",
                                "ru": "После шторма кабели лежали на земле <w>спутанными</w>.",
                                "fr": "Après la tempête, les câbles gisaient <w>emmêlés</w> sur le sol."
                            }
                        },
                        {
                            "text": "Hij vertelde een <w>verward</w> verhaal waar niemand iets van begreep.",
                            "target_lang_translations": {
                                "en": "He told a <w>confused</w> story that no one understood.",
                                "ru": "Он рассказал <w>сбивчивую</w> историю, которую никто не понял.",
                                "fr": "Il a raconté une histoire <w>incohérente</w> que personne n'a comprise."
                            }
                        }
                    ],
                    "synonyms": [
