        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "138864a5-fbf4-3c8f-8fc4-c62937d86a26",
                    "sense_definition": "Personne qui restreint excessivement ses dépenses et cherche à accumuler les richesses.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet <w>avare</w> préfère vivre dans l'inconfort plutôt que de dépenser un seul centime.",
                            "target_lang_translations": {
                                "en": "This <w>miser</w> would rather live in discomfort than spend a single cent.",
                                "ru": "Этот <w>скупец</w> предпочитает жить в неудобствах, лишь бы не потратить ни копейки.",
                                "de": "Dieser <w>Geizhals</w> lebt lieber unbequem, als auch nur einen einzigen Cent auszugeben.",
                                "es": "Este <w>avaro</w> prefiere vivir en la incomodidad antes que gastar un solo céntimo.",
                                "zh": "这个<w>守财奴</w>宁可过得不舒服，也不肯花一分钱。"
                            }
                        },
                        {
                            "text": "Dans sa comédie célèbre, Molière met en scène un vieil <w>avare</w> ridicule et tyrannique.",
                            "target_lang_translations": {
                                "en": "In his famous comedy, Molière presents a ridiculous, tyrannical old <w>miser</w>.",
                                "ru": "В своей знаменитой комедии Мольер выводит на сцену нелепого и деспотичного старого <w>скупца</w>.",
                                "de": "In seiner berühmten Komödie inszeniert Molière einen lächerlichen und tyrannischen alten <w>Geizhals</w>.",
                                "es": "En su famosa comedia, Molière pone en escena a un viejo <w>avaro</w> ridículo y tiránico.",
                                "zh": "莫里哀在他的著名喜剧中塑造了一个可笑又专横的老<w>守财奴</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "radin",
                        "pingre",
                        "grippe-sou",
                        "harpagon",
                        "rapiat"
                    ],
                    "antonyms": [
                        "dépensier"
