                        "examples": [
                            {
                                "example_id": "78d5cbd7-f8e9-4fc2-b113-0e56d819d016",
                                "sense_id": "1ae0a68f-c58b-307d-880c-9f0dd4d50ffc",
                                "text": "„Die Windlotterie beim Skifliegen in Planica endete am Sonntag nach nur einem Bewerb, den der Pole Kamil Stoch gewann.“"
                            },
                            {
                                "example_id": "853f0990-7f53-4116-b0a2-8d13a32b4d54",
                                "sense_id": "1ae0a68f-c58b-307d-880c-9f0dd4d50ffc",
                                "text": "„Österreichs Vertreterin Zoë startet dabei mit Startnummer 24 und somit als Drittletzte in den Bewerb.“"
                            }
                        ],
