                "senses": [
                    {
                        "sense_id": "95b15687-2368-31e6-a3ae-95e4bbc1ce29",
                        "entry_id": "829b0edb-2475-3cd5-93fd-f5ebf2f97f86",
                        "glosses": [
                            "das (absichtliche) Langsamsein bei der Ausführung von Tätigkeiten"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f9070dc8-0ee6-4c23-9bb7-5edeb46dfdad",
                                "sense_id": "95b15687-2368-31e6-a3ae-95e4bbc1ce29",
                                "text": "Nach Wochen der Saumseligkeit schrieb er seine Seminararbeit in den letzten drei Tagen vor Ablauf der Frist."
                            },
                            {
                                "example_id": "33ae3e6d-536e-4973-b3c7-4bc96779b447",
                                "sense_id": "95b15687-2368-31e6-a3ae-95e4bbc1ce29",
                                "text": "„Er möchte sich nicht ein zweites Mal dem Vorwurf der Saumseligkeit aussetzen.“"
                            },
                            {
                                "example_id": "fee698a3-227c-4554-a376-efdbf294bc17",
                                "sense_id": "95b15687-2368-31e6-a3ae-95e4bbc1ce29",
                                "text": "„Boncœur hatte den Kopf zwischen die Vorderfüße gelegt, und nur dann und wann sah er zu seiner selbstgewählten Herrin auf, als ob er sich wegen seiner Saumseligkeit entschuldigen wolle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
