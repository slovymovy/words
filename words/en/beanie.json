{
    "word_family": [
        "bean"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "79cf6686-a551-30f6-9d4d-f7bd3b254475",
                    "sense_definition": "A cap that fits the head closely, usually knitted from wool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on a warm <w>beanie</w> before going out into the snow.",
                            "target_lang_translations": {
                                "ru": "Он надел теплую <w>шапку</w>, прежде чем выйти на снег."
                            }
                        },
                        {
                            "text": "Enrique Iglesias is often seen wearing a <w>beanie</w> during his concerts.",
                            "target_lang_translations": {
                                "ru": "Энрике Иглесиаса часто видят в <w>шапке-бини</w> во время его концертов."
                            }
                        }
                    ],
                    "synonyms": [
                        "knit cap",
                        "knit hat",
                        "skull cap",
                        "snow cap",
                        "ski cap",
                        "stocking cap",
                        "toque",
                        "watch cap",
                        "woolly hat"
                    ],
                    "common_phrases": [
                        "knit beanie",
                        "wool beanie",
                        "wear a beanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно облегающая голову шапка, обычно вязанная из шерсти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шапка",
                                "target_lang_sense_clarification": "общий термин для головного убора"
                            },
                            {
                                "target_lang_word": "вязаная шапка",
                                "target_lang_sense_clarification": "указывает на способ изготовления"
                            },
                            {
                                "target_lang_word": "бини",
                                "target_lang_sense_clarification": "современное заимствование для этого фасона"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e12bf9d8-36d4-37c7-a692-8d271be9fd5c",
                    "sense_definition": "A head-hugging brimless cap made from triangular sections of cloth or leather joined by a button at the crown.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "headwear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy wore a traditional <w>beanie</w> with a small button on top.",
                            "target_lang_translations": {
                                "ru": "Школьник носил традиционную <w>шапочку</w> с маленькой пуговицей наверху."
                            }
                        },
                        {
                            "text": "This vintage <w>beanie</w> is made of several silk panels stitched together.",
                            "target_lang_translations": {
                                "ru": "Эта винтажная <w>шапочка</w> сделана из нескольких сшитых вместе шелковых лоскутов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "brimless beanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прилегающая шапочка без полей, сшитая из клиньев ткани или кожи, соединенных пуговицей на макушке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюбетейка",
                                "target_lang_sense_clarification": "близкий по форме фасон без полей"
                            },
                            {
                                "target_lang_word": "шапочка из клиньев",
                                "target_lang_sense_clarification": "описание конструкции"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32a597ba-7d60-3202-99c7-99dbaf2e0988",
                    "sense_definition": "A small soft toy filled with beans or similar stuffing, often referring to a Beanie Baby.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toys",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a large collection of every <w>beanie</w> released in the nineties.",
                            "target_lang_translations": {
                                "ru": "У нее большая коллекция каждой <w>мягкой игрушки</w>, выпущенной в девяностые."
                            }
                        },
                        {
                            "text": "The child squeezed the plush <w>beanie</w> to feel the small pellets inside.",
                            "target_lang_translations": {
                                "ru": "Ребенок сжал плюшевую <w>игрушку</w>, чтобы почувствовать маленькие гранулы внутри."
                            }
                        }
                    ],
                    "common_phrases": [
                        "plush beanie",
                        "collectible beanie"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to refer to Beanie Babies"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая мягкая игрушка, наполненная гранулами или бобами (часто о серии Beanie Babies)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мягкая игрушка",
                                "target_lang_sense_clarification": "общий термин"
                            },
                            {
                                "target_lang_word": "игрушка с гранулами",
                                "target_lang_sense_clarification": "указывает на наполнитель"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}