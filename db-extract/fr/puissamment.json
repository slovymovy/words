        "fr-extract.jsonl": [
            {
                "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                "word": "puissamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "glosses": [
                            "Avec puissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e39393a-30e8-46f2-ab8d-2970bdcad789",
                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                "text": "Voir de si faibles vainqueurs [les femmes] Régner si puissamment sur les plus nobles cœurs !"
                            },
                            {
                                "example_id": "677c966a-0af1-44e8-88f0-7d5902a07a97",
                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                "text": "Il sait… que le Grand Seigneur arme puissamment,"
                            },
                            {
                                "example_id": "7788598e-b0b3-48ec-a701-dbd87481ba80",
                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                "text": "À peine le guéritier, se bouchant du pouce la narine droite, en aspira-t-il par la gauche un demi-pincée, le mort toussa si puissamment qu’il aveugla par ses postillons les yeux des trois pandores."
                            },
                            {
                                "example_id": "74db40ec-3903-4d63-93d2-19f6858ee087",
                                "sense_id": "578cd8c7-93e9-3f0f-b0fe-720ee79b5b1a",
                                "text": "Enfin, comme à dessein de le rendre plus complexe, des odeurs de caroube, de denrées coloniales, de goudron, d’air marin arrivaient puissamment du port et se mêlaient à celles qui montaient des pavés et des caves."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "glosses": [
                            "Avec force."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d113a91f-ca9b-45b7-b3dc-850041bc54cf",
                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                "text": "Rien n'éloigne plus promptement et plus puissamment les surprises captieuses des sophistes…."
                            },
                            {
                                "example_id": "ea66973b-dee8-41e6-8598-0321fa2779be",
                                "sense_id": "1ecceb1f-61a5-3cd9-b561-b00e0bad29fe",
                                "text": "Cela confirme puissamment ce que vous dites si bien, que nos yeux ne sont point ceux qu’on devrait avoir, si nous regardions les choses comme des chrétiens,"
                            }
                        ]
                    },
                    {
                        "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "glosses": [
                            "Extrêmement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fb4417b-e2bc-4185-a803-c03dd4010c20",
                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                "text": "À sa propagande de quartier, il alliait une action incessante dans les ateliers du boulevard Masséna. Il avait puissamment resserré les liens moraux qui unissaient à la C. G. T. les typographes, les minervistes et les relieurs de Delaborde."
                            },
                            {
                                "example_id": "4ea3938c-6db6-4212-9464-caf7e52e5cdb",
                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                "text": "Je sentirais mon mal puissamment soulagé,"
                            },
                            {
                                "example_id": "ec10b2e3-de5a-47f0-94ba-35748b44b43b",
                                "sense_id": "b5141eed-dc04-3b5b-a570-1597d395c899",
                                "text": "Et qu’Isabelle en est puissamment irritée,"
                            }
                        ]
                    },
                    {
                        "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                        "entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "glosses": [
                            "très."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "700f41c6-35f1-4c4d-8369-8afce460f6ed",
                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                "text": "Puissamment riche très riche."
                            },
                            {
                                "example_id": "b11faaf8-91ef-482b-a460-c0cecaba00f9",
                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                "text": "Oui, madame, je suis puissamment riche,"
                            },
                            {
                                "example_id": "6979a1a3-ff77-4b06-b29b-74fdd355955b",
                                "sense_id": "19966dd9-2a43-3fa8-ada9-88dc1a61094d",
                                "text": "Un brave laboureur […], et qui, après avoir payé la taille, le taillon, les aides et gabelles, le sou pour livre, la capitation et les vingtièmes, ne se trouvait pas puissamment riche au bout de l’année,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "535b6c83-f08d-4b1b-884c-d7d0602ad49e",
                        "source_entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "target_lang_word": "mächtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mächtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e1f0b455-8447-3648-9b47-9fae5e3f3d7e",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "über Einfluss verfügend, Macht habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b238c369-670d-4fa8-89f7-25f49e918a4f",
                                                "sense_id": "e1f0b455-8447-3648-9b47-9fae5e3f3d7e",
                                                "text": "Der mächtige Tyrann war über die Ländergrenzen gefürchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "beeindruckende, große Ausmaße oder Funktion habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154bfcd5-07c2-443c-b5e1-9ee47103fc2e",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "Ich gehe zum Bäcker, ich habe einen mächtigen Hunger."
                                            },
                                            {
                                                "example_id": "b3b4cc36-62ec-425d-b142-189908a83bec",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "„Hier entstanden mehrere tausend Meter mächtige Eisschilde, die schließlich talwärts in Bewegung gerieten.“"
                                            },
                                            {
                                                "example_id": "ce63b07b-8c8c-47f0-8e80-5c636c3e34a8",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "Das neue Bildbearbeitungsprogramm des Computerherstellers wird in Fachkreisen als mächtiges Werkzeug gelobt."
                                            },
                                            {
                                                "example_id": "a3f6b2a0-c880-4344-9a21-94948da8cc9e",
                                                "sense_id": "b5487af5-7e59-32da-9e8c-e6f8f97d57a4",
                                                "text": "„Das mächtige Kreuz vor der Kirche, von Steinmetzen aus heimischem Basalt gehauen, imponiert durch seine monumentale Größe ebenso wie durch seine Aussagekraft als Mahnmal für die Toten der beiden Weltkriege des 20. Jahrhunderts (…).“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "448e0ca4-d820-30a6-81d3-c6143c5a520f",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "etwas beherrschend"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a948688-62fd-413c-b5fb-e56a9ef53f95",
                                                "sense_id": "448e0ca4-d820-30a6-81d3-c6143c5a520f",
                                                "text": "Er ist seiner Sinne nicht mehr mächtig."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                        "entry_id": "8706c0a4-12c1-34df-a363-94a25ab83ebf",
                                        "glosses": [
                                            "sehr, viel"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e5ad5c-2ba1-4e40-90ba-1f9b59e0885d",
                                                "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                                "text": "Meine Mutter war mächtig sauer, weil ich erst nach Mitternacht heimkam."
                                            },
                                            {
                                                "example_id": "fe871ace-c5c8-49d9-b7ed-38819914bd9f",
                                                "sense_id": "7c5bafd8-6443-3ea7-865e-5d1688fea086",
                                                "text": "Bei der Erstellung von Beispielsätzen muss man mächtig aufpassen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85a4adec-0623-4d6c-8edb-157905f915d1",
                        "source_entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
                        "target_lang_word": "greatly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greatly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                        "entry_id": "35b3c682-a5a9-3bbc-b9be-6a7e802a6e64",
                                        "glosses": [
                                            "To a great extent or degree."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a938ac68-03cd-41ac-965a-22d98d7c9f4a",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Expenses greatly exceeded revenues this year, much to nobody's surprise."
                                            },
                                            {
                                                "example_id": "df33be7a-e68d-4308-94b3-6102a24ab72e",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "He was more greatly beloved than anyone in living memory."
                                            },
                                            {
                                                "example_id": "57e9eb3d-84c9-4401-adb7-9258ad862af9",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "There were many wooden chairs for the bulk of his visitors, and two wicker armchairs with red cloth cushions for superior people. From the packing-cases had emerged some Indian clubs,[…], and all these articles[…] made a scattered and untidy decoration that Mrs. Clough assiduously dusted and greatly cherished."
                                            },
                                            {
                                                "example_id": "5421a778-d12f-4e92-a761-83b5711af321",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Terry's goal looked to have put Chelsea in control on the stroke of half-time but Arsenal's response presented a compelling case for Wenger's insistence that reports of his side's demise have been greatly exaggerated."
                                            },
                                            {
                                                "example_id": "98b550b3-469c-4002-b5d1-7e078cb7b127",
                                                "sense_id": "1a696390-44c2-31f9-89f9-37b54af56d28",
                                                "text": "Instead of retracing my route, I have elected to walk across Blackpool to the town's remaining large station, although even this has been greatly reduced in size."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                        "entry_id": "35b3c682-a5a9-3bbc-b9be-6a7e802a6e64",
                                        "glosses": [
                                            "Nobly; magnanimously."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58c6a1ba-e211-4777-9d18-a68462604190",
                                                "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                                "text": "His Suff’rings ſhine, and ſpread a Glory round him;\nGreatly unfortunate, he fights the Cauſe\nOf Honour, Virtue, Liberty, and Rome."
                                            },
                                            {
                                                "example_id": "0ce7d7dd-a1aa-4dc0-bc0c-8629540eac76",
                                                "sense_id": "cba29a28-2e63-316e-b08a-3f721fa43d4d",
                                                "text": "But all this our fisher, who was neither a poet, nor a dependent, did not know, so he concluded, that all who were truly great, were truly greatly minded, and noble in soul, as they were exalted by birth, and rich in splendour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80bd87e1-6893-4365-80c4-f0282d148af9",
                        "source_entry_id": "ce7bdb40-73c1-3265-a92a-ef9e31ab8252",
