                    "frequency": "High",
                    "semantic_group_id": "small_hole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een klein <w>gaatje</w> in mijn nieuwe trui.",
                            "target_lang_translations": {
