                "senses": [
                    {
                        "sense_id": "e96b322c-3e96-3356-b703-6f7638b62a73",
                        "entry_id": "93712a7f-e89e-3425-90d2-a21a248f198f",
                        "glosses": [
                            "Relatif à la diaspora mexicaine des États-Unis."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "05f49dae-69d8-401a-b720-08d88d1163ee",
                                "sense_id": "e96b322c-3e96-3356-b703-6f7638b62a73",
                                "text": "Héritier en ligne directe du muralisme mexicain, le muralisme chicano est aujourd’hui l’un des multiples exemples de peinture murale aux États-Unis."
                            },
                            {
                                "example_id": "d36a3a47-6c91-4b06-95c2-c9e44578a5f6",
                                "sense_id": "e96b322c-3e96-3356-b703-6f7638b62a73",
                                "text": "C'est à Siqueiros que le muralisme mexicain doit d’avoir été un exemple d’avant-garde d’art monumental, national et révolutionnaire. C’est de son exemple et de sa conception du muralisme que vont largement s’inspirer les muralistes chicanos."
                            }
                        ]
                    },
                    {
                        "sense_id": "35794dfb-43a1-3a26-8a4f-f5ea7f63e738",
                        "entry_id": "93712a7f-e89e-3425-90d2-a21a248f198f",
                        "glosses": [
                            "Relatif à toute diaspora des États-Unis venant d’Amérique latine."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "dc10644b-a447-4f09-9fc0-ab39134c9f6c",
                                "sense_id": "35794dfb-43a1-3a26-8a4f-f5ea7f63e738",
                                "text": "Vos récits ont pour héros des protagonistes chicanos, des Américains d’origine latine, mexicaine dans votre cas."
                            }
                        ]
                    }
                ],
