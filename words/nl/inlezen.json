                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "data_verwerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de jaren 70 moest je nog ponsbanden en -kaarten <w>inlezen</w>.",
