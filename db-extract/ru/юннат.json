                        ],
                        "form": "юнна́те"
                    },
                    {
                        "form_id": "9b3d82b2-3319-45c2-a5dd-1b81c88c75df",
                        "entry_id": "e6f4f622-2597-3629-9bf3-caa9d85ba7bc",
                        "tags": [
