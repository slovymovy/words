                "senses": [
                    {
                        "sense_id": "33c5998e-0505-3aa3-86e8-6c7a19583b49",
                        "entry_id": "c8b7e90e-48da-3fb6-a367-d3a72e6ace01",
                        "glosses": [
                            "Certainement, sûrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c906a25b-99b3-47ea-9919-d8e30d1aeb64",
                                "sense_id": "33c5998e-0505-3aa3-86e8-6c7a19583b49",
                                "text": "Der Artikel ist gut, aber sicherlich ausbaufähig."
                            },
                            {
                                "example_id": "1820aea0-81dd-4a72-969e-d0a1211ccd67",
                                "sense_id": "33c5998e-0505-3aa3-86e8-6c7a19583b49",
                                "text": "Wir haben sicherlich oft zu viel Empörung in unserer Debattenkultur. Hier aber können wir gar nicht empört genug sein.",
                                "translation": "Nous avons certainement souvent trop d'indignation dans notre culture du débat. Mais ici, nous ne serons jamais assez indignés."
                            },
                            {
                                "example_id": "e8ccbd55-964a-4d7f-b1f5-a24f34a2ff33",
                                "sense_id": "33c5998e-0505-3aa3-86e8-6c7a19583b49",
                                "text": "Herr Jean Jacques Hoffstede, der Poet der Stadt, der sicherlich auch für den heutigen Tag ein paar Reime in der Tasche hatte, war nicht viel jünger als Johann Buddenbrook, der Ältere, und abgesehen von der grünen Farbe seines Leibrockes, in demselben Geschmack gekleidet.",
                                "translation": "M. Jean-Jacques Hoffstede, poète du cru, qui avait certainement dans sa poche quelques rimes pour la fête d’aujourd’hui, était à peine plus jeune que Johann Buddenbrook aîné et vêtu dans le même goût, sauf pour la couleur verte de son habit."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                "word": "sicherlich",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                        "entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                        "glosses": [
                            "mit ziemlicher Sicherheit; oftmals eine gewisse Beeinschränkung beinhaltend, die zum Beispiel mit aber angeschlossen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efcc9f1b-6ab4-4f17-9d7d-8a8f2666e8a4",
                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                "text": "Sie hat sich sicherlich Mühe gegeben, aber Mühe alleine reicht eben nicht immer."
                            },
                            {
                                "example_id": "9aa492dd-7788-4948-a9d6-9593849347cd",
                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                "text": "Der Artikel ist gut, aber sicherlich ausbaufähig."
                            },
                            {
                                "example_id": "aa2d1e30-b32b-478a-95e4-35dbf3762217",
                                "sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                                "text": "Seine Schilderung der Ereignisse entspricht sicherlich der Wahrheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "723b340f-c020-4619-8314-cdd3cbaad0e5",
                        "source_entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                        "source_sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                        "target_lang_word": "surely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Without fail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "406c8243-0e5a-4fe4-bdcc-81fcc211cc27",
                                                "sense_id": "84032c6a-9b2d-34fb-a3a0-79fc6a145067",
                                                "text": "slowly but surely"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "Certainly, undoubtedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be9b0d14-0b29-4e6f-ac77-7ad98fa65234",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Surely, you must be joking."
                                            },
                                            {
                                                "example_id": "3621f3cb-b892-44b0-ab9d-e6dd2977a6eb",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "You don’t suppose we're going to pay for you, surely?"
                                            },
                                            {
                                                "example_id": "43d2bcd0-c794-4516-846b-a4cd249eb952",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "She’s surely got the letter by now."
                                            },
                                            {
                                                "example_id": "9a311353-e1b1-495e-b931-1e8f75127d7e",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "But then I had the flintlock by me for protection. ¶ There were giants in the days when that gun was made; for surely no modern mortal could have held that mass of metal steady to his shoulder. The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window[…]."
                                            },
                                            {
                                                "example_id": "34663fcc-6e83-4c73-a424-c4edc32328ad",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Ted Striker: The stewardess said... both pilots?!\nDr. Rumack: Can you fly this plane and land it?\nTed Striker: Surely you can't be serious.\nDr. Rumack: I am serious; and don't call me Shirley."
                                            },
                                            {
                                                "example_id": "18d0c44d-e5af-404c-a843-a5a80d2b4334",
                                                "sense_id": "cdc0643e-333e-3f60-a6bf-11547cca24b7",
                                                "text": "Here perhaps one of you might interrupt me and say, 'But what is it that you do, Socrates? How is it that you have been misrepresented like this? Surely all this talk and gossip about you would never have arisen if you had confined yourself to ordinary activities, but only if your behaviour was abnormal. Give us the explanation, if you do not want us to draw our own conclusions.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                        "entry_id": "8617bbc5-d461-317b-a70e-c5e6ca6e8097",
                                        "glosses": [
                                            "With confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17183608-5e5e-41bb-8ca6-60914ff1a33d",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "His feet were planted surely on the ground."
                                            },
                                            {
                                                "example_id": "1db64fc2-249b-44ee-9da4-84ee0955ecf5",
                                                "sense_id": "0a6d8157-34ad-35d4-8b7e-29b7cfd9d832",
                                                "text": "Forasmuch as many have taken in hand to set forth in order a declaration of those things which are most surely believed among us[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a739f272-7abd-48f9-9b88-40e9229e9bdf",
                        "source_entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                        "source_sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
                        "target_lang_word": "certainement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "certainement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9399dc4-7955-33af-a827-38bca68ee9a5",
                                        "entry_id": "a8e0c183-2c85-3bf6-addf-c02a571e258e",
                                        "glosses": [
                                            "D'une manière certaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03bf328-42c6-4d25-81d0-b97f12c92f36",
                                                "sense_id": "d9399dc4-7955-33af-a827-38bca68ee9a5",
                                                "text": "Le roi veut qu’on l’arrête, et qu’on sache certainement de quel pays il est."
                                            },
                                            {
                                                "example_id": "87a6d652-a17d-4110-ada1-1e4d6c587016",
                                                "sense_id": "d9399dc4-7955-33af-a827-38bca68ee9a5",
                                                "text": "Cependant, il ne voulait point lui dire que leur séparation serait probablement, certainement même, éternelle..."
                                            },
                                            {
                                                "example_id": "68b1b0e5-1a60-425d-b838-237ab78cda63",
                                                "sense_id": "d9399dc4-7955-33af-a827-38bca68ee9a5",
                                                "text": "Saint Augustin le déclare expressément : « une chose notifiée par allégorie est certainement plus expressive, plus agréable, plus imposante que lorsqu’on l’énonce en des termes techniques. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3daaac9f-18c1-3bd1-be83-b612f79e5018",
                                        "entry_id": "a8e0c183-2c85-3bf6-addf-c02a571e258e",
                                        "glosses": [
                                            "Sans doute ; en vérité ; assurément."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "346a1a05-aa6d-459b-8309-c3e4aa74aeae",
                                                "sense_id": "3daaac9f-18c1-3bd1-be83-b612f79e5018",
                                                "text": "Et certainement on ne saurait assez plaindre la perte de ces excellents originaux."
                                            },
                                            {
                                                "example_id": "9a961b0b-b937-43c3-939f-01e124d4e9ae",
                                                "sense_id": "3daaac9f-18c1-3bd1-be83-b612f79e5018",
                                                "text": "Les deux officiers avaient trouvé plusieurs clés USB, ainsi que trois disques durs externes et des brouillons de formules mathématiques, certainement le fruit des recherches du défunt chercheur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013b4006-8f05-3fa1-b874-069b8e15de6b",
                                        "entry_id": "a8e0c183-2c85-3bf6-addf-c02a571e258e",
                                        "glosses": [
                                            "Très probablement mais exprimant une certaine incertitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a605d405-5951-45a7-99d8-b594b71418e8",
                                                "sense_id": "013b4006-8f05-3fa1-b874-069b8e15de6b",
                                                "text": "Pour sonder son frère, Aristide, qui n’osait paraître inquiet ouvertement, se contenta de lui demander :\n— As-tu lu mon article d’hier ? Qu’en penses-tu ?\nEugène eut un léger mouvement d’épaules.\n— Vous êtes un niais, mon frère, répondit-il simplement.\n— Alors, s’écria le journaliste en pâlissant, tu donnes raison à Vuillet, tu crois au triomphe de Vuillet.\n— Moi !… Vuillet…\nIl allait certainement ajouter : « Vuillet est un niais comme toi. » Mais en apercevant la face grimaçante de son frère qui se tendait anxieusement vers lui, il parut pris d’une subite défiance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7d9047-a32e-33d2-9772-b56477563af6",
                                        "entry_id": "a8e0c183-2c85-3bf6-addf-c02a571e258e",
                                        "glosses": [
                                            "Utilisé en ce sens pour marquer une certaine circonspection de manière atténuée, et qui signifie en définitive l’inverse de ce qu’il devrait signifier."
                                        ],
                                        "tags": [
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e169766-acbd-41c0-9ae7-1591db31f028",
                                                "sense_id": "8d7d9047-a32e-33d2-9772-b56477563af6",
                                                "text": "Je veux faire plein de choses dans ma vie : parler 10 langues, faire le tour du monde, avoir 3 chiens et 4 enfants, plusieurs voitures !\n— Ah, mais certainement, me dit mon père, dubitatif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79de617e-44f4-4080-a6cf-64a5e2d987e0",
                        "source_entry_id": "4975487c-8fdb-39fc-a7ae-31aa8c89778b",
                        "source_sense_id": "b59b08bd-38c8-339d-82fb-37fa4b6a0718",
