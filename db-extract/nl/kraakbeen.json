                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6baea7a6-5177-3215-bf7c-ad0bd87b8e9c",
                                        "entry_id": "90b4c098-c17f-3399-9dd5-b142b2e18784",
                                        "glosses": [
                                            "A particular structure made of cartilage."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
