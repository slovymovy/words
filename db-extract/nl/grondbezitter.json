                        "cross_references": [
                            {
                                "target_word": "landowner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57155fae-4c37-309a-9234-a18f1896e61b",
                                        "entry_id": "ad6a2816-f981-3677-b6d4-06853c385f94",
                                        "glosses": [
                                            "A person who owns land."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fd6a997-893a-4c18-9cba-353d83d35f77",
                                                "sense_id": "57155fae-4c37-309a-9234-a18f1896e61b",
                                                "text": "If this was unrestricted freehold, the land is available for sale or lease, although often it is not readily marketable, by reason of its shape and access; neighbouring landowners are possible purchasers. In some cases, reversionary rights were reserved to neighbouring landowners when the land was acquired."
                                            },
                                            {
                                                "example_id": "4a0caa52-3c43-44ee-9831-86016ccd18d3",
                                                "sense_id": "57155fae-4c37-309a-9234-a18f1896e61b",
                                                "text": "The largest owner of tea lands on the island in the late 1800s (and Taiwan’s single wealthiest family) were the Lins of Pan-ch’iao. Along with other great familial and corporate landowners, the Pan-ch’iao Lins drew income from renting their properties under a flexible, sophisticated contractual system of land tenure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78dd5bc4-e0de-4779-b3cd-4b28cb558c2d",
                        "source_entry_id": "7b49d618-5000-385b-9132-c7e951ec411d",
                        "source_sense_id": "2dfdc0f1-62d6-3dda-a15e-559fb9456e36",
                        "target_lang_word": "landlord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landlord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84194766-5e83-3bef-a439-2c4c119939ea",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "A person that leases real property; a lessor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7530885a-636f-486d-933b-b895410316b5",
                                                "sense_id": "84194766-5e83-3bef-a439-2c4c119939ea",
                                                "text": "Brethren, brethren, it were better to haue this communitie,\nThen to haue this difference in degrees:\nThe landlord his rent, the lawyer his fees.\nSo quickly the poore mans ſubſtance is ſpent […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2eecb5-29f7-3b32-8059-ebd997da64bb",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "The owner or manager of a public house."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ec27c3-fa85-4a70-b494-79ecec76c7e4",
                                                "sense_id": "9c2eecb5-29f7-3b32-8059-ebd997da64bb",
                                                "text": "When asked to explain why he became a landlord, he told the Archbishop of York it was so he could close the pub on Sundays, and suppress the profane language and singing that came through the bar windows."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358caf9f-e361-349b-b1f7-a556599d9cb2",
                                        "entry_id": "4befbc28-013a-33db-9600-4240eb6b53d8",
                                        "glosses": [
                                            "A shark, imagined as the owner of the surf to be avoided."
                                        ],
                                        "tags": [
                                            "slang",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
