                "senses": [
                    {
                        "sense_id": "b80e8fca-7995-3f94-b0e1-319ee1bb69c6",
                        "entry_id": "6921c934-3361-3ccd-887d-6603c6da8eb7",
                        "glosses": [
                            "Pferderasse, die gekennzeichnet ist durch ein hohes Körpergewicht, ein ruhiges Gemüt und der Fähigkeit, große Lasten zu ziehen. Es besteht keine Verbindung zur Körpertemperatur der Pferde!"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2121081-89be-44b5-95e9-3c6820c42561",
                                "sense_id": "b80e8fca-7995-3f94-b0e1-319ee1bb69c6",
                                "text": "Das sanfte Kaltblut Schorschi ist im Alter von 21 Jahren an Alterschwäche gestorben."
                            },
                            {
                                "example_id": "e9952e5a-869e-48b4-b9e7-7a732de18cd3",
                                "sense_id": "b80e8fca-7995-3f94-b0e1-319ee1bb69c6",
                                "text": "Als sich der Fuhrknecht genug an den beiden Tieren ausgetobt hatte, band er den zweiten Schlitten los, und einzeln schafften die beiden Kaltblüter schließlich beide Fuhren auf die Höhe des Berges."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
