                        "glosses": [
                            "A diminutive of the female given name Edith, also used as a formal given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "639cb91f-ad99-4249-b745-f42f0aaebb4a",
                                "sense_id": "57e457cc-4af2-301c-80f7-9d487dc21685",
                                "text": "“We have the name for our daughter. We can call her Edie Maureen. They're old fashioned names so if we have a son and a daughter, we need to find a name for our son. […]\""
                            },
                            {
                                "example_id": "e707a763-5252-4c11-b678-ae78cf2ccca1",
                                "sense_id": "57e457cc-4af2-301c-80f7-9d487dc21685",
                                "text": "My full name is Edith Jasmine Snow, but the kids at school generally call me Edie-Snow-Peadie, and I don't want to tell him that."
                            }
                        ]
                    }
                ],
