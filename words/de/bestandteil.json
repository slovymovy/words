                            },
                            {
                                "target_lang_word": "constituent",
                                "target_lang_sense_clarification": "formal component of a whole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51eec739-181e-3c4d-8a58-586adb367dcb",
                    "sense_definition": "stofflicher Anteil oder Zutat eines Gemisches, eines Lebensmittels oder eines chemischen Stoffes",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ingredient_substance",
                    "name_type": "no",
                    "examples": [
                        {
