                ],
                "senses": [
                    {
                        "sense_id": "dde1e9b0-0a39-32f5-8e41-3fdbe2b66e3e",
                        "entry_id": "113d80a7-2baa-3b86-babf-156dca19b57a",
                        "glosses": [
                            "Kohle, die aus tierischer Biomasse wie Blut hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde05b91-993a-4e4e-aaf2-4f315b84d6d8",
                                "sense_id": "dde1e9b0-0a39-32f5-8e41-3fdbe2b66e3e",
                                "text": "„Auch Wohl und Losanitsch verwerten die adsorbierende Kraft mit flüssiger Luft gekühlter Blutkohle.“"
                            },
                            {
                                "example_id": "afede9ee-2022-483a-9daa-af8569db2a1b",
                                "sense_id": "dde1e9b0-0a39-32f5-8e41-3fdbe2b66e3e",
                                "text": "„Eine weitere Eigenschaft unterscheidet die Zuckerkohle von der Blutkohle: sie ist im Gegensatz zu letzterer in recht erheblichem Ausmass autoxydabel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4a5a78f5-9d49-3ba6-9f8c-041e9e8733fd",
                        "entry_id": "113d80a7-2baa-3b86-babf-156dca19b57a",
                        "glosses": [
                            "Braun- oder Steinkohle, bei deren Gewinnung durch niedrige Sicherheitsstandards viele Verletzte und Tote anfallen"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "af91a9ab-0250-4749-8d0b-9da5ad78dc2d",
                                "sense_id": "4a5a78f5-9d49-3ba6-9f8c-041e9e8733fd",
                                "text": "„Bei der tarifvertraglichen Regelung in Sachen Deputatkohle, erklärte Hundertmark, werde auf die Förderung aus eigener Produktion gesetzt. ‚Nach dem Ende der heimischen Förderung nun chinesische oder kolumbianische Blutkohle zur Versorgung unserer Kollegen zu importieren, das ist abzulehnen‘, sagte Hundertmark.“"
                            },
                            {
                                "example_id": "883cdbc4-23ab-44f3-8032-1ccd779c8255",
                                "sense_id": "4a5a78f5-9d49-3ba6-9f8c-041e9e8733fd",
                                "text": "„Aktuell klagen Menschenrechts-Organisationen darüber, dass große Energiekonzerne an Rhein und Ruhr sogenannte ‚Blutkohle‘ aus Kolumbien importieren.“"
                            },
                            {
                                "example_id": "95b39539-cb7a-4e17-b2c3-5d6bccee7da8",
                                "sense_id": "4a5a78f5-9d49-3ba6-9f8c-041e9e8733fd",
                                "text": "„Nationalisten hatten die Gleise besetzt, weil sie jedweden Profit aus dem Handel mit den Führungen im Osten als ‚Blutgeld‘ und dort geförderte Kohle als ‚Blutkohle‘ bezeichnet hatten.“"
                            },
                            {
                                "example_id": "d7a770ee-bd9a-455d-9d11-e23225497eb5",
                                "sense_id": "4a5a78f5-9d49-3ba6-9f8c-041e9e8733fd",
                                "text": "„Bogotá: Blutkohle aus Kolumbien“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
