                "senses": [
                    {
                        "sense_id": "b90c3009-aba9-33a9-94b3-4a28e6844d8b",
                        "entry_id": "b95daf3c-4c23-3a41-ab9a-887785fe980a",
                        "glosses": [
                            "Ausdrucksweise, bei der gehäuft Wörter aus dem Fäkalbereich verwendet werden, also Wörter, die die Ausscheidungen von Blase und Darm bezeichnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d096b7-63ea-4f4f-9667-7ece9cf6f8f0",
                                "sense_id": "b90c3009-aba9-33a9-94b3-4a28e6844d8b",
                                "text": "„Ich leide unter dieser 500-Worte-Sprache, daher musste ich bei diesem Film mitmachen. Kampf der Fäkaliensprache!“ Kampf gegen die Fäkaliensprache? „Nein, Kampf der Fäkaliensprache, mit Genitiv. Schreiben Sie das so.“"
                            },
                            {
                                "example_id": "9e9c1da5-f3f1-4b13-bbfe-09251c717710",
                                "sense_id": "b90c3009-aba9-33a9-94b3-4a28e6844d8b",
                                "text": "„Er warf Bohlen wegen dessen teils mit Fäkaliensprache gespickten Sprüchen vor: «Wer Menschen verachtet, beleidigt Gott.» RTL ermahnte er, Beleidigungen und Fäkaliensprache dürften keinen Raum im Fernsehen erhalten.“"
                            },
                            {
                                "example_id": "9f426be3-81b5-4398-803d-6684b3447178",
                                "sense_id": "b90c3009-aba9-33a9-94b3-4a28e6844d8b",
                                "text": "„Fäkaliensprache ist eines der letzten Tabus.“"
                            }
                        ],
