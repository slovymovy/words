{
    "word_family": [
        "ivorine"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7af2d953-1972-372a-83c0-be867a1d5b0a",
                    "sense_definition": "The hard white form of dentin which forms the tusks of elephants, walruses, and other animals.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "material_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "International laws strictly ban the illegal <w>ivory</w> trade to protect endangered elephants.",
                            "target_lang_translations": {
                                "ru": "Международные законы строго запрещают незаконную торговлю <w>слоновой костью</w> для защиты исчезающих слонов.",
                                "zh": "国际法严格禁止非法<w>象牙</w>贸易，以保护濒危大象。"
                            }
                        },
                        {
                            "text": "The museum displayed a beautiful statue carved from pure <w>ivory</w>.",
                            "target_lang_translations": {
                                "ru": "В музее была выставлена прекрасная статуя, вырезанная из чистой <w>слоновой кости</w>.",
                                "zh": "博物馆展出了一尊用纯<w>象牙</w>雕成的精美雕像。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ivory trade",
                        "carved ivory",
                        "piece of ivory",
                        "ivory tusk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердое белое вещество, из которого состоят бивни слонов, моржей и других животных.",
                        "zh": "象、海象等动物獠牙中形成的坚硬白色物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слоновая кость",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象牙",
                                "target_lang_sense_clarification": "指大象、海象等动物獠牙中的硬白色材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2c71e59-20e8-33cc-9ea3-17efca87ad23",
                    "sense_definition": "A creamy white color, the color of ivory.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "color_shade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She chose a dress in a soft shade of <w>ivory</w> for the wedding.",
                            "target_lang_translations": {
                                "ru": "Для свадьбы она выбрала платье мягкого оттенка <w>цвета слоновой кости</w>.",
                                "zh": "她为婚礼挑选了一件柔和<w>象牙色</w>的连衣裙。"
                            }
                        },
                        {
                            "text": "The walls were painted <w>ivory</w> to make the small room look brighter.",
                            "target_lang_translations": {
                                "ru": "Стены были покрашены в <w>цвет слоновой кости</w>, чтобы маленькая комната казалась светлее.",
                                "zh": "墙壁被刷成了<w>象牙色</w>，让这个小房间显得更明亮。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cream",
                        "off-white"
                    ],
                    "antonyms": [
                        "ebony",
                        "black"
                    ],
                    "common_phrases": [
                        "shade of ivory",
                        "pale ivory",
                        "ivory white"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кремово-белый цвет, цвет слоновой кости.",
                        "zh": "一种奶油般的白色，也就是象牙的颜色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвет слоновой кости",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "айвори",
                                "target_lang_sense_clarification": "название цвета (заимств.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象牙色",
                                "target_lang_sense_clarification": "一种偏奶油色的白色"
                            },
                            {
                                "target_lang_word": "象牙白",
                                "target_lang_sense_clarification": "更强调白色感的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69dffaf2-8527-3ac4-93a6-b09cb73553ee",
                    "sense_definition": "The keys of a piano, specifically the white keys.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "music_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jazz musician sat down to tickle the <w>ivories</w> for the excited crowd.",
                            "target_lang_translations": {
                                "ru": "Джазовый музыкант сел пробежаться по <w>клавишам</w> для восторженной толпы.",
                                "zh": "这位爵士乐手坐到钢琴前，在<w>琴键</w>上弹奏起来，让兴奋的人群听得如痴如醉。"
                            }
                        },
                        {
                            "text": "He learned to play the <w>ivories</w> at a very young age.",
                            "target_lang_translations": {
                                "ru": "Он научился играть на <w>клавишах</w> в очень юном возрасте.",
                                "zh": "他很小的时候就学会了在<w>钢琴键</w>上弹奏。"
                            }
                        }
                    ],
                    "synonyms": [
                        "keys"
                    ],
                    "antonyms": [
                        "ebonies"
                    ],
                    "common_phrases": [
                        "tickle the ivories",
                        "pound the ivories"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'tickle the ivories'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Клавиши фортепиано (разговорное).",
                        "zh": "钢琴的琴键，尤指白键；口语说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клавиши",
                                "target_lang_sense_clarification": "фортепиано"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琴键",
                                "target_lang_sense_clarification": "口语，指钢琴的键，尤指白键"
                            },
                            {
                                "target_lang_word": "钢琴键",
                                "target_lang_sense_clarification": "更具体地指钢琴的键"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4798ba54-7528-3419-808b-bf651a652b1f",
                    "sense_definition": "The teeth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "body_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He smiled broadly, flashing his pearly <w>ivories</w> at the camera.",
                            "target_lang_translations": {
                                "ru": "Он широко улыбнулся, сверкнув своими жемчужными <w>зубами</w> в камеру.",
                                "zh": "他咧嘴一笑，对着镜头露出一口珍珠般的<w>牙齿</w>。"
                            }
                        },
                        {
                            "text": "The boxer lost two of his <w>ivories</w> during the intense match.",
                            "target_lang_translations": {
                                "ru": "Боксер потерял два <w>зуба</w> во время напряженного боя.",
                                "zh": "那场激烈的比赛中，这位拳击手掉了两颗<w>牙齿</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teeth",
                        "pearly whites"
                    ],
                    "common_phrases": [
                        "flash one's ivories",
                        "pearly ivories"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зубы (слэнг).",
                        "zh": "牙齿；俚语用法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубы",
                                "target_lang_sense_clarification": ""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "牙齿",
                                "target_lang_sense_clarification": "俚语说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2608876a-11cc-30d0-b209-050912b1926d",
                    "sense_definition": "A die or dice used in games of chance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler threw the <w>ivory</w> across the table hoping for a six.",
                            "target_lang_translations": {
                                "ru": "Игрок бросил <w>кость</w> через стол, надеясь на шестерку.",
                                "zh": "这个赌徒把<w>骰子</w>掷过桌面，希望掷出六点。"
                            }
                        },
                        {
                            "text": "He shook the <w>ivory</w> in his hand before making the decisive roll.",
                            "target_lang_translations": {
                                "ru": "Он потряс <w>кость</w> в руке перед решающим броском.",
                                "zh": "在关键一掷之前，他先在手里摇了摇那颗<w>骰子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "die",
                        "dice"
                    ],
                    "common_phrases": [
                        "throw the ivory"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly 19th century usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игральная кость или кубик.",
                        "zh": "赌博或游戏中使用的骰子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "игральная кость",
                                "target_lang_sense_clarification": ""
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": ""
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骰子",
                                "target_lang_sense_clarification": "游戏中使用的小立方体器具"
                            },
                            {
                                "target_lang_word": "色子",
                                "target_lang_sense_clarification": "口语说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "194e9fe2-1637-3f4a-9ce1-a8c75134aa2d",
                    "sense_definition": "Resembling or having the creamy white color of ivory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "color_shade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful <w>ivory</w> silk dress to the evening gala.",
                            "target_lang_translations": {
                                "ru": "Она надела красивое шелковое платье <w>цвета слоновой кости</w> на вечерний гала-концерт.",
                                "zh": "她穿着一件漂亮的<w>象牙色</w>丝绸礼服去参加晚会。"
                            }
                        },
                        {
                            "text": "The artist used <w>ivory</w> paint to capture the light on the clouds.",
                            "target_lang_translations": {
                                "ru": "Художник использовал краску <w>цвета слоновой кости</w>, чтобы передать свет на облаках.",
                                "zh": "画家用了<w>象牙色</w>颜料来表现云上的光线。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cream",
                        "off-white"
                    ],
                    "common_phrases": [
                        "ivory skin",
                        "ivory complexion",
                        "ivory silk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий кремово-белый цвет слоновой кости.",
                        "zh": "呈象牙那样的奶油白色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цвета слоновой кости",
                                "target_lang_sense_clarification": "о цвете"
                            },
                            {
                                "target_lang_word": "кремовый",
                                "target_lang_sense_clarification": "близкий оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象牙色的",
                                "target_lang_sense_clarification": "形容颜色像象牙一样"
                            },
                            {
                                "target_lang_word": "乳白色的",
                                "target_lang_sense_clarification": "近似色，偏奶油白"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07d50815-9efa-37dd-8f23-3eacfa99378a",
                    "sense_definition": "Made of ivory.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "material_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique knife had a delicate <w>ivory</w> handle carved with intricate designs.",
                            "target_lang_translations": {
                                "ru": "У старинного ножа была изящная ручка из <w>слоновой кости</w> с замысловатой резьбой.",
                                "zh": "这把古董刀有一个雕着繁复花纹的<w>象牙制的</w>刀柄。"
                            }
                        },
                        {
                            "text": "Critics say the professor lives in an <w>ivory</w> tower and ignores reality.",
                            "target_lang_translations": {
                                "ru": "Критики говорят, что профессор живет в башне из <w>слоновой кости</w> и игнорирует реальность.",
                                "zh": "批评者说，那位教授住在象牙塔里，无视现实。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ivory tower",
                        "ivory handle",
                        "ivory carving"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из слоновой кости.",
                        "zh": "由象牙制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "из слоновой кости",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "象牙制的",
                                "target_lang_sense_clarification": "由象牙制成"
                            },
                            {
                                "target_lang_word": "象牙做的",
                                "target_lang_sense_clarification": "较口语的说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a554c920-75fa-3cf8-8a2a-38ac2df4acc9",
                    "sense_definition": "A male or female given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "person_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Ivory</w> was excited to start her new job at the library.",
                            "target_lang_translations": {
                                "ru": "<w>Айвори</w> была рада начать свою новую работу в библиотеке.",
                                "zh": "<w>艾沃里</w>很高兴开始她在图书馆的新工作。"
                            }
                        },
                        {
                            "text": "I met a man named <w>Ivory</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил мужчину по имени <w>Айвори</w>.",
                                "zh": "昨天我在会议上遇到了一位名叫<w>艾沃里</w>的男士。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское или женское имя.",
                        "zh": "一个男性或女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айвори",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾沃里",
                                "target_lang_sense_clarification": "名字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2e7a5ad-3b30-316a-9eab-5d5903e77d43",
                    "sense_definition": "A surname of Old French origin.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Ivory</w> has been teaching mathematics at the university for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Айвори</w> преподает математику в университете уже двадцать лет.",
                                "zh": "<w>艾沃里</w>先生在大学教数学已经二十年了。"
                            }
                        },
                        {
                            "text": "The <w>Ivory</w> family has lived in this town for generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Айвори</w> живет в этом городе уже несколько поколений.",
                                "zh": "<w>艾沃里</w>一家已经在这个镇上生活了好几代。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия старофранцузского происхождения.",
                        "zh": "一个源自古法语的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Айвори",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "艾沃里",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
