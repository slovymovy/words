                        "tags": [],
                        "examples": [
                            {
                                "example_id": "751b62ce-b279-44c9-a624-c7db10f82b3f",
                                "sense_id": "a3884ee6-22bd-3ed2-b09a-b49403cbecf4",
                                "text": "„Güterverkehr herrschte durch das Verladen von Ton des Klinkerwerkes Gottfried in Großheirath, wozu eine aufgeständerte Ladestraße und eine Gleiswaage vorhanden war. Daneben gab es in Niederfüllbach Gleisanschlüsse für eine Spedition und einen Stahlhändler.“"
                            },
                            {
                                "example_id": "80968143-cb39-49f3-8db1-fed21b30619e",
                                "sense_id": "a3884ee6-22bd-3ed2-b09a-b49403cbecf4",
                                "text": "„Steinweden baute als jüngster deutscher Stahlhändler sein Geschäft zügig aus: Die Firma beliefert zunächst Handwerk und Industrie in der Region.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
