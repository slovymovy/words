                    "frequency": "Middle",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De monteur heeft de computer van de auto <w>uitgelezen</w> om de storing te vinden.",
                            "target_lang_translations": {
                                "en": "The mechanic <w>read out</w> the car's computer to find the fault."
                            }
                        },
                        {
                            "text": "Je kunt de gegevens van de slimme meter eenvoudig via een app <w>uitlezen</w>.",
                            "target_lang_translations": {
                                "en": "You can easily <w>retrieve</w> the data from the smart meter via an app."
                            }
                        }
                    ],
                    "synonyms": [
                        "scannen",
                        "registreren"
                    ],
                    "common_phrases": [
                        "data uitlezen",
                        "foutcodes uitlezen"
