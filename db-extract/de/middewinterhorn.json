                                "target_senses": [
                                    {
                                        "sense_id": "e7e30d9d-8e17-3a58-b96e-32cf78df275d",
                                        "entry_id": "3137c8a1-ee32-307c-a7b0-dec5aa911d3b",
                                        "glosses": [
                                            "een oud blaasinstrument, een licht gebogen hoorn van berken- elzen- of wilgenhout die op ambachtelijke manier gemaakt is en waarop een monotone melodie wordt geblazen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863b9ac5-31af-4797-b9b6-2c9d6326ad77",
                                                "sense_id": "e7e30d9d-8e17-3a58-b96e-32cf78df275d",
                                                "text": "In sommige streken in het oosten van Nederland zijn 's winters soms midwinterhoorns te horen."
                                            },
                                            {
                                                "example_id": "ff7671e3-bba2-48cb-9b1c-73170660134a",
                                                "sense_id": "e7e30d9d-8e17-3a58-b96e-32cf78df275d",
                                                "text": "Sinds zondag kan er weer op de midwinterhoorn worden geblazen. Het was de eerste van de adventstijd. En elke rechtgeaarde blazer weet dat pas dan de eerste toon geblazen mag worden. En na Driekoningen (6 januari) moet het afgelopen zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
