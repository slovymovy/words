                                    },
                                    {
                                        "sense_id": "db98fbc9-5ba6-3fb0-84b6-cd41c12cf3a4",
                                        "entry_id": "b6485df1-2288-3fa4-825c-a02bc117e5e1",
                                        "glosses": [
                                            "die äußerste Schicht der Epidermis (Oberhaut)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd3fb2c-fae1-4d2e-b48d-4f81a8033bc8",
                                                "sense_id": "db98fbc9-5ba6-3fb0-84b6-cd41c12cf3a4",
                                                "text": "Die Hornhaut ist die oberste Hautschicht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ecac6b8b-81fd-3098-9aa4-46e8fb782cc6",
                                        "entry_id": "b6485df1-2288-3fa4-825c-a02bc117e5e1",
                                        "glosses": [
                                            "eine verdickte Hornschicht, häufig als Folge mechanischer Belastung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35a4eccb-b2f2-4bc6-b3c9-f157690d6b11",
                                                "sense_id": "ecac6b8b-81fd-3098-9aa4-46e8fb782cc6",
                                                "text": "Hornhaut bildet sich am häufigsten an den Füßen, da diese den ganzen Tag über belastet werden."
                                            },
                                            {
                                                "example_id": "15497abc-5a3c-42bd-882b-0af5ea53126d",
                                                "sense_id": "ecac6b8b-81fd-3098-9aa4-46e8fb782cc6",
                                                "text": "„An der Spitze seines rechten Daumens hatte er allmählich eine Hornhaut bekommen, und mit der konnte er eine Bierflasche öffnen: er hielt die Flasche am Hals fest und prellte den Verschluß mit dem Daumen ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
