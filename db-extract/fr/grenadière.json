                "forms": [
                    {
                        "form_id": "35024e05-137f-43be-9c41-143fc12051c6",
                        "entry_id": "91bc1897-5ae3-3ed7-bc1f-8954bffd5096",
                        "tags": [
                            "plural"
                        ],
                        "form": "grenadières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "af137d04-94a4-3fe0-891c-b530c4d878ae",
                        "entry_id": "91bc1897-5ae3-3ed7-bc1f-8954bffd5096",
                        "glosses": [
                            "Gibecière qui faisait autrefois partie de l’équipement d’un grenadier et dans laquelle il portait les grenades."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50fdaeef-226c-41c0-a315-3cf89fa2587b",
                                "sense_id": "af137d04-94a4-3fe0-891c-b530c4d878ae",
                                "text": "Ils portaient une hache, un sabre et une grenadière, ou sac de cuir, contenant 12 à 15 grenades."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6326c52-c9c3-3eb9-ad54-40bb9e34c417",
                        "entry_id": "91bc1897-5ae3-3ed7-bc1f-8954bffd5096",
                        "glosses": [
                            "Boucle sur le canon d’un fusil ou passait une bretelle permettant de porter le fusil à l’épaule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8db91db7-c7b9-437d-be6a-29673be33c00",
                                "sense_id": "a6326c52-c9c3-3eb9-ad54-40bb9e34c417",
                                "text": "On l’a appelé Grenadière, parce que les grenadiers de l’infanterie française portait en certaines circonstances en sautoir au moyen de la bretelle …. — (Étienne Alexandre Bardin, Oudinot de Reggio, Dictionnaire de l’armée de terre, Perrotin, 1841)"
                            },
                            {
                                "example_id": "17ce7843-9ef9-4a0d-99fb-63dc204439c4",
                                "sense_id": "a6326c52-c9c3-3eb9-ad54-40bb9e34c417",
                                "text": "Mettre son fusil à la grenadière : Le suspendre à l’épaule, en lâchant la bretelle de manière à avoir les mains libres."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a5ff42b-48f4-3387-87d3-340352194f52",
                        "entry_id": "91bc1897-5ae3-3ed7-bc1f-8954bffd5096",
                        "glosses": [
                            "Surnom donné aux brodeuses de la grenade, emblème de la gendarmerie et du corps des pompiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b20ee9c7-e4bd-482a-8b1a-a49f38f50bcc",
                                "sense_id": "0a5ff42b-48f4-3387-87d3-340352194f52",
                                "text": "Ces réalisations en grande série, brodées de cannetilles d’or leur valurent le nom de « grenadières »."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4bef596-eb30-3f89-94eb-dfe5a23612ee",
                        "entry_id": "91bc1897-5ae3-3ed7-bc1f-8954bffd5096",
                        "glosses": [
                            "Femme de haute taille qui a des manières libres et hardies."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4273bc65-74e3-4b4d-b56d-aa5f387225d0",
                                "sense_id": "d4bef596-eb30-3f89-94eb-dfe5a23612ee",
                                "text": "— J’étais une femme solide, je vous en réponds, continua-t-elle, et, dans le pays, on m’appelait la grenadière."
                            }
                        ]
                    }
                ],
