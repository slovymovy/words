                                "example_id": "0fb626af-a5b9-4623-866b-0272b66adedc",
                                "sense_id": "584c6023-04fd-3a86-92b2-9ce7de270db8",
                                "text": "Les héritiers contribuent à cette dépense au prorata de leurs parts et portions."
                            },
