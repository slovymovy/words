                    },
                    {
                        "translation_id": "6e7aad1f-3f48-4807-ac93-9493ceccd753",
                        "source_entry_id": "bb970e12-fc83-3ba2-a9fe-cecb2f2f81d8",
                        "source_sense_id": "845261b5-ceb2-30c7-b011-0829abee2b6f",
                        "target_lang_word": "chrome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chrome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4c34636-84c0-350d-a649-ff8af5f8e9ab",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Élément chimique métallique de symbole Cr et de numéro atomique 24."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8519aaac-40f3-4eb0-be21-dddb3427616e",
                                                "sense_id": "d4c34636-84c0-350d-a649-ff8af5f8e9ab",
                                                "text": "Mais les aciers ordinaires ne s'y prêtent pas : les aciers propres à la nitruration contiennent généralement du chrome ou de l'aluminium, métaux qui donnent facilement des nitrures."
                                            },
                                            {
                                                "example_id": "891d7ff4-8a30-46b3-a1b4-24539f28b0ee",
                                                "sense_id": "d4c34636-84c0-350d-a649-ff8af5f8e9ab",
                                                "text": "Jaune de chrome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d89ed2e8-25c9-3356-a5f0-6099367d839e",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Métal pur de cet élément, dur, d’une couleur gris acier argenté, résistant à la corrosion et au ternissement."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e6d8407-d22a-4580-858d-3b7263dd33b3",
                                                "sense_id": "d89ed2e8-25c9-3356-a5f0-6099367d839e",
                                                "text": "L'Anglais Harry Brearley obtint l'acier au chrome, donnant le jour aux couteaux inoxydables et s'attirant la reconnaissance des ménagères."
                                            },
                                            {
                                                "example_id": "668a1edc-7f6e-4084-90c3-a9c9192a9ca3",
                                                "sense_id": "d89ed2e8-25c9-3356-a5f0-6099367d839e",
                                                "text": "Il faut souligner que, si les aciers inoxydables ont connu l'extraordinaire développement que nous connaissons, cela est dû à la disponibilité à grande échelle des métaux entrant dans leur composition, c'est-à-dire le chrome, le nickel, le molybdène et le manganèse, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975552c1-5a04-3721-96ce-04670cdd9dae",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Pièce chromée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da1bea0f-aef7-47e3-a7d7-657636477930",
                                                "sense_id": "975552c1-5a04-3721-96ce-04670cdd9dae",
                                                "text": "Je passe un doigt ganté sur le chrome du lit. Pas un grain de poussière. Et (je me penche pour voir la lumière friser le métal) pas une empreinte."
                                            },
                                            {
                                                "example_id": "e9f529df-1241-4e4b-ba8c-fa2da199e052",
                                                "sense_id": "975552c1-5a04-3721-96ce-04670cdd9dae",
                                                "text": "Les chromes d'une voiture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9770b1b1-c3af-3d36-930c-d03a641683e0",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Tout accessoire décoratif, ajout superflu, etc."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db1bb4ef-a32d-416c-992f-6e604c0cad7d",
                                                "sense_id": "9770b1b1-c3af-3d36-930c-d03a641683e0",
                                                "text": "Ce site web est plein de chrome."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ac91ea-c4ec-3868-9882-97a0925dd035",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Les alliages de chrome, dans leur ensemble."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23d3ae1-0184-4f20-9afa-4e86bef5e654",
                                                "sense_id": "a1ac91ea-c4ec-3868-9882-97a0925dd035",
                                                "text": "Les ferro-chromes, les ferro-molybdènes, les ferro-siliciums et les ferro-manganèses."
                                            },
                                            {
                                                "example_id": "272884ba-f557-42cc-ab53-34b0306ab08b",
                                                "sense_id": "a1ac91ea-c4ec-3868-9882-97a0925dd035",
                                                "text": "En 1930, René Marie Victor Perrin invente un procédé […] de fabrication des ferro-chromes et ferro-manganèses à très bas carbone, […] etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5dfcfd0-09b4-36e5-b8ce-b127e8bacb78",
                                        "entry_id": "3575b2cc-b957-38af-aa1d-1283ececd345",
                                        "glosses": [
                                            "Jaune de chrome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab248af2-9617-49e8-a55a-7cda1524a3c6",
                                                "sense_id": "f5dfcfd0-09b4-36e5-b8ce-b127e8bacb78",
                                                "text": "Ton fin pour demi-teinte d'or (…) Base, chrome le plus clair."
                                            }
                                        ]
                                    }
                                ]
                            },
