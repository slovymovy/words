                        "examples": [
                            {
                                "example_id": "a72c96a8-c623-4ee5-ad3b-0525570d6abb",
                                "sense_id": "154bbe5c-3407-33d8-83a0-e9cd5dfe0194",
                                "text": "Smaak is in dit kader niet meer dan de trek van de lust en nog lang niet het schoonheidsgevoel en de waardering voor wat werkelijk lieftallig en beminnenswaardig is."
                            },
                            {
                                "example_id": "7896ecc5-f82f-4eb4-9a61-8f874488bbe5",
                                "sense_id": "154bbe5c-3407-33d8-83a0-e9cd5dfe0194",
                                "text": "Maar is zo'n vrouw op grond van haar knappe uiterlijk ook beminnelijk en beminnenswaardig? Niet altijd."
                            }
                        ]
                    }
