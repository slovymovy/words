                "senses": [
                    {
                        "sense_id": "dd1ee1c0-469b-30b3-9e6b-985e20315fd1",
                        "entry_id": "b6f5140e-84f4-3518-ad89-dbb35bab470d",
                        "glosses": [
                            "The state of being grand or splendid; magnificence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b96e1fe-a732-4020-aea4-d4b73ea1fe7a",
                                "sense_id": "dd1ee1c0-469b-30b3-9e6b-985e20315fd1",
                                "text": "I wrapp’d myself in grandeur then,\nAnd donn’d a visionary crown ——"
                            },
                            {
                                "example_id": "4ac835cd-b194-4178-803d-bf0ae0f5d2b5",
                                "sense_id": "dd1ee1c0-469b-30b3-9e6b-985e20315fd1",
                                "text": "So much of what followed from the drawing boards of others will have been designed with the demands, effort and grandeur of Primrose Hill [tunnel] in the back of their minds."
                            },
                            {
                                "example_id": "b101be62-0430-4c4f-9a8e-a72e4f677c21",
                                "sense_id": "dd1ee1c0-469b-30b3-9e6b-985e20315fd1",
                                "text": "In a tightly choreographed ceremony filled with imperial grandeur, Xi and Putin then walked towards each other and met in the middle, smiling as they shook hands."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a38a491-dc4b-3902-9c99-d6f3f6a1153b",
                        "entry_id": "b6f5140e-84f4-3518-ad89-dbb35bab470d",
                        "glosses": [
                            "Nobility (state of being noble)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8c4c5861-9bda-356d-a9a7-5b9598c0ce14",
                        "entry_id": "b6f5140e-84f4-3518-ad89-dbb35bab470d",
                        "glosses": [
                            "Greatness; largeness; tallness; loftiness."
