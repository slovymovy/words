                        ],
                        "examples": [
                            {
                                "example_id": "e1e7fe2a-774b-4a19-a5a0-8730fa967630",
                                "sense_id": "9707a462-4ee7-3c14-9ca6-fbe148053db2",
                                "text": "Betzy was een diepgelovige vrouw die al op jonge leeftijd als verpleegster en evangeliste naar Lapland trok."
                            },
                            {
                                "example_id": "36460747-a6d5-412e-bd2b-1e20b8500809",
                                "sense_id": "9707a462-4ee7-3c14-9ca6-fbe148053db2",
                                "text": "In dorpshuis de Hesselerhof in Oosterhesselen worden op de dinsdagen 10, 17 en 24 maart luistersamenkomsten gehouden voor mensen die geïnteresseerd zijn in de Bijbel. Initiatiefneemsters zijn twee evangelistes, die hun ervaringen delen met het publiek."
                            }
                        ]
                    },
                    {
                        "sense_id": "6be3a329-1daa-3d8f-8b5c-076150caabec",
                        "entry_id": "de736890-e8f5-35a1-aaf7-ad9f75973afb",
                        "glosses": [
                            "vrouw die voortdurend andere mensen probeert te overtuigen dat ze een bepaalde opvatting of handelwijze moeten navolgen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a119a77a-85c9-4e72-9417-409907c56eb6",
                                "sense_id": "6be3a329-1daa-3d8f-8b5c-076150caabec",
                                "text": "Groei zit ook in de seniorenmarkt; de branche heeft in de 77-jarige Dini ten Wolde een vurig evangeliste voor bejaarden-fitness gevonden."
                            }
                        ]
                    }
