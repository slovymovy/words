                        "glosses": [
                            "The production or condition of tetanus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "06046d00-52e3-461d-924c-348c43b96713",
                                "sense_id": "16a56a62-db14-327e-a4c3-dde255f1a554",
                                "text": "Muscle which has been tetanized produces less acid than muscle which has been at rest; in fact the tetanization of muscle seems to consume the acid-forming matter."
                            },
                            {
                                "example_id": "589b4efa-554a-4093-aa1e-5ab4f8334e66",
                                "sense_id": "16a56a62-db14-327e-a4c3-dde255f1a554",
                                "text": "The position of the internal capsule is determined with microelectrodes by its characteristic absence of somatodendritic action potentials and the tetanization produced by stimulating corticospinal tract fibers."
                            },
                            {
                                "example_id": "58e382f3-9760-4b2a-86c9-b22964b40076",
                                "sense_id": "16a56a62-db14-327e-a4c3-dde255f1a554",
                                "text": "Heterosynaptic, long-term plastic changes can be induced in hippocampal and neocortical neurons by intracellular tetanization—bursts of spikes evoked by short, depolarizing pulses applied through the recording electrode."
                            }
                        ]
                    }
