                                        "entry_id": "2e82b171-3e97-398c-9daa-08a0d8ec5f08",
                                        "glosses": [
                                            "A personality disorder characterized by impaired empathy and remorse, and bold, disinhibited, and egocentric traits masked by superficial charm and the outward presence of apparent normality. Violent and criminal offenses may be indicative of this disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e607e41-2162-34d0-b13c-67997b07688c",
                                        "entry_id": "2e82b171-3e97-398c-9daa-08a0d8ec5f08",
                                        "glosses": [
                                            "A mental illness; insanity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47523b8f-ee49-49c7-828a-a26b43b4fd48",
                                                "sense_id": "7e607e41-2162-34d0-b13c-67997b07688c",
                                                "text": "It is true that insanity may originate in the mind, as well as in the body, but diseased action must take place in the brain, otherwise we have not, as has been well observed, “a true psychopathy.”"
                                            }
                                        ]
                                    }
