                    }
                ],
                "senses": [
                    {
                        "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                        "entry_id": "2231eff5-f82b-349e-a6b6-b05997561f73",
                        "glosses": [
                            "A raised platform in an early Christian church, as well as in the Eastern Orthodox, Oriental Orthodox, and Eastern Catholic churches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf8287c5-4471-4358-8ace-dc6952304aff",
                                "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                                "text": "‘It will get better somehow,’ he thought, and went to the ambo. On going up the steps and turning to the right he saw the priest."
                            },
                            {
                                "example_id": "dd15b394-662d-4772-90ad-202f99fd20ee",
                                "sense_id": "d2a7221b-1f9e-3835-a1c8-43c8122b23ed",
                                "text": "the Emperor arrived and instead of moving directly to his seat climbed to the top level of the ambo, the great three-decker pulpit of polychrome marble."
                            }
                        ]
                    },
                    {
                        "sense_id": "4596fa4b-bbc3-3bdc-8c7b-ba6fe69f0c01",
                        "entry_id": "2231eff5-f82b-349e-a6b6-b05997561f73",
                        "glosses": [
                            "A stationary podium used for readings and homilies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc692389-bfea-49c5-803b-172ca3fe84eb",
                                "sense_id": "4596fa4b-bbc3-3bdc-8c7b-ba6fe69f0c01",
                                "text": "The dignity of the Word of God requires that in the church there be a suitable place from which it may be proclaimed and toward which the attention of the faithful naturally turns during the Liturgy of the Word. It is appropriate that generally this place be a stationary ambo and not simply a movable lectern."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b6c6e16-daa9-4f4e-bf8c-4687ddb21bae",
                        "source_entry_id": "2231eff5-f82b-349e-a6b6-b05997561f73",
                        "source_sense_description": "raised platform",
                        "target_lang_word": "ambon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ambon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf71f2be-9fe9-3aba-9349-da84a8b0e135",
                                        "entry_id": "bef1b739-3cc0-3e8f-8aaf-19ba9920d06e",
                                        "glosses": [
                                            "Lieu surélevé d’où est lue la Bible pendant la messe, placé à l’entrée du chœur dans une église. L’ambon a au cours du temps pris la forme d’une tribune ou d’un lutrin ; il est parfois confondu avec le jubé ou la chaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfda1962-00c8-4083-94e0-b6ea2abaf14c",
                                                "sense_id": "cf71f2be-9fe9-3aba-9349-da84a8b0e135",
                                                "text": "À l’entrée du chœur était l’ambon, c’est-à-dire une tribune élevée où l’on montait des deux côtés, servant aux lectures publiques, nommée depuis pupitre, lutrin ou jubé."
                                            },
                                            {
                                                "example_id": "5319d09b-f70a-4a2d-9d6d-28b64aa9641e",
                                                "sense_id": "cf71f2be-9fe9-3aba-9349-da84a8b0e135",
                                                "text": "Bientôt on établit un ambon pour les lectures et les sermons, puis un cancel de séparation entre le presbyterium et le reste de la salle."
                                            },
                                            {
                                                "example_id": "4f2fbfc1-368d-46df-bcd1-a9c3b02ed9b7",
                                                "sense_id": "cf71f2be-9fe9-3aba-9349-da84a8b0e135",
                                                "text": "Dans les églises primitives, il n'y avait pas, à proprement parler, de chaires à prêcher, mais deux ambons ou pupitres placés des deux côtés du chœur pour lire l'épître et l'Évangile aux fidèles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17d82791-e9d2-3726-820d-704720fedf36",
                                        "entry_id": "bef1b739-3cc0-3e8f-8aaf-19ba9920d06e",
                                        "glosses": [
                                            "Bord cartilagineux qui environne la cavité d’un os."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c4ff74b7-706a-3efe-936d-87113f43acdc",
                                        "entry_id": "bef1b739-3cc0-3e8f-8aaf-19ba9920d06e",
                                        "glosses": [
                                            "Bordage de chêne posé sur le pont d’un vaisseau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53d4eba5-d7d2-3e50-b966-dfa4a0f7335e",
                                        "entry_id": "bef1b739-3cc0-3e8f-8aaf-19ba9920d06e",
                                        "glosses": [
                                            "Arbre des Indes-Orientales de la forme du néflier et dont le fruit ressemble à une prune blanche."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
