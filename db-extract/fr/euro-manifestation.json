                        "entry_id": "06f7c17f-1935-3598-88ff-8f3dbf7be8e5",
                        "glosses": [
                            "manifestation relative à l’Union européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca6f97d9-56dc-41eb-9d7b-0f62bd1516f9",
                                "sense_id": "8016b521-1c13-3093-8361-cb6f875208d2",
                                "text": "Cette « euro-manifestation », la première de l’année 2014, vise à réclamer une « nouvelle voie pour l’Europe » via des investissements, une croissance durable et des emplois de qualité."
                            },
                            {
                                "example_id": "8e8f97d7-adb5-408d-86f6-430e7a520f48",
                                "sense_id": "8016b521-1c13-3093-8361-cb6f875208d2",
                                "text": "Comme ces grandes journées de mobilisation, des “euro-manifestations” qui ces dernières années sont clairement dirigées contre les plans d’austérité."
                            },
                            {
                                "example_id": "4bf811a3-2bda-4a2e-a62c-79e5dda2c8d2",
                                "sense_id": "8016b521-1c13-3093-8361-cb6f875208d2",
                                "text": "Un signe parmi d’autres : l’euro-manifestation que la Confédération européenne des syndicats (CES) a organisée, le 5 avril, à Ljubljana, qui a réuni 20 000 syndicalistes venus de 23 pays, avait pour thème : « À l’offensive pour des salaires équitables. »"
                            }
                        ]
                    }
