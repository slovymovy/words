                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0545a89b-ce6a-49c2-bd90-b63db4c6cb35",
                                "sense_id": "eabe264a-8111-3076-85a5-9bb35fee71f8",
                                "text": "The Voice Senior is een nieuwe variant op het succesvolle The Voice-concept, ditmaal met bejaarden. De eerste uitzending trok vorige week vrijdag een miljoenenpubliek. Nederland is het eerste land waarin deze spin-off van de reguliere The Voice te zien is."
                            },
                            {
                                "example_id": "8650759d-2304-472a-8dc6-0b25adfad90d",
                                "sense_id": "eabe264a-8111-3076-85a5-9bb35fee71f8",
                                "text": "The Hills ontstond in 2006 als spin-off van de realityserie Laguna Beach: The Real Orange County, die van 2004 tot 2006 op de buis was. De serie was een geacteerde realityserie waarin het leven van rijke kinderen in Beverly Hills werd gevolgd, een knipoog naar de tv-serie Beverly Hills 90210."
                            },
                            {
                                "example_id": "5f7aaada-8ee9-4b96-9d9f-6088de9da12d",
                                "sense_id": "eabe264a-8111-3076-85a5-9bb35fee71f8",
                                "text": "In de spin-off van sitcom Roseanne is de moeder des huizes met die naam overleden. Dat blijkt uit een interview met John Goodman, die in de serie haar man Dan speelt."
                            }
                        ]
