                        "examples": [
                            {
                                "example_id": "c7291f5d-348c-4627-a899-8c590fc98555",
                                "sense_id": "a203618b-461a-33a3-83cb-1669f00ee858",
                                "text": "Ashame thou, Sidon, seith the se, the strengthe of the se, seiende, I trauailide not with child, and bar not, and nurshede not out ȝung childer, ne to ful waxing broȝte forth maidenes.",
                                "translation": "Be ashamed, Sidon, says the sea, the strength of the sea, saying, “I did not travail with child [give birth], and did not nurse boys, nor to full waxing bring forth maidens.",
                                "english": "Be ashamed, Sidon, says the sea, the strength of the sea, saying, “I did not travail with child [give birth], and did not nurse boys, nor to full waxing bring forth maidens."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                        "entry_id": "5b7808fd-a30d-32ac-ab93-42401a30436f",
                        "glosses": [
                            "To make ashamed; to shame."
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7e823ebc-d283-4da2-bde9-808c7b16fa84",
                                "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                                "text": "I am young Woman indifferently well brought up in the Country, and might raiſe my fortune conſiderably had I not got ſuch a Habit of Sweating, which quite aſhames me, when in Company, to ſee my Face of a dewy Sweat, and the generality complain of Cold."
                            },
                            {
                                "example_id": "c802df01-f751-4cda-926c-9f4d0519af26",
                                "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                                "text": "The notice annoyed and ashamed him."
                            },
                            {
                                "example_id": "05c1d085-86e6-4b4b-84d6-bdbe8a6be16d",
                                "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                                "text": "If it is one Minister who has done it he has ashamed us all and the title \"Minister\" will not be respected anymore."
                            },
                            {
                                "example_id": "54fafb36-e162-4789-a044-f6a84d395e9d",
                                "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                                "text": "They would think that I had abandoned them, that I could not handle the stress and pressure and this ashamed me immensely."
                            },
                            {
                                "example_id": "2ff9e329-7ccb-4b0f-92ed-e918ebd46b3e",
                                "sense_id": "c0aafd4f-37b7-324f-b1a4-b89a5ab714b4",
                                "text": "“As a nation, our head is bloodied but unbowed,” Kenyan President Uhuru Kenyatta said in a televised address, declaring three days of mourning. “We have ashamed and defeated our attackers.”"
                            }
                        ]
