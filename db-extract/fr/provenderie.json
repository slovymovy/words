                        "glosses": [
                            "Fabrication ou commerce de provende, mélange alimentaire destiné aux animaux d’élevage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98f6363a-0c93-43da-ab0b-d027b8d4cf8e",
                                "sense_id": "39938686-fdca-3552-a497-18cab467a58c",
                                "text": "Cette société de rizerie et de provenderie transforme le « riz cargo » en riz blanc (de luxe et courant), ce qui génère des sous-produits (son et brisure) qui intéressent les éleveurs de volailles notamment."
                            }
                        ]
                    },
                    {
                        "sense_id": "03cfca19-b6f2-3fe8-b74e-8c05c1086d44",
                        "entry_id": "f2e8ade5-3271-3bee-bc8b-1de63ebd1f02",
                        "glosses": [
                            "Installation permettant de produire un mélange alimentaire destiné aux animaux d’élevage."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "b69b0c26-1121-49f5-ab66-c99dda03331d",
                                "sense_id": "03cfca19-b6f2-3fe8-b74e-8c05c1086d44",
                                "text": "Dans celui-ci [système semi-intensif], toutes les substances nutritives nécessaires aux oiseaux doivent être procurées par les aliments, généralement sous forme de composés équilibrés, fournis par une provenderie."
                            }
                        ]
