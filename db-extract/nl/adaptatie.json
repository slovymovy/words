                    },
                    {
                        "translation_id": "752cdb92-d22e-4ed5-bb54-ddace012dea4",
                        "source_entry_id": "6450dbd1-eb61-3bf7-8fa5-f1c2f7ae1c9b",
                        "source_sense_id": "5fea8d54-8ecd-38e0-9bd3-ab030a8d5ea0",
                        "source_sense_description": "aanpassingsvermogen",
                        "target_lang_word": "adaptation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adaptation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f5fdb1-225a-365b-9611-e37fc14009b0",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "The process of adapting something or becoming adapted to a situation; adjustment, modification."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caba84f2-8439-45ae-8e45-9f4b7deffe18",
                                                "sense_id": "e8f5fdb1-225a-365b-9611-e37fc14009b0",
                                                "text": "To sum up, the Furka-Oberalp Railway is a good example of the adaptation of the rack-and-pinion system to a main line over mountainous terrain."
                                            },
                                            {
                                                "example_id": "71d91d94-e7d6-47d6-aca8-6083929e24d4",
                                                "sense_id": "e8f5fdb1-225a-365b-9611-e37fc14009b0",
                                                "text": "Lifestyle adaptation arises because people inevitably encounter a gap between the style of life they desire and the actual resources they control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbae20fc-1dd0-3933-8726-6a2003f99d3f",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "A change that is made or undergone to suit a condition or environment."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35d34df8-3b0b-4fee-b5c1-10f9365620b4",
                                                "sense_id": "fbae20fc-1dd0-3933-8726-6a2003f99d3f",
                                                "text": "It's staggering because these adaptations to your schedule can dramatically change your life forever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2210881e-eb5c-3a80-92c2-242a918935c4",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "The process of change that an organism undergoes to be better suited to its environment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83e93649-cc36-4d43-8f6b-5c95c1cde713",
                                                "sense_id": "2210881e-eb5c-3a80-92c2-242a918935c4",
                                                "text": "ACCLIMATIZATION, the process of adaptation by which animals and plants are gradually rendered capable of surviving and flourishing in countries remote from their original habitats, or under meteorological conditions different from those which they have usually to endure, and at first injurious to them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "498f8b61-df76-3165-8047-32fae9be5507",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "An instance of an organism undergoing change, or the structure or behavior that is changed."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b50225-ac02-49b2-9ba3-3737a17a080f",
                                                "sense_id": "498f8b61-df76-3165-8047-32fae9be5507",
                                                "text": "This is the very method adopted, in the structure of the eye, to produce a perfect picture on the retina; it is an adaptation to the laws of light, and the property of color, in natural objects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8ce9a7d-9615-30d5-9cd0-bb4d413f4370",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "The process of adapting an artistic work from a different medium."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c4caacb-90a3-45e0-950a-c14e1d3ddd43",
                                                "sense_id": "e8ce9a7d-9615-30d5-9cd0-bb4d413f4370",
                                                "text": "Plays are rich and suitable sources for adaptation to film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "681aa9c8-5b57-3d4a-a4b2-42b06db3a24f",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "An artistic work that has been adapted from a different medium."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b68eaa01-8c6d-4e51-95df-ccc798eb393b",
                                                "sense_id": "681aa9c8-5b57-3d4a-a4b2-42b06db3a24f",
                                                "text": "Having partly a bibliographic value, and partly confirming the statements above as to Balzac's influence, the following details concerning theatrical adaptations of some of his novels may serve as a supplement to this chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0537ede4-9d14-3c7f-926a-2e0b49928d10",
                                        "entry_id": "88298fd2-2add-3ad4-b00a-e3147271eab1",
                                        "glosses": [
                                            "The means by which social groups adapt to different social and physical environments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
