                ],
                "senses": [
                    {
                        "sense_id": "330d006e-f0f8-3124-bc6b-3b13d20b3a9e",
                        "entry_id": "f4750149-43ff-3c61-9d48-84cb7d2667c7",
                        "glosses": [
                            "alle vertrekken in een gebouw die een vloer hebben die op dezelfde hoogte ligt, uitgezonderd zolder en souterrain"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de1bc134-0019-4c26-94de-9945ad83a9c8",
                                "sense_id": "330d006e-f0f8-3124-bc6b-3b13d20b3a9e",
                                "text": "De voormalige gezondheidszorgpraktijk maakt dus plek voor in totaal zes huizen. Het witte langgerekte gebouw bestaat uit een bouwlaag met zolder."
                            },
                            {
                                "example_id": "d59f79f1-dcdb-44f7-bd1a-8ac521a7a0b9",
                                "sense_id": "330d006e-f0f8-3124-bc6b-3b13d20b3a9e",
                                "text": "Van Hoorik is opgelucht nu de gemeente met geld over de brug is gekomen. Het oorspronkelijke plan van twee bouwlagen gaat overigens in de prullenbak. Het is te kostbaar en heeft ook niet de voorkeur van Van Hoorik. Zij pleitte in eerste instantie voor een kattenasiel bestaande uit maar één verdieping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9c8d335-66a7-48fc-a4ee-28ec6c4628b8",
                        "source_entry_id": "f4750149-43ff-3c61-9d48-84cb7d2667c7",
                        "source_sense_id": "330d006e-f0f8-3124-bc6b-3b13d20b3a9e",
                        "source_sense_description": "alle vertrekken in een gebouw die een vloer hebben die op dezelfde hoogte ligt, uitgezonderd zolder en souterrain",
                        "target_lang_word": "floor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46cea428-9ffc-3e31-afce-1549aed43c6d",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The interior bottom or surface of a house or building; the supporting surface of a room."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dad601c6-b8a6-4216-83c1-b1edb2154b15",
                                                "sense_id": "46cea428-9ffc-3e31-afce-1549aed43c6d",
                                                "text": "The room has a wooden floor."
                                            },
                                            {
                                                "example_id": "db6bd2ff-ab1c-4da3-800e-8b77f9cb1486",
                                                "sense_id": "46cea428-9ffc-3e31-afce-1549aed43c6d",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0e5305-5d56-3a48-a4c1-6c93362862c8",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The bottom surface of a natural structure, entity, or space (e.g. cave, forest, ocean, desert, etc.); the ground (surface of the Earth)."
                                        ],
                                        "tags": [
                                            "with a modifier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de04c46-37a1-4af1-b996-d11ccfb17df8",
                                                "sense_id": "7a0e5305-5d56-3a48-a4c1-6c93362862c8",
                                                "text": "The leaves covering the forest floor provide many hiding-places for small animals."
                                            },
                                            {
                                                "example_id": "1c4819da-a274-4a21-ba08-8b196b7bb1bd",
                                                "sense_id": "7a0e5305-5d56-3a48-a4c1-6c93362862c8",
                                                "text": "Many sunken ships rest on the ocean floor."
                                            },
                                            {
                                                "example_id": "5222c340-cb8e-4643-93a8-11fb6f7592b2",
                                                "sense_id": "7a0e5305-5d56-3a48-a4c1-6c93362862c8",
                                                "text": "The floor of a cave served the refugees as a home."
                                            },
                                            {
                                                "example_id": "f93458c9-7094-449a-acfc-0bef77b463f1",
                                                "sense_id": "7a0e5305-5d56-3a48-a4c1-6c93362862c8",
                                                "text": "The pit floor showed where a ring of post holes had been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7d26297-3346-3e46-b749-4eb7744d1b71",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The ground."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56664944-c902-41c3-a0bf-06042c0b25bc",
                                                "sense_id": "e7d26297-3346-3e46-b749-4eb7744d1b71",
                                                "text": "After stepping off the bus, my wallet fell on the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eda0043e-5af6-3e69-8efe-a8ffb607f36f",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A structure formed of beams, girders, etc, with proper covering, which divides a building horizontally into storeys/stories."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3e1bdab-4468-37f8-816b-ec728dfe1300",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The supporting surface or platform of a structure such as a bridge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31d6d6d1-453f-4525-b48d-2c72ba6d8d10",
                                                "sense_id": "b3e1bdab-4468-37f8-816b-ec728dfe1300",
                                                "text": "Wooden planks of the old bridge's floor were nearly rotten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78a1f454-58c0-3453-b930-212df85d410b",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A storey/story of a building."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbee0423-234d-4d9d-bbbc-e0cdc9cfdeed",
                                                "sense_id": "78a1f454-58c0-3453-b930-212df85d410b",
                                                "text": "For years we lived on the third floor."
                                            },
                                            {
                                                "example_id": "bf0e6b02-42f9-4d78-844e-9bf4fc25fbc0",
                                                "sense_id": "78a1f454-58c0-3453-b930-212df85d410b",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him. He had him gripped firmly by the arm, since he felt it was not safe to let him loose, and he had no immediate idea what to do with him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b258b65-ec36-3836-b49d-bbcadbc9d731",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "In a parliament, the part of the house assigned to the members, as opposed to the viewing gallery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8b157c7-3584-346b-bfe6-3252fafceaed",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "The right to speak at a given time during a debate or other public event."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06dd773-c04e-4160-a1df-178964104437",
                                                "sense_id": "f8b157c7-3584-346b-bfe6-3252fafceaed",
                                                "text": "Will the senator from Arizona yield the floor?"
                                            },
                                            {
                                                "example_id": "48fb9b3b-6b4a-4a7f-8fa3-0d7ab6a307eb",
                                                "sense_id": "f8b157c7-3584-346b-bfe6-3252fafceaed",
                                                "text": "The mayor often gives a lobbyist the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "777b92ff-d62d-3ff4-9184-01112254ef5c",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "That part of the bottom of a vessel on each side of the keelson which is most nearly horizontal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c65e1cda-7235-3181-add9-1370a583d0df",
                                        "entry_id": "37f52095-8ddf-3d1f-9a0a-3769d8c921d7",
                                        "glosses": [
                                            "A horizontal, flat ore body; the rock underlying a stratified or nearly horizontal deposit."
                                        ],
