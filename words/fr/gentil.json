                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "desapprobation_ironie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je te trouve <w>gentil</w> de me parler sur ce ton devant tout le monde !"
                        },
                        {
                            "text": "Ah, je suis <w>gentille</w>, moi, de t'aider alors que tu ne dis même pas merci !"
