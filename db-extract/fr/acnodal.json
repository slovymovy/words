                "senses": [
                    {
                        "sense_id": "cfd4431b-7360-3735-a1f9-4c090c0db14b",
                        "entry_id": "ab637839-b58a-383d-8898-749394c78dc2",
                        "glosses": [
                            "Qualifie une courbe qui possède un point isolé qui n’est pas sur cette courbe, appelé acnode, mais dont les coordonnées vérifient l’équation de la courbe de sorte qu’il est considéré comme appartenant à la courbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9df634cd-6337-4804-a82f-111de9478061",
                                "sense_id": "cfd4431b-7360-3735-a1f9-4c090c0db14b",
                                "text": "A une droite, elle fait correspondre une cubique ayant un point acnodal à l’origine, dont les tangentes en ce point sont isotropes et dont deux asymptotes sont parallèles aux axes."
                            }
                        ]
                    }
                ],
