                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc999f2a-58eb-414d-a2db-d1c0ace29619",
                                "sense_id": "28b16405-c120-3f9a-9322-4994ca797da0",
                                "text": "Le contrat de partage de production, comme la concession, autorise en exclusivité le contractant à conduire à son propre risque des travaux d’exploration sur un domaine minier."
                            }
                        ]
                    }
                ],
