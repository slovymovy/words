                    {
                        "sense_id": "7cf9cc91-48ea-35f3-87f8-c00c16dc35d8",
                        "entry_id": "b0dea198-2551-382e-a7d3-a2cb3b3f78b7",
                        "glosses": [
                            "Relatif à Salman Rusdie ou à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ef2e0e-e6e7-4fe5-b39e-c1fe231cacbb",
                                "sense_id": "7cf9cc91-48ea-35f3-87f8-c00c16dc35d8",
                                "text": "De la même façon, l’écriture rushdienne transcrit la langue de S.S. Sisodia et la « brissétise », en recourant en permanence sur la décomposition des syntagmes pour en exploiter les ambiguïtés et les calembours jaillissant de l’homophonie."
                            },
                            {
                                "example_id": "b7d89f15-0a12-44d9-9e9d-2b3f205d07b9",
                                "sense_id": "7cf9cc91-48ea-35f3-87f8-c00c16dc35d8",
                                "text": "Il déploie d’abord quelques outils de l’Art qui réfutent leurs emprunts rushdiens de noétique naturelle."
                            },
                            {
                                "example_id": "f345780f-90c4-4e40-a27b-83220be4a216",
                                "sense_id": "7cf9cc91-48ea-35f3-87f8-c00c16dc35d8",
                                "text": "Il s’agit plutôt de décrire ce qu’il lit pour déterminer comment se mettent en place, dans le passage des propositions rushdiennes au sein des disputes latines, quelques aspects remarquables de leur inévitable transfiguration."
                            }
                        ]
                    }
