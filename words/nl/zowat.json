{
    "word_family": [
        "wat",
        "zo"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b0c7194f-2184-3db6-a7cb-03a2424394d9",
                    "sense_definition": "bijna helemaal of nagenoeg volledig",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "benadering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zowat</w> iedereen in de klas heeft het huiswerk op tijd ingeleverd.",
                            "target_lang_translations": {
                                "en": "<w>Just about</w> everyone in the class handed in their homework on time.",
                                "fr": "<w>Presque</w> tout le monde dans la classe a rendu ses devoirs à temps."
                            }
                        },
                        {
                            "text": "Ik heb <w>zowat</w> alles geprobeerd om de computer weer aan de praat te krijgen.",
                            "target_lang_translations": {
                                "en": "I have tried <w>almost</w> everything to get the computer working again.",
                                "fr": "J'ai essayé <w>presque</w> tout pour faire refonctionner l'ordinateur."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijna"
                    ],
                    "common_phrases": [
                        "zowat iedereen",
                        "zowat alles"
                    ],
                    "target_lang_definitions": {
                        "en": "almost completely or nearly entirely",
                        "fr": "presque entièrement ou presque totalement"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "just about",
                                "target_lang_sense_clarification": "nearly everything or everyone"
                            },
                            {
                                "target_lang_word": "almost",
                                "target_lang_sense_clarification": "nearly all"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "all but a few"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "presque",
                                "target_lang_sense_clarification": "presque tout ou presque tout le monde"
                            },
                            {
                                "target_lang_word": "quasi",
                                "target_lang_sense_clarification": "quasiment la totalité"
                            },
                            {
                                "target_lang_word": "environ",
                                "target_lang_sense_clarification": "à peu près tout"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d69289af-186b-3f59-b544-787db7d09b11",
                    "sense_definition": "geeft een benadering aan van een actie of toestand die bijna plaatsvond",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benadering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd <w>zowat</w> uit zijn auto geslingerd door de kracht van die botsing.",
                            "target_lang_translations": {
                                "en": "He was <w>practically</w> thrown out of his car by the force of that collision.",
                                "fr": "Il a <w>presque</w> été éjecté de sa voiture par la force de cet impact."
                            }
                        },
                        {
                            "text": "Ik rende <w>zowat</w> de berg op om op tijd bij de top te zijn.",
                            "target_lang_translations": {
                                "en": "I <w>nearly</w> ran up the mountain to be at the top on time.",
                                "fr": "J'ai <w>pratiquement</w> couru pour gravir la montagne afin d'être au sommet à temps."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijna"
                    ],
                    "common_phrases": [
                        "zowat uit de bocht"
                    ],
                    "target_lang_definitions": {
                        "en": "indicates an approximation of an action or state that almost occurred",
                        "fr": "indique une approximation d'une action ou d'un état qui a failli se produire"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "practically",
                                "target_lang_sense_clarification": "as if it actually happened"
                            },
                            {
                                "target_lang_word": "all but",
                                "target_lang_sense_clarification": "very nearly"
                            },
                            {
                                "target_lang_word": "nearly",
                                "target_lang_sense_clarification": "close to happening"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "presque",
                                "target_lang_sense_clarification": "à deux doigts de se produire"
                            },
                            {
                                "target_lang_word": "pratiquement",
                                "target_lang_sense_clarification": "comme si cela s'était produit"
                            },
                            {
                                "target_lang_word": "faillir",
                                "target_lang_sense_clarification": "avoir manqué de peu de faire quelque chose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f50a282-be00-3eb5-8124-2a67d052609b",
                    "sense_definition": "in praktische zin of feitelijk gezien",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "benadering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met die opmerking geeft hij <w>zowat</w> het hele antwoord al weg.",
                            "target_lang_translations": {
                                "en": "With that remark, he <w>virtually</w> gives away the entire answer already.",
                                "fr": "Avec cette remarque, il donne <w>pour ainsi dire</w> déjà toute la réponse."
                            }
                        },
                        {
                            "text": "Het is <w>zowat</w> onmogelijk om in deze drukke stad een parkeerplaats te vinden.",
                            "target_lang_translations": {
                                "en": "It is <w>pretty much</w> impossible to find a parking spot in this busy city.",
                                "fr": "Il est <w>pratiquement</w> impossible de trouver une place de parking dans cette ville animée."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijna"
                    ],
                    "common_phrases": [
                        "zowat onmogelijk"
                    ],
                    "target_lang_definitions": {
                        "en": "in a practical sense or factually speaking",
                        "fr": "au sens pratique ou d'un point de vue factuel"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "virtually",
                                "target_lang_sense_clarification": "for all practical purposes"
                            },
                            {
                                "target_lang_word": "pretty much",
                                "target_lang_sense_clarification": "informal way to say essentially"
                            },
                            {
                                "target_lang_word": "essentially",
                                "target_lang_sense_clarification": "in essence"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "virtuellement",
                                "target_lang_sense_clarification": "pratiquement en fait"
                            },
                            {
                                "target_lang_word": "pour ainsi dire",
                                "target_lang_sense_clarification": "façon de parler pour exprimer la quasi-certitude"
                            },
                            {
                                "target_lang_word": "pratiquement",
                                "target_lang_sense_clarification": "en pratique"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}