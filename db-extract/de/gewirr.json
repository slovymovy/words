                    {
                        "sense_id": "bba1ad6a-38b9-3b3d-addb-0567fafc9834",
                        "entry_id": "b0c6ae21-3048-39c1-8675-eea5519f4be4",
                        "glosses": [
                            "auf den ersten Eindruck hin undurchschaubares Durcheinander von irgendwelchen Dingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bb9e08-d6e1-4dc7-ad3c-bc0781a56edf",
                                "sense_id": "bba1ad6a-38b9-3b3d-addb-0567fafc9834",
                                "text": "Auf dem Markt herrscht ein Gewirr von Menschen aller Altersstufen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e656feb0-79ce-4682-b14a-286ee60d0c18",
                        "source_entry_id": "b0c6ae21-3048-39c1-8675-eea5519f4be4",
                        "source_sense_id": "bba1ad6a-38b9-3b3d-addb-0567fafc9834",
                        "source_sense_description": "auf den ersten Eindruck hin undurchschaubares Durcheinander von irgendwelchen Dingen",
                        "target_lang_word": "tangle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d26a558f-2637-389d-a80c-8c83d1ee8d64",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To mix together or intertwine."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To become mixed together or intertwined."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2873175a-a9e8-42b0-9a36-9782fdbb8323",
                                                "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                                "text": "Her hair was tangled from a day in the wind."
                                            },
                                            {
                                                "example_id": "a3f4607c-a914-4a3c-8f0d-70a91bec5fec",
                                                "sense_id": "5f43a864-c350-3e6f-908b-3d5679cfad50",
                                                "text": "By the afternoon it seemed as if the storm had passed and that frost was setting in; but in the evening the wind rose to gale force, bringing telegraph poles down like skittles and tangling power and telephone lines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To enter into an argument, conflict, dispute, or fight."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "463a4562-367e-47ed-836a-bb2760cc2164",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "Don't tangle with someone three times your size."
                                            },
                                            {
                                                "example_id": "4be7dc12-caaa-4384-aaa9-a00be9e6f683",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "He tangled with the law."
                                            },
                                            {
                                                "example_id": "3df7ebef-7096-48ea-87b1-7b52d3bb8dc1",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "Compared to the last time they'd tangled with the U.S. Navy's carriers, the antiaircraft fire had been much, much more effective, even if the Wildcats hadn't done particularly well in their intercepts. They couldn't know it, of course, but the officer aboard Enterprise who'd recommended recarpeting the ship with 20-mm Oerlikons had, at least partially, been listened to, and the effect on the Japanese Navy's elite aircrews had been devastating."
                                            },
                                            {
                                                "example_id": "8ada5550-f47e-4471-b605-293858034888",
                                                "sense_id": "312e5e24-e428-38be-b648-36f146774a38",
                                                "text": "After a few attempts at counseling, they separated in January 2015. Since then, they have tangled in the courts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                        "entry_id": "3b2fcbfe-22dc-3027-a6a5-fd5765835834",
                                        "glosses": [
                                            "To catch and hold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9bea344-16f0-4438-9561-9da2da70dba0",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "When my simple weakness strays, / Tangled in forbidden ways."
                                            },
                                            {
                                                "example_id": "2f74f1a2-157a-44e9-a435-3611c1fd767e",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "tangled in amorous nets"
                                            },
                                            {
                                                "example_id": "49b48468-190c-49e3-bfb7-3f62a5309334",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "This is a book about the potential for the reclamation, reform, and enlightened transformation of the most expansive elements of the liberal tradition— that social and economic justice remain tangled in liberalism's web of pretentious institutions and betrayed promises is the reason for this battle from within."
                                            },
                                            {
                                                "example_id": "8b8b2857-8ddb-485e-94c3-c4a3f5a59a54",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "He spent the night at a friend's place unable to sleep and wondering how he got himself tangled in this mess."
                                            },
                                            {
                                                "example_id": "920f38f2-53cf-429c-8b61-098d2dc16f8b",
                                                "sense_id": "3bc340b4-2d1d-373a-8c15-6ce02e5e5c7e",
                                                "text": "Why else would she have tangled him in spells of illusion to get him to keep her company?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b53a3ba3-7c8c-38f4-ac7b-0499b5959719",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A tangled twisted mass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A complicated or confused state or condition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a36daac-eff2-4761-855e-c275b2865801",
                                                "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                                "text": "I tried to sort through this tangle and got nowhere."
                                            },
                                            {
                                                "example_id": "e28246bf-3502-4e1d-b989-19170689179f",
                                                "sense_id": "96034a77-4fca-37df-a9db-821cb96a5282",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too. GDP measures the total value of output in an economic territory. Its apparent simplicity explains why it is scrutinised down to tenths of a percentage point every month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b830b86a-ff44-37a5-8387-425fb4bcbb85",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "An argument, conflict, dispute, or fight."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d61e7167-bc4c-3e92-a9e8-928b33bb359f",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A region of the projection of a knot such that the knot crosses its perimeter exactly four times."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3968af7c-f5b6-3e8f-a869-1bf0ba1268f8",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A paired helical fragment of tau protein found in a nerve cell and associated with Alzheimer's disease."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db49fcd7-f13c-31d1-b131-19aad3fbe690",
                                        "entry_id": "6707af7f-3755-3902-b68d-a6dea9705e5d",
                                        "glosses": [
                                            "A form of art which consists of sections filled with repetitive patterns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tangle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8481ce2-72a1-33dd-a5c0-96c7341588cf",
                                        "entry_id": "902af8b8-2e02-3f73-9153-0297ec2d6bee",
                                        "glosses": [
                                            "Any large type of seaweed, especially a species of Laminaria."
