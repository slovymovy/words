                ],
                "senses": [
                    {
                        "sense_id": "76facd0a-8580-355c-8718-48c4b1167b59",
                        "entry_id": "4c7a9c1a-0f9b-30a8-877f-af7c78c15780",
                        "glosses": [
                            "Mouvement d'obédience musulmane, qui se veut réformateur et qui est présent au Pakistan, en particulier au Pendjab."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e189180-8a67-42b0-82c2-0988edde0f6f",
                                "sense_id": "76facd0a-8580-355c-8718-48c4b1167b59",
                                "text": "Vivement combattu par les courants majoritaires de l'islam pour lesquels Mahomet est le dernier prophète, l’ahmadisme a par exemple été déclaré « non-musulman » par le parlement pakistanais en 1974."
                            },
                            {
                                "example_id": "1417350a-ebdc-4568-ba30-54587068092b",
                                "sense_id": "76facd0a-8580-355c-8718-48c4b1167b59",
                                "text": "C’est entre 1921 et 1925 que l’ahmadisme fait sa première grande incursion en Amérique avec l’arrivée d’un premier missionnaire ahmadiste qadiani, le mufti Muhammad Sadiq, qui persuade plus d’un millier d’Américains, noirs et blancs, de se convertir."
                            },
                            {
                                "example_id": "174e9e09-9dd9-4692-a07b-b01db07db19f",
                                "sense_id": "76facd0a-8580-355c-8718-48c4b1167b59",
                                "text": "L’ahmadisme est un courant minoritaire de l’Islam qui considère qu’il existe un autre Prophète et remet ainsi en cause les bases même de l’Islam pour les sunnites et les chiites."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55203e2d-196d-4ee0-9600-8d1fbae274e8",
                        "source_entry_id": "4c7a9c1a-0f9b-30a8-877f-af7c78c15780",
