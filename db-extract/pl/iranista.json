                "senses": [
                    {
                        "sense_id": "db799a85-efd2-3c05-87cb-c73c82b3505c",
                        "entry_id": "86a695c1-6953-37ae-a41b-45e2eed2d7dc",
                        "glosses": [
                            "badacz języków irańskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "478bebf4-e8d8-4ccd-a7b5-c1d5ce57d69f",
                                "sense_id": "db799a85-efd2-3c05-87cb-c73c82b3505c",
                                "text": "Zrozpaczona Oleńka wyprosiła sobie wreszcie przeniesienie na seminarium starego profesora iranisty, zaczęła pisać pod jego kierunkiem rozprawę doktorską i już by ją spokojnie zakończyła, gdyby na stronice gazet nie wypłynął nagle problem irańskiego Azerbejdżanu"
                            },
                            {
                                "example_id": "5391eadc-ba97-4f51-b92b-a464059949a9",
                                "sense_id": "db799a85-efd2-3c05-87cb-c73c82b3505c",
                                "text": "(…) Potwierdził wczoraj, że rozmawiał z premierem na ten temat i jest zwolennikiem kandydatury Ananicza, będącego specjalistą od spraw Bliskiego Wschodu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
