                "senses": [
                    {
                        "sense_id": "2c3a4ec4-cec3-3945-9a44-a26e2458aa6e",
                        "entry_id": "357dab41-3d4b-3131-ae56-f1e515528040",
                        "glosses": [
                            "церк. совершение в церкви религиозных обрядов служителями культа; церковная служба"
                        ],
                        "tags": [],
