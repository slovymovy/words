                ],
                "senses": [
                    {
                        "sense_id": "e1b0f080-fca9-374a-85f0-75d386293c7a",
                        "entry_id": "da80ada6-7bec-34b3-9d8b-bcf50f59e0dd",
                        "glosses": [
                            "überstaatliche Weltorganisation, deren Ziel die Sicherung des Weltfriedens ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9591571b-a57a-4be3-933e-ea91236939bd",
                                "sense_id": "e1b0f080-fca9-374a-85f0-75d386293c7a",
                                "text": "„Man hört auf ihn nicht mehr als auf die Befürworter einer Weltregierung.“"
                            },
                            {
                                "example_id": "8d0cf924-dcd6-417f-966e-b74e5b862ebf",
                                "sense_id": "e1b0f080-fca9-374a-85f0-75d386293c7a",
                                "text": "„Wenn die Weltregierungen so über die Folgen der Finanzkrise verhandelt hätten, wären sie vermutlich reihenweise gestürzt worden.“"
                            },
                            {
                                "example_id": "9229bb72-b1da-4fa2-afaa-b75d4ba2a521",
                                "sense_id": "e1b0f080-fca9-374a-85f0-75d386293c7a",
                                "text": "„Es handelt sich um einen Kampf der Weltregierungen des Sports um Autonomie und Einfluss, der bei der vergangenen WM in Südkorea und Japan darin gipfelte, dass die Fifa Wada-Beobachtern eine Teilnahme an dem Turnier verweigerte.“"
                            },
                            {
                                "example_id": "1a8dc634-1540-4925-bbe3-fc1385f6c37a",
                                "sense_id": "e1b0f080-fca9-374a-85f0-75d386293c7a",
                                "text": "„Diese Weltregierung, auf gesetzlicher Grundlage errichtet, soll die Verantwortung für das Schicksal aller Völker tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
