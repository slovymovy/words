                                        "entry_id": "cefb6441-55dc-3b03-8cc3-6800d2d33bf1",
                                        "glosses": [
                                            "Avion propulsé par une ou plusieurs hélices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507b1ce6-051e-46da-922c-ecae20a7237f",
                                                "sense_id": "21de5694-871f-33b9-9dd9-18b9ab253b2f",
                                                "text": "L’usine des Hautes-Pyrénées recrute pour fabriquer l’avion à hélice TBM et des aérostructures pour Airbus et Dassault."
                                            }
