                    },
                    {
                        "translation_id": "35bd09b7-2a11-4ad9-b6e8-8d5281e5380f",
                        "source_entry_id": "69b92878-470b-3cc5-839a-6921bf5971be",
                        "target_lang_word": "rhapsodie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhapsodie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "421bfd4b-e9f1-3c0d-8a12-6d9c1e87281f",
                                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                                        "glosses": [
                                            "Chez les Grecs, morceaux détachés de l’Iliade et de l’Odyssée, que chantaient les rhapsodes."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                                        "glosses": [
                                            "Mauvais ramas, soit de vers, soit de prose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4edb59e7-a147-4791-93d3-c4adae522c5a",
                                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                                "text": "Je n’ai jamais vu pareille rhapsodie."
                                            },
                                            {
                                                "example_id": "938f7b97-ba16-46d1-8f72-3fca690bbe20",
                                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                                "text": "Tout son discours n’était qu’une mauvaise rhapsodie."
                                            },
                                            {
                                                "example_id": "63b5c9ec-0ce9-46f1-b548-ba98f23b3a1a",
                                                "sense_id": "9a23a675-1175-383a-8e61-0a111fe9895b",
                                                "text": "Uranie : Voulez-vous que l’on vous délace ?\nClimène : Mon Dieu, non. Ah !\nUranie : Quel est donc votre mal, et depuis quand vous a-t-il pris ?\nClimène : Il y a plus de trois heures, et je l’ai apporté du Palais-Royal.\nUranie : Comment ?\nClimène : Je viens de voir, pour mes péchés, cette méchante rapsodie de l’École des femmes. Je suis encore en défaillance du mal de cœur que cela m’a donné, et je pense que je n’en reviendrai de plus de quinze jours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82974b22-4148-33e3-af3a-ffa955402f3a",
                                        "entry_id": "133fa8c6-e2d1-39be-a014-e2eb428a476a",
                                        "glosses": [
