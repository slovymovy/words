                                        "sense_id": "c0ccfbf3-0e65-38b9-a846-ed68cb38742b",
                                        "entry_id": "16833988-bebc-3f60-aff5-868e07bab860",
                                        "glosses": [
                                            "a biological artefact, not altered by human hands; e.g. a seed, or an uncarved wooden roof beam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a441ec66-2b9a-3ce4-8fcd-5ab8e62e8a3a",
                                        "entry_id": "16833988-bebc-3f60-aff5-868e07bab860",
                                        "glosses": [
                                            "A hybrid of an artefact and a living entity, or between concepts of nature and technology."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93882b49-cd9e-4047-b268-a84b2899318d",
                        "source_entry_id": "d52014df-a1cf-325b-ae4f-ea90cdf07d73",
                        "source_sense_id": "67c137c9-d195-3d24-81fd-c5b7fe0428ba",
