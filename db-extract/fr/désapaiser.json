                        "glosses": [
                            "Faire perdre son caractère apaisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1cf460-6743-4672-8de8-121685e9d961",
                                "sense_id": "98c3f5b7-3c76-37d7-8868-673582517648",
                                "text": "-Laisse-les dormir, Sara. Ils ont l'air si apaisés. -J'M'EN VAIS TE LES DÉSAPAISER !"
                            },
                            {
                                "example_id": "e013701c-7bb2-42e3-9ca8-d11fc2c29efd",
                                "sense_id": "98c3f5b7-3c76-37d7-8868-673582517648",
                                "text": "Deux des plus amicales des extrêmes désapaisent ainsi le domaine politique."
                            },
                            {
                                "example_id": "4b529866-809b-4248-b05c-c91361dd972a",
                                "sense_id": "98c3f5b7-3c76-37d7-8868-673582517648",
                                "text": "Au contraire, je suis trés calme en temps normal et l'art me permet de me désapaiser."
                            }
                        ]
                    }
