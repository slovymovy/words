{
    "word_family": [
        "repos",
        "reposant",
        "reposoir",
        "reposée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0aa84cca-6f29-30b5-9800-1ad2ca216e24",
                    "sense_definition": "Prendre du repos, cesser une activité fatigante pour récupérer de ses forces.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, elle a besoin de se <w>reposer</w> un moment."
                        },
                        {
                            "text": "Le médecin lui a conseillé de se <w>reposer</w> pendant au moins une semaine."
                        }
                    ],
                    "common_phrases": [
                        "se reposer un peu",
                        "besoin de se reposer"
                    ]
                },
                {
                    "sense_id": "e391daef-6785-36be-a7ee-dd1ee21158f7",
                    "sense_definition": "Poser de nouveau un objet ou le remettre à la place où on l'avait pris.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "poser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il boit une gorgée d'eau fraîche avant de <w>reposer</w> son verre sur la table."
                        },
                        {
                            "text": "Après avoir feuilleté le livre, elle va le <w>reposer</w> délicatement sur l'étagère."
                        }
                    ],
                    "common_phrases": [
                        "reposer le combiné",
                        "reposer son verre"
                    ]
                },
                {
                    "sense_id": "390a2e19-7509-33e5-9fb8-5ff887d5d236",
                    "sense_definition": "Être fondé, établi ou soutenu par quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fondement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la confiance entre eux <w>repose</w> sur une sincérité absolue depuis le début."
                        },
                        {
                            "text": "Ce projet ambitieux <w>repose</w> principalement sur des financements publics accordés cette année."
                        }
                    ],
                    "synonyms": [
                        "s'appuyer"
                    ],
                    "common_phrases": [
                        "reposer sur un principe",
                        "reposer sur la confiance"
                    ]
                },
                {
                    "sense_id": "9969ae6a-60f8-388e-9be3-98c030468c9a",
                    "sense_definition": "Poser de nouveau, formuler une nouvelle fois une demande ou une interrogation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "poser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me permets de vous <w>reposer</w> la question car je n'ai pas bien compris."
                        },
                        {
                            "text": "L'avocat souhaite <w>reposer</w> plusieurs questions importantes au témoin durant l'audience."
                        }
                    ],
                    "common_phrases": [
                        "reposer une question",
                        "reposer le problème"
                    ]
                },
                {
                    "sense_id": "dea5899c-2ffe-3504-91c7-a77142bd95b1",
                    "sense_definition": "Demeurer immobile afin de se clarifier, de fermenter ou de s'attendrir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut laisser <w>reposer</w> la pâte au réfrigérateur pendant au moins une heure."
                        },
                        {
                            "text": "Le chef conseille de laisser <w>reposer</w> la viande quelques minutes avant de la découper."
                        }
                    ],
                    "common_phrases": [
                        "laisser reposer la pâte",
                        "laisser reposer le vin"
                    ]
                },
                {
                    "sense_id": "5e8ffdf3-cd7f-3303-a368-d41f45ae0de3",
                    "sense_definition": "Être inhumé, enterré en un lieu pour son dernier sommeil.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les grands hommes de la nation <w>reposent</w> sous la coupole du Panthéon."
                        },
                        {
                            "text": "Ses ancêtres <w>reposent</w> en paix dans le vieux cimetière au sommet de la colline."
                        }
                    ],
                    "common_phrases": [
                        "reposer en paix",
                        "reposer au cimetière"
                    ]
                },
                {
                    "sense_id": "bdde6630-8080-3749-92d0-9aa3a6e87fec",
                    "sense_definition": "Procurer du calme, détendre les sens ou l'esprit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "repos",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La vue de ce paysage verdoyant <w>repose</w> les yeux fatigués par les écrans."
                        },
                        {
                            "text": "Écouter le bruit des vagues <w>repose</w> l'esprit après une journée agitée."
                        }
                    ],
                    "common_phrases": [
                        "reposer la vue",
                        "reposer l esprit"
                    ]
                }
            ]
        }
    ]
}