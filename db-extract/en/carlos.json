                        "entry_id": "fa3063f5-ccdb-39ca-bf77-def8d7376f67",
                        "glosses": [
                            "A male given name from Portuguese or from Spanish [in turn from Latin, in turn from the Germanic languages], equivalent to English Charles, Carl, or Karl."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3a14daa-2b17-4219-9a8d-715b607f32b4",
                                "sense_id": "929f0c6e-224f-3770-a17e-c86b6f33777f",
                                "text": "The Ferraris pressed the self-destruct button, Lewis Hamilton lost his spot on the podium, and there were champagne moments for Pierre Gasly and Carlos Sainz Jr."
