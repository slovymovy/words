                "senses": [
                    {
                        "sense_id": "45b7f570-f1f9-32ca-814b-99061ffce871",
                        "entry_id": "52ac1e6d-3400-330d-8e87-2c8cb598b6f0",
                        "glosses": [
                            "Eigenschaft/Handlungsweise, die in deutlichem Maße nicht zu erwartendes (abnormales, abnormes) Verhalten oder eine solche, nicht der Norm entsprechende Ausprägung zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f0a4cce-1f9f-45f4-a54f-b76cde359345",
                                "sense_id": "45b7f570-f1f9-32ca-814b-99061ffce871",
                                "text": "„Als Konsequenz dieser Befunde entstand ein Konzept, demzufolge bei der arteriellen Hypertonie eine generalisierte Abnormalität des zellulären Membrantransports vorliegt.“"
                            },
                            {
                                "example_id": "60d009ef-a950-4bbf-bac8-8b8a7f7097db",
                                "sense_id": "45b7f570-f1f9-32ca-814b-99061ffce871",
                                "text": "„Legasthenie, eine LeseRechtschreibSchwäche, die sich in der Verdrehung oder Verwechslung von Buchstaben oder ganzen Wortteilen äußert, ist ein gutes Beispiel für eine funktionale Abnormalität.“"
                            },
                            {
                                "example_id": "a2ba3ce7-f2b4-453d-a53e-84674e8a86a9",
                                "sense_id": "45b7f570-f1f9-32ca-814b-99061ffce871",
                                "text": "„Und praktisch ist es sicher sehr zu empfehlen, daß der sich keiner Abnormalität bewußte Richter sich die Frage vorlegt: kannst du die Handlungsweise des Angeklagten verstehen, dich in ihn hineindenken – oder nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "835ab182-c7e9-459a-92ee-6c461e7e2013",
                        "source_entry_id": "52ac1e6d-3400-330d-8e87-2c8cb598b6f0",
                        "source_sense_id": "45b7f570-f1f9-32ca-814b-99061ffce871",
                        "source_sense_description": "abnormales Verhalten oder abnormaler Zustand/Eigenschaft",
                        "target_lang_word": "abnormality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnormality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "The state or quality of being abnormal; variation; irregularity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c8c773d-1a68-45cd-b85e-6fcb1f2336de",
                                                "sense_id": "aa83e66e-b633-369b-953b-28b56fd3ba04",
                                                "text": "Taylor said that her fame makes her \"sometimes\" miss the normality of being able to hang out with friends but that she's had to get used to \"the abnormality of my life\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                        "entry_id": "dd8cb471-944d-3d40-8259-e3f163eb8c4f",
                                        "glosses": [
                                            "Something abnormal; an aberration; an abnormal occurrence or feature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1105f1de-6ba5-46b3-a72a-ad1184d2815a",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "I want a full genetic analysis. We're going to examine any abnormality we find no matter how insignificant it seems."
                                            },
                                            {
                                                "example_id": "7284ac2f-3efa-4a79-bc17-2dbf7c46a283",
                                                "sense_id": "f55ce250-88f6-3085-a629-daca7cd3bd8c",
                                                "text": "The factors that filter out who “gets through” from conception to birth include chromosomal or genetic abnormalities of the fetus or the mother’s stress response to changes in her environment, Catalano said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
