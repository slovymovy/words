                            {
                                "example_id": "2efa9705-956a-43c7-81f3-a982ba95e79e",
                                "sense_id": "39754ae5-ba7a-3420-8cc7-6500b8a07b46",
                                "text": "„Der Parkweg wurde zum Kiesweg und wir holperten an stattlichen Platanen vorbei, deren gefleckte Stämme ich besonders liebte.“"
                            },
                            {
                                "example_id": "eb40c413-205f-450d-b772-65e68a91291a",
                                "sense_id": "39754ae5-ba7a-3420-8cc7-6500b8a07b46",
                                "text": "„Während Robert durch die Parkwege des wie ausgestorben wirkenden Villenvororts schlenderte, sann er den Worten des Alten nach.“"
                            }
                        ],
