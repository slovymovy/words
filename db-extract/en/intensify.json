                                        "sense_id": "3cf1c899-f44f-3c3b-b728-4506b68ebfad",
                                        "entry_id": "2e295d97-7759-36f2-be6e-4f11a0004324",
                                        "glosses": [
                                            "etwas verstärken, steigern, intensiver gestalten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2809cf57-3b41-4136-8a07-48d61e3e769b",
                                                "sense_id": "3cf1c899-f44f-3c3b-b728-4506b68ebfad",
                                                "text": "Unterdessen gibt es offenbar europäische Bestrebungen, den Kampf gegen die Piraterie in den Gewässern vor Somalia zu intensivieren, indem weitere Kriegschiffe dorthin geschickt werden sollen."
                                            },
                                            {
                                                "example_id": "7662b244-efdd-41c5-b56d-b84082da1b36",
                                                "sense_id": "3cf1c899-f44f-3c3b-b728-4506b68ebfad",
                                                "text": "Der russische Vizeaußenminister Sergej Ryabkow warf der neuen US-Regierung von Barack Obama vor, dieses Projekt noch immer nicht aufgegeben zu haben: „Im Gegenteil, wir sehen, dass die Arbeiten an der Raketenabwehr sogar wieder intensiviert werden.“"
                                            },
                                            {
                                                "example_id": "eb0ac4b2-ff71-419a-950d-1be6a4ca4e0d",
                                                "sense_id": "3cf1c899-f44f-3c3b-b728-4506b68ebfad",
                                                "text": "Solche Eingriffe \"sind allerdings mit vielen ethischen Fragen verbunden, deren Diskussion in den kommenden Jahren intensiviert werden muss.\""
                                            },
                                            {
                                                "example_id": "a97961b5-6299-41b7-8850-79ae520eda92",
                                                "sense_id": "3cf1c899-f44f-3c3b-b728-4506b68ebfad",
                                                "text": "„Die Reaktion der Nordvietnamesen bestand darin, dass sie ihre Bemühungen intensivierten, das Nachbarland zu infiltrieren und die kommunistische Bewegung des Landes […] zu schulen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
