                        "sense_id": "18c78299-9fb2-3706-afaa-70171840b3fa",
                        "entry_id": "2b9d73be-269d-3940-ab36-d9e3e149f614",
                        "glosses": [
                            "Vorgang, bei dem ein Bauwerk verkleinert oder beseitigt wird"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "db4dec83-4fe4-4cd0-81c8-ba8af349b288",
                                "sense_id": "18c78299-9fb2-3706-afaa-70171840b3fa",
                                "text": "Bei diesem Gebäudekomplex sollte ein Rückbau diverser Komponenten in Erwägung gezogen werden, da es sich um eine unvorteilhafte Verquickung von Baustilen verschiedener Epochen handelt, gab der Bauingenieur zu bedenken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a442f0e6-18bf-4ff8-b123-577bba016dca",
                        "source_entry_id": "2b9d73be-269d-3940-ab36-d9e3e149f614",
                        "source_sense_id": "18c78299-9fb2-3706-afaa-70171840b3fa",
                        "source_sense_description": "fachsprachlich: Vorgang, bei dem ein Bauwerk verkleinert oder beseitigt wird",
                        "target_lang_word": "demolition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demolition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cfb36bbf-f73c-3d30-b6bc-306875e39cc0",
                                        "entry_id": "8e01b77b-eb4e-3209-9960-ed75b5c58fba",
                                        "glosses": [
                                            "The process of demolishing or destroying buildings or other structures."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a48b902a-82f4-4e87-bf5a-4ab7a525edaa",
                                                "sense_id": "cfb36bbf-f73c-3d30-b6bc-306875e39cc0",
                                                "text": "During the war, but unrecorded because of the requirements of censorship, a link with the now partly-abandoned Cardiff Railway disappeared with the demolition of Rhydyfelin Viaduct, near Treforest, South Wales, in the latter part of 1942. The steelwork in this structure, amounting to nearly 1,150 tons, was salvaged as scrap metal to assist the war effort."
                                            },
                                            {
                                                "example_id": "ae7da3f7-c2d5-40ec-9581-fd027020f33f",
                                                "sense_id": "cfb36bbf-f73c-3d30-b6bc-306875e39cc0",
                                                "text": "At Kiwi, 40 miles from Nelson [New Zealand], eight women installed themselves in the goods shed, taking with them their knitting, and a supply of food and magazines. The demolition crew was unable to pull the building down without injuring them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "352ce863-4775-4fe3-bcd2-51988d3d4b4c",
                        "source_entry_id": "2b9d73be-269d-3940-ab36-d9e3e149f614",
