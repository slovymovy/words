                ],
                "senses": [
                    {
                        "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                        "entry_id": "7f4baedc-ed19-34dd-b8d7-1083cdecb37b",
                        "glosses": [
                            "kleineres Gebäude, das zum Abhalten von religiösen Ritualen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889c619a-77cb-4432-b7ad-4e8e0781d985",
                                "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                                "text": "„Das heutige Kapellengebäude wurde um 1330 erbaut.“"
                            },
                            {
                                "example_id": "ea09bbfb-0724-4567-ad29-5479982a247d",
                                "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                                "text": "„Durch das Engagement der Bürgerinitiative seit Anfang 2013 konnte erreicht werden, dass das Kapellengebäude in die städtebaulichen Planungen für das Neubaugebiet auf dem Gelände des bisherigen Klinikums Oststadt-Heidehaus integriert wurde.“"
                            },
                            {
                                "example_id": "3d8e6ab4-6b88-4c43-a467-fe464cd1954a",
                                "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                                "text": "„Mit einem bunten Rahmenprogramm wurde am Samstag, den 11.10.2014 das Kapellengebäude in der Leipziger Straße 2 in Grimma (Sachsen) seiner neuen Bestimmung übergeben.“"
                            },
                            {
                                "example_id": "bbab3d62-b9c2-4290-9ecb-f5f587256cff",
                                "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                                "text": "„Das Kapellengebäude wurde im Baustil des Neo-Barock errichtet, womit man - vielleicht unbeabsichtigt - eine Parallele zum Stadtbrand gezogen hatte, in dessen Zuge die Stadt ganz überwiegend im Stil des Barock wiederaufgebaut worden ist.“"
                            },
                            {
                                "example_id": "0bb80f62-b8a9-43ac-9287-701c7b378a97",
                                "sense_id": "da4e3e88-4b83-3cda-bda5-ee046c0d880f",
                                "text": "„Der Beschwerde ist zwar einzuräumen, daß ein Kapellengebäude, hier konkret dessen Außenfassade, keinen Gegenstand religiöser Verehrung im Sinn der zweiten Alternative des § 126 Abs 1 Z. 1 StGB darstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
