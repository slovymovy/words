    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "43a4077e-3ad9-3fbe-a5f8-df9a0baf7acf",
                    "sense_definition": "aus Versehen, ohne Absicht geschehend",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unabsichtlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe die E-Mail <w>versehentlich</w> an die falsche Person geschickt.",
                            "target_lang_translations": {
                                "ru": "Я <w>по ошибке</w> отправил электронное письмо не тому человеку."
                            }
                        },
                        {
                            "text": "Er hat gestern beim Aufräumen <w>versehentlich</w> die Tasse fallen lassen.",
                            "target_lang_translations": {
                                "ru": "Вчера во время уборки он <w>случайно</w> уронил чашку."
                            }
                        }
                    ],
                    "synonyms": [
                        "aus Versehen"
                    ],
                    "antonyms": [
                        "absichtlich",
                        "mit Absicht"
                    ],
                    "common_phrases": [
                        "versehentlich gelöscht",
                        "etwas versehentlich tun"
                    ],
                    "target_lang_definitions": {
                        "ru": "по ошибке, без умысла, непреднамеренно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайно",
                                "target_lang_sense_clarification": "без намерения, непреднамеренно"
                            },
                            {
                                "target_lang_word": "по ошибке",
                                "target_lang_sense_clarification": "вследствие ошибки или недосмотра"
                            },
                            {
                                "target_lang_word": "нечаянно",
                                "target_lang_sense_clarification": "непреднамеренно, по оплошности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "488fbdc3-62b3-3999-b514-273f7d035d8b",
                    "sense_definition": "auf einem Versehen beruhend; nicht beabsichtigt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unabsichtlich",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein <w>versehentliches</w> Löschen der wichtigen Dateien sollte durch das System verhindert werden.",
                            "target_lang_translations": {
                                "ru": "<w>Случайное</w> удаление важных файлов должно предотвращаться системой."
                            }
                        },
                        {
                            "text": "Die Verzögerung war die Folge eines <w>versehentlichen</w> Fehlers im Formular.",
                            "target_lang_translations": {
                                "ru": "Задержка стала следствием <w>ошибочной</w> неточности в бланке."
                            }
                        }
                    ],
                    "synonyms": [
                        "unabsichtlich"
                    ],
                    "antonyms": [
                        "absichtlich",
                        "vorsätzlich"
                    ],
                    "common_phrases": [
                        "versehentlicher Fehler",
                        "versehentliches Löschen"
                    ],
                    "target_lang_definitions": {
                        "ru": "основанный на ошибке или недосмотре; непреднамеренный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный",
                                "target_lang_sense_clarification": "произошедший без умысла"
                            },
                            {
                                "target_lang_word": "ошибочный",
                                "target_lang_sense_clarification": "совершенный по ошибке или недосмотру"
                            },
                            {
                                "target_lang_word": "непреднамеренный",
                                "target_lang_sense_clarification": "сделанный без злого умысла или намерения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
