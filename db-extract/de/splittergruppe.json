                                        "entry_id": "6ae96dda-3a20-3e98-a5ad-12d097771ca1",
                                        "glosses": [
                                            "A group of members of a political party or of a similar organisation who have decided to create their own organisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c27b7d33-811b-4aba-bc54-c23d920970a8",
                                                "sense_id": "e7412b61-940d-37b6-8a3e-c535f87cb54a",
                                                "text": "Splinter groups in the centre Left or centre Right are often a shot in the arm for the Far Right or the Communist Party."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f87e9640-8acf-407c-bd5f-7761fe74edf8",
                        "source_entry_id": "15fcf9fc-ded0-3edd-a30c-45e82f256122",
                        "source_sense_id": "198b2483-d222-3558-849d-fa36d2eb93e5",
