                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b69767b0-505f-4a20-9a2f-63d379169939",
                        "entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "vérandas"
                    },
                    {
                        "form_id": "0cf45b55-e2f3-4520-afed-374a69de796f",
                        "entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "tags": [],
                        "form": "vérandah"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                        "entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "glosses": [
                            "Sorte de galerie légère, couverte et à jour, établie sur la façade d’une maison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09ceb657-7f6d-47f5-8573-638c25ad889e",
                                "sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                                "text": "Une jolie galerie découpée règne au premier étage, et une véranda projette sa cage de verre au milieu de la façade."
                            },
                            {
                                "example_id": "75d7d5e1-ed52-4de6-a3bb-1f1c3276cfc9",
                                "sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                                "text": "Il déboucha bientôt devant plusieurs chalets, construits en planches comme le dernier, avec chacun une sorte de véranda mal peinte en blanc."
                            },
                            {
                                "example_id": "a2fad262-ee80-45ed-ba83-c812b0415440",
                                "sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                                "text": "Sur la véranda de la Maple House du Domaine Joly-De Lotbinière, désormais un lieu touristique, une jeune fille en chandail bedaine fait un égoportrait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4458d5d-065d-41c5-adff-4e40937a6779",
                        "source_entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "source_sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                        "target_lang_word": "Veranda",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Veranda",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                        "entry_id": "eae5b624-d9d3-3c40-90af-7fafa39679f9",
                                        "glosses": [
                                            "ein offener Hausan- oder Aufbau, auch mit Überdachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5511ce7-7619-4806-9a46-8d9f60e0fc7f",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Lass uns bei dem schönen Wetter raus auf die Veranda gehen."
                                            },
                                            {
                                                "example_id": "7198627a-7a1a-4865-96c4-70ca76fa86a4",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "Um der Zugluft nicht ausgesetzt zu sein, wird die Veranda zwischen Gebäudeflügeln eingerückt oder an den Schmalseiten durch Holz- oder Glaswände geschlossen.\""
                                            },
                                            {
                                                "example_id": "76e735cb-4a21-404f-ad67-c92661ea078b",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Jack saß auf der Veranda und schrieb einen Brief an seine Frau.“"
                                            },
                                            {
                                                "example_id": "aa4e343b-931c-4dee-ab15-8ccdb2bbe512",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Als ich nach dem Mittagessen allein auf der Veranda saß und rauchte, kam der Offizier auch heraus und direkt auf mich zu.“"
                                            },
                                            {
                                                "example_id": "dac699f3-d3c1-4b78-8340-1c2f3960d157",
                                                "sense_id": "ba2283fc-d9d9-3dc5-8d52-e7c6373c88f1",
                                                "text": "„Die Veranda war leer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c8f1273-228e-4576-a4d8-135305a017bf",
                        "source_entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "source_sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                        "target_lang_word": "porch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A covered entrance to a building, whether taken from the interior, and forming a sort of vestibule within the main wall, or projecting without and with a separate roof. A porch often has chair(s), table(s) and swings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd83e935-f280-4556-bc92-8ac38c713c95",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "He sat on his porch, waiting for his friend to come over."
                                            },
                                            {
                                                "example_id": "b4427204-bd67-4105-8e0b-abacba4479e0",
                                                "sense_id": "ee26168e-e438-3396-9aa7-b03684687115",
                                                "text": "But Miss Thorn relieved the situation by laughing aloud,[…]. We began to tell her about Mohair and the cotillon, and of our point of observation from the Florentine galleried porch, and she insisted she would join us there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84535f0e-a39c-3050-a918-08f7e8143f31",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "A portico; a covered walk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                        "entry_id": "9d7e81e7-cc18-373b-9826-e8b9fd89bfcf",
                                        "glosses": [
                                            "The platform outside the external hatch of a spacecraft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1110cd98-0ed3-45f4-ada1-cfe40857f0a6",
                                                "sense_id": "964dd79a-6b6e-391c-a646-a20c8635ef71",
                                                "text": "By the time he had put on the backpack, McDivitt was ready to let him do more—to stand on the porch at least."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1097143f-60e5-409b-a282-e6c7991fc361",
                        "source_entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "source_sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
                        "target_lang_word": "veranda",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veranda",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78e47701-2be8-3dc9-bf1d-6fab2adb6628",
                                        "entry_id": "049e5556-937a-346f-a450-984a39569f16",
                                        "glosses": [
                                            "A gallery, platform, or balcony, usually roofed and often partly enclosed, extending along the outside of a building."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8669fd8d-d347-490c-8bb0-e4eae930de37",
                                                "sense_id": "78e47701-2be8-3dc9-bf1d-6fab2adb6628",
                                                "text": "Boulte ate his breakfast, advised her to see her Arab pony fed in the veranda, and went out."
                                            },
                                            {
                                                "example_id": "58d40114-0688-4cef-ac7c-ca87c9f1283f",
                                                "sense_id": "78e47701-2be8-3dc9-bf1d-6fab2adb6628",
                                                "text": "No matter how early I came down, I would find him on the veranda, smoking cigarettes, or otherwise his man would be there with a message to say that his master would shortly join me if I would kindly wait."
                                            },
                                            {
                                                "example_id": "1978a1fa-382d-4695-bcd3-12bbc08e0bc4",
                                                "sense_id": "78e47701-2be8-3dc9-bf1d-6fab2adb6628",
                                                "text": "Our part of the veranda did not hang over the gorge, but edged the meadow where half a dozen large and sleek horses had stopped grazing to join us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77c09d45-d450-4178-b5f2-ed96cb3149a8",
                        "source_entry_id": "622beb6f-4032-3cc4-9468-722ad4fc13a8",
                        "source_sense_id": "4f5c1df8-6300-3db7-9daa-ffe6be9237ed",
