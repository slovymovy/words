                "senses": [
                    {
                        "sense_id": "1ca10902-8434-3aca-9ba7-80be2992519c",
                        "entry_id": "2cae5e76-c514-32b2-8a5f-66fa30a764b9",
                        "glosses": [
                            "ohne festen Straßenbelag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa049ee0-2a07-4fdb-8cda-f22b7cdf5795",
                                "sense_id": "1ca10902-8434-3aca-9ba7-80be2992519c",
                                "text": "„Der Wagen rumpelte über eine unbefestigte Straße voller Schlaglöcher.“"
                            },
                            {
                                "example_id": "4c4dffc6-7017-47af-94df-6cbdd57b8937",
                                "sense_id": "1ca10902-8434-3aca-9ba7-80be2992519c",
                                "text": "„Zwei kleine Mädchen und ein Hund gingen ein unbefestigtes Sträßchen entlang.“"
                            },
                            {
                                "example_id": "18e32647-ee7f-45b7-a6a3-619f89e178ab",
                                "sense_id": "1ca10902-8434-3aca-9ba7-80be2992519c",
                                "text": "„Vielleicht ist er in eine Einfahrt oder eine unbefestigte Straße abgebogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
