                                    {
                                        "sense_id": "d382c20e-a9a6-3e07-a6e9-db8e4ea3c47b",
                                        "entry_id": "88e322e5-a695-3395-879f-740052be9664",
                                        "glosses": [
                                            "Characteristic of, or accompanied by, ischemia — localised anaemia due to mechanical obstruction of the blood supply, creating a local disturbance in blood circulation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5edb2769-8928-4389-ac46-0bd171121d4d",
                                                "sense_id": "d382c20e-a9a6-3e07-a6e9-db8e4ea3c47b",
                                                "text": "Dr. Salazar was a fast talker, devoid of personality. Lolly's vitals had stabilised, she said. Her stroke was ischemic, caused by a clot rather than a rupture. She'd come in exhibiting classic symptoms: weakness on her left side, double vision, aphasia.\n\"What's aphasia?\" I said.\n\"A disconnect between what the patient's trying to say and what's being communicated. For instance, Louella thinks to herself, I'm thirsty. I want more ice chips. But when she verbalises it, it comes out as gibberish.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
