                    "frequency": "Middle",
                    "semantic_group_id": "soleil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vacanciers passent toute l'après-midi à se <w>rôtir</w> sur la plage sans aucune protection."
                        },
                        {
                            "text": "Tu devrais te mettre à l'ombre au lieu de te <w>rôtir</w> au soleil."
