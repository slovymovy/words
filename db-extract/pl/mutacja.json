                        "cross_references": [
                            {
                                "target_word": "mutation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4fea3a0-ae5a-338d-94c1-37d0156ff2c6",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "Any alteration or change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f945948f-1492-3bd5-9b9d-2cc820640458",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "Any heritable change of the base-pair sequence of genetic material."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "971b5b6d-ca18-44b7-a42e-b31115967c4b",
                                                "sense_id": "f945948f-1492-3bd5-9b9d-2cc820640458",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, […]. In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b136c89f-57a5-3bf1-8bcd-3d5b2f7f9201",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "A mutant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aacd5e1d-e964-31c2-a6f2-6829c4c0e061",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "An alteration in a particular sound of a word, especially the initial consonant, which is triggered by the word's morphological or syntactic context and not by its phonological context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d34d7e4-24f7-33a6-85df-0601511f36ad",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "The transfer of title of an asset in a register."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                        "entry_id": "43335c2f-a916-3f0f-8534-0e805f4d0ec3",
                                        "glosses": [
                                            "A group of thrushes."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "noun",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf4d0075-8667-478f-a3c0-c34fd7acf20c",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "Birdwatchers would enjoy a host of sparrows, a herd of swans, a descent of woodpeckers, a herd of wrens, and mutation of thrushes."
                                            },
                                            {
                                                "example_id": "4fe4be53-982f-4f50-8be6-19213edd112a",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "Names for a group: A flute or mutation of thrushes."
                                            },
                                            {
                                                "example_id": "635d8ce0-0fe7-4bb2-8acf-741aef4f8c37",
                                                "sense_id": "dc21595b-3fbf-3890-a8f1-2cb16585903e",
                                                "text": "A Mutation of Thrushes\nThe authors of the books of venery were not predicting Darwin with this term, but taking a cue from a common fable of the time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
