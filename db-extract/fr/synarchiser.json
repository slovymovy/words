                "senses": [
                    {
                        "sense_id": "d8486cd0-2f68-3f29-83c2-5a2b4faef537",
                        "entry_id": "3a5c3e98-c9c6-3f90-911b-f915c07b9f81",
                        "glosses": [
                            "Donner un caractère synarchique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356136f6-6cd2-4ad5-8426-f9a1ceb76741",
                                "sense_id": "d8486cd0-2f68-3f29-83c2-5a2b4faef537",
                                "text": "Est-il possible de synarchiser la France du jour au lendemain?"
                            },
                            {
                                "example_id": "f42870b9-1ed1-4a46-b7c1-8204addb376f",
                                "sense_id": "d8486cd0-2f68-3f29-83c2-5a2b4faef537",
                                "text": "Échappée aux disputes retentissantes que mon dernier article vous signalait, elle vient de se donner un comité de rédaction nouveau, décidé à chercher par tous les moyens à coordonner, à synarchiser les efforts artistiques non seulement de l'école tchèque, mais de toutes les écoles slaves de façon à faire si possible de Prague une véritable capitale slave."
                            }
                        ]
                    }
