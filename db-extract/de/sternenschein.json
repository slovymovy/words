                "senses": [
                    {
                        "sense_id": "dda94e78-7ad6-347d-9491-7c881c7539c7",
                        "entry_id": "71e62345-3bfa-3c86-9809-d98542badb9c",
                        "glosses": [
                            "Licht der Sterne, das die Erde erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f00ef73-64e1-476e-a53b-e7dd24589784",
                                "sense_id": "dda94e78-7ad6-347d-9491-7c881c7539c7",
                                "text": "„Nirgends habe ich so hellen Sternenschein gesehen wie hier, hier in den kaukasischen Bergen, und der Mond, obwohl er nur etwas über die Hälfte hinaus ist, leuchtet, als wäre er voll.“"
                            },
                            {
                                "example_id": "10605227-0bb9-43e6-b199-683b12b820cc",
                                "sense_id": "dda94e78-7ad6-347d-9491-7c881c7539c7",
                                "text": "„Jetzt freilich, unter dem Sternenschein, lag alles da wie das Schloß im Märchen, und Schach hielt öfters an und sah hinauf, augenscheinlich betroffen von der Schönheit des Bildes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
