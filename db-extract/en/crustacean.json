                        "target_lang_word": "Krustentier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krustentier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca5e7da4-fe04-3499-ac2e-c46b8861e640",
                                        "entry_id": "27e621a0-7706-3269-9bcc-11694db939ef",
                                        "glosses": [
                                            "als Lebensmittel nutzbares Krebstier"
                                        ],
                                        "tags": [
                                            "Küche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be1fee9a-0aea-4e17-8c08-9e9ae005e3a0",
                                                "sense_id": "ca5e7da4-fe04-3499-ac2e-c46b8861e640",
                                                "text": "Krustentiere können sehr lecker sein."
                                            },
                                            {
                                                "example_id": "25b127f2-ca0d-4ed2-afa9-4cd50b23c3e3",
                                                "sense_id": "ca5e7da4-fe04-3499-ac2e-c46b8861e640",
                                                "text": "„Es handelt sich hierbei um Einzeller (Protozoen) wie die Foraminiferen (mit Kalkschale) und die Radiolarien (Skelett aus Kieselsäure), um Coelenteraten wie Medusen und Quallen, um Rädertierchen, Würmer aus der Gruppe der Anneliden und der Chaetognathen sowie zahlreiche Krustentiere, unter den die Copepoden überwiegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a4ce991-c369-4a34-8a26-10d03ae8fd16",
                        "source_entry_id": "902a7818-26e7-306b-b4dd-6233515a333d",
                        "source_sense_id": "bf90aa96-9961-3cba-ad0b-33995f40e9c2",
                        "source_sense_description": "arthropod of the subphylum Crustacea",
                        "target_lang_word": "Krebstier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krebstier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                        "entry_id": "69f511af-cf5d-3a70-98b7-1de57a72cc6c",
                                        "glosses": [
                                            "Mitglied einer Klasse (Crustacea) der Gliederfüßer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2661ff-8fac-4a37-aba9-6f6800d4ccf8",
                                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                                "text": "„Ein lebendes Fossil ist der nur zwei Millimeter große Urzeitkrebs mit dem wissenschaftlichen Namen Antrobathynella stammeri, eine Entwicklungslinie der Krebstiere, die es schon im Karbon gegeben hat.“"
                                            },
                                            {
                                                "example_id": "b2ec33f7-85bc-41f6-a3e5-a58cd68eab45",
                                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                                "text": "„Zum Spektrum der Nahrung gehören Würmer, Fischbruten, kleine Krebstiere und ähnliches.“"
                                            },
                                            {
                                                "example_id": "a4339e88-7a19-4706-941c-9446c7192510",
                                                "sense_id": "4521660a-6d70-3985-ae38-dd6a2e1b71e7",
                                                "text": "„So ernährt sich beispielsweise der Krill, ein Krebstier, in der Antarktis wesentlich von diesen Einzellern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec670fdd-0715-48ba-b1ab-d16d29f1fcf9",
                        "source_entry_id": "902a7818-26e7-306b-b4dd-6233515a333d",
