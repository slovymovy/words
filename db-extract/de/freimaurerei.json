                                        "glosses": [
                                            "sociedade secreta, iniciática, sem fins lucrativos, cuja origem se perde na antigüidade; sistema de conduta moral onde seus membros preservam os princípios da fraternidade, igualdade e da liberdade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65039ec-03f2-4f0f-a2a8-87a7bd4590f5",
                                                "sense_id": "1dd73a75-df3f-3d5c-b935-80376c2db401",
