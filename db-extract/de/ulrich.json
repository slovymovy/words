                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Ulrich kommt und geht."
                            },
                            {
                                "example_id": "2d6d3328-fe21-46e8-bad4-bcf911737abe",
                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Frau Ulrich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ebb66810-ec01-4a8a-b5b6-c7a57c03ef87",
                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Herr Ulrich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "62e6d002-fb4a-4769-be94-552da1ade613",
                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Die Ulrichs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "01cbbf4b-f432-4259-8b33-1183df7f9a95",
                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Der Ulrich trägt nie die Schals, die die Ulrich ihm strickt."
                            },
                            {
                                "example_id": "1b261a14-8102-44c6-bde3-450210e326d7",
                                "sense_id": "d894edbf-6419-3bc0-808c-5626725baeb6",
                                "text": "Ulrichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
