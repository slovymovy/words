                                                "sense_id": "9012b93d-c298-3d83-80f0-a25619b0eb2b",
                                                "text": "Önceden koyduğu nice teşhislerin doğruluğu sonradan kaç defa sabit olmuş."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb861b89-90b9-3fe6-ab38-162c55d40381",
                                        "entry_id": "7b4e7fb0-2fa7-3e26-aa9a-23fa1f32fd21",
                                        "glosses": [
                                            "kim ve ne olduğunu anlama, tanıma, seçme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e594456-0957-4bce-adc7-da4a41694dd6",
                                                "sense_id": "eb861b89-90b9-3fe6-ab38-162c55d40381",
                                                "text": "Hayatımı karartan bir adamı bile teşhiste zaafa uğradım."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e93db4f7-cebd-3e2a-89ef-9aa92273b075",
                                        "entry_id": "7b4e7fb0-2fa7-3e26-aa9a-23fa1f32fd21",
                                        "glosses": [
                                            "belirleme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e2cdd2e-b821-49b5-a5b8-eaa4a75356fd",
                                                "sense_id": "e93db4f7-cebd-3e2a-89ef-9aa92273b075",
                                                "text": "Bu teşhisi ister istemez kabul eden çağdaş Batılı, hastalığın sınırlarını daraltmak ister."
                                            }
                                        ]
                                    },
                                    {
