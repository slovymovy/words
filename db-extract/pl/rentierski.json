                "senses": [
                    {
                        "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                        "entry_id": "b1c9ded9-381d-3bde-93e6-532bb3ae496a",
                        "glosses": [
                            "rentier"
                        ],
                        "tags": [
                            "literary",
                            "not-comparable",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "a9a5c001-4895-4b27-b4a3-487d6ca65efd",
                                "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                                "text": "plan rentierski",
                                "translation": "annuity plan",
                                "english": "annuity plan"
                            },
                            {
                                "example_id": "9d8e8131-1211-4780-a021-c64864c9edf9",
                                "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                                "text": "lokata rentierska",
                                "translation": "annuity deposit",
                                "english": "annuity deposit"
                            },
                            {
                                "example_id": "fee67a8c-a799-4074-a1d1-8ed9ddfdf280",
                                "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                                "text": "Otóż zadaniem państwa jest pilnowanie, ażeby zawsze zwyciężała solidarność interesów wszystkich czynników produkcji, nie zaś chęć wyzyskania chwilowej koniunktury przez jakiś specjalny czynnik, bez względu na to czy to będzie kapitał rentierski, praca ludzka lub też czynnik przedsiębiorczości, łączący ze sobą dwa poprzednie czynniki.",
                                "translation": "The task of the state is to ensure that the solidarity of interests of all factors of production always prevails, and not the desire to exploit the momentary prosperity by some special factor, whether it be rentier capital, human labour or the factor of entrepreneurship, combining the two previous factors.",
                                "english": "The task of the state is to ensure that the solidarity of interests of all factors of production always prevails, and not the desire to exploit the momentary prosperity by some special factor, whether it be rentier capital, human labour or the factor of entrepreneurship, combining the two previous factors."
                            },
                            {
                                "example_id": "25460662-4ee6-4bd8-9607-7c4c2dcfbf16",
                                "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                                "text": "Oznacza to ni mniej ni więcej, że z punktu widzenia produkcji społecznej w warunkach imperializmu własność prywatna przestała być siłą napędzającą 1 organizującą produkcję. Przestała być siłą „wprawiającą w ruch całe bogactwo społeczne” i, co więcej, stała się zagrożeniem dla jej dalszego rozwoju. Tym samym kapitał przemysłowy przekształca się w rentierski, pasożytniczy.",
                                "translation": "This means nothing less than that, from the perspective of social production under imperialism, private property has ceased to be the driving and organizing force of production. It has ceased to be the force \"setting the entire social wealth in motion\" and, moreover, has become a threat to its further development. Thus, industrial capital is transformed into rentier, parasitic capital.",
                                "english": "This means nothing less than that, from the perspective of social production under imperialism, private property has ceased to be the driving and organizing force of production. It has ceased to be the force \"setting the entire social wealth in motion\" and, moreover, has become a threat to its further development. Thus, industrial capital is transformed into rentier, parasitic capital."
                            },
                            {
                                "example_id": "d5a1be0d-3122-48d8-aa57-b62d5d52f26e",
                                "sense_id": "5d9c333b-e762-3305-b8e7-888d04359c92",
                                "text": "Plan rentierski Skarbiec Rentier umożliwia uzyskiwanie stałych i systematycznych dochodów z inwestycji w wybrane fundusze.",
                                "translation": "The Skarbiec annuity plan allows you to obtain stable and systematic income from investments in selected funds.",
                                "english": "The Skarbiec annuity plan allows you to obtain stable and systematic income from investments in selected funds."
                            }
                        ]
                    }
