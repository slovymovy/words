                                "target_senses": [
                                    {
                                        "sense_id": "d1548ab6-0cb6-3e9c-aad4-5b102c367c3d",
                                        "entry_id": "dc90ed18-9358-3b39-884c-db48e14bb8dc",
                                        "glosses": [
                                            "Débarrasser des germes pathogènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9aa16a-7005-4ee1-8ee0-fc48f9dc09c9",
                                                "sense_id": "d1548ab6-0cb6-3e9c-aad4-5b102c367c3d",
                                                "text": "Seuls les passagers des avions en provenance de l’ouest sont soumis au flytoxage. Les avions venant d’Extrême-Orient ne sont jamais désinfectés."
                                            },
                                            {
                                                "example_id": "becc79c8-5bda-4f6f-8f81-ca68eb4ff119",
                                                "sense_id": "d1548ab6-0cb6-3e9c-aad4-5b102c367c3d",
                                                "text": "L’ensemble de l’outillage, des harnachements, du matériel et autres équipements devraient être régulièrement nettoyés et désinfectés, sous peine de voir ces équipements se couvrir d’une gangue de matière organique propice à la multiplication de bactéries pathogènes."
                                            },
                                            {
                                                "example_id": "9f14ea50-fb90-4db9-aaa5-21a4acee393e",
                                                "sense_id": "d1548ab6-0cb6-3e9c-aad4-5b102c367c3d",
                                                "text": "Je veux de l’eau, je veux me décroûter, désensanglanter, décailler, députrifier, dépuriner, désinfecter, défècier."
                                            }
                                        ]
                                    },
