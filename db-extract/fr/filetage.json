                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17442501-edb4-337f-9c13-38138035e87c",
                                        "entry_id": "b72dca2c-9486-3c2d-9376-e6753afff56f",
                                        "glosses": [
                                            "The degree of fineness; quality; nature."
                                        ],
                                        "tags": [
