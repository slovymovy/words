                "senses": [
                    {
                        "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                        "entry_id": "717373c1-c36a-3b42-9720-599f60cdc623",
                        "glosses": [
                            "suprasegmentales Merkmal, das eine Morphem- oder Wortgrenze anzeigt"
                        ],
                        "tags": [
                            "speziell Phonologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d5e66df2-3da2-4956-90ca-ac569de7d962",
                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                "text": "„Erst, wenn man einen Ausschnitt der Lautfolge isoliert, kann man leichter bestimmen, ob ein fester oder ein loser Anschluß - linguistisch gesprochen: eine geschlossene oder offene Junktur - vorliegt.“"
                            },
                            {
                                "example_id": "436c4166-483a-4127-8dbd-8acf0a1108a4",
                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                "text": "Die Wortfolgen „Ski fliegen“ und „schief liegen“ unterscheiden sich phonologisch nur durch die unterschiedliche Junktur."
                            },
                            {
                                "example_id": "3730b4e8-e15a-4249-8888-5cd157eaa049",
                                "sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                                "text": "„Wir vermeiden damit Formulierungen wie: Junktur markiert Fuge zwischen zwei Morphemen, was umgekehrt keineswegs immer der Fall ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e39f75c-1d5c-4269-9e0f-9d03553745a5",
                        "source_entry_id": "717373c1-c36a-3b42-9720-599f60cdc623",
                        "source_sense_id": "85af9f78-7437-36b0-ae38-f130b666c7ad",
                        "source_sense_description": "Linguistik, speziell Phonologie: suprasegmentales Merkmal, das eine Morphem- oder Wortgrenze anzeigt",
                        "target_lang_word": "juncture",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
