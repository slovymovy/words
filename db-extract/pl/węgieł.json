                "translations": [
                    {
                        "translation_id": "e4de0ee0-0f54-410a-9a19-c02c754ace48",
                        "source_entry_id": "d3431a87-7064-3aab-8bc7-03de5daa4426",
                        "source_sense_id": "bbfbcaf2-d767-3b89-a169-077611376b2b",
                        "target_lang_word": "quoin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quoin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a38f387-822f-3937-b593-3aafa44c7b7f",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "Any of the corner building blocks of a building, usually larger or more ornate than the surrounding blocks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8a3d089-f6d4-4518-b834-65987972c9d5",
                                                "sense_id": "6a38f387-822f-3937-b593-3aafa44c7b7f",
                                                "text": "In Casterbridge there stood a noble pile, […]\nBut evil days beset that domicile;\nThe stately beauties of its roof and wall\nPassed into sordid hands. Condemned to fall\nWere cornice, quoin, and cove,\nAnd all that art had wove in antique style."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1e81577-43e7-39e3-97c9-16983d24b583",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "The keystone of an arch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c68d3f6c-4f88-3199-b64a-87883b2818f7",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "A metal wedge which fits into the space between the type and the edge of a chase, and is tightened to fix the metal type in place."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d7485c-ddf8-43f0-a90f-c508f25a607c",
                                                "sense_id": "c68d3f6c-4f88-3199-b64a-87883b2818f7",
                                                "text": "Next fit the quoins, using the “persuader” to squeeze in the pages, and tap up all around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9acc772-4f35-3a4d-b388-5ee28b320f42",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "A form of wedge used to prevent casks from moving."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac5a57d0-de05-3552-89eb-44091eac3fc8",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "A wedge of wood or iron put under the breech of heavy guns or the muzzle of siege-mortars to raise them to the proper level."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "080f395a-1988-3bc8-a33b-4628b3ac2471",
                                        "entry_id": "4379f82f-ce42-3c78-a34a-a542a562fff8",
                                        "glosses": [
                                            "A number of apple varieties with a distinctive ribbed appearance, like corners of a coin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
