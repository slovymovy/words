                                        "glosses": [
                                            "het percentage van een bevolking dat een vaccinatie heeft ontvangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dae170-2931-4e08-8b6b-2e84ca48eeb9",
                                                "sense_id": "2f41a4ce-d302-3a49-bc53-390ae0c03958",
                                                "text": "De ondervraagden konden kiezen uit negen beleidsopties om de vaccinatiegraad te vergroten, bijvoorbeeld het belonen van gevaccineerden of juist het opleggen van beperkingen aan mensen die zich niet laten vaccineren."
                                            },
                                            {
                                                "example_id": "9e1abf41-b39c-4ca4-8569-d92cde1fefe6",
                                                "sense_id": "2f41a4ce-d302-3a49-bc53-390ae0c03958",
                                                "text": "De minister voegde eraan toe dat het kabinet wil dat zoveel mogelijk mensen zich laten vaccineren. \"De vaccinatiegraad moet zo hoog mogelijk zijn, maar mensen willen dat het een echte vrije keuze is.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
