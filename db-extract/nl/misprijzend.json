                ],
                "senses": [
                    {
                        "sense_id": "4069e3bb-9e2e-39ed-a334-7d29afc81574",
                        "entry_id": "d26b8883-754c-3fbf-9ec0-41ca4f009a02",
                        "glosses": [
                            "van afkeuring getuigend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f4cf67-b442-4b1a-b035-964357a50c3e",
                                "sense_id": "4069e3bb-9e2e-39ed-a334-7d29afc81574",
                                "text": "Lachend laat Marco zijn natte broekspijpen zien. Ondanks de regen heeft hij de opblaasbare stormbaan bedwongen, die op het grasveld achter de school te vinden is. ‘Ik was een van de eersten, maar ik werd wel kleddernat’, zegt hij met een misprijzende blik op zijn broek."
                            },
                            {
                                "example_id": "b50162b6-2c6c-45f2-ab77-acebcd2dcc7b",
                                "sense_id": "4069e3bb-9e2e-39ed-a334-7d29afc81574",
                                "text": "Nog niet zo lang geleden wierp ze zelf ook weleens een misprijzende blik op het supermarktmandje van de klant voor haar."
                            },
                            {
                                "example_id": "c204270b-b68a-48bd-8371-fdc4b2596cd5",
                                "sense_id": "4069e3bb-9e2e-39ed-a334-7d29afc81574",
                                "text": "Maar kom je een coffeeshop uit dan krijg je misprijzende blikken en ben je ineens een ‘drugsverslaafde’."
                            }
                        ]
                    }
