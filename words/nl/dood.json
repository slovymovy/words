                                "target_lang_sense_clarification": "polite term for death"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смерть",
                                "target_lang_sense_clarification": "событие кончины"
                            },
                            {
                                "target_lang_word": "кончина",
                                "target_lang_sense_clarification": "более вежливый термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62358df2-b246-3457-8ed4-d80804d2a1c5",
                    "sense_definition": "een personificatie van het einde van het leven, vaak afgebeeld als een skelet met een zeis",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In oude verhalen wordt de <w>dood</w> vaak afgebeeld met een zeis.",
                            "target_lang_translations": {
                                "en": "In old stories, <w>Death</w> is often depicted with a scythe.",
                                "ru": "В старинных историях <w>смерть</w> часто изображают с косой."
                            }
                        },
                        {
                            "text": "De <w>dood</w> maait met zijn zeis alle rangverschillen weg.",
                            "target_lang_translations": {
                                "en": "<w>Death</w> mows away all differences in rank with his scythe.",
                                "ru": "<w>Смерть</w> скашивает своей косой все сословные различия."
                            }
                        }
                    ],
                    "synonyms": [
                        "Magere Hein",
                        "man met de zeis",
                        "Pietje de Dood"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "mythological context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a personification of the end of life, often depicted as a skeleton with a scythe",
                        "ru": "олицетворение конца жизни, часто изображаемое в виде скелета с косой"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Death",
                                "target_lang_sense_clarification": "the personified figure"
                            },
                            {
                                "target_lang_word": "the Grim Reaper",
                                "target_lang_sense_clarification": "the skeletal figure with a scythe"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "смерть",
                                "target_lang_sense_clarification": "аллегорическая фигура"
                            },
                            {
                                "target_lang_word": "старуха с косой",
                                "target_lang_sense_clarification": "традиционный образ"
                            }
                        ]
                    }
                }
            ]
