                "senses": [
                    {
                        "sense_id": "cb37419f-d8ec-35d7-872c-eef6c6978fe1",
                        "entry_id": "7103c020-a4c4-3f5c-b494-0fbd3ce2da10",
                        "glosses": [
                            "Rendre toxique, polluer, empoisonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f1e6bb-2e31-4fb6-a0cb-01dfc2f3f478",
                                "sense_id": "cb37419f-d8ec-35d7-872c-eef6c6978fe1",
                                "text": "The more chemicals you use the more you have to use. The more you have to use the more you degrade and toxify the soil. The more you degrade and toxify the soil, the worse your pest problems become."
                            },
                            {
                                "example_id": "6dd6c3a3-2722-49ab-9b60-dec0659b3126",
                                "sense_id": "cb37419f-d8ec-35d7-872c-eef6c6978fe1",
                                "text": "Picture a healthy family that has decided as a unit that they do not want any of their members (or anyone else) to put poisons on their food, nor to toxify the water they drink, nor to toxify the air they breathe."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cebaf2d-edb6-3dd8-a90b-b96b421d342e",
                        "entry_id": "7103c020-a4c4-3f5c-b494-0fbd3ce2da10",
                        "glosses": [
                            "Intoxiquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e58544f-42f3-474e-92c6-17f4a8a96892",
                                "sense_id": "8cebaf2d-edb6-3dd8-a90b-b96b421d342e",
                                "text": "Senator Hughes. Is there any danger, if a patient is highly toxified on alcohol, in giving them Librium?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7c09cc68-8d37-39c7-a5b7-b16bf1f55a4c",
                        "entry_id": "7103c020-a4c4-3f5c-b494-0fbd3ce2da10",
                        "glosses": [
                            "Réduire à néant, neutraliser."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b15e4ee3-687e-40a4-8b18-87c4b4a3f74d",
                                "sense_id": "7c09cc68-8d37-39c7-a5b7-b16bf1f55a4c",
                                "text": "Not only was a hard Brexit offered by Theresa May, but the Brexiteers toxified the possibility of any negotiated deal in favour of the delusion of no deal."
                            }
                        ]
                    }
                ],
