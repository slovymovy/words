                    }
                ],
                "senses": [
                    {
                        "sense_id": "b42b254d-2ed5-3676-86e7-a456b4541214",
                        "entry_id": "0be622e6-7b60-3e5d-a016-7eda2b8b2c24",
                        "glosses": [
                            "forma żeńska od: śpiewak"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b390b6d1-7339-4acd-bf74-09762c43fc50",
                                "sense_id": "b42b254d-2ed5-3676-86e7-a456b4541214",
                                "text": "Na niewielką scenę w kącie sali wrócił właśnie, z przysługującej mu piętnastominutowej przerwy rekreacyjnej, trzyosobowy zespół złożony z gitarzysty, perkusisty i śpiewaczki o platynowych włosach, ubranej w czarno-srebrzystą suknię niepotrzebnie mocno odsłaniającą dekolt"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5cce5f4a-4e52-4197-9d05-c9c4d2cee749",
                        "source_entry_id": "0be622e6-7b60-3e5d-a016-7eda2b8b2c24",
                        "source_sense_id": "b42b254d-2ed5-3676-86e7-a456b4541214",
                        "target_lang_word": "zpěvačka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zpěvačka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "6ec8bf37-95e1-32ab-89ac-7dbe8784bf6b",
                                        "entry_id": "ae0ea0b2-c809-3678-ae46-f0df449f295d",
                                        "glosses": [
                                            "žena, která umí dobře zpívat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77390e5f-0ebd-4a22-8034-8498c9fbc5e5",
                                                "sense_id": "6ec8bf37-95e1-32ab-89ac-7dbe8784bf6b",
                                                "text": "Dnes je tam i pobožnost i zvědavost vábila. Mělať tam dnes paní Božena, rozhlášená zpěvačka, zpívati, a rytíř Slavibor byl k této slavnosti i manžela jejího mezi hudce postavil, ačkoli jej až dosavad ve vazbě držel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb1883a5-986e-4300-bda3-1841561ca4e3",
                        "source_entry_id": "0be622e6-7b60-3e5d-a016-7eda2b8b2c24",
                        "source_sense_id": "b42b254d-2ed5-3676-86e7-a456b4541214",
                        "target_lang_word": "Sängerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sängerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                        "entry_id": "5fe15538-19a4-3976-8172-2dce1f06139a",
                                        "glosses": [
                                            "eine weibliche Person, die berufsmäßig singt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9ac3999-028f-4a1e-87c5-d5ccbecff446",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "Pink, Christina Aguilera, Lil' Kim und Mya waren die Sängerinnen von „Lady Marmalade“."
                                            },
                                            {
                                                "example_id": "fd53d6cc-e810-4629-8441-8d06229e0f99",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Da ist eine schwarze Sängerin mit einer schönen Stimme.“"
                                            },
                                            {
                                                "example_id": "07c18ff4-22a4-4ef6-8dd5-58e2f161b372",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Sie war Sängerin, er hatte sie unterrichtet.“"
                                            },
                                            {
                                                "example_id": "3468df7e-917f-4662-a22f-4aeb021728d1",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Im zweiten Akt verkleidet die Gräfin, die sich von dem kleinen Schäker und Draufgänger gern anhimmeln lässt, den jungen Mann, der von einer Sängerin gespielt wird, in eine junge Frau.“"
                                            },
                                            {
                                                "example_id": "a6427adf-a57b-467a-8914-de5749063fc5",
                                                "sense_id": "29d9eb38-1dbe-3773-8ebc-1a45e04cce90",
                                                "text": "„Vorübergehend trat sie als Sängerin auf, im langen weißen Kleid aus fließender Seide.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d5df0b3-4516-367c-8c0b-578bb8038252",
                                        "entry_id": "5fe15538-19a4-3976-8172-2dce1f06139a",
                                        "glosses": [
                                            "eine weibliche Person, die hobbymäßig, zum Beispiel in einem Chor singt"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a679b5c-ecbb-434c-b07d-127d5fe58f00",
                                                "sense_id": "5d5df0b3-4516-367c-8c0b-578bb8038252",
                                                "text": "Laura steht in dem Ruf, eine gute Sängerin zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5bcacfe0-d894-494c-ba95-bf0406d973bc",
                        "source_entry_id": "0be622e6-7b60-3e5d-a016-7eda2b8b2c24",
                        "source_sense_id": "b42b254d-2ed5-3676-86e7-a456b4541214",
                        "target_lang_word": "певица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "певица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "29ae9d86-6fa6-3430-9833-1038fbcccd26",
                                        "entry_id": "3d4a65f4-59c1-348c-b373-00c62771680e",
                                        "glosses": [
                                            "женск. к певец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55b81804-976c-4a3d-952f-4619392581dc",
                                                "sense_id": "29ae9d86-6fa6-3430-9833-1038fbcccd26",
                                                "text": "На эстраду вышла декольтированная певица, с трубочкою нот в руках, в сопровождении аккомпаниатора во фраке."
                                            },
                                            {
                                                "example_id": "4b034bec-8192-4dcb-8d85-1429d24d9d87",
                                                "sense_id": "29ae9d86-6fa6-3430-9833-1038fbcccd26",
                                                "text": "На эстраде сменялись певицы и танцовщицы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
