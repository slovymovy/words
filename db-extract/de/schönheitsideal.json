                "senses": [
                    {
                        "sense_id": "72563fbe-a9e1-37e6-a80a-7d6b133bd003",
                        "entry_id": "092e6779-644f-38c0-97c6-8e9ed168aa36",
                        "glosses": [
                            "etwas, das jemandem als das Ideal des Schönen vorschwebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "336c1751-c0ba-4bca-8634-5a5c458aa63b",
                                "sense_id": "72563fbe-a9e1-37e6-a80a-7d6b133bd003",
                                "text": "Da Schönheit individuell ist, ist ein Schönheitsideal nicht festlegbar."
                            },
                            {
                                "example_id": "80606dc3-8f1e-4bb5-afe5-525083ba2a27",
                                "sense_id": "72563fbe-a9e1-37e6-a80a-7d6b133bd003",
                                "text": "Das Schönheitsideal des antiken Griechenlandes lässt sich noch heute an den Skulpturen aus dieser Zeit festmachen."
                            },
                            {
                                "example_id": "9ca0086c-ca4c-4f7c-b86c-0aca5674dce3",
                                "sense_id": "72563fbe-a9e1-37e6-a80a-7d6b133bd003",
                                "text": "„So haben sich unsere Maler seit je weibliches Schönheitsideal vorgestellt und bildlich zur Darstellung gebracht: Taillen vergleichbar biegsamen Weidenruten, die Gliedmaßen nicht prall, sondern lose in der Gewandung steckend.“"
                            },
                            {
                                "example_id": "b42445d8-9636-4b48-9aa2-53e08b86dc4b",
                                "sense_id": "72563fbe-a9e1-37e6-a80a-7d6b133bd003",
                                "text": "„So saßen wir in der Küche seines Bungalows, tranken Veuve Cliquot und redeten über Fettabsaugung, Schönheitsideale und Facelifting.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
