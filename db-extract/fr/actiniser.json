                "senses": [
                    {
                        "sense_id": "5db85277-465a-3a53-8eec-248570f431a9",
                        "entry_id": "f1e1ec15-09d8-3e1f-819a-097c806460ae",
                        "glosses": [
                            "Synonyme de irradier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd30f303-531e-42fe-a049-b38004261c62",
                                "sense_id": "5db85277-465a-3a53-8eec-248570f431a9",
                                "text": "Cependant au-delà de 3 microns, le tube en quartz, dans lequel circule le vin à actiniser, s’opacifie et devient imperméable aux rayonnements."
                            },
                            {
                                "example_id": "4fd77a45-f0ee-4df4-a7da-7017052d4c4f",
                                "sense_id": "5db85277-465a-3a53-8eec-248570f431a9",
                                "text": "Il peut enfin être intéressant, pour augmenter le pouvoir antirachitique de certains aliments, de les irradier en couches minces ou de les « actiniser » par passage dans des tubes capillaires exposés au rayonnement U.V. ;"
                            }
                        ]
                    }
