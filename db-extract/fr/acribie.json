                "senses": [
                    {
                        "sense_id": "52d4e87d-68a9-3156-99ea-17eef775437a",
                        "entry_id": "43655655-0f29-3960-b8a5-5db9985a499c",
                        "glosses": [
                            "Qualité de celui qui travaille, ou qui exerce le strict droit, avec le soin le plus scrupuleux et avec une grande précision."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "f6a7df1f-d9ce-49fa-b8ce-8a6419ff6cf9",
                                "sense_id": "52d4e87d-68a9-3156-99ea-17eef775437a",
                                "text": "De son côté, avec son acribie coutumière, M. Lieberman vient d’entreprendre l’examen de ce difficile problème."
                            },
                            {
                                "example_id": "cd4fd910-bfb8-4de2-b23e-aba687fca67f",
                                "sense_id": "52d4e87d-68a9-3156-99ea-17eef775437a",
                                "text": "D’une part, donc, Origène soulève des questions autour de certains passages problématiques du texte évangélique, en déployant largement l’acribie du chercheur dont il est capable, et cela dans la formulation des apories comme dans leur solution."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b4ed496-5f4c-4b83-bfee-13f47c792ea5",
                        "source_entry_id": "43655655-0f29-3960-b8a5-5db9985a499c",
                        "source_sense_id": "52d4e87d-68a9-3156-99ea-17eef775437a",
                        "target_lang_word": "Akribie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akribie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                        "entry_id": "6a3d8b4f-54d7-3544-a579-72df21b92a87",
                                        "glosses": [
                                            "höchste Sorgsamkeit, höchste Genauigkeit, äußerste Gründlichkeit"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b59fa24-481a-4580-b843-30b99190daab",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "Er erledigte diese Aufgabe mit großer Akribie."
                                            },
                                            {
                                                "example_id": "d936c86c-6249-48db-a20c-77fb4d227a7c",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Mir wurde bald deutlich, daß man sogenannter objektiver Wahrheit nicht ohne alle erdenkliche Akribie habhaft werden kann.“"
                                            },
                                            {
                                                "example_id": "2b04487e-9a0c-4906-9c01-42686ac26bf7",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "In der Orthodoxie ist Akribie die äußerste Genauigkeit, nach der alle Gebote gewissenhaft befolgt werden müssen."
                                            },
                                            {
                                                "example_id": "c1519b5c-fa35-4172-b230-cdef38c0ef13",
                                                "sense_id": "07632ff6-dbd3-3fdc-a922-2df8b21862e9",
                                                "text": "„Aber die Akribie derartiger Zusammenstellungen verrät einen Hang zur Eindeutigkeit, den die folgenden Ausschweifungen nicht teilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
