                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "082deb65-d781-40dd-9f7a-77cc8fd1d281",
                                                "sense_id": "6d0026a2-e6e1-329a-bbcb-35dbcfeb61be",
                                                "text": "Прежде он думал, что он, русский человек, — жертва интриг, несправедливостей, притеснений, жертва людской неблагодарности, жадности, бедности, и был твёрдо уверен, что освободись он хоть на одну минуту от всех вышеупомянутых бед, так сейчас же, сию минуту, все увидят, как он добр, благороден, великодушен, вежлив, щедр, непоколебим и честен…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f85e185-4fa1-337e-aeae-e7195f8da3e3",
                                        "entry_id": "19da20e8-9d5b-3057-a6f9-42ba2a496318",
                                        "glosses": [
                                            "сильное желание чего-либо, страстный интерес"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b71567e5-f9bf-4f79-8427-5987c9bc6e12",
                                                "sense_id": "2f85e185-4fa1-337e-aeae-e7195f8da3e3",
                                                "text": "С жадностью читать книгу"
                                            },
                                            {
                                                "example_id": "252ead40-a7eb-4df9-8654-2c35046e0385",
                                                "sense_id": "2f85e185-4fa1-337e-aeae-e7195f8da3e3",
                                                "text": "После пережитого он с жадностью выпил воды."
                                            }
                                        ]
                                    }
                                ]
                            }
