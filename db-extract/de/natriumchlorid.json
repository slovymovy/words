                                    {
                                        "sense_id": "4fca09a0-fe71-3159-86b7-dbbc7470103a",
                                        "entry_id": "c4d00254-20eb-340c-911b-11713d41644f",
                                        "glosses": [
                                            "Common table salt, a compound composed of equal number of sodium and chlorine atoms. Chemical formula NaCl."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "653eb2e8-d180-43b1-aef9-98246668d0c4",
