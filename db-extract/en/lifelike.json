                "senses": [
                    {
                        "sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
                        "entry_id": "bcd23b9e-6e1d-3c51-a90a-3cb9bff8a9d1",
                        "glosses": [
                            "Like a living being, resembling life, giving an accurate representation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c83d166-945b-4ecf-95c3-cc85974504ee",
                                "sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
                                "text": "a lifelike portrait"
                            },
                            {
                                "example_id": "a4b39da5-0f44-412b-bae6-188314b72bbd",
                                "sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
                                "text": "The robot was so lifelike, Jack could hardly tell it apart from his sister."
                            },
                            {
                                "example_id": "e223081d-6594-4a5a-ba2d-b069237cda60",
                                "sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
                                "text": "The stories did not seem to me to touch life. […] They left me with the impression of a well-delivered stereopticon lecture, with characters about as life-like as the shadows on the screen, and whisking on and off, at the mercy of the operator."
                            },
                            {
                                "example_id": "edaa188e-2d99-417e-a19a-9a805824e58a",
                                "sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
                                "text": "But part of the movie’s nonstop fun is the way [Christopher] McQuarrie taps back into the genre’s (and this series’) games of subterfuge, misdirection, and indeterminate loyalties, beginning with the fiendishly clever rug-pull of its worst-case-scenario prologue and epitomized by the goofily irresistible sight of characters dramatically ripping off lifelike rubber masks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c2971a6-429f-42b1-b9f7-fe76d3c58372",
                        "source_entry_id": "bcd23b9e-6e1d-3c51-a90a-3cb9bff8a9d1",
                        "source_sense_id": "d01ddc5e-481d-305e-9c97-5e39acfb6b12",
