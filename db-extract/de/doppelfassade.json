                ],
                "senses": [
                    {
                        "sense_id": "4c8459ba-b0e0-3a35-8310-411a362b05a6",
                        "entry_id": "9cadeaf1-9865-3870-8cd5-abfeb974c81f",
                        "glosses": [
                            "eine Fassade mit zwei Fassadenebenen, zwischen denen ein Zwischenraum von mindestens 20 cm bis zu mehreren Metern zu bestehen hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bfec896-f2cb-4096-a0bc-17972fde099b",
                                "sense_id": "4c8459ba-b0e0-3a35-8310-411a362b05a6",
                                "text": "„Die Fassade erhält ebenso ein neues Gesicht aus Glas und Stahl mit einem windgeschützten Sonnenschutz in der Doppelfassade und einer natürlichen Be- und Entlüftung.“"
                            },
                            {
                                "example_id": "0b86df23-e8d4-45ec-83ce-610ee579bbe0",
                                "sense_id": "4c8459ba-b0e0-3a35-8310-411a362b05a6",
                                "text": "„Die Gebäudehülle ist eine Doppelfassade aus Glasbausteinen, zwischen denen ein begehbarer Erlebnisraum entstanden ist.“"
                            },
                            {
                                "example_id": "53c4ec06-179d-45a3-8c4d-e4098841f195",
                                "sense_id": "4c8459ba-b0e0-3a35-8310-411a362b05a6",
                                "text": "„Die Gebäudehülle ist als Doppelfassade konzipiert. Die Außenwand besteht aus Glasbausteinen und Sichtbeton, die dahinterliegende eigentliche Gebäudewand ist aus Glas.“"
                            },
                            {
                                "example_id": "6078ecec-a482-4739-98a8-b978b9eb9ebd",
                                "sense_id": "4c8459ba-b0e0-3a35-8310-411a362b05a6",
                                "text": "„Zwischen der Doppelfassade findet sich ein begehbarer Raum. Man bewegt sich draußen im Inneren - und erlebt dies in den Höhen der Bibliothek noch intensiver als im Kunstmuseum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
