                        "glosses": [
                            "Femme qui joue au handball."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6960fd1c-6b39-4968-9a33-823ea077d8b2",
                                "sense_id": "0ecc8dc6-7927-388f-bb1a-6988c7f6451c",
                                "text": "Benjamine surdouée, la Corse de Porto-Vecchio née à Abidjan d’un père footballeur et d’une mère handballeuse, a suivi une trajectoire linéaire et quasi parfaite."
                            }
                        ]
                    }
                ],
