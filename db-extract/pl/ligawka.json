                        "glosses": [
                            "ludowy instrument dęty wykonany z wydrążonego, przeciętego wzdłuż pnia drzewa, np. olchy, owiniętego łykiem; wydaje przenikliwy, donośny dźwięk; podobny do trombity i bazuny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8409e8-04db-47a6-b62b-8515fab1ddd5",
                                "sense_id": "9f4815cf-432f-34e6-bd19-ff42d81e8a7d",
                                "text": "Potem spod boru, spod ciemnego ozwała się przeciągle ligawka…"
                            },
                            {
                                "example_id": "05929b1d-2d95-4b6f-97c9-dd1cdd3de161",
                                "sense_id": "9f4815cf-432f-34e6-bd19-ff42d81e8a7d",
                                "text": "Ligawka miała dziwny głos płaczu i skargi, jakby jęk duszy tych wierzbin, tych drzew tęskniących za słońcem, za wichrem, co buja po polach […]"
                            },
                            {
                                "example_id": "5c59fae9-94d8-4e64-8a91-fb45846db21d",
                                "sense_id": "9f4815cf-432f-34e6-bd19-ff42d81e8a7d",
                                "text": "Wyznaję, że ta ligawka pięknie gra"
                            },
                            {
                                "example_id": "9433b778-bb09-4d57-a86a-e2588b055067",
                                "sense_id": "9f4815cf-432f-34e6-bd19-ff42d81e8a7d",
                                "text": "(…) tony ligawek pastuszych się odzywały i śpiewały żale jakieś prostacze, dziecięce, jakby żale dzieci, co pogubiły ojców […]"
                            }
                        ],
