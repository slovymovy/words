                    {
                        "sense_id": "ca8512ff-6f60-37b9-894a-38658476579a",
                        "entry_id": "6e312673-fa0c-36a4-8167-cd38eac19c9e",
                        "glosses": [
                            "körperlich und/oder geistiges Zurückbleiben auf der Entwicklungsstufe eines Kindes"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "055a2ee9-d662-4e08-b558-6429178257b2",
                                "sense_id": "ca8512ff-6f60-37b9-894a-38658476579a",
                                "text": "Menschen mit Infantilismus wurden aufgrund ihres Andersseins gern auf Jahrmärkten zur Schau gestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d480d2b3-6302-3e2a-81d8-4f0d82d52ab2",
                        "entry_id": "6e312673-fa0c-36a4-8167-cd38eac19c9e",
                        "glosses": [
                            "Äußerung oder Verhalten, das dem eines Kindes ähnelt, das kindisch/unreif wirkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac8d090e-d894-463e-b095-349065b3fa38",
                                "sense_id": "d480d2b3-6302-3e2a-81d8-4f0d82d52ab2",
                                "text": "„Über solche Infantilismen ziehen aber nicht nur die Russen die Brauen hoch, und wie man hört, sind sie selbst drüben jetzt vorübergehend seltener geworden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
