                                        "sense_id": "aad32dc0-f6da-37ca-a844-0a3e42738722",
                                        "entry_id": "8fcbd951-eb82-39f1-b9c2-a2fa782da89a",
                                        "glosses": [
                                            "Participe présent du verbe acter."
                                        ],
