                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "300bcb04-5d1d-4730-8358-04b6ad14e1ce",
                                                "sense_id": "4603f055-475c-3160-89ed-e7d96ba2bd5d",
                                                "text": "De cet amour trop pusillanime, car Dieu veut qu’on ose aussi, et le seul qu’elle n’ait pas couronné, Géraldine fut toujours hantée, même et surtout aux heures brillantes de sa carrière aspasienne."
                                            },
                                            {
                                                "example_id": "f663880b-3d4c-44d3-bb3d-16d84a2b12ce",
                                                "sense_id": "4603f055-475c-3160-89ed-e7d96ba2bd5d",
                                                "text": "C’est près du pont des Arts à Paris que Géraldine et Bernard Siouffi se sont rencontrés il y a 25 ans."
                                            },
                                            {
                                                "example_id": "36926283-2b8d-4032-9dbe-03baa1529b27",
                                                "sense_id": "4603f055-475c-3160-89ed-e7d96ba2bd5d",
                                                "text": "C’est par exemple le cas de Géraldine Sohier, qui a été tuée en 2016."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
