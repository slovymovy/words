        "fr-extract.jsonl": [
            {
                "entry_id": "2ab6ae12-5116-3a8d-8d4a-29eda466ed47",
                "word": "flamant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "87f4f9cf-8ae9-47fd-bab3-0d84e3d344c4",
                        "entry_id": "2ab6ae12-5116-3a8d-8d4a-29eda466ed47",
                        "tags": [
                            "plural"
                        ],
                        "form": "flamants"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8b47004-2a57-3e49-81f5-03ae00c2e5f6",
                        "entry_id": "2ab6ae12-5116-3a8d-8d4a-29eda466ed47",
                        "glosses": [
                            "Oiseau échassier, ainsi nommé à cause de la belle couleur de son plumage comparée à une flamme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac9994b-16bd-4d92-80ee-2258440ee06c",
                                "sense_id": "b8b47004-2a57-3e49-81f5-03ae00c2e5f6",
                                "text": "Du costé de la transmontane advola vn grand, gras, gros, gris pourceau ayant æsles longues & amples comme sont les æsles d'vn moulin a vent. Et estoit le pēnaige rouge cramoysi, cōme est d'vn phoenicoptere: qui en langueguoth est appellé flammāt."
                            },
                            {
                                "example_id": "ad3bac3a-7e06-4c7d-a64a-1bef7b81e1f9",
                                "sense_id": "b8b47004-2a57-3e49-81f5-03ae00c2e5f6",
                                "text": "Si le chef aux cris sublimes est un aigle ; Canalis, blanc et rose, est comme un flamant."
                            },
                            {
                                "example_id": "2ab79420-8196-497d-b5f6-fc18e3544be6",
                                "sense_id": "b8b47004-2a57-3e49-81f5-03ae00c2e5f6",
                                "text": "Les hérons aux ailes de fer et les flamants dont le col se recourbe, traversent les mornes étendues ; les faisans courent sur le sable vert et l’horizon n’est qu’une ligne égale et brune que vient rompre à peine la cime noire d’un pin parasol."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8d2fdb02-87da-495f-8316-bac2efdf1a16",
                        "source_entry_id": "2ab6ae12-5116-3a8d-8d4a-29eda466ed47",
                        "source_sense_id": "b8b47004-2a57-3e49-81f5-03ae00c2e5f6",
                        "target_lang_word": "Flamingo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flamingo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                        "entry_id": "749180f9-85f0-3265-9fb8-1814e1e832a0",
                                        "glosses": [
                                            "Vogel mit langen dünnen Beinen, einem langen biegsamen Hals und einem rosa Gefieder"
                                        ],
                                        "tags": [
                                            "Phoenicoparrus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbc11f5-7554-4104-bc85-6695f11bd9a5",
                                                "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                                "text": "Das Gefieder der Flamingos weist stets unterschiedliche Rosatöne auf."
                                            },
                                            {
                                                "example_id": "a912f655-93a9-4414-bdd3-a6eccadfcff4",
                                                "sense_id": "30730e70-b9c0-3377-8954-7d77fe17a324",
                                                "text": "„Jan grinste mich von der Seite an, während wir über die Miniatur-Wege Richtung Ausgang liefen, einbeinige Flamingos zu unserer Rechten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2978e390-3d72-4001-bc40-704943a20b2a",
                        "source_entry_id": "2ab6ae12-5116-3a8d-8d4a-29eda466ed47",
