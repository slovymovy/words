                    {
                        "sense_id": "0d0cf552-5f5b-377e-8fa3-3aafca26bd3d",
                        "entry_id": "43cfbd9d-0a19-378b-864b-decc8f6cf1b9",
                        "glosses": [
                            "das Auftreffen/Einschlagen (und Explodieren) einer Rakete/Raketenwaffe"
