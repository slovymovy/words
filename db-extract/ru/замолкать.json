                "senses": [
                    {
                        "sense_id": "4f88bb4c-2f9a-36d3-96fb-6d4803dd7e2c",
                        "entry_id": "93767cdb-ada8-3b7e-9f1a-398a27aa3770",
                        "glosses": [
