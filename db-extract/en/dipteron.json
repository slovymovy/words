                "senses": [
                    {
                        "sense_id": "20b06665-3301-330e-adeb-314dab4a1a4a",
                        "entry_id": "f571d5a5-6978-353e-bf9f-d200befb43e8",
                        "glosses": [
                            "Alternative form of dipteros."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "82e98160-a4d5-4f7f-8e54-e4814b4c47eb",
                                "sense_id": "20b06665-3301-330e-adeb-314dab4a1a4a",
                                "text": "It is also a Pseudodipteron, that is, a false Dipteron; for at first they us'd to build a Dipteron, that is, a double Wing, or Row of Pillars about; but Hermogenes afterwards brought up the Custom of taking away the inner Row of Pillars, so to make the Walking-Place more open, which sort of Wings is call'd Psuedodipteron, because they imitated the Form of the Dipteron."
                            },
                            {
                                "example_id": "d17b1936-1565-4b8e-b8e8-39819d002e1b",
                                "sense_id": "20b06665-3301-330e-adeb-314dab4a1a4a",
                                "text": "The first dipteron on Samos is dated by Buschor 560-550 B.C. or earlier (see below, pp. 199 f.)."
                            },
                            {
                                "example_id": "bb63a30c-1b1f-44fb-aa33-1b45b6e77ce5",
                                "sense_id": "20b06665-3301-330e-adeb-314dab4a1a4a",
                                "text": "It seems to have been the original Samian dipteron, laid down perhaps shortly before 560 B.C., that set the pace; and this great building not only excited the rivalry of the Ephesians but set the pattern for architectural forms on Chios also."
                            }
                        ]
                    }
                ],
