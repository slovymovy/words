                "senses": [
                    {
                        "sense_id": "e0c8a62a-d88f-3d0d-94f9-075ffdfe40e7",
                        "entry_id": "f0b51859-fff8-3aa2-a6d2-eccc0694d625",
                        "glosses": [
                            "die von der in der Paulskirche (Frankfurt am Main) tagenden Frankfurter Nationalversammlung erarbeitete und am 28. März 1849 veröffentlichte Verfassung, die eine konstitutionelle Monarchie vorsah; erste demokratisch beschlossene Verfassung für ganz Deutschland, die allerdings nie umgesetzt wurde"
                        ],
                        "tags": [
                            "deutsche Geschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "1f9ee3e5-6a85-45ec-b44f-7a3d49de774a",
                                "sense_id": "e0c8a62a-d88f-3d0d-94f9-075ffdfe40e7",
                                "text": "„Die sogenannte Paulskirchenverfassung vom 27. März 1849 war die erste demokratisch beschlossene Verfassung für ganz Deutschland.“ […] „So habe die Paulskirchenverfassung zwar ›ein für damalige Verhältnisse bahnbrechend demokratisches Wahlgesetz‹ geschaffen, sagte Köhler.“ […] „Die Paulskirchenverfassung sei ›Kern unserer demokratischen Tradition‹, sagte der Bundespräsident.“ […] „Beim Festakt zum 160. Jahrestag der Paulskirchenverfassung rief er die Politik zu ›mehr demokratischer Transparenz und Verantwortlichkeit‹ auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
