                    {
                        "translation_id": "db85c921-b66d-484b-a729-82d9bb7fffb7",
                        "source_entry_id": "5bc5df06-5837-3b31-ba2d-60b57569627c",
                        "source_sense_id": "9b3496c8-b9b2-3baf-974f-09d4c0c9acbf",
