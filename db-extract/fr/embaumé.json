                        "entry_id": "d878cd44-68a5-3c75-a4f1-48a1e97b7351",
                        "glosses": [
                            "Odorant, parfumé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ef27a08-a794-4aee-9aa1-57f5b926a2ca",
                                "sense_id": "ddf01df9-7a6b-300d-ae2b-fe79ae53ab9b",
                                "text": "Sous une toilette criarde, ton corps mouvant laisse derrière lui flotter un sillage embaumé."
                            },
                            {
                                "example_id": "f1cf01f0-2128-4236-9d0b-51cc5767b69e",
                                "sense_id": "ddf01df9-7a6b-300d-ae2b-fe79ae53ab9b",
                                "text": "On sentait l’eau bénite et le parfum des fleurs. C’était un petit coin embaumé, mystérieux, doux, à l’écart dans l’église."
                            }
                        ]
                    }
