                ],
                "senses": [
                    {
                        "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                        "entry_id": "12673be1-066e-3415-8703-0fd2de102621",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b9517e-ec7b-47fc-863a-a5d910f5ed45",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Frau Skelton ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b0195b90-3fdb-49e1-941b-5dada22a15be",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Herr Skelton wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ade29a85-5216-4cb9-a821-bcee743ee4de",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Die Skeltons kommen heute von Helgoland."
                            },
                            {
                                "example_id": "53c4b8e2-5fd5-4ef6-86d3-ed9aef150b7e",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Der Skelton trägt nie die Schals, die die Skelton ihm strickt."
                            },
                            {
                                "example_id": "9b9692bc-14cd-413b-9333-d09c5f4d84e3",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Skelton kommt, geht der Herr Skelton.“"
                            },
                            {
                                "example_id": "41686ba8-1341-45f8-8aed-7db0e6847984",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Skelton kommt und geht."
                            },
                            {
                                "example_id": "764aa9e4-c5b8-41e3-ad1d-a8b88e09e649",
                                "sense_id": "9757abb7-0038-3bc0-a1f7-7afeff440aec",
                                "text": "Skeltons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
