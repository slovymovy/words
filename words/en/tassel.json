    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "284f727e-1c96-3133-8f42-04937ee0d1a7",
                    "sense_definition": "A dangling decorative knot or tuft of threads or cords fastened at one end, often used on garments, curtains, or graduation caps.",
