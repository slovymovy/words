                        "sense_id": "44c233bd-875a-3c68-a77d-3f09e9c27cbd",
                        "entry_id": "9922baff-755f-37c0-9a05-24f0165f4995",
                        "glosses": [
                            "решительно, безоговорочно ( в сочетании с отказывать(ся); с другими — )"
                        ],
                        "tags": [
                            "obsolete",
