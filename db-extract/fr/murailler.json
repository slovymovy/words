                "senses": [
                    {
                        "sense_id": "7ae163d8-1add-38ac-a153-704e6e4acccc",
                        "entry_id": "2a8b6b8c-7d40-3196-b864-1ac544abdc49",
                        "glosses": [
                            "Recouvrir d’une muraille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1ddcbc-ff7f-4069-8450-77e05aa128f6",
                                "sense_id": "7ae163d8-1add-38ac-a153-704e6e4acccc",
                                "text": "Ces murs [de l’Escurial] sont fort épais ; on y fait des creux et on met un corps dans chacun, qu’on muraille par-dessus, en sorte qu’il n’en paraît rien."
                            }
                        ]
                    },
                    {
                        "sense_id": "05c08f00-937c-3662-903d-8d979284249d",
                        "entry_id": "2a8b6b8c-7d40-3196-b864-1ac544abdc49",
                        "glosses": [
                            "Soutenir par un mur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0edbc1c9-89ac-4806-8a75-34daab141935",
                                "sense_id": "05c08f00-937c-3662-903d-8d979284249d",
                                "text": "Murailler un puits de mine, un souterrain, un remblai. Tranchée muraillée."
                            },
                            {
                                "example_id": "1dc066ae-47b2-4f7e-ac4b-8c8b7e9838a9",
                                "sense_id": "05c08f00-937c-3662-903d-8d979284249d",
                                "text": "Les roches marneuses et délitables durent être muraillées."
                            }
                        ]
                    }
                ],
