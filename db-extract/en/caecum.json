                                    {
                                        "sense_id": "ad5791dc-6166-3706-8f46-0b2a8eeea1f3",
                                        "entry_id": "f85bb4f8-5195-3b64-b9a8-28e373a0b133",
                                        "glosses": [
                                            "der im rechten Mittelbauch liegende Anfangsteil des Dickdarms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32bee661-7069-46ed-a6f2-2a8d0bf5d11a",
                                                "sense_id": "ad5791dc-6166-3706-8f46-0b2a8eeea1f3",
                                                "text": "„Es war der Fluch der Roth-Männer, deren Blinddarm oft retrozäkal lag, das heißt hinter dem Dickdarm, wo eine Schwellung unbemerkt blieb, bis es zu spät war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c5f8338-08d1-3b8e-8fe1-af918f67bdea",
                                        "entry_id": "f85bb4f8-5195-3b64-b9a8-28e373a0b133",
                                        "glosses": [
                                            "für den Wurmfortsatz"
                                        ],
                                        "tags": [
                                            "volkstümlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b505ab7-5c43-47c1-85c4-8392d5c3cf78",
                                                "sense_id": "3c5f8338-08d1-3b8e-8fe1-af918f67bdea",
                                                "text": "Viele Menschen müssen irgendwann am Blinddarm operiert werden."
                                            },
                                            {
                                                "example_id": "c5dc288f-319e-4270-9694-cb2fbda25427",
                                                "sense_id": "3c5f8338-08d1-3b8e-8fe1-af918f67bdea",
                                                "text": "Nach einer missglückten Blinddarm-Operation entschied sich Kallistheni Leonidou, Ärztin zu werden und anderen Menschen zu helfen."
                                            },
                                            {
                                                "example_id": "d9768dc4-8103-4349-ad07-18e0bb583f6c",
                                                "sense_id": "3c5f8338-08d1-3b8e-8fe1-af918f67bdea",
                                                "text": "Eine medizinische Besonderheit beim Pferd ist dessen – verglichen mit uns Menschen – extrem großer Blinddarm. In ihm wird das Futter verarbeitet, vergleichbar mit dem menschlichen Magen."
                                            },
                                            {
                                                "example_id": "59a527e4-4a68-4f1d-aa2a-96c917d34ad9",
                                                "sense_id": "3c5f8338-08d1-3b8e-8fe1-af918f67bdea",
                                                "text": "„Nur wenige Patienten besitzen die edle Einfalt des Grafen Bobby, der soeben erfahren hat, daß sich ein berühmter Chirurg den Blinddarm eigenhändig herausnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
