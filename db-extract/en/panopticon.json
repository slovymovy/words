                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ead9029-d8e7-4a8c-af79-597c9fed0153",
                                                "sense_id": "a6c661f3-0ae8-3d08-a713-0d478eeffe7c",
                                                "text": "„Das Panoptikum verfügt heute über 130 Figuren von historischen Persönlichkeiten in wertvollen Kostümen, internationale Berühmtheiten und Hamburger Stars.“"
                                            },
                                            {
                                                "example_id": "7d82a4c0-8065-4bc2-a4c6-60501daebbc4",
                                                "sense_id": "a6c661f3-0ae8-3d08-a713-0d478eeffe7c",
                                                "text": "„Nachdem im Oktober 1934 Karl Valentins ‚Lach- und Gruselkabinett‘, das Panoptikum, eröffnet war, konstatierte ein Kritiker: ‚Wer einmal in Valentins Panoptikum war, hat die Nase voll - oder hat den Humor verstanden und kommt wieder.‘“"
                                            },
                                            {
                                                "example_id": "94d08807-bb86-4b69-8d56-5dcd4c029c8f",
                                                "sense_id": "a6c661f3-0ae8-3d08-a713-0d478eeffe7c",
                                                "text": "„Vor ein paar Jahren hatte er das gesamte Inventar des Panoptikums ersteigert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb419c9f-4517-35fa-b29f-4d4f64344f47",
                                        "entry_id": "4f801594-09c0-3cbd-947e-7a49657c1c7d",
                                        "glosses": [
                                            "Konzept für den Bau von Gefängnissen oder Fabriken nach Bentham, bei der eine Überwachung mit minimalem Personalaufwand möglich ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3c425bc-d992-4f0e-ace9-3cc1cc0d146c",
                                                "sense_id": "cb419c9f-4517-35fa-b29f-4d4f64344f47",
                                                "text": "Die Welt als Warenhaus erweist sich als digitales Panoptikum mit einer Totalüberwachung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
