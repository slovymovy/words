                "senses": [
                    {
                        "sense_id": "98d5995d-63d2-3b28-94d7-294e6d9f6c33",
                        "entry_id": "8941741c-b382-351d-9c1f-c980ee9761c3",
                        "glosses": [
                            "Faire perdre son caractère événementiel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f0637c2-6f09-4bf7-8974-80e005f63f3e",
                                "sense_id": "98d5995d-63d2-3b28-94d7-294e6d9f6c33",
                                "text": "Pour défaire la calculatorité de la finance, il faudrait désévènementialiser sa structure et déquantiviser ses éléments : cela veut dire que devrait cesser d’être la référence exclusive du système l’avènement ou le non avènement d’actes de paiement et les sommes qui y sont impliquées."
                            },
                            {
                                "example_id": "066598a1-8581-41ce-ac14-2f13bd20efaf",
                                "sense_id": "98d5995d-63d2-3b28-94d7-294e6d9f6c33",
                                "text": "Il y a donc le souci de « désévènementialiser » la COP."
                            }
                        ]
                    }
