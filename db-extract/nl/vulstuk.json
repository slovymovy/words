                        "entry_id": "e28262a8-9604-3972-9b42-7ce2b3998c62",
                        "glosses": [
                            "voorwerpen die een lege ruimte kunnen opvullen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3dd134c-190b-459b-964d-5e91bd670c6d",
                                "sense_id": "1eec766f-0595-3028-bb5f-a14b302bfe48",
                                "text": "Het interieur is ingedeeld met voorin een grote rondzit die met vulstukken tot zonnebed kan worden omgetoverd."
                            },
                            {
                                "example_id": "d2784027-0357-4396-8949-3b051450b677",
                                "sense_id": "1eec766f-0595-3028-bb5f-a14b302bfe48",
                                "text": "Achterin de 588 zijn de hoge enkele bedden gesitueerd, toegankelijk met treden waarin kleine spullen kunnen worden opgeborgen. De twee slaapplekken tover je in een handomdraai om – met een vulstuk (optie) – tot een riante tweepersoons matras van twee bij twee meter."
                            }
                        ]
                    }
                ],
                "translations": [
