                    {
                        "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                        "entry_id": "eddf7acb-922e-3744-83af-82076694b263",
                        "glosses": [
                            "A self-propelled railway vehicle for passengers, similar to a bus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997f1ae3-5df9-49fc-8f07-ba625ebd9e40",
                                "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                                "text": "The semi-streamlined contour of the earlier G.W.R. railcars has been given up in favour of a more utilitarian blunt-nose end, and effective floor space gained thereby."
                            },
                            {
                                "example_id": "0103ee83-4ba9-4b9f-be00-2f1dbee65c82",
                                "sense_id": "b9999b3a-1a51-3973-8dcb-580b61b9735f",
                                "text": "Profitable operation is being made possible by the widespread introduction of capacious diesel railcars, which for their comfort and speed are very popular with the travelling public."
                            }
                        ]
                    },
                    {
                        "sense_id": "e358c973-6407-3ee3-9fb6-bc9590ea7559",
                        "entry_id": "eddf7acb-922e-3744-83af-82076694b263",
                        "glosses": [
                            "A powered single railway vehicle designed for passenger transport, with a driver's cab in both ends; Not to be confused with motor coach/motorcar, which is a powered railway vehicle capable to haul a train."
                        ],
                        "tags": [],
                        "examples": []
