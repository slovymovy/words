    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "96f289ad-4a7c-3b8d-93e2-2f2ff03d51d7",
                    "sense_definition": "Упакованная вещь, пересылаемая по почте или курьером",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "package_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы пошли на почту, чтобы получить <w>посылку</w> от бабушки.",
                            "target_lang_translations": {
                                "en": "We went to the post office to pick up a <w>parcel</w> from grandma.",
                                "pl": "Poszliśmy na pocztę, aby odebrać <w>paczkę</w> od babci."
                            }
                        },
                        {
                            "text": "В этой <w>посылке</w> лежат тёплые вещи и книги для детей.",
                            "target_lang_translations": {
                                "en": "There are warm clothes and books for children in this <w>package</w>.",
                                "pl": "W tej <w>paczce</w> znajdują się ciepłe ubrania i książki dla dzieci."
                            }
                        }
                    ],
                    "synonyms": [
                        "пакет",
                        "отправление"
                    ],
                    "common_phrases": [
                        "отправить посылку",
                        "получить посылку",
                        "тяжёлая посылка",
                        "посылка с подарками"
                    ],
                    "target_lang_definitions": {
                        "en": "A packed item sent by mail or courier",
                        "pl": "Zapakowany przedmiot przesyłany pocztą lub kurierem"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "parcel",
                                "target_lang_sense_clarification": "item sent by post"
                            },
                            {
                                "target_lang_word": "package",
                                "target_lang_sense_clarification": "wrapped box or item"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "paczka",
                                "target_lang_sense_clarification": "przesyłka pocztowa lub kurierska"
                            },
                            {
                                "target_lang_word": "przesyłka",
                                "target_lang_sense_clarification": "ogólnie rzecz nadana do przewozu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27ef4016-f7a2-3793-a739-d221e2fdd3c4",
                    "sense_definition": "Действие по отправке чего-либо куда-либо",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sending_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Срочная <w>посылка</w> документов была необходима для заключения контракта.",
                            "target_lang_translations": {
                                "en": "The urgent <w>sending</w> of documents was necessary to conclude the contract.",
                                "pl": "Pilna <w>wysyłka</w> dokumentów była konieczna do podpisania umowy."
                            }
                        },
                        {
                            "text": "Для <w>посылки</w> денег родители обычно использовали банковский перевод.",
                            "target_lang_translations": {
                                "en": "Parents usually used a bank transfer for <w>sending</w> money.",
                                "pl": "Do <w>przesyłania</w> pieniędzy rodzice zazwyczaj używali przelewu bankowego."
                            }
                        }
                    ],
                    "synonyms": [
                        "отправка",
                        "отправление",
                        "пересылка"
                    ],
                    "antonyms": [
                        "получение"
                    ],
                    "common_phrases": [
                        "посылка писем",
                        "посылка товаров",
                        "время посылки"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of sending something somewhere",
                        "pl": "Czynność polegająca na wysyłaniu czegoś gdzieś"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sending",
                                "target_lang_sense_clarification": "general action"
                            },
                            {
                                "target_lang_word": "dispatch",
                                "target_lang_sense_clarification": "formal or official sending"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wysyłka",
                                "target_lang_sense_clarification": "czynność nadawania rzeczy"
                            },
                            {
                                "target_lang_word": "wysłanie",
                                "target_lang_sense_clarification": "akt nadania lub ekspediowania"
                            },
                            {
                                "target_lang_word": "przesłanie",
                                "target_lang_sense_clarification": "akt przekazania dalej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e8afad0-71c1-3090-afad-89955fe19b1e",
                    "sense_definition": "Исходное суждение, на котором основывается умозаключение или вывод",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic_premise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Если первая <w>посылка</w> ложная, то и вывод будет неверным.",
                            "target_lang_translations": {
                                "en": "If the first <w>premise</w> is false, then the conclusion will also be incorrect.",
                                "pl": "Jeśli pierwsza <w>przesłanka</w> jest fałszywa, to i wniosek będzie błędny."
                            }
                        },
                        {
                            "text": "Его теория строится на ошибочной <w>посылке</w>, поэтому она неубедительна.",
                            "target_lang_translations": {
                                "en": "His theory is built on an erroneous <w>premise</w>, so it is unconvincing.",
                                "pl": "Jego teoria opiera się na błędnej <w>przesłance</w>, dlatego jest nieprzekonująca."
                            }
                        }
                    ],
                    "synonyms": [
                        "предпосылка",
                        "основание"
                    ],
                    "antonyms": [
                        "вывод",
                        "заключение"
                    ],
                    "common_phrases": [
                        "ложная посылка",
                        "логическая посылка",
                        "исходить из посылки"
                    ],
                    "target_lang_definitions": {
                        "en": "A statement or idea on which reasoning is based",
                        "pl": "Sąd wyjściowy, na którym opiera się wniosek lub rozumowanie w logice"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "premise",
                                "target_lang_sense_clarification": "logic term"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przesłanka",
                                "target_lang_sense_clarification": "termin logiczny; założenie wyjściowe"
                            }
                        ]
                    }
                }
