                                                "sense_id": "84840440-072b-308c-9980-b8f632b8e572",
                                                "text": "Die militärische Ausbildung war sehr hart."
                                            },
                                            {
                                                "example_id": "3e3f265f-a575-489f-88f1-08f419ceb1ae",
                                                "sense_id": "84840440-072b-308c-9980-b8f632b8e572",
                                                "text": "„Die Tetrarchen mussten immer ihre militärische Befähigung unter Beweis stellen, um sich in kritischen Situationen auf die Loyalität der Soldaten stützen zu können.“"
                                            },
                                            {
                                                "example_id": "857bf9af-6738-4a3a-b199-269eef2c32da",
                                                "sense_id": "84840440-072b-308c-9980-b8f632b8e572",
                                                "text": "„An der türkischen Ostfront erzielte Kemal unterdessen die ersten militärischen Erfolge.“"
                                            },
                                            {
                                                "example_id": "280ec90c-24df-4481-9cd9-4e83896698d4",
                                                "sense_id": "84840440-072b-308c-9980-b8f632b8e572",
                                                "text": "„Risikosport zählt seit alters zur militärischen Ausbildung.“"
                                            }
                                        ],
