                        ]
                    },
                    {
                        "sense_id": "c76222bf-e314-38f2-9498-76ff967a96ca",
                        "entry_id": "ec0d2e9c-a2b3-3258-95d3-634bbb328482",
                        "glosses": [
                            "Se dit d'un polariseur lorsqu’il est mis en fin de système optique."
