                "senses": [
                    {
                        "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                        "entry_id": "0252ca4d-af8a-3f4f-9d0a-53105451ed05",
                        "glosses": [
                            "Qui ne dure qu’un moment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14a9f53d-d6c4-4c00-8baa-7d5bc88a546e",
                                "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                                "text": "Mais les révolutions sont toujours des sacrifices que le temps fait à l'avenir, et qui nécessitent de la part des peuples par qui elles s'accomplissent un grand désintéressement momentané."
                            },
                            {
                                "example_id": "8f542a06-d03b-4121-9c1c-4bbe882b3f1b",
                                "sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                                "text": "Les néologismes sont en effet des constructions momentanées, la plupart du temps non reprises, et qui rapidement disparaissent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dafe67d0-bb63-4eb3-9fed-f52034b1d74d",
                        "source_entry_id": "0252ca4d-af8a-3f4f-9d0a-53105451ed05",
                        "source_sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                        "target_lang_word": "momentan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "momentan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                        "entry_id": "140815df-4b3e-3f1a-b2ca-43e8ea89fdc0",
                                        "glosses": [
                                            "in diesem Moment, jetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aba289f1-c008-444f-b15c-20766b4e1407",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "Momentan habe ich sehr wenig Zeit."
                                            },
                                            {
                                                "example_id": "c7af6a8a-f0a2-48b3-9808-43646bd7e31f",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "Eine Versetzung ist momentan leider nicht möglich."
                                            },
                                            {
                                                "example_id": "3c4465f4-cf6e-479d-beec-c7ac6f3e6f5d",
                                                "sense_id": "66ac41ef-4c5d-37eb-90e2-6b624f2d67ab",
                                                "text": "„Und das ist klug,betrachtet man die momentane Lage der Werbekonzerne: Sie haben große Probleme, denn ihr Geschäftsmodell wackelt bedenklich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5019d53c-380e-45b2-9bfe-ee9c43c86315",
                        "source_entry_id": "0252ca4d-af8a-3f4f-9d0a-53105451ed05",
                        "source_sense_id": "0dd7ed15-7132-32d5-b225-1900a5b18dff",
                        "target_lang_word": "derzeit",
