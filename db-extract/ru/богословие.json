                "senses": [
                    {
                        "sense_id": "3829efb9-195d-3ce6-9fba-803afed5b3bd",
                        "entry_id": "de570024-6fa8-332e-8018-576dd2e790e5",
                        "glosses": [
                            "религ. учение о Боге, систематическое изложение и истолкование принципов, догматов какой-либо религии"
                        ],
                        "tags": [],
