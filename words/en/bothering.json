                            },
                            {
                                "target_lang_word": "gênant",
                                "target_lang_sense_clarification": "qui cause un embarras ou une gêne"
                            },
                            {
                                "target_lang_word": "importun",
                                "target_lang_sense_clarification": "qui est déplacé ou indiscret"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba3792da-ad9c-3f42-baea-1af1c5de3f5e",
                    "sense_definition": "the act of troubling, disturbing, or pestering someone",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bother_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bothering</w> from the telemarketers finally forced her to change her phone number.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>беспокойство</w> со стороны телемаркетологов в конце концов заставило её сменить номер телефона.",
                                "pl": "Ciągłe <w>niepokojenie</w> przez telemarketerów w końcu zmusiło ją do zmiany numeru telefonu.",
                                "fr": "Le <w>dérangement</w> constant des télévendeurs l'a finalement forcée à changer de numéro de téléphone."
                            }
                        },
                        {
                            "text": "He could not stand the <w>bothering</w> of his younger siblings while he studied.",
                            "target_lang_translations": {
                                "ru": "Он не выносил <w>докучаний</w> своих младших братьев и сестер, пока учился.",
                                "pl": "Nie mógł znieść <w>dokuczania</w> ze strony młodszego rodzeństwa, kiedy się uczył.",
                                "fr": "Il ne pouvait pas supporter le <w>dérangement</w> causé par ses jeunes frères et sœurs pendant qu'il étudiait."
                            }
                        }
                    ],
                    "synonyms": [
                        "disturbance",
                        "harassment",
                        "annoyance"
                    ],
                    "antonyms": [
                        "assistance",
                        "peace"
                    ],
                    "common_phrases": [
                        "constant bothering",
                        "unnecessary bothering"
                    ],
                    "target_lang_definitions": {
                        "ru": "действие по созданию помех, беспокойства или назойливости",
                        "pl": "czynność polegająca na zakłócaniu spokoju, niepokojeniu lub byciu natrętnym",
                        "fr": "L'acte de troubler, de déranger ou d'importuner quelqu'un"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
