                ],
                "senses": [
                    {
                        "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                        "entry_id": "162d19bb-7553-3ae3-9c27-8cd24f825a98",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a134d46-d43c-463b-b21b-c4074301d807",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Ähnlich ging Francois nach Frankreich und Gardegeneral Winkler übernahm sein »41.« K. Solche Art, mit Einheiten und Kommandos herumzuwerfen, mögen die Halbgötter des Großen Generalstabs verantworten."
                            },
                            {
                                "example_id": "934829e9-ace9-4456-96f6-12c47f747c6b",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Frau Winkler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6d7a804f-78d6-418d-b2dc-b78831147fb0",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Herr Winkler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7c935909-078f-4e22-91b3-bb1d2e87a4ae",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Die Winklers fahren heute nach Halle."
                            },
                            {
                                "example_id": "e587bfac-ef9c-46e0-8c64-24b3bd90c0f7",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Der Winkler trägt nie die Schals, die die Winkler ihm strickt."
                            },
                            {
                                "example_id": "4735bd91-ab3e-40d3-8211-b770e64d4098",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Winkler kommt, geht der Herr Winkler.“"
                            },
                            {
                                "example_id": "bc29dda3-d6ca-4217-8ce8-05e102cd861f",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Winkler kommt und geht."
                            },
                            {
                                "example_id": "23a62889-a494-4710-8cba-68efa569c1ac",
                                "sense_id": "808c7d82-c927-325d-aa6c-520c2cb7ede2",
                                "text": "Winklers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
