                                                "text": "an unasked question"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "056add56-c558-3e6f-96bf-63de3725ec4e",
                                        "entry_id": "514405df-d254-3e3f-9cff-d982c2dccccb",
                                        "glosses": [
                                            "Not asked or invited to an event."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d396ffba-398d-4e41-92bf-ca35d126069b",
                                                "sense_id": "056add56-c558-3e6f-96bf-63de3725ec4e",
                                                "text": "an unasked guest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab8d6ab-97ed-35df-9edd-6e126c2c10df",
                                        "entry_id": "514405df-d254-3e3f-9cff-d982c2dccccb",
                                        "glosses": [
                                            "Not asked for; unrequested."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8539abf4-69c6-4ab4-8ac2-2134235fb97e",
                                                "sense_id": "1ab8d6ab-97ed-35df-9edd-6e126c2c10df",
                                                "text": "Love comes out of heaven unasked and unsought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11ae06a8-3b0b-45ac-95f5-0c43a2dcbaee",
                        "source_entry_id": "55634bc4-39de-3247-8260-e8bc54ac1def",
                        "source_sense_id": "aafb274c-ff62-382a-abbb-3ecb5dd13079",
                        "target_lang_word": "unsolicited",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsolicited",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c0d5043-8e1c-31ac-831c-7db3d09442e8",
                                        "entry_id": "c8af790c-403d-3538-a4df-c1a4dada0423",
                                        "glosses": [
                                            "Not requested; neither welcomed nor invited."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1573b7-209e-420a-b825-1c3bde1121b7",
                                                "sense_id": "4c0d5043-8e1c-31ac-831c-7db3d09442e8",
                                                "text": "People have become very frustrated with unsolicited sales calls."
                                            },
                                            {
                                                "example_id": "0bba941f-2d0a-466c-b695-19919a8fa56e",
                                                "sense_id": "4c0d5043-8e1c-31ac-831c-7db3d09442e8",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2a05f4e-ed35-45ed-9257-d9369b565f85",
                        "source_entry_id": "55634bc4-39de-3247-8260-e8bc54ac1def",
                        "source_sense_id": "aafb274c-ff62-382a-abbb-3ecb5dd13079",
                        "target_lang_word": "unbidden",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbidden",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e1c5848-a3d3-39ea-a2f7-5f193bb23d89",
                                        "entry_id": "3d79224b-89fd-3ed0-805a-e5b20e25d5fe",
                                        "glosses": [
                                            "not invited, requested or asked for"
                                        ],
                                        "tags": [
