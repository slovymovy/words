                    "sense_id": "4ed7ec49-2dba-369e-8d29-bb6a7f565f7e",
                    "sense_definition": "Официальный руководитель предприятия, организации, учреждения или учебного заведения.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "management_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Генеральный <w>директор</w> подписал приказ о назначении новых сотрудников.",
                            "target_lang_translations": {
                                "en": "The General <w>Director</w> signed the order regarding the appointment of new employees.",
                                "zh": "总经理<w>签署</w>了任命新员工的命令。"
                            }
                        },
                        {
                            "text": "Родителей ученика срочно вызвали к <w>директору</w> школы для важного разговора.",
                            "target_lang_translations": {
                                "en": "The student's parents were urgently summoned to the school <w>principal</w> for an important conversation.",
                                "zh": "学生家长被紧急叫到学校去见<w>校长</w>，进行一次重要谈话。"
                            }
                        },
                        {
                            "text": "На совещании <w>директор</w> завода представил план развития на следующий год.",
                            "target_lang_translations": {
                                "en": "At the meeting, the factory <w>director</w> presented the development plan for the next year.",
                                "zh": "在会议上，工厂<w>经理</w>提出了下一年的发展计划。"
                            }
                        }
                    ],
