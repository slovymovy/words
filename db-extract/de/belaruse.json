                ],
                "senses": [
                    {
                        "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                        "entry_id": "49206369-fd50-3d37-af6c-5ae1de58c99b",
                        "glosses": [
                            "Staatsbürger von Belarus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fcb96ce-feec-406e-af68-3a3f6ad8e642",
                                "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                                "text": "Er ist Belaruse und wohnt in Brest."
                            },
                            {
                                "example_id": "ad927caf-d6e0-486f-82d4-205855f42f2c",
                                "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                                "text": "Ihr Vater ist Belaruse, ihre Mutter Französin."
                            },
                            {
                                "example_id": "2308b963-efd6-466d-baf7-c0f85d58ef66",
                                "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                                "text": "„Die Gesellschaft war überwiegend agrarisch geprägt, und in den Städten fanden die Belarusen sich in Konkurrenz zu den nationalen Bemühungen der Litauer, Polen und Ukrainer.“"
                            },
                            {
                                "example_id": "f23be86d-e852-4042-bd90-55119d9fbc28",
                                "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                                "text": "„Wer ‚Belarus‘ sagt, müsste logischerweise als Adjektiv dann ‚belarusisch‘ verwenden und die Einwohner des Landes ‚Belarusen‘ nennen.“"
                            },
                            {
                                "example_id": "37cfe79c-d818-4f4c-85fd-6b7d9b09a856",
                                "sense_id": "a509ddc3-9632-3b53-a1d2-3954b760e8d0",
                                "text": "„Millionen Belarusen kämpften jeden Tag, um ihre Zukunft zu gestalten und frei zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
