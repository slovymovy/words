                                        "glosses": [
                                            "Mappe, in die Blätter eingeheftet oder eingeklemmt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55358a25-0735-4799-a196-536242043a15",
                                                "sense_id": "0360635b-357b-360a-afec-7a36de6273b5",
                                                "text": "Ordnet das bitte in euren Hefter ein."
                                            },
                                            {
                                                "example_id": "43ccf139-ef35-4aa6-b337-1b4d6b6ccf87",
                                                "sense_id": "0360635b-357b-360a-afec-7a36de6273b5",
                                                "text": "„Bevor Jürgen Loose seinen Hefter hervorholt, isst er zwei Stücke Kuchen mit gutem Appetit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7ac889f-5939-34d8-bc78-d23facc53c51",
                                        "entry_id": "d54ac61a-1128-3ef5-b993-b895af0b0125",
                                        "glosses": [
                                            "kleineres Gerät, mit dem mehrere Dinge durch Eindrücken einer Klammer aneinander geheftet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ebd6ac-1736-4c8e-bb73-4f02533bb5d3",
                                                "sense_id": "f7ac889f-5939-34d8-bc78-d23facc53c51",
                                                "text": "Mir gehen die Klammern für meinen Hefter aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32c8a245-d29f-4323-91f9-524c5b16ee5e",
                        "source_entry_id": "6cfaaef3-077b-367f-9364-a9dd3c32655b",
                        "source_sense_id": "28d155a9-e38d-36ab-9edc-f15e62511457",
                        "target_lang_word": "сшиватель",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сшиватель",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f101710-9e09-379c-b2b9-789ebc999f37",
                                        "entry_id": "ea6edac9-11c9-35f6-9078-bae907aafda7",
                                        "glosses": [
                                            "устройство для сшивания чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00f9ced7-4b0d-4007-b8f5-2e9e1c57b10a",
                                                "sense_id": "6f101710-9e09-379c-b2b9-789ebc999f37",
                                                "text": "Последнее мнение вероятнее, ибо и святитель Иоанн Златоуст, который, конечно, хорошо знал смысл слова скинотворец, употреблял вместо него выражение сшиватель палаток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46e45cf0-50ba-3c8b-a5bb-ee1cd58668c1",
                                        "entry_id": "ea6edac9-11c9-35f6-9078-bae907aafda7",
                                        "glosses": [
                                            "то же, что скоросшиватель; папка с приспособлением для подшивки и скрепления бумаг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eaf8ebc-374d-4b08-8ddb-ffa935ebc5d1",
                                                "sense_id": "46e45cf0-50ba-3c8b-a5bb-ee1cd58668c1",
                                                "text": "В ней ― тоже белой и тоже ярко и мягко освещённой ― большой стол. На нём компьютер, бумаги, сшиватели, папки. И служащий возле стола."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06e5631a-8ba8-32f6-9e13-6e86a82c1be4",
                                        "entry_id": "ea6edac9-11c9-35f6-9078-bae907aafda7",
                                        "glosses": [
                                            "то же, что степлер; устройство для оперативного скрепления листов металлическими скрепками (скобами)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b00a53e-b67d-480a-824a-a38f712cb16f",
                                                "sense_id": "06e5631a-8ba8-32f6-9e13-6e86a82c1be4",
                                                "text": "Он поставил несколько печатей, потом взял сшиватель и скрепил два листа вместе, затем положил их в прозрачную папку."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
