                        ],
                        "examples": [
                            {
                                "example_id": "10833a5f-333e-47ee-bee4-337419b76ae9",
                                "sense_id": "bd84298f-9443-3541-88a9-6c33a8074f7c",
                                "text": "But with outrageous strokes did him restraine,\nAnd with his body bard the way atwixt them twaine."
                            },
                            {
                                "example_id": "0dd576af-a94e-48b2-bd61-5b210f79bd0e",
                                "sense_id": "bd84298f-9443-3541-88a9-6c33a8074f7c",
                                "text": "Whate’er ye are, be sure an’ fix’t;\nOpinions ne’er haltin’ atwixt;"
                            },
                            {
                                "example_id": "d3c6a76e-988e-4f9b-a351-2d4aff4b721b",
                                "sense_id": "bd84298f-9443-3541-88a9-6c33a8074f7c",
                                "text": "[…] the boat’s drove tight by the tide ’atwixt two tiers of barges."
                            },
                            {
                                "example_id": "e7d3df8b-01d5-4882-84c2-90b9297d3c87",
                                "sense_id": "bd84298f-9443-3541-88a9-6c33a8074f7c",
                                "text": "“I kin take him from right here ’atwixt his eyes,” said Jenks softly, and tapped his rifle significantly."
                            }
                        ]
                    }
                ],
