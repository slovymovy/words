                ],
                "senses": [
                    {
                        "sense_id": "6c72199e-e29e-3e2a-a1a7-ee498cd44e51",
                        "entry_id": "acaa914a-5013-3c6a-b42b-19a92b598fa0",
                        "glosses": [
                            "заниматься добычей кого-либо, чего-либо (обычно зверя, птицы, рыбы)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0325178b-fff4-48f1-af53-3bf58ef824c6",
                                "sense_id": "6c72199e-e29e-3e2a-a1a7-ee498cd44e51",
                                "text": "Зимой ненцы промышляли оленей на юго-восточном берегу Новой Земли."
                            }
                        ]
                    },
                    {
                        "sense_id": "77cfa96f-5f4b-320e-9074-7304b3e739e5",
                        "entry_id": "acaa914a-5013-3c6a-b42b-19a92b598fa0",
                        "glosses": [
                            "доставать, добывать, получать что-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7d8cb216-a865-33b9-83d9-a8958b0ab518",
                        "entry_id": "acaa914a-5013-3c6a-b42b-19a92b598fa0",
                        "glosses": [
                            "добывать себе средства к существованию (занимаясь мелким ремесленным производством, торговлей и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474f6f13-6903-42ad-a455-5c80efab8987",
                                "sense_id": "7d8cb216-a865-33b9-83d9-a8958b0ab518",
                                "text": "До того он ― этот Турчанинов ― солью промышлял да торговал на строгановских землях, и медным делом тоже маленько занимался."
                            }
                        ]
                    },
                    {
                        "sense_id": "2adf831a-eec2-32b4-a5d2-6ea10e4eb0fb",
                        "entry_id": "acaa914a-5013-3c6a-b42b-19a92b598fa0",
                        "glosses": [
                            "заниматься чем-либо предосудительным (воровством, мошенничеством и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67fd0ab7-c52f-4fd9-ae0a-f2b6f26245f6",
                                "sense_id": "2adf831a-eec2-32b4-a5d2-6ea10e4eb0fb",
                                "text": "Я рядовой россиянин, чуть-чуть промышляю незаконными операциями, никому вреда не делаю."
                            }
                        ]
                    },
                    {
                        "sense_id": "b8ec38af-7b53-3420-bba1-04abe371af77",
                        "entry_id": "acaa914a-5013-3c6a-b42b-19a92b598fa0",
                        "glosses": [
                            "устар. заботиться, думать о ком-либо, чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a9e1063-02a8-4842-ba31-34f10af3b0eb",
                                "sense_id": "b8ec38af-7b53-3420-bba1-04abe371af77",
                                "text": "А так как нам жалованье королевское, обещанное на прежних комиссиях, не доходило, то мы должны были сами о себе промышлять"
                            }
                        ]
                    }
                ],
