                "senses": [
                    {
                        "sense_id": "f08e3d5b-2293-3f92-b768-d10e57139847",
                        "entry_id": "a2ace522-4120-336b-9de1-7f0d27329ad1",
                        "glosses": [
                            "jemand, der ein Fahrzeug der Marke Porsche fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "509f6e7c-04a0-4f2e-9336-33ff916b275d",
                                "sense_id": "f08e3d5b-2293-3f92-b768-d10e57139847",
                                "text": "„Weil ein Porschefahrer an einer roten Ampel eingeschlafen war, verständigten Verkehrsteilnehmer am frühen Samstagmorgen, gegen 3.30 Uhr, die Polizei.“"
                            },
                            {
                                "example_id": "f9af8b35-d89f-43f5-a766-f485dec11d00",
                                "sense_id": "f08e3d5b-2293-3f92-b768-d10e57139847",
                                "text": "„Aber andererseits sitzt man dann vielleicht doch im falschen Auto, und die Idee, den Porschefahrer nebenan zu demütigen, mag reizvoll sein, ist aber reichlich unerwachsen, vor allem für einen Audi-Fahrer.“"
                            },
                            {
                                "example_id": "ecb3bc31-3fcf-40c4-9d96-18b83e1c3130",
                                "sense_id": "f08e3d5b-2293-3f92-b768-d10e57139847",
                                "text": "„In einem meiner liebsten Froschwitze kommt wieder ein Autofahrer vor, ein Porschefahrer.“"
                            },
                            {
                                "example_id": "62892181-eeb9-44ca-a7a0-4fcc000663b1",
                                "sense_id": "f08e3d5b-2293-3f92-b768-d10e57139847",
                                "text": "„Ein Porschefahrer ist so freundlich, ihn abzuschleppen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
