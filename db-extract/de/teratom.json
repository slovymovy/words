                                "sense_id": "86654a50-c4b8-321f-8c85-344b71d9794e",
                                "text": "Vor fünf Jahren wurde sie in einer ersten Publikation bei zwölf Patientinnen im Alter zwischen 14 und 44 Jahren beschrieben, alle hatten ein Teratom."
                            }
                        ],
                        "sense_index_json": "\"1\""
