                        "sense_id": "71545b42-c938-3501-a3e8-e386e3372ca3",
                        "entry_id": "37cac6a6-5ff1-3055-b51f-604c6a5b9012",
                        "glosses": [
                            "natürliche Veranlagung, Sachverhalte schnell zu begreifen, zu beurteilen und/oder auf solche schlagfertig zu reagieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6243948a-7663-44b4-b04d-ee8075ebc83f",
                                "sense_id": "71545b42-c938-3501-a3e8-e386e3372ca3",
                                "text": "Er war berühmt für seinen Mutterwitz."
                            },
                            {
                                "example_id": "732a1315-2123-4203-bd8a-f791a5c59208",
                                "sense_id": "71545b42-c938-3501-a3e8-e386e3372ca3",
                                "text": "„Er überlegte sich, wie er sich auf Photos machen würde, ob er das Zeug zu einer populären Figur hatte, ob er reden konnte, Mutterwitz besaß.“"
                            },
                            {
                                "example_id": "cd94e08c-7b80-4070-a17d-e2b1ae942243",
                                "sense_id": "71545b42-c938-3501-a3e8-e386e3372ca3",
                                "text": "„Er verkörperte den Berliner Mutterwitz und wurde in allen Zeitungen und Zeitschriften als ärmlich gekleideter Bursche mit einem Paar langschäftiger Stiefel über der Schulter abgebildet.“"
                            }
                        ],
