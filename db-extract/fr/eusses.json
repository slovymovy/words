        "fr-extract.jsonl": [
            {
                "entry_id": "afe11f82-c4cb-3cb5-b087-638dd9857190",
                "word": "eusses",
                "pos": "pron",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cb84aee0-03b8-36eb-ae40-98bbfaf70ec5",
                        "entry_id": "afe11f82-c4cb-3cb5-b087-638dd9857190",
                        "glosses": [
                            "Variante de eux."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1cd09e-f9ab-47d8-8aca-1432f2e79003",
                                "sense_id": "cb84aee0-03b8-36eb-ae40-98bbfaf70ec5",
                                "text": "— Non, elle n’ira plus à vot’école ma fille… c’est pas la peine, pour apprendre qu’il faut rester dans la débine comme père et mère et se tenir bien tranquille, en crevant de faim tout comme eusses et surtout pas oublier de dire merci…"
                            },
                            {
                                "example_id": "ba3049e4-797c-4204-9314-5c3fc230840b",
                                "sense_id": "cb84aee0-03b8-36eb-ae40-98bbfaf70ec5",
                                "text": "Les drôles, eusses, ils courraient, les deux garçons, et même Sylvie qui doit déjà trotter toute seule…"
                            },
                            {
                                "example_id": "e68f64c6-7988-4d6a-b08d-a90e3b46b833",
                                "sense_id": "cb84aee0-03b8-36eb-ae40-98bbfaf70ec5",
                                "text": "— Pourquoi eusses et pas nous ?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "22e96d5d-d4f5-33f2-9675-61ebb4be89c7",
                "word": "eusses",
