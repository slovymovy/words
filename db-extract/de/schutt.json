                "senses": [
                    {
                        "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                        "entry_id": "5b5476ec-9d26-310f-aa23-82d0814b8c44",
                        "glosses": [
                            "Menge von hauptsächlich festen, aus irgendeinem größerem Objekt herausgelösten, Objekten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d4f2b07-7153-47f8-a9fb-07f4f7c685e8",
                                "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                                "text": "Nach der Explosion blieb von dem Gebäude nur ein Haufen Schutt übrig."
                            },
                            {
                                "example_id": "4c8e78f6-39f6-400b-83ee-8393f96f0a83",
                                "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                                "text": "„Die junge Erde wurde häufig von Schutt aus dem All getroffen.“"
                            },
                            {
                                "example_id": "94e57dd7-4a76-42d4-85d9-905efb2a1bf6",
                                "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                                "text": "„Ludwig war der erste, der von der Fuhlsbütteler Straße über den Wall von Geröll und Schutt in die Düsternstraße fand.“"
                            },
                            {
                                "example_id": "d326aeac-bb53-4acc-b10f-862750af7539",
                                "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                                "text": "„Als der Krieg vorbei war, blieben Trümmer und Schutt.“"
                            },
                            {
                                "example_id": "ce32809b-03cb-43f8-b1cb-865f0ebcffcb",
                                "sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                                "text": "„Und dort blieb der Mercedes stehen, weil die Fahrbahn zertrümmert und voller Schutt und Geröll war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2204593-fda2-4db6-8462-4f376d02427f",
                        "source_entry_id": "5b5476ec-9d26-310f-aa23-82d0814b8c44",
                        "source_sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                        "source_sense_description": "Menge von hauptsächlich festen, aus irgendeinem größerem Objekt herausgelösten, Objekten",
                        "target_lang_word": "rubble",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The broken remains of an object, usually rock or masonry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8fac65a-71ab-4493-920d-e1809b8bd185",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The main East Coast line from Edinburgh to Berwick was blocked at Cockburnspath and Grantshouse by flood water, which washed away part of an embankment, and by the collapse of about 300 tons of rubble on to the track."
                                            },
                                            {
                                                "example_id": "4c06c861-e286-49e7-8d70-d44c8fabe967",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "The old boulevard now was a sagging ruin, waiting for the wreckers. … You'd have to loathe yourself vividly to be indifferent to such destruction or, worse, rejoice at the crushing of the locus of these middle-class settlements, glad that history had made rubble of them."
                                            },
                                            {
                                                "example_id": "cda0aea3-0c8e-4382-9e8b-6cc71cbe7883",
                                                "sense_id": "bd71af53-b398-3630-9faf-a49613b8cad1",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "A mass or stratum of fragments of rock lying under the alluvium and derived from the neighbouring rock."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ba0d85-a578-439f-b97f-e4baed25a644",
                                                "sense_id": "55ee50b7-6235-3c4a-9077-3646c34eb1ec",
                                                "text": "The overlying beds are composed of such calcareous rubble and flints, rudely stratified"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9de155-140c-34bb-bf85-a98a64033ebd",
                                        "entry_id": "3ff6a9da-e156-3ef4-bb86-9e9f74737a82",
                                        "glosses": [
                                            "The whole of the bran of wheat before it is sorted into pollard, bran, etc."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "dialectal",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rubble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "69bc4804-2cb4-3955-ad6d-8dbd6e670e53",
                                        "entry_id": "f5ef4954-bc1c-38fb-8501-636117ce81d6",
                                        "glosses": [
                                            "To break down into rubble."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e28c557b-78e1-4eea-bb8f-e0c3513673a6",
                        "source_entry_id": "5b5476ec-9d26-310f-aa23-82d0814b8c44",
                        "source_sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                        "source_sense_description": "Menge von hauptsächlich festen, aus irgendeinem größerem Objekt herausgelösten, Objekten",
                        "target_lang_word": "debris",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "debris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "Rubble, wreckage, scattered remains of something destroyed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa199f89-94b5-4f90-a392-09958347b679",
                                                "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                                "text": "His neighbors were still ripping out debris. But Mr. Ryan, a retired bricklayer who built his house by hand 30 years ago only to lose most of it to Hurricane Sandy, was already hard at work rebuilding."
                                            },
                                            {
                                                "example_id": "3bb9cf6c-9097-4820-92c3-ffd791e7f70d",
                                                "sense_id": "1620398d-8770-34c5-b5f2-85853d5d3ee9",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379706f9-6687-3aae-9a5e-9548a9562a3b",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "Litter and discarded refuse."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61e5ce1-7f70-4442-b4b1-e4d25d3a804a",
                                                "sense_id": "379706f9-6687-3aae-9a5e-9548a9562a3b",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ea9c012-159b-3a48-b44b-069d5affc95c",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "The ruins of a broken-down structure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "159de434-b733-32c6-953f-aaf17db4ab4c",
                                        "entry_id": "ec1ab707-728f-319b-bb40-fa4cf13ae0a2",
                                        "glosses": [
                                            "Large rock fragments left by a melting glacier etc."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "459b66bf-6005-4df9-9668-d8e383d33a53",
                        "source_entry_id": "5b5476ec-9d26-310f-aa23-82d0814b8c44",
                        "source_sense_id": "3fa8c388-7a87-31cc-ab70-838c345f266c",
                        "source_sense_description": "Menge von hauptsächlich festen, aus irgendeinem größerem Objekt herausgelösten, Objekten",
                        "target_lang_word": "gravats",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravats",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "02b70c0d-38bc-3b79-80d8-e34af57a21ad",
                                        "entry_id": "0c6c7f05-cd0f-30f4-9800-3211b1b1fbb5",
                                        "glosses": [
                                            "La partie la plus grossière qui reste du plâtre après qu’on l’a cassé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d2a99f6-dd04-4145-8e6c-cca1bfc9a53e",
                                                "sense_id": "02b70c0d-38bc-3b79-80d8-e34af57a21ad",
                                                "text": "Battre les gravats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f93833f-59fb-3d4e-8ce9-326c5bff143c",
                                        "entry_id": "0c6c7f05-cd0f-30f4-9800-3211b1b1fbb5",
                                        "glosses": [
                                            "Débris d’un bâtiment qu’on a démoli, ou déchets de matériaux d’une construction que l’on vient d’achever."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17f8740c-83db-4e18-93cd-da3e85344f32",
                                                "sense_id": "9f93833f-59fb-3d4e-8ce9-326c5bff143c",
                                                "text": "La plupart du temps, après leur abandon, les maisons ont été démontées jusqu’aux fondations pour récupérer la pierre, et il ne reste bien souvent que les tranchées remplies de gravats, ainsi que des lambeaux de sol et les caves, pour reconstituer le plan des édifices."
                                            },
                                            {
                                                "example_id": "670ae285-9c96-41e1-ac6b-eb9a18b95979",
                                                "sense_id": "9f93833f-59fb-3d4e-8ce9-326c5bff143c",
                                                "text": "Certaines ornières avaient été rempierrées avec des gravats de brique et de plâtre et, plutôt que rendre service, elles se révélaient comme des zones traîtresses pour les pneus usés de la Benelli."
                                            },
                                            {
                                                "example_id": "e669d2fa-8c87-486c-b0f9-d76b66177e2b",
                                                "sense_id": "9f93833f-59fb-3d4e-8ce9-326c5bff143c",
                                                "text": "Et pourtant les figuiers s’obstinent à pousser spontanément parmi les gravats et je me gorge, sans rien payer, de leurs fruits cramoisis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0da0e96-bb48-4aab-81e8-df773c08375f",
