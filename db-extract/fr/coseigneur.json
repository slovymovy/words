                        "examples": [
                            {
                                "example_id": "73c89db4-0222-474c-9377-a1a8e5646512",
                                "sense_id": "688eed73-f547-36f7-90aa-fb475113bc4d",
                                "text": "Toutes ces insultes, au dire du chevalier Jean de Blonay, avaient été faites par le coseigneur Antoine ou à son instigation."
                            },
                            {
                                "example_id": "d98274d4-da13-4178-bb44-807e3585f65a",
                                "sense_id": "688eed73-f547-36f7-90aa-fb475113bc4d",
                                "text": "Les habitants d’Orbey, en tout cas, s’étaient de bonne heure assuré la jouissance exclusive des cinq pelouses. Ils les tenaient en amodiation des deux coseigneurs du ban de Fraize, à la limite duquel elles s’étendaient."
                            }
                        ]
