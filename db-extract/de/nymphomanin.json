                                    {
                                        "sense_id": "04115c3e-f29a-30fe-88e9-53caf625b188",
                                        "entry_id": "2cbc9878-325a-35ae-8f58-4459df6c42bf",
                                        "glosses": [
                                            "A woman with an excessive libido."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779cbeec-15e4-4312-9833-dd61f374a4e1",
                                                "sense_id": "04115c3e-f29a-30fe-88e9-53caf625b188",
                                                "text": "Xenia's such a nymphomaniac that she's not even satisfied with three lovers."
                                            }
