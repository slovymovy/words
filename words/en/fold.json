{
    "word_family": [
        "enfold",
        "folder",
        "folding",
        "manifold",
        "twofold",
        "unfold"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c5f1e6c-bfdc-35c4-8efb-ca563fcb3b44",
                    "sense_definition": "To bend any thin material, such as paper or cloth, over so that it comes in contact with itself.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>fold</w> the laundry neatly before putting it away in the dresser.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, аккуратно <w>сложи</w> белье, прежде чем убрать его в комод."
                            }
                        },
                        {
                            "text": "You should <w>fold</w> the paper in half to make a card for your mother.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>сложить</w> бумагу пополам, чтобы сделать открытку для мамы."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "crease"
                    ],
                    "antonyms": [
                        "unfold"
                    ],
                    "common_phrases": [
                        "fold in half",
                        "fold the laundry",
                        "fold the paper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сгибать тонкий материал, такой как бумага или ткань, так, чтобы его части соприкасались."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складывать",
                                "target_lang_sense_clarification": "бумагу, одежду"
                            },
                            {
                                "target_lang_word": "сгибать",
                                "target_lang_sense_clarification": "материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e803f8e-b994-3d05-bcc6-4ccd332c8507",
                    "sense_definition": "To double or lay together parts of the body, such as arms or hands, so they overlap.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to <w>fold</w> his arms and wait patiently for the meeting to start.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>скрестить</w> руки на груди и терпеливо ждать начала собрания."
                            }
                        },
                        {
                            "text": "The child would <w>fold</w> his hands during the quiet moment at school.",
                            "target_lang_translations": {
                                "ru": "Ребенок <w>складывал</w> руки во время минуты тишины в школе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fold your arms",
                        "fold your hands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрещивать или соединять части тела, например руки, так, чтобы они перекрывали друг друга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скрещивать",
                                "target_lang_sense_clarification": "руки на груди"
                            },
                            {
                                "target_lang_word": "складывать",
                                "target_lang_sense_clarification": "руки вместе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d985626-5c0b-3e78-9e3b-23fb27776481",
                    "sense_definition": "To stir semisolid ingredients gently into a mixture by turning one part over another.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Carefully <w>fold</w> the egg whites into the batter to keep the cake light.",
                            "target_lang_translations": {
                                "ru": "Осторожно <w>вмешайте</w> яичные белки в тесто, чтобы пирог остался воздушным."
                            }
                        },
                        {
                            "text": "You need to <w>fold</w> in the chocolate chips at the very end of the recipe.",
                            "target_lang_translations": {
                                "ru": "В самом конце по рецепту нужно <w>добавить</w> шоколадную крошку, аккуратно перемешивая."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fold in the ingredients",
                        "fold gently"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осторожно подмешивать густые ингредиенты в смесь, аккуратно переворачивая одну часть массы над другой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аккуратно вводить",
                                "target_lang_sense_clarification": "ингредиенты в тесто"
                            },
                            {
                                "target_lang_word": "вмешивать",
                                "target_lang_sense_clarification": "осторожными движениями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b90cad35-1e16-38e7-b804-dc5f80afe5db",
                    "sense_definition": "To withdraw from betting in a game of poker or other card games.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He knew his cards were weak, so he decided to <w>fold</w> early in the round.",
                            "target_lang_translations": {
                                "ru": "Он знал, что его карты слабые, поэтому решил <w>пасовать</w> в начале раунда."
                            }
                        },
                        {
                            "text": "If you don't have a good hand, it is often better to <w>fold</w> than to lose more money.",
                            "target_lang_translations": {
                                "ru": "Если у вас плохие карты, часто лучше <w>сбросить</w> их, чем потерять еще больше денег."
                            }
                        }
                    ],
                    "common_phrases": [
                        "decide to fold",
                        "fold a hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекратить участие в торгах в покере или других карточных играх, сбросив карты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пасовать",
                                "target_lang_sense_clarification": "в карточных играх"
                            },
                            {
                                "target_lang_word": "сбрасывать карты",
                                "target_lang_sense_clarification": "выходить из игры"
                            },
                            {
                                "target_lang_word": "фолдить",
                                "target_lang_sense_clarification": "сленг в покере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2c8df64-a710-38f8-bd7d-b65f0b3eae88",
                    "sense_definition": "Of a company or organization, to cease to trade or close down due to failure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small business was forced to <w>fold</w> after the new mall opened nearby.",
                            "target_lang_translations": {
                                "ru": "Малый бизнес был вынужден <w>закрыться</w> после открытия нового торгового центра неподалеку."
                            }
                        },
                        {
                            "text": "Many startups <w>fold</w> within their first year of operation due to lack of funding.",
                            "target_lang_translations": {
                                "ru": "Многие стартапы <w>прогорают</w> в первый же год работы из-за нехватки финансирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "cave in#Verb",
                        "crumple#Verb"
                    ],
                    "common_phrases": [
                        "forced to fold",
                        "business fold"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О компании или организации: прекратить торговлю или закрыться из-за неудачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прогореть",
                                "target_lang_sense_clarification": "о бизнесе"
                            },
                            {
                                "target_lang_word": "закрыться",
                                "target_lang_sense_clarification": "прекратить деятельность"
                            },
                            {
                                "target_lang_word": "ликвидироваться",
                                "target_lang_sense_clarification": "о предприятии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "10793e71-3146-3059-92e7-43c8430bdeb0",
                    "sense_definition": "To give way or surrender on a point, in an argument, or under pressure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "failure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness began to <w>fold</w> under the intense questioning from the lawyer.",
                            "target_lang_translations": {
                                "ru": "Свидетель начал <w>сдаваться</w> под интенсивным допросом адвоката."
                            }
                        },
                        {
                            "text": "He didn't want to concede the point, but eventually he had to <w>fold</w>.",
                            "target_lang_translations": {
                                "ru": "Он не хотел признавать правоту, но в конце концов ему пришлось <w>уступить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "concede",
                        "give in",
                        "give way",
                        "yield"
                    ],
                    "common_phrases": [
                        "fold under pressure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сдаться или отступить в споре или под давлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдаваться",
                                "target_lang_sense_clarification": "под давлением"
                            },
                            {
                                "target_lang_word": "пасовать",
                                "target_lang_sense_clarification": "перед трудностями"
                            },
                            {
                                "target_lang_word": "уступать",
                                "target_lang_sense_clarification": "в споре"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6694c0e-0f82-3074-b5e0-dd751cc36f04",
                    "sense_definition": "A bend or crease in something flexible, such as cloth or paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "crease",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a sharp <w>fold</w> in the map where it had been tucked into his pocket.",
                            "target_lang_translations": {
                                "ru": "На карте остался резкий <w>сгиб</w> там, где она была засунута в карман."
                            }
                        },
                        {
                            "text": "She smoothed out every <w>fold</w> in the tablecloth before the guests arrived.",
                            "target_lang_translations": {
                                "ru": "Она разгладила каждую <w>складку</w> на скатерти перед приходом гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "bend",
                        "crease",
                        "ply"
                    ],
                    "common_phrases": [
                        "sharp fold",
                        "smooth the fold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изгиб или линия сгиба на чем-то гибком, например на ткани или бумаге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "складка",
                                "target_lang_sense_clarification": "на ткани или коже"
                            },
                            {
                                "target_lang_word": "сгиб",
                                "target_lang_sense_clarification": "на бумаге"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05e69881-6ef8-3ac8-89df-7f8119311a36",
                    "sense_definition": "A group of people with shared ideas, goals, or a common community.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of traveling abroad, he was happy to return to the <w>fold</w> of his family.",
                            "target_lang_translations": {
                                "ru": "После многих лет путешествий за границей он был счастлив вернуться в <w>круг</w> своей семьи."
                            }
                        },
                        {
                            "text": "The party leader welcomed the former members back into the <w>fold</w> before the election.",
                            "target_lang_translations": {
                                "ru": "Лидер партии приветствовал возвращение бывших членов в свои <w>ряды</w> перед выборами."
                            }
                        }
                    ],
                    "synonyms": [
                        "community",
                        "cohort"
                    ],
                    "common_phrases": [
                        "back into the fold",
                        "return to the fold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей с общими идеями, целями или общее сообщество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круг",
                                "target_lang_sense_clarification": "семьи или единомышленников"
                            },
                            {
                                "target_lang_word": "лоно",
                                "target_lang_sense_clarification": "церкви или организации"
                            },
                            {
                                "target_lang_word": "паства",
                                "target_lang_sense_clarification": "религиозная община"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f9d14b-983b-3f64-8853-2852b0716fc6",
                    "sense_definition": "An enclosure or pen for sheep or other domestic animals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enclosure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shepherd led the sheep into the <w>fold</w> as the sun began to set.",
                            "target_lang_translations": {
                                "ru": "Пастух завел овец в <w>загон</w>, когда солнце начало садиться."
                            }
                        },
                        {
                            "text": "A wolf was seen prowling near the <w>fold</w> during the cold winter night.",
                            "target_lang_translations": {
                                "ru": "Холодной зимней ночью возле <w>кошары</w> видели рыщущего волка."
                            }
                        }
                    ],
                    "synonyms": [
                        "enclosure",
                        "pen",
                        "penfold",
                        "pinfold"
                    ],
                    "common_phrases": [
                        "sheep fold"
                    ],
                    "target_lang_definitions": {
                        "ru": "Загон или огороженное место для овец или других домашних животных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загон",
                                "target_lang_sense_clarification": "для скота"
                            },
                            {
                                "target_lang_word": "кошара",
                                "target_lang_sense_clarification": "для овец"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}