            {
                "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                "word": "gisant",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "720776aa-c59d-48d4-865e-3a02334addea",
                        "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "gisants"
                    },
                    {
                        "form_id": "28c3ca27-ead3-4c83-9215-b89fbf589214",
                        "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "gisante"
                    },
                    {
                        "form_id": "6f4f83ab-1bb3-45cc-af0e-2c0dae6c7891",
                        "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "gisantes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b464aa3-7cf0-36af-b3e8-6df93368cfba",
                        "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                        "glosses": [
                            "Qui est couché, étendu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e79e88f-e112-4028-aa9d-2fb4faabdf8f",
                                "sense_id": "2b464aa3-7cf0-36af-b3e8-6df93368cfba",
                                "text": "On voyait que la victime avait été frappée au moment où, à genoux devant le tonneau, elle commençait à remplir une bouteille, qui lui avait échappé des mains et qui était gisante à ses côtés."
                            },
                            {
                                "example_id": "b0a7435d-2ba6-42f2-8560-b57aa2995cb8",
                                "sense_id": "2b464aa3-7cf0-36af-b3e8-6df93368cfba",
                                "text": "Il aurait arrêté le Diable et demandé leurs passeports aux gisantes multitudes ressuscitées par le souffle d’Ézéchiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "bfec7ad6-5d1c-3044-b75c-b50933cb0a61",
                        "entry_id": "a2f2034a-75f7-34e1-ab93-10552b50b89c",
                        "glosses": [
                            "Se dit d'un quadrupède (en particulier un cerf) qui est représenté couché. À rapprocher de couché, dormant, embarroqué, en forme et en repos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48989452-e037-4505-b731-238639770edc",
                                "sense_id": "bfec7ad6-5d1c-3044-b75c-b50933cb0a61",
                                "text": "Écartelé ; au premier des comtes sénateurs au second de sinople au lion gisant gueule béante d’or ; au troisième d’argent aux trois violettes au naturel posées deux et un ; le quatrième d’azur à la croix pattée d’or, qui est de Claude François Marie Primat → voir illustration « lion gisant »"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                "word": "gisant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba78e3b7-c7b3-4fd0-b1da-49394b54deaf",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "tags": [
                            "plural"
                        ],
                        "form": "gisants"
                    },
                    {
                        "form_id": "86de3324-30b0-44bd-83e9-0c5f9ad836a5",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "gisante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5f77096-83e0-3cba-a034-c3d26f93cfd2",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "glosses": [
                            "Statue qui représente le défunt reposant, comme élément décoratif d'un tombeau."
                        ],
                        "tags": [
                            "Funéraire",
                            "Sculpture"
                        ],
                        "examples": [
                            {
                                "example_id": "50878982-ed54-459c-ab46-bede1088390b",
                                "sense_id": "b5f77096-83e0-3cba-a034-c3d26f93cfd2",
                                "text": "Chacun sur son oreiller, elle au fond, moi au bord, rigides comme deux gisants, elle une main sur la poitrine et l'autre sur le ventre comme Catherine de Médicis, moi les bras le long du corps comme Henri II […]"
                            },
                            {
                                "example_id": "58720e6e-3c1c-48d5-9067-3c6f2b4d2be5",
                                "sense_id": "b5f77096-83e0-3cba-a034-c3d26f93cfd2",
                                "text": "Ce silence, cette absence de tout mouvement l'impressionnait, on aurait dit un gisant."
                            },
                            {
                                "example_id": "a58f2951-d89b-4272-84e8-661d7a45ac01",
                                "sense_id": "b5f77096-83e0-3cba-a034-c3d26f93cfd2",
                                "text": "D’ordinaire, les gisants sont allongés, horizontaux des pieds à la tête. Seuls les bras offrent une gestuelle particulière, soit appuyés sur le buste, soit les mains en prière, ou encore le long du corps."
                            }
                        ]
                    },
                    {
                        "sense_id": "153b34a0-8b12-3cb8-9a7e-0bb9b3926bcb",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "glosses": [
                            "Personne mourante ou venant de mourir."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "74c16983-de7c-4c33-90be-d8b9d6be907d",
                                "sense_id": "153b34a0-8b12-3cb8-9a7e-0bb9b3926bcb",
                                "text": "Je me rappelle la pénombre aigre des chambres désinfectées au crésyl, les gisants de cire au milieu du linge blanc et le geste du prêtre qui ouvre les draps fétides et d'un pouce huilé trace ses croix en marmottant des orémus."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c9a3b66-e2f8-3d3e-b5b7-97b435b49582",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "glosses": [
                            "Objets devenus inutiles qu’on conserve."
                        ],
                        "tags": [
                            "analogy",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "57b695ab-3706-45f9-8469-d6a2878565c0",
                                "sense_id": "6c9a3b66-e2f8-3d3e-b5b7-97b435b49582",
                                "text": "Ses doigts tâtonnaient dans le noir, il fouillaient entre des souches de chéquiers, des factures d’EDF, des agendas périmés et une collection de vieux tickets de cinéma, ces gisants de papier qu’on entasse et que les générations suivantes hésiteront à jeter, quand ils videront les tiroirs de nos meubles après nous."
                            }
                        ]
                    },
                    {
                        "sense_id": "0660f46a-56cf-303c-914f-91252de8cc43",
                        "entry_id": "72adbb5e-afc1-3850-9f30-cb0f5e97516c",
                        "glosses": [
                            "Partie du brancard d’un chariot, qui porte directement sur l’essieu."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
