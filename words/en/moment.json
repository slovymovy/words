    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17807956-7d51-37ff-aa66-2cce7e8e91ca",
                    "sense_definition": "A brief, unspecified amount of time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wait a <w>moment</w> while I lock the front door.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подождите <w>минутку</w>, пока я запру входную дверь."
                            }
                        },
                        {
                            "text": "She stood for a <w>moment</w> holding her skirt above the grimy steps.",
                            "target_lang_translations": {
                                "ru": "Она постояла <w>мгновение</w>, придерживая юбку над грязными ступенями."
                            }
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "minute",
                        "second",
                        "while"
                    ],
                    "antonyms": [
                        "forever",
                        "age",
                        "eon"
                    ],
                    "common_phrases": [
                        "wait a moment",
                        "for a moment",
                        "just a moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткий, неопределенный промежуток времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "момент",
                                "target_lang_sense_clarification": "краткий промежуток времени"
                            },
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "очень короткий срок"
                            },
                            {
                                "target_lang_word": "минута",
                                "target_lang_sense_clarification": "небольшой промежуток времени"
                            },
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "молниеносный момент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2fa9552-c848-3505-ad26-e8cf15bbb8e8",
                    "sense_definition": "A particular point of time; an instant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At that <w>moment</w>, the lights in the theater went out.",
                            "target_lang_translations": {
                                "ru": "В тот <w>момент</w> свет в театре погас."
                            }
                        },
                        {
                            "text": "He knew at the <w>moment</w> of impact that the car was damaged.",
                            "target_lang_translations": {
                                "ru": "В <w>момент</w> столкновения он понял, что машина повреждена."
                            }
                        }
                    ],
                    "synonyms": [
                        "instant",
                        "juncture",
                        "point in time"
                    ],
                    "common_phrases": [
                        "at that moment",
                        "the right moment",
                        "moment of truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный момент времени; мгновение."
                    },
                    "translations": {
                        "ru": [
