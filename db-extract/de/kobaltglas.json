                            {
                                "example_id": "50e326f2-866b-4f50-8a02-8ec5fb254411",
                                "sense_id": "b4979af4-56a4-3409-a732-3b2d72f90864",
                                "text": "Die Flamme färbt sich intensiv gelb; betrachtet man sie durch ein blaues Glas („Kobaltglas“), so erscheint sie farblos."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0017e19-759d-4bf0-b69a-eb8096616ed3",
