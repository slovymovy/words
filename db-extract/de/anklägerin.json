                                "target_senses": [
                                    {
                                        "sense_id": "b5aab516-6623-3187-84d4-96a3505454ad",
                                        "entry_id": "3bf4560f-9eb5-3b86-b2e2-f3b8583e9332",
                                        "glosses": [
                                            "A prosecuting attorney."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a1f5151-4ca6-4a8d-9aa6-bddd7a16c100",
                                                "sense_id": "b5aab516-6623-3187-84d4-96a3505454ad",
                                                "text": "Annie Jay was the Wisconsin government prosecutor in the trial of a man for forging his client's signature."
                                            },
                                            {
                                                "example_id": "81b8c764-0d3d-4eed-97fc-6906e6b41bd5",
                                                "sense_id": "b5aab516-6623-3187-84d4-96a3505454ad",
                                                "text": "The evidence disclosed that the three prisoners were in a public-house together with the prosecutor, Abraham Rhodes, and that in concert with the other two prisoners, the prisoner John Dewhirst placed a pencase on the table in the room where they were assembled, and left the room to get writing-paper."
                                            },
                                            {
                                                "example_id": "9089c41c-cca2-4483-b618-650bfbdcbad8",
                                                "sense_id": "b5aab516-6623-3187-84d4-96a3505454ad",
                                                "text": "It sat by mutely while Jack Abramoff, the superlobbyist, spun schemes that eroded public trust, until prosecutors had to move in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd7d6492-e00d-3ce5-919c-d6416e0aa828",
                                        "entry_id": "3bf4560f-9eb5-3b86-b2e2-f3b8583e9332",
                                        "glosses": [
                                            "A person, as a complainant, victim, or chief witness, who institutes prosecution in a criminal proceeding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "467d86d2-72ac-4445-afc5-b23863323746",
                                                "sense_id": "bd7d6492-e00d-3ce5-919c-d6416e0aa828",
                                                "text": "The prosecutor got the witness to admit he was lying."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "776bbd0f-2e87-47ea-abe4-7a776a021082",
                        "source_entry_id": "886837a9-d09e-34f2-85bc-8aa41b9c45cf",
