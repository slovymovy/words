            "senses": [
                {
                    "sense_id": "739a0d64-4600-3fd5-b5c4-978a6c992dae",
                    "sense_definition": "Devenir visible ou commencer à se manifester.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visibilité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un magnifique arc-en-ciel vient d'<w>apparaître</w> dans le ciel après la pluie."
                        },
                        {
                            "text": "Une nouvelle icône va <w>apparaître</w> sur un écran après le redémarrage."
                        }
                    ],
                    "antonyms": [
                        "disparaître"
                    ],
                    "common_phrases": [
                        "apparaître dans le ciel",
                        "apparaître sur un écran"
                    ]
                },
                {
                    "sense_id": "b533c85b-7cd8-302b-bee1-5bb2cdcb111a",
                    "sense_definition": "Sembler, donner une impression particulière ou se présenter à l'esprit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette proposition nous <w>apparaît</w> tout à fait raisonnable compte tenu des circonstances."
                        },
                        {
                            "text": "La solution commence à <w>apparaître</w> clairement après de longues discussions."
                        }
                    ],
                    "synonyms": [
                        "paraître"
                    ],
                    "common_phrases": [
                        "apparaître clairement",
                        "apparaître comme une évidence"
                    ]
                },
                {
                    "sense_id": "25bd72bd-0509-395f-b021-1b96db67701a",
                    "sense_definition": "Se présenter de manière soudaine, imprévue ou surprenante.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surgissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un cerf majestueux est soudainement <w>apparu</w> au milieu de la route forestière."
                        },
                        {
                            "text": "Sans faire le moindre bruit, elle <w>apparut</w> sur le seuil de la porte."
                        }
                    ],
                    "common_phrases": [
                        "apparaître soudainement"
                    ]
                }
            ]
        }
