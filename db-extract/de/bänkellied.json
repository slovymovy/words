                "senses": [
                    {
                        "sense_id": "1b323625-bdbb-3007-88d6-ea6f6ad1542e",
                        "entry_id": "64ec0aa4-ad97-3f34-b0cd-393161d29141",
                        "glosses": [
                            "erzählendes Lied von Moritaten (Mordtaten und Verbrechen), das von fahrenden Schaustellern auf Jahrmärkten vorgetragen wurde und von großen Bildtafeln illustriert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49ba011-e175-41ed-b297-b9f1323f32c3",
                                "sense_id": "1b323625-bdbb-3007-88d6-ea6f6ad1542e",
                                "text": "Auch heute gibt es einige wenige Künstler, die die Tradition der Bänkelsänger aufleben lassen und mit den alten Bänkelliedern auf historischen Jahrmärkten und Burgfesten auftreten."
                            },
                            {
                                "example_id": "2a5f40c7-910c-42e7-9277-5944c5009418",
                                "sense_id": "1b323625-bdbb-3007-88d6-ea6f6ad1542e",
                                "text": "„Oben auf einem First stand ein bedauernswerter Schwachsinniger und zeigte seine armselige Kunst, die er schaurige Bänkellieder fürs Volk nannte, es kostete einen Schilling.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
