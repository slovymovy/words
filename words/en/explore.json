{
    "word_family": [
        "exploration",
        "explorer",
        "exploratory",
        "explorative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea32ca1d-fd46-3b98-8cac-f0367771f423",
                    "sense_definition": "To travel to or around an unfamiliar place in order to learn about it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "travel_discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We plan to <w>explore</w> the ancient ruins during our summer vacation.",
                            "target_lang_translations": {
                                "ru": "Мы планируем <w>исследовать</w> древние руины во время летнего отпуска.",
                                "tr": "Yaz tatilimiz sırasında antik kalıntıları <w>keşfetmeyi</w> planlıyoruz.",
                                "zh": "我们计划在暑假期间去<w>探索</w>那些古遗迹。"
                            }
                        },
                        {
                            "text": "Astronauts continue to <w>explore</w> space to discover new planets and stars.",
                            "target_lang_translations": {
                                "ru": "Астронавты продолжают <w>исследовать</w> космос, чтобы открывать новые планеты и звезды.",
                                "tr": "Astronotlar yeni gezegenler ve yıldızlar keşfetmek için uzayı <w>araştırmaya</w> devam ediyor.",
                                "zh": "宇航员们继续<w>探索</w>太空，以发现新的行星和恒星。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "explore the world",
                        "explore the city",
                        "explore nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путешествовать по незнакомому месту или местности с целью его изучения.",
                        "tr": "Hakkında bilgi edinmek amacıyla bilinmeyen bir yere veya bölgeye seyahat etmek.",
                        "zh": "前往陌生的地方进行实地考察或游览，以了解当地情况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исследовать",
                                "target_lang_sense_clarification": "путешествовать и изучать"
                            },
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "познавать новое место"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "keşfetmek",
                                "target_lang_sense_clarification": "yeni bir yeri gezip öğrenmek"
                            },
                            {
                                "target_lang_word": "gezip görmek",
                                "target_lang_sense_clarification": "bir bölgeyi dolaşarak tanımak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "探索",
                                "target_lang_sense_clarification": "深入了解未知领域或地方"
                            },
                            {
                                "target_lang_word": "考察",
                                "target_lang_sense_clarification": "实地观察调查"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7894f071-ba81-36c7-ab4a-a7fc6ec44d44",
                    "sense_definition": "To examine or investigate something systematically to understand it better.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "investigate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee needs to <w>explore</w> all possible solutions to the problem.",
                            "target_lang_translations": {
                                "ru": "Комитету необходимо <w>изучить</w> все возможные решения проблемы.",
                                "tr": "Komitenin soruna yönelik tüm olası çözümleri <w>araştırması</w> gerekiyor.",
                                "zh": "委员会需要<w>探讨</w>解决该问题的所有可能方案。"
                            }
                        },
                        {
                            "text": "Scientists are <w>exploring</w> the causes of the sudden climate change.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>исследуют</w> причины внезапного изменения климата.",
                                "tr": "Bilim insanları ani iklim değişikliğinin nedenlerini <w>inceliyor</w>.",
                                "zh": "科学家们正在<w>研究</w>气候突然变化的原因。"
                            }
                        }
                    ],
                    "synonyms": [
                        "research",
                        "delve into",
                        "investigate",
                        "look into"
                    ],
                    "common_phrases": [
                        "explore options",
                        "explore possibilities",
                        "explore ideas"
                    ],
                    "target_lang_definitions": {
                        "ru": "Систематически рассматривать или изучать что-либо для лучшего понимания.",
                        "tr": "Bir konuyu daha iyi anlamak için sistemli bir şekilde incelemek veya araştırmak.",
                        "zh": "系统地检查或研究某事物，以便更深入地理解它。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изучать",
                                "target_lang_sense_clarification": "вникать в детали"
                            },
                            {
                                "target_lang_word": "исследовать",
                                "target_lang_sense_clarification": "проводить изыскания"
                            },
                            {
                                "target_lang_word": "рассматривать",
                                "target_lang_sense_clarification": "анализировать варианты"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "araştırmak",
                                "target_lang_sense_clarification": "sistemli şekilde incelemek"
                            },
                            {
                                "target_lang_word": "incelemek",
                                "target_lang_sense_clarification": "detaylarıyla ele almak"
                            },
                            {
                                "target_lang_word": "değerlendirmek",
                                "target_lang_sense_clarification": "seçenekleri veya fikirleri gözden geçirmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "研究",
                                "target_lang_sense_clarification": "深入探究问题或现象"
                            },
                            {
                                "target_lang_word": "探讨",
                                "target_lang_sense_clarification": "深入讨论或分析问题"
                            },
                            {
                                "target_lang_word": "考察",
                                "target_lang_sense_clarification": "审视或评估方案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4dbed258-7903-3390-beab-d210629e5eaa",
                    "sense_definition": "To wander around a place without a specific purpose just to see what is there.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "travel_discovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran off to <w>explore</w> the woods behind the house.",
                            "target_lang_translations": {
                                "ru": "Дети убежали <w>исследовать</w> лес за домом.",
                                "tr": "Çocuklar evin arkasındaki ormanı <w>keşfetmek</w> için koşup gittiler.",
                                "zh": "孩子们跑去屋后的树林里<w>探险</w>了。"
                            }
                        },
                        {
                            "text": "I spent the whole afternoon <w>exploring</w> the narrow streets of the old town.",
                            "target_lang_translations": {
                                "ru": "Я провел весь день, <w>осматривая</w> узкие улочки старого города.",
                                "tr": "Bütün öğleden sonrayı eski kentin dar sokaklarını <w>dolaşarak</w> geçirdim.",
                                "zh": "我整个下午都在老城狭窄的街道上<w>逛</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go exploring",
                        "explore around"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бродить по месту без определенной цели, просто чтобы посмотреть, что там есть.",
                        "tr": "Sadece ne olduğunu görmek amacıyla belirli bir amacı olmadan bir yerde dolaşmak.",
                        "zh": "在某处随意走动，没有特定目的，只是为了看看那里有什么。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "знакомиться с обстановкой"
                            },
                            {
                                "target_lang_word": "бродить",
                                "target_lang_sense_clarification": "гулять без цели"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dolaşmak",
                                "target_lang_sense_clarification": "etrafı görmek için gezmek"
                            },
                            {
                                "target_lang_word": "keşfe çıkmak",
                                "target_lang_sense_clarification": "çevreyi gezip görmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逛",
                                "target_lang_sense_clarification": "随意游览"
                            },
                            {
                                "target_lang_word": "转转",
                                "target_lang_sense_clarification": "四处走动查看"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97bb67b9-b516-3de7-9f2d-af54a54daf59",
                    "sense_definition": "To examine a part of the body, often surgically, to make a diagnosis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon had to <w>explore</w> the wound to check for internal damage.",
                            "target_lang_translations": {
                                "ru": "Хирургу пришлось <w>обследовать</w> рану, чтобы проверить наличие внутренних повреждений.",
                                "tr": "Cerrah, iç hasar olup olmadığını kontrol etmek için yarayı <w>incelemek</w> zorunda kaldı.",
                                "zh": "外科医生必须<w>探查</w>伤口，以检查是否有内部损伤。"
                            }
                        },
                        {
                            "text": "Doctors decided to <w>explore</w> the abdomen to find the source of the pain.",
                            "target_lang_translations": {
                                "ru": "Врачи решили <w>обследовать</w> брюшную полость, чтобы найти источник боли.",
                                "tr": "Doktorlar ağrının kaynağını bulmak için karın bölgesini <w>muayene etmeye</w> karar verdiler.",
                                "zh": "医生们决定对腹部进行<w>探查</w>，以找到疼痛的根源。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осматривать часть тела, часто хирургическим путем, для постановки диагноза.",
                        "tr": "Teşhis koymak amacıyla vücudun bir bölümünü (genellikle cerrahi yöntemle) muayene etmek.",
                        "zh": "检查身体的某个部位，通常通过手术方式，以进行诊断。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обследовать",
                                "target_lang_sense_clarification": "проводить медицинский осмотр"
                            },
                            {
                                "target_lang_word": "осматривать",
                                "target_lang_sense_clarification": "диагностировать"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muayene etmek",
                                "target_lang_sense_clarification": "tıbbi açıdan incelemek"
                            },
                            {
                                "target_lang_word": "incelemek",
                                "target_lang_sense_clarification": "cerrahi olarak kontrol etmek"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "探查",
                                "target_lang_sense_clarification": "医学上深入检查病灶"
                            },
                            {
                                "target_lang_word": "检查",
                                "target_lang_sense_clarification": "诊断性查看"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7af8099b-82fe-3288-8162-cc9d19f79620",
                    "sense_definition": "A short tour or walk around a place to see what it is like.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went for a quick <w>explore</w> of the town before dinner.",
                            "target_lang_translations": {
                                "ru": "Мы пошли на быстрый <w>осмотр</w> города перед ужином.",
                                "tr": "Akşam yemeğinden önce kasabada hızlı bir <w>keşif turuna</w> çıktık.",
                                "zh": "晚饭前我们去镇上<w>逛了逛</w>。"
                            }
                        },
                        {
                            "text": "I had a little <w>explore</w> around the garden while waiting for you.",
                            "target_lang_translations": {
                                "ru": "Я немного <w>прогулялся</w> по саду, пока ждал тебя.",
                                "tr": "Seni beklerken bahçede küçük bir <w>gezinti</w> yaptım.",
                                "zh": "等你的时候，我在花园里<w>转了转</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have an explore",
                        "go for an explore"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая прогулка или осмотр места, чтобы узнать, что оно собой представляет.",
                        "tr": "Bir yerin nasıl olduğunu görmek için yapılan kısa tur veya yürüyüş.",
                        "zh": "为了了解某地情况而进行的短途游览或散步。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмотр",
                                "target_lang_sense_clarification": "краткое ознакомление"
                            },
                            {
                                "target_lang_word": "прогулка",
                                "target_lang_sense_clarification": "хождение по месту"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "keşif turu",
                                "target_lang_sense_clarification": "kısa gezinti"
                            },
                            {
                                "target_lang_word": "gezinti",
                                "target_lang_sense_clarification": "etrafı dolaşma"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逛逛",
                                "target_lang_sense_clarification": "随意的短途游览"
                            },
                            {
                                "target_lang_word": "探访",
                                "target_lang_sense_clarification": "短时间的实地查看"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}