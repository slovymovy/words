                                        "glosses": [
                                            "To labour in (or as in) a low servile job."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8ae6107-4cad-4592-bdc1-b6e1b46481e2",
                                                "sense_id": "34cfd3ce-6ea5-3314-b367-fff071273765",
                                                "text": "Rise to our Toils and drudge away the day."
                                            },
                                            {
                                                "example_id": "a6b84031-421c-4350-90a5-d5394cf3eb25",
                                                "sense_id": "34cfd3ce-6ea5-3314-b367-fff071273765",
                                                "text": "He gradually rose in the estimation of the booksellers for whom he drudged."
                                            }
                                        ]
