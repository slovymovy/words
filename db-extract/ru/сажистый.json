                "senses": [
                    {
                        "sense_id": "d8eb4365-f637-35a7-ac45-d7a0f8e317ed",
                        "entry_id": "0762e039-f9b4-3de3-b80d-32153c9f4123",
                        "glosses": [
                            "содержащий в себе сажу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1579b7a4-0e1a-40fe-a499-7ce4b3ae2ea0",
                                "sense_id": "d8eb4365-f637-35a7-ac45-d7a0f8e317ed",
                                "text": "На многих старых сучках-пеньках сохранились сажистые следы ожога, иногда выраженные довольно отчетливо."
                            }
                        ]
                    },
                    {
                        "sense_id": "da0563f9-26a9-39a8-9b11-ca8139223f1c",
                        "entry_id": "0762e039-f9b4-3de3-b80d-32153c9f4123",
                        "glosses": [
                            "дающий много сажи"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4cc94fbb-27b1-3876-9236-d52ced422664",
                        "entry_id": "0762e039-f9b4-3de3-b80d-32153c9f4123",
                        "glosses": [
                            "пачкающийся как сажа"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88ac882c-e2ea-42c6-9a75-b9f55c2382ca",
                                "sense_id": "4cc94fbb-27b1-3876-9236-d52ced422664",
                                "text": "Примерами могут служить: мел, каолин (в сухом состоянии), различные охры, сажистый пиролюзит (MnO₂), тонкопористые массы гидроокислов железа и т. д."
                            }
                        ]
                    }
