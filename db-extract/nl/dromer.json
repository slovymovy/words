                        "entry_id": "1b47ebcf-71f6-35cf-9b55-b070e90aeb54",
                        "glosses": [
                            "een persoon (man) die droomt."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "91f8dd6a-dc12-300c-9162-7dc94cf73ce6",
                        "entry_id": "1b47ebcf-71f6-35cf-9b55-b070e90aeb54",
                        "glosses": [
                            "een idealist, een niet realistisch persoon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bad8ae1d-30ed-41be-8c3f-fa106a1faff5",
                                "sense_id": "91f8dd6a-dc12-300c-9162-7dc94cf73ce6",
                                "text": "Hij is meer een dromer dan een aanpakker."
                            },
                            {
                                "example_id": "61e45e21-c6d6-4fd6-85b9-de3d8ee87375",
                                "sense_id": "91f8dd6a-dc12-300c-9162-7dc94cf73ce6",
                                "text": "Allemaal dromers die hun dromen waarmaakten."
                            }
                        ]
                    },
                    {
                        "sense_id": "39065bf8-d8b7-3f94-aa05-2a0f419de17f",
                        "entry_id": "1b47ebcf-71f6-35cf-9b55-b070e90aeb54",
                        "glosses": [
                            "Een dromerdijk of dromer is een extra dijk voor het geval de slaperdijk geen stand houdt. Het is de laatste in het rijtje waker - slaper - dromer."
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b44a119e-5e07-45e9-b92d-b0dc0cee5d44",
                        "source_entry_id": "1b47ebcf-71f6-35cf-9b55-b070e90aeb54",
                        "target_lang_word": "Träumer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Träumer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                        "entry_id": "1b3e2f9d-1b0f-37c7-992f-772a23c2fadb",
                                        "glosses": [
                                            "Person, die im Schlaf träumt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27512e5f-df55-41bc-b365-110a683aef51",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Am Morgen wird der Träumer gebeten, seinen Traum so detailreich wie möglich zu schildern."
                                            },
                                            {
                                                "example_id": "481a4300-89e3-4cb5-9ba5-6642ff2da6f3",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Ein Träumer kann nur selten seinen Traum beeinflussen oder ihn beenden."
                                            },
                                            {
                                                "example_id": "cf40ce27-d834-4564-8f9f-b9d341e7e955",
                                                "sense_id": "5c09e012-e091-31dd-ae39-83ca4a281985",
                                                "text": "Er ist kein Träumer, jedenfalls kann er sich kaum einmal daran erinnern, im Schlaf geträumt zu haben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                        "entry_id": "1b3e2f9d-1b0f-37c7-992f-772a23c2fadb",
                                        "glosses": [
                                            "Person, die stark von ihren Traumvorstellungen (Wunschvorstellungen oder auch unrealistischen Vorstellungen über die Wirklichkeit) beeinflusst wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e40119d1-2f9e-4849-afd3-b1e1d584bdc4",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Der Träumer war allerdings kein Weichling.“"
                                            },
                                            {
                                                "example_id": "06a6646d-ab45-40a7-ad1b-e86c61dbbc3a",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "Du bist doch ein Träumer! Glaubst Du wirklich, dass er freiwillig nachgeben wird?"
                                            },
                                            {
                                                "example_id": "9d09ddcc-6da2-48a3-953b-e018b403c043",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "Wir brauchen Träumer, die das vordenken, was andere später einmal realisieren werden."
                                            },
                                            {
                                                "example_id": "33d3ba78-bc9e-4049-844b-3779a7099a97",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Ein solcher Träumer war Jakob Haringer, ein Träumer aus schierer Verzweiflung.“"
                                            },
                                            {
                                                "example_id": "e251068f-d87c-494a-8fbb-825dd6a8880a",
                                                "sense_id": "a9021f08-5741-39b6-8650-abd449777f3e",
                                                "text": "„Wenn die Gegenseite Krieg will, hilft Friedensliebe wenig. Pazifisten gelten heute als Träumer, Populisten oder Putin-Versteher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1450230-6fd9-44b9-8af2-c9225a9497e3",
                        "source_entry_id": "1b47ebcf-71f6-35cf-9b55-b070e90aeb54",
