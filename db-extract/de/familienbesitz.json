                "senses": [
                    {
                        "sense_id": "b082c4ae-9bf2-3182-9bed-fb49f4c851f5",
                        "entry_id": "03eb5290-d712-354c-8354-dd24061613c0",
                        "glosses": [
                            "Gesamtheit dessen, was sich im Besitz einer Familie befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9719b893-f8f8-45a7-89b2-6ea96cda145c",
                                "sense_id": "b082c4ae-9bf2-3182-9bed-fb49f4c851f5",
                                "text": "„Auch hier gehört zum Familienbesitz ein Weinberg mit eigener Kelterei, für die es schon Ausbaupläne gibt.“"
                            },
                            {
                                "example_id": "7e84f077-7c7f-45e4-b600-7790da972d87",
                                "sense_id": "b082c4ae-9bf2-3182-9bed-fb49f4c851f5",
                                "text": "„Luther wusste das vermutlich von Katharina, die sich um den Familienbesitz kümmerte und ihn eifrig mehrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
