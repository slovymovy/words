                        "examples": []
                    },
                    {
                        "sense_id": "941f60f1-1813-35c3-9ecc-e1e0eff3a8bc",
                        "entry_id": "eed0fc92-f05b-34f7-a871-e5920743e05b",
                        "glosses": [
                            "деревья, посаженные шпалерами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "129162a6-b43d-4c64-a511-0cddf6bb7895",
                                "sense_id": "941f60f1-1813-35c3-9ecc-e1e0eff3a8bc",
                                "text": "Тут бы ему [Завольскому] и умереть голодною и лютою смертию, и занимательному роману не бывать; но вдруг он находит на дорожке женские перчатки, а в двух шагах от себя за густым шпалерником слышит женские голоса."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfeb4518-ca04-4045-91ea-0469f336edf1",
                        "source_entry_id": "eed0fc92-f05b-34f7-a871-e5920743e05b",
                        "target_lang_word": "espalier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espalier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "413a2b6c-a00d-362a-912c-5ee2d31171a2",
                                        "entry_id": "48b3f3c9-42e4-3936-9db8-a9821eae90bc",
                                        "glosses": [
                                            "A latticework used to shape or train the branches of a tree or shrub into a two-dimensional ornamental or useful design, as along a wall or fence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b7e2ca-fb6c-4768-9df8-34b93a57092c",
                                                "sense_id": "413a2b6c-a00d-362a-912c-5ee2d31171a2",
                                                "text": "The garment stalls carried the traditional blue vine-dressers' outfits, sunhats, and the great willow pitchforks grown in espalier at villages like Sauve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e138d05b-3860-3a92-a6d0-952b391e29eb",
                                        "entry_id": "48b3f3c9-42e4-3936-9db8-a9821eae90bc",
                                        "glosses": [
                                            "A plant that has been shaped in this manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e046cb24-6a91-49be-a739-9f30bf0b2bab",
                                                "sense_id": "e138d05b-3860-3a92-a6d0-952b391e29eb",
                                                "text": "It is on this rocky surface that one finds many of the growth forms associated with extreme life conditions: polsters, mat plants, espaliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75a7cf39-4329-30c1-bf8e-6cce1d307f1c",
                                        "entry_id": "48b3f3c9-42e4-3936-9db8-a9821eae90bc",
                                        "glosses": [
                                            "A row of plants that have been shaped in this manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
