                "senses": [
                    {
                        "sense_id": "f2b06013-be13-3cb7-8e93-390655c37e12",
                        "entry_id": "7667d876-2f72-3cb1-a207-864f896338fe",
                        "glosses": [
                            "The act of enslaving or the state of being a slave; bondage"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad1de5a4-86d7-4610-a357-7d00b94ed20c",
                                "sense_id": "f2b06013-be13-3cb7-8e93-390655c37e12",
                                "text": "I should like to take this opportunity to express my wish for success and victory in our struggle against Communism and enslavement and for freedom and peace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "556e4ab6-898c-4358-9b46-b720109efd9c",
                        "source_entry_id": "7667d876-2f72-3cb1-a207-864f896338fe",
                        "source_sense_id": "f2b06013-be13-3cb7-8e93-390655c37e12",
