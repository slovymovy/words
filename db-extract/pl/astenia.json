                "forms": [],
                "senses": [
                    {
                        "sense_id": "cd6498ab-6dc6-3ef3-b70d-5d13274a9b9a",
                        "entry_id": "cb9acbc4-5574-3b33-bbac-d9076cdb8e39",
                        "glosses": [
                            "stan słabości, zmniejszenie lub brak odporności fizycznej i psychicznej"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
