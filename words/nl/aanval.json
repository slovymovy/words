                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sudden_onset",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In een <w>aanval</w> van woede gooide hij de vaas op de grond.",
                            "target_lang_translations": {
                                "en": "In a <w>fit</w> of rage, he threw the vase on the floor.",
                                "ru": "В <w>приступе</w> ярости он бросил вазу на пол.",
                                "fr": "Dans une <w>crise</w> de colère, il a jeté le vase par terre."
