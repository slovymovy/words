                ],
                "senses": [
                    {
                        "sense_id": "74167b77-b9fc-3f10-95c5-d292f07b631a",
                        "entry_id": "606e5685-addd-39d1-80ab-dfe95504b7b0",
                        "glosses": [
                            "Rendre serein."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "98a1d87f-98d1-48d3-9bbc-f28fe835c3e0",
                                "sense_id": "74167b77-b9fc-3f10-95c5-d292f07b631a",
                                "text": "La philosophie faict estat de sereiner les tempestes de l’ame."
                            },
                            {
                                "example_id": "2c7015eb-7210-43bf-8bf5-19b36dcd0c2e",
                                "sense_id": "74167b77-b9fc-3f10-95c5-d292f07b631a",
                                "text": "Enfin ! un peu de soleil sereinera cette misère. Cette sérénité des belles heures lisses et chaudes, Georges en savourait par avance la splendeur."
                            },
                            {
                                "example_id": "575a7d83-1df9-4a67-8082-b13ea8c27765",
                                "sense_id": "74167b77-b9fc-3f10-95c5-d292f07b631a",
                                "text": "Ici même, déjà, la main sur la poitrine,\nIls ont congratulé le dieu de la doctrine\nEt reçu, pour salaire, un rayon de ses yeux\nQui contristent la France et sereinent Lisieux."
                            }
                        ]
                    }
