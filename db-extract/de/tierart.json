                        "sense_id": "26935c8b-e6b8-31b9-8d83-809434d02800",
                        "entry_id": "c273db11-1d6a-36bf-899b-c24f9a659854",
                        "glosses": [
                            "nach bestimmten Kriterien von anderen Tieren abgegrenzte Tiergruppe"
