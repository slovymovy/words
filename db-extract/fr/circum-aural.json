                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumaural",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bfc402b-ea2a-3e73-b29d-f2967c72c1e8",
                                        "entry_id": "a96aea13-6223-3c48-956d-8583b42cdb08",
                                        "glosses": [
                                            "Surrounding the pinnae or external ears, as in circumaural headphones."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc63439e-c173-4be7-92ae-ae0f81f75290",
                                                "sense_id": "5bfc402b-ea2a-3e73-b29d-f2967c72c1e8",
                                                "text": "They adjusted with a-dB step attenuator the loudness of one of two circumaural earphones to equality with a standard WE 705A ear-phone set at 40 dB..."
                                            },
                                            {
                                                "example_id": "7d66685e-11cf-407c-a55e-279e64b147c7",
                                                "sense_id": "5bfc402b-ea2a-3e73-b29d-f2967c72c1e8",
                                                "text": "First, they are usually connected by a headband and it can be difficult to place the headband or the circumaural cushion so as not to rest on a scalp..."
                                            },
                                            {
                                                "example_id": "73eb6c2d-3720-44ed-a051-31ccc67511ce",
                                                "sense_id": "5bfc402b-ea2a-3e73-b29d-f2967c72c1e8",
                                                "text": "For the first two experiments, sounds were presented through canal (insert) earphones...; for the third experiment, circumaural earphones...were employed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
