                    "frequency": "Middle",
                    "semantic_group_id": "portion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fügen Sie der Suppe vor dem Servieren noch eine <w>Prise</w> Salz hinzu."
                        },
                        {
                            "text": "Ein guter Kuchen braucht neben Mehl und Eiern oft auch eine <w>Prise</w> Zucker."
                        }
                    ],
                    "common_phrases": [
