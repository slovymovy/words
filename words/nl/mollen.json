                            }
                        },
                        {
                            "text": "Ze hadden de getuige al <w>gemold</w> voordat hij zijn verklaring kon afleggen.",
                            "target_lang_translations": {
                                "en": "They had already <w>done in</w> the witness before he could make his statement."
                            }
                        }
                    ],
                    "synonyms": [
