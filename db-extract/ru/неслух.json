                        "tags": [],
                        "examples": [
                            {
                                "example_id": "153b33f7-798e-4e19-9e08-76bb30ff97e1",
                                "sense_id": "f3c273a2-ca97-388b-a090-4f5cc60faabc",
                                "text": "— Я не знаю, в кого ты стал неслухом."
                            },
                            {
                                "example_id": "084ca6fa-631e-4a33-9107-6d2d4a0654d5",
                                "sense_id": "f3c273a2-ca97-388b-a090-4f5cc60faabc",
                                "text": "— Да сейчас дети-то пошли неслухи да своевольники."
                            }
                        ]
                    }
