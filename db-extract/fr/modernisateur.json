                "senses": [
                    {
                        "sense_id": "b057aad3-17e9-3fa0-a43d-32bab4e53114",
                        "entry_id": "713b654b-fa11-301f-8e59-d00cb5adfd0a",
                        "glosses": [
                            "Qui rend plus moderne quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e23a6b3-422f-4f6a-aa81-8633bb228199",
                                "sense_id": "b057aad3-17e9-3fa0-a43d-32bab4e53114",
                                "text": "Face à ce mouvement modernisateur, divers autres milieux sociaux peuvent se sentir remis en question dans leur identité."
                            },
                            {
                                "example_id": "4fc8dff7-e142-474e-9917-aa5482f31001",
                                "sense_id": "b057aad3-17e9-3fa0-a43d-32bab4e53114",
                                "text": "Cette dynamique modernisatrice est d’autant plus importante qu’elle est censée détruire les structures précapitalistes et donc préparer le terrain pour la transition du capitalisme au socialisme."
                            }
                        ]
                    }
                ],
