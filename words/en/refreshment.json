    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "66069dac-f407-3995-9d11-fc5e6232f9dd",
                    "sense_definition": "Light food or drink served in a small quantity, especially at an event or during a break.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_drink",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Light <w>refreshments</w> will be served immediately after the presentation.",
                            "target_lang_translations": {
                                "ru": "Сразу после презентации будут предложены лёгкие <w>закуски</w>."
                            }
                        },
                        {
                            "text": "The guests stopped at a cafe for some much-needed <w>refreshment</w>.",
                            "target_lang_translations": {
                                "ru": "Гости зашли в кафе, чтобы немного <w>подкрепиться</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "light refreshments",
                        "serve refreshments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лёгкая еда или напитки, подаваемые в небольшом количестве, особенно на мероприятиях или во время перерыва."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закуски",
                                "target_lang_sense_clarification": "лёгкая еда на мероприятиях"
                            },
                            {
                                "target_lang_word": "угощение",
                                "target_lang_sense_clarification": "еда и напитки для гостей"
                            },
                            {
                                "target_lang_word": "прохладительные напитки",
                                "target_lang_sense_clarification": "напитки для утоления жажды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7e28f56-7cda-308e-b68b-ae0ecddce3a6",
                    "sense_definition": "The act or feeling of restoring physical energy, strength, or freshness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A short walk in the cool air provided great <w>refreshment</w> after studying.",
                            "target_lang_translations": {
                                "ru": "Короткая прогулка на свежем воздухе принесла прекрасное <w>освежение</w> после учёбы."
                            }
                        },
                        {
                            "text": "He sought mental <w>refreshment</w> by spending a quiet weekend in the mountains.",
                            "target_lang_translations": {
                                "ru": "Он искал душевной <w>перезагрузки</w>, проведя спокойные выходные в горах."
                            }
                        }
                    ],
                    "synonyms": [
                        "reinvigoration",
                        "revival",
                        "restoration",
                        "renewal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстановление физических сил, энергии, бодрости или свежести."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освежение",
                                "target_lang_sense_clarification": "возвращение свежести и сил"
                            },
                            {
                                "target_lang_word": "восстановление сил",
                                "target_lang_sense_clarification": "отдых, возвращение энергии"
                            },
                            {
                                "target_lang_word": "бодрость",
                                "target_lang_sense_clarification": "чувство прилива энергии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
