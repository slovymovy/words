                "senses": [
                    {
                        "sense_id": "96a4da23-f4bb-3238-a14d-8d4bcdaa17ae",
                        "entry_id": "7d8b9e1a-29b7-34a9-891c-74405642f9fa",
                        "glosses": [
                            "alternative letter-case form of Fugen-s"
                        ],
                        "tags": [
