                                                "sense_id": "e4178fd0-bfba-348e-aa54-33ab0bcfe6b1",
                                                "text": "Es ist schön muckelig warm hier."
                                            },
                                            {
                                                "example_id": "3f28e6fe-587b-4a16-8ea9-2ae418da172f",
                                                "sense_id": "e4178fd0-bfba-348e-aa54-33ab0bcfe6b1",
                                                "text": "Ein muckeliger Nachmittag ist einfach das Tollste, wenn ich denn mal einen freien Tag habe."
                                            },
                                            {
                                                "example_id": "9d3f8092-3cef-470e-8ccf-b03825848698",
                                                "sense_id": "e4178fd0-bfba-348e-aa54-33ab0bcfe6b1",
                                                "text": "Ach, ich wünsche mir zu Weihnachten eine muckelige Lammfellweste."
                                            }
