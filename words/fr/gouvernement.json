            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a23db7c-f62a-346f-afab-4024111d3878",
                    "sense_definition": "Organe collégial exerçant le pouvoir exécutif dans un pays, composé des ministres sous la direction d'un chef d'État ou de gouvernement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le Premier ministre a présenté les nouveaux membres de son <w>gouvernement</w>."
                        },
                        {
                            "text": "Le <w>gouvernement</w> a annoncé une baisse des impôts pour les ménages modestes dès l'année prochaine."
                        }
                    ],
                    "synonyms": [
                        "ministère",
                        "cabinet"
                    ],
                    "common_phrases": [
                        "chef du gouvernement",
                        "porte-parole du gouvernement",
                        "former un gouvernement"
                    ]
                },
                {
                    "sense_id": "48279ed5-3e51-3716-a9a9-d37c7dab8d41",
                    "sense_definition": "Autorité suprême ou institution politique qui régit et dirige un État.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les citoyens attendent des mesures efficaces de la part de leur <w>gouvernement</w> pour lutter contre le chômage."
                        },
                        {
                            "text": "Après de longs mois de contestation populaire, les manifestants ont renversé le <w>gouvernement</w> autoritaire."
                        }
                    ],
                    "synonyms": [
                        "pouvoir"
                    ],
                    "common_phrases": [
                        "gouvernement central",
                        "renverser un gouvernement"
                    ]
                },
                {
                    "sense_id": "562576c2-062a-3eff-8d55-599e17536803",
                    "sense_definition": "Système, régime ou mode d'organisation politique selon lequel un État est constitué et administré.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La république parlementaire est une forme de <w>gouvernement</w> courante sur le continent européen."
                        },
                        {
                            "text": "Les philosophes des Lumières ont analysé les avantages et les faiblesses de chaque type de <w>gouvernement</w>."
