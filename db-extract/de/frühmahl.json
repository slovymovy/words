                        "entry_id": "ca1a9773-adaa-3376-99d7-b70359ea5206",
                        "glosses": [
                            "Mahl, das früh am Tag eingenommen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e95c03-a932-450c-9e04-fe5b5ed72677",
                                "sense_id": "4037f73d-1152-3323-aa3a-a3289f4ecb55",
                                "text": "„Am nächsten Morgen sorgte sie, als er sich erhoben hatte, für sein Frühmahl.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "072ec0b2-e490-4068-b3b4-d645c1d525ca",
                        "source_entry_id": "ca1a9773-adaa-3376-99d7-b70359ea5206",
                        "source_sense_id": "4037f73d-1152-3323-aa3a-a3289f4ecb55",
                        "source_sense_description": "Mahl, das früh am Tag eingenommen wird",
                        "target_lang_word": "petit-déjeuner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petit-déjeuner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                        "entry_id": "7f52f3dd-637f-3c06-90b0-e2d771053fe0",
                                        "glosses": [
                                            "Manger un petit déjeuner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f69b3ea0-f902-41ff-8a40-735e6d2ede01",
                                                "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                                "text": "Le jour du nouvel an, ils petit-déjeunèrent d’un zoni traditionnel, puis les deux filles allèrent essayer leurs cerfs-volants avec les enfants du voisinage."
                                            },
                                            {
                                                "example_id": "38d20d63-348c-4f12-8287-cd16128fc8db",
                                                "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                                "text": "Et puis tu petit-déjeunais à la sauvette, cigarette au bec, debout dans la cuisine."
                                            },
                                            {
                                                "example_id": "17e5abea-b214-4dc6-a10f-0df3c8c33ed0",
                                                "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                                "text": "On va encore me reprocher de passer mon temps à regarder Télématin, mais il fallait bien que je petit-déjeunasse pour oublier, si peu que ce soit, les quatre jours de quasi-diète que vient de m’infliger un OVNI (objet viral non identifié) !"
                                            },
                                            {
                                                "example_id": "fc581d13-718e-437c-9401-a5b46184a35d",
                                                "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                                "text": "Elle petit-déjeuna à la terrasse d’un café, et se rendit chez le coiffeur."
                                            },
                                            {
                                                "example_id": "c93511d9-9f49-4e73-a984-25c0de2d1f41",
                                                "sense_id": "b6b71dbe-1fcd-3442-9c8f-012cf982ed79",
                                                "text": "À l’occasion du Salon de l’agriculture, temple éphémère du bien-manger, nos conseils pour bien petit-déjeuner."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "petit-déjeuner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08ef9b89-6cd3-3efc-884b-1d3799a68208",
                                        "entry_id": "91a1c8f4-09f2-3b29-9d20-02724e3da979",
                                        "glosses": [
                                            "Variante orthographique de petit déjeuner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe307e61-8160-4937-9936-1315861d2e2e",
                                                "sense_id": "08ef9b89-6cd3-3efc-884b-1d3799a68208",
                                                "text": "Et il se rappela douloureusement avoir entendu Mᵐᵉ Kroner prévenir que le petit-déjeuner serait servi tôt ce matin-là à cause du service religieux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
