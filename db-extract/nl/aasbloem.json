                        "glosses": [
                            "benaming voor diverse stinkende planten zoals de stinkende kamille Anthemis cotula"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb23a116-48fb-4ffa-bc11-5f46d011e731",
                                "sense_id": "cdca9d7f-1408-34ba-b19c-4ab95ee910c1",
                                "text": "„Wat zo leuk is aan deze plant: hij stinkt. En behoorlijk ook. Het is een aasbloem, dus hij trekt met zijn vieze geur allerlei vliegen aan, die weer voor bestuiving zorgen. Gelukkig is het alleen de bloem die stinkt, en die bloeit maar een week. Zodra die afsterft, groeit het blad. En dan merk je niets meer van die stank.”"
                            }
                        ]
                    }
