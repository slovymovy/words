                            {
                                "example_id": "17ac4516-bf6d-42c3-8d33-2aabbcdd9c5d",
                                "sense_id": "8041f72e-56d5-3777-9cf7-df8ddc0b519b",
                                "text": "Verhit wat olie in een ruime pan en bak de bosui, spekreepjes en gekookte linzen. Laat alles 5 minuten stoven en breng op smaak met zout en peper en de balsamicoazijn."
                            },
                            {
                                "example_id": "a92ef4be-c01b-4ff2-81b0-2ac733ff7a7e",
                                "sense_id": "8041f72e-56d5-3777-9cf7-df8ddc0b519b",
                                "text": "Borstel de champignons schoon. Verwijder indien nodig de onderkant van de steeltjes. Snij de champignons in vieren. Verhit 2 el boter in een hapjespan en bak hierin de champignons samen met de uitjes en de spekreepjes gaar."
                            }
