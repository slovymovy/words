{
    "word_family": [
        "stutterer",
        "stuttering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3a59a56b-1982-3c63-b797-a9f81f1eb911",
                    "sense_definition": "To speak with involuntary pauses or repetitions of sounds, often due to nervousness or a speech disorder.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>stuttered</w> a few words of thanks when he received the award.",
                            "target_lang_translations": {
                                "ru": "Он <w>прозаикался</w> несколько слов благодарности, когда получал награду."
                            }
                        },
                        {
                            "text": "The nervous boy began to <w>stutter</w> when the teacher asked him a question.",
                            "target_lang_translations": {
                                "ru": "Нервный мальчик начал <w>заикаться</w>, когда учитель задал ему вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "stammer"
                    ],
                    "common_phrases": [
                        "stutter nervously",
                        "begin to stutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с непроизвольными паузами или повторениями звуков, часто из-за нервозности или дефекта речи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заикаться",
                                "target_lang_sense_clarification": "о речи"
                            },
                            {
                                "target_lang_word": "запинаться",
                                "target_lang_sense_clarification": "прерываться при разговоре"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64d493c1-1d63-30f1-becd-29f53f283b9d",
                    "sense_definition": "To move or make a series of short, irregular sounds or movements, like an engine failing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mechanical_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engine of the old car <w>stuttered</w> going up the steep slope.",
                            "target_lang_translations": {
                                "ru": "Двигатель старой машины <w>работал с перебоями</w>, когда она поднималась по крутому склону."
                            }
                        },
                        {
                            "text": "The old tractor started to <w>stutter</w> before it finally stopped working.",
                            "target_lang_translations": {
                                "ru": "Старый трактор начал <w>чихать</w>, прежде чем окончательно заглох."
                            }
                        }
                    ],
                    "common_phrases": [
                        "engine started to stutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или издавать серию коротких, прерывистых звуков, подобно неисправному двигателю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работать с перебоями",
                                "target_lang_sense_clarification": "о механизме"
                            },
                            {
                                "target_lang_word": "чихать",
                                "target_lang_sense_clarification": "о звуке мотора"
                            },
                            {
                                "target_lang_word": "дергаться",
                                "target_lang_sense_clarification": "о прерывистом движении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c674f67-4b00-3089-a61b-9486302afc28",
                    "sense_definition": "A speech disorder or an instance of speaking with spasmodic repetitions or pauses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a slight <w>stutter</w> that becomes more noticeable when he is tired.",
                            "target_lang_translations": {
                                "ru": "У него легкое <w>заикание</w>, которое становится заметнее, когда он устает."
                            }
                        },
                        {
                            "text": "The actor worked with a therapist to overcome his childhood <w>stutter</w>.",
                            "target_lang_translations": {
                                "ru": "Актер работал с терапевтом, чтобы преодолеть свое детское <w>заикание</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stammer"
                    ],
                    "common_phrases": [
                        "slight stutter",
                        "noticeable stutter",
                        "childhood stutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение речи или случай произнесения слов со спазматическими повторениями или паузами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заикание",
                                "target_lang_sense_clarification": "дефект речи"
                            },
                            {
                                "target_lang_word": "запинка",
                                "target_lang_sense_clarification": "кратковременная пауза в речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4405db58-d9d4-39f2-93bb-5e5e0a81ff34",
                    "sense_definition": "A person who has a <w>stutter</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old text, it was noted that many <w>stutters</w> were considered to have a quick temper.",
                            "target_lang_translations": {
                                "ru": "В старом тексте отмечалось, что многие <w>заики</w> считались вспыльчивыми людьми."
                            }
                        },
                        {
                            "text": "The historical document describes how <w>stutters</w> were treated in the seventeenth century.",
                            "target_lang_translations": {
                                "ru": "В историческом документе описывается, как лечили <w>заик</w> в семнадцатом веке."
                            }
                        }
                    ],
                    "synonyms": [
                        "stutterer",
                        "stammerer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used to refer to a person with the condition"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который страдает заиканием (устаревшее употребление существительного)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заика",
                                "target_lang_sense_clarification": "человек с дефектом речи"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}