                        "source_sense_id": "e8976da0-1495-37b8-94cf-9d6cae7b8d1e",
                        "target_lang_word": "Françoise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Françoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6e3acb-4335-3343-a716-3307476b1909",
                                        "entry_id": "6aeed8b6-90d8-35a5-b303-308971a4199d",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e60fbfa6-f442-4301-99b6-7a23df1b0607",
                                                "sense_id": "ae6e3acb-4335-3343-a716-3307476b1909",
                                                "text": "La guide, Maëlle Françoise, accueille les visiteurs, et leur fait découvrir les œuvres de l’artiste et le patrimoine de la chapelle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Françoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                        "entry_id": "560b0acf-722b-3b6f-9da8-fb02c4e73570",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d67fd7-d3ca-402f-aa7e-504b00293896",
                                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                                "text": "Chez Françoise Sutton, baronne Dudley, huitième pairesse du banc des barons, le thé était servi par un babouin vêtu de brocart d’or que lady Dudley appelait « mon nègre »."
                                            },
                                            {
                                                "example_id": "8380a633-dba5-4b5f-abac-0e77440261e4",
                                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                                "text": "— C’est une jeune fille de Saint-Claude. Tu ne la connais pas. Bien entendu. Elle s’appelle Françoise… Françoise Jacquier… C’est un nom bien connu dans le pays."
                                            },
                                            {
                                                "example_id": "4f8bed20-4e5b-40b8-9824-f6d6c2be27a9",
                                                "sense_id": "6708890b-bc0d-31ab-964f-21ccd72fcbfa",
                                                "text": "Elle s’appelait « Françoise »\nMais on l’appelait « Framboise »\nUne idée de l’adjudant\nQui en avait très peu pourtant\nDes idées."
                                            }
                                        ]
                                    }
                                ]
