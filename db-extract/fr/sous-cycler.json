                ],
                "senses": [
                    {
                        "sense_id": "ba4edf47-958b-315d-8ad7-fd71576268c7",
                        "entry_id": "65446bce-5dfc-3d3f-af12-2a054f4e9cb3",
                        "glosses": [
                            "Recycler, en obtenant une valeur plus faible que ce qu’on a recyclé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bd77b4c9-3566-494c-8eed-40c5c4af5059",
                                "sense_id": "ba4edf47-958b-315d-8ad7-fd71576268c7",
                                "text": "Ne pas sous-cycler, prévenir la toxicité, faire mieux avec moins."
                            },
                            {
                                "example_id": "3d7bffb1-011a-4158-96f7-558239c5cad4",
                                "sense_id": "ba4edf47-958b-315d-8ad7-fd71576268c7",
                                "text": "Intégrer progressivement la notion de upcyclage (créer de la valeur à chaque usage et non sous-cycler)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c15b052-1fc2-494f-896f-60ce6517c3e5",
                        "source_entry_id": "65446bce-5dfc-3d3f-af12-2a054f4e9cb3",
                        "source_sense_id": "ba4edf47-958b-315d-8ad7-fd71576268c7",
                        "target_lang_word": "downcycle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa94e1d-28b3-368c-9235-5b15709374d8",
                                        "entry_id": "9ffe9015-ef45-3645-af3c-b084059a86a2",
                                        "glosses": [
                                            "To convert (waste materials, etc.) into new materials or products of lower quality and reduced functionality."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08a67a7-1e66-4994-b90e-7b995971555d",
                                                "sense_id": "6aa94e1d-28b3-368c-9235-5b15709374d8",
                                                "text": "Nike set up a \"Reuse-a-Shoe\" program to \"downcycle\" old sneakers. The outsole rubber and midsole foam from used shoes are converted into surface material for running tracks and other athletic facilities and playgrounds. The fabric from the shoe uppers becomes padding under carpets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downcycle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c6cb09c-70a7-31d6-beef-4bae328a8a53",
                                        "entry_id": "c472ebe3-c725-346d-81fb-ad500253bc27",
                                        "glosses": [
                                            "A period of a cycle where something is decreasing or deteriorating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af41691-c72c-4fdf-93a8-f7d709098ca5",
                                                "sense_id": "8c6cb09c-70a7-31d6-beef-4bae328a8a53",
                                                "text": "Because commodity industries, including energy, are driven by costs, a pricing down-cycle brings major cost cutting efforts, often involving restructurings and consolidations to increase economies of scale."
                                            },
                                            {
                                                "example_id": "52492d10-994d-4792-9184-6a580681a601",
                                                "sense_id": "8c6cb09c-70a7-31d6-beef-4bae328a8a53",
                                                "text": "It is precisely these logical anomalies, paradoxes and problems, which create Samsara's wheel of eternal repeating up-cycles which is followed by eternal repeating down-cycles and vice versa (for example life and death, success and fiasco, joy and sorrow) – as well as the ignorance and suffering when you are caught into this wheel, for example in the experience of nightmare and anxiety."
                                            },
                                            {
                                                "example_id": "e7d89ddc-dccb-4bbf-91da-cbf4b3376110",
                                                "sense_id": "8c6cb09c-70a7-31d6-beef-4bae328a8a53",
                                                "text": "[M]ost experts agree that a downcycle is in progress and are expecting demand from emerging countries and regions such as India, South-East Asia and even Africa, to eventually rebound to the point where it once again outstrips supply."
                                            },
                                            {
                                                "example_id": "5e6ada69-4409-49a2-9e6c-888b940c4060",
                                                "sense_id": "8c6cb09c-70a7-31d6-beef-4bae328a8a53",
                                                "text": "Again, the current down cycle is anomalous, with the Fed's monetary policies encouraging unusually high levels of stock buybacks and fruitless mergers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
