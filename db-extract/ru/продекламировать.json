                                    {
                                        "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                        "entry_id": "bf674bac-02ac-3dc5-827a-0d3b0fd56d57",
                                        "glosses": [
                                            "To repeat aloud (some passage, poem or other text previously memorized, or in front of one's eyes), often before an audience."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94963a8b-28e8-489c-934c-0c9919743b21",
                                                "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                                "text": "Janice is able to recite pi to 100 decimals."
                                            },
                                            {
                                                "example_id": "25889418-1afe-47e1-a802-9a634f970af7",
                                                "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                                "text": "\"I feel the seat. I feel the seat against my arm. I feel my hands,\" recites Edmonds, her eyes still closed."
                                            },
                                            {
                                                "example_id": "5101c3f1-58dd-4591-b204-6f30fa6a31fc",
                                                "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                                "text": "It’s recited in schools across the US every day by students standing stiffly with their hands over their hearts."
                                            },
                                            {
                                                "example_id": "88de79d1-afcc-4c49-979b-42083b997ac5",
                                                "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                                "text": "Services during Yom Kippur are held continuously through the day and include readings from the Torah and the reciting of prayers expressing regret or asking for forgiveness."
                                            },
                                            {
                                                "example_id": "8b6ee278-325c-4231-b5f4-f15c7f8094f4",
                                                "sense_id": "6058b093-bcae-3ad6-93af-00f6f63193b0",
                                                "text": "Amanda Gorman, the nation’s first-ever youth poet laureate who gained national acclaim at President Joe Biden’s inauguration, will recite an original poem before Super Bowl LV, NFL Commissioner Roger Goodell announced on Wednesday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1094b9ed-ce08-3a3e-9794-555b069eb620",
                                        "entry_id": "bf674bac-02ac-3dc5-827a-0d3b0fd56d57",
                                        "glosses": [
                                            "To list or enumerate something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
