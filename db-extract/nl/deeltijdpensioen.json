                        "examples": [
                            {
                                "example_id": "d5a1933f-e906-4311-800e-da20cf3d064c",
                                "sense_id": "92fac0fb-8450-342e-aabf-608530793aa9",
                                "text": "Deeltijdpensioen fiscaal gunstiger: Mensen die met vervroegd pensioen willen maar daarnaast ook willen blijven werken, worden in de toekomst niet meer fiscaal belast over het pensioendeel. Dat heeft staatssecretaris Weekers van Financiën bekendgemaakt."
                            },
                            {
                                "example_id": "fa31da16-3916-4fcf-a341-f4df5a68368b",
                                "sense_id": "92fac0fb-8450-342e-aabf-608530793aa9",
                                "text": "Het geld dat werknemers hiermee kunnen sparen, is bedoeld als aanvulling op het inkomen en is bijvoorbeeld vrij opneembaar bij het verlenen van zorg, het opnemen van deeltijdpensioen of voor scholing. Er kan in deze regeling maximaal 20.000 euro fiscaal aantrekkelijk worden gespaard en er geldt een maximuminleg van 5000 euro."
                            }
                        ]
                    }
