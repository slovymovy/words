{
    "word_family": [
        "świdrować",
        "świdrowy",
        "świderek"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5cfe933e-e232-3118-9783-9115f8a90437",
                    "sense_definition": "Narzędzie służące do wykonywania otworów w różnych materiałach.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "narzędzia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fachowiec użył <w>świdra</w>, aby wywiercić otwór w twardej ścianie.",
                            "target_lang_translations": {
                                "ru": "Мастер использовал <w>бур</w>, чтобы просверлить отверстие в твердой стене."
                            }
                        },
                        {
                            "text": "Muszę kupić nowy <w>świder</w>, bo stary już się stępił.",
                            "target_lang_translations": {
                                "ru": "Мне нужно купить новое <w>сверло</w>, потому что старое уже затупилось."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiertło"
                    ],
                    "common_phrases": [
                        "ręczny świder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент для проделывания отверстий в различных материалах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сверло",
                                "target_lang_sense_clarification": "основной инструмент для сверления отверстий"
                            },
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "инструмент для сверления твердых материалов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5946398b-9c76-3641-b60a-dc9e7e4c8a14",
                    "sense_definition": "Tradycyjne narzędzie stolarskie do ręcznego wiercenia otworów w drewnie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "narzędzia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stolarz wziął do ręki <w>świder</w> i zaczął powoli wiercić otwór w desce.",
                            "target_lang_translations": {
                                "ru": "Столяр взял в руки <w>бурав</w> и начал медленно сверлить отверстие в доске."
                            }
                        },
                        {
                            "text": "Dawniej każdy cieśla posiadał własny <w>świder</w> do pracy w drewnie.",
                            "target_lang_translations": {
                                "ru": "Раньше у каждого плотника был свой <w>бурав</w> для работы по дереву."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Традиционный столярный инструмент для ручного сверления отверстий в дереве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бурав",
                                "target_lang_sense_clarification": "ручной инструмент для сверления дерева"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "527d0658-6372-3000-ab1a-ffe4b113692a",
                    "sense_definition": "Potoczne określenie zezowatych lub bardzo wnikliwie patrzących oczu.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wygląd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Patrzył na mnie swoimi <w>świdrami</w>, jakby chciał przejrzeć moje myśli.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на меня своими <w>буравчиками</w>, словно хотел прочитать мои мысли."
                            }
                        },
                        {
                            "text": "Znowu wywrócił <w>świdry</w> w moją stronę, gdy tylko wszedłem do pokoju.",
                            "target_lang_translations": {
                                "ru": "Он снова уставился на меня своими <w>буравчиками</w>, как только я вошел в комнату."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Używane w mowie potocznej."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное обозначение косящихся или очень пристально смотрящих глаз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буравчики",
                                "target_lang_sense_clarification": "переносное значение: о пронзительном взгляде"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9639c30-cdd9-372d-bf9b-8efa43c7870d",
                    "sense_definition": "Maszyna lub urządzenie przeznaczone do wiercenia głębokich otworów w twardym podłożu, np. w skale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "narzędzia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Górnicy użyli potężnego <w>świdra</w>, aby przebić się przez warstwę granitu.",
                            "target_lang_translations": {
                                "ru": "Шахтеры использовали мощный <w>бур</w>, чтобы пробиться сквозь слой гранита."
                            }
                        },
                        {
                            "text": "Ten nowoczesny <w>świder</w> pozwala na wiercenie w najtwardszych skałach.",
                            "target_lang_translations": {
                                "ru": "Этот современный <w>бур</w> позволяет сверлить самые твердые породы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geologiczny świder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Машина или устройство для бурения глубоких отверстий в твердом грунте, например, в скале."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бур",
                                "target_lang_sense_clarification": "инструмент для бурения скважин"
                            },
                            {
                                "target_lang_word": "буровая установка",
                                "target_lang_sense_clarification": "машина для бурения"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "fbeea2b0-df7c-38c4-98e0-853055f8b602",
                    "sense_definition": "Polskie nazwisko męskie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Świder</w> jest naszym nowym sąsiadem z trzeciego piętra.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Свидер</w> — наш новый сосед с третьего этажа."
                            }
                        },
                        {
                            "text": "Rozmawiałem dzisiaj z doktorem <w>Świdrem</w> o wynikach badań.",
                            "target_lang_translations": {
                                "ru": "Я разговаривал сегодня с доктором <w>Свидером</w> о результатах анализов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Nazwisko."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская мужская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6eb89692-a06b-366a-b37b-d645628b21a8",
                    "sense_definition": "Polskie nazwisko żeńskie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pani <w>Świder</w> prowadzi zajęcia z matematyki w naszej szkole.",
                            "target_lang_translations": {
                                "ru": "Госпожа <w>Свидер</w> ведет занятия по математике в нашей школе."
                            }
                        },
                        {
                            "text": "Spotkałem wczoraj panią <w>Świder</w> w pobliskim parku.",
                            "target_lang_translations": {
                                "ru": "Я встретил вчера госпожу <w>Свидер</w> в ближайшем парке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Nazwisko."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Польская женская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидер",
                                "target_lang_sense_clarification": "фамилия (несклоняемая для женщин)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b83d607a-c052-357b-a406-35f8c49a6460",
                    "sense_definition": "Rzeka w Polsce, prawobrzeżny dopływ Wisły.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografia",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "W upalne dni wielu mieszkańców Warszawy wypoczywa nad rzeką <w>Świder</w>.",
                            "target_lang_translations": {
                                "ru": "В жаркие дни многие жители Варшавы отдыхают на реке <w>Свидер</w>."
                            }
                        },
                        {
                            "text": "Kajakarze często wybierają <w>Świder</w> na swoją weekendową wycieczkę.",
                            "target_lang_translations": {
                                "ru": "Байдарочники часто выбирают <w>Свидер</w> для своей поездки на выходные."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в Польше, правый приток Вислы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидер",
                                "target_lang_sense_clarification": "географическое название (река)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81978af1-729a-3ece-8b9f-47bc163586a8",
                    "sense_definition": "Dzielnica Otwocka, dawniej miejscowość letniskowa.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geografia",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Wiele zabytkowych willi znajduje się w dzielnicy <w>Świder</w>.",
                            "target_lang_translations": {
                                "ru": "Много исторических вилл находится в районе <w>Свидер</w>."
                            }
                        },
                        {
                            "text": "Dojechałem pociągiem do stacji <w>Świder</w> w Otwocku.",
                            "target_lang_translations": {
                                "ru": "Я доехал на поезде до станции <w>Свидер</w> в Отвоцке."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Район города Отвоцк, бывший курортный поселок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидер",
                                "target_lang_sense_clarification": "географическое название (район)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abef7f0c-b3d8-33d9-9b98-010364f18076",
                    "sense_definition": "Wieś w Polsce, w województwie lubelskim.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geografia",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Mała wieś <w>Świder</w> leży w gminie Wola Mysłowska.",
                            "target_lang_translations": {
                                "ru": "Маленькая деревня <w>Свидер</w> находится в гмине Воля-Мысловска."
                            }
                        },
                        {
                            "text": "Podróżując przez województwo lubelskie, przejeżdżaliśmy przez miejscowość <w>Świder</w>.",
                            "target_lang_translations": {
                                "ru": "Путешествуя по Люблинскому воеводству, мы проезжали через населенный пункт <w>Свидер</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деревня в Польше, в Люблинском воеводстве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Свидер",
                                "target_lang_sense_clarification": "географическое название (деревня)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}