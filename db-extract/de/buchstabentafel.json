                "translations": [
                    {
                        "translation_id": "e840f545-544d-44ab-8df7-d15d84b0e152",
                        "source_entry_id": "15d27641-a1dc-3f82-8d1c-535e44027750",
                        "source_sense_id": "e58c70a9-1c89-30f9-aa01-28804e9702a1",
                        "source_sense_description": "Tafel, auf der das Alphabet steht, und die früher als Lernhilfe für Kinder benutzt wurde",
                        "target_lang_word": "hornbook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hornbook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                        "entry_id": "dd05813a-e078-394e-97e6-d313786f7124",
                                        "glosses": [
                                            "A single page containing the alphabet, covered with a sheet of transparent horn, formerly used for teaching children to read."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d78bbd-f222-41ae-a403-9cec023c7528",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "Yes, yes, he teaches boyes the Horne-Booke: […]"
                                            },
                                            {
                                                "example_id": "f799188f-eb82-4441-9c5c-b80d61238991",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "HO′RNBOOK. n.ʃ. [horn and book] The firſt book of children, covered vvith horn to keep it unſoiled."
                                            },
                                            {
                                                "example_id": "e4919555-4c7f-42b4-a71a-0edb40804951",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "By way of the hornbook Shakespeare would have learned to read, […]"
                                            },
                                            {
                                                "example_id": "7acd436c-d8d5-4a05-8c8d-7db841a58d3e",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "Infants learned their letters from a hornbook, a square of wood shaped like a table-tennis bat on which were pasted the alphabet, syllables and the Lord's Prayer […]"
                                            },
                                            {
                                                "example_id": "9806bfc8-4228-408e-85a3-03460622ed35",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "The hornbook is the first piece of instructional material specifically mentioned in American records."
                                            },
                                            {
                                                "example_id": "5cb540eb-3cd9-435a-9759-8f80ed881169",
                                                "sense_id": "3afa0046-7483-364d-9389-513c7ed2005f",
                                                "text": "Not only is it difficult to extract just the right doozy of an adjective out of the hornbook, but the maneuver can be performed at most twice in the course of an article or chapter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "535b217d-2e02-31db-ac2c-03888ba60519",
                                        "entry_id": "dd05813a-e078-394e-97e6-d313786f7124",
                                        "glosses": [
                                            "A legal textbook that provides a basic overview of a particular area of law."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8180b72b-8997-4b82-a7dc-53cbf9e84935",
