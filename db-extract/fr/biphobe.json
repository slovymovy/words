                ],
                "senses": [
                    {
                        "sense_id": "7df9af63-1cda-37c4-9f87-3c6a859d4dc9",
                        "entry_id": "e37aa465-6754-3cef-b297-5ebfd356fd75",
                        "glosses": [
                            "Relatif à de l’aversion pour la bisexualité ou une attitude hostile à l’encontre des bisexuels."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42e928c6-6bc5-40fb-b87a-54aa2aa52f5d",
                        "source_entry_id": "e37aa465-6754-3cef-b297-5ebfd356fd75",
                        "source_sense_id": "7df9af63-1cda-37c4-9f87-3c6a859d4dc9",
                        "target_lang_word": "biphob",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biphob",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                        "entry_id": "fd39a6e1-5dd9-3bd9-afa2-bbb33ced6d9f",
                                        "glosses": [
                                            "Ablehnung gegenüber Bisexualität empfindend"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22853af1-bfa6-4c0a-9a4e-7f5f4f46470c",
                                                "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                                "text": "„Die hegemoniale Konstruktion von Bisexualität als essenziell nicht-monogam betrifft Bisexuelle auf vielfältige Weise. Sie ist ein zentraler Bestandteil anti-bisexueller oder biphober Vorurteile.“"
                                            },
                                            {
                                                "example_id": "cf280c5f-9ed8-4c5b-9841-227dc47d082b",
                                                "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                                "text": "„Du darfst dich in mein Leben einmischen, aber ich darf deinen Freund nicht in die Schranken weisen, wenn er sich wie ein biphober Arsch benimmt?“"
                                            },
                                            {
                                                "example_id": "77c0cb29-b953-42a5-be70-d17467558f5c",
                                                "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                                "text": "„Als Kala sich in der Arbeit outet, um ihrem biphoben Mitarbeiter eins auszuwischen, braucht sie plötzlich ein falsches Date für die Weihnachtsfeier.“"
                                            },
                                            {
                                                "example_id": "2b2258fd-a8a3-4fb8-843b-b6939f38f77f",
                                                "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                                "text": "„Auch neuere Veröffentlichungen zum Thema insbesondere im deutschsprachigen Raum sehen sich vorrangig der Aufklärung über die Lebensrealität bisexueller Menschen und der Widerlegung von biphoben Vorurteilen verpflichtet.“"
                                            },
                                            {
                                                "example_id": "62bd500f-e431-4af2-909e-be4c619d272c",
                                                "sense_id": "2d327c9c-39ec-3e9f-8e05-07d1a0660a67",
                                                "text": "„Wie sonst sind beispielsweise die Forderungen von autonomen Zentren, Clubs, Wohnprojekten oder künstlerischen Plattformen zu verstehen, der von ihnen bereitgestellte Raum des Experiments stehe nur denjenigen zur Verfügung, die aus einer rassistischen, sexistischen, antisemitischen, kapitalistischen homo-, trans- und biphoben Gegenwart und Vergangenheit hinreichende Schlüsse gezogen haben […]?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "116df0b2-a115-48ef-a56e-e7d65e7c91ba",
                        "source_entry_id": "e37aa465-6754-3cef-b297-5ebfd356fd75",
                        "source_sense_id": "7df9af63-1cda-37c4-9f87-3c6a859d4dc9",
                        "target_lang_word": "bifeindlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bifeindlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                        "entry_id": "d2e17b4a-f0e2-34aa-af0d-1c8d1d3b3193",
                                        "glosses": [
                                            "Ablehnung gegenüber Bisexualität empfindend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a964af0-66d7-49d7-9490-3598904a2e28",
                                                "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                                "text": "„Ein Mensch kann queer sein und trotzdem intolerant, das Label allein macht keinen Menschen toleranter oder zum Beispiel weniger trans*- [sic] oder bifeindlich.“"
                                            },
                                            {
                                                "example_id": "236a88fb-fd28-4399-8ec8-f4b541dc3f6d",
                                                "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                                "text": "„Sexistisches, homofeindliches, bifeindliches, trans*feindliches [sic], inter*feindliches [sic], rassistisches, mackeriges, … Verhalten hat hier keinen Platz!“"
                                            },
                                            {
                                                "example_id": "2dd1637b-cf74-45ed-aed6-38246c7c0382",
                                                "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                                "text": "„Es ist auch möglich, bifeindlich zu sein, ohne jedoch homophob zu sein.“"
                                            },
                                            {
                                                "example_id": "85a7c9ff-d42b-4f08-8b7b-892c0bf24cb9",
                                                "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                                "text": "„Wenn die diskriminierende Äußerung unkommentiert stehen gelassen oder positiv bestärkt wird, können Sie sich in das Gespräch einschalten, auch wenn Sie die beiden Personen an der Theke nicht kennen. Erklären Sie ihnen, was an der Aussage bifeindlich ist.“"
                                            },
                                            {
                                                "example_id": "941ae3c4-bbae-4c5c-bbc2-b6109d43b8ed",
                                                "sense_id": "9f8c620c-831a-3449-9088-984753dc5282",
                                                "text": "„Sobald Religion fundamentalistisch ist, ist diese oftmals homofeindlich, bifeindlich und transfeindlich. “"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e7f3bcc-e820-4965-8edd-9a297fa4570d",
