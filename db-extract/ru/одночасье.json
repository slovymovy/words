                ],
                "translations": [
                    {
                        "translation_id": "990b18dc-6f3b-4cfb-ad53-f05c3518bb38",
                        "source_entry_id": "b66e3ddf-231b-39dc-a644-3e27eba8a67c",
                        "source_sense_description": "промежуток времени в один час",
                        "target_lang_word": "une heure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3dd68ca9-0fc5-4652-837a-d9945442e8bc",
                        "source_entry_id": "b66e3ddf-231b-39dc-a644-3e27eba8a67c",
                        "source_sense_description": "очень короткий промежуток времени",
                        "target_lang_word": "instant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "392c8b2a-f189-37c9-8000-1beaff793ccc",
                                        "entry_id": "7c72bf89-2216-3c48-ab9d-228c54159fd4",
                                        "glosses": [
                                            "Qui est pressant."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de90b56e-3c5d-4c04-9e28-8e527421d8aa",
                                                "sense_id": "392c8b2a-f189-37c9-8000-1beaff793ccc",
                                                "text": "il n’allégua d’autres excuses de ce manque de foi que la nécessité de déférer aux sollicitations vives et instantes des commissaires de la convention."
                                            },
                                            {
                                                "example_id": "8f813b5b-4858-4216-a8c5-a7b081b38cb4",
                                                "sense_id": "392c8b2a-f189-37c9-8000-1beaff793ccc",
                                                "text": "[…] Rébecca, à son instante prière, s’était de nouveau placée à la fenêtre pour suivre et lui raconter le résultat de l’attaque."
                                            },
                                            {
                                                "example_id": "946b8cb7-9723-4e35-93c1-77de676aa810",
                                                "sense_id": "392c8b2a-f189-37c9-8000-1beaff793ccc",
                                                "text": "Un soir, un seul soir, devant la prière peut-être plus instante de mon regard, elle se départit de son mutisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d381e45-813f-372a-b372-f12b64bd4e17",
                                        "entry_id": "7c72bf89-2216-3c48-ab9d-228c54159fd4",
                                        "glosses": [
                                            "Qui est imminent, urgent."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c5ecea0-1385-41f2-a6ae-11ad1834d5f2",
                                                "sense_id": "8d381e45-813f-372a-b372-f12b64bd4e17",
                                                "text": "[…] elles prennent acte, si on peut parler ainsi, de l’aveu que font les inoculateurs, qu’on peut mourir de la petite vérole artificielle ; elles voient l’inoculation comme un péril instant et prochain de perdre la vie en un mois, et la petite vérole comme un danger incertain."
                                            },
                                            {
                                                "example_id": "189e68bc-93eb-45d7-8104-696c602e5994",
                                                "sense_id": "8d381e45-813f-372a-b372-f12b64bd4e17",
                                                "text": "Le danger était instant ; il n’y avait aucune pitié à attendre de pareils ennemis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0000a62-2009-3f8e-905b-2364a5387153",
                                        "entry_id": "a0920089-777c-3bd0-89e4-e9fd8fe12791",
                                        "glosses": [
                                            "Instantanément."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "instant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "888cf5b7-9699-39f4-a47d-ecb5694f2847",
                                        "entry_id": "f4108ff8-5c21-321b-82bf-9cbb1e38a7a1",
                                        "glosses": [
                                            "Durée très brève, voire infinitésimale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "213c0baf-6d02-43a8-addd-5acda25d3d15",
                                                "sense_id": "888cf5b7-9699-39f4-a47d-ecb5694f2847",
                                                "text": "Dans la catégorie moto, la lutte a fait rage jusqu’aux derniers instants, mais c’est l’Argentin Kevin Benavides qui a coiffé au poteau l’Australien Toby Price, de quarante-cinq secondes, après plus de 8 000 km de course dans le désert saoudien."
                                            },
                                            {
                                                "example_id": "ac59310e-c94b-4774-872c-54fbf989aeb7",
                                                "sense_id": "888cf5b7-9699-39f4-a47d-ecb5694f2847",
                                                "text": "Caderousse resta un instant étourdi sous le poids de cette supposition.\n— Oh ! dit-il au bout d'un instant et en prenant son chapeau qu’il posa sur le mouchoir rouge noué autour de sa tête, nous allons bien le savoir."
                                            },
                                            {
                                                "example_id": "13cb96de-e085-444d-853f-282a16c976d0",
                                                "sense_id": "888cf5b7-9699-39f4-a47d-ecb5694f2847",
                                                "text": "Quelques instants après, comme on passait au salon, elle s’approcha de moi et me dit dans un éclair irrité : « Oh ! vous l’aimez bien !"
                                            },
                                            {
                                                "example_id": "f3943280-c490-458a-8a00-cb5aa1c21169",
                                                "sense_id": "888cf5b7-9699-39f4-a47d-ecb5694f2847",
                                                "text": "Les prairies, émaillées de saxifrages, sont clôturées de murs en pierres sèches qu'il nous faut franchir à tout instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e39e102-8fd1-32b9-bf73-8fcddcd273b2",
                                        "entry_id": "f4108ff8-5c21-321b-82bf-9cbb1e38a7a1",
                                        "glosses": [
                                            "Point précis, moment exact ou défini, dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1a3d9f-de6f-448a-bd41-c28396fb11bb",
                                                "sense_id": "9e39e102-8fd1-32b9-bf73-8fcddcd273b2",
                                                "text": "Quelque doux qu’il me soit d’habiter cette maison, je l’ai résolu, je le jure, si je m’aperçois jamais que je m’y plais trop, j’en sortirai dans l’instant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
