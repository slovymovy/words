                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Полиция давно следила за этим старым <крестом>.",
                            "target_lang_translations": {
