                                            {
                                                "example_id": "adabf003-98af-4562-898a-4fb9f8a5146a",
                                                "sense_id": "97852f07-963e-3482-859a-25d06cac8bed",
                                                "text": "Le qat est un arbuste originaire d'Afrique orientale et australe, importé au Yémen au XIVᵉ siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76143453-b090-3f02-8763-bae30ee7a09b",
                                        "entry_id": "07bdef54-84a4-3baf-bf43-9c747bbd7638",
                                        "glosses": [
                                            "Feuilles de cet arbuste, mâchées pour leur effet stimulant et euphorisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a668ac96-9140-40fc-947e-5f33e1def16e",
                                                "sense_id": "76143453-b090-3f02-8763-bae30ee7a09b",
                                                "text": "Même s'il est connu depuis longtemps la consommation du qat s'est développée depuis une vingtaine d'années après la révolution de 1962 au nord et depuis la réunification au sud."
                                            }
                                        ]
                                    }
                                ]
                            }
