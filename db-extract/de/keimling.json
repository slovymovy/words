                ],
                "senses": [
                    {
                        "sense_id": "a354ca4b-ce74-3a4d-9010-af0b4a2a9d79",
                        "entry_id": "05fae6b9-ddd0-3afe-a70c-85501d3db7fe",
                        "glosses": [
                            "Pflanze im frühesten Entwicklungsstadium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "658b1b3d-2cbd-4986-b641-34517074d330",
                                "sense_id": "a354ca4b-ce74-3a4d-9010-af0b4a2a9d79",
                                "text": "Bekommen die Keimlinge in der ersten Zeit zu wenig Licht, vergeilen sie, d.h. sie bilden unnatürlich lange Triebe mit großen Abständen zwischen den aufeinanderfolgenden Blättern aus."
                            },
                            {
                                "example_id": "7a6210c7-e3e6-488b-a79a-e67b14b67a82",
                                "sense_id": "a354ca4b-ce74-3a4d-9010-af0b4a2a9d79",
                                "text": "„Später wird aus dem Keimling ein Sämling.“"
                            },
                            {
                                "example_id": "a5e7e98f-eb09-46b5-b5b8-970b27178d05",
                                "sense_id": "a354ca4b-ce74-3a4d-9010-af0b4a2a9d79",
                                "text": "„Diesen Keimling lässt Wieland sich auswachsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b74f0e12-970c-3fef-98dd-6d8985f53e5c",
                        "entry_id": "05fae6b9-ddd0-3afe-a70c-85501d3db7fe",
                        "glosses": [
                            "ungeborenes Lebewesen, bei Mensch und Tier gleichermaßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7d9d2c-08c9-41b0-b1ff-35b12ae22f5f",
                                "sense_id": "b74f0e12-970c-3fef-98dd-6d8985f53e5c",
                                "text": "„Die echte Plazenta (Mutterkuchen) ist ein leistungsfähiges Austauschorgan zwischen Mutter und Keimling.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
