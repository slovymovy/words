                    },
                    {
                        "translation_id": "2482daf4-b3cd-44a7-8053-1c855c0ba5bc",
                        "source_entry_id": "12eb5003-01b9-3683-9c7f-4747e5705646",
                        "source_sense_description": "любитель",
                        "target_lang_word": "Liebhaber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Liebhaber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "Mann, mit dem jemand eine (außereheliche) sexuelle Beziehung führt"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "774e49c9-1f93-41f2-a93e-91038542db5e",
                                                "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                                "text": "Den Geräuschen nach zu urteilen, hat die Frau aus dem zweiten Stock schon wieder einen neuen Liebhaber."
                                            },
                                            {
                                                "example_id": "95993674-1b9e-4ec9-81e6-35ccce58706d",
                                                "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                                "text": "Frau Schmidt hat einen Liebhaber nach dem anderen."
                                            },
                                            {
                                                "example_id": "8b6467dd-bc02-4c4f-89d7-4619de8cfc61",
                                                "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                                "text": "Du solltest dir endlich einen Liebhaber zulegen."
                                            },
                                            {
                                                "example_id": "032d59ff-6ba9-4569-a37b-407c2b6a6f08",
                                                "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                                "text": "„Sowohl in der Vergangenheit als auch in der Gegenwart hatte Fanny einen Liebhaber.“"
                                            },
                                            {
                                                "example_id": "8aed90a7-0237-477e-bf0f-a32b63ce7a8e",
                                                "sense_id": "a71055c3-c554-3269-bcda-3dd66f1bc776",
                                                "text": "„In London kam sie mit Zwillingen nieder, die der Liebhaber der Mutter adoptierte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "Mann, der um die Gunst einer Frau buhlt, um sie wirbt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6b6dd81-7e45-42d8-9ccc-fb0f606b7b02",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "Aus Verzweiflung stürzte sich der verschmähte Liebhaber von den Klippen."
                                            },
                                            {
                                                "example_id": "69ffa129-972d-432c-8d2d-9a0b954cd8d7",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "Der Liebhaber der Baronesse spielt jede Nacht stundenlang vor ihrem Fenster auf der Laute."
                                            },
                                            {
                                                "example_id": "1bf00f55-913c-444a-9f6d-85340200e025",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "„Aus seinem ironischen Ton schloß sie, daß er annahm, sie wäre wohl mit einem anderen Mann, einem anderen Liebhaber verabredet.“"
                                            },
                                            {
                                                "example_id": "ed6687d5-0fd2-4ec5-8162-7be5f4035a8d",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "„Die Furcht, das Wunder zu versäumen, wird aus ihm einen unbeständigen Liebhaber machen, der sich in seinen eigenen Netzen fängt.“"
                                            },
                                            {
                                                "example_id": "619a5a3f-5590-492e-85d5-5b7f19e0ee29",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "„Aber am gleichen Tag, gerade als ich zu Mittag gegessen hatte, kam der arme untröstliche Liebhaber zu mir ins Zimmer.“"
                                            },
                                            {
                                                "example_id": "1f499744-2230-4ec2-ac98-07edd0fde2e0",
                                                "sense_id": "f5774e89-2fc3-3670-9341-2b138aa2e2fc",
                                                "text": "„Längst war ihm aufgefallen, daß niemals aus den offenen Fenstern eine lärmend verzerrte Radiomusik die Straßen überschwemmte, daß nirgendwo die quälende Monotonie klavierspielender Liebhaber zu vernehmen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "ein Mann in seiner Eigenschaft als Sexualpartner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22668f0a-cefc-4cf8-9dd6-bf2d76d3228b",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "Bertie ist ein grandioser Liebhaber."
                                            },
                                            {
                                                "example_id": "c5bf74c4-b6e4-43cd-be19-5a2cd99de9a8",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "Was du brauchst, ist ein erfahrener Liebhaber."
                                            },
                                            {
                                                "example_id": "92bd2e95-a95f-49e9-a020-365cb474a151",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "„Sie bewegt sich und schreit auf wie eine Frau von vierzig, die zum letzten Mal mit ihrem Liebhaber zusammen ist.“"
                                            },
                                            {
                                                "example_id": "32403276-7bfe-4c0f-8bf5-54a7c8cb6727",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "„Ich war ein seltsamer Liebhaber, die ganzen acht Wochen lang, in denen wir uns sahen.“"
                                            },
                                            {
                                                "example_id": "36972f37-68b4-423f-95c8-c01227b71148",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "„Das war ihm anfangs mehrmals passiert, und es hatte lange an seinem Selbstbild als Liebhaber gekratzt.“"
                                            },
                                            {
                                                "example_id": "58f0e3c7-1c0d-48e4-8120-b15bb8d1e1d0",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "„Diese Frau nun machte sich nach dem Krieg gleich wieder an ihren Liebhaber heran und unternahm so allerlei, um an dessen Kunstschätze zu gelangen.“"
                                            },
                                            {
                                                "example_id": "a0b7da16-4b1a-4800-a501-77265afda51e",
                                                "sense_id": "caf3c3e5-76b9-382d-a4dd-a4db08546036",
                                                "text": "„Wenn ich in dieser Zeit von einem Liebhaber träumte, spielte sich das Ganze immer in stockfinsteren Räumen ab, im Abteil eines Schlafwagens, nachts auf der Straße unter erloschenen Laternen, in einem finsteren Hauseingang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "503c5d52-84e7-37a1-b26f-4be21b6e184a",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "Rolle des werbenden und buhlenden Mannes"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42596d8b-761d-4d5b-924b-69c08ea7ba0e",
                                                "sense_id": "503c5d52-84e7-37a1-b26f-4be21b6e184a",
                                                "text": "John hat sich auf das Fach des Liebhabers spezialisiert."
                                            },
                                            {
                                                "example_id": "f2d956df-69f9-482b-8ce9-51398300990b",
                                                "sense_id": "503c5d52-84e7-37a1-b26f-4be21b6e184a",
                                                "text": "In dieser Schauspielertruppe gibt es einen unnachahmlichen Liebhaber."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "93a4a664-3b9c-3bda-b28a-14a6c5184327",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "Mann, der sich für etwas besonders begeistern kann, eine starke Vorliebe für etwas hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfd05bee-eaa3-4939-a1f4-9715e5d54aff",
                                                "sense_id": "93a4a664-3b9c-3bda-b28a-14a6c5184327",
                                                "text": "Man sieht Hanno deutlich an, dass er ein Liebhaber guten Essens ist."
                                            },
                                            {
                                                "example_id": "662f6a87-56dd-4c1f-9dd4-3d622d8105ab",
                                                "sense_id": "93a4a664-3b9c-3bda-b28a-14a6c5184327",
                                                "text": "Mein Schwiegervater ist ein Liebhaber der Tafelmusik."
                                            },
                                            {
                                                "example_id": "c78ea875-4d3e-414a-9d8c-1c6d6ff1da61",
                                                "sense_id": "93a4a664-3b9c-3bda-b28a-14a6c5184327",
                                                "text": "„Die Jerusalem-Sehnsucht hat zu allen Zeiten die unterschiedlichsten Liebhaber ergriffen.“"
                                            },
                                            {
                                                "example_id": "0b0a3465-1a32-42e6-b8bd-adb8593bdeb0",
                                                "sense_id": "93a4a664-3b9c-3bda-b28a-14a6c5184327",
                                                "text": "„Wie fast alle Liebhaber von Puppen und Hampelmännern fühlt er Kindern gegenüber eine große Indifferenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "c3181048-4126-3277-aa3a-86ee640169e6",
                                        "entry_id": "5842012e-a3e0-3182-9698-310af990d541",
                                        "glosses": [
                                            "Amateur"
                                        ],
                                        "tags": [],
                                        "examples": [
