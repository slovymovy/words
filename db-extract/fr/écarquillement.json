                        "examples": [
                            {
                                "example_id": "24928218-055f-4654-b66d-7c46b1205b24",
                                "sense_id": "6a79c690-89ea-3a22-904f-bd1962560960",
                                "text": "Evitez seulement de vouloir paraître écouter avec esprit : c’est une prétention qui produit un écarquillement d’yeux et cent mines ridicules qui attirent désagréablement l’attention."
                            },
                            {
                                "example_id": "eaa0e251-e843-4e63-9f86-647754d7161e",
                                "sense_id": "6a79c690-89ea-3a22-904f-bd1962560960",
                                "text": "Puis, tout debout dans le bureau de la normalienne, elle s’empare de la classe, d’un écarquillement de son humble visage, d’une offre de sa poitrine plate ; et là, aussitôt, elle se donne à ces enfants inconnus."
                            }
                        ]
                    }
