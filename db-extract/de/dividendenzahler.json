                "senses": [
                    {
                        "sense_id": "d139e144-dcf4-33b3-8b99-d7a5b4a58bd3",
                        "entry_id": "80233b69-9147-3bb2-a51e-67592e20a9e6",
                        "glosses": [
                            "Unternehmen, das eine Dividende an seine Anteilseigner ausschüttet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6896e9f-ee62-485a-aaed-f8fdd46760ce",
                                "sense_id": "d139e144-dcf4-33b3-8b99-d7a5b4a58bd3",
                                "text": "„Damit kann die OMV jene Kohle verdienen, die für den Umbau in ein möglichst CO2-neutrales Unternehmen nötig ist. Und sie kann der verlässliche Dividendenzahler bleiben, der sie in den vergangenen Jahren war.“"
                            },
                            {
                                "example_id": "f3fbf644-3a08-4370-bd34-89726e506a3d",
                                "sense_id": "d139e144-dcf4-33b3-8b99-d7a5b4a58bd3",
                                "text": "„Wenn der größte deutsche Dividendenzahler Mercedes-Benz im April seine Schatulle öffnet und die Anteilseigner am Gewinn beteiligt, dann klingeln die Kassen in Kuwait, Peking und Hongkong.“"
                            }
                        ],
