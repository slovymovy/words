                        "glosses": [
                            "Accomplir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c07dfbde-46bb-4750-9033-da7a95e51456",
                                "sense_id": "db27e7f9-37f7-3193-9845-182a701ad9a2",
                                "text": "Il est curieux surtout de voir cette lumière réaccomplir en elle la vertu d'onction, dont on connaît le rôle dans l'expérience proustienne des matières."
                            },
                            {
                                "example_id": "3e615bd2-2f29-4af3-9b15-9fbf648894fb",
                                "sense_id": "db27e7f9-37f7-3193-9845-182a701ad9a2",
                                "text": "Et comment peut-il, comme nous l'avons vu, réaccomplir la performance indésirable sans revenir à son statut initial de non-sujet ?"
                            }
                        ]
                    }
