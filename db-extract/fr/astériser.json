                "senses": [
                    {
                        "sense_id": "e8e83cb4-4841-3b0f-a65a-61e13086a765",
                        "entry_id": "1a5c4dc6-db96-3fc7-b8ae-0d78225170be",
                        "glosses": [
                            "Transformer en étoile(s)."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ba9518ab-17f5-497b-b82b-b5287d433fc8",
                                "sense_id": "e8e83cb4-4841-3b0f-a65a-61e13086a765",
                                "text": "Mais Poséidon eut pitié de leur chef qui l’avait honoré en offrandes et sacrifices et décida de l’astériser sous sa forme cétacée (Hygin)."
                            },
                            {
                                "example_id": "2411d1dd-6c85-4c46-b1ef-ec15ca86b9fe",
                                "sense_id": "e8e83cb4-4841-3b0f-a65a-61e13086a765",
                                "text": "Il fut astérisé en la constellation de ce nom par Zeus."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fa19506-6e13-34a1-b6c0-3c3fac238330",
                        "entry_id": "1a5c4dc6-db96-3fc7-b8ae-0d78225170be",
                        "glosses": [
                            "Doter d’une étoile ou d’un astérisque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb06513b-0c95-4620-8b1f-d30e576b3393",
                                "sense_id": "6fa19506-6e13-34a1-b6c0-3c3fac238330",
                                "text": "C'est sur cet ajout, astérisé dans le manuscrit, que porte la scholie."
                            },
                            {
                                "example_id": "611731ee-80dc-42df-be22-3a4e212db96d",
                                "sense_id": "6fa19506-6e13-34a1-b6c0-3c3fac238330",
                                "text": "J’ai \"astérisé\" volontairement quelques champs à remplir)."
                            },
                            {
                                "example_id": "ac49143b-d87d-4b17-932a-5150f70ee770",
                                "sense_id": "6fa19506-6e13-34a1-b6c0-3c3fac238330",
                                "text": "Une étoile s'est décrochée de ton maillot pour t'astériser."
                            }
                        ]
                    }
                ],
