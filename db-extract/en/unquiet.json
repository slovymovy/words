                    {
                        "sense_id": "c96352ac-0c4b-31db-8eae-d276f83396d5",
                        "entry_id": "22c7ece8-612c-37fb-a67b-62b2871c6436",
                        "glosses": [
                            "To disquiet (someone or something); to disturb."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c0ac7909-4308-4dfd-8579-c958fa5d37e8",
                                "sense_id": "c96352ac-0c4b-31db-8eae-d276f83396d5",
                                "text": "Butt the unbelevinge iewes, steryd uppe and unquyeted the myndes off the gentyles agaynste the brethren."
                            },
                            {
                                "example_id": "bcf1f7d4-fcf4-4407-9a57-ef74eb1782b1",
                                "sense_id": "c96352ac-0c4b-31db-8eae-d276f83396d5",
                                "text": "Thus erring Rome hath, doth, & vvill our chriſtian VVorld vnqueate: / May therefore Princes ioyne to race that Monſter from his Seate."
                            },
                            {
                                "example_id": "2dc75460-f6d3-49b1-810c-370e1d2a464a",
                                "sense_id": "c96352ac-0c4b-31db-8eae-d276f83396d5",
                                "text": "they were greatly troubled, and unquieted"
                            }
                        ]
                    }
                ],
