                        ],
                        "form": "das Nachschlagewerk"
                    },
                    {
                        "form_id": "73f735db-8646-4560-8baf-6391202401dc",
                        "entry_id": "91c67a2c-05bc-384b-a614-310e998f55b0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nachschlagewerke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                        "entry_id": "91c67a2c-05bc-384b-a614-310e998f55b0",
                        "glosses": [
                            "eine Datensammlung in alphabetischer oder systematischer Ordnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0add0a12-93d3-48e2-ba53-31cfe5729d74",
                                "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                                "text": "Zu den am meisten benutzten Nachschlagewerken zählen die Rechtschreibwörterbücher."
                            },
                            {
                                "example_id": "ccc6a925-e02f-406a-8aa1-e319b8b4d63c",
                                "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                                "text": "„Die Brauchbarkeit als Nachschlagewerk und Orientierungshilfe, womöglich als oberste Instanz in Fragen ‚richtigen‘ oder ‚falschen‘ Sprachgebrauchs steht und fällt mit der behaupteten Objektivität und Neutralität der Wörterbuchinhalte.“"
                            },
                            {
                                "example_id": "43693653-1936-4414-a759-3943634e4bef",
                                "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                                "text": "„Das bedeutet freilich nicht, dass sie in jedem Fall ohne Nachschlagewerke als Hilfsmittel unverständlich bleiben müssen.“"
                            },
                            {
                                "example_id": "4e139ce2-441c-4b73-8ec0-1e2a4b3150aa",
                                "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                                "text": "„Helena achtete darauf, die Wände mit Bücherregalen zu schmücken, so wie es sich für ein kultiviertes Haus gehört, und in diesen Regalen standen neben einer Enzyklopädie, einem Nachschlagewerk zu berühmten Menschen und berühmten Orten, auch Fotoalben.“"
                            },
                            {
                                "example_id": "1b287220-1f5b-4b8d-8fdc-5b0d24419908",
                                "sense_id": "6bd14cf8-69a2-3ee5-8126-333b724ca99d",
                                "text": "„Die starke Nachfrage nach solchen Nachschlagewerken nimmt nicht wunder, suchen doch viele Eltern die Namen aus Vorlagen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
