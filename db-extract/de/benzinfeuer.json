                            {
                                "example_id": "da75be91-f5e6-432c-9cea-18e1875f79ca",
                                "sense_id": "10a8145c-1bac-3d82-a364-fc16d6447d2f",
                                "text": "„Die orangeroten Lichter sehen wie ein Benzinfeuer aus.“"
                            },
                            {
                                "example_id": "091a0114-9b1c-4302-bb38-917c9fe2e07f",
                                "sense_id": "10a8145c-1bac-3d82-a364-fc16d6447d2f",
                                "text": "„Das Tier kreischte auf, als die Flammen seinen Kopf umschlossen, und sofort warf es sich zu Boden und wälzte sich, um das Benzinfeuer, das in seinem Gesicht tobte, zu ersticken.“"
                            }
