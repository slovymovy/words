                                    {
                                        "sense_id": "5011660a-adbb-30a9-ab9e-473b733edde6",
                                        "entry_id": "1aef6251-f1d3-3100-888d-e6ae382c4249",
                                        "glosses": [
                                            "The mouth, sometimes particularly the tongue, underlip, or tooth."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d59c82e4-df8b-4ee4-a555-c58f10337c11",
                                                "sense_id": "5011660a-adbb-30a9-ab9e-473b733edde6",
                                                "text": "They needa’ watch they jibs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d49161f-0a58-36ba-9e38-3ce9bc3a3450",
                                        "entry_id": "41001d9c-04d2-3a72-9288-9f9ae05a4fe2",
                                        "glosses": [
                                            "A first-year student at the University of Dublin."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "archaic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c72730d-f4e1-4566-a2ba-a94073e52f70",
                                                "sense_id": "1d49161f-0a58-36ba-9e38-3ce9bc3a3450",
                                                "text": "Forgetting that the jibs, whom they insulted, were afterwards to grow into the influential men […]"
                                            },
                                            {
                                                "example_id": "d55d425a-cf22-4718-83e7-29d807f2a8c7",
                                                "sense_id": "1d49161f-0a58-36ba-9e38-3ce9bc3a3450",
                                                "text": "[I]n a healthy environment, young Mahoney might have taken the risk, both with University and, in part, with entering the Aula for the jibs dance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
