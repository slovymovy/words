        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed309dec-d26e-36d5-9da7-665b078ed1aa",
                    "sense_definition": "Performed or done while maintaining an upright position on one's feet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adj_upright",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience gave the orchestra a <w>standing</w> ovation.",
