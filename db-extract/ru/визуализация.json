                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d922c423-0b15-4e76-b9fe-2cd941bdcc7f",
                                                "sense_id": "348b9ad3-e1ad-3d06-a932-f86f45d13ed9",
                                                "text": "Und jetzt denken Sie an Ihre Mutter. Lassen Sie die Visualisierung ganz deutlich werden vor Ihrem inneren Auge."
                                            },
                                            {
                                                "example_id": "57e7b2b2-48ac-4202-b4cf-4ddc8b2aa613",
                                                "sense_id": "348b9ad3-e1ad-3d06-a932-f86f45d13ed9",
                                                "text": "Wir arbeiten mit Visualisierungen. Es ist wichtig, seine Ziele so genau wie möglich zu visualisieren."
                                            }
