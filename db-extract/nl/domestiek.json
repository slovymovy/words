                "senses": [
                    {
                        "sense_id": "cc1918dc-b984-30f3-9303-cb538ef45ccb",
                        "entry_id": "9db25296-bf93-3676-8413-505d619bcf03",
                        "glosses": [
                            "huiselijk, betrekking hebbend op de huishouding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a3fe38-be69-4355-ab8d-5c4408cea940",
                                "sense_id": "cc1918dc-b984-30f3-9303-cb538ef45ccb",
                                "text": "Hij is op dat moment net begonnen aan een lange reis die anderhalf jaar zal duren en die hem zal voeren door Frankrijk, Duitsland, Oostenrijk en Italië, tot aan Rome. Tot zijn gezelschap, dat uit twaalf personen bestaat, behoren vrienden, familie en personeel. Als voornaamste reden voor deze reis kan genoemd worden, dat Montaigne een aantal kuuroorden wilde bezoeken teneinde verlichting voor zijn kwaal, nierstenen, te vinden, maar zeker zal ook hebben meegespeeld dat hij er eens uit wilde zijn, weg van de eentonigheid en verveling van de domestieke beslommeringen."
                            }
                        ]
                    }
                ],
