                        ],
                        "examples": [
                            {
                                "example_id": "6ab9f770-3f15-4e71-bbb5-939a1d2f786d",
                                "sense_id": "40caa01a-a822-31e7-9ccd-cddade17e726",
                                "text": "„Insgesamt sind 2500 menschliche Figuren von etwa 60–75 Zentimeter Höhe abgebildet. Den Kaiser selbst kann man rund sechzigmal identifizieren.“"
                            },
                            {
                                "example_id": "64d16b39-a251-43f5-b2f2-d923ac638d36",
                                "sense_id": "40caa01a-a822-31e7-9ccd-cddade17e726",
                                "text": "„Wenn Steinböcke und Dickhornschafe mit ihren Köpfen gegeneinander[ ]rennen, meistern sie gewaltige Kräfte. Diese sind bis zu sechzigmal größer als diejenigen, die ein Menschenschädel verkraften kann.“"
                            },
                            {
                                "example_id": "e85db3bd-ed6e-4545-894f-6ffc11351473",
                                "sense_id": "40caa01a-a822-31e7-9ccd-cddade17e726",
                                "text": "„Es ist in viele Sprachen übersetzt und seit 1472 über sechzigmal gedruckt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
