                                "target_senses": [
                                    {
                                        "sense_id": "fa9c2706-d64a-3ad7-aa7a-35dc96a7390f",
                                        "entry_id": "831395e1-37e7-35de-94e0-b4f0baba0e55",
                                        "glosses": [
                                            "The act of electrifying, or the state of being charged with electricity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29bfa1d3-e96a-3e31-9b87-1dcf3a11a1f9",
                                        "entry_id": "831395e1-37e7-35de-94e0-b4f0baba0e55",
                                        "glosses": [
                                            "The adaptation (of a home, farm, village, city, industry, railroad) for electric power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2adb3f3-82ca-4108-8bf6-3994c04eb45e",
                                                "sense_id": "29bfa1d3-e96a-3e31-9b87-1dcf3a11a1f9",
                                                "text": "The proposed Bedford-Leeds service requires the electrification of the Midland main line north of Market Harborough (it assumes that Kettering to Market Harborough is a done deal) and the Birmingham-Nottingham service requires electrification west of Nottingham."
                                            },
                                            {
                                                "example_id": "dcc2b04d-48ba-4e42-ba1a-5e6df79c4b24",
                                                "sense_id": "29bfa1d3-e96a-3e31-9b87-1dcf3a11a1f9",
                                                "text": "Transport Scotland's Director of Rail Bill Reeve has raised the prospect of electrification in Scotland being extended to connect all of the nation's seven cities. With the Scottish Government due to publish its plans in the spring for achieving a zero net carbon railway by 2035, Reeve told RAIL that \"the working assumption\" is that it will include the erection of wires to Perth, Aberdeen, Inverness and Dundee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3016db4-81d7-40ca-9375-9ba48eb2625a",
                        "source_entry_id": "06799f64-8177-386b-8778-0fb233e018db",
                        "source_sense_id": "ece022d3-cee7-3ca0-bed6-f8802dd64e10",
                        "source_sense_description": "invoering van een elektriciteitsnet",
                        "target_lang_word": "électrification",
