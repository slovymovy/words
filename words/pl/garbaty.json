{
    "word_family": [
        "garb",
        "garbić",
        "zgarbić",
        "garbus"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a086fa1-8659-3484-a3f7-5a15ca42243b",
                    "sense_definition": "mający zniekształcone plecy z widocznym wygięciem kręgosłupa, z garbem",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deformacja_ciala",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary, <w>garbaty</w> mężczyzna powoli szedł wzdłuż wąskiej uliczki starego miasta.",
                            "target_lang_translations": {
                                "ru": "Старый <w>горбатый</w> мужчина медленно шёл по узкой улочке старого города."
                            }
                        },
                        {
                            "text": "Przez całe dorosłe życie był wyraźnie <w>garbaty</w>, co utrudniało mu noszenie ubrań.",
                            "target_lang_translations": {
                                "ru": "Всю взрослую жизнь он был заметно <w>горбатым</w>, из-за чего ему было трудно подбирать одежду."
                            }
                        }
                    ],
                    "antonyms": [
                        "prosty"
                    ],
                    "common_phrases": [
                        "garbaty człowiek",
                        "być garbatym"
                    ],
                    "target_lang_definitions": {
                        "ru": "имеющий деформацию спины с заметным искривлением позвоночника, с горбом"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горбатый",
                                "target_lang_sense_clarification": "о человеке или животном с горбом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbf12ce7-1927-34e9-b759-0c4d3f52d0a3",
                    "sense_definition": "o części ciała lub przedmiocie: mający wypukłość, wybrzuszenie, haczykowaty lub zakrzywiony kształt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ksztalt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego charakterystyczny, <w>garbaty</w> nos nadawał twarzy bardzo surowy wyraz.",
                            "target_lang_translations": {
                                "ru": "Его характерный <w>горбатый</w> нос придавал лицу очень строгое выражение."
                            }
                        },
                        {
                            "text": "Ptak wyróżniał się niezwykle ostrym i <w>garbatym</w> dziobem.",
                            "target_lang_translations": {
                                "ru": "Птица выделялась необычайно острым и <w>крючковатым</w> клювом."
                            }
                        }
                    ],
                    "antonyms": [
                        "prosty"
                    ],
                    "common_phrases": [
                        "garbaty nos"
                    ],
                    "target_lang_definitions": {
                        "ru": "о части тела или предмете: имеющий выпуклость, искривлённую, крючковатую форму или горбинку"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горбатый",
                                "target_lang_sense_clarification": "выпуклый, изогнутый дугой"
                            },
                            {
                                "target_lang_word": "с горбинкой",
                                "target_lang_sense_clarification": "о носе"
                            },
                            {
                                "target_lang_word": "крючковатый",
                                "target_lang_sense_clarification": "о носе или клюве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}