                        "sense_id": "358b2ea8-e095-3502-aa9f-b8f99543dd53",
                        "entry_id": "0328194c-7dd3-3c99-af44-97f010da418b",
                        "glosses": [
                            "een taalvariatie die met een specifieke sociale groep verband is"
                        ],
