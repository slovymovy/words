                "senses": [
                    {
                        "sense_id": "14bec08e-d715-3f0a-8add-c62b86f6c7a7",
                        "entry_id": "ccdb19f8-1fec-38ea-b95b-91325c1ab467",
                        "glosses": [
                            "Einberufung zum Militärdienst"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c53ab00f-ce9c-4347-aa11-6a814164f98d",
                                "sense_id": "14bec08e-d715-3f0a-8add-c62b86f6c7a7",
                                "text": "„Ein Jahr zuvor hatte mich der dritte Gestellungsbefehl in München erreicht - ich war dort Kunststudent.“"
                            },
                            {
                                "example_id": "6913326a-42a2-492e-881d-12753a1b0a5d",
                                "sense_id": "14bec08e-d715-3f0a-8add-c62b86f6c7a7",
                                "text": "„Es ist, als stiege man in die Verliese einer Vergangenheit, deren Reize und Schrecken ich allein vom Hörensagen kenne, aus den zahllosen Erzählungen meiner Eltern und Großeltern, die von Gestellungsbefehlen und Bombennächten, Kriegsgefangenschaft und Hamsterfahrten handelten und mit der Währungsreform endeten.“"
                            },
                            {
                                "example_id": "dcc20cc5-9359-4f6f-8e0c-e8f581d87005",
                                "sense_id": "14bec08e-d715-3f0a-8add-c62b86f6c7a7",
                                "text": "„Über hundert seiner Beschäftigten, darunter besonders viele qualifizierte Drucker, mussten den Verlag wegen Gestellungsbefehlen verlassen und einrücken.“"
                            },
                            {
                                "example_id": "9693c699-c34a-488b-b47d-37cc7c9aa055",
                                "sense_id": "14bec08e-d715-3f0a-8add-c62b86f6c7a7",
                                "text": "„Noch ehe der Direktor verkündete, die Schule würde geschlossen, erhielten die Primaner schon ihre Gestellungsbefehle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
