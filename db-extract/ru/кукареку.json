                        "source_sense_id": "74fbc123-302c-3089-9fa9-c427aeb145d4",
                        "target_lang_word": "cocorico",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cocorico",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c593926b-0bd3-3122-b628-cc21933e2f37",
                                        "entry_id": "3d614c2e-5ce5-3e41-8a59-6946ca8d7743",
                                        "glosses": [
                                            "Onomatopée par laquelle on désigne le chant du coq."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d02e52-4cf6-4d11-8201-edc187cac88f",
                                                "sense_id": "c593926b-0bd3-3122-b628-cc21933e2f37",
                                                "text": "Écoutez, redit par l’écho,\nCe cri plein d’une ardeur touchante\nCocorico ! cocorico !\nVoilà, voilà le coq qui chante !"
                                            },
                                            {
                                                "example_id": "7b12837e-b6d0-4672-a462-3cff5330b0ab",
                                                "sense_id": "c593926b-0bd3-3122-b628-cc21933e2f37",
                                                "text": "Le coq pattu dont elle connaissait si bien le chant faisait cocorico à quelques pas d’elle et son propre sansonnet sifflait dans son oreille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cocorico",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4f28e7-1229-3413-935f-c43b2ad90f1f",
                                        "entry_id": "80b8929b-066b-3d23-a1cb-16168b185181",
                                        "glosses": [
                                            "Cri du coq."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f556378-70ae-48f4-9f12-741870cacb0f",
                                                "sense_id": "2d4f28e7-1229-3413-935f-c43b2ad90f1f",
                                                "text": "Et, pour mettre le comble au tapage, des myriades de poules et de coqs jetaient au vent leur caquet, dominé par la fanfare des cocoricos."
                                            },
                                            {
                                                "example_id": "0480bdac-42da-41e0-9437-010e53085f42",
                                                "sense_id": "2d4f28e7-1229-3413-935f-c43b2ad90f1f",
                                                "text": "Mais son fils est un vaniteux, qui aime mieux paraître qu’être (cela se conçoit, il n’est rien), et qui monte sur ses ergots dès que l’on fait cocorico. Pourtant, il faut qu’un Français chante et qu’il se moque de ses maîtres."
                                            },
                                            {
                                                "example_id": "1cd34301-c8c7-4270-aaf8-e810d5a18118",
                                                "sense_id": "2d4f28e7-1229-3413-935f-c43b2ad90f1f",
                                                "text": "Moyennant la somme de dix mille francs, il se procurait un gallinacé émettant jusqu'à cent dix-sept cocoricos par minute, et triomphait avec lui dans les diverses expositions où il le transportait derrière les barreaux d’une cage au treillis d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9631ede-4627-3980-a9b6-8cab757eda7a",
                                        "entry_id": "80b8929b-066b-3d23-a1cb-16168b185181",
                                        "glosses": [
                                            "Cri de victoire par lequel on exprime son patriotisme français."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6a8bd0a-4dbc-4b5b-87e9-fbe3155a62fe",
                                                "sense_id": "b9631ede-4627-3980-a9b6-8cab757eda7a",
                                                "text": "Je fais un petit cocorico, parce qu'il y a une part de génie français dans ce que vous faites."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
