                                                "sense_id": "8a85509a-73f0-3feb-a1de-135b831ef90d",
                                                "text": "„Tonga ist der einzige Staat in Ozeanien, der nie von Europäern kolonialisiert wurde.“"
                                            },
                                            {
                                                "example_id": "b9053263-6a48-4b79-967b-389cbaf15557",
                                                "sense_id": "8a85509a-73f0-3feb-a1de-135b831ef90d",
                                                "text": "„Die medizinische Versorgung in Tonga entspricht, insbesondere in den ländlichen Gebieten, nicht deutschem Standard.“"
                                            },
                                            {
                                                "example_id": "21585620-5376-4abf-aaf6-3a34c4ed1fc8",
                                                "sense_id": "8a85509a-73f0-3feb-a1de-135b831ef90d",
                                                "text": "„1886 erschienen die ersten eigenen Briefmarken Tongas.“"
                                            }
