                    },
                    {
                        "translation_id": "4b93151d-0aae-4d32-a466-f4c67c12f3ae",
                        "source_entry_id": "bd7b762f-7b5e-3e73-ad8e-f9d8489c752a",
                        "source_sense_id": "cf51cb5e-120f-383f-ae01-cbda6765f153",
                        "source_sense_description": "particle",
                        "target_lang_word": "pion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2292d9e7-4620-34c2-83f6-6a915a0194c0",
                                        "entry_id": "ed820eab-23a4-3f26-92de-d5f8b84629cf",
                                        "glosses": [
                                            "Pièce du jeu d’échecs placée initialement sur la seconde rangée de l’échiquier dans chaque camp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c08e379-fa4f-4422-b496-5c3fbd5d5772",
                                                "sense_id": "2292d9e7-4620-34c2-83f6-6a915a0194c0",
                                                "text": "Les batailles ne pouvaient donc plus être assimilées à des jeux d’échec dans lesquels l’homme est comparable à un pion ; elles devenaient des accumulations d’exploits héroïques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57f2c2aa-4665-362d-890e-3abc894225dd",
                                        "entry_id": "ed820eab-23a4-3f26-92de-d5f8b84629cf",
                                        "glosses": [
                                            "Pièce de certains autres jeux, tels que les dames, othello, backgammon, etc…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad3a9fed-e963-48f8-bfa1-df5336f3f94d",
                                                "sense_id": "57f2c2aa-4665-362d-890e-3abc894225dd",
                                                "text": "Aller à dame, se dit d'un pion qui prend la valeur de la dame lorsqu'on le mène jusqu'à la dernière ligne de l'adversaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606a0a2e-88a4-3e7f-ab7e-8a8ebd2ad9f2",
                                        "entry_id": "ed820eab-23a4-3f26-92de-d5f8b84629cf",
                                        "glosses": [
                                            "Petite tresse faite sur l’encolure d’un cheval avec les crins de sa crinière."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1aeb09d6-71a2-3648-92a8-016a89d69d99",
                                        "entry_id": "ed820eab-23a4-3f26-92de-d5f8b84629cf",
                                        "glosses": [
                                            "Petite pièce cylindrique se positionnant dans un trou et servant de référence. Voir aussi simbleau, centreur, locating."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae92a7a5-880f-4d1f-a442-e2cdd81190f6",
                                                "sense_id": "1aeb09d6-71a2-3648-92a8-016a89d69d99",
                                                "text": "Pion de centrage, pion de positionnement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3f88fde-ca11-3a16-b532-3bedb07d793b",
                                        "entry_id": "46cd7142-9c90-3b27-9000-3aa628fa00d3",
                                        "glosses": [
                                            "Fantassin, domestique à pied."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa8c95d-1ed0-4f97-ae6f-e7b57a0c3dfd",
                                                "sense_id": "e3f88fde-ca11-3a16-b532-3bedb07d793b",
                                                "text": "Deux chameaux, et leurs conducteurs, pour porter ses provisions et ses bagages ; deux pions, ou coureurs, pour l’annoncer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eea2a2d0-9bfd-3cda-b908-16bc00fbf909",
                                        "entry_id": "46cd7142-9c90-3b27-9000-3aa628fa00d3",
                                        "glosses": [
                                            "Personne qui fait office de pion dans une stratégie globale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c59a7c1-1652-453f-bdc3-c4701c69b850",
                                                "sense_id": "eea2a2d0-9bfd-3cda-b908-16bc00fbf909",
                                                "text": "Il n’a promu que des anciens de son école, il avance ses pions pour noyauter la direction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fa88b94-d135-39be-a3bd-aeec47dbcfed",
                                        "entry_id": "46cd7142-9c90-3b27-9000-3aa628fa00d3",
                                        "glosses": [
                                            "Quelqu’un qui n’a pas vraiment d’importance dans une organisation quelconque."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40abfe9c-2f32-423f-8ca5-c1b123051143",
                                                "sense_id": "9fa88b94-d135-39be-a3bd-aeec47dbcfed",
                                                "text": "Le professeur a été nommé à l’autre bout du pays, il a l’impression de n’être qu'un pion."
                                            },
                                            {
                                                "example_id": "426af02c-b086-4d1a-9503-a94c63f5af67",
                                                "sense_id": "9fa88b94-d135-39be-a3bd-aeec47dbcfed",
                                                "text": "Tu te prends pour qui, le pion?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                        "entry_id": "46cd7142-9c90-3b27-9000-3aa628fa00d3",
                                        "glosses": [
                                            "Surveillant d’établissement scolaire, dans le langage des écoliers."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "beddd570-735a-4352-a264-da1de3050595",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Cet élève, au bout d’une demi-heure d’étude ne comprenant pas son devoir, avait fait passer des billets pour le savoir. Le pion l’ayant découvert lui dit des sottises selon son ordinaire."
                                            },
                                            {
                                                "example_id": "2367e121-6dda-4693-bed1-9c413e39a907",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Entré comme pion à vingt ans dans une institution quelconque, afin de pouvoir pousser ses études jusqu'à la licence ès lettres d'abord, et jusqu'au doctorat ensuite, il s'était trouvé engrené de telle sorte dans cette vie sinistre qu'il était resté pion toute sa vie."
                                            },
                                            {
                                                "example_id": "14886bb9-c7e1-46fd-9c7d-2c20864f4eee",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Le collège, sans transition, avait été continué par le bureau, et les pions, devant qui il tremblait autrefois, étaient aujourd’hui remplacés par les chefs qu’il redoutait effroyablement."
                                            },
                                            {
                                                "example_id": "6fcccdd9-1f27-415d-a1b1-119fb853db8c",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Dans les milieux bourgeois, l’enfant vit jusqu’à sept ans avec ses bonnes, jusqu’à seize avec ses pions, et ensuite, avec… qui vous savez."
                                            },
                                            {
                                                "example_id": "81954078-d59b-475d-98de-aad51c2a5022",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Je lui ai tendu ensuite un assez long post-scriptum détaché, qui est une liste des errata relevés par lui dans mon livre. « Faites imprimer ça aussi, me dit-il avec bonne humeur. Ça fera voir mon côté pion !… »"
                                            },
                                            {
                                                "example_id": "c807eb21-b0ae-433b-91eb-91efe3b82883",
                                                "sense_id": "d4c21977-ea03-3d3a-b197-f34cb7fb2807",
                                                "text": "Les surveillantes ne réussissaient pas à nous faire tenir tranquilles. Nous passions les heures de battement […] dans […] « la salle d'étude des cours ». Nous bavardions, nous ricanions, nous provoquions la pionne chargée d'y faire régner l'ordre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fdbaccf8-41e0-375f-962b-5a01a3b4d71d",
                                        "entry_id": "0bd21c34-bed0-3df9-8011-4e1673dd4cb3",
                                        "glosses": [
                                            "Particule du type méson."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92878df1-44c5-491d-b1d8-db07df1974a1",
                                                "sense_id": "fdbaccf8-41e0-375f-962b-5a01a3b4d71d",
                                                "text": "Un pion a 273 fois la masse de l’électron."
                                            },
                                            {
                                                "example_id": "9727e12a-c191-4fbc-8dce-c622c18b2549",
                                                "sense_id": "fdbaccf8-41e0-375f-962b-5a01a3b4d71d",
                                                "text": "Pourquoi de si grosses machines pour déceler de si petites particules, aux noms pour moi enchanteurs — électrons, muons, neutrinos, quarks, fermions, pions, bosons, hypérons ou kaons ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "109a6ab7-12a9-32a1-b87b-cf506821c6a9",
                                        "entry_id": "dcbe7c36-08d1-3426-a22d-11c7d83003b2",
                                        "glosses": [
                                            "Relatif à Lavoine, commune située dans le département de l’Allier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "pion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "061db17b-dc7f-3dde-abe5-1eca7ef7dd2f",
                                        "entry_id": "3daeafe0-a487-3022-abce-9cec1cb4bfc1",
                                        "glosses": [
                                            "Ivre, en état d’ébriété."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f2a1f9-d343-49ea-9d21-67d0fc94aa81",
                                                "sense_id": "061db17b-dc7f-3dde-abe5-1eca7ef7dd2f",
                                                "text": "Si tu écluses encore un glace, tu vas êt’ complètement pion ; un beau mâle comme toi, ça d’vrait pas schnouper tant, ou tu seras bientôt amputé de la défonceuse..."
                                            },
                                            {
                                                "example_id": "d7a64f95-81df-47a4-87eb-9df186210734",
                                                "sense_id": "061db17b-dc7f-3dde-abe5-1eca7ef7dd2f",
                                                "text": "L’autre soir, tu étais presque complètement pion, et tu as laissé entendre que, pour un rien, tu déserterais..."
                                            },
                                            {
                                                "example_id": "fbad3402-482d-4275-a666-31db907ca27f",
                                                "sense_id": "061db17b-dc7f-3dde-abe5-1eca7ef7dd2f",
                                                "text": "Elle voudrait bien d’un coup de sabord lui intimer d’écraser. Cézigue, trop pion peut-être pour rien remarquer, va plus avant encore dans l’impair."
                                            },
                                            {
                                                "example_id": "98a26e34-a0b5-4825-b1c8-f2a6c7efd533",
                                                "sense_id": "061db17b-dc7f-3dde-abe5-1eca7ef7dd2f",
                                                "text": "Tatiana, au bout d’un moment était complètement pionne et moi aussi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
