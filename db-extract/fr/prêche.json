                    {
                        "translation_id": "132f3596-18ac-4b82-8d8d-ba2cae736cf1",
                        "source_entry_id": "6054e7a5-c627-3d04-b342-d9934372f3ed",
                        "target_lang_word": "kazanie",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazanie",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "25b3b567-66c2-3f5a-a63c-9a221a229af5",
                                        "entry_id": "ce5d2acc-b14e-33d0-8813-a65909a7fabf",
                                        "glosses": [
                                            "religijna przemowa, której celem jest przekazanie prawd wiary i zasad życia moralnego, w chrześcijaństwie także część mszy lub nabożeństwa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c15fcb-9a2d-42ef-bac1-9179cfec98f8",
                                                "sense_id": "25b3b567-66c2-3f5a-a63c-9a221a229af5",
                                                "text": "Kazania głoszone są też poza eucharystią, np. podczas Gorzkich Żali."
                                            },
                                            {
                                                "example_id": "00798480-181e-480f-801b-906358a4b010",
                                                "sense_id": "25b3b567-66c2-3f5a-a63c-9a221a229af5",
                                                "text": "Każda homilia jest kazaniem, ale nie każde kazanie jest homilią."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "e3480341-5bec-3e33-88be-94b06b808e6d",
                                        "entry_id": "ce5d2acc-b14e-33d0-8813-a65909a7fabf",
                                        "glosses": [
                                            "nadęta mowa umoralniająca"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69557064-562f-4c72-94bd-b94509d985f2",
                                                "sense_id": "e3480341-5bec-3e33-88be-94b06b808e6d",
                                                "text": "Jeżeli wrócę do domu po północy, to znowu będę miał kazanie od żony."
                                            },
                                            {
                                                "example_id": "d3b6a35f-e69a-459c-9041-49210aec0f9b",
                                                "sense_id": "e3480341-5bec-3e33-88be-94b06b808e6d",
                                                "text": "Belfer prawił młodzieży tradycyjne kazanie przed wspólnym wyjściem do kina."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "3856d2c6-fb33-3f28-a37b-fbef474ac0b2",
                                        "entry_id": "ce5d2acc-b14e-33d0-8813-a65909a7fabf",
                                        "glosses": [
                                            "rzecz. odczas. od kazać"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e73072-cc27-4393-9c0b-3a1d7b505a77",
                                                "sense_id": "3856d2c6-fb33-3f28-a37b-fbef474ac0b2",
                                                "text": "Kazanie mu iść precz nie było najlepszym pomysłem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    }
                                ]
                            }
