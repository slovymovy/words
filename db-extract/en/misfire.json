                                        "glosses": [
                                            "Avoir la carène enfoncée plus ou moins dans l’eau, en parlant d’un navire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aea4616-85fe-41c5-9683-c135df08015f",
                                                "sense_id": "ad2d0f8d-2b0a-377b-92aa-c9bcb4215806",
                                                "text": "Le navire avait été franc d’eau jusqu’à ce qu’il eût été calé à treize pieds."
                                            },
