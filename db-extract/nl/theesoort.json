                        "examples": [
                            {
                                "example_id": "544d6fa6-9e83-4261-8b90-d53197a17786",
                                "sense_id": "a6f1bd02-b7e6-3934-a54a-a45cc853ac2b",
                                "text": "De tour kan daarna verder gaan met een middagje theedrinken in het Emirates Palace. Naast heerlijke theesoorten kun je je ook laten verwennen met een ‘Palace Cappuccino’ volledig versierd met 24 karaat goudschilfers."
                            },
                            {
                                "example_id": "321ec914-5fb4-4fb3-8293-c8919062c1b4",
                                "sense_id": "a6f1bd02-b7e6-3934-a54a-a45cc853ac2b",
                                "text": "De kwaliteit van thee in Nederland laat veel te wensen over. ‘We leven echt in een theezakjescultuur en hebben nog een lange weg te gaan. Cups and Leafs wil daar een grote rol in spelen. Voor iedereen is er wel een theesoort te vinden’, vertelt Hamans. In de bar - en de webshop - vind je klassieke theesoorten, maar ook zelf ontwikkelde moderne combinaties, koffie en eten."
                            },
                            {
                                "example_id": "17432476-9a30-4b0a-94d9-01a82db4c158",
                                "sense_id": "a6f1bd02-b7e6-3934-a54a-a45cc853ac2b",
                                "text": "Met dit herfstweer is er niets zo lekker als met een kop warme thee op de bank kruipen. En gelukkig zijn er theesoorten in overvloed. Maar wist je ook dat het ontzettend makkelijk is om je eigen thee te maken? Lekker, gezond en zó gebeurd. Maar hoe? VROUW geeft handige tips om zelf thee te maken."
                            }
                        ]
                    }
