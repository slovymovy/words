                ],
                "senses": [
                    {
                        "sense_id": "ccb9ae90-be51-30e7-aebc-3fa88c7f08f9",
                        "entry_id": "40513bda-9c91-33d4-885c-f9a0591a10dc",
                        "glosses": [
                            "To refuse or (intentionally) fail to obey an order of (somebody)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "22c3db15-a4a8-49ce-9fcb-29914dc5b2b1",
                                "sense_id": "ccb9ae90-be51-30e7-aebc-3fa88c7f08f9",
                                "text": "disobey the rules"
                            },
                            {
                                "example_id": "dd833ab7-2320-4955-9115-9165abbef4cb",
                                "sense_id": "ccb9ae90-be51-30e7-aebc-3fa88c7f08f9",
                                "text": "disobey your parents"
                            }
                        ]
                    },
                    {
                        "sense_id": "ce6eab46-f2f8-3173-a90e-93f3e3347a4b",
                        "entry_id": "40513bda-9c91-33d4-885c-f9a0591a10dc",
                        "glosses": [
                            "To refuse or (intentionally) fail to obey."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "57ff5f3a-4f1c-4493-b137-7dad4e5b6af1",
                                "sense_id": "ce6eab46-f2f8-3173-a90e-93f3e3347a4b",
                                "text": "The powerful Bene Gesserit sisterhood for ninety generations has been manipulating bloodlines to produce the Kwisatz Haderach, a superbeing. On Caladan, Jessica, a member of the sisterhood and the bound concubine of Duke Leto Atreides, had been ordered to bear only daughters. Because of her love for the duke, she disobeyed and gave birth to a son: Paul, Paul Atreides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1530be83-f6e7-4852-92a4-86709ab1f9f5",
                        "source_entry_id": "40513bda-9c91-33d4-885c-f9a0591a10dc",
                        "source_sense_description": "to refuse to obey an order",
                        "target_lang_word": "niet gehoorzamen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3a87400a-fde6-43c6-b58f-6ad270f94baa",
                        "source_entry_id": "40513bda-9c91-33d4-885c-f9a0591a10dc",
                        "source_sense_description": "to refuse to obey an order",
                        "target_lang_word": "désobéir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désobéir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                        "entry_id": "203efceb-adb4-3733-a49c-b767c309b192",
                                        "glosses": [
                                            "Ne pas obéir, refuser d’obéir à quelqu’un, soit en faisant ce qui est défendu, soit en ne faisant pas ce qui est commandé, refuser de se soumettre à une volonté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec8a05f-eb9f-4d8e-9144-f17eecd778c5",
                                                "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                                "text": "Cet enfant a désobéi."
                                            },
                                            {
                                                "example_id": "15e24ed9-baab-4bb1-b2ae-b59693c5e349",
                                                "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                                "text": "Il désobéit, mais bêtement, pour des riens et avec une ruse mesquine ; il fait penser à l’employé qui use ses facultés à tromper la vigilance du chef, pour des niaiseries : pour lire son feuilleton, pour s’absenter dix minutes."
                                            },
                                            {
                                                "example_id": "c9974c13-2bf2-46da-93d7-2fb49e7cacd8",
                                                "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                                "text": "Il est ainsi des cas où, non pas d'ailleurs une obligation, mais un droit de désobéir a été, à moins de frais, reconnu."
                                            },
                                            {
                                                "example_id": "ce0b7735-93c5-4f84-adc6-2c3678fbdaf0",
                                                "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                                "text": "Désobéir à son supérieur, à ses parents. — Désobéir d’un commandement, à des ordres."
                                            },
                                            {
                                                "example_id": "490f97ee-bf45-4da8-b415-f551eec087c0",
                                                "sense_id": "f2d7e0b5-0312-3dee-869e-3df9a250349d",
                                                "text": "Désobéir à la loi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
