                        "entry_id": "2badecf9-0a26-3227-95a9-c2ffa05e234e",
                        "glosses": [
                            "Clipping of tranquilize."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "clipping",
                            "slang",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "02952fe2-1c46-4af1-b160-d92b65f72130",
                                "sense_id": "bea4d189-4294-30e1-a6f6-2e2a83425601",
                                "text": "He was about to stand up and start on another rant, which only would have led to Sam tranqing him."
                            },
                            {
                                "example_id": "75af7478-4f9b-4ed8-b5c0-8d37a66f00bb",
                                "sense_id": "bea4d189-4294-30e1-a6f6-2e2a83425601",
                                "text": "He fumbled at the dart but the needle was barbed and wouldn't come out. His fingers slid from it as a powerful numbness began to creep over his extremities. “Got him!” the man who had tranqed him shouted to his buddies."
                            }
                        ]
                    },
