    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0d95a66c-b38d-3ff2-86fd-048de418c663",
                    "sense_definition": "Possessing or showing courage or determination; brave, heroic.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "bravery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>valiant</w> soldier stood his ground despite the overwhelming odds against his small unit.",
                            "target_lang_translations": {
                                "es": "El <w>valiente</w> soldado se mantuvo firme a pesar de la abrumadora desventaja frente a su pequeña unidad."
                            }
                        },
                        {
                            "text": "She made a <w>valiant</w> effort to save the company from bankruptcy during the economic crisis.",
                            "target_lang_translations": {
                                "es": "Ella hizo un <w>valeroso</w> esfuerzo para salvar a la empresa de la quiebra durante la crisis económica."
                            }
                        }
                    ],
                    "synonyms": [
                        "courageous",
                        "heroic",
                        "intrepid",
                        "gallant",
                        "dauntless"
                    ],
                    "common_phrases": [
                        "valiant effort",
                        "valiant attempt"
                    ],
                    "target_lang_definitions": {
                        "es": "Que posee o muestra valor, coraje o determinación; valeroso, heroico."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "valiente",
                                "target_lang_sense_clarification": "persona que actúa con valor y coraje"
                            },
                            {
                                "target_lang_word": "valeroso",
                                "target_lang_sense_clarification": "digno de admiración por su valor"
                            },
                            {
                                "target_lang_word": "denodado",
                                "target_lang_sense_clarification": "esfuerzo o acción realizada con gran determinación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34d84293-247b-3c13-83a1-fdb052fad2a0",
                    "sense_definition": "Characterized by or done with bravery or valour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bravery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The history books are filled with stories of <w>valiant</w> deeds performed by ancient warriors.",
                            "target_lang_translations": {
                                "es": "Los libros de historia están llenos de relatos sobre <w>valerosas</w> hazañas realizadas por antiguos guerreros."
                            }
                        },
                        {
                            "text": "His <w>valiant</w> actions during the fire earned him a medal for extreme bravery.",
                            "target_lang_translations": {
                                "es": "Sus <w>heroicas</w> acciones durante el incendio le valieron una medalla al valor extremo."
                            }
                        }
                    ],
                    "synonyms": [
                        "heroic",
                        "courageous"
                    ],
                    "common_phrases": [
                        "valiant deeds",
                        "valiant actions"
                    ],
                    "target_lang_definitions": {
                        "es": "Caracterizado por la valentía o realizado con gran valor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "valeroso",
                                "target_lang_sense_clarification": "hecho o acción heroica"
                            },
                            {
                                "target_lang_word": "heroico",
                                "target_lang_sense_clarification": "acto de valentía extraordinaria"
                            },
                            {
                                "target_lang_word": "valiente",
                                "target_lang_sense_clarification": "gesta o conducta arriesgada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "317597d5-84d5-36ac-9cdc-943a0cee74bd",
                    "sense_definition": "A person who acts with valour, showing hero-like characteristics in the midst of danger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bravery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legends tell of the <w>valiants</w> who defended the kingdom from the invading armies.",
                            "target_lang_translations": {
                                "es": "Las leyendas hablan de los <w>valientes</w> que defendieron el reino de los ejércitos invasores."
                            }
                        },
                        {
                            "text": "Only the true <w>valiants</w> among the knights were chosen to lead the dangerous mission.",
                            "target_lang_translations": {
                                "es": "Solo los verdaderos <w>valientes</w> entre los caballeros fueron elegidos para liderar la peligrosa misión."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in literary or historical contexts."
                        }
                    ],
                    "target_lang_definitions": {
