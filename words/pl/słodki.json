                        {
                            "text": "Większość jezior w Polsce zawiera wodę <w>słodką</w>.",
                            "target_lang_translations": {
                                "ru": "В большинстве озер в Польше вода <w>пресная</w>.",
                                "en": "Most lakes in Poland contain <w>fresh</w> water.",
                                "nl": "De meeste meren in Polen bevatten <w>zoet</w> water.",
                                "de": "Die meisten Seen in Polen enthalten <w>Süßwasser</w>.",
                                "fr": "La plupart des lacs en Pologne contiennent de l'eau <w>douce</w>.",
                                "it": "La maggior parte dei laghi in Polonia ha acqua <w>dolce</w>.",
                                "cs": "Většina jezer v Polsku obsahuje <w>sladkou</w> vodu.",
                                "tr": "Polonya'daki göllerin çoğu <w>tatlı</w> su içerir.",
                                "es": "La mayoría de los lagos de Polonia contienen agua <w>dulce</w>.",
                                "zh": "波兰的大多数湖泊都是<w>淡</w>水湖。"
                            }
                        },
                        {
                            "text": "Ryby żyjące w wodach <w>słodkich</w> nie przeżyją w oceanie.",
                            "target_lang_translations": {
                                "ru": "Рыбы, обитающие в <w>пресных</w> водах, не выживут в океане.",
                                "en": "Fish living in <w>fresh</w> waters will not survive in the ocean.",
                                "nl": "Vissen die in <w>zoet</w> water leven overleven niet in de oceaan.",
                                "de": "Fische, die in <w>Süßgewässern</w> leben, überleben im Ozean nicht.",
                                "fr": "Les poissons qui vivent dans les eaux <w>douces</w> ne survivront pas dans l'océan.",
                                "it": "I pesci che vivono nelle acque <w>dolci</w> non sopravvivono nell'oceano.",
                                "cs": "Ryby žijící ve <w>sladkých</w> vodách v oceánu nepřežijí.",
                                "tr": "<w>Tatlı</w> sularda yaşayan balıklar okyanusta hayatta kalamaz.",
                                "es": "Los peces que viven en aguas <w>dulces</w> no sobrevivirán en el océano.",
                                "zh": "生活在<w>淡</w>水中的鱼类无法在海洋中生存。"
                            }
                        }
