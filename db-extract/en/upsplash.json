                        ],
                        "examples": [
                            {
                                "example_id": "0213ffb1-9d97-4c7c-b639-6d129d62c60d",
                                "sense_id": "d6d63523-3704-3449-9f0d-cb87d502f4d7",
                                "text": "It half disintegrated on the way, crust and filling slapping against the train like an upsplash of mud."
                            },
                            {
                                "example_id": "34451026-9c46-4bb7-8cb0-cb6a80254778",
                                "sense_id": "d6d63523-3704-3449-9f0d-cb87d502f4d7",
                                "text": "The mist was like backwards rain, upsplash from the falls, and it pelted us so hard I thought I'd lose my balance."
                            },
                            {
                                "example_id": "69363f7c-7381-419b-bf0a-c0a405381cc3",
                                "sense_id": "d6d63523-3704-3449-9f0d-cb87d502f4d7",
                                "text": "[…] as she plummets back her hair falls slower, splayed like water's upsplash, buoyed on the air, but then pulled down with her […]"
                            }
                        ]
                    }
