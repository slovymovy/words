                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06f58cba-6979-4d85-8123-5820a96dc731",
                                                "sense_id": "11a5198d-9cce-30ff-8f16-ab984a3e0136",
                                                "text": "Anywhere you go in France, there will be bread and wine with dinner."
                                            },
                                            {
                                                "example_id": "b42af498-ca63-45a5-85b0-f3e8b5f19f80",
                                                "sense_id": "11a5198d-9cce-30ff-8f16-ab984a3e0136",
                                                "text": "I'm staying home today. I'm not going anywhere."
                                            },
                                            {
                                                "example_id": "d173ddda-3b36-4e04-82a0-0423efd76c5c",
                                                "sense_id": "11a5198d-9cce-30ff-8f16-ab984a3e0136",
                                                "text": "Are you going anywhere special this weekend?"
                                            }
                                        ]
                                    }
                                ]
                            },
