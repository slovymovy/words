                ],
                "senses": [
                    {
                        "sense_id": "c0b3de0d-59eb-3494-99fc-327d067b859e",
                        "entry_id": "48df72f2-9632-3cec-be44-118b9ab8e91c",
                        "glosses": [
                            "Pelotant, qui pelote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96ac814-54d0-4231-83c7-49e87766a684",
                                "sense_id": "c0b3de0d-59eb-3494-99fc-327d067b859e",
                                "text": "Il aimait la société des jeunes femmes qu’il traitait avec une insolence caressante et qu’il enveloppait […] de gestes délicatement peloteurs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "01ba4a92-a221-3b59-8a1e-b2192707b399",
                "word": "peloteur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "74501183-4576-4178-af6e-ecaf3d10e77d",
                        "entry_id": "01ba4a92-a221-3b59-8a1e-b2192707b399",
                        "tags": [
