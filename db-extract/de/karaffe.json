                        "form": "die Karaffen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                        "entry_id": "84121e1d-b640-381d-acf0-49437855ddcb",
                        "glosses": [
                            "geschliffener Glas- oder Kristallbehälter für Getränke, der oftmals eine bauchige Form und einen Verschluss hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec8ee20d-e4d0-4579-a3cf-557595c40326",
                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                "text": "Die Karaffe ist ein Bestandteil der Trinkkultur."
                            },
                            {
                                "example_id": "593cb58d-ac25-45db-9035-689fe356c027",
                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                "text": "„Nikolai bestellte eine Karaffe roten Landwein.“"
                            },
                            {
                                "example_id": "b3a67cac-b4b0-4e1d-a473-441b3722861f",
                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                "text": "„In Treviso waren wir alle sehr gut untergebracht, und nachdem wir einige Karaffen Limonade getrunken hatten, gingen wir alle schlafen.“"
                            },
                            {
                                "example_id": "14ef33f7-5800-4049-b8ca-cba6b072c471",
                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                "text": "„Die alte Bedienerin, die sich offensichtlich freute, daß ein Gast im Hause weilte, war einige Male in den Saal gekommen, hatte ein graukariertes Tuch über den Tisch gebreitet, Besteck und Serviette bereitgelegt, Karaffe und Glas gebracht.“"
                            },
                            {
                                "example_id": "28a17b26-efca-4176-9080-ecd0f87d5342",
                                "sense_id": "fdb56f8c-e070-3559-9e2e-bc42c4874ef4",
                                "text": "„Gläser und Teller und eine leicht beschlagene Karaffe mit Wasser standen darauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95b92741-3c4d-4657-9de7-6b12e2267800",
                        "source_entry_id": "84121e1d-b640-381d-acf0-49437855ddcb",
