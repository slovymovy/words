            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aaafaa02-bd62-3be0-abd1-40abbf79e9ca",
                    "sense_definition": "Causing damage or harm.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harmful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Smoking tobacco can be <w>detrimental</w> to your health and long-term well-being.",
                            "target_lang_translations": {
                                "ru": "Курение табака может быть <w>вредным</w> для вашего здоровья и долгосрочного благополучия."
                            }
                        },
                        {
                            "text": "The new policy had a <w>detrimental</w> effect on the local economy and small businesses.",
                            "target_lang_translations": {
                                "ru": "Новая политика оказала <w>пагубное</w> влияние на местную экономику и малый бизнес."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmful",
                        "damaging",
                        "hurtful",
                        "noxious",
                        "injurious",
                        "deleterious",
                        "prejudicial",
                        "inimical"
                    ],
                    "antonyms": [
                        "beneficial"
                    ],
                    "common_phrases": [
                        "detrimental effect",
                        "detrimental to health",
                        "prove detrimental"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причиняющий ущерб или вред."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вредный",
                                "target_lang_sense_clarification": "оказывающий плохое влияние на здоровье или состояние"
                            },
                            {
                                "target_lang_word": "пагубный",
                                "target_lang_sense_clarification": "ведущий к гибели или серьезному ущербу"
                            },
                            {
                                "target_lang_word": "губительный",
                                "target_lang_sense_clarification": "разрушительный, приносящий гибель"
                            },
                            {
                                "target_lang_word": "вредоносный",
                                "target_lang_sense_clarification": "приносящий вред, часто в техническом или биологическом смысле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b50acf36-64cd-38ba-9529-749e6946e57c",
                    "sense_definition": "Anything that causes harm or damage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "harmful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor explained that these <w>detrimentals</w> suck the life out of the host organism.",
                            "target_lang_translations": {
                                "ru": "Врач объяснил, что эти <w>вредоносные элементы</w> высасывают жизнь из организма хозяина."
                            }
                        },
                        {
                            "text": "In the social circle of the time, poets and artists were often viewed as <w>detrimentals</w>.",
                            "target_lang_translations": {
                                "ru": "В светских кругах того времени на поэтов и художников часто смотрели как на <w>вредных элементов</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-либо, что причиняет вред или ущерб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вредный элемент",
                                "target_lang_sense_clarification": "о человеке или факторе, приносящем вред"
                            },
                            {
                                "target_lang_word": "пагубный фактор",
                                "target_lang_sense_clarification": "явление, вызывающее негативные последствия"
                            }
                        ]
                    }
                }
            ]
        }
