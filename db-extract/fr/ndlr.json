                    {
                        "sense_id": "53a66b1f-1188-3a52-aa16-ab1e241507c5",
                        "entry_id": "7621a5e0-f5bd-31c9-a934-11721c0da486",
                        "glosses": [
                            "Note ajoutée dans une citation par la rédaction d’un article de presse. Note d’usage : Écrit au début ou à la fin d’une note ajoutée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d84dc67e-fc64-4325-a834-506071b3db2d",
                                "sense_id": "53a66b1f-1188-3a52-aa16-ab1e241507c5",
                                "text": "Cela fait déjà plusieurs années qu’en toute discrétion, des crédits PIA ont été réorientés pour faire face à des impasses budgétaires [plus de 3 milliards d’euros depuis 2011, NDLR]."
                            },
                            {
                                "example_id": "c69a60a5-d795-4cda-a801-487b7def7333",
                                "sense_id": "53a66b1f-1188-3a52-aa16-ab1e241507c5",
                                "text": "Problème, \"certains maîtres d’ouvrages privés (Promoteurs, aménageurs, société immobilière ou foncière NDLR) font pression pour reprendre les activités\", indique une source bien informée du secteur"
                            },
                            {
                                "example_id": "ccd51110-3318-4e99-a9f5-9be8f3aa87b7",
                                "sense_id": "53a66b1f-1188-3a52-aa16-ab1e241507c5",
                                "text": "Je me suis entretenu avec Marion Rousse (la directrice de l’épreuve, NDLR)."
                            }
                        ]
                    }
