                {
                    "sense_id": "eaa78236-26fb-3e33-b13f-9da085aa843b",
                    "sense_definition": "The University of Texas at Austin, often used in sports or academic contexts.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "organizations",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He hopes to play football for <w>Texas</w> after he graduates from high school.",
                            "target_lang_translations": {
                                "ru": "Он надеется играть в футбол за <w>Техас</w> после окончания средней школы.",
                                "zh": "他希望高中毕业后能为<w>得克萨斯大学</w>打美式橄榄球。"
                            }
                        },
                        {
                            "text": "She received her law degree from <w>Texas</w> before moving to New York.",
                            "target_lang_translations": {
                                "ru": "Она получила диплом юриста в <w>Техасском университете</w> перед переездом в Нью-Йорк.",
                                "zh": "在搬去纽约之前，她从<w>得克萨斯大学</w>获得了法学学位。"
                            }
                        }
                    ],
