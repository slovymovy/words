                "senses": [
                    {
                        "sense_id": "c362c9f8-636b-33a3-9753-66511e442127",
                        "entry_id": "fa566a20-57ea-3d11-a123-48991e6c8ef9",
                        "glosses": [
                            "делать (сделать) ряды параллельных волнообразных складок (на ткани, бумаге, металле и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26733ba-b1fc-4111-977e-36f267f80a17",
                                "sense_id": "c362c9f8-636b-33a3-9753-66511e442127",
                                "text": "Искусственные (вискоза, ацетат) и синтетические (полиакрил, полиэстер, полиамид) ткани плохо пропускают воздух. Поэтому такие волокна гофрируют, а затем скручивают в нити."
                            },
                            {
                                "example_id": "18388b8c-c239-4335-8c0f-ac9d711f8063",
                                "sense_id": "c362c9f8-636b-33a3-9753-66511e442127",
                                "text": "Стальную ламинированную ленту сначала гофрируют, затем сворачивают вокруг кабеля, после чего накладывают и маркируют защитный шланг."
                            }
                        ]
                    }
