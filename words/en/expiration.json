{
    "word_family": [
        "expire",
        "expired",
        "expiry",
        "expiratory"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "25a9f2f7-1e1e-36a4-93b5-4ff36901e0a7",
                    "sense_definition": "The end of a period of time during which something is valid or in effect.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check the <w>expiration</w> date on the milk carton before you buy it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте дату <w>истечения</w> срока годности на пакете молока перед покупкой."
                            }
                        },
                        {
                            "text": "The <w>expiration</w> of the contract means we need to negotiate a new agreement.",
                            "target_lang_translations": {
                                "ru": "<w>Окончание</w> срока действия контракта означает, что нам нужно обсудить новое соглашение."
                            }
                        }
                    ],
                    "synonyms": [
                        "termination"
                    ],
                    "common_phrases": [
                        "expiration date",
                        "contract expiration",
                        "approaching expiration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончание периода времени, в течение которого что-либо является действительным или имеет силу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истечение",
                                "target_lang_sense_clarification": "срока действия"
                            },
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "срока"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "743193e0-216c-35bf-b25d-895ec0756bba",
                    "sense_definition": "The act or process of breathing out air from the lungs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to focus on slow <w>expiration</w> during the breathing test.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента сосредоточиться на медленном <w>выдохе</w> во время дыхательного теста."
                            }
                        },
                        {
                            "text": "You can hear a slight whistling sound upon <w>expiration</w> if the airway is blocked.",
                            "target_lang_translations": {
                                "ru": "При заблокированных дыхательных путях на <w>выдохе</w> можно услышать легкий свистящий звук."
                            }
                        }
                    ],
                    "synonyms": [
                        "exhalation"
                    ],
                    "antonyms": [
                        "inspiration",
                        "inhalation"
                    ],
                    "common_phrases": [
                        "forced expiration",
                        "prolonged expiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или процесс выдыхания воздуха из легких."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдох",
                                "target_lang_sense_clarification": "процесс дыхания"
                            },
                            {
                                "target_lang_word": "выдыхание",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b9ad96d-dc4f-33e2-aa23-899bf494709a",
                    "sense_definition": "The final emission of breath at the moment of death.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ending",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the peaceful <w>expiration</w> of the old man in his final hours.",
                            "target_lang_translations": {
                                "ru": "Поэт описал мирную <w>кончину</w> старика в его последние часы."
                            }
                        },
                        {
                            "text": "With a final, quiet <w>expiration</w>, the king passed away surrounded by his family.",
                            "target_lang_translations": {
                                "ru": "С последним тихим <w>вздохом</w> король скончался в окружении своей семьи."
                            }
                        }
                    ],
                    "synonyms": [
                        "demise",
                        "death",
                        "decease"
                    ],
                    "common_phrases": [
                        "final expiration"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary use for death"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Последний вздох в момент смерти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кончина",
                                "target_lang_sense_clarification": "литературное обозначение смерти"
                            },
                            {
                                "target_lang_word": "испускание духа",
                                "target_lang_sense_clarification": "устаревшее/поэтическое"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}