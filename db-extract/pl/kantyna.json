                    },
                    {
                        "translation_id": "c590c515-f328-47cb-b5e8-a85fea1bcd1a",
                        "source_entry_id": "ca4c4141-b396-30c1-a5ae-763838c61512",
                        "source_sense_id": "13247567-0840-313c-bf96-ab5462f61527",
                        "target_lang_word": "Kantine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kantine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                        "entry_id": "ef63127b-096a-3542-9a7f-fe58943546fd",
                                        "glosses": [
                                            "Ort, wo man günstig eine Mahlzeit einnehmen und trinken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d15a171-5354-4fc1-9976-c4102d9ef198",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "Mittags ging ich in die Kantine zum Essen."
                                            },
                                            {
                                                "example_id": "27d48546-4631-4488-8988-2a739de9fd7f",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„Wir können es nicht an einem Fleck aushalten und gehen zur Kantine.“"
                                            },
                                            {
                                                "example_id": "bb8a82bb-9ab2-4e1d-8c14-bab2b7f2b25f",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„Diese Hinweise schienen mir, wie alles, was Paul sagte, Hand und Fuß zu haben, und ich befolgte sie, indem ich bei der nächsten Gelegenheit in der Kantine verschwand.“"
                                            },
                                            {
                                                "example_id": "fb07a128-2f85-411e-893a-1b7859b94b0e",
                                                "sense_id": "aaa098ce-cf5e-3434-a74e-16d5ebe7e556",
                                                "text": "„In der Kantine kaufte Tante Dagmar mir soviel Tortenstücke, wie ich verdrücken konnte.“"
                                            },
                                            {
