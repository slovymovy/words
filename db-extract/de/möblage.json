                "senses": [
                    {
                        "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                        "entry_id": "056345a2-810d-3de2-96bb-6bad37a57c97",
                        "glosses": [
                            "Gesamtheit der Möbelstücke"
                        ],
                        "tags": [
                            "auch übertragen"
                        ],
                        "examples": [
                            {
                                "example_id": "1250602a-9aac-4635-bf56-71c05e2de649",
                                "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                                "text": "„Er war mit solcher Möblage aufgewachsen.“"
                            },
                            {
                                "example_id": "4133d0fa-55b0-4715-8940-76d2c20dda0a",
                                "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                                "text": "„Wenn nicht bald ein Geld hereinkommt, müssen wir die Möblage verkaufen.“"
                            },
                            {
                                "example_id": "b1523a35-07e7-4d55-851a-f2a6181a8311",
                                "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                                "text": "„Im Zuge des Umbaus wird ein Teil der Möblage des Plenarsaales versteigert, […]“"
                            },
                            {
                                "example_id": "906cfba7-3e8b-426a-8d80-ebfb13fb6383",
                                "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                                "text": "„Ein Zufall oder die davor positionierte Möblage sicherten die weitere Existenz des 110 cm hohen antiken Fragments.“"
                            },
                            {
                                "example_id": "3fddef22-b5af-4a6d-9f5a-82ccf75a0d1b",
                                "sense_id": "9a39526f-8327-3329-81b0-09b5ba0637b9",
                                "text": "„Und diesen Umstand machte ich mir zunutze: Ich kletterte hinten auf das Gerüst und ruckelte an der Kulisse, bis diese langsam, ganz langsam zu Boden segelte – direkt auf die Möblage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
