                            {
                                "example_id": "07e4a1aa-df99-407f-a1be-09bdf9a3169b",
                                "sense_id": "f8448d43-a4a3-332a-b5d2-7c309f3d6534",
                                "text": "Ze stond niet bekend om haar zwijgzaamheid."
                            },
                            {
                                "example_id": "d7af156e-c7f6-4cae-be37-bd5979eb24c0",
                                "sense_id": "f8448d43-a4a3-332a-b5d2-7c309f3d6534",
                                "text": "Er verschijnt een barst in haar zwijgzaamheid, en plotseling tuimelen de woorden naar buiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d988f37-e32b-46e7-9b9a-4ceb4f17b45a",
                        "source_entry_id": "ce9c8ef1-2208-3bc1-9ed9-f09f0cb1650d",
                        "source_sense_id": "f8448d43-a4a3-332a-b5d2-7c309f3d6534",
                        "target_lang_word": "taciturnity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taciturnity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                                        "glosses": [
                                            "The trait of being taciturn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d49795b9-7b66-4fba-bf90-2322cdff9bff",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Humphries broke out more freely into speech than he had done before, for his usual characteristic was that of taciturnity."
                                            },
                                            {
                                                "example_id": "62eae02b-1cb7-4f6d-a6b8-ff26b138324c",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Gernois’ cordiality was short-lived. No sooner had they ridden out of sight of Captain Gerard and his men than he lapsed once more into his accustomed taciturnity."
                                            },
                                            {
                                                "example_id": "8479b40c-3207-470c-87a6-40823abb4ba6",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "\"[…]and as Mr. H., with his long purse and his willingness to receive hints, is no bad card in the game, he has been brought up to Abbotsford for a week; his taciturnity has long ago fled, and he is one of the most loquacious Borderers going. […]\""
                                            },
                                            {
                                                "example_id": "cd12764a-3f55-429b-b110-33c179f185b5",
                                                "sense_id": "5e4c3165-70ff-3d71-8870-283a91bb4663",
                                                "text": "Once he is back on the bench, will Justice Thomas revert to his usual taciturnity?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90393d21-25b6-3a0e-a4d1-ff5b8b7232ad",
                                        "entry_id": "6384772e-f091-31bc-8532-bccdace2d9d7",
                                        "glosses": [
                                            "Failure to assert a legal right in a way that implies that it is being given up."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "406d3aa4-7fb2-46cd-babd-97f40bb66abb",
                        "source_entry_id": "ce9c8ef1-2208-3bc1-9ed9-f09f0cb1650d",
                        "source_sense_id": "f8448d43-a4a3-332a-b5d2-7c309f3d6534",
                        "target_lang_word": "taciturnité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taciturnité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                        "entry_id": "5707313a-4eca-321b-9585-73d05ddfb25a",
                                        "glosses": [
                                            "Humeur, tempérament ou état d’une personne taciturne."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8588d75f-29bc-462f-a1cc-9f435f9d85b1",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Comment ne l’eût-on pas fui, quand déjà son extérieur, sa taciturnité, la vue de son fils, suffisaient et au delà à éteindre aussitôt dans tous les esprits jusqu’à la velléité de le connaître intimement ?"
                                            },
                                            {
                                                "example_id": "b2808b70-c0b0-4a38-9041-a0edb7c12825",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Il semble que la colère ne produise pas la taciturnité. Car la taciturnité est opposée à la parole."
                                            },
                                            {
                                                "example_id": "1bc1cd15-7991-4e84-84ed-22d3ac4ac063",
                                                "sense_id": "999d99d6-a3a0-3309-8a76-a91ed9af0abf",
                                                "text": "Dès lors, le péché de taciturnité va présenter une distinction, qui connaîtra ensuite une longue carrière : d’une part la « taciturnité excessive » (nimia tacitumitas), dont les dangers et les fautes peuvent concerner tous les hommes ; de l’autre le « silence sans discernement » […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
