                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cadre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle apprécie de travailler dans un <w>environnement</w> professionnel stimulant et bienveillant."
                        },
                        {
                            "text": "Un <w>environnement</w> familial harmonieux favorise le bon développement des adolescents."
