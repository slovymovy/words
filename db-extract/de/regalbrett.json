                "senses": [
                    {
                        "sense_id": "cafeba92-723c-3482-b67f-57e5476666a4",
                        "entry_id": "d3b16b18-2476-3e82-a034-8434524c6f42",
                        "glosses": [
                            "Étagère (tablette, tablar, planche, plan)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49eee0a6-c262-4142-945a-fd6af81a50bf",
                                "sense_id": "cafeba92-723c-3482-b67f-57e5476666a4",
                                "text": "Bevor ein Regalbrett an der Wand befestigt wird, sollte einiges bedacht werden. Unter anderem zählt hierzu die Tragfähigkeit des Bretts, damit Sie auch schwerere Gegenstände darauf legen können.",
                                "translation": "Avant de fixer une étagère au mur, il faut tenir compte de certains aspects, notamment la capacité de charge de la planche, afin que vous puissiez aussi y placer des objets plus lourds."
                            }
                        ]
                    }
