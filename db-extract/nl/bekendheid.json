                                "sense_id": "ef4c4154-a393-3d06-896e-80b83288b42d",
                                "text": "Hij verwierf hierdoor grote bekendheid."
                            }
                        ]
                    },
                    {
                        "sense_id": "771774cf-d496-343c-8313-3b9627f4dd7c",
                        "entry_id": "1de38cc3-1e66-30e1-9ad0-d4a0a091c3c5",
                        "glosses": [
