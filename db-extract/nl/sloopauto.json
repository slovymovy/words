                        "sense_id": "ab9ba40c-5024-343a-8f81-82b3265d4dd7",
                        "entry_id": "55b42130-7fa8-372c-b9c0-20e5329758a6",
                        "glosses": [
                            "auto die nooit meer kan rijden en dus alleen maar geschikt is voor de sloop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea577eb6-5359-4085-bbbd-d91e7d74848d",
                                "sense_id": "ab9ba40c-5024-343a-8f81-82b3265d4dd7",
                                "text": "In Veen ging in dezelfde nacht ook een sloopauto in vlammen op. Een 21-jarige man uit Wijk en Aalburg werd opgepakt omdat hij bij het brandende wrak stond met een groot vuurwerkpakket, dat hij volgens de politie wilde aansteken."
                            },
                            {
                                "example_id": "ff427d28-afc0-425c-a974-2a6d55bc4f80",
                                "sense_id": "ab9ba40c-5024-343a-8f81-82b3265d4dd7",
                                "text": "Tijdens en voorafgaand aan de jaarwisselingen worden er ’traditioneel’ sloopauto’s in brand gestoken in Veen. Het liefst midden in het dorp, op het Veense kruispunt. „Stoken op de openbare weg is echter verboden”, schrijft de gemeente op haar site."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
