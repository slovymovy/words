                                    {
                                        "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                        "entry_id": "9453b9e2-e855-31f3-9b2b-5a0bc7c09526",
                                        "glosses": [
                                            "in/aus der Zeit, bevor eine Ehe geschlossen wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8bd044e-d790-4769-be09-cdbadd37af72",
                                                "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                                "text": "„Er hätte also ruhig in jener Nacht mit Marion etwas anfangen können; Konsequenzen in dieser Hinsicht hätte ein voreheliches Techtelmechtel für ihn - und sie - nicht gehabt.“"
                                            },
                                            {
                                                "example_id": "756cd573-2c19-4236-9bf2-e42a9da561d5",
                                                "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                                "text": "„Während früher für voreheliche Schulden des Mannes im Regelfall das Gesamtgut neben dem Eigengut haftete, beschränkt sich diese Haftung nunmehr auf dessen Eigengut.“"
                                            },
                                            {
                                                "example_id": "bc590193-3f7f-407f-97cd-33725fb6930b",
                                                "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                                "text": "„Insgesamt wurden rund 16% aller von jemals verheirateten Frauen geborenen Kinder vorehelich geboren.“"
                                            },
                                            {
                                                "example_id": "7cf5252f-e8bd-47af-b75e-7158259b4418",
                                                "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                                "text": "„Martha Müller-Grählert wurde als Johanna Friederike Karoline Daatz als voreheliches Kind geboren.“"
                                            },
                                            {
                                                "example_id": "9d6f7880-ef1c-40b2-ab3e-f408e452d15e",
                                                "sense_id": "be28fd1a-187e-3f89-bb6c-10b3431a79c4",
                                                "text": "„Das Berufungsgericht verwarf diese Rechtsrüge und pflichtete der Rechtsansicht des Erstgerichtes auch in diesem Punkte bei mit der Begründung, die Legitimation könne nur eintreten, wenn der Ehemann der Kindesmutter auch der voreheliche Erzeuger des legitimierten Kindes sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
