                ],
                "senses": [
                    {
                        "sense_id": "16b43b98-76a9-3d46-a1d9-85fee97cf10d",
                        "entry_id": "751b1ce9-f68f-35cc-bf26-2fff9a2a4a9a",
                        "glosses": [
                            "Enlever les bourgeons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7940caa4-b5e0-4758-9f56-369eb92e4283",
                                "sense_id": "16b43b98-76a9-3d46-a1d9-85fee97cf10d",
                                "text": "Le 10 août 1824, Aimée-Constance Debully, jeune fille de la commune d’Esteville, arrondissement d’Étampes, âgée de douze ans et demi, sortit de chez ses parens, vers quatre heures du soir, pour aller débourgeonner une pièce de vigne qu’ils possédaient à un quart de lieue du village, et près du bois de Sardion."
                            },
                            {
                                "example_id": "a38c0cfd-7177-4773-a9ab-e06ff2d8a3b0",
                                "sense_id": "16b43b98-76a9-3d46-a1d9-85fee97cf10d",
                                "text": "Par contre il faut prévoir de débourgeonner les cordons les premières années sinon c’est la galère à tailler."
                            },
                            {
                                "example_id": "c46b6a41-9667-48f4-94a3-146711bc806a",
                                "sense_id": "16b43b98-76a9-3d46-a1d9-85fee97cf10d",
                                "text": "\"Ce n’est qu’un simple retour aux méthodes ancestrales\", fait remarquer le viticulteur, qui s’apprête à débourgeonner ses vignes à la main."
                            }
                        ]
                    }
                ],
