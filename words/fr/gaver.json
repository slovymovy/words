            "senses": [
                {
                    "sense_id": "4cc58a81-5eaa-38b9-b6c8-ef8d072cecd0",
                    "sense_definition": "Manger avec excès jusqu'à satiété complète, souvent utilisé à la forme pronominale.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les fêtes, les enfants aiment se <w>gaver</w> de chocolat."
                        },
                        {
                            "text": "Il ne faut pas trop te <w>gaver</w> avant le dîner sinon tu n'auras plus faim."
                        }
                    ],
                    "common_phrases": [
                        "se gaver de bonbons",
                        "se gaver de chocolat"
                    ],
                    "traits": [
                        {
