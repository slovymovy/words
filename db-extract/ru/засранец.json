                    },
                    {
                        "sense_id": "3b4f0772-ea23-3743-a5d9-2f32453644b2",
                        "entry_id": "4e00aa52-7724-3737-9de7-45d8733103e2",
                        "glosses": [
                            "перен. дрянной, пакостный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40101299-e8ce-46c8-8698-253f9224067f",
                                "sense_id": "3b4f0772-ea23-3743-a5d9-2f32453644b2",
                                "text": "— Мы, твою мать, вайперы! — рявкнул один из засранцев обиженно."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f094f5ee-f13f-4c06-80b2-4b7c2be9d400",
                        "source_entry_id": "4e00aa52-7724-3737-9de7-45d8733103e2",
                        "source_sense_description": "тот, кто гадит, испражняется",
                        "target_lang_word": "asshole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asshole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                        "entry_id": "63070978-44d5-3291-b060-30a86c5c5973",
                                        "glosses": [
                                            "The anus."
                                        ],
                                        "tags": [
                                            "US",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e22bc8c-79b0-47e5-888e-d426b4178daf",
                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "That homemade hot sauce of yours got me twice, both coming and going. My asshole is still sore."
                                            },
                                            {
                                                "example_id": "0ae35788-f51d-453d-aefc-16728a4949fc",
                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "She said she couldn't wiggle when she had the doorknob in her asshole."
                                            },
                                            {
                                                "example_id": "4dfc3967-710a-4510-b926-fc3921d14092",
                                                "sense_id": "0347d304-e465-3d54-a5a6-0f5ddfa53b27",
                                                "text": "'You talk as if you were born without an asshole,' he cried to Commander Semmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                        "entry_id": "63070978-44d5-3291-b060-30a86c5c5973",
                                        "glosses": [
                                            "A jerk; an inappropriately or objectionably mean, inconsiderate, contemptible, obnoxious, intrusive, stupid, or rude person."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "offensive",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b94cd36-e88d-4247-8d17-fca45e6102a2",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "My former landlord was a world-class asshole. Fortunately my current landlord is an actual human being."
                                            },
                                            {
                                                "example_id": "d69d9665-4d26-4b33-ab57-cd5b74c5d739",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "He philosophised all day about Morandi, Klee, Miró and Picasso, and was such an asshole that he spelled \"cunt\" with a \"d\"."
                                            },
                                            {
                                                "example_id": "b5de761e-58a7-46f0-97a2-af14cc0c982f",
                                                "sense_id": "d08d66dd-a722-3517-842a-07b70b3850cc",
                                                "text": "They are the assholes for thinking they and their little crotch-spawn were special and exempt from the event guidelines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                        "entry_id": "63070978-44d5-3291-b060-30a86c5c5973",
                                        "glosses": [
                                            "Anything (especially a place) that is unpleasant or undesirable."
                                        ],
                                        "tags": [
                                            "US",
                                            "broadly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42ffc30d-ab70-4f73-b630-c433676de05e",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "Welcome to the Northeast, the asshole of America."
                                            },
                                            {
                                                "example_id": "c05f5f58-8b39-41e7-b9a7-37342502fea2",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "You oughta have better sense than to trust anyone with anything in this asshole place."
                                            },
                                            {
                                                "example_id": "aff5bdea-c700-4abb-aa59-a1386e1a99b7",
                                                "sense_id": "301fffa8-a29c-352f-8833-7897c9ff1a5f",
                                                "text": "... but when he started bugging the bartender to shut the asshole TV off because he wanted to have a serious discussion..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asshole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbb8720-3eac-35e1-b72d-c1fd4e5df148",
                                        "entry_id": "b184d425-ca60-3a95-aaa0-f84342b4479b",
                                        "glosses": [
                                            "A receptacle under a fire grate for collecting ashes."
                                        ],
                                        "tags": [
                                            "Northern-England",
                                            "Scotland",
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcd87ffd-3f66-40a5-b408-06aee1f4053f",
                                                "sense_id": "bbbb8720-3eac-35e1-b72d-c1fd4e5df148",
                                                "text": "Esshole, Asshole, the hole under the fire to hold ashes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be67498-3d5d-47ac-9928-0a0a43f40c00",
                        "source_entry_id": "4e00aa52-7724-3737-9de7-45d8733103e2",
                        "source_sense_description": "тот, кто гадит, испражняется",
                        "target_lang_word": "Scheißkerl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheißkerl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                        "entry_id": "1bccecff-fc3f-3e50-a94b-2668db10b7ee",
                                        "glosses": [
                                            "widerlicher, erbärmlicher Mann"
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d2c85cc-4cfa-49cc-834b-076b1739aa4c",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "Verpiss dich, du Scheißkerl!"
                                            },
                                            {
                                                "example_id": "360eba2d-0222-43ba-9552-35283b1c7082",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Der Duden sieht bei Fügungen mit dem als ‚derb‘ qualifizierten Wort ‚Scheiß‘ Zusammenschreibung vor und nennt als Beispiele: Scheißdreck, Scheißhaus, Scheißkerl, Scheißladen, Scheißwetter.“"
                                            },
                                            {
                                                "example_id": "37195cd5-3a29-49ff-8c1a-4d2e07dc3583",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Ich hoffe, der Scheißkerl ist in Kalifornien.“"
                                            },
                                            {
                                                "example_id": "54ea855c-7c27-43bb-a35e-2952645a3df0",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Der Scheißkerl fing an, ihm auf die Nerven zu gehen.“"
                                            },
                                            {
                                                "example_id": "792a0a19-a71d-4d1d-9759-0b4b4d1f9cf6",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Und da es in diesen Tagen eine ganze Menge Rattenlöcher und eine ganze Menge Scheißkerle auf der Welt gab, hatte die Delta Force alle Hände voll zu tun.“"
                                            },
                                            {
                                                "example_id": "d83cbba2-53ab-4581-b925-9475128cb28c",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Kann sein. Aber er ist trotzdem ein Lügner und ein Scheißkerl.“"
                                            },
                                            {
                                                "example_id": "cd0dd21a-85c8-436e-9104-a6a55d82d2f0",
                                                "sense_id": "b56e9239-bcab-3c27-b604-926b16555816",
                                                "text": "„Ich werde die Scheißkerle finden, die das getan haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
