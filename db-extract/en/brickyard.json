                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2166eaf4-c274-4813-91e4-3537d193c5bc",
                                                "sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                                                "text": "Ziegeleien verbrauchen für ihre Öfen Brennstoff und sehr großen Mengen."
                                            },
                                            {
                                                "example_id": "932764d7-83fe-4d9d-9952-86efd3f947eb",
                                                "sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                                                "text": "Die Ziegelei brennt in ihrem Ringofen rund um die Uhr."
                                            },
                                            {
                                                "example_id": "338233f1-3d33-4f94-8382-fd4df9013dfb",
                                                "sense_id": "d3bc65cd-17e5-33d7-9a12-494c5b2c570c",
                                                "text": "„Im ersten Jahr wurde sie als Strafarbeiterin in Nischni Tagil eingesetzt, im Straßenbau, in der Ziegelei, auch in der Gärtnerei.“"
                                            }
                                        ],
