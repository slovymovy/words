                "senses": [
                    {
                        "sense_id": "dccb22b0-7c79-30c7-a1f9-a644d9da8702",
                        "entry_id": "54851973-fd98-35fd-b9f5-be8259eb9f67",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным вдова; свойственный, характерный для неё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1c1e02e-5f1f-44b9-92bd-ed2b54b89f22",
                                "sense_id": "dccb22b0-7c79-30c7-a1f9-a644d9da8702",
                                "text": "Огороды назывались вдовьими потому, что их содержали две вдовы, мать и дочь."
                            },
                            {
                                "example_id": "a70d9336-065e-4ba3-b81f-dbc873b3ec20",
                                "sense_id": "dccb22b0-7c79-30c7-a1f9-a644d9da8702",
                                "text": "После смерти мужа Медея надела вдовьи одежды ― и поразила всех красотой и необыкновенным выражением мягкости, которого прежде в ней не замечали."
                            }
                        ]
                    }
