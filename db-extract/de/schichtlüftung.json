                "senses": [
                    {
                        "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                        "entry_id": "b0512ceb-7921-3c8b-9924-f529cd34a311",
                        "glosses": [
                            "verwirbelungsfreie Einbringung von Zuluft in einen Raum und schichtweise Verdrängung der belasteten Hallenluft durch thermischen Auftrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6b846e-e740-4770-9de5-7ad760189118",
                                "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                                "text": "„Das wesentliche Merkmal der Schichtlüftung ist, dass die aufgrund thermischer Auftriebskräfte aufsteigende Luft ungehindert zur Decke hin strömen kann und von dort über die Abluft an die Außenluft abgegeben werden kann.“"
                            },
                            {
                                "example_id": "e2d22f21-984a-4db9-a524-f30ea34b42fa",
                                "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                                "text": "„Schichtlüftung: Als besonders geeignet für die Belüftung von Industriehallen hat sich in den letzten Jahren die Schichtlüftung gezeigt.“"
                            },
                            {
                                "example_id": "06d5cfb7-f200-4e5b-ab46-ca634b8a3213",
                                "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                                "text": "„Schichtlüftung ist dann trotz rechnerisch kleiner Gleichgewichtshöhen möglich.“"
                            },
                            {
                                "example_id": "d4afaf7e-afc1-48ad-919a-fcfa3bf17153",
                                "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                                "text": "„Saubere Luft: Staub- und Rauchpartikel werden unter der Hallendecke erfasst und gefiltert im Bodenbereich zurück in die Halle geführt (Schichtlüftung).“"
                            },
                            {
                                "example_id": "3e833ce2-9167-4a42-8d04-dca56e40dbbe",
                                "sense_id": "8b0f2e18-f42d-3f09-bd94-653721710a82",
                                "text": "„Eine Schichtlüftung nutzt die Thermikströmung von Wärmequellen bei Arbeitsprozessen (Schichtströmung).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
