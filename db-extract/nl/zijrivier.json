                                            {
                                                "example_id": "4015110b-cde3-403c-ad52-57644a81ede7",
                                                "sense_id": "459d60fc-e7f5-30c0-a2b1-3dee772d6989",
                                                "text": "Le train du Northern Pacific n’y stationna qu’une couple d’heures, et n’eut plus qu’à descendre vers les plaines sillonnées par le cours de la Yellowstone et ses nombreux affluents."
                                            },
                                            {
                                                "example_id": "955835c2-e6ea-4e24-8400-9d0ce3f6ce87",
                                                "sense_id": "459d60fc-e7f5-30c0-a2b1-3dee772d6989",
                                                "text": "Au point de vue floristique, la vallée de la Lanterne et de ses affluents de droite essentiels représente une zone de passage entre la flore vosgienne silicicole des Ballons et la flore des terrains jurassiques."
                                            },
                                            {
                                                "example_id": "525077b9-3bfe-467b-a0c6-161ca64af498",
                                                "sense_id": "459d60fc-e7f5-30c0-a2b1-3dee772d6989",
                                                "text": "Aucune découverte préhistorique n'a été signalée à Sauvagny, sans doute par absence de prospection de ce terroir, de la vallée de l’Œil et de ses affluents, aux terrains légers qui, pourtant, conviennent à l’implantation d’habitats."
                                            },
                                            {
                                                "example_id": "3c9661bf-e1b4-4d50-b05c-4bbd4ebc38cc",
                                                "sense_id": "459d60fc-e7f5-30c0-a2b1-3dee772d6989",
                                                "text": "Affluent : Cours d’eau qui se jette dans un autre plus important ou dans un lac ; on dit aussi cours d’eau tributaire."
                                            }
                                        ]
                                    }
                                ]
                            },
