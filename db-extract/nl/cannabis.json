        "nl-extract.jsonl": [
            {
                "entry_id": "4ba1b21c-9880-30f0-a3cb-3350203d0c3b",
                "word": "cannabis",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                        "entry_id": "4ba1b21c-9880-30f0-a3cb-3350203d0c3b",
                        "glosses": [
                            "drug met als werkzame stof tetrahydrocannabinol (THC)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3275a637-9e41-4701-90b7-a19ec6cb2734",
                                "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                                "text": "Veel scholieren gebruiken cannabis."
                            },
                            {
                                "example_id": "1419ebae-adbb-4f3e-a7c2-6b0bc5704565",
                                "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                                "text": "Cannabis wordt gerekend tot de softdrugs."
                            },
                            {
                                "example_id": "8dff5b18-79ea-4f7f-81c2-b113cbd75bfc",
                                "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                                "text": "In de zuiveringsinstallaties werd het binnenkomende “ruwe rioolwater” onderzocht op sporen van vijf soorten drugs, namelijk cocaïne, cannabis, mdma, amfetamine (speed) en methamphetamine – laatstgenoemde kwam in geen van de gemeentes voor. Opvallend: het gebruik van cocaïne en cannabis ligt in deze gemeenten lager dan in bijvoorbeeld de steden Amsterdam en Utrecht, maar het gebruik van speed ligt in een aantal gemeenten fors hoger."
                            },
                            {
                                "example_id": "43e6be01-c3c0-4e87-a745-f6fd8ebf8e0f",
                                "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                                "text": "Ik wilde losbreken van mijn vaste gewoontes, en misschien zou cannabis me kunnen helpen om te relaxen in stressvolle tijden."
                            },
                            {
                                "example_id": "85224808-8cf7-455a-9b40-021e01df2932",
                                "sense_id": "28ce80df-3a6f-312f-97bf-8f375b6b0116",
                                "text": "Maar begin april werd alles wat Cusani opbouwde in één klap illegaal. In een nieuwe wet stelt het Italiaanse parlement hennep gelijk aan cannabis, waarvan de kweek verboden is. Zo'n achthonderd bedrijven, goed voor meer dan tienduizend werknemers, moeten daardoor de boeken sluiten."
                            }
                        ]
                    }
