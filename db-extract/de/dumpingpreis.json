                "senses": [
                    {
                        "sense_id": "b7010a86-5fb3-3092-94fa-90ef93527a23",
                        "entry_id": "ef5270bd-51da-3501-aed1-1deb48552cb0",
                        "glosses": [
                            "Preis, der die Kosten der Ware nicht deckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6a8a94b-3da8-44b5-abc4-4c9466bac634",
                                "sense_id": "b7010a86-5fb3-3092-94fa-90ef93527a23",
                                "text": "Mit Dumpingpreisen versuchen Firmen manchmal, ihre Konkurrenten vom Markt zu verdrängen."
                            },
                            {
                                "example_id": "5e67ca30-f7eb-46be-b0cd-7197f828d69a",
                                "sense_id": "b7010a86-5fb3-3092-94fa-90ef93527a23",
                                "text": "„Euroherc habe sich in Österreich vor allem auf die Versicherungen von Fuhrparks (Taxis, Carsharing etc.) spezialisiert und Kunden mit Dumpingpreisen angelockt. Gerade in diesen Segmenten sei die Schadenshäufigkeit groß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
