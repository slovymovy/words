                                "sense_id": "2453362e-8233-31bd-b6bb-51bea5644005",
                                "text": "Mrs. Flintwinch crossed the hall, feeling its pavement cold to her stockingless feet, and peeped in between the rusty hinges on the door, which stood a little open."
                            },
                            {
                                "example_id": "096f52bd-326b-4c2a-88bc-acaa94002aa2",
                                "sense_id": "2453362e-8233-31bd-b6bb-51bea5644005",
                                "text": "Her tremendous, flabby, stockingless ankles bulged over her unlaced hobnailed boots; her dress was torn and unbuttoned at the throat, displaying one of the dirtiest necks I have seen."
                            }
                        ]
                    }
