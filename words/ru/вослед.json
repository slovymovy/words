    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4e4294ff-dbfa-3ca2-a12f-b1b42bbbf939",
                    "sense_definition": "Непосредственно за кем-либо или чем-либо удаляющимся; следом.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Задумчиво безмолвный хан душой <w>вослед</w> ему стремится.",
                            "target_lang_translations": {
                                "de": "Nachdenklich und stumm strebt der Khan mit seiner Seele <w>hinterher</w>."
                            }
                        },
                        {
                            "text": "Он смотрел <w>вослед</w> уходящему поезду, надеясь увидеть знакомое лицо.",
                            "target_lang_translations": {
                                "de": "Er schaute dem abfahrenden Zug <w>hinterher</w> in der Hoffnung, ein bekanntes Gesicht zu sehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "вслед"
                    ],
                    "common_phrases": [
                        "смотреть вослед"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Direkt hinter jemandem oder etwas, das sich entfernt; hinterher."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hinterher",
                                "target_lang_sense_clarification": "allgemein für eine Bewegung hinter jemandem her"
                            },
                            {
                                "target_lang_word": "nach",
                                "target_lang_sense_clarification": "in Verbindung mit Verben der Bewegung, oft in gehobener Sprache"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ecb8d0d-a065-3c04-bf91-4d32b1b08491",
                    "sense_definition": "В направлении кого-либо или чего-либо удаляющегося.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А им <w>вослед</w> старуха крикнула обидное слово.",
                            "target_lang_translations": {
                                "de": "Und die alte Frau rief ihnen <w>hinterher</w> ein beleidigendes Wort zu."
                            }
                        },
                        {
                            "text": "Ветер летел <w>вослед</w> улетающим птицам.",
                            "target_lang_translations": {
                                "de": "Der Wind wehte den davonfliegenden Vögeln <w>hinterher</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "вслед"
                    ],
                    "common_phrases": [
                        "крикнуть вослед"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "устаревшее слово"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "In die Richtung von jemandem oder etwas, das sich entfernt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "hinterher",
                                "target_lang_sense_clarification": "in Richtung einer sich entfernenden Person oder Sache"
                            },
                            {
                                "target_lang_word": "nach",
                                "target_lang_sense_clarification": "gehoben, um die Richtung einer Handlung oder eines Blicks auszudrücken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}