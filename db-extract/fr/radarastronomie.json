                "senses": [
                    {
                        "sense_id": "1685eac2-07b9-3d63-852b-3b4448d172c6",
                        "entry_id": "2ef38320-a822-3922-8623-36988c9ff3d7",
                        "glosses": [
                            "Branche de l’astronomie qui étudie les astres en émettant vers eux des ondes radio puis en analysant les échos produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ece3068-ce5c-4db2-93ce-0c51ad38d7a4",
                                "sense_id": "1685eac2-07b9-3d63-852b-3b4448d172c6",
                                "text": "Ce ne fut que grâce à la technique de la radarastronomie et du radiotélescope d’Arecibo, le plus grand du monde, que la surface de l'astéroïde Cléopatra put être \"tâtée\"."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5aeb5c96-78ce-451a-b6d0-0f88e2cf2a3e",
                        "source_entry_id": "2ef38320-a822-3922-8623-36988c9ff3d7",
                        "source_sense_id": "1685eac2-07b9-3d63-852b-3b4448d172c6",
                        "target_lang_word": "Radarastronomie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radarastronomie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58dd0de8-aa4b-3539-a08d-d9ad570b8ede",
                                        "entry_id": "91f8485d-dd71-398d-9ffe-23a1aacaa782",
                                        "glosses": [
                                            "Teilgebiet der Astronomie, bei dem Radarstrahlen für die Erforschung von Himmelskörpern unseres Sonnensystems verwendet werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95655ec5-bdac-474d-b672-175fcf1c218f",
                                                "sense_id": "58dd0de8-aa4b-3539-a08d-d9ad570b8ede",
                                                "text": "„Ein junger Forschungszweig, die Radarastronomie, hat viele neue Erkenntnisse über die Planetenwelt gebracht, zum Beispiel die Existenz von Eis auf Merkur.“"
                                            },
                                            {
                                                "example_id": "1da32f6e-f6ba-467a-9327-9c9df24ac14a",
                                                "sense_id": "58dd0de8-aa4b-3539-a08d-d9ad570b8ede",
                                                "text": "„Die Radarastronomie beschäftigt sich im Gegensatz zur bekannteren Radioastronomie nicht mit der passiven Erforschung der von kosmischen Objekten ausgesandten Radiostrahlung, sondern mit dem aktiven Senden von Funkimpulsen zu nahen Himmelskörpern und der Untersuchung der reflektierten Signale (RADAR = Radio Detecting and Ranging).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
