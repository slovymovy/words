                "senses": [
                    {
                        "sense_id": "004770ad-16d6-3054-9a47-aa8dfea75906",
                        "entry_id": "50422fa3-497e-3b0c-9ee8-abfbd6226566",
                        "glosses": [
                            "to reprimand, to criticise (now usually connoting pedantry)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "544efcfb-2c10-4a27-9266-585e199d61d4",
                                "sense_id": "004770ad-16d6-3054-9a47-aa8dfea75906",
                                "text": "De leraar besloot de studenten streng te beleren over hun slordige werk.",
                                "translation": "The teacher decided to reprimand the students sternly for their sloppy work.",
                                "english": "The teacher decided to reprimand the students sternly for their sloppy work."
                            },
                            {
                                "example_id": "3ef2f2f2-4576-4118-8079-98fb9b1fe350",
                                "sense_id": "004770ad-16d6-3054-9a47-aa8dfea75906",
                                "text": "Hij heeft de neiging om anderen te beleren over hun fouten, wat soms als betuttelend wordt ervaren.",
                                "translation": "He has a tendency to criticize others for their mistakes, which is sometimes perceived as pedantic.",
                                "english": "He has a tendency to criticize others for their mistakes, which is sometimes perceived as pedantic."
                            },
                            {
                                "example_id": "20a3308c-987e-465d-839e-34d2f5dc0910",
                                "sense_id": "004770ad-16d6-3054-9a47-aa8dfea75906",
                                "text": "De oudere collega houdt ervan om zijn jongere collega's te beleren over de juiste werkwijze, zelfs als ze het al goed doen.",
                                "translation": "The older colleague enjoys lecturing his younger colleagues on the correct way of doing things, even when they are already doing it well.",
                                "english": "The older colleague enjoys lecturing his younger colleagues on the correct way of doing things, even when they are already doing it well."
                            }
                        ]
