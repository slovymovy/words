                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>absently</w> stirred his coffee while staring out the window at the rain.",
                            "target_lang_translations": {
                                "cs": "Zatímco hleděl z okna na déšť, <w>nepřítomně</w> si míchal kávu."
                            }
                        },
                        {
                            "text": "She <w>absently</w> played with her hair during the long and boring meeting.",
                            "target_lang_translations": {
                                "cs": "Během dlouhé a nudné schůze si <w>roztržitě</w> hrála s vlasy."
                            }
                        }
                    ],
                    "synonyms": [
                        "absent-mindedly",
                        "abstractedly"
                    ],
                    "common_phrases": [
                        "stare absently",
                        "nod absently",
                        "smile absently"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobem, který ukazuje, že člověk nevěnuje pozornost tomu, co se děje kolem něj, protože myslí na jiné věci."
                    },
                    "translations": {
                        "cs": [
                            {
