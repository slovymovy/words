                ],
                "senses": [
                    {
                        "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                        "entry_id": "0d0ca394-358c-3f14-b5a3-106e4eac4a5c",
                        "glosses": [
                            "größtes Sinnesorgan (Haut) von einem Elch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867ba4b8-9b01-4a27-8f9e-c582b77ee4f1",
                                "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                                "text": "„Sie kleiden sich in Röcke aus Biber- und Murmeltierfellen und Rentier- und Elchhäuten, die unten mit Troddeln verziert sind.“"
                            },
                            {
                                "example_id": "5e06fc1d-150c-432b-bf31-573be10edb9f",
                                "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                                "text": "„[…] im Westen galt die Elchhaut als hieb- und stichfest, […].“"
                            },
                            {
                                "example_id": "4f95dfc8-8798-46bc-bd35-fd2aae8b2d0a",
                                "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                                "text": "„So hat der Große Kurfürst von 1656 an streng darauf geachtet, daß alle ostpreußischen Elchhäute zubereitet, gegerbt und zu Kollern für seine Reuterregimenter verarbeitet wurden.“"
                            },
                            {
                                "example_id": "77ee5ddc-a4ea-4018-ae89-703399fab9a6",
                                "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                                "text": "„Wenn hier von Gerbern die Rede ist, so sind die Lohgerber gemeint, die Rinds- und Kalbsleder herstellten im Unterschied zu den Weißgerbern, die hauptsächlich Hirsch-, Schaf- oder Elchhäute bearbeiteten.“"
                            },
                            {
                                "example_id": "e465fde1-fa40-4dfe-b2d8-3b888340651a",
                                "sense_id": "1b18668c-363b-3d67-9e05-525611e8b2aa",
                                "text": "„Mit ihrem Überschuß an getrocknetem Lachs trieben sie Handel bis weit den Fluß hinauf und entlang der Küste und brachten Ziegenhaarroben, Elchhäute, Kanus, Sklaven und exotische Nahrungsmittel heim.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
