                "senses": [
                    {
                        "sense_id": "eadab605-f332-3b86-b8e7-de1894d3b7aa",
                        "entry_id": "93258fe6-cf2c-35d4-9928-3b417db78c92",
                        "glosses": [
                            "Fragment de pierre comme le marbre ou de terre cuite, employé dans les mosaïques de pavement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05db94b1-6a65-42bb-919b-5f62c6a9dbee",
                                "sense_id": "eadab605-f332-3b86-b8e7-de1894d3b7aa",
                                "text": "L’opus tesselatum emploie comme tesselles des abacules, c'est-à-dire des petits cubes de pierre, collés soit directement sur la surface à paver, soit sur un enduit intermédiaire."
                            },
                            {
                                "example_id": "6cafeba1-42f9-4e45-adb6-ca728c7af9c5",
                                "sense_id": "eadab605-f332-3b86-b8e7-de1894d3b7aa",
                                "text": "J’oubliais : il y avait aussi le problème du matériau, des tessons en émail de Briare. Ces tesselles, nous les rapportions par camions. Un jour c’était une benne de rouge, un autre une benne de bleu."
                            }
                        ]
                    },
                    {
                        "sense_id": "69a51d15-b4b5-3676-bdaa-ffe0d92a361d",
                        "entry_id": "93258fe6-cf2c-35d4-9928-3b417db78c92",
                        "glosses": [
                            "Petit élément de forme régulière utilisé en marqueterie."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
