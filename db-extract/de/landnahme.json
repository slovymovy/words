                "senses": [
                    {
                        "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                        "entry_id": "d6aff94e-7bf4-34bf-9358-31ad6be1f1ab",
                        "glosses": [
                            "Aneignung von fremdem Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9210c5-68f5-44e6-b30f-be4ecc4ab0fa",
                                "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                                "text": "„Diese Konkurrenz-Ideologie beschleunigt die Landnahme in Afrika.“"
                            },
                            {
                                "example_id": "ad56110b-4cdc-4b46-b0c1-fa5a484b8371",
                                "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                                "text": "„Die Idee der Überlegenheit und Zivilisierung waren vorgeschobene Argumente in einer systematischen Landnahme zum Vorteil der Siedlerkolonien.“"
                            },
                            {
                                "example_id": "9443f9bd-95a3-452e-8baf-43491b785923",
                                "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                                "text": "„Im Kern meint Kolonialismus den Prozess der Landnahme und Aufbau eines Herrschaftsverhältnisses durch einen Staat gegenüber einem anderen Staat oder einer Bevölkerungsgruppe fern vom angestammten Lebensraum.“"
                            },
                            {
                                "example_id": "63b878b7-b6f5-4027-bb7c-ab0e2315caf8",
                                "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                                "text": "„Hier endete infolgedessen auch die durch das bisherige europäische Völkerrecht bewirkte Hegung des Krieges und wurde der Kampf um die Landnahme hemmungslos.“"
                            },
                            {
                                "example_id": "afd08b71-7c79-4305-b9c7-830c683b540b",
                                "sense_id": "8aa240b9-cbd5-3324-8cb7-7d42c44cf10c",
                                "text": "„Damals hatte Kiew als Reaktion auf die Landnahme russischer und prorussischer Kräfte in der Ostukraine eine ‚Antiterroroperation‘ gestartet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
