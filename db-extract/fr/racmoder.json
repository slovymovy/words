                "senses": [
                    {
                        "sense_id": "3ef368a9-876b-3034-9e21-87e0bd73e560",
                        "entry_id": "f2e57adb-3490-39f4-98b7-665d4e9cfa4d",
                        "glosses": [
                            "Raccommoder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3814b0c-a2e7-4eb0-9537-dcf4ea32fbe4",
                                "sense_id": "3ef368a9-876b-3034-9e21-87e0bd73e560",
                                "text": "Ça qu’a d’ belles robes, ça met des chapiaux à fleûx, ça lit dans les livres, ça passe son temps à racmoder ses frusques."
                            },
                            {
                                "example_id": "0becef9a-c904-4fa3-82cd-7de4c7d78e0a",
                                "sense_id": "3ef368a9-876b-3034-9e21-87e0bd73e560",
                                "text": "J’ai là un bon poulet, ça va vous racmoder un brin l’estomac, quand vous allez avoi mis un verre de vin par là-dessus."
                            },
                            {
                                "example_id": "91721e59-0b0c-464f-bed2-25496f18c358",
                                "sense_id": "3ef368a9-876b-3034-9e21-87e0bd73e560",
                                "text": "Va cri mon parapluie qui doit être racmodé à la fin, dis au bon Dieu qu’i t’avoinde un fromage…"
                            }
                        ]
                    }
