    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67a36028-6d26-38a7-8f82-42ff36a5d7b4",
                    "sense_definition": "wypowiadać słowa lub wykonywać gesty na pożegnanie, rozstając się z kimś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę już <w>żegnać</w> gości, bo jest późno.",
                            "target_lang_translations": {
                                "ru": "Мне пора <w>прощаться</w> с гостями, потому что уже поздно."
                            }
                        },
                        {
                            "text": "Na dworcu przyszła pora, by <w>żegnać</w> przyjaciół.",
                            "target_lang_translations": {
                                "ru": "На вокзале пришло время <w>прощаться</w> с друзьями."
                            }
                        }
                    ],
                    "synonyms": [
                        "odprowadzać"
                    ],
                    "antonyms": [
                        "witać"
                    ],
                    "common_phrases": [
                        "żegnać gości"
                    ],
                    "target_lang_definitions": {
                        "ru": "говорить слова или совершать жесты при расставании с кем-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощаться",
                                "target_lang_sense_clarification": "обмениваться приветствиями при расставании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a08b5954-1491-324a-8eda-cb9168e6591a",
                    "sense_definition": "rozstawać się z kimś lub z czymś na dłuższy czas",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pożegnanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trudno było <w>żegnać</w> się z domem, w którym spędziłem dzieciństwo.",
                            "target_lang_translations": {
                                "ru": "Трудно было <w>прощаться</w> с домом, в котором я провел детство."
                            }
                        },
                        {
                            "text": "Sportowiec musiał <w>żegnać</w> się z marzeniami o medalu po kontuzji.",
                            "target_lang_translations": {
                                "ru": "После травмы спортсмену пришлось <w>расстаться</w> с мечтами о медали."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozstawać się"
                    ],
                    "target_lang_definitions": {
                        "ru": "расставаться с кем-то или чем-то на долгое время"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прощаться",
                                "target_lang_sense_clarification": "расставаться с чем-либо или кем-либо надолго или навсегда"
                            },
                            {
                                "target_lang_word": "расставаться",
                                "target_lang_sense_clarification": "прекращать отношения или покидать место"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1c1008-c5a1-3203-8385-c19c55454066",
                    "sense_definition": "czynić nad kimś znak krzyża",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "znak krzyża",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Matka <w>żegnała</w> swoje dziecko przed wyjściem do szkoły.",
                            "target_lang_translations": {
                                "ru": "Мать <w>крестила</w> своего ребенка перед уходом в школу."
                            }
                        },
                        {
                            "text": "Babcia <w>żegnała</w> wnuka znakiem krzyża na czole.",
                            "target_lang_translations": {
                                "ru": "Бабушка <w>крестила</w> внука, осеняя его крестным знамением на лбу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "осенять кого-либо крестным знамением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крестить",
                                "target_lang_sense_clarification": "осенять крестным знамением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2b73f62-c7dd-3326-814a-d0a9a6d5badb",
                    "sense_definition": "czynić nad sobą znak krzyża",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "znak krzyża",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wchodząc do kościoła, wierni <w>żegnają</w> się wodą święconą.",
                            "target_lang_translations": {
                                "ru": "Входя в церковь, верующие <w>крестятся</w> святой водой."
                            }
                        },
                        {
                            "text": "Przed trudną decyzją często <w>żegnam</w> się w myślach.",
                            "target_lang_translations": {
                                "ru": "Перед принятием трудного решения я часто <w>крещусь</w> про себя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "żegnać się znakiem krzyża"
                    ],
                    "target_lang_definitions": {
                        "ru": "осенять себя крестным знамением"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "креститься",
                                "target_lang_sense_clarification": "осенять себя крестным знамением"
                            }
                        ]
                    }
                }
            ]
        }
    ]
