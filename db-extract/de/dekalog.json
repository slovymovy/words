                    {
                        "sense_id": "33139534-1b73-33c0-a48a-600e1fbe5fbb",
                        "entry_id": "5ffa9e35-acd5-3cfc-8aeb-e18bf2530201",
                        "glosses": [
                            "die Zehn Gebote der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e1622b2-125c-4f80-b386-51a032120460",
                                "sense_id": "33139534-1b73-33c0-a48a-600e1fbe5fbb",
                                "text": "Im Dekalog gab JHWH seinem Volk Regeln."
                            },
                            {
                                "example_id": "1a8a9100-0c24-442e-a506-8ea331ad3fac",
                                "sense_id": "33139534-1b73-33c0-a48a-600e1fbe5fbb",
                                "text": "Der Bibel zufolge schrieb Gott persönlich den Dekalog auf zwei Steintafeln, die er Mose auf dem Berg Sinai gab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
