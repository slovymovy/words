                ],
                "senses": [
                    {
                        "sense_id": "ebec8d7c-f3e8-3305-80da-fd75a6c1a1c2",
                        "entry_id": "b8e24060-cab9-30a8-a1de-7dc5ca81849e",
                        "glosses": [
                            "Première personne du singulier de l’indicatif présent de allonger."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "1bb76562-a38f-4ac1-92fe-a17b3f5dcc31",
                                "sense_id": "ebec8d7c-f3e8-3305-80da-fd75a6c1a1c2",
                                "text": "Un peu plus tard, j’éteins la calbombe et m’allonge sur un canapé, non loin du radiateur."
                            }
                        ]
                    },
                    {
                        "sense_id": "dde4f86e-b624-31cf-8d02-bc2b012e6591",
                        "entry_id": "b8e24060-cab9-30a8-a1de-7dc5ca81849e",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent de allonger."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d2906a46-e0e6-4341-8867-f20c8310daf9",
                                "sense_id": "dde4f86e-b624-31cf-8d02-bc2b012e6591",
                                "text": "T’as raison, nada… surtout pas sa boîte d’allouffes qui était là trois secondes avant… alors le mec, il comprend que c’est toi qui viens de la chouriner, y t’allonge direct un coup de boule…"
                            },
                            {
                                "example_id": "6ffc44d3-e845-4751-883b-bc838efe9df9",
                                "sense_id": "dde4f86e-b624-31cf-8d02-bc2b012e6591",
                                "text": "La révolution s’allonge dans le temps, risque de se « giletjauniser », se radicalise dans sa demande et ne faiblit pas pour demander un départ total du régime et de son tutorat."
                            }
                        ]
                    },
                    {
                        "sense_id": "df8b2158-e737-3c9b-8606-6abf7e36b8ad",
                        "entry_id": "b8e24060-cab9-30a8-a1de-7dc5ca81849e",
                        "glosses": [
