                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f8d581b5-4bbe-32f5-ba43-5d66893302b3",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "A place related to fishing",
                            "A place where fish or other seafood are processed: a seafood factory."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7c2ffb1a-6c8a-3e09-b9c1-f7e0b6e98722",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "A right to fish in a particular location, such as territorial fishing waters."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c3de0b2b-87a3-36c0-b9e4-caf9129e5f6e",
                        "entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "glosses": [
                            "A fishing company."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdef7cfa-aa5e-48b5-9dd8-8e343a480262",
                        "source_entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "source_sense_description": "fishing",
                        "target_lang_word": "pêcherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pêcherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a32b64c-5345-3b12-adad-bda4cbdb029e",
                                        "entry_id": "ede29685-9c09-3e59-8dcd-88ec0d9fdc5f",
                                        "glosses": [
                                            "Lieu aménagé pour la pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c717a684-0ecf-4899-9140-cfc5fc0c96e1",
                                                "sense_id": "3a32b64c-5345-3b12-adad-bda4cbdb029e",
                                                "text": "Partout, dans l’eau verte des pêcheries, dans la houle des prairies, sous les fougères qui coupent, au creux des taillis se cachaient des trésors que je brûlais de découvrir."
                                            },
                                            {
                                                "example_id": "e51fc6f2-35b3-4349-8bd1-d3aae0a2ee10",
                                                "sense_id": "3a32b64c-5345-3b12-adad-bda4cbdb029e",
                                                "text": "Face au grand perron, il y avait une pêcherie où souvent des servantes lavaient du linge à grands coups de battoir ; une pelouse descendait en pente raide jusqu’à une bâtisse, plus ancienne que le château : la « maison d’en bas », remplie de harnais et de toiles d’araignée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f6ace0d-a15a-3357-8384-b69edd68fa7c",
                                        "entry_id": "ede29685-9c09-3e59-8dcd-88ec0d9fdc5f",
                                        "glosses": [
                                            "Lieu aménagé pour une entreprise de pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6230c041-0170-4033-b184-16912540bc4c",
                                                "sense_id": "3f6ace0d-a15a-3357-8384-b69edd68fa7c",
                                                "text": "Or, […] les pêcheries ne sont pas rares sur cette partie de l’Amérique septentrionale qui s’appelle la Nouvelle-Géorgie."
                                            },
                                            {
                                                "example_id": "089e30e2-0c90-4e44-ae6c-55905e4062f3",
                                                "sense_id": "3f6ace0d-a15a-3357-8384-b69edd68fa7c",
                                                "text": "La plupart des passagers sont des marchands danois qui vont visiter leurs comptoirs d’Islande ou leurs pêcheries des îles Féroë."
                                            },
                                            {
                                                "example_id": "6bf7f4fa-15b9-4e15-b5a6-940e8cd08860",
                                                "sense_id": "3f6ace0d-a15a-3357-8384-b69edd68fa7c",
                                                "text": "La répartition géographique des planctons, dont la connaissance est si utile aux pêcheries, conditionne la présence des dépôts sous-marins comme ces boues à Diatomées origine du tripoli."
                                            },
                                            {
                                                "example_id": "93a50b1f-8160-42f6-b3f0-9fcd1ca367ba",
                                                "sense_id": "3f6ace0d-a15a-3357-8384-b69edd68fa7c",
                                                "text": "Créée au XIIIᵉ siècle, la Ligue hanséatique organise les pêcheries de harengs et, en 1375, une norme standard est adoptée afin de faciliter les échanges de harengs salés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d273f42-2f09-36ba-9cf3-74e84ce7300a",
                                        "entry_id": "ede29685-9c09-3e59-8dcd-88ec0d9fdc5f",
                                        "glosses": [
                                            "Réservoir à bonde pour l’arrosement des prairies."
                                        ],
                                        "tags": [
                                            "Limousin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01ff048b-444f-40da-ae89-21c713426e06",
                                                "sense_id": "4d273f42-2f09-36ba-9cf3-74e84ce7300a",
                                                "text": "« Nom, dans la Creuse, de réservoirs à bonde qui servent à l’arrosement des prairies, » les Primes d’honneur, Paris, 1872, page 337"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70f871cf-06e7-4b8f-9362-e22416861694",
                        "source_entry_id": "ae3f6f82-3b01-3a52-aaad-9b5a1a866c6c",
                        "source_sense_description": "fishing",
                        "target_lang_word": "Fischerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fischerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb729cdf-f620-3f14-b07d-bb9d1a014446",
                                        "entry_id": "123409b1-2db1-3a54-81d2-4a1d698adba5",
                                        "glosses": [
                                            "das Fangen von Fischen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee18849e-5951-41b0-b5d5-0ae63365d18f",
                                                "sense_id": "cb729cdf-f620-3f14-b07d-bb9d1a014446",
                                                "text": "Die Fischerei- und Jagdverwaltung ist für die Erhaltung gesunder, den Lebensräumen angepasste Wild- und Fischbestände verantwortlich."
                                            },
                                            {
                                                "example_id": "882d81c3-d94d-48d1-9d8f-030cc7c491d8",
                                                "sense_id": "cb729cdf-f620-3f14-b07d-bb9d1a014446",
                                                "text": "„Jetzt spielt er diese Rolle perfekt gegenüber Gísli, der gern mit Menschen über die Fischerei spricht, die in dem Thema bewandert sind, und das scheint dieser Pastor zu sein, er kennt sich offenbar aus, benutzt die richtigen Wörter und stellt die richtigen Fragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cac527dc-faff-3ddd-b546-3cd35e647766",
                                        "entry_id": "123409b1-2db1-3a54-81d2-4a1d698adba5",
                                        "glosses": [
                                            "Betrieb, der [1] betreibt und weiterverarbeitet und/oder Handeln mit dem Fang macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6656da6-3707-47a3-bb28-3d27e403a8af",
                                                "sense_id": "cac527dc-faff-3ddd-b546-3cd35e647766",
                                                "text": "Bei der Fischerei Gottfried H. kann man auch telefonisch Sushi bestellen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6cfd22f9-3033-36cf-88b7-cb558030dddb",
                                        "entry_id": "123409b1-2db1-3a54-81d2-4a1d698adba5",
                                        "glosses": [
                                            "Personen oder Gegenstände für einen bestimmten Zweck sammeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdb89a3-ebc7-4861-b749-85d70a679b38",
                                                "sense_id": "6cfd22f9-3033-36cf-88b7-cb558030dddb",
                                                "text": "Um Kunden für das Unternehmen zu bekommen, wird die Fischerei potenzieller Käufer durch die Werbung gefördert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
