                        ]
                    },
                    {
                        "translation_id": "04374f01-947a-42a7-8813-e29e3fde7241",
                        "source_entry_id": "a7f86c43-fda8-3346-9ae0-0df8de9ca814",
                        "target_lang_word": "Plünderung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Plünderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                        "entry_id": "b2d1473e-17dd-3d27-bc20-27363cd57705",
                                        "glosses": [
                                            "illegale Aneignung fremden Hab und Gutes unter Gewalt oder Androhung derselben beziehungsweise unter Ausnutzung bestimmter Notsituationen wie zum Beispiel Naturkatastrophen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dabb142f-8692-4fac-905b-19f54729effd",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "Nachdem die öffentliche Ordnung zusammengebrochen war, nahmen die Plünderungen zu."
                                            },
                                            {
                                                "example_id": "3a35b0b2-afeb-4b6f-bddb-abc35144ddb1",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "Was hältst du von einer Plünderung des Kühlschranks? Ich habe einen Bärenhunger."
                                            },
                                            {
                                                "example_id": "38e39996-a121-4ab9-a78e-1db38c9519cf",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "„Keltische Kriegerscharen fielen, von Gallien kommend, in Italien ein, die Römer stellten sich ihnen in der Schlacht an der Allia und erlitten eine katastrophale Niederlage. Sie hatten den Kelten nun nichts mehr entgegenzusetzen und mußten die Einnahme und Plünderung ihrer Stadt hinnehmen.“"
                                            },
                                            {
                                                "example_id": "95ff91c6-7265-4982-9795-7d4bd311545d",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "„Jugendliche, die in die Wälder geflüchtet waren, versuchen mit zurückgelassenen Waffen der Wehrmacht, die Plünderungen und Vergewaltigungen im Dorf zu verhindern.“"
                                            },
                                            {
                                                "example_id": "b8524687-b112-4d8c-bd69-9f1d93de1dbb",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "„Aber die Plünderung war schon im Gange.“"
                                            },
                                            {
                                                "example_id": "a588584b-e84e-495d-adc3-00cc61b68ba6",
                                                "sense_id": "1c0b006b-e017-3ae9-a093-6afc4020dfdc",
                                                "text": "„In vielen Städten des britischen Empires bis hin nach Südafrika kam es derweil zu Plünderungen in Läden mit deutsch klingenden Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee6028ef-8cbf-4ae3-8cb2-eee9c7bd863c",
                        "source_entry_id": "a7f86c43-fda8-3346-9ae0-0df8de9ca814",
                        "target_lang_word": "Diebstahl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diebstahl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                        "entry_id": "dac034cd-f8ce-3b18-9fcf-db67ca822d32",
                                        "glosses": [
                                            "heimliche Entwendung fremden Eigentums"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20a98857-0cf9-4b5b-8be7-85438c09ba4a",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "Mein Laptop ist gegen Diebstahl versichert."
                                            },
                                            {
                                                "example_id": "88dcfbe3-e034-4051-acb2-8f759add36ae",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Der Reihe nach bekannten sie sich zu Diebstählen oder tätlichen Angriffen mit und ohne Waffengewalt.“"
                                            },
                                            {
                                                "example_id": "c80f8e75-70fc-4bd4-bfab-f106ef0ac10f",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Die Dubois wurde wegen Diebstahls verhaftet und ins Gefängnis von Nantes gebracht, und zwar in die Abteilung für gewöhnliche Kriminelle, die von den politischen Gefangenen strikt getrennt war.“"
                                            },
                                            {
                                                "example_id": "b6ee5516-7118-421d-81bc-4d03ec52ec73",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Auch Diebstahl aus Hunger verstößt gegen das 7. Gebot, hatte er gelernt.“"
                                            },
                                            {
                                                "example_id": "e5c2fd49-8092-4fb6-9dfe-024e9c43e6ab",
                                                "sense_id": "853722d5-4281-3a11-b39f-b5fe4be6559e",
                                                "text": "„Das hätte mich meine Ehre gekostet, wenn es nicht meinem Scharfsinn gelungen wäre, ihn eines Diebstahls zu überführen, für den man andernfalls mich verantwortlich gemacht hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a45cffa7-90b3-3aa4-a245-67be6dac7a33",
                                        "entry_id": "dac034cd-f8ce-3b18-9fcf-db67ca822d32",
                                        "glosses": [
                                            "Wegnahme einer fremden beweglichen Sache in Zueignungsabsicht"
                                        ],
                                        "tags": [
                                            "deutsches und österreichisches Strafrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0c0a61d-76cd-473b-ac67-5800f4040ad1",
                                                "sense_id": "a45cffa7-90b3-3aa4-a245-67be6dac7a33",
                                                "text": "Herr Müller wurde wegen Diebstahls zu einer Geldstrafe verurteilt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "388a731b-15f4-4841-8364-d381113cfcca",
                        "source_entry_id": "a7f86c43-fda8-3346-9ae0-0df8de9ca814",
                        "target_lang_word": "Raub",
