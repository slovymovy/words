                        "entry_id": "ffbeb812-8873-30c6-8184-fcf88041353a",
                        "glosses": [
                            "a state that doesn't obey the rule of law and in which the powerholders exercise their power arbitrarily at will"
                        ],
                        "tags": [
                            "masculine",
                            "mixed"
                        ],
                        "examples": [
                            {
