                                                "sense_id": "05f1039a-54df-3c13-82ca-f048b44ecf2e",
                                                "text": "Das Acroleinmolekül enthält eine Doppelbindung und eine Aldehydgruppe."
                                            },
                                            {
                                                "example_id": "ca74245b-070d-41f7-b742-61889431aa03",
                                                "sense_id": "05f1039a-54df-3c13-82ca-f048b44ecf2e",
                                                "text": "Acrolein ist sehr reaktiv."
                                            },
                                            {
                                                "example_id": "8b387c2e-520f-47fa-8d7b-872ac2626ac3",
                                                "sense_id": "05f1039a-54df-3c13-82ca-f048b44ecf2e",
                                                "text": "„Acrolein entsteht auch beim Überhitzen pflanzlicher und tierischer Fette, zum Beispiel beim Frittieren.“"
                                            }
