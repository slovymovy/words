                "senses": [
                    {
                        "sense_id": "bd3ddff3-b6c9-370d-91a9-545fb4a5615d",
                        "entry_id": "1dcafd83-63ac-327c-92a2-11b2224a31a2",
                        "glosses": [
                            "Suppe mit Fleischeinlage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3acf06e-b92e-41a1-b813-53280de31822",
                                "sense_id": "bd3ddff3-b6c9-370d-91a9-545fb4a5615d",
                                "text": "„Für die Erwachsenen gibt es eine kräftige Fleischsuppe, für die Kinder einen süßen Grießbrei und warme Milch.“"
                            },
                            {
                                "example_id": "7896577f-73c9-4a2a-8457-892a76abb61d",
                                "sense_id": "bd3ddff3-b6c9-370d-91a9-545fb4a5615d",
                                "text": "„Und pünktlich zum ersten Wintertag ist es auch richtig kalt geworden. Ein Feiertag ist es nicht, aber immerhin laden die Geschäftsleute auf der Skólavörðustígur an diesem Tag zu einer herzhaften Fleischsuppe ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
