                                "target_senses": [
                                    {
                                        "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                        "entry_id": "4996e0cb-fa07-363d-a1af-1354dffa5984",
                                        "glosses": [
                                            "Wald, der vorwiegend oder ausschließlich aus Kiefernbäumen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb7e8acb-b891-48c5-b0ad-b2a47a806947",
                                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                                "text": "Oben im Kiefernwald gibt es eine alte Holzhütte."
                                            },
                                            {
                                                "example_id": "7d5dfd3c-4122-485c-80d5-002e78e50b41",
                                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                                "text": "„Ein Team mit österreichischer Beteiligung hat diese Verbindungen nun in einem fast unberührten Kiefernwald erfasst.“"
                                            },
                                            {
                                                "example_id": "828ba1a9-6cf7-4b3a-9053-a10d9638ffc1",
                                                "sense_id": "a6b7cf54-48e2-3d02-8027-808c0c7ad3b8",
                                                "text": "„Er blickt hinüber zu den Nudisten, die in den Dünen am Rand des Kiefernwaldes liegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "808d3845-1d40-4554-b733-785f33efdf41",
