    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2e4de89c-8c70-3229-9e1a-f4b9684f0e41",
                    "sense_definition": "In a sitting position; not standing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please remain <w>seated</w> until the bus comes to a complete stop.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставайтесь <w>на своих местах</w>, пока автобус полностью не остановится.",
                                "zh": "在公交车完全停稳前，请保持<w>坐着</w>。"
                            }
                        },
                        {
                            "text": "The audience was <w>seated</w> and waiting for the show to begin.",
                            "target_lang_translations": {
                                "ru": "Зрители <w>заняли места</w> и ждали начала шоу.",
                                "zh": "观众已经<w>就座</w>，等待演出开始。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sitting"
                    ],
                    "antonyms": [
                        "standing"
                    ],
                    "common_phrases": [
                        "remain seated",
                        "please be seated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в сидячем положении; не стоящий.",
                        "zh": "处于坐姿；没有站立。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сидящий",
                                "target_lang_sense_clarification": "находящийся в положении сидя"
                            },
                            {
                                "target_lang_word": "сидя",
                                "target_lang_sense_clarification": "наречие, часто используется в фразах типа 'оставаться сидя'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坐着",
                                "target_lang_sense_clarification": "处于坐下的状态"
                            },
                            {
                                "target_lang_word": "就座",
                                "target_lang_sense_clarification": "坐在座位上"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83468747-f46d-3760-90d2-bbfcc599a901",
                    "sense_definition": "Firmly established or deeply rooted in one's nature or mind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fixed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a deep-<w>seated</w> fear of flying that prevents him from traveling.",
                            "target_lang_translations": {
                                "ru": "У него глубоко <w>укоренившийся</w> страх полетов, который мешает ему путешествовать.",
                                "zh": "他有一种<w>根深蒂固的</w>飞行恐惧症，这使他无法旅行。"
                            }
                        },
                        {
                            "text": "The conflict was <w>seated</w> in centuries of political tension.",
                            "target_lang_translations": {
                                "ru": "Конфликт <w>коренился</w> в вековой политической напряженности.",
                                "zh": "这场冲突<w>根源于</w>几个世纪以来的政治紧张局势。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ingrained",
                        "fixed",
                        "established"
                    ],
                    "common_phrases": [
                        "deep-seated"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочно укоренившийся или глубоко заложенный в характере или сознании.",
                        "zh": "在性格或思想中根深蒂固的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укоренившийся",
                                "target_lang_sense_clarification": "прочно вошедший в привычку или сознание"
                            },
                            {
                                "target_lang_word": "глубокий",
                                "target_lang_sense_clarification": "в контексте 'deep-seated' (глубоко скрытый)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "根深蒂固的",
                                "target_lang_sense_clarification": "形容思想或习惯难以改变"
                            },
                            {
                                "target_lang_word": "深层的",
                                "target_lang_sense_clarification": "指隐藏在内心深处的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a08f361-fc47-3cf2-9127-84c2ad097ab6",
                    "sense_definition": "Situated or located in a specific place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The infection appears to be <w>seated</w> in the lungs.",
                            "target_lang_translations": {
                                "ru": "Инфекция, по-видимому, <w>локализуется</w> в легких.",
                                "zh": "感染似乎<w>位于</w>肺部。"
                            }
                        },
                        {
                            "text": "The company's headquarters are <w>seated</w> in the financial district.",
                            "target_lang_translations": {
                                "ru": "Штаб-квартира компании <w>расположена</w> в финансовом районе.",
                                "zh": "公司总部<w>坐落于</w>金融区。"
                            }
                        }
                    ],
                    "synonyms": [
                        "located",
                        "situated"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный или находящийся в определенном месте.",
                        "zh": "位于或坐落于特定地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расположенный",
                                "target_lang_sense_clarification": "находящийся в конкретном месте"
                            },
                            {
                                "target_lang_word": "находящийся",
                                "target_lang_sense_clarification": "пребывающий где-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "位于",
                                "target_lang_sense_clarification": "处于某处"
                            },
                            {
                                "target_lang_word": "坐落于",
                                "target_lang_sense_clarification": "指建筑物或机构的位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "731bfd4c-4841-31b4-8c12-4bd0a4f53438",
                    "sense_definition": "Furnished with a specific type of seat.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room contained only a simple rush-<w>seated</w> chair.",
                            "target_lang_translations": {
                                "ru": "В комнате был только простой стул с плетеным <w>сиденьем</w>.",
                                "zh": "房间里只有一把简单的灯芯草<w>座</w>椅子。"
                            }
                        },
                        {
                            "text": "They bought a set of cane-<w>seated</w> stools for the kitchen.",
                            "target_lang_translations": {
                                "ru": "Они купили набор табуретов с тростниковыми <w>сиденьями</w> для кухни.",
                                "zh": "他们为厨房买了一套藤<w>座</w>凳子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оснащенный сиденьем определенного типа.",
                        "zh": "配有特定类型的座位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с ... сиденьем",
                                "target_lang_sense_clarification": "используется в составе сложных прилагательных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "……座的",
                                "target_lang_sense_clarification": "用于描述椅子的座面材质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4a9ac87-eb89-3f85-a294-a7d9d74aea15",
