                "senses": [
                    {
                        "sense_id": "a1e8a4ff-e5ad-35a8-9c8a-ca90f87ff36a",
                        "entry_id": "67d088e9-1bee-3dd6-88f8-ea1ac222cb51",
                        "glosses": [
                            "nachträgliche Behandlung von Abgas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e7a6d52-fdd2-4065-8bd7-18fbcc994e4f",
                                "sense_id": "a1e8a4ff-e5ad-35a8-9c8a-ca90f87ff36a",
                                "text": "„Insgesamt verringert sich beim Direkteinspritzer der Kraftstoffverbrauch, auf Grund höherer Temperaturen im Brennraum bilden sich aber mehr Stickoxide; dies macht eine Abgasnachbehandlung erforderlich.“"
                            },
                            {
                                "example_id": "5ec4c431-4e26-4290-adee-c628eea6c51d",
                                "sense_id": "a1e8a4ff-e5ad-35a8-9c8a-ca90f87ff36a",
                                "text": "„Eine Abgasnachbehandlung mittels Oxidationskatalysatoren und Partikelfiltern reduziert heute alle gesetzlich limitierten Schadstoffe – mit Ausnahme der Stickoxide – bis an die versuchstechnische Nachweisgrenze.“"
                            },
                            {
                                "example_id": "2abe7180-e895-4136-be60-1d751c2c7c1e",
                                "sense_id": "a1e8a4ff-e5ad-35a8-9c8a-ca90f87ff36a",
                                "text": "„Platin wird häufig als Katalysator verwandt, um Oxidationsreaktionen zu beschleunigen, zum Beispiel bei der Abgasnachbehandlung in Autos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
