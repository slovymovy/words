                                                "example_id": "499c970c-7bb2-4dc4-9e11-505fdfa0f0d5",
                                                "sense_id": "1a8110f2-4678-35ec-a763-3bfa33b5153d",
                                                "text": "Dieses Textverarbeitungsprogramm stellt strukturierte Information in Form eines problemorientierten Thesaurus bereit."
                                            }
                                        ],
