                                "target_senses": [
                                    {
                                        "sense_id": "e26ecb09-2a05-303d-841e-db9909c2e61b",
                                        "entry_id": "2bf9ceb8-97c3-3ee3-8ea8-22922bdea227",
                                        "glosses": [
                                            "Personne éprouvant une attirance sexuelle envers les animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0008f1b-8692-46d4-a4cd-64b1b5061fdf",
                                                "sense_id": "e26ecb09-2a05-303d-841e-db9909c2e61b",
                                                "text": "Le zoophile devra respecter une probation de trois ans et se soumettre à un prélèvement d’ADN."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "zoophile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ff2e1fc-66d5-3264-bfa1-1366ca2251ef",
                                        "entry_id": "bbb0f28a-8651-3c10-b669-258dccd261e7",
                                        "glosses": [
                                            "Qui éprouve une attirance sexuelle envers les animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b561b16b-d1e8-4ee6-8461-60455ac53f33",
                                                "sense_id": "0ff2e1fc-66d5-3264-bfa1-1366ca2251ef",
                                                "text": "L’obsession de l’identité sexuelle est si forte que j’ai même rencontré une ado qui pensait qu’elle était zoophile parce qu’elle avait un élan d’affection pour son chien !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645d8613-9fdb-3ba5-b8cb-1657defc81a5",
                                        "entry_id": "bbb0f28a-8651-3c10-b669-258dccd261e7",
                                        "glosses": [
                                            "En rapport avec la zoophilie, qui concerne la zoophilie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee27155c-9fea-4241-a932-e2fc5ff5005d",
                                                "sense_id": "645d8613-9fdb-3ba5-b8cb-1657defc81a5",
                                                "text": "Des tendances zoophiles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a836828b-10dc-317b-bb37-2413ebf356ef",
                                        "entry_id": "bbb0f28a-8651-3c10-b669-258dccd261e7",
                                        "glosses": [
                                            "Se dit des plantes utilisant les animaux comme vecteur du pollen pour leur fécondation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f1e2debb-6b90-3e85-81e4-5f8df6374784",
                                        "entry_id": "bbb0f28a-8651-3c10-b669-258dccd261e7",
                                        "glosses": [
                                            "Qui aime les animaux, ou qui concerne l’amour des animaux."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c600e38d-b76a-362f-b25a-bbf29865e4b6",
                                        "entry_id": "bbb0f28a-8651-3c10-b669-258dccd261e7",
                                        "glosses": [
                                            "Qui défend la cause des animaux."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5837b108-b96b-4947-a6b2-7feff171fce1",
                                                "sense_id": "c600e38d-b76a-362f-b25a-bbf29865e4b6",
                                                "text": "J'étais assez content de ma réponse qui serait, à mes yeux, quelques bonnes pages de propagande zoophile."
                                            },
                                            {
                                                "example_id": "57e25555-3fc9-4d6c-81e8-e6dda8d9aae4",
                                                "sense_id": "c600e38d-b76a-362f-b25a-bbf29865e4b6",
                                                "text": "Si donc quelqu’un s’avisait, poussé mettons par une mentalité végétarienne, de voussoyer une vache (parfaitement conscient du fait que l’on manque plus facilement d’égards à un être que l’on tutoie), on le traiterait aussitôt de sot ou même de fou ; non pas à cause de sa mentalité végétarienne ou zoophile, laquelle est jugée « profondément humaine », mais bien parce qu’il l’aurait transposée dans le réel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
