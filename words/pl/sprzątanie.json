    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "add04613-72e6-3f5c-b1d8-c68a8933b35c",
                    "sense_definition": "czynność polegająca na przywracaniu porządku i czystości w jakimś pomieszczeniu lub miejscu",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "czystosc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W każdą sobotę rano cała nasza rodzina zajmuje się dokładnym <w>sprzątaniem</w> domu.",
                            "target_lang_translations": {
                                "ru": "Каждое субботнее утро вся наша семья занимается тщательной <w>уборкой</w> дома."
                            }
                        },
                        {
                            "text": "Przed świętami czeka nas generalne <w>sprzątanie</w> wszystkich szaf i podłóg.",
                            "target_lang_translations": {
                                "ru": "Перед праздниками нас ждёт генеральная <w>уборка</w> всех шкафов и полов."
                            }
                        }
                    ],
                    "synonyms": [
                        "porządkowanie"
                    ],
                    "common_phrases": [
                        "generalne sprzątanie",
                        "wiosenne sprzątanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "наведение чистоты и порядка в помещении или каком-либо месте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборка",
                                "target_lang_sense_clarification": "наведение порядка и чистоты"
                            },
                            {
                                "target_lang_word": "наведение порядка",
                                "target_lang_sense_clarification": "процесс раскладывания вещей и очистки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62b77ac3-4853-3e76-a7a1-883c2cbc7fad",
                    "sense_definition": "usuwanie, zabieranie lub odkładanie na właściwe miejsce rzeczy niepotrzebnych lub rozrzuconych",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "usuwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po skończonym obiedzie kelner natychmiast przystąpił do <w>sprzątania</w> brudnych naczyń ze stołu.",
                            "target_lang_translations": {
                                "ru": "После окончания обеда официант сразу приступил к <w>уборке</w> грязной посуды со стола."
                            }
                        },
                        {
                            "text": "Dzieci zaczęły wreszcie <w>sprzątanie</w> swoich zabawek z dywanu.",
                            "target_lang_translations": {
                                "ru": "Дети наконец-то начали <w>убирать</w> свои игрушки с ковра."
                            }
                        }
                    ],
                    "synonyms": [
                        "uprzątanie"
                    ],
                    "common_phrases": [
                        "sprzątanie ze stołu"
                    ],
                    "target_lang_definitions": {
                        "ru": "перемещение, убирание или раскладывание по местам ненужных или разбросанных вещей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убирание",
                                "target_lang_sense_clarification": "процесс перемещения вещей с одного места"
                            },
                            {
                                "target_lang_word": "уборка",
                                "target_lang_sense_clarification": "убирание предметов со стола, пола и т. п."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af64ceb6-0bd7-31e9-a24f-dbb1560a3d5d",
                    "sense_definition": "zbieranie plonów, zbóż lub innych płodów rolnych z pola",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rolnictwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rolnicy z naszej wsi zakończyli już <w>sprzątanie</w> zboża przed nadejściem ulewnych deszczy.",
                            "target_lang_translations": {
                                "ru": "Фермеры из нашей деревни уже завершили <w>уборку</w> зерна до наступления проливных дождей."
                            }
                        },
                        {
                            "text": "W sierpniu zawsze zaczyna się intensywne <w>sprzątanie</w> słomy z pól.",
                            "target_lang_translations": {
                                "ru": "В августе всегда начинается интенсивная <w>уборка</w> соломы с полей."
                            }
                        }
                    ],
                    "synonyms": [
                        "zbiór",
                        "zwózka",
                        "sprzęt"
                    ],
                    "common_phrases": [
                        "sprzątanie zbóż",
                        "sprzątanie plonów"
                    ],
                    "target_lang_definitions": {
                        "ru": "сбор сельскохозяйственных культур, зерна или других плодов с полей"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уборка",
                                "target_lang_sense_clarification": "сбор урожая, хлеба или зерновых"
                            },
                            {
                                "target_lang_word": "сбор",
                                "target_lang_sense_clarification": "сбор урожая"
                            },
                            {
                                "target_lang_word": "жатва",
                                "target_lang_sense_clarification": "уборка злаковых культур"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}