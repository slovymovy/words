                "senses": [
                    {
                        "sense_id": "bc4a7510-faf5-337a-80c9-2ee9f2f3c0ab",
                        "entry_id": "7678fefd-0957-3058-a7dd-ac79e5af6092",
                        "glosses": [
                            "female equivalent of мучи́тель (mučítelʹ): female tormenter"
                        ],
                        "tags": [
                            "feminine",
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "de7ed1a3-ea3a-4a0b-b5bf-812092895d88",
                                "sense_id": "bc4a7510-faf5-337a-80c9-2ee9f2f3c0ab",
                                "text": "Я всё же знал, что протяни́ я ру́ку под свою́ поду́шку — коне́ц верёвки ока́жется в мои́х рука́х, набро́сить петлю́ на ря́дом лежа́щую ма́ленькую голо́вку мое́й мучи́тельницы ничего́ не сто́ило.",
                                "translation": "Despite all, I knew that if I reached under my pillow the end of the rope would be in my hands; it would be nothing to throw the noose over the head of the little tormentress lying beside me.",
                                "english": "Despite all, I knew that if I reached under my pillow the end of the rope would be in my hands; it would be nothing to throw the noose over the head of the little tormentress lying beside me."
                            }
                        ]
                    }
                ],
