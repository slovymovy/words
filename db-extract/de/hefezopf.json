                                "example_id": "a3ede052-caf0-49d2-9274-35d7843a3ee3",
                                "sense_id": "6a2211a7-c2c7-344f-9c83-b71f13310b47",
                                "text": "In diesem Hefezopf sind besonders viele Rosinen."
                            },
                            {
                                "example_id": "8fb0e969-801c-490d-855c-619765899002",
                                "sense_id": "6a2211a7-c2c7-344f-9c83-b71f13310b47",
                                "text": "„Der Obmann ruft den Dank der Katzenmusikanten aus und schon laben wir uns an Hefezopf und belegtem Brot mit Schinken und Ei, es gibt Weinschorle und Bier, alles nicht zu knapp.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
