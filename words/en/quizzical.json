                {
                    "sense_id": "3dabf91a-58a2-3c61-a5bc-b38f280baf5f",
                    "sense_definition": "Expressing mild puzzlement, curiosity, or questioning amusement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tilted her head and gave him a <w>quizzical</w> look when he claimed to be finished.",
                            "target_lang_translations": {
                                "ru": "Она склонила голову и бросила на него <w>недоуменный</w> взгляд, когда он заявил, что закончил."
                            }
                        },
                        {
                            "text": "The detective raised a <w>quizzical</w> eyebrow at the suspect's unlikely story.",
                            "target_lang_translations": {
                                "ru": "Детектив <w>вопросительно</w> поднял бровь, услышав неправдоподобную историю подозреваемого."
                            }
                        }
                    ],
