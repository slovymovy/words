                        "glosses": [
                            "einer gesamten Mannschaft zugerechnetes Foul, wobei es ab einer bestimmten Anzahl besondere Strafmaßnahmen gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5efa8b9-1f16-449f-afe5-04621e0ccdb6",
                                "sense_id": "089d9e9a-04bf-378f-8116-4ad296f950c6",
                                "text": "„Bei zehn Teamfouls erhält die gegnerische Mannschaft einen Penalty, danach bei jedem fünften.“"
                            },
                            {
                                "example_id": "f0554b3b-ecd4-4abc-bf59-ab6bfc6603d8",
                                "sense_id": "089d9e9a-04bf-378f-8116-4ad296f950c6",
                                "text": "„Ein technisches Foul gegen einen Trainer und sonstigen Angehörigen der Mannschaft zählt nicht als Teamfoul.“"
                            }
                        ],
