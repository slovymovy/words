                "senses": [
                    {
                        "sense_id": "784e777e-a0f5-3fdc-8f76-5e4d71ae07e6",
                        "entry_id": "498ba982-5cc1-359d-b126-c2ea5f3d4fe3",
                        "glosses": [
                            "człowiek nierozgarnięty, ograniczony, niezdatny do niczego"
                        ],
                        "tags": [
                            "scornfully"
                        ],
                        "examples": [
                            {
                                "example_id": "35b23a10-c306-4362-af58-d5c642713fa5",
                                "sense_id": "784e777e-a0f5-3fdc-8f76-5e4d71ae07e6",
                                "text": "Nazwała go jełopem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e696f2c-d586-4d8e-86b9-e6393c9ed816",
                        "source_entry_id": "498ba982-5cc1-359d-b126-c2ea5f3d4fe3",
                        "source_sense_id": "784e777e-a0f5-3fdc-8f76-5e4d71ae07e6",
                        "target_lang_word": "балбес",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "балбес",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5361d0d3-3781-349a-9242-35f3f177a355",
                                        "entry_id": "25247393-f4ff-34ed-aaa8-caf34fcc16b4",
                                        "glosses": [
                                            "разг. бестолковый, тупой человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98108940-89f6-47c1-b10e-9a6bc836213d",
                                                "sense_id": "5361d0d3-3781-349a-9242-35f3f177a355",
                                                "text": "Старший — Артамон — умный был детина, средний — Степан — был и так и сяк, а младший — Никита — нельзя сказать, чтобы вовсе был дурак, но невероятнейший балбес, пьяница и скандалист, типичный недоросль из богатых купеческих сынков, так что почтенной фирме Хлудовых был от него один только срам, наносивший большой ущерб торговому реноме."
                                            },
                                            {
                                                "example_id": "c2c80f10-311f-4d11-ab97-3efadc8f7348",
                                                "sense_id": "5361d0d3-3781-349a-9242-35f3f177a355",
                                                "text": "Один — сын начальника депо, инженера Сухарько, белобрысый, веснушчатый семнадцатилетний балбес и повеса Рябой Шурка, как прозвали его в училище, с хорошей удочкой, с лихо закушенной папироской."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f89f22e-1d37-43f7-b826-2dfcfd9d410f",
                        "source_entry_id": "498ba982-5cc1-359d-b126-c2ea5f3d4fe3",
                        "source_sense_id": "784e777e-a0f5-3fdc-8f76-5e4d71ae07e6",
                        "target_lang_word": "оболтус",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оболтус",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                                        "entry_id": "aa93da07-7178-3d1a-ba07-68f0e892f12e",
                                        "glosses": [
                                            "прост., пренебр. шутл. глупый, ленивый человек, бездельник"
                                        ],
                                        "tags": [
                                            "или"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30614586-5e4f-4fab-a55b-94a1869d113e",
                                                "sense_id": "8882bde2-dd13-3ff7-a72b-567ed33af802",
                                                "text": "У меня до сих пор есть сильное подозрение, что Вера Акимовна все прекрасно понимала и она нам позволяла подмену, зная: уж троечку как-нибудь поставит нам, оболтусам тупым."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08d1881f-5c4a-4ab4-8e1b-a190c4302cbe",
                        "source_entry_id": "498ba982-5cc1-359d-b126-c2ea5f3d4fe3",
                        "source_sense_id": "784e777e-a0f5-3fdc-8f76-5e4d71ae07e6",
                        "target_lang_word": "остолоп",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "остолоп",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "964478eb-6ecc-3485-92f9-75ce086d13a4",
                                        "entry_id": "ec393fb7-0b3b-3330-81d0-91d522666fe7",
                                        "glosses": [
                                            "прост., бран. бестолковый человек; глупец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c60df315-f037-4c4d-a704-52330c6aafe1",
                                                "sense_id": "964478eb-6ecc-3485-92f9-75ce086d13a4",
                                                "text": "― Бываеть народ тёмный, так ему ещё мало, он ещё и сам всякую потьму на себя напускает, а потом и живёт, как остолоп какой, всего боиться: и грома, и месяца, и кошки."
                                            },
                                            {
                                                "example_id": "6de63417-5922-4211-b0b0-da3b47fd123b",
                                                "sense_id": "964478eb-6ecc-3485-92f9-75ce086d13a4",
                                                "text": "Ведь из университета выгоняют только остолопов, у которых слишком тупые головы!"
                                            },
                                            {
                                                "example_id": "2d5855cd-8011-40d8-af9d-48677974642e",
                                                "sense_id": "964478eb-6ecc-3485-92f9-75ce086d13a4",
                                                "text": "Это я, остолоп, улетел в командировку в Москву и оставил кран в ванной открытым."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
