                        "examples": [
                            {
                                "example_id": "e1473558-7936-4615-91f6-3b29d3bd1b92",
                                "sense_id": "b04ab8d2-63ff-3ab7-a6ec-5dfe106fd54b",
                                "text": "Le degradement de Louis le Debonnaire."
                            },
                            {
                                "example_id": "f4efddb5-d14a-48e8-bcb0-5f48032d3b64",
                                "sense_id": "b04ab8d2-63ff-3ab7-a6ec-5dfe106fd54b",
                                "text": "De là il devait tout voir, la plaine, la mer et puis ces mêmes collines que d’aucuns appellent montagnes, indigo par endroits dans la lumière du soir, se pressant les unes derrière les autres à perte de vue, traversées par des vallées qu’on ne voit pas mais qu’on devine, à cause du dégradement des tons et puis à cause d’autres indices intraduisibles en mots et - même impensables."
                            },
                            {
                                "example_id": "c73fe615-c530-45ac-83c9-ddd6ad6e1a8b",
                                "sense_id": "b04ab8d2-63ff-3ab7-a6ec-5dfe106fd54b",
                                "text": "Il a été également profondément frappé de constater dans l’attitude de ses amis le début d’un dangereux dégradement moral qui menace de corrompre le pays tout entier."
                            }
                        ]
                    }
