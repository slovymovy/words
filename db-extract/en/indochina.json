                                "target_senses": [
                                    {
                                        "sense_id": "14a684fb-915d-3c68-9b41-a5f4e53259a2",
                                        "entry_id": "d903b2e8-ab75-3717-8091-2d8bafc4d8e3",
                                        "glosses": [
                                            "schiereiland in de Zuid-Chinese Zee dat Cambodja, Laos en Vietnam omvat"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d33877f6-e479-4e9c-a7e8-a301d1cae2e3",
                                                "sense_id": "14a684fb-915d-3c68-9b41-a5f4e53259a2",
                                                "text": "Het is 1954. De Fransen vechten in Indochina om het behoud van hun kolonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b181ee9-ce81-3609-ba5e-2ef99bebff50",
                                        "entry_id": "d903b2e8-ab75-3717-8091-2d8bafc4d8e3",
                                        "glosses": [
                                            "schiereiland tussen de Indische en de Stille Oceaan dat het grootste deel van Zuidoost-Azië vormt"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a5020ba-771c-4ac8-9227-7c585e8b3c91",
                                                "sense_id": "9b181ee9-ce81-3609-ba5e-2ef99bebff50",
                                                "text": "De minder bekende Oosterse keukens uit Indochina zoals Vietnam, Laos, Cambodja en Birma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "721f2e7c-bdc8-42db-ac7c-5aabd10b5ee8",
                        "source_entry_id": "64ee8923-d608-3528-a1f6-5f5929ec650e",
                        "source_sense_description": "part of Southeast Asia",
                        "target_lang_word": "Indochine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indochine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97c6a50b-813f-356a-ab65-0611500ba8d7",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Péninsule du continent asiatique située au sud de la Chine et à l’est de l’Inde, comprenant la Birmanie, le Cambodge, le Laos, la Thaïlande et le Vietnam."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e13afa87-a8b5-43bc-8fb7-cbf1ed2907c1",
                                                "sense_id": "97c6a50b-813f-356a-ab65-0611500ba8d7",
                                                "text": "Certaines notions qui lui sont très familières aux siècles classiques — comme celles de l’hybris et de la némésis — se retrouvent chez des populations aussi peu évoluées que les tribus Moïs du sud de l’Indochine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Indochine française."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba72eb8b-b8f4-4a1b-bd0f-5a11ecdd1fa4",
                                                "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                                "text": "[…] il me touchait presque et hurlait: « Tu vas parler ! Tout le monde doit parler ici ! On a fait la guerre en Indochine, ça nous a servi pour vous connaître. Ici, c'est la Gestapo ! Tu connais la Gestapo ? »"
                                            },
                                            {
                                                "example_id": "5b6caf21-5a2a-444a-9e4c-457742582f61",
                                                "sense_id": "16a08a22-5322-3b58-b59d-6f23d7c20c0e",
                                                "text": "Je ne pense jamais au Siam sans évoquer le déjeuner que fit au Palais Royal le gouverneur de l’Indochine d’alors, M. Violette, accompagné de sa très digne épouse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                        "entry_id": "21833725-c691-334e-9379-9db169755783",
                                        "glosses": [
                                            "Guerre d’Indochine."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a17f1f-d71e-4243-ae93-9bf32df9c635",
                                                "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                                "text": "Je peux ajouter qu’un frère de Maria Soledad, qui avait aussi vécu la guerre d’Espagne, fit le coup de feu dans le maquis, puis s’engagea pendant cinq ans dans la Légion où il fit d’ailleurs l’Indochine…"
                                            },
                                            {
                                                "example_id": "aa249c47-684b-4917-9cf3-c39df5acd4a4",
                                                "sense_id": "91219ec9-a426-3c96-a453-9ca56d7e481e",
                                                "text": "J’avais un brigadier-chef qui avait fait l’Indochine, le parfait baroudeur, qui commençait à être violent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "506d7cdb-263c-452c-a17c-55348349ef39",
                        "source_entry_id": "64ee8923-d608-3528-a1f6-5f5929ec650e",
                        "source_sense_description": "part of Southeast Asia",
                        "target_lang_word": "Indochina",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indochina",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e94e71d-46ff-388d-86cd-1fd81f55d9ec",
                                        "entry_id": "742857f0-4178-335e-b851-9c87a47d0a77",
                                        "glosses": [
                                            "Französisch-Indochina, eine ehemalige Kolonie Frankreichs in Südostasien, die die heutigen Staaten Kambodscha, Laos und Vietnam umfasste"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2fdab6-23cd-4760-9dc7-7460aafcff55",
                                                "sense_id": "3e94e71d-46ff-388d-86cd-1fd81f55d9ec",
                                                "text": "„Als die USA sich verrückterweise den Krieg des \"militärisch-industriellen Komplexes\" in Indochina aufdrängen ließen, warnte Armeegeneral Douglas MacArthur vor einem neuen Landkrieg in Asien.“"
                                            },
                                            {
                                                "example_id": "9cf5a8bb-6ce2-478a-9342-a1c9e2bd887c",
                                                "sense_id": "3e94e71d-46ff-388d-86cd-1fd81f55d9ec",
                                                "text": "„Bevor die Feen sich zum Tanz aufreihten, öffnete sich der Vorhang für eine alte Holzpuppe, von der nur eine Handvoll Menschen wussten, dass sie, angefertigt in einer Zeit, als man Vietnam noch Indochina nannte, schon seit einem Vierteljahrhundert Prenzlbergerin war, im Verborgenen.“"
                                            },
                                            {
                                                "example_id": "70c3396c-2745-405a-aa55-a7473c727260",
                                                "sense_id": "3e94e71d-46ff-388d-86cd-1fd81f55d9ec",
                                                "text": "„Die Strafexpedition ist von Erfolg gekrönt und Mayréna gewinnt die Sympathie des französischen Bischofs in Indochina.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c95cfaf-4cdc-3e39-9ddc-8e5fbaf35ffd",
                                        "entry_id": "742857f0-4178-335e-b851-9c87a47d0a77",
                                        "glosses": [
                                            "Indochinesische Halbinsel"
                                        ],
                                        "tags": [
                                            "Geographie"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
