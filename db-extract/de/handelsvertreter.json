                    {
                        "sense_id": "39d19061-4774-3f65-98d1-43600a1fb431",
                        "entry_id": "2d5f4c36-d224-318e-9156-daa3bf5535f7",
                        "glosses": [
                            "Person, die gewerblich für Unternehmen Geschäfte vermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4922dae-3d72-45cf-91f4-c075dff2eb62",
                                "sense_id": "39d19061-4774-3f65-98d1-43600a1fb431",
                                "text": "„Wer hier übernachtete, war reisender Handelsvertreter mit kleinem Budget oder Lasterfahrer, der die Fähre aufs Festland verpasst hatte.“"
                            },
                            {
                                "example_id": "329b523b-2f6f-401a-8f64-00765c982f15",
                                "sense_id": "39d19061-4774-3f65-98d1-43600a1fb431",
                                "text": "„Hans Miller zog als Handelsvertreter von Singer-Nähmaschinen durch die Lande und sprach Englisch, Deutsch, Hebräisch und auch einigermaßen gut Griechisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
