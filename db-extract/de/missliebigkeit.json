                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20c45f4f-84f4-45b5-891a-bef692d13dd7",
                                "sense_id": "63ead820-7339-35ff-b59e-007930b7a5ed",
                                "text": "„Zugegeben, Donald Trump hatte es von Anfang an gesagt: Schon im Wahlkampf hatte er angekündigt, vieles von dem abzuschaffen und zurückzunehmen, was es so an Missliebigkeiten aus der Zeit Barack Obamas gebe.“"
                            },
                            {
                                "example_id": "240bc5e5-4bdc-424d-ba63-8c48066458dd",
                                "sense_id": "63ead820-7339-35ff-b59e-007930b7a5ed",
                                "text": "„Das heißt aber nicht, dass der Bürger vor der durch einen religiösen Bezug ausgelösten Missliebigkeit stärker zu schützen wäre als vor sonstigen Missliebigkeiten.“"
                            },
                            {
                                "example_id": "ff1c509f-035c-42a5-b0d4-2002f5dbe761",
                                "sense_id": "63ead820-7339-35ff-b59e-007930b7a5ed",
                                "text": "„Sie hatten eine ungewöhnlich ruhige Reise ohne Stürme und andere Missliebigkeiten gehabt.“"
                            },
                            {
                                "example_id": "b708194d-a905-4918-bf7f-f6a1844951f7",
                                "sense_id": "63ead820-7339-35ff-b59e-007930b7a5ed",
                                "text": "„Ein Berater muss die eigenen Kompetenzen und Grenzen, die persönlichen Stärken und Schwächen, Vorlieben und Missliebigkeiten, aber auch die blinden Flecken kennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
