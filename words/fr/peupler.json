                {
                    "sense_id": "46ffe5c6-6d0e-3bda-99ea-040a9a687cb2",
                    "sense_definition": "Se reproduire abondamment et multiplier son espèce par la génération.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet environnement protégé, les rongeurs <w>peuplent</w> à une vitesse surprenante.",
                            "target_lang_translations": {
                                "en": "In this protected environment, the rodents <w>breed</w> at a surprising rate.",
                                "ru": "В этой охраняемой среде грызуны <w>размножаются</w> с удивительной скоростью.",
                                "de": "In dieser geschützten Umgebung <w>vermehren</w> <w>sich</w> die Nagetiere erstaunlich schnell.",
                                "es": "En este entorno protegido, los roedores <w>se reproducen</w> a una velocidad sorprendente.",
                                "zh": "在这个受保护的环境里，啮齿动物<w>繁殖</w>的速度快得惊人。"
                            }
                        },
                        {
                            "text": "Peu d'animaux sauvages <w>peuplent</w> aussi vite que les lapins dans une telle garenne.",
                            "target_lang_translations": {
                                "en": "Few wild animals <w>breed</w> as quickly as rabbits in such a warren.",
                                "ru": "Немногие дикие животные <w>плодятся</w> так же быстро, как кролики в таком кроличьем садке.",
                                "de": "Nur wenige Wildtiere <w>vermehren</w> <w>sich</w> so schnell wie Kaninchen in einem solchen Kaninchengehege.",
                                "es": "Pocos animales salvajes <w>se reproducen</w> tan rápidamente como los conejos en una conejera como esta.",
                                "zh": "在这样的兔场里，很少有野生动物能像兔子那样<w>繁殖</w>得这么快。"
                            }
                        }
