                ],
                "senses": [
                    {
                        "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                        "entry_id": "4043e20c-454f-3f97-b5be-bd10538bb4ef",
                        "glosses": [
                            "Kette aus Glasperlen, die als Schmuckstück um den Hals getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7451f2d9-4bdd-42d4-80e6-971a7456b5f6",
                                "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                                "text": "„Das WNW- OSO-orientierte Grab besaß als Inventar ein Bügelfibelpaar und einen Kolbenarmring aus Bronze, eine Glasperlenkette und ein kleines handgemachtes Tongefäß.“"
                            },
                            {
                                "example_id": "c3f3705e-b4ee-4d6d-89be-6cb22ac041bd",
                                "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                                "text": "„Als weiteren Schmuck hatte sie Ohrringe und die schwarze Glasperlenkette um den Hals - am Ringfinger den Ehering.“"
                            },
                            {
                                "example_id": "5e316805-f3ec-46bf-b699-f7d5046b6441",
                                "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                                "text": "„Plötzlich entdeckte ich zwischen einem Schwung bunter Glasperlenketten und mehreren emaillierten Armreifen die goldfarbene Brosche, die Frau Rehberg ständig an ihrer Kleidung trug.“"
                            },
                            {
                                "example_id": "ef66d237-1a9c-4c52-8435-4e781f7a7393",
                                "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                                "text": "„Glasperlenketten waren zu früherer Zeit nicht nur Schmuckstück, sondern auch ein wertvolles Zahlungsmittel.“"
                            },
                            {
                                "example_id": "bd7d283a-8977-4edc-87c3-66db479fe876",
                                "sense_id": "707fe57d-d7fb-3375-88bc-45257d95c7ae",
                                "text": "„Im Anschluss an die Führung können alle Teilnehmer selbst eine kleine Ausgrabung nach Tonscherben und Münzen vornehmen und glänzende Schmuckstücke nach römischen Vorbildern wie Glasperlenketten, goldene Ringe und Scheibenfibeln herstellen, die sie mit nach Hause nehmen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "900120d1-0054-49e1-be0c-d396dbe39a7f",
                        "source_entry_id": "4043e20c-454f-3f97-b5be-bd10538bb4ef",
