                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7d0bca4-161d-4c96-8edf-a3cff6141d27",
                                                "sense_id": "fe94a5d8-7cf4-345f-b9cc-6e0c104c0360",
                                                "text": "Ich will nur noch eine einzige Bemerkung anhängen, dann bin ich fertig."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3649c1d3-3731-39ba-afbe-37485d5925fb",
                                        "entry_id": "47538c45-272e-3150-aa5c-925c666edcc2",
                                        "glosses": [
