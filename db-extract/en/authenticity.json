    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0dbc18d9-6020-32b0-a70a-efccc40dc988",
                "word": "authenticity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f0becf07-ebd7-4bb4-afeb-90f2749bfc6b",
                        "entry_id": "0dbc18d9-6020-32b0-a70a-efccc40dc988",
                        "tags": [
