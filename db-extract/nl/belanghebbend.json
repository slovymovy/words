                    {
                        "translation_id": "c85ee203-134c-4e9c-8ddd-9219211107b3",
                        "source_entry_id": "bbcb09b5-bf85-378a-80fe-1e068aef6702",
                        "source_sense_id": "deded35c-5d36-3f81-b189-eacd38692285",
                        "source_sense_description": "er belang bij hebben",
                        "target_lang_word": "interested",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interested",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b74b9f5-019a-389c-9768-afd4fe2cb343",
                                        "entry_id": "772abecb-d75a-3aca-ae10-212827bfac8c",
                                        "glosses": [
                                            "Having or showing interest (attention or curiosity)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36339a5b-bf94-4abe-96d6-accdebac3761",
                                                "sense_id": "0b74b9f5-019a-389c-9768-afd4fe2cb343",
                                                "text": "I'm very interested in going to see that play."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                        "entry_id": "772abecb-d75a-3aca-ae10-212827bfac8c",
                                        "glosses": [
                                            "Having an interest (stake); being a stakeholder; motivated by considerations of self-interest; self-serving."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28fc42a6-bdfa-4d5c-a27e-77fcc9dc7c39",
                                                "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                                "text": "all interested parties [≈ all stakeholders]"
                                            },
                                            {
                                                "example_id": "383d56d4-841a-41e0-9422-32d2b20ace99",
                                                "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                                "text": "I was even mortified at those instances of his liberality, which my situation compelled me to receive, lest, being but little acquainted with my disposition, he should suspect me of being interested in my love […]."
                                            },
                                            {
                                                "example_id": "f3d93fb5-c49a-4dbd-9fc6-4d489328a33c",
                                                "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                                "text": "[…] they impressed my youthful mind with a sincere aversion to the northern inhabitants of Britain, as a people blood-thirsty in time of war, treacherous during truce, interested, selfish, avaricious, and tricky in the business of peaceful life, and having few good qualities,[…]."
                                            },
                                            {
                                                "example_id": "c4565538-c031-4256-9e16-7fa93b54fb7a",
                                                "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                                "text": "\"Oh, you are quite wrong!\" cried his mother; \"no love of fortune, nor of ambition, could have tempted Norbourne to desert you. Little, indeed, do you know his high and generous nature, when you suppose that he could be actuated by an interested motive.\""
                                            },
                                            {
                                                "example_id": "aa63fbd8-9c5f-4dc0-bb26-dc067474f7ff",
                                                "sense_id": "4b19fe71-77fe-364e-a950-947a7309a1b2",
                                                "text": "He maintained -- the thought is not unnatural in a royal historiographer -- that the generous actions of great princes are often twisted and misrepresented by interested critics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54e1734-ac7e-3575-a531-6d1305b0c751",
                                        "entry_id": "772abecb-d75a-3aca-ae10-212827bfac8c",
                                        "glosses": [
                                            "Having an interest (stake); being a stakeholder; motivated by considerations of self-interest; self-serving.",
                                            "Owning a share of a company; being a shareholder."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
