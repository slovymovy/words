    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "29c22ba9-191c-3e56-bc3f-43b388d03135",
                "word": "tatters",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9c6a3278-671d-3a88-8166-fe730644e7f1",
                        "entry_id": "29c22ba9-191c-3e56-bc3f-43b388d03135",
                        "glosses": [
                            "Ragged clothing or fabric, paper, etc."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "fd159025-09ca-4a63-8da5-8933e06932f5",
                                "sense_id": "9c6a3278-671d-3a88-8166-fe730644e7f1",
                                "text": "The universe is finished; the copestone is on, and the chips were carted off a million years ago. Poor Lazarus there, chattering his teeth against the curbstone for his pillow, and shaking off his tatters with his shiverings, he might plug up both ears with rags, and put a corn-cob into his mouth, and yet that would not keep out the tempestuous Euroclydon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c010e34-11d1-444f-a67e-aab54242017d",
                        "source_entry_id": "29c22ba9-191c-3e56-bc3f-43b388d03135",
                        "source_sense_id": "9c6a3278-671d-3a88-8166-fe730644e7f1",
                        "source_sense_description": "ragged clothing, fabric, paper etc",
                        "target_lang_word": "hadry",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadry",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                        "entry_id": "fcb529e5-6c67-3032-9d12-cea3332f04cd",
                                        "glosses": [
                                            "oblečení"
                                        ],
                                        "tags": [
                                            "multiplicative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82d8019d-a55e-45ed-935c-cde738ed33a1",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Vybírám kus od kusu. Něco může být 'vintaged' a 'funky', ale zbytek jsou staromódní hadry."
                                            },
                                            {
                                                "example_id": "b527504e-9179-42ff-9649-f57a3d531e8a",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Hadry, které měla na sobě, byly staré, špinavé, propocené, nicméně tělo, které halily, zcela jistě patřilo dobře živené, zdravé dívce."
                                            },
                                            {
                                                "example_id": "d3a10852-7a9d-4630-a880-70014429ae9f",
                                                "sense_id": "8b826170-292a-376a-8f54-9041f12a3087",
                                                "text": "Takže chlap si chce užít, na holku v ten moment přijdou krámy, chlápek má utrum, zbije holku na srágoru, lohne jí šaty a hadry a vezme roha,\" rekapituluje si to Kaoru."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef4c5323-e9d3-30ee-9a90-378757a1e95c",
                                        "entry_id": "fcb529e5-6c67-3032-9d12-cea3332f04cd",
                                        "glosses": [
                                            "hadrářská nemoc (nemoc vznikající při třídění hadrů)"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hadry",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "eaf8d454-59e8-3a7b-8cbc-f8620d510e30",
