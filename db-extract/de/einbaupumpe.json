                "senses": [
                    {
                        "sense_id": "d5dc1bfd-34b1-35f8-9340-391c308c379d",
                        "entry_id": "0cd5300f-3b26-300a-b0ab-03b0fc2bc7a7",
                        "glosses": [
                            "eine fest an einem Löschfahrzeug befestigte Feuerlöschpumpe, die in der Regel durch dessen Motor betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f833f86-c1df-4fda-8621-012e83acbeae",
                                "sense_id": "d5dc1bfd-34b1-35f8-9340-391c308c379d",
                                "text": "„Das Tanklöschfahrzeug 4000 (TLFA 4000) ist ein Feuerwehrfahrzeug, dass für die Brandbekämpfung ausgerüstet ist. Die wesentliche Ausstattung beinhaltet: 1 Löschwassertank mit 4.000 Liter Inhalt 1 Einbaupumpe 1 Schnellangriffseinrichtung 1 Wasserwerfer[.]“"
                            },
                            {
                                "example_id": "6281bc00-c8b7-4c56-93ba-1b0005b20ffd",
                                "sense_id": "d5dc1bfd-34b1-35f8-9340-391c308c379d",
                                "text": "„Das HLF verfügt über einen Wassertank von 1000l und neben der Standardbeladung sind Rettungsschere & Spreizer, Hebekissen, Kettensäge, Trennschleifer, Greifzug, Lichtmast, eine Einbaupumpe der neusten Generation sowie eine dreiteilige Schiebleiter verladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
