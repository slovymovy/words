                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c80b3f1c-e2f7-46ec-a5b1-dc7f1e3daa35",
                                "sense_id": "a68bfd16-4f82-3c6d-8be5-3f0bb33bfaad",
                                "text": "Subsequently, the Atacamenians developed their own distinctive ware."
                            },
                            {
                                "example_id": "8e20e4b5-480a-4373-ac08-dff5ad489f9f",
                                "sense_id": "a68bfd16-4f82-3c6d-8be5-3f0bb33bfaad",
                                "text": "Another issue is language. After the conquest, the Spanish administrators in San Pedro cut out the tongues of anyone who spoke the Atacamenians’ original language, known as Cunza, our tongue."
                            },
                            {
                                "example_id": "8a9ff897-bbb5-4738-a369-8bfd876ad855",
                                "sense_id": "a68bfd16-4f82-3c6d-8be5-3f0bb33bfaad",
                                "text": "Strategically located on the highest spot overlooking the rivery valley, it was built by a people from Bolivia […]. With control of the river, they imposed a tax for water rights on the local Atacamenians."
                            }
                        ]
                    }
