                    {
                        "sense_id": "f116e3d7-c8d5-3a96-9730-333940178052",
                        "entry_id": "2bcfffb4-6021-30d0-a273-03da91f144cb",
                        "glosses": [
                            "Troisième personne du singulier du présent du subjonctif de mettre."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "287c273a-0671-4d36-b829-d31010f6d6ef",
                                "sense_id": "f116e3d7-c8d5-3a96-9730-333940178052",
                                "text": "Je l’enverrai à une nation perfide, et je lui commanderai d’aller contre un peuple que je regarde dans ma fureur, afin qu’il en remporte les dépouilles, qu’il le mette au pillage, et qu’il le foule aux pieds comme la boue qui est dans les rues."
                            },
                            {
                                "example_id": "debdcd97-7a95-4264-83fd-f47b6f799b90",
                                "sense_id": "f116e3d7-c8d5-3a96-9730-333940178052",
                                "text": "Il se disait probablement que sa femme ne les trouverait jamais, qu’elles s’effriteraient avant qu’elle ne mette la main sur le carton."
                            }
                        ]
                    }
