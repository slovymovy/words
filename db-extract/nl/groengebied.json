                        "glosses": [
                            "gebied met veel (natuurlijke) begroeiing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d39230-f4ad-444f-83e1-0a6e1a4ff3f0",
                                "sense_id": "6718aacc-26bf-390e-aa13-b64958f363cf",
                                "text": "Volgens de regionale omroep waren de twee kadavers in de omgeving van de Kapel van Genooy begraven. Het paardenhoofd lag in een groengebied iets verderop. De politie onderzoekt in samenwerking met de dierenpolitie of de vondsten verband houden met elkaar."
                            },
                            {
                                "example_id": "17f7f8f8-88b6-47ec-89ab-3817b570b9e1",
                                "sense_id": "6718aacc-26bf-390e-aa13-b64958f363cf",
                                "text": "Wynia haalde zijn evenement weg uit een Amsterdams stadspark na dringend verzoek van de gemeente om festivals minder snel op elkaar te laten volgen. Zo kan het gras beter herstellen. \"Vorig jaar werden we benaderd door Groengebied Amstelland dat het terrein aan de Ouderkerkerplas beheert. Ze wilden kijken of er ruimte was voor een festival en vroegen of we mee wilden doen aan een pitch. Dat kwam als geroepen.\""
                            }
                        ]
                    }
