                "translations": [
                    {
                        "translation_id": "d7bdc73f-9f9f-4464-81ce-5e400e67423e",
                        "source_entry_id": "2fa8b374-34c5-38dc-a14a-b5b82d0c77e4",
                        "source_sense_id": "d4058d52-7c95-3d42-aab9-fa020b2322e8",
                        "target_lang_word": "slight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Minor; small in amount",
                                            "Gentle or weak, not aggressive or powerful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e115aa71-9c1c-4176-827b-c865b0c83ece",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "give it a slight kick"
                                            },
                                            {
                                                "example_id": "5ac30632-30b4-467c-9948-96cbf3404a80",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "a slight hint of cinnamon"
                                            },
                                            {
                                                "example_id": "3e277e30-5521-4be1-ab73-36c0907dee68",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "a slight effort"
                                            },
                                            {
                                                "example_id": "6026333f-6155-4b16-b35e-4430f2f9aac5",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "a slight (i.e. not convincing) argument"
                                            },
                                            {
                                                "example_id": "1a3259cb-24f5-4ef8-ad0b-3fa359f49999",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "Mother very rightly resented the slightest hint of condescension. She considered that the exclusiveness of Peter's circle was due not to its distinction, but to the fact that it was an inner Babylon of prodigality and whoredom,[…]."
                                            },
                                            {
                                                "example_id": "82678602-0976-42d3-bb53-faa8094d7757",
                                                "sense_id": "0195dc6a-5cca-33ef-a037-410b416c21dc",
                                                "text": "Even though there is slight quality variation between the long and short versions of Arabic vowels, the variation is rarely noticeable even by some phoneticians; hence, it does not amount to a source of even phonetic accent except for those learners of Arabic whose language has a strictly centrifugal vowel system such as Spanish, Italian, Tagalog, among others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46c432bd-d7cb-39cc-9142-96dd3acfa843",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Minor; small in amount",
                                            "Not thorough; superficial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904eeb69-9bec-482d-9c1d-12065d737a4b",
                                                "sense_id": "46c432bd-d7cb-39cc-9142-96dd3acfa843",
                                                "text": "make a slight examination"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "989364e6-cabc-375c-8538-583407a323cf",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Minor; small in amount",
                                            "Trifling; unimportant; insignificant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b66505-b4dc-4548-b8d1-685287f54ad0",
                                                "sense_id": "989364e6-cabc-375c-8538-583407a323cf",
                                                "text": "we made a slight mistake"
                                            },
                                            {
                                                "example_id": "2c1b9d29-affe-4a1d-a2f2-1faaf968f585",
                                                "sense_id": "989364e6-cabc-375c-8538-583407a323cf",
                                                "text": "a slight pain"
                                            },
                                            {
                                                "example_id": "ce61c4ac-8fec-457d-95c4-bf8b8e8c2266",
                                                "sense_id": "989364e6-cabc-375c-8538-583407a323cf",
                                                "text": "Some firmly embrace doctrines upon slight grounds."
                                            },
                                            {
                                                "example_id": "734e301d-7d42-4e53-b9a9-687b660616bb",
                                                "sense_id": "989364e6-cabc-375c-8538-583407a323cf",
                                                "text": "Slight is the subject, but not so the praise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "774c97db-6919-3cb2-b747-64f445accab7",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Minor; small in amount",
                                            "Not far away in space or time."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "959aecbf-fb51-4ac8-939a-3650d4a46043",
                                                "sense_id": "774c97db-6919-3cb2-b747-64f445accab7",
                                                "text": "in the slight future"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb82fdc4-c94d-3310-a396-87e04c9aa477",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Of slender build."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77dcd222-0d55-491e-ba6c-781e1a6dfd72",
                                                "sense_id": "fb82fdc4-c94d-3310-a396-87e04c9aa477",
                                                "text": "a slight but graceful woman"
                                            },
                                            {
                                                "example_id": "b0068769-4e10-4dc8-875c-d669abb37d5e",
                                                "sense_id": "fb82fdc4-c94d-3310-a396-87e04c9aa477",
                                                "text": "his own figure, which was formerly so slight"
                                            },
                                            {
                                                "example_id": "4dcf74ad-403a-40cd-9309-a7b89e0ab71e",
                                                "sense_id": "fb82fdc4-c94d-3310-a396-87e04c9aa477",
                                                "text": "But now, ten years later, after his recent shipwreck, he cannot compete as a runner, though he can outthrow the slighter Phaeacians with the heaviest discus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbf402d8-d848-3adb-8d83-a9d9b5f2eb07",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Even, smooth or level."
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b998979-3401-4f95-b9e1-163adc7f90ed",
                                                "sense_id": "dbf402d8-d848-3adb-8d83-a9d9b5f2eb07",
                                                "text": "A slight stone"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb50bc50-b8d3-31df-8808-8a65ab2f0c64",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Still; with little or no movement on the surface."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0bf41a-e09f-4842-8605-2c4baaeca008",
                                                "sense_id": "eb50bc50-b8d3-31df-8808-8a65ab2f0c64",
                                                "text": "The sea was slight and calm"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "786f3db5-86f9-360d-bbed-d1aa39a1e464",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Foolish; silly; not intellectual."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4a27688-6835-4546-9f3b-bffe85ab64b9",
                                                "sense_id": "786f3db5-86f9-360d-bbed-d1aa39a1e464",
                                                "text": "But no beast ever was so slight,\nFor man, as for his god, to fight;\nThey have more wit, alas! and know\nThemselves and us better than so."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c079301-614b-3ed6-b38e-4c8046c2ae37",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Bad, of poor quality."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6adbe4b7-9184-4091-849b-92ab5278fdfc",
                                                "sense_id": "7c079301-614b-3ed6-b38e-4c8046c2ae37",
                                                "text": "1889 (first published), George Washington, Writings\nwe frequently have slight Goods and sometimes old and unsaleable Articles"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "379f9af2-d321-3a6a-8284-c4a0c27d3a2e",
                                        "entry_id": "cde4c392-19e0-39a9-bf1f-37c7c6637fa5",
                                        "glosses": [
                                            "Slighting; treating with disdain."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76985d5c-ec2d-4970-8b52-098ea85a41c7",
                                                "sense_id": "379f9af2-d321-3a6a-8284-c4a0c27d3a2e",
                                                "text": "This slight way of treating both his book and his ancestors nettled little Puddock – who never himself took a liberty, and expected similar treatment – but he knew Sturk, the nature of the beast, and he only bowed grandly […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca7bda46-95df-3b87-8082-06d283983b5a",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To treat as unimportant or not worthy of attention; to make light of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "186b15b1-1f87-4045-8e17-ec5edb39b6d1",
                                                "sense_id": "ca7bda46-95df-3b87-8082-06d283983b5a",
                                                "text": "the wretch who slights the bounty of the skies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ad99a0-6532-329b-8526-13c06e37fa7a",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To give lesser weight or importance to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bcff6d9-1fae-4069-a25a-1ec6d8ae8128",
                                                "sense_id": "00ad99a0-6532-329b-8526-13c06e37fa7a",
                                                "text": "Incontiguously (accent on tig; the rest of the syllables slighted) means in an incontiguous manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b614e35-ad08-3e2b-b597-e36ae40df3cd",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To treat (someone or something) with disdain or neglect, usually out of prejudice, hatred, or jealousy; to ignore disrespectfully; to skimp on one's duties toward."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49f61a31-05f9-4fee-8d35-e8cc455558c1",
                                                "sense_id": "9b614e35-ad08-3e2b-b597-e36ae40df3cd",
                                                "text": "Though true of heart, she was somewhat of a coquette in manner; and I was jealous as a Turk. She slighted me in a thousand ways, yet would never acknowledge herself to be in the wrong. She would drive me mad with anger, and then force me to beg her pardon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "249e8c9c-d120-3c2b-909f-4ee4d6071d30",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To act negligently or carelessly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ae852c9-843c-3674-adf6-b7639517ec0c",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To render no longer defensible by full or partial demolition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927f131a-21ac-4605-aa5f-233f9c95a913",
                                                "sense_id": "3ae852c9-843c-3674-adf6-b7639517ec0c",
                                                "text": "When the parliament had finished the war , they reduced and slighted most of the inland garrison"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c126464-a7ec-30f5-b219-a5b778926630",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To make even or level."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8f5527-7bbb-4160-9a22-aa16b6fa67b7",
                                                "sense_id": "5c126464-a7ec-30f5-b219-a5b778926630",
                                                "text": "After your ground is sowne and harrowed, you shall then clotte it, sleight it, and smooth it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "471f1908-27a3-372b-be72-940ab975c5ef",
                                        "entry_id": "475814df-f7bb-3e07-806f-87dad0c01aa1",
                                        "glosses": [
                                            "To throw heedlessly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87699890-c089-4c6f-b9de-c0743417af98",
                                                "sense_id": "471f1908-27a3-372b-be72-940ab975c5ef",
                                                "text": "The rogue slighted me into the river."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "slight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8553042f-d408-3569-b482-bfd1628fecc7",
                                        "entry_id": "24d70e7e-4186-3df7-9b22-ecd7ac0fa60e",
                                        "glosses": [
                                            "The act of ignoring or snubbing; a deliberate act of neglect or discourtesy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad1e9ceb-18bf-4793-9539-f063edb029d7",
                                                "sense_id": "8553042f-d408-3569-b482-bfd1628fecc7",
                                                "text": "Never use a slighting expression to her, even in jest; for slights in jest, after frequent bandyings, are apt to end in angry earnest."
                                            },
                                            {
                                                "example_id": "aa8756e6-6301-4e17-8850-6085e61bb0b8",
                                                "sense_id": "8553042f-d408-3569-b482-bfd1628fecc7",
                                                "text": "But you, you're not allowed\n You're uninvited\n An unfortunate slight"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea73f79d-5d08-3a9f-8400-e1ec1dfa249b",
                                        "entry_id": "24d70e7e-4186-3df7-9b22-ecd7ac0fa60e",
                                        "glosses": [
                                            "Sleight."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6536c491-9c5b-4a95-b5c7-08ce0bf9eae1",
                                                "sense_id": "ea73f79d-5d08-3a9f-8400-e1ec1dfa249b",
                                                "text": "For till that stownd could never wight him harme,\nBy subtilty, nor slight, nor might, nor mighty charme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
