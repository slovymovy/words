                                            {
                                                "example_id": "7c75fef5-809a-4f46-bcf3-1151d6f4c75e",
                                                "sense_id": "fc7c6ee8-28cb-3de2-912d-d1a8a077a324",
                                                "text": "Aman, çocuğa iyi bakın"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28438bd6-1b08-3781-bdfd-92be40f18efd",
                                        "entry_id": "ebb0b74b-b4c5-3590-ae57-36c8dd6daa8c",
                                        "glosses": [
                                            "çok beğenmeyi anlatan bir söz: Aman ne güzel şey! Bu anlamda kullanıldığında buna da edatı da getirilebilir"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc64ddf2-b4b9-44d5-b817-f5873373fc4c",
                                                "sense_id": "28438bd6-1b08-3781-bdfd-92be40f18efd",
                                                "text": "Aman da ne güzel şey"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cfeb0ca-a49b-3b2d-8a05-4dddf84c7414",
                                        "entry_id": "ebb0b74b-b4c5-3590-ae57-36c8dd6daa8c",
                                        "glosses": [
                                            "şaşma anlatan bir söz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "606f5767-a27e-4178-8a6b-0fe6299a6f73",
                                                "sense_id": "1cfeb0ca-a49b-3b2d-8a05-4dddf84c7414",
                                                "text": "Aman efendim, bana öyle şeyler söyledi ki donakaldım."
