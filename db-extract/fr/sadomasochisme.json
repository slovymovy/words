                "senses": [
                    {
                        "sense_id": "564ac420-5f91-3a5e-a24d-554bde4ec186",
                        "entry_id": "ccf10ddd-649d-3461-89b4-37ff99a0d803",
                        "glosses": [
                            "Pratique sexuelle utilisant la douleur, la domination ou l'humiliation dans la recherche du plaisir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dacbfd06-bbf0-4df8-9f19-7601b89eb480",
                                "sense_id": "564ac420-5f91-3a5e-a24d-554bde4ec186",
                                "text": "Le sadomasochisme représente une confrontation philosophique entre la pensée de l'homme bon par nature et l'homme mauvais qui doit brider ses passions."
                            },
                            {
                                "example_id": "7ddc0eef-876d-4be7-87d9-2599ab2cc166",
                                "sense_id": "564ac420-5f91-3a5e-a24d-554bde4ec186",
                                "text": "Le sadomasochisme ressemble à des pratiques comme l’exhibitionnisme et le voyeurisme, dirait Nagel, en ce sens que ce sont des pratiques qui ne tiennent pas vraiment compte d’autrui."
                            }
                        ]
                    }
                ],
