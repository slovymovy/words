            {
                "entry_id": "eee998b8-4fc6-30d4-b298-c64a1763de1e",
                "word": "vingt-deuxième",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d2893a9-56f9-4e73-b622-2e5e17a53191",
                        "entry_id": "eee998b8-4fc6-30d4-b298-c64a1763de1e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "vingt-deuxièmes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3eacadf-20f9-3083-b3ef-8953b1f0599a",
                        "entry_id": "eee998b8-4fc6-30d4-b298-c64a1763de1e",
                        "glosses": [
                            "Adjectif numéral ordinal correspondant au nombre 22. Qui est au rang dont le numéro est vingt-deux (22)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b32e1ff-8d3f-4070-88cf-9df188dcb104",
                                "sense_id": "b3eacadf-20f9-3083-b3ef-8953b1f0599a",
                                "text": "Tout le mois de juillet, l’ex-sélectionneur multiplie les allers et retours entre sa résidence secondaire de Cassis et la ville de Barcelone où se déroulent les vingt-deuxièmes Jeux olympiques d'été."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9442e83d-3d12-4e68-a1f7-b8fc11c2425f",
                        "source_entry_id": "eee998b8-4fc6-30d4-b298-c64a1763de1e",
                        "source_sense_id": "b3eacadf-20f9-3083-b3ef-8953b1f0599a",
                        "target_lang_word": "zweiundzwanzigste",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweiundzwanzigste",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                        "entry_id": "10a1afda-8553-3a0f-8789-8ddaedbdfb1d",
                                        "glosses": [
                                            "nach dem oder der einundzwanzigsten kommend; in einer Reihenfolge an Stelle zweiundzwanzig"
                                        ],
                                        "tags": [
                                            "Ordnungszahl"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c29a721b-02a3-46ff-86a7-1fb154876b05",
                                                "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                                "text": "„Als nun der Minister Chonin Nidun hinkam und das Kissen auflegen wollte, riß der zweiundzwanzigste Holzmensch, namens Ischidari, das Kissen weg und sprach: Weshalb kommst du?“"
                                            },
                                            {
                                                "example_id": "40916b84-486c-4ea5-ab61-a361c3caa226",
                                                "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                                "text": "„Die Talsperre ist nach dem Schüttvolumen des Staudamms die neuntgrößte der Welt, nach Speicherraum ist sie an zweiundzwanzigster Stelle.“"
                                            },
                                            {
                                                "example_id": "55367b4d-4b90-4622-b2fa-4e362fdabeb4",
                                                "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                                "text": "„Und der am Ende vereinbarte Friedenstractat traf dann auch sehr wenig mit den Wünschen der Kaiserin-Königin überein, vor allem deßwegen, weil der zweiundzwanzigste Artikel desselben die Gewährleistung Europas für das Recht Preußens auf Schlesien enthielt.“"
                                            },
                                            {
                                                "example_id": "c95dcfec-9be8-4540-9577-a7745ad29b9f",
                                                "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                                "text": "„Die zweiundzwanzigste Session handelte von dem Meßopfer und von den Mißbräuchen bei demselben.“"
                                            },
                                            {
                                                "example_id": "44450a5f-4e23-4999-8979-5ea14ba278ab",
                                                "sense_id": "35db41d7-9be1-32de-a6ad-c8847162577f",
                                                "text": "„Durch das zweiundzwanzigste Gesetz zur Änderung des Grundgesetzes ist Art. 74 Ziff. 13 GG dahingehend erweitert worden, daß dem Bund zusätzlich eine konkurrierende Kompetenz zur Regelung der Ausbildungsbeihilfen zusteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
