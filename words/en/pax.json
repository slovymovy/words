                    "sense_definition": "A passenger or passengers, used particularly in the travel and transport industries.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "passenger_or_guest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manifest shows that eighty <w>pax</w> boarded the charter flight.",
                            "target_lang_translations": {
                                "zh": "旅客名单显示有八十名<w>旅客</w>登上了这架包机。"
                            }
                        },
                        {
                            "text": "Ground staff guided the arriving <w>pax</w> through the terminal.",
                            "target_lang_translations": {
                                "zh": "地勤人员引导抵达的<w>乘客</w>穿过航站楼。"
                            }
