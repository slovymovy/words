                        "entry_id": "f7aae5af-17c2-378b-a38f-fbbd49268f4b",
                        "glosses": [
                            "najwyższe władze państwowe Rosji, a wcześniej ZSRR"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "5c8a255e-a0ed-4847-8f94-cc5cdf9148b5",
                                "sense_id": "17622af5-3859-32fb-b06a-9505d3115271",
                                "text": "Kreml zdecydowanie temu zaprzecza, a na potwierdzenie publikuje fotografie i film."
                            }
                        ],
