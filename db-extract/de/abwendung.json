                        "examples": [
                            {
                                "example_id": "c048125f-3265-43ae-9734-73a9cfbabf06",
                                "sense_id": "0482db56-1013-3906-9d51-110339833d99",
                                "text": "Sie hatte die Abwendung ihrer Familie nur schwer ertragen."
                            },
                            {
                                "example_id": "bd1209b6-8783-4bc4-8987-3ad3f0528896",
                                "sense_id": "0482db56-1013-3906-9d51-110339833d99",
                                "text": "„Am Ende der Gymnasialzeit stand der körperliche Zusammenbruch und die völlige Abwendung vom Christentum.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "516de147-633f-33cb-98d6-5e2d5f6c3a45",
                        "entry_id": "52208344-8380-3a4e-8e26-3118fd1b674c",
                        "glosses": [
                            "Abwehr einer Bedrohung, eines Schlages oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f9cb00-ca3c-4e5a-8bb8-fb99ae44743d",
                                "sense_id": "516de147-633f-33cb-98d6-5e2d5f6c3a45",
                                "text": "Ich wünsche mir nichts so sehr, wie eine Abwendung dieser drohenden Gefahr."
                            },
                            {
                                "example_id": "d34b939e-83e3-42eb-a9c0-3e4fe6cdc61a",
                                "sense_id": "516de147-633f-33cb-98d6-5e2d5f6c3a45",
                                "text": "„Dieser Brief ist ab jetzt Jochen Kleppers Faustpfand, die entscheidende Waffe zur Abwendung von Renates Deportation, ein unersetzliches Gut, das nur in höchster Not zum Einsatz kommen soll.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
