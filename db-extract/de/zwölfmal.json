                        "entry_id": "4ffaa67c-56d5-305a-b6e5-eae54af2e348",
                        "glosses": [
                            "zwölf Male; elfmal und ein weiteres Mal"
                        ],
                        "tags": [
                            "bestimmtes Wiederholungszahlwort (Angabe",
                            "wie oft etwas wiederkehrt)"
                        ],
                        "examples": [
                            {
                                "example_id": "cfb1ac73-a5bf-4485-8790-e84120c9b9b8",
                                "sense_id": "602fbb42-d3a6-357e-9896-b92b51e0d092",
                                "text": "„Uganda hat seit 1956 zwölfmal an Olympischen Spielen teilgenommen.“"
                            },
                            {
                                "example_id": "27237701-78b1-4528-9012-8ec8a1798092",
                                "sense_id": "602fbb42-d3a6-357e-9896-b92b51e0d092",
                                "text": "Zwölfmal haben Chirurgen der Helios-Kliniken im vergangenen Jahr bei Operationen Dinge im Körper eines Patienten zurückgelassen, die dort nicht hingehören: Bohrerspitzen, Kompressen, Schlauchstücke, Tupfer."
                            },
                            {
                                "example_id": "ff1ea43a-addb-4093-9444-30d1942a9ed6",
                                "sense_id": "602fbb42-d3a6-357e-9896-b92b51e0d092",
                                "text": "Zwölfmal wurde Tilly von den Engländern erobert, zwölfmal von den Deutschen zurückgewonnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
