                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "987da8b0-f1a2-4d0f-b69b-dfacb0d927a2",
                                "sense_id": "00997600-5f01-3eec-9ed1-d7dda4b43dd9",
