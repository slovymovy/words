                "senses": [
                    {
                        "sense_id": "bc20d778-1f46-3028-a46e-813568b29b31",
                        "entry_id": "bbbd11ab-f7ed-37dc-bf17-b783d427a21b",
                        "glosses": [
                            "Decline in judgment and other cognitive functions, associated with aging; senility."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ee0a0957-9eed-4d6e-90b0-6d5391735359",
                                "sense_id": "bc20d778-1f46-3028-a46e-813568b29b31",
                                "text": "\"More care!\" said the old man in a shrill voice, […] there were in his face marks of deep and anxious thought which convinced me that he could not be, as I had been at first inclined to suppose, in a state of dotage or imbecility."
                            }
                        ]
                    },
                    {
                        "sense_id": "04978891-aa53-3d2d-9a53-4d49fabd70a3",
                        "entry_id": "bbbd11ab-f7ed-37dc-bf17-b783d427a21b",
                        "glosses": [
                            "Fondness or attentiveness, especially to an excessive degree."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "77826c78-b6e4-4fa8-9f43-9315323f3b55",
                                "sense_id": "04978891-aa53-3d2d-9a53-4d49fabd70a3",
                                "text": "Claudio And ſhe is exceeding wiſe.\nPrince In euery thing but in louing Benedicke. […] I would ſhee had beſtowed this dotage on mee, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "32313e6e-e37d-3cff-9b6f-f90a42cea9fb",
                        "entry_id": "bbbd11ab-f7ed-37dc-bf17-b783d427a21b",
                        "glosses": [
                            "Foolish utterance(s); drivel."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12e80115-e84b-46d1-858d-c9c56845020c",
                                "sense_id": "32313e6e-e37d-3cff-9b6f-f90a42cea9fb",
                                "text": "No leſs are they out of the way in Philoſophy, peſtring their heads with the ſapleſs dotages of old Paris and Salamanca."
                            }
                        ]
                    }
                ],
