                        "glosses": [
                            "Que l’on peut solder, qui peut être soldé."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "469ad1a6-c2ee-4e35-878f-27fcf5f20331",
                                "sense_id": "e45294cf-41c8-3fe1-9458-390c71b90425",
                                "text": "Elle devait déposer à la Caisse de l’Extraordinaire les trois-quarts de cette somme comme garantie, le reste soldable en quinze ans avec intérêt de 5 %."
                            },
                            {
                                "example_id": "48dffcfd-50da-4293-9c10-b79d7290d5eb",
                                "sense_id": "e45294cf-41c8-3fe1-9458-390c71b90425",
                                "text": "Oser dire aux acheteurs à crédit qu’ils auront une voiture neuve alors qu’à la fin du paiement il leur restera une guimbarde soldable pour deux ou trois mensualités : les putains n’ont pas ce culot !"
                            },
                            {
                                "example_id": "78154457-7f4e-44f9-af25-b9915f99692c",
                                "sense_id": "e45294cf-41c8-3fe1-9458-390c71b90425",
                                "text": "Car il faut souligner que très peu de danses nouvelles se maintinrent au répertoire : la Monarchie de Juillet déclinante inaugura l’ère du prêt-à-danser, soldable après six mois."
                            }
                        ]
                    }
