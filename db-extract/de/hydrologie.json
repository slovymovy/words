                        "form_id": "9a6e9227-2423-4d3d-bbe5-7f84df32e118",
                        "entry_id": "d3ea9e50-8035-3a10-9e4e-5ac8b07aeed0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Hydrologie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "951987aa-710f-38b6-89ed-44b5ccd3edf8",
                        "entry_id": "d3ea9e50-8035-3a10-9e4e-5ac8b07aeed0",
                        "glosses": [
                            "die Lehre, Wissenschaft vom Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b356aa3-936b-48a0-a0d4-76011f7bf0e8",
                                "sense_id": "951987aa-710f-38b6-89ed-44b5ccd3edf8",
                                "text": "„Zu den praktischen Aufgaben der Hydrologie gehören das Management oberirdischer Gewässer (Flüsse, Seen, Talsperren) im Zusammenhang mit Wasserversorgung, Wasserkraftgewinnung, öffentliche Nutzung der Gewässer (z. B. für Freizeitaktivitäten) und der Hochwasserschutz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31dcaad8-197e-47d7-ae79-fa11e0a72e08",
                        "source_entry_id": "d3ea9e50-8035-3a10-9e4e-5ac8b07aeed0",
                        "source_sense_id": "951987aa-710f-38b6-89ed-44b5ccd3edf8",
                        "source_sense_description": "die Lehre, Wissenschaft vom Wasser",
                        "target_lang_word": "hydrology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e823abe8-7c97-3bb6-a2bf-46a97126ad96",
                                        "entry_id": "ecee72c2-c6e0-363a-a07a-60da69b1382f",
                                        "glosses": [
                                            "The science of the properties, distribution, and effects of water on a planet's surface, in the soil and underlying rocks, and in the atmosphere"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f0416a43-6673-3261-9396-be58ca2ca1ad",
                                        "entry_id": "ecee72c2-c6e0-363a-a07a-60da69b1382f",
                                        "glosses": [
                                            "The properties, distribution, and flows of water in a specific locale; the hydrological characteristics of a particular place or region."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b6f7b41-ef41-4477-adfd-452d6dc9b627",
                                                "sense_id": "f0416a43-6673-3261-9396-be58ca2ca1ad",
                                                "text": "Excessively high floods may be caused by obstructions which were not noted by the observer subsequently removed. Information of this kind is necessary, but it is equally necessary that something of the local hydrology should be also known and applied."
                                            },
                                            {
                                                "example_id": "73e2815e-33b8-414e-a547-9971a8b18970",
                                                "sense_id": "f0416a43-6673-3261-9396-be58ca2ca1ad",
                                                "text": "Operations studies are required to define appropriate hydrologies and facility operations schedules on which to base the Delta modeling."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd531fd5-deb7-44e3-8647-4d1936adf12b",
                        "source_entry_id": "d3ea9e50-8035-3a10-9e4e-5ac8b07aeed0",
                        "source_sense_id": "951987aa-710f-38b6-89ed-44b5ccd3edf8",
                        "source_sense_description": "die Lehre, Wissenschaft vom Wasser",
                        "target_lang_word": "hydrologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9264371-6f22-301b-8888-1ed4f4e6e075",
                                        "entry_id": "4de5e40b-b802-33a3-8b73-06990f6b0c66",
                                        "glosses": [
                                            "Partie de l’histoire naturelle qui traite des eaux, de leur nature et de leurs propriétés diverses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224d964a-9e8d-4547-a8d5-8a612ed8fea8",
                                                "sense_id": "b9264371-6f22-301b-8888-1ed4f4e6e075",
                                                "text": "En plus de fournir une description universelle de l’hydrologie, il couvre de multiples sujets dont l’estimation statistique des débits, l’exploitation des eaux, les systèmes d’information géographique et la télédétection."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56f62099-3118-3f41-9a08-132963d91d11",
                                        "entry_id": "4de5e40b-b802-33a3-8b73-06990f6b0c66",
                                        "glosses": [
                                            "Ensemble des processus de circulation de l’eau à l'échelle d'un bassin versant ou de la planète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18c08198-dc23-4ec9-842a-b87ad2af38ec",
                                                "sense_id": "56f62099-3118-3f41-9a08-132963d91d11",
                                                "text": "En modifiant l’hydrologie et les flux de matériaux, l'homme a généré une déstabilisation de l'ensemble de la rivière dans laquelle la végétation ripuaire joue un rôle de catalyseur des mécanismes et de relais entre les différentes composantes de notre système."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b31bb103-6fd3-3a0b-a3ce-ee7649e4ad5c",
                                        "entry_id": "4de5e40b-b802-33a3-8b73-06990f6b0c66",
                                        "glosses": [
                                            "Ensemble des processus de circulation d’un fluide se comportant comme l’eau (même si ce n’est pas de l’eau) sur un corps planétaire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4ea008b-660a-4765-b46f-a8f5b2cba50b",
                                                "sense_id": "b31bb103-6fd3-3a0b-a3ce-ee7649e4ad5c",
                                                "text": "L'hydrologie de Titan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c1aaeca8-8412-45b3-87c8-ac967a2080cd",
                        "source_entry_id": "d3ea9e50-8035-3a10-9e4e-5ac8b07aeed0",
