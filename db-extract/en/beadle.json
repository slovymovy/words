            {
                "entry_id": "3163d05b-fc1a-3344-8c95-5cfb2f4f7f6c",
                "word": "beadle",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e0f05771-b5ee-4941-9ec5-5d381a75e433",
                        "entry_id": "3163d05b-fc1a-3344-8c95-5cfb2f4f7f6c",
                        "tags": [
