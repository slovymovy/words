                        "sense_id": "03d84f48-73d9-3e0e-aab3-dc4030c5db3c",
                        "entry_id": "c03d9f9e-22b1-38f4-a330-664bb96b2790",
                        "glosses": [
                            "Filled or overrun (with moving objects or beings)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efd704d1-39ee-422f-ab47-57494f21ba30",
                                "sense_id": "03d84f48-73d9-3e0e-aab3-dc4030c5db3c",
                                "text": "1882, Algernon Charles Swinburne, Sonnets on English Dramatic Poets, “Ben Jonson,” in Tristram of Lyonesse, and other poems, Portland, Maine: Thomas B. Mosher, 1904, p. 309,\nThe mountain where thy Muse’s feet made warm\nThose lawns that revelled with her dance divine\nShines yet with fire as it was wont to shine\nFrom tossing torches round the dance aswarm."
                            },
                            {
                                "example_id": "65281d7b-505f-44de-8875-2a5d187a08d9",
                                "sense_id": "03d84f48-73d9-3e0e-aab3-dc4030c5db3c",
                                "text": "The juniors hurried out like bees aswarm, asking no questions, clattered up the staircase, and added themselves to the embroilment."
                            },
                            {
                                "example_id": "0f6fe933-6270-412c-8f74-18c1afe00fab",
                                "sense_id": "03d84f48-73d9-3e0e-aab3-dc4030c5db3c",
                                "text": "Over all the more populous districts the air was ever aswarm with planes up to a height of five miles, where the giant air-liners plied between the continents."
                            },
                            {
                                "example_id": "891037d3-4153-4c94-bbfb-7c94a16831d5",
                                "sense_id": "03d84f48-73d9-3e0e-aab3-dc4030c5db3c",
                                "text": "He banished all irrelevancies from his canalised mind. His great ham of a face was tickling as though aswarm with insects, but there was no room left in his brain to receive the messages which his nerve endings were presumably delivering—his brain was full."
                            }
                        ]
                    }
