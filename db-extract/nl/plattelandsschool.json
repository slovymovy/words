                        "examples": [
                            {
                                "example_id": "39d803fb-3661-4041-b388-65951da906f7",
                                "sense_id": "62673c84-ad62-3b0f-b0e5-ab828d983965",
                                "text": "\"We waren net aan het herstellen van die afgrijselijke jaren. 2014 leek een uitstekend jaar te worden. En toen, in september, kwamen die studenten in het nieuws.\" Mevrouw Zavala doelt op de 43 vermiste studenten van de plattelandsschool van Ayotzinapa."
                            },
                            {
                                "example_id": "daeb8702-53a0-4e7d-a53a-542004abd2b5",
                                "sense_id": "62673c84-ad62-3b0f-b0e5-ab828d983965",
                                "text": "De eerste schooldag in het nieuwe jaar is altijd speciaal. Zeker op de basisschool Ypelo/Rectum. Daar werd maandagmorgen aan alle kinderen en medewerkers van de kleine plattelandsschool een nieuwjaarsbuffet geserveerd."
                            }
                        ]
