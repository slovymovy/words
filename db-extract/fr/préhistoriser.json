                "senses": [
                    {
                        "sense_id": "b14d3f36-8e35-3bc3-831d-6158354e7528",
                        "entry_id": "c8afb288-bfa0-3de0-a8ce-c9517c9411c6",
                        "glosses": [
                            "Donner un caractère préhistorique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10e6285b-cf5a-470d-aa36-214e74a15ef1",
                                "sense_id": "b14d3f36-8e35-3bc3-831d-6158354e7528",
                                "text": "Joli programme, et nous on se charge de préhistoriser tes cheveux!"
                            },
                            {
                                "example_id": "769ad59b-752a-4b5e-ae22-24aa5c36b011",
                                "sense_id": "b14d3f36-8e35-3bc3-831d-6158354e7528",
                                "text": "« Préhistoriser » le présent"
                            },
                            {
                                "example_id": "ad944982-f783-4dfb-af24-a1a64f279d5b",
                                "sense_id": "b14d3f36-8e35-3bc3-831d-6158354e7528",
                                "text": "La peau de bête déguenillée est essentielle à l’image de l’homme préhistorique : équiper n’importe quel personnage d’une massue et d’une peau de bête, cela suffit à le préhistoriser, pourrait-on dire."
                            },
                            {
                                "example_id": "3ebd28ff-b02d-446c-99b2-43c1fd92829e",
                                "sense_id": "b14d3f36-8e35-3bc3-831d-6158354e7528",
                                "text": "Pour se « préhistoriser », donc, se désensucrer et s’amertumiser."
                            }
                        ]
                    }
