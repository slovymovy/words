                "senses": [
                    {
                        "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                        "entry_id": "42da22ea-1736-35e2-9e62-0732dc0fdc47",
                        "glosses": [
                            "Faire diminuer en provoquant une déplétion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7212c4e-5599-4ec2-8901-df0934c30d69",
                                "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                                "text": "Il existe une technique d'épuration sans dialyse qui consiste à faire une très forte ultrafiltration tout en substituant le plasma retiré par une perfusion, sauf bien sûr la quantité à dépléter au final. Cela s'appelle de l'hémofiltration."
                            },
                            {
                                "example_id": "a489702a-aee1-442f-9df7-9a3897f243cd",
                                "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                                "text": "Des séries de déplétions ont été réalisées afin de dépléter les 14 protéines majoritaires (colonne IgY14TM) de l’échantillon avant son analyse par trois approches effectuées en parallèle"
                            },
                            {
                                "example_id": "1c1a0853-d0b5-4ad1-aa8b-2ed0daa49cb1",
                                "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                                "text": "Objectif : Dépléter la cellule tumorale en Fer et réduire ou annihiler sa croissance."
                            },
                            {
                                "example_id": "0b4c215e-d511-4f4d-989d-2ee251282b36",
                                "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                                "text": "Nous avons donc développé des anticorps spécifiques, protégés par un brevet détenu par le CNRS, qui ont pour propriétés de bloquer et dépléter in vitro."
                            },
                            {
                                "example_id": "c3a95bfe-afd7-48b2-add5-3a434349e217",
                                "sense_id": "7740175a-1fe3-3b4a-9edb-ad380676a318",
                                "text": "Techniques de génétiques de drosophile (croisements, utilisation de lignées Gal4 pour dépléter ou surexprimer la protéine d’intérêt dans des tissus spécifiques, génération de lignées transgéniques, variégation à effet de position, ….)."
                            }
                        ]
                    }
