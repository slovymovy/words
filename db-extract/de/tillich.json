                "senses": [
                    {
                        "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                        "entry_id": "c4d7aa84-0724-36dd-a74a-b06adf834c5a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3612cd12-168b-4683-8df9-0d03d30a51dc",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Frau Tillich ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "835a8623-d006-4d76-8e14-5e601750e0c7",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Herr Tillich wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b669af16-2611-4b81-a898-e5ae702e6e8a",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Die Tillichs fliegen heute nach Istanbul."
                            },
                            {
                                "example_id": "dcb07716-e90c-422d-ba27-9ca1bae7d9ef",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Der Tillich trägt nie die Pullover, die die Tillich ihm strickt."
                            },
                            {
                                "example_id": "03802c70-2b04-4d93-8c7f-c6337ec46396",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Tillich kommt, geht der Herr Tillich.“"
                            },
                            {
                                "example_id": "b368fd5b-6f53-4862-af89-670deeccfc8e",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Tillich kommt und geht."
                            },
                            {
                                "example_id": "3dd3354a-03f1-494f-bbb4-3127cc3578cb",
                                "sense_id": "d9261fd6-0e61-34f4-b9e6-90cd2ea27aa8",
                                "text": "Tillichs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
