                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                        "entry_id": "28878445-3d59-3d79-9926-4391e1c8bb3d",
                                        "glosses": [
                                            "To purify using clay."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af8bef3a-82dd-4e5f-93fa-2eb7b3ee8a51",
                                                "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                                "text": "1776, Adam Smith, An Inquiry into the Nature and Causes of the Wealth of Nations, Book IV, Chapter 7: Of Colonies, Part 2: Causes of Prosperity of New Colonies,\nThey amounted, therefore, to a prohibition, at first of claying or refining sugar for any foreign market, and at present of claying or refining it for the market, which takes off, perhaps, more than nine-tenths of the whole produce."
                                            },
                                            {
                                                "example_id": "f250b781-f02b-4da5-8ba4-cc64a3a16eb1",
                                                "sense_id": "3f78e9d3-6c1d-353b-9eae-9b42d9d8f26f",
                                                "text": "The Portuguese had mastered the technique of claying sugar, and other European nations tried to learn the secrets from them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64815887-bdf7-482b-9c99-739838ce66a6",
