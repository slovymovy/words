                    {
                        "sense_id": "a904907f-bf15-3cee-9c70-8ae82671df0b",
                        "entry_id": "7f158cb8-094c-3541-b6c0-4d17366b85ea",
                        "glosses": [
                            "Principe considérant que les individus sont répartis de manière homogène au sein de la population et participent, en matière reproductive, à la formation de la génération suivante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7f5c4d9-05d8-4241-ba35-eae70853d772",
                                "sense_id": "a904907f-bf15-3cee-9c70-8ae82671df0b",
                                "text": "La panmixie est l’une des hypothèses de travail du principe de Hardy-Weinberg."
                            },
                            {
                                "example_id": "6dde9019-2a15-4a94-a226-7cc89d67e503",
                                "sense_id": "a904907f-bf15-3cee-9c70-8ae82671df0b",
                                "text": "Certains auteurs englobent sous le nom de panmixie l’ensemble des conditions de validité de la loi de Hardy-Weinberg."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
