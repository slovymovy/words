                ],
                "senses": [
                    {
                        "sense_id": "d824b6a4-dfce-3d58-9ee2-2a2e1499fe7d",
                        "entry_id": "8713432c-201a-391e-ab2c-119b7f0be354",
                        "glosses": [
                            "ohne Glas, kein Glas habend, nicht verglast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e886499-40b7-4c24-ae58-b5dcdea9749f",
                                "sense_id": "d824b6a4-dfce-3d58-9ee2-2a2e1499fe7d",
                                "text": "„Es war immerhin so hoch, dass sich die oberste Reihe seiner glaslosen Fenster direkt über der Asche befand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1d2077-5185-4735-b838-e2924b261a2f",
                        "source_entry_id": "8713432c-201a-391e-ab2c-119b7f0be354",
                        "source_sense_id": "d824b6a4-dfce-3d58-9ee2-2a2e1499fe7d",
                        "source_sense_description": "ohne Glas",
                        "target_lang_word": "glassless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glassless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "662042fd-4975-3127-bdb4-a61825816c3c",
                                        "entry_id": "a94d0bc3-0e7e-3800-a7f8-474cb0395965",
                                        "glosses": [
                                            "Without glass."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f30c2b2-7164-4c39-b6f4-f2bfb722a7a3",
                                                "sense_id": "662042fd-4975-3127-bdb4-a61825816c3c",
                                                "text": "The glassless windows of the old house looked menacing."
                                            },
                                            {
                                                "example_id": "36b48a11-0786-4e80-b26a-9878046b5bb4",
                                                "sense_id": "662042fd-4975-3127-bdb4-a61825816c3c",
                                                "text": "Nearly every station has its quota of wrecked rolling stock, sometimes on a great scale; once fine stations, where the structure stands, are glassless and open to the sky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
