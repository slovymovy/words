                "senses": [
                    {
                        "sense_id": "158d230e-955f-3999-9132-ea490f524f48",
                        "entry_id": "526130ac-922b-3057-a160-119661205b64",
                        "glosses": [
                            "воен., сокр. от командир батальона"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "b357c5ae-0873-436a-b8d9-276eca2be261",
                                "sense_id": "158d230e-955f-3999-9132-ea490f524f48",
                                "text": "На прошедших недавно под Рязанью тактических учениях с боевой стрельбой действия комбата Рязанцева и его батальона получили высокую оценку."
                            }
                        ]
                    },
                    {
                        "sense_id": "240ea73e-f0e0-3a26-b09b-449816450a63",
                        "entry_id": "526130ac-922b-3057-a160-119661205b64",
                        "glosses": [
                            "воен., сокр. от командир батареи"
                        ],
                        "tags": [
                            "abbreviation"
                        ],
                        "examples": [
                            {
                                "example_id": "dbf59e41-750d-49bf-9112-ceded2a6fe49",
                                "sense_id": "240ea73e-f0e0-3a26-b09b-449816450a63",
                                "text": "По приказу комбата батарея открыла огонь."
                            }
                        ]
                    }
                ],
