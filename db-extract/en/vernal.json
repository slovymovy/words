                                    {
                                        "sense_id": "8373083b-bdbb-378d-88f6-8b3e4db48b0a",
                                        "entry_id": "1e2706ca-82e6-3893-a0ef-8fcaf0b1cfde",
                                        "glosses": [
                                            "Qui appartient au printemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "785e7c4c-2943-450d-b10f-b3f498906f75",
                                                "sense_id": "8373083b-bdbb-378d-88f6-8b3e4db48b0a",
                                                "text": "equinoctium vernal : équinoxe de printemps"
                                            },
                                            {
                                                "example_id": "47a54c8a-4714-4adf-918c-d7af1249a3d3",
                                                "sense_id": "8373083b-bdbb-378d-88f6-8b3e4db48b0a",
                                                "text": "Dans toute la vallée moyenne on observe généralement deux périodes de grande pluviosité : l’une hivernale (novembre-décembre), l’autre vernale (février-avril) […]"
                                            },
                                            {
                                                "example_id": "275126a0-b80b-4a83-801a-14be5d2c65ed",
                                                "sense_id": "8373083b-bdbb-378d-88f6-8b3e4db48b0a",
                                                "text": "Parmi les signaux de l’arrivée du printemps en milieu forestier figurent les floraisons des plantes dites vernales qui fleurissent très tôt au printemps avant l’émergence des feuillages des arbres, profitant de la lumière encore disponible au sol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bf27d42-56a3-307c-a54a-a3f2720484ee",
                                        "entry_id": "1e2706ca-82e6-3893-a0ef-8fcaf0b1cfde",
                                        "glosses": [
                                            "Printanier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ff64c8-2c6b-41f7-a39b-a426ccfe38a6",
                                                "sense_id": "6bf27d42-56a3-307c-a54a-a3f2720484ee",
                                                "text": "J’ai quitté l’île heureuse hélas !… Ah ! si jamais\nVers Syracuse et les abeilles et les vignes\n Tu retournes, suivant le vol vernal des cygnes,\n Cher hôte informe-toi de celle que j’aimais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8daadf5f-ba52-4c54-8c3b-0737c190ead3",
                        "source_entry_id": "053fe581-a731-36fa-b8d7-09602999d584",
                        "source_sense_description": "pertaining to or occurring in spring",
                        "target_lang_word": "printanier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "printanier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "35ae86b6-e7ef-3b00-8b6a-87ce12370bd2",
                                        "entry_id": "5d4f325f-11ee-3711-a8e9-2a0b20729faa",
                                        "glosses": [
                                            "Qui se rapporte au printemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64608898-e8f7-44ae-9ac2-1158785c0c1a",
                                                "sense_id": "35ae86b6-e7ef-3b00-8b6a-87ce12370bd2",
                                                "text": "L’Inde autrefois nous donna l’anémone,\nDe nos jardins ornement printanier."
                                            },
                                            {
                                                "example_id": "b380b74d-955e-4a3d-b795-9e28e2e1ded7",
                                                "sense_id": "35ae86b6-e7ef-3b00-8b6a-87ce12370bd2",
                                                "text": "Les partis politiques annoncent des candidatures, de potentiels candidats font leur entrée sur les médias sociaux et on commence à voir des publicités, mais est-ce que la fenêtre pour un scrutin printanier n’est pas en train de se refermer tranquillement ?"
                                            },
                                            {
                                                "example_id": "defef3ef-2f44-4b48-9ffd-9ef67e86f0db",
                                                "sense_id": "35ae86b6-e7ef-3b00-8b6a-87ce12370bd2",
                                                "text": "Temps humide, redoux… malheureusement pour les cultures de printemps, le climat printanier plait aux limaces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                        "entry_id": "5d4f325f-11ee-3711-a8e9-2a0b20729faa",
                                        "glosses": [
                                            "Frais, fleuri et gai comme le printemps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1155358-853d-48ef-91ca-a80c4a87dcbb",
                                                "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                                "text": "L’on avait nommé la jeune princesse Printanière, parce qu’elle avait un teint de lis et de roses, plus frais et plus fleuri que le printemps."
                                            },
                                            {
                                                "example_id": "b73e9444-4cb7-47eb-a6a2-1f3fb808c75a",
                                                "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                                "text": "Ô vingt ans printaniers ! Étincelante aurore !\nL’amour, à son matin, farouche et libre encore,\nEst comme un jeune aiglon qui tente un premier vol."
                                            },
                                            {
                                                "example_id": "6df96a9e-e749-4cc2-9590-37cfa63e7132",
                                                "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                                "text": "Il fait doux, il fait clair. L’hiver commence à peine et je ne sais quoi de printanier flotte dans l’air subtil."
                                            },
                                            {
                                                "example_id": "fea813f3-b21d-4a3d-bbc1-1bab740fe446",
                                                "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                                "text": "C’est le matin. L’air est limpide et printanier."
                                            },
                                            {
                                                "example_id": "73110e56-0f5f-42f7-885e-94da206b44c1",
                                                "sense_id": "30d2b423-1f8e-36bf-bec3-5fe009f7b307",
                                                "text": "Étoffes printanières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb609162-e310-38e2-b57e-559432754b20",
                                        "entry_id": "5d4f325f-11ee-3711-a8e9-2a0b20729faa",
                                        "glosses": [
                                            "Qui contient des légumes qui poussent au printemps, tels que carottes, asperges, petits pois, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "828deb0a-cebf-4154-bba1-386367817f2c",
                                                "sense_id": "bb609162-e310-38e2-b57e-559432754b20",
                                                "text": "Potage printanier aux quenelles.\nPoule au riz.\nCôtelettes de mouton à la jardinière.\nJambon au naturel.\nSalade de légumes.\nTarte de groseilles vertes, à la crème."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
