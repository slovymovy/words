                        "glosses": [
                            "door medisch ingrijpen veroorzaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37c0355e-1582-4b9d-8143-9732b30375d5",
                                "sense_id": "0d66d142-0353-3ade-8629-c395e02acb82",
                                "text": "Bij overvloedig, overbodig en langdurig medicijngebruik zijn iatrogene aandoeningen niet uit te sluiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4db4d1c9-9e7a-47dd-b41d-6640a9430afd",
                        "source_entry_id": "02bb27ce-2033-3feb-85e7-73d3c2444981",
                        "source_sense_id": "0d66d142-0353-3ade-8629-c395e02acb82",
                        "source_sense_description": "door medisch ingrijpen veroorzaakt",
                        "target_lang_word": "iatrogenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iatrogenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "166823e5-7886-32e5-b684-362d0e3fc904",
                                        "entry_id": "6e5b759a-b49f-3441-942b-15c6dd4f5b4a",
                                        "glosses": [
                                            "Induced by the words or actions of the physician or by medical treatment or diagnostic procedure."
                                        ],
                                        "tags": [
                                            "of a disease"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cf460b3-e88a-4881-93c9-ead837e6c35a",
                                                "sense_id": "166823e5-7886-32e5-b684-362d0e3fc904",
                                                "text": "Another group argues that the diagnosis is being overused and that many of the diagnosed cases are iatrogenic, or unintentionally shaped or caused by the practitioner"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3a57e73-2be8-47c9-8a1d-dbc35d3bd949",
                        "source_entry_id": "02bb27ce-2033-3feb-85e7-73d3c2444981",
                        "source_sense_id": "0d66d142-0353-3ade-8629-c395e02acb82",
                        "source_sense_description": "door medisch ingrijpen veroorzaakt",
                        "target_lang_word": "iatrogène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iatrogène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf4f646a-b189-3f09-8b4e-d26b614ce5a3",
                                        "entry_id": "7aabf100-6466-336d-97b2-c6659b4295cc",
                                        "glosses": [
                                            "Relatif à un effet indésirable provoqué par un médecin ou un traitement médical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1de7395c-f9e3-431e-9286-5a683f765572",
                                                "sense_id": "cf4f646a-b189-3f09-8b4e-d26b614ce5a3",
                                                "text": "La Haute Autorité de santé (HAS), dans ses recommandations, évoque une dépendance iatrogène – pathologie causée par un acte médical – « évitable », qui représenterait 10 % des hospitalisations de personnes âgées en services de soins aigus. Autrement dit, au bas mot, des dizaines de milliers de personnes âgées deviennent dépendantes chaque année en raison d’une prise en charge insatisfaisante dans des moments-clé de leur hospitalisation."
                                            },
                                            {
                                                "example_id": "a98076f8-9ebe-45dd-afc5-0987cd882de1",
                                                "sense_id": "cf4f646a-b189-3f09-8b4e-d26b614ce5a3",
                                                "text": "Si l’hystérie n'est pas au départ une maladie iatrogène, le médecin n’en a pas moins parfois un rôle regrettable dans la fixation des troubles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f53c6f17-aa59-4b6d-b1ac-9c8f8ba3423c",
                        "source_entry_id": "02bb27ce-2033-3feb-85e7-73d3c2444981",
                        "source_sense_id": "0d66d142-0353-3ade-8629-c395e02acb82",
