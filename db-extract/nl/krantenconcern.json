                        "examples": [
                            {
                                "example_id": "13820345-d722-4948-acb2-cb16e2d1a3eb",
                                "sense_id": "c76e31b3-4920-3853-9b74-81bae6fa3ff4",
                                "text": "In Amerika klaagden Britse aandeelhouders van het krantenconcern de Murdochs aan vanwege misleiding. Rupert en James Murdoch deden de afluisterpraktijken namelijk in eerste instantie af als een geïsoleerd incident. Van deze beschuldiging werden ze eerder dit jaar vrijgesproken."
                            },
                            {
                                "example_id": "6667692c-2cfa-496c-a744-ca5a367e806e",
                                "sense_id": "c76e31b3-4920-3853-9b74-81bae6fa3ff4",
                                "text": "Talpa is met het Belgische Mediahuis in een strijd verwikkeld om het krantenconcern. De raad van commissarissen van TMG ziet meer in de plannen van het Mediahuis. Ook de redactieraad vroeg De Mol om te stoppen met de overnamestrijd."
                            }
                        ]
                    }
