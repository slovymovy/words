                "translations": [
                    {
                        "translation_id": "776cab78-f133-4a7a-94db-39706ea40eff",
                        "source_entry_id": "59195c82-21f6-3877-9d20-16a1f42ac3e5",
                        "source_sense_description": "fluctuating, uncertain",
                        "target_lang_word": "wankelmütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wankelmütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50d6dda0-a687-35f9-bd0a-6026d7810831",
                                        "entry_id": "917436a5-b280-37e2-acd4-d2b2a8d4e83a",
                                        "glosses": [
                                            "unentschlossen, unbeständig, unsicher in Gesinnung und Haltung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "903a5ca9-2a6e-4541-b0a3-32b5dac00056",
                                                "sense_id": "50d6dda0-a687-35f9-bd0a-6026d7810831",
                                                "text": "Sein wankelmütiges Verhalten brachte ihm kein Vertrauen."
                                            },
                                            {
                                                "example_id": "1756c1ef-c79f-4984-b43e-c8e07d9e7e12",
                                                "sense_id": "50d6dda0-a687-35f9-bd0a-6026d7810831",
                                                "text": "„Von wankelmütigen Herrschern beauftragt, von einer unzuverlässigen Mannschaft begleitet, begab er sich auf unabsehbare Zeit unter unvorhersehbaren Gefahren auf eine Reise jenseits der Grenzen der bekannten Welt, um auf unsicheren Wegen ein erhofftes Ziel zu erreichen.“"
                                            },
                                            {
                                                "example_id": "e660dccc-3fc6-4203-acd6-9a8943965917",
                                                "sense_id": "50d6dda0-a687-35f9-bd0a-6026d7810831",
                                                "text": "„Hinzu kommen die kaum vorhandene Abgrenzung und die wankelmütigen politischen Prinzipien der etablierten gegenüber den religiösen Gruppierungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af32a88e-0162-4d68-891e-6e361f0dda80",
                        "source_entry_id": "59195c82-21f6-3877-9d20-16a1f42ac3e5",
                        "source_sense_description": "fluctuating, uncertain",
                        "target_lang_word": "unschlüssig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unschlüssig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                        "entry_id": "ec3abe71-f588-38b6-b23f-726cedebe0da",
                                        "glosses": [
                                            "unsicher, wie etwas zu beurteilen oder was zu tun ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af7b838-9b83-4dfe-a1a7-2b284c68c4e7",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Ein paar Stühle standen herum, wie unschlüssige Besucher, die nicht wissen, was sie tun sollen.“"
                                            },
                                            {
                                                "example_id": "42ec81fc-74ec-4dd9-a307-134e9fdcc5b1",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Ich nickte unschlüssig und versuchte, zu ignorieren, dass er damit überdeutlich andeutete, dass sie bis jetzt noch immer nicht gänzlich überzeugt war.“"
                                            },
                                            {
                                                "example_id": "ede1703e-556e-48b7-99b4-581519ef0894",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Ich stand einen Augenblick unschlüssig im Gang herum und wusste nicht recht, was ich jetzt mit mir anfangen sollte.“"
                                            },
                                            {
                                                "example_id": "7e893aff-683c-4be4-9b6d-f75903335ebc",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Mit Ende 30 ist Melanie Hughes immer noch unschlüssig, ob sie überhaupt Kinder haben möchte.“"
                                            },
                                            {
                                                "example_id": "33161c70-e681-496c-9c3b-6a552b3f218d",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Der Mann, der noch immer zögernd und unschlüssig in der Empfangshalle stand, wandte das Gesicht ab.“"
                                            },
                                            {
                                                "example_id": "162eca80-379b-4be0-8173-93dd2a7d18ae",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„Und es wurde mir schwer, die zögernde und unschlüssige Haltung des Deutschen Reichs mit anzusehen.“"
                                            },
                                            {
                                                "example_id": "1e558cf4-54a1-46e0-9aa2-a76730fdcc3c",
                                                "sense_id": "2fc4f8f6-a4f6-3cbf-ae09-675033fdc250",
                                                "text": "„In einem miesen Börsenklima, geprägt von Konjunkturschwäche, Umsatz- und Ertragswarnungen bewahren Stoppkurse unschlüssige Aktionäre vor hohem Verlust.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2df96e81-6ee6-3bd3-b269-9a55e5a06a0b",
                                        "entry_id": "ec3abe71-f588-38b6-b23f-726cedebe0da",
                                        "glosses": [
                                            "nicht logisch und überzeugend, folgerichtig (genug)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba95c73d-5987-4ca1-a63d-3075e1daef69",
                                                "sense_id": "2df96e81-6ee6-3bd3-b269-9a55e5a06a0b",
                                                "text": "Diese Facharbeit ist in sich unschlüssig und an manchen Stellen sogar widersprüchlich."
                                            },
                                            {
                                                "example_id": "1fd44bdb-d8ec-4679-b633-373b2704b492",
                                                "sense_id": "2df96e81-6ee6-3bd3-b269-9a55e5a06a0b",
                                                "text": "„Eine unzulässige oder unschlüssige Klage kann im Laufe des gerichtlichen Verfahrens noch zulässig und schlüssig werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
