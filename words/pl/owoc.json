                {
                    "sense_id": "4d5ad990-c580-3d82-8304-6cb2c8c1854d",
                    "sense_definition": "Jadalna część rośliny, zazwyczaj soczysta i słodka, zawierająca nasiona.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W twojej diecie powinno znaleźć się więcej warzyw i <w>owoców</w>.",
                            "target_lang_translations": {
                                "ru": "В твоей диете должно быть больше овощей и <w>фруктов</w>.",
                                "en": "Your diet should include more vegetables and <w>fruit</w>.",
                                "de": "In deiner Ernährung sollte mehr Gemüse und <w>Obst</w> enthalten sein."
                            }
                        },
                        {
                            "text": "Na deser podano pyszne, świeże <w>owoce</w> z bitą śmietaną.",
                            "target_lang_translations": {
                                "ru": "На десерт подали вкусные свежие <w>фрукты</w> со взбитыми сливками.",
                                "en": "Delicious, fresh <w>fruit</w> with whipped cream was served for dessert.",
                                "de": "Zum Nachtisch wurden köstliche, frische <w>Früchte</w> mit Schlagsahne serviert."
                            }
                        }
                    ],
                    "common_phrases": [
                        "świeże owoce",
                        "owoce sezonowe",
                        "owoce morza",
                        "owoce leśne"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобная часть растения, обычно сочная и сладкая, содержащая семена.",
                        "en": "An edible part of a plant, usually juicy and sweet, containing seeds.",
                        "de": "Essbarer Teil einer Pflanze, meist saftig und süß, der Samen enthält."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фрукт",
                                "target_lang_sense_clarification": "сочный съедобный плод (кулинарное)"
                            },
                            {
                                "target_lang_word": "плод",
                                "target_lang_sense_clarification": "часть растения с семенами (ботаническое)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "fruit",
