                                "target_word": "prévu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1f3a5e2-43a9-3a1c-9526-93ef79454d93",
                                        "entry_id": "583b8e22-bafa-37f1-a9a7-a06136b041ed",
                                        "glosses": [
                                            "Masculin singulier du participe passé du verbe prévoir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
