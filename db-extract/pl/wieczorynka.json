                                            {
                                                "example_id": "d9d97cb1-c14b-4ec0-b6da-4784d0c94dc0",
                                                "sense_id": "219c5f5a-2dce-3699-92a4-e6231ee209fe",
                                                "text": "Sie schreibt am schnellsten an der alten Maschine."
                                            },
                                            {
                                                "example_id": "780aedd6-9fff-41c8-8881-d8f66d466063",
