                        "glosses": [
                            "Celui qui a obtenu un diplôme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f2d86a-74e7-49ac-9dd2-6d107b641ac6",
                                "sense_id": "5a86054c-a0d7-3a33-b921-4462d1c33f64",
                                "text": "Fin 2005, environ 240 000 bénéficiaires de l’allocation de solidarité spécifique ont été reçus pour être « remobilisés » et un suivi spécial a été lancé pour les jeunes diplômés des zones urbaines sensibles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "854205df-a82b-4e0c-af1b-753730ce21bd",
                        "source_entry_id": "f2a50e6c-7c2c-37e0-ab91-de376ea939ef",
                        "source_sense_id": "5a86054c-a0d7-3a33-b921-4462d1c33f64",
                        "target_lang_word": "Absolvent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Absolvent",
