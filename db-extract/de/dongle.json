                "senses": [
                    {
                        "sense_id": "c1a1b66d-0572-311b-b830-ceb87c69bdce",
                        "entry_id": "d775dc3a-4f6e-3668-bbc6-ee2621cdb8ed",
                        "glosses": [
                            "ein Stecker für eine Computerschnittstelle, die der Sicherung einer Computeranwendung gegen unbefugte Benutzung dient"
                        ],
                        "tags": [
                            "Informationstechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "b7f14d51-f431-4baa-8b57-687febe2c839",
                                "sense_id": "c1a1b66d-0572-311b-b830-ceb87c69bdce",
                                "text": "Dieser Compiler funktioniert nur mit eingestecktem Dongle."
                            },
                            {
                                "example_id": "7962da1f-309d-4115-bf44-33d627a40581",
                                "sense_id": "c1a1b66d-0572-311b-b830-ceb87c69bdce",
                                "text": "Viele Softwareunternehmen schützen ihre Produkte mit einem Dongle gegen Raubkopieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00031ad7-36d6-4476-ad3f-5130936f5599",
                        "source_entry_id": "d775dc3a-4f6e-3668-bbc6-ee2621cdb8ed",
                        "source_sense_id": "c1a1b66d-0572-311b-b830-ceb87c69bdce",
                        "source_sense_description": "Stecker für eine Computerschnittstelle zur Sicherung einer Computeranwendung gegen unbefugte Benutzung",
                        "target_lang_word": "dongle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dongle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc17301f-5227-3281-a471-faef2e7b710d",
                                        "entry_id": "617dcab3-a10e-3ccd-8572-07c96d2aa1a3",
                                        "glosses": [
                                            "Any small device that plugs into an electronic device, typically a computer, and alters its functionality. Common examples include wireless modems, digital media players, software copy protect devices, and adapters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44693969-03af-4e72-888b-9faba1b520cc",
                                                "sense_id": "fc17301f-5227-3281-a471-faef2e7b710d",
                                                "text": "FreedomPop will offer three different flavors of broadband: a USB dongle that allows you to connect your computer to the internet, a WiFi hotspot device, and an iPhone case that allows you to override the phone's existing network and use it as a FreedomPop hotspot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96011e21-b190-34b6-ab15-25b0bb705cca",
                                        "entry_id": "617dcab3-a10e-3ccd-8572-07c96d2aa1a3",
                                        "glosses": [
                                            "A hardware device used by a specific application for purposes of copy protection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f7e7966-9de5-4ec6-ae1e-d861379beb25",
                                                "sense_id": "96011e21-b190-34b6-ab15-25b0bb705cca",
                                                "text": "Take the dongle, for example. It is the summit of copy protection, an explicit melding of software and hardware. Without the right hardware key—the dongle—plugged into the machine's parallel port, the software won't run."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
