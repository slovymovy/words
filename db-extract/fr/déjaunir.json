                "senses": [
                    {
                        "sense_id": "e0217e6e-3d5a-3979-9f85-39d9024a8698",
                        "entry_id": "91d1bca6-4d09-3497-9e57-3c5c6024ed95",
                        "glosses": [
                            "Faire perdre sa couleur jaune à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fb643e2-6850-4540-8fe5-c39f37f1ec5e",
                                "sense_id": "e0217e6e-3d5a-3979-9f85-39d9024a8698",
                                "text": "C'est prouvé par un centre de recherche japonais, les bains de vin rouge déjaunissent la peau."
                            },
                            {
                                "example_id": "fdf64253-ac86-4171-a736-5a96a5c14d0d",
                                "sense_id": "e0217e6e-3d5a-3979-9f85-39d9024a8698",
                                "text": "Je n'utilise aucun produit à base d'acide qui certes déjaunissent mais sont irritants."
                            }
                        ]
                    },
                    {
                        "sense_id": "86da6eb8-ec31-32c7-a33a-53e847f2327a",
                        "entry_id": "91d1bca6-4d09-3497-9e57-3c5c6024ed95",
                        "glosses": [
                            "Perdre sa couleur jaune."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc162b3f-9477-4719-aa56-7766eb55c1e0",
                                "sense_id": "86da6eb8-ec31-32c7-a33a-53e847f2327a",
                                "text": "Bonsoir les filles, une amie m'a demandé de faire en sorte que ses cheveux déjaunissent."
                            }
                        ]
                    }
