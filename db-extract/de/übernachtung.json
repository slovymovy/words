                "senses": [
                    {
                        "sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                        "entry_id": "099ef070-c3a3-362a-aa38-1359efb21de2",
                        "glosses": [
                            "Aufenthalt zum Schlafen während der Nacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d751390-7179-462a-b5d5-8453a69c8b02",
                                "sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                                "text": "Für die Übernachtung kehrten wir im Hotel zur Weide ein."
                            },
                            {
                                "example_id": "fb12ba94-4d6a-4de1-9dd8-396928037c20",
                                "sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                                "text": "„Wir legten das Geld für die Übernachtung auf den Küchentisch.“"
                            },
                            {
                                "example_id": "67543c97-562a-4cc7-bb99-466d29faacd0",
                                "sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                                "text": "„Ich zog den einen Kissenbezug ab, dann überlegte ich mir die Sache anders und bezog das Kissen wieder, es könnte ja zu weiteren Übernachtungen kommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e210c63e-ebdb-47de-8599-1769efd24b7b",
                        "source_entry_id": "099ef070-c3a3-362a-aa38-1359efb21de2",
                        "source_sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                        "source_sense_description": "Aufenthalt zum Schlafen während der Nacht",
                        "target_lang_word": "over-night-stay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "72543998-b097-48f1-9535-f6c60881835f",
                        "source_entry_id": "099ef070-c3a3-362a-aa38-1359efb21de2",
                        "source_sense_id": "d4c3926f-85c0-3ccd-8860-0785054caa6e",
                        "source_sense_description": "Aufenthalt zum Schlafen während der Nacht",
                        "target_lang_word": "pernoctation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pernoctation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44dbcded-a2c0-3c0a-af30-5bcba203034e",
                                        "entry_id": "c2ea49da-845a-385a-a3f1-2d5c808b6802",
                                        "glosses": [
                                            "The action of abiding through the night at a location; (countable) an instance of this; an overnight stay."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9018abff-f1bc-4893-88a6-fc41642076ec",
                                                "sense_id": "44dbcded-a2c0-3c0a-af30-5bcba203034e",
                                                "text": "The next morning they [Mary and Joseph] return back with ſpeed toward Jeruſalem; and at night repairing to their former lodging, neither there it ſeems heard they any thing of him [Jesus] (which argues, for this time of his abſence his pernoctation in the Temple), and ſo they muſt paſs this ſecond night alſo in great deſolation."
                                            },
                                            {
                                                "example_id": "40ff85da-bcd3-4636-abfe-848afefc0538",
                                                "sense_id": "44dbcded-a2c0-3c0a-af30-5bcba203034e",
                                                "text": "For the purposes of this clause, residing in Oxford shall mean the occupation of a dwelling-house or lodging in Oxford with pernoctation, and residing in College shall mean the occupation of rooms in College, or of a house in immediate communication with the College, with pernoctation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f29a942-55bc-3c88-b1d6-75d291032a24",
                                        "entry_id": "c2ea49da-845a-385a-a3f1-2d5c808b6802",
                                        "glosses": [
                                            "The action of walking about at night, especially as a vigil or watch; (countable) an instance of this."
                                        ],
                                        "tags": [
                                            "formal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4459c6-6717-4ed4-a011-52c8755ea91c",
                                                "sense_id": "8f29a942-55bc-3c88-b1d6-75d291032a24",
                                                "text": "In 1599 Sʳ Robert Leech and Sʳ John Meades were guilty of pernoctation and breaking windows. They had been sent to prison by the Proctor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5d1ac9b-336f-3118-84ec-24315ee3a822",
                                        "entry_id": "c2ea49da-845a-385a-a3f1-2d5c808b6802",
                                        "glosses": [
                                            "A religious watch kept during normal sleeping hours, during which prayers or other ceremonies are performed; a vigil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "formal",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fc42e0e-965e-4290-82d5-30b133a81cca",
                                                "sense_id": "f5d1ac9b-336f-3118-84ec-24315ee3a822",
                                                "text": "[I]n general the veſpers begin a little before ſunſet; the matins at four o'clock in the morning, and the liturgy or communion about nine; and when the vigil, or pernoctation, is performed, that ſervice begins after ſunſet; and there is no ſervice, in the morning following, till the communion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22303706-0f23-4fba-87aa-8ec258ee9a69",
                        "source_entry_id": "099ef070-c3a3-362a-aa38-1359efb21de2",
