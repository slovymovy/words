                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>dacht</w> lang <w>na</w> voordat hij antwoord gaf op de vraag.",
                            "target_lang_translations": {
                                "en": "He <w>thought</w> for a long time before he answered the question.",
                                "ru": "Он долго <w>думал</w>, прежде чем ответить на вопрос.",
                                "it": "Ha <w>riflettuto</w> a lungo prima di rispondere alla domanda.",
                                "de": "Er <w>dachte</w> lange <w>nach</w>, bevor er die Frage beantwortete.",
                                "pl": "Długo <w>zastanawiał się</w>, zanim odpowiedział na pytanie.",
                                "fr": "Il a longuement <w>réfléchi</w> avant de répondre à la question.",
                                "cs": "Dlouho <w>přemýšlel</w>, než na otázku odpověděl.",
                                "tr": "Soruya cevap vermeden önce uzun süre <w>düşündü</w>.",
                                "es": "Él <w>reflexionó</w> mucho antes de responder a la pregunta.",
                                "zh": "他在回答这个问题之前<w>思考</w>了很久。"
                            }
                        },
                        {
                            "text": "Je moet eerst goed <w>nadenken</w> en dan pas iets doen.",
                            "target_lang_translations": {
                                "en": "You must <w>think</w> carefully first and only then do something.",
                                "ru": "Нужно сначала хорошо <w>подумать</w>, а потом уже что-то делать.",
                                "it": "Devi prima <w>pensare</w> bene e solo dopo fare qualcosa.",
                                "de": "Du musst erst gut <w>nachdenken</w> und erst dann etwas tun.",
                                "pl": "Musisz najpierw dobrze <w>się zastanowić</w>, a dopiero potem coś zrobić.",
                                "fr": "Tu dois d'abord bien <w>réfléchir</w> avant de faire quoi que ce soit.",
                                "cs": "Nejdřív musíš pořádně <w>popřemýšlet</w> a až potom něco dělat.",
                                "tr": "Önce iyice <w>düşünmeli</w> ve ancak ondan sonra bir şey yapmalısın.",
                                "es": "Primero debes <w>pensar</w> bien y solo entonces hacer algo.",
                                "zh": "你必须先仔细<w>思考</w>，然后再采取行动。"
                            }
