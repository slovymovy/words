                "senses": [
                    {
                        "sense_id": "f841b142-942f-3429-a840-bb77baf2a61c",
                        "entry_id": "0bb0f8ca-f3e2-384b-94eb-29b4e3b9678c",
                        "glosses": [
                            "Faire cesser d’être syndiqué."
                        ],
                        "tags": [
                            "Syndicalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "879e8487-d5dc-4427-aafe-b27fa1e8e378",
                                "sense_id": "f841b142-942f-3429-a840-bb77baf2a61c",
                                "text": "Il a même désyndiqué ceux et celles qui l’étaient déjà, du jamais vu depuis la Grande noirceur."
                            }
                        ]
                    },
                    {
                        "sense_id": "30dbecba-9a22-3337-8cee-4ac86477f588",
                        "entry_id": "0bb0f8ca-f3e2-384b-94eb-29b4e3b9678c",
                        "glosses": [
                            "Cesser d’être syndiqué."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "a2e55b51-6193-4c07-b2e7-fd731216fc70",
                                "sense_id": "30dbecba-9a22-3337-8cee-4ac86477f588",
                                "text": "Tout travailleur devrait avoir le droit de se syndiquer, tout comme il devrait avoir le droit de se désyndiquer et de redevenir indépendant."
                            },
                            {
                                "example_id": "a2ee79f5-a276-4342-8a74-f30cbb2f5591",
                                "sense_id": "30dbecba-9a22-3337-8cee-4ac86477f588",
                                "text": "Le certificat du serveur ayant changé il faudra probablement vous désyndiquer puis vous resyndiquer."
                            }
                        ]
                    }
                ],
