                "senses": [
                    {
                        "sense_id": "0f1ea2a6-09c9-310b-b464-6f3c5e58d4c0",
                        "entry_id": "6cde5f17-3ad7-3f82-83af-978b18f1d9be",
                        "glosses": [
                            "неумеренным пьянством доводить себя до тяжёлого состояния"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d3ee073-419c-4984-a2c3-cb31b4847730",
                                "sense_id": "0f1ea2a6-09c9-310b-b464-6f3c5e58d4c0",
                                "text": "В это время он научился пить с горя, допивался не раз до белой горячки, а затем опять начинал шляться по тёмным местам, где принимают на службу и острожников."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ea91bbb-949e-3653-86fe-e8ee18678f19",
                        "entry_id": "6cde5f17-3ad7-3f82-83af-978b18f1d9be",
                        "glosses": [
                            "страд. к допивать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "f2505ed7-c52e-4013-a541-0e700517198b",
                                "sense_id": "7ea91bbb-949e-3653-86fe-e8ee18678f19",
                                "text": "В углу все еще длилась игра в косточки, допивался полуштоф водки и раздавались громкие споры по поводу дележки выигранных денег."
                            }
                        ]
                    }
