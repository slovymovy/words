                "senses": [
                    {
                        "sense_id": "4374b6cf-dbca-3c3a-b7e3-5a9e8a64890b",
                        "entry_id": "cca92c31-a532-392e-b90f-09b93966f8e7",
                        "glosses": [
                            "Faire perdre son caractère d’homme (au sens biologique), d’être humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca56b33f-25d6-4f7b-9b7d-7f1b9bc64f19",
                                "sense_id": "4374b6cf-dbca-3c3a-b7e3-5a9e8a64890b",
                                "text": "De là, au lieu de tendre à hominiser de plus en plus, il faut tendre à « déshominiser », à sublimer, à angéliser l’homme d’abord, son mode d’expression ensuite."
                            },
                            {
                                "example_id": "b419f1ce-c7d6-446d-bece-122211f3e7fa",
                                "sense_id": "4374b6cf-dbca-3c3a-b7e3-5a9e8a64890b",
                                "text": "En s’enfonçant dans la forêt dense, eux qui étaient des prédateurs actifs et qui avaient comme un début d’industrie, eux qui semblaient donc en voie de devenir des hommes, se sont d’une certaine manière « déshominisés »."
                            },
                            {
                                "example_id": "a16179d3-e21c-4d5f-9830-655f48a2906b",
                                "sense_id": "4374b6cf-dbca-3c3a-b7e3-5a9e8a64890b",
                                "text": "Les descriptions cadrent assez avec ce qu’on peut imaginer de l’allure d’un homme de Néanderthal qui se serait « déshominisé » depuis le paléolithique moyen ."
                            }
                        ]
                    }
