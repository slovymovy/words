                        "entry_id": "8caaa70b-871e-3998-950a-1d8b78bd5cc2",
                        "glosses": [
                            "Maschine mit Behälter/Auflage für Nahrungsmittel zum Zubereiten derselben durch Hitze"
                        ],
                        "tags": [
                            "Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "99f0109a-c2fb-4eaf-a514-2bd13231d7db",
                                "sense_id": "215121ce-0f4f-3b11-844d-9579717bd5cd",
                                "text": "„Die Prüfungsstelle wird unter Anderem noch zu berücksichtigen haben, dass ein Gargerät auch etwas anderes als ein Schnellkochtopf sein kann.“"
                            },
                            {
                                "example_id": "cda733c3-a4ef-44d0-83cf-9b9f1fd1aa63",
                                "sense_id": "215121ce-0f4f-3b11-844d-9579717bd5cd",
                                "text": "„Der allgemeine zeitliche Ablauf der Verteilung [der Nahrungsmittel] beginnt mit dem Entleeren der Gargeräte.“"
                            }
                        ],
