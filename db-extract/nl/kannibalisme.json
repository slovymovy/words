        "nl-extract.jsonl": [
            {
                "entry_id": "6fc79529-5c03-3cb1-adcc-50d4c8135035",
                "word": "kannibalisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea985302-7d7a-3e8c-8919-9562aa7fc9e6",
                        "entry_id": "6fc79529-5c03-3cb1-adcc-50d4c8135035",
                        "glosses": [
                            "het eten van het vlees van een soortgenoot m.n. als het gaat over mensen die mensenvlees eten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18fa477-2cb0-44c0-8567-a0f0478b697f",
                                "sense_id": "ea985302-7d7a-3e8c-8919-9562aa7fc9e6",
                                "text": "„Filosofen hebben vaak gefantaseerd over mensenvlees en de afschrikwekkende noodzaak die een mens ertoe kan drijven een ander mens op te eten”, zegt de Roemeense politieke wetenschapper Avramescu, de auteur van An Intellectual History of Cannibalism. Dit is een fascinerend wetenschappelijke boek over de culturele impact van en politieke theorie over mensen die ander mensen eten. Het internettijdschrift Cabinet heeft een interview met Avramescu, waarin hij het belang aangeeft van kannibalisme in het moderne Europese denken. Klinkt spannend?"
                            },
                            {
                                "example_id": "389ff564-d36c-4698-a5ff-1b8960333783",
                                "sense_id": "ea985302-7d7a-3e8c-8919-9562aa7fc9e6",
                                "text": "De ongelooflijkste vorm van kannibalisme, ook volgens Schutt zelf, is ontdekt bij de zandtijgerhaai. Een ongeboren zandtijgerhaai blijkt zich al in de baarmoeder tegoed te doen aan de embryo's van zijn broers en zussen, en pleegt dus prenataal kannibalisme."
                            }
                        ]
                    },
                    {
                        "sense_id": "73fd45be-b8e2-35e9-86db-d505cce0edd5",
                        "entry_id": "6fc79529-5c03-3cb1-adcc-50d4c8135035",
                        "glosses": [
                            "concurreren met een onderdeel van het eigen bedrijf of bedrijfsonderdeel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3a2865-ac82-4647-bb97-28b320a0f866",
                                "sense_id": "73fd45be-b8e2-35e9-86db-d505cce0edd5",
                                "text": "American Gods komt uit de koker van Bryan Fuller. Hij verlegde al grenzen met zijn barokke serie Hannibal, waarin hij de categorie 'highbrow kannibalisme' introduceerde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1417c8f-455a-4bcf-a854-0adf1958a2e9",
                        "source_entry_id": "6fc79529-5c03-3cb1-adcc-50d4c8135035",
                        "source_sense_id": "ea985302-7d7a-3e8c-8919-9562aa7fc9e6",
                        "source_sense_description": "(voeding) het eten van het vlees van een soortgenoot m.n. als het gaat over mensen die mensenvlees eten",
                        "target_lang_word": "cannibalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cannibalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07a3a239-98f1-3ddb-b6e2-2bcf70062681",
                                        "entry_id": "ff0f4111-6b82-342b-9f3a-83abf70c936e",
                                        "glosses": [
                                            "The act of eating another of one's own species."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be433d47-c3a7-4fc1-ab52-6f53d4b89dfc",
                                                "sense_id": "07a3a239-98f1-3ddb-b6e2-2bcf70062681",
                                                "text": "Cannibalism does not openly figure amongst aboriginal misdeeds, but in the northern part of Queensland it is no uncommon vice."
                                            },
                                            {
                                                "example_id": "52664153-3d20-4034-aad3-a72ccf6ed5a6",
                                                "sense_id": "07a3a239-98f1-3ddb-b6e2-2bcf70062681",
                                                "text": "Evidence for cannibalism abounds - even if circumstantial - both from the modern world and throughout history, but academic anthropology has found itself in a funk of denial. […] Considered globally, cannibalism should be less a moral issue than one of custom. I like Marmite, but then I have been raised on the stuff."
                                            },
                                            {
                                                "example_id": "6bc44fd6-c4d6-4cad-9b17-34b7ddb53b7d",
                                                "sense_id": "07a3a239-98f1-3ddb-b6e2-2bcf70062681",
                                                "text": "HuFu and was promoting it as “the healthy human flesh alternative!” Mark Nuckols, inventor of HuFu, says, “I have to admit that I myself have never sampled human flesh. . . . However, I've done quite a bit of research on the history and anthropology of cannibalism and read enough accounts to have come up with a fairly good approximation”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3eb6087-3ad8-36bb-9f7e-209668b4e137",
                                        "entry_id": "ff0f4111-6b82-342b-9f3a-83abf70c936e",
                                        "glosses": [
                                            "An act in which one thing consumes or takes over another of the same kind."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
