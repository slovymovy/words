                                    {
                                        "sense_id": "dbb57bf4-538d-36c6-9f87-676f62470538",
                                        "entry_id": "5d507ff9-2f10-36d0-806b-f966c43c0443",
                                        "glosses": [
                                            "Facharzt für die Innere Medizin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb53e70b-858a-4a3e-816f-e6fd394f0cd7",
                                                "sense_id": "dbb57bf4-538d-36c6-9f87-676f62470538",
                                                "text": "„In Deutschland etabliert sich eine kassentechnisch bedingte Aufspaltung in eine fachärztliche und eine hausärztliche Domäne, die mit empfindlichen Einschränkungen des Kompetenzbereichs hausärztlich tätiger Internisten einhergeht.“"
                                            },
                                            {
                                                "example_id": "7443e638-2d71-484b-9bd1-f7315e1b9728",
                                                "sense_id": "dbb57bf4-538d-36c6-9f87-676f62470538",
                                                "text": "„Als Internist und Nephrologe an der Berliner Charité wurde er vielfach beratend hinzugezogen, wenn bei einer Frau während der Schwangerschaft gesundheitliche Probleme auftraten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
