                    {
                        "translation_id": "6163b10d-72bb-4f38-bd90-1a4cd8d21311",
                        "source_entry_id": "b79c33f1-8bb8-34dc-968d-82ecab2e3b4d",
                        "source_sense_id": "1e8b7535-cba3-33e2-8a7b-488132b4299e",
                        "source_sense_description": "in ruime mate aanwezig of voorhanden zijn",
                        "target_lang_word": "Abundanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abundanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a244d4c-b3b0-38fd-aa2b-1106bcf2de33",
                                        "entry_id": "d51517d8-56f4-3b9a-8f6f-352ba9ffc4b8",
                                        "glosses": [
                                            "große Häufigkeit, hohe Dichte oder Fülle des Vorkommens"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87ec8d1c-361b-409a-888f-aa10b08d9138",
                                                "sense_id": "1a244d4c-b3b0-38fd-aa2b-1106bcf2de33",
                                                "text": "„Die Abundanz technischer Variation und spezifischer Anwendungen, die von einem unübersehbaren Heer von Computerfirmen und Softwarehäusern auf vielen Ebenen angeboten wird, hat dazu geführt, dass viele Anwendungsinseln geboren wurden, die zunächst unabhängig operieren, aber fast immer logische Verbindungen zu anderen Anwendungen und Datenbanken aufweisen.“"
                                            },
                                            {
                                                "example_id": "32182349-c5fa-4a77-b902-64e2f9ea934f",
                                                "sense_id": "1a244d4c-b3b0-38fd-aa2b-1106bcf2de33",
                                                "text": "„Abiotische Faktoren wie wechselnde Witterungseinflüsse, Wasser- und Nährstoffversorgung und und singuläre Ereignisse können ebenso wie die Einwirkungen von Beutegreifern, Parasiten oder Krankheiten die Abundanz der betroffenen Organismen sowie deren Aufnahme und Anreicherung von Stoffen aus der Umwelt beeinflussen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4743a66b-e999-34b1-9d43-f03873366f0d",
                                        "entry_id": "d51517d8-56f4-3b9a-8f6f-352ba9ffc4b8",
                                        "glosses": [
                                            "Merkmals- oder Zeichenüberfluss in einer Information"
                                        ],
                                        "tags": [
                                            "Informationstheorie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe42fc58-1b6b-4296-8b28-3ef257561ff5",
                                                "sense_id": "4743a66b-e999-34b1-9d43-f03873366f0d",
                                                "text": "„Im Allgemeinen versteht man in der Informationstheorie unter Freiheit von Redundanz einen Verzicht auf Abundanz und zusätzliche Information, welche in Bezug auf eine beabsichtigte Grundinformation irrelevant ist oder diese nur stützt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "296e8231-a05c-3447-a567-495f74d19497",
                                        "entry_id": "d51517d8-56f4-3b9a-8f6f-352ba9ffc4b8",
                                        "glosses": [
                                            "hohe Bevölkerungsdichte einer Art"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78fc53a5-1e06-4509-827d-a66c0496ea69",
                                                "sense_id": "296e8231-a05c-3447-a567-495f74d19497",
                                                "text": "„Die Bevölkerungsdichte einer Art (Populationsdichte, Abundanz) ist deren Individuenzahl je Raum- oder Flächeneinheit im Lebensraum, z. B. Puppen des Kiefernspanners (Bupalus piniarius) je qm […].“"
                                            },
                                            {
                                                "example_id": "0e9cfb6b-9d3f-4a21-b0bb-05a34941b378",
                                                "sense_id": "296e8231-a05c-3447-a567-495f74d19497",
                                                "text": "„Der Collembole Hypogastrura viatica kommt z. B. mit hoher Abundanz in folgenden Lebensstätten vor; (1) den aus faulenden Meerespflanzen bestehenden Anwurfbänken des marinen Litorals, (2) den mit Bakterienrasen überzogenen Schotterfiltern von Kläranlagen und (3) den Algenüberzügen in der Umgebung von Jauchegruben und Misthaufen[.]“"
                                            },
                                            {
                                                "example_id": "6220309e-1c50-4ea2-92e3-c1c21a8fa273",
                                                "sense_id": "296e8231-a05c-3447-a567-495f74d19497",
                                                "text": "„Sie sind der Ansicht, der Menschenfloh könne eine Seuche auslösen, wenn er in genügender Abundanz auftrete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "949b875d-c888-37a1-943d-0469b6b2609d",
                                        "entry_id": "d51517d8-56f4-3b9a-8f6f-352ba9ffc4b8",
                                        "glosses": [
                                            "„Wiedergabe desselben Gedankens mit Hilfe bedeutungsgleicher oder sinnverwandter Formulierungen“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "298816f5-43db-489c-b17c-08688bb3cbf4",
                                                "sense_id": "949b875d-c888-37a1-943d-0469b6b2609d",
                                                "text": "„Der Charakter der Abundanz ist in verschiedenen Abstufungen fast allen Erscheinungen eigen, je nachdem, ob zwei (oder mehr) direkt synonyme oder doch den gleichen Gegenstand meinende Ausdrücke in einem Satz oder sogar in direkter Zuordnung zueinander begegnen.“"
                                            },
                                            {
                                                "example_id": "e6662ebe-b625-4606-9ad6-05dbb38d196d",
                                                "sense_id": "949b875d-c888-37a1-943d-0469b6b2609d",
                                                "text": "„Das erste ist den Formen der Ausdrucksverknappung gewidmet […], das zweite befaßt sich mit der Anreicherung des Ausdrucks […], wobei insbesondere die Formen der Periphrase und die Abundanz im syntaktischen System (Pleonasmen) detailliert vorgestellt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
