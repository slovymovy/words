                "word": "unvorsichtigerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                        "entry_id": "bb81000e-fb18-3de0-b0fb-97a7f22feed8",
                        "glosses": [
                            "nicht mit der genügenden Achtsamkeit; aus Unvorsichtigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26fc0d5e-1ea8-4d4d-a08e-e5ab05456603",
                                "sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                                "text": "Unvorsichtigerweise sagte sie dem Vorstandsvorsitzenden ihre Meinung direkt ins Gesicht."
                            },
                            {
                                "example_id": "8f41ac66-db20-41f5-952a-e9d571cc769a",
                                "sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                                "text": "Unvorsichtigerweise ging ich über den zugefrorenen See. Und fiel prompt auf die Nase."
                            },
                            {
                                "example_id": "1d187106-343f-454b-b1aa-7a02b9c5ed18",
                                "sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                                "text": "1933 schied Böse aus dem Schuldienst aus, er gehörte später zur „Bästlein-Jacob-Abshagen“-Widerstandsgruppe und wurde verhaftet, als ihn 1942 ein aus dem KZ entlassener Genosse unvorsichtigerweise besuchte."
                            },
                            {
                                "example_id": "24bc218d-6d06-4412-8c28-039be8515ff6",
                                "sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                                "text": "Jede und jeder schien gegen irgend etwas allergisch zu sein. „Ich habe nur Schnupfen“, sagte ich unvorsichtigerweise. „Ich wette, das ist Heuschnupfen!“ trumpfte die Mutter auf. Es war Heuschnupfen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13ff6d03-5bae-4839-8737-cd9b6ac3509a",
                        "source_entry_id": "bb81000e-fb18-3de0-b0fb-97a7f22feed8",
                        "source_sense_id": "e4e36e69-ef82-3744-9464-737684087770",
                        "source_sense_description": "nicht mit der genügenden Achtsamkeit; aus Unvorsichtigkeit",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
