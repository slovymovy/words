{
    "word_family": [
        "concept",
        "conception",
        "conceptual",
        "conceptualize",
        "conceivable",
        "inconceivable",
        "misconceive",
        "preconceive"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c3e899b-ec73-31b3-99d4-035cbc059f4c",
                    "sense_definition": "To form or develop a plan, idea, or feeling in the mind.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect helped <w>conceive</w> the idea for the new city park.",
                            "target_lang_translations": {
                                "ru": "Архитектор помог <w>задумать</w> идею нового городского парка.",
                                "tr": "Mimar yeni şehir parkı fikrini <w>tasarlamaya</w> yardımcı oldu.",
                                "de": "Der Architekt half dabei, die Idee für den neuen Stadtpark zu <w>konzipieren</w>."
                            }
                        },
                        {
                            "text": "It is difficult to <w>conceive</w> a plan that satisfies every member of the committee.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>разработать</w> план, который удовлетворил бы каждого члена комитета.",
                                "tr": "Komitenin her üyesini tatmin edecek bir plan <w>geliştirmek</w> zordur.",
                                "de": "Es ist schwierig, einen Plan zu <w>erdenken</w>, der jedes Mitglied des Komitees zufriedenstellt."
                            }
                        }
                    ],
                    "synonyms": [
                        "devise",
                        "formulate",
                        "think up"
                    ],
                    "common_phrases": [
                        "conceive an idea",
                        "conceive a plan",
                        "conceive a project"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформулировать или разработать план, идею или чувство в уме.",
                        "tr": "Zihinde bir plan, fikir veya duygu geliştirmek ya da tasarlamak.",
                        "de": "Einen Plan, eine Idee oder ein Gefühl im Geist entwickeln oder entwerfen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задумать",
                                "target_lang_sense_clarification": "мысленно составить план или идею"
                            },
                            {
                                "target_lang_word": "разработать",
                                "target_lang_sense_clarification": "детально продумать проект или план"
                            },
                            {
                                "target_lang_word": "замыслить",
                                "target_lang_sense_clarification": "спланировать что-либо, часто масштабное"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tasarlamak",
                                "target_lang_sense_clarification": "bir plan veya fikri zihinde oluşturmak"
                            },
                            {
                                "target_lang_word": "geliştirmek",
                                "target_lang_sense_clarification": "bir düşünceyi veya projeyi zihinde biçimlendirmek"
                            },
                            {
                                "target_lang_word": "yaratmak",
                                "target_lang_sense_clarification": "düşünce veya hayal gücüyle yeni bir fikir ortaya koymak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "konzipieren",
                                "target_lang_sense_clarification": "einen Entwurf oder eine Konzeption für etwas erstellen"
                            },
                            {
                                "target_lang_word": "erdenken",
                                "target_lang_sense_clarification": "sich etwas Neues einfallen lassen"
                            },
                            {
                                "target_lang_word": "ersinnen",
                                "target_lang_sense_clarification": "sich etwas ausdenken oder erfinden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9992fe5-4979-3fd1-b69d-2657301979b3",
                    "sense_definition": "To become pregnant with a child.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple had been trying to <w>conceive</w> for several years before they were successful.",
                            "target_lang_translations": {
                                "ru": "Пара пыталась <w>зачать</w> ребенка в течение нескольких лет, прежде чем им это удалось.",
                                "tr": "Çift, başarılı olmadan önce birkaç yıl boyunca <w>hamile kalmaya</w> çalışmıştı.",
                                "de": "Das Paar hatte mehrere Jahre versucht, ein Kind zu <w>empfangen</w>, bevor es erfolgreich war."
                            }
                        },
                        {
                            "text": "Medical treatments can sometimes help women who find it difficult to <w>conceive</w> naturally.",
                            "target_lang_translations": {
                                "ru": "Медицинское лечение иногда может помочь женщинам, которым трудно <w>забеременеть</w> естественным путем.",
                                "tr": "Tıbbi tedaviler bazen doğal yoldan <w>gebe kalmakta</w> zorlanan kadınlara yardımcı olabilir.",
                                "de": "Medizinische Behandlungen können manchmal Frauen helfen, die Schwierigkeiten haben, auf natürlichem Weg <w>schwanger zu werden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "get pregnant"
                    ],
                    "common_phrases": [
                        "trying to conceive",
                        "unable to conceive",
                        "conceive a child"
                    ],
                    "target_lang_definitions": {
                        "ru": "Забеременеть ребенком.",
                        "tr": "Bir çocuğa hamile kalmak.",
                        "de": "Schwanger werden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачать",
                                "target_lang_sense_clarification": "биологический процесс начала беременности"
                            },
                            {
                                "target_lang_word": "забеременеть",
                                "target_lang_sense_clarification": "стать беременной"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "hamile kalmak",
                                "target_lang_sense_clarification": "gebe kalmak, hamilelik sürecini başlatmak"
                            },
                            {
                                "target_lang_word": "gebe kalmak",
                                "target_lang_sense_clarification": "karnında yavru/bebek oluşması"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "schwanger werden",
                                "target_lang_sense_clarification": "den Zustand der Schwangerschaft erreichen"
                            },
                            {
                                "target_lang_word": "empfangen",
                                "target_lang_sense_clarification": "ein Kind empfangen (gehoben)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "564abb79-c585-3112-b89b-8c05ff787a16",
                    "sense_definition": "To imagine or visualize something as being a certain way.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_formation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is hard to <w>conceive</w> of a world without modern technology.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>представить</w> себе мир без современных технологий.",
                                "tr": "Modern teknolojinin olmadığı bir dünyayı <w>tahayyül etmek</w> zordur.",
                                "de": "Es ist schwer, sich eine Welt ohne moderne Technologie <w>vorzustellen</w>."
                            }
                        },
                        {
                            "text": "I cannot <w>conceive</w> of him acting so rudely to his guests.",
                            "target_lang_translations": {
                                "ru": "Я не могу <w>вообразить</w>, чтобы он вел себя так грубо со своими гостями.",
                                "tr": "Misafirlerine bu kadar kaba davranabileceğini <w>düşünemiyorum</w>.",
                                "de": "Ich kann mir nicht <w>vorstellen</w>, dass er sich seinen Gästen gegenüber so unhöflich verhält."
                            }
                        }
                    ],
                    "synonyms": [
                        "envision",
                        "visualize",
                        "imagine"
                    ],
                    "common_phrases": [
                        "conceive of",
                        "hard to conceive"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представить или визуализировать что-либо определенным образом.",
                        "tr": "Bir şeyi belirli bir şekilde hayal etmek veya zihinde canlandırmak.",
                        "de": "Sich etwas vorstellen oder visualisieren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "представить",
                                "target_lang_sense_clarification": "вообразить что-либо в уме"
                            },
                            {
                                "target_lang_word": "вообразить",
                                "target_lang_sense_clarification": "создать мысленный образ"
                            },
                            {
                                "target_lang_word": "помыслить",
                                "target_lang_sense_clarification": "допустить мысль о чем-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "tahayyül etmek",
                                "target_lang_sense_clarification": "zihinde canlandırmak veya hayal etmek"
                            },
                            {
                                "target_lang_word": "düşünmek",
                                "target_lang_sense_clarification": "bir olasılığı zihinde akıl etmek"
                            },
                            {
                                "target_lang_word": "hayal etmek",
                                "target_lang_sense_clarification": "bir durumu zihinde imgelemek"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich vorstellen",
                                "target_lang_sense_clarification": "ein Bild von etwas im Kopf erzeugen"
                            },
                            {
                                "target_lang_word": "sich ausmalen",
                                "target_lang_sense_clarification": "sich eine Situation in Gedanken detailliert vorstellen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8af337f-852e-3be7-877a-0149656bcf90",
                    "sense_definition": "To understand or grasp the meaning of what someone is saying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>conceive</w> your meaning perfectly, though your explanation was brief.",
                            "target_lang_translations": {
                                "ru": "Я прекрасно <w>понимаю</w> вашу мысль, хотя ваше объяснение было кратким.",
                                "tr": "Açıklamanız kısa olsa da ne demek istediğinizi mükemmel bir şekilde <w>anlıyorum</w>.",
                                "de": "Ich <w>verstehe</w> Ihre Bedeutung vollkommen, obwohl Ihre Erklärung kurz war."
                            }
                        },
                        {
                            "text": "Do you <w>conceive</w> the gravity of the situation we are currently facing?",
                            "target_lang_translations": {
                                "ru": "Вы <w>постигаете</w> всю серьезность ситуации, с которой мы сейчас столкнулись?",
                                "tr": "Şu anda karşı karşıya olduğumuz durumun ciddiyetini <w>kavrayabiliyor musunuz</w>?",
                                "de": "Können Sie die Schwere der Situation, der wir derzeit gegenüberstehen, <w>begreifen</w>?"
                            }
                        }
                    ],
                    "synonyms": [
                        "comprehend",
                        "grasp",
                        "apprehend"
                    ],
                    "antonyms": [
                        "misunderstand"
                    ],
                    "common_phrases": [
                        "conceive the meaning"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Понять или уловить смысл того, что кто-то говорит.",
                        "tr": "Birinin söylediği şeyin anlamını anlamak veya kavramak.",
                        "de": "Den Sinn oder die Bedeutung von etwas verstehen oder erfassen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "понимать",
                                "target_lang_sense_clarification": "постигать смысл высказывания"
                            },
                            {
                                "target_lang_word": "постигать",
                                "target_lang_sense_clarification": "глубоко осознавать или понимать"
                            },
                            {
                                "target_lang_word": "уяснить",
                                "target_lang_sense_clarification": "сделать ясным для себя"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "anlamak",
                                "target_lang_sense_clarification": "bir şeyin ne demek olduğunu kavramak"
                            },
                            {
                                "target_lang_word": "kavramak",
                                "target_lang_sense_clarification": "bir durumun veya anlamın tam olarak farkına varmak"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verstehen",
                                "target_lang_sense_clarification": "den Sinngehalt einer Aussage erfassen"
                            },
                            {
                                "target_lang_word": "begreifen",
                                "target_lang_sense_clarification": "etwas in seiner Tiefe oder Tragweite verstehen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}