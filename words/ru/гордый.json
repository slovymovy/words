{
    "word_family": [
        "гордость",
        "гордиться",
        "горделивый",
        "гордо",
        "гордыня"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "320b45c9-7839-30a3-9ce1-c0f8ec4e8601",
                    "sense_definition": "Испытывающий чувство собственного достоинства, самоуважения или удовлетворения от своих успехов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "proud_feeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Отец был очень <w>горд</w> успехами своего сына в школе.",
                            "target_lang_translations": {
                                "en": "The father was very <w>proud</w> of his son's success at school."
                            }
                        },
                        {
                            "text": "Она — <w>гордая</w> женщина и никогда не станет просить о помощи.",
                            "target_lang_translations": {
                                "en": "She is a <w>proud</w> woman and will never ask for help."
                            }
                        }
                    ],
                    "synonyms": [
                        "горделивый"
                    ],
                    "antonyms": [
                        "смиренный"
                    ],
                    "common_phrases": [
                        "гордый взгляд",
                        "гордый человек"
                    ],
                    "target_lang_definitions": {
                        "en": "Feeling self-respect, dignity, or satisfaction with one's achievements."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "proud",
                                "target_lang_sense_clarification": "feeling satisfaction or self-respect"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d6a39bd-443d-3b14-b52c-6ad969072cbe",
                    "sense_definition": "Отличающийся величием, внушительной красотой; величавый.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "majestic_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Через месяц Цусенька <w>гордой</w> поступью вошла в родной двор.",
                            "target_lang_translations": {
                                "en": "A month later, Tsusenka entered her native courtyard with a <w>proud</w> gait."
                            }
                        },
                        {
                            "text": "На вершине холма стоял <w>гордый</w> замок, возвышающийся над всей долиной.",
                            "target_lang_translations": {
                                "en": "On top of the hill stood a <w>majestic</w> castle, towering over the entire valley."
                            }
                        }
                    ],
                    "common_phrases": [
                        "гордая осанка",
                        "гордая поступь"
                    ],
                    "target_lang_definitions": {
                        "en": "Distinguished by grandeur, impressive beauty; majestic."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "majestic",
                                "target_lang_sense_clarification": "having grandeur or impressive beauty"
                            },
                            {
                                "target_lang_word": "proud",
                                "target_lang_sense_clarification": "stately or majestic in appearance"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}