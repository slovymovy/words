                "senses": [
                    {
                        "sense_id": "3dca5c92-89d5-38a7-a8d2-7ee95be1ea75",
                        "entry_id": "7c17a14b-411f-35ab-8f3d-5d7de77b8a10",
                        "glosses": [
                            "In the manner of a knight; chivalrously."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25286ae7-e7c2-4076-bd7c-82d336ffe44f",
                                "sense_id": "3dca5c92-89d5-38a7-a8d2-7ee95be1ea75",
                                "text": "Mar. In Gods name, and the Kings, say who yͧ [thou] art.\nAnd why thou com'st thus knightly clad in Armes?"
                            },
                            {
                                "example_id": "49e104bb-5902-4347-bdc4-33ae613abd25",
                                "sense_id": "3dca5c92-89d5-38a7-a8d2-7ee95be1ea75",
                                "text": "Who backs a horse, or bears a hawk, or wears\nA sword like him! Whose plume nods knightlier?"
                            },
                            {
                                "example_id": "82c36025-fe1c-43cc-a6a8-695e2c410eb9",
                                "sense_id": "3dca5c92-89d5-38a7-a8d2-7ee95be1ea75",
                                "text": "He, reverencing king's blood in a bad man,\nMade such excuses as he might, and these\nFull knightly without scorn; for in those days\nNo knight of Arthur's noblest dealt in scorn."
                            }
                        ]
                    }
