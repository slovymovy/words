{
    "word_family": [
        "board",
        "overboard",
        "onboard",
        "seaboard"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c277ade0-4aba-3d65-a7c4-acee22fe0c57",
                    "sense_definition": "On or into a ship, train, aircraft, or other vehicle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transport_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We all climbed <w>aboard</w> just minutes before the train departed.",
                            "target_lang_translations": {
                                "ru": "Мы все поднялись <w>на борт</w> всего за несколько минут до отправления поезда.",
                                "zh": "火车出发前几分钟，我们都<w>上</w>了车。"
                            }
                        },
                        {
                            "text": "Once everyone is <w>aboard</w>, the captain will start the engines.",
                            "target_lang_translations": {
                                "ru": "Как только все будут <w>на борту</w>, капитан запустит двигатели.",
                                "zh": "一旦大家都<w>在</w>船上，船长就会启动引擎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "on board",
                        "on"
                    ],
                    "antonyms": [
                        "ashore"
                    ],
                    "common_phrases": [
                        "climb aboard",
                        "all aboard",
                        "hop aboard",
                        "go aboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "На судне, в поезде, самолете или другом транспортном средстве; внутрь транспортного средства.",
                        "zh": "在船、火车、飞机或其他交通工具上或进入其中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на борту",
                                "target_lang_sense_clarification": "местонахождение"
                            },
                            {
                                "target_lang_word": "на борт",
                                "target_lang_sense_clarification": "направление движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上",
                                "target_lang_sense_clarification": "表示进入交通工具"
                            },
                            {
                                "target_lang_word": "在……上",
                                "target_lang_sense_clarification": "表示在交通工具内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9abb515-e0e2-33a1-b92b-264c3cd180bf",
                    "sense_definition": "Into a team, group, or organization.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was delighted to welcome the new expert <w>aboard</w>.",
                            "target_lang_translations": {
                                "ru": "Менеджер был рад поприветствовать нового эксперта <w>в команде</w>.",
                                "zh": "经理很高兴欢迎这位新专家<w>加入</w>团队。"
                            }
                        },
                        {
                            "text": "We need to get the investors <w>aboard</w> with our new strategy.",
                            "target_lang_translations": {
                                "ru": "Нам нужно привлечь инвесторов <w>к участию</w> в нашей новой стратегии.",
                                "zh": "我们需要让投资者<w>加入</w>我们的新战略。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "welcome aboard",
                        "bring aboard",
                        "get aboard"
                    ],
                    "target_lang_definitions": {
                        "ru": "В команду, группу или организацию (обычно в переносном смысле).",
                        "zh": "加入团队、组织或项目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в команду",
                                "target_lang_sense_clarification": "вступление в группу"
                            },
                            {
                                "target_lang_word": "на борт",
                                "target_lang_sense_clarification": "идиоматическое выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加入",
                                "target_lang_sense_clarification": "成为团队成员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd8b9032-9e6e-395b-a394-e3a357e78cfc",
                    "sense_definition": "On the back of a horse or other animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_riding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jockey climbed <w>aboard</w> the restless stallion.",
                            "target_lang_translations": {
                                "ru": "Жокей взбрался <w>верхом</w> на беспокойного жеребца.",
                                "zh": "骑师<w>骑在</w>那匹焦躁不安的种马背上。"
                            }
                        },
                        {
                            "text": "She felt very high up once she was <w>aboard</w> the camel.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала, что находится очень высоко, когда оказалась <w>верхом</w> на верблюде.",
                                "zh": "她<w>骑在</w>骆驼上时，感觉自己坐得很高。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхом на лошади или другом животном.",
                        "zh": "骑在马或其他动物背上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верхом",
                                "target_lang_sense_clarification": "положение на животном"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑在……上",
                                "target_lang_sense_clarification": "骑乘姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96876cc8-ba42-393b-918f-51ec224988c9",
                    "sense_definition": "On base in a game of baseball.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batter hit a double with two men <w>aboard</w>.",
                            "target_lang_translations": {
                                "ru": "Бэттер сделал дабл, когда двое игроков были <w>на базах</w>.",
                                "zh": "在两名球员<w>在垒上</w>时，击球手打出了一支二垒安打。"
                            }
                        },
                        {
                            "text": "He managed to strike out the player while runners were <w>aboard</w>.",
                            "target_lang_translations": {
                                "ru": "Ему удалось выбить игрока в аут, пока раннеры находились <w>на базах</w>.",
                                "zh": "在跑垒员<w>在垒上</w>时，他成功三振了对方球员。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "На базе (в бейсболе).",
                        "zh": "在棒球比赛中处于垒位上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на базе",
                                "target_lang_sense_clarification": "бейсбол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在垒上",
                                "target_lang_sense_clarification": "棒球术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c59d7a5-a0d5-3df3-b6d8-50b453b21ea8",
                    "sense_definition": "Alongside a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alongside_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pirate vessel came close <w>aboard</w> to attack.",
                            "target_lang_translations": {
                                "ru": "Пиратское судно подошло вплотную, <w>борт о борт</w>, для атаки.",
                                "zh": "海盗船<w>并排</w>靠过来准备进攻。"
                            }
                        },
                        {
                            "text": "They laid their ship <w>aboard</w> the enemy vessel.",
                            "target_lang_translations": {
                                "ru": "Они поставили свой корабль <w>борт о борт</w> с вражеским судном.",
                                "zh": "他们将自己的船与敌船<w>并排</w>停靠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alongside"
                    ],
                    "common_phrases": [
                        "close aboard"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "nautical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рядом с кораблем, борт о борт.",
                        "zh": "靠近船只，与船并排。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "борт о борт",
                                "target_lang_sense_clarification": "морской термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "并排",
                                "target_lang_sense_clarification": "航海术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "922fba3d-7157-3e01-8d4a-cb03f2fca8ab",
                    "sense_definition": "On or into a ship, train, aircraft, or other vehicle.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "transport_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They served a delicious dinner <w>aboard</w> the plane.",
                            "target_lang_translations": {
                                "ru": "Вкусный ужин подали <w>на борту</w> самолета.",
                                "zh": "他们在飞机<w>上</w>供应了美味的晚餐。"
                            }
                        },
                        {
                            "text": "Life <w>aboard</w> a submarine can be challenging for the crew.",
                            "target_lang_translations": {
                                "ru": "Жизнь <w>на борту</w> подводной лодки может быть сложной для экипажа.",
                                "zh": "潜艇<w>上</w>的生活对船员来说可能充满挑战。"
                            }
                        }
                    ],
                    "synonyms": [
                        "on"
                    ],
                    "antonyms": [
                        "off"
                    ],
                    "common_phrases": [
                        "aboard the ship",
                        "aboard the train",
                        "aboard the plane"
                    ],
                    "target_lang_definitions": {
                        "ru": "На борту или внутри транспортного средства (предлог).",
                        "zh": "在交通工具内部。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на борту",
                                "target_lang_sense_clarification": "местонахождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……上",
                                "target_lang_sense_clarification": "交通工具内"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d486087-0739-3678-a69a-6db26ad1f93d",
                    "sense_definition": "On the back of a horse or animal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_riding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He jumped <w>aboard</w> his horse and rode away quickly.",
                            "target_lang_translations": {
                                "ru": "Он запрыгнул <w>верхом на</w> свою лошадь и быстро ускакал.",
                                "zh": "他<w>跳上</w>马背，飞快地跑了。"
                            }
                        },
                        {
                            "text": "The child sat safely <w>aboard</w> the pony.",
                            "target_lang_translations": {
                                "ru": "Ребенок безопасно сидел <w>верхом на</w> пони.",
                                "zh": "孩子安全地<w>骑在</w>小马背上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхом на животном (предлог).",
                        "zh": "骑在动物背上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верхом на",
                                "target_lang_sense_clarification": "положение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "骑在……上",
                                "target_lang_sense_clarification": "骑乘位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bb004b4-caf6-3e26-9e42-62fc2659cffd",
                    "sense_definition": "Across or alongside something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alongside_nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy waves crashed <w>aboard</w> the deck during the storm.",
                            "target_lang_translations": {
                                "ru": "Тяжелые волны обрушились <w>на</w> палубу во время шторма.",
                                "zh": "暴风雨中，巨浪拍打<w>在</w>甲板上。"
                            }
                        },
                        {
                            "text": "The small boat drifted <w>aboard</w> the pier.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка дрейфовала <w>вдоль</w> пирса.",
                                "zh": "小船<w>沿着</w>码头漂流。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поперек или вдоль чего-либо (обычно судна).",
                        "zh": "横跨或沿着某物（通常指船只）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на",
                                "target_lang_sense_clarification": "на поверхность"
                            },
                            {
                                "target_lang_word": "вдоль",
                                "target_lang_sense_clarification": "рядом с объектом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……上",
                                "target_lang_sense_clarification": "表面位置"
                            },
                            {
                                "target_lang_word": "沿着",
                                "target_lang_sense_clarification": "沿边位置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}