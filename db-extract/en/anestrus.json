                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a837779-c64d-3fe4-8687-2dd5565bde84",
                        "entry_id": "bd7447dd-d269-3651-bee4-b0ebdeb69123",
                        "glosses": [
                            "In female placental mammals—excluding humans and great apes—a phase of the estrous cycle during which the sexual cycle rests."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "907cc606-915c-4423-b9eb-cc511f0f3fa3",
                                "sense_id": "3a837779-c64d-3fe4-8687-2dd5565bde84",
                                "text": "1993, R. E. Larsen, S. C. Denham, J. F. Boucher, E. L. Adams, Chapter 13: Breeding Season Length Versus Calving Percentage in Beef Cattle Herds, Michael J. Fields, Robert S. Sand (editors), Factors Affecting Calf Crop, CRC Press, page 191,\nDuration of postpartum anestrus is the period from calving to the first estrus. This anestrus period is recognized as being a major factor in controlling the proportion of cows conceiving each breeding season (Wiltbank et al., 1961)."
                            },
                            {
                                "example_id": "48069824-d474-4830-ab31-b15055885c79",
                                "sense_id": "3a837779-c64d-3fe4-8687-2dd5565bde84",
                                "text": "During anestrus the size range and numbers of ovarian antral follicles were similar to those seen during the breeding season."
                            },
                            {
                                "example_id": "ffff4a85-a0ae-4ba5-b3d9-88f091ab4168",
                                "sense_id": "3a837779-c64d-3fe4-8687-2dd5565bde84",
                                "text": "2011, Carole C. Miller, Carla L. Carleton (consulting editor), Anestrus, Jean-Pierre Lavoie, Kenneth William Hinchcliff (editors), Blackwell's Five-Minute Veterinary Consult: Equine, 2nd Edition, Wiley, page 75,\nTreating a mare with progesterone while she is in anestrus/early vernal transition will suppress ovarian activity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df11e5e5-46cd-4f1e-8ce0-d62ad34f8ac3",
                        "source_entry_id": "bd7447dd-d269-3651-bee4-b0ebdeb69123",
                        "source_sense_id": "3a837779-c64d-3fe4-8687-2dd5565bde84",
                        "source_sense_description": "period of pause during the sexual cycle",
                        "target_lang_word": "anœstrus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anœstrus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80de0d14-45a9-32fc-ba23-8063d4389331",
                                        "entry_id": "284b8fbd-237a-34bc-a696-bf3545af4cc6",
                                        "glosses": [
                                            "Absence d’œstrus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4de05529-8ff3-4b02-8f1b-5761b0bdf93c",
                                                "sense_id": "80de0d14-45a9-32fc-ba23-8063d4389331",
                                                "text": "Encore une génération, et ils auraient vraisemblablement atteint le stade ultime du contrôle démographique automatique, à savoir l’anœstrus, dans lequel une trop grande proximité entre les membres d’une même espèce conduit à la réabsorption par l’organisme femelle de tout le matériel embryonnaire."
                                            },
                                            {
                                                "example_id": "b1768b41-586d-4d75-8abe-bc28abdc8933",
                                                "sense_id": "80de0d14-45a9-32fc-ba23-8063d4389331",
                                                "text": "(Chez la vache) L’anœstrus, anaphrodisie ou frigidité, est fréquent. Il s’agit de l’absence de chaleurs observables pendant une période plus ou moins longue. Il se produit après le vêlage (anœstrus post-partum, anœstrus de lactation) ou après un service (saillie naturelle ou insémination artificielle)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
