                        ]
                    },
                    {
                        "translation_id": "a218114f-036e-4750-ade7-853035819e5d",
                        "source_entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                        "source_sense_id": "9a29c5ca-e65f-3623-8b34-a3dea5d0a559",
                        "source_sense_description": "philosophical doctrine",
                        "target_lang_word": "spiritisme",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiritisme",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                                        "entry_id": "07085e84-a467-3e87-a299-c84ca3d79c0a",
                                        "glosses": [
                                            "een geloof dat stelt dat de mens na zijn dood als geest voortbestaat, en dan in staat is om met andere, nog levende mensen te communiceren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bfc1c1c-522d-4db9-945c-09435be9735e",
                                                "sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                                                "text": "Wallace werkte nog vijftig jaar als een bij tijd en wijle verdienstelijk natuuronderzoeker en denker, maar hij verloor geleidelijk de gunst van de wetenschap door zich in te laten met twijfelachtige zaken als spiritisme en de mogelijkheid van buitenaards leven. Daardoor werd de theorie, hoofdzakelijk bij gebrek aan beter, die van Darwin alleen."
                                            },
                                            {
                                                "example_id": "fb1782f6-9581-46a7-9c56-aaa344a2166a",
                                                "sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                                                "text": "Nadat Arthur Conan Doyle een zoon verloren had in de Eerste Wereldoorlog, werd hij een steeds vuriger aanhanger van het spiritualisme, ook wel spiritisme genoemd: het geloof dat het leven niet ophoudt bij de dood en dat we contact kunnen hebben met de geesten van overledenen."
                                            },
                                            {
                                                "example_id": "6997a667-aeb1-43ed-a3ea-2ed60bf7e80e",
                                                "sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                                                "text": "Een vleugje spiritisme, santera en geestesverschijningen zorgen voor de obligate dosis magisch realisme in dit deprimerende verhaal, waarin geen boek wordt gelezen en geen cd wordt gespeeld zonder dat de auteur, de componist of de muzikant wordt vermeld. de Standaard 3 MEI 2016 OM 03:00 UUR"
                                            },
                                            {
                                                "example_id": "ee410b79-a8b7-42d8-834e-aecaa714d047",
                                                "sense_id": "ef8c7ddd-af9b-3ed9-b8a9-617ce2cb5831",
                                                "text": "Schouten laat zien dat zowel de beweging van Tachtig als het Palingoproer in de lucht hing: 'Het was de tijdgeest, om dat vage begrip maar eens te gebruiken.'Op allerlei terreinen werd gebroken met heersende conventies, waardoor het socialisme onder leiding van Domela Nieuwenhuis kon opkomen, en nieuwigheden als spiritisme en hypnose in de mode raakten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f0d27fb-0869-4ae4-aab0-d7680402d45f",
                        "source_entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                        "source_sense_id": "9a29c5ca-e65f-3623-8b34-a3dea5d0a559",
                        "source_sense_description": "philosophical doctrine",
                        "target_lang_word": "spiritisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spiritisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbbabb63-873c-38eb-8b48-f8c0cd3c28dd",
                                        "entry_id": "f173ac55-527f-309f-ae4c-cfc2a3904701",
                                        "glosses": [
                                            "Doctrine qui fonde une communication avec les esprits désincarnés dans les plans spirituels via des médiums."
                                        ],
                                        "tags": [
                                            "Ésotérisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afac7423-b715-4618-8b72-e4daabe36f96",
                                                "sense_id": "bbbabb63-873c-38eb-8b48-f8c0cd3c28dd",
                                                "text": "Le spiritisme peut être considéré comme une variante du spiritualisme dans les pays latins. Sa doctrine repose sur deux piliers : l'identification des esprits avec les âmes des morts et le principe de réincarnation, une croyance qui ne fait pas l'unanimité chez les spiritualistes."
                                            },
                                            {
                                                "example_id": "9d7450d6-7646-4201-af8e-a3d6d73f36d6",
                                                "sense_id": "bbbabb63-873c-38eb-8b48-f8c0cd3c28dd",
                                                "text": "Le spiritisme est né vers 1850. Il a donc, en quarante ans, convaincu vingt millions d'intelligences, parmi lesquelles les cas d’aliénation mentale ne sont pas plus fréquents qu’ailleurs."
                                            },
                                            {
                                                "example_id": "b2467b12-b5b2-4309-8c0a-5d35cba37ce2",
                                                "sense_id": "bbbabb63-873c-38eb-8b48-f8c0cd3c28dd",
                                                "text": "Bizarrement, la mode des séances de spiritisme avec déplacements de lourdes tables et apparitions et matérialisations « d’ectoplasmes » perdit beaucoup de sa popularité à peu près à la même époque où la compagnie Kodak mis sur le marché son premier film sensible aux rayons infrarouges."
                                            },
                                            {
                                                "example_id": "46ac8fca-5ad0-494d-a3ff-a43c0610eae2",
                                                "sense_id": "bbbabb63-873c-38eb-8b48-f8c0cd3c28dd",
                                                "text": "Certes, l’onirologie de Maeterlinck, qui se réfère très explicitement à la « télépsychie », au magnétisme, à la « communion des Esprits », est fortement marquée de spiritisme et manifeste donc la croyance de son auteur en un au-delà que les surréalistes ont toujours récusé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea07f4f9-2294-4606-a923-14547826a035",
                        "source_entry_id": "fb6adc05-6ac7-3d50-8515-b819a3c46bb8",
                        "source_sense_id": "9a29c5ca-e65f-3623-8b34-a3dea5d0a559",
                        "source_sense_description": "philosophical doctrine",
                        "target_lang_word": "Spiritismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spiritismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45ae5798-7f8f-3895-8620-1ee357ac21de",
                                        "entry_id": "6eaa19af-c6a1-3a88-b8f1-2763ec7129c9",
                                        "glosses": [
                                            "Geisterglaube; Glaube an Geister, an die Beschwörung von Geistern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5aff62a-59cc-4a87-9818-536b578b6952",
                                                "sense_id": "45ae5798-7f8f-3895-8620-1ee357ac21de",
                                                "text": "„Der Spiritismus gab sich als eine wissenschaftliche Lehre aus und behauptete, der Mensch müsse von nun an an ein Jenseits, an die Unsterblichkeit der Seele und dergleichen nicht mehr nur glauben, da dies alles von spiritistischen Medien in London wissenschaftlich bewiesen worden sei.“"
                                            },
                                            {
                                                "example_id": "d82f03f8-ee42-4cc5-8178-e26cf6d7a25a",
                                                "sense_id": "45ae5798-7f8f-3895-8620-1ee357ac21de",
                                                "text": "„Aufatmen konnte Darwin erst wieder, als Wallace zur allgemeinen Verblüffung seine Selbstvernichtung als Wissenschaftler einleitete, indem er sich dem Spiritismus zuwandte, der zu einer Modeerscheinung unter ansonsten intelligenten Menschen geworden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
