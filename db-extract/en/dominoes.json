                        "target_lang_word": "Domino",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Domino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b1c75c4-63f7-3b10-8e34-209af26fd18b",
                                        "entry_id": "b6f4dad8-6836-31f4-af4f-64a3ff50a7b8",
                                        "glosses": [
                                            "Name eines Gesellschaftsspieles mit Spielsteinen, auf denen Zahlen in Form entsprechend vieler Punkte abgebildet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6da0fd95-bc8e-45d4-9095-5e25f03addf7",
                                                "sense_id": "3b1c75c4-63f7-3b10-8e34-209af26fd18b",
                                                "text": "Spielen wir Domino?"
                                            },
                                            {
                                                "example_id": "350c6bbb-836e-4223-99f9-8681b2420911",
                                                "sense_id": "3b1c75c4-63f7-3b10-8e34-209af26fd18b",
                                                "text": "„Ein paar Männer spielen Domino; sie sehen aus wie Nordafrikaner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Domino",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d4f161-6372-3473-b73b-8aff521bd3ab",
                                        "entry_id": "f597afe6-c003-3ac5-9d71-697a44f28c37",
                                        "glosses": [
                                            "Kapuzenumhang, der der Maskierung dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0634712-94de-420b-a0b4-2ceee34303bb",
                                                "sense_id": "e3d4f161-6372-3473-b73b-8aff521bd3ab",
                                                "text": "Er zog den Domino an und verschwand unter den anderen Maskierten."
                                            },
                                            {
                                                "example_id": "b5f52b6d-51d2-4a0b-96f6-4cb1202c3afa",
                                                "sense_id": "e3d4f161-6372-3473-b73b-8aff521bd3ab",
                                                "text": "„Sie antwortete mir, sie könne nur daran denken, mich glücklich zu machen, wenn sie selbst dabei glücklich werde, und werde mir schreiben, was ich dazu tun könne; den Brief werde sie zwischen Futter und Überzug der Kapuze des Dominos einnähen, und deshalb solle ich diesen erst am folgenden Tag holen lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4672656b-e085-355c-b724-b7e299770183",
                                        "entry_id": "f597afe6-c003-3ac5-9d71-697a44f28c37",
                                        "glosses": [
                                            "Träger eines Kapuzenumhangs, der der Maskierung dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09dce69f-afa2-4969-9fdc-8a361abba037",
                                                "sense_id": "4672656b-e085-355c-b724-b7e299770183",
                                                "text": "Sie tanzte auf dem Kostümfest mit einem Domino."
                                            },
                                            {
                                                "example_id": "e0825ca5-908f-4f13-8de9-7a20b9dc3f80",
                                                "sense_id": "4672656b-e085-355c-b724-b7e299770183",
                                                "text": "„Ich war nicht maskiert. Bald sah ich mich von einem schwarzen Domino angegriffen, den ich leicht als eine weibliche Maske erkannte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ebcad0fe-90a0-33f0-9b84-2e74fa484ea1",
                                        "entry_id": "f597afe6-c003-3ac5-9d71-697a44f28c37",
                                        "glosses": [
                                            "Dominostein"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ef9738-f14e-4283-b531-441e8ed79142",
                                                "sense_id": "ebcad0fe-90a0-33f0-9b84-2e74fa484ea1",
                                                "text": "Alle Dominos fielen Stein für Stein um."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
