                    },
                    {
                        "translation_id": "86c10c39-301e-436f-a4ba-05dd1915b03b",
                        "source_entry_id": "9fb2c5c9-1197-3a6c-aa1d-f995c245d96f",
                        "source_sense_id": "006b82b9-8d18-3b01-9633-ad3d108b3c2d",
