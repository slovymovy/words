                                "sense_id": "8af7db42-6f60-320a-a578-0d13aeba4bf2",
                                "text": "J’ai choisi la risographie pour imprimer mes affiches."
                            },
                            {
                                "example_id": "4c9db9be-4f5a-4a56-bb44-8f14ebc6d5f7",
                                "sense_id": "8af7db42-6f60-320a-a578-0d13aeba4bf2",
                                "text": "Là encore, l’originalité peut s’exprimer (risographie, etc.)."
                            }
                        ]
                    },
