                                "target_senses": [
                                    {
                                        "sense_id": "77ff238a-13bf-3c89-a8fb-9e63b0463e58",
                                        "entry_id": "f61d8fd2-04b0-3c65-a3fd-9653af4d7b3e",
                                        "glosses": [
                                            "Symbol"
                                        ],
                                        "tags": [],
