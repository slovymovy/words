                ],
                "senses": [
                    {
                        "sense_id": "d8f69d57-3d54-3ca1-8b44-25864cbd418c",
                        "entry_id": "601d5680-be5b-37c3-b432-00daedcc09fc",
                        "glosses": [
                            "een overheidsdienst die de veiligheid bewaakt door middel van land-, zee- en luchtmacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d6f7321-58ec-4cfc-b776-3bd89a107b44",
                                "sense_id": "d8f69d57-3d54-3ca1-8b44-25864cbd418c",
                                "text": "De Nederlandse krijgsmacht heeft al meerdere keren bewezen dat deze goed functioneert."
                            },
                            {
                                "example_id": "3365d176-88ed-488a-8235-7b30d38c2e59",
                                "sense_id": "d8f69d57-3d54-3ca1-8b44-25864cbd418c",
                                "text": "Ook binnen de NAVO is er enthousiasme voor de toetreding van beide landen. \"Qua krijgsmacht wordt de NAVO zeker versterkt\", zegt Sabine Mengelberg, universitair docent Internationale Veiligheidssamenwerking aan de Nederlandse Defensie Academie. \"Finland is een democratisch land, een rijk land, met een sterke krijgsmacht. Dat is zeker een aanwinst voor de andere NAVO-landen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9302094-072a-4f91-a4f7-f4281fa86dd3",
                        "source_entry_id": "601d5680-be5b-37c3-b432-00daedcc09fc",
                        "source_sense_id": "d8f69d57-3d54-3ca1-8b44-25864cbd418c",
