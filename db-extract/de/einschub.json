                "senses": [
                    {
                        "sense_id": "fa469e2f-d65e-3d96-abcb-894c35352749",
                        "entry_id": "f4409bb6-9cfc-317d-8428-b49d0efc0e32",
                        "glosses": [
                            "eingeschobene Textpassage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410a490a-c5ca-4abb-942c-df0bcc8c1f03",
                                "sense_id": "fa469e2f-d65e-3d96-abcb-894c35352749",
                                "text": "„Hier muss man die Erzählung kurz unterbrechen und einen Einschub machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1ebda32-665b-4920-ae29-24d4084a633a",
                        "source_entry_id": "f4409bb6-9cfc-317d-8428-b49d0efc0e32",
                        "source_sense_id": "fa469e2f-d65e-3d96-abcb-894c35352749",
                        "source_sense_description": "eingeschobene Textpassage",
                        "target_lang_word": "interpolation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpolation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb5cd552-5179-3882-a51c-b251e0c36ec5",
                                        "entry_id": "3ee0887a-7724-38ce-9a13-4c38f5cf8919",
                                        "glosses": [
                                            "An abrupt change in elements, with continuation of the first idea."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d84c97f-051d-3315-8a1c-4577f5e4b5c2",
                                        "entry_id": "3ee0887a-7724-38ce-9a13-4c38f5cf8919",
                                        "glosses": [
                                            "The process of estimating the value of a function at a point from its values at nearby points."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62761487-0a91-3ead-be5d-3cced7afb80e",
                                        "entry_id": "3ee0887a-7724-38ce-9a13-4c38f5cf8919",
                                        "glosses": [
                                            "The process of interpolating: including and processing externally-fetched data in a document or program."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "515640cf-f6ca-4f17-9591-9f1369397f24",
                                                "sense_id": "62761487-0a91-3ead-be5d-3cced7afb80e",
                                                "text": "In Perl, variable interpolation happens in double-quoted strings and patterns, and list interpolation occurs when constructing the list of values to pass to a list operator or other such construct that takes a LIST."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29b44255-b167-3253-9bd3-03fa4096856d",
                                        "entry_id": "3ee0887a-7724-38ce-9a13-4c38f5cf8919",
                                        "glosses": [
                                            "That which is introduced or inserted; in contexts of content analysis of centuries-old texts, especially something foreign or spurious."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17cd570c-2c20-438b-91d7-04758b377688",
                                                "sense_id": "29b44255-b167-3253-9bd3-03fa4096856d",
                                                "text": "Today a widely established convention encloses all editorial interpolations in square brackets [like so] for clarity."
                                            },
                                            {
                                                "example_id": "f2eaa5a9-3d16-472f-bba5-83c3ce8d44ee",
                                                "sense_id": "29b44255-b167-3253-9bd3-03fa4096856d",
                                                "text": "Bentley wrote a letter […] upon the scriptural glosses in our present copies of Hesychius, which he considered interpolations from a later hand."
                                            },
                                            {
                                                "example_id": "1e53f9f4-1f79-41db-82e3-bd1669f133a1",
                                                "sense_id": "29b44255-b167-3253-9bd3-03fa4096856d",
                                                "text": "We, who are born into the world's artificial system, can never adequately know how little in our present state and circumstances is natural, and how much is merely the interpolation of the perverted mind and heart of man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74f52786-4f02-3261-b252-abe391e458b7",
                                        "entry_id": "3ee0887a-7724-38ce-9a13-4c38f5cf8919",
                                        "glosses": [
                                            "The use of a melody from a previously recorded song, but recreated rather than sampled from that recording."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3c955e-6694-4d27-8080-b306b615e74c",
                                                "sense_id": "74f52786-4f02-3261-b252-abe391e458b7",
                                                "text": "The melody itself is an interpolation of “The Streets of Cairo,” an Orientalist Tin Pan Alley song originally published in 1895."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37a43fd7-638b-46a6-8d10-c5d6f23d2e6c",
                        "source_entry_id": "f4409bb6-9cfc-317d-8428-b49d0efc0e32",
                        "source_sense_id": "fa469e2f-d65e-3d96-abcb-894c35352749",
