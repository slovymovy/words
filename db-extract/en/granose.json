                        "glosses": [
                            "Having the form of a string of grains or beads, as the antennæ of some insects or the ridges of some conch shells."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afd1fa9-bdd0-40b8-83dd-2e5fd00f0367",
                                "sense_id": "41a749ef-9306-3e14-96e7-276bde998caa",
                                "text": "Those species in which the antennæ gradually enlarge and are either wholly or partly almost granose, with the last joint avoid or oval; in which the head projects but little before, and is prolonged and insensibly rounded behind; and where the thorax is almost cylindrical or square, compose our genus LAGRIA properly so called (1)."
                            },
                            {
                                "example_id": "aaf2be88-27d1-42bd-8feb-1589c3ad2793",
                                "sense_id": "41a749ef-9306-3e14-96e7-276bde998caa",
                                "text": "Shell somewhat fusiform, conical, granose throughout, ridged at the base, spire slightly channeled, finely coronated at the edge; white, tinged with light brown at the base and apex. Length 1 inch."
                            }
                        ]
                    }
