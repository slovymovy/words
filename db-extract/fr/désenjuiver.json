                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee4524d-03a3-48f4-bd95-65a04f8d47cf",
                                "sense_id": "0501ebf1-18b3-3ab9-b387-3f9816488841",
                                "text": "Il appelle chaque Allemand, partout, à désenjuiver l’Europe, à la débarrasser de son ivraie qu’un méchant a semée."
                            },
                            {
                                "example_id": "f59dfbbb-dc52-4105-b1d0-9cb870dcb905",
                                "sense_id": "0501ebf1-18b3-3ab9-b387-3f9816488841",
                                "text": "J’ai essayé, mais je ne crois pas être en mesure de le désenjuiver."
                            },
                            {
                                "example_id": "f7fe5218-20bd-470e-9179-291671463213",
                                "sense_id": "0501ebf1-18b3-3ab9-b387-3f9816488841",
                                "text": "Si l’office du droit allemand est de « désenjuiver » la communauté populaire, la tâche de la « science » allemande du droit allemand est de se désenjuiver elle-même et donc d’extirper jusqu’à la racine le positivisme et le normativisme."
                            }
                        ]
                    }
