                                    {
                                        "sense_id": "2a41c916-9ed3-344e-9bb4-cee0e3a27fe3",
                                        "entry_id": "726219a6-cb84-3875-b36f-22c235815613",
                                        "glosses": [
                                            "Commune et ville de la région du Frioul-Vénétie julienne en Italie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76daeef0-62c4-4230-8c02-3a7cc906bee6",
                                                "sense_id": "2a41c916-9ed3-344e-9bb4-cee0e3a27fe3",
                                                "text": "Une autre espèce de navire très-commune à Venise , et qui sert particulièrement à ses communications avec Trieste et les ports de l’Istrie , ce sont des trébacs de soixante à quatre-vingts tonneaux."
                                            },
                                            {
                                                "example_id": "8f21de8e-aa1f-4cf6-ba3b-2487ccb43632",
                                                "sense_id": "2a41c916-9ed3-344e-9bb4-cee0e3a27fe3",
                                                "text": "Va pour le sud-est : l’usage cartographique fixait la bordure australe de l’arc alpin à Trieste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9df7066-18c1-3e04-9ac1-4c0b866b7734",
                                        "entry_id": "726219a6-cb84-3875-b36f-22c235815613",
