                        ],
                        "examples": [
                            {
                                "example_id": "be6ce1c0-bbe6-4d83-b268-988bbf193f57",
                                "sense_id": "2e094f74-84ed-3356-8494-594beda17896",
                                "text": "Ба́ить на юг от Мск., ба́ять и байкать, ба́ивать (ба́яти и ба́ти; сеяти и сети, деяти и дети; как от пети песнь, так от бати баснь) сев. и вост. также в зап. губ. говорить, болтать, беседовать, разсказывать, разговаривать, толковать; бахорить, баку́лить, балабонить, калякать, га́мить"
                            }
                        ]
                    }
