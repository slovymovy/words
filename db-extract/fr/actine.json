                                        "glosses": [
                                            "ein Eiweißkörper im Muskel"
                                        ],
                                        "tags": [
                                            "Biochemie",
                                            "Molekularbiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e8f45eb-dbbc-4edc-9341-23bf1f56bc24",
                                                "sense_id": "44c5c384-6521-3973-8510-c483642ed1ea",
                                                "text": "Aktin und Myosin spielen bei der Muskelkontraktion eng zusammen."
