                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small town of <w>Interior</w> serves as a gateway to the Badlands National Park.",
                            "target_lang_translations": {
                                "ru": "Маленький городок <w>Интериор</w> служит воротами в национальный парк Бэдлендс.",
                                "zh": "小镇<w>因特里尔</w>是通往恶地国家公园的门户。"
                            }
                        },
