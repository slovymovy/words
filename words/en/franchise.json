                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports_context",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is hoping to attract a new football <w>franchise</w> to the stadium.",
