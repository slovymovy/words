                    {
                        "translation_id": "a487ba5d-66b9-4ef0-84af-1d216bf2ffdd",
                        "source_entry_id": "f32bfe95-869c-3c17-926d-e344f60b8b27",
                        "source_sense_description": "battle axe",
                        "target_lang_word": "Streitaxt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streitaxt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f300a5e2-768a-3241-b9e1-a78064ab8dea",
                                        "entry_id": "ec73ed73-23d3-3258-af5b-51093b0e3f96",
                                        "glosses": [
                                            "Militär, historisch: eine primär als Waffe konzipierte Axt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415c6ba6-17a2-442c-9abf-4502a8a3814e",
                                                "sense_id": "f300a5e2-768a-3241-b9e1-a78064ab8dea",
                                                "text": "„Neben Pfeil und Bogen gehört die Streitaxt mit zu den ältesten Waffen der Menschheit.“"
                                            },
                                            {
                                                "example_id": "a0bc8fba-0f3a-49c0-a433-8f78230f4553",
                                                "sense_id": "f300a5e2-768a-3241-b9e1-a78064ab8dea",
                                                "text": "„Bald nach dem Massaker stürmen Indianer auf die Grönländer zu, schwingen steinerne Tomahawks und schießen mit Pfeil und Bogen - steinzeitliche Waffen, die den eisernen Schwertern und Streitäxten der Wikinger aber kaum unterlegen sind.“"
                                            },
                                            {
                                                "example_id": "7ea91bf4-c296-48f0-856b-06fe3f089244",
                                                "sense_id": "f300a5e2-768a-3241-b9e1-a78064ab8dea",
                                                "text": "„Ihre Hände griffen rasch nach ihren Lanzen und Streitäxten, ihre Nasen begannen zu schnauben gleich Streitrossen, ihre düstern Gesichter nahmen einen furchtbar trotzigen Ausdruck an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
