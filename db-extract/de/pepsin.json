                    {
                        "translation_id": "570f72da-0110-4109-951d-0889f166a12d",
                        "source_entry_id": "bd261ba1-4074-33d0-afe3-db4330794835",
                        "source_sense_id": "d04c5512-3d12-3e1d-879f-ac93dc02c8b9",
                        "source_sense_description": "Biologie: eiweißspaltendes Enzym des Magensafts (zur Verdauung)",
                        "target_lang_word": "pepsine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pepsine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b0e07f4-9c77-3c28-8d8d-529d53ec71de",
                                        "entry_id": "64a793cf-ca9c-39b9-a326-096205637b57",
                                        "glosses": [
                                            "Ferment contenu dans le suc gastrique et agissant au cours de la digestion sur les protéines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "070aff0e-8782-41a1-a227-429614829da8",
                                                "sense_id": "5b0e07f4-9c77-3c28-8d8d-529d53ec71de",
                                                "text": "L'extrait stomacal est capable d'hydrolyser la lactoglobuline dénaturée, mais non la forme native. La pepstatin-A, inhibiteur spécifique de la pepsine, inhibe, complètement, les effets du suc gastrique, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa1b8da3-1c11-30f5-ab61-458f6506e180",
                                        "entry_id": "64a793cf-ca9c-39b9-a326-096205637b57",
                                        "glosses": [
                                            "Médicament aidant à la digestion utilisant cette enzyme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15504d25-f2f3-4599-9131-ee746f48df66",
                                                "sense_id": "aa1b8da3-1c11-30f5-ab61-458f6506e180",
                                                "text": "Mon pauvre beau ! Il ne voulait rien me dire, d’abord : il cachait sa neurasthénie de Parisien surmené. Il s’était mis à croire aux vins de coca, aux pepto-fers, à toutes les pepsines, et un jour il s’est évanoui sur mon cœur…"
                                            },
                                            {
                                                "example_id": "aff5defd-0b6d-4706-88e9-376f5a329644",
                                                "sense_id": "aa1b8da3-1c11-30f5-ab61-458f6506e180",
                                                "text": "Quand Françoise, après avoir veillé à ce que mes parents eussent tout ce qu’il leur fallait, remontait une première fois chez ma tante pour lui donner sa pepsine et lui demander ce qu’elle prendrait pour déjeuner, il était bien rare qu’il ne fallût pas donner déjà son avis ou fournir des explications sur quelque événement d’importance"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
