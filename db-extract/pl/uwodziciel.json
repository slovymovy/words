                "senses": [
                    {
                        "sense_id": "1b146bf1-46b1-351c-a4e9-714ce7efac88",
                        "entry_id": "59829c23-1d7a-3376-9fd4-2678f272d3bb",
                        "glosses": [
                            "mężczyzna uwodzący kogoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfbce0f-8bd4-45b7-a059-1ac97682b0f4",
                                "sense_id": "1b146bf1-46b1-351c-a4e9-714ce7efac88",
                                "text": "Hrabina została poinformowana o reputacji tego uwodziciela."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04de2a55-fc78-48dc-92ea-0dc2d15f473d",
                        "source_entry_id": "59829c23-1d7a-3376-9fd4-2678f272d3bb",
                        "source_sense_id": "1b146bf1-46b1-351c-a4e9-714ce7efac88",
                        "target_lang_word": "seducer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seducer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "61860484-8de5-39dc-85d0-8162f65753a0",
                                        "entry_id": "142d0942-14f1-3e64-b72b-361e3e281598",
                                        "glosses": [
                                            "Someone who seduces, especially a man who seduces a woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdfdd853-74db-4397-9d05-6da05764791f",
                                                "sense_id": "61860484-8de5-39dc-85d0-8162f65753a0",
                                                "text": "But Ted Farrell couldn't stop; that armful of active girl was too much for the wise precautions of a seducer. He kept panting, \"Don't be a nark, Cora,\" while struggling to hold her down."
                                            },
                                            {
                                                "example_id": "4ba6e3e8-fcea-426d-a323-4c9f88f655c6",
                                                "sense_id": "61860484-8de5-39dc-85d0-8162f65753a0",
                                                "text": "Knox takes us through the lives of memorable seducers and their critics, in sometimes academic and sometimes rococo prose dappled with doges, coups de foudre, rakes, bawds, coquettes, coxcombs and procuresses — with guest appearances by members of the Frankfurt School sunning themselves in La Jolla."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79072889-d52c-475b-9357-a614b3b8fd86",
                        "source_entry_id": "59829c23-1d7a-3376-9fd4-2678f272d3bb",
                        "source_sense_id": "1b146bf1-46b1-351c-a4e9-714ce7efac88",
                        "target_lang_word": "séducteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                        "entry_id": "4220d491-6cec-368a-ab0b-7d4af7eba809",
                                        "glosses": [
                                            "Qui cherche à plaire, qui charme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb321a2c-c469-43dc-b7f2-a2dbca6bdae2",
                                                "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                                "text": "Un discours, un ton séducteur."
                                            },
                                            {
                                                "example_id": "b46d43df-8293-4edf-ba51-94d9ef6fd8e7",
                                                "sense_id": "523c2a6c-adca-3b80-a893-d88792abc312",
                                                "text": "L’esprit séducteur : le diable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "séducteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa00affe-79f6-3b04-9c4c-55c5426c16a1",
                                        "entry_id": "8b77c9b3-664e-38cc-9533-b526cb6db47c",
                                        "glosses": [
                                            "Celui qui séduit, qui fait tomber en erreur ou en faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d71e694-9299-4bc1-9d7f-6ba00c6dbc66",
                                                "sense_id": "aa00affe-79f6-3b04-9c4c-55c5426c16a1",
                                                "text": "Séducteur de la jeunesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                        "entry_id": "8b77c9b3-664e-38cc-9533-b526cb6db47c",
                                        "glosses": [
                                            "Celui qui corrompt l’innocence, la vertu des jeunes personnes ou des adultes."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5558567a-8e77-4a43-b91b-6ab4884703ba",
                                                "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                                "text": "Pour elle j'étais l’amant, non le séducteur; elle revoyait son premier rendez-vous, elle ressentait le premier baiser; elle se revirginisait! Pauvre Gretchen!"
                                            },
                                            {
                                                "example_id": "7e7e820b-e1f2-4fff-8401-ca9f174d7093",
                                                "sense_id": "f2a6dd0e-396b-3234-b54f-1a3577239383",
                                                "text": "Des imbéciles qui se retrouvaient en tôle[sic] parce qu'il fallait faire sa fête à la fauteuse et trucider le séducteur. Pour l'honneur ! Mon œil pensait Lekbir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
