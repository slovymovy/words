                "senses": [
                    {
                        "sense_id": "81a6da92-235a-3588-bf4c-a97a07029768",
                        "entry_id": "7d74cea7-09a3-31e8-bfea-90e2237f329e",
                        "glosses": [
                            "bewaffnete Drohne für Kampfeinsätze, die bei ihrem Einsatz (gewollt) zerstört wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db06e68-8b83-4c4e-b03d-d188334cfdc1",
                                "sense_id": "81a6da92-235a-3588-bf4c-a97a07029768",
                                "text": "„Ukrainische Experten haben eine erbeutete russische Kamikazedrohne vom Typ Lancet zerlegt.“"
                            },
                            {
                                "example_id": "94461333-891c-4cc9-86ce-8e33d1226e22",
                                "sense_id": "81a6da92-235a-3588-bf4c-a97a07029768",
                                "text": "„Die Kamikazedrohnen können Flugabwehrpanzer wie den deutschen Gepard durch ihre schiere Anzahl überwinden.“"
                            },
                            {
                                "example_id": "c51816ec-0cf8-4daa-973f-06e4d9e8486f",
                                "sense_id": "81a6da92-235a-3588-bf4c-a97a07029768",
                                "text": "„Das rusische Militär und der chinesische Drohnenhersteller Xi'an Bingo Intelligent Aviation Technology verhandeln angeblich über die Massenproduktion sogenannter Kamikazedrohnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
