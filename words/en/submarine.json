                            }
                        },
                        {
                            "text": "A nuclear <w>submarine</w> can stay submerged for a very long time.",
                            "target_lang_translations": {
                                "ru": "Атомная <w>подводная лодка</w> может оставаться под водой очень долгое время.",
                                "zh": "核<w>潜艇</w>可以在水下停留很长时间。"
                            }
