{
    "word_family": [
        "idle",
        "idly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6fc8df2d-4b9b-3b20-858f-de4ee8fd9199",
                    "sense_definition": "The state of being inactive or not working.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory closed down and left many workers in a state of <w>idleness</w>.",
                            "target_lang_translations": {
                                "ru": "Завод закрылся, и многие рабочие оказались в состоянии <w>просто́я</w>."
                            }
                        },
                        {
                            "text": "He spent his summer in <w>idleness</w> instead of looking for a job.",
                            "target_lang_translations": {
                                "ru": "Он провел лето в <w>безде́лье</w>, вместо того чтобы искать работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "inactivity",
                        "laziness",
                        "inactivity"
                    ],
                    "antonyms": [
                        "activity",
                        "industry"
                    ],
                    "common_phrases": [
                        "forced idleness",
                        "chronic idleness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние бездействия или отсутствия работы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безде́лье",
                                "target_lang_sense_clarification": "состояние, когда человек ничем не занят"
                            },
                            {
                                "target_lang_word": "просто́й",
                                "target_lang_sense_clarification": "вынужденный перерыв в работе или производстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df3d348-a1a1-3fa0-8305-c9f3b8eb91eb",
                    "sense_definition": "The quality of being lazy or avoiding effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>idleness</w> prevented him from achieving his full potential at school.",
                            "target_lang_translations": {
                                "ru": "Его постоянная <w>ле́ность</w> помешала ему полностью раскрыть свой потенциал в школе."
                            }
                        },
                        {
                            "text": "She was criticized for her <w>idleness</w> when there was so much work to be done.",
                            "target_lang_translations": {
                                "ru": "Её критиковали за <w>пра́здность</w>, когда нужно было сделать так много работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "indolence",
                        "sloth"
                    ],
                    "antonyms": [
                        "diligence"
                    ],
                    "common_phrases": [
                        "habitual idleness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество лени или избегание усилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ле́ность",
                                "target_lang_sense_clarification": "склонность к лени, нежелание трудиться"
                            },
                            {
                                "target_lang_word": "пра́здность",
                                "target_lang_sense_clarification": "образ жизни, лишенный труда и серьезных занятий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a903a5ca-af73-3e91-9963-7863b172e4c8",
                    "sense_definition": "The quality of being trivial, worthless, or lacking serious purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic dismissed the entire project as mere <w>idleness</w> and vanity.",
                            "target_lang_translations": {
                                "ru": "Критик отверг весь проект как пустую <w>бесполе́зность</w> и тщеславие."
                            }
                        },
                        {
                            "text": "He regretted the <w>idleness</w> of his youth spent on meaningless pursuits.",
                            "target_lang_translations": {
                                "ru": "Он сожалел о <w>беспло́дности</w> своей юности, потраченной на бессмысленные занятия."
                            }
                        }
                    ],
                    "synonyms": [
                        "frivolity",
                        "triviality"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество тривиальности, бесполезности или отсутствия серьезной цели."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бесполе́зность",
                                "target_lang_sense_clarification": "отсутствие пользы или смысла"
                            },
                            {
                                "target_lang_word": "беспло́дность",
                                "target_lang_sense_clarification": "отсутствие результатов или продуктивности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}