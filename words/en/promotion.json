{
    "word_family": [
        "promote",
        "promoter",
        "promotional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fa021e83-8b19-30af-a053-6da0c1ed4e83",
                    "sense_definition": "An advancement to a higher rank, position, or job level within an organization.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "career_advancement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After three years of hard work, she finally received a <w>promotion</w> to senior manager.",
                            "target_lang_translations": {
                                "ru": "После трех лет упорной работы она наконец получила <w>повышение</w> до старшего менеджера."
                            }
                        },
                        {
                            "text": "The company announced a well-deserved <w>promotion</w> for several dedicated employees this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром компания объявила о заслуженном <w>повышении</w> нескольких преданных сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "advancement",
                        "elevation",
                        "ascent"
                    ],
                    "antonyms": [
                        "demotion"
                    ],
                    "common_phrases": [
                        "receive a promotion",
                        "deserve a promotion",
                        "job promotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продвижение на более высокий ранг, должность или уровень работы внутри организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повышение",
                                "target_lang_sense_clarification": "по службе"
                            },
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "по карьерной лестнице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2abd8655-0ec7-329a-b16f-0ba1a8cb1db3",
                    "sense_definition": "The act of spreading information or supporting an idea to increase its popularity or public awareness.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marketing_and_advocacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>promotion</w> of healthy eating habits in schools is essential for long-term public health.",
                            "target_lang_translations": {
                                "ru": "<w>Пропаганда</w> привычек здорового питания в школах необходима для долгосрочного здоровья населения."
                            }
                        },
                        {
                            "text": "They are focusing on the <w>promotion</w> of renewable energy sources across the country.",
                            "target_lang_translations": {
                                "ru": "Они сосредоточены на <w>продвижении</w> возобновляемых источников энергии по всей стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "advocacy",
                        "encouragement",
                        "furtherance"
                    ],
                    "common_phrases": [
                        "promotion of ideas",
                        "active promotion",
                        "health promotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по распространению информации или поддержке идеи для повышения её популярности или общественной осведомленности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "идей или ценностей"
                            },
                            {
                                "target_lang_word": "пропаганда",
                                "target_lang_sense_clarification": "здорового образа жизни или идей"
                            },
                            {
                                "target_lang_word": "популяризация",
                                "target_lang_sense_clarification": "знаний или привычек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4517bd4-8ec7-3597-bb74-768984308212",
                    "sense_definition": "A specific activity or campaign designed to increase the sales or public image of a product or brand.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "marketing_and_advocacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supermarket is running a special <w>promotion</w> where you can buy two items for the price of one.",
                            "target_lang_translations": {
                                "ru": "Супермаркет проводит специальную <w>акцию</w>, по которой можно купить два товара по цене одного."
                            }
                        },
                        {
                            "text": "This seasonal <w>promotion</w> helped the brand reach a much wider audience than last year.",
                            "target_lang_translations": {
                                "ru": "Эта сезонная <w>рекламная кампания</w> помогла бренду охватить гораздо более широкую аудиторию, чем в прошлом году."
                            }
                        }
                    ],
                    "synonyms": [
                        "advertising",
                        "publicity",
                        "campaign"
                    ],
                    "common_phrases": [
                        "sales promotion",
                        "special promotion",
                        "run a promotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное мероприятие или кампания, направленная на увеличение продаж или улучшение имиджа продукта или бренда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "акция",
                                "target_lang_sense_clarification": "рекламная или торговая"
                            },
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "товара на рынке"
                            },
                            {
                                "target_lang_word": "промоушен",
                                "target_lang_sense_clarification": "маркетинговая активность"
                            },
                            {
                                "target_lang_word": "рекламная кампания",
                                "target_lang_sense_clarification": "для привлечения клиентов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d6cdddf-a62e-37e3-8f87-c8d443e53081",
                    "sense_definition": "In chess, the transformation of a pawn into a more powerful piece when it reaches the opponent's back rank.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chess_mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player achieved a pawn <w>promotion</w> and chose a queen to secure the win.",
                            "target_lang_translations": {
                                "ru": "Игрок добился <w>превращения</w> пешки и выбрал ферзя, чтобы обеспечить победу."
                            }
                        },
                        {
                            "text": "He carefully calculated his moves to ensure a successful <w>promotion</w> in the endgame.",
                            "target_lang_translations": {
                                "ru": "Он тщательно просчитывал свои ходы, чтобы обеспечить успешное <w>проведение</w> пешки в эндшпиле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pawn promotion"
                    ],
                    "target_lang_definitions": {
                        "ru": "В шахматах: превращение пешки в более сильную фигуру при достижении последней горизонтали противника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "превращение",
                                "target_lang_sense_clarification": "пешки"
                            },
                            {
                                "target_lang_word": "проведение",
                                "target_lang_sense_clarification": "пешки в ферзи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29a14bc0-1eab-356e-b9ab-4bb48beab37d",
                    "sense_definition": "The forward movement of a limb or body part, especially in biology or anatomy.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher studied the <w>promotion</w> and remotion of the insect's legs during rapid movement.",
                            "target_lang_translations": {
                                "ru": "Исследователь изучал <w>протракцию</w> и ретракцию ног насекомого во время быстрого движения."
                            }
                        },
                        {
                            "text": "In certain arthropods, the <w>promotion</w> of the leg occurs at the coxa-trochanter joint.",
                            "target_lang_translations": {
                                "ru": "У некоторых членистоногих <w>движение вперед</w> ноги происходит в тазобедренном суставе."
                            }
                        }
                    ],
                    "synonyms": [
                        "forward motion"
                    ],
                    "common_phrases": [
                        "leg promotion"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение конечности или части тела вперед, особенно в биологии или анатомии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "протракция",
                                "target_lang_sense_clarification": "движение вперед в анатомии"
                            },
                            {
                                "target_lang_word": "продвижение",
                                "target_lang_sense_clarification": "конечности вперед"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}