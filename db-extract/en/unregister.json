                    {
                        "translation_id": "0524c3a8-118c-497b-b607-a645b78ab201",
                        "source_entry_id": "2ce22256-a4de-3f91-9ae1-39ed6cd8f756",
                        "source_sense_description": "deregister",
                        "target_lang_word": "abmelden",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abmelden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0306baf0-8e6f-3197-8a4a-fca886516d5d",
                                        "entry_id": "eb2e218b-cb15-367a-a1a5-125c6932ec22",
                                        "glosses": [
                                            "seinen Weggang bekanntgeben"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b495bb30-21be-40d6-a141-36c4db2531b5",
                                                "sense_id": "0306baf0-8e6f-3197-8a4a-fca886516d5d",
                                                "text": "„Jetzt bin ich ganz kalt: ‚Herr Hauptmann, ich habe Anspruch auf ärztliche Versorgung wie jeder Soldat — ich melde mich ab zum Truppenverbandsplatz.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d85954a5-dee0-32c5-93e0-682b8fba98be",
                                        "entry_id": "eb2e218b-cb15-367a-a1a5-125c6932ec22",
                                        "glosses": [
                                            "die Außerbetriebnahme bekanntgeben"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54d6c06b-98ad-4d2d-a7c1-847225e3b2a2",
                                                "sense_id": "d85954a5-dee0-32c5-93e0-682b8fba98be",
                                                "text": "„Wer keinerlei Risiko eingehen will, sollte seinen Wagen vor der Übergabe abmelden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "12bc0ac6-64ee-3c2e-84df-a1a11a954fb0",
                                        "entry_id": "eb2e218b-cb15-367a-a1a5-125c6932ec22",
                                        "glosses": [
                                            "die Nichtmehrteilnahme bekanntgeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac247d47-9bb1-44f9-88be-dfb800edf738",
                                                "sense_id": "12bc0ac6-64ee-3c2e-84df-a1a11a954fb0",
                                                "text": "„Ein verletzter Abwehrspieler der Italiener hatte das Spielfeld für eine medizinische Behandlung verlassen, wurde jedoch nicht beim Schiedsrichter abgemeldet, der ihn als einen im Spiel eingreifenden italienischen Akteur wertete, der dadurch zusammen mit Buffon (es zählen die letzten zwei Abwehrspieler) die Abseitsstellung Van Nistelrooys aufhob.“"
                                            },
                                            {
                                                "example_id": "84921d8e-8510-409b-9afa-a9ec96595759",
                                                "sense_id": "12bc0ac6-64ee-3c2e-84df-a1a11a954fb0",
                                                "text": "„Bei Bedarf kann man einen Benutzer abmelden, ohne vorher umständlich zum betreffenden Konto zu wechseln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
