                "forms": [
                    {
                        "form_id": "0b01b27d-d20a-4d58-bfa1-54f418666d43",
                        "entry_id": "97a62e5c-1623-343c-964d-2a3b54118a30",
                        "tags": [
                            "plural"
                        ],
                        "form": "mésaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b3fa322-97e1-3306-a381-d6cd055c94bd",
                        "entry_id": "97a62e5c-1623-343c-964d-2a3b54118a30",
                        "glosses": [
                            "Insuffisance des moyens d’existence ; gêne financière."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "633524da-5e8a-42ef-bb78-534050fa9fc3",
                                "sense_id": "2b3fa322-97e1-3306-a381-d6cd055c94bd",
                                "text": "Elle vit l’opulence & les richesses succéder à l’aisance ; & son père, avant tout cela, avoit connu le mésaise & presque la pauvreté."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8de6012-2fc6-3a5b-bad1-bb271be686c0",
                        "entry_id": "97a62e5c-1623-343c-964d-2a3b54118a30",
                        "glosses": [
                            "État psychologique de déplaisir et d'insatisfaction causé par une gêne ou par un manque."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "14e4acb7-d1df-4597-8cc4-bec63ecfa3ad",
                                "sense_id": "c8de6012-2fc6-3a5b-bad1-bb271be686c0",
                                "text": "Le mésaise que vous éprouvez n’a point d’autres causes que le vide où se trouve votre cœur."
                            },
                            {
                                "example_id": "fb4c0696-12a4-4b6c-9109-81f9066f114e",
                                "sense_id": "c8de6012-2fc6-3a5b-bad1-bb271be686c0",
                                "text": "Sans mentir et sans se leurrer aussi, il pouvait, en toute sécurité, s’écrier : « Seigneur, j’ai aimé la beauté de votre maison et le lieu où habite votre gloire. » C’était la seule compensation qu’il pût proposer au Père, de ses contumélies et de ses mésaises, de ses écarts et de ses chutes."
                            }
                        ]
                    }
                ],
