                            {
                                "example_id": "feb27d07-5ce3-410a-a723-147ce2a084bd",
                                "sense_id": "6c1e6fed-1f73-3f6e-82b1-6f248f3ecf15",
                                "text": "Ik wilde aan de kant van de toeschouwers staan, in plaats van tegen hen te praten of hen te commanderen, zoals ik met die grote kleurvlakken heb gedaan, door hun instructies te geven hoe ze zich moeten voelen, ik wilde liever, weet je, samen met hen in de reddingssloep plaatsnemen."
                            },
                            {
                                "example_id": "bd136935-7399-40a8-9cac-7905226106fd",
                                "sense_id": "6c1e6fed-1f73-3f6e-82b1-6f248f3ecf15",
                                "text": "De slachtoffers zaten in de reddingssloep die op meer dan twintig meter hoogte aan het cruiseschip hing. De sloep raakte los, kantelde en kwam op zijn kop in het water terecht. De slachtoffers konden er niet meer onderuit komen."
                            }
                        ]
                    }
