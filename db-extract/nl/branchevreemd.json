                "senses": [
                    {
                        "sense_id": "a3c40794-5e9c-36a6-b521-743c8eda8377",
                        "entry_id": "5df286cd-624b-32f3-8f9b-4fb242919595",
                        "glosses": [
                            "van iets dat het niet past bij de bedrijfstak waartoe een bedrijf hoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed5011c-c2d9-4827-8a7c-29179cda8f08",
                                "sense_id": "a3c40794-5e9c-36a6-b521-743c8eda8377",
                                "text": "\"Uitgaven aan speelgoed gaan deels ook online, en ook buiten speelgoedwinkels om via branchevreemde spelers als drogisterijen, bouwmarkten, supermarkten en winkels in huishoudelijke artikelen\", zegt Duijn."
                            },
                            {
                                "example_id": "f2e53c70-a6d4-484e-b570-85f750e12008",
                                "sense_id": "a3c40794-5e9c-36a6-b521-743c8eda8377",
                                "text": "Verder wil ze dat alleen winkels kunnen meedoen die minimaal 1000 boeken in hun assortiment hebben. Dat sluit grote 'branchevreemde' partijen zoals supermarkten en drogisterijketens uit."
                            },
                            {
                                "example_id": "1a4b047b-839f-458f-940a-4187061faf9b",
                                "sense_id": "a3c40794-5e9c-36a6-b521-743c8eda8377",
                                "text": "Terwijl Bos en Vogelaar over geld ruzieden gingen de corporaties op steeds grotere schaal speculeren en meer branchevreemde projecten aan. Maar het Vestia-debacle kon niemand zien aankomen zegt Van der Laan: \"Hier heeft verheimelijking een rol gespeeld.\""
                            }
                        ]
                    }
