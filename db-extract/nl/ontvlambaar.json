                                        "glosses": [
                                            "Qui s’enflamme facilement, qui prend rapidement feu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdbabbd9-bd0a-479d-a1e4-d08f996f8bc6",
                                                "sense_id": "f4c3f068-8ccf-3b17-b434-c86d0ae9d2d2",
                                                "text": "Les pinèdes, ainsi que les massifs de bruyères et de chênes kermès deviennent particulièrement inflammables."
                                            },
                                            {
                                                "example_id": "f9143a99-ada9-4b2c-9d83-ad72e04d577c",
                                                "sense_id": "f4c3f068-8ccf-3b17-b434-c86d0ae9d2d2",
                                                "text": "Ce qui se passe actuellement est emblématique : le massif landais est essentiellement composé de pins maritimes plantés par les humains, qui sont des arbres résineux extrêmement inflammables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87f15cb5-ba05-3816-b1f1-796dc270eea7",
                                        "entry_id": "8269ea7a-aeab-3136-a4e4-74c9f1759dc2",
                                        "glosses": [
                                            "Qui est sujet à se prendre de passion, ou qui s’irrite facilement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95748fcf-976e-4c5d-9db6-87f4dc726748",
                                                "sense_id": "87f15cb5-ba05-3816-b1f1-796dc270eea7",
                                                "text": "Avoir le cœur, un caractère, une nature inflammable."
                                            },
                                            {
                                                "example_id": "fb785273-f05c-46de-aafb-075ebc22ecd9",
                                                "sense_id": "87f15cb5-ba05-3816-b1f1-796dc270eea7",
                                                "text": "Bien que l’indice des prix à la consommation constitue un objet politique moins inflammable qu’auparavant, les controverses demeurent."
                                            }
                                        ]
                                    }
                                ]
                            }
