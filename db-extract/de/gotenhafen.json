                "senses": [
                    {
                        "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                        "entry_id": "86c9aa69-477a-3dac-a53b-ad8baa50624d",
                        "glosses": [
                            "Gdingen, einer Stadt im damals besetzten Polen"
                        ],
                        "tags": [
                            "1939-1945 Name von"
                        ],
                        "examples": [
                            {
                                "example_id": "490d6377-bf4d-42e1-b729-cee17b3684bd",
                                "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                                "text": "Im Zuge der Flucht der deutschen Zivilbevölkerung aus Ostpreußen und anderen Regionen am Ende des Zweiten Weltkriegs war Gotenhafen einer der wichtigsten Evakuierungshäfen, von dem aus Schiffe wie die Wilhelm Gustloff oder die Goya in den Westen fuhren."
                            },
                            {
                                "example_id": "729d6f6b-4ba3-4f8e-8621-85fbdd931120",
                                "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                                "text": "„Als ich in Gotenhafen ankam und vom Bahnhof zum Hafen ging, staunte ich über die Größe des Hafens.“"
                            },
                            {
                                "example_id": "4ae628d5-a7b6-427b-84a7-cc753bc2279e",
                                "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                                "text": "„Da von den weit über viertausend Säuglingen, Kindern, Jugendlichen an Bord des Unglücksschiffes keine hundert gerettet wurden, fanden sich nur zufällig Fotos von ihnen, weil mit dem Schiff das Flüchtlingsgepäck und in ihm die Fotoalben geflüchteter Familien aus Ost- und Westpreußen, Danzig und Gotenhafen verloren gegangen sind.“"
                            },
                            {
                                "example_id": "fe2974e8-12be-4380-98b3-9125eb55a839",
                                "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                                "text": "„Am 9. Januar 1942 betrat ich an der Seite von Heinz Lücker und vier anderen Kmeraden aus Bergen op Zoom in Gotenhafen bei Danzig das Deck der »Wilhelm Gustloff«.“"
                            },
                            {
                                "example_id": "49c49313-9290-4be0-a2fe-c12cb3f0f264",
                                "sense_id": "c3f2e519-0e1e-3bfb-813e-f44a9132f8f4",
                                "text": "„Sie enthielt die Information, dass sie am Leben sei und nun in Gotenhafen ein Schiff besteigen werde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
