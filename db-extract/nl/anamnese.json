                    },
                    {
                        "translation_id": "b1a2a61c-d141-42d7-9b13-ad869a11993f",
                        "source_entry_id": "083e150f-38dc-3466-a879-086fd055549b",
                        "source_sense_id": "ce3a5951-97d7-37d7-aae5-fda31bc81d85",
                        "source_sense_description": "een vraaggesprek naar de ziektegeschiedenis",
                        "target_lang_word": "Anamnese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anamnese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e8bb0e-b1fc-3d50-ae6e-3ec962588e7a",
                                        "entry_id": "47907e95-a402-38c1-9d86-6b3ab5023b95",
                                        "glosses": [
                                            "die Vorgeschichte einer Krankheit, die im Gespräch mit dem Kranken (Eigenanamnese) oder mit den Angehörigen (Fremdanamnese) zur Diagnosestellung ermittelt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ed10c33-d9a9-4bcd-a938-56648ec95c64",
                                                "sense_id": "b5e8bb0e-b1fc-3d50-ae6e-3ec962588e7a",
                                                "text": "Die Anamnese ist ein wichtiger Bestandteil der Diagnosefindung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4043763-582c-3412-9feb-bf30846cc3cb",
                                        "entry_id": "47907e95-a402-38c1-9d86-6b3ab5023b95",
                                        "glosses": [
                                            "Wiedererinnerung der Seele an die Zeit vor der Geburt; Erinnerung an Wahrheiten, die vor Vereinigung von Körper und Seele geschaut wurden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0f73ad-7a9e-40ea-8230-82c52271fddf",
                                                "sense_id": "a4043763-582c-3412-9feb-bf30846cc3cb",
                                                "text": "„Die Anamnese spielt in der Erkenntnislehre Platons (427–347) eine besondere Rolle. Die Erkenntnis der Wahrheit erfolgt nach seiner Auffassung durch Wiedererinnerung an ein früheres Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6c1219c4-b608-39fb-a160-ba2272e61f66",
                                        "entry_id": "47907e95-a402-38c1-9d86-6b3ab5023b95",
                                        "glosses": [
                                            "ein Gebet während der Eucharistie"
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e9ebd3a-e1b7-4ff0-826d-b242a08c0376",
                                                "sense_id": "6c1219c4-b608-39fb-a160-ba2272e61f66",
                                                "text": "„Im klassischen Sinne bezeichnet die Anamnese einen definierten Teil im Abendmahlsgebet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0e06a98-47f5-4a88-a07b-12e561fc712c",
                        "source_entry_id": "083e150f-38dc-3466-a879-086fd055549b",
                        "source_sense_id": "ce3a5951-97d7-37d7-aae5-fda31bc81d85",
                        "source_sense_description": "een vraaggesprek naar de ziektegeschiedenis",
                        "target_lang_word": "Krankengeschichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krankengeschichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                                        "entry_id": "8ffa009f-bf65-33f4-8290-1805992e8fef",
                                        "glosses": [
                                            "Vorgeschichte der Krankheiten einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f4427f-1595-4143-a6d0-6240ff405fa8",
                                                "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                                                "text": "„Ihre Biographie gleicht einer Krankengeschichte.“"
                                            },
                                            {
                                                "example_id": "18829a6a-2b2e-4db2-87ac-706db119dfa8",
                                                "sense_id": "5675abbd-bdd1-3887-ad33-c4b57c7951f3",
                                                "text": "„Zuvor fragte er nach allerlei Daten, nach ihrer Krankengeschichte und Versicherungskarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10d88539-90e8-308c-957d-b95935cf52c5",
                                        "entry_id": "8ffa009f-bf65-33f4-8290-1805992e8fef",
                                        "glosses": [
                                            "Akte, in der die Vorgeschichte der Krankheiten einer Person dokumentiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78dc45ca-8147-419d-a941-4a7d61ce95b2",
                                                "sense_id": "10d88539-90e8-308c-957d-b95935cf52c5",
                                                "text": "„Vor ihrer Überweisung an den Psychiater war sie von mehreren Spezialisten in einer großen Klinik untersucht und behandelt worden. Dadurch hatte sich eine Krankengeschichte von eindrucksvollem Volumen angesammelt, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca22964c-d124-46f2-b223-c56ae01d529f",
                        "source_entry_id": "083e150f-38dc-3466-a879-086fd055549b",
                        "source_sense_id": "ce3a5951-97d7-37d7-aae5-fda31bc81d85",
                        "source_sense_description": "een vraaggesprek naar de ziektegeschiedenis",
                        "target_lang_word": "Vorgeschichte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgeschichte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                        "entry_id": "64f459a7-f2f4-3267-8b20-f1f3516061a4",
                                        "glosses": [
                                            "Gesamtheit der historischen Ereignisse vor Beginn der schriftlichen Überlieferung"
                                        ],
                                        "tags": [
                                            "Geschichtswissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "055d2b9a-af6c-47bd-8f39-031bcb5c4aab",
                                                "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                                "text": "Mit den Kulturen der Vorgeschichte befasst sich die Archäologie."
                                            },
                                            {
                                                "example_id": "b134b50f-5d4f-468b-ad3b-0a4da7d4638a",
                                                "sense_id": "45243c92-2936-3632-96ac-e92e42de043c",
                                                "text": "„Das ist vielleicht die bedeutendste Erkenntnis auf dem Gebiet der Humanevolution seit Lucys Entdeckung: dass in unserer Vorgeschichte mehrere menschliche Arten gleichzeitig auf der Erde umherstreiften.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                        "entry_id": "64f459a7-f2f4-3267-8b20-f1f3516061a4",
                                        "glosses": [
                                            "das, was vor einem bestimmten Ereignis/Zustand liegt und sich darauf auswirkt/zu seinem Verständnis beiträgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcdd5a1-fe20-42e6-a273-f38a3929591e",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Seine Vorgeschichte reichte weit in die Kindheit hinein und in die Zeit, in welcher der innere Horizont durch die Künste des Lesens und Schreibens noch keine Einschnürung erfahren hat.“"
                                            },
                                            {
                                                "example_id": "a1d50b35-da28-456f-9938-86d5ac4883d4",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Der »Schach Lolo« hat eine Vorgeschichte, die der Grund war, dieses Gedicht in die dreibändige Edition von Wielands politischen Schriften aufzunehmen.“"
                                            },
                                            {
                                                "example_id": "5f80350c-f8ea-4717-8dcd-26211c4bb251",
                                                "sense_id": "19891f0a-1526-39f6-96a6-1dcdfe2a4df9",
                                                "text": "„Oft ging dabei der historische Kontext unter, also die Vorgeschichte deutscher Aggressionen und Verbrechen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb8734d2-06b4-492b-a215-9f6c9902414f",
                        "source_entry_id": "083e150f-38dc-3466-a879-086fd055549b",
