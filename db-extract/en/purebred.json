                    {
                        "sense_id": "2739b813-462c-3e57-9e79-df6ebcadb03a",
                        "entry_id": "2c906ef1-365e-3a7d-8a76-7f6719f2a6ff",
                        "glosses": [
                            "Having genuine parents of the same breed, usually of an animal."
