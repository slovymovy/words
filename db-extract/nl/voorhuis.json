                "senses": [
                    {
                        "sense_id": "6f3b4e73-5167-336e-a7c9-d0a2fc6a86a2",
                        "entry_id": "94057361-e22f-308c-b9c1-961341dab66f",
                        "glosses": [
                            "het gedeelte van een woning dat voor het hoofdgebouw is gelegen en dient als ingang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c42eaa1-94e3-408b-a06b-419138890272",
                                "sense_id": "6f3b4e73-5167-336e-a7c9-d0a2fc6a86a2",
                                "text": "In het voorhuis zat Denisov, met een pijp, ineengedoken op de drempel voor de wachtmeester, die rapport uitbracht."
                            },
                            {
                                "example_id": "93d590c9-e2ef-4d94-b23d-422b1d9c89d1",
                                "sense_id": "6f3b4e73-5167-336e-a7c9-d0a2fc6a86a2",
                                "text": "\"Alles knalde en knetterende, de schilderijen bewogen aan de muren. Ik vond mijn vrouw met een spierwit gezicht, tandenborstel in de mond tegen de diepvries om deze te stutten. Puin lag in de afzuigkap, de schoorsteen was uit z'n verband, de tegels in de badkamer waren geknapt en alle deuren van het voorhuis zaten klem.\""
                            }
                        ]
                    }
                ],
