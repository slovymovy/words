                "senses": [
                    {
                        "sense_id": "ef6d521b-276b-3d3e-984d-e01e4e16f303",
                        "entry_id": "64f752ed-3cb0-3d64-8a0e-b627f37290f5",
                        "glosses": [
                            "Auto, das mit Elektromotoren angetrieben wird die ihre Energie ausschließlich aus der Sonneneinstrahlung beziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c58f1e0-ac8e-477b-af85-1e326d500a9c",
                                "sense_id": "ef6d521b-276b-3d3e-984d-e01e4e16f303",
                                "text": "„Als 20 Jahre später immer noch kein Solarauto auf dem Markt war, obwohl man doch die Technik kannte, beschloss Palmer, selber eines zu bauen.“"
                            },
                            {
                                "example_id": "52f79212-f151-474d-a95e-c174e4585d16",
                                "sense_id": "ef6d521b-276b-3d3e-984d-e01e4e16f303",
                                "text": "„Für Josef Jenni, den Initiator des Rennens, belegte die Vorführung, daß Solarautos bald \"einen wichtigen Beitrag zum Nahverkehr\" leisten können.“"
                            },
                            {
                                "example_id": "39a4c422-73b4-48ed-9812-27d56b898b3c",
                                "sense_id": "ef6d521b-276b-3d3e-984d-e01e4e16f303",
                                "text": "„Nach 37 Stunden reiner Fahrzeit erreichte das niederländische Solarauto \"Nuna 9\" als erstes das Ziel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
