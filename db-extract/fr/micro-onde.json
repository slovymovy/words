                "senses": [
                    {
                        "sense_id": "9207c176-b7fe-3f7f-a599-f3e71b375441",
                        "entry_id": "e77471ca-0eb6-3efb-9fdc-93dee35b1424",
                        "glosses": [
                            "Onde radioélectrique dont la longueur d’onde est comprise entre 0,3 mm et 1 m environ."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "a45181fd-95a1-4253-8fbf-960a374a93d7",
                                "sense_id": "9207c176-b7fe-3f7f-a599-f3e71b375441",
                                "text": "Par ailleurs, les applications médicales des micro-ondes deviennent de plus en plus nombreuses. Sans entrer dans les détails, on peut en citer quelques-unes. L’hyperthermie à 2.45 GHz est pratiquée en clinique depuis les années 70."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f10ef86-5c7a-4802-ac1f-1d3e4da0f998",
                        "source_entry_id": "e77471ca-0eb6-3efb-9fdc-93dee35b1424",
                        "source_sense_id": "9207c176-b7fe-3f7f-a599-f3e71b375441",
                        "target_lang_word": "Mikrowelle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikrowelle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "92f8c7e8-f35b-3a51-bbab-d22aab5872f1",
                                        "entry_id": "5fae8a66-9d08-32d7-b848-48fc8ba08b45",
                                        "glosses": [
                                            "Spektrum der elektromagnetischen Wellen von 30 cm bis zu 1 mm Wellenlänge (1 bis 300 GHz), wovon der Bereich um 2,4 GHz zur Wärmeerzeugung eingesetzt wird. Weitere Anwendungsgebiete für Mikrowellen sind Mobilfunk, Radar, Satellitenrundfunk und WLAN"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02abc14f-694c-4fd1-bdaf-8428fcc9af53",
                                                "sense_id": "92f8c7e8-f35b-3a51-bbab-d22aab5872f1",
                                                "text": "Mikrowellen werden häufig zur Wärmeerzeugung eingesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "860ed10b-6140-38bc-87e2-cb3aa3b02438",
                                        "entry_id": "5fae8a66-9d08-32d7-b848-48fc8ba08b45",
                                        "glosses": [
                                            "Kurzform für Mikrowellenherd"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fd34f86-08eb-4478-8606-cad17bf68935",
                                                "sense_id": "860ed10b-6140-38bc-87e2-cb3aa3b02438",
                                                "text": "Das Essen aus der Mikrowelle schmeckt mir nicht so richtig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5535f5e-c718-4366-a7dc-1bb38d29c434",
                        "source_entry_id": "e77471ca-0eb6-3efb-9fdc-93dee35b1424",
                        "source_sense_id": "9207c176-b7fe-3f7f-a599-f3e71b375441",
                        "target_lang_word": "microwave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microwave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                        "entry_id": "4a92e3cd-0992-3bf2-aba4-4c72ac0e35ba",
                                        "glosses": [
                                            "An electromagnetic wave with wavelength between that of infrared light and radio waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcb1fd4-9d4b-4366-bba8-10dadf0fa63d",
                                                "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                                "text": "Many radar systems use a combination of radio waves and microwaves."
                                            },
                                            {
                                                "example_id": "987f0202-bc57-4a98-9c78-19a9322fa3b9",
                                                "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                                "text": "Microwaves do not follow the curvature of the earth, but travel in a straight line. They must therefore have unobstructed \"line of sight\" and the dish aerials have to be sited on towers or high buildings, on high ground, or a combination of all three."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f5e0bc-d68d-312f-8300-7090555fe876",
                                        "entry_id": "4a92e3cd-0992-3bf2-aba4-4c72ac0e35ba",
                                        "glosses": [
                                            "Ellipsis of microwave oven."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db7154e-b2a9-4f7c-80e0-a3945d986653",
                                                "sense_id": "88f5e0bc-d68d-312f-8300-7090555fe876",
                                                "text": "Just put it in the microwave for 30 seconds and it's ready to eat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "microwave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "363d8b5f-8c02-3ea3-924c-1a804c3b717a",
                                        "entry_id": "b0c085f3-34d0-3b56-b9f9-9850bb2720e8",
                                        "glosses": [
                                            "To cook (something) in a microwave oven."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
