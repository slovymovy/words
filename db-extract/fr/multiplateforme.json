                                        "sense_id": "43068847-c1e3-39d4-9172-4a959074c96b",
                                        "entry_id": "24ef59b6-d8a3-31d6-823f-a7434cedad28",
                                        "glosses": [
                                            "That takes place between two trains in different platforms, usually across an island platform."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9aa20d57-82e5-49ac-aeb8-72c3324cdae1",
                                                "sense_id": "43068847-c1e3-39d4-9172-4a959074c96b",
                                                "text": "At Euston the cross-platform interchange between the Victoria Line and the Northern Line (City branch) will be unusual in that passengers will board trains travelling in the opposite direction to continue their journey. Normally, of course, in cross-platform interchange, trains depart in the same direction."
                                            }
                                        ]
                                    }
                                ]
