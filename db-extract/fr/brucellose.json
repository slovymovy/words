                ],
                "senses": [
                    {
                        "sense_id": "1e43cbdb-8732-3272-a33b-469227bc421e",
                        "entry_id": "6dc4256b-1b16-3600-bc3d-a2dec1d9eb33",
                        "glosses": [
                            "Anthropozoonose due à des coccobacilles du genre Brucella."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "a4380130-bfe0-4be2-a797-c3649918e277",
                                "sense_id": "1e43cbdb-8732-3272-a33b-469227bc421e",
                                "text": "On me reproche tout ce qui ne va pas dans le village : la brucellose des vaches, l’impétigo des nourrissons, l’impôt sécheresse et la poussée de la gauche aux dernières municipales !"
                            },
                            {
                                "example_id": "38e4eb97-d208-4038-82d6-24a19bb0c523",
                                "sense_id": "1e43cbdb-8732-3272-a33b-469227bc421e",
                                "text": "La brucellose, maladie provoquée par ces brucelles, est surtout caractérisée par des avortements dus à la multiplication des bactéries dans les enveloppes placentaires."
                            },
                            {
                                "example_id": "792f3c9c-1b06-4bb6-8c3f-e9c8e12b5440",
                                "sense_id": "1e43cbdb-8732-3272-a33b-469227bc421e",
                                "text": "La période est d’autant plus chargée que la campagne de prophylaxie bovine bat son plein, obligeant chaque éleveur à tester son troupeau pour s’assurer qu’il n’est pas porteur de brucellose, de tuberculose ou de diarrhée virale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe3f7624-f869-42a6-a741-798955a13b89",
                        "source_entry_id": "6dc4256b-1b16-3600-bc3d-a2dec1d9eb33",
                        "source_sense_id": "1e43cbdb-8732-3272-a33b-469227bc421e",
