                                "target_senses": [
                                    {
                                        "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The soft light in the sky seen before the rising and (especially) after the setting of the sun, occasioned by the illumination of the earth’s atmosphere by the direct rays of the sun and their reflection on the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139c654f-2701-43e8-b196-eb9ecdaefdf8",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "Near-synonym: half-light"
                                            },
                                            {
                                                "example_id": "9e841ad3-a0d3-4997-8e06-93b3e952020e",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "I could just make out her face in the twilight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when said light is visible; the period between daylight and darkness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8c779b-0bc2-4e22-8281-dc9676ab6da3",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "It was twilight by the time I got back home."
                                            },
                                            {
                                                "example_id": "e99ecff9-5aa3-43d4-b499-f5f9a4fb4378",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "Any faint light through which something is seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399a1ac8-1115-4635-bb06-df847497f4f0",
                                                "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                                "text": "Two women, Eusabio’s wife and sister, looked on from the deep twilight of the hut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7fea1b-4fb8-3ce8-bf7c-201dde43ab51",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
