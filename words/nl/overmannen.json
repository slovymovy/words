    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c83081d2-e1c8-3cc2-b1d0-6f725dadae37",
                    "sense_definition": "Met grote kracht de baas worden of overmeesteren, vaak gebruikt bij emoties of fysieke overmacht.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overweldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Andrea laat zich zelden <w>overmannen</w> door negatieve emoties.",
                            "target_lang_translations": {
                                "en": "Andrea rarely lets herself be <w>overwhelmed</w> by negative emotions."
                            }
                        },
                        {
                            "text": "De vermoeidheid begon hem na de lange reis volledig te <w>overmannen</w>.",
                            "target_lang_translations": {
                                "en": "Fatigue began to completely <w>overcome</w> him after the long journey."
                            }
                        }
                    ],
                    "synonyms": [
                        "overmeesteren",
                        "overweldigen"
                    ],
                    "common_phrases": [
                        "door emoties overmannen",
                        "door vermoeidheid overmannen"
                    ],
                    "target_lang_definitions": {
                        "en": "To overcome or overpower with great force, often used in the context of emotions or physical exhaustion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overwhelm",
                                "target_lang_sense_clarification": "by emotions or fatigue"
                            },
                            {
                                "target_lang_word": "overcome",
                                "target_lang_sense_clarification": "by feelings or physical state"
                            },
                            {
                                "target_lang_word": "overpower",
                                "target_lang_sense_clarification": "physically or emotionally"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf3fa474-8405-3ac3-a0d3-cf1f2453416d",
                    "sense_definition": "Fysiek of mentaal overmeesteren of overweldigen.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "overweldigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie wist de gewapende overvaller snel te <w>overmannen</w>.",
                            "target_lang_translations": {
                                "en": "The police managed to quickly <w>overpower</w> the armed robber."
                            }
                        },
                        {
                            "text": "Hij probeerde zijn tegenstander te <w>overmannen</w> tijdens het gevecht.",
                            "target_lang_translations": {
                                "en": "He tried to <w>subdue</w> his opponent during the fight."
                            }
                        }
                    ],
                    "synonyms": [
                        "overmeesteren",
                        "overweldigen"
                    ],
                    "common_phrases": [
                        "de dader overmannen"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically or mentally overpower, subdue, or overpower an opponent."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overpower",
                                "target_lang_sense_clarification": "subdue physically"
                            },
                            {
                                "target_lang_word": "subdue",
                                "target_lang_sense_clarification": "bring under control by force"
                            },
                            {
                                "target_lang_word": "overcome",
                                "target_lang_sense_clarification": "defeat an opponent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
