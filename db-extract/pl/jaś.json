                        "examples": [
                            {
                                "example_id": "f06d763a-d4b6-437c-9ccd-1eccbc5cf5f0",
                                "sense_id": "0d1b5467-4260-388e-ba67-fb8796d55fc3",
                                "text": "Daliśmy synkowi na imię Jaś, po moim dziadku Janku."
                            },
                            {
                                "example_id": "1898beda-6710-42fb-ae45-0df7e36a9342",
                                "sense_id": "0d1b5467-4260-388e-ba67-fb8796d55fc3",
                                "text": "Chciało się Zosi jagódek, / kupić ich za co nie miała, / Jaś ich miał pełen ogródek, / ale go prosić nie śmiała"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
