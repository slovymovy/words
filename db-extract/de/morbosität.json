                "senses": [
                    {
                        "sense_id": "2b2402a5-a60e-36b5-8b80-4f9174ee5525",
                        "entry_id": "5bb05841-3fb0-3ae0-907d-1b32f35e4ec2",
                        "glosses": [
                            "Eigenschaft, zu kränkeln, bei schlechter Gesundheit zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e76920f-0c63-4121-bcf5-a90a50ed1fd1",
                                "sense_id": "2b2402a5-a60e-36b5-8b80-4f9174ee5525",
                                "text": "„So wird die Morbosität des Fürsten K. von Mar'ja Moskaleva nur unter dem Aspekt der eigenen Bereicherung betrachtet. Da der alte Mann sehr vermögend ist, gilt es, ihn so schnell wie möglich zu verheiraten, um nach seinem Ableben an das Erbe zu kommen.“"
                            },
                            {
                                "example_id": "d99df3b6-3082-4860-bd67-32d3b752e07d",
                                "sense_id": "2b2402a5-a60e-36b5-8b80-4f9174ee5525",
                                "text": "„Zeit seines Lebens ist Claudius dem Anblick der Hinfälligkeit, der Morbosität des Seienden ausgesetzt, und zu beschönigen ist seine Sache nicht. Alle Kreatur ist in der Endlichkeit solidarisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
