                        "entry_id": "0f22c132-da76-349a-9fe0-d3112a47eea2",
                        "glosses": [
                            "Cendre de certaines plantes du milieu littoral à partir de laquelle on produisait la soude."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "118a0c28-aa60-30dd-b2ea-ef334d5fcccf",
                        "entry_id": "0f22c132-da76-349a-9fe0-d3112a47eea2",
                        "glosses": [
                            "Soude, carbonate de sodium."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a756d531-8020-4696-900e-4ee95b5407d0",
                                "sense_id": "118a0c28-aa60-30dd-b2ea-ef334d5fcccf",
                                "text": "Les savons sont généralement caustiques et renferment un excès d'alcali libre. On admet qu’ils agissent par leur alcali pour saponifier les corps gras […]"
                            },
                            {
                                "example_id": "22de9641-eabb-4ff2-affa-d63d9580e821",
                                "sense_id": "118a0c28-aa60-30dd-b2ea-ef334d5fcccf",
                                "text": "Le savon de toilette ne doit pas contenir d’alcali libre […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "8b0d6522-1314-3850-995e-d55bd4a8a925",
                        "entry_id": "0f22c132-da76-349a-9fe0-d3112a47eea2",
                        "glosses": [
                            "Ammoniaque."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b40ed5-bab4-4af7-b3d3-a365544f4bfb",
                                "sense_id": "8b0d6522-1314-3850-995e-d55bd4a8a925",
                                "text": "Je l’ai employée avec beaucoup de succès dans le traitement d’une mine de cobalt arsénicale; j’en ai séparé tout le cobalt et l’arsénic, et en ne traitant que par l’acide nitrique et les alcalis, la majeure partie de ces deux métaux restant unis ensemble à l’état d’arséniate."
                            }
                        ]
                    }
