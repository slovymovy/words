                "senses": [
                    {
                        "sense_id": "b02557f8-f26b-3126-8cc6-d2c05bf0ef39",
                        "entry_id": "c3038905-20d2-376a-b3db-648a9eda5e10",
                        "glosses": [
                            "Soulagement ou plaisir ressenti face à une sensation d'augmentation de quantité d'air."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d0248e4a-4406-362b-a5af-b2a828c301f4",
                        "entry_id": "c3038905-20d2-376a-b3db-648a9eda5e10",
                        "glosses": [
                            "Plaisir ressenti lors d'un saut en parachute grâce à la résistance de l'air."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e9e3fd4e-d2d0-4013-85e8-c56873d7e6f6",
                                "sense_id": "d0248e4a-4406-362b-a5af-b2a828c301f4",
                                "text": "« Le dernier saut a été phénoménal, analyse Johan Van Eeckhout, l’un des cinq coachs, du club de Lille-Bondues. On n’était pas sûr de pouvoir sauter (à cause des nuages), et on l’a juste fait. Il y a eu ce silence qui règne quand tout fonctionne, c’est magique. » Un véritable « airgasme », comme il l’a lancé au micro."
                            }
                        ]
                    },
                    {
                        "sense_id": "d4575f7e-88eb-3942-a63e-59797ab59457",
                        "entry_id": "c3038905-20d2-376a-b3db-648a9eda5e10",
                        "glosses": [
                            "Acte de sauter nu en parachute, à deux, pour pratiquer le coït et possiblement pour atteindre l'orgasme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cf447cc-0eaa-48fb-b567-754016e30ed9",
                                "sense_id": "d4575f7e-88eb-3942-a63e-59797ab59457",
                                "text": "La preuve en est avec ce couple qui a décidé de s’envoyer en l’air (c’est le cas de le dire) lors d’un saut en parachute ! Du coup, ils n’appellent plus l’orgasme ainsi mais airgasme."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce52217b-6c6c-3a32-96ac-30f69aa989c1",
                        "entry_id": "c3038905-20d2-376a-b3db-648a9eda5e10",
                        "glosses": [
                            "État procuré par l'air ressenti après le retrait d'un masque."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6b216c0f-b710-4e55-9da5-459273bb2667",
                                "sense_id": "ce52217b-6c6c-3a32-96ac-30f69aa989c1",
                                "text": "Quand tu sors du magasin et que tu as un airgasme."
                            }
                        ]
                    }
                ],
                "translations": [
