                                    {
                                        "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                        "entry_id": "e7b24127-4be3-3ca2-a730-07299b4e1f52",
                                        "glosses": [
                                            "Très grand pays d’Asie, bordé par la Chine, le Népal et le Bhoutan au nord, la Birmanie et le Bangladesh à l’est, la golfe du Bengale et la mer d’Oman au sud, et le Pakistan à l’ouest, et dont la capitale est New Delhi (la Nouvelle-Delhi)."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96989f86-6872-4898-9a97-0370f031e9c9",
                                                "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                                "text": "D’après les calculs approximatifs du célèbre major Rennel, qui ont servi de base aux évaluations faites plus tard par le savant Graberg et par Bertuch, la population de l’Inde serait au-dessous de 95 millions, tandis qu’elle s’éleverait au-dessus de 100 millions d’après ceux de Canning, à 110 d’après l’évaluation de Orme et même à 120 millions d’après un calcul moyen fait par M. Lindner."
                                            },
                                            {
                                                "example_id": "e74a1efb-5159-4a1f-b1e5-313aa7579a90",
                                                "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                                "text": "De l’autre côté de l’Arabie, il y a encore des terres conquises à l’Islam, puis des régions habitées par des idolâtres, l’Inde et la Chine, qui atteignent le limbe oriental du disque terrestre."
                                            },
                                            {
                                                "example_id": "18e01438-ce14-48f9-92ab-5d112d1f0279",
                                                "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                                "text": "« Un autre livre paraîtra en 2023, il aura pour cadre le Brésil, l’Inde ou la France », dévoile la Saintongeaise."
                                            },
                                            {
                                                "example_id": "60ac09d0-da1a-42a5-adaf-acf3c11a078a",
                                                "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                                "text": "Les cultures dans les pays de population dense comme l’Inde ou les deltas indo-chinois occupent des surfaces considérables."
                                            },
                                            {
                                                "example_id": "3347f8f0-8b82-4d5b-9df7-a4277306b64b",
                                                "sense_id": "a598672d-79af-3bc3-935e-9fb000c2ef2c",
                                                "text": "Avant que le califat omeyyade de Damas n’eût cédé la place aux Abbassides de Bagdad, en 750, les conquêtes arabes avaient unifié politiquement une grande partie du monde, de l’Espagne à l’Inde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d78be081-fb3b-41fc-b0e5-e929a6c48190",
                        "source_entry_id": "4b49d5c6-8a9e-334d-a5ff-bd3c6b78e1e3",
                        "source_sense_description": "the country",
                        "target_lang_word": "Indien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                        "entry_id": "37e7b8d9-d6a4-3188-accd-0790eb079de3",
                                        "glosses": [
                                            "Staat in Südasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7646356a-0fbf-48d3-b9a5-c191b669fb8e",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "„Indien ist ein multiethnischer Staat und mit 1,2 Milliarden Einwohnern (2009) das zweitbevölkerungsreichste Land und der bevölkerungsreichste demokratische Staat der Erde.“"
                                            },
                                            {
                                                "example_id": "179519fb-5c72-4d1c-8134-9cf7111d4c03",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "„Natürlich gehört Indien zu Asien.“"
                                            },
                                            {
                                                "example_id": "b235a927-f10c-44c4-b6da-c3eda6700445",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "Neu-Delhi ist die Hauptstadt von Indien."
                                            },
                                            {
                                                "example_id": "c8fa829d-f7d9-47c9-8496-5cfbcddfc508",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "Ich habe meinem Vater einen Bildband über das Indien von heute geschenkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11130d12-d57a-46e4-80c0-3913fabb4470",
                        "source_entry_id": "4b49d5c6-8a9e-334d-a5ff-bd3c6b78e1e3",
