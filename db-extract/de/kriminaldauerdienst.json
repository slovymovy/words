                "senses": [
                    {
                        "sense_id": "11d6055c-e79b-3f60-a7c5-6b5fc472751e",
                        "entry_id": "8d668919-c9cd-30a4-b369-3f442ee19c44",
                        "glosses": [
                            "Dienst der Kriminalpolizei, der zu jeder Uhrzeit zur Verfügung steht"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "8637c3d6-9e2e-45b0-888a-271b53d7e707",
                                "sense_id": "11d6055c-e79b-3f60-a7c5-6b5fc472751e",
                                "text": "„Weil sich der Stoff jedoch auch zur Herstellung von Bomben eignet, benachrichtigte eine Mitarbeiterin des Baumarkts am späten Abend noch den Kriminaldauerdienst der Polizei.“"
                            },
                            {
                                "example_id": "747ca327-4354-4ad9-9f55-e27b6db523cc",
                                "sense_id": "11d6055c-e79b-3f60-a7c5-6b5fc472751e",
                                "text": "„Und so kommt es, dass der Münchner Kriminaldauerdienst, den sie hier alle nur KDD nennen, einiges zu tun hat: 960 Leichen mussten Mitarbeiter des Kommissariats im vergangenen Jahr untersuchen, dazu 235 Sexualstraftaten.“"
                            },
                            {
                                "example_id": "d601d441-1397-4154-98b4-6acfbde4deed",
                                "sense_id": "11d6055c-e79b-3f60-a7c5-6b5fc472751e",
                                "text": "„Warum der Beamte allein im Wachraum war, obwohl einschliesslich Streifenbeamten und Kriminaldauerdienst üblicherweise zwölf Beamte Nachtschicht machten, sei noch zu klären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
