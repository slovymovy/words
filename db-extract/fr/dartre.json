                                        "sense_id": "4e045e55-6d51-3580-af48-e1e528d38a23",
                                        "entry_id": "3cbd72a8-76a0-39e7-bfbd-1dd2322aaa77",
                                        "glosses": [
                                            "Causing pain or discomfort; painfully sensitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4206dcb1-42e3-4642-a9f2-449f837414ac",
                                                "sense_id": "4e045e55-6d51-3580-af48-e1e528d38a23",
                                                "text": "Her feet were sore from walking so far."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d3dc16-89eb-3620-8089-e8103e1dfb03",
                                        "entry_id": "3cbd72a8-76a0-39e7-bfbd-1dd2322aaa77",
                                        "glosses": [
                                            "Sensitive; tender; easily pained, grieved, or vexed; very susceptible of irritation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c70fec1-ce03-48ee-a9b6-7aac59782dda",
                                                "sense_id": "38d3dc16-89eb-3620-8089-e8103e1dfb03",
                                                "text": "Malice and hatred are very fretting and vexatious, and apt to make our minds sore and uneasy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ef616cc-ce18-345e-a8da-871ee16935d5",
                                        "entry_id": "3cbd72a8-76a0-39e7-bfbd-1dd2322aaa77",
                                        "glosses": [
                                            "Dire; distressing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7f8f46-8d04-41a0-81fd-0f664a9eeb76",
                                                "sense_id": "9ef616cc-ce18-345e-a8da-871ee16935d5",
                                                "text": "The school was in sore need of textbooks, theirs having been ruined in the flood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0144f9-d6bd-34e3-8ac8-7f78855c1eeb",
                                        "entry_id": "3cbd72a8-76a0-39e7-bfbd-1dd2322aaa77",
                                        "glosses": [
                                            "Feeling animosity towards someone; annoyed or angered."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3054092c-60a9-4441-9f20-3b3901042f40",
                                                "sense_id": "ba0144f9-d6bd-34e3-8ac8-7f78855c1eeb",
                                                "text": "Joe was sore at Bob for beating him at checkers."
                                            },
                                            {
                                                "example_id": "be9ff537-35f5-4cfa-98eb-383c0cf06404",
                                                "sense_id": "ba0144f9-d6bd-34e3-8ac8-7f78855c1eeb",
                                                "text": "“God damn it.” He was sore as hell. He was really furious."
                                            },
                                            {
                                                "example_id": "dcfe22be-ba4f-4471-976a-1ec7cf7e889c",
                                                "sense_id": "ba0144f9-d6bd-34e3-8ac8-7f78855c1eeb",
                                                "text": "TfN is clearly very sore about last year's axing of part of HS2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802ac244-38f1-3673-a476-1ab842a25c21",
                                        "entry_id": "3cbd72a8-76a0-39e7-bfbd-1dd2322aaa77",
                                        "glosses": [
                                            "Criminal; wrong; evil."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75e97d4e-bf81-4252-a595-069dc3f37d49",
                                                "sense_id": "802ac244-38f1-3673-a476-1ab842a25c21",
                                                "text": "[…]and your water is a sore decayer of your whoreson dead body."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sore",
