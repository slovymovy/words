                                    {
                                        "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                        "entry_id": "80662de8-e72c-3b1b-aa3c-e59343c4a3fa",
                                        "glosses": [
                                            "Alternative form of bagle."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cecac24-076e-4e11-a728-10ad798841b3",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "“He’s so adorable, Aaron. Part beagle, part basset hound.” “A bagel. Very appropriate.”"
                                            },
                                            {
                                                "example_id": "574c0ae7-c5f8-45a4-8abf-9668756e235c",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "In October, Allan and Rebecca began to care for Marty’s dog Phil more often and adopted the “bagel” (basset and beagle mix breed) when the time came."
                                            },
                                            {
                                                "example_id": "f4115e4a-9fe6-4328-8c3d-aed7e84b1f21",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "The Bagel isn’t necessarily a popular dog, but they seem to appear often enough to be worth mentioning."
                                            },
                                            {
                                                "example_id": "c225a867-a0f7-44b9-8c85-2c13a96c0e3e",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "The Bagel is a cross between the Beagle and the Basset Hound. Though not as popular as some of the more well-established mixes, the short-coated Bagel has the loving personality one would expect from two Hounds, plus the potential for some stubbornness."
                                            },
                                            {
                                                "example_id": "7772217c-1b2c-4454-9501-1b7b01b70ede",
                                                "sense_id": "fe4c18e4-652a-349c-bb08-5c55304a3a9c",
                                                "text": "Linus was half basset and half beagle hound, thus a bagel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
