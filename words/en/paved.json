{
    "word_family": [
        "pave",
        "pavement",
        "paver",
        "paving"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0bd33c5f-8466-31fe-afb6-6afbadf70fa8",
                    "sense_definition": "Covered in pavement; having a hard surface, as of concrete or asphalt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "surface_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city decided to replace the old dirt road with a newly <w>paved</w> street.",
                            "target_lang_translations": {
                                "ru": "Городские власти решили заменить старую грунтовую дорогу новоиспеченной <w>асфальтированной</w> улицей."
                            }
                        },
                        {
                            "text": "We rode our bicycles along the <w>paved</w> path through the park.",
                            "target_lang_translations": {
                                "ru": "Мы катались на велосипедах по <w>вымощенной</w> дорожке через парк."
                            }
                        }
                    ],
                    "synonyms": [
                        "paven"
                    ],
                    "antonyms": [
                        "unpaved"
                    ],
                    "common_phrases": [
                        "paved road",
                        "paved path",
                        "paved street"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрытый мощением; имеющий твердое покрытие, например, из бетона или асфальта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощеный",
                                "target_lang_sense_clarification": "о дороге, улице, покрытой камнем или брусчаткой"
                            },
                            {
                                "target_lang_word": "асфальтированный",
                                "target_lang_sense_clarification": "о дороге, покрытой асфальтом"
                            },
                            {
                                "target_lang_word": "вымощенный",
                                "target_lang_sense_clarification": "покрытый твердым материалом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35259be5-3845-3c75-aa11-5bf95d326b53",
                    "sense_definition": "Laid out or made, as intentions, desires, plans, etc.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The road to Hell is <w>paved</w> with good intentions.",
                            "target_lang_translations": {
                                "ru": "Дорога в ад <w>вымощена</w> благими намерениями."
                            }
                        },
                        {
                            "text": "His career was <w>paved</w> with many successful projects and strong connections.",
                            "target_lang_translations": {
                                "ru": "Его карьерный путь был <w>усыпан</w> множеством успешных проектов и прочными связями."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paved with good intentions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выложенный или подготовленный (в переносном смысле о намерениях, планах, пути и т. д.)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымощен",
                                "target_lang_sense_clarification": "в переносном смысле, например, о дороге благими намерениями"
                            },
                            {
                                "target_lang_word": "усыпан",
                                "target_lang_sense_clarification": "в переносном смысле, о жизненном или карьерном пути"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d5bb75c0-1226-3742-b259-4781aedf5030",
                    "sense_definition": "simple past and past participle of <w>pave</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers <w>paved</w> the entire driveway in just one afternoon.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>замостили</w> весь подъездной путь всего за один день."
                            }
                        },
                        {
                            "text": "They have <w>paved</w> the way for future generations of scientists.",
                            "target_lang_translations": {
                                "ru": "Они <w>проложили</w> путь для будущих поколений ученых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "paved the way"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола pave (мостить, асфальтировать, прокладывать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замостили",
                                "target_lang_sense_clarification": "прошедшее время от замостить"
                            },
                            {
                                "target_lang_word": "вымостили",
                                "target_lang_sense_clarification": "прошедшее время от вымостить"
                            },
                            {
                                "target_lang_word": "проложили",
                                "target_lang_sense_clarification": "в контексте прокладывания пути (paved the way)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}