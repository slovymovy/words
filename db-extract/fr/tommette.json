                        "glosses": [
                            "Nom, dans le sud-est de la France, donné aux briques servant au carrelage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26e1651f-0e47-4cb7-bb06-50d6627abb57",
                                "sense_id": "ca3797bf-e127-3546-b84f-16ef9ac52278",
                                "text": "J’ai fait carreler la pièce avec des tommettes rouges."
                            },
                            {
                                "example_id": "24ae8349-cb44-40e2-80ec-e4da63a8c5ac",
                                "sense_id": "ca3797bf-e127-3546-b84f-16ef9ac52278",
                                "text": "Un épais rideau de velours noir masquait une verrière inclinée qui occupait le mur du fond d’une haute pièce dont les tommettes du sol étaient recouvertes de plusieurs tapis persans."
                            },
                            {
                                "example_id": "cfe95876-89cc-4666-9445-c6e61c18336a",
                                "sense_id": "ca3797bf-e127-3546-b84f-16ef9ac52278",
                                "text": "Il y a des tommettes rouges sur le sol et sur les murs un papier peint représentant divers arbustes."
                            }
                        ]
                    }
                ],
