{
    "word_family": [
        "méchamment",
        "méchanceté"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "381e41d0-954d-3ce1-a2fc-62be69f30708",
                    "sense_definition": "Qui manifeste de la malveillance, de la cruauté ou l'intention de faire souffrir autrui.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas prêter attention à ses remarques, il n'est pas vraiment <w>méchant</w>."
                        },
                        {
                            "text": "Prenez garde en entrant dans cette cour, car il y a un chien <w>méchant</w>."
                        }
                    ],
                    "antonyms": [
                        "gentil",
                        "bon"
                    ],
                    "common_phrases": [
                        "chien méchant",
                        "grand méchant loup"
                    ]
                },
                {
                    "sense_id": "a0d65a57-2676-30a3-b285-2775b26dbbd6",
                    "sense_definition": "Qui présente de la gravité ou un danger réel, particulièrement dans des tournures négatives.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gravite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin m'a rassuré en disant que cette petite blessure n'était pas bien <w>méchante</w>."
                        },
                        {
                            "text": "Ne vous inquiétez pas pour cette panne de voiture, ce n'est rien de <w>méchant</w>."
                        }
                    ],
                    "common_phrases": [
                        "pas bien méchant"
                    ]
                },
                {
                    "sense_id": "00910ed1-6ff7-3092-bb24-eb4297585134",
                    "sense_definition": "Qui est de médiocre ou de mauvaise qualité, sans valeur appréciable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "qualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont passé la nuit dans un <w>méchant</w> hôtel près de la gare ferroviaire."
                        },
                        {
                            "text": "L'écrivain débutant travaillait sur une <w>méchante</w> table en bois dans sa petite chambre."
                        }
                    ],
                    "synonyms": [
                        "mauvais"
                    ],
                    "antonyms": [
                        "bon"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b8dfbf23-34a5-39d1-9f63-0bf32be416d0",
                    "sense_definition": "Personnage malfaisant ou hostile opposé au héros dans une œuvre de fiction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "fiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce dessin animé, le <w>méchant</w> cherche constamment à détruire la ville."
                        },
                        {
                            "text": "L'acteur a déclaré qu'il adorait incarner les <w>méchants</w> dans les films d'aventure."
                        }
                    ],
                    "antonyms": [
                        "gentil"
                    ],
                    "common_phrases": [
                        "le rôle du méchant"
                    ]
                },
                {
                    "sense_id": "3d6907e1-796b-3b87-96da-16c12d40a521",
                    "sense_definition": "Personne qui agit avec méchanceté ou cruauté.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans les fables traditionnelles, la punition finit toujours par frapper les <w>méchants</w>."
                        },
                        {
                            "text": "Elle refuse de croire que son voisin soit un <w>méchant</w> capable de telles cruautés."
                        }
                    ],
                    "antonyms": [
                        "gentil"
                    ]
                }
            ]
        }
    ]
}