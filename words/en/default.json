{
    "word_family": [
        "defaulter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "30e611b1-e942-3d8e-9a76-0822d969ebf9",
                    "sense_definition": "A standard setting or value automatically used by a computer program or device when no other option is chosen by the user.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not select a specific font, the system will use the <w>default</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы не выберете конкретный шрифт, система будет использовать <w>значение по умолчанию</w>.",
                                "zh": "如果你不选择特定的字体，系统将使用<w>默认值</w>。"
                            }
                        },
                        {
                            "text": "You can easily restore the factory <w>defaults</w> in the settings menu if something goes wrong.",
                            "target_lang_translations": {
                                "ru": "Вы можете легко восстановить <w>заводские настройки</w> в меню, если что-то пойдет не так.",
                                "zh": "如果出现问题，你可以在设置菜单中轻松恢复<w>出厂设置</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "factory default",
                        "default setting",
                        "by default"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартная настройка или значение, автоматически используемое компьютерной программой или устройством, если пользователь не выбрал иное.",
                        "zh": "计算机程序或设备在用户未做选择时自动使用的标准设置或数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "значение по умолчанию",
                                "target_lang_sense_clarification": "параметр"
                            },
                            {
                                "target_lang_word": "настройка по умолчанию",
                                "target_lang_sense_clarification": "конфигурация"
                            },
                            {
                                "target_lang_word": "по умолчанию",
                                "target_lang_sense_clarification": "как стандарт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "默认值",
                                "target_lang_sense_clarification": "参数"
                            },
                            {
                                "target_lang_word": "默认设置",
                                "target_lang_sense_clarification": "配置"
                            },
                            {
                                "target_lang_word": "默认",
                                "target_lang_sense_clarification": "作为标准"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                    "sense_definition": "A choice, situation, or course of action that happens automatically because no alternative has been specified.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "general_absence_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She became the team captain by <w>default</w> because no one else wanted the job.",
                            "target_lang_translations": {
                                "ru": "Она стала капитаном команды <w>по умолчанию</w>, потому что никто другой не хотел эту должность.",
                                "zh": "因为没人想当队长，她<w>默认</w>成为了队长。"
                            }
                        },
                        {
                            "text": "Silence became his <w>default</w> response whenever he was asked a difficult question.",
                            "target_lang_translations": {
                                "ru": "Молчание стало его реакцией <w>по умолчанию</w> всякий раз, когда ему задавали сложный вопрос.",
                                "zh": "每当被问到难题时，沉默就成了他<w>默认</w>的反应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "by default"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбор, ситуация или порядок действий, происходящие автоматически, так как не была указана альтернатива.",
                        "zh": "因没有指定其他选择而自动发生的行为、情况或结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по умолчанию",
                                "target_lang_sense_clarification": "автоматически"
                            },
                            {
                                "target_lang_word": "автоматический выбор",
                                "target_lang_sense_clarification": "отсутствие альтернативы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "默认",
                                "target_lang_sense_clarification": "自动地"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                    "sense_definition": "A failure to fulfill an obligation, especially a financial one such as repaying a loan.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "financial_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is in <w>default</w> on its loan payments and faces legal action.",
                            "target_lang_translations": {
                                "ru": "Компания находится в состоянии <w>дефолта</w> по выплатам кредита и сталкивается с судебным иском.",
                                "zh": "该公司在贷款偿还上<w>违约</w>，正面临法律诉讼。"
                            }
                        },
                        {
                            "text": "If the borrower goes into <w>default</w>, the bank may seize the property.",
                            "target_lang_translations": {
                                "ru": "Если заемщик допустит <w>дефолт</w>, банк может конфисковать имущество.",
                                "zh": "如果借款人<w>违约</w>，银行可能会没收其财产。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in default",
                        "loan default",
                        "credit default"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невыполнение обязательств, особенно финансовых, таких как погашение кредита.",
                        "zh": "未能履行义务，尤指未能偿还贷款等财务义务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дефолт",
                                "target_lang_sense_clarification": "финансовый"
                            },
                            {
                                "target_lang_word": "невыполнение обязательств",
                                "target_lang_sense_clarification": "юридический"
                            },
                            {
                                "target_lang_word": "неплатёж",
                                "target_lang_sense_clarification": "отсутствие оплаты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "违约",
                                "target_lang_sense_clarification": "法律或财务"
                            },
                            {
                                "target_lang_word": "拖欠",
                                "target_lang_sense_clarification": "未按时付款"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91d9936f-1679-32ba-9251-ffbab135ef86",
                    "sense_definition": "A loss in a match or competition caused by a failure to participate or follow the rules.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player won the match by <w>default</w> when his opponent failed to appear.",
                            "target_lang_translations": {
                                "ru": "Теннисист выиграл матч ввиду <w>неявки</w> соперника.",
                                "zh": "由于对手未到场，这位网球选手<w>不战而</w>胜。"
                            }
                        },
                        {
                            "text": "The team suffered a <w>default</w> after arriving too late for the game.",
                            "target_lang_translations": {
                                "ru": "Команде было засчитано <w>техническое поражение</w> после опоздания на игру.",
                                "zh": "该队因迟到被<w>判负</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forfeit"
                    ],
                    "common_phrases": [
                        "win by default"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поражение в матче или соревновании, вызванное неявкой или нарушением правил.",
                        "zh": "因未参赛或违反规则而导致的比赛失利。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техническое поражение",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "неявка",
                                "target_lang_sense_clarification": "отсутствие участника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "判负",
                                "target_lang_sense_clarification": "体育"
                            },
                            {
                                "target_lang_word": "弃权",
                                "target_lang_sense_clarification": "未参赛"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05038a12-f88a-39cb-8755-e40c06888788",
                    "sense_definition": "To automatically return to or select a standard option or value when no specific choice is made.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software <w>defaults</w> to the standard view unless you change the preferences.",
                            "target_lang_translations": {
                                "ru": "Программа <w>выбирает по умолчанию</w> стандартный вид, если вы не измените настройки.",
                                "zh": "除非你更改偏好设置，否则该软件会<w>默认</w>显示标准视图。"
                            }
                        },
                        {
                            "text": "If you do not specify a color, the program <w>defaults</w> to black.",
                            "target_lang_translations": {
                                "ru": "Если вы не укажете цвет, программа <w>использует по умолчанию</w> черный.",
                                "zh": "如果你不指定颜色，程序会<w>默认</w>使用黑色。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "default to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоматически возвращаться к стандартному варианту или выбирать его, когда не сделан конкретный выбор.",
                        "zh": "在未做具体选择时，自动返回或采用标准选项或数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбирать по умолчанию",
                                "target_lang_sense_clarification": "программное обеспечение"
                            },
                            {
                                "target_lang_word": "использовать по умолчанию",
                                "target_lang_sense_clarification": "настройки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "默认",
                                "target_lang_sense_clarification": "自动选择"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e4d6f1e-d4c9-390c-a773-e933cc2bb468",
                    "sense_definition": "To fail to pay a debt or fulfill a legal obligation.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "financial_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you <w>default</w> on your mortgage, you risk losing your home.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>нарушите обязательства</w> по ипотеке, вы рискуете потерять свой дом.",
                                "zh": "如果你在抵押贷款上<w>违约</w>，你就有失去房子的风险。"
                            }
                        },
                        {
                            "text": "The country threatened to <w>default</w> on its international debts during the crisis.",
                            "target_lang_translations": {
                                "ru": "Страна угрожала <w>объявить дефолт</w> по своим международным долгам во время кризиса.",
                                "zh": "该国在危机期间威胁要对其国际债务<w>违约</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "default on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не суметь выплатить долг или выполнить юридическое обязательство.",
                        "zh": "未能偿还债务或履行法律义务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявить дефолт",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "нарушить обязательства",
                                "target_lang_sense_clarification": "договор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "违约",
                                "target_lang_sense_clarification": "合同"
                            },
                            {
                                "target_lang_word": "拖欠",
                                "target_lang_sense_clarification": "债务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f05c08-783f-3b00-aa57-3337617d98a0",
                    "sense_definition": "To lose a game or competition by failing to appear or participate.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had to <w>default</w> the match due to a sudden injury during the warm-up.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>сдать</w> матч из-за внезапной травмы во время разминки.",
                                "zh": "由于热身时突然受伤，他不得不<w>弃权</w>比赛。"
                            }
                        },
                        {
                            "text": "If you refuse to wear the proper uniform, you will be forced to <w>default</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы откажетесь надеть надлежащую форму, вы будете вынуждены <w>получить техническое поражение</w>.",
                                "zh": "如果你拒绝穿戴合适的制服，你将被迫<w>弃权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "forfeit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проиграть игру или соревнование из-за неявки или отказа от участия.",
                        "zh": "因未出席或未参赛而输掉比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получить техническое поражение",
                                "target_lang_sense_clarification": "спорт"
                            },
                            {
                                "target_lang_word": "сдать матч",
                                "target_lang_sense_clarification": "отказ от игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弃权",
                                "target_lang_sense_clarification": "放弃比赛"
                            },
                            {
                                "target_lang_word": "被判负",
                                "target_lang_sense_clarification": "体育"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}