    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b58af887-43f5-33e4-b4ce-77589c9c5570",
                    "sense_definition": "Great delight, joy, or satisfaction, especially from one's own good fortune or from another's misfortune.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "joy_and_delight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rubbed her hands with <w>glee</w> when she heard that her rival's project had failed.",
                            "target_lang_translations": {
                                "ru": "Она потерла руки от <w>злорадства</w>, когда услышала, что проект её соперника провалился."
                            }
                        },
                        {
                            "text": "The children opened their holiday presents with pure <w>glee</w>.",
                            "target_lang_translations": {
                                "ru": "Дети открывали свои праздничные подарки с чистой <w>радостью</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "delight",
                        "elation",
                        "gladness",
                        "happiness",
                        "joy",
                        "merriment",
                        "mirth"
                    ],
                    "antonyms": [
                        "gloom",
                        "misery",
                        "sadness",
                        "sorrow"
                    ],
                    "common_phrases": [
                        "with glee",
                        "pure glee",
                        "shriek of glee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое удовольствие, радость или удовлетворение, особенно от собственного везения или от чужого несчастья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ликование",
