                                                "sense_id": "c446a1bd-4c03-3874-ab4a-79afe7248bed",
                                                "text": "„Die Einwohner Grenadas stammen zu über 95 % ganz oder teilweise von Afrikanern ab, die von den europäischen Kolonialisten zur Sklavenarbeit auf die Insel gebracht wurden.“"
                                            },
                                            {
                                                "example_id": "8ea59c2d-39eb-4eb5-82cb-0b62a28c5b3e",
                                                "sense_id": "c446a1bd-4c03-3874-ab4a-79afe7248bed",
                                                "text": "Grenada wurde in den letzten Jahren zweimal von einem Hurrikan getroffen."
                                            },
                                            {
                                                "example_id": "525bc03a-386d-48bc-bd54-ca3d07c8b8ea",
                                                "sense_id": "c446a1bd-4c03-3874-ab4a-79afe7248bed",
                                                "text": "St. George’s ist die Hauptstadt von Grenada."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
