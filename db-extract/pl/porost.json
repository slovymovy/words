                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45a75a2c-464f-4ba4-8c90-7d66aff289da",
                                "sense_id": "e179efd9-fce9-325e-9f22-405a2138d45a",
                                "text": "Uważam, że żadna maść na porost włosów nie jest naprawdę skuteczna."
