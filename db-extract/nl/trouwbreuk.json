                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80d4e19b-ecd1-3693-b253-51424296ba28",
                                        "entry_id": "cb839db5-8144-334e-b191-507cfdd2a7ae",
                                        "glosses": [
                                            "Injury; degradation; ruin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
