                        "sense_id": "690f70ed-be82-37ee-8599-151a411d5228",
                        "entry_id": "0d57973f-8908-3d62-8fef-bcbef552ddd9",
                        "glosses": [
                            "zaak in zoverre die voor vermeerdering en vermindering vatbaar is, iets meetbaars en/of kwantificeerbaars"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548bb240-c079-4bf1-8c92-9d41ce35425f",
                                "sense_id": "690f70ed-be82-37ee-8599-151a411d5228",
                                "text": "Ingeborgs vader, baron Von Freital, geloofde niet in de liefde, maar des te meer in geld en afkomst, en vooral in de gunstige combinatie van die grootheden."
                            }
                        ]
                    },
                    {
                        "sense_id": "be32e37a-5588-3fad-b71a-530b5e0c48ea",
                        "entry_id": "0d57973f-8908-3d62-8fef-bcbef552ddd9",
                        "glosses": [
                            "iemand met veel maatschappelijk aanzien"
                        ],
                        "tags": [
                            "maatschappij"
                        ],
                        "examples": [
                            {
                                "example_id": "95848b20-8a1e-4a60-8e3b-2c31b8fb65dc",
                                "sense_id": "be32e37a-5588-3fad-b71a-530b5e0c48ea",
                                "text": "Hij noemt Boer \"een grootheid van wie ik het meest heb kunnen leren\". Van de Laar: \"Zijn belangrijkste kenmerk was zijn liefde voor natuur. Daar haalde hij energie en voldoening uit en dat liet hij terugzien op het bord.\""
                            }
                        ]
                    }
                ],
