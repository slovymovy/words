{
    "word_family": [
        "démenti"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a02d07ea-18bf-33c4-b8dc-056e391e600e",
                    "sense_definition": "Déclarer faux ou inexact un fait, une nouvelle ou une rumeur.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le porte-parole du gouvernement a immédiatement tenu à <w>démentir</w> cette rumeur infondée."
                        },
                        {
                            "text": "L'entreprise a publié un communiqué officiel pour <w>démentir</w> les accusations de fraude financière."
                        }
                    ],
                    "synonyms": [
                        "nier",
                        "réfuter",
                        "infirmer",
                        "contester"
                    ],
                    "common_phrases": [
                        "démentir une rumeur",
                        "démentir formellement",
                        "démentir une information"
                    ]
                },
                {
                    "sense_id": "747b4363-a316-3055-b277-3e9e7a527231",
                    "sense_definition": "Contredire une personne en affirmant qu'elle ne dit pas la vérité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne n'a osé le <w>démentir</w> lorsqu'il a présenté sa version des faits à la réunion."
                        },
                        {
                            "text": "Si le ministre affirme cela publiquement, plusieurs témoins vont certainement le <w>démentir</w>."
                        }
                    ],
                    "synonyms": [
                        "contredire"
                    ]
                },
                {
                    "sense_id": "b81809d9-9f84-32c0-8b60-2db1703005aa",
                    "sense_definition": "Être en contradiction avec des prévisions, des apparences ou des attentes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contradiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les résultats économiques exceptionnels sont venus <w>démentir</w> les prévisions les plus pessimistes des analystes."
                        },
                        {
                            "text": "Son comportement calme et mesuré semblait <w>démentir</w> sa réputation d'homme impulsif."
                        }
                    ],
                    "synonyms": [
                        "contredire",
                        "infirmer"
                    ],
                    "common_phrases": [
                        "démentir les prévisions",
                        "démentir les pronostics"
                    ]
                },
                {
                    "sense_id": "0ed35f04-6c1c-3685-8603-14914e325dac",
                    "sense_definition": "Diminuer, faiblir ou cesser, employé surtout à la forme négative pour exprimer la constance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "continuite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le succès populaire de cette exposition artistique ne s'est pas <w>démenti</w> depuis son ouverture."
                        },
                        {
                            "text": "L'engouement des jeunes pour ce festival de musique ne semble jamais se <w>démentir</w>."
                        }
                    ],
                    "common_phrases": [
                        "ne pas se démentir"
                    ]
                }
            ]
        }
    ]
}