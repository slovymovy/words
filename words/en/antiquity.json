{
    "word_family": [
        "antique",
        "antiquarian",
        "antiquated",
        "antiquary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "796e04b4-2103-3fbb-8aaa-25c09cbdd43c",
                    "sense_definition": "The ancient past, especially the period before the Middle Ages",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_periods",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many great philosophers and orators lived during the era of <w>antiquity</w>.",
                            "target_lang_translations": {
                                "ru": "Многие великие философы и ораторы жили в эпоху <w>древности</w>."
                            }
                        },
                        {
                            "text": "The legends of these heroes have been passed down from <w>antiquity</w> to the present day.",
                            "target_lang_translations": {
                                "ru": "Легенды об этих героях передавались из <w>древности</w> до наших дней."
                            }
                        }
                    ],
                    "antonyms": [
                        "modernity"
                    ],
                    "common_phrases": [
                        "from antiquity",
                        "since antiquity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древнее прошлое, особенно период до Средневековья"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "далекое прошлое"
                            },
                            {
                                "target_lang_word": "старина",
                                "target_lang_sense_clarification": "давние времена"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3896cd0-4d07-3e58-a204-8c25c5c06576",
                    "sense_definition": "An object, building, or work of art from the ancient past",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_objects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum houses a priceless Egyptian <w>antiquity</w> that was discovered last year.",
                            "target_lang_translations": {
                                "ru": "В музее хранится бесценная египетская <w>древность</w>, обнаруженная в прошлом году."
                            }
                        },
                        {
                            "text": "The collector spent his life searching for a rare <w>antiquity</w> to complete his gallery.",
                            "target_lang_translations": {
                                "ru": "Коллекционер всю жизнь искал редкую <w>древность</w>, чтобы пополнить свою галерею."
                            }
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "Egyptian antiquity",
                        "Roman antiquity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, здание или произведение искусства из древнего прошлого"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "памятник старины"
                            },
                            {
                                "target_lang_word": "антиквариат",
                                "target_lang_sense_clarification": "старинная вещь"
                            },
                            {
                                "target_lang_word": "раритет",
                                "target_lang_sense_clarification": "редкая старинная вещь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04a2102b-de00-3096-9e30-839e652922bc",
                    "sense_definition": "The quality of being very old or having ancient origins",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "age_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>antiquity</w> of the manuscript was confirmed by carbon dating the parchment.",
                            "target_lang_translations": {
                                "ru": "<w>Древность</w> рукописи была подтверждена радиоуглеродным анализом пергамента."
                            }
                        },
                        {
                            "text": "Visitors are often struck by the noble <w>antiquity</w> and strength of the cathedral walls.",
                            "target_lang_translations": {
                                "ru": "Посетителей часто поражает благородная <w>древность</w> и мощь стен собора."
                            }
                        }
                    ],
                    "common_phrases": [
                        "great antiquity",
                        "venerable antiquity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество того, что является очень старым или имеет древнее происхождение"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "свойство старого"
                            },
                            {
                                "target_lang_word": "почтенный возраст",
                                "target_lang_sense_clarification": "очень долгий срок существования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e71fb551-f4c6-332b-81d1-4bdd50014303",
                    "sense_definition": "The people who lived in ancient times",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "historical_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All <w>antiquity</w> seemed to believe in the existence of these mythical pillars.",
                            "target_lang_translations": {
                                "ru": "Вся <w>древность</w>, казалось, верила в существование этих мифических столпов."
                            }
                        },
                        {
                            "text": "The customs of <w>antiquity</w> often seem strange to those living in the modern world.",
                            "target_lang_translations": {
                                "ru": "Обычаи <w>древних</w> часто кажутся странными тем, кто живет в современном мире."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used to refer to ancient peoples as a collective group"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди, жившие в древние времена"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "древние народы"
                            },
                            {
                                "target_lang_word": "древние",
                                "target_lang_sense_clarification": "люди прошлого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c74476fe-f688-3b21-ad8a-2f6b98928b52",
                    "sense_definition": "An elderly man",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man was a shrewd <w>antiquity</w> who knew every secret of the village.",
                            "target_lang_translations": {
                                "ru": "Старик был пронырливым <w>древним дедом</w>, знавшим все секреты деревни."
                            }
                        },
                        {
                            "text": "He looked like a walking <w>antiquity</w> in his dusty, out-of-date suit.",
                            "target_lang_translations": {
                                "ru": "В своем пыльном, старомодном костюме он выглядел как ходячая <w>древность</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used humorously or descriptively for an old person"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожилой мужчина (используется иронично или описательно)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старина",
                                "target_lang_sense_clarification": "старик"
                            },
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "очень старый человек"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a0dc6af-e4f1-3983-8980-0329c448fff7",
                    "sense_definition": "The specific historical period of Ancient Greece and Ancient Rome",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historical_periods",
                    "name_type": "historical_name",
                    "examples": [
                        {
                            "text": "Scholars of <w>Antiquity</w> study the political structures of the Roman Republic.",
                            "target_lang_translations": {
                                "ru": "Исследователи <w>Античности</w> изучают политическое устройство Римской республики."
                            }
                        },
                        {
                            "text": "The art of <w>Antiquity</w> heavily influenced the painters of the Renaissance.",
                            "target_lang_translations": {
                                "ru": "Искусство <w>Античности</w> оказало огромное влияние на художников Возрождения."
                            }
                        }
                    ],
                    "synonyms": [
                        "classical antiquity"
                    ],
                    "common_phrases": [
                        "classical antiquity",
                        "late antiquity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный исторический период Древней Греции и Древнего Рима"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Античность",
                                "target_lang_sense_clarification": "греко-римский мир"
                            },
                            {
                                "target_lang_word": "древность",
                                "target_lang_sense_clarification": "классическая эпоха"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
