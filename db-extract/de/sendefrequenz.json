                "senses": [
                    {
                        "sense_id": "f374a8d9-c158-331d-ae64-8b1b1417d65b",
                        "entry_id": "2313c478-94df-34ed-bf00-2634ddad3c9a",
                        "glosses": [
                            "Frequenz, die für die Ausstrahlung eines Funksignals verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae081cb3-d41b-4443-9929-29cf2ad76b36",
                                "sense_id": "f374a8d9-c158-331d-ae64-8b1b1417d65b",
                                "text": "„Ebenfalls ab Oktober werden sich der Musik- und Entertainment-Sender VIVA und Comedy Central eine Sendefrequenz teilen.“"
                            },
                            {
                                "example_id": "99cfb833-9c2e-465c-a445-79f44604ed2d",
                                "sense_id": "f374a8d9-c158-331d-ae64-8b1b1417d65b",
                                "text": "„Dieser Rat würde entscheiden, wer unter welchen Bedingungen eine Sendefrequenz erhält.“"
                            },
                            {
                                "example_id": "59dfbf91-1ec1-4b35-9ddd-3a052bde81d5",
                                "sense_id": "f374a8d9-c158-331d-ae64-8b1b1417d65b",
                                "text": "„Nun - ein halbes Jahr später - läuft das Jugendradio Gefahr, die Sendefrequenz zu verlieren und in Zukunft nur noch im Internet gehört werden zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
