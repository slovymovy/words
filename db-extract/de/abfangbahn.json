                "senses": [
                    {
                        "sense_id": "98726582-b555-3158-a079-7a03956bd131",
                        "entry_id": "602c1f54-c07a-3be0-b6ce-7be3feb53d9c",
                        "glosses": [
                            "Flugbahn, auf der eine Rakete fliegt, um ein Flugzeug zu treffen, abzuschießen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd0c96cd-7bf9-4174-92a8-f182a407214c",
                                "sense_id": "98726582-b555-3158-a079-7a03956bd131",
                                "text": "„Der wirkliche Flugvorgang ist wesentlich komplizierter, da die Fluggeschwindigkeit längs der Abfangbahn abnimmt und weitere Randbedingungen erfüllt werden müssen.“"
                            },
                            {
                                "example_id": "717a48cc-a3ad-49cb-a69c-a7ad6a94496d",
                                "sense_id": "98726582-b555-3158-a079-7a03956bd131",
                                "text": "„Die Kräfteverteilung beim Flugzeug ist auch abhängig davon, ob die Kurve oder die Abfangbahn bei kleiner Krümmung mit großer Geschwindigkeit oder bei großer Krümmung mit kleiner Geschwindigkeit durchflogen wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
