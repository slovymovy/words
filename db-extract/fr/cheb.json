                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "837e4a77-2330-4cb2-907b-e793f7fb9047",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Frau Mann ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "b1c95862-2dd7-4a7c-8f43-5f898cd9b2cc",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Herr Mann wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d6323905-1408-4b63-9941-da86dfe2ef7d",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Die Manns kommen heute aus der Steiermark."
                                            },
                                            {
                                                "example_id": "9432d445-c04b-42dc-a9ce-d95cf78a0953",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Der Mann trägt nie die Schals, die die Mann ihm strickt."
                                            },
                                            {
                                                "example_id": "561e6162-5d8f-48a9-a115-8e9ebfbd2b4b",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mann kommt, geht der Herr Mann.“"
                                            },
                                            {
                                                "example_id": "bc2dbe9d-fdc4-4506-b40c-6d121b7892fd",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Mann kommt und geht."
                                            },
                                            {
                                                "example_id": "e98a2d83-35ed-4942-8a4c-3ce3c7002fe1",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "Manns kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "e0b034b5-830d-49e3-a445-fcaaf814e936",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "An verregneten Herbsttagen ist Familie Manns liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "4e16284d-b383-42a6-b5ff-6afaaf1672f5",
                                                "sense_id": "8e68c9ec-8153-3b24-ac29-94241f450c4a",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Mann das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
