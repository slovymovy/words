                "senses": [
                    {
                        "sense_id": "32962239-1ddc-3b13-b5bc-cae19f0b8e8b",
                        "entry_id": "5368f3a1-70e7-3a53-81e4-b7e610a44de9",
                        "glosses": [
                            "Des deux côtés - recto et verso - d’une feuille de papier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd17476f-2021-49d7-8ad4-80ad34266a2c",
                                "sense_id": "32962239-1ddc-3b13-b5bc-cae19f0b8e8b",
                                "text": "Toutes les imprimantes ne prennent pas en charge l’impression recto-verso automatique."
                            },
                            {
                                "example_id": "7c747f74-4dd2-4234-b25c-df8b5121deee",
                                "sense_id": "32962239-1ddc-3b13-b5bc-cae19f0b8e8b",
                                "text": "Demander à Lison d’imprimer des dossiers pour chaque participant, recto verso pour éviter qu’un écolo vétilleux ne lui mette la misère."
                            }
                        ]
                    }
