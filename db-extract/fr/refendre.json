                "senses": [
                    {
                        "sense_id": "18d37bf2-0a63-3243-a0ba-494701b3a7fb",
                        "entry_id": "9709d65b-e952-38a1-87ee-577c676ebd91",
                        "glosses": [
                            "Fendre de nouveau."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "34ba6262-cfd6-3121-97ed-0d7e428632d8",
                        "entry_id": "9709d65b-e952-38a1-87ee-577c676ebd91",
                        "glosses": [
                            "Scier en long, fendre, diviser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "243eb60d-0b14-46bb-9a5b-5e21bf51c9f3",
                                "sense_id": "34ba6262-cfd6-3121-97ed-0d7e428632d8",
                                "text": "Refendre une poutre."
                            },
                            {
                                "example_id": "731b72aa-7b78-498a-95a8-75a21c5f53cb",
                                "sense_id": "34ba6262-cfd6-3121-97ed-0d7e428632d8",
                                "text": "Refendre une pièce de charpente, pour en faire des chevrons, des planches."
                            },
                            {
                                "example_id": "808ef553-921f-4869-a7b8-a6335ea25e35",
                                "sense_id": "34ba6262-cfd6-3121-97ed-0d7e428632d8",
                                "text": "Refendre de l’ardoise, du pavé."
                            },
                            {
                                "example_id": "c946286f-35f4-462d-8db5-64d5b5432ba3",
                                "sense_id": "34ba6262-cfd6-3121-97ed-0d7e428632d8",
                                "text": "Refendre un cuir."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1877024-0829-322d-8a46-52923c9e0644",
                        "entry_id": "9709d65b-e952-38a1-87ee-577c676ebd91",
                        "glosses": [
                            "Passer une autre fois la charrue entre les sillons déjà ouverts par un premier labour."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b7228233-6211-47cc-8c85-a31bb0ac2623",
                                "sense_id": "c1877024-0829-322d-8a46-52923c9e0644",
                                "text": "Cette opération consiste à répandre la semence avant de donner le dernier labour , & aussi-tôt après avoir fermé, refendre avec une binette ou autre charrue qui pique peu, les éminences des raies, pour recouvrir la semence qui est tombée dans le fond."
                            },
                            {
                                "example_id": "5b43ef93-74e7-46c9-92ef-bff39e853b42",
                                "sense_id": "c1877024-0829-322d-8a46-52923c9e0644",
                                "text": "Quand votre labour du milieu est refendu fin juin ou début juillet, vous devez épendre votre fumier avant le dernier labour, …."
                            }
                        ]
                    }
                ],
