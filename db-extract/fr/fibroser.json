                        "glosses": [
                            "Se charger de façon pathologique en tissus fibreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc1ba540-0a95-4e9c-aee8-330113d1367c",
                                "sense_id": "1763f906-1178-3e16-af19-8f498273309c",
                                "text": "On la place entre la paroi musculaire et le péritoine pour qu'elle se péritonéalise et se fibrose."
                            },
                            {
                                "example_id": "b0af8795-f760-41c0-9785-a963bf326337",
                                "sense_id": "1763f906-1178-3e16-af19-8f498273309c",
                                "text": "La fibrose pulmonaire idiopathique (FPI) est une maladie progressive et chronique caractérisée par une altération du poumon qui se fibrose et se rigidifie."
                            },
                            {
                                "example_id": "c3de0865-1124-42fc-99c3-278e6f03cb3b",
                                "sense_id": "1763f906-1178-3e16-af19-8f498273309c",
                                "text": "Ce tissu se fibrose ne laissant plus aucune chance aux vaisseaux de nourrir normalement le tissu."
