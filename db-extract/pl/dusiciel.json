                        ],
                        "examples": [
                            {
                                "example_id": "04b541c2-3821-42e1-b761-78040dec8318",
                                "sense_id": "e0ca6cde-345c-346d-99a3-9ae7912fa2f8",
                                "text": "Możesz słowy ułagodzić psa gniewnego, zdumieć byka, oczarować węża dusiciela, przestraszyć tygrysa, rozczulić lwa; ale na tego potwora, na tę rozpętaną armatę — nie masz sposobu"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    },
                    {
                        "sense_id": "008f8921-0607-3152-a6c6-eb4bdf782432",
                        "entry_id": "d5082724-b750-364b-b81b-51fc5cb5298c",
                        "glosses": [
