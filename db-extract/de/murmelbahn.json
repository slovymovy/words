                    {
                        "sense_id": "d1fe7e20-e54f-3943-90e3-07598033dfe2",
                        "entry_id": "277c49e9-320e-37d7-b6ce-2a40814723d8",
                        "glosses": [
                            "Bahn, auf der eine Murmel eine bestimmte Strecke herunterrollt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1c252f6-650a-491a-87dd-c1fccecba25b",
                                "sense_id": "d1fe7e20-e54f-3943-90e3-07598033dfe2",
                                "text": "Mein Sohn zerstörte gestern seine Murmelbahn, indem er eine Kerze auf sie warf, infolgedessen sie verbrannte."
                            },
                            {
                                "example_id": "23c05774-18b5-423b-8142-41248a6d207f",
                                "sense_id": "d1fe7e20-e54f-3943-90e3-07598033dfe2",
                                "text": "„Nachdem ich ein Stück Kuchen gegessen hatte, setzte ich mich im Wohnzimmer auf den Perserteppich und fing etwas lustlos an, Murmeln durch die Murmelbahn zu schicken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
