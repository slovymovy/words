                    {
                        "form_id": "27bcd03b-7c2b-4ec2-b731-38136ef2d73d",
                        "entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "tags": [],
                        "form": "réveil-matin"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "62a2212c-575d-3279-a055-5ca5618777f6",
                        "entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "glosses": [
                            "Petite pendule, munie d’un mécanisme qui actionne une sonnerie bruyante et prolongée, à l’heure que l’on a marquée par une aiguille spéciale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2afaa7af-d467-4756-a008-9adcb02659d9",
                                "sense_id": "62a2212c-575d-3279-a055-5ca5618777f6",
                                "text": "De peur que la fatigue ne l’assommât, vers le jour, il réglait son réveille-matin à cinq heures, heure à laquelle il devait être debout, pour recevoir le premier train de Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8e0d63b-c21e-309f-959b-f15400892b9d",
                        "entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "glosses": [
                            "Bruit que fait le matin de bonne heure un coq, un voisin bruyant, etc."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "73f452f3-2cb0-46e4-9dcb-d502bc453f7c",
                                "sense_id": "e8e0d63b-c21e-309f-959b-f15400892b9d",
                                "text": "C’est un fâcheux réveille-matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5fabf0c-1637-347f-b25a-f9bb17bfb98e",
                        "entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "glosses": [
                            "Bonne ou mauvaise nouvelle qu’on apprend en s’éveillant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad55251-1c61-4d27-935d-c8bd97b0c02b",
                                "sense_id": "a5fabf0c-1637-347f-b25a-f9bb17bfb98e",
                                "text": "C’est un agréable réveille-matin, c’est un fâcheux réveille-matin."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f89f3bc-b6a1-399b-809c-44bf64aee215",
                        "entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "glosses": [
                            "Euphorbe réveille-matin"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e0db644-5325-4831-b869-7d54b3e000fe",
                        "source_entry_id": "3e5a625d-6665-3a03-ad09-c699621e3414",
                        "source_sense_description": "Appareil",
                        "target_lang_word": "Wecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                        "entry_id": "2aa9516e-a70c-37fc-90d2-d75762e75399",
                                        "glosses": [
                                            "Uhr, die zu einer vorher eingestellten Zeit ein Signal gibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99d2bd89-530f-455f-aa37-71b79a219da3",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "Wenn du den Wecker nicht einschaltest, klingelt er auch nicht."
                                            },
                                            {
                                                "example_id": "445e1369-289e-4827-909a-57522042c567",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Um fünf Uhr am nächsten Morgen weckte mich der Ruf des Muezzins, noch bevor mein Wecker losging.“"
                                            },
                                            {
                                                "example_id": "9fd85e71-7542-4b49-9e6a-3f9af78e0c4c",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Die Zeiger des Weckers im Schlafzimmer ticken lauter als sonst.“"
                                            },
                                            {
                                                "example_id": "d2f52492-ad28-4270-8bbc-bb484492013b",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Zuerst dachte er, es sei der Wecker, der ihn aufstehen hieß, aber dann wurde er vollends wach und besann sich auf seinen Beruf.“"
                                            },
                                            {
                                                "example_id": "6d173184-cc39-427e-a3dd-a8fc5f498050",
                                                "sense_id": "1e132aec-d5e3-3147-9ccc-941f780850dd",
                                                "text": "„Dann sah sie zum Wecker auf der Nachkonsole.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                        "entry_id": "af8da273-8b43-3664-a585-e616a370bee5",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4064813b-4042-4812-a8b0-eca3fc9c58dc",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Herr Wecker hat seinen Bauantrag fristgerecht eingereicht."
                                            },
                                            {
                                                "example_id": "c601d977-bfd4-4eff-a2c9-049f2f503fc7",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Frau Wecker hat vor Gericht erfolgreich gegen ihre Kündigung geklagt."
                                            },
                                            {
                                                "example_id": "d5e8585c-73b6-44ae-bc15-562324b0fec7",
                                                "sense_id": "f48c92fa-eb80-30b7-80ab-a362f3507c15",
                                                "text": "Bei den Weckers ist immer was los."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Wecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4fb40a-dae0-3c3c-af00-bebf5e833944",
                                        "entry_id": "41f1f06e-52d1-3ffc-ba85-5b204e505711",
                                        "glosses": [
                                            "Ortsteil von Biwer, Luxemburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4923583d-fb71-4b2a-8b01-ea63576cb452",
                                                "sense_id": "9e4fb40a-dae0-3c3c-af00-bebf5e833944",
                                                "text": "Wecker liegt in Luxemburgs Osten."
                                            }
                                        ],
