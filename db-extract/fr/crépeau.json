                "senses": [
                    {
                        "sense_id": "e3991eab-ad4b-39e0-88a8-3dd40833d10e",
                        "entry_id": "8ea830bc-509c-3e3e-878e-d27acd5ed3cc",
                        "glosses": [
                            "Lieu-dit de la commune de Saint-Ciers-de-Canesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd93cf85-c5ad-45d3-9836-165996804550",
                                "sense_id": "e3991eab-ad4b-39e0-88a8-3dd40833d10e",
                                "text": "À la requête du sieur Jean Raboutet, propriétaire, et de la dame Marie Chabanit, sans profession, son épouse, qu'il autorise, demeurant ensemble à Crépeau, commune de Saint-Ciers-de-Canesse."
                            }
                        ]
                    },
                    {
                        "sense_id": "87ea6245-a1d5-380a-9330-9e0801204da5",
                        "entry_id": "8ea830bc-509c-3e3e-878e-d27acd5ed3cc",
                        "glosses": [
                            "Lieu-dit de la commune de Saint-Hilaire-de-Voust."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "57e3f9d9-2b96-3b67-8839-caf41ae87ae6",
                        "entry_id": "8ea830bc-509c-3e3e-878e-d27acd5ed3cc",
                        "glosses": [
                            "Canton inhabité du Nord-du-Québec."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c883fcf7-8036-3b4a-9209-a5589bf90fa6",
                        "entry_id": "8ea830bc-509c-3e3e-878e-d27acd5ed3cc",
                        "glosses": [
                            "Lac de la commune de Saint-Zénon dans la région de Lanaudière au Québec (Canada)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d09076d-bf50-459b-b7ba-474f8be187e5",
                                "sense_id": "c883fcf7-8036-3b4a-9209-a5589bf90fa6",
                                "text": "Un homme est mort noyé en fin d'après-midi sur le lac Crépeau à Saint-Zénon, au nord de Joliette, dans Lanaudière."
                            }
                        ]
                    },
                    {
                        "sense_id": "d13e6e1f-a81b-3627-a22f-a1c1d35176bf",
                        "entry_id": "8ea830bc-509c-3e3e-878e-d27acd5ed3cc",
                        "glosses": [
                            "Lac de Chertsey dans la région de Lanaudière au Québec (Canada)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e6436e-35ec-42cc-a44e-0ecc156d946f",
                                "sense_id": "d13e6e1f-a81b-3627-a22f-a1c1d35176bf",
                                "text": "Les concentrations furent découvertes sur le lot 6, rang IX du canton de Chertsev, sur la rive convexe du lac Catherine ; sur le lot 5, rang VIII de Chertsey, à la sortie du lac Racine, formé par la décharge du lac Lafontaine ; sur le lot 6, rang VI de Chertsey, à environ mille pieds à l'ouest du chemin de rang ; et sur le lot 7, rang V du canton de Cathcart, directement à l'ouest du lac Crépeau sur la route des lacs Gareau."
                            }
                        ]
                    }
                ],
