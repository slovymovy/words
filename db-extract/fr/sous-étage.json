                    {
                        "sense_id": "76c21bfa-7298-34d8-ad6a-710d61342b76",
                        "entry_id": "cc9d0fe2-026d-3ae3-a517-e45710a39e21",
                        "glosses": [
                            "Ensemble des plantes, mort-bois ou commercialisables, poussant sous la ou les essences objectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45308d59-7c71-4131-9758-f54d9b73adde",
                                "sense_id": "76c21bfa-7298-34d8-ad6a-710d61342b76",
                                "text": "Quant aux satellites les plus constants de l'Ormaie rudérale qui auraient dû accompagner le Buddleia en sous-étage dans les sols riches des jardins embroussaillés, ils font tous curieusement défaut (Lierre terrestre, Herbe-à-Robert, Benoîte des villes, Alliaire; le Sureau n'a été observé que deux fois et l'Orme une seule fois, planté)."
                            },
                            {
                                "example_id": "ec77f31a-0209-4add-9055-9d80c90d4f06",
                                "sense_id": "76c21bfa-7298-34d8-ad6a-710d61342b76",
                                "text": "Cette dynamisation de la sylviculture ne conduit pas pour autant à des peuplements purs et monospécifiques car le mélange des essences et la présence d’un sous-étage diversifié et bénéfique est un souci permanent du sylviculteur."
                            },
                            {
                                "example_id": "7cf7650a-49c1-4261-8ee9-bdfa1e18baff",
                                "sense_id": "76c21bfa-7298-34d8-ad6a-710d61342b76",
                                "text": "Rechercher les arbres de qualité et travailler à leur profit en contenant d’abord le sous-étage de [c]harme. Il faut supprimer les arbres de sous[-]étage qui risquent de faire mourir des branches charpentières."
                            }
                        ]
                    }
