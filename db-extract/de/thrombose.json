                        "glosses": [
                            "Blutgerinnung innerhalb der Blutgefäße, typische Erkrankung der Venen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5dc407-a2ef-46ce-b1de-c79f6f7a21b9",
                                "sense_id": "e0aba390-c033-348c-a476-d5c02db7c4ae",
                                "text": "Um einer Thrombose vorzubeugen, bekommt man im Krankenhaus häufig Stützstrümpfe, wenn man länger liegen muss."
                            },
                            {
                                "example_id": "72830326-08cd-4601-9924-98e335fd7c65",
                                "sense_id": "e0aba390-c033-348c-a476-d5c02db7c4ae",
                                "text": "Arterielle Thrombosen sind eher selten, aber es gibt sie."
                            }
                        ],
                        "sense_index_json": "\"1\""
