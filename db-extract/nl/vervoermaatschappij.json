                    {
                        "sense_id": "eb62683b-988f-3f18-90c3-3b8285d1b52a",
                        "entry_id": "484442b1-4343-360d-ad2d-edca69384cb9",
                        "glosses": [
                            "bedrijf dat zich bezighoudt met het transport van mensen of goederen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35e43475-a217-4676-bc2f-e647d7e77d5c",
                                "sense_id": "eb62683b-988f-3f18-90c3-3b8285d1b52a",
                                "text": "Een rolstoelgebruiker uit Den Haag zegt in de krant dat hij vooral met de Haagse vervoermaatschappij HTM problemen heeft: \"Soms negeren chauffeurs me als ik alleen bij de halte sta. Dan steek ik mijn hand op, maar rijdt de bus gewoon door.\""
                            },
                            {
                                "example_id": "b0db653d-0e55-43fe-b4f1-579d140779a8",
                                "sense_id": "eb62683b-988f-3f18-90c3-3b8285d1b52a",
                                "text": "De Vlaamse vervoermaatschappij De Lijn betaalde chauffeurs 50 euro bruto per dag extra als ze ondanks de terreurdreiging op Brussel zouden blijven rijden. De premie werd uitgekeerd van maandag tot donderdag."
                            },
                            {
                                "example_id": "409cf817-1c3f-4b13-910d-3436ef17574b",
                                "sense_id": "eb62683b-988f-3f18-90c3-3b8285d1b52a",
                                "text": "Zelfs de stadsbussen van de Parijse vervoermaatschappij RATP rijden door, terwijl toch echt besloten was dat ze even zouden stilhouden."
                            }
                        ]
                    }
