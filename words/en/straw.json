                    "sense_definition": "Of a pale, yellowish beige colour.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fields turned a <w>straw</w> yellow as the harvest approached.",
                            "target_lang_translations": {
                                "ru": "Поля окрасились в <w>соломенный</w> желтый цвет по мере приближения сбора урожая.",
                                "tr": "Hasat yaklaştıkça tarlalar <w>saman</w> sarısına döndü.",
                                "zh": "随着收获季节临近，田野变成了<w>稻草黄</w>。"
                            }
