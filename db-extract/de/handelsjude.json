                "senses": [
                    {
                        "sense_id": "7647daa1-10da-3187-950a-6a76b116bcba",
                        "entry_id": "89956b0a-4e05-395c-9eb1-35f37fc7429c",
                        "glosses": [
                            "jüdischer Händler/Viehhändler und Jude, der als Hausierer umherzog"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "e0a54894-e9db-4a7a-bd5f-581fa7b7a7db",
                                "sense_id": "7647daa1-10da-3187-950a-6a76b116bcba",
                                "text": "„Eine besonders genaue Aufsicht ist in dieser Hinsicht über die wandernden Handwerksburschen, Handelsjuden und dergleichen Personen zu führen.“ (1831)"
                            },
                            {
                                "example_id": "7b385c63-6712-4f79-8aab-ca0b096818ba",
                                "sense_id": "7647daa1-10da-3187-950a-6a76b116bcba",
                                "text": "„Die Bauern hatten kein eigenes Vieh im Stalle, es gehörte dem Handelsjuden, von dem sie es nicht gekauft, sondern geborgt hatten.“ (1877)"
                            },
                            {
                                "example_id": "669eb379-2f8c-4f29-b4c2-60865ddc7dd9",
                                "sense_id": "7647daa1-10da-3187-950a-6a76b116bcba",
                                "text": "„Der arme Handelsjude drückte also mit der Frage »Bin ich a Forelle!« aus, dass er nicht über den Status verfügte, den die Forelle sozusagen auf der Speisekarte beanspruchen durfte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
