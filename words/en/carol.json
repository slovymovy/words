                },
                {
                    "sense_id": "93c537e9-045a-356c-ac7e-c2cd97c04438",
                    "sense_definition": "A male given name.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "male_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "King <w>Carol</w> II of Romania reigned during a turbulent period in history.",
                            "target_lang_translations": {
                                "ru": "Король Румынии <w>Кароль</w> II правил в неспокойный исторический период.",
                                "zh": "罗马尼亚国王<w>卡罗尔</w>二世在历史上的一个动荡时期统治该国。",
                                "es": "El rey <w>Carol</w> II de Rumania reinó durante un período turbulento de la historia."
                            }
                        },
                        {
                            "text": "We named our son <w>Carol</w> after his great-grandfather.",
                            "target_lang_translations": {
                                "ru": "Мы назвали сына <w>Кароль</w> в честь его прадеда.",
                                "zh": "我们给儿子取名叫<w>卡罗尔</w>，以纪念他的曾祖父。",
                                "es": "Llamamos a nuestro hijo <w>Carol</w> en honor a su bisabuelo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское имя.",
                        "zh": "男性名字。",
                        "es": "Un nombre propio masculino."
                    },
                    "translations": {
                        "ru": [
