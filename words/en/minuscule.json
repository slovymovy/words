{
    "word_family": [
        "minuscule"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c7b41e6-7a2a-34e0-bcb1-6222c2ce98b5",
                    "sense_definition": "Very small; tiny.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted a <w>minuscule</w> dot on the canvas.",
                            "target_lang_translations": {
                                "zh": "艺术家在画布上画了一个<w>微小</w>的圆点。"
                            }
                        },
                        {
                            "text": "The company reported a <w>minuscule</w> profit after a very difficult year.",
                            "target_lang_translations": {
                                "zh": "在经历了非常困难的一年后，该公司报告了<w>微小</w>的利润。"
                            }
                        }
                    ],
                    "synonyms": [
                        "microscopic",
                        "minute",
                        "tiny"
                    ],
                    "common_phrases": [
                        "minuscule amount",
                        "minuscule detail"
                    ],
                    "target_lang_definitions": {
                        "zh": "极小的；微小的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "微小",
                                "target_lang_sense_clarification": "形容体积或数量非常小。"
                            },
                            {
                                "target_lang_word": "极小",
                                "target_lang_sense_clarification": "强调程度达到极点。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f2290fc-216f-3944-9006-aad9d03f9023",
                    "sense_definition": "Written in lowercase letters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript was written entirely in <w>minuscule</w> script.",
                            "target_lang_translations": {
                                "zh": "这份古代手稿完全是用<w>小写</w>字体书写的。"
                            }
                        },
                        {
                            "text": "The scribe used <w>minuscule</w> letters for the body of the text.",
                            "target_lang_translations": {
                                "zh": "抄写员在正文部分使用了<w>小写</w>字母。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lower-case",
                        "small"
                    ],
                    "antonyms": [
                        "majuscule",
                        "uppercase"
                    ],
                    "target_lang_definitions": {
                        "zh": "用小写字母书写的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小写",
                                "target_lang_sense_clarification": "指字母书写形式为小写。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53cf78e0-b78f-3037-b725-e9be8a46080c",
                    "sense_definition": "Written in a specific medieval handwriting style.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "typography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars study the development of <w>minuscule</w> handwriting in early texts.",
                            "target_lang_translations": {
                                "zh": "学者们研究早期文献中<w>小写字体</w>的发展。"
                            }
                        },
                        {
                            "text": "The document features a clear <w>minuscule</w> style typical of the period.",
                            "target_lang_translations": {
                                "zh": "该文件呈现出那个时期典型的清晰的<w>小写字体</w>风格。"
                            }
                        }
