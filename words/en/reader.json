{
    "word_family": [
        "read",
        "readable",
        "readability",
        "reading",
        "unread",
        "misread",
        "proofread"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c124f243-8ae5-35dd-ac23-31d232d84a18",
                    "sense_definition": "A person who reads.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is an avid <w>reader</w> who finishes at least two books every week.",
                            "target_lang_translations": {
                                "ru": "Она заядлая <w>читательница</w>, которая прочитывает как минимум две книги каждую неделю."
                            }
                        },
                        {
                            "text": "The teacher encouraged every young <w>reader</w> in the class to explore different genres.",
                            "target_lang_translations": {
                                "ru": "Учитель поощрял каждого юного <w>читателя</w> в классе изучать разные жанры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "avid reader",
                        "young reader",
                        "talented reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который читает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читатель",
                                "target_lang_sense_clarification": "тот, кто читает"
                            },
                            {
                                "target_lang_word": "чтец",
                                "target_lang_sense_clarification": "человек, читающий вслух или любящий читать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4038770-4f80-3575-b762-92da6bc69edd",
                    "sense_definition": "A person who reads a specific publication, such as a newspaper or magazine.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_reading",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine has over one million regular <w>readers</w> across the country.",
                            "target_lang_translations": {
                                "ru": "У журнала более миллиона постоянных <w>читателей</w> по всей стране."
                            }
                        },
                        {
                            "text": "The editor wrote a letter to address the concerns of a loyal <w>reader</w>.",
                            "target_lang_translations": {
                                "ru": "Редактор написал письмо, чтобы ответить на опасения преданного <w>читателя</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loyal reader",
                        "regular reader",
                        "target reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Читатель определенного издания, например, газеты или журнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "читатель",
                                "target_lang_sense_clarification": "подписчик или потребитель издания"
                            },
                            {
                                "target_lang_word": "аудитория",
                                "target_lang_sense_clarification": "совокупность читателей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89d47619-3211-3fe2-a406-d52582dbf040",
                    "sense_definition": "Any electronic device that reads or displays digital data.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I prefer using an <w>e-reader</w> because it is much lighter than carrying physical books.",
                            "target_lang_translations": {
                                "ru": "Я предпочитаю использовать <w>электронную книгу</w>, потому что она намного легче, чем бумажные книги."
                            }
                        },
                        {
                            "text": "Please insert your credit card into the card <w>reader</w> to complete the payment.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вставьте вашу кредитную карту в <w>картридер</w>, чтобы завершить оплату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "card reader",
                        "e-reader",
                        "barcode reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое электронное устройство, которое считывает или отображает цифровые данные."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "считыватель",
                                "target_lang_sense_clarification": "устройство для считывания данных"
                            },
                            {
                                "target_lang_word": "ридер",
                                "target_lang_sense_clarification": "электронная книга или устройство чтения"
                            },
                            {
                                "target_lang_word": "картридер",
                                "target_lang_sense_clarification": "устройство для чтения карт памяти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35049962-af7e-3378-a4c1-33013ac69bba",
                    "sense_definition": "An elementary textbook for those learning to read, especially for foreign languages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "book_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students used a graded <w>reader</w> to improve their vocabulary in the new language.",
                            "target_lang_translations": {
                                "ru": "Студенты использовали <w>адаптированную книгу для чтения</w>, чтобы расширить свой словарный запас в новом языке."
                            }
                        },
                        {
                            "text": "This <w>reader</w> contains simple stories designed for beginners.",
                            "target_lang_translations": {
                                "ru": "Эта <w>хрестоматия</w> содержит простые рассказы, предназначенные для начинающих."
                            }
                        }
                    ],
                    "common_phrases": [
                        "graded reader",
                        "language reader",
                        "school reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Учебное пособие для тех, кто учится читать, особенно на иностранных языках."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "книга для чтения",
                                "target_lang_sense_clarification": "учебное пособие с текстами"
                            },
                            {
                                "target_lang_word": "хрестоматия",
                                "target_lang_sense_clarification": "сборник избранных текстов"
                            },
                            {
                                "target_lang_word": "адаптированная книга",
                                "target_lang_sense_clarification": "текст для изучающих язык"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd7bfb2-4912-3a52-847d-04f91035c1ab",
                    "sense_definition": "Glasses used for reading.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "eyewear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reached for his <w>readers</w> so he could see the small print on the menu.",
                            "target_lang_translations": {
                                "ru": "Он потянулся за своими <w>очками для чтения</w>, чтобы разглядеть мелкий шрифт в меню."
                            }
                        },
                        {
                            "text": "I keep a pair of <w>readers</w> in every room of the house.",
                            "target_lang_translations": {
                                "ru": "У меня есть пара <w>очков для чтения</w> в каждой комнате дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of readers"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the plural form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очки, используемые для чтения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очки для чтения",
                                "target_lang_sense_clarification": "корректирующие очки для близкого расстояния"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6917c91e-f0e5-375d-a8a5-b3a18b9aff24",
                    "sense_definition": "A university lecturer ranking below a professor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of research, she was finally promoted to the position of <w>Reader</w> in History.",
                            "target_lang_translations": {
                                "ru": "После многих лет исследований она, наконец, была повышена до должности <w>ридера</w> истории."
                            }
                        },
                        {
                            "text": "The <w>reader</w> delivered a fascinating lecture on medieval literature.",
                            "target_lang_translations": {
                                "ru": "<w>Ридер</w> прочитал захватывающую лекцию по средневековой литературе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "university reader"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Primarily used in the UK and Commonwealth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ученое звание или должность в британских университетах, стоящая выше старшего преподавателя, но ниже профессора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ридер",
                                "target_lang_sense_clarification": "академическое звание в Великобритании"
                            },
                            {
                                "target_lang_word": "доцент",
                                "target_lang_sense_clarification": "приблизительный эквивалент в российской системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cb17098-53f1-3924-b1ab-a87c437560e3",
                    "sense_definition": "A <w>proofreader</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publishing_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reader</w> found several typos that the author had missed.",
                            "target_lang_translations": {
                                "ru": "<w>Корректор</w> нашел несколько опечаток, которые пропустил автор."
                            }
                        },
                        {
                            "text": "As a professional <w>reader</w>, his job is to ensure the text is error-free.",
                            "target_lang_translations": {
                                "ru": "Как профессиональный <w>корректор</w>, его работа заключается в том, чтобы гарантировать отсутствие ошибок в тексте."
                            }
                        }
                    ],
                    "synonyms": [
                        "proofreader",
                        "printer's reader"
                    ],
                    "common_phrases": [
                        "proof reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Корректор, проверяющий текст на наличие ошибок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корректор",
                                "target_lang_sense_clarification": "специалист по исправлению ошибок в тексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a504213d-e729-35d3-a6b1-3d7dbeb7623e",
                    "sense_definition": "A person employed by a publisher to read works submitted for publication and determine their merits.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "publishing_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The publisher's <w>reader</w> recommended the manuscript for immediate publication.",
                            "target_lang_translations": {
                                "ru": "Издательский <w>рецензент</w> рекомендовал рукопись к немедленной публикации."
                            }
                        },
                        {
                            "text": "He worked as a freelance <w>reader</w> for several major publishing houses.",
                            "target_lang_translations": {
                                "ru": "Он работал внештатным <w>редактором-рецензентом</w> в нескольких крупных издательствах."
                            }
                        }
                    ],
                    "synonyms": [
                        "publisher's reader",
                        "first reader"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Сотрудник издательства, который читает рукописи и дает заключение об их качестве."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецензент",
                                "target_lang_sense_clarification": "лицо, дающее отзыв на рукопись"
                            },
                            {
                                "target_lang_word": "редактор",
                                "target_lang_sense_clarification": "сотрудник, оценивающий материал"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c87a5a9c-e86a-35aa-8af4-a773f624277f",
                    "sense_definition": "A lay or minor cleric who reads lessons in a church service.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>reader</w> stood at the lectern to deliver the morning scripture.",
                            "target_lang_translations": {
                                "ru": "<w>Чтец</w> встал за аналой, чтобы прочитать утреннее Писание."
                            }
                        },
                        {
                            "text": "He has served as a lay <w>reader</w> in his local parish for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он служит <w>чтецом-мирянином</w> в своем местном приходе уже более двадцати лет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lay reader"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мирянин или церковнослужитель низшего чина, читающий тексты во время богослужения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чтец",
                                "target_lang_sense_clarification": "церковнослужитель, читающий молитвы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf396ceb-ee15-33d0-b96c-d7140f2bf488",
                    "sense_definition": "A newspaper advertisement designed to look like a news article rather than a commercial solicitation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "advertising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company placed a <w>reading</w> notice in the Sunday paper to promote their new health product.",
                            "target_lang_translations": {
                                "ru": "Компания разместила <w>рекламную заметку</w> в воскресной газете для продвижения своего нового продукта для здоровья."
                            }
                        },
                        {
                            "text": "Many people were confused by the <w>reader</w> because it looked exactly like a regular report.",
                            "target_lang_translations": {
                                "ru": "Многие люди были сбиты с толку этой <w>рекламой</w>, потому что она выглядела в точности как обычный репортаж."
                            }
                        }
                    ],
                    "synonyms": [
                        "reading notice"
                    ],
                    "common_phrases": [],
                    "target_lang_definitions": {
                        "ru": "Газетная реклама, оформленная в виде обычной статьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекламная заметка",
                                "target_lang_sense_clarification": "текст, имитирующий редакционный материал"
                            },
                            {
                                "target_lang_word": "джинса",
                                "target_lang_sense_clarification": "скрытая реклама (жаргон)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3586c03e-16d7-3cde-bab2-405c6f7a38b9",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The author of the study is a professor named Dr. <w>Reader</w>.",
                            "target_lang_translations": {
                                "ru": "Автор исследования — профессор по фамилии доктор <w>Ридер</w>."
                            }
                        },
                        {
                            "text": "We are meeting the <w>Reader</w> family for dinner this evening.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером мы встречаемся с семьей <w>Ридер</w> за ужином."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ридер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b53666d-d4cc-30ab-898f-9eb96c563e31",
                    "sense_definition": "A place name referring to several locations in the United States, such as in Arkansas, Illinois, or West Virginia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "location",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The small community of <w>Reader</w> is located in West Virginia.",
                            "target_lang_translations": {
                                "ru": "Небольшая община <w>Ридер</w> находится в Западной Вирджинии."
                            }
                        },
                        {
                            "text": "They drove through <w>Reader</w>, Arkansas, during their road trip across the South.",
                            "target_lang_translations": {
                                "ru": "Они проезжали через <w>Ридер</w>, штат Арканзас, во время своего путешествия по Югу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких населенных пунктов в США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ридер",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}