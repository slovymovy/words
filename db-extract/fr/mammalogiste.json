                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1d9fd05-2255-404e-a6aa-f6a7240b98db",
                                "sense_id": "20d8e697-a6ef-38e9-9bba-c7d591feca93",
                                "text": "Il a fallu une bonne dose d’obstination à Tim Flannery, un mammalogiste australien, pour y découvrir l’animal qu’il recherchait, décrit par les chasseurs locaux mais jamais vu par un zoologiste et dont le nom local est tenkile."
                            },
                            {
                                "example_id": "7334c2cf-8a1c-4e74-bd83-07037dfa309a",
                                "sense_id": "20d8e697-a6ef-38e9-9bba-c7d591feca93",
                                "text": "Pendant le petit-déjeuner près du feu, Johan Michaux, mammalogiste, nous raconte son voyage chez les Inuits, à la recherche des ours blancs."
                            }
                        ]
                    }
