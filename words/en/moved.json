        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4cbd9d70-2683-3623-b892-adf19287f41c",
                    "sense_definition": "Emotionally affected; feeling strong sadness, sympathy, or gratitude.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience was deeply <w>moved</w> by the actor's powerful performance.",
                            "target_lang_translations": {
                                "ru": "Зрители были глубоко <w>тронуты</w> мощной игрой актера.",
                                "es": "La audiencia quedó profundamente <w>conmovida</w> por la poderosa actuación del actor."
                            }
                        },
                        {
                            "text": "She felt strangely <w>moved</w> when she saw the old family photographs.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала себя странно <w>растроганной</w>, увидев старые семейные фотографии.",
                                "es": "Se sintió extrañamente <w>conmovida</w> al ver las viejas fotografías familiares."
                            }
                        }
                    ],
                    "synonyms": [
                        "touched",
                        "affected",
                        "emotional"
                    ],
                    "antonyms": [
                        "unmoved",
                        "indifferent"
                    ],
                    "common_phrases": [
                        "deeply moved",
                        "moved to tears",
                        "visibly moved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Эмоционально затронутый; испытывающий сильную грусть, сочувствие или благодарность.",
                        "es": "Afectado emocionalmente; que siente una fuerte tristeza, simpatía o gratitud."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тронут",
                                "target_lang_sense_clarification": "вызывающий душевный отклик"
                            },
                            {
                                "target_lang_word": "растроган",
                                "target_lang_sense_clarification": "доведенный до сильных чувств или слез"
                            },
                            {
                                "target_lang_word": "взволнован",
                                "target_lang_sense_clarification": "находящийся в состоянии душевного волнения"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "conmovido",
                                "target_lang_sense_clarification": "que siente una fuerte emoción"
                            },
                            {
                                "target_lang_word": "emocionado",
                                "target_lang_sense_clarification": "que experimenta una emoción intensa"
                            },
                            {
                                "target_lang_word": "tocado",
                                "target_lang_sense_clarification": "afectado profundamente en los sentimientos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cf90306-c594-3306-8af7-7abbccc080f6",
                    "sense_definition": "Convinced or persuaded to believe something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am not <w>moved</w> by your arguments to change my original decision.",
                            "target_lang_translations": {
                                "ru": "Ваши доводы не <w>убедили</w> меня изменить мое первоначальное решение.",
                                "es": "No me siento <w>convencido</w> por tus argumentos para cambiar mi decisión original."
                            }
                        },
                        {
                            "text": "He was <w>moved</w> to believe that the plan might actually succeed.",
                            "target_lang_translations": {
                                "ru": "Его <w>побудили</w> поверить, что план действительно может сработать.",
                                "es": "Fue <w>persuadido</w> a creer que el plan realmente podría tener éxito."
                            }
                        }
                    ],
                    "synonyms": [
                        "convinced",
                        "persuaded"
                    ],
                    "antonyms": [
                        "dissuaded"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern usage typically prefers 'persuaded' or uses the verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убежденный или склоненный поверить во что-то.",
                        "es": "Convencido o persuadido de creer en algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежден",
                                "target_lang_sense_clarification": "уверенный в правильности чего-либо"
                            },
                            {
                                "target_lang_word": "побужден",
                                "target_lang_sense_clarification": "склоненный к действию или мнению"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "convencido",
                                "target_lang_sense_clarification": "persuadido de la verdad de algo"
                            },
                            {
                                "target_lang_word": "persuadido",
                                "target_lang_sense_clarification": "inducido a creer o hacer algo"
                            }
                        ]
                    }
                }
            ]
        }
