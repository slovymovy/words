                                        "sense_id": "067793ff-2ec0-3260-b417-7613f80a78a9",
                                        "entry_id": "66670248-7f67-3b1b-9323-12f11ca14025",
                                        "glosses": [
                                            "van grote schoonheid, zo prachtig dat het een afbeelding lijkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26f01de-fab4-4b64-821e-7d330cbc4ea2",
                                                "sense_id": "067793ff-2ec0-3260-b417-7613f80a78a9",
                                                "text": "Er kwam een beeldschone jongedame binnen en de aandacht van velen werd afgeleid van het droge betoog van de spreker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "215f7b03-7063-4ab1-b8d9-d9f51db882f1",
                        "source_entry_id": "bb51d2aa-301c-3b8d-8936-cb1505e59811",
                        "source_sense_id": "aa117783-5ad2-3566-9332-03d40c8e3a8e",
                        "source_sense_description": "Extremely beautiful",
                        "target_lang_word": "ravissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ravissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b75e0a6-e0f8-3ccd-981c-c4496b9225c5",
                                        "entry_id": "9a42434e-285f-31c8-8334-42d20f6776a4",
                                        "glosses": [
                                            "Qui transporte d’admiration."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eb61649-2b63-487d-9fcb-a78b0ff96e0c",
                                                "sense_id": "5b75e0a6-e0f8-3ccd-981c-c4496b9225c5",
                                                "text": "La scène de la réconciliation, où Béatrix fit rejurer haine à l’épouse qui jouait, dit-elle, la comédie du lait répandu, se passa dans un vrai bocage où elle minaudait environnée de fleurs ravissantes, de jardinières d’un luxe effréné."
                                            },
                                            {
                                                "example_id": "24c48756-46c3-4c42-a738-1354d2f9f8b7",
                                                "sense_id": "5b75e0a6-e0f8-3ccd-981c-c4496b9225c5",
                                                "text": "Un ravissant cimetière, tout gai, tout ensoleillé, tout fleuri de clématites et de roses entoure l'église ; […]."
                                            },
                                            {
                                                "example_id": "9f3de8bc-b9ea-4d67-a594-54efdce622f6",
                                                "sense_id": "5b75e0a6-e0f8-3ccd-981c-c4496b9225c5",
                                                "text": "Ses airs penchés, sa ravissante et luxueuse pochette de soie, son bracelet montre en or, le fard étalé sur ses joues le tenaient quitte de manifester son opinion."
                                            },
                                            {
                                                "example_id": "939b0925-ba62-4182-8857-9b99012aae1a",
                                                "sense_id": "5b75e0a6-e0f8-3ccd-981c-c4496b9225c5",
                                                "text": "Et tout près de là, à Saint-Hilaire-de-Loulay, au cours d'une garden-party chez la Baronne Taylor, il est présenté à une ravissante jeune fille de 18 ans, Simone Calary de Lamazière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ravissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdca86fa-4f59-3ad6-92fb-b75f7df3bc32",
                                        "entry_id": "cb2866ed-f26f-3d1e-b9e4-cda1cdbe7908",
                                        "glosses": [
                                            "Participe présent de ravir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4ded9f84-e79a-3cc3-91b1-065ae116bc10",
                                        "entry_id": "cb2866ed-f26f-3d1e-b9e4-cda1cdbe7908",
                                        "glosses": [
                                            "Se dit du loup, renard ou goupil représenté rampant et non passant comme à l’ordinaire."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de997712-c5e6-4c64-a5d4-e5ceca9970d9",
                                                "sense_id": "4ded9f84-e79a-3cc3-91b1-065ae116bc10",
                                                "text": "Parti : en 1) coupé, de gueules à une croix de Malte alésée d’argent, et d’azur à un épi de blé d’or posé en bande ; en 2) d’argent à un goupil ravissant au naturel, qui est de La Croix-en-Brie → voir illustration « goupil ravissant »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
