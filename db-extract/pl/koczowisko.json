                    },
                    {
                        "sense_id": "3cc88200-58d2-3512-ac43-2ac4fca0a2d2",
                        "entry_id": "fd44d2dc-bdd4-3922-b38e-55b6b2c0d09d",
                        "glosses": [
                            "miejsce, w którym ludzie (np. uchodźcy) są zmuszeni do przebywania tymczasowo, zwłaszcza w złych warunkach"
                        ],
                        "tags": [
