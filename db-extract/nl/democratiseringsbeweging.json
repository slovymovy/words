                        "examples": [
                            {
                                "example_id": "238d7fbc-7465-4cd8-8fa3-1e42aa082309",
                                "sense_id": "6a3cd35c-c0f8-35b9-b835-af6b1574769b",
                                "text": "Fennema kwam zoals velen bij de CPN door zijn afkeer van de Vietnamoorlog en doordat hij in de greep raakte van de 'democratiseringsbeweging' aan de universiteiten. In Amsterdam was hij een van de studenten die de strijd aanbonden met hoogleraar politicologie Hans Daudt, die de 'alleenheerschappij' van de hoogleraren verdedigde tegen de aanspraken op medezeggenschap van de studenten."
                            },
                            {
                                "example_id": "760dac45-a1ac-4704-afa6-92c8e7935753",
                                "sense_id": "6a3cd35c-c0f8-35b9-b835-af6b1574769b",
                                "text": "In Hongkong hebben tienduizenden mensen het bloedige neerslaan van de democratiseringsbeweging in China herdacht. Vandaag is het precies dertig jaar geleden dat ordetroepen een eind maakten aan de al zeven weken durende demonstraties op het Tiananmenplein in Peking. Daarbij vielen honderden en mogelijk zelfs duizenden doden."
                            },
                            {
                                "example_id": "de84f90e-a79c-46a6-b89a-1bcd421caf08",
                                "sense_id": "6a3cd35c-c0f8-35b9-b835-af6b1574769b",
                                "text": "In het verleden schreef hij nummers over corruptie en sociaal onrecht in Marokko. Belghouat is betrokken bij de democratiseringsbeweging in zijn land."
                            }
                        ]
                    }
