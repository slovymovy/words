    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15e6fb32-0251-3d9c-bb2f-c0b24c5b8724",
                    "sense_definition": "A felt-tipped pen used for writing or drawing.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "writing_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't use the permanent <w>marker</w> on the whiteboard.",
                            "target_lang_translations": {
                                "ru": "Не используйте перманентный <w>маркер</w> на белой доске.",
                                "zh": "不要在白板上使用永久性<w>记号笔</w>。"
                            }
                        },
                        {
                            "text": "She used a red <w>marker</w> to highlight the important dates on the calendar.",
                            "target_lang_translations": {
                                "ru": "Она использовала красный <w>маркер</w>, чтобы выделить важные даты в календаре.",
                                "zh": "她用红色的<w>记号笔</w>在日历上标出了重要的日期。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "permanent marker",
                        "dry-erase marker",
                        "felt-tip marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фломастер, используемый для письма или рисования.",
                        "zh": "一种用于书写或绘画的毡尖笔。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркер",
                                "target_lang_sense_clarification": "инструмент для письма"
                            },
                            {
                                "target_lang_word": "фломастер",
                                "target_lang_sense_clarification": "для рисования или выделения текста"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "记号笔",
                                "target_lang_sense_clarification": "用于书写或标记的笔"
                            },
                            {
                                "target_lang_word": "马克笔",
                                "target_lang_sense_clarification": "常用于绘画或设计的笔"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0d0534c-72d8-321e-8b92-fba462dc99b6",
                    "sense_definition": "An object used to indicate a position, boundary, or route.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "indicators",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers followed the trail <w>markers</w> to find their way back to the camp.",
                            "target_lang_translations": {
                                "ru": "Туристы следовали за <w>указателями</w> на тропе, чтобы найти дорогу обратно в лагерь.",
                                "zh": "徒步旅行者沿着小径的<w>路标</w>找到了回营地的路。"
                            }
                        },
                        {
                            "text": "We placed a stone <w>marker</w> at the edge of our property.",
                            "target_lang_translations": {
                                "ru": "Мы установили каменную <w>метку</w> на границе нашего участка.",
                                "zh": "我们在土地边缘放置了一块石头作为<w>界标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "trail marker",
                        "boundary marker",
                        "mile marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, используемый для обозначения позиции, границы или маршрута.",
                        "zh": "用于指示位置、边界或路线的物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указатель",
                                "target_lang_sense_clarification": "знак направления или места"
                            },
                            {
                                "target_lang_word": "метка",
                                "target_lang_sense_clarification": "знак для отличия или обозначения"
                            },
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "для навигации"
                            },
                            {
                                "target_lang_word": "веха",
                                "target_lang_sense_clarification": "столб или знак границы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "用于识别位置或边界的物体"
                            },
                            {
                                "target_lang_word": "路标",
                                "target_lang_sense_clarification": "用于指示路线的标志"
                            },
                            {
                                "target_lang_word": "界标",
                                "target_lang_sense_clarification": "用于划分边界的标志"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a06efa2-8995-35a2-acd4-26d19da5a322",
                    "sense_definition": "A person who assigns grades or marks to students' work.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exam <w>marker</w> was very strict and gave few high scores.",
                            "target_lang_translations": {
                                "ru": "<w>Экзаменатор</w> был очень строг и поставил мало высоких баллов.",
                                "zh": "这位<w>阅卷人</w>非常严格，很少给出高分。"
                            }
                        },
                        {
                            "text": "I am a hard <w>marker</w> when it comes to checking spelling errors.",
                            "target_lang_translations": {
                                "ru": "Я строгий <w>проверяющий</w>, когда дело касается орфографических ошибок.",
                                "zh": "在检查拼写错误时，我是一个严格的<w>评分员</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hard marker",
                        "exam marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который выставляет оценки или проверяет работы студентов.",
                        "zh": "负责给学生作业评分或批改的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экзаменатор",
                                "target_lang_sense_clarification": "проверяющий работы"
                            },
                            {
                                "target_lang_word": "проверяющий",
                                "target_lang_sense_clarification": "лицо, оценивающее работу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阅卷人",
                                "target_lang_sense_clarification": "负责批改试卷的人"
                            },
                            {
                                "target_lang_word": "评分员",
                                "target_lang_sense_clarification": "负责给作业或考试打分的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "168ae41c-1b3b-3692-abc1-e941cc948cc7",
                    "sense_definition": "An action or event that serves as a sign of progress or intent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_signs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's early goal put down a <w>marker</w> for the rest of the match.",
                            "target_lang_translations": {
                                "ru": "Ранний гол команды стал <w>заявкой</w> на победу в остальной части матча.",
                                "zh": "球队早早进球，为整场比赛定下了<w>基调</w>。"
                            }
                        },
                        {
                            "text": "This new policy is a <w>marker</w> for how the company plans to grow.",
                            "target_lang_translations": {
                                "ru": "Эта новая политика является <w>показателем</w> того, как компания планирует развиваться.",
                                "zh": "这项新政策是公司未来发展计划的一个<w>信号</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "put down a marker",
                        "set a marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или событие, служащее признаком прогресса или намерения.",
                        "zh": "作为进展或意图标志的行动或事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "признак состояния"
                            },
                            {
                                "target_lang_word": "индикатор",
                                "target_lang_sense_clarification": "знак изменений"
                            },
                            {
                                "target_lang_word": "заявка",
                                "target_lang_sense_clarification": "демонстрация намерений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "具有象征意义的事件"
                            },
                            {
                                "target_lang_word": "信号",
                                "target_lang_sense_clarification": "显示某种意图或趋势的迹象"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c097afa0-7b8f-34f4-84d2-81400b912815",
                    "sense_definition": "A defensive player whose job is to stay close to an opponent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker managed to escape his <w>marker</w> and score a goal.",
                            "target_lang_translations": {
                                "ru": "Нападающему удалось уйти от своего <w>опекуна</w> и забить гол.",
                                "zh": "前锋成功摆脱了他的<w>盯防者</w>并打进一球。"
                            }
                        },
                        {
                            "text": "He is a very tight <w>marker</w> who never leaves the opponent alone.",
                            "target_lang_translations": {
                                "ru": "Он очень плотный <w>защитник</w>, который ни на шаг не отходит от соперника.",
                                "zh": "他是一名防守非常紧密的<w>防守队员</w>，从不让对手有空档。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tight marker",
                        "escape your marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитник, чья задача — плотно опекать соперника.",
                        "zh": "体育比赛中负责紧盯对手的防守队员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опекун",
                                "target_lang_sense_clarification": "в спорте, защитник"
                            },
                            {
                                "target_lang_word": "защитник",
                                "target_lang_sense_clarification": "персонально прикрепленный к игроку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盯防者",
                                "target_lang_sense_clarification": "负责贴身防守的球员"
                            },
                            {
                                "target_lang_word": "防守队员",
                                "target_lang_sense_clarification": "负责防守特定对手的球员"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97efa65d-9e1e-3749-aea1-2bee417f5b08",
                    "sense_definition": "A personal favor or debt that is owed to someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "debts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided it was time to call in some <w>markers</w> to get the deal done.",
                            "target_lang_translations": {
                                "ru": "Он решил, что пришло время потребовать ответных <w>услуг</w>, чтобы закрыть сделку.",
                                "zh": "他决定是时候要求别人还他<w>人情</w>以促成这笔交易了。"
                            }
                        },
                        {
                            "text": "I owe him a <w>marker</w> for helping me out last year.",
                            "target_lang_translations": {
                                "ru": "Я его <w>должник</w> за то, что он выручил меня в прошлом году.",
                                "zh": "他去年帮了我大忙，我欠他一个人情<w>债</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "call in a marker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in political or business contexts regarding favors."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личная услуга или долг, который кто-то обязан вернуть.",
                        "zh": "欠某人的个人人情或债务。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "должок",
                                "target_lang_sense_clarification": "ответная услуга"
                            },
                            {
                                "target_lang_word": "обязательство",
                                "target_lang_sense_clarification": "моральный долг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "人情债",
                                "target_lang_sense_clarification": "欠下的人情"
                            },
                            {
                                "target_lang_word": "恩情",
                                "target_lang_sense_clarification": "需要回报的帮助"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b71c0814-8623-39b5-85b7-7a0a47a0f28e",
                    "sense_definition": "An informal written record of a debt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "debts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gambler left a <w>marker</w> at the table because he ran out of cash.",
                            "target_lang_translations": {
                                "ru": "Игрок оставил <w>расписку</w> за столом, потому что у него закончились наличные.",
                                "zh": "赌徒因为现金用完了，在桌上留下了一张<w>欠条</w>。"
                            }
                        },
                        {
                            "text": "He had several outstanding <w>markers</w> at the local casino.",
                            "target_lang_translations": {
                                "ru": "У него было несколько непогашенных <w>долгов</w> в местном казино.",
                                "zh": "他在当地赌场有几笔未偿还的<w>债务</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "IOU"
                    ],
                    "common_phrases": [
                        "casino marker"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Common in gambling contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неофициальная долговая расписка.",
                        "zh": "非正式的债务书面记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "долговая расписка",
                                "target_lang_sense_clarification": "запись о долге"
                            },
                            {
                                "target_lang_word": "долговой жетон",
                                "target_lang_sense_clarification": "в казино"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "欠条",
                                "target_lang_sense_clarification": "书面的债务凭证"
                            },
                            {
                                "target_lang_word": "筹码",
                                "target_lang_sense_clarification": "赌场中代表债务的凭证"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2fd655f-1bac-3ef5-ac6e-d9090176267e",
                    "sense_definition": "A substance or gene used to identify a biological condition or species.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Doctors look for specific genetic <w>markers</w> to determine the risk of disease.",
                            "target_lang_translations": {
                                "ru": "Врачи ищут специфические генетические <w>маркеры</w>, чтобы определить риск заболевания.",
                                "zh": "医生寻找特定的遗传<w>标记</w>来确定患病风险。"
                            }
                        },
                        {
                            "text": "The blood test revealed several inflammatory <w>markers</w> in the patient.",
                            "target_lang_translations": {
                                "ru": "Анализ крови выявил у пациента несколько <w>показателей</w> воспаления.",
                                "zh": "血液检查显示患者体内有几个炎症<w>指标</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "genetic marker",
                        "biological marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или ген, используемые для идентификации биологического состояния или вида.",
                        "zh": "用于识别生物状况或物种的物质或基因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маркер",
                                "target_lang_sense_clarification": "биологический или генетический"
                            },
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "биологический признак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标记",
                                "target_lang_sense_clarification": "生物学上的识别特征"
                            },
                            {
                                "target_lang_word": "指标",
                                "target_lang_sense_clarification": "用于衡量某种生理状态的参数"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "577712b5-d729-3c50-bc31-ade670e520fc",
                    "sense_definition": "A word or part of a word that shows a grammatical relationship.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many languages, the plural <w>marker</w> is added to the end of the noun.",
                            "target_lang_translations": {
                                "ru": "Во многих языках <w>показатель</w> множественного числа добавляется в конец существительного.",
                                "zh": "在许多语言中，复数<w>标记</w>被加在名词的末尾。"
                            }
                        },
                        {
                            "text": "The suffix acts as a tense <w>marker</w> in this sentence.",
                            "target_lang_translations": {
                                "ru": "Суффикс выступает в качестве <w>маркера</w> времени в этом предложении.",
                                "zh": "在这个句子中，后缀起到了时态<w>标记</w>的作用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grammatical marker",
                        "tense marker",
                        "plural marker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Слово или часть слова, указывающая на грамматическую связь.",
                        "zh": "表示语法关系的词或词的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показатель",
                                "target_lang_sense_clarification": "грамматический признак"
                            },
                            {
                                "target_lang_word": "маркер",
                                "target_lang_sense_clarification": "лингвистический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "标记",
                                "target_lang_sense_clarification": "语言学中表示语法功能的成分"
                            },
                            {
                                "target_lang_word": "标志",
                                "target_lang_sense_clarification": "表示某种语法范畴的词缀或词"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "202dba82-3edf-3763-8ae7-0ee7a8d8c34d",
                    "sense_definition": "To write on or color something using a <w>marker</w> pen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "writing_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Someone had <w>markered</w> a message on the wall of the hallway.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>написал маркером</w> сообщение на стене в коридоре.",
                                "zh": "有人在走廊的墙上用记号笔<w>写</w>了一条信息。"
                            }
                        },
                        {
                            "text": "The child <w>markered</w> all over his notebook during the lesson.",
                            "target_lang_translations": {
                                "ru": "Ребенок весь <w>изрисовал маркером</w> свой блокнот во время урока.",
                                "zh": "上课时，孩子把他的笔记本上到处都<w>涂画</w>了记号。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "The verb form is less common than the noun."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Писать или раскрашивать что-либо с помощью маркера.",
                        "zh": "用记号笔在某物上书写或涂画。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "писать маркером",
                                "target_lang_sense_clarification": "использовать фломастер"
                            },
                            {
                                "target_lang_word": "разрисовывать",
                                "target_lang_sense_clarification": "покрывать надписями"
                            }
                        ],
