{
    "word_family": [
        "croupissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1be5574d-a629-36ef-adc5-ed62fe552ebe",
                    "sense_definition": "Stagner et se corrompre en dégageant une mauvaise odeur, en parlant de l'eau ou d'un liquide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stagnation_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'eau du vieux puits <w>croupit</w> depuis des années et sent très mauvais."
                        },
                        {
                            "text": "Il faut vider les pots de fleurs pour éviter que l'eau ne <w>croupisse</w> au soleil."
                        }
                    ],
                    "synonyms": [
                        "stagner",
                        "pourrir"
                    ],
                    "antonyms": [
                        "couler",
                        "circuler"
                    ],
                    "common_phrases": [
                        "eau qui croupit",
                        "laisser croupir de l'eau"
                    ]
                },
                {
                    "sense_id": "11b76c07-e486-32e7-b578-e019f235d833",
                    "sense_definition": "Demeurer longtemps dans un état de déchéance, d'inaction, de misère ou en captivité sans pouvoir en sortir.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stagnation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prisonnier a <w>croupi</w> pendant dix ans au fond d'un cachot humide."
                        },
                        {
                            "text": "Cette population défavorisée est condamnée à <w>croupir</w> dans la misère la plus totale."
                        }
                    ],
                    "synonyms": [
                        "végéter",
                        "pourrir"
                    ],
                    "antonyms": [
                        "s'épanouir",
                        "progresser"
                    ],
                    "common_phrases": [
                        "croupir en prison",
                        "croupir dans la misère",
                        "croupir dans l'ignorance"
                    ]
                },
                {
                    "sense_id": "a3eac42a-27a2-3219-a965-454d22a87b5a",
                    "sense_definition": "Se décomposer ou pourrir après avoir séjourné longtemps dans un liquide stagnant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stagnation_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les feuilles mortes tombées dans la mare <w>croupissent</w> au fil des mois."
                        },
                        {
                            "text": "De vieux morceaux de bois <w>croupissaient</w> au fond du fossé inondé."
                        }
                    ],
                    "synonyms": [
                        "se décomposer",
                        "pourrir"
                    ]
                },
                {
                    "sense_id": "18807622-63b6-3f52-9eb4-18d6a63b7b00",
                    "sense_definition": "Rester couché ou abandonné dans la saleté, la crasse ou ses propres déjections.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stagnation_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas laisser ce malade <w>croupir</w> ainsi dans ses draps souillés."
                        },
                        {
                            "text": "Dans cet asile insalubre, les pensionnaires abandonnés <w>croupissaient</w> sur des paillasses immondes."
                        }
                    ],
                    "common_phrases": [
                        "croupir dans la saleté"
                    ]
                }
            ]
        }
    ]
}