                ],
                "senses": [
                    {
                        "sense_id": "73c41823-4d53-380b-8dca-a8ff0695a89a",
                        "entry_id": "fcd99ca3-647e-3d5f-af41-1fae54044f56",
                        "glosses": [
                            "A match in which one opponent is greatly superior to the other."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db90a0cc-220a-4642-b5f1-0a3def4a6559",
                                "sense_id": "73c41823-4d53-380b-8dca-a8ff0695a89a",
                                "text": "[…] we can increase the velocity of that force, so as to make it an overmatch for its antagonist."
                            }
                        ]
                    },
                    {
                        "sense_id": "39814f54-29a3-3e78-8108-b10ca73690e3",
                        "entry_id": "fcd99ca3-647e-3d5f-af41-1fae54044f56",
                        "glosses": [
                            "An opponent who is more than a match for another; one who cannot be defeated."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0643d5d-1619-4b7e-8326-cf65d800ae69",
                                "sense_id": "39814f54-29a3-3e78-8108-b10ca73690e3",
                                "text": "For Memnon […] fought hand to hand with his overmatch, and met his boyish and most dolorous death beneath the walls of Troy."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
