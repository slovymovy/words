                "senses": [
                    {
                        "sense_id": "1534189c-88cf-3d76-9959-dcc1ec73436a",
                        "entry_id": "07ead9f9-d1c3-3fd8-8d5b-6278dfdd0f90",
                        "glosses": [
                            "aus einfachen Materialien wie Wellblech, Holz oder Pappe hergestellte behelfsmäßige Unterkunft, die der Zusammenkunft von Gläubigen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cac275a-6f60-4b97-8683-038877ac61c9",
                                "sense_id": "1534189c-88cf-3d76-9959-dcc1ec73436a",
                                "text": "„Die Geschichte der Barackenkirche in Nöstlbach (Gemeinde St. Marien, Bezirk Linz-Land) ist nicht einwandfrei geklärt.“"
                            },
                            {
                                "example_id": "9d996d23-3654-43af-85b2-3c04ea906c21",
                                "sense_id": "1534189c-88cf-3d76-9959-dcc1ec73436a",
                                "text": "„Ursprünglich sollte Holz aus dem Schwarzwald für die Fertigung von Barackenkirchen gekauft werden.“"
                            },
                            {
                                "example_id": "a2a2d418-fe38-499e-b2eb-035586948af2",
                                "sense_id": "1534189c-88cf-3d76-9959-dcc1ec73436a",
                                "text": "„Die eifrige Kirchgängerin kam mehrmals in der Woche mit dem Gebetbuch in der Hand auf ihrem Weg zur Barackenkirche die Bahnhofstraße herunter.“"
                            },
                            {
                                "example_id": "4b96f4e6-fd3c-47d0-b908-f7ffa4c057ef",
                                "sense_id": "1534189c-88cf-3d76-9959-dcc1ec73436a",
                                "text": "„An die Jahre, in denen die katholische Gemeinde nur über die Barackenkirche verfügte, erinnert eine auf Blech gemalte Ikone »Unsere liebe Frau«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
