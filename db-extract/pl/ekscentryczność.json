                "translations": [
                    {
                        "translation_id": "11a5c738-cf26-4f06-b375-890fe7301cad",
                        "source_entry_id": "4c5c47f3-8f10-3c7a-bf3e-11fcd410e371",
                        "source_sense_id": "68909bc6-d0de-336c-b586-03cf7e9adbff",
                        "target_lang_word": "eccentricity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eccentricity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a5034fbb-7c64-3163-b356-c893a02b93e8",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The quality of being eccentric or odd; any eccentric behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "339b790b-90c8-4746-bba0-63d487be8686",
                                                "sense_id": "a5034fbb-7c64-3163-b356-c893a02b93e8",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "727e160a-eec2-3b86-91c5-aa65573f1403",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The ratio, constant for any particular conic section, of the distance of a point from the focus to its distance from the directrix."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3129855c-1edf-4f53-a657-04d4ede9f78b",
                                                "sense_id": "727e160a-eec2-3b86-91c5-aa65573f1403",
                                                "text": "For an ellipse, the eccentricity is the ratio of the distance from the center to a focus divided by the length of the semi-major axis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ec51835-1b39-3aa8-adfd-98d6a9cbe05c",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The eccentricity of the conic section (usually an ellipse) defined by the orbit of a given object around a reference object (such as that of a planet around the sun)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "14b85c92-d9dc-38b6-b484-3423297e826b",
                                        "entry_id": "032e667a-6f02-368e-9e76-3a49ec346554",
                                        "glosses": [
                                            "The farthest distance from a vertex to any other vertex."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
