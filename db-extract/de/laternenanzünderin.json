                ],
                "senses": [
                    {
                        "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                        "entry_id": "033aab75-00d0-3522-b30e-117f921ec4c6",
                        "glosses": [
                            "städtische Angestellte, die bei Einbruch der Dunkelheit die Straßenlaternen anzündet"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c9a07644-2026-4ad5-a2de-7e732dd0f04f",
                                "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                                "text": "„Infolge des Rücktritts der seitherigen Laternenanzünderin Wiedemann wird laut Ausschreibung im magistratischen ‚Wochenblatt‘ zur Besorgung der Bedienung der Petroleumstraßenlaternen dahier eine verlässige Person gesucht.“"
                            },
                            {
                                "example_id": "90818bb9-98b2-46d0-9aa0-72a3f29dcb8e",
                                "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                                "text": "„In der Stadt Coburg hatte sich eine Laternenanzünderin bei der Bedienung einer Petroleumlaterne durch Sturz von der Leiter eine Knieverletzung zugezogen.“"
                            },
                            {
                                "example_id": "38f4ae27-7809-4648-87fd-9e540feb809d",
                                "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                                "text": "„Als eines von zwei Kölner Toren besaß es überhaupt eine Beleuchtung. Die dafür vorgesehenen (Öl-)Laternen fachte im 14. Jahrhundert für einige Jahre eine Laternenanzünderin, eine ›candelatrix‹, an.“"
                            },
                            {
                                "example_id": "1f3bde8f-8a79-4ff2-ac78-d1698b56a8c6",
                                "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                                "text": "„Frau Nele Schubart ist keine Laternenanzünderin, sie ist eine Laternenkaputtmacherin.“"
                            },
                            {
                                "example_id": "1cd58e98-312f-407e-9454-4bed8686988c",
                                "sense_id": "ebbfed00-93ca-3ea5-b315-ff296c5607b6",
                                "text": "„Das Öl wurde jeden Abend unter sie ausgeteilt, und beim Eintreten der Dämmerung fanden sie sich zu diesem Zwecke an gewissen Orten ein und verkürzten sich die Zeit, bis sie ihr Öl erhielten und an die Arbeit gehen konnten, mit allerlei Bemerkungen über ihr sauer verdientes geringes Brot, wobei sie gewöhnlich versicherten, daß das Amt einer Laternenanzünderin eine langsame Art von Hungertot sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
