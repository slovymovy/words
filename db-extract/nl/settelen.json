        "nl-extract.jsonl": [
            {
                "entry_id": "05a5e87f-1edc-3174-9492-674a65fef05e",
                "word": "settelen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "19e0cfa0-9d24-3831-8812-d105271a54ed",
                        "entry_id": "05a5e87f-1edc-3174-9492-674a65fef05e",
                        "glosses": [
                            "je op een nieuwe plaats gaan vestigen en thuis voelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fed8ee0-a661-405e-8ae0-93ae7fd4f367",
                                "sense_id": "19e0cfa0-9d24-3831-8812-d105271a54ed",
                                "text": "Natuurlijk, er gebeurt meer in de jaren van de grootste vetaanwas. Samenwonen, settelen, kinderen, vaker uit eten, stoppen met de sportvereniging. Veel daarvan heeft te maken met de tijd die je kwijt bent om acht uur per dag op kantoor te zitten."
                            },
                            {
                                "example_id": "3348aed0-7f18-4521-8f31-98f5749b7358",
                                "sense_id": "19e0cfa0-9d24-3831-8812-d105271a54ed",
                                "text": "Willen wij ons als mensen gaan settelen op de maan, dan moeten er speciale maanmodules gebouwd worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "a510397b-3e8b-388b-9255-ff0779e7df5d",
                        "entry_id": "05a5e87f-1edc-3174-9492-674a65fef05e",
                        "glosses": [
                            "zaken een vaste plaats geven en permanent regelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a51c818-fc69-41ac-b262-d843a66e21c8",
                                "sense_id": "a510397b-3e8b-388b-9255-ff0779e7df5d",
                                "text": "Nu millennials kinderen krijgen en zich gaan settelen, merkt Unilever dat de hang naar zekerheid bij hen toeneemt. „Veel mensen komen in een fase dat ze kinderen krijgen, gaan trouwen,” zegt Zeegers. „En daar hoort bij dat je zekerheid zoals een vast contract wat belangrijker gaat vinden.” Ze ziet niet veel verschillen tussen wat de generatie Y belangrijk vond en hoe de generaties voor hen daarover dachten."
                            }
                        ]
                    }
                ],
