                            {
                                "example_id": "4c5c6727-5a30-4b96-a780-c8be1eaa15a1",
                                "sense_id": "174dc5c8-a04a-3206-9f2d-abd140832e83",
                                "text": "There were outflankings and crownings of hills by numbers of thirteen and seventeen men, that made one hold one's breath."
