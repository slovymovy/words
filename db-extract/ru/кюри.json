                                "target_senses": [
                                    {
                                        "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                        "entry_id": "7e54cbfa-424d-3cbc-8acc-6e64cc261331",
                                        "glosses": [
                                            "Subdivision de la tribu chez les Romains."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "993675f0-1b46-4212-bc9a-3ea849e171e6",
                                                "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                                "text": "Romulus partagea le peuple romain en trois tribus, et chaque tribu en dix curies ; mais il n’y avait de curies que pour le peuple de l’enceinte de Rome ; et voter par curies, c’était voter en appelant seulement au vote les gens de la ville."
                                            },
                                            {
                                                "example_id": "bb24f966-f93b-4f99-8867-af46046f602e",
                                                "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                                "text": "Le peuple chercha toujours à faire par curies les assemblées qu’on avait coutume de faire par centuries, et à faire par tribus les assemblées qui se faisaient par curies."
                                            },
                                            {
                                                "example_id": "65b22340-3e35-4fc4-96cc-2f6c0ec9d48f",
                                                "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                                "text": "Comices par curie, l’assemblée des patriciens."
                                            },
                                            {
                                                "example_id": "64877082-fcc7-4c18-93e1-f6461053dc93",
                                                "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                                "text": "Les curies n’étaient composées que de gentes [familles] patriciennes ; elles se rassemblaient dans le Comitium."
                                            },
                                            {
                                                "example_id": "50b1b3bf-9873-461e-bd6d-442f8d6d52a9",
                                                "sense_id": "b2ba0d6c-5911-384e-9fbc-51d482ad5a9b",
                                                "text": "Chaque curie avait une voix qui exprimait l’opinion de la majorité de ses membres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68bb8109-f7b0-3556-a89b-f5f0bb441908",
                                        "entry_id": "7e54cbfa-424d-3cbc-8acc-6e64cc261331",
                                        "glosses": [
                                            "Subdivision de la tribu chez les Romains.",
                                            "Lieu où s’assemblaient les comices curiates et où s'assembla ultérieurement le sénat romain."
                                        ],
                                        "tags": [
