                                    },
                                    {
                                        "sense_id": "33d20155-2f59-3b24-9bd6-82d7047ea8de",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "Any of many tens of thousands of species of herbivorous beetles of various sizes, in the family Curculionidae within the superfamily Curculionoidea."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83ee494d-f684-3d98-ba70-37c4f0310faa",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "Any of many similar, but more distantly related, beetles such as the biscuit weevil (Stegobium paniceum)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7b11d5e-bead-369b-ad4d-18a80c981300",
                                        "entry_id": "adba09a8-597a-3068-b1e7-72f2d27f1dbb",
                                        "glosses": [
                                            "A loathsome person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
