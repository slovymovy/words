                        "examples": [
                            {
                                "example_id": "b97fcf8d-b0aa-4881-8f71-69998ce5ce1a",
                                "sense_id": "565e2bd2-1879-3dfb-80c3-891f01379a51",
                                "text": "Mensen in de rij twitterden vanochtend dat er vanwege de drukte opstootjes ontstonden en mensen flauwvielen. De autoriteiten in Oberhausen richtten een ambulancepost in. Ook zagen mensen in de drukte kans om een iPhone mee te nemen zonder af te rekenen."
                            },
                            {
                                "example_id": "111e931f-3e3f-4a0e-a21b-dce18c82dda6",
                                "sense_id": "565e2bd2-1879-3dfb-80c3-891f01379a51",
                                "text": "In grote gemeenten en in steden zijn ambulances vaak wel op tijd, maar op het platteland moeten mensen vaak lang wachten. Daar zijn minder ambulanceposten en moeten grotere afstanden worden afgelegd, waardoor de aanrijtijd langer is. Het is te duur om in iedere gemeente een ambulancepost te plaatsen."
                            }
                        ]
