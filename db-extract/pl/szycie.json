                                "target_senses": [
                                    {
                                        "sense_id": "2bd8cacc-1216-35da-aa2d-7cd8c2945fae",
                                        "entry_id": "6729f811-810f-33b4-b5e0-e6ffde5d4bb0",
                                        "glosses": [
                                            "The action of the verb to sew."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                        "entry_id": "6729f811-810f-33b4-b5e0-e6ffde5d4bb0",
                                        "glosses": [
                                            "Something that is being or has been sewn."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fa831e3-aab0-431c-a161-4399d3469880",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "She put down her sewing and went to answer the door."
                                            },
                                            {
                                                "example_id": "cea91a43-fa9b-4188-8cc0-d1d2a01a6368",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "The sewing has come undone on this seam."
                                            },
                                            {
                                                "example_id": "f0d21827-faa3-4453-8824-42180f759e1f",
                                                "sense_id": "64b8f6fb-05ed-3355-a275-e3557aefd007",
                                                "text": "Mrs. Flanders had left her sewing on the table. There were her large reels of white cotton and her steel spectacles; her needle-case; her brown wool wound round an old postcard."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "901feee4-3260-4ab7-aa54-faaf2e7919b2",
                        "source_entry_id": "0036a8c7-840f-368c-8827-1669815b1449",
                        "source_sense_id": "7cc1be45-7358-3c2a-a84c-0b6db501c55a",
                        "target_lang_word": "Nähen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nähen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73133782-1737-312f-9a40-f3af24b8787c",
                                        "entry_id": "a699dc56-1f94-3544-8be4-a2a2801f6481",
                                        "glosses": [
                                            "das Anfertigen von Kleidungsstücken und Gebrauchsgegenständen (meist) aus Stoff und mit Hilfe einer Nadel und eines Fadens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6428519c-979b-43fa-8d33-6e5d99076531",
                                                "sense_id": "73133782-1737-312f-9a40-f3af24b8787c",
                                                "text": "Beim Nähen brauche ich gutes Licht."
                                            },
                                            {
                                                "example_id": "f51faa5c-1e97-4bda-83af-23b8300428b5",
                                                "sense_id": "73133782-1737-312f-9a40-f3af24b8787c",
                                                "text": "Kochen und Nähen gehören zu den Ausbildungsinhalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff253074-eb50-4e4b-8c37-84f00a48a5d8",
                        "source_entry_id": "0036a8c7-840f-368c-8827-1669815b1449",
                        "source_sense_id": "7cc1be45-7358-3c2a-a84c-0b6db501c55a",
                        "target_lang_word": "шитьё",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шитьё",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f98d1e65-fb66-3b76-978f-96519fb13d7a",
                                        "entry_id": "967f3313-4f31-31aa-9e74-67cfab4a6cf4",
                                        "glosses": [
                                            "действие по значению гл. шить; скрепление, соединение (обычно ниткой с помощью иглы) краёв ткани, кожи и т.п.; изготовление чего-либо таким способом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35c7412c-6b81-4e3f-b370-6f5f2d8d825d",
                                                "sense_id": "f98d1e65-fb66-3b76-978f-96519fb13d7a",
                                                "text": "Пряли да ткали там, шитьё тоже, вязанье да плетенье и разное такое рукоделье."
                                            },
                                            {
                                                "example_id": "943b2cdc-286b-45b6-b510-8ee9fa28d6ed",
                                                "sense_id": "f98d1e65-fb66-3b76-978f-96519fb13d7a",
                                                "text": "Вера принесла ножницы, иголку с нитками, попробовала взяться за шитьё."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a237841-748a-3623-9867-f2428fb4e6c2",
                                        "entry_id": "967f3313-4f31-31aa-9e74-67cfab4a6cf4",
                                        "glosses": [
                                            "разг. то, что шьётся или сшито, вышивается или вышито"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111c01d9-e5b0-4ef4-81c2-d816edbeb091",
                                                "sense_id": "2a237841-748a-3623-9867-f2428fb4e6c2",
                                                "text": "У Тани в руках было шитьё, и она усердно работала, повернувшись в профиль к Андрею."
                                            },
                                            {
                                                "example_id": "ee06fd1a-f86c-4f34-aa33-bc8cff99c395",
                                                "sense_id": "2a237841-748a-3623-9867-f2428fb4e6c2",
                                                "text": "Келарь Агафоник, отозвав полковника, торопливо сунул ему монастырского шитья кошелёк с золотыми."
                                            },
                                            {
                                                "example_id": "f312a0ac-840c-4cad-a504-c65bfa8fb3cb",
                                                "sense_id": "2a237841-748a-3623-9867-f2428fb4e6c2",
                                                "text": "В углу под настольной лампой стоял чёрный с золотом зингер, драпированный складками неоконченного шитья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe35355-5b31-3c30-9402-5b57811c0f65",
                                        "entry_id": "967f3313-4f31-31aa-9e74-67cfab4a6cf4",
                                        "glosses": [
                                            "вышивание, расшивание, украшение ткани, одежды и т. п. с помощью узоров из стежков нитей"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d17bb8ba-4c1f-3a3f-8d98-79e08c6ef7f6",
                                        "entry_id": "967f3313-4f31-31aa-9e74-67cfab4a6cf4",
                                        "glosses": [
                                            "то же, что вышивка; полоса ткани с вышивкой, идущая на отделку одежды, белья и т.п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b96fb546-ab4e-42dd-b82a-b435e379ac25",
                                                "sense_id": "d17bb8ba-4c1f-3a3f-8d98-79e08c6ef7f6",
                                                "text": "Вошли двое молодых дружинников в чёрных рубахах, расшитых золотым шитьём по подолам."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
