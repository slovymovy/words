                    },
                    {
                        "translation_id": "6e25730c-6630-45dd-b69a-2e25caebdafd",
                        "source_entry_id": "838c9ebd-370a-39ba-a4b1-c54b0df4adc1",
                        "source_sense_id": "8fe4bebb-94c1-3874-bff8-783fed7e75d6",
                        "target_lang_word": "étude",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f7ddf12-0b60-3fbe-99ef-44adc48a75a0",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Apprentissage, travail pour apprendre ou approfondir des savoirs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f94c87-de3b-4f51-937b-d8c4e3237cd8",
                                                "sense_id": "1f7ddf12-0b60-3fbe-99ef-44adc48a75a0",
                                                "text": "Pour l’étude du comportement du vacuome au cours de la phagocytose, c'est l'amidon de riz qui représente le matériel phagocytaire le plus commode."
                                            },
                                            {
                                                "example_id": "20d866af-ff91-49be-adbe-9301c694b3a0",
                                                "sense_id": "1f7ddf12-0b60-3fbe-99ef-44adc48a75a0",
                                                "text": "J'estimais fort l’éloquence, et j'étais amoureux de la poésie ; mais je pensais que l’une et l’autre étaient des dons de l’esprit plutôt que des fruits de l’étude."
                                            },
                                            {
                                                "example_id": "1187aa6f-2903-4067-a124-a385713cee0e",
                                                "sense_id": "1f7ddf12-0b60-3fbe-99ef-44adc48a75a0",
                                                "text": "L'étude a été pour moi le souverain remède contre les dégoûts de la vie, n'ayant jamais eu de chagrin qu’une heure de lecture n'ait dissipé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fdcc699-cc89-3c97-a123-a88263139ce3",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Instruction scolaire."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31b51f82-896b-417e-b433-9c4c494bb9a4",
                                                "sense_id": "9fdcc699-cc89-3c97-a123-a88263139ce3",
                                                "text": "Faire de bonnes études ou de mauvaises études."
                                            },
                                            {
                                                "example_id": "2b24f739-4a9e-4f52-8dac-7919d0e740f3",
                                                "sense_id": "9fdcc699-cc89-3c97-a123-a88263139ce3",
                                                "text": "L'abbé d’Olivet avait dirigé au collége des jésuites les premières études de cet écrivain célèbre [Voltaire]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb76ac3b-c465-367f-9882-883687d24526",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Travail préparatoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d0db07-37c3-4b89-8bd3-394f5d845fe9",
                                                "sense_id": "eb76ac3b-c465-367f-9882-883687d24526",
                                                "text": "Quant au lysol, nous avons déjà noté, à plusieurs reprises, ses remarquables propriétés insecticides, en particulier dans nos études sur l’acariose."
                                            },
                                            {
                                                "example_id": "1acfd3c1-be99-43b0-898b-fda9713676ff",
                                                "sense_id": "eb76ac3b-c465-367f-9882-883687d24526",
                                                "text": "D'après une étude réalisée en Côte d’Ivoire, dans les lieux où les éléphants avaient disparu depuis longtemps on ne trouvait plus de plants de certaines espèces forestières qu'ils ont coutume de disséminer (Alexandre, 1978)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0be7e7bb-67db-395d-96d0-7a3eb8072bc7",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Examen préliminaire d’une question ou d’un projet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc210b1f-7ee8-4609-a99a-c12566930e07",
                                                "sense_id": "0be7e7bb-67db-395d-96d0-7a3eb8072bc7",
                                                "text": "Une étude plus large et plus scientifique des dialectes locaux établira que, par son origine et par ses caractères essentiels, le slovaque appartient au groupe yougoslave."
                                            },
                                            {
                                                "example_id": "89b09cca-7bb1-4bd5-bd4e-634943947b7a",
                                                "sense_id": "0be7e7bb-67db-395d-96d0-7a3eb8072bc7",
                                                "text": "Nous allons procéder maintenant à une étude d'ensemble des principaux modèles de déschisteurs automatiques pour bac à piston."
                                            },
                                            {
                                                "example_id": "2c0db9ad-4e14-4051-8be6-a6e8fc09fef7",
                                                "sense_id": "0be7e7bb-67db-395d-96d0-7a3eb8072bc7",
                                                "text": "Le 13 novembre 1970, dans les premiers jours du gouvernement Allende, on réalisa au Chili une étude préliminaire sur les relations militaires de ce pays avec les USA."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5192ddff-d635-3b71-ba1b-226a2d41d73c",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Ébauche préparatoire, dessin, peinture, sculpture, etc., exécuté en préparation d’une œuvre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9bf99b5-46ba-4346-a906-4e3e2ad8291d",
                                                "sense_id": "5192ddff-d635-3b71-ba1b-226a2d41d73c",
                                                "text": "Une étude de draperie, de paysage."
                                            },
                                            {
                                                "example_id": "780c31ee-0ef6-4e44-bc11-aee87ca6c329",
                                                "sense_id": "5192ddff-d635-3b71-ba1b-226a2d41d73c",
                                                "text": "Les études de Raphaël."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b8a36e2-2d02-36f2-88d3-4233ff7070ea",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Composition faite pour exercer au doigté, au jeu d’un instrument."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f50584f0-a47d-4e84-8ccf-270ca99e33f8",
                                                "sense_id": "2b8a36e2-2d02-36f2-88d3-4233ff7070ea",
                                                "text": "Des études pour le violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d4ced94-5b9a-39e7-8e61-fc2407f1a273",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Type d’ouvrage proche de l'essai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "621d7048-b906-4a18-b535-64a31e39b248",
                                                "sense_id": "5d4ced94-5b9a-39e7-8e61-fc2407f1a273",
                                                "text": "Étude sur la musique grecque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38dfd52b-3137-3634-8985-66ed2a4ecdec",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Action d’apprendre par cœur un rôle. On dit plutôt aujourd'hui étudier un rôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358a3af0-56e9-4c96-815d-c2d5424229eb",
                                                "sense_id": "38dfd52b-3137-3634-8985-66ed2a4ecdec",
                                                "text": "Il ne lui est rien arrivé que je ne lui aie prédit à elle-même, en lui disant adieu, quand je sus l’étude qu’elle faisait de ce rôle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "747c8d77-0d9e-3aa5-83d6-ac4a12b463bb",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Lieu de ce travail d’apprentissage, de ce travail intellectuel ; en particulier :"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "900127ef-86f8-363b-9c69-54043fcd78e6",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Lieu de ce travail d’apprentissage, de ce travail intellectuel ; en particulier :",
                                            "Lieu où l’on réunit les élèves pour étudier leurs leçons et faire leurs devoirs. Synonyme : salle d’étude."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d3d95a0-fc68-4436-b4b9-aeec9b48f305",
                                                "sense_id": "900127ef-86f8-363b-9c69-54043fcd78e6",
                                                "text": "Les études de ce collège sont vastes et bien aérées."
                                            },
                                            {
                                                "example_id": "ee0d5eb7-92a4-45a5-866f-b88ac0c563bc",
                                                "sense_id": "900127ef-86f8-363b-9c69-54043fcd78e6",
                                                "text": "Pour arriver à la cour de récréation, il me fallut traverser ce que le surveillant général avait appelé « l’étude ». C’était une classe, où trois colonnes de pupitres à deux places s’avançaient vers une chaire, installée sur une estrade d’une hauteur qui me parut anormale. Contre les murs, à la hauteur de ma tête, une longue rangée de petites armoires mitoyennes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "314c2bf1-2c80-311c-9695-947b1754c94e",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Lieu de ce travail d’apprentissage, de ce travail intellectuel ; en particulier :",
                                            "Bureau d’un notaire, d’un avoué, d’un huissier."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13e73beb-528b-476e-9bf9-591411b0025e",
                                                "sense_id": "314c2bf1-2c80-311c-9695-947b1754c94e",
                                                "text": "Il cède son étude à son premier clerc."
                                            },
                                            {
                                                "example_id": "e4129b2d-184e-4af9-b204-fa7ea52156bd",
                                                "sense_id": "314c2bf1-2c80-311c-9695-947b1754c94e",
                                                "text": "J’allais justement vous écrire pour vous prier de passer à mon étude, afin de vous donner connaissance du testament de M. Vaudrec, qui vous concerne"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4405d831-5e51-371a-8bcf-43fb12b3b1f9",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Lieu de ce travail d’apprentissage, de ce travail intellectuel ; en particulier :",
                                            "Chambre, cabinet où l’on étudie, où l’on compose."
                                        ],
                                        "tags": [
                                            "dated",
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80923352-6a5e-442e-8b01-18a268e98e34",
                                                "sense_id": "4405d831-5e51-371a-8bcf-43fb12b3b1f9",
                                                "text": "Ces vers, produits dans mon étude, Récitent tes commandements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6ea313-64a0-34ca-8222-e7abcc2bfc4d",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Le temps de ces exercices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d24c4e4-e7a5-47ba-a073-17289da8cae1",
                                                "sense_id": "ea6ea313-64a0-34ca-8222-e7abcc2bfc4d",
                                                "text": "L’étude la plus longue est celle du soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1f5061-b551-3b4b-858c-5856745cd751",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Connaissances acquises."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965aa2fb-81e3-4b19-96c4-ceaeb141f502",
                                                "sense_id": "2a1f5061-b551-3b4b-858c-5856745cd751",
                                                "text": "Avoir de l’étude."
                                            },
                                            {
                                                "example_id": "d2cdc3c9-f088-458f-8869-8e2c1bb7eb9a",
                                                "sense_id": "2a1f5061-b551-3b4b-858c-5856745cd751",
                                                "text": "Mais je ne trouve point de fatigue si rude Que l’ennuyeux loisir d’un mortel sans étude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d47c653-b785-35a2-b38e-2d9062388eb3",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Soin particulier que l’on apporte à quelque chose."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6bc289b-a1b5-4d21-bd5a-71ae4523aeef",
                                                "sense_id": "4d47c653-b785-35a2-b38e-2d9062388eb3",
                                                "text": "Je mettrais toute mon étude à rendre ce quelqu'un jaloux."
                                            },
                                            {
                                                "example_id": "1656ff12-825b-4fc6-8781-7ab6522496e1",
                                                "sense_id": "4d47c653-b785-35a2-b38e-2d9062388eb3",
                                                "text": "Elles étaient coiffées avec étude et portaient de fraîches toilettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7435367-d8a6-33da-a4b0-a59527161ccc",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Préméditation."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0db2b6e9-cd36-4435-bd2e-3fe13f0f476f",
                                                "sense_id": "b7435367-d8a6-33da-a4b0-a59527161ccc",
                                                "text": "L’indignation qu’on prend avec étude augmente avec le temps et porte un coup plus rude."
                                            },
                                            {
                                                "example_id": "659db382-6a55-4f31-8f28-4e3ec36ede27",
                                                "sense_id": "b7435367-d8a6-33da-a4b0-a59527161ccc",
                                                "text": "Tranquille en me frappant, barbare avec étude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706d6312-a418-32c0-a7f8-fc1ce9c24cbf",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Objet d’étude, de soin."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a077960-68a4-405a-8ccf-95c0b5f62c55",
                                                "sense_id": "706d6312-a418-32c0-a7f8-fc1ce9c24cbf",
                                                "text": "Votre exemple est partout une étude pour moi."
                                            },
                                            {
                                                "example_id": "edebfae0-ff47-4393-b12f-dc8a8237e289",
                                                "sense_id": "706d6312-a418-32c0-a7f8-fc1ce9c24cbf",
                                                "text": "J'ai […] de l’inquiétude de voir qu’un sot amour fait toute votre étude."
                                            },
                                            {
                                                "example_id": "0bfddc04-49a5-4a55-9d2c-b1239ca1534f",
                                                "sense_id": "706d6312-a418-32c0-a7f8-fc1ce9c24cbf",
                                                "text": "Je me suis fait une étude de cet endroit d’une de vos lettres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df94998d-2cca-376a-9a8a-83ff12cee1cb",
                                        "entry_id": "c3a6b6d8-8624-3bf2-bed4-33746113b29b",
                                        "glosses": [
                                            "Affectation, recherche."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "948abb1a-a4df-4911-9e68-d6eb50735c41",
                                                "sense_id": "df94998d-2cca-376a-9a8a-83ff12cee1cb",
                                                "text": "Que ne puis-je vous représenter cet homme simple et sans étude ?"
                                            },
                                            {
                                                "example_id": "9bb6c621-9e50-44e1-b824-7cb5bce31b2d",
                                                "sense_id": "df94998d-2cca-376a-9a8a-83ff12cee1cb",
                                                "text": "Toute notre vie est une étude de vanité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
