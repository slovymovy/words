                                    {
                                        "sense_id": "29c857b9-4c8d-35a5-864e-5126bfffd23d",
                                        "entry_id": "c5691494-755f-3bca-bdf6-ed6d278f5b85",
                                        "glosses": [
                                            "Partie fixe de nombreuses machines rotatives en particulier d'un moteur électrique, d'une turbine, d'une dynamo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a73cf800-f40d-47ff-855f-2c209e4e704c",
                                                "sense_id": "29c857b9-4c8d-35a5-864e-5126bfffd23d",
                                                "text": "Je lui montre comment on transforme les énergies primaires en énergies secondaires, je lui dessine les turbines, le rotor, le stator, et comment tout ça crée un champ magnétique qui produit un courant électrique."
                                            },
                                            {
                                                "example_id": "5a64a911-609a-4956-b171-987681812f7c",
                                                "sense_id": "29c857b9-4c8d-35a5-864e-5126bfffd23d",
                                                "text": "Le stator d'une machine électrique est la partie stationnaire d'un moteur électrique ou d'un alternateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d3b3f8-179e-3e74-9f55-fb6092eb1143",
                                        "entry_id": "c5691494-755f-3bca-bdf6-ed6d278f5b85",
                                        "glosses": [
                                            "Partie fixe de l’allumeur d’un moteur à explosion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
