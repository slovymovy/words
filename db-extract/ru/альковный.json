                                "target_senses": [
                                    {
                                        "sense_id": "c40115d2-9af8-30f9-aa81-926115ba42ce",
                                        "entry_id": "4fbf05c0-10b2-3a5e-b5ff-a4b05eb379ff",
                                        "glosses": [
                                            "A room in a house, apartment, hotel, or other dwelling where a bed is kept for sleeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ae33ce-7d3c-488c-bb22-550b446a1dd0",
                                                "sense_id": "c40115d2-9af8-30f9-aa81-926115ba42ce",
                                                "text": "Please don't enter my bedroom without knocking."
                                            },
                                            {
                                                "example_id": "dfddce14-aa3a-441a-8bf6-2c3d478545c6",
                                                "sense_id": "c40115d2-9af8-30f9-aa81-926115ba42ce",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century, […]."
                                            },
                                            {
                                                "example_id": "b02cf4de-98bb-430a-8aa0-294bffa51f49",
                                                "sense_id": "c40115d2-9af8-30f9-aa81-926115ba42ce",
                                                "text": "I am in the bedroom."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0e68865-d5f9-39ea-9cc9-52f704e2498c",
                                        "entry_id": "4fbf05c0-10b2-3a5e-b5ff-a4b05eb379ff",
                                        "glosses": [
                                            "The location of sexual activity."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93acd05d-c103-43bd-a5c9-747903a4d1a1",
                                                "sense_id": "f0e68865-d5f9-39ea-9cc9-52f704e2498c",
                                                "text": "\"How are things in the bedroom?\" asked the marriage therapist."
                                            },
                                            {
                                                "example_id": "d6313c8a-b029-4e63-b8d6-62cdbf7b68a6",
                                                "sense_id": "f0e68865-d5f9-39ea-9cc9-52f704e2498c",
                                                "text": "If you’re single, you might be going through a dry spell, or if you’re taken, life in the bedroom has become more routine and less of a spontaneous, fun activity."
                                            }
                                        ]
                                    }
                                ]
                            }
