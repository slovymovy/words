                        "cross_references": [
                            {
                                "target_word": "anglikanisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                        "entry_id": "562bdb04-8d49-3e7d-9af0-32783080c3e6",
                                        "glosses": [
                                            "zur englischen Kirche oder einer ihrer Tochterkirchen gehörend, sie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2980cb07-d7cc-4dce-8163-37bbb0dffabc",
                                                "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                                "text": "Die \"Church of England\" ist Teil der weltweiten Gemeinschaft anglikanischer Kirchen mit 80 Millionen Anhängern."
                                            },
                                            {
                                                "example_id": "c5e06854-1c1a-4a77-a7b5-a136d5cf03b2",
                                                "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                                "text": "Der Begriff „anglikanisch“ bezeichnet sowohl Lehre und Gebräuche, die im England des 15. Jahrhunderts entwickelt wurden, als auch die Reaktion auf die Reformation und die Entstehung des europäischen Protestantismus."
                                            },
                                            {
                                                "example_id": "ce28b86a-cb8d-48ff-a57d-5a7acd6a86fa",
                                                "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                                "text": "Die anglikanische Kirche von England hat erstmals eine Frau ins Bischofsamt berufen: Libby Lane wird künftig Bischöfin von Stockport in der Diözese Chester sein."
                                            },
                                            {
                                                "example_id": "a627c318-938c-4c5a-8365-8b7518cf9696",
                                                "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                                "text": "Die Mutterkirche der anglikanischen Weltgemeinschaft vollzieht damit einen Schritt, den viele ihrer Tochterkirchen bereits Jahrzehnte zuvor gegangen sind: Anglikanische Bischöfinnen gibt es unter anderem in den USA, in Australien und Indien."
                                            },
                                            {
                                                "example_id": "5576bd6f-8e8c-4c17-aad8-e4227cb1d0ca",
                                                "sense_id": "fe691df8-b987-32f8-96c9-7efaaf1bd17c",
                                                "text": "Die anglikanische Kirche ist in Österreich staatlich nicht anerkannt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
