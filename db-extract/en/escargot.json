                        "entry_id": "d9b1136e-e0de-33e4-8287-d4b53775dab5",
                        "glosses": [
                            "A dish, commonly associated with French cuisine, consisting of edible snails."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6509b331-075e-4373-8d1b-d9e574bab97b",
                                "sense_id": "0ccba011-813f-3edf-a46a-63c56f8a1f82",
                                "text": "J. is dating P. at NYU and modeling on the side. They're planning to meet us in Paris for spring break so J. can go to some look-sees (and eat some escargot, obv.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ea6a900-cc7b-3c88-943f-fac4c12024b7",
                        "entry_id": "d9b1136e-e0de-33e4-8287-d4b53775dab5",
                        "glosses": [
                            "A snail (often Helix pomatia) used in preparation of that dish."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "448a8b49-2e20-4595-a21f-cf36610a821c",
                        "source_entry_id": "d9b1136e-e0de-33e4-8287-d4b53775dab5",
                        "source_sense_description": "dish",
                        "target_lang_word": "escargot",
