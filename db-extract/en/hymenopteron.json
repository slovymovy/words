                        "glosses": [
                            "Any insect of the order Hymenoptera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d0e5cb9-105c-4fd8-86ed-e94f02f1d8ca",
                                "sense_id": "d0f046fe-4df9-370f-8c78-d7978c4cb920",
                                "text": "The remaining insects included larvae of midges, soldier-flies, horse-flies, may-flies, a hymenopteron, and a bird louse, of a species (Lipeurus squalidus) known to infest the Shoveller."
                            },
                            {
                                "example_id": "5779c18c-5568-4ed8-947c-2bcdf87f68e4",
                                "sense_id": "d0f046fe-4df9-370f-8c78-d7978c4cb920",
                                "text": "“The couple holding hands in the corner could be the Bee and a lady friend,” Prance said. “They're the likeliest bet, although that one really large table might hold a hymenopteron. Do you recognize any of them?”"
                            }
                        ]
                    }
