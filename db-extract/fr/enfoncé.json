                        "sense_id": "6269526f-5b24-35b3-9721-f2c7c9069c89",
                        "entry_id": "2321150e-fd76-3381-98ff-1931b838a48e",
                        "glosses": [
                            "Qui n’est pas au niveau du reste, qui forme cavité, ou un endroit profond."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc309fc6-88bc-4939-8480-e8d23de5053a",
                                "sense_id": "6269526f-5b24-35b3-9721-f2c7c9069c89",
                                "text": "Un lieu enfoncé, une partie enfoncée."
                            }
                        ]
                    },
                    {
                        "sense_id": "37daf26b-f2a5-3f29-a837-f2b83c4f17e3",
                        "entry_id": "2321150e-fd76-3381-98ff-1931b838a48e",
                        "glosses": [
                            "Qui a eu le dessous."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f2d38982-9dbe-4204-9712-dc31fb84b349",
                                "sense_id": "37daf26b-f2a5-3f29-a837-f2b83c4f17e3",
                                "text": "Le voilà enfoncé."
                            },
                            {
                                "example_id": "2eb18bc2-54c1-4856-aa87-b75740892fb6",
                                "sense_id": "37daf26b-f2a5-3f29-a837-f2b83c4f17e3",
                                "text": "S'ils font le coup ce soir, M. Rodolphe, qui croit qu'il se fera demain, est donc enfoncé."
                            },
                            {
                                "example_id": "e997d216-3c44-4a96-a548-c9dba028186f",
                                "sense_id": "37daf26b-f2a5-3f29-a837-f2b83c4f17e3",
                                "text": "— Je suis enfoncé ! se dit-il, le petit en tient et ils ont tous l’air de jouer au plus matois, ici ; quel galbe, quelle cariatide, mes enfants !"
                            }
                        ]
                    }
                ],
