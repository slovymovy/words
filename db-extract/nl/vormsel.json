                ],
                "senses": [
                    {
                        "sense_id": "cbf19b79-a9c3-32b1-863b-cdcc75218762",
                        "entry_id": "c9cfe4d6-a65e-3d17-928c-8c5c21b192e0",
                        "glosses": [
                            "sacrament waardoor een gedoopte de kracht van de Heilige Geest ontvangt om zijn geloof standvastig te kunnen belijden"
                        ],
                        "tags": [
                            "christendom"
                        ],
                        "examples": [
                            {
                                "example_id": "388ac98d-c168-47ad-9aa8-61c821974d47",
                                "sense_id": "cbf19b79-a9c3-32b1-863b-cdcc75218762",
                                "text": "De meeste kinderen worden gedoopt als ze een baby zijn en doen hun eerste heilige communie als ze zeven of acht jaar zijn. De gebruikelijke leeftijd om het vormsel te ontvangen is twaalf of dertien jaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53b914a2-58d1-4762-b32e-cdcfcb30c47a",
                        "source_entry_id": "c9cfe4d6-a65e-3d17-928c-8c5c21b192e0",
                        "source_sense_id": "cbf19b79-a9c3-32b1-863b-cdcc75218762",
                        "source_sense_description": "een sacrament waardoor een gedoopte de kracht van de Heilige Geest ontvangt om zijn geloof standvastig te kunnen belijden",
                        "target_lang_word": "Firmung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Firmung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "90bbe9b4-1c09-3cd8-ae9c-b149af43eabb",
                                        "entry_id": "dc70e018-093f-360f-9121-711cfc02aa52",
                                        "glosses": [
                                            "rituelle Handlung, bei der durch Handauflegung und Salbung mit Chrisamöl durch einen Bischof die Verbindung des Firmlings zur Kirche gestärkt werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60a4add3-0751-46a0-8426-4334e47ed93e",
                                                "sense_id": "90bbe9b4-1c09-3cd8-ae9c-b149af43eabb",
                                                "text": "„Die Firmung führt die in der Taufe begonnene christliche Initiation weiter. In diesem Sakrament empfangen die Getauften den Heiligen Geist, der ausgegossen und am Pfingstfest vom Herrn über die Apostel gesandt wurde.“"
                                            },
                                            {
                                                "example_id": "bb15ebc5-4277-40f5-b378-188889d87a3e",
                                                "sense_id": "90bbe9b4-1c09-3cd8-ae9c-b149af43eabb",
                                                "text": "„Schon kurz nach meiner Firmung machten sich immer mehr Zweifel am Glauben breit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e42da9d-5bf9-42aa-a282-ae967b0b6afd",
                        "source_entry_id": "c9cfe4d6-a65e-3d17-928c-8c5c21b192e0",
                        "source_sense_id": "cbf19b79-a9c3-32b1-863b-cdcc75218762",
                        "source_sense_description": "een sacrament waardoor een gedoopte de kracht van de Heilige Geest ontvangt om zijn geloof standvastig te kunnen belijden",
                        "target_lang_word": "confirmation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirmation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd3751e0-eaa5-303c-940a-d39243beeda1",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "An official indicator that things will happen as planned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be14f2d6-dbe1-4c77-bab9-4958b99795ba",
                                                "sense_id": "cd3751e0-eaa5-303c-940a-d39243beeda1",
                                                "text": "We will send you a written confirmation of your hotel booking."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "A verification that something is true or has happened."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15b621df-ff85-4107-8e9c-455638913032",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "The announcement in the newspaper was a confirmation of my suspicions."
                                            },
                                            {
                                                "example_id": "5e2e16b2-0833-47f9-b977-16b6b27d9826",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "They declare ringing confirmation for their theories even in the face of feeble data."
                                            },
                                            {
                                                "example_id": "7640ca90-b238-4756-aac9-08579b57f6e8",
                                                "sense_id": "ecb103c7-3a4b-3fcb-ab81-77f89a827c0f",
                                                "text": "The thing is, we've even had formal confirmation from Government itself that the crucial research required to make such sweeping claims hasn't been done!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da94b533-4a9d-3869-81bd-6fd7b5db9e4f",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "A ceremony of sealing and conscious acknowledgement of the faith in many Christian churches, typically around the ages of 14 to 18; considered a sacrament in some churches, including Catholicism, but not in most Protestant churches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0140b33e-9431-488c-8cee-72905c5fb18b",
                                                "sense_id": "da94b533-4a9d-3869-81bd-6fd7b5db9e4f",
                                                "text": "You got a nice white dress / and a party on your confirmation. / You've got a brand new soul, / mm, and a cross of gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f71ab6-0896-3005-9fa7-8ccbfc4c2c67",
                                        "entry_id": "76b09fcd-9d2c-386b-89a9-442e95123ba9",
                                        "glosses": [
                                            "An act whereby something conditional or voidable is made sure and unavoidable, especially the possession of an estate."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2588dcd0-15cc-4e86-b6a1-93adef99161f",
                        "source_entry_id": "c9cfe4d6-a65e-3d17-928c-8c5c21b192e0",
                        "source_sense_id": "cbf19b79-a9c3-32b1-863b-cdcc75218762",
                        "source_sense_description": "een sacrament waardoor een gedoopte de kracht van de Heilige Geest ontvangt om zijn geloof standvastig te kunnen belijden",
                        "target_lang_word": "confirmation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confirmation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3566b7e5-d526-31aa-98e1-948bf45c1246",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Action de confirmer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191bb73d-1a45-402e-9e73-19636b156990",
                                                "sense_id": "3566b7e5-d526-31aa-98e1-948bf45c1246",
                                                "text": "La sécheresse prolongée au Sahel, entre 1968 et 1973, et la famine meurtrière qui s'ensuit semblent apporter une confirmation brutale des thèses néomalthusiennes sur l'effondrement de la production agricole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8e6e8b-e93b-3a7a-9ea6-ac6d8cc522e0",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Ce qui rend une chose ferme et stable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "813673fe-6415-4a95-95d4-44c320babdaf",
                                                "sense_id": "5f8e6e8b-e93b-3a7a-9ea6-ac6d8cc522e0",
                                                "text": "La confirmation d’un jugement, d’un arrêt. Obtenir des lettres de confirmation. Confirmation de privilèges, de droits, de prérogatives, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Certitude qu’on acquiert d’une chose qui avait déjà été donnée pour vraie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b76d254-84f6-4acf-a6df-77a2ad5ce676",
                                                "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                                "text": "La confirmation d’une nouvelle. La confirmation d’une promesse."
                                            },
                                            {
                                                "example_id": "1d6c96c4-6ecc-4a39-a858-686f837f4f17",
                                                "sense_id": "29a10128-03ed-301b-b8ec-2ff3b80b1946",
                                                "text": "On m’a dit telle chose, j’en ai reçu la confirmation de tel endroit. Cela a besoin de confirmation, mérite confirmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d148188-299d-35f6-8491-9b436cf99ab5",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Partie du discours oratoire qui suit la narration et par laquelle on prouve ce qu’on vient d’avancer."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a7c49563-fa5f-3300-b6e7-e606ba6caf6d",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Sacrement par lequel les chrétiens, en recevant le Saint-Esprit avec l’abondance de ses dons, sont confirmés dans la grâce reçue au baptême."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d16d0e4b-8c2c-4316-8ab7-8567a27152b7",
                                                "sense_id": "a7c49563-fa5f-3300-b6e7-e606ba6caf6d",
                                                "text": "Le sacrement de confirmation. L’évêque seul peut donner la confirmation. Recevoir la confirmation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97fc863b-4637-3484-b3d0-5f7b0ed99743",
                                        "entry_id": "7b1b3c85-ccea-3bbf-89b6-21dcda0f187d",
                                        "glosses": [
                                            "Dans des confessions protestantes pratiquant le baptême des enfants, cérémonie de réaffirmation de la foi qui a lieu à l’adolescence ou plus tard, et qui ne constitue pas un sacrement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
