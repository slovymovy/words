                "senses": [
                    {
                        "sense_id": "807244c3-d853-3241-a1aa-41f6d386b694",
                        "entry_id": "bd15c233-746e-3c14-bebc-e4f62f4bc2db",
                        "glosses": [
                            "Fahrzeug, welches große Mengen Milch transportiert (zum Beispiel vom Erzeuger zur Molkerei)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1b0e26-a799-4d84-a27f-4fbd2746f38b",
                                "sense_id": "807244c3-d853-3241-a1aa-41f6d386b694",
                                "text": "„Neben der Straße gelandet ist am Sonntagmorgen bei Knonau das Milchauto, das in der Region Zürich die Milch bei den Bauern eingesammelt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a2d1c748-e8ce-3138-a55b-304dceaa13dc",
                        "entry_id": "bd15c233-746e-3c14-bebc-e4f62f4bc2db",
                        "glosses": [
                            "Fahrzeug, das Milch in kleineren Mengen, meist in Flaschen, an Haushalte liefert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db6aa888-366f-4438-8c35-aba0ae847999",
                                "sense_id": "a2d1c748-e8ce-3138-a55b-304dceaa13dc",
                                "text": "In Deutschland kommt das Milchauto fast nirgends mehr zu den Leuten nach Hause."
                            },
                            {
                                "example_id": "f5ded6d1-9618-494d-b646-8c843ec7e662",
                                "sense_id": "a2d1c748-e8ce-3138-a55b-304dceaa13dc",
                                "text": "Das Aufkommen der H-Milch läutete das Ende des englischen Milchautos ein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf847cb3-b574-4efb-bf1a-76dfe5dae97e",
                        "source_entry_id": "bd15c233-746e-3c14-bebc-e4f62f4bc2db",
                        "source_sense_id": "807244c3-d853-3241-a1aa-41f6d386b694",
                        "source_sense_description": "Tankfahrzeug, welches große Mengen Milch transportiert",
                        "target_lang_word": "milk tanker",
