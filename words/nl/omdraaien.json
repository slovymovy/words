                            "text": "Je mag mijn woorden niet <w>omdraaien</w> om gelijk te krijgen.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>twist</w> my words to get your way.",
                                "ru": "Ты не должен <w>переиначивать</w> мои слова, чтобы оказаться правым.",
                                "pl": "Nie możesz <w>przekręcać</w> moich słów, żeby postawić na swoim.",
                                "de": "Du darfst meine Worte nicht <w>verdrehen</w>, um Recht zu bekommen.",
                                "fr": "Tu ne devrais pas <w>détourner</w> mes paroles pour avoir raison.",
                                "it": "Non dovresti <w>stravolgere</w> le mie parole per avere ragione.",
