                "senses": [
                    {
                        "sense_id": "1a84eae8-c5f1-338e-8eb5-57b0deed2064",
                        "entry_id": "e4ca67c7-97e2-34a4-bed1-31b7368cf41b",
                        "glosses": [
                            "Durcissement des branches et rameaux de l’année en vue de l’hiver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce2671e-c292-4e1c-b530-ffc290bf02a3",
                                "sense_id": "1a84eae8-c5f1-338e-8eb5-57b0deed2064",
                                "text": "Par suite de cette défoliaison, lʼaoûtement des rameaux est imparfait, comme si la vigne avait perdu ses feuilles par le Mildiou."
                            },
                            {
                                "example_id": "46897a98-1dc2-4562-8aca-4f73f90f4622",
                                "sense_id": "1a84eae8-c5f1-338e-8eb5-57b0deed2064",
                                "text": "Pour le chêne, l’aoûtement de la dernière pousse d’élongation ne se déroule pas en août comme le nom l’indique mais plutôt fin octobre – début novembre (fin des journées chaudes, arrivée des nuits plus fraîches, voire premières gelées)."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb717d42-9a67-3f99-91d9-744bb0514fe1",
                        "entry_id": "e4ca67c7-97e2-34a4-bed1-31b7368cf41b",
                        "glosses": [
                            "Accélération sous une température favorable de la maturation des fruits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "821ea354-cd69-4bea-8651-cc5ecb3dcef2",
                                "sense_id": "eb717d42-9a67-3f99-91d9-744bb0514fe1",
                                "text": "Puis il tricote un nouveau parallèle entre le processus de l’aoûtement au terme duquel les fruits parviennent à maturation sous l’effet de la chaleur, et le mûrissement de sa mort sous l’effet du temps, qu’il sent sur le point de s’achever."
                            }
                        ]
                    }
