                                        "glosses": [
                                            "gemaakt van het hout van een eik (Quercus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1b784f-873a-48aa-aedf-6c5add6edeae",
                                                "sense_id": "aff23060-3177-397b-bf4f-ad6e612a8cce",
                                                "text": "Het eikenhouten beeld werd vorige week woensdag ontmanteld en naar Maastricht gebracht voor restauratie."
                                            },
                                            {
                                                "example_id": "54c8edc1-b8c8-4503-b33e-5fcfaa4e9494",
                                                "sense_id": "aff23060-3177-397b-bf4f-ad6e612a8cce",
                                                "text": "Het had al veel eerder bekend kunnen zijn dat de toren van het stadhuis in het Friese Bolsward aangetast was door de bonte knaagkever. Dat zegt oud-woordvoerder van de gemeente Bolsward en historicus Willem Haanstra. Afgelopen zaterdag werd de toren van het stadhuis ontmanteld, omdat de eikenhouten draagconstructie te instabiel was geworden door de kever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "256cb20c-42c2-433a-88dd-c9df6cc9bd32",
                        "source_entry_id": "82362273-060f-3021-92bf-e3fe7393786c",
                        "source_sense_id": "bebe7000-305e-3373-93d2-6e1adc9c85f9",
