    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e376a56-b568-3491-b86a-c4ed4cc6f9ad",
                    "sense_definition": "Rendre plus large dans l'espace ou étendre au sens figuré.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La municipalité a décidé d'<w>élargir</w> la route pour faciliter la circulation des bus."
                        },
                        {
                            "text": "Ce séjour à l'étranger lui a permis d'<w>élargir</w> ses horizons culturels."
                        }
                    ],
                    "common_phrases": [
                        "élargir la route",
                        "élargir ses horizons"
                    ]
                },
                {
                    "sense_id": "bcd37ee0-b33b-3064-bfaa-3ab1b5f883eb",
                    "sense_definition": "Prendre une plus grande dimension en largeur, devenir plus large.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dimension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le sentier commence à s'<w>élargir</w> après quelques minutes de marche dans la forêt."
                        },
                        {
                            "text": "La fissure sur le mur continue de s'<w>élargir</w> avec les changements de température."
                        }
                    ],
                    "common_phrases": [
                        "s'élargir peu à peu"
                    ]
                },
                {
                    "sense_id": "c100a5f7-824d-3e40-ae58-20e2f43b4963",
                    "sense_definition": "Remettre en liberté une personne détenue ou emprisonnée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "liberation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a ordonné d'<w>élargir</w> le suspect faute de preuves suffisantes."
                        },
                        {
                            "text": "Le prisonnier fut enfin <w>élargi</w> après plusieurs mois passés derrière les barreaux."
                        }
                    ],
                    "common_phrases": [
                        "élargir un prisonnier"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Employé surtout dans la langue juridique ou historique"
                        }
                    ]
                },
                {
                    "sense_id": "d7f0ae29-ed82-3331-bef2-003b661cf122",
                    "sense_definition": "Augmenter le nombre de bits utilisés pour représenter une donnée numérique.",
                    "learner_level": "C2",
