                        "examples": [
                            {
                                "example_id": "d7a1081f-6e19-470e-a702-92835817ba63",
                                "sense_id": "c40845ca-6432-3acb-9ac8-55100fc79419",
                                "text": "Turkije roept Duitsland op het matje na satire over Erdogan(!!!)"
                            },
                            {
                                "example_id": "52b5c42e-640e-4dc1-9caf-37c42d34e6a2",
                                "sense_id": "c40845ca-6432-3acb-9ac8-55100fc79419",
                                "text": "Trumps autocratische inborst wordt óók verraden door het soort satire dat hijzelf bedrijft: pesterijen gericht op gemarginaliseerden, zwakkeren en de vermeende enemy within. Als dat al uit een draaiboek komt, dan niet uit dat van Nixon, maar uit dat van Goebbels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4234fbdd-56d2-4d7a-8485-2e7d230d6a08",
                        "source_entry_id": "918ef058-9778-3791-b431-32e151e30589",
