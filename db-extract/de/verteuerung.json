                                "target_senses": [
                                    {
                                        "sense_id": "b2d16616-a6f1-3812-a5df-c31b870b417e",
                                        "entry_id": "1acd95bd-2115-3f22-9e49-47ce09d69065",
                                        "glosses": [
                                            "Action d’augmenter ou le résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d7af703-16e4-4222-b1d2-9786d2f1a0ba",
                                                "sense_id": "b2d16616-a6f1-3812-a5df-c31b870b417e",
                                                "text": "L’idée de déployer tous les fastes de la République et d'afficher une solennité churchillienne pour annoncer une augmentation de 1,6 point de la TVA ne peut venir que de cerveaux hallucinés."
                                            },
                                            {
                                                "example_id": "00faa9c8-cd29-4106-838f-b0c83cf65ad8",
                                                "sense_id": "b2d16616-a6f1-3812-a5df-c31b870b417e",
                                                "text": "On a fait valoir que l’augmentation de la consommation urbaine de viande au XIXᵉ siècle pouvait provenir de la surenchère gastronomique (ou gastrolâtrique) de la bourgeoisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "975039cc-8e33-32a7-b920-3d2327f02f97",
                                        "entry_id": "1acd95bd-2115-3f22-9e49-47ce09d69065",
                                        "glosses": [
                                            "Augmentation du salaire ou des prix."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f429f39-22ec-4f6a-bd58-2792e8d3bdd1",
                                                "sense_id": "975039cc-8e33-32a7-b920-3d2327f02f97",
                                                "text": "Si vous allez tous les ans me donner du travail comme ça et des inscriptions à faire au registre des naissances, je serai obligé de demander à la commune une augmentation."
                                            },
                                            {
                                                "example_id": "01b350e9-48e3-40ea-9071-6089b9f317f6",
                                                "sense_id": "975039cc-8e33-32a7-b920-3d2327f02f97",
                                                "text": "Elle passe d’un emploi à l’autre sans souffler. Puis le petit chef de la Lemmings est muté, remplacé par une jeune femme qui lui accorde sa première augmentation et lui permet de réorganiser ses horaires. La pression s’allège, elle retrouve le plaisir d’enseigner."
                                            },
                                            {
                                                "example_id": "01a0a2c4-53fa-4646-8e32-3f3d47605514",
                                                "sense_id": "975039cc-8e33-32a7-b920-3d2327f02f97",
                                                "text": "Subir une augmentation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcf4a10a-7c5a-3cc8-81b1-21ba96f237d9",
                                        "entry_id": "1acd95bd-2115-3f22-9e49-47ce09d69065",
                                        "glosses": [
                                            "Ajouts d’un augmentateur au livre d’un autre écrivain."
                                        ],
                                        "tags": [
                                            "dated",
                                            "especially",
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
