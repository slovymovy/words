        "fr-extract.jsonl": [
            {
                "entry_id": "9ae7698f-f6e6-3045-8ebc-ec47eb24711b",
                "word": "retape",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "19f4348c-9800-4af6-b485-5f4ca2ef2336",
                        "entry_id": "9ae7698f-f6e6-3045-8ebc-ec47eb24711b",
                        "tags": [
                            "plural"
                        ],
                        "form": "retapes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b5688f0-0d2d-3b3a-9c92-514b376246f9",
                        "entry_id": "9ae7698f-f6e6-3045-8ebc-ec47eb24711b",
                        "glosses": [
                            "Action d’une personne prostituée qui cherche et aborde d’éventuels clients."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "661f7b12-03b3-496e-bf1b-408f13b92551",
                                "sense_id": "5b5688f0-0d2d-3b3a-9c92-514b376246f9",
                                "text": "Fichtre ! te voilà belle, t’as une toilette chic. Où as-tu gagné ça, vache ! Tu viens de la retape, chameau ! Attends un peu que je t’arrange !…"
                            },
                            {
                                "example_id": "38b221b1-bc96-4b5b-afc6-326e02e77dcb",
                                "sense_id": "5b5688f0-0d2d-3b3a-9c92-514b376246f9",
                                "text": "Doit une partie de sa vogue à ça... que c’est la première demoiselle qui ait fait la retape à cheval. Raccrocher du haut d’un pur sang. Une idée de génie !"
                            },
                            {
                                "example_id": "b3563ddf-fd0b-4410-898e-3a98fe105ad8",
                                "sense_id": "5b5688f0-0d2d-3b3a-9c92-514b376246f9",
                                "text": "Toute doucereuse elle se faisait, avec des inclinaisons de tête sur l’épaule, pour vous regarder de côté, comme une chatte, avec un soupir de putain en retape."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6160030-4089-3b9c-aa07-42a5c39cbd28",
                        "entry_id": "9ae7698f-f6e6-3045-8ebc-ec47eb24711b",
                        "glosses": [
                            "Action qui vise à séduire la clientèle."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "ddacfe4b-581a-4c34-84ec-3bd05f938dc2",
                                "sense_id": "f6160030-4089-3b9c-aa07-42a5c39cbd28",
                                "text": "Le banquier fait la retape, mais il a une peur bleue de l’agent des mœurs, c’est-à-dire du maître chanteur."
                            },
                            {
                                "example_id": "e9bf99ed-f8cd-40e5-9993-3ff5aeace4fa",
                                "sense_id": "f6160030-4089-3b9c-aa07-42a5c39cbd28",
                                "text": "En 2010, l’OMS avait tiré la sonnette d’alarme en recommandant d’interdire, pour les moins de 18 ans, les pubs faisant la retape de produits au profil nutritionnel douteux."
                            }
                        ]
                    }
                ],
