                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "transferred from nickname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия, произошедшая от прозвища."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спайкс",
                                "target_lang_sense_clarification": "фамилия"
