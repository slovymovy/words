                            {
                                "example_id": "ef3c1767-6cd0-4f07-bf59-d910cfb1b4e5",
                                "sense_id": "2b5c2bfc-ebb1-38ec-b406-55d975f1ca55",
                                "text": "Je le suivis jusqu’à une petite pièce, deux étages en dessous, et m’assis entre une armoire-classeur métallique et un bureau en tôle émaillée blanche."
                            },
                            {
                                "example_id": "d95b15f5-4927-4c92-b937-b37a70a21507",
                                "sense_id": "2b5c2bfc-ebb1-38ec-b406-55d975f1ca55",
                                "text": "Entre deux fenêtres, on avait pu, comme par miracle, loger une armoire-classeur."
                            },
                            {
                                "example_id": "ced759a9-3104-43ee-8018-858e4445ddd3",
                                "sense_id": "2b5c2bfc-ebb1-38ec-b406-55d975f1ca55",
                                "text": "La lieutenante se dirigea vers une des armoires-classeurs dissimulant les murs de la pièce, elle hésita entre deux casiers et finit par ouvrir celui du dessus."
                            }
                        ]
                    }
