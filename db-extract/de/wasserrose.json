                "senses": [
                    {
                        "sense_id": "a773ea6a-0753-37f9-bf55-716689e22c87",
                        "entry_id": "d2c65fd5-d619-3ef3-b83b-c9d66118c33f",
                        "glosses": [
                            "Vertreter der Pflanzengattung Nymphaea aus der Familie der Seerosengewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee1be29-958c-449f-a785-a281f39fda99",
                                "sense_id": "a773ea6a-0753-37f9-bf55-716689e22c87",
                                "text": "„Bienen summten über einen verkrauteten und von weißen Wasserrosen bedeckten Teich.“"
                            },
                            {
                                "example_id": "390057b6-4cae-4dd6-832c-a0a18b3904dd",
                                "sense_id": "a773ea6a-0753-37f9-bf55-716689e22c87",
                                "text": "„In einer meiner glücklichsten Kindheitserinnerungen hocke ich dort am Teich und bin fasziniert von den in allen Farben schillernden Karpfen, die langsam unter den Wasserrosen hindurchschwimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1dfa96fb-1b7b-4289-ac57-9fa91cc69ce8",
                        "source_entry_id": "d2c65fd5-d619-3ef3-b83b-c9d66118c33f",
                        "source_sense_id": "a773ea6a-0753-37f9-bf55-716689e22c87",
                        "source_sense_description": "Vertreter der Pflanzengattung Nymphaea aus der Familie der Seerosengewächse",
                        "target_lang_word": "nénuphar",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nénuphar",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                        "entry_id": "4fce09f1-dedb-35ac-abe3-935b213a1a49",
                                        "glosses": [
                                            "Nom que l'on donne communément à l'ensemble des plantes de la famille des Nymphaeaceae (Nymphaeacées) qui ont de larges feuilles rondes et de grandes fleurs en forme de roses simples."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9218a14f-b707-4166-a0c6-a8bba3edf4b4",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "Tandis que le courant du milieu entraîne vers la mer les cadavres des pins et des chênes, on voit sur les deux courants latéraux remonter le long des rivages, des îles flottantes de pistia et de nénuphar, dont les roses jaunes s’élèvent comme de petits pavillons."
                                            },
                                            {
                                                "example_id": "395046ea-7671-43bb-9a52-eae2acd797de",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "La Thève bruissait à notre gauche, laissant à ses coudes des remous d'eau stagnante où s’épanouissaient les nénuphars jaunes et blancs, où éclatait comme des pâquerettes la frêle broderie des étoiles d’eau."
                                            },
                                            {
                                                "example_id": "129a3658-0d0b-467e-b7af-37bb5b6b70dc",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "Nymphéas, — Nuphars; — il y a entre les deux d’assez précises différences. Les fleurs des Nuphars sont plus petites, plus globuleuses et toujours jaunes. Celles des Nymphéas sont généralement blanches comme on les voit sur le type communément répandu dans nos étangs. Nymphéas ou Nuphars sont les Nénuphars."
                                            },
                                            {
                                                "example_id": "7a8f732d-5b51-4de3-aa56-eec081029f51",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "On coupa des baguettes et l’on chercha des perches légères, mais aucune ne se trouva être assez grande pour atteindre la grenouille, qui bâillait toujours, la gueule ouverte, sur sa feuille de nénuphar."
                                            },
                                            {
                                                "example_id": "b476a2ba-f437-4e81-b25e-78e57f76f553",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "Ils étaient parvenus sur le bord d’une immense pièce d’eau. Vers leur droite elle fuyait à perte de vue, de place en place ornée de nénuphars et de nymphéas, parmi lesquels s’élevaient des oiseaux gris et lumineux dans les premières lueurs du jour."
                                            },
                                            {
                                                "example_id": "402daa4a-c642-41e5-9fde-3195ec780986",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "Cet étang que tu avais vu sur un tableau, bordé de joncs, couvert de nénuphars…"
                                            },
                                            {
                                                "example_id": "a865852b-986b-4a89-982b-dce7ae8f6d26",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "Ils pensaient au départ qu’il s’agissait du Victoriana amazonia, l’une des deux variétés connues de nénuphars géants, dont le nom vient de la reine Victoria."
                                            },
                                            {
                                                "example_id": "5526fe9e-26df-45f3-810a-74568033a942",
                                                "sense_id": "a925307f-8c58-3ba8-9bd1-903c26165869",
                                                "text": "La différence entre le lotus et le nénuphar : les pétales du lotus ne touchent pas l’eau et s’élancent en direction du ciel. Celles du nénuphar se marient avec la danse du lac et épouse ses ondulations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d7e7d3c-8642-3008-9a04-d94a13eeec74",
                                        "entry_id": "4fce09f1-dedb-35ac-abe3-935b213a1a49",
                                        "glosses": [
                                            "Rhizome du nénuphar."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b251dee9-d674-4a78-981c-12f8f978d2f6",
                                                "sense_id": "8d7e7d3c-8642-3008-9a04-d94a13eeec74",
                                                "text": "Un cataplasme de nénuphar et de concombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef3d8ec0-42c5-384e-9ce4-909044306c58",
                                        "entry_id": "4fce09f1-dedb-35ac-abe3-935b213a1a49",
                                        "glosses": [
                                            "Fleur du nénuphar."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d665241-a013-4783-9f7b-9af4044ef639",
                                                "sense_id": "ef3d8ec0-42c5-384e-9ce4-909044306c58",
                                                "text": "Le sirop de nénuphar ordinaire, c’est-à-dire préparé avec les fleurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a60d61ba-abde-4a05-bcc1-a3900cd90695",
                        "source_entry_id": "d2c65fd5-d619-3ef3-b83b-c9d66118c33f",
                        "source_sense_id": "a773ea6a-0753-37f9-bf55-716689e22c87",
                        "source_sense_description": "Vertreter der Pflanzengattung Nymphaea aus der Familie der Seerosengewächse",
                        "target_lang_word": "nymphéa",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nymphéa",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                        "entry_id": "74d16a3f-3cad-3918-a402-b73810d77eb4",
                                        "glosses": [
                                            "Plante aquatique ornementale de la famille des Nymphéacées, appartenant au genre Nymphaea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b4a1ce-db87-411d-b94e-98ced31f5c29",
                                                "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                                "text": "Les rhizomes ou tiges souterraines du nymphéa, qui croît dans le Nil (Nymphæea cœrulea, Byarout des Arabes), tubercules gros comme des châtaignes, sont comestibles; ils abondent dans les lacs et les marécages, à la base du Delta et du Fagoum, et ne reçoivent aucune culture."
                                            },
                                            {
                                                "example_id": "73d28abb-56e4-4b44-8810-4ddc9a5597fe",
                                                "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                                "text": "Et, à fleur d’eau, dans la tiédeur de la nappe dormante doucement chauffée, des Nymphéa ouvraient leurs étoiles roses."
                                            },
                                            {
                                                "example_id": "5402b990-c6cc-41c4-9d15-11d70f7b7ec3",
                                                "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                                "text": "Nymphéas, — Nuphars; — il y a entre les deux d’assez précises différences. Les fleurs des Nuphars sont plus petites, plus globuleuses et toujours jaunes. Celles des Nymphéas sont généralement blanches comme on les voit sur le type communément répandu dans nos étangs. Nymphéas ou Nuphars sont les Nénuphars."
                                            },
                                            {
                                                "example_id": "6e701acc-63d1-4120-a0ea-eb21c67dd36b",
                                                "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                                "text": "Tu sembles une nymphéa mouvant allant à la dérive, et les reflets du ciel te font cortège."
                                            },
                                            {
                                                "example_id": "91579670-058c-4cd2-92a4-12b50cb4c31a",
                                                "sense_id": "ccbdccd5-c0e6-39c1-a05b-ad1a705034ed",
                                                "text": "Ils étaient parvenus sur le bord d’une immense pièce d’eau. Vers leur droite elle fuyait à perte de vue, de place en place ornée de nénuphars et de nymphéas, parmi lesquels s’élevaient des oiseaux gris et lumineux dans les premières lueurs du jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
