                "senses": [
                    {
                        "sense_id": "6400b683-7a7c-3f15-bfba-e75f11988143",
                        "entry_id": "56940bfb-58c2-341f-bc65-a0c4ced18ea5",
                        "glosses": [
                            "Klebeverbandtyp, der zur Behandlung schmerzhafter Erkrankungen der Sehnen und des Muskel- oder Skelettapparates eingesetzt wird, für dessen Wirksamkeit es bisher keinen Nachweis gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a117453-c61b-45b4-aaff-7d2e9558c266",
                                "sense_id": "6400b683-7a7c-3f15-bfba-e75f11988143",
                                "text": "„Später kam das Kinesio-Tape, ohne das kein Muskel mehr ordentlich durchblutet wurde. Nun also Trikots, die „Micro-Massagen bieten, eine effektivere Energieaufnahme in den aktiven Muskeln ermöglichen“, wie es bei Puma heißt.“"
                            },
                            {
                                "example_id": "b5837ada-ee00-49b4-ad5c-f216573b785c",
                                "sense_id": "6400b683-7a7c-3f15-bfba-e75f11988143",
                                "text": "„Es wurde bislang zweifelsfrei festgestellt, dass sich das Kinesio-Tape auf die Muskelaktivität auswirkt – allerdings nicht, ob positiv oder negativ.“"
                            },
                            {
                                "example_id": "39c7f516-8849-43f4-914e-6562dc5a0cd5",
                                "sense_id": "6400b683-7a7c-3f15-bfba-e75f11988143",
                                "text": "„Kinesio-Tapes sind nach Meinung des Autors eher Glaubenssache und haben kein wissenschaftlich gesichertes Fundament.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
