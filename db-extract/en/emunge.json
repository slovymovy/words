                        "sense_id": "2cb7c067-a78e-3829-9a8a-e152942c3b8a",
                        "entry_id": "7b2bcd7a-5c77-3c88-89ff-c9b6c3286478",
                        "glosses": [
                            "To wipe or cleanse, especially one's nose."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "cd1cdab4-da71-41a8-a6e5-79bbfb2a91a1",
                                "sense_id": "2cb7c067-a78e-3829-9a8a-e152942c3b8a",
                                "text": "The moment of inspiration commences — the speaker emunges his nose with all his might - a doleful voice, scarcely audible, something like the melancholy moan of the midnight breeze, which so few have heard, informs you might have supposed destitute of the organs of speech, possesses in some respect the faculties of speaking."
                            }
                        ]
