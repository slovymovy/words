{
    "word_family": [
        "постоянство",
        "постоянно"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5bc46f89-ac94-3307-b7f9-b6380b19f61e",
                    "sense_definition": "Не изменяющийся со временем, сохраняющий то же самое состояние или свойства.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stable_unchanging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В лаборатории должна поддерживаться строго <w>постоянная</w> температура для успеха эксперимента.",
                            "target_lang_translations": {
                                "en": "A strictly <w>constant</w> temperature must be maintained in the laboratory for the success of the experiment.",
                                "de": "Im Labor muss für den Erfolg des Experiments eine streng <w>konstante</w> Temperatur aufrechterhalten werden."
                            }
                        },
                        {
                            "text": "У него есть <w>постоянная</w> привычка гулять в парке перед сном.",
                            "target_lang_translations": {
                                "en": "He has a <w>constant</w> habit of walking in the park before bed.",
                                "de": "Er hat die <w>ständige</w> Angewohnheit, vor dem Schlafengehen im Park spazieren zu gehen."
                            }
                        }
                    ],
                    "synonyms": [
                        "неизменный",
                        "стабильный",
                        "устойчивый"
                    ],
                    "antonyms": [
                        "изменчивый",
                        "непостоянный",
                        "изменяющийся"
                    ],
                    "common_phrases": [
                        "постоянная температура",
                        "постоянная величина",
                        "постоянное место жительства"
                    ],
                    "target_lang_definitions": {
                        "en": "Not changing over time, maintaining the same state or properties.",
                        "de": "Sich im Laufe der Zeit nicht verändernd, denselben Zustand oder dieselben Eigenschaften beibehaltend."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "unchanging in value or state"
                            },
                            {
                                "target_lang_word": "stable",
                                "target_lang_sense_clarification": "steady, not fluctuating"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "konstant",
                                "target_lang_sense_clarification": "unverändert in Wert oder Zustand"
                            },
                            {
                                "target_lang_word": "stetig",
                                "target_lang_sense_clarification": "kontinuierlich, gleichmäßig"
                            },
                            {
                                "target_lang_word": "stabil",
                                "target_lang_sense_clarification": "dauerhaft, nicht schwankend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d64563ad-7704-354b-b712-ce5f3d1a705a",
                    "sense_definition": "Происходящий всё время без перерыва или очень часто повторяющийся.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "continuous_recurring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Меня начинает утомлять этот <w>постоянный</w> шум, доносящийся с оживлённой улицы.",
                            "target_lang_translations": {
                                "en": "I am starting to get tired of this <w>constant</w> noise coming from the busy street.",
                                "de": "Dieser <w>ständige</w> Lärm von der belebten Straße fängt an, mich zu ermüden."
                            }
                        },
                        {
                            "text": "Наш магазин очень ценит каждого <w>постоянного</w> клиента и предлагает им скидки.",
                            "target_lang_translations": {
                                "en": "Our store highly values every <w>regular</w> customer and offers them discounts.",
                                "de": "Unser Geschäft schätzt jeden <w>Stammkunden</w> sehr und bietet ihnen Rabatte an."
                            }
                        }
                    ],
                    "synonyms": [
                        "непрерывный",
                        "вечный"
                    ],
                    "antonyms": [
                        "случайный"
                    ],
                    "common_phrases": [
                        "постоянный клиент",
                        "постоянный шум",
                        "постоянные жалобы",
                        "постоянный контроль"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening all the time without interruption or recurring very often.",
                        "de": "Die ganze Zeit ohne Unterbrechung geschehend oder sich sehr oft wiederholend."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "happening continuously"
                            },
                            {
                                "target_lang_word": "continual",
                                "target_lang_sense_clarification": "recurring frequently"
                            },
                            {
                                "target_lang_word": "regular",
                                "target_lang_sense_clarification": "habitual or loyal (e.g., customer)"
                            },
                            {
                                "target_lang_word": "perpetual",
                                "target_lang_sense_clarification": "never-ending, often negative"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ständig",
                                "target_lang_sense_clarification": "sich immer wiederholend, ununterbrochen"
                            },
                            {
                                "target_lang_word": "dauernd",
                                "target_lang_sense_clarification": "fortwährend, ohne Pause"
                            },
                            {
                                "target_lang_word": "fortwährend",
                                "target_lang_sense_clarification": "störend oft wiederkehrend"
                            },
                            {
                                "target_lang_word": "Stamm-",
                                "target_lang_sense_clarification": "für Stammkunden/Stammgäste (regelmäßig)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89f234e0-f765-3d0d-97df-25bd0dfc3aef",
                    "sense_definition": "Рассчитанный на длительный срок использования, не временный.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "permanent_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После успешной стажировки ему предложили <w>постоянную</w> работу в офисе.",
                            "target_lang_translations": {
                                "en": "After a successful internship, he was offered a <w>permanent</w> job in the office.",
                                "de": "Nach einem erfolgreichen Praktikum wurde ihm eine <w>feste</w> Stelle im Büro angeboten."
                            }
                        },
                        {
                            "text": "Вам необходимо обменять этот временный билет на <w>постоянный</w> пропуск.",
                            "target_lang_translations": {
                                "en": "You need to exchange this temporary ticket for a <w>permanent</w> pass.",
                                "de": "Sie müssen dieses vorläufige Ticket gegen einen <w>dauerhaften</w> Ausweis eintauschen."
                            }
                        }
                    ],
                    "antonyms": [
                        "временный"
                    ],
                    "common_phrases": [
                        "постоянная работа",
                        "постоянный билет",
                        "постоянная основа"
                    ],
                    "target_lang_definitions": {
                        "en": "Intended for long-term use, not temporary.",
                        "de": "Für eine lange Nutzungsdauer vorgesehen, nicht vorübergehend."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "permanent",
                                "target_lang_sense_clarification": "lasting indefinitely, not temporary"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dauerhaft",
                                "target_lang_sense_clarification": "auf lange Zeit angelegt"
                            },
                            {
                                "target_lang_word": "fest",
                                "target_lang_sense_clarification": "unbefristet (z. B. Anstellung)"
                            },
                            {
                                "target_lang_word": "ständig",
                                "target_lang_sense_clarification": "dauerhaft (z. B. Wohnsitz)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "053459ff-2239-3224-8584-f544cece0af5",
                    "sense_definition": "Относящийся к электрическому току, который не меняет своего направления и величины.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physics_current",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Обычные батарейки и аккумуляторы вырабатывают <w>постоянный</w> ток.",
                            "target_lang_translations": {
                                "en": "Ordinary batteries and accumulators produce <w>direct</w> current.",
                                "de": "Normale Batterien und Akkus erzeugen <w>Gleichstrom</w>."
                            }
                        },
                        {
                            "text": "Для работы этого прибора требуется источник <w>постоянного</w> напряжения.",
                            "target_lang_translations": {
                                "en": "This device requires a source of <w>constant</w> voltage.",
                                "de": "Für den Betrieb dieses Geräts ist eine Quelle <w>konstanter</w> Spannung erforderlich."
                            }
                        }
                    ],
                    "antonyms": [
                        "переменный"
                    ],
                    "common_phrases": [
                        "постоянный ток",
                        "постоянное напряжение"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to electric current that does not change its direction and magnitude.",
                        "de": "Bezieht sich auf elektrischen Strom, der seine Richtung und Stärke nicht ändert."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "direct",
                                "target_lang_sense_clarification": "specifically for electric current (DC)"
                            },
                            {
                                "target_lang_word": "constant",
                                "target_lang_sense_clarification": "for voltage or physical magnitude"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Gleich-",
                                "target_lang_sense_clarification": "für Gleichstrom (DC)"
                            },
                            {
                                "target_lang_word": "konstant",
                                "target_lang_sense_clarification": "für eine unveränderliche Spannung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}