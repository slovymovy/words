                                            {
                                                "example_id": "4e18d588-e727-44c8-8e47-686cff95b203",
                                                "sense_id": "acf892a1-c02b-39e9-91e2-53cd545a33cf",
                                                "text": "Pater Amorth heeft als exorcist ongeveer veertigduizend uitdrijvingen gedaan, volgens de oude regels van het Rituale Romanum uit 1614."
                                            }
                                        ]
                                    }
                                ]
