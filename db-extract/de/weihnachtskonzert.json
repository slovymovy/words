                "senses": [
                    {
                        "sense_id": "3a513451-7dd6-3969-8f6d-48eddbddbac1",
                        "entry_id": "d081ec3a-a435-3547-a8d5-0cecd53d2965",
                        "glosses": [
                            "während der Weihnachtszeit stattfindendes und thematisch auf Weihnachten bezogenes Konzert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa983d47-0970-49ca-8225-6cdc99d6fe06",
                                "sense_id": "3a513451-7dd6-3969-8f6d-48eddbddbac1",
                                "text": "„Auch die Teilnahme des Schulchors am traditionellen Weihnachtskonzert im deutschen Generalkonsulat, das schon vorigen Dienstag stattgefunden hat, ist, wie jetzt bekannt wurde, von der türkischen Schulleitung untersagt worden.“"
                            },
                            {
                                "example_id": "44928d05-af1e-48e6-87b8-fb8037ed8dc2",
                                "sense_id": "3a513451-7dd6-3969-8f6d-48eddbddbac1",
                                "text": "„Die über lange Jahre schöne Gewohnheit, die weihnachtliche Festzeit mit einem feierlichen Weihnachtskonzert ausklingen zu lassen, wird auch heuer wieder vom Dorfener Kirchenmusiker Ernst Bartmann aufrechterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
