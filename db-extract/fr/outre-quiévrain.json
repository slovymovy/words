        "fr-extract.jsonl": [
            {
                "entry_id": "68d7d14a-9dce-3339-b01a-3100846631f3",
                "word": "outre-Quiévrain",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a55fe071-ebc4-3f32-b8e4-52806325d3ad",
                        "entry_id": "68d7d14a-9dce-3339-b01a-3100846631f3",
                        "glosses": [
                            "Du point de vue français, en Belgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ea55d3b-d679-427a-aa73-5a42ea06c347",
                                "sense_id": "a55fe071-ebc4-3f32-b8e4-52806325d3ad",
                                "text": "Reprenant leurs bonnes habitudes, nos voisins d’outre-Quiévrain consacraient la moitié de leurs achats viticoles français au Bordelais, le reste se répartissant en Bourgogne, Champagne et mousseux, Alsace ou Côtes du Rhône."
                            },
                            {
                                "example_id": "e0c0faf4-a8e6-4cc1-b376-f19002dcb107",
                                "sense_id": "a55fe071-ebc4-3f32-b8e4-52806325d3ad",
                                "text": "Outre-Quiévrain, la loi dite « Bruxelles Passif 2015 » semble valider ses propos."
                            },
                            {
                                "example_id": "ddc2623e-2b9a-4d27-b915-bb449defbca7",
                                "sense_id": "a55fe071-ebc4-3f32-b8e4-52806325d3ad",
                                "text": "C’est avec beaucoup d’étonnement que nous avons aperçu, grâce à FR3 Champagne-Ardenne, sur les parkings des supermarchés ardennais frontaliers, des coffres de voitures de nos amis belges remplis, jusqu’à plus soif, de bouteilles d’eau minérale… qui, d’après les témoignages recueillis, coûtent trois fois moins cher qu’outre-Quiévrain !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e566084b-cef4-37b2-864a-95374b321b5f",
                        "entry_id": "68d7d14a-9dce-3339-b01a-3100846631f3",
                        "glosses": [
                            "Du point de vue belge, en France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17849c35-7ff1-4cc5-b21f-86a8cc99bd81",
                                "sense_id": "e566084b-cef4-37b2-864a-95374b321b5f",
                                "text": "La pénétration des idées de ces deux hommes est facilitée par la médiation de nombreux exilés belges outre-Quiévrain."
                            },
                            {
                                "example_id": "04ee81b4-1920-4715-96f1-4fb01dc0980f",
                                "sense_id": "e566084b-cef4-37b2-864a-95374b321b5f",
                                "text": "Quoi de neuf outre-Quiévrain ? Que font les Français ?"
                            }
                        ]
                    }
                ],
