                "senses": [
                    {
                        "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                        "entry_id": "1531463a-51ee-35e8-a797-f3d812f5544a",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b123396d-41c9-47e6-9234-b122a960f4e4",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Frau Schnackenbeck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "425a89de-f349-4f1b-871d-5814615b2957",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Herr Schnackenbeck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "881b0a5c-08c0-4408-9aaa-bc565e0294fa",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Die Schnackenbecks kommen heute vom Chiemsee."
                            },
                            {
                                "example_id": "578dbfb9-7f63-400c-9b71-54e2ecccd67f",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Der Schnackenbeck trägt nie die Schals, die die Schnackenbeck ihm strickt."
                            },
                            {
                                "example_id": "6b6515f4-558b-478f-9d18-b79e65de6148",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schnackenbeck kommt, geht der Herr Schnackenbeck.“"
                            },
                            {
                                "example_id": "f27a0ecb-45a9-43e8-b717-b5fbe96e1d42",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Schnackenbeck kommt und geht."
                            },
                            {
                                "example_id": "ad53a515-9db0-4e31-821c-bd2dfabd7e9b",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "Schnackenbecks kamen, sahen und siegten."
                            },
                            {
                                "example_id": "83ac4908-c2db-4514-9bb5-ad4da7ddbccd",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "An verregneten Herbsttagen ist Familie Schnackenbecks liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "d31f1d3c-bd6b-42ec-a77f-213693f8160d",
                                "sense_id": "eb0237a5-3923-3415-a32e-2ab921743170",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Schnackenbeck das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
