                    {
                        "sense_id": "4ef159a4-ef30-32c7-897b-42204e61b876",
                        "entry_id": "8107c20d-9067-366a-a922-cdecb0e223a5",
                        "glosses": [
                            "A person who operates railway switches that route trains onto rail tracks."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe9bc05-cf74-43fe-921e-7b8b1091f704",
                                "sense_id": "4ef159a4-ef30-32c7-897b-42204e61b876",
                                "text": "This route is repeated automatically on the control panel of the appropriate box as flashing indications covering the track circuits involved and the switchman obeys the instruction by setting up the required route."
                            }
                        ]
                    },
                    {
                        "sense_id": "9122a480-612b-3ed3-bb6f-80040e3f3927",
                        "entry_id": "8107c20d-9067-366a-a922-cdecb0e223a5",
                        "glosses": [
                            "A person whose job is to help in the switching of railcars in a railway yard."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
