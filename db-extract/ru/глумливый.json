                            "singular",
                            "feminine",
                            "short-form"
                        ],
                        "form": "глумли́ва"
                    },
                    {
                        "form_id": "dcec5706-fc78-4df5-a100-7530c70587ff",
                        "entry_id": "eaa6c2a7-0ce5-347a-948d-f16e89d3b08c",
