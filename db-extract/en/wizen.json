                    {
                        "sense_id": "57951427-a3d1-35ec-88f2-a9725b366da2",
                        "entry_id": "46d29659-d1c6-365f-882b-0572cbf38d90",
                        "glosses": [
                            "Wizened; withered; lean and wrinkled by shrinkage as from age or illness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fbaaf18-5c12-4b34-8f1d-6bf763dc82da",
                                "sense_id": "57951427-a3d1-35ec-88f2-a9725b366da2",
                                "text": "His face was wizen and wrinkled, his faded blue eyes dim and weak-looking. He was feeble, and his hands were tremulous with a perpetual nervous motion."
                            },
                            {
                                "example_id": "5fde184c-1ce2-47a7-9834-4f3ccd9de234",
                                "sense_id": "57951427-a3d1-35ec-88f2-a9725b366da2",
                                "text": "Yes, there would be a day when his face would be wrinkled and wizen, his eyes dim and colourless, the grace of his figure broken and deformed. The scarlet would pass away from his lips and the gold steal from his hair."
                            }
                        ]
                    }
                ],
