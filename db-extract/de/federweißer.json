                                "text": "„So früh wie nie zuvor sind in Franken die ersten Trauben für den Federweißen gelesen worden.“"
                            },
                            {
                                "example_id": "bb312d77-a339-4bf8-8e6e-e1dd9d48fa75",
                                "sense_id": "cc29a2e5-ba7d-346e-a676-571cecbc35d1",
                                "text": "„Uns genügen Flammkuchen und Federweißer, wir sind Teil der Masse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
