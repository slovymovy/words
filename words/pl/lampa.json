                    "frequency": "Low",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary wzmacniacz audio wykorzystuje <w>lampy</w> elektronowe do przetwarzania dźwięku."
                        },
                        {
                            "text": "W gabinecie kosmetycznym używana jest specjalna <w>lampa</w> do utwardzania lakieru."
                        }
                    ],
                    "common_phrases": [
