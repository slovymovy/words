                                    {
                                        "sense_id": "f146f1ca-c4c0-3a91-9da4-13d64600d6ed",
                                        "entry_id": "13bf1dd7-54e3-33ef-801b-d4253b3d3a13",
                                        "glosses": [
                                            "związany z Quebekiem, dotyczący Quebecu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a08cef60-984e-40d4-b4d9-a7f793952ff3",
                                                "sense_id": "f146f1ca-c4c0-3a91-9da4-13d64600d6ed",
                                                "text": "Formułując teorię o automatycznej akcesji niepodległej Szkocji do Unii Europejskiej, szkoccy nacjonaliści pomijają też istotne doświadczenia quebeckie"
                                            },
                                            {
                                                "example_id": "e1ab6bea-1c97-44d6-9be7-d44e9744a4f4",
                                                "sense_id": "f146f1ca-c4c0-3a91-9da4-13d64600d6ed",
                                                "text": "Także kupcy angielscy, choć niebezpośrednio związani z quebecką wsią, odczuwali skutki kryzysu, lecz szybko poszukiwali innych możliwości dla swoich działań gospodarczych, zaczynając handlować z Górną Kanadą oraz Amerykanami"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
