                ],
                "senses": [
                    {
                        "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                        "entry_id": "d12f4498-9c2b-399c-97ea-f559c69b48af",
                        "glosses": [
                            "ein Arbeitsplatz, der gleichzeitig verschiedene Aufgabenbereiche hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2eb22ac-4926-4153-8073-ea7dfb2c2300",
                                "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                                "text": "„Zudem wurde die Arbeit gleichförmiger und monotoner als auf dem vorhergehenden Mischarbeitsplatz, auf dem auch sonstige leichte Verwaltungsarbeiten zu erledigen waren.“"
                            },
                            {
                                "example_id": "7182f440-332f-4b8f-be03-1dec810f815d",
                                "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                                "text": "„Bei mehrstelliger Einplatzeinzelarbeit werden unterschiedliche Stellenaufgaben an einem Arbeitsplatz (Mischarbeitsplatz) von einem konkreten Stelleninhaber erfüllt.“"
                            },
                            {
                                "example_id": "d6dde07a-77a0-4f4a-91af-8415507d310d",
                                "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                                "text": "„Der Mischarbeitsplatz ist der Büroarbeitsplatz der Zukunft (jedenfalls einer humaneren Zukunft).“"
                            },
                            {
                                "example_id": "e0e7bb7f-24e2-471e-a051-23367ab74074",
                                "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                                "text": "„In sehr kleinen Behörden oder Behörden-Außenstellen kann der Registrator-Dienstposten nicht allein Schriftgutverwalten umfassen, sondern muß auch fachfremde Aufgaben einschließen. Dieser Mischarbeitsplatz muß jedoch so gestaltet sein, daß das Schriftgutverwalten nicht zu kurz kommt.“"
                            },
                            {
                                "example_id": "40c25f56-9614-4499-91ae-19d03d0116a4",
                                "sense_id": "b7b7f59d-38cb-3ee6-a566-c6accff6c6cc",
                                "text": "„Eine Aufsichtstheke vor ihr dient als Mischarbeitsplatz der Auskunft und interner Arbeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
