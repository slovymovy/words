                    }
                ],
                "translations": [
                    {
                        "translation_id": "c95514d3-2a9a-4988-bf12-171892cf27c7",
                        "source_entry_id": "8b805d22-ce3d-36a4-afe5-75c3ff813843",
                        "source_sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                        "source_sense_description": "seltsam, eigenartig erscheinend",
                        "target_lang_word": "oddly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oddly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a peculiar manner; strangely; unusually."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96541df5-ae55-4169-bb0c-197733ba4364",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "For December, it was oddly warm."
                                            },
                                            {
                                                "example_id": "a2973025-3eb2-4e20-8bf8-8e04bdc917b5",
                                                "sense_id": "eff7b040-b6f4-31fd-aaa0-f085193dc257",
                                                "text": "Novv, Sir, vvhen my Time comes, leſt they ſhou'd think it vvorth vvhile to handle my Memory vvith the ſame Freedom, I am vvilling to prevent its being ſo odly beſmear'd (or at beſt but flatly vvhite-vvash'd) by taking upon me to give the Publick This, as true a Picture of myſelf as natural Vanity vvill permit me to dravv; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                        "entry_id": "22baef98-0d3b-3d56-8135-92739aaa7760",
                                        "glosses": [
                                            "In a manner measured by an odd number."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb800333-ec5f-44d7-ae79-27174e2fa8d8",
                                                "sense_id": "9bf5e97d-e63d-30d5-8fc1-5bfc81e35846",
                                                "text": "The oddly counted lords are always out of sync with at least one other evenly counted cycle. These two strange counts assured that at no single moment could all cycles end at the same time for an extraordinarily long time, for at least one odd count threw off all the even ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea7ff681-0248-40f0-9192-5278061a2e75",
                        "source_entry_id": "8b805d22-ce3d-36a4-afe5-75c3ff813843",
                        "source_sense_id": "db735d6a-d3f0-3e59-9216-a2b4597bb297",
                        "source_sense_description": "seltsam, eigenartig erscheinend",
                        "target_lang_word": "curieusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curieusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d5726c4-7dd5-337c-9520-e76a2c8c15df",
                                        "entry_id": "ed4749c5-52d2-3e82-ab6f-ac2bd25265d4",
                                        "glosses": [
                                            "Avec curiosité, avec désir de voir et de savoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e288191-d803-42b3-b811-f28fd948f257",
                                                "sense_id": "8d5726c4-7dd5-337c-9520-e76a2c8c15df",
                                                "text": "Observer, s'enquérir curieusement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abb253ae-3b58-3958-b194-fe980c8143b2",
                                        "entry_id": "ed4749c5-52d2-3e82-ab6f-ac2bd25265d4",
                                        "glosses": [
                                            "Avec soin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbe5525e-a614-4844-9931-0d4cda5c4f67",
                                                "sense_id": "abb253ae-3b58-3958-b194-fe980c8143b2",
                                                "text": "Aussi bien, que sert-il de regretter des plaisirs absents et de chercher curieusement tous les défauts de sa condition ?"
                                            },
                                            {
                                                "example_id": "93533534-3354-4777-9246-6fe88b83fbf1",
                                                "sense_id": "abb253ae-3b58-3958-b194-fe980c8143b2",
                                                "text": "Les Égyptiens conservaient curieusement les corps morts."
                                            },
                                            {
                                                "example_id": "6498fe4f-d838-4163-80cc-b0c8f9f97a96",
                                                "sense_id": "abb253ae-3b58-3958-b194-fe980c8143b2",
                                                "text": "Un autre décrit curieusement et fort au long les petites choses, et passe légèrement sur les grandes."
                                            },
                                            {
                                                "example_id": "49ab911b-c416-45d5-91a1-3824f9eae185",
                                                "sense_id": "abb253ae-3b58-3958-b194-fe980c8143b2",
                                                "text": "Ceux de ses auditeurs qui auraient le mieux entendu finesse, auraient jugé, non sans fondement, que cette manière de s'exprimer, si curieusement éloignée de la forme ordinaire, renfermait implicitement un trait de satire trop aiguisé pour être senti par la multitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9de4bda4-cf6e-3f43-b78d-5ede35050ff0",
                                        "entry_id": "ed4749c5-52d2-3e82-ab6f-ac2bd25265d4",
                                        "glosses": [
                                            "Avec soin et délicatesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51c324b1-5647-4c78-9d34-df329058bfa4",
                                                "sense_id": "9de4bda4-cf6e-3f43-b78d-5ede35050ff0",
                                                "text": "Tablette curieusement sculptée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be7011bf-ba5d-3b9e-9ca5-45c309ace0f5",
                                        "entry_id": "ed4749c5-52d2-3e82-ab6f-ac2bd25265d4",
                                        "glosses": [
                                            "D’une manière étrange."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c818f91-ce1f-418a-8283-cc91020aa7bc",
                                                "sense_id": "be7011bf-ba5d-3b9e-9ca5-45c309ace0f5",
                                                "text": "Aussi tout homme supérieur se sentait-il curieusement attiré vers cette femme douce et silencieuse."
                                            },
                                            {
                                                "example_id": "db0aba6d-02a9-4353-beef-ef549a3cbd04",
                                                "sense_id": "be7011bf-ba5d-3b9e-9ca5-45c309ace0f5",
                                                "text": "Une sphère lumineuse, tournant au plafond, scintillait de ses mille petites facettes dont les lueurs éclairaient curieusement les visages."
                                            },
                                            {
                                                "example_id": "0cbe1de3-cbdc-4630-a590-7dc798b89836",
                                                "sense_id": "be7011bf-ba5d-3b9e-9ca5-45c309ace0f5",
                                                "text": "Les cadrans bleus, mauves et rouges des instruments avec leurs divisions de radium forment curieusement le décor d'une scène de féerie enfantine aux teintes vives."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e74722c2-7147-4b21-bdf1-5409b8399cbe",
                        "source_entry_id": "8b805d22-ce3d-36a4-afe5-75c3ff813843",
