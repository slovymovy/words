                "senses": [
                    {
                        "sense_id": "ed4a1cf1-9917-3400-a9c7-77124ead86cd",
                        "entry_id": "73b4f195-d372-3bf6-9172-d8e099636572",
                        "glosses": [
                            "Qui est de la nature de la calomnie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "362c36fb-ff36-401a-8075-a541a30e3f86",
                                "sense_id": "ed4a1cf1-9917-3400-a9c7-77124ead86cd",
                                "text": "Contrairement à des accusations plus ou moins calomniatrices, leurs dépositions au cours du procès doivent être comprises comme des déclarations minimales et non comme des exagérations ; […]."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "928a297e-4705-3530-af7b-60c3420a3e7b",
                "word": "calomniateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2fa88375-db4b-4813-a8ab-546add003890",
                        "entry_id": "928a297e-4705-3530-af7b-60c3420a3e7b",
                        "tags": [
                            "plural"
                        ],
                        "form": "calomniateurs"
                    },
                    {
                        "form_id": "d43af8fc-81d6-4a21-93ff-4f1e72f51040",
                        "entry_id": "928a297e-4705-3530-af7b-60c3420a3e7b",
                        "tags": [
                            "feminine"
                        ],
                        "form": "calomniatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                        "entry_id": "928a297e-4705-3530-af7b-60c3420a3e7b",
                        "glosses": [
                            "Celui qui calomnie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a842ff14-7d16-4452-81b4-dd74a3dec3bd",
                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                "text": "Une autre calomniatrice se joignit à elle, & sçut donner de telles couleurs a ses impostures qu’elle les fit croire enfin à plusieurs."
                            },
                            {
                                "example_id": "a7288825-b91c-459a-97d6-29c5442c12e4",
                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                "text": "Leur bonheur à tous deux faisait une part du sien, c’était donc à lui d’essayer de leur rendre cette splendeur ternie un moment par un calomniateur ; […]."
                            },
                            {
                                "example_id": "f5506560-8b56-4224-ab32-7de90a994015",
                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                "text": "Le démon recourt à des calomniateurs pour nuire à François. Maintes fois l’évêque de Genève a fait l’objet de calomnies et de ragots de la part de certains ministres du culte réformé : […]."
                            },
                            {
                                "example_id": "1e078189-e85c-4bd4-8a9a-f4104f096258",
                                "sense_id": "3dc88eb7-d97e-34c8-996f-94903a24ec85",
                                "text": "C’est un mensonge et c’est une calomnie ! Vous êtes un petit calomniateur en disant ça…"
                            }
                        ]
                    }
                ],
