                        "glosses": [
                            "Cesser d’écouter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2920239d-4566-43cc-88ec-3d51efd1492a",
                                "sense_id": "9ee1e96f-b3bf-3800-a730-da54177d9318",
                                "text": "Je parle de nos besoins, que nous avons appris à désécouter."
                            },
                            {
                                "example_id": "e2924810-da03-4a4e-bb4e-d11282d54df4",
                                "sense_id": "9ee1e96f-b3bf-3800-a730-da54177d9318",
                                "text": "D’accord avec toi sur les podcasts en général d’autant plus que souvent je travaille en musique et donc quand je passe lire les amis pour faire une petite pause, ça me gêne d’être obligée de désécouter l’une pour écouter les autres."
                            },
                            {
                                "example_id": "d42546d4-4416-4b20-812f-54e851beb44e",
                                "sense_id": "9ee1e96f-b3bf-3800-a730-da54177d9318",
                                "text": "Il y a une méditation auditive qui a deux parties : premièrement, vous « désécoutez » ; puis, vous écoutez. « Désécouter » signifie séparer les sons de leurs associations qui, souvent, sont inconscientes."
                            }
                        ]
