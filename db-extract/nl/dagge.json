                ],
                "senses": [
                    {
                        "sense_id": "52051a95-7c19-3840-ac21-16a6d8dd32be",
                        "entry_id": "7b735de5-bacd-34f7-a6cb-fb916c16e183",
                        "glosses": [
                            "steekwapen, langer dan een mes, maar korter dan een zwaard"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0053f49-2c0f-4b20-bf90-a8391b3060b6",
                                "sense_id": "52051a95-7c19-3840-ac21-16a6d8dd32be",
                                "text": "De postiljon voorop. Gekleed als Gents poorter uit de middeleeuwen, gans in 't bruin, de Zwarte Leeuw op gouden veld op de borst gestikt, aan de gordelriem een dagge, in de rechterhand de knots."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9a284ac-42f9-33dd-8c8f-ea30cd619a53",
                        "entry_id": "7b735de5-bacd-34f7-a6cb-fb916c16e183",
                        "glosses": [
                            "metalen staafje met een handvat waarmee bij het metselen specie tussen stenen word aangedrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad5f4a6b-77d0-4643-95dc-eed51bd5d051",
                                "sense_id": "c9a284ac-42f9-33dd-8c8f-ea30cd619a53",
                                "text": "De dagge werd gebruikt om voegen af te strijken en zo te verdichten dan wel van een decoratie te voorzien."
                            }
                        ]
                    },
                    {
                        "sense_id": "4193a6ea-6256-3d23-a013-48ec30fa3aa3",
                        "entry_id": "7b735de5-bacd-34f7-a6cb-fb916c16e183",
                        "glosses": [
                            "kort dik stuk touw, gebruikt om mee te geselen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f44f9d56-2a1c-4c26-b748-fbe2f9cd2e94",
                                "sense_id": "4193a6ea-6256-3d23-a013-48ec30fa3aa3",
                                "text": "Dit hield in dat hij tussen tweehonderd en vijfhonderd maal met een dik touw of ‘dagge’ op de blote rug werd geslagen."
                            }
                        ]
                    }
                ],
