                    {
                        "translation_id": "df9b723c-bc52-40a7-8e27-25f6e40f49aa",
                        "source_entry_id": "77a586c8-66ef-33a8-82e2-9e09ae1ddffc",
                        "source_sense_id": "7ea417c0-8737-3baf-9be1-1d2028ddb5da",
                        "source_sense_description": "een eenwielige kar met twee lange handgrepen voor het transport van zware, meestal losse lading",
                        "target_lang_word": "Schubkarre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schubkarre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                        "entry_id": "fa31a28e-862a-3cb8-99fe-bd8ea95bdb1f",
                                        "glosses": [
                                            "kleiner einachsiger Wagen mit einem Rad, einer Wanne und zwei Handgriffen, der mit Muskelkraft geschoben wird"
                                        ],
                                        "tags": [
                                            "Landfahrzeug"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff43deca-3dd5-4a65-ba58-29c614cbb7f2",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "Die Schubkarre ist im Garten ein unentbehrlicher Helfer."
                                            },
                                            {
                                                "example_id": "80e88ca8-a1e9-4ad0-a411-2ebe0c83c71e",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "Schubkarren haben normalerweise ein Luftgummirad."
                                            },
                                            {
                                                "example_id": "2a5890b1-357c-46f9-ad58-eeaa4100cdbd",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "Beim Ausmisten von Ställen benötigt man eine Schubkarre."
                                            },
                                            {
                                                "example_id": "c2bda419-5cde-42f9-ae7b-9e6e1949021d",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "„Drei Schubkarren voller Erde und Sand hatte sie in das Loch geschüttet und die Oberfläche des Grabes geglättet.“"
                                            },
                                            {
                                                "example_id": "27667318-c412-415e-936c-d0cd99924929",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "„Mit dem Küchengerät kehre ich nach Rowen zurück; für die folgende Nacht leihe ich eine Schubkarre aus, um die Stühle zu bergen.“"
                                            },
                                            {
                                                "example_id": "47b6208a-acdf-4148-a8ba-fcd68c70d7c5",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "„Eine Frau mit einer Schubkarre voller Gartengeräte war um das Haus herumgekommen.“"
                                            },
                                            {
                                                "example_id": "38d58c99-785e-4f3c-9a7a-d8042a32ba33",
                                                "sense_id": "8c692312-f413-3422-a863-e7bd9eaf51da",
                                                "text": "„Einige schaufelten, andere fuhren die ausgehobene Erde mit Schubkarren über einen Bohlenweg fort, wieder andere standen untätig dabei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b8dfa84-b4f2-3d30-bc28-30250d6adc3d",
                                        "entry_id": "fa31a28e-862a-3cb8-99fe-bd8ea95bdb1f",
                                        "glosses": [
                                            "sportliche Übung, bei der einer auf Händen läuft, während ein Partner seine Beine hochhält und mitgeht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443aaa48-54cc-4808-9b1d-888203ee298e",
                                                "sense_id": "8b8dfa84-b4f2-3d30-bc28-30250d6adc3d",
                                                "text": "Beim Turnfest machen die Kinder paarweise Schubkarre um die Wette."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "77e0dade-2435-41a9-94b7-c19d1faf34ba",
                        "source_entry_id": "77a586c8-66ef-33a8-82e2-9e09ae1ddffc",
                        "source_sense_id": "7ea417c0-8737-3baf-9be1-1d2028ddb5da",
