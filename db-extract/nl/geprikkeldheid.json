                        "glosses": [
                            "de mate waarin iemand geïrriteerd is of raakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21c9a354-772a-482f-9bb2-04a67a47a6e3",
                                "sense_id": "7ef3ad7f-7cd4-3cb2-9412-1c3ef70f9e0f",
                                "text": "Ik de tsaar om gratie vragen! zei Denisov met een stem waaraan hij zijn vroegere energie en heftigheid wilde geven, maar waarin slechts een machteloze geprikkeldheid klonk."
                            },
                            {
                                "example_id": "094559e5-3ed6-4853-920f-019857574ef9",
                                "sense_id": "7ef3ad7f-7cd4-3cb2-9412-1c3ef70f9e0f",
                                "text": "Deze informele sfeer van ouwe-jongens-krentenbrood kan bij een gering misverstand, of onder stress, snel omslaan in geprikkeldheid, juist omdat die buffer van formaliteit ontbreekt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a081d72-f956-4f35-a9c2-abd2a2946e63",
