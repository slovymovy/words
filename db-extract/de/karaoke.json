                "senses": [
                    {
                        "sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                        "entry_id": "54a4f7a3-bfd1-3e32-945d-0276da9bc4bb",
                        "glosses": [
                            "ursprünglich aus Japan kommende Freizeitbeschäftigung, bei der meist nicht berufsmäßige Sänger die vokale Stimme zu einer Instrumentalversion eines bekannten Liedes live singen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "57f958b3-012c-4044-bd18-0f3928eb4e36",
                                "sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                                "text": "Heute Abend bin ich mit Freunden zum Karaoke verabredet."
                            },
                            {
                                "example_id": "1eb2e51e-fa7b-47d9-b99c-8dc9d8d97b0a",
                                "sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                                "text": "„Das sangesfreudige Volk macht das nicht nur in Diskotheken, mittlerweile bietet jede Kneipe, oft mehrfach in der Woche, Karaoke an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9e6cf0f5-dcc0-3467-90da-e1690c886b59",
                        "entry_id": "54a4f7a3-bfd1-3e32-945d-0276da9bc4bb",
                        "glosses": [
                            "Musikaufnahme ohne vokale Stimme eines bekannten Liedes"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01053212-96a0-4f3c-aaf4-e48b97ae1f09",
                        "source_entry_id": "54a4f7a3-bfd1-3e32-945d-0276da9bc4bb",
                        "source_sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                        "target_lang_word": "卡拉OK",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "卡拉OK",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                        "entry_id": "1398ed87-c4f4-3db6-9619-256d5d9b26ce",
                                        "glosses": [
                                            "20世紀70年代中期由日本發明的一種音響設備，可供人欣賞機內預先錄製的音樂，或使用伴奏功能演唱"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2948ae02-a333-4163-b88b-d0ca2ed0391b",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "我請你飮咖啡 卡拉OK唱歌詩",
                                                "translation": "我請你喝咖啡 帶你去卡拉OK唱歌"
                                            },
                                            {
                                                "example_id": "48b35496-19c8-4149-82d7-1f3ebac75480",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "我请你饮咖啡 卡拉OK唱歌诗",
                                                "translation": "我請你喝咖啡 帶你去卡拉OK唱歌"
                                            },
                                            {
                                                "example_id": "7d84f749-795f-45c5-8eb6-428798116de4",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "阿公仔愛唱卡拉OK 阿媽講伊眞討債",
                                                "translation": "爺爺愛唱卡拉OK 奶奶說他揮霍無度"
                                            },
                                            {
                                                "example_id": "9ede7da7-81ef-48a0-a50e-ade9c2213784",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "阿公仔爱唱卡拉OK 阿妈讲伊真讨债",
                                                "translation": "爺爺愛唱卡拉OK 奶奶說他揮霍無度"
                                            },
                                            {
                                                "example_id": "11ca1dad-a3e8-4276-a458-a5956ab9250d",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "卡拉OK甲點一塊快樂的演歌",
                                                "translation": "在卡拉OK點一首快樂的演歌"
                                            },
                                            {
                                                "example_id": "0134288c-59d2-4961-a765-d666ab29fa28",
                                                "sense_id": "8b0586cd-16ea-344d-925f-825d2f0f89b9",
                                                "text": "卡拉OK甲点一块快乐的演歌",
                                                "translation": "在卡拉OK點一首快樂的演歌"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c507ed1-a4f9-490c-b029-44e2ca2cff57",
                        "source_entry_id": "54a4f7a3-bfd1-3e32-945d-0276da9bc4bb",
                        "source_sense_id": "b13ae7fd-79e3-3958-b094-262c7e6dd7d4",
                        "target_lang_word": "karaoke",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "karaoke",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                                        "glosses": [
                                            "A form of entertainment popular in clubs, at parties, etc, in which individual members of the public sing along to pre-recorded instrumental versions of popular songs, the lyrics of which are displayed for the singer on a screen in time with the music."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b84ae3-9151-4d11-80b8-e986ad8372a7",
                                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                                "text": "The karaoke has been well received by those who frequent the oriental cabaret scene and adopt its particular social behaviors such as conversation, companionship, being seen, and showing off."
                                            },
                                            {
                                                "example_id": "99945542-6653-4a80-ac37-a1c8aad8fb4f",
                                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                                "text": "American Idol will always have a place in my heart. It's where I met Clay. And what could be more exciting than televised karaoke?"
                                            },
                                            {
                                                "example_id": "42ae3964-3572-4227-879e-6175853bf09c",
                                                "sense_id": "f30774b0-809b-368d-9436-6803b5008811",
                                                "text": "I was always split on Henley. Then I found out that he doesn’t want people to sing his songs at karaoke. In fact, Henley actually forbids karaoke companies from rerecording songs in his catalog."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d947a895-35cc-3ccb-8011-e571e0f85630",
                                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                                        "glosses": [
                                            "A karaoke session."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e92326c6-bf13-3ca1-a84d-05f9c509d2d4",
                                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                                        "glosses": [
                                            "A karaoke parlour."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "093d41a9-5f17-3e0f-b964-bc98b6d47ce3",
                                        "entry_id": "033ce6af-f7c2-3eb5-804e-f2eea5ab49d1",
                                        "glosses": [
                                            "An exercise in which the feet are alternately placed in front of each other while walking sideways to stretch various parts of the lower body and core."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
