                        "entry_id": "94aef32f-2a3f-36c0-a48e-8ba0964779c7",
                        "glosses": [
                            "Dispositif de financement public de formation continue en France."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "f1372784-3c6b-413a-93f2-ed62bcf102d4",
                                "sense_id": "1182fc71-d540-3ae6-af3b-8f84abbd3615",
                                "text": "Le compte personnel de formation (CPF), alimenté en heures, est utilisable par tout salarié, tout au long de sa vie active, pour suivre une formation qualifiante."
                            },
                            {
                                "example_id": "35009c2a-58f7-4d36-85f5-4fd139f4a70e",
                                "sense_id": "1182fc71-d540-3ae6-af3b-8f84abbd3615",
                                "text": "La fraude au CPF a fortement augmenté en 2021, détaillait en juillet Tracfin, la cellule de renseignements financiers de Bercy."
                            },
                            {
                                "example_id": "7565e8fa-b7b6-420f-8c82-bea98511765e",
                                "sense_id": "1182fc71-d540-3ae6-af3b-8f84abbd3615",
                                "text": "Jeudi, le Sénat a adopté à l’unanimité une proposition de loi pour interdire le démarchage commercial d’un titulaire de compte personnel de formation (CPF)."
                            }
                        ]
                    }
