                                        "sense_id": "159bdccf-cb95-35e9-84ea-ae776adc3ffa",
                                        "entry_id": "ee8302e3-3fc1-31bf-aafd-bac13d81ce6b",
                                        "glosses": [
                                            "Petit biscuit plat, allongé, à extrémité arrondie à pâte croquante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c3add8-8e53-4f48-ba4b-5a0dc5042201",
                                                "sense_id": "159bdccf-cb95-35e9-84ea-ae776adc3ffa",
                                                "text": "« – Je t’offrirai à goûter, dit–elle. J’ai des confitures d’abricots, et des langues de chat. Et puis, je te montrerai mes jouets. J’en ai des tas. »"
                                            },
                                            {
                                                "example_id": "650eaa97-4dbe-41bf-bbdb-5e1b0efaf81f",
                                                "sense_id": "159bdccf-cb95-35e9-84ea-ae776adc3ffa",
                                                "text": "... ce jour où, du haut de ses 5 ans, il « tomba dans la marmite » lorsque sa mère ; Léonie, lui proposa de façonner des langues de chat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2097e98-5235-398b-9004-d8ac197c9356",
                                        "entry_id": "ee8302e3-3fc1-31bf-aafd-bac13d81ce6b",
                                        "glosses": [
                                            "Petit morceau de viande bovine, situé dans le rumsteck."
                                        ],
                                        "tags": [
                                            "Boucherie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74e076af-4acf-4572-9be7-fbdae6a78073",
                                                "sense_id": "b2097e98-5235-398b-9004-d8ac197c9356",
                                                "text": "Il y a un morceau du boucher qui s’appelle la langue de chat. C’est un petit morceau sur le dessus du rumsteck."
                                            },
                                            {
                                                "example_id": "95f6f968-9426-4186-bc16-49db4bec5c6b",
                                                "sense_id": "b2097e98-5235-398b-9004-d8ac197c9356",
                                                "text": "La langue de chat de bœuf est une grillade trop peu connue, goûteuse, qui se rapproche du rumsteak, et tient son nom de sa forme allongée et conique."
                                            },
                                            {
                                                "example_id": "07982864-9eab-49e7-acd2-84c219e6c75e",
                                                "sense_id": "b2097e98-5235-398b-9004-d8ac197c9356",
                                                "text": "Petit morceau issu du rumsteck, la langue de chat est un secret de boucher qui fait d’excellents steaks individuels !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4243fb2f-dc95-3b41-b9a6-c3166ea8a5b3",
                                        "entry_id": "ee8302e3-3fc1-31bf-aafd-bac13d81ce6b",
                                        "glosses": [
                                            "Petite truelle dont la lame est fine et allongée, au bout arrondi, utilisée pour la confection des joints ou de menus travaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fa3587b-f6e8-481c-8207-8e2724fcbe3f",
                                                "sense_id": "4243fb2f-dc95-3b41-b9a6-c3166ea8a5b3",
                                                "text": "Humidifiez légèrement et écrasez à la truelle ou, comme ici, à la langue de chat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e39b7381-3943-3768-b1e4-51d23e0df4a9",
                                        "entry_id": "ee8302e3-3fc1-31bf-aafd-bac13d81ce6b",
                                        "glosses": [
                                            "Petit burin de graveur sur bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff9ee29-eb4d-4aed-a6fe-9ad24ab7815a",
                                                "sense_id": "e39b7381-3943-3768-b1e4-51d23e0df4a9",
                                                "text": "Ses premiers bois se ressentent de la facture du burin sur acier et de l'emploi de la langue de chat, mais bientôt il évolua avec les bois dessinés au crayon, qui ne demandaient qu'un fac-similé sincère, …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
