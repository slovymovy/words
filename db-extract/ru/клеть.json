                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a1b4ec4-3df1-3d71-83a7-d35d318baa40",
                        "entry_id": "95baad6a-8d7e-3c5c-a6b7-2e2a0115c394",
                        "glosses": [
                            "простая деревянная конструкция, образованная положенными друг на друга венцами из брёвен"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c779551a-7a68-4903-8180-88df8c6b0f0f",
                                "sense_id": "4a1b4ec4-3df1-3d71-83a7-d35d318baa40",
                                "text": "Основу церкви составляет обыкновенная клеть, какие здешние смерды рубили и для бытовых построек."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ee574a9-968a-3cd6-b86d-92a8f925eaaf",
                        "entry_id": "95baad6a-8d7e-3c5c-a6b7-2e2a0115c394",
                        "glosses": [
                            "особое помещение при избе или отдельная нежилая постройка для хранения имущества; кладовая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784cfef9-0c27-4e0c-b17a-cfb9626c39de",
                                "sense_id": "0ee574a9-968a-3cd6-b86d-92a8f925eaaf",
                                "text": "К Крестьянину на двор // Залез осенней ночью вор; // Забрался в клеть и на просторе, // Обшаря стены все, и пол, и потолок, // Покрал бессовестно, что мог .."
                            }
                        ]
                    },
                    {
                        "sense_id": "61cb095a-7a9e-3964-b5e5-878b4c8a4dd9",
                        "entry_id": "95baad6a-8d7e-3c5c-a6b7-2e2a0115c394",
                        "glosses": [
                            "металл. основной рабочий узел прокатного стана"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0f1c5309-556f-35b5-9304-dbd159498a79",
                        "entry_id": "95baad6a-8d7e-3c5c-a6b7-2e2a0115c394",
                        "glosses": [
                            "горн. подъёмное устройство для транспортирования шахтных вагонеток и людей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "769cd40a-cc31-4955-a4c0-3478ea9f55e7",
                                "sense_id": "0f1c5309-556f-35b5-9304-dbd159498a79",
                                "text": "Когда поданный вагончик был заполнен и отведен в клеть, инженер нажал кнопку, и клеть поднялась на два метра: в уровень с платформой стало нижнее отделение ее, в котором также помещался вагончик."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b208cf76-20e1-42ee-b9f2-e0ffccb37143",
                        "source_entry_id": "95baad6a-8d7e-3c5c-a6b7-2e2a0115c394",
                        "source_sense_description": "шахтное подъёмное устройство",
                        "target_lang_word": "cage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "An enclosure made of bars, normally to hold animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "176422fe-611a-402b-85a2-b15d15e3a079",
                                                "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                                "text": "Stone walls do not a prison make, / Nor iron bars a cage."
                                            },
                                            {
                                                "example_id": "f58e087b-7403-43ac-b443-8b3321c42d07",
                                                "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                                "text": "We keep a bird in a cage."
                                            },
                                            {
                                                "example_id": "1885df09-6066-46a7-bcdb-fdfb53543b97",
                                                "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                                "text": "The tigers are in a cage to protect the public."
                                            },
                                            {
                                                "example_id": "8de48867-7e13-4328-9b59-1dd71c640edb",
                                                "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                                "text": "The most dangerous prisoners are locked away in a cage."
                                            },
                                            {
                                                "example_id": "7b58b3a2-4a40-4c42-af59-81f1c1786723",
                                                "sense_id": "c676bc0b-d22f-385e-a4f4-9879697572df",
                                                "text": "For his father had / never a house but the cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aca46cb9-819c-3a61-8cd7-dd7a44790fd0",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "The passenger compartment of a lift."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9955b285-c4f2-3621-be67-63b53bbd7b71",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "The goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbfccb81-29a3-3f6c-b40b-c1a9215cba4c",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "An automobile."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "535498ca-0c6c-39fe-bb93-3f8b3be21136",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "Something that hinders freedom."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7774eb74-3f65-41e7-8ccb-54ff90f031cc",
                                                "sense_id": "535498ca-0c6c-39fe-bb93-3f8b3be21136",
                                                "text": "Schwartz examines with dignity and tenderness the battles within and without of […] families, created and biological, and the cages and freedom they can provide."
                                            },
                                            {
                                                "example_id": "5b863fc4-d12a-410c-b1ec-1b64f214efb8",
                                                "sense_id": "535498ca-0c6c-39fe-bb93-3f8b3be21136",
                                                "text": "My body is a cage / That keeps me from dancing with the one I love / But my mind holds the key"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52fedbc3-24f0-30db-a4a3-9c7f531f52d7",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "A prison or prison cell."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4e8ecde-0362-4fff-9f45-cb655dc61d52",
                                                "sense_id": "52fedbc3-24f0-30db-a4a3-9c7f531f52d7",
                                                "text": "The 'out of the closet' lesbians and gay men here in the Iowa Cages are harassed and discriminated daily by oppressive pigs, believe me, I know, as a lesbian I've experienced it first hand and seen my fellow lesbian and gay friends oppressed to where I'm ready to explode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdcf1e0-2211-3544-8246-20d3f018ceea",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "The area from which competitors throw a discus or hammer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7124b490-0c9e-39ef-8df2-3e2536c68fd4",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "An outer framework of timber, enclosing something within it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b46e224-c284-4223-9fd9-81af6459e70b",
                                                "sense_id": "7124b490-0c9e-39ef-8df2-3e2536c68fd4",
                                                "text": "Cage, in carpentry, is an outer work of timber inclosing another within it. Thus the cage of a stair is the wooden inclosure that encircles it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "322b5274-fbad-3b26-99ae-604c56c0fbb5",
                                        "entry_id": "9cfcd227-54ae-3027-9448-78cf049350f0",
                                        "glosses": [
                                            "A skeleton frame to limit the motion of a loose piece, such as a ball valve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
