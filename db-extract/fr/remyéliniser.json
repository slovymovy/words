                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00b7c7d4-0af0-402f-b11e-96ecc5cd8a8e",
                                "sense_id": "61065c4f-3d16-377f-ae5e-56dc379357dd",
                                "text": "Des oligodendrocytes normaux, sans doute capables de remyéliniser, sont encore identifiés, ainsi qu'une gliose astrocytaire débutante, de rares cellules nécrotiques et quelques lymphocytes,"
                            },
                            {
                                "example_id": "609add61-d371-45c1-9100-a5addbc3e7a9",
                                "sense_id": "61065c4f-3d16-377f-ae5e-56dc379357dd",
                                "text": "Les axones peuvent temporairement se remyéliniser et cicatriser en début de maladie, les atteintes neurologiques, après une poussée, deviennent réversibles."
                            }
                        ]
                    }
