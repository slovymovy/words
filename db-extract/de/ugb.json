        "de-extract.jsonl": [
            {
                "entry_id": "048ae755-d7ee-3ee6-b2a6-bec904f1efd8",
                "word": "UGB",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b000f782-0606-3070-966e-df900c19025f",
                        "entry_id": "048ae755-d7ee-3ee6-b2a6-bec904f1efd8",
                        "glosses": [
                            "österreichisches UnternehmensGesetzBuch (löste in Österreich per 1. Jänner 2007 das nach dem Anschluss 1938 übernommene deutsche HGB ab)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b74bff7e-b280-4cd4-905c-9b75419cf2fd",
                                "sense_id": "b000f782-0606-3070-966e-df900c19025f",
                                "text": "Zu Jahresbeginn hat das Unternehmensgesetzbuch (UGB) das altbekannte Handelsgesetzbuch (HGB) abgelöst."
                            },
                            {
                                "example_id": "f06d0a23-f927-4e81-8faf-e9b5720d5f7a",
                                "sense_id": "b000f782-0606-3070-966e-df900c19025f",
                                "text": "In Österreich ist das bereits der Fall: Abschlussprüfer haften laut Unternehmensgesetzbuch (UGB) nach Größe und Börsenotierung in vier Stufen von zwei Mio. bis zwölf Mio. Euro für fahrlässig verursachten Schaden."
                            },
                            {
                                "example_id": "1a17afab-67f7-401e-8fd0-69fe2d0d7d17",
                                "sense_id": "b000f782-0606-3070-966e-df900c19025f",
                                "text": "Das UGB-Hörbuch soll nur der Anfang einer ganzen Audioskriptum-Reihe sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "171500d0-db48-3595-bd2f-70f53cfbda60",
                        "entry_id": "048ae755-d7ee-3ee6-b2a6-bec904f1efd8",
                        "glosses": [
                            "deutscher \\\"Verband für Unabhängige Gesundheitsberatung\\\", der 1981 in Gießen als gemeinnütziger Verein gegründet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6d592d4-3d41-4751-8453-7236e42f8c83",
                                "sense_id": "171500d0-db48-3595-bd2f-70f53cfbda60",
                                "text": "Der UGB informiert Wissenschaftler und Verbraucher fachlich fundiert und unabhängig zu Ernährungs- und Gesundheitsthemen."
                            },
                            {
                                "example_id": "ce116bbc-8bcc-40b2-801a-d591efc535d2",
                                "sense_id": "171500d0-db48-3595-bd2f-70f53cfbda60",
                                "text": "Heilerde ist frei von Nebenwirkungen. Lt. UGB sollten nur schwangere und stillende Frauen sowie Kinder unter zwölf Jahren vorsichtshalber darauf verzichten, weil hierfür keine ausreichenden Untersuchungen vorliegen."
                            },
                            {
                                "example_id": "244b75a5-11b4-44f6-b6d5-0dad407e2cff",
                                "sense_id": "171500d0-db48-3595-bd2f-70f53cfbda60",
                                "text": "UGB-FachberaterInnen [sic] für Säuglings- und Kinderernährung unterstützen dabei, den Nachwuchs von Anfang an richtig zu versorgen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "0f5ea617-4f5e-379a-99d8-5f187f70c555",
                        "entry_id": "048ae755-d7ee-3ee6-b2a6-bec904f1efd8",
                        "glosses": [
                            "ein seit 1990 geplantes deutsches UmweltGesetzBuch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f83b144-904f-4c17-b210-7c3e060a09bc",
                                "sense_id": "0f5ea617-4f5e-379a-99d8-5f187f70c555",
                                "text": "Im Jahr 1990 stellten die Professoren Michael Kloepfer, Eckard Rehbinder, Eberhard Schmidt-Aßmann und Philip Kunig ihren Vorschlag für ein UGB der Öffentlichkeit vor (BERICHTE des Umweltbundesamtes 7/90)."
                            },
                            {
                                "example_id": "0241f29e-8096-4098-8bfb-c750449c6604",
                                "sense_id": "0f5ea617-4f5e-379a-99d8-5f187f70c555",
                                "text": "Das ausgeuferte deutsche Umweltrecht soll, so steht es im Koalitionsvertrag, vereinfacht und in einem Umweltgesetzbuch (UGB) zusammengefasst werden."
                            },
                            {
                                "example_id": "3f3a7e36-aa3a-4719-a682-4b18c5757c08",
                                "sense_id": "0f5ea617-4f5e-379a-99d8-5f187f70c555",
                                "text": "Nach Verabschiedung der Föderalismusreform will Bundesumweltminister Sigmar Gabriel die zwischen den Koalitionsparteien vereinbarte Neuordnung des Umweltrechts in einem Umweltgesetzbuch (UGB) zügig angehen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
