                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Влияние этого события на историю весьма <значительно>.",
                            "target_lang_translations": {
                                "en": "The influence of this event on history is quite <significant>.",
                                "zh": "这一事件对历史的影响非常<w>显著</w>。"
                            }
                        },
                        {
                            "text": "Расстояние между этими двумя городами <значительно>.",
                            "target_lang_translations": {
                                "en": "The distance between these two cities is <considerable>.",
                                "zh": "这两个城市之间的距离<w>相当大</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "существенно",
                        "важно"
                    ],
                    "antonyms": [
