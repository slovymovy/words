                "translations": [
                    {
                        "translation_id": "bec6cf30-61f4-4b5c-a4d6-c7750b753701",
                        "source_entry_id": "848e632a-0b75-3527-8d61-ddc7ad4d6353",
                        "source_sense_description": "сделанный из кремня",
                        "target_lang_word": "flint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A hard, fine-grained quartz that fractures conchoidally and generates sparks when struck against a material such as steel, because tiny chips of the steel are heated to incandescence and burn in air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088b64c0-82c9-455c-9fe2-f2e3eccf6fe8",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "He used flint to make a fire."
                                            },
                                            {
                                                "example_id": "9dbd6686-33d7-4a5b-9196-48b8956b695a",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "Some of the enormous fragments of chalk which are interstratified with drift have not only layers of undisturbed flints, but also sandpipes in the middle of them, or cylindrical cavities filled with sand and gravel […]"
                                            },
                                            {
                                                "example_id": "c0689f34-8c70-442c-a02d-d414e184b957",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "In a cornfield on one side flakings of flint are numerous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fbd3d57-3094-32d4-9b14-f0389961c643",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A piece of flint, such as a gunflint, used to produce a spark by striking it with a firestriker."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cc44ad1-6f1c-34bb-8e94-d2f2f90ae32b",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A small cylinder of some other material of the same function in a cigarette lighter, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ba6e2ed-6963-371e-b563-5c8800d0379b",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A type of maize/corn with a hard outer hull."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d671b8-3ab8-3ff0-a434-e7fc4173495f",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "Anything figuratively hard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                        "entry_id": "3c69ca49-fc85-3ebf-a24d-4e6d39ea74d3",
                                        "glosses": [
                                            "To furnish or decorate an object with flint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162f53f8-2dbf-46c5-aac0-6ad0a8b3a96e",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "No schoolboys lingered round Bob Robertson's (yclept Roberson's) blacksmith's shop, for this sleepy day no lusty throat bellowed attention to the flaming tongues fanned from its bloodily blazing teeth; no luminous stars flinted from the clanking anvil."
                                            },
                                            {
                                                "example_id": "a227c6e5-3f87-462f-af90-8d92bad5f186",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "No change from the primordial doth appear, / Within the earth’s rotation of the year, / Nor are ye heirless of her sane decree, / The problem is potentiality / Of Spring and Autumn, burdenful with Fate, / Upon the seeds of labour ye must wait, / Sowing the Consequence by which ye came, / Flinting the fire not to fire but flame, / With all the end of Destiny the same!"
                                            },
                                            {
                                                "example_id": "5d7a0703-e726-439f-afe2-69146588bb58",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "The sun had warmed the air to a balmy 45 degrees and sent sparks flinting off the bleachy white snow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d94d4be1-4af0-4b67-90db-98706ba725bc",
                        "source_entry_id": "848e632a-0b75-3527-8d61-ddc7ad4d6353",
                        "source_sense_description": "сделанный из кремня",
                        "target_lang_word": "flintstone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flintstone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "97bb7cf1-41fe-3b25-bf11-99c2cffa1809",
                                        "entry_id": "60fa58f7-1bc5-347f-b27a-ee9988effac7",
                                        "glosses": [
                                            "A piece of flint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1851537a-5bb4-4911-814b-490a0fb71800",
                                                "sense_id": "97bb7cf1-41fe-3b25-bf11-99c2cffa1809",
                                                "text": "The very poor will sometimes adorn the graves of those they love with oystershells, or flintstones, or small plaster busts, or tiles […]"
                                            },
                                            {
                                                "example_id": "50e02b61-69da-48ae-b9f8-bd18ec537860",
                                                "sense_id": "97bb7cf1-41fe-3b25-bf11-99c2cffa1809",
                                                "text": "At times when there was inadequate sunlight to focus through the lens, the king struck flintstones to ignite the flame in the same way."
                                            },
                                            {
                                                "example_id": "da60107f-c5dc-497f-8ef2-4989eb5ca616",
                                                "sense_id": "97bb7cf1-41fe-3b25-bf11-99c2cffa1809",
                                                "text": "They stacked flintstones in a way that permitted night winds to pass around them and cool them so they collected moisture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "984180a3-1ff0-4a3e-9e08-2d286c505df2",
                        "source_entry_id": "848e632a-0b75-3527-8d61-ddc7ad4d6353",
                        "source_sense_description": "сделанный из кремня",
                        "target_lang_word": "firestone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firestone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f656ff27-a37b-33b7-a2e2-c1bfa33f8f2d",
                                        "entry_id": "867cb9e6-d78a-33d6-9e80-a0d78d663a4c",
                                        "glosses": [
                                            "Iron pyrite, formerly used for striking fire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7a2c5ea-0f6c-36c6-a3fe-36f264d7f82f",
                                        "entry_id": "867cb9e6-d78a-33d6-9e80-a0d78d663a4c",
                                        "glosses": [
                                            "A flint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18485699-af26-3d4c-980a-ac62b7a88500",
                                        "entry_id": "867cb9e6-d78a-33d6-9e80-a0d78d663a4c",
                                        "glosses": [
                                            "A stone which will bear the heat of a furnace without injury; especially applied to the sandstone at the top of the upper greensand in the south of England, used for lining kilns and furnaces."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3716e75e-bb2c-42d9-8483-220fdd2ff343",
                                                "sense_id": "18485699-af26-3d4c-980a-ac62b7a88500",
                                                "text": "On the descent the line is often in cuttings; some are high, such as at Scarcroft, where a cut through firestone and fireclay was necessary, and near Bardsey, where the line threads a deep tree-lined gorge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab39ab52-99fb-46c4-9beb-086deecdc7e8",
                        "source_entry_id": "848e632a-0b75-3527-8d61-ddc7ad4d6353",
                        "source_sense_description": "действующий с помощью кремня",
                        "target_lang_word": "flint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A hard, fine-grained quartz that fractures conchoidally and generates sparks when struck against a material such as steel, because tiny chips of the steel are heated to incandescence and burn in air."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "088b64c0-82c9-455c-9fe2-f2e3eccf6fe8",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "He used flint to make a fire."
                                            },
                                            {
                                                "example_id": "9dbd6686-33d7-4a5b-9196-48b8956b695a",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "Some of the enormous fragments of chalk which are interstratified with drift have not only layers of undisturbed flints, but also sandpipes in the middle of them, or cylindrical cavities filled with sand and gravel […]"
                                            },
                                            {
                                                "example_id": "c0689f34-8c70-442c-a02d-d414e184b957",
                                                "sense_id": "08eaede2-3567-3d7e-8635-abc3d34e0b1c",
                                                "text": "In a cornfield on one side flakings of flint are numerous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fbd3d57-3094-32d4-9b14-f0389961c643",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A piece of flint, such as a gunflint, used to produce a spark by striking it with a firestriker."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cc44ad1-6f1c-34bb-8e94-d2f2f90ae32b",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A small cylinder of some other material of the same function in a cigarette lighter, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ba6e2ed-6963-371e-b563-5c8800d0379b",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "A type of maize/corn with a hard outer hull."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d671b8-3ab8-3ff0-a434-e7fc4173495f",
                                        "entry_id": "edfe9ff1-9c9c-33a5-a9c7-af98a9c2dab1",
                                        "glosses": [
                                            "Anything figuratively hard."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "flint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                        "entry_id": "3c69ca49-fc85-3ebf-a24d-4e6d39ea74d3",
                                        "glosses": [
                                            "To furnish or decorate an object with flint."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "162f53f8-2dbf-46c5-aac0-6ad0a8b3a96e",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "No schoolboys lingered round Bob Robertson's (yclept Roberson's) blacksmith's shop, for this sleepy day no lusty throat bellowed attention to the flaming tongues fanned from its bloodily blazing teeth; no luminous stars flinted from the clanking anvil."
                                            },
                                            {
                                                "example_id": "a227c6e5-3f87-462f-af90-8d92bad5f186",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "No change from the primordial doth appear, / Within the earth’s rotation of the year, / Nor are ye heirless of her sane decree, / The problem is potentiality / Of Spring and Autumn, burdenful with Fate, / Upon the seeds of labour ye must wait, / Sowing the Consequence by which ye came, / Flinting the fire not to fire but flame, / With all the end of Destiny the same!"
                                            },
                                            {
                                                "example_id": "5d7a0703-e726-439f-afe2-69146588bb58",
                                                "sense_id": "e271fe97-aef5-3550-939a-86fc2ef29853",
                                                "text": "The sun had warmed the air to a balmy 45 degrees and sent sparks flinting off the bleachy white snow."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
