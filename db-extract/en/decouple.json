                "senses": [
                    {
                        "sense_id": "99d22f2b-4c3a-3771-b78c-be984c209e2a",
                        "entry_id": "08504135-b208-3712-9dd1-0c4827b19ac5",
                        "glosses": [
                            "To unlink; to take apart or come apart."
                        ],
                        "tags": [
                            "ambitransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a9afb7bf-ec52-414a-adfa-d4f23193ab20",
                                "sense_id": "99d22f2b-4c3a-3771-b78c-be984c209e2a",
                                "text": "radiation decoupled from matter"
                            },
                            {
                                "example_id": "a99dda70-d629-4ed7-9976-099d8940cd8b",
                                "sense_id": "99d22f2b-4c3a-3771-b78c-be984c209e2a",
                                "text": "to decouple a spent rocket stage"
                            },
                            {
                                "example_id": "dde575c6-5cb9-4c21-823a-1dcdfc41f69b",
                                "sense_id": "99d22f2b-4c3a-3771-b78c-be984c209e2a",
                                "text": "Wild said in a previous project update that Bond Street had been \"decoupled from the opening of the railway\" and that it is not yet clear if it will open as part of the initial Elizabeth Line opening this spring."
                            }
                        ]
                    },
                    {
                        "sense_id": "76802eea-2868-32c8-b532-6447ec488978",
                        "entry_id": "08504135-b208-3712-9dd1-0c4827b19ac5",
                        "glosses": [
                            "To muffle the seismic waves of (a nuclear explosion) by performing it underground."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "19c18422-f102-4f52-9135-08fdf433a39c",
                                "sense_id": "76802eea-2868-32c8-b532-6447ec488978",
                                "text": "Smaller explosions and decoupled tests would be permitted. Further, the United States proposed that the three powers should start intensive research on the improvement of methods for detection and identification of underground explosions […]"
                            },
                            {
                                "example_id": "94288391-58f0-4f4f-8bc0-e17a15f09629",
                                "sense_id": "76802eea-2868-32c8-b532-6447ec488978",
                                "text": "Decoupled tests would be nuclear explosions set off in massive underground caverns, a site that would greatly reduce the seismic waves caused by the explosion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "689b4538-06d7-4471-a9f4-98b402a92e7b",
