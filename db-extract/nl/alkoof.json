                "senses": [
                    {
                        "sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                        "entry_id": "7b338d9b-6037-3a95-aade-05eab33acf48",
                        "glosses": [
                            "een kleine raamloze zijkamer, vaak gebruikt als slaapkamer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f2e6c25-9a55-469b-b515-87e170dc7efe",
                                "sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                                "text": "Karin ligt in de slaapkamer te slapen, ik zit op de rotanstoel in de alkoof, die uitkijkt op de smalle strook bos die onze tuin scheidt van die van de buren."
                            },
                            {
                                "example_id": "94bc459b-2d05-4789-8223-b2cc5bc64b54",
                                "sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                                "text": "Het was een alkoof waarin de bewoner zich kon wassen en kleden - een soort kleedkamer die in een Normandisch fort niet thuishoorde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11f4fd4f-4f04-4732-80a9-8bf494e438c0",
                        "source_entry_id": "7b338d9b-6037-3a95-aade-05eab33acf48",
                        "source_sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                        "source_sense_description": "een kleine raamloze zijkamer, vaak gebruikt als slaapkamer",
                        "target_lang_word": "Alkoven",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alkoven",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                        "entry_id": "381acccc-d865-340e-b371-d16924ea584e",
                                        "glosses": [
                                            "(zumeist durch einen Vorhang) von einem größeren Raum (zumeist dem eigentlichen Schlafraum) abgegrenzte, fensterlose Nische beziehungsweise nischenartiger Nebenraum mit Schlafgelegenheit"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "687a162b-895e-44ba-a6d3-872757d3e0da",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Ueber die Lage unſeres Zimmers hoͤchſt vergnuͤgt, bemerkten wir kaum[,] daß im Grunde deſſelben ein erhoͤhter Alkoven hinter Vorhaͤngen verſteckt ſey, wo ſich das weitlaͤufigſte Bett ausbreitete, das, mit einem ſeidenen Thronhimmel prangend, mit den uͤbrigen veralteten[,] ſtattlichen Mobilien voͤllig uͤbereinſtimmte.“"
                                            },
                                            {
                                                "example_id": "c3079986-9c31-4cbe-9f89-7f64c2afcb2f",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Ihr Bett ſtand in einem Alkoven, deſſen ſchwere Vorhänge nur zum kleineren Theile vorgezogen waren.“"
                                            },
                                            {
                                                "example_id": "70e95c98-cb83-4a28-94b3-d2fa2a8dc67d",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Die Alte murmelte etwas und ging; ich kroch in meinem Alkoven unter die Decke, hörte noch, wie es von Michaelis elf ſchlug, und wie der Wind aufkam und zwiſchen die loſen Dachpfannen fuhr; dann hörte ich nichts mehr.“"
                                            },
                                            {
                                                "example_id": "f2fe5274-a33a-4cb1-aeed-1c557b1d6b62",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Roswitha zog in ſelbiger Stunde noch mit ihren paar Habſeligkeiten in das landrätliche Haus hinüber und richtete ſich in dem kleinen Alkoven ein.“"
                                            },
                                            {
                                                "example_id": "d7172683-e9d9-4ed9-90bb-d21e5cf5ef91",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Adrian hatte in einem gegiebelten Bürgerhause am Marktplatz ein Zimmer mit Alkoven gefunden, das er als Untermieter einer älteren Beamtenwitwe während der zwei Jahre seines Aufenthaltes bewohnte.“"
                                            },
                                            {
                                                "example_id": "8f4a7544-740e-4247-b8d3-ef3b15c0d502",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Als es noch Vorhänge hatte, mochte das eine Art Alkoven gewesen sein.“"
                                            },
                                            {
                                                "example_id": "f403d5a4-5068-4a8d-9c44-6c3107ed15b0",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„In den Bauernhäusern Norddeutschlands war das als Kasten oder Verschlag mit der Wand fest verbundene Wandbett, das Alkoven, Butze, Durk oder Beddekast genannt wurde, die verbreitetste Schlafstätte für Erwachsene.“"
                                            },
                                            {
                                                "example_id": "71f8a5d9-1484-4065-bd71-56d1221bca6f",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Am Morgen nach diesem Coitus, den keiner wollte, grinsen uns die beiden anderen, die neben uns im Alkoven gelegen haben, immer so komisch an.“"
                                            },
                                            {
                                                "example_id": "0de6a61b-d333-40c6-a626-cbe1032a0094",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Ihre Wohnung war klein, sie bestand aus einer Küche und einem winzigen Schlafraum, der eher einem Alkoven glich und in dem nur ein Bett und ein Kleiderschrank standen.“"
                                            },
                                            {
                                                "example_id": "320331d7-5cf5-47dd-8cf5-5e43555b67a4",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Es besaß eine Art Alkoven mit einem großen Bett, das mit einem blauen Satinüberwurf zugedeckt war, passend zu den Vorhängen.“"
                                            },
                                            {
                                                "example_id": "2727e7cf-c7cf-4d39-a472-295ae8c9392f",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Aber bis ins 20. Jahrhundert hinein war im ländlichen Norddeutschland das vornehm Alkoven genannte, mit einem Vorhang verkleidete wandfeste Schrankbett gang und gäbe, in das sich Bauer und Bäuerin, Knechte und Mägde abends zurückzogen.“"
                                            },
                                            {
                                                "example_id": "7a760637-7401-48cf-aa91-bb8b19a8dec5",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Diese Bacchanalien entarteten manchmal zu Orgien - etliche Paare umschlangen sich in den Alkoven der Gesandtschaft, […].“"
                                            },
                                            {
                                                "example_id": "435edccc-aadf-4102-be84-f7f7430a95cb",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„Wer möchte, kann hier in einem Alkoven (einer Bettnische) übernachten.“"
                                            },
                                            {
                                                "example_id": "44b3377b-45f2-49f6-aeb8-f786efc69dd6",
                                                "sense_id": "44871c70-46d1-3021-a60a-3297a97f6ebf",
                                                "text": "„In Werner Webers literarkritischem Buch ‚Zeit ohne Zeit‘, das 1959 bei Manesse in Zürich erschienen ist und in der Bundesrepublik viel zu wenig beachtet wurde, heißt es einmal: ‚[…] Vorurteil ist ein Urteil ohne Prozeß; es ist in einer Zeit, die auf Rationalisierung drängt, ein Alkoven der Irrationalität; Mündungsplatz der Gefühle statt der Gründe.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ca4765f6-c5f5-362f-a55f-8c76e4c96a69",
                                        "entry_id": "381acccc-d865-340e-b371-d16924ea584e",
                                        "glosses": [
                                            "(von einem größeren Raum abgehender) kleiner, fensterloser Nebenraum"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1836e211-adc2-4c61-8fce-58025e575555",
                                                "sense_id": "ca4765f6-c5f5-362f-a55f-8c76e4c96a69",
                                                "text": "„Er eilte nach dem Alkoven, der offenbar als Toilettenzimmer dienen ſollte, und ſtellte ſich überlegend vor die Apparate.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "22b54e39-1b93-305e-9690-6d1d7b7e1328",
                                        "entry_id": "381acccc-d865-340e-b371-d16924ea584e",
                                        "glosses": [
                                            "(in einem Lastkraftwagen, Wohnmobil oder dergleichen) hinter oder über dem Führerhaus befindlicher, abgeteilter Schlafbereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ede91436-a32b-4450-bf4e-a3eaf584e749",
                                                "sense_id": "22b54e39-1b93-305e-9690-6d1d7b7e1328",
                                                "text": "„Sie tragen Kastenaufbauten mit Alkoven – ‚Nasenbären‘ – und sind als Alltagsfahrzeuge weniger gut zu gebrauchen, offerieren dabei aber mehr Raum für bis zu sechs Reiselustige.“"
                                            },
                                            {
                                                "example_id": "800fc71a-3dbb-404f-a106-99ff4fdaae25",
                                                "sense_id": "22b54e39-1b93-305e-9690-6d1d7b7e1328",
                                                "text": "„In Verfolgung dieses Plans fuhr er laut Anklage mit einem vom Mittäter bereitgestellten und präparierten Wohnmobil nach Istanbul, wo es P. übernahm und das Heroin in die Liegefläche des Alkovens einbaute.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "500b6b6a-bd77-3a9d-bcbe-27e4ce6304ed",
                                        "entry_id": "381acccc-d865-340e-b371-d16924ea584e",
                                        "glosses": [
                                            "intimer, verschwiegener Ort (als heimlicher Treffpunkt von Paaren, Verliebten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5bb49e1-8589-4f89-95a6-377995ac181d",
                                                "sense_id": "500b6b6a-bd77-3a9d-bcbe-27e4ce6304ed",
                                                "text": "„An Winternachmittagen werden die kleinen Parks heimgesucht von Streunern, Clochards, Arbeitslosen und Alten, von Kranken, Ziellosen, Abgehängten. […] Im Frühling kommen natürlich die Verliebten wieder, heimliche Paare finden ein Zuhause unter den Linden, in den blühenden Alkoven, Touristen fotografieren die Statuen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "521104d6-7aba-4424-bf1f-62cd8dc5a92c",
                        "source_entry_id": "7b338d9b-6037-3a95-aade-05eab33acf48",
                        "source_sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                        "source_sense_description": "een kleine raamloze zijkamer, vaak gebruikt als slaapkamer",
                        "target_lang_word": "alcove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e06626-e3f9-3d5c-b0e9-0c913e5d4295",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "A small recessed area set off from a larger room."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d94176-f09f-466e-9c10-7a084dd7dc74",
                                                "sense_id": "c8e06626-e3f9-3d5c-b0e9-0c913e5d4295",
                                                "text": "It was very different from such bookstores as he had been accustomed to patronize. Two stories of the old house had been thrown into one: the lower space was divided into little alcoves; above, a gallery ran round the wall, which carried books to the ceiling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a6a88fb-ad8c-3541-96ca-af206105c4ba",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "A shady retreat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e12985-f0e7-4bcc-b6ed-f3d970343c65",
                                                "sense_id": "3a6a88fb-ad8c-3541-96ca-af206105c4ba",
                                                "text": "The house was situated in a leafy alcove."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8077d124-7a0a-326e-9089-384bc0c582cb",
                                        "entry_id": "a8a02116-b47f-32fc-a953-f5f2d4374249",
                                        "glosses": [
                                            "The geographical and geological term for a steep-sided hollow in the side of an exposed rock face or cliff of a homogeneous rock type, that was water eroded."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a425a85b-e95a-4fae-915e-4a5539c9cb71",
                        "source_entry_id": "7b338d9b-6037-3a95-aade-05eab33acf48",
                        "source_sense_id": "309ee2c1-9f38-31bf-b2d2-be95c6515a1b",
                        "source_sense_description": "een kleine raamloze zijkamer, vaak gebruikt als slaapkamer",
                        "target_lang_word": "alcôve",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alcôve",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "064e56ac-2562-326a-b34d-f0e938ecd09b",
                                        "entry_id": "17a60acd-1593-3790-a870-fa67db444709",
                                        "glosses": [
                                            "Enfoncement pratiqué dans une chambre, initialement pour y placer un lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a1b36bc-d781-4f75-bb46-f56fd3e0d860",
                                                "sense_id": "064e56ac-2562-326a-b34d-f0e938ecd09b",
                                                "text": "En face de l’entrée du salon s’ouvrait la principale chambre à coucher avec une alcôve à l’extrémité d’une estrade sur laquelle était placé un lit de parade."
                                            },
                                            {
                                                "example_id": "521bea06-ef1e-40d0-9086-4ed0f2f75381",
                                                "sense_id": "064e56ac-2562-326a-b34d-f0e938ecd09b",
                                                "text": "Dans une sorte d’alcôve, sur un divan pisseux, trois filles se tenaient enlacées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c8d54b1-ee08-3dc6-9af6-d8c049d52a84",
                                        "entry_id": "17a60acd-1593-3790-a870-fa67db444709",
                                        "glosses": [
                                            "Pièce de petites dimensions située dans le prolongement d'une autre, dans l'habitat traditionnel, qui ne reçoit d'éclairage que par cette dernière et sert habituellement de chambre à coucher."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6ab022e-c581-4c0d-92c5-ae0bec00b99a",
                                                "sense_id": "9c8d54b1-ee08-3dc6-9af6-d8c049d52a84",
                                                "text": "Ou peut-être les appartements avec leurs alcôves, et les alcôves dans les alcôves, et les alcôves dans les alcôves des alcôves, de plus en plus noires, de plus en plus cachées ? La manie de l’étroit, du secret, du pas lavé…"
                                            },
                                            {
                                                "example_id": "0445f1e8-2d80-4dea-ad23-838e215b435f",
                                                "sense_id": "9c8d54b1-ee08-3dc6-9af6-d8c049d52a84",
                                                "text": "Deux larges alcôves pouvaient contenir chacune un lit de milieu, portes fermées"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab85211-ee1e-365d-aa56-1837b6986f7f",
                                        "entry_id": "17a60acd-1593-3790-a870-fa67db444709",
                                        "glosses": [
                                            "Partie de la chambre où certaines femmes tenaient salon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17a36557-6778-4dba-b275-fa7b91487bee",
                                                "sense_id": "4ab85211-ee1e-365d-aa56-1837b6986f7f",
                                                "text": "L’alcôve des Précieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c44fa0c9-719e-3766-b351-d8465efed258",
                                        "entry_id": "17a60acd-1593-3790-a870-fa67db444709",
                                        "glosses": [
                                            "Lieu des rapports amoureux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aaf55d2-0da7-4773-b8e6-ecadbb05988a",
                                                "sense_id": "c44fa0c9-719e-3766-b351-d8465efed258",
                                                "text": "Secrets d’alcôves."
                                            },
                                            {
                                                "example_id": "ef261e7f-a96b-4b5d-b0d5-e3c2ee77f44d",
                                                "sense_id": "c44fa0c9-719e-3766-b351-d8465efed258",
                                                "text": "Confessions d’alcôve."
                                            },
                                            {
                                                "example_id": "72a575b4-3db3-43ef-9d47-4041c8ccd17a",
                                                "sense_id": "c44fa0c9-719e-3766-b351-d8465efed258",
                                                "text": "Là où le journalisme n’éponge pas les petits faits, les grands mensonges, les événements de la rue, la chronique de la maison, les indiscrétions de l’alcôve, chacun est une ligne vivante du journal que l’arrondissement n'a pas encore."
                                            },
                                            {
                                                "example_id": "b808f0bb-370e-4c61-b4b6-f74ac954b10a",
                                                "sense_id": "c44fa0c9-719e-3766-b351-d8465efed258",
                                                "text": "Ni les satisfactions de l'amour-propre, ni celles que procure la fortune, ni les fiévreuses pamoisons étouffées sous les rideaux lourds des alcôves mystérieuses, rien ne vaut et n’égale cette joie honnête et calme, ce légitime contentement de soi-même que le travail donne aux laborieux comme un premier salaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
