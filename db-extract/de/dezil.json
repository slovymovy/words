                        "source_sense_id": "f36b60c1-b496-32b6-b33e-9c160d284c69",
                        "source_sense_description": "Statistik: Maß, das geordnete Werte in zehn gleiche Teile einteilt",
                        "target_lang_word": "décile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décile",
