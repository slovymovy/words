                "word": "torchbearer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c53a5fe5-3caa-4900-8c14-51403c852269",
                        "entry_id": "84172f07-c7d8-3c11-8698-53095a05b6bb",
