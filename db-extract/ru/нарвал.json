                                    {
                                        "sense_id": "6ff1db61-3490-3925-b7fa-12fc5a31c5d7",
                                        "entry_id": "9b2730a8-079d-3764-bb60-49c648877efc",
                                        "glosses": [
                                            "Mammifère marin des eaux arctiques, de l’ordre des cétacés, dont le mâle porte une longue défense, issue de la canine supérieure gauche."
                                        ],
                                        "tags": [
                                            "Cétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b74e49e4-0b50-40ac-9d56-472ab8de1da9",
                                                "sense_id": "6ff1db61-3490-3925-b7fa-12fc5a31c5d7",
                                                "text": "Le narval, petite baleine à la longue défense d’ivoire, vit dans l’Arctique. Contrairement à son cousin, le béluga, le narval est presque inconnu."
                                            },
                                            {
                                                "example_id": "8499ec02-47d5-4a1b-8e44-3db8e38ce519",
                                                "sense_id": "6ff1db61-3490-3925-b7fa-12fc5a31c5d7",
                                                "text": "Si pendant longtemps on a eu peu d’informations sur les narvals, c’est qu’ils vivent dans des eaux difficiles d’accès, au pôle nord, loin des regards humains."
                                            },
                                            {
                                                "example_id": "d64555bb-9b70-41de-80e5-cac06ce345cc",
                                                "sense_id": "6ff1db61-3490-3925-b7fa-12fc5a31c5d7",
                                                "text": "Le narval vit habituellement dans les eaux arctiques et est identifiable par son immense corne qui peut mesurer jusqu’à 1,5 mètre à l’âge adulte."
                                            }
                                        ]
                                    }
                                ]
                            }
