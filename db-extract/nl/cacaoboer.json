                    {
                        "sense_id": "ac00cf5a-5aa6-36af-9a32-ecb1f6ff323d",
                        "entry_id": "9b87fdb4-4162-3cfb-9e84-74509685548e",
                        "glosses": [
                            "iemand die een cacaoplantage heeft met cacaobomen"
