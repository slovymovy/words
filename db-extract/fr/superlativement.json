                                "example_id": "8c92a09b-3782-46fb-a05b-6984f5ed98b1",
                                "sense_id": "ff01c32c-ee20-30a9-a806-e1fabc28158d",
                                "text": "Quoique tu sois grec d’origine, Et superlativement grec,"
                            },
