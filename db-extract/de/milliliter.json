                        "glosses": [
                            "Einheit für das Volumen, die dem tausendsten Teil eines Liters eines flüssigen Stoffes entspricht; 0,001 Liter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95284457-410f-4414-b6ae-c779b6000f17",
                                "sense_id": "6d77d64b-84fe-39b8-9cff-1ea3ae238e9c",
                                "text": "Viele gebräuchliche Glasflaschen haben ein Fassungsvermögen von 330 Millilitern."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b83d6d52-b97e-4e90-a9ea-e1d1f8116945",
                        "source_entry_id": "089a4784-dbb3-3ce9-a22f-016cbc1ef229",
                        "source_sense_id": "6d77d64b-84fe-39b8-9cff-1ea3ae238e9c",
