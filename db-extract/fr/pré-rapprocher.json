                "senses": [
                    {
                        "sense_id": "c148add3-6457-3010-b5bd-4fe2fa4a0e00",
                        "entry_id": "a7f914cb-ec83-3c9c-a1ef-8f5e7c6a0a03",
                        "glosses": [
                            "Rapprocher écritures comptables et écritures bancaires correspondantes de façon préliminaire, avant le rapprochement définitif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6b85ad-e906-4e98-94f9-b9a063f70512",
                                "sense_id": "c148add3-6457-3010-b5bd-4fe2fa4a0e00",
                                "text": "Elle permet, en sélectionnant différentes lignes de données dans chacune des deux grilles, de rapprocher, pré-rapprocher ou dé-rapprocher celles-ci."
                            },
                            {
                                "example_id": "6d12be41-e950-47c1-98ab-f01dbe9b4cc6",
                                "sense_id": "c148add3-6457-3010-b5bd-4fe2fa4a0e00",
                                "text": "Pointer des opérations permet de pré-rapprocher vos opérations."
                            },
                            {
                                "example_id": "6a666072-c423-4b6c-a42c-8a399d9a8588",
                                "sense_id": "c148add3-6457-3010-b5bd-4fe2fa4a0e00",
                                "text": "Cette fonction vous permet de pré-rapprocher et même de modifier le rapprochement de vos écritures avant de le valider."
                            }
                        ]
                    }
