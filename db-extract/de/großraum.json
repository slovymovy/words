                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf0e4a6-e947-478b-b6ba-34fafd7ecf88",
                                "sense_id": "1797a86c-ad26-30f4-9691-097fc6889ffb",
                                "text": "Die Preise für Mietwohnungen im Großraum München sind horrend."
                            },
                            {
                                "example_id": "affebe01-1276-4321-b35e-a9ba07b71c4c",
                                "sense_id": "1797a86c-ad26-30f4-9691-097fc6889ffb",
                                "text": "„Die Deutsche Post wird am Sonnabend im Großraum Lübeck und Schwerin keine Briefe und Pakete zustellen.“"
                            },
                            {
                                "example_id": "b462fd02-abaf-4227-9cfc-dc21b2c803b3",
                                "sense_id": "1797a86c-ad26-30f4-9691-097fc6889ffb",
                                "text": "„Der Großraum Athen, ein Gebiet mit vier Millionen Einwohnern, verfügt über 140 Krankentransporter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c24d34e8-b084-302a-8a84-abcbea8e1926",
                        "entry_id": "5b5abe74-6828-30e2-ab74-c92adbfe0e1d",
