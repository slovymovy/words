                "senses": [
                    {
                        "sense_id": "dda6f63c-f311-3425-9285-c9649ae38ae2",
                        "entry_id": "837dd140-9901-351b-a963-43da552d4b31",
                        "glosses": [
                            "Unternehmen für Finanzgeschäfte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "663dfafe-4351-4d22-8db2-44f2f7e5eb8d",
                                "sense_id": "dda6f63c-f311-3425-9285-c9649ae38ae2",
                                "text": "„Zu gern würde er das Geldhaus loswerden.“"
                            },
                            {
                                "example_id": "2f0164d1-7d6f-416e-99e3-fbb6f6e53da1",
                                "sense_id": "dda6f63c-f311-3425-9285-c9649ae38ae2",
                                "text": "„Regelmäßig gingen in den USA Geldhäuser pleite.“"
                            },
                            {
                                "example_id": "9bcf77f7-1f02-4a5b-9ab2-006e03b0e77a",
                                "sense_id": "dda6f63c-f311-3425-9285-c9649ae38ae2",
                                "text": "„Geldhäuser wie das der Fugger stiegen zu Montanunternehmen und dann zu Montanmonopolisten auf, während die in Eigenregie schürfenden und hüttenden Bergwerkler zu Lohnarbeitern absanken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58bc5956-2bbe-4217-b1fa-7de4210d59de",
