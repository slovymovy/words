                                                "example_id": "a9fe101d-daf1-47b3-b633-fa8e0909d9ed",
                                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                                "text": "Io jest wielokrotnie wspominana w literaturze i filmach science fiction oraz w grach komputerowych"
                                            },
                                            {
                                                "example_id": "810bfa2a-ff8e-4b2f-8dec-0f57c3e681ef",
                                                "sense_id": "d481acb2-493e-3528-af77-800e1a769ac8",
                                                "text": "Na Io występują zorze polarne"
                                            }
