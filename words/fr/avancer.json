{
    "word_family": [
        "avancement",
        "avancée"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "076d870e-f199-3158-ac5d-659282c5c788",
                    "sense_definition": "Se déplacer vers l'avant ; aller de l'avant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement vers l'avant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture <w>avance</w> lentement dans les embouteillages."
                        },
                        {
                            "text": "Nous <w>avançons</w> sur le chemin malgré la pluie."
                        },
                        {
                            "text": "Le groupe <w>avance</w> pas à pas dans le brouillard."
                        }
                    ],
                    "antonyms": [
                        "reculer"
                    ],
                    "common_phrases": [
                        "avancer lentement",
                        "avancer pas à pas",
                        "avancer tout droit"
                    ]
                },
                {
                    "sense_id": "47a45314-f7c7-31cb-ad53-6005914d590d",
                    "sense_definition": "Faire des progrès ; se développer (en parlant d'un travail, d'une enquête, d'un projet).",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enquête <w>avance</w> doucement mais sûrement."
                        },
                        {
                            "text": "Mon travail <w>avance</w> bien depuis ce matin."
                        },
                        {
                            "text": "Les travaux <w>avancent</w> vite grâce à la bonne météo."
                        }
                    ],
                    "common_phrases": [
                        "avancer bien",
                        "avancer vite"
                    ]
                },
                {
                    "sense_id": "20171d1c-023f-35b0-8f3a-3c1408a58544",
                    "sense_definition": "S'approcher de quelqu'un ou de quelque chose en marchant ; se diriger vers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement vers l'avant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'<w>avance</w> vers moi avec un grand sourire."
                        },
                        {
                            "text": "Elle s'est <w>avancée</w> vers la scène pour saluer le public."
                        }
                    ],
                    "common_phrases": [
                        "avancer vers la sortie",
                        "avancer vers la porte"
                    ]
                },
                {
                    "sense_id": "e1cd0297-4deb-3338-b7a0-f668586b542b",
                    "sense_definition": "Faire progresser quelque chose, le rendre plus avancé.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a bien <w>avancé</w> ses devoirs avant le dîner."
                        },
                        {
                            "text": "Elle veut <w>avancer</w> son travail avant les vacances."
                        }
                    ],
                    "common_phrases": [
                        "avancer son travail",
                        "avancer ses devoirs"
                    ]
                },
                {
                    "sense_id": "b0f40395-43b9-361a-85ac-82ed258b1854",
                    "sense_definition": "Pousser ou porter quelque chose vers l'avant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement vers l'avant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>avança</w> la main pour attraper le verre."
                        },
                        {
                            "text": "Le joueur <w>avance</w> son pion de deux cases."
                        }
                    ],
                    "common_phrases": [
                        "avancer la main",
                        "avancer un pion"
                    ]
                },
                {
                    "sense_id": "b2be10bd-cbfd-3be3-9f7d-02965aed6cf5",
                    "sense_definition": "Faire avoir lieu plus tôt que prévu ; mettre une montre ou une horloge à une heure plus tardive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a décidé d'<w>avancer</w> la réunion à neuf heures."
                        },
                        {
                            "text": "N'oubliez pas d'<w>avancer</w> vos montres d'une heure ce week-end."
                        }
                    ],
                    "antonyms": [
                        "retarder"
                    ],
                    "common_phrases": [
                        "avancer la date",
                        "avancer une réunion",
                        "avancer son départ"
                    ]
                },
                {
                    "sense_id": "eaaea8ab-d7d4-3c26-be22-b6cc2c43f834",
                    "sense_definition": "Mettre en avant ; proposer ou affirmer quelque chose comme vrai.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre <w>avance</w> des chiffres que personne ne peut vérifier."
                        },
                        {
                            "text": "Il n'a <w>avancé</w> aucune preuve pour soutenir son accusation."
                        }
                    ],
                    "common_phrases": [
                        "avancer un chiffre",
                        "avancer une hypothèse",
                        "avancer un argument"
                    ]
                },
                {
                    "sense_id": "06624e53-c72a-33e3-bb40-aecbecdddf6b",
                    "sense_definition": "Prêter de l'argent à quelqu'un pour peu de temps ou payer une somme à sa place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu peux m'<w>avancer</w> dix euros ? Je te les rends demain."
                        },
                        {
                            "text": "Mon frère m'a <w>avancé</w> l'argent du billet de train."
                        }
                    ],
                    "synonyms": [
                        "dépanner"
                    ],
                    "common_phrases": [
                        "avancer de l'argent"
                    ]
                },
                {
                    "sense_id": "32f70ccc-c213-33bf-ad5d-3844b7c7015f",
                    "sense_definition": "Se rapprocher de la fin, en parlant du temps qui passe (la nuit, la saison, l'heure).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nuit <w>avance</w> et il faut rentrer."
                        },
                        {
                            "text": "Comme l'heure <w>avançait</w>, nous avons arrêté la réunion."
                        }
                    ],
                    "common_phrases": [
                        "l'heure avance",
                        "la saison avance"
                    ]
                },
                {
                    "sense_id": "c20c4a79-5742-3f4d-8d6c-a851f4c09df5",
                    "sense_definition": "Faire des progrès dans un travail ou dans une carrière.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>avance</w> rapidement dans sa carrière depuis sa promotion."
                        },
                        {
                            "text": "Je n'<w>avance</w> pas beaucoup dans ce roman : il est trop long."
                        }
                    ],
                    "common_phrases": [
                        "avancer dans sa carrière",
                        "avancer dans son travail"
                    ]
                },
                {
                    "sense_id": "c3510996-1992-3d66-9997-9df816bf3eed",
                    "sense_definition": "Rapprocher un objet de quelqu'un ou de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement vers l'avant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Peux-tu <w>avancer</w> la table vers le canapé ?"
                        },
                        {
                            "text": "<w>Avancez</w>-moi un fauteuil, s'il vous plaît."
                        }
                    ],
                    "common_phrases": [
                        "avancer une chaise",
                        "avancer la table"
                    ]
                },
                {
                    "sense_id": "68f0fc4d-cee0-3935-b637-f616e921a3d3",
                    "sense_definition": "Indiquer une heure trop tardive, en parlant d'une montre ou d'une horloge.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma montre <w>avance</w> de cinq minutes."
                        },
                        {
                            "text": "L'horloge de la gare <w>avançait</w> d'un quart d'heure."
                        }
                    ],
                    "antonyms": [
                        "retarder"
                    ],
                    "common_phrases": [
                        "avancer de cinq minutes",
                        "avancer de dix minutes"
                    ]
                },
                {
                    "sense_id": "122c164a-fda1-3f01-95f9-14254618ac65",
                    "sense_definition": "Faire progresser quelqu'un dans sa carrière ; lui procurer de l'avancement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "progression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur voulait <w>avancer</w> ses meilleurs employés."
                        },
                        {
                            "text": "Son oncle a tout fait pour l'<w>avancer</w> dans l'administration."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "emploi vieilli"
                        }
                    ]
                },
                {
                    "sense_id": "fa01182c-528f-3038-9bc5-0bb476705b0f",
                    "sense_definition": "Payer par avance, avant que l'argent soit dû.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>avancé</w> le loyer de deux mois à son propriétaire."
                        },
                        {
                            "text": "Nous pouvons <w>avancer</w> le paiement si cela vous arrange."
                        }
                    ],
                    "common_phrases": [
                        "avancer le loyer",
                        "avancer un paiement"
                    ]
                },
                {
                    "sense_id": "82660c2e-8576-37e1-a76a-0b31c128d832",
                    "sense_definition": "Dépasser d'un ensemble ; former une partie en saillie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le balcon <w>avance</w> au-dessus de la rue."
                        },
                        {
                            "text": "Une longue jetée <w>avance</w> dans la mer."
                        }
                    ],
                    "common_phrases": [
                        "avancer dans la mer"
                    ]
                },
                {
                    "sense_id": "414c2c81-bf22-398e-b1c3-18d46324f848",
                    "sense_definition": "Dans l'expression « être bien avancé » : ironiquement, n'avoir rien gagné, s'être donné de la peine pour rien ou avoir compromis ses intérêts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as menti, et maintenant tu es bien <w>avancé</w> !"
                        },
                        {
                            "text": "J'ai tout recommencé à zéro : me voilà bien <w>avancé</w> !"
                        }
                    ],
                    "common_phrases": [
                        "être bien avancé"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi ironique et familier"
                        }
                    ]
                },
                {
                    "sense_id": "84b697da-bdbd-364d-9877-470d01986819",
                    "sense_definition": "Se compromettre en disant ou en promettant quelque chose qui engage ; en affaires ou en négociation, faire une offre ou une affirmation risquée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne veux pas trop m'<w>avancer</w> avant d'avoir les résultats."
                        },
                        {
                            "text": "Le ministre s'est <w>avancé</w> en promettant une baisse des impôts."
                        }
                    ]
                }
            ]
        }
    ]
}