                    {
                        "sense_id": "fe72fe59-c1d0-3185-89b6-01c15d7c9b39",
                        "entry_id": "74c89990-92ea-3b6a-8de8-ac181544cf31",
                        "glosses": [
                            "Archaic form of carol."
