                                        "sense_id": "237cc57e-572b-36fa-adae-ab2ea9e8af16",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Animal fantástico con cabeza de león, cuerpo de cabra y cola de dragón, y que según la fábula vomitaba llamas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "442600cd-421b-3b06-9c59-d9cdbca46a97",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Creación imaginaria o improbable del espíritu; aquello que se cree verdadero o posible pero que en realidad no lo es."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98afa6c-1207-4166-95de-618756589d97",
                                                "sense_id": "442600cd-421b-3b06-9c59-d9cdbca46a97",
                                                "text": "Tengo pasión por la deducción y la observación. Esas teorías que a usted la perecen meras quimeras son muy reales. Tan reales como que de ellas depende mi sustento."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8b635278-7457-37cc-8d29-6f6ffaf3210f",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Cualquiera de las especies de peces cartilaginosos pertenecientes al orden de los quimeriformes (Chimaeriformes)."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2787d6ff-b586-30a8-8e79-7dc745350fd6",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Animal disecado u otros restos cuidadosamente compuestos con diversas partes de varias especies animales diferentes y que se intentan hacer pasar por los de una especie real.^([cita requerida])."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aac4e90-d7d5-46c5-9e14-9469fe705a60",
                                                "sense_id": "2787d6ff-b586-30a8-8e79-7dc745350fd6",
                                                "text": "La primera piel de ornitorrinco que llegó a Europa se consideró por muchos un engaño, una quimera."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d0421f20-6cb9-35ec-85b1-d32ad4826c99",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Disputa que se da entre dos o más personas o grupos de personas."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "4fa8e47f-5c07-36fc-a549-75c15aefb73b",
                                        "entry_id": "28505cba-0df7-30ff-b501-f3a057fd8f80",
                                        "glosses": [
                                            "Ser vivo, afectado por quimerismo, que posee dos tipos de células diferentes, cada una con distinta constitución genética."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    }
