                            {
                                "example_id": "33435408-b3c1-4ca5-ab8f-c25d0e2fb57f",
                                "sense_id": "a6bbad28-b25b-3b6b-b4f4-73a6dbe98ee8",
                                "text": "« Comme l'hydrogène, le tritium gazeux est difficile à stocker à température ambiante. »",
                                "translation": "Wie der Wasserstoff ist auch gasförmiges Tritium bei normaler Umgebungstemperatur schwierig zu lagern."
                            },
                            {
                                "example_id": "c2774484-2417-4769-8eca-dfa374ca649f",
                                "sense_id": "a6bbad28-b25b-3b6b-b4f4-73a6dbe98ee8",
                                "text": "« Aux températures ordinaires, le tritium est un gaz (HT ou H3) ; mais en présence d'oxygène, il produit spontanément de l'eau tritiée (HTO). »",
                                "translation": "Bei normalen Temperaturen ist Tritium ein Gas (HT oder ³H), aber bei Präsenz von Sauerstoff entsteht spontan Überschweres Wasser (HTO)."
                            }
                        ],
                        "sense_index_json": "\"1\""
