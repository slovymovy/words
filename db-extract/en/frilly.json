                "senses": [
                    {
                        "sense_id": "0d432ca5-1ca0-36ca-a905-23917481d614",
                        "entry_id": "5472837c-ff30-3b1f-8e64-47ab6692ab4c",
                        "glosses": [
                            "Having frills; frilled."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d1bce36-ed5a-42cb-acba-7cdc05d33fc0",
                                "sense_id": "0d432ca5-1ca0-36ca-a905-23917481d614",
                                "text": "In scented, frilly boutiques that she seemed to find by instinct, they exchanged her battered wardrobe for fur capes and Anna Karenina riding boots that slithered on the frosty cobble, and Pym's dismal school habit for a leather jacket and trousers without buttons for his braces."
                            },
                            {
                                "example_id": "790c8d79-e859-40fe-87f1-55afb3185b6b",
                                "sense_id": "0d432ca5-1ca0-36ca-a905-23917481d614",
                                "text": "Ms. Grant was dressed up as Little Bo Peep and had on a huge, frilly skirt that was held out with a hoop at the bottom."
                            },
                            {
                                "example_id": "6f2aaff3-81b6-4648-a987-ca614a9f1bf0",
                                "sense_id": "0d432ca5-1ca0-36ca-a905-23917481d614",
                                "text": "The one she showed me has this frilly white skirt with blue bows on it."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e7e5d45-170c-3f2a-82e8-0d11747b3503",
                        "entry_id": "5472837c-ff30-3b1f-8e64-47ab6692ab4c",
                        "glosses": [
                            "Over-elaborate or showy in character or appearance."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
