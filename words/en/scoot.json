                        "cs": "Skútr.",
                        "tr": "Scooter veya küçük motosiklet."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skútr",
                                "target_lang_sense_clarification": "hovorový nebo slangový výraz pro malé motorové vozidlo tohoto typu"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "scooter",
                                "target_lang_sense_clarification": "iki tekerlekli küçük taşıt"
                            },
                            {
                                "target_lang_word": "mobilet",
                                "target_lang_sense_clarification": "motorlu hafif iki tekerlekli araç"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbdec2ab-aecc-3d4c-9b46-2ccf23c142f3",
                    "sense_definition": "A sudden spray or stream of water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>scoot</w> of water hit him when the hose was turned on.",
                            "target_lang_translations": {
                                "cs": "Když se pustila hadice, zasáhlo ho <w>stříknutí</w> vody.",
                                "tr": "Hortum açıldığında ani bir su <w>fışkırması</w> ona çarptı."
                            }
