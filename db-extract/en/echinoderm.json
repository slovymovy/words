                "entry_id": "50171109-794a-3545-8b0f-e5d031f81aa0",
                "word": "echinoderm",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a7d0bcbd-6094-4110-bf3a-b1657d0f681d",
                        "entry_id": "50171109-794a-3545-8b0f-e5d031f81aa0",
                        "tags": [
                            "plural"
                        ],
                        "form": "echinoderms"
