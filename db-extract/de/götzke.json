                ],
                "senses": [
                    {
                        "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                        "entry_id": "da0b60fb-c1e8-33f1-a48d-3b018fda71e0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a73f2ca5-7fb1-4ca1-a82c-752b780c752b",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Götzkes kamen, sahen und siegten."
                            },
                            {
                                "example_id": "4e9e4f5b-5240-44ec-9544-efa4b0b63e07",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Frau Götzke ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "12876810-2bcc-43b8-8484-a9242b8710a5",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Herr Götzke wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "70cf3bb1-157c-4c57-b08e-d93676c8d0c6",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Die Götzkes fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "038aceee-bfbf-44b3-a3e5-0d437d83998d",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Der Götzke trägt nie die Schals, die die Götzke ihm strickt."
                            },
                            {
                                "example_id": "806843ab-954d-421e-b2c1-abcdcdf01ae7",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Götzke kommt, geht der Herr Götzke.“"
                            },
                            {
                                "example_id": "f2dcbc57-6b48-46bd-bbd7-d9aad426d053",
                                "sense_id": "f8cc8052-fbce-3712-b041-6855372eafac",
                                "text": "Götzke kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
