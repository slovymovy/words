                        "entry_id": "d7f05250-9d13-34f9-bcb8-ec70e4fe78d5",
                        "glosses": [
                            "Faire perdre son caractère linéaire à (quelque chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c91148c-9856-4466-bc04-858e522fe618",
                                "sense_id": "c4ba5d9c-01ab-353d-b1f8-60230a81a78a",
                                "text": "La possibilité de demander un programme à volonté a délinéarisé la télévision."
                            },
                            {
                                "example_id": "ab2b9d0a-6b4b-485f-b533-c7f59db8941d",
                                "sense_id": "c4ba5d9c-01ab-353d-b1f8-60230a81a78a",
                                "text": "Mais c’est pour ajouter tout de suite qu’il importe de délinéariser la direction du changement et, peut-être même encore davantage, d’en débonifier la signification."
                            }
                        ]
                    }
