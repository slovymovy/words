                        "glosses": [
                            "Qui s’étend à une partie d’un continent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e606f6c9-4760-4ba9-8f58-c34b68993a6b",
                                "sense_id": "c0a04f70-cfb0-3ae0-833b-053acba924fd",
                                "text": "Si la région appartient historiquement au dar el-islam, encore convient-il de relativiser l’idée d’un bloc musulman homogène : outre que l’islam est lui-même divers, son caractère structurant achoppe sur l’existence d’une bigarrure ethnolinguistique s’exprimant à différentes échelles, du local à l’infra-continental, comme sur l’affirmation de nationalismes parfois virulents."
                            }
                        ]
                    },
