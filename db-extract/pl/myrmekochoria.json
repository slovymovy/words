                        "glosses": [
                            "zjawisko roznoszenia diaspor roślinnych (rozsiewania roślin) przez mrówki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72d2674b-9a0b-43b4-a3d5-a18361c9c358",
                                "sense_id": "248a9086-a339-3b9a-9ab0-0f94bcc34618",
                                "text": "Ze względu na sposób rozsiewania na kurhanach przeważają anemochory (około 60%). Autochorycznie i barochorycznie rozsiewa się blisko 22% gatunków, a przy udziale zwierząt (epizoochoria, endozoochoria i myrmekochoria) około 17%"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
