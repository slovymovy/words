                ],
                "translations": [
                    {
                        "translation_id": "04229290-21be-4a99-8174-3b5ac9ee50fa",
                        "source_entry_id": "ae849520-c6d9-38a4-a24d-136ae322dea4",
                        "source_sense_id": "1670da57-6176-3bbf-8c83-561c30375f3d",
                        "source_sense_description": "counteracting acidity",
                        "target_lang_word": "antiacide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiacide",
