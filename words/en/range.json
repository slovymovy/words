                                "target_lang_sense_clarification": "matematik"
                            },
                            {
                                "target_lang_word": "görüntü kümesi",
                                "target_lang_sense_clarification": "matematik"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "值域",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "38ef30ff-13bf-3cb9-a981-1e19963e98ff",
                    "sense_definition": "To vary between two specified limits or values.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "vary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The temperature <w>ranges</w> from mild to very hot.",
                            "target_lang_translations": {
                                "ru": "Температура <w>варьируется</w> от умеренной до очень жаркой.",
                                "tr": "Sıcaklık ılımandan çok sıcağa kadar <w>değişmektedir</w>.",
                                "zh": "气温在温和到极热之间<w>变动</w>。"
                            }
                        },
                        {
