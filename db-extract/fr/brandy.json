                "senses": [
                    {
                        "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                        "entry_id": "79badbfc-1c44-35aa-b71b-3f506c12bb64",
                        "glosses": [
                            "Eau-de-vie de vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f31af05-8fd8-46d9-8d28-84de2f80161c",
                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                "text": "La bière est de côté et l’on prend du brandy."
                            },
                            {
                                "example_id": "cc64974d-0ee6-44a0-9606-56641102f9cb",
                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                "text": "Qu’il passât tout son temps dans sa cabine, nul n’y eût trouvé à redire, si le grossier master ne se fût pas grisé chaque jour de gin ou de brandy."
                            },
                            {
                                "example_id": "b37b4fc9-f6cf-4aa8-803f-0de291ba5060",
                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                "text": "Je me retrouvai enfin dans un bureau un peu mieux aménagé, où il y avait quand même un ventilateur, des rocking-chairs en rotin et, sur une table basse, quelques fioles carrées de whisky et de brandy."
                            },
                            {
                                "example_id": "df656595-2c4d-4b00-a0cd-b08bed3dc707",
                                "sense_id": "cb50161c-0d74-31c7-9487-2f32f0988029",
                                "text": "En contrepartie, l’affiche taurine se trouvera quelques sponsors, une marque de cigares, des brandys et quelques banques."
                            }
                        ]
                    }
                ],
