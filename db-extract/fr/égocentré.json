                                        "entry_id": "6bcc80e3-77da-3d30-aa6e-92325b22a242",
                                        "glosses": [
                                            "Concerned or relating to the self, and not necessarily the greater good of one's group, community, tribe, etc.; individualistic."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
