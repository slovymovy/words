                "senses": [
                    {
                        "sense_id": "b4b083ee-7e12-33d0-bc06-1830d3842248",
                        "entry_id": "5cc2614c-0e14-303d-a690-9dc8c09989c8",
                        "glosses": [
                            "книжн. расположенный по периметру чего-либо, в виде замкнутого контура; связанный с таким расположением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eebcee94-6b44-4c58-9782-2c0d0bb7e003",
                                "sense_id": "b4b083ee-7e12-33d0-bc06-1830d3842248",
                                "text": "Чтобы оздоровить территорию, внутри бульваров деревья придётся удалять, сохраняя и восстанавливая периметральные посадки."
                            },
                            {
                                "example_id": "eb4d73d8-4db0-4206-b561-48793d1d0e52",
                                "sense_id": "b4b083ee-7e12-33d0-bc06-1830d3842248",
                                "text": "Особенностью нового района Москвы станет среднеэтажная периметральная застройка с высотностью зданий не более десяти этажей."
                            }
                        ]
                    }
