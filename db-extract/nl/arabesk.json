                "senses": [
                    {
                        "sense_id": "24c69648-0280-3311-b39f-6d254324fd29",
                        "entry_id": "1da8a1a3-a084-33ee-a7f4-6d283e9e0c58",
                        "glosses": [
                            "een uitgebreide, vaak vlakvullende toepassing van zich herhalende geometrische vormen, die soms aan de vormen van dier of plant herinneren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "502e367c-024a-4eea-b7ef-3e0fd361f35e",
                                "sense_id": "24c69648-0280-3311-b39f-6d254324fd29",
                                "text": "In de islamitische kunst worden arabesken veel toegepast."
                            },
                            {
                                "example_id": "76e68639-7deb-48fb-9ebf-a5ffbd083e5c",
                                "sense_id": "24c69648-0280-3311-b39f-6d254324fd29",
                                "text": "De reling is een met goud beschilderde arabesk die de betoverde bezoeker naar de bovenverdieping lokt waar tientallen gedekte tafels staan."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7b5fcb1-8719-367f-8f81-261d35ead21e",
                        "entry_id": "1da8a1a3-a084-33ee-a7f4-6d283e9e0c58",
                        "glosses": [
                            "positie van het lichaam in het klassiek ballet, waarbij de danser op één gestrekt been staat en het andere been daarmee een hoek van minstens 45 graden maakt en achter het lichaam wordt uitgestrekt"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9fe6c95f-d6a9-3bcb-9821-48e39ecc4784",
                        "entry_id": "1da8a1a3-a084-33ee-a7f4-6d283e9e0c58",
                        "glosses": [
                            "overdreven hoffelijke begroeting met veel kronkelige bewegingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17760e37-7653-4b63-a020-3397c570ff54",
                                "sense_id": "9fe6c95f-d6a9-3bcb-9821-48e39ecc4784",
                                "text": "Ook als ik niet op het bestaan van de majordomus zou zijn voorbereid, had hij mij onmogelijk kunnen ontgaan. Zodra ik één voet over de drempel had gezet van zijn vesting en heiligdom, danste hij mij tegemoet. Hij verwelkomde mij met zoveel egards, krullen en arabesken dat het overduidelijk was dat ik met een professional te maken had."
                            }
                        ]
                    },
                    {
                        "sense_id": "94c6a8a7-fdba-3877-a57c-e48be374226d",
                        "entry_id": "1da8a1a3-a084-33ee-a7f4-6d283e9e0c58",
                        "glosses": [
                            "speels, grillig muziekstuk"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fe57622-0067-4bad-9aaa-0c768b478684",
                        "source_entry_id": "1da8a1a3-a084-33ee-a7f4-6d283e9e0c58",
                        "target_lang_word": "arabesque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arabesque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7dd8c56d-b19a-39f3-92c7-f83faf030778",
                                        "entry_id": "0c93214c-47c9-3d11-940f-e60fdd13b7c4",
                                        "glosses": [
                                            "An elaborate design of intertwined floral figures or complex geometrical patterns, mainly used in Islamic art and architecture."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "637804e8-99e2-4893-81a5-0ed39191dcb8",
                                                "sense_id": "7dd8c56d-b19a-39f3-92c7-f83faf030778",
                                                "text": "It was a sort of scene which Adam had beheld almost weekly for years; he knew by heart every arabesque flourish in the framed specimen of Bartle Massey’s handwriting which hung over the schoolmaster’s head, by way of keeping a lofty ideal before the minds of his pupils; […]."
                                            },
                                            {
                                                "example_id": "e466fccc-d927-43a4-be02-42b17002dd67",
                                                "sense_id": "7dd8c56d-b19a-39f3-92c7-f83faf030778",
                                                "text": "The house of Ruthven was a small but ultra-modern limestone affair, between Madison and Fifth ;[…]. As a matter of fact its narrow ornate façade presented not a single quiet space that the eyes might rest on after a tiring attempt to follow and codify the arabesques, foliations, and intricate vermiculations of what some disrespectfully dubbed as “ near-aissance.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60b042d2-8fa7-33e2-a283-57016a00ff28",
                                        "entry_id": "0c93214c-47c9-3d11-940f-e60fdd13b7c4",
                                        "glosses": [
                                            "An ornate composition, especially for the piano."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e30c3f47-78f0-3632-9339-d4d6cc2231b4",
                                        "entry_id": "0c93214c-47c9-3d11-940f-e60fdd13b7c4",
                                        "glosses": [
                                            "A dance position in which the dancer stands on one leg, with the other raised backwards, and the arms outstretched."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aaf5479f-67e6-37da-8321-b16c3ae24838",
                                        "entry_id": "0c93214c-47c9-3d11-940f-e60fdd13b7c4",
                                        "glosses": [
                                            "Elaborate or ornate creations in general."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "264a5948-2b8d-43fa-983e-f9cf7a28ab75",
                                                "sense_id": "aaf5479f-67e6-37da-8321-b16c3ae24838",
                                                "text": "For a man who condemned worldly pleasures he ate with elegance. She loved to watch the arabesque of fingers and two forks."
                                            },
                                            {
                                                "example_id": "fc990106-af07-4a50-a7c8-adc69d7e0f7f",
                                                "sense_id": "aaf5479f-67e6-37da-8321-b16c3ae24838",
                                                "text": "In characterizing some of his tales as 'Arabesque', Poe intended no specific reference to the Arab manner of telling stories. He only used the term to refer to intricately patterned tales (intricate as the design of an oriental carpet) in which the centre of interest lay in the cunningly crafted plot, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
