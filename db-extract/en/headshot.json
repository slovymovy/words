                        "glosses": [
                            "A portrait for branding or social media."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c169598-70ff-48f2-ab2d-3c57f058f1f9",
                                "sense_id": "7e7e5f80-5a2a-3c00-b62f-d1d2f2104cc7",
                                "text": "I went home, I changed, I went to Walgreens and printed out a headshot of me and signed it ‘from your favorite local news reporter,’ and I sat in the parking lot for four hours until she said, ‘Hey, your passes to go backstage are at will-call’."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1d0d8cd-ebde-3126-be16-6a95ec8a1dab",
                        "entry_id": "70ae4219-d9a8-3122-9e29-9c02949a2b34",
                        "glosses": [
                            "A gunshot to the head."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2dce8be-fcdd-4d59-9b01-856c643ecb95",
                                "sense_id": "a1d0d8cd-ebde-3126-be16-6a95ec8a1dab",
                                "text": "Smelling victory amongst the gunpowder Graeme started shooting off his mouth. “True Counter-Strikers like me don’t even count kills unless they’re headshots or a knife in the back of the nut…”"
                            }
                        ]
                    },
                    {
