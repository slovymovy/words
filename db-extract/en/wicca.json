                    {
                        "translation_id": "f0ce22c8-61ba-4b92-a12b-aa29aee476fe",
                        "source_entry_id": "ababbe61-0c3f-36cc-b4df-713b4e51f450",
                        "source_sense_id": "69b69612-a8bf-3264-b37c-e823d9ceef2e",
