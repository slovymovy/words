                                            {
                                                "example_id": "67d60b42-e1cd-4c8b-aa73-e01cbc14c229",
                                                "sense_id": "5b71c30b-7fb6-3789-ba52-808d04a919e9",
                                                "text": "Przebadano go w poradni i stwierdzono, że ma dysleksję."
