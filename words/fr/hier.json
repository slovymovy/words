    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "49349061-ca15-31ba-b160-99228eeda59c",
                    "sense_definition": "Le jour qui précède immédiatement celui où l'on est : il y a un jour.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "passé récent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hier</w>, nous sommes allés au cinéma avec nos amis."
                        },
                        {
                            "text": "Nous avons mangé au restaurant <w>hier</w> soir."
                        },
                        {
                            "text": "Je n'ai pas travaillé <w>hier</w> après-midi parce que j'étais malade."
                        }
                    ],
                    "antonyms": [
                        "demain"
                    ],
                    "common_phrases": [
                        "hier soir",
                        "hier matin",
                        "hier après-midi"
                    ]
                },
                {
                    "sense_id": "bbb2e761-bae1-38bc-8cf3-6b29b500e1bb",
                    "sense_definition": "À une époque indéterminée, mais qui n'est passée que depuis peu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passé récent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Hier</w> encore, j'avais vingt ans et toute la vie devant moi."
                        },
                        {
                            "text": "On croit que cette guerre est loin, mais c'était <w>hier</w> à l'échelle de l'histoire."
                        }
                    ],
                    "common_phrases": [
                        "hier encore"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6df76f44-09df-354a-8932-91204eb08bf4",
                    "sense_definition": "Le passé, le temps passé, considéré comme une période révolue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il vit dans un <w>hier</w> qui ne reviendra jamais."
                        },
                        {
                            "text": "Les <w>hiers</w> heureux et les demains incertains se mélangent dans sa mémoire."
                        },
                        {
                            "text": "Il faut apprendre à ne pas regretter l'<w>hier</w> pour mieux vivre aujourd'hui."
                        }
                    ],
                    "common_phrases": [
                        "un hier permanent",
                        "les hiers et les demains"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5bad5d82-55b0-3ffb-a745-a43c5cf7621b",
                    "sense_definition": "Enfoncer ou tasser avec une hie, outil servant à enfoncer des pavés ou des pieux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les paveurs <w>hient</w> le sol avant de poser les pavés."
                        },
                        {
                            "text": "Il faut <w>hier</w> la terre avec soin pour qu'elle soit bien tassée."
                        }
                    ],
                    "synonyms": [
                        "damer"
                    ],
                    "common_phrases": [
