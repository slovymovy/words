                                                "text": "arrive at your destination"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10f90eeb-7bbb-3888-a118-445f70092239",
                                        "entry_id": "ca30e611-3974-34a7-9552-fb59feb19870",
