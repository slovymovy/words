                                                "example_id": "f28bbdce-0d3b-4543-a5c4-53efa165f9e1",
                                                "sense_id": "7d025096-8421-395e-9ca0-126f186592dd",
                                                "text": "Ich konnte beim besten Willen nichts ausrichten und gab schließlich auf."
                                            },
                                            {
                                                "example_id": "2cb95f5c-473d-4220-99e5-3d65555607fc",
                                                "sense_id": "7d025096-8421-395e-9ca0-126f186592dd",
                                                "text": "[Verurteilung von Jesus Christus:] „Da aber Pilatus sah, dass er nichts ausrichtete, sondern das Getümmel immer größer wurde, nahm er Wasser und wusch sich die Hände vor dem Volk und sprach: Ich bin unschuldig am Blut dieses Menschen; seht ihr zu!“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "edcc4c27-eb12-3000-9fdd-69583d6e0a99",
                                        "entry_id": "f46ac0da-1f96-3be2-af5c-d4cadd39d163",
                                        "glosses": [
                                            "sich über jemanden negativ äußern"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "528c2dba-6595-408d-9758-84b0ba16bf27",
                                                "sense_id": "edcc4c27-eb12-3000-9fdd-69583d6e0a99",
                                                "text": "„Die Verkäuferinnen vermißten schmerzlich die kommunikative Tante Ka, mit der sie immer gerne andere Leute ausgerichtet hatten, und sie mißtrauten der jungen Asiatin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    },
