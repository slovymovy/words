                    {
                        "translation_id": "c9cee029-76dc-41c8-bedb-5c17b69da6d7",
                        "source_entry_id": "9ed9a3ac-29ad-354a-b328-3b5c5fa0d30a",
                        "source_sense_id": "25cd46cc-6979-3f92-a3b8-7fc2a7547c5b",
                        "target_lang_word": "Steinzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                        "entry_id": "9d9e48df-5467-3d87-a8d2-d305d25e57ab",
                                        "glosses": [
                                            "vorgeschichtliche Periode, in der Menschen Werkzeug aus Stein fertigten und nicht aus Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9eaa92d-9cc2-4efc-9a3f-9897b7290328",
                                                "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                                "text": "In der Steinzeit stellten die Menschen Messer und Pfeilspitzen aus Feuerstein und Obsidian her."
                                            },
                                            {
                                                "example_id": "c752964b-1fe3-4331-a9e8-198f31a86704",
                                                "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                                "text": "Schon in der Steinzeit erlebte Malta ein goldenes Zeitalter, mysteriöse Megalithtempel geben Zeugnis über die älteste europäische Geschichte."
                                            },
                                            {
                                                "example_id": "4e2051a1-866e-44f5-a897-f33b636319c8",
                                                "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                                "text": "Höhlenmalereien aus der Steinzeit zeugen vom künstlerischen Gespür unserer Vorfahren."
                                            },
                                            {
                                                "example_id": "e32d5711-0302-4b42-ad64-23a71344ab68",
                                                "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                                "text": "Die chinesische Kultur blieb stärker als alle nomadischen Eindringlinge, kein anderes Land heute hat eine Tradition, die derart ungebrochen bis in die Steinzeit zurückreicht, kein anderes hat eine Schrift mit 4000-jähriger Geschichte."
                                            },
                                            {
                                                "example_id": "c1231fb1-1b18-44fa-9bd9-01960b34fb20",
                                                "sense_id": "f45706a7-b7d5-31dc-a9d1-178be83607cc",
                                                "text": "Die „Steinzeit zum Mitmachen“ beinhaltet u. a. ein Winterlager von Mammutjägern, eine Fladenbrotküche, das Zubereiten des Essens nach Steinzeitsitte, Steinbearbeitung, Bogenbau und das Herstellen von Pfeilspitzen aus Knochen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cf4160e-aa95-45d7-89ff-d7746eebdeae",
                        "source_entry_id": "9ed9a3ac-29ad-354a-b328-3b5c5fa0d30a",
                        "source_sense_id": "25cd46cc-6979-3f92-a3b8-7fc2a7547c5b",
                        "target_lang_word": "Stone Age",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stone Age",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a0098b-8ef9-3177-9df0-2857dc5a2420",
                                        "entry_id": "17066102-288e-3c18-a8e1-0556d8421035",
                                        "glosses": [
                                            "A broad prehistoric period during which humans widely used stone for toolmaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f8eab78-bc87-4ee7-a081-206ba8271193",
                                                "sense_id": "30a0098b-8ef9-3177-9df0-2857dc5a2420",
                                                "text": "Holonym: prehistory"
                                            },
                                            {
                                                "example_id": "2c008566-d538-44e0-8f7b-38942051d03b",
                                                "sense_id": "30a0098b-8ef9-3177-9df0-2857dc5a2420",
                                                "text": "Meronyms: Old Stone Age, Paleolithic; Mesolithic; New Stone Age, Neolithic; Pre-Pottery Neolithic, Pre-Pottery Neolithic A, Pre-Pottery Neolithic B; Chalcolithic, Cyprolithic, Copper Age"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e70ce58-c5b2-3752-8fd1-ad1cf2377193",
                                        "entry_id": "17066102-288e-3c18-a8e1-0556d8421035",
                                        "glosses": [
                                            "Any extremely primitive or undeveloped era."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "883c554c-eae1-431b-a264-d5797e2544dd",
                                                "sense_id": "2e70ce58-c5b2-3752-8fd1-ad1cf2377193",
                                                "text": "If they attack our country, we'll bomb them back to the Stone Age!"
                                            },
                                            {
                                                "example_id": "4b15c2a1-81e7-47af-8598-086654d8f4dd",
                                                "sense_id": "2e70ce58-c5b2-3752-8fd1-ad1cf2377193",
                                                "text": "Welcome back to the Stone Age, vermin. Welcome home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36e503b2-f750-3639-8bcd-3935e413f2e0",
                                        "entry_id": "17066102-288e-3c18-a8e1-0556d8421035",
                                        "glosses": [
                                            "The time a particular field was introduced and was in its earliest stages of development."
