                                    {
                                        "sense_id": "7367df86-69f6-37e6-aa0a-745772be1394",
                                        "entry_id": "d390c128-54cb-311a-834e-95c591c3fc98",
                                        "glosses": [
                                            "Eröffnung einer Ausstellung von Werken eines noch lebenden Künstlers in kleinem Kreis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76b32f32-099f-4437-8595-8a6c43405a3e",
                                                "sense_id": "7367df86-69f6-37e6-aa0a-745772be1394",
                                                "text": "Bei der Vernissage konnte man mit dem Künstler ausgiebig plaudern."
                                            },
                                            {
                                                "example_id": "fb14d6df-c9fc-450b-a625-558830fac5a8",
                                                "sense_id": "7367df86-69f6-37e6-aa0a-745772be1394",
                                                "text": "„Ich ging noch etwas trinken und geriet in eine Vernissage.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55d4b74c-ea66-4627-8e47-5fd2c4bca191",
                        "source_entry_id": "81b77f34-4523-34b8-b228-e6f5ff01a9ed",
