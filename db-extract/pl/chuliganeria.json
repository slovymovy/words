                                        "entry_id": "b3b51270-875a-3c57-8e9f-54820a169552",
                                        "glosses": [
                                            "The condition, state, or world of a thug; thugs collectively"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8df9fc4-b26e-4867-a128-90c1d907189a",
                                                "sense_id": "fea81c1e-da23-3d89-9e45-2c90491e1de1",
                                                "text": "Have the days of thugdom returned to the metropolitan newspaper business?"
                                            },
                                            {
                                                "example_id": "8659fc89-cfe4-49b0-9314-25f027884465",
                                                "sense_id": "fea81c1e-da23-3d89-9e45-2c90491e1de1",
                                                "text": "They had fashioned it from the stuff of which the Executioner was made and fanned it to life with the spreading flames of rampant thugdom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
