                        "source_sense_id": "43028016-b3d9-3d82-9b0d-298a43f2587b",
                        "source_sense_description": "voedingsmiddel op basis van melk",
                        "target_lang_word": "Milchprodukt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milchprodukt",
