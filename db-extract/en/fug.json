                    {
                        "translation_id": "98db3c52-5b9a-4ec7-b932-a37e97de2555",
                        "source_entry_id": "2441235c-50db-3dc3-8e76-57f3a7581bb5",
                        "source_sense_description": "A heavy, musty, and unpleasant atmosphere, usually in a poorly-ventilated area",
                        "target_lang_word": "Muff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                        "entry_id": "3917b41b-3e8e-3500-8c79-5b55792466b8",
                                        "glosses": [
                                            "eine Hülle aus Pelz oder gefüttertem Stoff zum Wärmen oder Warmhalten der Hände"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe471e7-8d6d-4802-89e6-bcf2f9d491a5",
                                                "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                                "text": "Früher wurden Muffe nicht nur von Frauen getragen."
                                            },
                                            {
                                                "example_id": "80dc1f7d-8bb5-44b7-982d-2cb63bcd1fb0",
                                                "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                                "text": "„Das Räubermädchen betrachtete sie ganz ernsthaft, nickte ein wenig mit dem Kopfe und sagte: ‚Sie sollen Dich nicht schlachten, selbst wenn ich Dir böse werde, dann werde ich es schon selbst thun!‘ und dann trocknete sie Gretchens Augen und steckte ihre beiden Hände in den schönen Muff, der weich und warm war.“"
                                            },
                                            {
                                                "example_id": "e6221c2a-4d2e-4590-9f1d-fec9ec318dcb",
                                                "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                                "text": "„Außerdem gab es eine feine Dame mit Muff, riesigem Pelzkragen und langer Zigarettenspitze.“"
                                            },
                                            {
                                                "example_id": "6ac731d8-b401-4913-bebe-41d49591fd28",
                                                "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                                "text": "„Die Adeligen mit Muffs und Fischotterpelz unterhalten sich polnisch.“"
                                            },
                                            {
                                                "example_id": "68dd0bef-b8bb-495e-abef-14745ae04f1e",
                                                "sense_id": "a38eb506-9ce5-3eb1-b4e9-a011feb408fe",
                                                "text": "„Ich ließ nun den Muff fallen, packte sie bei den Schenkeln, und der Nagel gab ihr festen Halt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Muff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62cb0f04-45d1-37f6-a554-3453f9a249c1",
                                        "entry_id": "e9b9cf4d-f39c-3bcb-b8b4-067a6b7e4e2b",
                                        "glosses": [
                                            "besonders unangenehmer, modriger Geruch"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1babbb-bb53-4e0e-aa44-59e594f24d62",
                                                "sense_id": "62cb0f04-45d1-37f6-a554-3453f9a249c1",
                                                "text": "Im Keller herrscht ein hartnäckiger Muff, der weder durch Lüften noch durch Putzen wegzukriegen ist."
                                            },
                                            {
                                                "example_id": "26ab10fe-d3dc-49da-9141-d5af8e5ef481",
                                                "sense_id": "62cb0f04-45d1-37f6-a554-3453f9a249c1",
                                                "text": "„Unter den Talaren – Muff von 1000 Jahren“ (68er-Bewegung: bekannter Text eines Transparents, gerne als Kernsatz der Studentenbewegung zitiert)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
