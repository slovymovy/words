                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les examens, ils ont <w>foiré</w> ensemble pendant tout le week-end dans les rues de la ville.",
                            "target_lang_translations": {
                                "en": "After the exams, they <w>partied</w> together all weekend long through the city's streets.",
                                "ru": "После экзаменов они всё выходные напролёт <w>гуляли</w> вместе по улицам города.",
                                "de": "Nach den Prüfungen haben sie das ganze Wochenende über zusammen in den Straßen der Stadt <w>gefeiert</w>.",
                                "es": "Después de los exámenes, <w>juerguearon</w> juntos durante todo el fin de semana por las calles de la ciudad.",
                                "zh": "考试结束后，他们整个周末都在城里的大街小巷一起<w>疯玩</w>。"
                            }
                        },
                        {
                            "text": "Les jeunes du village adorent <w>foirer</w> tard dans les bars le samedi soir.",
                            "target_lang_translations": {
                                "en": "The young people of the village love <w>partying</w> late in the bars on Saturday nights.",
                                "ru": "Деревенская молодёжь обожает <w>гулять</w> допоздна по барам в субботу вечером.",
                                "de": "Die jungen Leute aus dem Dorf lieben es, samstagabends spät in den Bars zu <w>feiern</w>.",
                                "es": "A los jóvenes del pueblo les encanta <w>juerguear</w> hasta tarde en los bares el sábado por la noche.",
                                "zh": "村里的年轻人最喜欢周六晚上去酒吧<w>狂欢</w>到深夜。"
