                                            "dekorativer umlaufender Zierstreifen auf Wänden, Textilien, Gefäßen u.a."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3096939-3056-46f9-be85-4b909e2a660e",
                                                "sense_id": "699a8c8f-f7b9-33ce-8900-3d82fa519ca8",
                                                "text": "Kulante Vermieter lassen ihren Mietern freie Hand bei der Wahl der Fliesen und der passenden Bordüre."
