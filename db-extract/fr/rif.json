            {
                "entry_id": "07014e66-8c6d-3d37-956c-6a71f8ba737b",
                "word": "Rif",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2d0f79c6-8b7a-3da7-8438-99ca3d024e5e",
                        "entry_id": "07014e66-8c6d-3d37-956c-6a71f8ba737b",
                        "glosses": [
                            "Région montagneuse du nord du Maroc."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "0ccacbe0-503f-4b7e-86d3-fac256504bcf",
                                "sense_id": "2d0f79c6-8b7a-3da7-8438-99ca3d024e5e",
                                "text": "Au début de 1925, mon pays vivait depuis déjà quatre ans une de ces aventures coloniales dont il a le secret. De mèche avec les Espagnols, il guerroyait dans le Rif contre un nommé Abd el-Krim, une sorte de terroriste nationaliste marocain."
                            },
                            {
                                "example_id": "c2e0cbee-049e-4e78-a3c1-28e5ad71eba6",
                                "sense_id": "2d0f79c6-8b7a-3da7-8438-99ca3d024e5e",
                                "text": "Le Rif produisait chaque année des milliers de tonnes de résine de cannabis."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                "word": "rif",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "02782acf-e663-4754-a4e9-e2b1fea1dc5e",
                        "entry_id": "1179ed1b-ce31-3314-84e8-6c7151568cac",
                        "tags": [
