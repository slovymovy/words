                        ],
                        "examples": [
                            {
                                "example_id": "05a2bf2c-4df7-44fe-be7a-df135a29b7f0",
                                "sense_id": "220b7434-efec-3207-af94-9d7150ea93d9",
                                "text": "Israel's decision to ban fluoridation follows a vote to preclude the practice in Portland, Ore., and Wichita, Kan. It was also recently overturned in Hamilton, the fourth most populous city in New Zealand."
                            },
                            {
                                "example_id": "43044d14-22f1-4c68-80b5-aac2ab2d2177",
                                "sense_id": "220b7434-efec-3207-af94-9d7150ea93d9",
                                "text": "Proposed restrictions on fluoridation in New Hampshire, Tennessee and North Dakota were rejected. A measure in Kentucky to make fluoridation optional stalled in the state Senate."
                            }
                        ]
                    }
                ],
