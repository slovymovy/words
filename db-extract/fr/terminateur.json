                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "Someone who terminates or ends something, especially (in later use) an assassin or exterminator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e7391ed6-17fd-35f0-adc1-cc6c71b7fc22",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "A text character or string that serves to mark the end of a document or transmission."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c94b510-bb32-3225-ada1-d61c4df0f4d4",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "The line between the day side and the night side of a moon, planet or other celestial body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaec27be-e84b-49c7-a34e-83b1c62ed92a",
                                                "sense_id": "6c94b510-bb32-3225-ada1-d61c4df0f4d4",
                                                "text": "Harriot, looking at the moon, saw the irregular terminator, the highlights and shadows, the mountain ranges and valleys that Galileo had described – and he also convinced himself that he saw Galileo's imaginary crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a937509b-5009-3830-b43b-4faeb2e84631",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "A DNA sequence that causes RNA transcription to cease and an mRNA transcript to break off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bae6a9d5-08f0-3c00-9145-d2d04083e471",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "An electrical device that absorbs reflection at the end of a transmission line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23de5820-6556-3a05-8fb5-6592d68dad1f",
                                        "entry_id": "0592be81-84ea-391d-ac72-23fccffa5120",
                                        "glosses": [
                                            "An intelligent android created to destroy humans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fc0b584-94ac-46ee-a6ea-a41fe5b2ec34",
                                                "sense_id": "23de5820-6556-3a05-8fb5-6592d68dad1f",
                                                "text": "Opposite of natural monsters there are technological monsters such as terminators, cyborgs, and robocops—all of which undermine dichotomies between the artificial and the organic, the prosthetic and the natural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
