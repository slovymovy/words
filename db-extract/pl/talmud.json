                        "translation_id": "b0debe6a-29b3-4953-807f-caac1ff916f8",
                        "source_entry_id": "ce1d5736-246a-3f1b-aa07-251e7fbe08eb",
                        "source_sense_id": "d26f37bd-481d-36a3-bfa9-b2dd7c5946f4",
                        "target_lang_word": "Talmud",
