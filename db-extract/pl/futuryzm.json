                    },
                    {
                        "translation_id": "4522f042-d603-4b7e-8782-fce0f7f7e681",
                        "source_entry_id": "c1a0cbd3-532a-3f5a-a2a5-cf30128cbc47",
                        "source_sense_id": "879723e6-c81b-351f-82a3-ee0f40187360",
                        "target_lang_word": "Futurismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Futurismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                        "entry_id": "759cf680-1fd5-3272-b64c-dce72219c005",
                                        "glosses": [
                                            "architektonischer, musikalischer, künstlerischer oder produktgestalterischer Stil, der auf Vorstellungen über die Zukunft basiert beziehungsweise der Versuch mit künstlerischen Mitteln die Zukunft zu erfassen und abzubilden"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc097019-19c1-438f-b09d-becd71c8f667",
                                                "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                                "text": "„Die Überwältigungs-Technik besteht aus sehr klobigen Geräten mit sehr großen Knöpfen und Zeigern, die Fernbedienung stammt aus dem Spielzeuggeschäft, und Futurismus bedeutet vor allem Blitz, Rauch und Lärm – die alten Theaterrequisiten also.“"
                                            },
                                            {
                                                "example_id": "a7a90307-9bf4-482d-9654-c5d1d2d8e265",
                                                "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                                "text": "„Wie Stephen \"Thundercat\" Bruner gehörte auch Peralta zu einer Gruppe junger Jazzmusiker aus Los Angeles, die sich zurzeit vorzugsweise beim Label Brainfeeder Records versammeln, um wundersame, zwischen Nostalgie und Futurismus transzendierende Musik zu machen. “"
                                            },
                                            {
                                                "example_id": "47d07197-038d-48c3-8dbe-8be7148ca8ef",
                                                "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                                "text": "„Der Futurismus dieser Forderung ist etwa für die Literaturwerkstatt, die mit lyrikline.org eine internationale Netzplattform für Poesie betreibt und dazu auch europäische Mittel in Anspruch nimmt, längst beispielhafter Alltag.“"
                                            },
                                            {
                                                "example_id": "d28cbacd-97d6-4889-92f1-fb4dd60aba80",
                                                "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                                "text": "„Futurismus und Kontemplation - Auf Zeitreise in Tokio und Kyoto“"
                                            },
                                            {
                                                "example_id": "a1210885-4383-4595-a480-f4f6dcffa6bf",
                                                "sense_id": "780477df-3def-3ba5-abcd-b866b01f6348",
                                                "text": "„Die göttliche \"Déesse\", das war bis dahin nicht dagewesener Futurismus in Millionenauflage, der sich bis zur finalen Ausbaustufe DS 23 im Jahr 1975 streckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8fb46d03-0b82-3fc9-a00e-16a94c650a21",
                                        "entry_id": "759cf680-1fd5-3272-b64c-dce72219c005",
                                        "glosses": [
                                            "vorwiegend italienische, avantgardistische Kunstbewegung der ersten Hälfte des 20. Jahrhunderts"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24709706-cbba-4331-9d32-2b6d21dbedbe",
                                                "sense_id": "8fb46d03-0b82-3fc9-a00e-16a94c650a21",
                                                "text": "Filippo Tommaso Marinetti begründete den Futurismus."
                                            },
                                            {
                                                "example_id": "3ba88ec4-5dd9-43bf-987b-9a1e47a9b004",
                                                "sense_id": "8fb46d03-0b82-3fc9-a00e-16a94c650a21",
                                                "text": "„In der Kunst sympathisierte er mit dem Futurismus, der im frühen 20. Jahrhundert in Italien entstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
