                    {
                        "sense_id": "17eee9cb-9b39-3636-8dbc-c304cc7c4cc6",
                        "entry_id": "72ae318d-e459-3ce2-8137-933dbf11d0f8",
                        "glosses": [
                            "Polycopié."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "338288c0-5ec0-49e1-a9b2-34e9c6d9f1a8",
                                "sense_id": "17eee9cb-9b39-3636-8dbc-c304cc7c4cc6",
                                "text": "Finis les artistes de tout poil pour nous faire comprendre les chiffons de Boltanski, finies les nuits blanches, finis les polys qu’il fallait faire réciter à Fanny."
                            }
                        ]
