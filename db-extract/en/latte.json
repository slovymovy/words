                "senses": [
                    {
                        "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                        "glosses": [
                            "A drink of coffee made from espresso and steamed milk, generally topped with foam."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "873005a7-5cdf-4f76-bd1b-ca367d7e6292",
                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                "text": "Lilian Benedict walked into the office carrying two cups of latte."
                            },
                            {
                                "example_id": "168f9199-f5bf-4b59-930c-9602d9f54e70",
                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                "text": "Yet in “Through a Latte, Darkly”, a new study of how Starbucks has largely avoided paying tax in Britain, Edward Kleinbard […] shows that current tax rules make it easy for all sorts of firms to generate what he calls “stateless income”: […]. In Starbucks’s case, the firm has in effect turned the process of making an expensive cup of coffee into intellectual property."
                            },
                            {
                                "example_id": "09ed945b-2218-4699-a3b3-58e88c50a078",
                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                "text": "High-priced lattes and customized drinks helped lift the coffee chain’s US sales in the quarter ending on October 1, the company said Thursday."
                            },
                            {
                                "example_id": "9f67e0c0-e7b6-4b5c-940a-691d834c5633",
                                "sense_id": "f54e4435-4fad-3fa8-abb6-745715fdd4dd",
                                "text": "Photos of the drink, posted on Chinese social media platform Weibo by the Shanghai Starbucks Reserve Roastery, show a drizzle of dark red sauce atop the latte foam — with a square slice of pork on a skewer resting on the mug rim."
                            }
                        ]
                    },
                    {
                        "sense_id": "64d627fe-9e1a-3e75-83e4-db5874cd60ab",
                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                        "glosses": [
                            "A similar drink, where the espresso is replaced with some other flavoring ingredient such as chai, maté or matcha (green tea)."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "96777fdc-d060-4903-b3fc-ab7b0a28355c",
                                "sense_id": "64d627fe-9e1a-3e75-83e4-db5874cd60ab",
                                "text": "matcha latte"
                            }
                        ]
                    },
                    {
                        "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                        "entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                        "glosses": [
                            "Affluent leftism."
                        ],
                        "tags": [
                            "attributive",
                            "countable",
                            "figuratively",
                            "informal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d4a2866c-2d07-43c9-859c-4e8a445eb145",
                                "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                                "text": "latte liberal"
                            },
                            {
                                "example_id": "7ee8d728-9a50-497f-9161-a175ab0639cd",
                                "sense_id": "47a3cc14-a71c-3ec1-9dfb-b9d674c603c9",
                                "text": "Newt Gingrich accused New York mayor Bill De Blasio of “small soy latte liberalism” in 2014 – emphasising that the only thing more girlish than drinking a big dairy milky coffee was drinking a small vegan milky coffee."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daa84285-c976-494d-b326-e3f5afd29b0e",
                        "source_entry_id": "68864b94-abe6-3316-8c23-ecfe5989789e",
                        "source_sense_description": "caffè latte",
                        "target_lang_word": "café au lait",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "café au lait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b06126f-4933-397e-a2af-89c7d34ab2bb",
                                        "entry_id": "528f60f9-f79f-3e1e-a045-d088fc57ddfa",
                                        "glosses": [
                                            "Boisson obtenue en mélangeant du café et du lait."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcdf4b8f-6a71-4bd6-8f08-8c3743ce8f4f",
                                                "sense_id": "5b06126f-4933-397e-a2af-89c7d34ab2bb",
                                                "text": "Il a voulu monter plus haut que l’échelle, disait-on à ceux qui plaignaient l’ex-garde-chasse, le chanoine rubicond à qui sa femme faisait son café au lait le matin, comme on l’a vu dans le récit des événements antérieurs."
                                            },
                                            {
                                                "example_id": "2e0ed7c3-1f62-40cc-8cf4-7aded2f0f409",
                                                "sense_id": "5b06126f-4933-397e-a2af-89c7d34ab2bb",
                                                "text": "Comme toutes les vieilles filles — qui ont une gourmandise — elle aime son café au lait à l’adoration, — et il est bon, ma foi ! J’en ai les lèvres toutes grasses, et les joues toutes chaudes. C’est le même bol que celui où je trempais autrefois mon museau, en buvant des gorgées doubles parce que ma mère pouvait arriver et que ma mère ne voulait pas qu’on me gâtât en dehors d’elle ; — puis le café au lait, c’est mauvais pour les enfants « ça donne des glaires. »"
                                            },
                                            {
                                                "example_id": "766c6480-1d78-483a-85ed-9dc770ed06e9",
                                                "sense_id": "5b06126f-4933-397e-a2af-89c7d34ab2bb",
                                                "text": "Le goût du café au lait matinal nous apporte cette vague espérance d'un beau temps qui jadis si souvent, pendant que nous le buvions dans un bol de porcelaine blanche, crémeuse et plissée qui semblait du lait durci, quand la journée était encore intacte et pleine, se mit à nous sourire dans la claire incertitude du petit jour."
                                            },
                                            {
                                                "example_id": "312e586a-44ea-4d24-898f-f7d0bebbb3d0",
                                                "sense_id": "5b06126f-4933-397e-a2af-89c7d34ab2bb",
                                                "text": "– Jan, saviez-vous que les Suisses avaient de si étranges habitudes ?\n– Rappelez-vous, Sofia… ils aiment beaucoup le café au lait…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ae3e379-1568-3903-ba3d-7b1474a83082",
                                        "entry_id": "528f60f9-f79f-3e1e-a045-d088fc57ddfa",
                                        "glosses": [
                                            "Portion de cette boisson."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c302d528-a9e3-325e-8980-540972a8df3f",
                                        "entry_id": "528f60f9-f79f-3e1e-a045-d088fc57ddfa",
                                        "glosses": [
                                            "Couleur d’un tel mélange."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "661e5f45-b5a6-4a33-b735-7349f0206882",
                                                "sense_id": "c302d528-a9e3-325e-8980-540972a8df3f",
                                                "text": "Pour aller d’un pays à l’autre, on s’entassait dans l’omnibus du théâtre — un vieil omnibus café au lait traîné par un cheval phtisique."
                                            },
                                            {
                                                "example_id": "6f48c36f-1086-4dd4-a074-521d1aa14f5a",
                                                "sense_id": "c302d528-a9e3-325e-8980-540972a8df3f",
                                                "text": "Au sortir de la gare, on tombe dans un quartier tout neuf, où des centaines de maisons chaotiques nous allèchent d’abord par leur couleur café au lait, chocolat ou thé, révélant chez les architectes germains une prédilection pour les aspects comestibles."
                                            },
                                            {
                                                "example_id": "50944405-63ec-445c-bcc3-0be0934cef5e",
                                                "sense_id": "c302d528-a9e3-325e-8980-540972a8df3f",
                                                "text": "Elle le suivit dans une pièce grande et laide, où des baguettes blanches flottaient sur un océan café au lait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1660cdb-8217-35d2-825e-1ae540084dfd",
                                        "entry_id": "528f60f9-f79f-3e1e-a045-d088fc57ddfa",
                                        "glosses": [
                                            "Mulâtre."
                                        ],
                                        "tags": [
                                            "countable",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4acdebad-82ac-4d33-91f3-dffcb43b99df",
                                                "sense_id": "e1660cdb-8217-35d2-825e-1ae540084dfd",
                                                "text": "L’individu café au lait tira un livre de sa poche — c’était une Bible — et se mit à lire dedans à toute vitesse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "café au lait",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee4dce7a-4198-3fac-96fe-7756fa56ec30",
                                        "entry_id": "335be8e7-1264-38e0-a45d-4f594c7fcc7a",
                                        "glosses": [
                                            "Teinte de marron de couleur café au lait. #785E2F"
