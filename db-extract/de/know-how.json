                ],
                "senses": [
                    {
                        "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                        "entry_id": "cb3c72c7-1c48-3e79-add0-aa181efdf5d9",
                        "glosses": [
                            "das Wissen, wie man etwas macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dad838d-12c7-4508-9086-615aea545893",
                                "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                                "text": "Wenn dir das entsprechende Know-how fehlt, musst du zu diesem Thema noch eine Schulung machen."
                            },
                            {
                                "example_id": "cf420d9d-5224-412d-a35e-66589adca906",
                                "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                                "text": "„Ihnen fielen die Produktionsstätten und teilweise das Know-how der mächtigen deutschen Konkurrenz praktisch in den Schoß.“"
                            },
                            {
                                "example_id": "89d52572-7641-48a5-8319-51bf0d488979",
                                "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                                "text": "„Die Franzosen beabsichtigten, dieses Know-how des Kriegsgegners nicht den Amerikanern zu überlassen, sondern die Spezialisten stattdessen nach Frankreich zu bringen.“"
                            },
                            {
                                "example_id": "dd2fb372-6e1e-43be-b09e-7d19b6a06ec2",
                                "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                                "text": "„Als die Juden gingen, ging das notwendige Know-how mit, und der deutsche Film hat sich seitdem nie mehr erholt.“"
                            },
                            {
                                "example_id": "405227e3-3bf3-4aad-b53b-cf8ebfd49fb0",
                                "sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                                "text": "[Russlands Krieg gegen die Ukraine 2022-…:] „Deutschland unterstützt die Ukraine seit Beginn der russischen Invasion mit Waffen, Hilfsgütern und eigenem Know-how.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d097f35-9fb8-4a93-a8da-7f157277a457",
                        "source_entry_id": "cb3c72c7-1c48-3e79-add0-aa181efdf5d9",
                        "source_sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                        "source_sense_description": "das Wissen, wie man etwas macht",
                        "target_lang_word": "know-how",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "know-how",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                        "entry_id": "5460d9d1-fbbc-3e37-b89f-a3e71b6b1ff1",
                                        "glosses": [
                                            "The knowledge and skill to be able to (do something correctly)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2448b225-e70b-4c58-aaff-c02f9d6c5c1e",
                                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                                "text": "Marlo has the know-how to fix your computer."
                                            },
                                            {
                                                "example_id": "ba1bfe9b-a482-4ec0-a722-dd72b5d5ab1f",
                                                "sense_id": "ab414e38-1311-387a-b67f-dc5124cacc0f",
                                                "text": "American innovators — with their world-class strengths in product design, marketing and finance — may have a historic opportunity to convert the scientific know-how from abroad into market gains and profits. Mr. Hill views the transition to “the postscientific society” as an unrecognized bonus for American creators of new products and services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67ceeeca-1fb2-4db7-bfa5-2bb62532b2d4",
                        "source_entry_id": "cb3c72c7-1c48-3e79-add0-aa181efdf5d9",
                        "source_sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
                        "source_sense_description": "das Wissen, wie man etwas macht",
                        "target_lang_word": "savoir-faire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "savoir-faire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                        "entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                                        "glosses": [
                                            "Connaissance pratique d'un domaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a57a7f4-e8bd-48b2-a92e-18da359fdb7e",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "La célèbre mirabelle de Lorraine est le fruit d’un savoir-faire ancestral qui respecte le rythme des saisons."
                                            },
                                            {
                                                "example_id": "9605518d-e757-4666-8cf8-167d59b5f461",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "Voilà un bel exemple du fait que le savoir-faire peut très bien précéder le savoir. C'est ainsi que l'on a inventé le levier bien avant qu'Archimède n'en explique le principe."
                                            },
                                            {
                                                "example_id": "64e662b1-7a1e-41d6-aecc-27d1ea9ae76f",
                                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                                "text": "Il n’a pas de véritable talent, il n’a que du savoir-faire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c9972e8-b1e0-4766-89ad-388a597f622d",
                        "source_entry_id": "cb3c72c7-1c48-3e79-add0-aa181efdf5d9",
                        "source_sense_id": "fa0fbe61-a866-3cfb-8319-11263f79e6b0",
