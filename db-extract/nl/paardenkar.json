                        "glosses": [
                            "een door een paard voortgetrokken tweewielige wagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f095612-50a1-4959-b83a-f83121910812",
                                "sense_id": "fec2e511-d239-337f-821c-274c4fa4f94f",
                                "text": "Twee mannen zijn zondagochtend zwaargewond geraakt door een ongeluk met een paardenkar in Rosmalen. Het paard sloeg op hol en de kar raakte twee bomen. Vervolgens sloeg het voertuig om."
                            },
                            {
                                "example_id": "bace9fb9-402e-4697-8fe3-f97013b32537",
                                "sense_id": "fec2e511-d239-337f-821c-274c4fa4f94f",
                                "text": "Het evenement is gewijd aan buitenleven en buitenproducten. Er zijn zo’n 180 stands met streekproducten en verder is er een speeltuin, een professionele bellenblaasster, shows met honden, paarden en een race met Shetlandpony’s. Ook rijden er voor bezoekers diverse paardenkarren op het landgoed rond."
                            }
                        ]
                    }
