{
    "word_family": [
        "daylit"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5bac190e-3843-3c88-a7ad-4284531dad3e",
                    "sense_definition": "The natural light that comes from the sun.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is much easier to read a book by natural <w>daylight</w>.",
                            "target_lang_translations": {
                                "ru": "Читать книгу при естественном <w>дневном свете</w> гораздо легче.",
                                "zh": "在自然<w>日光</w>下看书要容易得多。"
                            }
                        },
                        {
                            "text": "The curtains were thick enough to block out the bright <w>daylight</w>.",
                            "target_lang_translations": {
                                "ru": "Шторы были достаточно плотными, чтобы не пропускать яркий <w>дневной свет</w>.",
                                "zh": "窗帘足够厚，能挡住明亮的<w>日光</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sunlight",
                        "sunshine"
                    ],
                    "antonyms": [
                        "darkness"
                    ],
                    "common_phrases": [
                        "broad daylight",
                        "natural daylight",
                        "bright daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный свет, исходящий от солнца.",
                        "zh": "来自太阳的自然光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дневной свет",
                                "target_lang_sense_clarification": "свет солнца"
                            },
                            {
                                "target_lang_word": "естественное освещение",
                                "target_lang_sense_clarification": "природный свет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日光",
                                "target_lang_sense_clarification": "太阳光"
                            },
                            {
                                "target_lang_word": "自然光",
                                "target_lang_sense_clarification": "天然的光线"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d34082aa-7329-3a2d-9771-d10322cf32e4",
                    "sense_definition": "The period of the day between sunrise and sunset when there is light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to finish painting the fence while there is still <w>daylight</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно закончить покраску забора, пока еще есть <w>дневной свет</w>.",
                                "zh": "我们需要趁着还有<w>白昼</w>把栅栏漆完。"
                            }
                        },
                        {
                            "text": "Most accidents on this road happen during <w>daylight</w> hours.",
                            "target_lang_translations": {
                                "ru": "Большинство аварий на этой дороге происходит в <w>светлое время</w> суток.",
                                "zh": "这条路上大多数事故都发生在<w>白天</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "daytime",
                        "day"
                    ],
                    "antonyms": [
                        "night"
                    ],
                    "common_phrases": [
                        "daylight hours",
                        "during daylight",
                        "lose daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Период дня между восходом и закатом, когда на улице светло.",
                        "zh": "从日出到日落之间有光亮的白天。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "светлое время суток",
                                "target_lang_sense_clarification": "период дня"
                            },
                            {
                                "target_lang_word": "день",
                                "target_lang_sense_clarification": "время, когда светло"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白天",
                                "target_lang_sense_clarification": "有光亮的时期"
                            },
                            {
                                "target_lang_word": "白昼",
                                "target_lang_sense_clarification": "日间时段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "916fd1b3-1c3f-3dc4-9a61-5ced9d170d73",
                    "sense_definition": "The time in the morning when light first appears.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time_period",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers were up before <w>daylight</w> to feed the animals.",
                            "target_lang_translations": {
                                "ru": "Фермеры встали до <w>рассвета</w>, чтобы покормить животных.",
                                "zh": "农民们在<w>黎明</w>前就起床喂牲口了。"
                            }
                        },
                        {
                            "text": "We plan to leave at <w>daylight</w> to avoid the heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Мы планируем выехать на <w>рассвете</w>, чтобы избежать пробок.",
                                "zh": "我们计划在<w>黎明</w>时出发以避开拥堵的交通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dawn",
                        "sunrise",
                        "dayspring"
                    ],
                    "common_phrases": [
                        "before daylight",
                        "at daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Время ранним утром, когда появляется первый свет.",
                        "zh": "清晨光线初现的时候。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рассвет",
                                "target_lang_sense_clarification": "начало дня"
                            },
                            {
                                "target_lang_word": "заря",
                                "target_lang_sense_clarification": "первые лучи солнца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "黎明",
                                "target_lang_sense_clarification": "天刚亮时"
                            },
                            {
                                "target_lang_word": "拂晓",
                                "target_lang_sense_clarification": "天快亮时"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "800de7a9-bbee-3ca8-8ca2-75b2ccf1a299",
                    "sense_definition": "A clear open space or gap, often used metaphorically to mean a path to success or visibility.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gap_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of struggle, he could finally see <w>daylight</w> at the end of the project.",
                            "target_lang_translations": {
                                "ru": "После месяцев борьбы он наконец увидел <w>просвет</w> в конце проекта.",
                                "zh": "经过几个月的挣扎，他终于在项目结束时看到了<w>曙光</w>。"
                            }
                        },
                        {
                            "text": "The runner saw a bit of <w>daylight</w> in the defense and sprinted through it.",
                            "target_lang_translations": {
                                "ru": "Бегун увидел небольшой <w>просвет</w> в обороне и рванул сквозь него.",
                                "zh": "跑步者在防守中发现了一丝<w>缺口</w>，并冲了过去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "see daylight",
                        "run to daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободное пространство или промежуток; часто используется метафорически как путь к успеху или надежда.",
                        "zh": "清晰的空隙或缺口，常比喻为通往成功或可见的路径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "свободное пространство или надежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缺口",
                                "target_lang_sense_clarification": "空隙或突破口"
                            },
                            {
                                "target_lang_word": "曙光",
                                "target_lang_sense_clarification": "比喻希望或转机"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "473b759f-2a8d-36d4-9697-cf18e6614426",
                    "sense_definition": "Artificial light designed to simulate the spectrum of natural sunlight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "light_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist uses a <w>daylight</w> lamp to mix colors accurately in the studio.",
                            "target_lang_translations": {
                                "ru": "Художник использует лампу <w>дневного света</w>, чтобы точно смешивать краски в студии.",
                                "zh": "艺术家在工作室使用<w>日光灯</w>来准确调色。"
                            }
                        },
                        {
                            "text": "These bulbs provide <w>daylight</w> simulation for indoor plants.",
                            "target_lang_translations": {
                                "ru": "Эти лампы обеспечивают имитацию <w>дневного света</w> для комнатных растений.",
                                "zh": "这些灯泡为室内植物提供<w>日光</w>模拟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "daylight bulb",
                        "daylight lamp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусственный свет, имитирующий спектр естественного солнечного света.",
                        "zh": "旨在模拟自然阳光光谱的人造光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дневной свет",
                                "target_lang_sense_clarification": "тип искусственного освещения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日光灯",
                                "target_lang_sense_clarification": "模拟自然光的人造光源"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7b5a43e-09e1-324c-9476-9e36c81cf89a",
                    "sense_definition": "A noticeable difference, gap, or disagreement between people or opinions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gap_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is very little <w>daylight</w> between the two candidates on economic policy.",
                            "target_lang_translations": {
                                "ru": "Между двумя кандидатами очень мало <w>различий</w> в вопросах экономической политики.",
                                "zh": "两位候选人在经济政策上几乎没有什么<w>分歧</w>。"
                            }
                        },
                        {
                            "text": "The negotiator tried to close the <w>daylight</w> between the demands of the two parties.",
                            "target_lang_translations": {
                                "ru": "Переговорщик пытался сократить <w>разрыв</w> между требованиями двух сторон.",
                                "zh": "谈判代表试图缩小双方要求之间的<w>差距</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "daylight between"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заметная разница, дистанция или разногласие между людьми или мнениями.",
                        "zh": "人与人之间或观点之间明显的差异、差距或分歧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разница",
                                "target_lang_sense_clarification": "отличие"
                            },
                            {
                                "target_lang_word": "разрыв",
                                "target_lang_sense_clarification": "дистанция во мнениях"
                            },
                            {
                                "target_lang_word": "расхождение",
                                "target_lang_sense_clarification": "несовпадение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "意见不合"
                            },
                            {
                                "target_lang_word": "差距",
                                "target_lang_sense_clarification": "距离或差异"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb3f4051-d87c-363d-93bc-531cf2de09e9",
                    "sense_definition": "Exposure to public view or knowledge.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scandal finally saw <w>daylight</w> after years of being hidden.",
                            "target_lang_translations": {
                                "ru": "Скандал наконец вышел на <w>свет</w> после того, как его годами скрывали.",
                                "zh": "这桩丑闻在被隐藏多年后终于<w>曝光</w>了。"
                            }
                        },
                        {
                            "text": "Corruption cannot survive in the <w>daylight</w> of public scrutiny.",
                            "target_lang_translations": {
                                "ru": "Коррупция не может выжить при <w>свете</w> общественного внимания.",
                                "zh": "腐败在公众监督的<w>阳光</w>下无法生存。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "see daylight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выставление на всеобщее обозрение или предание гласности.",
                        "zh": "暴露在公众视野或知识中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свет",
                                "target_lang_sense_clarification": "публичность, известность"
                            },
                            {
                                "target_lang_word": "огласка",
                                "target_lang_sense_clarification": "раскрытие информации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "曝光",
                                "target_lang_sense_clarification": "公之于众"
                            },
                            {
                                "target_lang_word": "公开",
                                "target_lang_sense_clarification": "使人知晓"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bbf77bc6-bb81-3a1a-a793-e5511080cbc8",
                    "sense_definition": "The space between the moving plates of a press or similar machine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gap_space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The operator adjusted the <w>daylight</w> of the press to accommodate the larger mold.",
                            "target_lang_translations": {
                                "ru": "Оператор отрегулировал <w>просвет</w> пресса, чтобы вместить форму большего размера.",
                                "zh": "操作员调整了压力机的<w>净空</w>以容纳更大的模具。"
                            }
                        },
                        {
                            "text": "You must check the maximum <w>daylight</w> specification before buying the machine.",
                            "target_lang_translations": {
                                "ru": "Перед покупкой станка необходимо проверить спецификацию максимального <w>просвета</w>.",
                                "zh": "在购买机器前，你必须检查最大<w>净空</w>规格。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстояние между движущимися плитами пресса или аналогичного станка.",
                        "zh": "压力机或其他类似机器的活动板之间的距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просвет",
                                "target_lang_sense_clarification": "технический зазор"
                            },
                            {
                                "target_lang_word": "открытая высота",
                                "target_lang_sense_clarification": "параметр станка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "净空",
                                "target_lang_sense_clarification": "机器的有效间隙"
                            },
                            {
                                "target_lang_word": "开口高度",
                                "target_lang_sense_clarification": "技术参数"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd4bd8bb-eb92-3e18-85cc-b2a2b5c3989f",
                    "sense_definition": "To expose a previously covered underground stream or pipe to the open air.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council voted to <w>daylight</w> the old creek to improve the park's ecology.",
                            "target_lang_translations": {
                                "ru": "Городской совет проголосовал за то, чтобы <w>вывести на поверхность</w> старый ручей для улучшения экологии парка.",
                                "zh": "市议会投票决定将旧溪流<w>开挖</w>以改善公园的生态。"
                            }
                        },
                        {
                            "text": "Engineers are working to <w>daylight</w> the river that flows under the shopping center.",
                            "target_lang_translations": {
                                "ru": "Инженеры работают над тем, чтобы <w>открыть</w> реку, протекающую под торговым центром.",
                                "zh": "工程师们正在努力将流经购物中心下方的河流<w>开挖</w>出来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыть доступ к ранее скрытому подземному потоку или трубе, выведя их на поверхность.",
                        "zh": "将之前被覆盖的地下溪流或管道暴露在露天环境中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вывести на поверхность",
                                "target_lang_sense_clarification": "открыть русло"
                            },
                            {
                                "target_lang_word": "открыть",
                                "target_lang_sense_clarification": "сделать доступным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开挖",
                                "target_lang_sense_clarification": "使地下水流重见天日"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43240a70-c4c8-3ae0-943d-417e9ec70654",
                    "sense_definition": "To illuminate a building or space with natural light using windows or skylights.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "illuminate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect designed the atrium to <w>daylight</w> the interior offices.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал атриум так, чтобы <w>осветить естественным светом</w> внутренние офисы.",
                                "zh": "建筑师设计了中庭，以便为内部办公室提供<w>采光</w>。"
                            }
                        },
                        {
                            "text": "Properly <w>daylighting</w> a workspace can reduce energy costs significantly.",
                            "target_lang_translations": {
                                "ru": "Правильное <w>естественное освещение</w> рабочего пространства может значительно снизить затраты на электроэнергию.",
                                "zh": "对工作空间进行合理的<w>采光</w>设计可以显著降低能源成本。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освещать здание или пространство естественным светом с помощью окон или зенитных фонарей.",
                        "zh": "利用窗户或天窗用自然光照亮建筑物或空间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освещать естественным светом",
                                "target_lang_sense_clarification": "архитектурное решение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "采光",
                                "target_lang_sense_clarification": "建筑设计中的自然照明"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}