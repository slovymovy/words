        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e85e4754-6457-3c64-946d-51d2e239ba29",
                    "sense_definition": "A small, insectivorous mammal resembling a mouse, with a pointed snout and tiny eyes, belonging to the family Soricidae.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mammal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cat darted into the tall grass and caught a tiny <w>shrew</w>."
                        },
                        {
                            "text": "Unlike mice, a <w>shrew</w> has a very high metabolic rate and must eat constantly."
                        }
                    ],
                    "synonyms": [
                        "soricid"
                    ]
                },
                {
                    "sense_id": "0e3c30a7-95ed-3f19-9f2f-48ca21c952eb",
                    "sense_definition": "An ill-tempered, bad-tempered, or aggressively nagging woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the classic comedy, the main character attempts to tame an argumentative <w>shrew</w>."
                        },
                        {
                            "text": "He complained that his neighbor was a constant <w>shrew</w> who shouted at everyone on the street."
                        }
                    ],
                    "synonyms": [
                        "harpy",
                        "harridan",
                        "hellcat",
                        "scold",
                        "termagant",
                        "virago",
                        "vixen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "now generally considered derogatory and old-fashioned"
                        }
                    ]
                },
                {
                    "sense_id": "0fb9dfc9-90c6-3217-88f4-d7aa1c80ba09",
                    "sense_definition": "Any of various small mammals that resemble true shrews, such as elephant shrews or tree shrews.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mammal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist identified the small creature as a tree <w>shrew</w> rather than a true soricid."
                        },
                        {
                            "text": "Despite its common name, the elephant <w>shrew</w> is not closely related to true shrews."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10b3b882-45cc-3caa-8438-7c41f7512174",
                    "sense_definition": "To invoke evil upon; to beshrew or curse.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>shrew</w> myself for ever trusting his dishonest words."
                        },
                        {
                            "text": "In the old verse, the speaker would <w>shrew</w> the hour of their misfortune."
                        }
                    ],
