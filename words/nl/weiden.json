                            "trait_type": "dated",
                            "comment": "vooral gebruikt in literaire of verheven context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to let one's gaze roam or wander freely across an area"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wander",
                                "target_lang_sense_clarification": "of eyes or gaze moving freely"
                            },
                            {
                                "target_lang_word": "roam",
                                "target_lang_sense_clarification": "of eyes or gaze passing over an area"
                            },
                            {
                                "target_lang_word": "feast one's eyes",
