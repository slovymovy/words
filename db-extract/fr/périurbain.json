                ],
                "senses": [
                    {
                        "sense_id": "9160adb3-dfda-3c22-9895-0f98dcccc924",
                        "entry_id": "67c75439-ce4f-3325-b324-c8bab79d434a",
                        "glosses": [
                            "Qui concerne les environs d’une ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7abd620d-1130-411b-a305-3199f8ce3b76",
                                "sense_id": "9160adb3-dfda-3c22-9895-0f98dcccc924",
                                "text": "La caractéristique du jardin ouvrier périurbain et du coin de terre rural, c’est d’engager l’initiative privée."
                            },
                            {
                                "example_id": "9e5a7e78-2227-46ee-8f43-91da8e0ee584",
                                "sense_id": "9160adb3-dfda-3c22-9895-0f98dcccc924",
                                "text": "Cuy-Saint-Fiacre est une petite commune de 535 habitants située au sud du \"désert\" à 4,1 kilomètres du bureau de Gournay. Cette commune périurbaine est l'exemple type de la cité dortoir: aucun commerçant mais des pavillons."
                            },
                            {
                                "example_id": "d9643735-d540-4afa-a7f5-3e42b2784651",
                                "sense_id": "9160adb3-dfda-3c22-9895-0f98dcccc924",
                                "text": "La gendarmerie nationale serait alors chargée d’assurer la sécurité publique et l’ordre public, « particulièrement dans les zones rurales et périurbaines, ainsi que sur les voies de communications »."
                            },
                            {
                                "example_id": "a42ac722-7521-4c4a-9419-0a0ac9694d3d",
                                "sense_id": "9160adb3-dfda-3c22-9895-0f98dcccc924",
                                "text": "Une civilisation périurbaine a émergé, avec ses lotissements, ses ronds-points, ses zones commerciales et ses entrepôts Amazon."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa74ffc6-836f-3771-90cf-684606f436f8",
                        "entry_id": "67c75439-ce4f-3325-b324-c8bab79d434a",
                        "glosses": [
                            "Qualifie la zone de transition entre l'urbanité et la ruralité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de0dd132-7257-4e5b-9990-8afc90699e6f",
                                "sense_id": "fa74ffc6-836f-3771-90cf-684606f436f8",
                                "text": "Aux banlieues pavillonnaires de la première couronne succèdent des zones périurbaines où se multiplient les espaces commerciaux de grands gabarits, les terres agricoles, en friche ou boisées, des aires de services en bordure des autoroutes, des noyaux villageois rurbanisés ou des espaces de villégiature embourgeoisés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad5335d6-762b-4de2-a4a2-0ee082af5f44",
                        "source_entry_id": "67c75439-ce4f-3325-b324-c8bab79d434a",
