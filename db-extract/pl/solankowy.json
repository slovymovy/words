                        "source_sense_id": "26af0699-20a5-3024-b165-1807f5c85241",
                        "target_lang_word": "рассольный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "рассольный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4f92f6-722d-3a7f-b513-4949405fdea6",
                                        "entry_id": "b115db81-3f46-386a-83c0-00807378c380",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным рассол"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18994cd8-d336-4b4a-b400-2edd3ce2e719",
                                                "sense_id": "3e4f92f6-722d-3a7f-b513-4949405fdea6",
                                                "text": "Они, ни на секунду не прерывая взмахов руки́, кололи, распахивали свиной живот, ошпаривали, скребли, отрубали но́ги, голову и ту́шу за тушей опускали в рассольный чан."
                                            },
                                            {
                                                "example_id": "e0ad8344-d84a-47e6-9184-820a15ba2e72",
                                                "sense_id": "3e4f92f6-722d-3a7f-b513-4949405fdea6",
                                                "text": "Кроме того, предприятие производит и́глы для инъекторов, матрицы клипсаторов, роторы рассольных насосов и другие быстроизнашивающиеся элементы технологического оборудования."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf7be42-fa9e-3686-90fe-75b66cb17270",
                                        "entry_id": "b115db81-3f46-386a-83c0-00807378c380",
                                        "glosses": [
                                            "приготовленный на рассоле или с рассолом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caf00460-a653-4c28-8237-e59b27df67de",
                                                "sense_id": "ddf7be42-fa9e-3686-90fe-75b66cb17270",
                                                "text": "Зайцы подавались душёные (духовые), рассольные (в рассоле варёные) и под взварами, особенно сладкими."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
