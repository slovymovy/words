                },
                {
                    "sense_id": "84a5f0fd-a37b-3225-9fee-6ab4fcfc5db1",
                    "sense_definition": "Marque une quantité ou un degré très important ; tellement, tant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je n'ai jamais vu <w>autant</w> de monde dans ce petit village de montagne."
                        },
                        {
                            "text": "Pourquoi cours-tu <w>autant</w> alors que le train ne part que dans une heure ?"
                        }
                    ],
                    "synonyms": [
