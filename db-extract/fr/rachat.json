                                            {
                                                "example_id": "f2f46eb6-5e22-451a-8769-71eb925a9503",
                                                "sense_id": "6094ae02-7b3c-308e-8e83-cf7d5d5fc4b6",
                                                "text": "Der Gang zur Toilette brachte für ihn endlich Erlösung."
                                            },
                                            {
                                                "example_id": "5003c61a-cc27-45fd-af58-117f7cd4ac48",
                                                "sense_id": "6094ae02-7b3c-308e-8e83-cf7d5d5fc4b6",
                                                "text": "„Wenn einst – und das muß ja kommen, wenn unsere ganze Kultur nicht untergehen soll – wenn einst die Welt von diesem größten aller Übel, vom Krieg, erlöst sein wird, so wird Andrejew mit seinem unvergleichlichen Kunstwerk an dieser Erlösung mitgearbeitet haben, wie kein Zweiter.“"
                                            },
                                            {
                                                "example_id": "5df958fe-43a7-4d41-98ee-4da757258e7e",
                                                "sense_id": "6094ae02-7b3c-308e-8e83-cf7d5d5fc4b6",
                                                "text": "„Afrika war für mich eine Erlösung gewesen, eine befreiende Umarmung und eine Chance.“"
                                            },
                                            {
                                                "example_id": "7ca9f413-b68a-4595-bd21-aa393e0e50e8",
                                                "sense_id": "6094ae02-7b3c-308e-8e83-cf7d5d5fc4b6",
                                                "text": "Für Tom war es die Erlösung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1ce1162a-7af5-3aa6-9338-dcfe8c9f7058",
                                        "entry_id": "50914585-ff52-36c5-af19-75acddf197b9",
                                        "glosses": [
                                            "Prozess oder ein Punkt des Heraustretens aus einem Zustand der Unfreiheit, Bedrängung, Entfremdung oder der vererbten Sünde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e237e785-b42a-4b80-b9b1-2d4526e8b5a2",
                                                "sense_id": "1ce1162a-7af5-3aa6-9338-dcfe8c9f7058",
                                                "text": "„Durch ihn haben wir die Erlösung, die Vergebung der Sünden.“"
                                            },
                                            {
                                                "example_id": "df977832-ba77-43fe-b925-779a2029008a",
                                                "sense_id": "1ce1162a-7af5-3aa6-9338-dcfe8c9f7058",
                                                "text": "„Das erinnert bis zu dem albernen ›stracks gen Himmel‹ mehr an das von Luther befehdete katholische Tauschgeschäft Ablass gegen Seligkeit als an seine eigene Gnadenlehre, der zufolge die Erlösung unabhängig ist von guten Werken und irdischem Wirken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "531c88bc-ece1-35f9-9cdc-00c839f59d80",
