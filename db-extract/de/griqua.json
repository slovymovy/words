                "senses": [
                    {
                        "sense_id": "d5bde431-378d-3e15-adcc-919d380b6c08",
                        "entry_id": "7a012268-0e4c-3ef8-ba01-3b68fc2823b3",
                        "glosses": [
                            "aus Verbindungen zwischen Khoikhoi oder Nama und Buren hervorgangenen Ethnie im südlichen Afrika"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "18b6e4a3-ce8a-4c4c-819d-56ffb4d1bb08",
                                "sense_id": "d5bde431-378d-3e15-adcc-919d380b6c08",
                                "text": "„Die verschiedenen Bevölkerunsgruppen konkurrierten nicht nur miteinander, es gab auch Kontakte, Austausch und Vermischung. Das beste Beispiel hierfür waren die Griqua, nach damaligem Sprachgebrauch ‹Halbblute›, die aus offiziellen und weniger offiziellen Beziehungen zwischen Weißen und Khoikhoi hervorgegangen waren und schon zu Beginn des 19. Jahrhunderts als ein Volk für sich betrachtet wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
