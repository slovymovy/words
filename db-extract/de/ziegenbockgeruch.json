                ],
                "senses": [
                    {
                        "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                        "entry_id": "2d005de6-b72a-3cd7-8521-e80208c1ad4c",
                        "glosses": [
                            "Geruch, der von einer geschlechtsreifen männlichen Ziege stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c71c1f-ff23-4dda-9610-f5ea9557b656",
                                "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                                "text": "„Dann strömen die erwachsenen Männchen einen stechenden «Ziegenbockgeruch» aus, werden zu erbitterten Rivalen und liefern einander heftige Zweikämpfe, um das Vorrecht zur Paarung mit den brünstigen Weibchen zu erlangen.“"
                            },
                            {
                                "example_id": "825b866c-131e-4065-9785-1eeb750707b8",
                                "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                                "text": "„Reibt der Leser mit seiner Hand über die zahlreichen Bilder, kommt er selbst in den Genuss der zwölf verschiedenen Duftnoten, Ziegenbockgeruch natürlich inklusive.“"
                            },
                            {
                                "example_id": "92c1d733-5c9e-4ee3-bc14-205ff20ee061",
                                "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                                "text": "Unter dem Vorurteil des strengen Ziegenbockgeruches leidet auch zu Unrecht das Gitzifleisch, welches eine absolute Delikatesse ist."
                            },
                            {
                                "example_id": "147f45ff-c622-4aa0-b4d5-8270f5da6874",
                                "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                                "text": "Es gibt sie wirklich, die Genießer des Ziegenbockgeruchs und jetzt kann man all das auch wieder bei uns am Seewaldsee bekommen."
                            },
                            {
                                "example_id": "4f3844bf-bdd9-43d3-8e86-b069b882092b",
                                "sense_id": "8fe80a43-1026-344e-be86-7e21846c4e1a",
                                "text": "Stinkend charakterisierte er ziegenartigen Mief wie Satyrion, Ziegenbockgerüche, übelriechenden Gänsefuß und Androsoeum foetidum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0e6bde28-b650-3fab-bd1a-1914992313f5",
                        "entry_id": "2d005de6-b72a-3cd7-8521-e80208c1ad4c",
                        "glosses": [
                            "Geruch der [1] ähnelt, jedoch von einer Pflanze stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb249a6-4ef4-48e2-b265-7120dc6d0cbb",
                                "sense_id": "0e6bde28-b650-3fab-bd1a-1914992313f5",
                                "text": "Stinkend charakterisierte er ziegenartigen Mief wie Satyrion, Ziegenbockgerüche, übelriechenden Gänsefuß und Androsoeum foetidum."
                            },
                            {
                                "example_id": "bd99b029-97d3-4972-92cf-068472cd741d",
                                "sense_id": "0e6bde28-b650-3fab-bd1a-1914992313f5",
                                "text": "„Ihren Namen trägt die Pflanze zu recht: Wer im Mai an ihren Blüten schnüffelt, kann einen deutlichen Ziegenbockgeruch wahrnehmen.“"
                            },
                            {
                                "example_id": "8faaecc9-d38e-44dc-b67e-a58109db908e",
                                "sense_id": "0e6bde28-b650-3fab-bd1a-1914992313f5",
                                "text": "„Der etwas seltsam anmutende Name resultiert aus einem intensiven Ziegenbockgeruch der blühenden Pflanze.“"
                            },
                            {
                                "example_id": "ae3ea691-72e7-489d-97f8-21cdaa168474",
                                "sense_id": "0e6bde28-b650-3fab-bd1a-1914992313f5",
                                "text": "„Die Wurzel wird in der Heilkunde gebraucht, sie besitzt außer dem Ziegenbockgeruch, eine brennende, brecherregende Wirkung , woran die Bibernelle von allen Kräutern leicht zu erkennen ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
