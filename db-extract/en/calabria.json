                                            {
                                                "example_id": "153a028b-14a3-4ead-b4aa-50339a179bf8",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "Kalabriens Hauptstadt ist Catanzaro."
                                            },
                                            {
                                                "example_id": "a74201d6-c1a5-4d1b-b1b5-b76bcae24a07",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "Kalabrien bildet die erdbebenreiche Südwesthalbinsel Italiens."
                                            },
                                            {
                                                "example_id": "23434228-b115-41ac-85ff-03a5e2b38627",
                                                "sense_id": "3e436ad9-cdc5-3ba0-a003-155d57f83c8e",
                                                "text": "„Die jüngere hielt es für nötig, meine Spottrede über ihr Land übelzunehmen und mir Fehde anzusagen; doch ich besänftigte sie mit den Worten, Kalabrien wäre ein wunderschönes Land, wenn wenigstens ein Viertel der Einwohner ihr ähnlich sähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
