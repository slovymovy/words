                "senses": [
                    {
                        "sense_id": "fe13e385-2a3a-3636-84eb-60db959357ec",
                        "entry_id": "2944b507-9d84-364e-93d3-4594a8cc4949",
                        "glosses": [
                            "A diminutive of the female given name Matilda."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a95beacf-8b53-4075-8c2c-e6116d539afd",
                                "sense_id": "fe13e385-2a3a-3636-84eb-60db959357ec",
                                "text": "Tilly's name is Matilda. It was typical of Mum and Dad that they wouldn't let her be called Tilly when she came to them because that was the unusual shortening of Matilda, the unconventional one, and you never did unconventional things, you never did things to draw attention to yourself. So they called her Matty."
                            }
                        ]
                    },
