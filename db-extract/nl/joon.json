                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "611c59b0-c651-35f5-818e-128b375072f7",
                                        "entry_id": "c6a726e7-07a1-3af9-9b8c-e1c9df20dacf",
                                        "glosses": [
                                            "To support or maintain at a high level."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad63b640-66a2-46f8-81a6-06b55f3b7523",
                                                "sense_id": "611c59b0-c651-35f5-818e-128b375072f7",
                                                "text": "“My Heart Will Go On” debuted at No. 1 on the Billboard Hot 100 on Feb. 28, 1998, buoying the Titanic soundtrack’s 16-week run atop the Billboard 200."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6b3fa6-7d60-3a0a-811f-ed41dc0bcb69",
                                        "entry_id": "c6a726e7-07a1-3af9-9b8c-e1c9df20dacf",
                                        "glosses": [
                                            "To mark with a buoy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b235056d-d5c2-4b8f-94c7-a4d0c748c6df",
                                                "sense_id": "1d6b3fa6-7d60-3a0a-811f-ed41dc0bcb69",
                                                "text": "to buoy an anchor; to buoy or buoy off a channel"
                                            },
                                            {
                                                "example_id": "be467fa9-40fa-41d8-9242-09fde18e69de",
                                                "sense_id": "1d6b3fa6-7d60-3a0a-811f-ed41dc0bcb69",
                                                "text": "Not one rock near the surface was discovered which was not buoyed by this floating weed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                                        "entry_id": "c6a726e7-07a1-3af9-9b8c-e1c9df20dacf",
                                        "glosses": [
                                            "To maintain or enhance enthusiasm or confidence; to lift the spirits of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "152d4991-f776-49de-83bb-990819f651f7",
                                                "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                                                "text": "Buoyed by the huge success, they announced two other projects."
                                            },
                                            {
                                                "example_id": "e745f127-ef70-42e7-af99-44158a5fbf29",
                                                "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                                                "text": "This dynamic stage of the ongoing struggle for long-denied democratic rights and national liberation helped inspire and buoy many in the U.S. and around the world who longed for social and economic justice."
                                            },
                                            {
                                                "example_id": "8b022d50-13af-4c3e-9569-3765e9ab5a4e",
                                                "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                                                "text": "It ended up being a bittersweet night for England, full of goals to send the crowd home happy, buoyed by the news that Montenegro and Poland had drawn elsewhere in Group H but also with a measure of regret about what happened to Danny Welbeck and what it means for Roy Hodgson's team going into a much more difficult assignment against Ukraine."
                                            },
                                            {
                                                "example_id": "b85c8e9d-5a74-4e97-8a5c-c6b0f9d118db",
                                                "sense_id": "95b6b014-b804-34fe-96da-d5707664b6a6",
                                                "text": "Considering the results of the study, today John may be buoyed at the clear trend of increasing numbers of new “lishes” for each successive decade since the 1950s, and the fact that nothing in the data suggests this trend is likely to falter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
