                        ],
                        "form": "den Schlappschwanz"
                    },
                    {
                        "form_id": "2d7dd46d-58cd-4105-9bd3-e744be5196e4",
                        "entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schlappschwänze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                        "entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                        "glosses": [
                            "willensschwacher, weichlicher, auch feiger Mensch"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "fff96fc1-2b40-42c8-9a98-c35c6e4fbbbc",
                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                "text": "Du traust dich nicht, allein in den Keller zu gehen? Was bist du denn für ein Schlappschwanz?"
                            },
                            {
                                "example_id": "d997a792-87e7-4951-a848-b5abb40abd39",
                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                "text": "„Sie nutzte die Gelegenheit, um sich über Luciens Theorien lustig zu machen, und nannte ihn sogar einen Schlappschwanz.“"
                            },
                            {
                                "example_id": "7a931cef-6c17-4b56-ba5a-df7bf94a9d55",
                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                "text": "„Ansonsten ist Robert ein Schlappschwanz und tut auch gar nicht erst so, als ob er keiner wäre.“"
                            },
                            {
                                "example_id": "939e0e2a-fe44-4233-bfe7-fc3822502dcd",
                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                "text": "„Der Autor, John Steinbeck, war ein Schlappschwanz gewesen, zu schissig, um etwas geschehen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4393de51-7f16-36b9-97fc-fde358b18c8b",
                        "entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                        "glosses": [
                            "impotenter Mann, Liebhaber ohne Temperament"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "969d7b20-0761-4a25-874d-b85753257cce",
                                "sense_id": "4393de51-7f16-36b9-97fc-fde358b18c8b",
                                "text": "Erst hat er den ganzen Abend mit seinen Qualitäten als Liebhaber geprahlt und dann erweist er sich im Bett als echter Schlappschwanz."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21df4945-ceba-4fe3-88d1-931a248cabbd",
                        "source_entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                        "source_sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                        "source_sense_description": "abwertend, verächtlich: willensschwacher, weichlicher, auch feiger Mensch",
                        "target_lang_word": "slappeling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slappeling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8ed3aaa4-ce1b-39c4-8599-c4950ac6d78c",
                                        "entry_id": "7c4a6b4e-e144-3133-ad62-b8895dc61464",
                                        "glosses": [
                                            "een man zonder moed of kracht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0d2767e-5635-4c57-b7a6-1c025756d128",
                                                "sense_id": "8ed3aaa4-ce1b-39c4-8599-c4950ac6d78c",
                                                "text": "De slappeling zal na het lezen van dit boek niet snel de sterke leider zijn. Daar is een intensieve training voor nodig, als zelfs dat al genoeg is. Maar als het lezen van dit boek leidt tot ten minste één moedige beslissing, die anders niet genomen zou worden, dan is het boek al geslaagd."
                                            },
                                            {
                                                "example_id": "773ff426-5f97-4287-938a-ace9d2b38b80",
                                                "sense_id": "8ed3aaa4-ce1b-39c4-8599-c4950ac6d78c",
                                                "text": "De schrijver was niet bepaald even goed als hij probeerde te verklaren en beredeneren wat hij al had beschreven, over hoe de oorlog een nieuw mensentype had geschapen dat bevrijd was van de zorgen van het grauwe dagelijkse leven, een nieuw ras, 'een elite van supermannen, jongleurs van de dood, schitterende roofdieren', mannen die in tegenstelling tot de pacifistische en verwekelijkte slappelingen van de democratie het nieuwe Duitsland zouden creëren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
