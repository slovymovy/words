                                "target_senses": [
                                    {
                                        "sense_id": "8d678417-a006-3812-bdc7-473f03a1e706",
                                        "entry_id": "7cfe38aa-5b1d-3a60-9dc2-269f1e205f65",
                                        "glosses": [
                                            "Relatif à l’enclitique, mot phonétiquement attaché au précédent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51efcc32-cd39-4484-b1fc-f3e41c26b01b",
                                                "sense_id": "8d678417-a006-3812-bdc7-473f03a1e706",
                                                "text": "T-il est une forme enclitique du pronom personnel sujet il à la forme interrogative."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "enclitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                        "entry_id": "5e6b3daa-e072-3f0f-85f3-16ca44e081bd",
                                        "glosses": [
                                            "Clitique phonétiquement attaché au mot précédent. Mot qui prend appui sur le mot précédent et forme avec lui une seule unité accentuelle."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e474b76d-8125-4274-b5ab-44710c60a927",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "Une enclitique est un petit mot que l'on joint au mot qui le précède, en appuyant sur la dernière syllabe de ce mot"
                                            },
                                            {
                                                "example_id": "d16dca3e-fefd-406d-894e-1a472ed22ba0",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "En français, les pronoms dans puis-je, est-ce et allez-y sont des enclitiques."
                                            },
                                            {
                                                "example_id": "62f34831-ef9a-4661-9970-913962b346b0",
                                                "sense_id": "26707bb9-59da-3322-a590-e6c36a020f1b",
                                                "text": "En japonais, la prolifération des suffixes fonctionnels et la complexité des enclitiques supposent que le sujet s’avance dans l’énonciation à travers des précautions, des reprises, des retards et des insistances dont le volume final […] fait précisément du sujet une grande enveloppe vide de la parole, et non ce noyau plein qui est censé diriger nos phrases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4b1ded0-0faa-422a-97e6-35f4aa56246a",
                        "source_entry_id": "726c6849-ef93-3b23-87bb-9545f33a0c20",
                        "source_sense_id": "e139998b-e55e-3392-94f1-d48e3a7a1f20",
                        "source_sense_description": "affixed phonetically",
                        "target_lang_word": "enklitisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enklitisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                        "entry_id": "e4a04426-5442-3f4d-986e-873c128901e9",
                                        "glosses": [
                                            "in der Form einer Enklise an ein Wort angehängt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81388d98-88ff-4682-9711-529db2e75eb5",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Diese beiden Suffixe werden entweder der Grundform als eigenes Wort nachgesetzt oder sie werden enklitisch suffigiert.“"
                                            },
                                            {
                                                "example_id": "e38e2016-aaad-46bb-8ab1-1b433ec74ab6",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Diese sind jedoch drastisch vereinfacht worden, das heißt die alte Kongruenzflexion etwa beim enklitischen Artikel ist, kaum daß sie längere Zeit richtig in Gebrauch gewesen ist, schon seit Jahrhunderten (wieder) verschwunden.“"
                                            },
                                            {
                                                "example_id": "41c5a4ab-8b24-41bd-947b-6d31c12d93b7",
                                                "sense_id": "c2eb5bb8-e6b0-3885-bb9b-8b5f8dd2011c",
                                                "text": "„Treffen ein vokalisch auslautendes Stützwort und ein vokalisch anlautendes enklitisches Element aufeinander, so treten ebenfalls Assimilationserscheinungen auf, um den entstehenden Hiat zu vermeiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67918ba6-9754-4c0f-9126-800272ff9364",
                        "source_entry_id": "726c6849-ef93-3b23-87bb-9545f33a0c20",
                        "source_sense_id": "e139998b-e55e-3392-94f1-d48e3a7a1f20",
