                },
                {
                    "sense_id": "38222d73-f973-3d3c-b79d-3378e689a843",
                    "sense_definition": "Fierce, cruel, or intimidating in nature or appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dire</w> wolf was a formidable predator that lived during the Pleistocene epoch.",
                            "target_lang_translations": {
                                "ru": "<w>Ужасный</w> волк был грозным хищником, жившим в эпоху плейстоцена.",
                                "nl": "De <w>reuzenwolf</w> was een geduchte roofvijand die leefde tijdens het pleistoceen."
                            }
                        },
                        {
                            "text": "The warrior faced a <w>dire</w> beast in the depths of the dark forest.",
                            "target_lang_translations": {
                                "ru": "Воин столкнулся с <w>лютым</w> зверем в глубине темного леса.",
                                "nl": "De krijger stond oog in oog met een <w>angstaanjagend</w> beest in de diepten van het donkere woud."
                            }
                        }
