                "senses": [
                    {
                        "sense_id": "4095a9b3-1d7f-399a-82ac-07957c0c6dce",
                        "entry_id": "20150fb1-4ddd-3429-b975-f7837df182d3",
                        "glosses": [
                            "iemand die ervoor zorgt dat crimineel geld gebruikt kan worden in de niet criminele wereld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e8d60cd-fdb3-4fb7-bd3f-fe75ed8b1aff",
                                "sense_id": "4095a9b3-1d7f-399a-82ac-07957c0c6dce",
                                "text": "Voormalig vastgoedman Jan-Dirk Paarlberg, veroordeeld witwasser van door Willem Holleeder afgeperste gelden, is bankroet."
                            },
                            {
                                "example_id": "669b96d6-ec28-4787-ab2a-e1cc6f5eab5e",
                                "sense_id": "4095a9b3-1d7f-399a-82ac-07957c0c6dce",
                                "text": ",,Deze zaak stamt uit 2014 en 2015. Toen was het allemaal nog niet zo helder als nu. De zaak moet met de bril van toen bekeken worden”, aldus advocaat Peter Plasman in een bevlogen betoog. De verdachten zouden specifiek voor de bitcointransacties niet als witwassers veroordeeld kunnen worden."
                            },
                            {
                                "example_id": "9c219229-766d-4add-8a44-846de7ace8ff",
                                "sense_id": "4095a9b3-1d7f-399a-82ac-07957c0c6dce",
                                "text": "De Russen zijn de beste witwassers ter wereld en daarom is het belangrijk dat veiligheidsdiensten internationaal samenwerken, anders kunnen die miljarden met de snelheid van het licht in allerlei brievenbusfirma's verdwijnen."
                            }
                        ]
                    }
                ],
