                    {
                        "form_id": "360e2805-6ace-40f9-9804-793440dad298",
                        "entry_id": "63587bae-a1a5-3938-bd3e-2db15134c718",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nebensächlichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                        "entry_id": "63587bae-a1a5-3938-bd3e-2db15134c718",
                        "glosses": [
                            "etwas, das in den Augen des Betrachters nicht so wichtig ist wie vieles andere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72f2022f-808b-4544-8728-2a624009b7ea",
                                "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                                "text": "Nun lass uns mal nicht über die Nebensächlichkeiten reden. Mir geht es hier um die große Linie. Bis du bei diesem Geschäft dabei oder nicht?"
                            },
                            {
                                "example_id": "736ded06-8b7f-4ba0-ba85-a0e40db11c9d",
                                "sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                                "text": "„Es stimmte, dass ich auf Nebensächlichkeiten wie das Wetter kaum achtete, da andere Dinge meine ganze Aufmerksamkeit in Anspruch nahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f346905c-a8ae-4ea2-baac-c23d124b845c",
                        "source_entry_id": "63587bae-a1a5-3938-bd3e-2db15134c718",
                        "source_sense_id": "eaaa627a-94d0-3a3e-917e-98468c182ac9",
                        "source_sense_description": "etwas, das in den Augen des Betrachters nicht so wichtig ist wie vieles andere",
                        "target_lang_word": "détail",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détail",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                        "entry_id": "8a78a088-954e-3640-b610-047cb27b8a1e",
                                        "glosses": [
                                            "Chacune des parties qui concourent à la composition et à la formation d’un ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11d1fc70-5965-4968-ab3d-522b733fc46d",
                                                "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                                "text": "\"Il n’y a de vérité que dans les détails\" : c’est un froggie, Stendhal qu’il s’appelait, qui a dit ça…"
                                            },
                                            {
                                                "example_id": "6c8798c1-2454-4fa1-91f8-37091d52b461",
                                                "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                                "text": "Il doit tant pour les réparations dont voici le détail, dont le détail suit."
                                            },
                                            {
                                                "example_id": "1ef65db0-336b-4b1c-9718-fe439fcd81fc",
                                                "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                                "text": "Un détail estimatif."
                                            },
                                            {
                                                "example_id": "b4b9ff0a-8fb5-4069-9322-b66702f0f218",
                                                "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                                "text": "On dit de même"
                                            },
                                            {
                                                "example_id": "9cb9009e-19d6-41e5-83e6-adcc06a7469e",
                                                "sense_id": "4366e887-1d5f-3417-b520-088b2b7d6e1a",
                                                "text": "Les détails d’un compte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                        "entry_id": "8a78a088-954e-3640-b610-047cb27b8a1e",
                                        "glosses": [
                                            "Énumération des circonstances et des particularités d’un événement, d’une affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b6e05b-1b0d-4bbd-97ac-6dd41dfc02ff",
                                                "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                                "text": "Il a donné au public une relation de cette bataille, avec un détail exact de toutes les circonstances."
                                            },
                                            {
                                                "example_id": "31175656-cc9b-444d-b832-2cebd258a936",
                                                "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                                "text": "Il nous a fait un long détail de sa mésaventure."
                                            },
                                            {
                                                "example_id": "92cb531b-a7e4-4c58-8b01-73e8f864a458",
                                                "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                                "text": "Je vous raconterai l’affaire en gros, sans entrer dans le détail, sans descendre dans le détail."
                                            },
                                            {
                                                "example_id": "1ceed18c-2e1a-4adb-b141-bac940bf7f5e",
                                                "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                                "text": "Raconter une chose en détail."
                                            },
                                            {
                                                "example_id": "35046f28-b7d0-408b-87bf-d0eb223063e2",
                                                "sense_id": "b4224eaf-19f2-309a-bc3d-968fd67730d2",
                                                "text": "Il a l’esprit de détail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                        "entry_id": "8a78a088-954e-3640-b610-047cb27b8a1e",
                                        "glosses": [
                                            "Ces circonstances, ces particularités mêmes."
                                        ],
                                        "tags": [],
                                        "note": "S’emploie alors très souvent au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "3a9e8346-f787-4fc4-b754-93add30c4d2b",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Il importe donc fort peu de savoir ce que les mythes renferment de détails desti­nés à apparaître réellement sur le plan de l’histoire future […] il peut même arriver que rien de ce qu’ils renferment ne se produise […]"
                                            },
                                            {
                                                "example_id": "882eb1bb-75e1-4c25-af5a-a57c9ba68aa4",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "L’humus […] résulte de la transformation de la matière organique. C’est un produit composite, chimiquement mal défini, et les détails de sa formation sont encore imparfaitement connus."
                                            },
                                            {
                                                "example_id": "a534bb81-81e7-4506-b1a0-2de09c215caa",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Je passe quelques jours à Serbonnes, jusqu'au 15 août. Au retour j’apprends quelques détails rétrospectifs."
                                            },
                                            {
                                                "example_id": "fc71148f-ae02-4f0c-b3db-948e3adbf37f",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Il veut connaître le détail."
                                            },
                                            {
                                                "example_id": "44a9d197-0afd-4cb8-9874-a799d12097f5",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Descendre jusqu’aux moindres, aux plus petits, aux infimes détails."
                                            },
                                            {
                                                "example_id": "c2573511-398d-4374-940c-05cabb48b344",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Il se perd dans les détails."
                                            },
                                            {
                                                "example_id": "7df1c4d6-d506-41d2-9556-28ad16ec0962",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Bien des détails doivent lui échapper."
                                            },
                                            {
                                                "example_id": "e91e89c3-e4db-4ba4-b86e-35a7805ceeac",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Officier de détail : Celui qui est chargé de pourvoir à la solde et à l’habillement d’une partie d’un corps."
                                            },
                                            {
                                                "example_id": "8357f9b4-e038-412d-a89e-47704d193e90",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Revue de détail : Revue où l’inspecteur examine, d’après les registres et le matériel, l’administration des troupes."
                                            },
                                            {
                                                "example_id": "9a589279-29e8-45a3-b759-ad0184ce2752",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "Guerre de détail, Guerre de partisans et qui use l’ennemi par des petits combats."
                                            },
                                            {
                                                "example_id": "aad96d2e-962c-4c91-b2ef-e1f82a3163a8",
                                                "sense_id": "37124be8-2590-32ec-b645-c7e616f6a1d7",
                                                "text": "C’est un détail : Se dit d’une circonstance sur laquelle on passe légèrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                        "entry_id": "8a78a088-954e-3640-b610-047cb27b8a1e",
                                        "glosses": [
                                            "Partie particulièrement remarquable d’un ensemble."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd177d6-e471-4728-80e4-da8c11278679",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "La profusion de détails gracieux ne nuit en rien à l’ensemble qui conserve toute sa majesté."
                                            },
                                            {
                                                "example_id": "884836dd-8bea-4172-9ff5-6c64a4e09d9b",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "L’ensemble et les détails."
                                            },
                                            {
                                                "example_id": "d97e48ee-daf7-4fd6-980e-4c6cf5060341",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "Il ne faut point s’attacher à reproduire minutieusement chaque détail de son modèle."
                                            },
                                            {
                                                "example_id": "9c02f397-e519-4d24-8bba-6ac23400a493",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "Ce peintre, ce sculpteur ne soigne pas assez les détails."
                                            },
                                            {
                                                "example_id": "9b8df79e-0d2a-4d1c-9234-5d335d61ff1e",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "Cette œuvre imparfaite se relève par des beautés de détail."
                                            },
                                            {
                                                "example_id": "e2524e37-28ba-436b-8f4f-06bfda41cb6b",
                                                "sense_id": "0a05615a-c5c1-354b-a013-6345b6596514",
                                                "text": "Il y a quelques détails spirituels dans cette pièce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6ae693c-3ec2-3025-a93c-9148c321e027",
                                        "entry_id": "8a78a088-954e-3640-b610-047cb27b8a1e",
                                        "glosses": [
                                            "Désigne l’action de vendre des marchandises à plus petites mesures, à plus petits poids qu’on ne les a achetées ; de les couper, de les diviser pour en faire le débit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcc1d7c9-1fe4-46dd-8e5a-dd174b80cfe4",
                                                "sense_id": "b6ae693c-3ec2-3025-a93c-9148c321e027",
                                                "text": "En gros et en détail."
                                            },
                                            {
                                                "example_id": "68597477-8551-4756-a38c-a0a1f7a8a4fb",
                                                "sense_id": "b6ae693c-3ec2-3025-a93c-9148c321e027",
                                                "text": "Ce marchand en gros fait aussi le détail."
                                            },
