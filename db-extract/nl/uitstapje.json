                                        "entry_id": "66ec3897-f62f-3ec4-bdc0-c477fdf8564a",
                                        "glosses": [
                                            "The act of publicly revealing that a person is homosexual or transgender without that person's consent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
