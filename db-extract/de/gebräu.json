                "senses": [
                    {
                        "sense_id": "b6095e0d-dc93-327c-8a6e-be808339c4da",
                        "entry_id": "f3347023-fc2c-365b-8e21-461fdec957dd",
                        "glosses": [
                            "brewage"
                        ],
                        "tags": [
                            "derogatory",
                            "neuter",
                            "sometimes",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "6378b117-1de5-4e07-a4f8-1c6a7e1962d1",
                                "sense_id": "b6095e0d-dc93-327c-8a6e-be808339c4da",
                                "text": "Diese Leute haben kein sonderbares Gebräu getrunken oder Methamphetamin geraucht.",
                                "translation": "These people haven't drunk any strange brewage, nor have they smoked methamphetamine.",
                                "english": "These people haven't drunk any strange brewage, nor have they smoked methamphetamine."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed639c79-5695-3884-94aa-52432aa9fc80",
                        "entry_id": "f3347023-fc2c-365b-8e21-461fdec957dd",
                        "glosses": [
                            "beer"
                        ],
                        "tags": [
                            "especially",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "564c14e3-0ec8-4903-9c97-835490e8d517",
                                "sense_id": "ed639c79-5695-3884-94aa-52432aa9fc80",
                                "text": "»Es ist nicht gerade Hofbräu, Herr Permaneder, aber immerhin genießbarer, als unser einheimisches Gebräu.« Und der Konsul schenkte ihm von dem braun schäumenden Porter ein, den er selbst um diese Zeit zu trinken pflegte."
                            }
                        ]
                    },
                    {
                        "sense_id": "a293ec9f-f61e-3563-9b38-4bb1c4986c1b",
                        "entry_id": "f3347023-fc2c-365b-8e21-461fdec957dd",
                        "glosses": [
                            "hodgepodge, mixture"
                        ],
                        "tags": [
                            "figuratively",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "dc601583-ff74-4ed4-8286-2a597b2f84a0",
                                "sense_id": "a293ec9f-f61e-3563-9b38-4bb1c4986c1b",
                                "text": "Hinter dieser Bewegung steckt ein Gebräu aus radikalen AbtreibungsgegnerInnen, christlichen FundamentalistInnen und Rechten bis Rechtsex­tremen.",
                                "translation": "Behind this movement is a salmagundi of radical anti-abortionists, Christian fundamentalists and right ones to right-wing extremists.",
                                "english": "Behind this movement is a salmagundi of radical anti-abortionists, Christian fundamentalists and right ones to right-wing extremists."
                            }
                        ]
                    }
                ],
