                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "45004168-9303-3f90-95c4-970179e3f94f",
                        "entry_id": "55d4c4c0-79d8-3395-a0df-4be9748843a4",
                        "glosses": [
                            "À l’intérieur d’un lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a17e1c93-9e03-48a9-b362-c0f484585801",
                                "sense_id": "45004168-9303-3f90-95c4-970179e3f94f",
                                "text": "Tu l'a vue sortir ? Non, elle est encore au-dedans."
                            }
                        ]
                    },
                    {
                        "sense_id": "37d0da76-6b5d-3d7d-a491-11c6316dbee3",
                        "entry_id": "55d4c4c0-79d8-3395-a0df-4be9748843a4",
                        "glosses": [
                            "Au fond de soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99301758-101d-43c5-bab3-50241bdc766e",
                                "sense_id": "37d0da76-6b5d-3d7d-a491-11c6316dbee3",
                                "text": "Il paraît calme, mais au-dedans, il est bouleversé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d68b4ce5-a267-42ac-b1bc-4cc22a5a3ee6",
                        "source_entry_id": "55d4c4c0-79d8-3395-a0df-4be9748843a4",
                        "target_lang_word": "drinnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drinnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1251dc-346e-3350-8e67-7a29bfcfb41b",
                                        "entry_id": "91b4281e-5f24-3b17-9b4d-cf7f1c8edbbd",
                                        "glosses": [
                                            "innerhalb eines Raumes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3822f78-8705-49dc-bb83-246fe991d9e8",
                                                "sense_id": "5e1251dc-346e-3350-8e67-7a29bfcfb41b",
                                                "text": "Drinnen ist es warm und draußen schneit es."
                                            },
                                            {
                                                "example_id": "b32c102f-bf21-4ed6-aee9-3e33e6fed5e7",
                                                "sense_id": "5e1251dc-346e-3350-8e67-7a29bfcfb41b",
                                                "text": "„Drinnen würde die Mutter diesen Driss nicht dulden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0f4d724-8cd1-4946-866e-9ec5158ccb01",
                        "source_entry_id": "55d4c4c0-79d8-3395-a0df-4be9748843a4",
                        "target_lang_word": "inside",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64970111-6408-3c6c-be48-ebd391a3fa6e",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "The interior or inner part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a72a9da-3a59-48f6-9ddd-47fe3073f509",
                                                "sense_id": "64970111-6408-3c6c-be48-ebd391a3fa6e",
                                                "text": "The inside of the building has been extensively restored."
                                            },
                                            {
                                                "example_id": "a9b45754-8724-4d47-b1b2-4cb9979f3611",
                                                "sense_id": "64970111-6408-3c6c-be48-ebd391a3fa6e",
                                                "text": "Looked he o' the inside of the paper?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a49113ce-31ab-365d-baa7-648610266747",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "The left-hand side of a road if one drives on the left, or right-hand side if one drives on the right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5842e87-3a5a-4237-a369-9b00752db9ad",
                                                "sense_id": "a49113ce-31ab-365d-baa7-648610266747",
                                                "text": "On a motorway, you should never pass another vehicle on the inside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede3d587-dd87-3603-acf8-14e8c06e6ea4",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "The side of a curved road, racetrack etc. that has the shorter arc length; the side of a racetrack nearer the interior of the course or some other point of reference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b825f64-d45d-4c08-b065-bd0ef8eca10c",
                                                "sense_id": "ede3d587-dd87-3603-acf8-14e8c06e6ea4",
                                                "text": "The car in front drifted wide on the bend, so I darted up the inside to take the lead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6771cb6-d875-3409-87e2-a345e0110b26",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "The interior organs of the body, especially the guts."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6af111a-5b8c-4e73-b4ae-8bc28f4b4756",
                                                "sense_id": "e6771cb6-d875-3409-87e2-a345e0110b26",
                                                "text": "Eating that stuff will damage your insides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c00b57c9-33da-39cb-aae0-06d0215d3b5f",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "A passenger within a coach or carriage, as distinguished from one upon the outside."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aeb4c5-61c1-40a1-954a-897b256d6ca6",
                                                "sense_id": "c00b57c9-33da-39cb-aae0-06d0215d3b5f",
                                                "text": "So down thy hill, romantic Ashbourne, glides / The Derby dilly, carrying three insides."
                                            },
                                            {
                                                "example_id": "d9fb2fd9-3238-43e6-b73b-36c738c9287c",
                                                "sense_id": "c00b57c9-33da-39cb-aae0-06d0215d3b5f",
                                                "text": "So, what between Mr. Dowler's stories, and Mrs. Dowler's charms, and Mr. Pickwick's good humour, and Mr. Winkle's good listening, the insides contrived to be very companionable all the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dc67b92-d383-3208-aa6e-1f224eac5e48",
                                        "entry_id": "4be0849c-9c11-3de2-8aed-dd8318ec8913",
                                        "glosses": [
                                            "The inside scoop; information known only to certain involved people."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15a758a-0d99-4857-9920-5e78913a7106",
                                                "sense_id": "6dc67b92-d383-3208-aa6e-1f224eac5e48",
                                                "text": "Anyone got the inside on the new ratings? The book is out."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acd61a13-6cc5-3e7b-9908-47d4b26ff05d",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "Of or pertaining to the inner surface, limit or boundary."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db2add7-29d7-4610-ac9c-65f8a84c9d92",
                                                "sense_id": "acd61a13-6cc5-3e7b-9908-47d4b26ff05d",
                                                "text": "The inside surface of the cup is unpainted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69edbd46-64b6-3c08-b468-17f12423aa16",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "Nearer to the interior or centre of something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f38cd1-72c3-4cec-ad2c-f5e5749e2fed",
                                                "sense_id": "69edbd46-64b6-3c08-b468-17f12423aa16",
                                                "text": "Because of the tighter bend, it's harder to run in an inside lane."
                                            },
                                            {
                                                "example_id": "2b678a0a-8ee3-4802-8973-14cad5d0407e",
                                                "sense_id": "69edbd46-64b6-3c08-b468-17f12423aa16",
                                                "text": "All the window seats were occupied, so she took an inside seat."
                                            },
                                            {
                                                "example_id": "9bfadd66-5243-4b8b-9d69-2fce0b95c3dc",
                                                "sense_id": "69edbd46-64b6-3c08-b468-17f12423aa16",
                                                "text": "As the centripetal force is an inverse function of the radius of the curve, it follows that the runner in the outside lane will be less affected than the runner in the inside lane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c56f1b4-cf26-380f-8316-754c8b59c7b9",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "Originating from, arranged by, or being someone inside an organisation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eac08b9c-7e93-4895-843b-a05968de30b0",
                                                "sense_id": "4c56f1b4-cf26-380f-8316-754c8b59c7b9",
                                                "text": "The reporter had received inside information about the forthcoming takeover."
                                            },
                                            {
                                                "example_id": "b1b2d44a-cecb-486f-b521-f2b404937ca6",
                                                "sense_id": "4c56f1b4-cf26-380f-8316-754c8b59c7b9",
                                                "text": "The robbery was planned by the security guard: it was an inside job."
                                            },
                                            {
                                                "example_id": "1594dc15-da1f-4904-bb17-fc437bcb8afa",
                                                "sense_id": "4c56f1b4-cf26-380f-8316-754c8b59c7b9",
                                                "text": "They wanted to know the inside story behind the celebrity's fall from grace."
                                            },
                                            {
                                                "example_id": "0803c736-fc0c-4abb-abc9-1bd43d63db4d",
                                                "sense_id": "4c56f1b4-cf26-380f-8316-754c8b59c7b9",
                                                "text": "“They have an inside man at the base, so I didn't want to alert him. If their inside man called Mr. C about us locating the C-4, I doubt you and Gail would still be alive.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3aee6955-7690-32c2-b5f4-b0fd7ef8e992",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "Legally married to or related to (e.g. born in wedlock to), and/or residing with, a specified other person (parent, child, or partner); (of a marriage, relationship, etc) existing between two such people."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "787e6c84-93e1-47b1-baf9-091c112666d0",
                                                "sense_id": "3aee6955-7690-32c2-b5f4-b0fd7ef8e992",
                                                "text": "But the terms normally used to distinguish a man's resident and absent children are \"inside\" and \"outside,\" the reference being to the home where the common father dwells. Only rarely will a man describe his \"inside\" children born out of out of wedlock as \"lawful,\" [...]"
                                            },
                                            {
                                                "example_id": "fe44ab52-9498-43a3-98e9-738d90a7c815",
                                                "sense_id": "3aee6955-7690-32c2-b5f4-b0fd7ef8e992",
                                                "text": "An 'outside wife' has limited social recognition and status because her husband typically refuses to declare her publicly as his wife. She also has much less social and politico-jural recognition than an 'inside wife' [...]"
                                            },
                                            {
                                                "example_id": "cabb3265-5236-41fd-b8c5-ae2b632f0823",
                                                "sense_id": "3aee6955-7690-32c2-b5f4-b0fd7ef8e992",
                                                "text": "[The person] who was going to visit her with his wife had a physical resemblance to the abuser, so some of her inside children had a strong reaction of fear and revulsion to him. They were afraid to look at the face of the guest in case he was the abuser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339a0ad9-44e0-3dcf-bd30-8cea96f59b53",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "Toward the batter as it crosses home plate."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d2b46a-b4c2-4be5-bdec-42fc480a2deb",
                                                "sense_id": "339a0ad9-44e0-3dcf-bd30-8cea96f59b53",
                                                "text": "The first pitch is ... just a bit inside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39afaea3-efe5-38af-8695-a070176d2e15",
                                        "entry_id": "2a1cf97d-8ab7-323e-bcfb-b63dcf65cf40",
                                        "glosses": [
                                            "At or towards or the left-hand side of the road if one drives on the left, or right-hand side if one drives on the right."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97d9b24c-4edd-4919-afb2-6e9b8f217938",
                                                "sense_id": "39afaea3-efe5-38af-8695-a070176d2e15",
                                                "text": "the inside lane of the motorway"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23a4fd43-ea4b-3cdb-9ec7-b410a711de9b",
                                        "entry_id": "e2906daf-1a23-3335-a4bc-052b896a9d7e",
                                        "glosses": [
                                            "Within or towards the interior of something; within the scope or limits of something (a place), especially a building."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b859d75d-df02-4aa9-a76f-a624b101d850",
                                                "sense_id": "23a4fd43-ea4b-3cdb-9ec7-b410a711de9b",
                                                "text": "It started raining, so I went inside."
                                            },
                                            {
                                                "example_id": "da1b0f8d-1395-4bc4-886d-8978892673f7",
                                                "sense_id": "23a4fd43-ea4b-3cdb-9ec7-b410a711de9b",
                                                "text": "The secretive residents of the massive city-ship tended to stay inside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd86eb36-ec35-3cbe-a1f5-bf15626c65fb",
                                        "entry_id": "e2906daf-1a23-3335-a4bc-052b896a9d7e",
                                        "glosses": [
                                            "Within or towards the interior of something; within the scope or limits of something (a place), especially a building.",
                                            "In or to prison."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7b27963-7e36-4fa5-9476-457b1025cdaf",
                                                "sense_id": "bd86eb36-ec35-3cbe-a1f5-bf15626c65fb",
                                                "text": "He spent ten years inside, doing a stretch for burglary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb26730f-b548-3f3f-879e-8d93a0d50117",
                                        "entry_id": "e2906daf-1a23-3335-a4bc-052b896a9d7e",
                                        "glosses": [
                                            "Indoors."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fca2a45-0e2e-4793-b579-48780bf5c5df",
                                                "sense_id": "bb26730f-b548-3f3f-879e-8d93a0d50117",
                                                "text": "It was snowing, so the children stayed inside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5b3dd36-a017-33a4-a774-a33ba451477d",
                                        "entry_id": "e2906daf-1a23-3335-a4bc-052b896a9d7e",
                                        "glosses": [
                                            "Intimately, secretly; without expressing what one is feeling or thinking."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f929d20-10af-4c32-a924-b34f12fd2c15",
                                                "sense_id": "a5b3dd36-a017-33a4-a774-a33ba451477d",
                                                "text": "Are you laughing at us inside?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inside",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b668bcd-1e7d-3b43-89e7-27b801aacde8",
                                        "entry_id": "3e851b0b-6704-30c8-b2c5-915c61f6b925",
                                        "glosses": [
                                            "Within the interior of something, closest to the center or to a specific point of reference."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf0ca1aa-5f0d-4cd9-92c9-00c39276ce28",
                                                "sense_id": "5b668bcd-1e7d-3b43-89e7-27b801aacde8",
                                                "text": "He placed the letter inside the envelope."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "314dfe04-a8a3-3b6e-aee2-d853e350d769",
                                        "entry_id": "3e851b0b-6704-30c8-b2c5-915c61f6b925",
                                        "glosses": [
                                            "Within a period of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44538ed3-5ed3-4800-94f9-fec338003728",
                                                "sense_id": "314dfe04-a8a3-3b6e-aee2-d853e350d769",
                                                "text": "The job was finished inside two weeks."
                                            },
                                            {
                                                "example_id": "43a77242-e497-40be-97df-32720053b459",
                                                "sense_id": "314dfe04-a8a3-3b6e-aee2-d853e350d769",
                                                "text": "Then he commenced to talk, really talk, and inside of two flaps of a herring's fin he had me mesmerized, like Eben Holt's boy at the town hall show. He talked about the ills of humanity, and the glories of health and Nature and service and land knows what all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b62b2c2-96d4-4f91-b588-d097ecbce818",
                        "source_entry_id": "55d4c4c0-79d8-3395-a0df-4be9748843a4",
                        "target_lang_word": "within",
                        "target_lang_code": "en",
