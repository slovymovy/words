                        ],
                        "form": "коры́стях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "804b6337-911c-3eb2-8636-fd718eb3306b",
                        "entry_id": "def396fd-d042-3623-ba8a-41f494cc28ea",
                        "glosses": [
                            "жажда наживы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4057ce7f-bb85-4b95-87d4-335afdf1cab0",
                                "sense_id": "804b6337-911c-3eb2-8636-fd718eb3306b",
                                "text": "Алчность богатства, жадная корысть с каждым днем разрастаются в омраченной душе его…"
                            },
                            {
                                "example_id": "537daf32-532c-4be9-b738-a45de12b2c2c",
                                "sense_id": "804b6337-911c-3eb2-8636-fd718eb3306b",
                                "text": "Кроме этих страшных язв войны, этой грубой и явной несправедливости, Александра смущала та ужасная ложь и бесстыдная корысть, которыми обычно руководствовались политики всех рангов и всех национальностей."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e8d4dcf-8bde-3f83-b1fc-b811859d6716",
                        "entry_id": "def396fd-d042-3623-ba8a-41f494cc28ea",
                        "glosses": [
                            "устар. доход, прибыль, выгода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "723aa4a1-5d64-43fd-9439-829fe8492308",
                                "sense_id": "8e8d4dcf-8bde-3f83-b1fc-b811859d6716",
                                "text": "Корыстолюбцы во всех своих делах смотрят на корысть, и за то не принимаются, от чего не надеются себе прибытка получить."
                            },
                            {
                                "example_id": "a082d256-835f-4ae9-8931-47e1badfa2cb",
                                "sense_id": "8e8d4dcf-8bde-3f83-b1fc-b811859d6716",
                                "text": "Большой брат Липоксай и средний Арпоксай покушались один за другим взять себе в корысть оные золотые вещи, однако оба не могли получить для огня, круг них пылающего."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92cdb122-8fc9-47aa-a9f3-b08257e8e1ea",
                        "source_entry_id": "def396fd-d042-3623-ba8a-41f494cc28ea",
                        "target_lang_word": "self-interest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-interest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                        "entry_id": "0754b173-1534-391a-8780-0c907494bd4f",
                                        "glosses": [
                                            "One's personal interest or advantage, especially when pursued without regard for others."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a05622b-d627-4d8c-b5f1-56f31463789f",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "I cannot abandon my husband for the sake of self-interest and personal gain."
                                            },
                                            {
                                                "example_id": "9b15dd4a-9c94-4b86-bd6a-88774804d32d",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "And so he reasoned until the first generous impulse to proclaim the truth and relinquish his titles and his estates to their rightful owner was forgotten beneath the mass of sophistries which self-interest had advanced."
                                            },
                                            {
                                                "example_id": "4f1b27c1-b536-4a0b-baa9-fb4fdcd90214",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Corruption becomes fatal when those in power are no longer able to distinguish the difference between self-interest and the national interest."
                                            },
                                            {
                                                "example_id": "2a50f168-1741-4273-b227-5cff7ea39279",
                                                "sense_id": "7e56abb1-70b9-3f3f-b977-9a506b23a8be",
                                                "text": "Government standards of decency and honesty were quite low, and decision-makers were tainted with self-interest and corruption at the very highest level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d593c5b-c28b-44b6-8ff5-088fc6e00b13",
                        "source_entry_id": "def396fd-d042-3623-ba8a-41f494cc28ea",
                        "target_lang_word": "greed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                        "entry_id": "55171cf4-41ee-31f1-9eaa-90671c1faec9",
                                        "glosses": [
                                            "A selfish or excessive desire for more than is needed or deserved, especially of money, wealth, food, or other possessions."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9830e570-5c1d-4e67-a317-8fd1cee96526",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "His greed was his undoing."
                                            },
                                            {
                                                "example_id": "9998a4c5-5551-4fed-990c-e7cd09736564",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "[…]But when I had bestridden the plank, quoth I to myself, \"Thou deserveth all that betideth thee. All this is decreed to me of Allah (whose name be exalted!), to turn me from my greed of gain, whence ariseth all that I endure, for I have wealth galore.\""
                                            },
                                            {
                                                "example_id": "090ab8ff-1782-428a-8903-372d23ae4873",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "Your market gardener is not a well-breeched man, dependant as he is on the imponderables of glut, the inequities of distribution, and the greeds of wholesaler and retailer."
                                            },
                                            {
                                                "example_id": "da05c7f1-cd52-47e9-95d3-7e40241c412f",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "She does not display voracities and greeds like a number of patients […] nor has she shown any significant tendency to possessiveness, grievance, paranoia, or mania."
                                            },
                                            {
                                                "example_id": "e472d04f-fceb-4cd9-8cc5-a17da0d738e1",
                                                "sense_id": "8bff3a12-6956-38c5-9db7-39123cafa205",
                                                "text": "The point is, ladies and gentleman, that greed, for lack of a better word, is good. Greed is right, greed works. Greed clarifies, cuts through, and captures the essence of the evolutionary spirit. Greed, in all of its forms; greed for life, for money, for love, knowledge has marked the upward surge of mankind."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "greed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                        "entry_id": "0cc97faf-bca1-385b-82df-ecd5dd0fbb81",
                                        "glosses": [
                                            "To desire in a greedy manner, or to act on such a desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8670af7-9cad-404b-8633-d597266d1af5",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "The ravens sit greeding, / And watching, and heeding: / Thoro' wind, over water, / Comes scent of the slaughter, / And ravens sit greeding / Their share of the bones."
                                            },
                                            {
                                                "example_id": "b0808650-caae-47d5-bdb8-af9168706414",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "Hearing these words he arose, because indeed he greeded for her, and came up behind her as she rested upon her elbows and knees and bending in hand his prickle nailed it into her coynte and did manly devoir."
                                            },
                                            {
                                                "example_id": "de2fb649-fa3f-42e7-8e14-1be5d6d1a96a",
                                                "sense_id": "ec41933d-5820-3913-b821-23406d83c31e",
                                                "text": "This conniving bastard has greeded the farm off an old man and I end up with nothing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
