                "senses": [
                    {
                        "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                        "entry_id": "947df732-743f-3c06-8a59-9acc6e3692ce",
                        "glosses": [
                            "wellenförmig fortschreitende Kontraktion von Hohlorganen, um Inhalte weiter zu transportieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3a0ead3-b299-4997-afa5-b9faa8cb6890",
                                "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                                "text": "Mittels Peristaltik wird der Inhalt von Darm, Gefäßen, Harn-, Ei- und Samenleiter vorwärts bewegt."
                            },
                            {
                                "example_id": "f54f97a6-8ff0-4d0d-8bd8-7f6febc99ff6",
                                "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                                "text": "Wie schon erwähnt, findet man die Peristaltik in der Physiologie insbesondere in Speiseröhre, Harnleiter, Samenleiter, Eileiter und Dünndarm."
                            },
                            {
                                "example_id": "c8e2601a-6515-4ce3-bfed-e7ab27d99930",
                                "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                                "text": "Man weiß aber auch, dass die Peristaltik lebenswichtig ist und dass zahlreiche Erkrankungen mit einer gestörten Peristaltik einhergehen."
                            },
                            {
                                "example_id": "cb9cd4e9-b698-4493-94a7-c82716088190",
                                "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                                "text": "Die ständige, durch die Peristaltik hervorgerufene Bewegung, formt die Zusammensetzung des Mikrobioms im Darm auf positive Weise."
                            },
                            {
                                "example_id": "f2b0f969-8e07-415c-b383-1c2a011483d1",
                                "sense_id": "37f7f45c-21b4-38ef-aa66-aa204f128380",
                                "text": "Die durch einen Schluckakt induzierte primäre Peristaltik beginnt im Oropharynx, läuft peristaltisch über den ganzen Ösophagus und endet mit einer Erschlaffung und damit Öffnung des unteren Ösophagussphinkters (…)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
