{
    "word_family": [
        "gefladder",
        "fladderaar",
        "fladdermuis"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee77a50c-edf1-37c8-9903-5af8c4c8e22d",
                    "sense_definition": "Met snelle, onregelmatige bewegingen van de vleugels vliegen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vliegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vlinder bleef vrolijk rond de bloemen <w>fladderen</w> in de zon.",
                            "target_lang_translations": {
                                "en": "The butterfly continued to <w>flutter</w> happily around the flowers in the sun."
                            }
                        },
                        {
                            "text": "Ik zag een klein vogeltje onrustig door de tuin <w>fladderen</w>.",
                            "target_lang_translations": {
                                "en": "I saw a small bird <w>fluttering</w> restlessly through the garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "wieken",
                        "flapperen"
                    ],
                    "common_phrases": [
                        "rond de bloemen fladderen",
                        "onrustig fladderen"
                    ],
                    "target_lang_definitions": {
                        "en": "To fly with quick, irregular movements of the wings."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flutter",
                                "target_lang_sense_clarification": "of a bird or insect"
                            },
                            {
                                "target_lang_word": "flap",
                                "target_lang_sense_clarification": "moving wings up and down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "230724a0-81e9-3c0c-ad02-dca6e381f628",
                    "sense_definition": "Zich op een onhandige manier met veel vleugelgeklap ergens heen begeven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vliegen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jonge vogel was naar het water <w>gefladderd</w> en er bijna ingevallen.",
                            "target_lang_translations": {
                                "en": "The young bird had <w>fluttered</w> toward the water and almost fell in."
                            }
                        },
                        {
                            "text": "De kip probeerde over het hek te <w>fladderen</w> om te ontsnappen.",
                            "target_lang_translations": {
                                "en": "The chicken tried to <w>flap</w> over the fence to escape."
                            }
                        }
                    ],
                    "common_phrases": [
                        "naar beneden fladderen",
                        "over het hek fladderen"
                    ],
                    "target_lang_definitions": {
                        "en": "To move somewhere in a clumsy manner with a lot of wing flapping."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flutter",
                                "target_lang_sense_clarification": "moving clumsily with wings"
                            },
                            {
                                "target_lang_word": "flap",
                                "target_lang_sense_clarification": "struggling to fly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad128560-ecfb-3e46-a35a-c1932262e351",
                    "sense_definition": "Zich met groot gemak, lichtheid of onbezorgdheid voortbewegen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hopelijk zou ik me de volgende ochtend een stuk beter voelen en als een vlinder de berg over <w>fladderen</w>.",
                            "target_lang_translations": {
                                "en": "Hopefully I would feel a lot better the next morning and <w>flutter</w> over the mountain like a butterfly."
                            }
                        },
                        {
                            "text": "Zij kan de hele avond van het ene gesprek naar het andere <w>fladderen</w>.",
                            "target_lang_translations": {
                                "en": "She can <w>flit</w> from one conversation to another all evening."
                            }
                        }
                    ],
                    "common_phrases": [
                        "door het leven fladderen",
                        "over de berg fladderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak figuurlijk gebruikt voor sociale of lichte beweging."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To move about with great ease, lightness, or carefreeness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flutter",
                                "target_lang_sense_clarification": "moving lightly or socially"
                            },
                            {
                                "target_lang_word": "flit",
                                "target_lang_sense_clarification": "moving quickly and lightly from place to place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b58ae9f3-1234-3d01-836c-f71554ca375c",
                    "sense_definition": "Een vorm van hartritmestoornis waarbij de boezems of kamers zich zeer snel en ritmisch samentrekken.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De cardioloog stelde vast dat de patiënt last had van boezem <w>fladderen</w>.",
                            "target_lang_translations": {
                                "en": "The cardiologist determined that the patient was suffering from atrial <w>flutter</w>."
                            }
                        },
                        {
                            "text": "Bij deze aandoening begint het hart ongecontroleerd te <w>fladderen</w>.",
                            "target_lang_translations": {
                                "en": "With this condition, the heart begins to <w>flutter</w> uncontrollably."
                            }
                        }
                    ],
                    "synonyms": [
                        "flutteren"
                    ],
                    "common_phrases": [
                        "boezem fladderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Medische vakterm."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A type of heart rhythm disorder where the atria or ventricles contract very quickly and rhythmically."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flutter",
                                "target_lang_sense_clarification": "medical term for rapid heart pulsation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}