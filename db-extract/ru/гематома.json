                    {
                        "translation_id": "8edc54fd-98fc-4738-9b79-ce40d90187fb",
                        "source_entry_id": "fad8e7e3-1e68-38bd-a0f7-0fe0f92891f9",
                        "source_sense_id": "45b2c166-0b81-397a-ba19-21322e5800ce",
                        "target_lang_word": "hématome",
