                                        "examples": [
                                            {
                                                "example_id": "15c765b2-fc59-4d7e-b5f1-aa05c210abf1",
                                                "sense_id": "e9fe8f2f-7335-38d8-abd0-e2ae3d4dc7b8",
                                                "text": "the famous Marian diviner, Asqudum"
                                            }
