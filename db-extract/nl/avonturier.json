                "senses": [
                    {
                        "sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                        "entry_id": "63acaeaf-3a9a-31dc-a24f-c0b0e8f11847",
                        "glosses": [
                            "iemand die graag het avontuur opzoekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ef6f11-7bff-4451-b2d4-64bfaf341339",
                                "sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                                "text": "Hij was een onstuitbare avonturier, jammer dat hij verongelukt is."
                            },
                            {
                                "example_id": "afe2836b-adce-4ae9-9863-6f82b58dab5b",
                                "sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                                "text": "De CDT, de Continental Divide Trail, is pas een paar jaar oud en bekend om haar isolated untouched nature en is alleen weggelegd voor de moedige avonturier."
                            },
                            {
                                "example_id": "0800494f-672f-4540-9042-197b4ed69fb2",
                                "sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                                "text": "Aangezien wij geen avonturiers waren en de risico’s daarom zo veel mogelijk uit wilden sluiten, boekten wij op de conservatieve manier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4c5dd55-064b-476c-a190-34521259cebd",
                        "source_entry_id": "63acaeaf-3a9a-31dc-a24f-c0b0e8f11847",
                        "source_sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                        "source_sense_description": "iemand die graag het avontuur opzoekt",
                        "target_lang_word": "Abenteurer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteurer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                        "entry_id": "5603c5a8-a338-3515-a95f-7419a9a3e5c6",
                                        "glosses": [
                                            "Person, die gefährliche Herausforderungen sucht/erlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76a8aac-4a99-4164-9682-62c224fdb265",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Skrupellose Abenteurer und Geschäftemacher ringen um die Ressourcen des Staates.“"
                                            },
                                            {
                                                "example_id": "db5f7b3f-310c-4c96-826e-6f0c6016bedf",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Er ging nach Lissabon, wo zahlreiche Genuesen lebten, denn diese Hauptstadt war damals die Weltbörse für Seefahrer und Abenteurer.“"
                                            },
                                            {
                                                "example_id": "1be208db-2da3-472b-af18-0ecb22e8e7f9",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Als müsste man mehr als nur Grenzgänger sein, nämlich auch Glücksritter und Idealist, Falschmünzer und Abenteurer.“<"
                                            },
                                            {
                                                "example_id": "c7ebe3c3-6e2e-42af-95f9-61ee8210c460",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Für Schweitzer bedeutet es, ein geistiger Abenteurer zu sein, wie die Welt sie nötig hat, wenn man die Fähigkeit entwickelt, sein Vorhaben nicht als etwas Außergewöhnliches, sondern als etwas Selbstverständliches zu begreifen, bei dem man nur seine Pflicht erfüllt.\""
                                            },
                                            {
                                                "example_id": "407a6f3f-6dfb-43ea-b14e-42e4dd49a073",
                                                "sense_id": "d5dcd6fe-2a8d-356b-8cdd-05986cbc7e4c",
                                                "text": "„Mit Bergen kennt sich der 51jährige Abenteurer und Extremkletterer aus wie kein Zweiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5e3d46a-77c5-4cfd-8f03-2faff452ee0b",
                        "source_entry_id": "63acaeaf-3a9a-31dc-a24f-c0b0e8f11847",
                        "source_sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                        "source_sense_description": "iemand die graag het avontuur opzoekt",
                        "target_lang_word": "adventurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adventurer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "One who enjoys adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb94115f-988e-4eee-9483-709d5adce082",
                                                "sense_id": "e74caca8-4300-3c01-a89c-70964d9c49c0",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43aaed4b-b0cc-3c0d-bdfc-f36b3cb09704",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who seeks a fortune in new and possibly dangerous enterprises."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "75d462da-e20f-3bb9-b757-07cdd0fffd44",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A soldier of fortune, a speculator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3967e50b-1d81-34f4-a883-a479f6163ae0",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A person who tries to advance their social position by somewhat devious means."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                        "entry_id": "1d3f22c5-4696-3a87-a375-08c2ca87a87e",
                                        "glosses": [
                                            "A player of adventure games or text adventures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86e2d7a7-7001-400c-806d-dfec1639d647",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "Meanwhile, the ranks of adventurers grow, be they manic puzzle-solvers or people like me, who like to look under the Robners' beds just for the hell of it."
                                            },
                                            {
                                                "example_id": "207b0c72-6830-4f0c-9d9a-70bcaef66c9a",
                                                "sense_id": "c18de493-155f-3430-b08d-337830a9a11d",
                                                "text": "It's a challenging game for the inexperienced adventurer, and should even give the hardened pros a bit of a run for their money."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8864b813-415a-4301-bf2d-4f610484e30a",
                        "source_entry_id": "63acaeaf-3a9a-31dc-a24f-c0b0e8f11847",
                        "source_sense_id": "d035f478-7feb-3be6-b79d-1faf0a546bc0",
                        "source_sense_description": "iemand die graag het avontuur opzoekt",
                        "target_lang_word": "aventurier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aventurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e211dd8-b568-3a2a-b9ac-da1933378038",
                                        "entry_id": "67d26e7c-92c4-3d34-aea3-1a396f3a2877",
                                        "glosses": [
                                            "Celui qui aime les aventures extraordinaires, qui court le monde et s’engage volontiers dans les entreprises hasardeuses où il peut espérer quelque avantage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6aca5d02-3533-4e5d-a652-e9658502c3f3",
                                                "sense_id": "1e211dd8-b568-3a2a-b9ac-da1933378038",
                                                "text": "Plus d’un aventurier hardi se présenta, qui voulait partager la gloire et les dangers de sa tentative ; mais il refusa sans donner de raisons de son refus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e515e9da-7f86-39ca-82d9-c8a236d8c1da",
                                        "entry_id": "67d26e7c-92c4-3d34-aea3-1a396f3a2877",
                                        "glosses": [
                                            "Celui qui allait volontairement à la guerre, sans recevoir de solde et sans s’obliger aux gardes et aux autres fonctions militaires qui ne donnent que de la fatigue."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b75ffa29-ed1b-4b44-a1e4-affe8a3e5633",
                                                "sense_id": "e515e9da-7f86-39ca-82d9-c8a236d8c1da",
                                                "text": "Mais tu étais cadet, et sous l’ancien droit, le patrimoine dont tu as eu la moitié appartenait entièrement à ton frère aîné. […]. Si la Constituante n’avait passé un trait de plume sur cet article de la loi, tu serais à l’heure qu’il est de toute nécessité chevalier d’industrie, barnabote, aventurier, abbé, bretteur, coureur de ruelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98637edf-c132-32eb-add7-382f51c1005c",
                                        "entry_id": "67d26e7c-92c4-3d34-aea3-1a396f3a2877",
                                        "glosses": [
                                            "Corsaire qui piratait sur les mers de l’Amérique et qu’on appelait autrement flibustiers et boucaniers."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04c7b2ce-6c69-3a19-bc5d-8df25c9776b4",
                                        "entry_id": "67d26e7c-92c4-3d34-aea3-1a396f3a2877",
                                        "glosses": [
                                            "Celui qui est sans état et sans fortune et qui vit d’expédients."
                                        ],
                                        "tags": [
                                            "Plus courant"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffee7fab-3f92-4847-9cbd-596105a4558d",
                                                "sense_id": "04c7b2ce-6c69-3a19-bc5d-8df25c9776b4",
                                                "text": "Cette dépravée, cette aventurière qui vient nous narguer et a le toupet de nous donner des leçons !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aventurier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "283f5ff3-f5fa-37c4-8a6a-3cb194c1413d",
                                        "entry_id": "384f3b00-c499-3ce6-a5e1-30534bf8c168",
                                        "glosses": [
                                            "Aventureux, qui a le goût de l’aventure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14d8582b-2679-4529-9ec8-5fed5b22ba7a",
                                                "sense_id": "283f5ff3-f5fa-37c4-8a6a-3cb194c1413d",
                                                "text": "C’est une femme aventurière."
                                            },
                                            {
                                                "example_id": "21cda42d-9b10-481e-812d-e9cd42baaf40",
                                                "sense_id": "283f5ff3-f5fa-37c4-8a6a-3cb194c1413d",
                                                "text": "Il y a des hommes hardis et aventuriers qui…."
                                            },
                                            {
                                                "example_id": "38b79b58-7cf3-4fdf-bdf7-27c80347b9b1",
                                                "sense_id": "283f5ff3-f5fa-37c4-8a6a-3cb194c1413d",
                                                "text": "Vie aventurière."
                                            },
                                            {
                                                "example_id": "a28491b6-6805-43ce-90f6-2de59d70d475",
                                                "sense_id": "283f5ff3-f5fa-37c4-8a6a-3cb194c1413d",
                                                "text": "Parfois un passant, mû par une aventurière curiosité, poussait la porte de cette ineffable Pochette Surprise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
