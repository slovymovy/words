{
    "word_family": [
        "sculpt",
        "sculptor",
        "sculptural"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7d0157d0-79c8-396b-8ff4-7748edc38d05",
                    "sense_definition": "A three-dimensional work of art created by shaping stone, wood, metal, clay, or other materials.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "artistic_sculpture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displays a famous marble <w>sculpture</w> in the main hall.",
                            "target_lang_translations": {
                                "ru": "В главном зале музея выставлена знаменитая мраморная <w>скульптура</w>.",
                                "zh": "博物馆大厅里陈列着一件著名的大理石<w>雕塑</w>。",
                                "es": "El museo exhibe una famosa <w>escultura</w> de mármol en el vestíbulo principal."
                            }
                        },
                        {
                            "text": "She created a beautiful ice <w>sculpture</w> for the winter festival.",
                            "target_lang_translations": {
                                "ru": "Она создала красивую ледяную <w>скульптуру</w> для зимнего фестиваля.",
                                "zh": "她为冬季艺术节创作了一件精美的冰<w>雕</w>。",
                                "es": "Ella creó una hermosa <w>escultura</w> de hielo para el festival de invierno."
                            }
                        }
                    ],
                    "synonyms": [
                        "statue",
                        "figure",
                        "carving"
                    ],
                    "common_phrases": [
                        "bronze sculpture",
                        "ice sculpture",
                        "stone sculpture",
                        "modern sculpture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трехмерное художественное произведение, созданное из камня, дерева, металла, глины или других материалов.",
                        "zh": "一种通过塑造石头、木头、金属、粘土或其他材料而创作的三维艺术品。",
                        "es": "Obra de arte tridimensional creada mediante el modelado o tallado de piedra, madera, metal, arcilla u otros materiales."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптура",
                                "target_lang_sense_clarification": "произведение искусства"
                            },
                            {
                                "target_lang_word": "статуя",
                                "target_lang_sense_clarification": "фигура человека или животного"
                            },
                            {
                                "target_lang_word": "изваяние",
                                "target_lang_sense_clarification": "поэтическое или устаревшее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雕塑",
                                "target_lang_sense_clarification": "艺术作品"
                            },
                            {
                                "target_lang_word": "雕像",
                                "target_lang_sense_clarification": "人物或动物形象"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "escultura",
                                "target_lang_sense_clarification": "obra de arte tridimensional"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a104c5a-1f5d-3b93-95d9-5c6d8d06db3a",
                    "sense_definition": "The art or practice of creating three-dimensional figures; works of this type considered as a group.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "artistic_sculpture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to study <w>sculpture</w> at the art academy.",
                            "target_lang_translations": {
                                "ru": "Он решил изучать <w>скульптуру</w> в художественной академии.",
                                "zh": "他决定去艺术学院学习<w>雕塑</w>。",
                                "es": "Él decidió estudiar <w>escultura</w> en la academia de arte."
                            }
                        },
                        {
                            "text": "Greek <w>sculpture</w> is renowned for its realistic depiction of the human body.",
                            "target_lang_translations": {
                                "ru": "Греческая <w>скульптура</w> славится реалистичным изображением человеческого тела.",
                                "zh": "希腊<w>雕塑</w>以其对人体逼真的刻画而闻名。",
                                "es": "La <w>escultura</w> griega es famosa por su representación realista del cuerpo humano."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpting",
                        "modeling"
                    ],
                    "common_phrases": [
                        "classical sculpture",
                        "study sculpture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство создания объемных фигур; совокупность таких произведений.",
                        "zh": "创作三维形象的艺术或实践；作为整体的此类作品。",
                        "es": "El arte o la práctica de crear figuras tridimensionales; el conjunto de obras de este tipo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптура",
                                "target_lang_sense_clarification": "вид искусства"
                            },
                            {
                                "target_lang_word": "ваяние",
                                "target_lang_sense_clarification": "высокий стиль"
                            },
                            {
                                "target_lang_word": "лепка",
                                "target_lang_sense_clarification": "создание формы из мягких материалов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雕塑",
                                "target_lang_sense_clarification": "艺术门类"
                            },
                            {
                                "target_lang_word": "雕刻",
                                "target_lang_sense_clarification": "创作手法"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "escultura",
                                "target_lang_sense_clarification": "disciplina artística"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c02be4d5-9723-3399-9fb2-dff98932adb2",
                    "sense_definition": "The raised patterns, ridges, or texture on the outer surface of a shell.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The biologist examined the delicate spiral <w>sculpture</w> on the snail's shell.",
                            "target_lang_translations": {
                                "ru": "Биолог изучил тонкую спиральную <w>скульптуру</w> на раковине улитки.",
                                "zh": "生物学家观察了蜗牛壳上精细的螺旋状<w>纹饰</w>。",
                                "es": "El biólogo examinó el delicado <w>relieve</w> espiral en la concha del caracol."
                            }
                        },
                        {
                            "text": "This species is identified by the rough <w>sculpture</w> covering its casing.",
                            "target_lang_translations": {
                                "ru": "Этот вид опознается по грубой <w>скульптуре</w>, покрывающей его оболочку.",
                                "zh": "该物种可以通过其外壳上覆盖的粗糙<w>纹饰</w>来识别。",
                                "es": "Esta especie se identifica por el <w>relieve</w> rugoso que cubre su caparazón."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рельефный узор или текстура на поверхности раковины моллюска.",
                        "zh": "贝壳外表面上的凸起图案、脊线或纹理。",
                        "es": "Patrones, crestas o textura en relieve sobre la superficie exterior de una concha."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "скульптура",
                                "target_lang_sense_clarification": "биологический термин"
                            },
                            {
                                "target_lang_word": "рельеф",
                                "target_lang_sense_clarification": "текстура поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纹饰",
                                "target_lang_sense_clarification": "生物学上的表面纹理"
                            },
                            {
                                "target_lang_word": "浮雕",
                                "target_lang_sense_clarification": "表面凸起结构"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "textura o patrón superficial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ee86eb0-6d3d-3be6-b6cf-e4b388452dae",
                    "sense_definition": "A printed picture, such as an engraving.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The antique book contained a fine <w>sculpture</w> of the king.",
                            "target_lang_translations": {
                                "ru": "В старинной книге была прекрасная <w>гравюра</w> с изображением короля.",
                                "zh": "这本古籍里有一幅精美的国王<w>版画</w>。",
                                "es": "El libro antiguo contenía un fino <w>grabado</w> del rey."
                            }
                        },
                        {
                            "text": "He collected old manuscripts adorned with detailed <w>sculptures</w>.",
                            "target_lang_translations": {
                                "ru": "Он коллекционировал старинные рукописи, украшенные детальными <w>гравюрами</w>.",
                                "zh": "他收藏了一些装饰有精细<w>版画</w>的古老手稿。",
                                "es": "Él coleccionaba manuscritos antiguos adornados con <w>grabados</w> detallados."
                            }
                        }
                    ],
                    "synonyms": [
                        "engraving",
                        "print"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напечатанное изображение, например, гравюра (устаревшее значение).",
                        "zh": "一种印刷图片，例如版画（古语）。",
                        "es": "Una imagen impresa, como un grabado (uso arcaico)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гравюра",
                                "target_lang_sense_clarification": "оттиск"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "版画",
                                "target_lang_sense_clarification": "印刷图像"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "grabado",
                                "target_lang_sense_clarification": "imagen impresa o estampada"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8bd0a067-94e3-3c99-842b-843c6b73b156",
                    "sense_definition": "To form or shape material into a three-dimensional figure or work of art.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>sculptured</w> a magnificent horse from the block of clay.",
                            "target_lang_translations": {
                                "ru": "Художник <w>вылепил</w> великолепную лошадь из куска глины.",
                                "zh": "艺术家用那块粘土<w>塑造</w>了一匹壮丽的马。",
                                "es": "El artista <w>esculpió</w> un magnífico caballo a partir del bloque de arcilla."
                            }
                        },
                        {
                            "text": "She carefully <w>sculptured</w> the features of the face using a small tool.",
                            "target_lang_translations": {
                                "ru": "Она тщательно <w>вылепила</w> черты лица с помощью маленького инструмента.",
                                "zh": "她用小工具小心地<w>雕刻</w>出面部的特征。",
                                "es": "Ella <w>esculpió</w> cuidadosamente los rasgos del rostro usando una pequeña herramienta."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculpt",
                        "carve",
                        "fashion",
                        "model"
                    ],
                    "common_phrases": [
                        "sculpture a bust",
                        "sculpture in stone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать объемную фигуру или произведение искусства из какого-либо материала.",
                        "zh": "将材料塑造成三维形象或艺术品。",
                        "es": "Dar forma a un material para convertirlo en una figura tridimensional o una obra de arte."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ваять",
                                "target_lang_sense_clarification": "создавать скульптуру"
                            },
                            {
                                "target_lang_word": "лепить",
                                "target_lang_sense_clarification": "из глины или воска"
                            },
                            {
                                "target_lang_word": "высекать",
                                "target_lang_sense_clarification": "из камня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雕刻",
                                "target_lang_sense_clarification": "从硬质材料中塑造"
                            },
                            {
                                "target_lang_word": "塑造",
                                "target_lang_sense_clarification": "从软质材料中塑造"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "esculpir",
                                "target_lang_sense_clarification": "dar forma artística"
                            },
                            {
                                "target_lang_word": "modelar",
                                "target_lang_sense_clarification": "dar forma con materiales blandos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cd0b2c4-1990-3ca6-8c93-f905615692b1",
                    "sense_definition": "To change the shape of a land feature or rock formation through natural processes like erosion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_shaping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river has <w>sculptured</w> the canyon walls over thousands of years.",
                            "target_lang_translations": {
                                "ru": "Река <w>выточила</w> стены каньона за тысячи лет.",
                                "zh": "数千年来，河流不断<w>雕琢</w>着峡谷的岩壁。",
                                "es": "El río ha <w>esculpido</w> las paredes del cañón a lo largo de miles de años."
                            }
                        },
                        {
                            "text": "Strong winds <w>sculptured</w> the sand dunes into waving patterns.",
                            "target_lang_translations": {
                                "ru": "Сильные ветры <w>сформировали</w> из песчаных дюн волнистые узоры.",
                                "zh": "强风将沙丘<w>塑造成</w>波浪状的图案。",
                                "es": "Los fuertes vientos <w>esculpieron</w> las dunas de arena en patrones ondulados."
                            }
                        }
                    ],
                    "synonyms": [
                        "erode",
                        "shape"
                    ],
                    "common_phrases": [
                        "sculptured by wind",
                        "sculptured by water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять форму ландшафта или скал под воздействием природных сил (ветра, воды).",
                        "zh": "通过侵蚀等自然过程改变地貌或岩层的形状。",
                        "es": "Cambiar la forma de un accidente geográfico o formación rocosa mediante procesos naturales como la erosión."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтачивать",
                                "target_lang_sense_clarification": "воздействием воды или ветра"
                            },
                            {
                                "target_lang_word": "формировать",
                                "target_lang_sense_clarification": "придавать форму"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侵蚀",
                                "target_lang_sense_clarification": "自然力作用"
                            },
                            {
                                "target_lang_word": "雕琢",
                                "target_lang_sense_clarification": "自然力塑造地貌"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "modelar",
                                "target_lang_sense_clarification": "dar forma por procesos naturales"
                            },
                            {
                                "target_lang_word": "esculpir",
                                "target_lang_sense_clarification": "dar forma por erosión"
                            }
                        ]
                    }
                }
            ]
        }
