                ],
                "senses": [
                    {
                        "sense_id": "b7b48d7e-cbf7-3bcb-9f78-a8a70773f06f",
                        "entry_id": "91af4d83-c9c6-32b6-b92c-110281236a0c",
                        "glosses": [
                            "taraban (percussive drum-like folk instrument of Turkish origin, which was once used in Ukraine and, to a lesser extent, in Poland)"
                        ],
                        "tags": [
                            "historical",
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "51b1739c-e592-42e2-9897-004754917e1d",
                                "sense_id": "b7b48d7e-cbf7-3bcb-9f78-a8a70773f06f",
                                "text": "Już tam ojciec do swej Basi\nMówi zapłakany\n— Słuchaj jeno, pono nasi\nBiją w tarabany",
                                "translation": "A father, to his Basia,\nsays, all in tears,\n“Listen, they are saying ours\nare strucking the tarabans”",
                                "english": "A father, to his Basia,\nsays, all in tears,\n“Listen, they are saying ours\nare strucking the tarabans”"
                            }
                        ]
                    },
                    {
                        "sense_id": "0840ef93-a84b-3bfd-8847-09fa52ae0c05",
                        "entry_id": "91af4d83-c9c6-32b6-b92c-110281236a0c",
                        "glosses": [
                            "synonym of szaraban"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "a6bab637-6fc4-438a-9485-704f32d672c0",
                                "sense_id": "0840ef93-a84b-3bfd-8847-09fa52ae0c05",
                                "text": "Cztery konie w tarabanie,\nSame wrone.",
                                "translation": "Four horses in a charabancs,\nAll crows.",
                                "english": "Four horses in a charabancs,\nAll crows."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ad16391-79a2-3c7f-8bbb-09126b1e6240",
                        "entry_id": "91af4d83-c9c6-32b6-b92c-110281236a0c",
                        "glosses": [
                            "synonym of bęben"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "73468159-62c6-4e92-b284-f69dbaaf7058",
                                "sense_id": "6ad16391-79a2-3c7f-8bbb-09126b1e6240",
                                "text": "Biją mi w taraban.",
                                "translation": "They are beating my drum.",
                                "english": "They are beating my drum."
                            }
                        ]
                    }
                ],
