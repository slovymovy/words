                    {
                        "translation_id": "999d159f-ece7-49d5-8f18-bf041fa4ac7f",
                        "source_entry_id": "e0462d76-56ea-37b4-9ca4-6baf11345b13",
                        "source_sense_id": "08fc19a7-ec02-3db6-bb19-a0110340ec8d",
