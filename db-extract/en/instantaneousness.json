                                    {
                                        "sense_id": "b106b271-aa6f-3fce-bfc3-be6ece9d2be8",
                                        "entry_id": "be94c55a-5c6a-3550-a136-4e3c772b476a",
                                        "glosses": [
                                            "Qualité de ce qui est instantané."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6228fdc-7a04-48c4-a5d6-19fc3c42e0ad",
                                                "sense_id": "b106b271-aa6f-3fce-bfc3-be6ece9d2be8",
                                                "text": "Lui pour qui l’instantanéité est un dogme et la précipitation une seconde nature, il reprend patiemment le chemin déjà parcouru."
                                            },
                                            {
                                                "example_id": "1f3cb529-6d30-4b17-86d6-a9e2ce6c4611",
                                                "sense_id": "b106b271-aa6f-3fce-bfc3-be6ece9d2be8",
                                                "text": "Pour tout être rationnel, l’instantanéité de la consommation n’est pas un critère de décision, surtout lorsqu’un virage sociétal est en jeu."
                                            },
                                            {
                                                "example_id": "6387b4da-56c3-41c6-820c-e4d49a88e671",
                                                "sense_id": "b106b271-aa6f-3fce-bfc3-be6ece9d2be8",
                                                "text": "Il faut replacer l’instantanéité des événements dans le temps, assure Jean-Noël Jeanneney."
                                            },
                                            {
                                                "example_id": "859d7626-d126-4174-9f68-5322a8e26310",
                                                "sense_id": "b106b271-aa6f-3fce-bfc3-be6ece9d2be8",
                                                "text": "Il faut décrocher au maximum de l'idée de l' instantanéité pour se dire que c'est vraiment une stratégie d'ancrage sur le long terme."
                                            }
                                        ]
                                    }
