                "senses": [
                    {
                        "sense_id": "bd823a73-3f6b-3f99-aedf-a9e4bae72bdb",
                        "entry_id": "612b8f8f-7095-354a-91df-5c6ba2d5d14a",
                        "glosses": [
                            "прост. человек, снимающий шкуры с убитых или павших животных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83df807d-77ad-47e0-9535-32b7fd209f15",
                                "sense_id": "bd823a73-3f6b-3f99-aedf-a9e4bae72bdb",
                                "text": "Пришёл странный человек, худой, чёрный, грязный, в забрызганном чем-то чёрным кафтане. Это был драч. Он взял, не поглядев на него, повод оброти, надетой на Холстомера, и повел."
                            }
                        ]
                    }
                ],
