                ],
                "senses": [
                    {
                        "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                        "entry_id": "63c08ea3-00e9-30d3-880f-a2d50c23b9aa",
                        "glosses": [
                            "Geruchswahrnehmung, die von trocknendem Gras stammt; natürlicher Eigengeruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7eab02e1-b9dd-479b-ac2a-b5a8243c5d5b",
                                "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                                "text": "„Cumarin: Es ist für den typischen Heugeruch beim Trocknen von Pflanzen, z.B. Gras, verantwortlich.“"
                            },
                            {
                                "example_id": "010cf74e-7435-44be-b331-e41f646ae6d2",
                                "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                                "text": "„Der den typischen Heugeruch hervorrufende Stoff erzeugt auf der Haut rötliche Flecken.“"
                            },
                            {
                                "example_id": "bfb2d1ce-0ec0-4595-b1c1-34bb2aa7c0e6",
                                "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                                "text": "„Beim Trocknen dieser Pflanzen werden bestimmte dann enthaltene Glukoside durch fermentative Prozesse zu Cumarin umgewandelt, das dann den typischen Heugeruch hervorruft.“"
                            },
                            {
                                "example_id": "219c31d8-29dc-46e7-b968-5f1b6395d8cd",
                                "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                                "text": "„Einwandfreies Heu soll den typischen Heugeruch aufweisen, absolut trocken und von grüner Farbe sein, keine Verunreinigungen und keine Giftpflanzen enthalten.“"
                            },
                            {
                                "example_id": "571ea4ce-117d-45c8-9195-22c3085fe91d",
                                "sense_id": "e2cb49dc-0396-3857-a75f-b7a4a961bb9b",
                                "text": "„An sonnigen Junitagen, beim ersten Heuschnitt, weht uns dabei auf allen Wiesenflächen hier und da der waldmeisterartige Heugeruch des Ruchgrases in die Nase.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
