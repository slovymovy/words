                "senses": [
                    {
                        "sense_id": "55a72768-f740-3f17-a270-77f4be2cecbe",
                        "entry_id": "9a108314-803c-3c1d-9374-9c89bf5060ce",
                        "glosses": [
                            "To make royal or royalist."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8edc61c8-4a13-4eeb-9027-511ebf290105",
                                "sense_id": "55a72768-f740-3f17-a270-77f4be2cecbe",
                                "text": "Ere you were queen, yea, or your husband king,\nI was a pack-horse in his great affairs;\nA weeder-out of his proud adversaries,\nA liberal rewarder of his friends:\nTo royalize his blood I spilt mine own."
                            },
                            {
                                "example_id": "c9d0e2d1-0687-4136-80fe-600f45ec3fcc",
                                "sense_id": "55a72768-f740-3f17-a270-77f4be2cecbe",
                                "text": "[…] nor let the new royaliz’d presbyterians perswade themselves that thir old doings, though now recanted, will be forgotten […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "76849b24-d702-3cd4-ae0a-9c4db68dcd1c",
                        "entry_id": "9a108314-803c-3c1d-9374-9c89bf5060ce",
                        "glosses": [
                            "To make famous, to glorify, to celebrate."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "036a888a-d5b7-4d92-b2ba-520e5c5c4384",
                                "sense_id": "76849b24-d702-3cd4-ae0a-9c4db68dcd1c",
                                "text": "For fates and Oracles, heauen haue ſworne,\nTo roialiſe the deeds of Tamburlaine:\nAnd make them bleſt that ſhare in his attemptes."
                            }
                        ]
                    }
