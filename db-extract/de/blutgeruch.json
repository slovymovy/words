                "senses": [
                    {
                        "sense_id": "19d2e0ce-ac40-3d6d-a07e-122363a70bd7",
                        "entry_id": "2402987c-b51a-33f6-acfb-a07c215d8a6a",
                        "glosses": [
                            "Wahrnehmung von Geruch, der von Blut stammt oder diesem ähnelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe8d352f-84d5-42f4-9ce7-b083dfab1722",
                                "sense_id": "19d2e0ce-ac40-3d6d-a07e-122363a70bd7",
                                "text": "„Die Leichen- und Blutspurspürhunde der Polizei schnüffeln nach Leichen und Leichenteilen in allen Verwesungsstadien, sie riechen mit Leichen- oder Blutgeruch behaftete Orte, Fahrzeuge und Gegenstände, oder daran haftende Leichen-, Blut- oder Gewebespuren – auch wenn die Spuren entfernt wurden.“"
                            },
                            {
                                "example_id": "a18f08b6-1524-4799-8102-95faca3582ef",
                                "sense_id": "19d2e0ce-ac40-3d6d-a07e-122363a70bd7",
                                "text": "„Dass der Mensch Eisen 'riechen' kann, ist als ein Sinn für Blutgeruch zu interpretieren.“"
                            },
                            {
                                "example_id": "563dd764-11d7-4c06-bdc1-5fa6b07d366d",
                                "sense_id": "19d2e0ce-ac40-3d6d-a07e-122363a70bd7",
                                "text": "„Von Blutgeruch angelockt, findet er in einem Dorf einen frischen Kadaver.“"
                            },
                            {
                                "example_id": "d3c628f9-eff3-4759-aa7a-d46120961162",
                                "sense_id": "19d2e0ce-ac40-3d6d-a07e-122363a70bd7",
                                "text": "„Nahrung hängt von den Bäumen herab und da wo das Licht herkommt ist der Blutgeruch am intensivsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
