                    {
                        "translation_id": "aa7f4350-5327-45ee-98a1-a5bf7688792b",
                        "source_entry_id": "76c29cc1-d5fd-3ba2-974f-a3e9d6e6bf14",
                        "source_sense_id": "41a950b0-32a2-3945-bc32-6194c9e222bd",
