                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                        "entry_id": "c1e45e54-ef1d-3181-8a6f-534db44fe964",
                                        "glosses": [
                                            "Gesamtheit des Fremdenverkehrs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1640b0ae-6999-4df5-91f8-562743020c39",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Auch im Tourismus wird dieses vage historische Gefühl kultiviert und genutzt.“"
                                            },
                                            {
                                                "example_id": "c1ee9acb-ccd3-437f-8ef0-cf1ca8c76b92",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Der Tourismus stellt in Koblenz einen bedeutenden ökologischen und ökonomischen Einflussfaktor dar.“"
                                            },
                                            {
                                                "example_id": "b95bda8a-3c05-45f2-95f7-a12bfe5fb100",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "[…] „Der Tourismus verursacht bereits neun Prozent der globalen CO₂-Emissionen, haben Forscher berechnet – und fordern Gegenmaßnahmen.“"
                                            },
                                            {
                                                "example_id": "9e41b150-d6c9-4ba4-a28a-350af3091f31",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„An manchen Ecken sieht Berlin nachts trotz des Tourismus gespenstisch, gar ausgestorben aus.“"
                                            },
                                            {
                                                "example_id": "28fb76fd-0c4c-45be-b892-e6d459f237e4",
                                                "sense_id": "68b70dba-24be-3c01-b65e-4dba2d309ad1",
                                                "text": "„Beim Tourismus galt seit jeher, schon seit der Kavalierstour, dass Hunger und Elend nie weit von den Fünfsternehotels entfernt sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
