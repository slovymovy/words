                            },
                            {
                                "target_lang_word": "最少",
                                "target_lang_sense_clarification": "用于数量的最低要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a7f54b7-a8d6-3b15-885a-e71ac4d9f085",
                    "sense_definition": "The smallest amount or degree of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "limit_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please keep noise to a <w>minimum</w> after eleven o'clock at night.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, сведите шум к <w>ми́нимуму</w> после одиннадцати часов вечера.",
                                "pl": "Proszę ograniczyć hałas do <w>minimum</w> po godzinie jedenastej wieczorem.",
                                "zh": "晚上十一点后请将噪音降到<w>最低限度</w>。"
                            }
                        },
                        {
                            "text": "He always tries to get away with doing the bare <w>minimum</w> at work.",
                            "target_lang_translations": {
                                "ru": "На работе он всегда старается отделаться лишь необходимым <w>ми́нимумом</w>.",
                                "pl": "W pracy zawsze stara się wykręcić robieniem absolutnego <w>minimum</w>.",
                                "zh": "他在工作中总是试图只做<w>最低限度</w>的工作来敷衍了事。"
                            }
                        }
                    ],
                    "antonyms": [
                        "maximum"
                    ],
                    "common_phrases": [
                        "bare minimum",
                        "keep to a minimum",
                        "at a minimum"
                    ],
                    "target_lang_definitions": {
