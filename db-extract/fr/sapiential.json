                "senses": [
                    {
                        "sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                        "entry_id": "c3a13281-4fb7-3763-98fb-a2ae3f5277f2",
                        "glosses": [
                            "Qui enseigne la sagesse, en parlant de certains livres religieux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9edec60-7b2d-47cf-b682-c9f9fb02589c",
                                "sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                                "text": "Tester cette hypothèse, essayer de la corroborer ou de la réfuter, n'est pas simple, car le concept de « registre sapiential » n’est pas aussi solidement défini que d’autres concepts analogues, tels que ceux de « registre tragique » […]."
                            },
                            {
                                "example_id": "6d2ab862-31cb-4d85-bb28-03bf3c2d99fc",
                                "sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                                "text": "Dans ce passage, le micro-genre prophétique est utilisé de manière sapientiale ou selon notre expression « sapientialisée »."
                            },
                            {
                                "example_id": "4351ef9a-7aef-434c-afde-5622ca78d4e3",
                                "sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                                "text": "Claire-Lumière, Discernement et expériences sapientiales."
                            },
                            {
                                "example_id": "c2cce53d-9de3-4dd0-886f-8f95a9e975c2",
                                "sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                                "text": "C’est alors, dans l’épître de la vigile et dans celle de la fête, que nous entendons pour la première fois, magnifiant la Mère de Dieu, les deux épîtres sapientiales, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9597880-cc55-4139-acc6-c436aaa7bec5",
                        "source_entry_id": "c3a13281-4fb7-3763-98fb-a2ae3f5277f2",
                        "source_sense_id": "e9e271cc-f0b2-3099-b69f-555505f49aa9",
                        "target_lang_word": "wisdom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wisdom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9d5a3de-928a-3231-b6e7-30a5b4c7f9d7",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "An element of personal character that enables one to distinguish the wise from the unwise."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0b130fdf-59ab-354b-ae73-84046442449d",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "A piece of wise advice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "279d9ac0-6a92-3d10-bbc1-64ebd721f808",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "The discretionary use of knowledge for the greatest good."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71461697-8eeb-3b73-8fad-d4d120c91af7",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "The ability to apply relevant knowledge in an insightful way, especially to different situations from that in which the knowledge was gained."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b856049f-de1a-36c5-8021-6440e9488ed8",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "The ability to make a decision based on the combination of knowledge, experience, and intuitive understanding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "365b29cd-afb5-3aa6-8cab-0e96e980e239",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "The ability to know and apply spiritual truths."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5eee69e-eb78-454f-aa87-a5d84ebb0d66",
                                                "sense_id": "365b29cd-afb5-3aa6-8cab-0e96e980e239",
                                                "text": "Wiſdom…is to a man an infinite Treaſure, for ſhe is the Breath of the Power of God, and a pure Influence that floweth from the Glory of the Almighty; ſhe is the Brightneſs of Eternal Light, and an undefiled Mirror of the Majeſty of God, and an Image of his Goodneſs; ſhe teacheth us Soberneſs and Prudence, Righteouſneſs and Strength; ſhe underſtands the Subtilty of words, and Solution of dark ſentences; ſhe foreknoweth Signs and Wonders, and what ſhall happen in time to come."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d71738f9-79b6-358c-a164-cfd06751fc37",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "A group of wombats."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3680f33d-73f9-4776-985a-a574f16c4520",
                                                "sense_id": "d71738f9-79b6-358c-a164-cfd06751fc37",
                                                "text": "It would also be difficult to get to the bottom line accurately if a wisdom of wombats ate your working papers. Both scenarios are equal in probability."
                                            },
                                            {
                                                "example_id": "bfc44386-edfc-4340-b25b-a1fe7e3ec431",
                                                "sense_id": "d71738f9-79b6-358c-a164-cfd06751fc37",
                                                "text": "Beautimus strolled to the river for her morning bath. She looked one direction, then the other to search the landscape for anything or anybody who might offer a clue as to what could be coming her way. She passed a pond where a congregation of alligators and a wisdom of wombats engaged in a heated argument over economics. Nothing unusual in that."
                                            },
                                            {
                                                "example_id": "dd0c910f-58c5-42c6-94fb-2c7eff819127",
                                                "sense_id": "d71738f9-79b6-358c-a164-cfd06751fc37",
                                                "text": "Banyule means hill, another voice whispers from the swamp, and as I turn to ask a question I see kangaroos lying in the shade of a low tree by the shining water. Yes, the water has returned, along with giant earth-eating creatures boring holes far below, linking wisdoms of wombats with wastelands of Winthers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "156b1d85-30b5-3bea-a90b-153e846b29d2",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "A group of owls."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdf4b4bd-c2a2-4ef6-97a8-5808cc162048",
                                                "sense_id": "156b1d85-30b5-3bea-a90b-153e846b29d2",
                                                "text": "What he expected to find I cannot imagine , unless it was a wisdom of owls. What he did see and hear were telephones ringing, assistants answering them, getting up from their seats to take a book or a card from a file, returning[…]"
                                            },
                                            {
                                                "example_id": "7dc1e7fd-ceb2-4dbf-9469-65c2f6f7d2e9",
                                                "sense_id": "156b1d85-30b5-3bea-a90b-153e846b29d2",
                                                "text": "All of us, whether we gather into a wisp of snipes, a wisdom of owls, a wing of plovers, or remain like a single regretful priest on his knees before his God, we are one and it is not for us to decide another's fate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a02f722b-1be2-36b7-a0ab-c62bf224bdac",
                                        "entry_id": "f305fd0f-d108-3a11-9594-c570c20e9d92",
                                        "glosses": [
                                            "Ellipsis of wisdom tooth."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "colloquial",
                                            "countable",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2484e9c1-2481-4e45-8c06-ff9a03c25aff",
                                                "sense_id": "a02f722b-1be2-36b7-a0ab-c62bf224bdac",
                                                "text": "HAVING MY WISDOMS REMOVED"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
