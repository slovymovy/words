                "senses": [
                    {
                        "sense_id": "60e01ec9-af5a-32f5-b71b-86ece151f056",
                        "entry_id": "5e3a0478-abba-3d29-8899-879b3e88f869",
                        "glosses": [
                            "Celui qui coordonne, qui organise les rencontres entre différents intervenants, qui planifie les différentes tâches de différents intervenants ou qui organise leur travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e32fba06-2b68-4ec8-8a23-2b7621cb0d4b",
                                "sense_id": "60e01ec9-af5a-32f5-b71b-86ece151f056",
                                "text": "Ce coordinateur est un expert dans son domaine de compétence."
                            }
                        ]
                    },
                    {
                        "sense_id": "3353043f-c51c-3941-85a6-5dd311c35969",
                        "entry_id": "5e3a0478-abba-3d29-8899-879b3e88f869",
                        "glosses": [
                            "Membre d'un groupe politique chargé de coordonner les activités de leur groupe au sein d'une commission parlementaire mais également de préparer, avec le président de la commission et les autres coordinateurs, certaines décisions."
                        ],
                        "tags": [
                            "Droit de l’Union européenne"
                        ],
                        "examples": [
                            {
                                "example_id": "e9271494-d1f0-441a-9092-61e73c08da76",
                                "sense_id": "3353043f-c51c-3941-85a6-5dd311c35969",
                                "text": "Les groupes politiques peuvent désigner l'un de leurs membres au sein des différentes commissions comme coordinateur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45c22fc7-1363-420f-868a-a07cdf134a7c",
                        "source_entry_id": "5e3a0478-abba-3d29-8899-879b3e88f869",
                        "target_lang_word": "Koordinator",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koordinator",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a7a984-5df0-3c29-86d8-a7b335798f8b",
                                        "entry_id": "4b4acab2-c426-3da5-b687-31f1302ae64f",
                                        "glosses": [
                                            "Person, die organisiert und dabei verschiedene Ideen und Ansprüche sowie Rahmenbedingungen berücksichtigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42a3e2f8-409e-4098-baeb-acf239023909",
                                                "sense_id": "f2a7a984-5df0-3c29-86d8-a7b335798f8b",
                                                "text": "Er steht als Koordinator zwischen Mensch und Maschine und bestimmt letztlich das Ergebnis, das aus der Kombination dieser beiden Komponenten entsteht."
                                            },
                                            {
                                                "example_id": "10827cdb-ac5d-4a05-809c-6cfba18c5309",
                                                "sense_id": "f2a7a984-5df0-3c29-86d8-a7b335798f8b",
                                                "text": "Ich dachte, Sie könnten die Rolle des Koordinators zwischen den Ansprüchen und Ideen der beiden beteiligten Familien übernehmen. Sprechen Sie doch mal mit beiden Parteien und hören Sie, was die sich so vorstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
