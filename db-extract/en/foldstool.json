                                "sense_id": "d62487d0-880b-327b-ad65-555c6abfa242",
                                "text": "Handibasket with foldstool"
                            },
                            {
                                "example_id": "6b48ed47-7de7-4d71-b319-ecf3ffad7c05",
                                "sense_id": "d62487d0-880b-327b-ad65-555c6abfa242",
                                "text": "I dropped a small wicker foldstool that I always carried as part of my camp-kit on the side of the road to mark the spot and told the driver to back down the road, guiding him with my torch – till we found a convenient place to turn the vehicle around."
                            },
                            {
                                "example_id": "23a77af9-90dc-4acb-aae7-fcdb40b3172e",
                                "sense_id": "d62487d0-880b-327b-ad65-555c6abfa242",
                                "text": "Yulia had pushed forward a large foldstool, and Zoë motioned to her and her companion to sit down in a corner."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba57df86-f9af-3502-ba58-cf1bfebb2f07",
                        "entry_id": "926eaf1e-8386-39e4-b8bd-ad791f1a4c42",
