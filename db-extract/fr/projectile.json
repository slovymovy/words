        "fr-extract.jsonl": [
            {
                "entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                "word": "projectile",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cb8f8e8e-ba7b-401a-a2a0-2ecaa2fa2fa1",
                        "entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                        "tags": [
                            "plural"
                        ],
                        "form": "projectiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "93dccbc4-a719-38ee-be0a-73fd6d0b6ee3",
                        "entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                        "glosses": [
                            "Tout corps lancé par une force quelconque."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "e80703b1-2f0e-4010-ab04-0f7060ae9097",
                                "sense_id": "93dccbc4-a719-38ee-be0a-73fd6d0b6ee3",
                                "text": "On a brûlé ce qui tombait sous la main et les livres ont servi de combustibles comme ils avaient servi de projectiles. La première chose qui avait été lancée sur les CRS, c'est une bible !"
                            },
                            {
                                "example_id": "94877b01-e63d-411a-909e-66816929ef29",
                                "sense_id": "93dccbc4-a719-38ee-be0a-73fd6d0b6ee3",
                                "text": "D’énormes fumigènes rouges et une bombe agricole illuminèrent le virage de Boulogne, et différents projectiles fusèrent en direction du terrain sous les cris de : « CRS marseillais ! » Des agents de sécurité couraient dans tous les sens, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c97274ff-ca86-3d4b-9f92-d51d25c8845f",
                        "entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                        "glosses": [
                            "Balle, obus, et en général de tout corps lancé par une arme de jet ou une arme à feu."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "29ceef02-a2ad-4a8a-800b-bfba288fcbfb",
                                "sense_id": "c97274ff-ca86-3d4b-9f92-d51d25c8845f",
                                "text": "Alors des flammes aveuglantes jaillirent dans toutes les directions autour du point où le projectile toucha terre, et l’homme qui avait sauté devint, pendant quelques secondes, un éclat de feu et disparut… entièrement."
                            },
                            {
                                "example_id": "49aad308-e2c0-4b00-9aa1-d6791411cc2a",
                                "sense_id": "c97274ff-ca86-3d4b-9f92-d51d25c8845f",
                                "text": "Ce soir-là, […], je pris ma première leçon d'artillerie. Je connus, à un bruit étrange, croissant, entièrement nouveau, que des projectiles arrivaient, tels des oiseaux criards ; […] ; l'instant d'après ils plongeaient au-dessus de notre toit et éclataient comme à notre nez, criblant l'autre maison et le carrefour."
                            },
                            {
                                "example_id": "2c5ff444-2ddd-4244-9354-b33042aa6b44",
                                "sense_id": "c97274ff-ca86-3d4b-9f92-d51d25c8845f",
                                "text": "Entre 1952 et 1999, environ 500 000 projectiles ont été tirés dans les eaux du lac par l'armée canadienne afin d'effectuer des tirs de pratique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76bf46db-dca9-42b6-b43c-5bd097eb1a65",
                        "source_entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                        "target_lang_word": "Geschoss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geschoss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                        "entry_id": "707c02e0-d0fc-3e4a-968f-b06f77b8412f",
                                        "glosses": [
                                            "Gegenstand, der mit einer Waffe verschossen werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a05ad6a-c9a0-45aa-88e2-642a5fd4cd0e",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "Das Geschoss durchschlug sogar dicke Betonwände."
                                            },
                                            {
                                                "example_id": "99c7811e-d95a-4051-b717-de2c99ebfa9c",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "„Sie sind ein aufgewühltes Meer, die Stichflammen der Geschosse springen wie Fontänen heraus.“"
                                            },
                                            {
                                                "example_id": "f0b65fc6-d326-443d-885d-4d3a88c07e0d",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "„Ein Geschoss von drüben zirpte über uns weg.“"
                                            },
                                            {
                                                "example_id": "63f0dde3-854e-4414-b6c1-5748fdbdafb4",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "„Andererseits mangelte es sowohl an genügend Metall für den Guss neuer Geschosse als auch an den Chemikalien, aus denen man Treib- und Sprengladungen zusammenmischen konnte.“"
                                            },
                                            {
                                                "example_id": "7ce883b8-2caf-4acc-8717-4e551b35b162",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "[Russland-Ukraine-Krieg 2022:] „Im flachen Land der Ostukraine kämpfen russische und ukrainische Soldaten im Hagel der Geschosse um jeden Meter.“"
                                            },
                                            {
                                                "example_id": "18ac0251-8e1c-4832-8c2f-678a48760245",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "„Die Ausbildung der ukrainischen Soldaten an den Panzerhaubitzen, die GPS-gelenkte Geschosse abfeuern können, dürfte bereits laufen.“"
                                            },
                                            {
                                                "example_id": "b8cef8ae-1667-4bb8-a929-cd12cda0da86",
                                                "sense_id": "cf2af394-2228-323e-a9eb-e9238ad6f784",
                                                "text": "„Nordkorea hat nach Angaben Japans und Südkoreas mindestens eine Rakete zu Testzwecken ins Meer abgefeuert. Wahrscheinlich handelte es sich bei dem Geschoss um eine ballistische Rakete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d5be68d1-ae91-3f6d-a7a6-d46f4ac0d42b",
                                        "entry_id": "707c02e0-d0fc-3e4a-968f-b06f77b8412f",
                                        "glosses": [
                                            "Räumlichkeiten, die sich in einem Gebäude auf derselben Ebene befinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c07157-deee-408c-980e-651d789126bb",
                                                "sense_id": "d5be68d1-ae91-3f6d-a7a6-d46f4ac0d42b",
                                                "text": "Wie viele Geschosse hat das Hochhaus?"
                                            },
                                            {
                                                "example_id": "3ffe8537-e6fa-4ec3-a402-282d60ea687f",
                                                "sense_id": "d5be68d1-ae91-3f6d-a7a6-d46f4ac0d42b",
                                                "text": "„Er vermutet, dass es die Tochter ist, die mit ihrer Familie im unteren Geschoss wohnt und für den frühen Morgen einen Ausflug geplant hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8780bc3-7e8f-4711-b105-d46e5724d4b6",
                        "source_entry_id": "05f4766b-141e-37b9-ae40-daba8039f913",
                        "target_lang_word": "Projektil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Projektil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "464f281f-9aa2-329a-b51f-389ef48d9f91",
                                        "entry_id": "243df4b8-4d2f-3f78-8081-5684ecb936e4",
                                        "glosses": [
                                            "von einer Schusswaffe abgeschossenes Geschoss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "337d7a8c-5b95-4ce3-829d-5720d5fc632a",
                                                "sense_id": "464f281f-9aa2-329a-b51f-389ef48d9f91",
                                                "text": "Das Projektil durchschlug den Körper."
                                            },
                                            {
                                                "example_id": "887d0cd5-5d44-4d8f-8481-752605b7b96f",
                                                "sense_id": "464f281f-9aa2-329a-b51f-389ef48d9f91",
                                                "text": "Hier haben wir Projektile aus Messing mit Bleikern."
                                            },
                                            {
                                                "example_id": "03f03cc5-0578-4aaa-92c0-98d88ab18d12",
                                                "sense_id": "464f281f-9aa2-329a-b51f-389ef48d9f91",
                                                "text": "Kaliber .45 bedeutet, dass das Projektil einen Durchmesser von fast 12 mm hat."
                                            },
                                            {
                                                "example_id": "83b151ee-61dc-4933-8e9b-c4b6122f936e",
                                                "sense_id": "464f281f-9aa2-329a-b51f-389ef48d9f91",
                                                "text": "„Vergeblich suchte er das Einschussloch im Bretterzaun und das Projektil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c0c3b3b-f56e-356d-94dd-122b6fbb4c39",
                                        "entry_id": "243df4b8-4d2f-3f78-8081-5684ecb936e4",
                                        "glosses": [
                                            "größerer Flugkörper; Rakete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57f9b532-f1c6-43fa-8fa6-4e324e7ed7ec",
                                                "sense_id": "9c0c3b3b-f56e-356d-94dd-122b6fbb4c39",
                                                "text": "„Das Projektil blieb weiterhin im Anflug auf den Nordpol und hatte das Mondzentrum weit hinter sich gelassen.“"
                                            },
                                            {
                                                "example_id": "f9657654-76b7-4478-93fe-c43d6a29f527",
                                                "sense_id": "9c0c3b3b-f56e-356d-94dd-122b6fbb4c39",
                                                "text": "Nach Beendigung des Antriebsschubes fliegt die Rakete als reines Projektil weiter."
                                            },
                                            {
                                                "example_id": "a7edbb7a-bd04-440a-ad74-0c1d6aa4267e",
                                                "sense_id": "9c0c3b3b-f56e-356d-94dd-122b6fbb4c39",
                                                "text": "Das 4,5 m lange Projektil soll Höhen bis zu 130 km und Geschwindigkeiten bis zu 3000 km/h erreichen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
