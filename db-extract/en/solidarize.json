                                "target_senses": [
                                    {
                                        "sense_id": "d8e3a990-3ff1-36b2-bcc8-b515b221f30e",
                                        "entry_id": "595f5543-86ea-3b7c-8f38-b9888cddd52c",
                                        "glosses": [
                                            "sich unterstützend auf die gleiche Seite stellen, sich mit etwas oder jemandem solidarisch erklären"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f8b6894-542a-437f-adb1-4c2800c6be41",
                                                "sense_id": "d8e3a990-3ff1-36b2-bcc8-b515b221f30e",
                                                "text": "„Der Bischof schaut nicht verächtlich von oben auf den Trinker herab – er nimmt ihn in seiner Würde ernst, die er trotz seines Lasters hat. Und damit gibt er ihm seine Würde wieder zurück. Jesus solidarisiert sich mit Sündern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4c3626d-75c1-34ff-83b6-62015f24d357",
                                        "entry_id": "595f5543-86ea-3b7c-8f38-b9888cddd52c",
                                        "glosses": [
                                            "sich gegenseitig unterstützen, um in einer Sache gemeinsam aktiv zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eae4397c-e063-4626-99d8-85cf1453d2a5",
                                                "sense_id": "a4c3626d-75c1-34ff-83b6-62015f24d357",
                                                "text": "„Nutzt eure Kraft, denn ihr seid viele. Ihr seid die Macht, die jene, die euch auf allen Kontinenten in permanenter Armut halten, brechen kann. Solidarisiert euch! Solidarisiert euch weltweit! “"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
