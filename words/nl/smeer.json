                    "sense_id": "15798298-b9e7-373c-b079-54c6904dee4a",
                    "sense_definition": "Een vette substantie die gebruikt wordt om te smeren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vet_substantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een dikke laag <w>smeer</w> op de ketting van mijn fiets.",
                            "target_lang_translations": {
                                "en": "There is a thick layer of <w>grease</w> on my bicycle chain."
                            }
                        },
                        {
                            "text": "Gebruik deze speciale <w>smeer</w> om de machine soepel te laten lopen.",
                            "target_lang_translations": {
                                "en": "Use this special <w>lubricant</w> to keep the machine running smoothly."
                            }
                        }
                    ],
                    "synonyms": [
                        "vet"
                    ],
                    "common_phrases": [
                        "dikke laag smeer"
                    ],
                    "target_lang_definitions": {
                        "en": "A greasy substance used for lubrication or greasing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grease",
                                "target_lang_sense_clarification": "lubricating substance"
                            },
                            {
