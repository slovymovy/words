                ],
                "senses": [
                    {
                        "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                        "entry_id": "21240143-265b-31bf-a401-d17c7be01dde",
                        "glosses": [
                            "die Wissenschaft von der kurdischen Sprache und Literatur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e585700d-816f-46cf-b543-516f3d1860d5",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "„Kurdologie bzw. kurdische Studien im Sinne der Satzung meint die systematische Auseinandersetzung mit sozialwissenschaftlichen ebenso wie mit philologischen, historischen und künstlerischen Fragestellungen.“"
                            },
                            {
                                "example_id": "55b2987a-36ef-45bf-81df-e3355cde1e18",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "Die Kurdologie untersucht u.a. die Geschichte der kurdischen Sprache."
                            },
                            {
                                "example_id": "a801e2e8-df1e-401f-8297-16309bcffffe",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "„Zu den bekanntesten Wissenschaftlern auf dem Feld der Kurdologie zählen Wladimir Minorski und Mohammad Mokri, die sich u. a. mit der Kurdischen Sprache befassten.“"
                            },
                            {
                                "example_id": "e5d1bf32-9726-41fc-9cc4-704eee163e3b",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "„In der Kurdologie als einer Disziplin, die sich aufgrund ihres Forschungsgegenstandes — einer Ethnie mit einer virulenten Nationalbewegung — der sozialen Konstruktion bzw. Dekonstruktion von Ethnizität und Nation widmet, wurde es bislang weitgehend versäumt, sich der wohl universellsten und wirkungsmächtigsten sozialen Konstruktion, der des Geschlechts, zuzuwenden.“"
                            },
                            {
                                "example_id": "52661c94-c6cd-4a19-be63-e80ccbdb2ef6",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "„Es gibt drei verschiedene Schwerpunkte in der Göttinger Iranistik: Neuiranistik, Altiranistik und Kurdologie.“"
                            },
                            {
                                "example_id": "80a40e77-cf09-4a2b-816d-375333b6bf5b",
                                "sense_id": "ddfd22c4-b818-3af5-93d0-2930b7ce697a",
                                "text": "„Es handelt sich um die Zentren für Kurdologie in Moskau, Leningrad und Yerevan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
