                "senses": [
                    {
                        "sense_id": "45421bdc-b7f1-32be-9a1b-d088b5d2d0e2",
                        "entry_id": "69f76897-afe8-31cd-9f08-b3376ca1eef9",
                        "glosses": [
                            "die letzten Tage eines Monats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4896e66c-00a8-4ad3-a467-fefc81afb42d",
                                "sense_id": "45421bdc-b7f1-32be-9a1b-d088b5d2d0e2",
                                "text": "Oft ist am Monatsende nicht mehr viel vom Geld übrig."
                            },
                            {
                                "example_id": "8dc92142-9642-49d2-b9c3-80219d43a6d4",
                                "sense_id": "45421bdc-b7f1-32be-9a1b-d088b5d2d0e2",
                                "text": "„Die Einkommen von Auszubildenden und Berufsanfängern sind mager – am Monatsende bleibt davon meist nichts übrig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
