    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc05e25e-f8fd-36d4-9162-092b6234a4d6",
                    "sense_definition": "De buitenkant van een boek die de bladzijden bij elkaar houdt en beschermt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "boekonderdelen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>kaft</w> van dit oude boek is helemaal versleten en valt bijna uit elkaar.",
                            "target_lang_translations": {
                                "en": "The <w>cover</w> of this old book is completely worn out and is almost falling apart."
                            }
                        },
                        {
                            "text": "Zij koos voor een stevige <w>kaft</w> om haar nieuwe dagboek goed te beschermen.",
                            "target_lang_translations": {
                                "en": "She chose a sturdy <w>cover</w> to protect her new diary well."
                            }
                        }
                    ],
                    "synonyms": [
                        "boekomslag",
                        "omslag",
                        "boekband"
                    ],
                    "common_phrases": [
                        "stevige kaft",
                        "harde kaft",
                        "slappe kaft"
                    ],
                    "target_lang_definitions": {
                        "en": "The outer part of a book that holds the pages together and protects them."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "of a book"
                            },
                            {
                                "target_lang_word": "book cover",
                                "target_lang_sense_clarification": "the protective outer layer"
                            },
                            {
                                "target_lang_word": "binding",
                                "target_lang_sense_clarification": "the physical construction holding pages"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6709afc-0321-3e66-bf6f-49e459d3fc31",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>kaften</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kaft</w> mijn nieuwe schoolboeken altijd met vrolijk papier aan het begin van het jaar.",
                            "target_lang_translations": {
                                "en": "I always <w>cover</w> my new schoolbooks with cheerful paper at the beginning of the year."
                            }
                        },
                        {
                            "text": "Elke keer als ik een nieuw boek koop, <w>kaft</w> ik het direct om beschadigingen te voorkomen.",
                            "target_lang_translations": {
                                "en": "Every time I buy a new book, I <w>cover</w> it immediately to prevent damage."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "eerste persoon enkelvoud tegenwoordige tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first person singular present tense of 'kaften' (to cover a book)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cover",
                                "target_lang_sense_clarification": "first person singular present tense"
                            },
                            {
                                "target_lang_word": "am covering",
                                "target_lang_sense_clarification": "present continuous"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb46496c-f568-3129-91d8-e767ab50d9b0",
                    "sense_definition": "De gebiedende wijs van <w>kaften</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kaft</w> je boeken voordat je naar school gaat, zodat ze niet vies worden.",
                            "target_lang_translations": {
                                "en": "<w>Cover</w> your books before you go to school so they don't get dirty."
                            }
                        },
                        {
                            "text": "Alsjeblieft, <w>kaft</w> dat dure tekstboek even voor me met dit plastic.",
                            "target_lang_translations": {
                                "en": "Please, <w>cover</w> that expensive textbook for me with this plastic."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
