                "senses": [
                    {
                        "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                        "entry_id": "4730c7dd-18fb-30c6-b9c8-c2daf676de83",
                        "glosses": [
                            "Ausdruck der Ablehnung oder Unzufriedenheit über etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f93f4f5a-b058-4640-bf9d-942b90bebefb",
                                "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                                "text": "„Abrupt hob er den Kopf auf meinen Gutenmorgengruß hin und bellte mir etwas entgegen, das ich zwar nicht verstand, aber wegen des Tonfalls für eine Missfallensäußerung bezüglich meines Zuspätkommens halten musste.“"
                            },
                            {
                                "example_id": "e29d375d-b811-49be-843a-d4545d02975c",
                                "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                                "text": "„Als ich gedankenversunken auf dem Beifahrersitz saß, wurde ich erneut von einer unbeherrschten Missfallensäußerung meines Schwagers unsanft aus den Gedanken heraus gerissen.“"
                            },
                            {
                                "example_id": "d8e812b5-4a9a-4306-b153-fb8f4b410698",
                                "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                                "text": "„Mein Stöhnen, vom Publikum als Missfallensäußerung gedeutet und vielfach wiederholt, sabotierte die letzten Szenen.“"
                            },
                            {
                                "example_id": "68adcfb8-c2e2-4899-bed8-bc4a93d33dc3",
                                "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                                "text": "„Die Männer grummelten etwas vor sich hin, das Fiete nicht verstand, was er aber als Missfallensäußerung auffasste, er konnte damit leben, die Sicherheit auf seiner Baustelle war ihm sehr wichtig.“"
                            },
                            {
                                "example_id": "5ff075ae-ed63-4388-8939-5e0a7d2aa9c3",
                                "sense_id": "2b7a2a26-838d-3e18-be09-5e6f40606bea",
                                "text": "„Sie wusste, es sollte eine Missfallensäußerung sein, doch für sie klang es wie ein lustvolles Stöhnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
