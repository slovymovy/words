                    {
                        "sense_id": "4aef3ffe-64ae-39c8-ba89-e81fa1260597",
                        "entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "glosses": [
                            "mechanisme in schietwapen waardoor het buigen van de wijsvinger leidt tot het lossen van een schot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc752fb-9f31-458a-ace8-3a31bc94b191",
                                "sense_id": "4aef3ffe-64ae-39c8-ba89-e81fa1260597",
                                "text": "Zestig jaar nadat de foto ‘De laatste Jood van Vinnytsja’ voor het eerst aan de wereld werd getoond, heeft een Duitse historicus de naam van de SS'er achterhaald die in 1941 de trekker overhaalde."
                            }
                        ]
                    },
                    {
                        "sense_id": "feaddf45-1e62-3fd3-a88c-b0839ecfdefd",
                        "entry_id": "11d47330-cc1a-3d25-917c-0d0856c6a7e9",
                        "glosses": [
                            "vogel die, afhankelijk van het jaargetijde, in ver van elkaar gelegen gebieden verblijft"
