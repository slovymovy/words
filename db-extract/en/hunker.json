                                        "entry_id": "90076bb8-cbbb-3a9d-b3d1-9a1a667c4e5c",
                                        "glosses": [
                                            "den Kopf oder Oberkörper nach unten einziehen, um nicht von etwas getroffen oder jemandem gesehen zu werden"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5790a5f2-60e3-4093-9b78-8a1a95c14fa3",
                                                "sense_id": "693c37c5-de20-3af9-b458-b0d35bb40b7f",
                                                "text": "George W. Bush duckte sich noch rechtzeitig, um dem nahenden Schuh auszuweichen."
                                            },
                                            {
                                                "example_id": "a120a842-85f5-44aa-807d-6b616ac2dc87",
                                                "sense_id": "693c37c5-de20-3af9-b458-b0d35bb40b7f",
                                                "text": "Das kleine Mädchen duckte sich ganz tief in die Ecke zwischen Schrank und Tür."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2d01cc2-7c02-4437-b527-a7be9d912876",
                        "source_entry_id": "7a4263ed-e560-3470-bef0-70f63005b165",
                        "source_sense_description": "To crouch, squat or lie down",
                        "target_lang_word": "kauern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kauern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9fe79425-dd76-3653-942c-87e36f2419f7",
                                        "entry_id": "03dcb33e-7ad4-3405-9c1c-90ce8eb1949a",
                                        "glosses": [
                                            "in hockender Position oder mit gekrümmtem Rücken sitzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7db337f6-146c-4ea8-9ad5-c50fe5ab979d",
                                                "sense_id": "9fe79425-dd76-3653-942c-87e36f2419f7",
                                                "text": "Das Kind kauerte in einer Ecke und ließ sich nicht herauslocken, bis seine Mutter kam."
                                            },
                                            {
                                                "example_id": "c63132f6-50be-40f1-ac84-5ed1bd4220b0",
                                                "sense_id": "9fe79425-dd76-3653-942c-87e36f2419f7",
                                                "text": "„Auch ich kaure manchmal am Gartenzaun unseres Schrebergartens und rupfe Unkraut aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d426b721-351d-37bc-97aa-03cc68ca5b0d",
                                        "entry_id": "03dcb33e-7ad4-3405-9c1c-90ce8eb1949a",
                                        "glosses": [
                                            "sich zusammengekrümmt hinsetzen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebe8741d-e364-4e58-881f-5125b4bd58c8",
                                                "sense_id": "d426b721-351d-37bc-97aa-03cc68ca5b0d",
                                                "text": "„Dozenten sind doof, cool, lustig, irgendwie putzig, gruselig oder schlicht sonderbar. Sie sitzen in Badehose in ihren Büros, hängen ulkige Sprüche aus, sind nuschelnde absolute Fachidioten oder Leute, mit denen man sprechen kann auch wenn sie sich vor die [H]eizung kauern um ihre Mandarinen zu essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
