                                        "entry_id": "6c7fbdec-76cc-3212-a1ee-184d2ebda3dc",
                                        "glosses": [
                                            "Qui assimile la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af4891c4-0b66-4d8e-baa3-973f5ab18f74",
                                                "sense_id": "bfeacf45-a0c9-3c81-950b-e4065b2e6895",
                                                "text": "Une cellule photoréceptrice."
                                            },
                                            {
                                                "example_id": "827ce180-9595-4458-8338-264c59dbf531",
                                                "sense_id": "bfeacf45-a0c9-3c81-950b-e4065b2e6895",
                                                "text": "Les neurones photorécepteurs convertissent, par un processus photochimique, l'énergie lumineuse en un signal neurochimique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "photorécepteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d935a44-935d-31a4-830d-81af477a7342",
                                        "entry_id": "f2ae8461-5480-3124-9fbc-267894da1dc9",
                                        "glosses": [
                                            "Neurone ou molécule sensible à la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21e5071a-5630-427e-b753-e03b40342cf6",
                                                "sense_id": "9d935a44-935d-31a4-830d-81af477a7342",
                                                "text": "Entre les deux valeurs, le photorécepteur est un indicateur fiable et sensible de l’intensité lumineuse."
                                            },
                                            {
                                                "example_id": "41d3eb14-d786-44cf-84ec-d1dee4d5c504",
                                                "sense_id": "9d935a44-935d-31a4-830d-81af477a7342",
                                                "text": "En journée, la lumière dégrade la protéine TIM via l’action d’un photorécepteur (une autre protéine, « cryptochrome »), et en l’absence de TIM, PER sera également dégradée. La dégradation des protéines PER et TIM permet aux protéines CLK et CYC d’assurer à nouveau leur action activatrice, démarrant ainsi un nouveau cycle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0388c23-84a0-3d76-ac48-4ec2f1772777",
                                        "entry_id": "f2ae8461-5480-3124-9fbc-267894da1dc9",
                                        "glosses": [
                                            "Composant capable de transformer un rayonnement lumineux en signal électrique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
