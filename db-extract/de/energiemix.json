                "senses": [
                    {
                        "sense_id": "67542586-00c9-30a3-81e4-ce1f4523fe07",
                        "entry_id": "dca4c154-686a-3330-a51f-96046c71b204",
                        "glosses": [
                            "bestehende Gesamtheit der Versorgung mit Energie aus ganz unterschiedlichen Primärenergien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17393c59-ded6-42cb-9a34-e20dfc4f056b",
                                "sense_id": "67542586-00c9-30a3-81e4-ce1f4523fe07",
                                "text": "„Im Vergleich zu einer einzelnen Energie hat der Energiemix den großen Vorteil, dass der Versorgte nicht vollkommen von einer speziellen Energiequelle und deren Preisen abhängig ist.“"
                            },
                            {
                                "example_id": "e39500fe-d6bf-430a-8b30-7d5c9bf2d984",
                                "sense_id": "67542586-00c9-30a3-81e4-ce1f4523fe07",
                                "text": "„Durch den Energiemix wird daher die Abhängigkeit von bestimmten Energiequellen verhindert.“"
                            },
                            {
                                "example_id": "da7b2990-42b3-4daf-a151-10f50c59a76c",
                                "sense_id": "67542586-00c9-30a3-81e4-ce1f4523fe07",
                                "text": "„Bezogen auf den jeweiligen Energiemix und die hier betrachteten Energieträger entfielen sowohl in der EU (1,2 Prozent) als auch in den USA (0,8 Prozent) und in China (0,5 Prozent) auf die neuen erneuerbaren Energien die niedrigsten Werte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
