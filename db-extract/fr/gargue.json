                        "examples": [
                            {
                                "example_id": "2dcb4696-ee3c-4f82-bc5d-6e50f882fe45",
                                "sense_id": "6ab75b98-3917-386b-9066-65b644644cd7",
                                "text": "Après une raclée d’un vrai mac, madame peut redescendre au turbin, un peu d’eau fraîche sur la gargue et d’la poudre de riz le long des joues, bien malin s’rait l’client qui dépisterait la chose."
                            },
                            {
                                "example_id": "c6f652b6-94e8-4188-aeca-e36437eed096",
                                "sense_id": "6ab75b98-3917-386b-9066-65b644644cd7",
                                "text": "Willy se cloque dans la gargue une énorme bouchée de gigot, puis l’ayant réduite en trois coups de mâchoire, admet, sérieux : - Le retour de flamme pour la malhonnêteté, ça existe !"
                            },
                            {
                                "example_id": "f57a7a06-8229-4485-bbf2-171175d77382",
                                "sense_id": "6ab75b98-3917-386b-9066-65b644644cd7",
                                "text": "César continuait à driver bon train, une pipe à demi éteinte vissée au coin de la gargue."
                            },
                            {
                                "example_id": "fcbce35f-a75d-4084-8bb5-4f3a037d5733",
                                "sense_id": "6ab75b98-3917-386b-9066-65b644644cd7",
                                "text": "Et l’air, pourtant trop lourd, trop chaud, refuse le chemin de la poitrine et lui gèle la gargue."
                            }
                        ]
                    }
