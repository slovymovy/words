                                    {
                                        "sense_id": "0170487f-08d9-3c11-aa33-f082bb3cf7e2",
                                        "entry_id": "f9f5bd66-5054-3bf0-8584-91fc89723407",
                                        "glosses": [
                                            "etwas geschickt oder unbemerkt wegnehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82a6db7b-a933-4460-af20-6ff947065ff7",
                                                "sense_id": "0170487f-08d9-3c11-aa33-f082bb3cf7e2",
                                                "text": "Die Elster stibitzte sich ein Stück Brot vom Tisch, während keiner hinsah."
                                            }
