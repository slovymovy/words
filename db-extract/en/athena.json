                                "target_senses": [
                                    {
                                        "sense_id": "9ddeb9d1-2cce-3de0-bb03-081dac456515",
                                        "entry_id": "a413234b-82e3-39a7-8d38-88cd5f403538",
                                        "glosses": [
                                            "de hoofdstad van Griekenland"
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80b6474b-53f4-4f07-ac7d-dff7c01f9799",
                                                "sense_id": "9ddeb9d1-2cce-3de0-bb03-081dac456515",
                                                "text": "Zo werd in Athene een festival voor de stadsgodin Pallas Athene ingesteld dat Atheense burgers jaarlijks de gelegenheid gaf zich met elkaar te meten, maar één keer per vier jaar ook deelnemers van buiten Athene toeliet."
                                            },
                                            {
                                                "example_id": "d45e0bfa-8195-410a-96c1-1a0dfc8524fe",
                                                "sense_id": "9ddeb9d1-2cce-3de0-bb03-081dac456515",
                                                "text": "Vaak ging het om niet meer dan een open ruimte aan de rand van de stad, of net buiten de stadsmuren, zoals de beroemde Akademie in Athene die gelegen was rond een heiligdom."
                                            },
                                            {
                                                "example_id": "8920a310-773f-49b0-8865-b9dbc6ea5090",
                                                "sense_id": "9ddeb9d1-2cce-3de0-bb03-081dac456515",
                                                "text": "In Athene waren er bijvoorbeeld wetten die openingstijden per leeftijdsgroep beperkten, en in een gymnasiumreglement uit de Macedonische stad Beroia lezen we dat verschillende leeftijdsgroepen zich niet op hetzelfde moment mochten omkleden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49918536-26f0-3d5b-b9be-06441d5251aa",
                                        "entry_id": "a413234b-82e3-39a7-8d38-88cd5f403538",
                                        "glosses": [
                                            "de Griekse godin van de wijsheid, voluit Pallas Athene genaamd"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae7933d7-0d8a-47b6-b4f1-6a05b8b27bce",
                                                "sense_id": "49918536-26f0-3d5b-b9be-06441d5251aa",
                                                "text": "Zo werd in Athene een festival voor de stadsgodin Pallas Athene ingesteld dat Atheense burgers jaarlijks de gelegenheid gaf zich met elkaar te meten, maar één keer per vier jaar ook deelnemers van buiten Athene toeliet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
