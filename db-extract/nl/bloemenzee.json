                        "sense_id": "3a4ceecc-e33f-3e95-8db2-886f070b0195",
                        "entry_id": "452a4d1c-b595-3edf-8d54-5bb5840fc6b1",
                        "glosses": [
                            "een grote hoeveelheid bloemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d799b41f-f117-4f3b-a7ad-e4763ed17b8b",
                                "sense_id": "3a4ceecc-e33f-3e95-8db2-886f070b0195",
                                "text": "Die bloemenzee wordt onafgebroken aangevuld door het publiek, dat telkens twee anjers aan de voet van het portret legt — een even aantal bloemen voor een dode."
                            },
                            {
                                "example_id": "6c65fca7-769b-48a4-811e-1eaa2594fe56",
                                "sense_id": "3a4ceecc-e33f-3e95-8db2-886f070b0195",
                                "text": "Het is vandaag Nationale Tulpendag, het begin van het tulpenseizoen. Normaal betekent dat dat de Dam wordt omgetoverd in een bloemenzee waar elke Amsterdammer een tulp mag komen plukken. Maar vanwege de coronamaatregelen ging dat niet door. In plaats daarvan reikte Van Duin zijn eigen tulp vanaf een open rondvaartboot uit aan voorbijgangers."
                            }
                        ]
                    }
