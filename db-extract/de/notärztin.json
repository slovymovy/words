                    {
                        "sense_id": "0bf87da2-6c5c-36db-aaaa-f67cc22d0ccf",
                        "entry_id": "dacc2226-a2b8-3e58-a1e7-c0132d751f74",
                        "glosses": [
                            "Medizinerin, die auf die Behandlung von Notfällen spezialisiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ad87b94-5162-4886-8f74-279b2f79a36d",
                                "sense_id": "0bf87da2-6c5c-36db-aaaa-f67cc22d0ccf",
                                "text": "Die Notärztin kam nicht mehr rechtzeitig zur Unfallstelle und konnte nur noch den Tod des Lkw-Fahrers feststellen."
                            },
                            {
                                "example_id": "280770ee-c45a-4bee-9ab7-7746bc2e99bf",
                                "sense_id": "0bf87da2-6c5c-36db-aaaa-f67cc22d0ccf",
                                "text": "„Bis zur Rente arbeitete sie als Anästhesistin in einer Klinik und ließ sich außerdem zur Notärztin ausbilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
