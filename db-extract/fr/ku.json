                                "target_senses": [
                                    {
                                        "sense_id": "de202a35-ca4b-341e-a384-5b19d3ac0518",
                                        "entry_id": "42012c08-7325-3797-ae00-9d8402585c75",
                                        "glosses": [
                                            "The name of the Latin-script letter Q/q. Alternative form of cue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
