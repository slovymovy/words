                                            },
                                            {
                                                "example_id": "4d038520-b81c-4bae-83a8-d94b052fcd70",
                                                "sense_id": "2c5ba947-193b-333e-bcc0-459b37cdc038",
                                                "text": "Forme rhomboïdale."
                                            },
                                            {
                                                "example_id": "e93958ec-21e8-4fa1-b362-a5b5da43790b",
                                                "sense_id": "2c5ba947-193b-333e-bcc0-459b37cdc038",
                                                "text": "Des bâtiments aux formes les plus étranges - hexagonale, pentagonale, rhomboïdale, pyramidale - étaient disposés dans un parfait chaos, qui pourtant semblait avoir un sens caché"
                                            }
