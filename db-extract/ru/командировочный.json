                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "An assigned task."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4074e1b9-2938-4aec-a663-891a42c9388d",
                                                "sense_id": "f8c1224f-7654-360d-919e-8430116093f6",
                                                "text": "The assignment the department gave him proved to be quite challenging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031fafe4-4441-36f9-861c-c048081ba522",
                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "A position to which someone is assigned."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9166de2-b9e0-4cdf-a77c-103a5ade2536",
                                                "sense_id": "031fafe4-4441-36f9-861c-c048081ba522",
                                                "text": "Unbeknownst to Mr Smith, his new assignment was in fact a demotion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c10294-3cc8-34bd-8981-138077eb59ea",
                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "A task given to students, such as homework or coursework."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9281c909-a2ec-4c09-ad7f-d0cce28cc987",
                                                "sense_id": "34c10294-3cc8-34bd-8981-138077eb59ea",
                                                "text": "Mrs Smith gave out our assignments, and said we had to finish them by Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2f55576-db80-35b1-b617-4d0d7b8c8797",
                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "A transfer of a right or benefit from one person to another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "062ca8b5-b159-4e15-b72e-9c2bb9563ec4",
                                                "sense_id": "e2f55576-db80-35b1-b617-4d0d7b8c8797",
                                                "text": "The assignment of the lease has not been finalised yet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97aceffb-abba-37b5-af20-a96b5ad078eb",
                                        "entry_id": "1a936b6d-9153-3586-9316-e2dc4be872af",
                                        "glosses": [
                                            "A document that effects this transfer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da6ff47e-e249-4988-abd6-c6322e87b46f",
                                                "sense_id": "97aceffb-abba-37b5-af20-a96b5ad078eb",
