                    }
                ],
                "translations": [
                    {
                        "translation_id": "f40a03ae-b712-4be5-b68d-aca480f2e979",
                        "source_entry_id": "c56ded74-9ef6-3bac-8e1a-4fc98fed0d30",
                        "source_sense_description": "ребёнок, растущий без отца",
                        "target_lang_word": "orphelin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orphelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64896a83-854b-33a4-8b28-5d198a5bd758",
                                        "entry_id": "221cf7eb-a7de-3390-bed0-c3c22f14629a",
                                        "glosses": [
                                            "Qui a perdu son père et sa mère, ou l’un des deux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d01c3c6-607f-4aeb-b9aa-b0162602ca8c",
                                                "sense_id": "64896a83-854b-33a4-8b28-5d198a5bd758",
                                                "text": "Un jour, les femmes cherchèrent leurs maris, les maris cherchèrent leurs femmes, les pères cherchèrent leurs enfants, et les enfants se crurent orphelins : tout était sens dessus dessous!"
                                            },
                                            {
                                                "example_id": "93006dca-eca1-4d08-ba9f-11ab00f6c4d4",
                                                "sense_id": "64896a83-854b-33a4-8b28-5d198a5bd758",
                                                "text": "L’orphelin faible et nu, m’a-t-on vu l’outrager ?"
                                            },
                                            {
                                                "example_id": "3c9abbb1-f987-43d5-a635-5839ca1a266c",
                                                "sense_id": "64896a83-854b-33a4-8b28-5d198a5bd758",
                                                "text": "La bonne amie de Pierrotte s’appelait Roberte, la grande Roberte. C’était une belle magnanarelle de dix-huit ans, orpheline comme lui, pauvre comme lui, mais sachant très bien lire et écrire, ce qui, dans les villages cévenols, est encore plus rare qu’une dot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1506a154-9e67-388a-ac66-4380bed7e246",
                                        "entry_id": "221cf7eb-a7de-3390-bed0-c3c22f14629a",
                                        "glosses": [
                                            "Qui a perdu ses parents, parrains et marraines, supérieurs ou antécédents."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba22827a-0114-4e04-8e9d-89d66a99e6ad",
                                                "sense_id": "1506a154-9e67-388a-ac66-4380bed7e246",
                                                "text": "Une cause orpheline."
                                            },
                                            {
                                                "example_id": "5c08d2b6-7f09-4475-841a-82bc32c203ba",
                                                "sense_id": "1506a154-9e67-388a-ac66-4380bed7e246",
                                                "text": "Une page Web orpheline est une page vers laquelle aucune autre ne pointe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14b33e29-d112-321f-90fd-6d37a2cd4b6f",
                                        "entry_id": "221cf7eb-a7de-3390-bed0-c3c22f14629a",
                                        "glosses": [
                                            "Qui n’a pas d’hyperlien pointant vers lui."
                                        ],
                                        "tags": [
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e28e5ef2-fbb2-4ae9-84b2-3a3c61a7bb3a",
                                                "sense_id": "14b33e29-d112-321f-90fd-6d37a2cd4b6f",
                                                "text": "Article orphelin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "orphelin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "593bae99-164d-3acf-9147-2a80667e238f",
                                        "entry_id": "1f6ef139-71c5-3c30-b211-5b1d02dee9f6",
                                        "glosses": [
                                            "Enfant qui a perdu son père et sa mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c55097ca-990d-4145-be8e-58648ace006b",
                                                "sense_id": "593bae99-164d-3acf-9147-2a80667e238f",
                                                "text": "Je ne puis voir un pauvre sans lui donner ma bourse. J’ai doté des orphelines, établi des jeunes gens méritants, nourri des vieillards, fondé des hospices."
                                            },
                                            {
                                                "example_id": "886091a7-3fe3-45bd-bb3b-e45d8747de6c",
                                                "sense_id": "593bae99-164d-3acf-9147-2a80667e238f",
                                                "text": "Défendre la veuve et l’orphelin, défendre les faibles et les opprimés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f4b6f9d-9392-3308-abe5-f3a694232ba2",
                                        "entry_id": "1f6ef139-71c5-3c30-b211-5b1d02dee9f6",
                                        "glosses": [
                                            "Enfant qui a perdu son père ou sa mère → voir demi-orphelin et semi-orphelin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712fa18b-23a6-4a15-9e07-dafe22ab6e42",
                                                "sense_id": "3f4b6f9d-9392-3308-abe5-f3a694232ba2",
                                                "text": "Orphelin de père."
                                            },
                                            {
                                                "example_id": "77f18727-0271-434a-95b8-3da9f400e4cc",
                                                "sense_id": "3f4b6f9d-9392-3308-abe5-f3a694232ba2",
                                                "text": "Orphelin de mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be655a87-2ce5-37f3-a015-6bf071203d31",
                                        "entry_id": "1f6ef139-71c5-3c30-b211-5b1d02dee9f6",
                                        "glosses": [
                                            "Cigarette unitaire, mégot."
                                        ],
                                        "tags": [],
