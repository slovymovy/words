            "senses": [
                {
                    "sense_id": "08301829-11f5-33d4-95c5-a4603343b140",
                    "sense_definition": "Уменьшительно-ласкательное к <w>лавка</w>; небольшая скамейка для сидения (в саду, у дома и т. п.).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bench",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старики вечеруют и тихо беседуют, сидя на <w>лавочке</w> около своего дома.",
                            "target_lang_translations": {
                                "en": "The elderly spend the evening chatting quietly, sitting on a <w>bench</w> near their house.",
                                "es": "Los ancianos pasan la tarde y conversan tranquilamente, sentados en el <w>banco</w> cerca de su casa.",
                                "fr": "Les vieilles personnes passent la soirée à discuter doucement, assises sur un <w>banc</w> près de leur maison."
                            }
                        },
                        {
                            "text": "Мы решили ненадолго присесть на <w>лавочку</w> в тенистом парке, чтобы немного отдохнуть после долгой прогулки.",
                            "target_lang_translations": {
                                "en": "We decided to sit down on a <w>bench</w> for a bit in a shady park to rest after a long walk.",
                                "es": "Decidimos sentarnos un momento en un <w>banco</w> del parque a la sombra para descansar un poco después de un largo paseo.",
                                "fr": "Nous avons décidé de nous asseoir un instant sur un <w>banc</w> dans un parc ombragé pour nous reposer un peu après une longue promenade."
                            }
                        }
                    ],
                    "common_phrases": [
                        "присесть на лавочку",
                        "деревянная лавочка",
                        "сидеть на лавочке"
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of bench; a small seat for sitting (in a garden, near a house, etc.).",
                        "es": "Diminutivo de banco; asiento pequeño para sentarse en un jardín, junto a una casa, etc.",
                        "fr": "Petit banc pour s'asseoir (dans un jardin, près d'une maison, etc.)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bench",
                                "target_lang_sense_clarification": "small outdoor seat"
                            },
