                        "entry_id": "42901018-de0c-3c0b-b063-b3706748adf1",
                        "glosses": [
                            "Capable of being converted."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6b928eeb-9079-4a0e-910b-b9f20f173bbc",
                                "sense_id": "2fb4b464-e2fa-311d-b565-c3d084e52e42",
                                "text": "a. 1661, Henry Hammond, Sermon 7 in Sermons Preached by Henry Hammond, London: Robert Pawlet, 1675, p. 96,\n[It is] from the not exercising of faith actually, that I ever sin; and every man in the same degree, that he is a sinner, so far is he an unbeliever. So that this conversible retrogradous Sorites may shut up all."
                            },
                            {
                                "example_id": "eaf6c67b-a5eb-467e-aa57-bb1701000dec",
                                "sense_id": "2fb4b464-e2fa-311d-b565-c3d084e52e42",
                                "text": "“But what do you call right? What’s your canon of certainty there?” “The conscience that’s in us—that charming, conversible, infinite thing, the intensest thing we know. […]”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e4a9b178-89e8-3aa3-be85-3c5b4cdbd952",
                        "entry_id": "42901018-de0c-3c0b-b063-b3706748adf1",
                        "glosses": [
                            "Capable of being substituted or swapped (with another thing)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e9451195-fded-44cc-ae54-3e5283d8d016",
                                "sense_id": "e4a9b178-89e8-3aa3-be85-3c5b4cdbd952",
                                "text": "Reciprocal signs I call those that are conversible with the thing they are the signs of."
                            },
                            {
                                "example_id": "b0aeccd0-b119-417a-bd00-f107ed7a90d7",
                                "sense_id": "e4a9b178-89e8-3aa3-be85-3c5b4cdbd952",
                                "text": "[These] were with me, terms full as conversible as —"
                            }
                        ]
                    }
