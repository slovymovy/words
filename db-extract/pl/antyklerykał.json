                ],
                "senses": [
                    {
                        "sense_id": "4a7daf65-e19b-3778-aa9c-f071319a4414",
                        "entry_id": "c17ffe57-fc23-3bd6-9d1e-95baf663090b",
                        "glosses": [
                            "przeciwnik klerykalizmu, zwolennik antyklerykalizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb546308-147f-4465-bcba-7bf1a65e6906",
                                "sense_id": "4a7daf65-e19b-3778-aa9c-f071319a4414",
                                "text": "Oczywiście, antyklerykałowie i niewierzący to nie są zbiory tożsame. Są wierzący antyklerykałowie i niewierzący, którzy nie przejawiają wrogich uczuć do Kościoła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "45bd0098-2d47-4c76-823a-01e1980d4e74",
                        "source_entry_id": "c17ffe57-fc23-3bd6-9d1e-95baf663090b",
                        "source_sense_id": "4a7daf65-e19b-3778-aa9c-f071319a4414",
                        "target_lang_word": "anticlerical",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticlerical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "037a1b63-4e5d-39d2-adaa-14342c5c0ef1",
                                        "entry_id": "bf0235e7-7066-3bf3-b276-42bbe47448d2",
                                        "glosses": [
                                            "Opposed to political influence of clerics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anticlerical",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19aa0e05-6d2c-37d1-a651-7166852bcc9d",
                                        "entry_id": "85031091-acae-3b21-acc9-471a6719d3f4",
                                        "glosses": [
                                            "One who opposes the political influence of clerics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5792f65-d117-45c7-af22-86097ce7898e",
                                                "sense_id": "19aa0e05-6d2c-37d1-a651-7166852bcc9d",
                                                "text": "'I think I am an anti-clerical,' Father Brown would say with a faint smile; 'but there wouldn't be half so much clericalism if they would only leave things to the clerics.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21ea12ee-05ec-4709-8ce2-caf701152a40",
                        "source_entry_id": "c17ffe57-fc23-3bd6-9d1e-95baf663090b",
                        "source_sense_id": "4a7daf65-e19b-3778-aa9c-f071319a4414",
                        "target_lang_word": "anticlérical",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticlérical",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c78981cb-3b56-3934-ae1e-606973aa8141",
                                        "entry_id": "9b8dfd45-4985-3a1b-b95a-70a60db112fe",
                                        "glosses": [
                                            "Relatif à l’anticléricalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f42f469-a04d-4513-92f2-2c771b075d91",
                                                "sense_id": "c78981cb-3b56-3934-ae1e-606973aa8141",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            },
                                            {
                                                "example_id": "0b5aeec6-21ab-482e-a474-9b4dc5b807d0",
                                                "sense_id": "c78981cb-3b56-3934-ae1e-606973aa8141",
                                                "text": "C'est pourquoi le politicien anticlérical fait élever son Elodie chez les bonnes soeurs. Ainsi il donne à son produit une marque supérieure qui en augmente le prix."
                                            },
                                            {
                                                "example_id": "e0e3081f-22bd-48df-82dd-7e537dff08ff",
                                                "sense_id": "c78981cb-3b56-3934-ae1e-606973aa8141",
                                                "text": "Vous le verrez, sous un habit persan, c’est la froideur anglaise, les idées françaises, l’esprit plus anticlérical que M. Clemenceau."
                                            },
                                            {
                                                "example_id": "f8e422b0-596d-40f9-83d9-c6bbb6e3b8ec",
                                                "sense_id": "c78981cb-3b56-3934-ae1e-606973aa8141",
                                                "text": "Nous sommes en chemin vers une affirmation paradoxale : plus je suis croyant, moins je devrais le montrer. La laïcité est anticléricale et non antireligieuse, comme l’actera la loi de décembre 1905."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticlérical",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85ad9425-b876-3dc4-8350-2d32a9acf046",
                                        "entry_id": "00e1c99e-23e1-386d-9970-590be212e2c5",
                                        "glosses": [
                                            "Personne qui professe l'anticléricalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f52a9a1-1e86-4ebd-925d-a3155f4e6a3c",
                                                "sense_id": "85ad9425-b876-3dc4-8350-2d32a9acf046",
                                                "text": "Mais Victor Schoelcher est aussi un militant républicain et un anticlérical convaincu."
                                            },
                                            {
                                                "example_id": "fd2044bb-e929-407a-85fc-c302a5bc962c",
                                                "sense_id": "85ad9425-b876-3dc4-8350-2d32a9acf046",
                                                "text": "En province, […], toute fille qui devient amante « fait une faute » ; le terme est significatif. […]. Si elle est institutrice, on la dénonce, car la fornication est un péché mortel, même chez les anticléricaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42653093-6ed1-4d4d-9621-92b77a1cdd19",
                        "source_entry_id": "c17ffe57-fc23-3bd6-9d1e-95baf663090b",
