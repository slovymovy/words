                        ],
                        "examples": [
                            {
                                "example_id": "37b7314e-1ed0-4ffc-862d-4066d9969504",
                                "sense_id": "6cfb7203-1f39-377e-8f3a-6c39ce9875c7",
                                "text": "Wil ik je niet een stelletje prima kwaliteit gladakkers oversturen ter veredeling van het pointersras."
                            }
                        ]
                    },
                    {
                        "sense_id": "18f89ca3-1515-3547-aa47-57941b72fe1c",
                        "entry_id": "22080341-4b34-37c0-af6e-a21289e8f599",
                        "glosses": [
                            "iemand die alles doet om aan de kost te komen, vandaar ook: gewiekst, listig persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "73a817c6-007a-4875-b38c-b065c799ed2b",
                                "sense_id": "18f89ca3-1515-3547-aa47-57941b72fe1c",
                                "text": "Een vrouw kan zomaar vallen voor de charmes van een gladakker, dubieuze handelaar of iemand uit Den Haag."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1e0b801-2a64-39db-b68c-98f9a27beaaf",
                        "entry_id": "22080341-4b34-37c0-af6e-a21289e8f599",
                        "glosses": [
                            "onbetrouwbaar en verdorven persoon, slechterik"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "253109ff-07e7-44d9-a245-5128a4bebad1",
                                "sense_id": "c1e0b801-2a64-39db-b68c-98f9a27beaaf",
                                "text": "Ik maak me nooit zorgen om de toekomst, maar toen ik die gladakker van een Pastors met zo’n eng lachje zag zeggen dat hij nu met vakantie naar Marokko ging zag ik het even heel erg somber in."
                            }
                        ]
                    }
