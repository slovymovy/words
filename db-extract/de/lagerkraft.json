                            {
                                "example_id": "8613ae28-cc8d-4b4a-9150-07d2a300466f",
                                "sense_id": "97b5480e-6b9a-3312-93f4-f48c671ca10f",
                                "text": "Eine freie Stelle als Lagerkraft Hoch- und Tiefbau (m/w) bei Carl Beutlhauser Baumaschinen GmbH findest du im Stellenmarkt."
                            },
                            {
                                "example_id": "9849275e-86ea-4030-9454-b859f027497e",
                                "sense_id": "97b5480e-6b9a-3312-93f4-f48c671ca10f",
                                "text": "Lagerkraft mit Staplerschein [gesucht]."
                            },
                            {
                                "example_id": "8276a1f6-86b5-46c7-a902-ab4071dd8dcb",
                                "sense_id": "97b5480e-6b9a-3312-93f4-f48c671ca10f",
                                "text": "Für eine abwechslungsreiche und spannende Tätigkeit als Lagerkraft (m/w) suchen wir Sie in Festanstellung ab sofort."
                            },
                            {
                                "example_id": "c1a12c85-b861-4930-bb78-179505ba0fc2",
                                "sense_id": "97b5480e-6b9a-3312-93f4-f48c671ca10f",
                                "text": "Hier auf arbeiten.de, der Alternative zum Arbeitsamt, finden Sie Jobs als Lagerkraft."
                            },
                            {
                                "example_id": "3746964d-dc46-40f9-96d8-659b7132a420",
                                "sense_id": "97b5480e-6b9a-3312-93f4-f48c671ca10f",
                                "text": "Für ein Unternehmen der Getränkebranche im Raum Ustersbach, suchen wir ab sofort für einen langfristigen Einsatz eine Lagerkraft mit Staplerschein (m/w)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "40639f70-51df-32a5-b356-260508da6239",
                        "entry_id": "d0a11955-cc59-3cf0-9a1e-08d4f19b03a2",
                        "glosses": [
                            "auftretende Kraft bei der Lagerung, zum Beispiel eines Trägers auf Stützen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "7a296088-b8be-482b-83dc-e7afa0aba86e",
                                "sense_id": "40639f70-51df-32a5-b356-260508da6239",
                                "text": "Schon ein Lagerspiel von 1 mm bewirkt eine verhältnismässig grosse Relativgeschwindigkeit zwischen Brückenträger und Lagerunterteil nach dem Durchfahren des Lagerspiels und eine entsprechende enorme Lagerkraft, so dass eine Bemessung des Lagers ohne Ausnützung seines plastischen Verformungsvermögens praktisch unmöglich ist."
                            },
                            {
                                "example_id": "bacc9241-fec5-43ee-964b-096f8de03a8f",
                                "sense_id": "40639f70-51df-32a5-b356-260508da6239",
                                "text": "Um die Berechnung der Lagerkräfte bei Balkenaufgaben zu veranschaulichen, dient uns hier ein Beispiel."
                            }
                        ],
