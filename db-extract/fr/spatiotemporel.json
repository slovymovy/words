                ],
                "senses": [
                    {
                        "sense_id": "3315c7ee-c6a1-3d65-9898-0b7a5472e074",
                        "entry_id": "b8419fb1-14fb-33e9-9f6e-5f0f08b29052",
                        "glosses": [
                            "Relatif à la fois à l’espace et au temps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ded56494-9db7-402f-b1a5-29021bc65106",
                                "sense_id": "3315c7ee-c6a1-3d65-9898-0b7a5472e074",
                                "text": "Derrière un nom assez complexe, la visualisation de données spatiotemporelles cache un concept très simple."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a412a15-e3e6-3a3f-9b27-4476a98f3d55",
                        "entry_id": "b8419fb1-14fb-33e9-9f6e-5f0f08b29052",
                        "glosses": [
                            "Relatif à l’espace-temps."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "09efc957-b3d7-4f55-a3eb-13b749c4722c",
                                "sense_id": "9a412a15-e3e6-3a3f-9b27-4476a98f3d55",
                                "text": "Partant des remarques de M. Vigier, on pourrait notamment chercher à se représenter les corpuscules matériels (et également les photons) comme des singularités au sein d'un champ spatiotemporel à caractère ondulatoire, dont la structure ferait intervenir le quantum d'action de Planck."
                            },
                            {
                                "example_id": "2dda2d71-7f6b-4d6c-a1f7-97e28f75fe5b",
                                "sense_id": "9a412a15-e3e6-3a3f-9b27-4476a98f3d55",
                                "text": "Cette fois, le voici lancé à la poursuite du cadran d’Archimède, un artefact qui permet de localiser les failles spatiotemporelles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c18dbfa3-0c4d-4a1c-b3d0-1adb35dd9a32",
                        "source_entry_id": "b8419fb1-14fb-33e9-9f6e-5f0f08b29052",
                        "source_sense_description": "relatif à l’espace et au temps",
                        "target_lang_word": "spatiotemporal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spatiotemporal",
