                    },
                    {
                        "translation_id": "2fdc3faf-4f8c-49e0-839c-fddb02dae66b",
                        "source_entry_id": "80fd2d53-6deb-38b9-811f-7af91508c539",
                        "source_sense_id": "56ab6f34-bf9c-3e3d-aae9-5a8a8ff35053",
                        "target_lang_word": "périhélie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "périhélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                        "entry_id": "99ad0fc8-030d-3724-99e3-be04926a7b9d",
                                        "glosses": [
                                            "Sur une orbite ayant pour foyer le Soleil, le point le plus proche de celui-ci ; autrement dit, le périapside d’une orbite héliocentrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e037c9c-07ed-4386-8182-c7c7e27871a9",
                                                "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                                "text": "C’est en hiver que la Terre se trouve au périhélie de son orbite. La Terre arrive à son périhélie."
                                            },
                                            {
                                                "example_id": "7d9e950c-a81b-4694-b695-0706eafa20ce",
                                                "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                                "text": "Le périhélie de cette comète est à 400 millions de kilomètres du Soleil."
                                            },
                                            {
                                                "example_id": "340c7b00-65c8-4255-8c14-83e7e2cf1213",
                                                "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                                "text": "Le passage au périhélie de cet astre est prévu le 29 janvier."
                                            },
                                            {
                                                "example_id": "ec555ca1-7fa5-4167-afb0-f10b5b349ef7",
                                                "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                                "text": "Il ne s’agit pas de calculer les dixièmes de seconde d’arc de précession du périhélie de Mercure; il s'agit de juger si la masse de Jupiter est de deux fois, ou de quatre fois, celle de Saturne."
                                            },
                                            {
                                                "example_id": "e6ad86b5-9554-4d5c-ac9c-793223dc33b3",
                                                "sense_id": "aa9b77ad-526b-33a7-92b1-9d771d84c826",
                                                "text": "En novembre 1915, ayant calculé la courbure de l’espace-temps créée par le soleil, Einstein annonce que l’avance du périhélie de Mercure s’élève à 43°."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "périhélie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d25ddc7-d1e8-3eec-9f9d-a02d9e28fd5f",
                                        "entry_id": "636fbec6-df59-3ef1-8473-52e6a44cf825",
                                        "glosses": [
                                            "Qui est le plus rapproché du Soleil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f3465a5-2327-473d-b28c-917c8926ad34",
                                                "sense_id": "6d25ddc7-d1e8-3eec-9f9d-a02d9e28fd5f",
                                                "text": "Cette planète est périhélie."
                                            }
                                        ]
                                    }
                                ]
                            }
