                "senses": [
                    {
                        "sense_id": "96fdd1da-40e3-3593-82c8-52bea65bf94b",
                        "entry_id": "adb69397-24a9-3ea4-9eee-1ac33706ff1f",
                        "glosses": [
                            "iemand niet gunnen dat die iets heeft dat men zelf wil hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7ec43f-5c39-46f7-8c3d-962cee1dbf01",
                                "sense_id": "96fdd1da-40e3-3593-82c8-52bea65bf94b",
                                "text": "Hij is nogal afgunstig, vooral op zijn buurman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05ec0b5d-f390-4b68-8cb0-286f7720bade",
                        "source_entry_id": "adb69397-24a9-3ea4-9eee-1ac33706ff1f",
                        "source_sense_id": "96fdd1da-40e3-3593-82c8-52bea65bf94b",
                        "source_sense_description": "iemand niet gunnen dat die iets heeft dat men zelf wil hebben",
                        "target_lang_word": "envious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fc68938-3a5c-3a4b-8b3b-29d0f1891163",
                                        "entry_id": "06d16a12-43fa-3739-8dfa-65b9d487fa7f",
                                        "glosses": [
                                            "Feeling or exhibiting envy; jealously desiring the excellence or good fortune of another; maliciously grudging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e021057-6c1e-4e79-9552-59e096eb2d62",
                                                "sense_id": "2fc68938-3a5c-3a4b-8b3b-29d0f1891163",
                                                "text": "an envious man, disposition, or attack; envious tongues"
                                            },
                                            {
                                                "example_id": "3e400592-7f74-479d-958c-7ca04991603e",
                                                "sense_id": "2fc68938-3a5c-3a4b-8b3b-29d0f1891163",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "27cd37bc-a099-4ea5-a0ae-2f75ad5034b4",
                                                "sense_id": "2fc68938-3a5c-3a4b-8b3b-29d0f1891163",
                                                "text": "My soul is envious of mine eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e772f77c-80dd-3d56-a40c-a8d818de16e4",
                                        "entry_id": "06d16a12-43fa-3739-8dfa-65b9d487fa7f",
                                        "glosses": [
                                            "Excessively careful; cautious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc0db85-ed04-49ca-bc24-7b48c845900f",
                                                "sense_id": "e772f77c-80dd-3d56-a40c-a8d818de16e4",
                                                "text": "for no man was ever so amorous, as to love a toad; none so envious, as to repine at the condition of the miserable"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1bc8ef6-df69-34c3-940a-677baa2e3236",
                                        "entry_id": "06d16a12-43fa-3739-8dfa-65b9d487fa7f",
                                        "glosses": [
                                            "Malignant; mischievous; spiteful."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0973e58-54b2-4971-bfb9-890cc6b601bd",
                                                "sense_id": "b1bc8ef6-df69-34c3-940a-677baa2e3236",
                                                "text": "Each envious brier his weary legs doth scratch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "646a936b-b4bd-3cad-8031-6ee288be2ba6",
                                        "entry_id": "06d16a12-43fa-3739-8dfa-65b9d487fa7f",
                                        "glosses": [
                                            "Inspiring envy."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9852205d-3e78-41a2-9eb5-d0f899d02621",
                                                "sense_id": "646a936b-b4bd-3cad-8031-6ee288be2ba6",
                                                "text": "He to him leapt, and that same envious gage / Of victors glory from him snatcht away."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7fba75c-d176-44c0-b6ab-aff2a0a19344",
                        "source_entry_id": "adb69397-24a9-3ea4-9eee-1ac33706ff1f",
                        "source_sense_id": "96fdd1da-40e3-3593-82c8-52bea65bf94b",
                        "source_sense_description": "iemand niet gunnen dat die iets heeft dat men zelf wil hebben",
                        "target_lang_word": "jealous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jealous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Suspecting rivalry in love; troubled by worries that one might have been replaced in someone's affections; suspicious of a lover's or spouse's fidelity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17584d40-0e0d-4f96-9f3f-b15a20216bda",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "jealous rage"
                                            },
                                            {
                                                "example_id": "cf218791-c704-407b-b015-0913c4173608",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "jealous lover"
                                            },
                                            {
                                                "example_id": "17db4c8c-0401-47d8-876c-6c2b8af97de8",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "She gave him a jealous look."
                                            },
                                            {
                                                "example_id": "304471a8-b8b1-4621-9175-7da4c4d6133e",
                                                "sense_id": "2c6126ae-e267-3da5-aa47-d0e24119dbbf",
                                                "text": "She stopped, and laid her hand upon his golden head, and then bent down and kissed his brow with a chastened abandonment of tenderness that would have been beautiful to behold had not the sight cut me to the heart - for I was jealous!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Protective; zealously guarding; careful in the protection of something (or someone) one has or appreciates, especially one's spouse or lover."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbd1bc68-7b31-46b9-bf20-43253584cfd4",
                                                "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                                "text": "Thou ſhalt not bow downe thy ſelfe to them, nor ſerue them: For I the Lord thy God am a iealous God, viſiting the iniquitie of the fathers vpon the children, vnto the thirde and fourth generation of them that hate me:"
                                            },
                                            {
                                                "example_id": "3280419a-78a0-42d8-8966-97bee94b6a40",
                                                "sense_id": "96ec7fbc-f944-313d-847f-d1e5293a3b78",
                                                "text": "Soft Simon had reduced himself to the lowest class of Stalkos, or walking gentlemen, as they are termed; men who have nothing to do, and no fortune to support them, but who style themselves esquire; and who […] are jealous of that title, and of their claims to family antiquity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Envious; feeling resentful or angered toward someone for a perceived advantage or success, material or otherwise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d13f98e-a051-46e1-b851-d7c3587a7368",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "be jealous of someone/something"
                                            },
                                            {
                                                "example_id": "b3a042e8-1f38-47b3-80c5-fbdf12333a24",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "He was jealous of his friend’s success."
                                            },
                                            {
                                                "example_id": "e4c3a00e-58e7-4b58-9c34-346fab6c9eae",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "I'm jealous because I'm single."
                                            },
                                            {
                                                "example_id": "85c0c2bb-6b35-4ced-9dd8-c1e695ce227c",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "I am jealous of everything whose beauty does not die."
                                            },
                                            {
                                                "example_id": "0570d788-016b-461f-abf8-e327798c18ab",
                                                "sense_id": "714bdaf4-1a8f-3b45-9bbd-fd2d1e3718b7",
                                                "text": "The neighbouring towns were jealous of this honourable supremacy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                        "entry_id": "b82817bd-d52f-3f51-890b-9ebb05d1fe23",
                                        "glosses": [
                                            "Suspicious; apprehensive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe5d6f9b-8d26-48c5-8f29-a966e7f30b55",
                                                "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                                "text": "I began my fence or wall; which, being still jealous of my being attacked by somebody, I resolved to make very thick and strong."
                                            },
                                            {
                                                "example_id": "ee7cb869-5bdb-4194-8620-a879687fcd86",
                                                "sense_id": "ff2dbddf-4765-3b8e-b748-6566d42adbbe",
                                                "text": "At length […] the Duke demanded to know of Durward who his guide was, […] and wherefore he had been led to entertain suspicion of him. To the first of these questions Quentin Durward answered by naming Hayraddin Maugrabin, the Bohemian; […] and in reply to the third point he mentioned what had happened in the Franciscan convent near Namur, how the Bohemian had been expelled from the holy house, and how, jealous of his behaviour, he had dogged him to a rendezvous with one of William de la Marck's lanzknechts, where he overheard them arrange a plan for surprising the ladies who were under his protection."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jealous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                        "entry_id": "65ffdda7-dc40-3033-95d4-b40d1f559eff",
                                        "glosses": [
                                            "To harass or attack (somebody) out of jealousy."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ceeda6f-3ed9-4777-b4b9-7bc5670a7dd3",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "If I go back, he starts his jealousing again. Drinking and jealousing."
                                            },
                                            {
                                                "example_id": "3bea9587-58b6-4b62-9230-8bb5d4dac65c",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "Jealousing can take place: You may notice some of your fellow female co-workers that can be jealousing you."
                                            },
                                            {
                                                "example_id": "a4815039-27d1-4011-81d1-a725096ed583",
                                                "sense_id": "486a7207-5471-3601-9183-b705f6b89e64",
                                                "text": "But another part of me is jealousing because Xifeng is looking at Ify like she is special, almost like she is wanting to call her daughter, and I am wanting Xifeng all to myself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "403fab52-26e6-38f1-b9b3-7431525599dd",
                                        "entry_id": "65ffdda7-dc40-3033-95d4-b40d1f559eff",
                                        "glosses": [
                                            "To deliberately make (someone) jealous of another person's (often their partner's) associations with other people."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbba0190-48d3-4291-82cb-b26b3b5cd0c6",
                                                "sense_id": "403fab52-26e6-38f1-b9b3-7431525599dd",
                                                "text": "[…] where the victim of an assault had been 'jealousing' the offender about her sister."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
