                                                "example_id": "5b54acb8-977f-49a5-a2ac-abc43951606c",
                                                "sense_id": "10682f86-e26b-38b7-977f-a573d0604299",
                                                "text": "La fabrication des étoffes de laine, des soieries."
                                            },
