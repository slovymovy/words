                        "entry_id": "db7283ab-015b-3791-8730-7aa4217dc0d2",
                        "glosses": [
                            "To withdraw from volunteering; to revoke one's own voluntary status."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bc7cf318-79c8-446e-aecc-6f08a58da9ad",
                                "sense_id": "e0f73b28-033e-3892-a149-7753dedaf890",
                                "text": "Which means, in practice, that quite often we expect to unvolunteer whenever we feel like it. If our feelings are hurt, we unvolunteer. We go AWOL at our convenience, and think there should be no consequences."
                            },
                            {
                                "example_id": "70781d4d-1ff2-4c99-9074-060792b2998c",
                                "sense_id": "e0f73b28-033e-3892-a149-7753dedaf890",
                                "text": "The IRS won't tell you how to “unvolunteer” or how your consent was procured, because they want everyone to be indentured government slaves in violation of the Thirteenth Amendment."
                            }
                        ]
                    }
