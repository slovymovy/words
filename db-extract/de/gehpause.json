                "senses": [
                    {
                        "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                        "entry_id": "54d1f5af-690f-30d2-817f-bf0899102df3",
                        "glosses": [
                            "kurze Phase des Gehens während einer anderen (anspruchsvollen) Aktivität (wie Laufen oder Training)"
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7b262ac9-df95-43e1-8233-63766f40cac4",
                                "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                                "text": "„Ein Marathon im Dauerlauftempo, zudem immer wieder unterbrochen durch geplante Gehpausen, das schadet nicht, erhöht durch den langen Lauf eher den Trainingserfolg.“"
                            },
                            {
                                "example_id": "cf89268f-b693-414a-91f3-d966b479c47a",
                                "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                                "text": "„Beim extensiven Intervalltraining sind die Gehpausen kurz gehalten, damit der Puls etwa auf 65–70% deiner maximalen Herzfrequenz sinken kann.“"
                            },
                            {
                                "example_id": "fd1c53dc-6854-4f3b-a680-a344d05776cb",
                                "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                                "text": "„Anfänger: Für Laufeinsteiger ist das primäre Ziel, die 10 km ohne Gehpausen zu absolvieren.“"
                            },
                            {
                                "example_id": "09549bf7-42b0-4ea4-a24e-90b3c94890ca",
                                "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                                "text": "„Gehpausen sind in der Anfängergruppe selbstverständlich, besonders wenn es bergig wird.“"
                            },
                            {
                                "example_id": "ebcd52b9-f12f-4b02-8283-005077fae5ee",
                                "sense_id": "807b057d-a4dc-3ba5-ab6f-203df9709d73",
                                "text": "„Mein Laufziel war aber nicht, eine möglichst gute Zeit zu erreichen, sondern die Anstiege möglichst ohne Gehpause hochzulaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
