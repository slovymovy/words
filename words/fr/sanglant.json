                    "frequency": "Middle",
                    "semantic_group_id": "couvert_de_sang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a retiré ses gants <w>sanglants</w> après la longue opération.",
                            "target_lang_translations": {
                                "en": "The doctor took off his <w>bloody</w> gloves after the long operation.",
                                "ru": "Врач снял свои <w>окровавленные</w> перчатки после долгой операции.",
                                "de": "Der Arzt zog nach der langen Operation seine <w>blutigen</w> Handschuhe aus.",
                                "es": "Tras la larga operación, el médico se quitó los guantes <w>ensangrentados</w>.",
                                "zh": "长时间的手术结束后，医生摘下了<w>带血的</w>手套。"
                            }
