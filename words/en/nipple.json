                    "frequency": "Middle",
                    "semantic_group_id": "baby_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby refused to drink because the <w>nipple</w> on the bottle was too hard.",
                            "target_lang_translations": {
                                "zh": "婴儿拒绝喝奶，因为奶瓶上的<w>奶嘴</w>太硬了。"
                            }
                        },
                        {
                            "text": "Make sure to sterilize the bottle <w>nipple</w> before every use.",
                            "target_lang_translations": {
                                "zh": "每次使用前请务必对奶瓶<w>奶嘴</w>进行消毒。"
                            }
