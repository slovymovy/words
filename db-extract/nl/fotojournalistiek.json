                        "examples": [
                            {
                                "example_id": "b73c0334-a0fe-4749-9356-de82e3a25864",
                                "sense_id": "ee9bf0af-c4cf-35fd-8e92-f6fc4836f175",
                                "text": "De Canon Prijs voor vernieuwende fotojournalistiek ging naar Rob Hornstra en Arnold van Bruggen. Zij maakten The Sochi Project, een fotoserie over de omstreden Olympische Spelen in Rusland."
                            },
                            {
                                "example_id": "b837b0c7-66d1-4a40-8c63-da0e417b6e99",
                                "sense_id": "ee9bf0af-c4cf-35fd-8e92-f6fc4836f175",
                                "text": "Sacha de Boer vertrekt na 17 jaar bij de NOS en gaat zich nu helemaal richten op de fotojournalistiek."
                            },
                            {
                                "example_id": "d4ef8296-e5cb-4912-9723-b6d73846e6f4",
                                "sense_id": "ee9bf0af-c4cf-35fd-8e92-f6fc4836f175",
                                "text": "In 2004 ging hij met pensioen, nadat hij 48 jaar voor AP had gewerkt. \"Horst Faas was toonaangevend in de fotojournalistiek. Zijn buitengewone inzet om moeilijke verhalen te vertellen was uniek en opmerkelijk\", zegt Santiago Lyon, vicepresident van AP."
                            }
                        ]
                    }
