                "senses": [
                    {
                        "sense_id": "ff2807cf-c17a-3740-bdbb-ee0032a0b959",
                        "entry_id": "40d71477-f388-37ab-83c1-d83023f90d66",
                        "glosses": [
                            "miewający kaprysy, łatwo ulegający kaprysom; taki, który jest zmienny, niestały, działający pod wpływem kaprysu"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43264464-c9ab-413f-8da1-2460acf1c15e",
                        "source_entry_id": "40d71477-f388-37ab-83c1-d83023f90d66",
                        "source_sense_id": "ff2807cf-c17a-3740-bdbb-ee0032a0b959",
                        "target_lang_word": "capricious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capricious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                        "entry_id": "523a41c1-9ed8-3f1f-bd74-d5473cd1db43",
                                        "glosses": [
                                            "Impulsive and unpredictable; determined by chance, impulse, or whim."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f547e6ac-619c-4ad1-9e0f-5db1a65fcc5c",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "I almost died in a capricious winter storm."
                                            },
                                            {
                                                "example_id": "18399f7f-61a1-4504-86f4-011a25d88e85",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "Stringent rulers are unlikely to act capriciously."
                                            },
                                            {
                                                "example_id": "91f79306-c73b-46e1-898f-a78553365dad",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "I am heere with thee, and thy Goats, as the moſt capricious Poet honeſt Ouid was among Gothes."
                                            },
                                            {
                                                "example_id": "0abd0bf3-5b3c-41d5-be6a-66cc5683db76",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "\"Capricious?\" And at this monsieur began to laugh. \"Oh no, I'm not capricious. I am very faithful. I am very constant. Comprenez?\""
                                            },
                                            {
                                                "example_id": "7a509b2c-e74b-4b24-9973-e28bc94120de",
                                                "sense_id": "b75416f9-2ae0-3c40-bcb8-79466ede1839",
                                                "text": "Although much has been learned about lightning and its effects through research and study, many questions are still unanswered and the upper limits of voltage, current and total energy that may be associated with lightning are not conclusively defined. The apparent capricious nature of lightning is evidenced by the range of extremes as well as, in some cases, the unique nature of the damage that results. Thus, to predict in the absence of physical evidence the exact mechanism of ignition in this particular case is not possible. By the same reasoning, in view of the known facts of this accident, there is no logical explanation for ignition of the flammable vapors other than some effect stemming directly from the lightning strike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffa49196-b591-4c27-b5bd-5c854c66feef",
                        "source_entry_id": "40d71477-f388-37ab-83c1-d83023f90d66",
                        "source_sense_id": "ff2807cf-c17a-3740-bdbb-ee0032a0b959",
                        "target_lang_word": "capricieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "capricieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f56e5815-44e1-3dee-99ca-cd6ca5e81698",
                                        "entry_id": "d33788f3-6720-3cd2-b8a4-335609cb1e77",
                                        "glosses": [
                                            "Qui a des caprices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07bfe39a-10a4-4172-9379-a2d20d6bc7a6",
                                                "sense_id": "f56e5815-44e1-3dee-99ca-cd6ca5e81698",
                                                "text": "Le Frisé, un jouvenceau d’un an, capricieux et fantasque en diable, lui donnait surtout du fil à retordre, cherchant à profiter de tous les passages frayés dans l’une ou l’autre haie pour s’éclipser subitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4697e91d-770e-37de-b8bd-8fb388f47a61",
                                        "entry_id": "d33788f3-6720-3cd2-b8a4-335609cb1e77",
                                        "glosses": [
                                            "Qui agit de façon désordonnée, imprévisible."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e5e336-1fb2-4776-a424-14ff9dfdc447",
                                                "sense_id": "4697e91d-770e-37de-b8bd-8fb388f47a61",
                                                "text": "Le kusi est un vent réputé capricieux mais moins fort que son homologue du nord, qui souffle de façon plus laminaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f91931e-b928-3507-af7c-7dfe57f3e7a6",
                                        "entry_id": "d33788f3-6720-3cd2-b8a4-335609cb1e77",
                                        "glosses": [
                                            "Se dit de quelque chose qui ne fonctionne que par intermittence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbda4a4e-0748-4585-b3ab-a14926f5fd88",
                                                "sense_id": "1f91931e-b928-3507-af7c-7dfe57f3e7a6",
                                                "text": "Dehors la neige fondait, et les insolubles accords de sptième de dominante mêlaient leurs harmoniques au chant du ruissellement universel : tout un bruissement ponctué par le rythme capricieux des gouttières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "capricieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2555309d-cda5-3bb4-9a81-366d4ae58b32",
                                        "entry_id": "3b864043-880e-3ba2-b6b1-4af67782c1e6",
                                        "glosses": [
                                            "Homme, garçon qui a des caprices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "960be03f-42d2-410a-8383-6ec8351887c3",
                                                "sense_id": "2555309d-cda5-3bb4-9a81-366d4ae58b32",
                                                "text": "Calixte n'est pas seulement généreux, il est aussi capricieux comme un fils à papa qu'il est."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d4fb160-cf88-4f03-a054-06edf778e1b1",
                        "source_entry_id": "40d71477-f388-37ab-83c1-d83023f90d66",
