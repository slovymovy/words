                "forms": [
                    {
                        "form_id": "5483f96b-6755-4cf0-a421-4175b4946914",
                        "entry_id": "acddf99d-91aa-3081-9742-01088f6bd361",
                        "tags": [
                            "plural"
                        ],
                        "form": "chounes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42b8b460-d144-3fcd-9eb8-ae3a25a2e677",
                        "entry_id": "acddf99d-91aa-3081-9742-01088f6bd361",
                        "glosses": [
                            "Chérie."
                        ],
                        "tags": [
                            "Affectueux"
                        ],
                        "examples": [
                            {
                                "example_id": "50c91130-53ab-4cda-9a69-91d5aaee86c8",
                                "sense_id": "42b8b460-d144-3fcd-9eb8-ae3a25a2e677",
                                "text": "T’occupe ! On ne me reconnaîtra pas, avec ma barbe de papet. Et puis je saurai me débrouiller, ma choune."
                            },
                            {
                                "example_id": "f9fa2dc6-513f-4b5f-a1db-5b58ec1e9b39",
                                "sense_id": "42b8b460-d144-3fcd-9eb8-ae3a25a2e677",
                                "text": "Elle éclata soudain en sanglots. — Mais qu’est-ce qui se passe, ma choune ? fit Louis en accourant au salon."
                            }
                        ]
                    },
                    {
                        "sense_id": "53c19b1a-533e-3e32-8c95-2e344162d5d7",
                        "entry_id": "acddf99d-91aa-3081-9742-01088f6bd361",
