                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9bc4744-75d8-4f35-89c7-d16d75aedcb5",
                                "sense_id": "b099fadc-a6b7-3b11-8d53-d819235cdbdd",
                                "text": "Ich komme gerade aus Guatemala."
                            },
                            {
                                "example_id": "de3bf115-91cf-4356-9b48-6140e71dfe98",
                                "sense_id": "b099fadc-a6b7-3b11-8d53-d819235cdbdd",
                                "text": "Guatemala-Stadt ist die Hauptstadt von Guatemala."
                            },
                            {
                                "example_id": "bb5b8820-eb5e-4985-9b95-4e6f0d80ab17",
                                "sense_id": "b099fadc-a6b7-3b11-8d53-d819235cdbdd",
                                "text": "„Guatemala, tropisches Land auf der schmalen Brücke zwischen Nord- und Südamerika, ist eines der bedeutendsten Kaffeegebiete der Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
