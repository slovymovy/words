                        "entry_id": "e250f63b-7cae-3a59-8588-4ddc3a4a133e",
                        "glosses": [
                            "In an honourable manner."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "be2fd9ff-7964-4e65-8459-f0ab8fa8186d",
                                "sense_id": "5d2ad003-005b-379f-9bb1-26480b3a372d",
                                "text": "Inevitably the present extent and variety of the Belgian railways will diminish, and within the space of the ten-year plan we can expect to see a modern system concentrated on the main traffic routes like its neighbour in the Netherlands, and with its last steam locomotives and wooden coaches honourably retired to the museum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f995f394-7664-439b-a635-c8a2971e88c7",
                        "source_entry_id": "e250f63b-7cae-3a59-8588-4ddc3a4a133e",
                        "source_sense_id": "5d2ad003-005b-379f-9bb1-26480b3a372d",
                        "source_sense_description": "in an honourable manner",
                        "target_lang_word": "honorablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honorablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "da578f78-5e71-36cd-9512-00d205e3c95b",
                                        "entry_id": "cb572787-a62b-3427-9f16-4e3d07ef5902",
                                        "glosses": [
                                            "D’une manière honorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d48c6c2-3a1a-460e-bb13-56172430d67c",
                                                "sense_id": "da578f78-5e71-36cd-9512-00d205e3c95b",
                                                "text": "Mais puisqu'il est ainsi que le sort nous emporte, Qui voudrait se bander contre une loi si forte ? Suivons donc sa conduite en cet aveuglement ; qui pèche avec le ciel pèche honorablement."
                                            },
                                            {
                                                "example_id": "30112112-c112-4e48-9120-2b0773852649",
                                                "sense_id": "da578f78-5e71-36cd-9512-00d205e3c95b",
                                                "text": "L'évêque Ulphilas, qui avait le secret de l’ambassade, se rendit en diligence au camp d’Andrinople, où il fut reçu honorablement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b2da693-7e0f-39bb-86f6-e408e37bd259",
                                        "entry_id": "cb572787-a62b-3427-9f16-4e3d07ef5902",
                                        "glosses": [
                                            "D’une manière qui fait honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42e58fb-a0df-4b35-b29e-ce1ee72bf312",
                                                "sense_id": "5b2da693-7e0f-39bb-86f6-e408e37bd259",
                                                "text": "… ; les Indiens fâchés de cette mort qui leur enlevait une victime, avaient prodigué au jeune homme les plus grands soins, afin qu’il pût honorablement figurer au poteau du supplice, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
