                "senses": [
                    {
                        "sense_id": "df99d259-9a20-328d-9010-3aca26085d65",
                        "entry_id": "6aaaba44-22b2-3456-acae-019d522269ba",
                        "glosses": [
                            "einzelne Handlung, die einen Frevel gegen etwas darstellt; frevelhafte Tat"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "833c4eaf-5e95-40d2-91ed-30565c078407",
                                "sense_id": "df99d259-9a20-328d-9010-3aca26085d65",
                                "text": "„Wenn diese Freveltat nicht ihre Sühne finde, sei jedes Kind einer entmenschten Mutter vogelfrei.“"
                            },
                            {
                                "example_id": "a56fb6be-177a-4fe0-8b6f-30d5b3a7ed4f",
                                "sense_id": "df99d259-9a20-328d-9010-3aca26085d65",
                                "text": "„Ellen, das unschuldige Kind, war auf keinen Fall in die Freveltat eingeweiht, sonst hätte sie nicht so unbefangen den Aufenthalt und Besuch Cottons, dem der Sheriff schon seit mehreren Wochen nachspürte, verraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b20e0ee3-a909-4df9-97ae-fcce5c030932",
                        "source_entry_id": "6aaaba44-22b2-3456-acae-019d522269ba",
                        "source_sense_id": "df99d259-9a20-328d-9010-3aca26085d65",
                        "source_sense_description": "gehoben: einzelne Handlung, die einen Frevel gegen etwas darstellt; frevelhafte Tat",
                        "target_lang_word": "outrage",
