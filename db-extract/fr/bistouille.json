        "fr-extract.jsonl": [
            {
                "entry_id": "adec2f1d-c50c-3f93-94cd-d43ea227be65",
                "word": "bistouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a91cad1-b196-4552-afca-c3436eb549d7",
                        "entry_id": "adec2f1d-c50c-3f93-94cd-d43ea227be65",
                        "tags": [
                            "plural"
                        ],
                        "form": "bistouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "679c3c8d-bcac-36b6-ba94-12796b2b1294",
                        "entry_id": "adec2f1d-c50c-3f93-94cd-d43ea227be65",
                        "glosses": [
                            "Café chaud auquel on ajoute de l’eau-de-vie."
                        ],
                        "tags": [
                            "Nord de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "a2fedbca-7d23-4391-9ea4-2ace45373b64",
                                "sense_id": "679c3c8d-bcac-36b6-ba94-12796b2b1294",
                                "text": "Le soir, comme maintenant, il aurait eu besoin, pour posséder tout son mordant, d’une bistouille supplémentaire."
                            },
                            {
                                "example_id": "6fc20f57-cde8-4933-97a9-a7d19b2b9835",
                                "sense_id": "679c3c8d-bcac-36b6-ba94-12796b2b1294",
                                "text": "Au comptoir des cafés devant la tasse de bistouille du matin, dans la douce chaleur d'une cuisine devant le bol de chicorée posé sur la toile cirée, à la bibliothèque municipale où il va chercher quelques livres, il en rencontre qui lui confient sans réticence […] qu'ils rêvent d'un pays où les travailleurs sont au pouvoir […]."
                            },
                            {
                                "example_id": "a27fcd8e-04ef-4115-811a-827ad9d70416",
                                "sense_id": "679c3c8d-bcac-36b6-ba94-12796b2b1294",
                                "text": "Avant d'atteindre le fond de sa tasse, Karl y vidait une forte dose de liqueur de feu, gnôle, cognac ou genièvre ; alors le café changeait de nom et devenait bistouille. Une fois la bistouille consommée, il ajoutait une seconde dose pour rincer la tasse."
                            }
                        ]
                    },
                    {
                        "sense_id": "2df4d775-ad69-31c3-b0b0-21cac330d46b",
                        "entry_id": "adec2f1d-c50c-3f93-94cd-d43ea227be65",
                        "glosses": [
                            "Boisson d’origine douteuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f73d94f6-5a97-4241-8a86-45482fa89e31",
                                "sense_id": "2df4d775-ad69-31c3-b0b0-21cac330d46b",
                                "text": "À l’autre bout de l’auge de refroidissement sortait l’extérieur du tube, d’où coulait un liquide qui devait être de l’alcool\n— Je me demande à partir de quoi ils fabriquent leur bistouille, chuchota Vanninen à mon oreille, d’un air visiblement intéressé."
                            }
                        ]
                    }
                ],
