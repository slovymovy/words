                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b3b6807-221a-4985-8630-403ca723a757",
                                "sense_id": "2f9505f7-aa4c-3307-8a9d-7055f1b13f60",
                                "text": "„Das sind zwar zwei Prozentpunkte mehr als in der Vorwoche.“"
                            },
                            {
                                "example_id": "500f9f64-851b-475c-8a36-a32bed1137d6",
                                "sense_id": "2f9505f7-aa4c-3307-8a9d-7055f1b13f60",
                                "text": "„Sie stoßen sich daran, dass bei der Regierungsklausur in der Steiermark in der Vorwoche auch Nationalratspräsident Wolfgang Sobotka (ÖVP) und die Dritte Präsidentin Anneliese Kitzmüller (FPÖ) anwesend waren.“"
                            }
                        ],
