                        "sense_id": "b56f11f3-5595-3754-bc6a-86c6ae6d0850",
                        "entry_id": "d8da1b99-40ed-38c9-abdb-5044c5529b55",
                        "glosses": [
                            "Alternative spelling of kush (“marijuana”)."
                        ],
                        "tags": [
                            "alt-of",
