                        "glosses": [
                            "The part of the Earth and its atmosphere capable of supporting life."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71afa595-1399-336a-b4a0-821060e2581c",
                        "entry_id": "d649026b-09e3-37e5-a61b-211b3eaf9094",
                        "glosses": [
                            "The totality of living organisms and their environment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de379aaf-ca0f-47e0-be96-016d58a9d710",
                                "sense_id": "71afa595-1399-336a-b4a0-821060e2581c",
                                "text": "Patavig is the second of the Macedon system's giant terrestrial planets, and by far the more interesting. Most of the surface is covered by a vast sea of liquid ammonia, in which a unique aquatic ammonia-based biosphere has developed. While the frozen continents are largely bereft of life, a rich bounty of complex organisms — many larger than a human — flourish in the chilly, toxic seas."
                            }
                        ]
                    }
