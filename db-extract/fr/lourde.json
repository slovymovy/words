        "fr-extract.jsonl": [
            {
                "entry_id": "ee2d7f6b-2d0d-3f51-8ced-af5185879a60",
                "word": "lourde",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3775805b-4a36-3c67-a25a-84e64924edef",
                        "entry_id": "ee2d7f6b-2d0d-3f51-8ced-af5185879a60",
                        "glosses": [
                            "Féminin singulier de lourd."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "a8112e48-db98-4d16-8249-1c4aeadbe048",
                                "sense_id": "3775805b-4a36-3c67-a25a-84e64924edef",
                                "text": "Au moment où je poussais la lourde porte barreaudée qui séparait le hall en deux parties égales, le compresseur se mit à vibrer contre mon abdomen."
                            },
                            {
                                "example_id": "c5ed2d8f-2c6d-4ddd-ad24-3e1e9a267900",
                                "sense_id": "3775805b-4a36-3c67-a25a-84e64924edef",
                                "text": "À la fin de la huitième lune, une chaleur lourde s’étendit sur la vieille cité et ramena avec elle une effrayante recrudescence de puanteur ambiante."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "735f2e12-1b1c-3bd9-9cb0-f651f71e0efc",
                "word": "Lourde",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "37f0e28e-3e5b-3dc3-9f97-d2be8a5e00ac",
                        "entry_id": "735f2e12-1b1c-3bd9-9cb0-f651f71e0efc",
