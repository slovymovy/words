                "translations": [
                    {
                        "translation_id": "2ff3c134-0089-49f7-a51f-276f74a81541",
                        "source_entry_id": "b52bc9fa-a419-3536-a92f-dbce9903a6c2",
                        "source_sense_id": "63a157e5-2dca-33c9-948c-e1b417bb1211",
                        "target_lang_word": "insipid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insipid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4df1bdaa-5044-35cb-b447-376bef0c2855",
                                        "entry_id": "92c3dfae-c21a-3744-ac93-2f4ec4bb2926",
                                        "glosses": [
                                            "Unappetizingly flavorless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56651192-f6fd-487b-b98a-0276d6ac5e94",
                                                "sense_id": "4df1bdaa-5044-35cb-b447-376bef0c2855",
                                                "text": "The diners were disappointed with the plain, insipid soup they were served."
                                            },
                                            {
                                                "example_id": "23b5ab1e-1eb8-4e0d-849e-272ec8ac35a5",
                                                "sense_id": "4df1bdaa-5044-35cb-b447-376bef0c2855",
                                                "text": "There was no limit on drinks, and the guy next to me tucked away a few G and Ts. I confined myself to a pleasant Brewdog Ale and a glass of slightly insipid wine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b2155e-90b5-328c-a410-f78c7c60aa97",
                                        "entry_id": "92c3dfae-c21a-3744-ac93-2f4ec4bb2926",
                                        "glosses": [
                                            "Flat; lacking character or definition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e965da1-00fa-44cf-a403-5294fbcf8895",
                                                "sense_id": "74b2155e-90b5-328c-a410-f78c7c60aa97",
                                                "text": "The textbook had a most insipid presentation of the controversy."
                                            },
                                            {
                                                "example_id": "fff4b3d6-4821-4399-b829-510e9113c103",
                                                "sense_id": "74b2155e-90b5-328c-a410-f78c7c60aa97",
                                                "text": "If the secret history of books could be written, and the author’s private thoughts and meanings noted down alongside of his story, how many insipid volumes would become interesting, and dull tales excite the reader!"
                                            },
                                            {
                                                "example_id": "7f65ade4-0487-4da0-9c83-b157688f400e",
                                                "sense_id": "74b2155e-90b5-328c-a410-f78c7c60aa97",
                                                "text": "“Look at this festive assembly. All of us, gathered here together, chuckling at jokes and silliness.” [laughter] “And jackanapery.” [rim shots] “I guess there's only one thing left to say. What is this shit?” [rim shot] [laughter] “[laughs] Very good.” “You call yourselves vampires? Bah. This entire evening has been nothing but a pageant of insipid nonsense.” “[laughing] Yes.” “Worshipping at the altar of your own mediocre frivolity. A jester's hollow dance. And who is laughing?” “Yeah! [whoops] [grunts]” “Vampires are supposed to have blood orgies and slaughter circles. Gah! You have all gone soft. You even invited humans to this asinine affair.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
