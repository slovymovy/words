                "senses": [
                    {
                        "sense_id": "316b063e-6a3d-363a-a3a8-4804076105fc",
                        "entry_id": "32d45029-d5df-3bca-b132-c74038f341a5",
                        "glosses": [
                            "jawność, otwartość – pojęcie używane w kontekście upublicznienia faktów historycznych oraz sytuacji politycznej i gospodarczej w ZSRR w okresie przemian rozpoczętych przez Michaiła Gorbaczowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8c0a8a8-0548-4c5a-993a-975d0182512b",
                                "sense_id": "316b063e-6a3d-363a-a3a8-4804076105fc",
                                "text": "W Moskwie od 1985 r. rządził Michaił Gorbaczow – zaczęła się głasnost, zapowiadano pierestrojkę"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21586b5b-9543-4716-adaf-cc4b23505e90",
                        "source_entry_id": "32d45029-d5df-3bca-b132-c74038f341a5",
                        "source_sense_id": "316b063e-6a3d-363a-a3a8-4804076105fc",
                        "target_lang_word": "glasnost",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glasnost",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ffbaca1-e866-3bff-b42e-b7284acc86cd",
                                        "entry_id": "a22fa999-b762-3bb1-a710-552c401c7945",
                                        "glosses": [
                                            "1980s and early 1990s policy of the Soviet Union under Gorbachev to allow more government transparency; often paired with perestroika"
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1974ff4-c734-4ab4-a173-1d9713c63996",
                                                "sense_id": "8ffbaca1-e866-3bff-b42e-b7284acc86cd",
                                                "text": "Gorbachev would introduce glasnost (openness and freedom) and perestroika (economic restructuring) to Russia under his tenure, ultimately freeing thousands of political prisoners and dissidents and trying to address the shortages in food and goods that had become the hallmarks of the failing Soviet economy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c059f4ce-3dd3-41b4-832e-ab4fafb2d6c6",
                        "source_entry_id": "32d45029-d5df-3bca-b132-c74038f341a5",
                        "source_sense_id": "316b063e-6a3d-363a-a3a8-4804076105fc",
                        "target_lang_word": "Glasnost",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Glasnost",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd2cdb24-0983-3f10-8a3a-26f4812c13cd",
                                        "entry_id": "93d09cae-8abb-3745-abd2-8534ea0a46c8",
                                        "glosses": [
                                            "Politik: die Öffentlichkeit, die politische Öffnung, Schlagwort der Reformpolitik in der damaligen UdSSR Mitte der 1980er Jahre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04873eb4-2809-422e-80c3-cad0bd2751eb",
                                                "sense_id": "fd2cdb24-0983-3f10-8a3a-26f4812c13cd",
                                                "text": "Durch Glasnost wird mehr Offenheit verlangt."
                                            },
                                            {
                                                "example_id": "d22b2dcf-321e-44cb-b262-fd335a160d29",
                                                "sense_id": "fd2cdb24-0983-3f10-8a3a-26f4812c13cd",
                                                "text": "„Und es waren aufregende Zeiten: Glasnost und Perestrojka prägten die Weltpolitik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e75f831-7308-4c56-821f-f581ebe521cf",
                        "source_entry_id": "32d45029-d5df-3bca-b132-c74038f341a5",
                        "source_sense_id": "316b063e-6a3d-363a-a3a8-4804076105fc",
                        "target_lang_word": "гласность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гласность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7051d1df-d2d0-3658-a667-f2e1805eaba9",
                                        "entry_id": "2923e103-8c39-3cce-9e25-2abef66cecef",
                                        "glosses": [
                                            "книжн., юр. открытость, доступность, публичность информации о деятельности учреждений, организаций, должностных лиц и т. п. для общественного ознакомления, обсуждения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a8479f-c55d-4483-94b2-d0d572644f17",
                                                "sense_id": "7051d1df-d2d0-3658-a667-f2e1805eaba9",
                                                "text": "Нападения на писателя и оправдания, коим подают они повод, суть важный шаг к гласности прений о действиях так называемых общественных лиц (hommes publics), к одному из главнейших условий высоко образованных обществ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e291ca04-d9f1-3a80-a554-c19ba34042e8",
                                        "entry_id": "2923e103-8c39-3cce-9e25-2abef66cecef",
                                        "glosses": [
                                            "истор., полит. основной компонент политики перестройки, проводимый М. С. Горбачёвым во второй половине 1980-х годов в СССР и заключавшийся в существенном ослаблении цензуры и снятии существовавших в советском обществе многочисленных информационных барьеров, в том числе и гласности [1]"
                                        ],
                                        "tags": [],
