                ],
                "senses": [
                    {
                        "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                        "entry_id": "79f41da8-c6a8-3557-ab88-57778097905d",
                        "glosses": [
                            "(von einem Veranstalter, Sportverein oder Ähnlichem) organisierte Möglichkeit, einen oder mehrere Läufe zu absolvieren – meistens im Rahmen einer Laufveranstaltung oder eines Trainingsprogramms"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "1bee050b-41a8-4baf-906d-f6a5ffc9cffe",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„In bewährter Weise bietet der Fürst Carl Seenlandmarathon in Pleinfeld am Brombachsee ein breitgefächertes Laufangebot sowie ein familiäres Rahmenprogramm.“"
                            },
                            {
                                "example_id": "79d334e8-7a3e-49c7-a76f-035dfd0fb807",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„Mit dem 21. Gerstewitzer Mühlentag-Lauf in Nellschütz, den 29. Zeitzer Stadtlauf und der 40-igste Ausgabe des Rudelsburglaufs in Bad Kösen sind auch drei Landescupläufe im Laufangebot.“"
                            },
                            {
                                "example_id": "b2e8acd6-446f-4070-a61a-2013dfdceb6f",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„Ein Laufangebot für Anfänger gibt es jeden Montag von 18:30 h – 19:30 h. Start ist in Horas am Parkplatz Kulturzentrum Kreuz.“"
                            },
                            {
                                "example_id": "03f41815-47f5-43b7-87e1-fd5e3ba467b5",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„Wichtig für die Veranstalter der Eifelläufe ist der Fakt, dass jeder Teilnehmer das richtige und für sich persönliche Laufangebot findet.“"
                            },
                            {
                                "example_id": "354df094-41c1-4c92-9b26-086776b895e5",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„Dieses Jahr besteht der Schüler-Lauf-Cup aus vier Einzelveranstaltungen in Nordborchen, Dörenhagen, Kirchborchen und Alfen mit unterschiedlichen Laufangeboten.“"
                            },
                            {
                                "example_id": "7ba2d7e6-e771-4e3f-8643-ba1ff565a6c4",
                                "sense_id": "1e3b4b27-992e-307c-9d6d-d90e91d5289c",
                                "text": "„Es zahlt sich jetzt aus, dass wir auch in der Pandemie unsere Laufangebote aufrechterhalten haben, wenn auch teilweise nur als Virtual Run.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
