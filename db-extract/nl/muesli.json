                                "target_senses": [
                                    {
                                        "sense_id": "8062ba0b-1761-3773-9575-e77f2e750f97",
                                        "entry_id": "e981ce1a-e920-3bd0-b804-1a4629a51af8",
                                        "glosses": [
                                            "Qualifie les plantes qui produisent des graines propres à la nourriture de l’homme et de certains animaux domestiques."
                                        ],
                                        "tags": [
                                            "dated",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6c885cc-fd70-4e54-8dda-ebdbea145ec4",
                                                "sense_id": "8062ba0b-1761-3773-9575-e77f2e750f97",
                                                "text": "La Verse ou le versage des blés, et de beaucoup de plantes céréales, est un accident occasionné, ou par de grands vents, des orages, de fortes pluies, ou par le trop d’embonpoint que prennent les plantes dans les temps chauds et humides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "céréale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff0b265f-603a-3e64-b848-56866a6a93a1",
                                        "entry_id": "88f80aa6-3594-30a0-b64a-28c30f3539b8",
                                        "glosses": [
                                            "Graminée cultivée principalement pour ses grains utilisés dans l’alimentation humaine et de certains animaux domestiques."
                                        ],
                                        "tags": [
                                            "Généralement au pluriel"
                                        ],
                                        "note": "Toutefois elle est parfois cultivée pour utiliser toute la plante comme fourrage",
                                        "examples": [
                                            {
                                                "example_id": "62bb3142-4196-4c1f-b447-685327d041a0",
                                                "sense_id": "ff0b265f-603a-3e64-b848-56866a6a93a1",
                                                "text": "Nous dirons en passant que les céréales sont beaucoup moins sujettes à la verse en Champagne que dans d’autres contrées."
                                            },
                                            {
                                                "example_id": "cecff887-45c3-4481-b579-82659beca39c",
                                                "sense_id": "ff0b265f-603a-3e64-b848-56866a6a93a1",
                                                "text": "Le sol argilo-calcaire, parfois décalcifié en surface —devenant argilo-siliceux au contact des grès bigarrés— se prête bien à la culture des céréales."
                                            },
                                            {
                                                "example_id": "9e91403e-1d0f-4506-a092-88fdc0d98a40",
                                                "sense_id": "ff0b265f-603a-3e64-b848-56866a6a93a1",
                                                "text": "Cette phytohormone de synthèse présentée sous forme de sels de sodium et de potassium, est surtout utilisée en cultures de céréales pour détruire le gaillet-gratteron et le mouron."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee069d19-db2e-3765-b5ba-ebd97b1f8ef7",
                                        "entry_id": "88f80aa6-3594-30a0-b64a-28c30f3539b8",
                                        "glosses": [
                                            "Graine de ces plantes."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3611d8d0-74fa-4259-9aa9-6d198e1ad8e7",
                                                "sense_id": "ee069d19-db2e-3765-b5ba-ebd97b1f8ef7",
                                                "text": "Par exemple, de la folle-avoine sera plus inacceptable dans une production de céréales destinée à la panification, que dans une céréale destinée à l’alimentation du bétail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
