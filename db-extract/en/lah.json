                                "sense_id": "65303561-9ece-379e-b7b0-63da07257c39",
                                "text": "Pitch contour: low-mid [lɑ(ː)˨]"
                            },
                            {
                                "example_id": "9079e6a9-9562-4489-94b7-d18077e72644",
                                "sense_id": "65303561-9ece-379e-b7b0-63da07257c39",
                                "text": "No fun lah, you.",
                                "translation": "You’re no fun.",
                                "english": "You’re no fun."
                            },
                            {
                                "example_id": "d18a979e-4532-4898-a610-f51afd9e414f",
                                "sense_id": "65303561-9ece-379e-b7b0-63da07257c39",
                                "text": "“Who lah that Panjali? A real ‘number nine’ [From Tamil ஒன்பது (oṉpatu), a derogatory term for a transgender person].”\n“You don’t play a fool you know. He is not a ‘number nine’, not a hermaphrodite, but a man. He is the one who has been cross-dressing and performing the role of Panjali for many years.”"
                            }
