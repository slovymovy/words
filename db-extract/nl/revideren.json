                                                "sense_id": "b44c8032-1f7a-3e1d-8d40-848276893a8b",
                                                "text": "[…] \"The Interview,\" a crude and poorly reviewed comedy about a C.I.A. effort to hire two bumbling journalists to knock off Kim Jong-un, the North Korean leader […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8022bf55-cc21-3944-b6fb-c20c3412d2d5",
                                        "entry_id": "5e2fe423-08cd-3514-a5e3-71dfaed7dcf2",
                                        "glosses": [
                                            "To look back over in order to correct or edit; to revise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c33087-6657-47da-9694-36ccc93dba9c",
                                                "sense_id": "8022bf55-cc21-3944-b6fb-c20c3412d2d5",
                                                "text": "\"Keith Williams is reviewing his review,\" the source said. \"The whole structure of the industry has changed since he wrote his report. [...]\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48ca95d0-fe44-3ec9-a989-d47e4dd29c04",
                                        "entry_id": "5e2fe423-08cd-3514-a5e3-71dfaed7dcf2",
