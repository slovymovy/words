                "senses": [
                    {
                        "sense_id": "63be7d80-186b-3312-9004-5c3825c79490",
                        "entry_id": "5cc25078-e700-3d35-832f-2bca605e5366",
                        "glosses": [
                            "Qui a la forme d’un ver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a642574b-8137-4123-80ea-bccd13407a2f",
                                "sense_id": "63be7d80-186b-3312-9004-5c3825c79490",
                                "text": "Elle était parvenue, certaine nuit à couler dans la grange son corps vermiforme, et de là, tombant par les abat-foin dans le râtelier des vaches, à pénétrer dans l’étable chaude où logeaient les poules."
                            },
                            {
                                "example_id": "0d624781-2fcf-4756-bed7-6719c9683d00",
                                "sense_id": "63be7d80-186b-3312-9004-5c3825c79490",
                                "text": "Certains batraciens, tels la Cécilie, sont vermiformes et dépourvus de membres, ce sont les apodes."
                            },
                            {
                                "example_id": "2dd3c42e-1ae4-4348-ac9d-9a13275aad2b",
                                "sense_id": "63be7d80-186b-3312-9004-5c3825c79490",
                                "text": "L’homme était déguisés en Tyrolien, genoux nus, bas verts, culotte à larges bretelles, gilet ouvert sur une chemise brodée, chapeau classique avec la plume, et il avait l’air d’un Français comme on n’en fait plus, dans les quarante ans, avec sa petite moustache, ses joues rouges, ses un mètre soixante et dix, et un chien sky-terrier en laisse, noir, à poils longs et rudes, vermiforme, les oreilles pointues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "437ec390-ed71-4fa5-acb8-24c5782cc7f6",
                        "source_entry_id": "5cc25078-e700-3d35-832f-2bca605e5366",
                        "source_sense_id": "63be7d80-186b-3312-9004-5c3825c79490",
