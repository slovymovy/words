                    {
                        "translation_id": "752ede5f-653b-4f37-9363-cced4b68dcb1",
                        "source_entry_id": "972307eb-8ff3-335d-80de-820874f2cb47",
                        "source_sense_id": "321d726a-8db2-3856-a6b9-123e6e7750e1",
