                ],
                "senses": [
                    {
                        "sense_id": "71f26423-f6bd-3871-8a3e-aa6f5740bcf1",
                        "entry_id": "fde0b3ec-c306-3f7b-81bf-2c03c3ef7dc1",
                        "glosses": [
                            "Etui für Schreibgeräte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1223415c-74a0-4541-9a92-efe46143a02d",
                                "sense_id": "71f26423-f6bd-3871-8a3e-aa6f5740bcf1",
                                "text": "„Ich selbst kaufte mir ein Pennal für achtzehn Pfennige, ein paar Strumpfbänder und für sechs Pfennige zwölf kleine Pfefferscheiben, die mir recht gut geschmeckt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "107225ce-3cf0-309e-a344-07d7008f2209",
                        "entry_id": "fde0b3ec-c306-3f7b-81bf-2c03c3ef7dc1",
                        "glosses": [
                            "höhere Lehranstalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46d9950d-68cd-4ec6-8272-964a4ddfb8fa",
                                "sense_id": "107225ce-3cf0-309e-a344-07d7008f2209",
                                "text": "„Pennal m. der angehende Student, der eben von dem Pennal, der lateinischen Schule, dem Gymnasinm („der Penne\") kommt; er erfuhr üble Aufnahme und wurde erst nach einem Jahre zünftiger Student.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
