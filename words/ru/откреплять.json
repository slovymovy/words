            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e141bc86-7152-3ab4-a33f-ba3ce5ef3f05",
                    "sense_definition": "Отделять или снимать что-либо, что было прикреплено.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рабочий начал осторожно <откреплять> детали от корпуса машины.",
                            "target_lang_translations": {
                                "en": "The worker started to carefully <detach> the parts from the machine body."
                            }
                        },
                        {
                            "text": "Перед стиркой всегда <w>открепляй</w> значки от куртки.",
                            "target_lang_translations": {
                                "en": "Always <w>unpin</w> the badges from your jacket before washing it."
                            }
                        }
                    ],
                    "synonyms": [
                        "отцеплять",
                        "отстёгивать",
                        "отсоединять"
                    ],
                    "antonyms": [
                        "закрепля́ть",
                        "прикреплять"
                    ],
                    "common_phrases": [
                        "откреплять файл",
                        "откреплять значок",
                        "откреплять ремень",
                        "откреплять деталь"
                    ],
                    "target_lang_definitions": {
                        "en": "To separate or remove something that was attached."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "detach",
                                "target_lang_sense_clarification": "general meaning"
                            },
                            {
                                "target_lang_word": "unfasten",
                                "target_lang_sense_clarification": "physical objects"
                            },
                            {
                                "target_lang_word": "unpin",
                                "target_lang_sense_clarification": "digital interface"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "511ab6c8-e79e-3465-b34e-45331417dfa1",
                    "sense_definition": "Снимать с официального учёта или регистрации в организации.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "administrative_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Поликлиника <w>открепляет</w> пациентов только по их письменному заявлению.",
                            "target_lang_translations": {
                                "en": "The clinic <w>deregisters</w> patients only upon their written request."
                            }
                        },
                        {
                            "text": "Страховая компания обычно <w>открепляет</w> клиента от прежней клиники в течение трёх дней.",
                            "target_lang_translations": {
                                "en": "The insurance company usually <w>deregisters</w> a client from their previous clinic within three days."
                            }
                        }
                    ],
                    "synonyms": [
                        "выписывать"
                    ],
                    "common_phrases": [
                        "откреплять от поликлиники",
                        "откреплять от участка"
                    ],
                    "target_lang_definitions": {
                        "en": "To remove from official records or registration in an organization."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "deregister",
                                "target_lang_sense_clarification": "official status"
                            },
                            {
                                "target_lang_word": "detach",
                                "target_lang_sense_clarification": "from an institution"
                            }
                        ]
                    },
                    "antonyms": [
                        "прикреплять"
                    ]
                }
            ]
        }
    ]
