                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a53c581b-1eac-49b1-8b36-6b55f091e1fa",
                                                "sense_id": "8ba1faf2-42c7-3bc0-9f48-daac26826a7b",
                                                "text": "to affiliate the child to (or on or upon) one man rather than another"
                                            }
                                        ]
