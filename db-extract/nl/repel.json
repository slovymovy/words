                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4b6c704-96ed-3db0-affa-cb3e9e895ccb",
                                        "entry_id": "a5359d32-c354-34fc-9fed-dd509ed7ace3",
