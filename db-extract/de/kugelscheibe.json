                "senses": [
                    {
                        "sense_id": "b0828908-183f-3899-846a-536c7a5aa7bc",
                        "entry_id": "c608f275-af19-3e39-bd41-97b95bee5765",
                        "glosses": [
                            "durch zwei parallele Ebenen begrenzter Bereich innerhalb, beziehungsweise Ausschnitt aus einer Kugel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b83c30e-d782-4bdf-b73f-233f8633b91a",
                                "sense_id": "b0828908-183f-3899-846a-536c7a5aa7bc",
                                "text": "Die Eigenschaften einer Kugelscheibe lassen sich mathematisch berechnen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                        "entry_id": "c608f275-af19-3e39-bd41-97b95bee5765",
                        "glosses": [
                            "Ring aus Metall mit schräger Außenfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54fbde75-6553-4459-9baa-d004876e42e4",
                                "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                                "text": "Die Kugelscheibe wird in eine Kegelpfanne gelegt."
                            },
                            {
                                "example_id": "c46f3c2c-4506-42d7-a538-7c969668b8fb",
                                "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                                "text": "„Eine zusätzliche Sicherheit bieten die im Maschinenbau üblichen Unterlegscheiben nach DIN 6319, bei denen eine Kugelscheibe und eine Kegelpfanne ineinandergreifen (Abb 16c).“"
                            },
                            {
                                "example_id": "3eb7622a-0670-4c72-a640-2ee8679fe005",
                                "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                                "text": "„Die Form G der Kegelpfanne unterscheidet sich von der Form D dadurch, dass der Bohrungsdurchmesser der Form G größer ist als der Bohrungsdurchmesser der Kugelscheibe.“"
                            },
                            {
                                "example_id": "86afaf31-864f-4efd-9b05-e70e47ee7ce1",
                                "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                                "text": "„Die Kolben werden gegen Anschlagstifte a gedrückt, die ihrerseits gegen die durch den Handhebel h verstellbare Kugelscheibe s anliegen.“"
                            },
                            {
                                "example_id": "2a3e92b8-709f-4cbe-adbd-635ef631d4cd",
                                "sense_id": "679416aa-fe52-3a32-ab88-9b2fa2ed0f81",
                                "text": "„Kugelscheiben und Kegelpfannen DIN 6319 werden eingesetzt, wenn sich Spannelemente an nicht parallele Flächen anpassen sollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
