                                                "example_id": "5e576e93-0e1d-470b-8d9c-06db9bc709d7",
                                                "sense_id": "da671059-a874-3f8a-8550-8100da39e799",
                                                "text": "The most common poly budget in use for games at the time of this writing is between 5,000 and 10,000 tris. Anything within that range is sufficient to accommodate all superficial anatomical details without resort to optimization beyond normal model cleanup."
                                            },
                                            {
                                                "example_id": "e6168807-d827-4ac4-aafa-9a55fbc15c43",
                                                "sense_id": "da671059-a874-3f8a-8550-8100da39e799",
                                                "text": "Tris and quads have different areas of functionality. In real-time graphics, tris are the norm because they provide the most basic geometric representations of planes."
                                            }
                                        ]
                                    },
