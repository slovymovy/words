                        "sense_id": "750488ab-4adf-3096-a0f5-f747b0882814",
                        "entry_id": "ddfbe0e3-8d5f-3b73-9ae2-cb2aa544a447",
                        "glosses": [
                            "neiging om bepaalde regels minder streng te toe te passen dan formeel eigenlijk nodig zou zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd80d3d3-ee7d-425e-8bca-20a7840b7106",
                                "sense_id": "750488ab-4adf-3096-a0f5-f747b0882814",
                                "text": "VluchtelingenWerk Nederland vindt dat er „iets” moet veranderen binnen het huidige inburgeringsbeleid. „Het inburgeringsprogramma is geen doel maar een middel”, zegt directeur Dorine Manson. Meer „coulance” en „effectiviteit” zijn gewenst. „Dit soort problemen draagt er niet toe bij dat de grote aantallen vluchtelingen die hiernaartoe zijn gekomen, op een goede manier integreren.”"
                            },
                            {
                                "example_id": "1ad6f2a9-c92e-424e-b2b4-7937ad59a27e",
                                "sense_id": "750488ab-4adf-3096-a0f5-f747b0882814",
                                "text": "Overstappen van justitie naar de advocatuur is in de VS niks ongewoons, al is het maar omdat de advocatuur aanzienlijk beter betaalt. Het is mede de oorzaak van het typisch Amerikaanse verschijnsel dat een bedrijf, zodra het een misstand ontdekt, onmiddellijk een groot intern onderzoek laat uitvoeren en daarna met een rapport vol bewijsmateriaal naar de instanties stapt, in de hoop op coulance."
                            }
                        ]
                    }
