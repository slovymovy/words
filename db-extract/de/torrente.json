                "translations": [
                    {
                        "translation_id": "8523addc-d69d-49c5-8203-8ef4ad9012cd",
                        "source_entry_id": "addff357-a53d-3316-b1d0-ffda9e3da842",
                        "source_sense_id": "16cf9dac-0c5c-3af4-862d-c6ef9782930b",
                        "source_sense_description": "Wasserlauf im Mittelmeerraum, der kurzzeitig nach heftigen Niederschlägen entsteht",
                        "target_lang_word": "torrent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                        "entry_id": "01e657ee-2a8f-35aa-8d8e-68fff78df68a",
                                        "glosses": [
                                            "A violent flow, as of water, lava, etc.; a stream suddenly raised and running rapidly, as down a precipice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae63836-184e-4593-acd6-b0db9ecd5294",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "Rain fell on the hills in torrents."
                                            },
                                            {
                                                "example_id": "32832dea-d134-491f-a494-96ee1f54af11",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "A torrent of green and white water broke over the hull of the sail-boat."
                                            },
                                            {
                                                "example_id": "246df152-77a0-4ae9-b8f8-00ac2464347e",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "\"Try not the Pass!\" the old man said; / \"Dark lowers the tempest overhead, / The roaring torrent is deep and wide!\" / And loud that clarion voice replied / Excelsior!"
                                            },
                                            {
                                                "example_id": "992afae0-ec92-43d1-859a-32d218a36300",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                        "entry_id": "01e657ee-2a8f-35aa-8d8e-68fff78df68a",
                                        "glosses": [
                                            "A large amount or stream of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e196229a-d0cf-491c-8c54-670d96b80bca",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "They endured a torrent of inquiries."
                                            },
                                            {
                                                "example_id": "fb150225-e8d2-43f9-bbea-0c75c658cf87",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "The wind was a torrent of darkness among the gusty trees, / The moon was a ghostly galleon tossed upon cloudy seas, / The road was a ribbon of moonlight over the purple moor, / And the highwayman came riding— / Riding—riding— / The highwayman came riding, up to the old inn-door."
                                            },
                                            {
                                                "example_id": "b7ac3658-f8a2-4bbc-b792-4012236d112b",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "On the banks of the grey torrent of life, love is the only flower."
                                            },
                                            {
                                                "example_id": "bde1b1f2-b388-4835-80dd-4c879e47caed",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "Western civilization has always taught the repression of emotion […] The emotional torrents of opera rebel against this."
                                            },
                                            {
                                                "example_id": "87f4aecd-0def-4029-afd0-b342da9d5068",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "A new stream of migrants is leaving the continent. It threatens to become a torrent if the debt crisis continues to worsen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "594eb05c-2d06-374f-8745-c77c11e0ca57",
                                        "entry_id": "3632b31f-818b-37ac-b73e-7968398d3459",
                                        "glosses": [
                                            "Rolling or rushing in a rapid stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd68a25a-86de-4d41-927a-6494bc9a84fc",
                                                "sense_id": "594eb05c-2d06-374f-8745-c77c11e0ca57",
                                                "text": "Waves of torrent fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                        "entry_id": "1c03a6bb-cf3f-34ef-b4ed-413c7baed5c3",
                                        "glosses": [
                                            "To fall or flow in a torrent; to pour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cef968c-fa37-4788-a2dc-7332ce5a02cb",
                                                "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                                "text": "Outside[,] rain was torrenting down, lightning and thunder heralded the arrival of a summer storm."
                                            },
                                            {
                                                "example_id": "f0023f20-01e8-4f3e-9855-b9b62ad95899",
                                                "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                                "text": "... through the inflexible rain, each turn in the track revealed a new cascade, torrenting down the steep cliff of the hill. The weather was too wild for me to get to them. In good weather, they wouldn't exist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8180e353-973a-3a59-be20-548c8c6f23fa",
                                        "entry_id": "f9da5cfe-fc29-39b8-bb83-64ff2cbd9612",
                                        "glosses": [
                                            "A set of files obtainable through a peer-to-peer network, especially BitTorrent."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b786eda0-3aa8-4c54-a4ed-5356ec4a2741",
                                                "sense_id": "8180e353-973a-3a59-be20-548c8c6f23fa",
                                                "text": "I got a torrent of the complete works of Shakespeare the other day; I'm not sure why."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                        "entry_id": "7bedd247-ba11-309b-a5a7-094d789d8aa2",
                                        "glosses": [
                                            "To download in a torrent."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0afb7f9-3b5f-4ebc-b579-a6740e8a464a",
                                                "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                                "text": "The video rental place didn't have the film I was after, but I managed to torrent it."
                                            },
                                            {
                                                "example_id": "68853dcc-82ac-4595-931c-bb8051e57f45",
                                                "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                                "text": "They had two thousand CDs burned with Listnin loaded on them, including versions for every major phone OS, and they'd set up a dozen servers in seven different countries for people to torrent the file from."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbba23d6-3279-411d-9073-a30eb836cedd",
                        "source_entry_id": "addff357-a53d-3316-b1d0-ffda9e3da842",
                        "source_sense_id": "16cf9dac-0c5c-3af4-862d-c6ef9782930b",
                        "source_sense_description": "Wasserlauf im Mittelmeerraum, der kurzzeitig nach heftigen Niederschlägen entsteht",
                        "target_lang_word": "torrent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torrent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                        "entry_id": "7368f23b-8eea-3e0e-b4fb-23d189a08b3c",
                                        "glosses": [
                                            "Courant d’eau impétueux, qui s’enfle rapidement et qui est souvent à sec."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5551e5-e0f1-4e84-8e13-f811162c198c",
                                                "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                                "text": "Le chemin que suivait la caravane serpentait dans un étroit ravin, lit desséché de quelque torrent, profondément encaissé entre deux collines."
                                            },
                                            {
                                                "example_id": "c0523cdc-20d9-4ae1-b05b-9ac3f7c7d657",
                                                "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                                "text": "Cette ville, située à une altitude de mille toises sur le revers oriental des Rocheuses, au bord d’un torrent tributaire du Missouri, forme un vaste entrepôt pour les produits miniers de la région, et compte de quatorze à quinze mille habitants."
                                            },
                                            {
                                                "example_id": "46acd944-6028-4ccd-803f-883c1f5e206f",
                                                "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                                "text": "Le Drac, avait dit l’abbé, est un des plus redoutables torrents qui soient en France ; actuellement, il se montre placide, presque tari, mais vienne la saison des ouragans et des neiges, il se réveille, pétille ainsi qu’une coulée d’argent, siffle et s’agite, écume et bondit, engloutit d’un coup les hameaux et les digues."
                                            },
                                            {
                                                "example_id": "19eab7df-b9f5-40ea-b9f3-825f4f4761e1",
                                                "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                                "text": "Il m'est dit à chaque instant que l'un des grands soucis des autorités départementales, c'est l'entretien des routes, souvent emportées par des torrents, par les coulées de boue, par les éboulements, par des chutes de blocs."
                                            },
                                            {
                                                "example_id": "bbdb10b6-3d98-4b30-adb3-d15db7ca4fc5",
                                                "sense_id": "0ba97473-d197-3961-a778-b8803eae183f",
                                                "text": "Le succès, déjà, hésitait, lorsque, des montagnes, la Piave, fleuve appauvri, devint soudain un effroyable torrent, emportant les ponts, les bacs, les chaînes de bateaux formant routes de convoi. Vingt régiments, en quelques heures, furent bloqués, adossés au fleuve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                        "entry_id": "7368f23b-8eea-3e0e-b4fb-23d189a08b3c",
                                        "glosses": [
                                            "Écoulement abondant, choses qui se répandent impétueusement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3d70afe-4ad0-4153-8fb2-59f3fd83fd9c",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Albert, la froissant sans la regarder et la mettant dans sa poche.– Une lettre que j’avais soignée… où j’avais répandu des torrents de passion…"
                                            },
                                            {
                                                "example_id": "067f37ea-6a35-40ac-b05e-ddad98756914",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "On a bu des torrents de bière."
                                            },
                                            {
                                                "example_id": "b72d9480-203a-4931-bd6f-6e7b1ebbbeff",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Il ferme les yeux et, à cet instant, au crépuscule de son existence, un torrent de souvenirs déferle en lui. Des tranches de vie, éphémères, s’incrustent une dernière fois dans le cours de ses pensées, avant de se perdre dans les méandres de l’oubli."
                                            },
                                            {
                                                "example_id": "793636de-4959-429f-b5e8-aa085b45e7fe",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Un torrent d’injures."
                                            },
                                            {
                                                "example_id": "60bd482c-a33b-4335-8b60-4043c9629853",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Un torrent d’éloquence."
                                            },
                                            {
                                                "example_id": "f746c45c-6464-4871-a478-9d821e91f4f7",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Il est difficile de résister au torrent des passions."
                                            },
                                            {
                                                "example_id": "c291918b-1c70-48f1-b41a-8d55e65dcd79",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "Laisser passer le torrent."
                                            },
                                            {
                                                "example_id": "cec012e0-cff0-4cc1-a7ba-777194bf7d8a",
                                                "sense_id": "f9c210c3-84ab-301a-8e89-2546105a24f0",
                                                "text": "C’est un torrent qui entraîne tout."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "fr",
