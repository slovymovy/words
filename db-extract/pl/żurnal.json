                    }
                ],
                "translations": [
                    {
                        "translation_id": "4081bc41-4e3a-4fc8-a276-7a3fe598e59b",
                        "source_entry_id": "88e2cc36-283a-30ec-b4b1-e94e86de728f",
                        "source_sense_id": "37da1fd7-dda6-3c99-852a-5af75376873e",
                        "target_lang_word": "fashion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fashion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc5d56f7-73b4-37d2-9c1b-1ee944b4a14f",
                                        "entry_id": "610b943b-b8da-315e-853d-abd5cd6f284b",
                                        "glosses": [
                                            "A current (constantly changing) trend, favored for frivolous rather than practical, logical, or intellectual reasons."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10788439-5b8b-4a04-9ad8-7e28d31ed8f1",
                                                "sense_id": "bc5d56f7-73b4-37d2-9c1b-1ee944b4a14f",
                                                "text": "The huge square box, parquet-floored and high-ceilinged, had been arranged to display a suite of bedroom furniture designed and made in the halcyon days of the last quarter of the nineteenth century, when modish taste was just due to go clean out of fashion for the best part of the next hundred years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feca5f74-a1ce-3f34-8726-b469bcfc4b68",
                                        "entry_id": "610b943b-b8da-315e-853d-abd5cd6f284b",
                                        "glosses": [
                                            "Popular trends, especially in clothing; the industry that designs clothing and sometimes other related items."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3447e9b1-f8de-4071-a2c1-a28eed0be06b",
                                                "sense_id": "feca5f74-a1ce-3f34-8726-b469bcfc4b68",
                                                "text": "Check out the latest in fashion."
                                            },
                                            {
                                                "example_id": "c8396e8a-9291-41f4-8164-a9b358e8cb13",
                                                "sense_id": "feca5f74-a1ce-3f34-8726-b469bcfc4b68",
                                                "text": "He had always been interested in fashion, so he decided to take a sewing class."
                                            },
                                            {
                                                "example_id": "5fe795aa-162a-4a6f-b7dc-254274aef843",
                                                "sense_id": "feca5f74-a1ce-3f34-8726-b469bcfc4b68",
                                                "text": "the innocent diversions in fashion"
                                            },
                                            {
                                                "example_id": "bc8c5e79-3cfb-48d8-a25d-5e99a4232d9f",
                                                "sense_id": "feca5f74-a1ce-3f34-8726-b469bcfc4b68",
                                                "text": "1874-1896, Herbert Spencer, Principles of Sociology Part IV\nAs now existing, fashion is a form of social regulation analogous to constitutional government as a form of political regulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a09a25d5-963c-3675-9166-9354fa0d9e0b",
                                        "entry_id": "610b943b-b8da-315e-853d-abd5cd6f284b",
                                        "glosses": [
                                            "A style or manner in which something is done."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3dadd3e0-2930-454e-82bc-1d7d0402d2f2",
                                                "sense_id": "a09a25d5-963c-3675-9166-9354fa0d9e0b",
                                                "text": "When it had advanced from the wood, it hopped much after the fashion of a kangaroo, using its hind feet and tail to propel it, and when it stood erect, it sat upon its tail."
                                            },
                                            {
                                                "example_id": "150b5233-a682-43d1-9b90-2084f20b69e3",
                                                "sense_id": "a09a25d5-963c-3675-9166-9354fa0d9e0b",
                                                "text": "It shell-shocked the home crowd, who quickly demanded a response, which came midway through the half and in emphatic fashion."
                                            },
                                            {
                                                "example_id": "63929e80-12f2-4a8e-9f93-e58b05aab948",
                                                "sense_id": "a09a25d5-963c-3675-9166-9354fa0d9e0b",
                                                "text": "Ophelia: My lord, he hath importuned me with love in honourable fashion.\nLord Polonius: Ay, fashion you may call it; go to, go to."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a97afc4a-68b3-3ef0-899e-a661bcda2777",
                                        "entry_id": "610b943b-b8da-315e-853d-abd5cd6f284b",
                                        "glosses": [
                                            "The make or form of anything; the style, shape, appearance, or mode of structure; pattern, model; workmanship; execution."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ee5e3a3-4409-491a-b1c3-2e12707597a5",
                                                "sense_id": "a97afc4a-68b3-3ef0-899e-a661bcda2777",
                                                "text": "the fashion of the ark, of a coat, of a house, of an altar, etc."
                                            },
                                            {
                                                "example_id": "da41128b-0764-4d7b-b5ce-362eccd8fad8",
                                                "sense_id": "a97afc4a-68b3-3ef0-899e-a661bcda2777",
                                                "text": "The fashion of his countenance was altered."
                                            },
                                            {
                                                "example_id": "ddfcfa1e-82bb-4611-9182-18c8a5fa9fd8",
                                                "sense_id": "a97afc4a-68b3-3ef0-899e-a661bcda2777",
                                                "text": "I do not like the fashion of your garments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4efdbb7f-90f7-3158-852d-ec9501033303",
                                        "entry_id": "610b943b-b8da-315e-853d-abd5cd6f284b",
                                        "glosses": [
                                            "Polite, fashionable, or genteel life; social position; good breeding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8584cca5-79f1-42aa-aa12-4e28cac86802",
                                                "sense_id": "4efdbb7f-90f7-3158-852d-ec9501033303",
                                                "text": "men of fashion"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fashion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e4f57aa-9879-36a4-8653-115f861eb263",
                                        "entry_id": "61f99dfc-65a6-3b7c-82bb-a5aef2107ad0",
                                        "glosses": [
                                            "To make, build or construct, especially in a crude or improvised way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c232b35e-eb2e-403f-bffb-d42c8a7f66cf",
                                                "sense_id": "9e4f57aa-9879-36a4-8653-115f861eb263",
                                                "text": "1918, Edgar Rice Burroughs, The Land That Time Forgot Chapter IX\nI have three gourds which I fill with water and take back to my cave against the long nights. I have fashioned a spear and a bow and arrow, that I may conserve my ammunition, which is running low."
                                            },
                                            {
                                                "example_id": "413f2e92-0073-4ad0-b981-dd9e3068df8a",
                                                "sense_id": "9e4f57aa-9879-36a4-8653-115f861eb263",
                                                "text": "[…] a device fashioned by arguments against that kind of prey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4dba148-c5f8-3752-8b11-c070bd4ec0d7",
                                        "entry_id": "61f99dfc-65a6-3b7c-82bb-a5aef2107ad0",
                                        "glosses": [
                                            "To make in a standard manner; to work."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd6d0db-092d-47e9-bb4f-0d61f0246a03",
                                                "sense_id": "c4dba148-c5f8-3752-8b11-c070bd4ec0d7",
                                                "text": "Fashioned plate sells for more than its weight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e52b10e-b2e5-35c1-90e2-49c691058855",
                                        "entry_id": "61f99dfc-65a6-3b7c-82bb-a5aef2107ad0",
                                        "glosses": [
                                            "To fit, adapt, or accommodate to."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb5759d-f151-4a88-9d28-99dc850415c3",
                                                "sense_id": "3e52b10e-b2e5-35c1-90e2-49c691058855",
                                                "text": "Laws ought to be fashioned unto the manners and conditions of the people."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74335b8e-fa76-3d87-8241-700780bf1fd3",
                                        "entry_id": "61f99dfc-65a6-3b7c-82bb-a5aef2107ad0",
                                        "glosses": [
                                            "To forge or counterfeit."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91c0a18-e655-42ca-a64d-0e2e76cc7f94",
                                                "sense_id": "74335b8e-fa76-3d87-8241-700780bf1fd3",
                                                "text": "Let me, if not by birth, have lands by wit; All with me's meet that I can fashion feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f05e7deb-e5a8-45b9-a163-4614ef8d55b9",
                        "source_entry_id": "88e2cc36-283a-30ec-b4b1-e94e86de728f",
