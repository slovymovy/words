                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "b682ee0d-94de-412b-b30b-0f80a8c9f749",
                                "sense_id": "42f765f5-1842-33b9-940d-1ed76126a444",
                                "text": "De rechtbank in Arnhem heeft een man laten weten dat hij niet meer welkom is als gemachtigde in twee rechtszaken omdat hij zich beledigend, smadelijk en bedreigend heeft uitgelaten over de rechtbank. De man noemde de rechtbank onder meer \"een vieze smerige hoerentent\" en maakte een vergelijking met communistische regimes. Ook wenste hij rechters levenslange opsluiting zonder proces toe."
                            }
                        ]
