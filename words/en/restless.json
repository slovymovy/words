{
    "word_family": [
        "rest",
        "restlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7483e5b0-6ce6-3020-8212-1e677bccee88",
                    "sense_definition": "Unable to be still or quiet due to nervousness or boredom.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>restless</w> child who could not sit still in class.",
                            "target_lang_translations": {
                                "tr": "Sınıfta bir türlü yerinde duramayan <w>yerinde duramayan</w> bir çocuktu."
                            }
                        },
                        {
                            "text": "She felt <w>restless</w> and nervous while waiting for the important news.",
                            "target_lang_translations": {
                                "tr": "Önemli haberi beklerken kendini <w>huzursuz</w> ve gergin hissediyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "antsy"
                    ],
                    "common_phrases": [
                        "restless child",
                        "restless feeling"
                    ],
                    "target_lang_definitions": {
                        "tr": "Can sıkıntısı veya huzursuzluk nedeniyle yerinde duramayan, sakinleşemeyen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yerinde duramayan",
                                "target_lang_sense_clarification": "Hareketli, kıpır kıpır olan kişiler için kullanılır."
                            },
                            {
                                "target_lang_word": "huzursuz",
                                "target_lang_sense_clarification": "İçsel bir rahatsızlık veya endişe duyan kişiler için kullanılır."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "496cd451-f0a7-3593-9d3f-c82038cc9fb0",
                    "sense_definition": "Not allowing or providing a period of calm or sleep.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The night before the big exam was a <w>restless</w> one.",
                            "target_lang_translations": {
                                "tr": "Büyük sınavdan önceki gece <w>uykusuz</w> bir geceydi."
                            }
                        },
                        {
                            "text": "After a <w>restless</w> night of tossing and turning, he felt exhausted.",
                            "target_lang_translations": {
                                "tr": "Yatakta dönüp durduğu <w>huzursuz</w> bir gecenin ardından kendini bitkin hissediyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "restless night"
                    ],
                    "target_lang_definitions": {
                        "tr": "Sakin veya uykulu bir döneme izin vermeyen, uykusuz geçen."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uykusuz",
                                "target_lang_sense_clarification": "Gece uykusunun bölünmesi veya hiç uyuyamama durumu."
                            },
                            {
                                "target_lang_word": "huzursuz",
                                "target_lang_sense_clarification": "Gece boyunca rahatsızlık veren, deliksiz uyku uyutmayan durumlar için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27849222-274e-3d60-b556-602d4688da07",
                    "sense_definition": "Deprived of sleep or unable to find rest.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sleep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They remained <w>restless</w> while sitting by the window all night long.",
                            "target_lang_translations": {
                                "tr": "Tüm gece pencerenin kenarında otururken <w>huzursuz</w> bir şekilde beklediler."
                            }
                        },
                        {
                            "text": "The <w>restless</w> travelers waited for the morning train to arrive.",
                            "target_lang_translations": {
                                "tr": "<w>Huzursuz</w> yolcular sabah treninin gelmesini beklediler."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Uykudan mahrum kalmış veya dinlenememiş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yorgun",
                                "target_lang_sense_clarification": "Dinlenememiş ve bitkin olma durumu."
                            },
                            {
                                "target_lang_word": "uykusuz",
                                "target_lang_sense_clarification": "Dinlenme fırsatı bulamamış kişiler için."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65ff9920-b4a9-3a5c-808d-797a13f60b0b",
                    "sense_definition": "Not satisfied with the current situation and eager for change.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ambition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>restless</w> ambition drove him to seek new challenges every year.",
                            "target_lang_translations": {
                                "tr": "Onun <w>yerinde duramayan</w> hırsı, onu her yıl yeni zorluklar aramaya itti."
                            }
                        },
                        {
                            "text": "The <w>restless</w> crowd demanded immediate changes from the government.",
                            "target_lang_translations": {
                                "tr": "<w>Huzursuz</w> kalabalık, hükümetten acil değişiklikler talep etti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "restless ambition"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mevcut durumdan memnun olmayan ve sürekli değişim arayan."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yerinde duramayan",
                                "target_lang_sense_clarification": "Sürekli yeni arayışlar içinde olan, tatminsiz."
                            },
                            {
                                "target_lang_word": "huzursuz",
                                "target_lang_sense_clarification": "Değişim arzusuyla dolu, memnuniyetsiz."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}