                    {
                        "translation_id": "0de465f7-fc95-4a71-8476-b3f0a16e02e9",
                        "source_entry_id": "3dc88b6b-f2f1-34cf-a82f-18fb51a9e7da",
                        "source_sense_description": "an explosion",
                        "target_lang_word": "взрыв",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "взрыв",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "11c4081f-8ab8-3955-bbc9-0c47d82c83b2",
                                        "entry_id": "d6d4d192-0a80-3a16-802b-88dc460517d3",
                                        "glosses": [
                                            "воспламенение в результате мгновенного разложения вещества с выделением значительной энергии в сравнительно небольшом объёме"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a051ec5-d7b2-45c9-b172-a524ea5d951a",
                                                "sense_id": "11c4081f-8ab8-3955-bbc9-0c47d82c83b2",
                                                "text": "Взрыв газа предотвратили, но опасность осталась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8b4a655-f084-35f4-ad84-7dd704e098be",
                                        "entry_id": "d6d4d192-0a80-3a16-802b-88dc460517d3",
                                        "glosses": [
                                            "разрушение чего-либо в результате такого процесса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79340563-1d33-470e-8893-6f00c0ed8c6c",
                                                "sense_id": "e8b4a655-f084-35f4-ad84-7dd704e098be",
                                                "text": "Взрыв джипа в аэропорту Глазго признан терактом."
                                            },
                                            {
                                                "example_id": "ca59f5a9-6f0a-4a8f-a868-0248406362fa",
                                                "sense_id": "e8b4a655-f084-35f4-ad84-7dd704e098be",
                                                "text": "Астрономы обнародовали результаты изучения чрезвычайно мощного взрыва сверхновой звезды."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9409d1a-9c79-3d48-8746-c0b1d1290d68",
                                        "entry_id": "d6d4d192-0a80-3a16-802b-88dc460517d3",
                                        "glosses": [
                                            "звук взрыва [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c3dbe5c-4da3-4580-b4bb-3c4c1e85cca3",
                                                "sense_id": "b9409d1a-9c79-3d48-8746-c0b1d1290d68",
                                                "text": "Я встала у плиты, но в этот момент где-то раздался взрыв."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60fa63b3-b9a7-3018-8a08-327e24ac65fa",
                                        "entry_id": "d6d4d192-0a80-3a16-802b-88dc460517d3",
                                        "glosses": [
                                            "перен. бурное, внезапное проявление или развитие чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7f60d41-b724-48c1-b0e7-3ed078d893fb",
                                                "sense_id": "60fa63b3-b9a7-3018-8a08-327e24ac65fa",
                                                "text": "Простая просьба заплатить за газ вызвала у президента настоящий взрыв эмоций."
                                            },
                                            {
                                                "example_id": "4f7ce01a-0bba-41d0-b7ec-fbb3bba22466",
                                                "sense_id": "60fa63b3-b9a7-3018-8a08-327e24ac65fa",
                                                "text": "Кембрийский эволюционный взрыв — одна из величайших загадок в истории развития жизни на Земле."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbdc68ba-10d6-3ce2-a209-dfee854e77bd",
                                        "entry_id": "d6d4d192-0a80-3a16-802b-88dc460517d3",
                                        "glosses": [
                                            "лингв. мгновенный выход струи воздуха при размыкании органов речи в момент произнесения звука"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9913045b-f9af-4190-a102-5499b9c45104",
                                                "sense_id": "cbdc68ba-10d6-3ce2-a209-dfee854e77bd",
                                                "text": "Буква слева над строкой означает долгий затвор, т. е. задержку артикуляции согласного перед взрывом; …."
                                            }
                                        ]
                                    }
                                ]
                            },
