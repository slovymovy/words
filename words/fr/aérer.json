                    "semantic_group_id": "soin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'infirmière emmène le malade sur la terrasse pour l'<w>aérer</w> un moment."
                        },
                        {
                            "text": "Les éducateurs profitent du soleil pour <w>aérer</w> les enfants au parc."
