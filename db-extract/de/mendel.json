                ],
                "senses": [
                    {
                        "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                        "entry_id": "138a2850-08f4-3704-b068-a7b6cc02e4a7",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c73a2743-2ad2-4a3d-ae94-4eb75df7c549",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Frau Mendel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5fb397b3-ed9b-426a-91a5-c464aac79835",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Herr Mendel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "42c0e4cf-6943-458c-8c51-eb846b9dbe4a",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Die Mendels fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "56186806-0872-442d-b483-f0f56f210cad",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Der Mendel trägt nie die Schals, die die Mendel ihm strickt."
                            },
                            {
                                "example_id": "46488d13-d8fe-4e76-a71e-1db9465a3c30",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mendel kommt, geht der Herr Mendel.“"
                            },
                            {
                                "example_id": "7d1a130d-1d1a-432f-bb18-35e8f3bb5dab",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Mendel kommt und geht."
                            },
                            {
                                "example_id": "97702bec-3602-4a80-8c18-5d82ea7570b6",
                                "sense_id": "74e99d44-d934-3cea-8621-635929a441ae",
                                "text": "Mendels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
