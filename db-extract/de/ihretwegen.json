                "senses": [
                    {
                        "sense_id": "f4f13ca1-26a2-3f60-9fd5-84b6c69a1ce3",
                        "entry_id": "f210abc9-6d1c-3921-9571-e0193cd17b78",
                        "glosses": [
                            "bezieht den Grund auf die dritte Person Singular Femininum oder die dritte Person Plural aus einem sie betreffenden Grund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16920a34-8f26-4884-bd1f-e02dd833a7a6",
                                "sense_id": "f4f13ca1-26a2-3f60-9fd5-84b6c69a1ce3",
                                "text": "„Ihretwegen mache ich mir keine Sorgen, sie sprach sozusagen gar nicht, außer mit Bébert in seinem Sack, Kosewörter, Gespräche zwischen ihnen…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "814aeac0-9eb5-365e-bbdb-44f1edd7c58c",
