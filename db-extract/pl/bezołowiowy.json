                                    {
                                        "sense_id": "5bd4017f-25af-3960-9d25-439cc5d76040",
                                        "entry_id": "2bb2484f-6a1e-3132-a243-e4786c04f2fd",
                                        "glosses": [
                                            "Decaffeinated."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7288af92-304f-46e4-99fa-de7e74a55dd5",
                                                "sense_id": "5bd4017f-25af-3960-9d25-439cc5d76040",
                                                "text": "I order a draft beer and a decaf coffee for Cha. The bartender tells me in a nice way they don't have unleaded coffee."
                                            },
                                            {
                                                "example_id": "75db7084-dfcc-4bfb-be7f-c623c6808a9a",
                                                "sense_id": "5bd4017f-25af-3960-9d25-439cc5d76040",
                                                "text": "“Could I get you a drink, coffee, or something?” “Unleaded coffee if Alex has any.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6063b3a-8b4b-3630-a588-48d91e6725c2",
                                        "entry_id": "2bb2484f-6a1e-3132-a243-e4786c04f2fd",
                                        "glosses": [
                                            "Having low alcohol content."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "not-comparable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4e8f625-8fb9-4dba-aac6-8d97019a9c53",
                                                "sense_id": "f6063b3a-8b4b-3630-a588-48d91e6725c2",
                                                "text": "Richie Pace ordered an unleaded beer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unleaded",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ad4fb56-473c-3be3-8a0f-3d1cde8653a1",
                                        "entry_id": "b9209eb5-6032-38d8-8543-16b180a47a93",
