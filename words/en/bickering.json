{
    "word_family": [
        "bicker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "028e2653-7b54-3a1d-8be2-c6a3e94c4085",
                    "sense_definition": "A state of petty or trivial arguing and quarreling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bickering</w> between the two neighbors made the whole street feel very tense.",
                            "target_lang_translations": {
                                "zh": "两个邻居之间不断的<w>争吵</w>让整条街的气氛都变得非常紧张。"
                            }
                        },
                        {
                            "text": "They finally stopped their petty <w>bickering</w> and decided to work together on the project.",
                            "target_lang_translations": {
                                "zh": "他们终于停止了琐碎的<w>拌嘴</w>，决定在项目上进行合作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squabbling",
                        "wrangling",
                        "arguing"
                    ],
                    "antonyms": [
                        "agreement",
                        "harmony"
                    ],
                    "common_phrases": [
                        "constant bickering",
                        "petty bickering"
                    ],
                    "target_lang_definitions": {
                        "zh": "指琐碎的争吵或口角。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争吵",
                                "target_lang_sense_clarification": "指因琐事而发生的口角。"
                            },
                            {
                                "target_lang_word": "拌嘴",
                                "target_lang_sense_clarification": "指为了小事而进行的轻微争执。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e278eb3-6782-31a6-8fdc-d27cded203f6",
                    "sense_definition": "Inclined to engage in petty or trivial arguments.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bickering</w> children could not agree on which game to play next.",
                            "target_lang_translations": {
                                "zh": "那些<w>爱争吵的</w>孩子们无法就接下来玩什么游戏达成一致。"
                            }
                        },
                        {
                            "text": "He grew tired of his <w>bickering</w> colleagues and decided to work from home.",
                            "target_lang_translations": {
                                "zh": "他厌倦了那些<w>爱争吵的</w>同事，决定在家办公。"
                            }
                        }
                    ],
                    "synonyms": [
                        "argumentative",
                        "quarrelsome"
                    ],
                    "antonyms": [
                        "agreeable"
                    ],
                    "target_lang_definitions": {
                        "zh": "指爱挑起琐碎争端或好争吵的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "爱争吵的",
                                "target_lang_sense_clarification": "形容人喜欢为小事争论。"
                            },
                            {
                                "target_lang_word": "好斗的",
                                "target_lang_sense_clarification": "形容人容易与人发生冲突。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22fa8f36-9b7d-3436-b78a-ff89c41bb29f",
                    "sense_definition": "Present participle and gerund of <w>bicker</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The siblings were <w>bickering</w> over who should get the last piece of cake.",
                            "target_lang_translations": {
                                "zh": "兄弟姐妹们正在为谁该吃最后一块蛋糕而<w>争吵</w>。"
                            }
                        },
                        {
                            "text": "Stop <w>bickering</w> about small details and focus on the main goal.",
                            "target_lang_translations": {
                                "zh": "别再为细节小事<w>拌嘴</w>了，专注于主要目标吧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "squabbling",
                        "arguing"
                    ],
                    "common_phrases": [
                        "bickering over"
                    ],
                    "target_lang_definitions": {
                        "zh": "指为琐事争吵。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "争吵",
                                "target_lang_sense_clarification": "指持续进行口角。"
                            },
                            {
                                "target_lang_word": "拌嘴",
                                "target_lang_sense_clarification": "指为小事争执。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}