                "senses": [
                    {
                        "sense_id": "9f372f25-7d02-3287-99a9-2190598d5c35",
                        "entry_id": "08090c83-2daf-39e1-a7b2-421fcc2459fc",
                        "glosses": [
                            "Work, especially research or preparation, that involves significant walking, travel, or similar effort."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a9749bd4-5d4b-4dbb-b6da-b46332b4a7e7",
                                "sense_id": "9f372f25-7d02-3287-99a9-2190598d5c35",
                                "text": "In addition to spreading more information, brokers are going to have to do some leg work to get new customers."
                            },
                            {
                                "example_id": "1488a36f-f54d-44ed-aba9-c2200b98c713",
                                "sense_id": "9f372f25-7d02-3287-99a9-2190598d5c35",
                                "text": "The worldwide effort has already revealed several valuable lessons [including] . . . the use of old-fashioned legwork in tracking down people who may unknowingly carry a virus."
                            },
                            {
                                "example_id": "60030085-df2a-47f8-838e-97f0faf3a1fd",
                                "sense_id": "9f372f25-7d02-3287-99a9-2190598d5c35",
                                "text": "John did all the legwork. He had the invitations printed and mailed. He found speakers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c40c0095-5e61-34a8-8ac4-e0932b5d8138",
                        "entry_id": "08090c83-2daf-39e1-a7b2-421fcc2459fc",
                        "glosses": [
                            "Skillful or vigorous use of the legs, as in dance or sports."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "449c2e06-bb1c-4576-b3b6-5714b48b0f54",
                                "sense_id": "c40c0095-5e61-34a8-8ac4-e0932b5d8138",
                                "text": "\"Watriss, No. 3, is rowing well. . . . His leg work is very fair.\""
                            },
                            {
                                "example_id": "ba855f2d-82ed-4b11-8efe-7fa0787ca11a",
                                "sense_id": "c40c0095-5e61-34a8-8ac4-e0932b5d8138",
                                "text": "Fancy legwork and jumping rope will get you in great shape."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f4e036d-1eca-4ad9-9596-c6edf935b374",
