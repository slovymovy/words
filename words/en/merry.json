                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "festivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village held a <w>merry</w> feast to celebrate the end of the harvest.",
                            "target_lang_translations": {
                                "ru": "В деревне устроила <w>весёлый</w> пир, чтобы отпраздновать окончание сбора урожая.",
                                "zh": "村里举办了一场<w>热闹</w>的宴会来庆祝丰收。"
                            }
                        },
                        {
                            "text": "Everyone was <w>merry</w> at the party, dancing and singing until late at night.",
