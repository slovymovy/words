                                            {
                                                "example_id": "681293ec-c5f2-4c5d-86b7-e28ffc99de46",
                                                "sense_id": "69dcd7a4-7eab-3784-b765-aa592bab5427",
                                                "text": "J'invite les lecteurs à consulter mon blogue afin de connaître ma position sur les Écoles anthroposophiques Waldorf."
