                "senses": [
                    {
                        "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                        "entry_id": "624dce2c-2d53-34a8-8b95-b966aca1d2c1",
                        "glosses": [
                            "Wort, das aus verschiedenen Gründen (ethisch, politisch, religiös) gemieden und durch Abkürzungen, Euphemismen, Umschreibungen umgangen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5cf3f0e-5246-4a1a-8edf-3c90fe8437dd",
                                "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                                "text": "In vielen Kulturen gilt der Name ihres Gottes als Tabuwort."
                            },
                            {
                                "example_id": "76e11c3c-8000-4e30-8ca2-8d0f11c1888b",
                                "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                                "text": "„Heute dominieren unter den Tabuwörtern die, die durch aufbessernde Benennungen ersetzt werden.“"
                            },
                            {
                                "example_id": "ef8cf245-a420-444e-86b3-8380c158aef1",
                                "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                                "text": "„Helmut Heißenbüttel beklagte, daß der »Bereich der sogenannten Tabuwörter« von der Lexikographie immer noch stiefmütterlich behandelt werde…“"
                            },
                            {
                                "example_id": "b3fbaafa-d8d6-41e6-8e12-371591aca066",
                                "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                                "text": "„»Du Nigger« oder »du Kanake«, von einem Afro-Deutschen oder einem türkischstämmigen Deutschen ausgesprochen, ist kein Tabuwort mehr.“"
                            },
                            {
                                "example_id": "62cff221-8c5b-493d-b954-26fb292779d2",
                                "sense_id": "526df4ca-07e3-3744-9dc5-efc51490580c",
                                "text": "„Ein Tabuwort wurde oft umschrieben, durch ein Hüllwort ersetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
