                        "entry_id": "110ec17f-86fa-3887-9a49-1cc0bd107ed7",
                        "glosses": [
                            "Schmalspurbahn vom Bahnhof Drei Annen Hohne zum Gipfel des Brocken im Harz; Teil der Harzquerbahn (Harzer Schmalspurbahnen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcd14db9-5c5a-4ca5-82c0-d928f90f7199",
                                "sense_id": "a9f0be4c-5fc9-3cd5-bd4c-87948edcf78e",
                                "text": "„Die Brockenbahn ist heute das Herzstück, das wirtschaftliche Rückenmark der Harzer Schmalspurbahnen.“"
                            },
                            {
                                "example_id": "87cd0598-7f50-4f2f-bfac-9f3e0f47b4d6",
                                "sense_id": "a9f0be4c-5fc9-3cd5-bd4c-87948edcf78e",
                                "text": "„Die Brockenbahn fuhr bis in die Kriegszeit hinein nach ihrem feststehenden Fahrplan, der täglich sechs Zugpaare vorsah.“"
                            }
                        ],
