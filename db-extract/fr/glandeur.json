                ],
                "senses": [
                    {
                        "sense_id": "55b8f314-47fc-3081-9e0d-6cbe0adede60",
                        "entry_id": "b4b305bc-2589-3c2c-8045-9b415984302a",
                        "glosses": [
                            "Qui aime à flemmarder, à rien faire ou pas grand chose."
                        ],
                        "tags": [
                            "colloquial",
                            "offensive"
                        ],
                        "examples": [
                            {
                                "example_id": "d2dddbd2-05b4-4844-b882-0ec12298cfc8",
                                "sense_id": "55b8f314-47fc-3081-9e0d-6cbe0adede60",
                                "text": "D'habitude, je ne suis pas trop glandeuse, mais après ce qui est arrivé à M. Weaver... et puis Toby... Impossible de me concentrer."
                            },
                            {
                                "example_id": "1ad39b6e-48a2-4742-8485-f667806f1b40",
                                "sense_id": "55b8f314-47fc-3081-9e0d-6cbe0adede60",
                                "text": "Mais il me faut t'avouer que je cultivais un coté bien trop glandeur à l'époque pour avoir la tête à mes études. Les aventures queutardes de la vingtaine, ça vous fusille un homme et sa carrière et mon niveau de concentration se situait bien en dessous de mon cerveau."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
