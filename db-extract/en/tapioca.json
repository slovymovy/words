                                "target_senses": [
                                    {
                                        "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                        "entry_id": "14fd2465-480c-3c6b-a82d-02cf85ba8fe7",
                                        "glosses": [
                                            "Fécule de racine de manioc, lavée avec soin et bien séchée, utilisée par exemple pour épaissir des potages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4042f167-125d-4aaf-9754-e9ce8330e573",
                                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                                "text": "On dirait un insecte maintenant, une silhouette de mante religieuse qui se disloque avant de prendre corps, et voilà la Grande Ourse, et puis des grains de tapioca, diaphanes et grumeleux."
                                            },
                                            {
                                                "example_id": "a731d836-9456-4c32-8cdf-e870ee2cd67e",
                                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                                "text": "Notre personnel renouvelé se composait d’une cuisinière, vieille fille sale, avide, grincheuse, dont les talents en cuisine ne s’étendaient pas au delà du tapioca, de la blanquette de veau, de la salade ; […]"
                                            },
                                            {
                                                "example_id": "67b5421f-b52b-4882-b219-c6970a96d725",
                                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                                "text": "M. Duthoit a-t-il compris ? Mystère. Il est aux prises avec son potage tapioca et ne lèvera le nez de son assiette que lorsque celle-ci sera vide…"
                                            },
                                            {
                                                "example_id": "589380bf-4a86-431a-9268-cd1fffb234de",
                                                "sense_id": "db45c172-d340-3d94-a806-05019ab54b9b",
                                                "text": "J’ai fait une crème vanillée aux perles du Japon, susurra la jeune femme. C’est une recette traditionnelle à base de tapioca."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
