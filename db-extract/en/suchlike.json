                                                "sense_id": "c9d7f3c6-beaf-3138-a336-451e50951929",
                                                "text": "Solchem Flehen muss man nachgeben."
                                            },
                                            {
                                                "example_id": "a1778405-3c73-49e7-8467-5e3115d45ccb",
                                                "sense_id": "c9d7f3c6-beaf-3138-a336-451e50951929",
                                                "text": "Ich habe eine solche Lust wieder einmal Ski zu fahren, ich kann meinen Urlaub kaum erwarten."
                                            },
                                            {
                                                "example_id": "458b833b-9525-4852-8466-57ee996f8f84",
                                                "sense_id": "c9d7f3c6-beaf-3138-a336-451e50951929",
                                                "text": "Ich hab aber solchen Hunger!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7690b32e-d2b4-3efe-acc2-6fa64a273695",
                                        "entry_id": "7991d955-adea-349c-9b73-09e71c321e44",
                                        "glosses": [
                                            "im Kern, in seiner Einzigartigkeit"
                                        ],
                                        "tags": [
                                            "mit als"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a126474f-32c6-454a-847e-30fc8de63cef",
                                                "sense_id": "7690b32e-d2b4-3efe-acc2-6fa64a273695",
                                                "text": "Die Idee als solche ist ja gar nicht mal schlecht, aber wir haben nicht so viel Zeit, dass das klappen könnte."
                                            }
