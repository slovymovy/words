                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Forderung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                        "entry_id": "824cf083-c4a4-3e79-aeeb-d27ccb14a8f7",
                                        "glosses": [
                                            "dringender Wunsch, Begehren, Verlangen, insbesondere auch ein finanzieller Anspruch an einen Dritten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e1452b-d9cc-4158-b8fe-8170afb28452",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "Der Forderung nach höheren Zinsen wurde von der Bank natürlich nicht stattgegeben."
                                            },
                                            {
                                                "example_id": "7c971d3a-b74d-4f26-aa1b-893b88972936",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "Forderungen bucht man per Soll."
                                            },
                                            {
                                                "example_id": "50d2c8aa-9032-41c9-bb45-0b2e6b8f30f4",
                                                "sense_id": "b51332b1-23d2-337b-8d03-a503de9e7497",
                                                "text": "„Wenn man derzeit von Forderungen liest, auch den Fachhochschulen das Promotionsrecht einzuräumen, kann man sich die Ergebnisse vorstellen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                        "entry_id": "824cf083-c4a4-3e79-aeeb-d27ccb14a8f7",
                                        "glosses": [
                                            "das zum Duell Aufrufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "131b0655-02f3-4483-92e1-20b0da87398e",
                                                "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                                "text": "Die Forderung auf Pistolen schockierte den Grafen."
                                            },
                                            {
                                                "example_id": "83126dde-050f-4de8-a61c-a14ffd19f965",
                                                "sense_id": "3544fdce-3e3a-34d6-ba10-b99fbd411403",
                                                "text": "Eigentlich hat man kein Recht, eine Forderung abzulehnen, aber man kann sich aus der Affäre ziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
