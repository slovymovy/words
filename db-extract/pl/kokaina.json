                                    {
                                        "sense_id": "0d23f40a-7908-3724-b6c6-07803809d92f",
                                        "entry_id": "7e2866ce-cce2-352f-95cf-b82846e3cd4f",
                                        "glosses": [
                                            "An addictive drug derived from coca (Erythroxylum) or prepared synthetically, used sometimes medicinally as a local anesthetic and, often illegally, as a stimulant."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a912005a-2be6-4810-b407-3d3ce9f767ea",
                                                "sense_id": "0d23f40a-7908-3724-b6c6-07803809d92f",
                                                "text": "Holmes, who loathed every form of society with his whole Bohemian soul, remained in our lodgings in Baker-street, buried among his old books, and alternating from week to week between cocaine and ambition, the drowsiness of the drug, and the fierce energy of his own keen nature."
                                            },
                                            {
                                                "example_id": "5161fcc3-0976-46fd-ac8c-db97b3dfaa1b",
                                                "sense_id": "0d23f40a-7908-3724-b6c6-07803809d92f",
                                                "text": "All I get, uh, is this cup of cold coffee and cocaine / And your ugly face, look out"
                                            },
                                            {
                                                "example_id": "d6407877-729b-4977-be8a-e966b3bc16b9",
                                                "sense_id": "0d23f40a-7908-3724-b6c6-07803809d92f",
                                                "text": "Cocaine’s awfully expensive stuff, isn't it? Is it worth it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792b4030-33ef-3122-90d1-2a25cb36800b",
                                        "entry_id": "7e2866ce-cce2-352f-95cf-b82846e3cd4f",
                                        "glosses": [
                                            "Any derivative of cocaine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "cocaine",
                                "target_lang_code": "en",
                                "target_senses": [
