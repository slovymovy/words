                                        "glosses": [
                                            "A nun."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c144cf3a-d3f0-4ebf-af70-784bcfe6e485",
                        "source_entry_id": "a35aa32d-6c16-3979-89a6-448e96e21780",
                        "source_sense_id": "7166d11a-5927-3fdc-8840-75c5cc452694",
