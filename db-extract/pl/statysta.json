                "translations": [
                    {
                        "translation_id": "35b06a99-8c8e-4d86-b770-f99f951b9a61",
                        "source_entry_id": "05885720-65b5-37be-8323-aeb8ff345e78",
                        "source_sense_id": "5224bf9c-b412-3448-a6e1-1062f5dec669",
                        "target_lang_word": "extra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "extra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3adc8d0a-b7f2-3910-b031-3ccbfa2f7693",
                                        "entry_id": "8f392594-ce3f-32e3-82c8-87dd590cc532",
                                        "glosses": [
                                            "Beyond what is due, usual, expected, or necessary; extraneous; additional; supernumerary."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34f82619-b0aa-472e-a015-0b46cc49b632",
                                                "sense_id": "3adc8d0a-b7f2-3910-b031-3ccbfa2f7693",
                                                "text": "I don't mind doing some extra work, as long as I get extra pay."
                                            },
                                            {
                                                "example_id": "476cf806-da1e-4e0d-b6f9-5eb6b5824142",
                                                "sense_id": "3adc8d0a-b7f2-3910-b031-3ccbfa2f7693",
                                                "text": "Kellogg himself became the biggest on-site celeb of all, delivering a weekly ‘Question Box’ lecture in which he explained that tobacco destroyed testicles, and that Ancient Rome had only fallen because the decadent Senators had started tossing their slaves into cookery pots to lend their food extra flavour, thus proving that an over-rich diet could lead to wholesale civilisational collapse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c49fb84-6d2f-3c9f-b2ee-0390e5d5db74",
                                        "entry_id": "8f392594-ce3f-32e3-82c8-87dd590cc532",
                                        "glosses": [
                                            "Extraordinarily good; superior."
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                        "entry_id": "8f392594-ce3f-32e3-82c8-87dd590cc532",
                                        "glosses": [
                                            "Over the top; going beyond what is normal or appropriate, often in a dramatic manner."
                                        ],
                                        "tags": [
                                            "comparable",
                                            "not-comparable",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f96076b4-f6da-4c83-9b88-f41da262c9c5",
                                                "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                                "text": "You unfollowed her for posting cat memes? You're so extra!"
                                            },
                                            {
                                                "example_id": "44535abf-5031-4d23-b30a-be19b87c355f",
                                                "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                                "text": "Wow, you're more extra than she is. You're the most extra friend I have."
                                            },
                                            {
                                                "example_id": "9094e67b-43c9-4621-9abd-b4f6e9f5d5dc",
                                                "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                                "text": "I highly recommend getting some more bread on the side—they offer small loaves and soup crackers for free, but I'm so extra, I bought my own loaf."
                                            },
                                            {
                                                "example_id": "26c3c6c9-c725-4720-b6b5-dd6d9d00affc",
                                                "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                                "text": "Shattered glass, pierced, bejewelled, chromed and glittered - nails are going totally extra on Insta at the minute and we approve."
                                            },
                                            {
                                                "example_id": "edd10088-4044-496f-a878-53f717de2fe7",
                                                "sense_id": "aa222635-2b4b-3620-9266-e375053b7a92",
                                                "text": "Two months of Christmas trees, Christmas movies and Christmas music brings so much fun to our home, we are so extra with it!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fec435b-6742-3d74-b35b-6bbcdd391722",
                                        "entry_id": "091c13b6-6728-3ed7-8fa3-b93d8418f86b",
                                        "glosses": [
                                            "To an extraordinary degree."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cb7d93a-ee15-443b-82e6-868b9f2e8eb1",
                                                "sense_id": "2fec435b-6742-3d74-b35b-6bbcdd391722",
                                                "text": "That day he ran to school extra fast."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "extra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c80b42a2-11e8-324f-8623-42f25d97da9b",
