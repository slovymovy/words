{
    "word_family": [
        "замерять",
        "замерить",
        "замерщик"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a5a51ee-1797-3143-babc-fe0bcfb0437a",
                    "sense_definition": "Процесс определения размеров, объема или количества чего-либо.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Инженер начал <w>замер</w> уровня воды в реке.",
                            "target_lang_translations": {
                                "en": "The engineer began the <w>measurement</w> of the water level in the river."
                            }
                        },
                        {
                            "text": "Для установки новых окон требуется точный <w>замер</w> оконного проема.",
                            "target_lang_translations": {
                                "en": "An accurate <w>measurement</w> of the window opening is required to install new windows."
                            }
                        }
                    ],
                    "synonyms": [
                        "измерение"
                    ],
                    "common_phrases": [
                        "точный замер",
                        "произвести замер"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of determining the size, volume, or quantity of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "measurement",
                                "target_lang_sense_clarification": "The act of measuring something."
                            },
                            {
                                "target_lang_word": "measuring",
                                "target_lang_sense_clarification": "The process or act of taking measurements."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba5d73e8-4d90-30e3-8d91-dcc93826c1c5",
                    "sense_definition": "Полученные данные или показатели в результате процесса измерения.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все <w>замеры</w> показали, что конструкция абсолютно безопасна.",
                            "target_lang_translations": {
                                "en": "All <w>measurements</w> showed that the structure is completely safe."
                            }
                        },
                        {
                            "text": "Специалист записал полученный <w>замер</w> в отчет.",
                            "target_lang_translations": {
                                "en": "The specialist recorded the obtained <w>measurement</w> in the report."
                            }
                        }
                    ],
                    "common_phrases": [
                        "показатели замера"
                    ],
                    "target_lang_definitions": {
                        "en": "Data or indicators obtained as a result of the measurement process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "measurement",
                                "target_lang_sense_clarification": "A specific value or result obtained from measuring."
                            },
                            {
                                "target_lang_word": "reading",
                                "target_lang_sense_clarification": "A value shown on a measuring instrument."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48d52b81-2c24-3293-b670-94454b954d06",
                    "sense_definition": "Мужской род единственного числа прошедшего времени глагола <w>замереть</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "motionless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>замер</w> от неожиданности, увидев старого друга.",
                            "target_lang_translations": {
                                "en": "He <w>froze</w> in surprise when he saw his old friend."
                            }
                        },
                        {
                            "text": "Весь зал <w>замер</w> в ожидании начала концерта.",
                            "target_lang_translations": {
                                "en": "The whole hall <w>stood still</w> in anticipation of the concert beginning."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Грамматическая форма глагола"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Masculine singular past tense of the verb 'to freeze' or 'to stand still'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "froze",
                                "target_lang_sense_clarification": "Past tense of freeze, often used to describe becoming motionless."
                            },
                            {
                                "target_lang_word": "stood still",
                                "target_lang_sense_clarification": "Became motionless or stopped moving."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}