                    }
                ],
                "senses": [
                    {
                        "sense_id": "b17cd6e6-62d6-3e61-a03c-e52412965f18",
                        "entry_id": "0ebcdb27-160e-3bb5-9dc8-49b409592d81",
                        "glosses": [
                            "Zostera sp. een plantensoort aangepast aan het leven in zout water"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "299900b5-7037-4e60-aecb-c112ae3d3059",
                        "source_entry_id": "0ebcdb27-160e-3bb5-9dc8-49b409592d81",
                        "source_sense_id": "b17cd6e6-62d6-3e61-a03c-e52412965f18",
                        "source_sense_description": "een plantensoort aangepast aan het leven in zout water",
                        "target_lang_word": "Seegras",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Seegras",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                        "entry_id": "5fc3099c-d87a-3f1c-9daf-0aa138c9885c",
                                        "glosses": [
                                            "in Küstennähe auf dem Meeresboden wachsende Samenpflanze, deren lange, grasähnliche Blätter wirtschaftlich genutzt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d05830bd-3de0-42a3-8dc9-f4891c1cb70e",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Zu den wenigen Gewinnern einer Säureschwemme dürfte dagegen das Seegras gehören – je tiefer der pH-Wert, desto mehr wuchert das submarine Grünzeug."
                                            },
                                            {
                                                "example_id": "93d6fcbb-fb1e-4b2d-9c4d-e23b334b8a74",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "An der Nord- und Ostseeküste wurde schon vor Jahrhunderten mit Seegras gedämmt."
                                            },
                                            {
                                                "example_id": "399fb8de-32aa-494c-9366-62c6b59e22e5",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Seegras ist ein zu 100 Prozent natürliches Baumaterial, das als Schüttdämmstoff oder in Form von Faserplatten zur Innen- und Zwischensparrendämmung genutzt werden kann."
                                            },
                                            {
                                                "example_id": "706e3885-2d17-4353-b5db-bd731a136500",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Auch hier pflanzte er Seegras, goss es mit einem Bambussegment voll Meerwasser an und hob seinen Fuß, wobei die Fluten auseinander wichen."
                                            },
                                            {
                                                "example_id": "0e16025e-e999-4561-9202-02e0fafa8379",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "Wenn das Seegras nach einigen warmen Tagen trocken geworden, geschieht das Auslesen ohne Schwierigkeit, wenn man eine Handvoll nach der andern hervorzieht, etwas abschüttelt und von fremden Pflanzen trennt."
                                            },
                                            {
                                                "example_id": "98baf5a2-a322-4be7-b200-8860498f09d4",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "„Ein Hektar Seegras nimmt genauso viel CO₂ auf, wie die fünfunddreißigfache Fläche Regenwald.“"
                                            },
                                            {
                                                "example_id": "a7d25834-9ef2-4d22-9167-fab7f5a65264",
                                                "sense_id": "ebb2f923-c2a3-3047-b503-d3132a4bf4d9",
                                                "text": "„GEOMAR-Forschende beobachten, dass dort, wo weniger gedüngt wird, das Seegras in der Ostsee besser wächst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c58985d3-5981-4534-915f-7c30037a5cd1",
                        "source_entry_id": "0ebcdb27-160e-3bb5-9dc8-49b409592d81",
                        "source_sense_id": "b17cd6e6-62d6-3e61-a03c-e52412965f18",
                        "source_sense_description": "een plantensoort aangepast aan het leven in zout water",
                        "target_lang_word": "seagrass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seagrass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40609322-c1a8-3cfc-a3c3-2beff4f29ec3",
                                        "entry_id": "3e660a14-9646-38f4-8ccf-e2f98b2e8ffc",
                                        "glosses": [
                                            "Any of various grass-like marine plants that grow underwater in salt water."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29096d82-a190-4b2d-af82-735c359a72e8",
                                                "sense_id": "40609322-c1a8-3cfc-a3c3-2beff4f29ec3",
                                                "text": "They are not seen again until they arrive as larger juveniles in shallow coastal waters, where they dine on seagrass and algae."
                                            },
                                            {
                                                "example_id": "ec5eccb2-500b-4ff2-bb64-529b81fa40c6",
                                                "sense_id": "40609322-c1a8-3cfc-a3c3-2beff4f29ec3",
                                                "text": "There has been some investigation into the potential of seaweeds as a carbon store, and although more is needed, one study says that seaweed habitats are believed to be the most productive of all coastal vegetated ecosystems, and suggested that the world’s seaweed sequesters as much carbon as all the planet’s seagrass meadows, saltmarshes and mangroves combined."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
