                                    },
                                    {
                                        "sense_id": "9a5b519d-b8c3-3fd5-86b2-dd54fa3cf66d",
                                        "entry_id": "e1c532b5-5f85-3e03-ba38-25c9d941043f",
                                        "glosses": [
                                            "To cause to pass quickly."
                                        ],
