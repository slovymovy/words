{
    "word_family": [
        "bulky",
        "bulkiness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "914d4761-df22-35ae-bb0d-a33e63b00f32",
                    "sense_definition": "The greater or major part of something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "majority_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bulk</w> of the students voted in favor of the new rule.",
                            "target_lang_translations": {
                                "ru": "<w>Бо́льшая часть</w> студентов проголосовала за новое правило.",
                                "zh": "<w>大部分</w>学生投票赞成这项新规定。"
                            }
                        },
                        {
                            "text": "She spends the <w>bulk</w> of her free time reading books.",
                            "target_lang_translations": {
                                "ru": "Она проводит <w>бо́льшую часть</w> своего свободного времени за чтением книг.",
                                "zh": "她把<w>大部分</w>空闲时间都花在看书上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "majority",
                        "mass",
                        "preponderance",
                        "main part"
                    ],
                    "antonyms": [
                        "minority"
                    ],
                    "common_phrases": [
                        "the bulk of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большая или основная часть чего-либо.",
                        "zh": "某事物的绝大部分或主要部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́льшая часть",
                                "target_lang_sense_clarification": "majority"
                            },
                            {
                                "target_lang_word": "основна́я ма́сса",
                                "target_lang_sense_clarification": "main part"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大部分",
                                "target_lang_sense_clarification": "majority"
                            },
                            {
                                "target_lang_word": "主体",
                                "target_lang_sense_clarification": "main part"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21bd1fc5-7907-3ff3-8bc3-2068b4e8c61c",
                    "sense_definition": "Goods or materials transported or sold in large quantities, often without individual packaging.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "trade_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is usually cheaper to buy rice and pasta in <w>bulk</w>.",
                            "target_lang_translations": {
                                "ru": "Обычно дешевле покупать рис и макароны <w>оптом</w>.",
                                "zh": "通常<w>散装</w>购买大米和意大利面更便宜。"
                            }
                        },
                        {
                            "text": "The store offers a discount for <w>bulk</w> orders.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает скидку на <w>оптовые</w> заказы.",
                                "zh": "这家店为<w>批发</w>订单提供折扣。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in bulk",
                        "buy in bulk",
                        "bulk order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Товары или материалы, продаваемые или перевозимые в больших количествах, часто без упаковки.",
                        "zh": "指大批量运输或销售的商品或材料，通常不进行单独包装。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́птом",
                                "target_lang_sense_clarification": "adverb, buying in large quantities"
                            },
                            {
                                "target_lang_word": "нава́лом",
                                "target_lang_sense_clarification": "loose, without packaging"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发",
                                "target_lang_sense_clarification": "wholesale"
                            },
                            {
                                "target_lang_word": "散装",
                                "target_lang_sense_clarification": "loose, without packaging"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "648b70a9-f075-3af1-8257-fdf28b6ee6a8",
                    "sense_definition": "The size, mass, or volume of something, especially when it is large.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "size_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheer <w>bulk</w> of the sofa made it difficult to move through the door.",
                            "target_lang_translations": {
                                "ru": "Огромные <w>габариты</w> дивана затрудняли его пронос через дверь.",
                                "zh": "沙发巨大的<w>体积</w>使它很难通过门口。"
                            }
                        },
                        {
                            "text": "Despite its <w>bulk</w>, the elephant moved through the forest with surprising silence.",
                            "target_lang_translations": {
                                "ru": "Несмотря на свои <w>размеры</w>, слон двигался по лесу удивительно тихо.",
                                "zh": "尽管<w>体量</w>庞大，大象在森林中穿行时却异常安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "size",
                        "volume",
                        "magnitude",
                        "dimensions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размер, масса или объем чего-либо, особенно если они велики.",
                        "zh": "某物的尺寸、质量或体积，尤指体型庞大时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объём",
                                "target_lang_sense_clarification": "volume, space occupied"
                            },
                            {
                                "target_lang_word": "разме́р",
                                "target_lang_sense_clarification": "dimensions"
                            },
                            {
                                "target_lang_word": "габари́ты",
                                "target_lang_sense_clarification": "external dimensions"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "体积",
                                "target_lang_sense_clarification": "volume"
                            },
                            {
                                "target_lang_word": "体量",
                                "target_lang_sense_clarification": "size or mass"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abd1d535-888e-3787-adb9-5dc15e898d95",
                    "sense_definition": "A large body, shape, or structure.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "size_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark <w>bulk</w> of the mountain loomed over the small village.",
                            "target_lang_translations": {
                                "ru": "Темная <w>громада</w> горы нависала над маленькой деревней.",
                                "zh": "那座山的黑色<w>庞然大物</w>笼罩着小村庄。"
                            }
                        },
                        {
                            "text": "He saw a large <w>bulk</w> emerging from the shadows in the alley.",
                            "target_lang_translations": {
                                "ru": "Он увидел, как из тени в переулке появилась большая <w>фигура</w>.",
                                "zh": "他看到一个巨大的<w>躯体</w>从巷子的阴影中显现出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hulk",
                        "mass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое тело, фигура или сооружение; громада.",
                        "zh": "巨大的物体、形状或结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грома́да",
                                "target_lang_sense_clarification": "large structure or mass"
                            },
                            {
                                "target_lang_word": "ту́ша",
                                "target_lang_sense_clarification": "large body (animate)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "庞然大物",
                                "target_lang_sense_clarification": "large structure or mass"
                            },
                            {
                                "target_lang_word": "躯体",
                                "target_lang_sense_clarification": "large body"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24037b0d-a5b1-3b11-bfdc-dc57b72d50ed",
                    "sense_definition": "Dietary fibre; indigestible plant material in food that aids digestion.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nutrition_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vegetables add necessary <w>bulk</w> to your diet to help with digestion.",
                            "target_lang_translations": {
                                "ru": "Овощи добавляют необходимую <w>клетчатку</w> в ваш рацион для улучшения пищеварения.",
                                "zh": "蔬菜能为你的饮食增加必要的<w>膳食纤维</w>，以帮助消化。"
                            }
                        },
                        {
                            "text": "You should eat whole grains to ensure you get enough <w>bulk</w>.",
                            "target_lang_translations": {
                                "ru": "Вам следует есть цельнозерновые продукты, чтобы получать достаточно <w>клетчатки</w>.",
                                "zh": "你应该吃全谷物以确保摄入足够的<w>膳食纤维</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fibre",
                        "roughage"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical or nutrition context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пищевые волокна; неперевариваемый растительный материал, способствующий пищеварению.",
                        "zh": "膳食纤维；食物中不能被消化的植物成分，有助于消化。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клетча́тка",
                                "target_lang_sense_clarification": "dietary fibre"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膳食纤维",
                                "target_lang_sense_clarification": "dietary fibre"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f4ebdef-d5c6-369e-8b92-cb710dbcd198",
                    "sense_definition": "To gain body mass, especially muscle, through diet and exercise.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fitness_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is trying to <w>bulk</w> up for the rugby season.",
                            "target_lang_translations": {
                                "ru": "Он пытается <w>набрать массу</w> к регбийному сезону.",
                                "zh": "他正在为橄榄球赛季努力<w>增肌</w>。"
                            }
                        },
                        {
                            "text": "Bodybuilders often <w>bulk</w> during the winter and cut fat in the spring.",
                            "target_lang_translations": {
                                "ru": "Бодибилдеры часто <w>набирают массу</w> зимой и сгоняют жир весной.",
                                "zh": "健美运动员通常在冬天<w>增肌</w>，在春天减脂。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bulk up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набирать мышечную массу с помощью диеты и упражнений.",
                        "zh": "通过饮食和锻炼增加身体质量，特别是肌肉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набира́ть ма́ссу",
                                "target_lang_sense_clarification": "gain muscle/weight"
                            },
                            {
                                "target_lang_word": "кача́ться",
                                "target_lang_sense_clarification": "slang: to work out/bulk up"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "增肌",
                                "target_lang_sense_clarification": "gain muscle"
                            },
                            {
                                "target_lang_word": "增重",
                                "target_lang_sense_clarification": "gain weight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af399044-d603-31e5-b7b1-c6d3bec1e265",
                    "sense_definition": "To appear or seem to be of great size or importance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The threat of war <w>bulked</w> large in their minds.",
                            "target_lang_translations": {
                                "ru": "Угроза войны <w>казалась огромной</w> в их умах.",
                                "zh": "战争的威胁在他们心中<w>显得重要</w>。"
                            }
                        },
                        {
                            "text": "This issue <w>bulks</w> larger than any other in the current debate.",
                            "target_lang_translations": {
                                "ru": "Этот вопрос <w>представляется более важным</w>, чем любой другой в текущих дебатах.",
                                "zh": "在当前的辩论中，这个问题比其他任何问题都更<w>凸显</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loom"
                    ],
                    "common_phrases": [
                        "bulk large"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Казаться значительным или важным; вырисовываться.",
                        "zh": "显得非常巨大或重要。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каза́ться значи́тельным",
                                "target_lang_sense_clarification": "seem important"
                            },
                            {
                                "target_lang_word": "вырисо́вываться",
                                "target_lang_sense_clarification": "loom, appear"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显得重要",
                                "target_lang_sense_clarification": "seem important"
                            },
                            {
                                "target_lang_word": "凸显",
                                "target_lang_sense_clarification": "loom, appear prominent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "48c8f0e9-a19c-3c9a-bcd1-7c5f3a713f27",
                    "sense_definition": "Relating to goods sent or sold in large quantities.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trade_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company specializes in <w>bulk</w> mail services for advertisers.",
                            "target_lang_translations": {
                                "ru": "Компания специализируется на услугах <w>массовой</w> рассылки для рекламодателей.",
                                "zh": "该公司专门为广告商提供<w>大规模的</w>邮件投递服务。"
                            }
                        },
                        {
                            "text": "We need to arrange a <w>bulk</w> shipment of materials for the construction site.",
                            "target_lang_translations": {
                                "ru": "Нам нужно организовать <w>оптовую</w> поставку материалов для строительной площадки.",
                                "zh": "我们需要为工地安排一次<w>批发的</w>材料运输。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bulk mail",
                        "bulk carrier"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к товарам, отправляемым или продаваемым большими партиями.",
                        "zh": "与大批量发送或销售的商品有关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о́птовый",
                                "target_lang_sense_clarification": "wholesale"
                            },
                            {
                                "target_lang_word": "ма́ссовый",
                                "target_lang_sense_clarification": "mass, large-scale"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "批发的",
                                "target_lang_sense_clarification": "wholesale"
                            },
                            {
                                "target_lang_word": "大规模的",
                                "target_lang_sense_clarification": "mass, large-scale"
                            }
                        ]
                    }
                }
            ]
        }
    ]
