                },
                {
                    "sense_id": "df068747-44ee-302e-8f76-18910e856668",
                    "sense_definition": "Échec complet ou insuccès total, particulièrement pour un spectacle, une tentative ou une plaisanterie.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "échec",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La nouvelle pièce de théâtre a fait un véritable <w>bide</w> auprès du public.",
                            "target_lang_translations": {
                                "en": "The new play was a real <w>flop</w> with audiences.",
                                "ru": "Новая пьеса стала настоящим <w>провалом</w> у публики.",
                                "de": "Das neue Theaterstück war beim Publikum ein echter <w>Flop</w>.",
                                "es": "La nueva obra de teatro fue un auténtico <w>fracaso</w> de público.",
                                "zh": "这部新话剧在观众中遭遇了一场<w>惨败</w>。"
                            }
                        },
                        {
                            "text": "Sa plaisanterie n'a fait rire personne et s'est terminée par un grand silence gêné, un sacré <w>bide</w>.",
                            "target_lang_translations": {
                                "en": "His joke didn't make anyone laugh and ended in an awkward silence, a proper <w>flop</w>.",
                                "ru": "Его шутка никого не рассмешила и закончилась неловким молчанием — настоящий <w>провал</w>.",
                                "de": "Sein Witz brachte niemanden zum Lachen und endete in einem peinlichen Schweigen, ein regelrechter <w>Flop</w>.",
                                "es": "Su chiste no hizo reír a nadie y terminó en un silencio incómodo, todo un <w>fracaso</w>.",
                                "zh": "他的笑话没有逗笑任何人，最后陷入一阵尴尬的沉默，真是一次彻底的<w>失败</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fiasco",
                        "flop",
                        "four"
                    ],
                    "common_phrases": [
                        "faire un bide"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A complete failure, especially of a show, attempt or joke.",
                        "ru": "Полный провал или неудача, особенно спектакля, попытки или шутки.",
                        "de": "Völliger Fehlschlag oder Misserfolg, besonders bei einer Aufführung, einem Versuch oder einem Witz.",
                        "es": "Fracaso total, especialmente de un espectáculo, un intento o una broma.",
                        "zh": "演出、尝试或玩笑等彻底失败的结果。"
                    },
