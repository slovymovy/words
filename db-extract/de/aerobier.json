                        "source_sense_id": "58c4bb4b-1abe-3906-821f-ae134ec3d396",
                        "source_sense_description": "Biologie: ein Lebewesen, das ohne Luftsauerstoff nicht überleben kann",
                        "target_lang_word": "aerobe",
