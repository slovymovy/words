                    {
                        "sense_id": "fe859f90-a967-3189-9975-fd8d246a7753",
                        "entry_id": "7b6dde6f-2ac1-3a9e-ab93-12db44e81a35",
                        "glosses": [
                            "Resembling a quagmire; marshy, miry."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b961dd-c8a8-4ff9-8d2e-16d8fa8f01e8",
                                "sense_id": "fe859f90-a967-3189-9975-fd8d246a7753",
                                "text": "English oxen would be much distressed and frightened in such quaggy soil."
                            },
                            {
                                "example_id": "1f165d34-6ed7-4f48-8092-7059e660dcc0",
                                "sense_id": "fe859f90-a967-3189-9975-fd8d246a7753",
                                "text": "Man has to feel his way most cautiously in the quaggy soil of ignorance, suspense, superstition and moral darkness."
                            }
                        ]
                    },
                    {
                        "sense_id": "f163ea41-ef61-3ecd-bb19-b1bb506da2cd",
                        "entry_id": "7b6dde6f-2ac1-3a9e-ab93-12db44e81a35",
                        "glosses": [
                            "Soft or flabby (of a person etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35a9eea1-5293-43bc-a460-a8ad32fd25b5",
                                "sense_id": "f163ea41-ef61-3ecd-bb19-b1bb506da2cd",
                                "text": "Behold her then, spreading the whole troubled bed with her huge quaggy carcase: Her mill-post arms held up; her broad hands clenched with violence […]."
                            },
                            {
                                "example_id": "af88b8de-6d07-4fff-a32f-5ba8bcf4eeba",
                                "sense_id": "f163ea41-ef61-3ecd-bb19-b1bb506da2cd",
                                "text": "In truth, a mature man who uses hair-oil, unless medicinally, that man has probably got a quoggy spot in him somewhere."
                            }
                        ]
                    }
                ],
