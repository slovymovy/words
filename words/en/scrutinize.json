    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "007c38c2-0e5a-31a2-a089-9b8f5bee5965",
                    "sense_definition": "To examine something with great care or detail, often to look for hidden or obscure flaws.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "examine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective began to <w>scrutinize</w> the evidence for any small details the police might have missed.",
                            "target_lang_translations": {
                                "ru": "Детектив начал <w>тщательно изучать</w> улики в поисках мелких деталей, которые полиция могла упустить."
                            }
                        },
                        {
                            "text": "It is important to <w>scrutinize</w> the details of the contract before you sign it.",
                            "target_lang_translations": {
                                "ru": "Важно <w>внимательно изучить</w> детали контракта перед тем, как подписывать его."
                            }
                        }
                    ],
                    "synonyms": [
                        "examine",
                        "inspect",
                        "study",
                        "analyze"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect",
                        "overlook"
                    ],
                    "common_phrases": [
                        "scrutinize the details",
                        "scrutinize the evidence",
                        "scrutinize the results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщательно и детально изучать что-либо, часто с целью поиска скрытых или неочевидных недостатков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тщательно изучать",
