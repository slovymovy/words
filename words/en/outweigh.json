    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8098539b-f3a6-3b68-853b-59be42c97121",
                    "sense_definition": "To be heavier than something else.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy cargo <w>outweighs</w> the small items in the container.",
                            "target_lang_translations": {
                                "pl": "Ciężki ładunek <w>przeważa</w> nad małymi przedmiotami w kontenerze.",
                                "ru": "Тяжелый груз <w>перевешивает</w> мелкие предметы в контейнере.",
                                "zh": "集装箱里的沉重货物<w>重于</w>那些小物件。",
                                "it": "Il carico pesante <w>pesa più dei</w> piccoli oggetti nel container."
                            }
                        },
                        {
                            "text": "The large stone <w>outweighed</w> everything else on the scale.",
                            "target_lang_translations": {
                                "pl": "Duży kamień <w>był cięższy</w> niż wszystko inne na wadze.",
                                "ru": "Большой камень <w>оказался тяжелее</w> всего остального на весах.",
                                "zh": "这块大石头<w>重于</w>秤上的其他所有东西。",
                                "it": "La grande pietra <w>era più pesante di</w> qualunque altra cosa sulla bilancia."
                            }
                        }
                    ],
                    "synonyms": [
                        "overbalance"
                    ],
                    "target_lang_definitions": {
                        "pl": "Być cięższym od czegoś innego.",
                        "ru": "Быть тяжелее, чем что-либо другое.",
                        "zh": "在重量上超过某物",
                        "it": "Essere più pesante di qualcos'altro; pesare di più."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeważać",
                                "target_lang_sense_clarification": "w kontekście fizycznej wagi"
                            },
                            {
                                "target_lang_word": "być cięższym niż",
                                "target_lang_sense_clarification": "bezpośrednie porównanie masy"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перевешивать",
                                "target_lang_sense_clarification": "в контексте физического веса"
                            },
                            {
                                "target_lang_word": "быть тяжелее",
                                "target_lang_sense_clarification": "прямое сравнение массы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重于",
                                "target_lang_sense_clarification": "重量超过某物"
                            },
                            {
                                "target_lang_word": "比……重",
                                "target_lang_sense_clarification": "重量更重"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "pesare più di",
                                "target_lang_sense_clarification": "riferito a peso fisico o massa"
                            },
                            {
                                "target_lang_word": "essere più pesante di",
                                "target_lang_sense_clarification": "confronto diretto di peso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca861e9e-cec4-301d-9687-6fa454fa51eb",
                    "sense_definition": "To be more important or valuable than something else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "weight",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The benefits of the new plan <w>outweigh</w> the potential risks.",
                            "target_lang_translations": {
                                "pl": "Korzyści nowego planu <w>przeważają</w> nad potencjalnym ryzykiem.",
                                "ru": "Преимущества нового плана <w>перевешивают</w> потенциальные риски.",
                                "zh": "新计划的好处<w>大于</w>潜在的风险。",
                                "it": "I vantaggi del nuovo piano <w>superano</w> i rischi potenziali."
                            }
                        },
                        {
                            "text": "The risks of the surgery clearly <w>outweigh</w> any possible advantage.",
                            "target_lang_translations": {
                                "pl": "Ryzyko operacji wyraźnie <w>przeważa nad</w> wszelkimi możliwymi korzyściami.",
                                "ru": "Риски операции явно <w>перевешивают</w> любые возможные преимущества.",
                                "zh": "该手术的风险显然<w>超过</w>了任何可能带来的好处。",
                                "it": "I rischi dell'intervento chirurgico chiaramente <w>prevalgono su</w> qualsiasi possibile beneficio."
                            }
                        }
                    ],
                    "synonyms": [
                        "surpass",
                        "exceed",
                        "overshadow"
                    ],
                    "common_phrases": [
                        "outweigh the benefits",
                        "outweigh the risks"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mieć większe znaczenie lub wartość niż coś innego.",
                        "ru": "Иметь большее значение или ценность, чем что-либо другое.",
                        "zh": "（在重要性或价值上）大于，超过",
                        "it": "Essere più importante, determinante o di maggior valore rispetto a qualcos'altro."
                    },
                    "translations": {
