                            {
                                "example_id": "426d556c-920a-48e2-84f0-b78cfc546746",
                                "sense_id": "34e02465-bbf7-3dca-9f8c-3d9bcf055472",
                                "text": "Die Sumpfdotterblume ist ein Frühblüher."
                            },
                            {
                                "example_id": "78b4fad8-c3f6-4e45-8409-62b4fdcd23c6",
                                "sense_id": "34e02465-bbf7-3dca-9f8c-3d9bcf055472",
                                "text": "„Aus dem klaren Wasser wuchsen Sumpfdotterblumen in dichten Büscheln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8925dcc-9b2d-48ce-be0d-6329c4b6a524",
