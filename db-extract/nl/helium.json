                    {
                        "translation_id": "99be5de7-b7cc-4805-baa3-a8075b6c8b59",
                        "source_entry_id": "9220e3e8-8b88-36fd-90a9-6a1d75f08a2e",
                        "source_sense_id": "1b73bbb2-b88e-3f07-b1f9-004af397d9b8",
                        "source_sense_description": "een chemisch element en een inert edelgas",
                        "target_lang_word": "гелий",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
