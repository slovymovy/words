                "senses": [
                    {
                        "sense_id": "7582ea1d-7171-3171-b5e5-f65e9eaa2b77",
                        "entry_id": "f0567164-f710-3c86-836c-00802a6cc09b",
                        "glosses": [
                            "рег. , разг. то же, что (красноярский) Академгородок"
                        ],
                        "tags": [
                            "Красноярск."
                        ],
                        "examples": [
                            {
                                "example_id": "d0498cac-bd66-44d6-aa29-54a924bdebba",
                                "sense_id": "7582ea1d-7171-3171-b5e5-f65e9eaa2b77",
                                "text": "Академгородок [в Красноярске] тоже Академ или Академка (для всех возрастов)."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d158998-5002-3fa9-8104-e8cae3f765d1",
                        "entry_id": "f0567164-f710-3c86-836c-00802a6cc09b",
                        "glosses": [
                            "рег. , разг. то же, что (новосибирский) Академгородок"
                        ],
                        "tags": [
                            "Новосибирск."
                        ],
                        "examples": [
                            {
                                "example_id": "340c5ae7-4a22-437f-b09b-f6af3e960ee5",
                                "sense_id": "3d158998-5002-3fa9-8104-e8cae3f765d1",
                                "text": "Точную сумму, запрошенную привокзальным таксистом до Академа, я не помню, но помню, что за плацкарту от Красноярска я заплатил гораздо меньше."
                            }
                        ]
                    }
