{
    "word_family": [
        "vacance",
        "vacant",
        "vacataire",
        "vacation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f837b41f-a178-32b5-be03-0fe56952033b",
                    "sense_definition": "S'occuper d'une tâche, se consacrer à une activité habituelle ou nécessaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "activite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après le petit-déjeuner, chacun se disperse pour <w>vaquer</w> à ses occupations habituelles."
                        },
                        {
                            "text": "Elle préférait le laisser <w>vaquer</w> à ses affaires sans intervenir dans ses décisions."
                        }
                    ],
                    "synonyms": [
                        "s'affairer",
                        "s'occuper"
                    ],
                    "common_phrases": [
                        "vaquer à ses occupations",
                        "vaquer à ses affaires"
                    ]
                },
                {
                    "sense_id": "6dc11e64-1af9-3553-8dfb-4f612236201c",
                    "sense_definition": "Être sans titulaire, n'être pas pourvu ou occupé, en parlant d'une charge, d'un poste ou d'un siège.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disponibilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poste de directeur va <w>vaquer</w> dès la fin du mois en cours."
                        },
                        {
                            "text": "Ce siège épiscopal <w>vaqua</w> durant plusieurs mois avant la désignation d'un successeur."
                        }
                    ]
                },
                {
                    "sense_id": "9e63c4c4-e652-3f28-9489-0a75b8f4d520",
                    "sense_definition": "Aller et venir librement d'un endroit à un autre, déambuler.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants adorent <w>vaquer</w> dans le jardin pendant les beaux jours d'été."
                        },
                        {
                            "text": "Nous l'avons aperçu qui <w>vaquait</w> tranquillement dans les couloirs silencieux du château."
                        }
                    ],
                    "synonyms": [
                        "déambuler",
                        "errer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "d'un usage principalement littéraire"
                        }
                    ]
                },
                {
                    "sense_id": "7878e63c-ff26-3501-bb18-7d7448684eaa",
                    "sense_definition": "Interrompre temporairement ses séances ou ses fonctions ordinaires, en parlant d'un tribunal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal cesse de siéger et <w>vaque</w> pendant toute la période estivale."
                        },
                        {
                            "text": "La cour d'appel ne recevra aucun dossier tant qu'elle <w>vaquera</w>."
                        }
                    ]
                }
            ]
        }
    ]
}