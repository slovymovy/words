                ],
                "senses": [
                    {
                        "sense_id": "379960d5-1b63-3969-a841-238b35b462ab",
                        "entry_id": "ea982e1d-668d-325b-9256-0f24e51d8ec2",
                        "glosses": [
                            "awantura, bijatyka, skandal"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2abf8221-a216-4145-980b-e9b72c78a4cf",
                                "sense_id": "379960d5-1b63-3969-a841-238b35b462ab",
                                "text": "Policja ukarała mandatem grupę mężczyzn za wszczęcie rozróby w barze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36516024-4722-468d-bc40-6ac5fd42e163",
                        "source_entry_id": "ea982e1d-668d-325b-9256-0f24e51d8ec2",
                        "source_sense_id": "379960d5-1b63-3969-a841-238b35b462ab",
                        "target_lang_word": "aggro",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aggro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "507bdbc9-24d3-301b-a645-087d3013acce",
                                        "entry_id": "841d3d58-acdd-33e3-ab5b-d1f202efd9bc",
                                        "glosses": [
                                            "Aggravation; bother."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fd221c-bd78-4518-9c1d-076e6d16999f",
                                                "sense_id": "507bdbc9-24d3-301b-a645-087d3013acce",
                                                "text": "But the thing to remember was that some women were prepared to provide an outlet, in spite of all the aggro, if the money was right. And lots of guys were prepared to pay, in spite of the aggro. And what the aggro boiled down to, if you thought about it, was the shame of being known to be the person who had been involved."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e0bbe09-619b-3527-934e-9d74fde2418e",
                                        "entry_id": "841d3d58-acdd-33e3-ab5b-d1f202efd9bc",
                                        "glosses": [
                                            "Aggressive behaviour; loud, intimidating behaviour that convincingly threatens violence without necessarily actually becoming violent."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0b68519-9230-458b-9b6e-ca51839baabf",
                                                "sense_id": "7e0bbe09-619b-3527-934e-9d74fde2418e",
                                                "text": "Move along, lads; we don't want any aggro."
                                            },
                                            {
                                                "example_id": "a207e137-961e-4052-82fc-e8f87801417c",
                                                "sense_id": "7e0bbe09-619b-3527-934e-9d74fde2418e",
                                                "text": "That is the case because, according to Marsh, soccer hooliganism is one of Britain's principal forms of aggro. If it is true that there is an absence of aggro traditions in the USA — and there is a wealth of evidence which suggests that Marsh is wrong on this score — then it is reasoble to deduce from Marsh′s arguments that it is unlikely that phenomena such as soccer hooliganism could or ever will develop there."
                                            },
                                            {
                                                "example_id": "fdfa6b8f-f90a-40b7-bc17-8153c4d3a086",
                                                "sense_id": "7e0bbe09-619b-3527-934e-9d74fde2418e",
                                                "text": "‘We ain′t got a name yet. We′re into aggro.’\n‘Aggro?’\n‘Yeah, you know, aggression, aggravation. Aggro’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d8171a4-cd53-30db-a785-49fec7cbebc7",
                                        "entry_id": "841d3d58-acdd-33e3-ab5b-d1f202efd9bc",
                                        "glosses": [
                                            "A measure of how belligerent a player is – a high value may inspire either avoidance or preemptive hostile action from enemies."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0cbe1aa-d2e7-4de2-9300-e3b5423cde07",
                                                "sense_id": "7d8171a4-cd53-30db-a785-49fec7cbebc7",
                                                "text": "To reduce one player's aggro level, the other must build up his own."
                                            },
                                            {
                                                "example_id": "edcdef8e-531f-42d1-9736-95e5279fa400",
                                                "sense_id": "7d8171a4-cd53-30db-a785-49fec7cbebc7",
                                                "text": "What isn't so gimmicky is the Aggro System, where you draw fire onto yourself by acting aggressive, while your partner sneaks off blindsiding distracted enemies. Aggro depends on how big your current weapon is and how often you act aggressive."
                                            },
                                            {
                                                "example_id": "d0873b23-df45-4687-a91a-9a4a5591452f",
                                                "sense_id": "7d8171a4-cd53-30db-a785-49fec7cbebc7",
                                                "text": "We asked for an ability to trasnfer^([sic]) our aggro to another player—were told that could cause some abuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4849059f-d9c0-37dc-b951-08a78b80e485",
                                        "entry_id": "841d3d58-acdd-33e3-ab5b-d1f202efd9bc",
                                        "glosses": [
                                            "Hostile attention from an enemy that should target players with better defenses."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a8fdeb-858f-4da9-bb0b-635583eb9aa3",
                                                "sense_id": "4849059f-d9c0-37dc-b951-08a78b80e485",
                                                "text": "You just pulled aggro off the tank and wiped the raid."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aggro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a118348-4d2d-3a9f-b707-662e6966c8f0",
                                        "entry_id": "5cea7981-be35-3db5-bd00-a92275df73fb",
                                        "glosses": [
                                            "Angry."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e84a3107-c0ae-45c9-9017-d438750a01d1",
                                                "sense_id": "0a118348-4d2d-3a9f-b707-662e6966c8f0",
                                                "text": "“The Chuckster say you two be finding aggro idiot who kilt Long,” said Dude.\nI thought I understood but looked at Charles for help.\n“Aggro means pissed off.” translated Charles. He still hadn't cracked a smile. Tardiness made Charles aggro."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1313abf7-7dda-36eb-9917-6ced3d6a2613",
                                        "entry_id": "5cea7981-be35-3db5-bd00-a92275df73fb",
                                        "glosses": [
                                            "Liable to attack without being attacked first (said of monsters)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdb037bb-8512-3292-8170-3bece0cc9ec5",
                                        "entry_id": "5cea7981-be35-3db5-bd00-a92275df73fb",
                                        "glosses": [
                                            "Designed for aggressive play that seeks to defeat the opponent in the early stages of the game. (of a player) Favoring such decks."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dba7b632-f1ab-324f-b29b-fe50e61cd654",
                                        "entry_id": "5cea7981-be35-3db5-bd00-a92275df73fb",
                                        "glosses": [
                                            "Hardcore, aggressive."
                                        ],
                                        "tags": [
                                            "British",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54688cf5-2b5d-4815-83de-d597cdabd414",
                                                "sense_id": "dba7b632-f1ab-324f-b29b-fe50e61cd654",
                                                "text": "At the beginning of the twenty-first century the physically adept aggro femme had become a recurring motif in new circus and physical theatre."
                                            },
                                            {
                                                "example_id": "2e084743-b9e6-4a9e-92ff-7de7de679592",
                                                "sense_id": "dba7b632-f1ab-324f-b29b-fe50e61cd654",
                                                "text": "Each Black Flag line-up had a personality and vibe. They were all totally aggro and totally rocking."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aggro",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c39fdfe1-92bf-3003-b73b-0d28e5b934b5",
                                        "entry_id": "ef7aa7b3-8f22-323b-84d3-edb7c0f24dce",
                                        "glosses": [
                                            "To become aggressive towards the player's character."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e66b616-126f-4895-ac7f-1b8c95a69292",
                                                "sense_id": "c39fdfe1-92bf-3003-b73b-0d28e5b934b5",
                                                "text": "They'll aggro on you if you get too close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "964f271d-28bb-397c-89a9-6050680f07c5",
                                        "entry_id": "ef7aa7b3-8f22-323b-84d3-edb7c0f24dce",
                                        "glosses": [
                                            "To cause (a non-player character) to become aggressive towards the player's character."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d691e7-9aee-4392-a8d5-e65e3b3493ff",
                                                "sense_id": "964f271d-28bb-397c-89a9-6050680f07c5",
                                                "text": "I aggroed the dragon by stealing from its hoard, and it killed me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
