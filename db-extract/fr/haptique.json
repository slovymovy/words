                    {
                        "sense_id": "8d272e42-d4dc-341c-9cf8-902db46a345c",
                        "entry_id": "9de269df-b43e-353c-9c41-07dab13f34e4",
                        "glosses": [
                            "Science du toucher, et des phénomènes kinesthésiques, c’est-à-dire de la perception du corps dans l’environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b34da99a-b1be-4d5f-add9-6aba43cd56f7",
                                "sense_id": "8d272e42-d4dc-341c-9cf8-902db46a345c",
                                "text": "En ce qui concerne la réception des œuvres littéraires et visuelles en général, l’haptique est présente dès lors que le texte ou l’image déclenche des simulations perceptives sensorimotrices engageant une réunion du tactile et du kinesthésique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d1f9afb-bb46-4d45-84ee-485e2f1efbde",
                        "source_entry_id": "9de269df-b43e-353c-9c41-07dab13f34e4",
