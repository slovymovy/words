                "senses": [
                    {
                        "sense_id": "0a7ed33a-a668-3b60-8379-325a64649bb9",
                        "entry_id": "f8a9b381-602f-384e-b8c9-5bf397ae81c5",
                        "glosses": [
                            "rundliche Ausweitung, Wölbung nach außen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84e8f671-cf11-42cf-9c1c-e751e370d06d",
                                "sense_id": "0a7ed33a-a668-3b60-8379-325a64649bb9",
                                "text": "„Ausstülpungen, bei denen alle Wandschichten des betroffenen Organs beteiligt sind, werden als echte Divertikel bezeichnet.“"
                            },
                            {
                                "example_id": "ada96297-6574-4b71-b890-30a56063fb72",
                                "sense_id": "0a7ed33a-a668-3b60-8379-325a64649bb9",
                                "text": "„Die Netzhaut ist im Laufe der Entwicklung aus einer Ausstülpung des Gehirns entstanden. In ihr wird Licht in elektrische Signale umgewandelt, die der Augennerv zum hinteren Teil des Gehirns transportiert, und das ermöglicht uns das Sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
