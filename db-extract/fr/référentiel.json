                                    {
                                        "sense_id": "5033c5ed-4438-36c7-8989-76afa8da1558",
                                        "entry_id": "40a3cacb-2808-33a5-ba74-41ec076f646c",
                                        "glosses": [
                                            "A set of assumptions, ideas and standards that form a viewpoint from which philosophical, religious and other ideas may be evaluated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531d13b6-c551-4233-9a70-9f44aa61ae44",
                                                "sense_id": "5033c5ed-4438-36c7-8989-76afa8da1558",
                                                "text": "Anyone with an unsubverted or cleansed frame of reference likely couldn't bear seeing such mistreatment and violence."
                                            },
                                            {
                                                "example_id": "5845b654-7841-4c38-9f95-20ab79618082",
                                                "sense_id": "5033c5ed-4438-36c7-8989-76afa8da1558",
                                                "text": "When Kafka’s novels are analyzed with the autistic frame of reference in mind the behavior of his protagonists make more sense and will reveal that Kafka’s protagonists focus on external behavioral cues which are guided by Kafka’s education and mindset of a lawyer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50b94fd7-361c-3787-b951-02f92fd17c9d",
                                        "entry_id": "40a3cacb-2808-33a5-ba74-41ec076f646c",
                                        "glosses": [
                                            "A set of axes which enable an observer to measure the position and motion of all bodies in some system relative to the reference frame."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
