{
    "word_family": [
        "горный",
        "горец",
        "горка",
        "гористый"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6f9ab761-63c0-3e37-8bd1-e5d547b11688",
                    "sense_definition": "крупная форма рельефа, значительно возвышающаяся над окружающей местностью",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Туристы решили подняться на самую высокую <w>гору</w> в этом районе.",
                            "target_lang_translations": {
                                "en": "The tourists decided to climb the highest <w>mountain</w> in the area."
                            }
                        },
                        {
                            "text": "Зимой на вершине этой <w>горы</w> всегда лежит снег.",
                            "target_lang_translations": {
                                "en": "In winter, there is always snow on the peak of this <w>mountain</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "возвышенность"
                    ],
                    "antonyms": [
                        "равнина",
                        "низина"
                    ],
                    "common_phrases": [
                        "высокая гора",
                        "подняться на гору"
                    ],
                    "target_lang_definitions": {
                        "en": "A large landform that rises significantly above the surrounding terrain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mountain",
                                "target_lang_sense_clarification": "A large natural elevation of the earth's surface."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1355a569-5a93-3039-b690-a4685aa8fddc",
                    "sense_definition": "большое количество чего-либо, сложенное в одну кучу",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе лежала целая <w>гора</w> неразобранных бумаг.",
                            "target_lang_translations": {
                                "en": "A whole <w>heap</w> of unsorted papers lay on the table."
                            }
                        },
                        {
                            "text": "После праздника в углу комнаты выросла <w>гора</w> подарочных коробок.",
                            "target_lang_translations": {
                                "en": "After the party, a <w>pile</w> of gift boxes grew in the corner of the room."
                            }
                        }
                    ],
                    "common_phrases": [
                        "гора вещей",
                        "гора мусора"
                    ],
                    "target_lang_definitions": {
                        "en": "A large quantity of something stacked or thrown together in one place."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heap",
                                "target_lang_sense_clarification": "A collection of things thrown together to form an elevation."
                            },
                            {
                                "target_lang_word": "pile",
                                "target_lang_sense_clarification": "A mass of things heaped together."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fdeaa6d-43cf-33d7-92e1-4de9d35d37a0",
                    "sense_definition": "сооружение в виде холма для катания",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Дети с радостью катались с ледяной <w>горы</w> в парке.",
                            "target_lang_translations": {
                                "en": "The children happily slid down the ice <w>slide</w> in the park."
                            }
                        },
                        {
                            "text": "Американские <w>горы</w> — это самый страшный аттракцион в этом парке.",
                            "target_lang_translations": {
                                "en": "The <w>roller coaster</w> is the scariest ride in this park."
                            }
                        }
                    ],
                    "synonyms": [
                        "холм"
                    ],
                    "common_phrases": [
                        "американские горы",
                        "ледяная гора"
                    ],
                    "target_lang_definitions": {
                        "en": "A structure, often in the form of a hill or slope, designed for sliding or amusement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slide",
                                "target_lang_sense_clarification": "A structure for sliding down, often found in parks."
                            },
                            {
                                "target_lang_word": "roller coaster",
                                "target_lang_sense_clarification": "An amusement park ride (often referred to as 'American mountains' in Russian)."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5d90897-7d4d-3e72-ae50-93b50f34a5a8",
                    "sense_definition": "горная местность или страна",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врачи настоятельно рекомендовали ему поехать отдыхать в <w>горы</w>.",
                            "target_lang_translations": {
                                "en": "Doctors strongly recommended that he go on vacation to the <w>mountains</w>."
                            }
                        },
                        {
                            "text": "Мы провели весь отпуск, путешествуя по <w>горам</w> Кавказа.",
                            "target_lang_translations": {
                                "en": "We spent our entire vacation traveling through the <w>mountains</w> of the Caucasus."
                            }
                        }
                    ],
                    "antonyms": [
                        "равнина"
                    ],
                    "common_phrases": [
                        "поехать в горы",
                        "отдых в горах"
                    ],
                    "target_lang_definitions": {
                        "en": "A mountainous region or area."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mountains",
                                "target_lang_sense_clarification": "A region characterized by high, rugged terrain."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31dcb18c-3716-3c80-b4fd-ffbd262ad521",
                    "sense_definition": "место для записи штрафных очков в карточной игре",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "game",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Игрок был вынужден записать штрафные очки в <w>гору</w>.",
                            "target_lang_translations": {
                                "en": "The player was forced to record penalty points in the <w>mountain</w> (score pile)."
                            }
                        },
                        {
                            "text": "После неудачного хода его <w>гора</w> значительно увеличилась.",
                            "target_lang_translations": {
                                "en": "After a bad move, his <w>mountain</w> (score pile) increased significantly."
                            }
                        }
                    ],
                    "antonyms": [
                        "пуля"
                    ],
                    "target_lang_definitions": {
                        "en": "A specific area or category for recording penalty points in certain card games."
                    },
                    "translations": {
                        "en": []
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "71533f31-e092-3b0e-84ab-fe8ed67a3350",
                    "sense_definition": "мужское имя, гипокористика к <w>Егор</w> или <w>Георгий</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего старого школьного друга все зовут просто <w>Гора</w>.",
                            "target_lang_translations": {
                                "en": "Everyone calls my old school friend just <w>Gora</w>."
                            }
                        },
                        {
                            "text": "Никто в офисе не знал, что <w>Гора</w> — это сокращение от Георгий.",
                            "target_lang_translations": {
                                "en": "No one in the office knew that <w>Gora</w> is short for Georgy."
                            }
                        }
                    ],
                    "synonyms": [
                        "Жора"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорная форма имени"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male given name, a colloquial diminutive of Egor or Georgy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Gora",
                                "target_lang_sense_clarification": "A nickname or short form of a Russian name."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75e596e9-8ae4-3cd6-91c5-f116f641541f",
                    "sense_definition": "богиня времени года в древнегреческой мифологии",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mythology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "Древние греки верили, что <w>Горы</w> следят за сменой времен года.",
                            "target_lang_translations": {
                                "en": "The ancient Greeks believed that the <w>Horae</w> watched over the changing of the seasons."
                            }
                        },
                        {
                            "text": "На фреске изображена <w>Гора</w>, приносящая весеннее тепло.",
                            "target_lang_translations": {
                                "en": "The fresco depicts a <w>Hora</w> bringing spring warmth."
                            }
                        }
                    ],
                    "synonyms": [
                        "Ора"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "мифологический контекст"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A goddess of the seasons in ancient Greek mythology."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Hora",
                                "target_lang_sense_clarification": "One of the Greek goddesses of the seasons and natural portions of time."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}