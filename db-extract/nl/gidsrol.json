                        "examples": [
                            {
                                "example_id": "da936504-a71e-4fc5-9ea6-fa291f18ddf8",
                                "sense_id": "6b77bdaf-cb5a-3913-a94f-db6fac02aa52",
                                "text": "Asscher zou het jammer vinden als er in het Sinterklaasjournaal van de publieke omroep, dat volgens hem een gidsrol heeft, toch weer zwarte pieten opduiken. Maar de politiek gaat daar niet over, zei hij."
                            },
                            {
                                "example_id": "6a22e064-05c3-47c6-9b43-186621b8c0d0",
                                "sense_id": "6b77bdaf-cb5a-3913-a94f-db6fac02aa52",
                                "text": "Het overdragen van deze waarden vereist voorleven, doorgeven en inwijden. De gidsrol van ouders is van belang, zoals Van der Ploeg terecht betoogt. Juist een gids biedt naast aandacht en positieve ondersteuning ook grenzen. Onze kinderen hebben leiding en begeleiding nodig."
                            }
                        ]
                    }
