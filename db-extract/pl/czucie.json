                "senses": [
                    {
                        "sense_id": "cb4b8825-dadf-351e-8fdf-164e3badc090",
                        "entry_id": "e7afef8d-bfb7-34dc-9d64-f21c82ae9e14",
                        "glosses": [
                            "odbiór poprzez zmysły, reakcja na odbierane aspekty rzeczywistości"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf47681b-87f6-4db2-92bb-3f2a15455d10",
                                "sense_id": "cb4b8825-dadf-351e-8fdf-164e3badc090",
                                "text": "Czucie i wiara silniej mówi do mnie niż mędrca szkiełko i oko."
                            },
                            {
                                "example_id": "83b8b72f-e0d0-4281-bf50-28bc4670d652",
                                "sense_id": "cb4b8825-dadf-351e-8fdf-164e3badc090",
                                "text": "Po wypadku Jacek stracił czucie w lewej ręce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "50bdd52f-5f5c-337f-aa7d-53b18b2307b2",
                        "entry_id": "e7afef8d-bfb7-34dc-9d64-f21c82ae9e14",
