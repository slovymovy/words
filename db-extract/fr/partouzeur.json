                        "entry_id": "c2191817-1cd6-310b-b0e1-ab5df3c4cc80",
                        "glosses": [
                            "Participant, adepte de la partouze."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce500ff-9819-4b7b-9f7c-4a1593d394ff",
                                "sense_id": "da5649b6-67f7-382a-b9f6-c86380999a9d",
                                "text": "Si, effectivement, nous sommes en présence d’un partouzeur qui veut garder une belle image auprès de sa vieille mère, il y a sûrement moyen de vendre sa tranquillité."
                            },
                            {
                                "example_id": "a3721997-9968-4c63-ac7d-891a7b65477b",
                                "sense_id": "da5649b6-67f7-382a-b9f6-c86380999a9d",
                                "text": "Elle avait la mamelle triste et la fesse en goutte d'huile, des légions de partouzeurs l'avaient aplatie comme une tortilla, à force de la prendre en sandwich, s'excita Clara."
                            }
                        ]
                    }
