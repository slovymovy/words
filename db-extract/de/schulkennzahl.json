                "senses": [
                    {
                        "sense_id": "c7504432-4605-3dd7-92e8-3a10c445c939",
                        "entry_id": "6bf0b9da-4084-3d6f-abc4-ce882514c6e9",
                        "glosses": [
                            "Nummer, die jeder Schule (in einem bestimmten Gebiet) eindeutig zugeordnet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "699869ff-b065-460e-98aa-387cfcf08298",
                                "sense_id": "c7504432-4605-3dd7-92e8-3a10c445c939",
                                "text": "„Die Kuverts wurden mit der Schulkennzahl versehen und mit der exakten Fragebogenanzahl bestückt.“"
                            },
                            {
                                "example_id": "35e13cf0-cb6b-4eff-bd22-65214a99d7ff",
                                "sense_id": "c7504432-4605-3dd7-92e8-3a10c445c939",
                                "text": "„Namen von Schülern, Klasse, Schule oder Schulkennzahl sollen codiert bzw. weggelassen werden.“"
                            },
                            {
                                "example_id": "6a4565ef-58d6-4dcb-9281-be0d882f95e2",
                                "sense_id": "c7504432-4605-3dd7-92e8-3a10c445c939",
                                "text": "„Problem laut Schülerunion: Dieser [Code] werde nicht automatisch generiert, sondern setze sich aus Schulkennzahl, Klasse, Geburtsdatum des Schülers, Katalognummer und Geschlecht zusammen, hieß es in einer Aussendung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
