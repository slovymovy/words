                    {
                        "sense_id": "ffb8e2b4-e438-3cc4-96ec-b62b36d43846",
                        "entry_id": "c7303778-4d83-3e71-96da-fed4fcd168e4",
                        "glosses": [
                            "Kette/Reihe von Beweisen, miteinander zusammenhängende Beweise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29b9f68-3c77-4c13-8a3e-5ce9b695cf44",
                                "sense_id": "ffb8e2b4-e438-3cc4-96ec-b62b36d43846",
                                "text": "„Der begründete Zweifel ist stets das schwächste Glied in der Beweiskette eines Staatsanwalts, und je komplizierter ein Fall, desto mehr Zweifel kommen auf.“"
                            },
                            {
                                "example_id": "f2b0f7b1-1798-4278-9831-41b2975260ad",
                                "sense_id": "ffb8e2b4-e438-3cc4-96ec-b62b36d43846",
                                "text": "„Also ging der Auftrag, zum Friedhof zu fahren, an mich - einen Profi, der dafür sorgt, dass die Beweiskette nicht zerstört wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
