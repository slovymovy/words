                        ],
                        "form": "geultjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1c95e0d-e243-3215-b194-0ef7593d2038",
                        "entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "glosses": [
                            "een lange en smalle verlaging in de grond waar water door kan stromen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f34dec-7e2d-4a34-9f5c-e40de0d8a8f8",
                                "sense_id": "f1c95e0d-e243-3215-b194-0ef7593d2038",
                                "text": "Hij probeerde te ontsnappen via een weiland, maar bleef steken in een geul."
                            },
                            {
                                "example_id": "c851691f-094b-41f7-80d8-6af739ee950b",
                                "sense_id": "f1c95e0d-e243-3215-b194-0ef7593d2038",
                                "text": "Langs de IJssel tussen Veessen en Wapenveld wordt een geul gegraven om de IJssel bij extreem hoogwater meer ruimte te geven."
                            }
                        ]
                    },
                    {
                        "sense_id": "e86af3ba-1d8e-3818-b788-f339d77cda88",
                        "entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "glosses": [
                            "een lange en smalle verlaging in de bodem van een rivier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05397424-6870-408c-8784-60d2a3d52208",
                                "sense_id": "e86af3ba-1d8e-3818-b788-f339d77cda88",
                                "text": "De geul naar Rotterdam is zo smal dat de loodsen de hulp van een draagbaar navigatiesysteem goed kunnen gebruiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e52e45b-c115-314a-812b-5fcea507bbf6",
                        "entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "glosses": [
                            "een kleine uitholling ontstaan door erosie of de eroderende werking van water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b055d4d-ac98-4b33-b26d-9a91554f6efb",
                                "sense_id": "5e52e45b-c115-314a-812b-5fcea507bbf6",
                                "text": "Bij sneeuw en gletsjers wordt de geul waardoor de massa zich baant door de druk van het ijs verdiept en verbreed en het losgewerkte materiaal in en onder het ijs verplaatst."
                            }
                        ]
                    },
                    {
                        "sense_id": "5adf5d8a-9c47-384b-b0a5-075068c81b3f",
                        "entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "glosses": [
                            "een verdieping tussen de zandbanken in het wad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d303c66-f03c-404c-ab1a-3c353cd32fca",
                                "sense_id": "5adf5d8a-9c47-384b-b0a5-075068c81b3f",
                                "text": "Je zakt soms tot je knieën weg in het slik en af en toe moet je door een geul waden en komt het water tot je middel."
                            }
                        ]
                    },
                    {
                        "sense_id": "68779243-7f4e-32ec-9863-1e561b311506",
                        "entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "glosses": [
                            "een aanleg van ondergrondseinfrastructuur zoals kabels en leidingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d87231b5-40ce-4fed-8a0c-0f3d4318cae5",
                                "sense_id": "68779243-7f4e-32ec-9863-1e561b311506",
                                "text": "Er wordt een geul gegraven van ongeveer 30 cm diep dwars door de tuin. Deze is voor de leidingen in de badkamer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f1280eb-4e9d-4b15-a06f-40a0c7a084d8",
                        "source_entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "source_sense_id": "f1c95e0d-e243-3215-b194-0ef7593d2038",
                        "source_sense_description": "een lange en smalle verlaging in de grond waar water door kan stromen",
                        "target_lang_word": "Rinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmale, längliche Vertiefung, durch die Wasser fließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f3b0f6-a626-45b8-a32a-1b75f4af6d60",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Für Wanderer gibt es zwischen den Wänden, Graten und Rinnen kaum Platz, doch die wenigen Möglichkeiten sind atemberaubend.“"
                                            },
                                            {
                                                "example_id": "41fe96ad-7f5b-4873-a018-3709465dad51",
                                                "sense_id": "208617e7-2f5c-323f-9d29-e631c251becf",
                                                "text": "„Als wir dicht herankamen, sah ich, dass eine tiefe Rinne hinaufführte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "Kurzform für die Fahrrinne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26d96a4-b850-4b2f-8b63-22c356bd521d",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Sitzt man am Rhein, so kann man die Frachtschiffe in der Rinne fahren sehen."
                                            },
                                            {
                                                "example_id": "1c865252-3630-4558-a52f-59c8bb44baca",
                                                "sense_id": "505db2d5-5558-332c-9ad9-8dcd1e165b44",
                                                "text": "Die Fahrrinne im Fluss wird extra durch Bojen gekennzeichnet, da diese Rinne im Flussbett auch bei Niedrigwasser immer \"Eine handbreit Platz unter dem Kiel\" bedeutet!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                        "entry_id": "822425fc-0a96-333a-ba56-f317a2ff1e89",
                                        "glosses": [
                                            "schmaler, langer, in Form einer Halbschale ausgehöhlter Körper aus Blech, Holz usw. in der etwas abfließen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9edd48ac-e091-4190-8bf9-03ff8544ad1b",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "Die Rinne des Daches wird im Herbst oftmals durch Laub verstopft."
                                            },
                                            {
                                                "example_id": "8ed662ff-3d68-49ac-bf31-2b7e213b11a6",
                                                "sense_id": "2f886cbc-38db-349f-a57b-330abd77222b",
                                                "text": "„Papa stellte zwei Leitern dran, und dann sollten Volker und ich mit Rundspachteln den Kniest aus der Rinne schaben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                        "entry_id": "625098f3-7aab-330a-9506-437dca503037",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3b7128c-04a7-45f2-9b78-7a2ed54c7130",
                                                "sense_id": "2839fa11-26d9-3f10-8380-a5b30daeb1bf",
                                                "text": "„Friedrich Heinrich (Fritz) Rinne (* 1852 in Eilsen; † 2. März 1924 in Berlin) war ein deutscher Chirurg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "191d8581-2780-3699-87ba-6c091b6e730c",
                                        "entry_id": "24c05283-95c1-37a6-bebc-3470dc77ce88",
                                        "glosses": [
                                            "Fluss oder auch See in Deutschland"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "388c8e58-7e6f-4d3b-90be-56078769db3d",
                        "source_entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "source_sense_id": "e86af3ba-1d8e-3818-b788-f339d77cda88",
                        "source_sense_description": "een lange en smalle verlaging in de bodem van een rivier",
                        "target_lang_word": "Fahrrinne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fahrrinne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b74e7a2f-7e37-37a9-9d6d-06ec11dc6caf",
                                        "entry_id": "e439e234-b876-3a6a-9709-1d3ad3c26460",
                                        "glosses": [
                                            "derjenige enge Bereich eines Gewässers, der von Schiffen auch bei Niedrigwasser befahren werden kann"
                                        ],
                                        "tags": [
                                            "Schifffahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fd5ca5e-1001-42ad-85c4-5ac7dc48e173",
                                                "sense_id": "b74e7a2f-7e37-37a9-9d6d-06ec11dc6caf",
                                                "text": "„Ein holländisches und ein französisches Schiff, die ihm entgegen kamen, überholten sich an einer engen Stelle der Fahrrinne.“"
                                            },
                                            {
                                                "example_id": "77019f77-e700-4661-80c3-45a577a87931",
                                                "sense_id": "b74e7a2f-7e37-37a9-9d6d-06ec11dc6caf",
                                                "text": "„Beiderseits der Fahrrinne standen die Mannschaften, im Seilzug bewegten sich die Schiffe durch den Kanal, die Sonne schien, die Matrosen sangen, in den Topps wehte der Union Jack, es war ein festlicher Tag.“"
                                            },
                                            {
                                                "example_id": "3e697ca0-ac3d-476d-b617-76f38fd54c64",
                                                "sense_id": "b74e7a2f-7e37-37a9-9d6d-06ec11dc6caf",
                                                "text": "„Im Wasser sind Wellen zu erkennen, womöglich die Fahrrinne, ein grüner Teppich, der zum Ufer führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "508c2dc8-6ab8-41d1-96ac-b89e3f14b91a",
                        "source_entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "source_sense_id": "5e52e45b-c115-314a-812b-5fcea507bbf6",
                        "source_sense_description": "een kleine uitholling ontstaan door erosie of de eroderende werking van water",
                        "target_lang_word": "Ausfurchung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ceca774b-41d0-47c4-96f3-518307a61895",
                        "source_entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "source_sense_id": "5adf5d8a-9c47-384b-b0a5-075068c81b3f",
                        "source_sense_description": "een verdieping tussen de zandbanken in het wad",
                        "target_lang_word": "Priel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Priel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                        "entry_id": "487f4b64-c461-36c0-a67b-1de6323f79ab",
                                        "glosses": [
                                            "natürlicher, tideabhängiger Wasserlauf im Deichvorland und Watt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049c65f0-ff92-439c-aa58-e0c28a69d1ff",
                                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                                "text": "Größere Priele dienen der Wattschifffahrt als Fahrrinnen."
                                            },
                                            {
                                                "example_id": "c53a74cd-aab0-4570-958c-351b3a3770ac",
                                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                                "text": "„Seeschwalben stürzen sich kopfüber in kleine Priele, die die Hallig wie Adern durchziehen.“"
                                            },
                                            {
                                                "example_id": "294e437f-6cdc-4d07-901a-e59da5b4e079",
                                                "sense_id": "172556e4-d771-37dc-8481-59f43aa5a754",
                                                "text": "„Nach drei Stunden lag der sandige Boden des Meeresarms frei, in der Mitte floß noch Wasser in einem Priel, das sich aber ohne weiteres durchwaten lassen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f779b2a5-be59-4f84-99f4-7e819109b3b9",
                        "source_entry_id": "0b8acfaf-5290-3d26-a0ad-6716ba312b75",
                        "source_sense_id": "68779243-7f4e-32ec-9863-1e561b311506",
                        "source_sense_description": "een aanleg van ondergrondseinfrastructuur zoals kabels en leidingen",
                        "target_lang_word": "Kanal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                        "entry_id": "287af6ff-cde2-3db2-965a-231e4b0292f0",
                                        "glosses": [
                                            "künstlich errichteter Wasserlauf oder Verkehrsweg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74516990-6bdd-4cdc-96ef-95b6a31d62ea",
                                                "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                                "text": "Viele Orte sind für Schiffe über einen Kanal erreichbar."
                                            },
                                            {
                                                "example_id": "e322904b-c20e-4c66-a85d-add63608d072",
                                                "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                                "text": "„Zwei Wege führten an Kanälen entlang, waren aber weit.“"
                                            },
                                            {
                                                "example_id": "46c9a5da-0227-4892-a1dc-47a4b9a81621",
                                                "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                                "text": "„Kanäle, satt schimmernd wie Jade, ziehen unter uns vorbei, Kanäle, auf denen breite Schuten liegen.“"
                                            },
                                            {
                                                "example_id": "73abcf62-aca2-40e6-9b5c-2b8ad625c4d7",
                                                "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                                "text": "„Ein solcher Kanal wäre nicht nur die ultimative Abkürzung für die Expansion und die Handelsverbindungen nach Westen gewesen, sondern auch eine Lösung, mittels der die gefährliche Passage rund um Kap Hoorn vermieden werden könnte.“"
                                            },
                                            {
                                                "example_id": "94f03a86-d0b7-478d-a4dd-ec25ed2a40c6",
                                                "sense_id": "af6c0338-654d-3cf3-96da-db352578952d",
                                                "text": "„Er schlenderte lange an den Kanälen hin und über Brücken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee600650-9a68-32ca-9229-020e4f3861eb",
                                        "entry_id": "287af6ff-cde2-3db2-965a-231e4b0292f0",
                                        "glosses": [
                                            "natürliche Meeresstraße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d5cca19-db9e-486f-888b-aa5231417508",
                                                "sense_id": "ee600650-9a68-32ca-9229-020e4f3861eb",
                                                "text": "Die Meerenge zwischen England und Frankreich heißt \"Ärmelkanal\"."
                                            },
                                            {
                                                "example_id": "abd63142-1f7c-40dd-a512-7a9c93262ded",
                                                "sense_id": "ee600650-9a68-32ca-9229-020e4f3861eb",
                                                "text": "„Als das Reich dann tatsächlich zur Kolonialmacht wurde, durften sich die Aktivisten kurze Zeit auf Augenhöhe mit dem ewigen Rivalen jenseits des Kanals fühlen.“"
                                            },
                                            {
                                                "example_id": "20ce1f04-d399-44b0-acec-973d33f367da",
                                                "sense_id": "ee600650-9a68-32ca-9229-020e4f3861eb",
                                                "text": "„Wir hatten mit unseren ersten Fronteinsätzen im Kanal gewissermaßen Pionierarbeit geleistet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "04f9fcea-7215-367d-97e8-b4f8a4f4a29d",
                                        "entry_id": "287af6ff-cde2-3db2-965a-231e4b0292f0",
                                        "glosses": [
                                            "Abwasserentsorgung im Siedlungsgebiet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66bee2ef-af82-46ed-956d-44335e8606bc",
                                                "sense_id": "04f9fcea-7215-367d-97e8-b4f8a4f4a29d",
                                                "text": "Der Kanal fasste die Regenmenge nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "46e8f4ea-3504-36e4-b83e-5d7dc8be9b4a",
                                        "entry_id": "287af6ff-cde2-3db2-965a-231e4b0292f0",
                                        "glosses": [
                                            "bestimmter Frequenzbereich in Rundfunktechnik"
                                        ],
                                        "tags": [
                                            "Telekommunikation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b9f69c-2d51-4b06-a965-67948f9046da",
                                                "sense_id": "46e8f4ea-3504-36e4-b83e-5d7dc8be9b4a",
                                                "text": "Die ARD liegt bei mir auf Kanal 1."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "b30ebc3a-ca7e-3fc3-8a06-6e068644c989",
                                        "entry_id": "287af6ff-cde2-3db2-965a-231e4b0292f0",
                                        "glosses": [
                                            "allgemeiner Übertragungsweg für Information in der Informationstheorie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0439a476-ca37-4588-b042-49b6b270431f",
                                                "sense_id": "b30ebc3a-ca7e-3fc3-8a06-6e068644c989",
                                                "text": "„Er bediente sich zweier ihm persönlich verbundener Personen, die teilweise auf eigene Faust und über private Kanäle geheimdienstlich für ihn tätig waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kanal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8a3ece4-67be-3a61-8b1d-0075434b07fd",
                                        "entry_id": "101251df-23cf-31be-aeeb-ae9d567a88bf",
