                "senses": [
                    {
                        "sense_id": "0f40ebcd-c6c1-37e6-a9ab-b793c600f8eb",
                        "entry_id": "4ca32a27-a950-3f8d-b743-c8e2cd164b7b",
                        "glosses": [
                            "zob. Dionizos, Bakchos, Liber, Liber Pater"
                        ],
                        "tags": [
                            "Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "85f5bd48-e74d-4c16-895b-21b53f5d4826",
                                "sense_id": "0f40ebcd-c6c1-37e6-a9ab-b793c600f8eb",
                                "text": "Atrybutami Bachusa były: tyrs, kielich (kantaros), wino, wieniec z bluszczu lub winorośli, kiść winogron, delfin, kozioł, osioł, pantera, lampart, leopard, lew i róg obfitości."
                            },
                            {
                                "example_id": "f827e223-6a5b-41df-bd62-895b0ba54264",
                                "sense_id": "0f40ebcd-c6c1-37e6-a9ab-b793c600f8eb",
                                "text": "Dionizos, zwany też Bachusem, był identyfikowany w starożytnym Rzymie z italskim Liberem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f09489b1-81b0-429f-8b4c-de37a98968eb",
