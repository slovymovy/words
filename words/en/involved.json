{
    "word_family": [
        "involvement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ea05aed1-3388-3cbf-b362-d4281200e5f2",
                    "sense_definition": "Associated with others or taking part in an activity, event, or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Several local businesses are <w>involved</w> in the charity event.",
                            "target_lang_translations": {
                                "ru": "Несколько местных компаний <w>участвуют</w> в благотворительном мероприятии.",
                                "fr": "Plusieurs entreprises locales sont <w>impliquées</w> dans l'événement caritatif."
                            }
                        },
                        {
                            "text": "He decided to get <w>involved</w> in student politics this year.",
                            "target_lang_translations": {
                                "ru": "В этом году он решил <w>заняться</w> студенческой политикой.",
                                "fr": "Il a décidé de s'<w>impliquer</w> dans la politique étudiante cette année."
                            }
                        }
                    ],
                    "synonyms": [
                        "participating",
                        "engaged",
                        "active",
                        "part of"
                    ],
                    "antonyms": [
                        "uninvolved"
                    ],
                    "common_phrases": [
                        "get involved",
                        "involved in",
                        "become involved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связанный с другими людьми или принимающий участие в какой-либо деятельности или событии.",
                        "fr": "Associé à d'autres personnes ou participant à une activité, un événement ou une situation."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вовлечённый",
                                "target_lang_sense_clarification": "погружённый в процесс или деятельность"
                            },
                            {
                                "target_lang_word": "участвующий",
                                "target_lang_sense_clarification": "принимающий активное участие"
                            },
                            {
                                "target_lang_word": "причастный",
                                "target_lang_sense_clarification": "имеющий отношение к чему-либо"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "impliqué",
                                "target_lang_sense_clarification": "qui participe activement à une activité ou un projet"
                            },
                            {
                                "target_lang_word": "engagé",
                                "target_lang_sense_clarification": "qui prend part à une cause ou une action"
                            },
                            {
                                "target_lang_word": "participant",
                                "target_lang_sense_clarification": "qui prend part à un événement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96d57972-da9e-3cc5-bf3d-3db52f8e591d",
                    "sense_definition": "Having a romantic or sexual relationship with someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>involved</w> with a musician she met last month.",
                            "target_lang_translations": {
                                "ru": "В данный момент она <w>встречается</w> с музыкантом, с которым познакомилась в прошлом месяце.",
                                "fr": "Elle est actuellement <w>en couple</w> avec un musicien qu'elle a rencontré le mois dernier."
                            }
                        },
                        {
                            "text": "They became romantically <w>involved</w> shortly after working together.",
                            "target_lang_translations": {
                                "ru": "У них завязались <w>романтические отношения</w> вскоре после совместной работы.",
                                "fr": "Ils se sont <w>mis en couple</w> peu de temps après avoir travaillé ensemble."
                            }
                        }
                    ],
                    "antonyms": [
                        "single"
                    ],
                    "common_phrases": [
                        "involved with someone",
                        "romantically involved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состоящий в романтических или сексуальных отношениях с кем-либо.",
                        "fr": "Ayant une relation amoureuse ou sexuelle avec quelqu'un."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состоящий в отношениях",
                                "target_lang_sense_clarification": "имеющий романтическую связь"
                            },
                            {
                                "target_lang_word": "связанный",
                                "target_lang_sense_clarification": "в контексте личных отношений"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en couple",
                                "target_lang_sense_clarification": "qui entretient une relation amoureuse"
                            },
                            {
                                "target_lang_word": "en relation",
                                "target_lang_sense_clarification": "qui est lié sentimentalement à quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a508f7-8626-329d-957f-9b11e1700fc3",
                    "sense_definition": "Difficult to understand or deal with because of complexity.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plot of the movie was so <w>involved</w> that I lost track of the story.",
                            "target_lang_translations": {
                                "ru": "Сюжет фильма был таким <w>запутанным</w>, что я потерял нить повествования.",
                                "fr": "L'intrigue du film était si <w>complexe</w> que j'ai perdu le fil de l'histoire."
                            }
                        },
                        {
                            "text": "Applying for the visa was a long and <w>involved</w> process.",
                            "target_lang_translations": {
                                "ru": "Оформление визы было долгим и <w>сложным</w> процессом.",
                                "fr": "La demande de visa était un processus long et <w>compliqué</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "complicated",
                        "complex",
                        "intricate",
                        "convoluted"
                    ],
                    "antonyms": [
                        "simple",
                        "straightforward"
                    ],
                    "common_phrases": [
                        "involved process",
                        "involved story"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для понимания или выполнения из-за сложности и запутанности.",
                        "fr": "Difficile à comprendre ou à gérer en raison de sa complexité."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запутанный",
                                "target_lang_sense_clarification": "сложный для понимания (о сюжете, истории)"
                            },
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "многосоставный, трудоёмкий (о процессе)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "complexe",
                                "target_lang_sense_clarification": "qui comporte de nombreux éléments difficiles"
                            },
                            {
                                "target_lang_word": "compliqué",
                                "target_lang_sense_clarification": "qui est difficile à suivre ou à réaliser"
                            },
                            {
                                "target_lang_word": "enchevêtré",
                                "target_lang_sense_clarification": "très confus ou difficile à démêler"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ec3e97bc-c99e-33f7-9ce5-c1b83d6cf28e",
                    "sense_definition": "Simple past and past participle of <w>involve</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accident <w>involved</w> three cars and a truck.",
                            "target_lang_translations": {
                                "ru": "В аварии <w>участвовали</w> три легковых автомобиля и грузовик.",
                                "fr": "L'accident <w>impliquait</w> trois voitures et un camion."
                            }
                        },
                        {
                            "text": "Her job <w>involved</w> managing a large team of developers.",
                            "target_lang_translations": {
                                "ru": "Её работа <w>предполагала</w> управление большой командой разработчиков.",
                                "fr": "Son travail <w>impliquait</w> la gestion d'une grande équipe de développeurs."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола involve (включать, касаться, вовлекать).",
                        "fr": "Passé simple et participe passé du verbe impliquer ou nécessiter."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "включал",
                                "target_lang_sense_clarification": "содержал в себе как часть"
                            },
                            {
                                "target_lang_word": "предполагал",
                                "target_lang_sense_clarification": "требовал выполнения определённых действий"
                            },
                            {
                                "target_lang_word": "затрагивал",
                                "target_lang_sense_clarification": "касался кого-то или чего-то"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "impliquait",
                                "target_lang_sense_clarification": "qui avait pour conséquence ou contenait"
                            },
                            {
                                "target_lang_word": "nécessitait",
                                "target_lang_sense_clarification": "qui demandait comme condition nécessaire"
                            },
                            {
                                "target_lang_word": "concernait",
                                "target_lang_sense_clarification": "qui avait trait à quelque chose"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}