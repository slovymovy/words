                "senses": [
                    {
                        "sense_id": "461adb6e-ec3e-3f31-8d63-7b237aa98b6b",
                        "entry_id": "268c985b-ae63-36c4-9713-09d47e09e794",
                        "glosses": [
                            "комфортабельный автобус венгерской марки «Икарус»"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ecce7a9-f6a7-4141-bdab-958c2c9c7de4",
                                "sense_id": "461adb6e-ec3e-3f31-8d63-7b237aa98b6b",
                                "text": "В полночь вышли с турбазы на автобусную станцию, вскоре сели в автобус Новгород — Москва. Пытались спать. Автобус вообще комфортабельный, «икарус», но спать было неудобно."
                            },
                            {
                                "example_id": "62fccf86-20a0-401e-bb32-3e1531004d66",
                                "sense_id": "461adb6e-ec3e-3f31-8d63-7b237aa98b6b",
                                "text": "За пустырём тянулось шоссе, по нему проезжали не торопясь жёлтые, игрушечные отсюда «икарусы»."
                            }
                        ]
                    }
