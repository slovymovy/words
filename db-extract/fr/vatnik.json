                    {
                        "sense_id": "6c9abd37-5022-3b49-884e-881b099f29bf",
                        "entry_id": "9826c9ef-8547-3e84-a3d2-9cd49f5ed167",
                        "glosses": [
                            "vatnik (Putinist)"
                        ],
                        "tags": [
                            "Internet",
                            "by-personal-gender",
                            "derogatory",
