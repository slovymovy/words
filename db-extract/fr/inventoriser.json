                "senses": [
                    {
                        "sense_id": "6f5c8062-ae77-3d95-baf0-e4abace7fd96",
                        "entry_id": "9f1e0a3e-e7a7-3d6b-98f2-a10dae0ff70c",
                        "glosses": [
                            "Inventorier."
                        ],
                        "tags": [
                            "Désuet ou régional"
                        ],
                        "examples": [
                            {
                                "example_id": "32010e36-d3d2-44e9-9e06-cb27b156b334",
                                "sense_id": "6f5c8062-ae77-3d95-baf0-e4abace7fd96",
                                "text": "Qui veut jouir du bénéfice d’inventaire, doit dans quarante jours après que la succession sera ouverte, faire inventoriser les biens du defunct par personne publique sous aurorité de Justice."
                            },
                            {
                                "example_id": "3db1a87c-fac0-4965-996e-858516870121",
                                "sense_id": "6f5c8062-ae77-3d95-baf0-e4abace7fd96",
                                "text": "Le juge de paix témoigna quelque envie d’aller inventoriser notre prise."
                            },
                            {
                                "example_id": "c75d3e01-79a4-4c18-a7d0-be59f18f2fc3",
                                "sense_id": "6f5c8062-ae77-3d95-baf0-e4abace7fd96",
                                "text": "Le 23 août, en Conseil des Cinquante fut représenté l’emprisonnement de Philibert Berthelier fait aujourd’hui et qu’on procède à inventoriser ses biens avant que de l’avoir condamné."
                            }
                        ]
                    }
