                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "облагоро́див"
                    },
                    {
                        "form_id": "d49eccff-c96a-4277-8c90-59fd32c4a36b",
                        "entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "облагоро́дивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d48b07b-d15f-3377-90dc-a40902d561b1",
                        "entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "glosses": [
                            "сделать благородным, более благородным, более высоким в моральном отношении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f796124-2a25-476a-b576-96a9aed96830",
                                "sense_id": "2d48b07b-d15f-3377-90dc-a40902d561b1",
                                "text": "Принято думать,что в общем задача литературы – облагородить человека."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a1b44a9-826e-349d-a52e-ae1672b7afd3",
                        "entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "glosses": [
                            "сделать более изысканным, утонченным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2007ffb-faf5-4ef2-90df-b91b24bdb533",
                                "sense_id": "5a1b44a9-826e-349d-a52e-ae1672b7afd3",
                                "text": "Но как облагородить дачный участок, имея лишь огромное желание создать уютный уголок, но не имея при этом больших финансовых возможностей?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a51e3850-ff2e-391d-b886-5cfe5c95f738",
                        "entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "glosses": [
                            "спец. улучшить породу, качество (растений, животных, материалов)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fe05686-f7d2-46dd-ad53-19f0d5eb248c",
                                "sense_id": "a51e3850-ff2e-391d-b886-5cfe5c95f738",
                                "text": "Из второго они и могли заключить, что целым рядом превращений можно облагородить металлы."
                            }
                        ]
                    },
                    {
                        "sense_id": "06a4c288-6156-3d95-9575-d901eba5b4a4",
                        "entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "glosses": [
                            "устар. возвести в одно из высших званий, сословий, считавшихся благородными в дореволюционной России"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e8b29b5-7837-4434-a549-0ec115a782a4",
                        "source_entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "source_sense_description": "сделать благородным, более благородным, более высоким в моральном отношении",
                        "target_lang_word": "ennoblir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ennoblir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31f39156-523c-3a8e-9fde-53ccadd5dabb",
                                        "entry_id": "5da0df44-7ab3-3394-8d19-0669c8ffc238",
                                        "glosses": [
                                            "Donner de la noblesse, de l’élévation, de la dignité, du lustre. Cela s’applique aux personnes et aux choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc989a4c-9d4b-4283-9e3e-3422a88e3c32",
                                                "sense_id": "31f39156-523c-3a8e-9fde-53ccadd5dabb",
                                                "text": "Pour ennoblir davantage la langue russe, elles proscrivaient la moitié des mots, les remplaçant par des locutions françaises…, d’ailleurs beaucoup plus risquées."
                                            },
                                            {
                                                "example_id": "c335adec-67ab-4036-920c-3792f3a09c72",
                                                "sense_id": "31f39156-523c-3a8e-9fde-53ccadd5dabb",
                                                "text": "[…] ne trouvez-vous pas que l’aspect de la nature grandiose et sublime qui nous environne a quelque chose de saisissant qui ennoblit les idées, élève l’âme et rend l’homme meilleur ?"
                                            },
                                            {
                                                "example_id": "83cd3819-f469-4ab9-ab2f-c802afa8e6b0",
                                                "sense_id": "31f39156-523c-3a8e-9fde-53ccadd5dabb",
                                                "text": "Tout compte fait, quand je vois que nos Nîmois, pleins d’esprit et fier à juste titre des ruines majestueuses qui ennoblissent leur ville, se donnent des gants d’être presque des Romains, je ne puis m’empêcher de sourire à mon tour."
                                            },
                                            {
                                                "example_id": "19cafac1-09d7-4250-9145-7c6b4d2a66ba",
                                                "sense_id": "31f39156-523c-3a8e-9fde-53ccadd5dabb",
                                                "text": ";mais vous,qu’avez-vous à craindre de tout cela, vous autres hommes que tout le monde excuse, et que le scandale ennoblit?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9c044a-a11f-319e-8f4a-2ea2b1552489",
                                        "entry_id": "5da0df44-7ab3-3394-8d19-0669c8ffc238",
                                        "glosses": [
                                            "Donner industriellement des façons aux tissus (impression, satinage, effet duveteux…) pour augmenter leur beauté et leur valeur marchande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f73d2369-cacf-43d1-a415-08c046ae71d6",
                                                "sense_id": "cb9c044a-a11f-319e-8f4a-2ea2b1552489",
                                                "text": "Au cours du dix-neuvième siècle, les apprêteurs s'efforcèrent d’ennoblir les tissus de coton et ils y réussirent parfaitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62e2ef3d-cd94-3124-a939-9b01f093d748",
                                        "entry_id": "5da0df44-7ab3-3394-8d19-0669c8ffc238",
                                        "glosses": [
                                            "Anoblir noble, pourvoir d’un titre de noblesse."
                                        ],
                                        "tags": [
                                            "Ancien sens"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1f7cd5-70d4-40ff-a72c-0b3ae2dd25b8",
                        "source_entry_id": "00a8eed9-5118-3383-a0e8-03d773dcf705",
                        "source_sense_description": "возвести в одно из высших званий, сословий, считавшихся благородными",
                        "target_lang_word": "anoblir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anoblir",
