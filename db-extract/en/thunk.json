            {
                "entry_id": "dc53444b-0688-31a6-922d-bee26b7300dc",
                "word": "thunk",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "efce030d-050b-39c2-a295-de1a4f5a5138",
                        "entry_id": "dc53444b-0688-31a6-922d-bee26b7300dc",
                        "glosses": [
                            "past participle of think"
                        ],
                        "tags": [
                            "form-of",
                            "humorous",
                            "nonstandard",
                            "participle",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "7e9d15bf-d5b3-4117-90d5-2dc4d4cc4592",
                                "sense_id": "efce030d-050b-39c2-a295-de1a4f5a5138",
                                "text": "Who would have thunk those guys would have a problem with a little lie?"
                            },
                            {
                                "example_id": "e9865568-b490-4b2c-b19e-b4c725fd5996",
                                "sense_id": "efce030d-050b-39c2-a295-de1a4f5a5138",
                                "text": "A skunk sat on a stump and thunk the stump stunk, but the stump thunk that the skunk stunk."
                            },
                            {
                                "example_id": "a9c96ae8-2762-4e57-bf5d-fbe1e155d282",
                                "sense_id": "efce030d-050b-39c2-a295-de1a4f5a5138",
                                "text": "I could think of things I never thunk before ..."
                            },
                            {
                                "example_id": "07736864-2229-419c-b835-b95d48cc5543",
                                "sense_id": "efce030d-050b-39c2-a295-de1a4f5a5138",
                                "text": "“Do you think I could have a minute to think about it?” “The prisoner needs a moment to think about it.” “It's ok. I thought about it.” “He's thunk about it.” “Okay. And I agree.”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
