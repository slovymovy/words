                "senses": [
                    {
                        "sense_id": "c11204f2-6492-3195-9971-69742cf12844",
                        "entry_id": "981da49b-1be3-3887-a65e-6ffccb9c5a6a",
                        "glosses": [
                            "Mouche enjouée (grain de beauté factice placé sur une ride ou dans le creux du sourire)."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "472f5201-319f-4b02-b939-bbb629435d6e",
                                "sense_id": "c11204f2-6492-3195-9971-69742cf12844",
                                "text": "Toute la bande suit la Mancini et son mari. Sa mouche, une « enjouée », collée sur le pli du sourire, vibre comme un véritable insecte, à force de saluts."
                            },
                            {
                                "example_id": "bc9e5b0d-6d3a-4d13-80b9-a6a3bf6c61ad",
                                "sense_id": "c11204f2-6492-3195-9971-69742cf12844",
                                "text": "Mme de Pompadour d'un geste de sa main blanche dissipa la poudre qui planait encore. Pose-moi trois mouches, dit-elle à Martine. Une galante, une enjouée et une friponne!"
                            },
                            {
                                "example_id": "70bfc2bc-3558-47a4-940f-27fc172eb342",
                                "sense_id": "c11204f2-6492-3195-9971-69742cf12844",
                                "text": "En France , la mouche passionnée se plaçait au coin de l’œil , la majestueuse au milieu du front, l’enjouée sur les plis que fait la joue en souriant, la galante au milieu de la joue, la baiseuse au coin de la bouche, l’effrontée sur le nez, la coquette auprès des lèvres : la recluse cachait quelque bouton."
                            }
                        ]
                    }
