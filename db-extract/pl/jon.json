                                "target_senses": [
                                    {
                                        "sense_id": "46808b2d-1343-3c39-9679-e82050c40570",
                                        "entry_id": "6cd71594-ccee-340f-8e5d-6ecfd3378128",
                                        "glosses": [
                                            "Partícula cargada eléctricamente constituida por un átomo o molécula que no es eléctricamente neutro."
                                        ],
                                        "tags": [
                                            "Física"
