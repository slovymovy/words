                "senses": [
                    {
                        "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                        "entry_id": "1847296b-808b-330a-ae5c-86c5dd98ba06",
                        "glosses": [
                            "Modell (meist eines technischen Gerätes), bei der Teile der Oberfläche entfernt wurden, um damit den Blick auf das Innere von etwas/des Gerätes freizugeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ddc82fb-9638-4aa7-afd0-2794526bbb40",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Für die Ausbildung wurden Schnittmodelle beschafft.“"
                            },
                            {
                                "example_id": "7f11002f-6e4f-413a-bbec-b7c0d0aeef66",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Ein 1:1 Schnittmodell des Salon-Raddampfers Pilatus lässt ins Innere eines Schiffes mit Motoranlage blicken.“"
                            },
                            {
                                "example_id": "32cf524f-995d-454f-ba52-cb9954652bf1",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Stelle mithilfe der dir zur Verfügung gestellten Materialien ein Schnittmodell einer Leichtbauwand her.“"
                            },
                            {
                                "example_id": "a285dedd-344e-48b1-bbda-31e3b4943903",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„»Gut, hier ist also die Munition, die überwiegend hier in Brandenburg so gefunden wird, immer ein Originalstück und ein Schnittmodell, um die Kollegen daran auszubilden, das ist die Anatomie sozusagen.«“"
                            },
                            {
                                "example_id": "242e8916-a80d-412f-85e2-9a46ee0bb92e",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "[Panzer T-55 AM:] „Die mehrlagige Anordnung der Panzerungselemente innerhalb der verstärkten Frontplatte ist bei diesem Schnittmodell der ehemaligen NVA gut zu erkennen.“"
                            },
                            {
                                "example_id": "2323f1fb-7738-41f6-8716-e5fe731aa030",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Das Strahltriebwerk Pirna 014 A0/V-16 ist als Schnittmodell im Verkehrsmuseum Dresden in der dortigen Luftfahrtabteilung ausgestellt.“"
                            },
                            {
                                "example_id": "ce63a795-f25e-4768-9917-c0f696eb93a0",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "Ein weiteres Schnittmodell müsste sich noch in den Händen der Technischen Universität Dresden befinden und in den Räumen der Fakultät für Verkehrswissenschaften im Gerhart-Potthoff-Bau in der Hettnerstraße stehen."
                            },
                            {
                                "example_id": "72bbcac9-d62f-4c49-8c7c-8d4b122e79f2",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Eine der vier mehrstufigen Gleichdruck-Dampfturbinen des Trägers B ist heute als Schnittmodell in der Maschinenhalle der Fachhochschule Kiel ausgestellt.“"
                            },
                            {
                                "example_id": "13d8ead1-8d0a-4e2c-b858-c9ba5271ba8c",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Letztendlich wurde das Schnittmodell im Mai 1937 an das Museum geliefert, fast drei Jahre nach der ersten Anfrage.“"
                            },
                            {
                                "example_id": "7d5f1eca-83cd-46ed-9142-01906e1145c0",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Demonstrativ hatten die Daimler-Techniker Schnittmodelle der Vorder- und Hinterachsen bereitgestellt, als sie vergangene Woche im spanischen Bagur ihre neuen Modelle 280 S bis 350 SE vorstellten.“"
                            },
                            {
                                "example_id": "ee6578c8-17c5-4fd3-9fb9-9f9d8d0c3d2f",
                                "sense_id": "b31e4546-5802-3b1b-8857-b89d07c35b73",
                                "text": "„Vor gut zwei Jahren bekam Bernhardt zur Pensionierung das »Schnittmodell« einer Kalaschnikow geschenkt“ […]."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
