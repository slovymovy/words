                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "Gyros schmeckt am besten mit Zaziki."
                                            },
                                            {
                                                "example_id": "0506aed5-be3d-4d2e-b5d7-b93a2d32f1fd",
                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "„‚Guten Appetit. Ich habe meinen schon unterwegs gegessen. Hoffentlich macht es dir nichts aus?‘ fragte Jessica und sah Celine an, wie sie hastig den Gyros aß.“"
                                            },
                                            {
                                                "example_id": "f842960a-b9ba-4cb9-8410-d9465c881240",
                                                "sense_id": "67d84572-d778-3fe8-bf54-fd32b58fd8a8",
                                                "text": "„Pat schaute entgeistert: ‚Hast du den Gyros nicht vertragen?‘“"
                                            }
                                        ],
