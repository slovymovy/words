    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "887edf91-6898-3653-b47e-fd498949e2ef",
                    "sense_definition": "Simple past and past participle of <w>agree</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We <w>agreed</w> to meet at the park for lunch.",
                            "target_lang_translations": {
                                "ru": "Мы <w>договорились</w> встретиться в парке на обед.",
                                "zh": "我们<w>商定</w>在公园碰头吃午饭。"
                            }
                        },
                        {
                            "text": "It was <w>agreed</w> to move to a new headquarters.",
                            "target_lang_translations": {
                                "ru": "Было <w>решено</w> переехать в новую штаб-квартиру.",
                                "zh": "大家<w>一致同意</w>搬迁到新的总部。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "agreed to",
                        "agreed with",
                        "agreed upon"
                    ],
                    "target_lang_definitions": {
