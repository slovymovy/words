                    },
                    {
                        "translation_id": "efb3e683-f0f2-4bb2-aa59-b260d6b6cc30",
                        "source_entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
                        "source_sense_description": "Of or befitting of a royal court",
                        "target_lang_word": "courtois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
