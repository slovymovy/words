                                                "example_id": "732651bd-2993-493f-8b75-249f509b87bd",
                                                "sense_id": "3b36e926-8bd2-3baa-9dfe-ab7e24d61596",
                                                "text": "Drugą ręką łamiąc kawałki gugla, kiwał poważnie głową i ważył w głębokim rozumie swoim…"
                                            }
