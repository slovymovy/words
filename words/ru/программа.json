                },
                {
                    "sense_id": "047d1659-395f-3537-8ad2-726988417270",
                    "sense_definition": "План деятельности, работы или намеченных действий.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planning_abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас на сегодня запланирована очень насыщенная культурная <w>программа</w>.",
                            "target_lang_translations": {
                                "en": "We have a very rich cultural <w>program</w> planned for today.",
                                "zh": "我们今天安排了非常丰富的文化<w>日程</w>。"
                            }
                        },
                        {
                            "text": "Мы полностью выполнили <w>программу</w> нашей поездки.",
                            "target_lang_translations": {
                                "en": "We have fully completed the <w>itinerary</w> of our trip.",
                                "zh": "我们圆满完成了旅行的<w>计划</w>。"
                            }
                        }
