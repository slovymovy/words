                        "sense_id": "351b91c5-fe0b-362d-819d-a9b23662c352",
                        "entry_id": "75b37dbb-9941-303d-8965-43cc2ff663f3",
                        "glosses": [
                            "Bezeichnung für das Vorkommen von doppelgeschlechtlichen Individuen, also Individuen mit männlicher und weiblicher Geschlechtsausprägung bei einer Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57cb3192-045a-4898-a50d-e3efeded5911",
                                "sense_id": "351b91c5-fe0b-362d-819d-a9b23662c352",
                                "text": "„Hermaphroditismus oder Zwittrigkeit bzw. Zwittertum bezeichnet in der Biologie das Vorkommen von doppelgeschlechtlichen Individuen, also Individuen mit männlicher und weiblicher Geschlechtsausprägung und die sowohl männliche als auch weibliche Keimzellen ausbilden, bei einer Art.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
