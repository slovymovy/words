                        "examples": [
                            {
                                "example_id": "8e4d6fa5-273c-411d-a31a-e22d740a101e",
                                "sense_id": "a359f268-bd4e-3185-8c9c-3cf4d3080cf9",
                                "text": "Des morgens was ik met mijnen vriend, den Brusselaar, op St.-Willebrords, niet verre van de barricade, die dicht bij de stad, omtrent de danszaal De Gouden Appel, opgeworpen was. Den ganschen nacht had men in de stad een hevig geweervuur gehoord, en klonk het er nog met meer aanhoudendheid."
                            },
                            {
                                "example_id": "170ac2e4-6f57-4231-a557-c42a5b345653",
                                "sense_id": "a359f268-bd4e-3185-8c9c-3cf4d3080cf9",
                                "text": "Van de 1.200 bevraagde Brusselaars wilt driekwart een uitbreiding van het metronet in de hoofdstad."
                            }
                        ]
                    }
