                        "glosses": [
                            "Peintre qui pignoche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3185475e-f0d8-4dde-bf7c-c8e39d72b9a5",
                                "sense_id": "31bfaae9-99df-3570-bfb1-91c9142c84a9",
                                "text": "C’est un naturiste, un froid naturaliste, un amoureux des petits détails précis, un pignocheur, comme on dit en peinture ; il a beaucoup lu, pas mal vu, pensé avec excès et beaucoup trop retenu, comme le Jean de Mademoiselle Julie, et ses ouvrages sont mosaïqués sans goût et même sans adresse."
                            },
                            {
                                "example_id": "ff77804a-d0a9-40aa-9767-c5483c9c4ad0",
                                "sense_id": "31bfaae9-99df-3570-bfb1-91c9142c84a9",
                                "text": "En paysage, les maîtres français entraînent tout, sauf quelques retardataires à la suite de Calame et quelques pignocheurs des bords du Rhin."
                            }
                        ]
                    }
