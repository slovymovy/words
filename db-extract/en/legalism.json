                                        "entry_id": "20c6773c-7c7f-3f05-965c-1ddd2ee2d826",
                                        "glosses": [
                                            "ścisłe przestrzeganie przepisów prawnych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97625da9-b500-496c-a72e-7153585589d6",
                                                "sense_id": "a6f9bf6a-3bfe-32f5-910b-dec528a3ee15",
                                                "text": "Z szerszym pojęciem legalizmu spotykamy się na gruncie nauk takich, jak etyka czy teoria państwa i prawa. Zgodnie z jedną z obowiązujących w nich definicji przyjmuje się, że legalizm to „postawa moralna” stanowiąca uzasadnienie „zachowania zgodnego z prawem”"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
