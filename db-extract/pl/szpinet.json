                                        "sense_id": "db50c9a5-d85d-387c-83c8-3304c98bf563",
                                        "entry_id": "e27c2309-b748-391d-896a-1ed2fe699fcf",
                                        "glosses": [
                                            "A spinney."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e5678f5-d5cc-44c8-a151-597e195e0b76",
                                                "sense_id": "db50c9a5-d85d-387c-83c8-3304c98bf563",
                                                "text": "The invention was to have a Satyr lodged in a little spinet, by which her majesty and the prince were to come"
                                            }
                                        ]
                                    }
                                ]
