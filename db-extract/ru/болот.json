                        "examples": [
                            {
                                "example_id": "3030405a-3c18-4521-97a3-668d25a2fdc4",
                                "sense_id": "edf803c0-6b76-3f50-9bab-bcefc7be71cc",
                                "text": ".. советник президента по связям с общественностью Болот Джанузаков (Bolot Dzhanuzakov) .."
                            },
                            {
                                "example_id": "d6a1bf97-8218-456d-af19-d3829934633a",
                                "sense_id": "edf803c0-6b76-3f50-9bab-bcefc7be71cc",
                                "text": "Молодёжь перестаёт скандировать, когда на бордюр пешеходного перехода забирается пожилой человек в национальном колпаке. Это Болот Шамшиев, известный кинорежиссёр."
                            },
                            {
                                "example_id": "4b33e41f-4c61-4df5-bd43-11d8f255c4c5",
                                "sense_id": "edf803c0-6b76-3f50-9bab-bcefc7be71cc",
                                "text": ".. известный алтайский мастер горлового пения Болот Байрышев."
                            },
                            {
                                "example_id": "88b50afd-df4d-45b4-bc7d-ff87e5c94ab0",
                                "sense_id": "edf803c0-6b76-3f50-9bab-bcefc7be71cc",
                                "text": "Роль педагога исполнил Болот Бейшеналиев, роль сироты, поверившей в первого учителя, — Наталья Аринбасарова."
                            }
                        ]
                    }
