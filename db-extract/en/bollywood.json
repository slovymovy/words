                                        "entry_id": "33814ba8-1330-35cb-8e51-024e7a551095",
                                        "glosses": [
                                            "Industrie cinématographique en langue hindi, basée à Bombay, dans l’état du Maharashtra, en Inde."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c16af5f-6278-496c-bb8e-c6d91a248b9a",
                                                "sense_id": "c2d6db34-ac8b-3619-9ec9-a412fb151f84",
                                                "text": "Une immense affiche publicitaire annonçait la dernière nouveauté de Bollywood, un spectacle musical avec des danseuses séduisantes aux yeux en amande maquillés au kajal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8012262e-2ad4-42b5-aa58-d0a2b564dbb0",
