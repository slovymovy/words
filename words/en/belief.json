{
    "word_family": [
        "believe",
        "believer",
        "believable",
        "unbelievable",
        "disbelief"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d4d0286-9437-3d7d-bc55-3d7f710c0a2b",
                    "sense_definition": "The feeling of being certain that something exists or is true.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is my <w>belief</w> that we can solve this problem if we work together.",
                            "target_lang_translations": {
                                "ru": "По моему <w>убеждению</w>, мы сможем решить эту проблему, если будем работать вместе.",
                                "zh": "我的<w>信念</w>是，如果我们齐心协力，就能解决这个问题。"
                            }
                        },
                        {
                            "text": "His <w>belief</w> in his own abilities helped him succeed.",
                            "target_lang_translations": {
                                "ru": "Его <w>вера</w> в собственные силы помогла ему преуспеть.",
                                "zh": "他对自身能力的<w>信心</w>帮助他取得了成功。"
                            }
                        }
                    ],
                    "synonyms": [
                        "faith",
                        "conviction",
                        "opinion"
                    ],
                    "antonyms": [
                        "disbelief"
                    ],
                    "common_phrases": [
                        "belief in",
                        "beyond belief",
                        "firm belief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство уверенности в том, что что-то существует или является правдой",
                        "zh": "对某事存在或属实的确信感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убеждение",
                                "target_lang_sense_clarification": "твердое мнение"
                            },
                            {
                                "target_lang_word": "вера",
                                "target_lang_sense_clarification": "уверенность без доказательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信念",
                                "target_lang_sense_clarification": "对某种主张或事实的坚定确信"
                            },
                            {
                                "target_lang_word": "信心",
                                "target_lang_sense_clarification": "对自己能力或某事成功的确信"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfa58bd3-3e03-3acc-8846-a90dddcf36b2",
                    "sense_definition": "Trust or confidence in a god or a religion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "state_of_mind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>belief</w> in God gave her strength during the difficult times.",
                            "target_lang_translations": {
                                "ru": "Её <w>вера</w> в Бога давала ей силы в трудные времена.",
                                "zh": "她对上帝的<w>信仰</w>在困难时期给了她力量。"
                            }
                        },
                        {
                            "text": "Many people find comfort and community through their religious <w>belief</w>.",
                            "target_lang_translations": {
                                "ru": "Многие люди находят утешение и общение благодаря своей религиозной <w>вере</w>.",
                                "zh": "许多人通过他们的宗教<w>信仰</w>找到了慰藉和归属感。"
                            }
                        }
                    ],
                    "synonyms": [
                        "faith"
                    ],
                    "common_phrases": [
                        "belief in God",
                        "religious belief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доверие к богу или религии",
                        "zh": "对神或宗教的信任或信心。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вера",
                                "target_lang_sense_clarification": "религиозное чувство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信仰",
                                "target_lang_sense_clarification": "对宗教或神灵的虔诚与信任"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a8a163f-b358-35c7-886d-0270066c56e1",
                    "sense_definition": "A specific idea or fact that is accepted as true.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "specific_idea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a common <w>belief</w> that cold weather causes the flu.",
                            "target_lang_translations": {
                                "ru": "Существует распространенное <w>мнение</w>, что холодная погода вызывает грипп.",
                                "zh": "有一种普遍的<w>观念</w>认为寒冷的天气会导致流感。"
                            }
                        },
                        {
                            "text": "The ancient people had a <w>belief</w> in many different spirits of nature.",
                            "target_lang_translations": {
                                "ru": "У древних людей было <w>верование</w> во множество различных духов природы.",
                                "zh": "古代人有关于自然界中许多不同神灵的<w>观念</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "opinion",
                        "assumption"
                    ],
                    "common_phrases": [
                        "common belief",
                        "popular belief",
                        "widespread belief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная идея или факт, принимаемые за истину",
                        "zh": "被接受为真实的特定观点或事实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мнение",
                                "target_lang_sense_clarification": "взгляд на что-либо"
                            },
                            {
                                "target_lang_word": "поверье",
                                "target_lang_sense_clarification": "предание или примета"
                            },
                            {
                                "target_lang_word": "верование",
                                "target_lang_sense_clarification": "религиозное представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对某事物的观点或见解"
                            },
                            {
                                "target_lang_word": "观念",
                                "target_lang_sense_clarification": "普遍存在的思想或认识"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73cb8905-f6ce-3058-b5fa-da00b1d276f3",
                    "sense_definition": "Strong religious or moral principles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "specific_idea",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to eat meat because of her moral <w>beliefs</w>.",
                            "target_lang_translations": {
                                "ru": "Она отказывалась есть мясо из-за своих моральных <w>убеждений</w>.",
                                "zh": "由于道德<w>信念</w>，她拒绝吃肉。"
                            }
                        },
                        {
                            "text": "You should respect the personal <w>beliefs</w> of others even if you disagree.",
                            "target_lang_translations": {
                                "ru": "Следует уважать личные <w>убеждения</w> других, даже если вы с ними не согласны.",
                                "zh": "即使你不同意，也应该尊重他人的个人<w>信念</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conviction",
                        "tenet"
                    ],
                    "common_phrases": [
                        "moral beliefs",
                        "personal beliefs",
                        "political beliefs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердые религиозные или моральные принципы",
                        "zh": "坚定的宗教或道德准则。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убеждения",
                                "target_lang_sense_clarification": "жизненные принципы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信念",
                                "target_lang_sense_clarification": "指导行为的道德或思想准则"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}