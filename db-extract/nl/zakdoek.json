                                            {
                                                "example_id": "1e5c30d8-0a95-4d0c-a83a-1c637a6666d8",
                                                "sense_id": "25edb148-c11d-3f96-97db-d1e6dbf74c58",
                                                "text": "He sneezed into his handkerchief during the meeting."
                                            },
                                            {
                                                "example_id": "524355fb-2109-4a3c-b305-3b53b1f4f765",
                                                "sense_id": "25edb148-c11d-3f96-97db-d1e6dbf74c58",
                                                "text": "Mr. Banks’ panama hat was in one hand, while the other drew a handkerchief across his perspiring brow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792c61a6-9482-37ae-bd0f-687e79ef553e",
                                        "entry_id": "d953fbf7-22b1-3b7e-bd29-f9f5002bb1b3",
                                        "glosses": [
                                            "A piece of cloth shaped like a handkerchief to be worn about the neck; a neckerchief or neckcloth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
