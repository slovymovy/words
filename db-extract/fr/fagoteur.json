                ],
                "senses": [
                    {
                        "sense_id": "e3f53d1a-42b2-3053-9111-bc8b7e07840f",
                        "entry_id": "35176f2e-69d4-355e-9ca5-276d2992371b",
                        "glosses": [
                            "Celui qui confectionne des fagots."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "811d1e03-cd43-47c6-b9c5-c837444b434c",
                                "sense_id": "e3f53d1a-42b2-3053-9111-bc8b7e07840f",
                                "text": "Bah ! dit la vieille Tonsard, vous avez une jolie fille, elle a dix-sept ans ; si elle est sage, vous vous arrangerez facilement avec ce vieux fagoteur-là…"
                            },
                            {
                                "example_id": "a0c82755-823c-4fa2-8d24-f1fb9df374d1",
                                "sense_id": "e3f53d1a-42b2-3053-9111-bc8b7e07840f",
                                "text": "Les fagoteurs s’étaient approchés : je jetais des regards questionneurs sur leur groupe."
                            },
                            {
                                "example_id": "848bce03-ae00-4fd2-ab42-f95fd5fea3d6",
                                "sense_id": "e3f53d1a-42b2-3053-9111-bc8b7e07840f",
                                "text": "Le 16 mai 1681, à Vitray-en-Beauce (Eure-et-Loir), un garçonnet de 12 à 13 ans, Michel Le Febvre, allait porter à dîner au fagoteur de son père qui s’activait dans le bois de Beauvoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cec940b-d7a4-387a-9aa5-b9fe758015d1",
                        "entry_id": "35176f2e-69d4-355e-9ca5-276d2992371b",
                        "glosses": [
                            "Celui qui fait mal quelque chose."
                        ],
                        "tags": [
                            "dated",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "14bec141-bae4-4683-8463-20dc6f55e9df",
                                "sense_id": "2cec940b-d7a4-387a-9aa5-b9fe758015d1",
                                "text": "Cet ouvrier ne sait pas son métier : c’est un fagoteur."
                            }
                        ]
                    }
                ],
