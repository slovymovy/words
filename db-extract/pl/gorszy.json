                                                "example_id": "7cb8bc3e-257f-4fbc-975f-79915c8e28e1",
                                                "sense_id": "3067e07b-53ee-32f4-95cc-b730d373888e",
                                                "text": "Ne plus s’aimer, c’est pire que de se haïr, car, on a beau dire, la mort est pire que la souffrance."
                                            },
                                            {
                                                "example_id": "c4f46f76-f345-4784-9eab-d601ba831c9f",
                                                "sense_id": "3067e07b-53ee-32f4-95cc-b730d373888e",
                                                "text": "Pauvre Bernard – non pire qu’un autre !"
                                            }
                                        ]
                                    }
                                ]
                            },
