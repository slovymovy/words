                    {
                        "sense_id": "d6c2b6d2-e68f-3e1b-9df2-09bb9ad0b648",
                        "entry_id": "f1d543c1-312c-3206-a01d-62ce1634bfa7",
                        "glosses": [
                            "Déplacé avec un moyen de transport."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c916d800-105d-37de-b0e8-20fe5a7b10bc",
                        "entry_id": "f1d543c1-312c-3206-a01d-62ce1634bfa7",
                        "glosses": [
                            "Emporté par un sentiment violent."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "59a223ad-e43a-4602-b22a-a89e1a0e1e51",
                                "sense_id": "c916d800-105d-37de-b0e8-20fe5a7b10bc",
                                "text": "Le comte transporté de joie, la releva, l'embrassa sur le front, et s'écria: — O Amélie, serait-il bien possible?"
                            },
                            {
                                "example_id": "3448a212-e273-4972-a43b-6ede7311fd89",
                                "sense_id": "c916d800-105d-37de-b0e8-20fe5a7b10bc",
                                "text": "Aman, favori d'Assuérus, voyant que le juif Mardochée refusait de fléchir le genou devant lui, en fut si transporté de colère, que, pour mieux faire éclater sa vengeance, il obtint du roi un cruel édit qui condamnait tous les Juifs à mort, […]."
                            },
                            {
                                "example_id": "c5556fcd-aaf9-4de6-8390-057681ff8c61",
                                "sense_id": "c916d800-105d-37de-b0e8-20fe5a7b10bc",
                                "text": "J'ai jugé, ajoute-t-il, comme un pauvre serviteur passionné pour le bien de son maître, transporté de peur et d'appréhension pour son maitre."
                            }
                        ]
                    },
                    {
                        "sense_id": "ff615611-5618-3a4f-927c-c1eeaa925deb",
                        "entry_id": "f1d543c1-312c-3206-a01d-62ce1634bfa7",
                        "glosses": [
                            "Emporté par un sentiment de joie ou de plaisir."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "876009c9-8267-41a9-9e9c-8d301b8e80f4",
                                "sense_id": "ff615611-5618-3a4f-927c-c1eeaa925deb",
                                "text": "En recevant cette bonne nouvelle, il fut transporté."
                            },
                            {
                                "example_id": "c5f8b4ad-dc89-4aab-8dd5-ebf8e8b7b874",
                                "sense_id": "ff615611-5618-3a4f-927c-c1eeaa925deb",
                                "text": "Tous les spectateurs étaient transportés."
                            }
                        ]
                    }
                ],
