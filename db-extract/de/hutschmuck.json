                "senses": [
                    {
                        "sense_id": "bd050778-9c83-3965-8cd0-6e47b3f70d73",
                        "entry_id": "bd96397f-d734-3f81-8912-ceb60659bed4",
                        "glosses": [
                            "Gegenstand zur Verschönerung oder Verzierung eines Hutes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6e0fc3e-fbb3-4408-afcb-19d500ec73e3",
                                "sense_id": "bd050778-9c83-3965-8cd0-6e47b3f70d73",
                                "text": "„Daher fiel ihnen weniger in die Hände als zunächst befürchtet: ein Degen aus der Diamantrosengarnitur, Epauletten, Hutschmuck und Orden, von Hunderten ausgestellter Schmuckstücke.“"
                            },
                            {
                                "example_id": "3327f73a-f604-4e6b-be3c-fd5388667e99",
                                "sense_id": "bd050778-9c83-3965-8cd0-6e47b3f70d73",
                                "text": "„In den Werkstätten der Federputzerinnen entstanden, vielfach von modischen Strömungen beeinflusst, neben dem Hutschmuck und dem zarten Besatz für Damen- und Kinderkleidung, Federbüsche (für Uniformen), Federschals (Boas), Federgirlanden, Federquasten, Federblumen und Federpelzwerk (aus dem Balg einiger Wasservögel).“"
                            },
                            {
                                "example_id": "f60a719f-e0d0-4088-9d1b-01c5d8745f5b",
                                "sense_id": "bd050778-9c83-3965-8cd0-6e47b3f70d73",
                                "text": "„In Bayern machte vor allem Prinzregent Luitpold (1821-1912) den Hutschmuck populär.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
