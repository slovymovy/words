                "senses": [
                    {
                        "sense_id": "af9f5ae9-e36b-32d3-bda0-689beaf4fdc1",
                        "entry_id": "9ae6e6f8-11f8-3413-a844-884fd0e37e7b",
                        "glosses": [
                            "de moed opgeven"
                        ],
                        "tags": [
                            "ergative",
                            "unergative"
                        ],
                        "examples": [
                            {
                                "example_id": "e7902ff2-156c-4437-a981-9c0c4d4cd055",
                                "sense_id": "af9f5ae9-e36b-32d3-bda0-689beaf4fdc1",
                                "text": "Dit impliceert dat een collectieve verantwoordelijkheid versaagd is in de afgelopen decennia."
                            },
                            {
                                "example_id": "5738a0a4-b87f-4de6-b722-23a16c5b2e34",
                                "sense_id": "af9f5ae9-e36b-32d3-bda0-689beaf4fdc1",
                                "text": "Er wordt niet versaagd in de rustperiode."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82f5c0ab-3235-4cf9-a4aa-7fdb13a25640",
                        "source_entry_id": "9ae6e6f8-11f8-3413-a844-884fd0e37e7b",
                        "source_sense_id": "af9f5ae9-e36b-32d3-bda0-689beaf4fdc1",
                        "source_sense_description": "de moed opgeven",
                        "target_lang_word": "verzagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verzagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6716e71b-627f-3248-8fcf-284ea38cb699",
                                        "entry_id": "4894b2a4-d67c-3753-90eb-ca9ff7273c67",
                                        "glosses": [
                                            "entmutigt aufgeben, die Hoffnung / die Zuversicht verlieren"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "auxiliary verb",
                                            "intransitive",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a1a4b56-0208-4428-81ed-4d9a8fe5a49d",
                                                "sense_id": "6716e71b-627f-3248-8fcf-284ea38cb699",
                                                "text": "Trotz des Rückschlags sollten wir nicht verzagen. Die Hoffnung stirbt zuletzt."
                                            },
                                            {
                                                "example_id": "81d7a25d-feb8-4e14-9e16-735ff609e9a3",
                                                "sense_id": "6716e71b-627f-3248-8fcf-284ea38cb699",
                                                "text": "Aber als die Abgeordneten begriffen, daß die Duma aufgelöst werden könnte und sie Gefahr liefen, plötzlich ihre Pfründe zu verlieren, verzagten sie und schoben ihre Prinzipien beiseite."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "530cc60f-495a-428e-98d2-51821a48c920",
                        "source_entry_id": "9ae6e6f8-11f8-3413-a844-884fd0e37e7b",
                        "source_sense_id": "af9f5ae9-e36b-32d3-bda0-689beaf4fdc1",
                        "source_sense_description": "de moed opgeven",
