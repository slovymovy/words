                ],
                "senses": [
                    {
                        "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                        "entry_id": "fbe17d30-e97e-358b-a44a-a7157611f857",
                        "glosses": [
                            "Flammenbildung bei der Verbrennung unter Abgabe von Wärme und Licht in einer Feuerstelle in einem Wohnraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09142448-8ae6-4bc9-afc9-41f22bf48bca",
                                "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                                "text": "Ich sitze gerne vor dem Kaminfeuer."
                            },
                            {
                                "example_id": "e33154b2-845b-4629-a5ea-01f21f076a68",
                                "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                                "text": "„Rotwein wird gereicht, das Kaminfeuer brennt; beim Anekdotenerzählen klingt Gelächter auf.“"
                            },
                            {
                                "example_id": "6b7eec7d-bd10-46f5-b3b5-1faac9075f74",
                                "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                                "text": "„Auf dem Gipfel steht eine Hütte mit Kaminfeuer, in der die Bergsportler sich wärmen können.“"
                            },
                            {
                                "example_id": "bf2ec622-ec52-4cc9-91a9-c14c3d8da91d",
                                "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                                "text": "„Das ganze Haus schlief, aber mein Klopfen und drei oder vier Paoli, die ich sogleich unter die Burschen verteilte, verschafften mir ein Kaminfeuer und setzte alle in Bewegung, um mir ein Essen zu bereiten.“"
                            },
                            {
                                "example_id": "e048b630-1f39-4f57-a152-b2c056022650",
                                "sense_id": "4c370087-7f0b-3372-a0f6-07f5e5ca0177",
                                "text": "„Ich seh ihn am Kaminfeuer stehen, mit einer von Vaters Zigarren in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
