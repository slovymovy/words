                {
                    "sense_id": "9febe7a2-1b4d-3e64-83d3-1b53c5e77d18",
                    "sense_definition": "Door iemand zelf gedaan of aanwezig, niet via iemand anders.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester was <w>persoonlijk</w> aanwezig bij de opening.",
                            "target_lang_translations": {
                                "en": "The mayor was <w>personally</w> present at the opening.",
                                "ru": "Мэр <w>лично</w> присутствовал на открытии.",
                                "pl": "Burmistrz był <w>osobiście</w> obecny na otwarciu.",
                                "de": "Der Bürgermeister war <w>persönlich</w> bei der Eröffnung anwesend.",
                                "fr": "Le maire était <w>personnellement</w> présent à l'inauguration.",
                                "it": "Il sindaco era <w>personalmente</w> presente all'inaugurazione.",
                                "cs": "Starosta byl <w>osobně</w> přítomen na zahájení.",
                                "tr": "Belediye başkanı açılışta <w>şahsen</w> bulundu.",
                                "es": "El alcalde estuvo <w>personalmente</w> presente en la inauguración.",
                                "zh": "市长<w>亲自</w>出席了开幕式。"
                            }
                        },
                        {
                            "text": "Ik zal er <w>persoonlijk</w> voor zorgen dat alles goed komt.",
                            "target_lang_translations": {
                                "en": "I will <w>personally</w> ensure that everything turns out well.",
                                "ru": "Я <w>лично</w> прослежу за тем, чтобы все было хорошо.",
                                "pl": "Zadbam <w>osobiście</w> o to, żeby wszystko się ułożyło.",
                                "de": "Ich werde mich <w>persönlich</w> darum kümmern, dass alles gut wird.",
                                "fr": "Je veillerai <w>personnellement</w> à ce que tout se passe bien.",
                                "it": "Mi occuperò <w>personalmente</w> che tutto vada bene.",
                                "cs": "Já se <w>osobně</w> postarám o to, aby vše dobře dopadlo.",
                                "tr": "Her şeyin yoluna girmesini <w>bizzat</w> sağlayacağım.",
                                "es": "Me encargaré <w>personalmente</w> de que todo salga bien.",
                                "zh": "我会<w>亲自</w>确保一切顺利。"
                            }
                        }
