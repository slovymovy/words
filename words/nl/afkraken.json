{
    "word_family": [
        "kraken",
        "kraak",
        "gekraak",
        "kraker"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "05388e6d-d23f-319a-a430-b5850d079361",
                    "sense_definition": "iemand of iets op een vernietigende en vaak onterechte manier bekritiseren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kritiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De critici besloten zijn nieuwe boek volledig <w>af te kraken</w> in de krant.",
                            "target_lang_translations": {
                                "en": "The critics decided to completely <w>slate</w> his new book in the newspaper."
                            }
                        },
                        {
                            "text": "Het is niet aardig om iemands werk zo hard <w>af te kraken</w> zonder goede reden.",
                            "target_lang_translations": {
                                "en": "It is not nice to <w>trash</w> someone's work so harshly without a good reason."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekritiseren",
                        "afbranden",
                        "neersabelen"
                    ],
                    "antonyms": [
                        "ophemelen",
                        "prijzen",
                        "waarderen"
                    ],
                    "common_phrases": [
                        "iemand volledig afkraken",
                        "een film afkraken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele gesprekken over meningen"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To criticize someone or something in a destructive and often unfair manner."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "slate",
                                "target_lang_sense_clarification": "to criticize harshly, especially in a review"
                            },
                            {
                                "target_lang_word": "trash",
                                "target_lang_sense_clarification": "to criticize severely or dismiss as worthless"
                            },
                            {
                                "target_lang_word": "bash",
                                "target_lang_sense_clarification": "to criticize someone or something strongly"
                            },
                            {
                                "target_lang_word": "tear apart",
                                "target_lang_sense_clarification": "to criticize something very severely"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cd0615f-d536-3a71-bb7d-fd4188b2e31b",
                    "sense_definition": "met een krakend geluid afbreken of loskomen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "breken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het gewicht van de sneeuw <w>kraakte</w> de dikke tak eindelijk <w>af</w>.",
                            "target_lang_translations": {
                                "en": "Due to the weight of the snow, the thick branch finally <w>snapped off</w>."
                            }
                        },
                        {
                            "text": "Ik hoorde het ijs onder mijn voeten terwijl er een groot stuk <w>afkraakte</w>.",
                            "target_lang_translations": {
                                "en": "I heard the ice under my feet as a large piece <w>cracked off</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afbreken"
                    ],
                    "common_phrases": [
                        "een tak kraakt af"
                    ],
                    "target_lang_definitions": {
                        "en": "To break off or come loose with a cracking sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snap off",
                                "target_lang_sense_clarification": "to break away with a sudden sound"
                            },
                            {
                                "target_lang_word": "crack off",
                                "target_lang_sense_clarification": "to break off with a cracking noise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}