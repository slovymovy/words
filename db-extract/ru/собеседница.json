                                    {
                                        "sense_id": "75987ab6-c32f-3c88-a72c-6df8c7bb5e8b",
                                        "entry_id": "a9dfe8f9-33da-387c-8d6d-a5ebd153edee",
                                        "glosses": [
                                            "A female interlocutor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6680247b-6549-4093-9a86-7bb554952c41",
                                                "sense_id": "75987ab6-c32f-3c88-a72c-6df8c7bb5e8b",
                                                "text": "Milly hereupon replied appreciatively that such a description of herself made her feel as if pink paper were her dress and lavender its trimming; but Aunt Maud was not to be deterred by a weak joke from keeping it up. Her interlocutress could feel besides that she kept it up in perfect sincerity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d68136b-9aee-468f-b0ec-b333c2a82e56",
                        "source_entry_id": "d6ac950c-719e-3bec-b440-f603dedc4844",
                        "source_sense_id": "758dee2c-274d-37ac-a727-95b0187d0e79",
                        "target_lang_word": "interlocutrice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interlocutrice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa00a691-12cf-385e-95b3-f33644cb94be",
                                        "entry_id": "2d7515af-e0f9-32ec-ab62-f911b3089b66",
                                        "glosses": [
                                            "A female interlocutor"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa7a4b9-8326-457e-a749-319a961a7616",
                                                "sense_id": "aa00a691-12cf-385e-95b3-f33644cb94be",
                                                "text": "I have forbidden Adèle to talk to me about her presents, and she is bursting with repletion; have the goodness to serve her as auditress and interlocutrice:"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7af5b35-a75a-4852-8eb2-e125f7aa952f",
                        "source_entry_id": "d6ac950c-719e-3bec-b440-f603dedc4844",
                        "source_sense_id": "758dee2c-274d-37ac-a727-95b0187d0e79",
