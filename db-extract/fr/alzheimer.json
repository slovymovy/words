                        ],
                        "examples": [
                            {
                                "example_id": "ca8f43b4-c584-42cd-92b6-f3eb4a130eae",
                                "sense_id": "93d7a096-98b8-39f8-90f8-60d8ec7829cb",
                                "text": "Grand-père est mort ce matin. Il louait une chambre dans la résidence médicalisée où ma grand-mère, atteinte d’alzheimer, habite depuis des années."
                            }
                        ]
