                        "source_entry_id": "8d1e9246-aaa5-368d-87d5-ddb8ae585edf",
                        "source_sense_id": "8d5e593a-e002-397f-a2f2-73aa8cad6e53",
                        "source_sense_description": "unterhalb der Schriftlinie von Texten und kleiner als normale Schriftzeichen dargestellt",
                        "target_lang_word": "subscript",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56fdcc2e-fddb-3aae-8f07-05478e02d65d",
                                        "entry_id": "c7f7975e-8476-3e38-b2fc-d3b3b855a0b6",
                                        "glosses": [
                                            "A type of lettering form written lower than the things around it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7795581f-2e7c-4847-b62f-42ad6e25d380",
                                                "sense_id": "56fdcc2e-fddb-3aae-8f07-05478e02d65d",
                                                "text": "In chemical formulas the number of atoms in a molecule is written as a subscript, so we write H₂O for water which has two atoms of hydrogen for each one of oxygen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e876131-a3d2-3f33-ace5-1d7a97c874dc",
                                        "entry_id": "c7f7975e-8476-3e38-b2fc-d3b3b855a0b6",
                                        "glosses": [
                                            "An index into an array or hash."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bcd48a8-9b45-4f56-968c-d90e9722cd2c",
                                                "sense_id": "2e876131-a3d2-3f33-ace5-1d7a97c874dc",
                                                "text": "If the container is subscriptable and you remember the position where a particular piece of data was stored, you can use the subscript to efficiently retrieve the data."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "subscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b496efa9-fb47-3084-aa94-c94daffbfb91",
                                        "entry_id": "48eb8312-916b-327c-a73c-2758c6f1f709",
                                        "glosses": [
                                            "To provide with a subscript."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "231e06a7-d628-4868-8ed6-9c2709c47043",
                                                "sense_id": "b496efa9-fb47-3084-aa94-c94daffbfb91",
                                                "text": "As in the chapters on the synchronous model, we use the convention of subscripting a variable by the index of the process at which the variable resides."
                                            },
                                            {
                                                "example_id": "1cfa9897-441b-44b5-8e36-5be033f2885d",
                                                "sense_id": "b496efa9-fb47-3084-aa94-c94daffbfb91",
                                                "text": "The elements of these matrices are subscripted with a row–column index, that is, with two integers that give the row and column position in the array."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67a7c6b-04be-35f2-aa0d-dd3e3d0ebf36",
                                        "entry_id": "48eb8312-916b-327c-a73c-2758c6f1f709",
                                        "glosses": [
                                            "To convert to a subscript form."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69842432-fbc9-40a6-99f1-b8f6b87328e2",
                                                "sense_id": "d67a7c6b-04be-35f2-aa0d-dd3e3d0ebf36",
                                                "text": "If your presentation covers chemistry or some other scientific field, you'll need to subscript and superscript characters (think H2O)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f4990a9-5da2-3d10-acf4-d2d49c7d09cd",
                                        "entry_id": "48eb8312-916b-327c-a73c-2758c6f1f709",
                                        "glosses": [
                                            "To access (an array element) by its index."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ececd74e-aeb3-4494-95f2-e6404032ac06",
                                                "sense_id": "5f4990a9-5da2-3d10-acf4-d2d49c7d09cd",
                                                "text": "Avoid subscripting arrays or hashes within loops."
                                            }
                                        ]
                                    }
                                ]
                            },
