{
    "word_family": [
        "leaching",
        "leachate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9f52c43a-219b-33f1-8c49-a5dd8f348c7c",
                    "sense_definition": "To remove soluble substances from a material by passing a liquid through it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rainfall can <w>leach</w> out minerals important for plant growth from the soil.",
                            "target_lang_translations": {
                                "ru": "Сильные дожди могут <w>вымывать</w> из почвы минералы, важные для роста растений."
                            }
                        },
                        {
                            "text": "The process helps to <w>leach</w> harmful chemicals from the contaminated industrial waste.",
                            "target_lang_translations": {
                                "ru": "Этот процесс помогает <w>выщелачивать</w> вредные химические вещества из загрязненных промышленных отходов."
                            }
                        }
                    ],
                    "synonyms": [
                        "filter",
                        "percolate"
                    ],
                    "common_phrases": [
                        "leach out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Извлекать или растворять вещества из материала путем пропускания через него жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымывать",
                                "target_lang_sense_clarification": "о растворимых веществах, минералах водой или раствором"
                            },
                            {
                                "target_lang_word": "выщелачивать",
                                "target_lang_sense_clarification": "в химических и промышленных процессах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d8b103d-d7e9-39ef-b9f8-11616939f28b",
                    "sense_definition": "To lose soluble components through the process of percolation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minerals <w>leached</w> from the ore during the chemical treatment process.",
                            "target_lang_translations": {
                                "ru": "Минералы <w>выщелачивались</w> из руды в процессе химической обработки."
                            }
                        },
                        {
                            "text": "Nutrients often <w>leach</w> from sandy soil during periods of heavy rain.",
                            "target_lang_translations": {
                                "ru": "Питательные вещества часто <w>вымываются</w> из песчаной почвы во время сильных дождей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Терять растворимые компоненты в результате просачивания жидкости; вымываться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымываться",
                                "target_lang_sense_clarification": "о веществе, уходящем с жидкостью"
                            },
                            {
                                "target_lang_word": "выщелачиваться",
                                "target_lang_sense_clarification": "в химии или геологии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "203aa84e-bc63-32d0-9f04-37414203b93b",
                    "sense_definition": "To seep or spread gradually into something else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seeping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city continues to <w>leach</w> into the surrounding rural landscape.",
                            "target_lang_translations": {
                                "ru": "Город продолжает постепенно <w>расползаться</w> по окружающему сельскому ландшафту."
                            }
                        },
                        {
                            "text": "A sense of sadness seemed to <w>leach</w> into every corner of the room.",
                            "target_lang_translations": {
                                "ru": "Казалось, ощущение печали <w>просачивалось</w> в каждый уголок комнаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "seep",
                        "permeate"
                    ],
                    "common_phrases": [
                        "leach into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно просачиваться, распространяться или проникать куда-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просачиваться",
                                "target_lang_sense_clarification": "постепенно проникать, в том числе метафорически"
                            },
                            {
                                "target_lang_word": "проникать",
                                "target_lang_sense_clarification": "медленно распространяться"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15ce2107-75ce-3130-ad6d-57abb02b94b3",
                    "sense_definition": "A container used for extracting soluble substances from materials like ashes or bark.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden <w>leach</w> stood in the corner of the workshop.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный <w>чан для выщелачивания</w> стоял в углу мастерской."
                            }
                        },
                        {
                            "text": "Workers filled the <w>leach</w> with wood ashes to begin the process.",
                            "target_lang_translations": {
                                "ru": "Рабочие наполнили <w>фильтровальный чан</w> древесной золой, чтобы начать процесс."
                            }
                        }
                    ],
                    "synonyms": [
                        "vat",
                        "tub"
                    ],
                    "target_lang_definitions": {
                        "ru": "Емкость, чан для выщелачивания или фильтрации растворимых веществ (например, из золы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чан для выщелачивания",
                                "target_lang_sense_clarification": "сосуд для экстракции"
                            },
                            {
                                "target_lang_word": "зольник",
                                "target_lang_sense_clarification": "для получения щелока из золы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d05f65ee-bd49-3311-8f62-ab6421c3ee62",
                    "sense_definition": "A collection of wood ashes prepared for the extraction of alkali.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "extraction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They prepared a fresh <w>leach</w> to obtain the necessary cleaning solution.",
                            "target_lang_translations": {
                                "ru": "Они подготовили свежую <w>золу</w>, чтобы получить необходимый чистящий раствор."
                            }
                        },
                        {
                            "text": "The water passed through the <w>leach</w> to collect the alkali.",
                            "target_lang_translations": {
                                "ru": "Вода проходила сквозь <w>слой золы</w>, чтобы вобрать в себя щелочь."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесная зола, подготовленная для извлечения щелочи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зола для щелока",
                                "target_lang_sense_clarification": "материал для выщелачивания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "441377c2-2418-322c-8de0-39301b67f3d2",
                    "sense_definition": "An alternative spelling of <w>leech</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medical practitioner used a <w>leach</w> to treat the patient.",
                            "target_lang_translations": {
                                "ru": "Лекарь использовал <w>пиявку</w> для лечения пациента."
                            }
