{
    "word_family": [
        "hurlement",
        "hurleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "47a109e8-059b-305f-98da-fda62bfeb84f",
                    "sense_definition": "Pousser des cris très puissants sous l'effet de la douleur, de la colère ou de la peur.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cris_humains",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé s'est mis à <w>hurler</w> de douleur quand les secours sont arrivés."
                        },
                        {
                            "text": "Arrête de <w>hurler</w> ainsi sur tes camarades pendant la récréation."
                        }
                    ],
                    "synonyms": [
                        "crier"
                    ],
                    "common_phrases": [
                        "hurler de douleur",
                        "hurler de rage"
                    ]
                },
                {
                    "sense_id": "b03980d9-47a3-3d13-99b6-474edea1c08d",
                    "sense_definition": "Pousser un cri plaintif et prolongé, en parlant des loups ou des chiens.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cris_animaux",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant la nuit sombre, le chien solitaire a commencé à <w>hurler</w> à la lune."
                        },
                        {
                            "text": "Au fond de la forêt enneigée, nous avons entendu une meute de loups qui <w>hurlait</w>."
                        }
                    ],
                    "common_phrases": [
                        "hurler à la lune",
                        "hurler à la mort"
                    ]
                },
                {
                    "sense_id": "66aeb191-f759-3507-aa1c-4cf065760353",
                    "sense_definition": "Produire un bruit violent, continu et strident, en parlant du vent ou d'un avertisseur sonore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bruits_elements",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La tempête approchait et le vent <w>hurlait</w> avec force contre les volets de la maison."
                        },
                        {
                            "text": "Quand l'incendie s'est déclaré, nous avons entendu la sirène qui <w>hurlait</w> dans toute l'usine."
                        }
                    ],
                    "common_phrases": [
                        "sirène qui hurle"
                    ]
                },
                {
                    "sense_id": "69a37c12-e127-3111-8c77-344752d2a4f0",
                    "sense_definition": "Rire de manière incontrôlable face à une situation ou une remarque comique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En découvrant cette vidéo complètement absurde, je me suis mis à <w>hurler</w> de rire."
                        },
                        {
                            "text": "Sa blague était tellement inattendue que tout le monde <w>hurlait</w> dans la pièce."
                        }
                    ],
                    "common_phrases": [
                        "hurler de rire"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "familier et fréquent sur les réseaux sociaux"
                        }
                    ]
                }
            ]
        }
    ]
}