                        "entry_id": "84862273-a7cf-3f7e-a6d3-3b7e81ee47a7",
                        "glosses": [
                            "As much as lasts or is produced in the spring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3903002d-12c8-4511-9a21-d0f198187496",
                                "sense_id": "efaae383-3b05-3425-9f2d-6e69d73285f3",
                                "text": "A springful of larks in a rolling Cloud and the roadside bushes brimming with whistling Blackbirds and the sun of October."
                            },
                            {
                                "example_id": "8bb53ef4-0a16-47da-b408-4dc648ebfd8b",
                                "sense_id": "efaae383-3b05-3425-9f2d-6e69d73285f3",
                                "text": "The palanquin was at once love's veena and a creeper shining with a springful of flowers;"
                            },
                            {
                                "example_id": "c23d7b11-d4c6-4d31-add1-5734af0be9f0",
                                "sense_id": "efaae383-3b05-3425-9f2d-6e69d73285f3",
                                "text": "Amidst a world whistling Not with summery wind But radiating a springful Of deathly atoms."
                            }
                        ]
                    },
                    {
                        "sense_id": "02103ed8-c9a6-3cfd-bcb2-c96cdf210dda",
                        "entry_id": "84862273-a7cf-3f7e-a6d3-3b7e81ee47a7",
                        "glosses": [
                            "As much as flows in a spring (of water)."
