                    {
                        "translation_id": "4f959925-206c-401c-beaa-721ba51a6619",
                        "source_entry_id": "112630cb-497a-3546-a0e3-9ec2ce456df7",
                        "source_sense_id": "bacbb734-81fa-33cd-bc72-c8c563b7dab5",
                        "target_lang_word": "Narwa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb4bd50-878a-35bb-910d-aba85f14d23a",
                                        "entry_id": "8c7d83aa-3680-3777-b226-d5adf47740ab",
                                        "glosses": [
                                            "Stadt in Estland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df016421-d01a-4550-9f04-6628c01b3e3c",
                                                "sense_id": "9bb4bd50-878a-35bb-910d-aba85f14d23a",
                                                "text": "„Nach der Ankunft im estnischen Hafen Narwa fuhren sie in einem Zug mit holzbefeuerter Lokomotive über die Grenze zur ersten größeren Station auf russischem Gebiet, Jamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Narwa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf2a3327-4761-3ba6-82c7-91e2a6a3cf3a",
                                        "entry_id": "a5f71bb6-2937-3a88-82f5-ba454b867087",
                                        "glosses": [
                                            "Grenzfluss zwischen Estland und Russland; Abfluss des Peipussees zur Ostsee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5789d22-4cc5-4504-bc7d-9fa3cb726bf5",
                                                "sense_id": "cf2a3327-4761-3ba6-82c7-91e2a6a3cf3a",
                                                "text": "„Der Orden ging nunmehr daran, das befriedete Land in seinen Grenzen zu sichern, vor allem die einzige Landgrenze, die gegen Rußland. Sie wurde gebildet durch den Peipussee und seinen nördlichen Abfluß in den Finnischen Meerbusen, die Narwa (Norwara). Dabei war es besonders wichtig, die Mündung der Narwa in die See zu sichern.“"
                                            },
                                            {
                                                "example_id": "87d0db31-e7db-4785-ac02-a9b86da1d39d",
                                                "sense_id": "cf2a3327-4761-3ba6-82c7-91e2a6a3cf3a",
                                                "text": "„Die Esten griffen schon am nächsten Tag mit dem SS-Rgt. 46 (SS-Standartenführer Tuling) von Riigiküla aus ungestüm nach Osten an und warfen in einem Stoß die bei Sivertsi über die Narwa gegangenen Russen auf das andere Ufer zurück.“"
                                            },
                                            {
                                                "example_id": "0584ab65-8ef9-44c6-ac7a-48e13ae2654e",
                                                "sense_id": "cf2a3327-4761-3ba6-82c7-91e2a6a3cf3a",
                                                "text": "„Nach dem Einbruch bei einer benachbarten deutschen Luftwaffenfelddivision musste sich die niederländische Brigade zum Westufer der Narwa zurückkämpfen, um einer Einkesselung zu entgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
