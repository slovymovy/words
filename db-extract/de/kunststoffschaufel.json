                ],
                "senses": [
                    {
                        "sense_id": "cdc0b7de-d476-3bf0-9e46-104fc9e6e75c",
                        "entry_id": "8c9c003b-874e-3e34-9553-c9d8dee14722",
                        "glosses": [
                            "Handwerkzeug aus Polymer mit einem flachen Blatt in gebogener Form und einem Stiel (Hebelarm), um Erde, Kies, Sand, oder Material ähnlicher Konsistenz schneller zu bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e24b821d-91c2-48e8-9fb7-b9fda427ea95",
                                "sense_id": "cdc0b7de-d476-3bf0-9e46-104fc9e6e75c",
                                "text": "„Solide, schlagfeste Kunststoffschaufel aus Polypropylen, mit eingeschweißtem Stahlgriff verstärkt. Diese Schaufel wird häufig von Fuhrunternehmern verwendet, die gefährliche Güter befördern und gemäß den ADR-Vorschriften eine Schaufel zum Aufnehmen verschütteter Ladungen mitführen müssen.“"
                            },
                            {
                                "example_id": "b680ba58-8def-423f-b2be-64052ebfceab",
                                "sense_id": "cdc0b7de-d476-3bf0-9e46-104fc9e6e75c",
                                "text": "„In dieser Kategorie sind Kunststoffschaufeln aus lebensmittelechten und spülmaschinenfesten robustem Material (Hartkunststoff) in verschiedenen Grössen vorzufinden. Genannte Kunststoffschaufeln sind als Abwiegeschaufeln bestens für Tee, Gewürzen, diversen Kräutern, Getreide, Mehl sowie für Salz und Zucker geeignet.“"
                            },
                            {
                                "example_id": "7947501f-6c73-4c08-93ed-194e99ba6ea0",
                                "sense_id": "cdc0b7de-d476-3bf0-9e46-104fc9e6e75c",
                                "text": "„Einteilige Kunststoffschaufeln sind für Bereiche konzipiert, in denen absolute Sauberkeit und leichtes Reinigen oberstes Gebot sind.“"
                            },
                            {
                                "example_id": "999ed4b9-2b22-4755-ba47-166f2c0b0f95",
                                "sense_id": "cdc0b7de-d476-3bf0-9e46-104fc9e6e75c",
                                "text": "„Solide, schlagfeste Kunststoffschaufel aus Polypropylen, mit eingeschweißtem Stahlgriff verstärkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
