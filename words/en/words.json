                    "sense_definition": "Plural of <w>word</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wrote a few <w>words</w> in her notebook to remember the idea.",
