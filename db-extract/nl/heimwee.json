        "nl-extract.jsonl": [
            {
                "entry_id": "81ea555f-dcb6-3ab7-8886-ec09d24b9310",
                "word": "heimwee",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "81ee7c24-f09a-332b-bcb5-468f3b2b2fb8",
                        "entry_id": "81ea555f-dcb6-3ab7-8886-ec09d24b9310",
                        "glosses": [
                            "sterk verlangen naar een plek die als thuis ervaren wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7256909-b8de-45d5-b07d-2a945aa7c1e3",
                                "sense_id": "81ee7c24-f09a-332b-bcb5-468f3b2b2fb8",
                                "text": "Wegens sterke heimwee kon hun dochtertje nooit bij vriendinnetjes logeren."
                            },
                            {
                                "example_id": "e07c80cf-3a44-4c80-8b24-f50fc6e6f1cb",
                                "sense_id": "81ee7c24-f09a-332b-bcb5-468f3b2b2fb8",
                                "text": "Van heimwee had ik bepaald geen last als we vroeger met ons gezin op vakantie gingen. Dolenthousiast was ik: een halfjaar van tevoren keek ik er al naar uit. Dat ik nu al reizend kan werken, vind ik geweldig. Voor het eerst lopen door de straten van New York of waar dan ook ter wereld: er maakt zich een enorme opwinding van mij meester als ik op een nieuwe plek kom. Dat ik geen vaste werkplek heb, is voor mij geen punt. Ik weet genoeg werkplekken te vinden die te huur zijn. Voor geroezemoes of getinkel van bestek kan ik me goed afsluiten."
                            },
                            {
                                "example_id": "75b7854c-e28a-4eea-be01-42bb9d934d01",
                                "sense_id": "81ee7c24-f09a-332b-bcb5-468f3b2b2fb8",
                                "text": "Maar je kon in Venetië niet van anachronismen spreken. De moderne tijd was een anachronisme in deze stad die op geen enkele manier was toegerust voor productiviteit, haast of nut. Hier was de tijd blijven zweven in melancholie en heimwee naar de droom van een schaduw van een rinkelend verleden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c362258-9e45-43b7-8545-1f93c616eeb8",
                        "source_entry_id": "81ea555f-dcb6-3ab7-8886-ec09d24b9310",
                        "source_sense_id": "81ee7c24-f09a-332b-bcb5-468f3b2b2fb8",
                        "source_sense_description": "sterk verlangen naar een plek die als thuis ervaren wordt",
                        "target_lang_word": "Heimweh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Heimweh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                        "entry_id": "4ac7eba5-d1f9-35f7-b085-c026157de8eb",
                                        "glosses": [
                                            "Sehnsucht nach der Heimat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a692ee63-9701-4fca-bb58-b327d7ddc9ce",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "Immer wenn der kleine Francesco seine Großeltern in Uelzen besuchte, litt er unter Heimweh."
                                            },
                                            {
                                                "example_id": "86493edb-3ae8-4715-a1ca-1a04edce1fb3",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "Wann immer Susaska Sachsen verlässt, befällt sie augenblicklich starkes Heimweh."
                                            },
                                            {
                                                "example_id": "11179590-f75c-4310-b4c4-2132d6c8ea5e",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "„Auch Anna Zakrzewska bestätigt das Heimweh ihrer Familie.“"
                                            },
                                            {
                                                "example_id": "953dec8f-724e-4ade-a3bb-4f961dc73d04",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "„Schon während ich das alles aufschrieb, spürte ich, dass ich etwas Heimweh bekam.“"
                                            },
                                            {
                                                "example_id": "9cfb13f8-c0b1-4d78-a26e-f3a8eb3ae183",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "„Da bekam ich eine Gänsehaut vor Heimweh.“"
                                            },
                                            {
                                                "example_id": "0d2e7f9f-fdfd-4548-af20-12d2bcb03d40",
                                                "sense_id": "7f70b360-a2d7-3290-935f-12038a9ca421",
                                                "text": "„Die Schweizer werden von einer Krankheit befallen, die man Heimweh nennt; sie wollen zurück, die Griechen nannten das ›Nostalgie‹.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfa4f4bd-bc50-452f-8414-2e4858206eac",
                        "source_entry_id": "81ea555f-dcb6-3ab7-8886-ec09d24b9310",
