                "senses": [
                    {
                        "sense_id": "b8c24b54-f410-39a3-8323-12a829f23dd1",
                        "entry_id": "9e6561fc-320f-35e5-b1f1-59a94cfd2e5d",
                        "glosses": [
                            "To convert to Jacobinism; to radicalize in opposition to the government."
                        ],
                        "tags": [
                            "derogatory",
                            "sometimes",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d0febcf4-fe72-4edd-94df-05f98f107030",
                                "sense_id": "b8c24b54-f410-39a3-8323-12a829f23dd1",
                                "text": "Happily, France was not then Jacobinized."
                            },
                            {
                                "example_id": "312526b6-268e-44d5-9d94-d7f1814751d3",
                                "sense_id": "b8c24b54-f410-39a3-8323-12a829f23dd1",
                                "text": "We are threatened by a most unprincipled system of agitation—the Tories actually doing their best to Jacobinize the poor, in the hope of turning an outbreak against the whig government to their own advantage."
                            },
                            {
                                "example_id": "75f2fe2d-ef23-4a28-b489-fd527e38e865",
                                "sense_id": "b8c24b54-f410-39a3-8323-12a829f23dd1",
                                "text": "If labourers were barred from pleasures they would Jacobinize the whole country, he declared."
                            }
                        ]
                    }
                ],
