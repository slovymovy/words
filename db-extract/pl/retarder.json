                                        "examples": [
                                            {
                                                "example_id": "bec5628b-3fbd-4547-b286-8176f0c27b2c",
                                                "sense_id": "53fc0b8c-2dd8-3219-9b11-9e4c2acb6ad6",
                                                "text": "The substance acted as a retarder to the chemical reaction because it radically changed the pH."
                                            },
                                            {
                                                "example_id": "d3db4ab3-5cb5-4093-810a-0b6561dda357",
                                                "sense_id": "53fc0b8c-2dd8-3219-9b11-9e4c2acb6ad6",
                                                "text": "Why is retarder used in dope when the dope is being sprayed in humid conditions? The retarder slows the drying of the dope and keeps it from blushing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c68fb8fd-0dab-3931-b3a5-53ca27e122d9",
                                        "entry_id": "ef0074f2-f7b8-3518-9bc5-bc839b731d45",
                                        "glosses": [
                                            "A device for slowing down large trucks, lorries, buses, shunted railway wagons."
