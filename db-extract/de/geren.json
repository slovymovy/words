                "senses": [
                    {
                        "sense_id": "e3df14ed-5861-3e19-b8ab-450a3b9a719f",
                        "entry_id": "1015d573-970b-30d2-9daa-97a0e0b55b0f",
                        "glosses": [
                            "begehren"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "6626ca05-38f7-4190-a328-5a78eacd4c98",
                                "sense_id": "e3df14ed-5861-3e19-b8ab-450a3b9a719f",
                                "text": "Nein, nein, nein, nein, das gehr ich nicht."
                            },
                            {
                                "example_id": "7b75041f-d220-4b59-977b-6da15cc73e5b",
                                "sense_id": "e3df14ed-5861-3e19-b8ab-450a3b9a719f",
                                "text": "Ihr aber seid ein weideplatz / dem hoffen und ein ziel dem gehren."
                            },
                            {
                                "example_id": "e1ccd391-324a-4904-9528-415d22fb6cb3",
                                "sense_id": "e3df14ed-5861-3e19-b8ab-450a3b9a719f",
                                "text": "Ich kann mir anderst nit gedenken, / denn er ger uns gar aus zu reuten."
                            },
                            {
                                "example_id": "3dd21204-58ef-48e7-837f-4276489d3cf4",
                                "sense_id": "e3df14ed-5861-3e19-b8ab-450a3b9a719f",
                                "text": "Und gert nit das ain ploszer man / geharnischt leüten gleich soll than."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b67ee79a-8e23-3bdd-82b2-b4dabc3b1409",
                        "entry_id": "1015d573-970b-30d2-9daa-97a0e0b55b0f",
