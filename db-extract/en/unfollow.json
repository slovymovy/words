                        "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                        "entry_id": "a6818005-b2be-3653-a2e7-1d27aa073822",
                        "glosses": [
                            "To cease to subscribe to (a feed of another user's activity)."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6dd305c9-2c9f-4bc4-8c29-aa473a3095c4",
                                "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                                "text": "With Twitter, it’s as easy to unfollow as it is to follow."
                            },
                            {
                                "example_id": "fcb8dd0c-3ab4-4120-9101-4065aa43ac10",
                                "sense_id": "9bed2eb5-45ed-3461-8e38-31e01f253d2e",
                                "text": "The calls came from Iranian intelligence as soon as the protests began. Agents threatened the family and friends of a DW editor, telling them to cut off contact with him and to unfollow him on Instagram. The journalist was said to be a \"muharebbe\" (Engl. warrior against God) – which is punishable by death in Iran."
                            }
                        ]
                    }
