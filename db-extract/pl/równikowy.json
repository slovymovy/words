                    },
                    {
                        "translation_id": "1033ffad-8377-4329-97d6-14682436e65d",
                        "source_entry_id": "81008b77-d3f6-3a08-ae8a-7eb567ecea16",
                        "source_sense_id": "1ca0801f-347b-3a46-89d9-f38bb756443f",
                        "target_lang_word": "äquatorial",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "äquatorial",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                        "entry_id": "1635f0a7-84bc-34a7-aa08-c23b35c30647",
                                        "glosses": [
                                            "auf einen Äquator oder eine Äquatorebene bezogen, an einem Äquator oder in einer Äquatorebene gelegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e02adff-78d9-4c74-87c1-21fd24d4895e",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Eine weitere nahezu windlose Zone ist der äquatorial gelegene Kalmengürtel."
                                            },
                                            {
                                                "example_id": "0af8ceea-0293-4ebb-a944-4d7a5713776c",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Das Klima ist typisch äquatorial und kennzeichnet sich neben ganzjährig hohen Temperaturen durch eine hohe Luftfeuchtigkeit."
                                            },
                                            {
                                                "example_id": "39684dad-e901-4240-90ef-757f23958221",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Die Frucht bildet eine rote, rötliche, grünliche oder bräunliche Scheinbeere, welche bei Reife abtrocknet und äquatorial aufreißt."
                                            },
                                            {
                                                "example_id": "900ca055-e31d-4ef5-adce-ea5d6dadc238",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Die Keimöffnungen sind entweder äquatorial diporat oder meridional zonasulcat."
                                            },
                                            {
                                                "example_id": "ebfdbbc5-3e23-40f9-94a5-123378b9dd4b",
                                                "sense_id": "e34c6e87-8ed8-3c81-b6ab-1b6c91088964",
                                                "text": "Dabei ist das Wasserstoffatom und ein Carbonylligand axial, die drei weiteren Carbonylliganden äquatorial angeordnet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8804f8c3-0535-3e66-8d70-650331d855d8",
                                        "entry_id": "1635f0a7-84bc-34a7-aa08-c23b35c30647",
                                        "glosses": [
                                            "Astronomie (von Koordinatensystemen): mit einer Himmelsachse, die gleich der Erdachse ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d13ba949-ffae-4aaf-b69e-ce2db82f4989",
                                                "sense_id": "8804f8c3-0535-3e66-8d70-650331d855d8",
                                                "text": "Der Frühlingspunkt dient sowohl für das äquatoriale wie für das ekliptikale Koordinatensystem als Nullpunkt, von dem aus Rektaszension bzw. ekliptikale Länge gezählt werden (nach Osten positiv)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
