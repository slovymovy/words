                                "target_senses": [
                                    {
                                        "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                        "entry_id": "c3e5339b-c4c0-3f8a-8f43-db078ef63b0f",
                                        "glosses": [
                                            "Faire un faux pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5b8c1e2-3012-4326-ae34-6ab5bb98c800",
                                                "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                                "text": "Cette course fiévreuse durait depuis dix heures. Le cheval râlait sourdement et trébuchait à chaque pas."
                                            },
                                            {
                                                "example_id": "8bb72af3-c204-4c38-82eb-0cc3372d8ec9",
                                                "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                                "text": "Cette maison, revêtue d’ardoises, se trouvait entre un passage et une ruelle aboutissant à la rivière. Elle avait intérieurement des différences de niveau qui faisaient trébucher."
                                            },
                                            {
                                                "example_id": "fb57e8e1-d5b6-492e-b147-05cd141444ad",
                                                "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                                "text": "C'est ainsi que trébuche celui qui sent qu'on croit qu'il va trébucher."
                                            },
                                            {
                                                "example_id": "778c3d0b-4db0-4844-a620-c5ad0200e3d6",
                                                "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                                "text": "Péniblement, il se releva et regagna, en trébuchant, sa place."
                                            },
                                            {
                                                "example_id": "a4041ca5-f210-45ba-99e2-e5b82b08ce17",
                                                "sense_id": "e2f3df18-7722-3575-ab72-c4a9b842d304",
                                                "text": "Il se souvenait du silence, du ciel couleur d'étain, des cristaux de givre qui lui écorchaient le nez, les joues ; de cette gadoue, neige et boue qui le faisait trébucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26efef30-1ff3-383e-b4c3-fc9577604815",
                                        "entry_id": "c3e5339b-c4c0-3f8a-8f43-db078ef63b0f",
                                        "glosses": [
                                            "Tomber."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee466ba-5642-4584-a8bb-268b8ee3d4ad",
                                                "sense_id": "26efef30-1ff3-383e-b4c3-fc9577604815",
                                                "text": "Trébucher dans une mauvaise affaire."
                                            },
                                            {
                                                "example_id": "0afa7d1a-18cd-43b4-8798-3e82df0d11d3",
                                                "sense_id": "26efef30-1ff3-383e-b4c3-fc9577604815",
                                                "text": "Nous suivons avec peine, à travers des champs et des prairies coupées de haies. Nous trébuchons contre un bœuf étendu."
                                            },
                                            {
                                                "example_id": "33900690-0a8e-4879-8b4c-9573d8591945",
                                                "sense_id": "26efef30-1ff3-383e-b4c3-fc9577604815",
                                                "text": "Jimmy le faisait méchamment trébucher, en le happant du crochet de sa grosse canne blanche, et les deux hommes tombaient à terre, ensemble."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2243a76-7cb4-3228-a5e2-8c82c7d89ac7",
                                        "entry_id": "c3e5339b-c4c0-3f8a-8f43-db078ef63b0f",
                                        "glosses": [
                                            "Déchoir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f74f2dd-730a-4bad-9378-afe46ea91de2",
                                                "sense_id": "c2243a76-7cb4-3228-a5e2-8c82c7d89ac7",
                                                "text": "Je ne vous ai point oublié, je ne vous oublierai jamais, soyez-en sûr ; si dans cette existence périlleuse d’un enfant perdu je n’ai pas trébuché, je ne suis pas tombé, c’est à vous que je le dois, à vos leçons, à vos exemples, ô mon vieux maître !"
                                            },
                                            {
                                                "example_id": "56e02969-b147-4f35-8f05-5316381e63db",
                                                "sense_id": "c2243a76-7cb4-3228-a5e2-8c82c7d89ac7",
                                                "text": "Il n’y a pas à dire, mais quand les dieux ou les destins, comme vous voudrez, ont décidé qu’ils vous feraient trébucher sur la route de la gloire ou de la fortune, il est inutile de regimber."
                                            },
                                            {
                                                "example_id": "a8920103-2c4c-45d8-9a3c-62ad92408e2e",
                                                "sense_id": "c2243a76-7cb4-3228-a5e2-8c82c7d89ac7",
                                                "text": "Probablement toutes ces réponses à la fois et aussi, inévitablement, ce que nous percevons tous les jours, chaque fois que nous trébuchons, tant physiquement que moralement, chaque fois qu’un être cher meurt, qu’un enfant désiré naît, qu’une maladie nous plie en deux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e098bb5-1303-34d0-b720-546faaca74a2",
                                        "entry_id": "c3e5339b-c4c0-3f8a-8f43-db078ef63b0f",
                                        "glosses": [
                                            "Emporter par sa pesanteur celle contre laquelle elle est pesée, faire pencher le trébuchet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "936ae243-a339-49f5-b62a-6c8edea3e5a2",
                                                "sense_id": "4e098bb5-1303-34d0-b720-546faaca74a2",
                                                "text": "Une pièce qui trébuche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1015592-9cb7-401a-9b1e-2753d4fae491",
                        "source_entry_id": "5d0352f0-6bbd-373b-a996-4117fe332fe8",
                        "source_sense_id": "01ea90e1-a72d-3928-a5ae-0f5cfe59deff",
                        "target_lang_word": "selhat",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selhat",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "c1d10fb5-0cd0-3d07-92fd-6c724e283958",
                                        "entry_id": "29520f49-77b5-3491-87c0-c64d4fd1384d",
                                        "glosses": [
                                            "nesplnit požadovaný úkol či funkci"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db3a28a2-e9f4-46e4-8706-b859eb157e25",
                                                "sense_id": "c1d10fb5-0cd0-3d07-92fd-6c724e283958",
                                                "text": "Automobilu v prudkém klesání selhaly brzdy a vůz se řítil nekontrolovaně vpřed."
                                            },
                                            {
                                                "example_id": "c904bc06-cf52-4612-a1de-bf232a45cb14",
                                                "sense_id": "c1d10fb5-0cd0-3d07-92fd-6c724e283958",
                                                "text": "Snad jenom mně se může stát, že když mám pod sebou mladou, dychtivou, svěží, svlečenou a ke všem hříchům ochotnou dívku, selžu jako šnek, který má urazit metr pod tři hodiny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
