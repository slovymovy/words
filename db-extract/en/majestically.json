                        "translation_id": "3955938a-ba99-4243-bbd3-fb9cb0489da1",
                        "source_entry_id": "17abb09c-69d3-32c0-97b9-5c87a28050c6",
                        "source_sense_id": "1719d0b7-6313-30e8-b3e9-8d63161dda28",
                        "source_sense_description": "in a majestic manner",
                        "target_lang_word": "majestueusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majestueusement",
