                                "example_id": "e1bc0549-eb9c-4a78-a295-89882c792777",
                                "sense_id": "fb7bfdc9-dd5b-3ca6-9f58-e95614d11085",
                                "text": "Het was een weergaloos optreden dat de 70 jarige zangeres wist neer te zetten."
                            },
                            {
                                "example_id": "79a6bd16-10f6-4a0e-b609-c04af728d5dd",
                                "sense_id": "fb7bfdc9-dd5b-3ca6-9f58-e95614d11085",
                                "text": "Hij was een bescheiden Britse kostschooljongen met een keurig Engels accent die, eenmaal op het podium, in een echte entertainer veranderde en als een kleine Mark Knopfler een weergaloze gitaarsolo neerzette."
                            }
                        ]
                    }
