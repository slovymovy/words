                    },
                    {
                        "translation_id": "b403d94e-b004-4442-be76-d3833e4e4bd8",
                        "source_entry_id": "d59ed7c0-6913-3266-bd32-643bb143fb3a",
                        "source_sense_id": "77b65793-e2ef-3510-96ad-cebd0d7ba70c",
                        "target_lang_word": "Maxime",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maxime",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                        "entry_id": "c79535dc-b9bb-34b4-b4d4-5e45fe06bdbe",
                                        "glosses": [
                                            "Einstellung/Motto/Regel, wonach man sein Verhalten ausrichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db57bc4a-42dc-4b3a-8925-8cc76e5b14e6",
                                                "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                                "text": "Er folgte immer der Maxime: Zuerst die Arbeit, dann das Vergnügen."
                                            },
                                            {
                                                "example_id": "5dc69e05-6819-47b7-8e22-55df303121df",
                                                "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                                "text": "„Handle so, daß die Maxime deines Willens jederzeit zugleich als Prinzip einer allgemeinen Gesetzgebung gelten könne.“"
                                            },
                                            {
                                                "example_id": "7b516da3-d834-43bf-b693-70ca4e17d8f3",
                                                "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                                "text": "„Daß die Staatsform der Demokratie keiner Zeremonien und Symbole bedürfe - diese Ansicht galt in der Bonner Republik über Jahrzehnte hinweg als unausgesprochene Maxime."
                                            },
                                            {
                                                "example_id": "37c176f0-a849-4e89-ae7c-da7a71ded2c1",
                                                "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                                "text": "„Das eine zu gewinnen, ohne das andere zu verlieren, scheint die Maxime der Polinnen zu sein.“"
                                            },
                                            {
                                                "example_id": "107cd1c6-3924-46fe-bd54-fbb2240341dc",
                                                "sense_id": "223a4c92-02c6-39d5-b8ee-4ad8c056573b",
                                                "text": "„So exemplifiziert de Sade, etwas summarisch formuliert, die populäre Maxime »Zurück zur Natur« auf seine Weise und inszeniert jene infernalische Welt, in der es, mit versetzten moralischen Vorzeichen, trotz aller Bestialität ganz logisch zugeht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d2dc10b-faba-4268-acd8-0c18f84dd5ef",
