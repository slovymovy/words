                                "example_id": "00a70884-0ef8-428b-bd5f-f8684f6d3292",
                                "sense_id": "15a012a6-9f81-3c2b-b7ea-e8571b697f4c",
                                "text": "Margin of dolon curling smoothly to distal margin of velum both anteriorly and posteriorly, but dolonal margins not in contact when valves closed."
                            },
                            {
                                "example_id": "d41f3252-2f99-45f3-83ac-a97739f1d0a7",
                                "sense_id": "15a012a6-9f81-3c2b-b7ea-e8571b697f4c",
                                "text": "In both cases the histial dolon is united anteriorly with the velar dolon and both genera are also similar in being unisulcate ."
                            }
                        ]
                    }
