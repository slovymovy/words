                "senses": [
                    {
                        "sense_id": "fd9b4086-e505-3f97-a162-7e08514c60a2",
                        "entry_id": "edcf1fc5-4e14-3456-a56c-163624bd7ec4",
                        "glosses": [
                            "Faire perdre son caractère bouffon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01d305af-d762-4b75-8c14-4c48af56213c",
                                "sense_id": "fd9b4086-e505-3f97-a162-7e08514c60a2",
                                "text": "Si on mélange tous les produits, on crée un liquide marabouté qui va permettre de débouffoniser cet objet, que je serai malheureusement ensuite contrainte de jeter dans le Lez."
                            },
                            {
                                "example_id": "24729be2-7916-4e86-bfb8-72fa1a779f62",
                                "sense_id": "fd9b4086-e505-3f97-a162-7e08514c60a2",
                                "text": "Plateau jeune, dominé par Cyrille Dubois (Belmonte), Joanna Wydorska (Blonde) et David Steffens en Osmin débouffonisé, direction vif-argent (au prix de quelques dérapages) du violoniste-chef Stefano Montanari, achevant d’entretenir le doute quant à la pérennité du message des Lumières en notre époque troublée."
                            },
                            {
                                "example_id": "b2eed1de-c5ed-463b-b5b0-f34d44ceda33",
                                "sense_id": "fd9b4086-e505-3f97-a162-7e08514c60a2",
                                "text": "Ma foi, pourquoi pas, on ajoute du piment et surtout on « débouffonise » un peu le perso."
                            }
                        ]
                    }
                ],
