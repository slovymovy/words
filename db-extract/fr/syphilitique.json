                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4c5e72f-6659-4219-8a91-bb7e9f6d71a5",
                                                "sense_id": "6ecc0e6c-e793-3322-8048-8acc99807373",
                                                "text": "One can try hunting syphilitic treponemes directly by having skin irregularities […] biopsied and subjected to a silver-staining test."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
