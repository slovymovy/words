                        "cross_references": []
                    },
                    {
                        "translation_id": "9ff4e5b1-9ad4-4773-9bf6-2366ca891475",
                        "source_entry_id": "eed0f8dd-2191-367a-a923-0669b6d5e929",
                        "source_sense_id": "447c22ce-f020-33a4-b2ba-204a5f71dd46",
                        "target_lang_word": "Mesalliance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mesalliance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ff7a073-a02b-39d4-b41d-340b27227dcb",
                                        "entry_id": "7f88f898-e319-3819-b34e-b990c7123ce0",
                                        "glosses": [
                                            "nicht standesgemäße Ehe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bba415a3-06a3-4c2a-8630-fdaf28c0b700",
                                                "sense_id": "1ff7a073-a02b-39d4-b41d-340b27227dcb",
                                                "text": "„Wollte deine Familie, besonders dein Vater, absolut nichts von der Mesalliance mit dem Yankeekommis, wie sie mich nannten, wissen.“"
                                            },
                                            {
                                                "example_id": "e53ff155-7ebf-4f48-8ac0-88df8ec57a95",
                                                "sense_id": "1ff7a073-a02b-39d4-b41d-340b27227dcb",
                                                "text": "„St. Arnaud aber trat nicht nur für den Privatgelehrten ein, sondern setzte sogar mit vieler Feierlichkeit hinzu, daß er sich einer Mesalliance zwischen einem Werleschen Fürsten und einer anhaltischen Prinzessin entsinne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56729ce7-485f-3f54-9612-b17bf0b31685",
                                        "entry_id": "7f88f898-e319-3819-b34e-b990c7123ce0",
                                        "glosses": [
                                            "unglückliche Verbindung, Beziehung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26b7731-f65f-4127-9c35-55b92388caf9",
                                                "sense_id": "56729ce7-485f-3f54-9612-b17bf0b31685",
                                                "text": "„Mit diesen hohen Subventionen kaufen sich die Saudis auch vom Makel ihrer ideologischen Mesalliance mit den USA frei, denn als solchen empfinden viele Muslime Riads Bündnis mit Amerika.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14549b07-0502-4b08-bf8a-5b98de8c960f",
                        "source_entry_id": "eed0f8dd-2191-367a-a923-0669b6d5e929",
