    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d45501cc-6d37-3c18-aa2d-782eff78e187",
                    "sense_definition": "op een zeer levendige en uitvoerige manier praten zonder op te houden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "praten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind babbelde <w>honderduit</w> over zijn eerste dag op de basisschool.",
                            "target_lang_translations": {
                                "en": "The child babbled <w>away</w> about his first day at primary school."
                            }
                        },
                        {
                            "text": "Tijdens de lange wandeling vertelde mijn opa <w>honderduit</w> over zijn jeugd in het dorp.",
                            "target_lang_translations": {
                                "en": "During the long walk, my grandfather told stories <w>at length</w> about his youth in the village."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitvoerig",
                        "vrijuit"
                    ],
                    "antonyms": [
                        "kortaf",
                        "zwijgzaam"
                    ],
                    "common_phrases": [
                        "honderduit praten",
                        "honderduit vertellen",
                        "honderduit babbelen"
                    ],
                    "target_lang_definitions": {
                        "en": "talking in a very lively and extensive way without stopping"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at length",
                                "target_lang_sense_clarification": "speaking extensively and in detail"
                            },
                            {
                                "target_lang_word": "freely",
                                "target_lang_sense_clarification": "speaking without hesitation or restraint"
                            },
                            {
                                "target_lang_word": "away",
                                "target_lang_sense_clarification": "used with verbs like 'chat' or 'talk' to indicate continuous action"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f526df-bf24-3ca9-95a7-695e90f85bd4",
                    "sense_definition": "in grote mate of zeer veel, vaak gebruikt in de context van waarschuwen of bekennen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hoeveelheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gids heeft <w>honderduit</w> gewaarschuwd tegen de gevaren van het moeras.",
                            "target_lang_translations": {
                                "en": "The guide warned <w>repeatedly</w> against the dangers of the swamp."
                            }
                        },
                        {
                            "text": "De verdachte begon <w>honderduit</w> te verklaren over zijn rol bij de diefstal.",
                            "target_lang_translations": {
                                "en": "The suspect began to testify <w>extensively</w> about his role in the theft."
                            }
                        }
                    ],
                    "synonyms": [
                        "volop",
                        "overvloedig"
                    ],
                    "common_phrases": [
                        "honderduit waarschuwen"
                    ],
                    "target_lang_definitions": {
                        "en": "to a great extent or very much, often used in the context of warning or confessing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "repeatedly",
                                "target_lang_sense_clarification": "doing something many times, such as warning"
                            },
                            {
                                "target_lang_word": "extensively",
                                "target_lang_sense_clarification": "in a detailed or comprehensive manner"
                            },
                            {
                                "target_lang_word": "at great length",
                                "target_lang_sense_clarification": "providing a lot of information or warnings"
                            }
                        ]
                    }
                }
            ]
        }
    ]
