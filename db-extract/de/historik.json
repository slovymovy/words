        "de-extract.jsonl": [
            {
                "entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                "word": "Historik",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "f07eb439-ff1e-4360-a5c5-b020f6103858",
                        "entry_id": "79431ca2-4190-3afd-b4b5-2a3ea9961bc4",
                        "tags": [
