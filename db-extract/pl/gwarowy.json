                                "target_senses": [
                                    {
                                        "sense_id": "095324b9-554f-3e45-a145-2d91e1ff6ee8",
                                        "entry_id": "a9f42198-7af0-3897-b7b9-eb5fc8b7b4b7",
                                        "glosses": [
                                            "die Mundart betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ca2f30-607f-4d33-af81-a556535702fe",
                                                "sense_id": "095324b9-554f-3e45-a145-2d91e1ff6ee8",
                                                "text": "„Das liegt auch an der mundartlichen Vielfalt, der sich jeder schnell bewußt wird, der hier lebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                        "entry_id": "a9f42198-7af0-3897-b7b9-eb5fc8b7b4b7",
                                        "glosses": [
                                            "in einer Mundart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f11baca-d3ee-4308-97ea-d6470ceb25f4",
                                                "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                                "text": "Heute sind bei Radio und Fernsehen die Regionalnachrichten mundartlich und dies, was besonders aufschlussreich ist, unter weitgehender Beibehaltung der genannten textsortentypischen Merkmale in Syntax und Lexikon."
                                            },
                                            {
                                                "example_id": "568a0def-2b36-4350-ad85-e9e6dfe96845",
                                                "sense_id": "0514545f-5859-3f70-bc2a-a5ad90c2dd6f",
                                                "text": "Apfelwein, mundartlich auch \"Äppelwoi\" oder liebevoll \"Stöffche\" genannt, in Hessen \"Nationalgetränk\", hat keine Lobby!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
