    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cae1264b-9854-3f78-a701-8a2804bc4c94",
                    "sense_definition": "czyścić powierzchnię z kurzu lub brudu za pomocą odkurzacza",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sprzątanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę dzisiaj <w>odkurzyć</w> cały salon przed przyjściem gości.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сегодня <w>пропылесосить</w> всю гостиную перед приходом гостей."
                            }
                        },
                        {
                            "text": "Czy mógłbyś <w>odkurzyć</w> dywan w pokoju dziecięcym?",
                            "target_lang_translations": {
                                "ru": "Ты не мог бы <w>пропылесосить</w> ковер в детской комнате?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "odkurzać dywan",
                        "odkurzać mieszkanie"
                    ],
                    "target_lang_definitions": {
                        "ru": "чистить поверхность от пыли или грязи с помощью пылесоса"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пылесосить",
                                "target_lang_sense_clarification": "основной глагол для обозначения уборки пылесосом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3c9e413-dc81-3ab4-a1e4-0586feb87125",
                    "sense_definition": "usuwać kurz z przedmiotów za pomocą ścierki lub innego narzędzia",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "sprzątanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Józefa codziennie tę półeczkę <w>odkurzała</w> osobiście z wielkim nabożeństwem.",
                            "target_lang_translations": {
                                "ru": "Юзефа каждый день лично <w>вытирала пыль</w> с этой полочки с большим усердием."
                            }
                        },
                        {
                            "text": "Warto regularnie <w>odkurzać</w> książki na regale.",
                            "target_lang_translations": {
                                "ru": "Стоит регулярно <w>вытирать пыль</w> с книг на полке."
                            }
                        }
                    ],
                    "synonyms": [
                        "wycierać"
                    ],
                    "common_phrases": [
                        "odkurzać meble"
                    ],
                    "target_lang_definitions": {
                        "ru": "удалять пыль с предметов с помощью тряпки или другого инструмента"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытирать пыль",
                                "target_lang_sense_clarification": "удаление пыли с поверхностей вручную"
                            },
                            {
                                "target_lang_word": "протирать",
                                "target_lang_sense_clarification": "очистка предметов от пыли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9e3c6d0-1c72-3562-8d95-1b82d7e4e0c1",
                    "sense_definition": "przypominać o czymś zapomnianym lub wracać do dawnych spraw",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaforyczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Politycy lubią <w>odkurzać</w> stare obietnice przed samymi wyborami.",
                            "target_lang_translations": {
                                "ru": "Политики любят <w>вспоминать</w> старые обещания прямо перед выборами."
                            }
                        },
                        {
                            "text": "Postanowiłem <w>odkurzyć</w> swoje dawne notatki z czasów studiów.",
                            "target_lang_translations": {
                                "ru": "Я решил <w>достать из архива</w> свои старые конспекты времен учебы."
                            }
                        }
                    ],
                    "synonyms": [
                        "przypominać",
                        "wznawiać"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w przenośni"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "напоминать о чем-то забытом или возвращаться к старым делам"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вспоминать",
                                "target_lang_sense_clarification": "возвращаться к старым мыслям или делам"
                            },
                            {
                                "target_lang_word": "доставать из архива",
                                "target_lang_sense_clarification": "метафорическое выражение для возвращения к забытым вещам"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}