                "senses": [
                    {
                        "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                        "entry_id": "63b16b51-a9c4-3f54-9fb2-779696e5e433",
                        "glosses": [
                            "durch Ruß schwarz geworden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "235c2659-14c1-4d7f-8dbb-11b7a0f13837",
                                "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                                "text": "„Der Boden müsste geputzt werden: gebrauchte Spritzen, Crackampullen, rußgeschwärzte Löffel, Mundstücke von Pfeifen.“"
                            },
                            {
                                "example_id": "364dff2d-2f95-4a10-ac0c-58f1cd1acc33",
                                "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                                "text": "„Der Knauf drehte sich, und die Tür schwang auf und enthüllte einen gebückten, rußgeschwärzten Kobold, umgeben von den Feuern der Hölle.“"
                            },
                            {
                                "example_id": "5ab89821-049e-4b84-ab48-e2ab42db3d62",
                                "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                                "text": "„Es war die Küche, nur war sie leer, von einigen Töpfen und Tiegeln abgesehen, die auf dem rußgeschwärzten Tisch standen.“"
                            },
                            {
                                "example_id": "3695df68-a288-47a0-a11c-e2eea017dfbf",
                                "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                                "text": "„Yu und Sanguk schalteten ihre Handlampen an und überprüften sorgfältig die rußgeschwärzten Außenwände des Hauses und die Umgebung.“"
                            },
                            {
                                "example_id": "6f275087-0ee9-4a82-9254-f16c28c4eca3",
                                "sense_id": "0d6ebfee-666e-3611-b197-526d59d3735b",
                                "text": "„Die Eingangshalle der Botschaft glich nun einem Abbild der Hölle: ein rußgeschwärztes Trümmerfeld voller Rauch und Staub.“"
                            }
                        ],
