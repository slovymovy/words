                    {
                        "sense_id": "5f0de622-82aa-32d4-bb88-19726405cfdb",
                        "entry_id": "1f18fbd9-9402-38e9-981c-933a7c4f519e",
                        "glosses": [
                            "Rascally behavior."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69e70116-9198-475d-abd7-084f02aa20fa",
                                "sense_id": "5f0de622-82aa-32d4-bb88-19726405cfdb",
                                "text": "The Dutch war, the rights of election, contests between king and parliament on questions of vital importance, the plots, rascalries, the shame and humiliation of the time, must have been in men's thoughts."
                            },
                            {
                                "example_id": "dac236b6-7c8c-4e5e-8b62-18d93c5c7fa3",
                                "sense_id": "5f0de622-82aa-32d4-bb88-19726405cfdb",
                                "text": "Can a rascal see his rascalry? How could he, poor man?"
                            }
                        ]
                    },
                    {
                        "sense_id": "a68a9b17-3ec2-3b11-8386-0ac2b484e58b",
                        "entry_id": "1f18fbd9-9402-38e9-981c-933a7c4f519e",
                        "glosses": [
                            "Rascals."
                        ],
                        "tags": [
                            "collective",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dc32bc3b-f9df-4b7f-a589-da5394809200",
                                "sense_id": "a68a9b17-3ec2-3b11-8386-0ac2b484e58b",
                                "text": "All the rascalry of the town, under the slogan of 'Church and King! and d--- all Presbyterians!' took advantage of the opportunity to burn, destroy, and plunder."
                            },
                            {
                                "example_id": "8e6dd329-fd18-4605-ac08-9033612833a9",
                                "sense_id": "a68a9b17-3ec2-3b11-8386-0ac2b484e58b",
                                "text": "Once-productive fields were deserted, as magnates surrounded themselves with hired rascalry, and banditry took over large areas of the countryside."
                            }
                        ]
                    }
                ],
