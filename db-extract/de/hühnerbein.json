                        ],
                        "form": "das Hühnerbein"
                    },
                    {
                        "form_id": "f0b36f18-4804-488e-b773-6afba975efc7",
                        "entry_id": "e165c650-2cf5-3f47-859e-d05d8b3dfbe9",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hühnerbeine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "760cb3c8-fcef-3a28-ab68-8ce131c282de",
                        "entry_id": "e165c650-2cf5-3f47-859e-d05d8b3dfbe9",
                        "glosses": [
                            "Bein eines (geschlachteten) Huhns beziehungsweise Hähnchens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd931704-fcbf-4713-9b2c-53aee507891e",
                                "sense_id": "760cb3c8-fcef-3a28-ab68-8ce131c282de",
                                "text": "Hier ein abgebissener Kopf, dort ein abgerissenes Hühnerbein, der tierische Eindringling hatte im Hühnergehege gewütet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "75ab087b-2358-3a60-95a3-a7883e29c8c7",
                        "entry_id": "e165c650-2cf5-3f47-859e-d05d8b3dfbe9",
                        "glosses": [
                            "zubereitete Keule des Huhns"
                        ],
                        "tags": [
                            "häufig im Plural"
                        ],
                        "examples": [
                            {
                                "example_id": "374a54e1-ab87-47e7-8dac-150f54fcd175",
                                "sense_id": "75ab087b-2358-3a60-95a3-a7883e29c8c7",
                                "text": "„Momly kocht abends immer Hühnerbeine für uns.“"
                            },
                            {
                                "example_id": "17e7529c-4312-4cc0-9879-f3a40a464052",
                                "sense_id": "75ab087b-2358-3a60-95a3-a7883e29c8c7",
                                "text": "„Ich schmause eine gebackene Banane und ein Hühnerbein, doch in tiefer Meditation sitzt meine Seele darüber und staunt ihr Idol an: die tote Bimatatetēle.“"
                            },
                            {
                                "example_id": "d30f6fb6-1408-4ea9-9788-61167ff45680",
                                "sense_id": "75ab087b-2358-3a60-95a3-a7883e29c8c7",
                                "text": "„Die Männer, die an die Wand gedrängt standen, verschlangen hastig eine Scheibe Schinken oder nagten ein im Fluge erwischtes Hühnerbein ab. “"
                            },
                            {
                                "example_id": "788e3bb3-dcaa-45c8-ad20-5d5ddc88276e",
                                "sense_id": "75ab087b-2358-3a60-95a3-a7883e29c8c7",
                                "text": "„Nachdem er das rechte Hühnerbein verzehrt hatte, stocherte er solange mit dem Messer an dem linken herum, bis auch davon nur ein nackter Knochen am Huhne hing.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
