                ],
                "senses": [
                    {
                        "sense_id": "5a5bbb6d-209f-3155-b563-84db6d6a7fa6",
                        "entry_id": "924443fb-4bbb-3907-8302-88190469b4b4",
                        "glosses": [
                            "Enrouler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3778dfbf-613a-4f95-bab2-a89712ed83f4",
                                "sense_id": "5a5bbb6d-209f-3155-b563-84db6d6a7fa6",
                                "text": "Il renroule ses cartes et les glisse dans un fourreau, puis il replie sa longue vue qu’il range dans un étui et met à son tour dans la valise."
                            },
                            {
                                "example_id": "e58fc134-974a-4606-a130-0479d25fb6e7",
                                "sense_id": "5a5bbb6d-209f-3155-b563-84db6d6a7fa6",
                                "text": "Moi, j’attends qu’ils frappent, et je saute dessus avant qu’ils aient eu le temps de se renrouler."
                            },
                            {
                                "example_id": "c2207b0d-840f-4cf5-ad6f-09b93459f925",
                                "sense_id": "5a5bbb6d-209f-3155-b563-84db6d6a7fa6",
                                "text": "Et je roule et je m’enroule et me déroule et me renroule dans le vide, avant d’aboutir brutalement dans la résille compliquée d’un immense filet."
                            }
                        ]
                    }
                ],
