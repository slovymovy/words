                        "entry_id": "1a8db89a-f2d6-35cc-b8bc-7393ae5e30da",
                        "glosses": [
                            "Petit trou cylindrique dans la glace ou la neige, provoqué par le réchauffement de matériaux sombres qui étaient posés dessus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61a654d6-3be6-4c5e-a722-3295dce97bc1",
                                "sense_id": "bc4d5dc9-1879-3219-b990-c9f70ee67018",
                                "text": "La cryoconite est un mélange de poussières et particules de matière organique de petite taille, de couleur noire, qui s'accumule dans de petites dépressions du glacier et qui s'approfondissent lentement."
                            }
                        ]
                    }
