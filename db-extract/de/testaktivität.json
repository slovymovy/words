                "senses": [
                    {
                        "sense_id": "c3a1c198-a5d0-397e-a94e-116e941e4bb0",
                        "entry_id": "fb244358-819f-3df7-86dd-a7b9844d9df8",
                        "glosses": [
                            "Durchführen einer Prüfung, Testdurchführung, Zeit, während der ein Test läuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6adf9c2-c40d-4955-8bcb-e7172d97e70a",
                                "sense_id": "c3a1c198-a5d0-397e-a94e-116e941e4bb0",
                                "text": "„Die Testaktivität beginnt im RUP bereits in der Konzeptualisierung mit der Testplanung und somit frühzeitig im Projekt. Die Testaktivität (s. [Kruchten 99, Kap. 12]) ist so gestaltet, dass Tests nie alle auf einmal durchgeführt werden.“"
                            },
                            {
                                "example_id": "19706bed-5051-467b-837c-5623645b5c9c",
                                "sense_id": "c3a1c198-a5d0-397e-a94e-116e941e4bb0",
                                "text": "„STROTHER (1949) folgerte aus den Ergebnissen seiner Versuche mit geübten (Schauspieler) und ungeübten (Studenten) Versuchspersonen, daß Differenzen zwischen Ruhe- und Testaktivität ein charakteristisches Aktionspotentialniveau für die entsprechenden Emotionen kennzeichneten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
