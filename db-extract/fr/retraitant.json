                        "sense_id": "cce11fc1-b906-3a2d-9a9a-cbce76b4ad42",
                        "entry_id": "979650d3-b7d9-3c57-9e5c-e62213471714",
                        "glosses": [
                            "Désigne les personnes, hommes ou femmes qui effectuent une retraite spirituelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca5ef609-2204-4087-a512-89bcf775fdfc",
                                "sense_id": "cce11fc1-b906-3a2d-9a9a-cbce76b4ad42",
                                "text": "Le quatrième chapitre porte sur la nourriture et la boisson pendant la retraite: repas à prendre, aliments et boissons à absorber, position que doit adopter le retraitant pour manger."
                            },
                            {
                                "example_id": "4087737f-1364-4961-8fac-b1ebedd41904",
                                "sense_id": "cce11fc1-b906-3a2d-9a9a-cbce76b4ad42",
                                "text": "Prières, enseignements et accompagnement personnalisé se succèdent. Les repas sont pris en silence. Les retraitants ne sont jamais laissés seuls"
                            },
                            {
                                "example_id": "9332f757-1c1c-43e3-b980-f208a6b7dba5",
                                "sense_id": "cce11fc1-b906-3a2d-9a9a-cbce76b4ad42",
                                "text": "... elle pouvait prendre part au repas pris entre retraitants..."
                            }
                        ]
                    }
                ],
