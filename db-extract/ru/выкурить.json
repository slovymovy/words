                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вы́курив"
                    },
                    {
                        "form_id": "8010b3d0-07d2-4ee3-b839-1d07a2c8df76",
                        "entry_id": "4edb784e-969e-3f06-bbc6-45e9092ba132",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "вы́куривши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6addfd56-48ca-3663-bb3b-9457a046a28f",
                        "entry_id": "4edb784e-969e-3f06-bbc6-45e9092ba132",
                        "glosses": [
                            "полностью употребить то, что предназначено для курения (сигарету, трубку и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c851f70-daba-473f-b116-63b23117b0c0",
                                "sense_id": "6addfd56-48ca-3663-bb3b-9457a046a28f",
                                "text": "Позвольте мне постоять подле вас и, если не возражаете, выкурить две папиросы."
                            },
                            {
                                "example_id": "5a986daf-b444-4335-950c-eb208a1539a6",
                                "sense_id": "6addfd56-48ca-3663-bb3b-9457a046a28f",
                                "text": "После чая Солнцев пригласил нас к себе в кабинет выкурить по трубке."
                            }
                        ]
                    },
                    {
                        "sense_id": "561f2074-fdf8-3c6a-b06c-d9a79ca63749",
                        "entry_id": "4edb784e-969e-3f06-bbc6-45e9092ba132",
                        "glosses": [
                            "спец. окуривая дымом, вынудить покинуть занимаемое помещение, ёмкость, пространство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4ab6c9e-791c-4a05-8daf-d0195367d7e0",
                                "sense_id": "561f2074-fdf8-3c6a-b06c-d9a79ca63749",
                                "text": "Комаров было множество, и они очень нам докучали. По вечерам, перед сном, мы нередко жгли в своих комнатах можжевеловые ветки, чтобы их выкурить."
                            },
                            {
                                "example_id": "6fbb2983-d226-4718-91f9-a7dd0db83481",
                                "sense_id": "561f2074-fdf8-3c6a-b06c-d9a79ca63749",
                                "text": "Не выкурить ли муравьев дымом, а потом, когда они покинут свое жилище, отправиться за вещами?"
                            }
                        ]
                    },
                    {
                        "sense_id": "ba16a00e-9894-3f04-8885-55e08c546174",
                        "entry_id": "4edb784e-969e-3f06-bbc6-45e9092ba132",
                        "glosses": [
                            "перен. вынудить кого-либо покинуть занимаемое помещение, место, позицию, создав невыносимые условия для дальнейшего пребывания в них"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cb269e9-3679-453b-9c5c-b58cd6c85bb6",
                                "sense_id": "ba16a00e-9894-3f04-8885-55e08c546174",
                                "text": "Дождь усиливался и хлестал иногда с порывами ветра мне под капюшон, но он был теплым, а порывы редкими, поэтому выкурить меня с моей скамейки было сложно."
                            },
                            {
                                "example_id": "5054e2f9-7a98-457f-99bd-a6ef4e180a86",
                                "sense_id": "ba16a00e-9894-3f04-8885-55e08c546174",
                                "text": "Но один из кочегаров засел в котельной, и до сих пор его не удается выкурить оттуда."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
