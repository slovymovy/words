                {
                    "sense_id": "463c4de7-05c9-352b-8ed5-d156704e121b",
                    "sense_definition": "Qui doit être respecté sans exception ; rigoureux ou étroitement délimité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "regle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur exige le <w>strict</w> respect des consignes de sécurité.",
                            "target_lang_translations": {
                                "en": "The director demands <w>strict</w> compliance with safety instructions.",
                                "ru": "Директор требует <w>строгого</w> соблюдения инструкций по технике безопасности.",
                                "de": "Der Direktor verlangt die <w>strenge</w> Einhaltung der Sicherheitsvorschriften.",
                                "es": "El director exige el <w>estricto</w> cumplimiento de las instrucciones de seguridad.",
                                "zh": "主任要求<w>严格</w>遵守安全规定。"
                            }
                        },
                        {
                            "text": "Au sens <w>strict</w>, cette mesure ne s'applique qu'aux adultes.",
                            "target_lang_translations": {
                                "en": "In the <w>strict</w> sense, this measure applies only to adults.",
                                "ru": "В <w>строгом</w> смысле эта мера применяется только к взрослым.",
                                "de": "Im <w>strengen</w> Sinne gilt diese Maßnahme nur für Erwachsene.",
                                "es": "En sentido <w>estricto</w>, esta medida solo se aplica a los adultos.",
                                "zh": "从<w>严格</w>意义上说，这项措施只适用于成年人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rigoureux",
                        "draconien",
                        "étroit"
                    ],
                    "antonyms": [
                        "large",
                        "approximatif",
                        "souple"
                    ],
                    "common_phrases": [
                        "au sens strict",
                        "strict respect",
                        "stricte vérité",
                        "stricte surveillance"
                    ],
                    "target_lang_definitions": {
                        "en": "Must be observed without exception, or rigorous and narrowly limited in scope.",
                        "ru": "Требующий соблюдения без исключений; точный или узко ограниченный по объёму.",
                        "de": "Muss ohne Ausnahme befolgt werden oder eng und genau begrenzt sein.",
                        "es": "Que debe cumplirse sin excepciones, o bien riguroso y de alcance muy limitado.",
                        "zh": "必须毫无例外地遵守的；或指严谨、界定很窄的。"
                    },
                    "translations": {
