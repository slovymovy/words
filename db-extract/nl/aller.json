                            "prefix"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3b6e1536-3529-3f65-be5f-c67eee3d09aa",
                        "entry_id": "08cdd788-5724-3eae-a677-7ad3778e530b",
                        "glosses": [
                            "bij een bijvoeglijk naamwoord in de overtreffende trap",
                            "in hoogst mogelijke graad"
