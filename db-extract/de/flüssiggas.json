                            "singular"
                        ],
                        "form": "das Flüssiggas"
                    },
                    {
                        "form_id": "dd179f93-912a-46d6-aa0b-3c8048b36537",
                        "entry_id": "159f1cf3-ab54-361f-86fc-4263cb2fc483",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Flüssiggase"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                        "entry_id": "159f1cf3-ab54-361f-86fc-4263cb2fc483",
                        "glosses": [
                            "durch Kühlung und/oder mit Druck verflüssigtes Gas; Flüssigerdgas"
                        ],
                        "tags": [
                            "oft synonym verwendet für"
                        ],
                        "examples": [
                            {
                                "example_id": "431b78aa-fec5-4b91-abd5-624f2caf93ce",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "Flüssiggas wird oft in Druckbehältern transportiert."
                            },
                            {
                                "example_id": "3bf1bdaa-4d83-47d4-b85c-f28495643824",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Der Anstieg des Exports von Flüssiggas verunsichert Anwohner und Naturschützer an der Golfküste, da die Region ohnehin von den Folgen des Klimawandels geplagt ist.“"
                            },
                            {
                                "example_id": "5d423bc2-bde4-4943-a816-e176a364bc4c",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Bereits 2008 wurde ein erstes Terminal für Flüssiggas in Betrieb genommen, zwei Jahre später ein zweites.“"
                            },
                            {
                                "example_id": "ce227d16-70b6-4236-9229-81eeacc19f7c",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Die Terminals, die für den Export von Flüssiggas bereits existieren oder geplant sind, wird es auf Jahrzehnte hinaus geben.“"
                            },
                            {
                                "example_id": "e302442c-8d90-4cd6-a60e-149a9d8995c2",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Die nötigen Arbeiten laufen, unter anderem ist ein schwimmendes Terminal für Flüssiggas (LNG) im Bau.“"
                            },
                            {
                                "example_id": "1577ee2e-250f-4cb1-867d-fce9db52ab64",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Deutschland soll ein fünftes staatlich gemietetes Terminal zur Anlandung von Flüssiggas (LNG - Liquefied Natural Gas) bekommen.“"
                            },
                            {
                                "example_id": "061b9646-dc32-4411-bb2c-aa8e1ce607fb",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Trudeau sagte, man werde den Export von Flüssiggas (LNG) über den Atlantik prüfen.“"
                            },
                            {
                                "example_id": "a832218f-ece7-4e0b-a4b5-84b6a1872611",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Um schneller von russischem Erdgas unabhängig zu werden, treibt die Bundesregierung den Import von Flüssiggas aus anderen Ländern voran.“"
                            },
                            {
                                "example_id": "3e238746-700d-44ae-a714-be46f5a5375c",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Kurzer Rückblick: 2010 exportierten die USA 1,5 Milliarden Kubikmeter Flüssiggas. 2020 – zehn Jahre später – waren es 61,4 Milliarden Kubikmeter. Exporte nach Europa sind zuletzt sprunghaft angestiegen.“"
                            },
                            {
                                "example_id": "a00a765d-bd13-4162-b1df-7dc4fc0a199b",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Mitte Juli meldete die amerikanische Energiebehörde, dass die Vereinigten Staaten im ersten Halbjahr 2022 zum weltweit größten Exporteur von Flüssiggas (LNG) aufgestiegen sind.“"
                            },
                            {
                                "example_id": "cbe40f79-ab6c-41ca-90df-9d589f04cba4",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Der deutsche Energieversorger EnBW will ab 2026 jährlich 1,5 Millionen Tonnen Flüssiggas (LNG) aus den USA beziehen.“"
                            },
                            {
                                "example_id": "26bf0c2c-a8b3-42ce-a2a8-1675c1e09dab",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Auch eine Begrenzung des Preises von Flüssiggas (LNG), das aus den USA oder dem Nahen Osten angeliefert wird, schloss von der Leyen nicht aus.“"
                            },
                            {
                                "example_id": "74b26eb3-7631-4f04-86c5-ff788c862e67",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Pipeline-Gas hat mehrere Vorteile: Es ist leicht in großen Mengen zu transportieren sowie deutlich umweltfreundlicher und billiger als Flüssiggas, das aufwändig komprimiert und per Tankschiff über die Ozeane transportiert werden muss.“"
                            },
                            {
                                "example_id": "6cb10213-48ec-4885-b488-403ab7ba820c",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Die geplanten See-Terminals zur Einspeisung von Flüssiggas aus Tankschiffen in das deutsche Leitungsnetz sorgt zunehmend für Streit zwischen Regierungsparteien in Bund und Ländern sowie Organisationen der Umweltbewegung.“"
                            },
                            {
                                "example_id": "e02511b4-7fca-475a-a064-5af7e621f953",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„Bereits 2019 veröffentlichte die Nichtregierungsorganisation Global Energy Monitor einen Bericht, der vor den Gefahren“ […] „bei der Förderung und dem Transport von Flüssiggas warnte.“"
                            },
                            {
                                "example_id": "da8d7cb7-4d57-460a-866d-de1ce6156c12",
                                "sense_id": "fefb5dc4-cd51-3b69-9bb0-8a8bd99cd5ba",
                                "text": "„»Flüssiggas aus den USA ist nicht die Lösung«, sagt John Allaire, Ex-Ingenieur bei den Ölkonzernen BP und Amoco.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
