                        "source_entry_id": "2d01d92e-2590-372c-80f1-d7e2c5088bfb",
                        "target_lang_word": "主战论",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4dbd3c66-9673-47f6-93e8-28a351a1ff65",
                        "source_entry_id": "2d01d92e-2590-372c-80f1-d7e2c5088bfb",
                        "target_lang_word": "Hurrapatriotismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hurrapatriotismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c7c6a5f-97c1-32c2-8eb0-d6a38d91ddbd",
                                        "entry_id": "3f5b4d6c-cfbc-390a-b744-353af5bd8cbb",
                                        "glosses": [
                                            "übertriebener Patriotismus, besonders in Zusammenhang mit Krieg"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c3ce556-e75d-4196-a895-e3d1b8c9b454",
                                                "sense_id": "7c7c6a5f-97c1-32c2-8eb0-d6a38d91ddbd",
                                                "text": "Es herrschte kein Hurrapatriotismus, aber doch ein wenig Stolz über die nationale Leistung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf03619a-8cb7-40b9-ba4e-8523b4678260",
                        "source_entry_id": "2d01d92e-2590-372c-80f1-d7e2c5088bfb",
                        "target_lang_word": "Jingoismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jingoismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71078816-018b-3831-a0ef-d10365bb2b2a",
                                        "entry_id": "9c968464-5ff4-3b17-a794-dc88ee2634b9",
                                        "glosses": [
                                            "übersteigerter englischer Patriotismus und Nationalismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c7ccd33-eb98-4628-ac8b-c64ee95f9f81",
                                                "sense_id": "71078816-018b-3831-a0ef-d10365bb2b2a",
                                                "text": "„Der innenpolitische Nutzen von Jingoismus und Imperialismus lag darin, daß sie zeitweilig von ungelösten inneren Problemen ablenken konnten […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90ba0783-341b-4957-97b5-144782074c66",
                        "source_entry_id": "2d01d92e-2590-372c-80f1-d7e2c5088bfb",
