    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38742777-4eee-38b2-aa00-23befb9953a3",
                    "sense_definition": "The process of converting information or data into a code, especially to prevent unauthorized access.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The website uses strong <w>encryption</w> to protect your credit card details during the transaction.",
                            "target_lang_translations": {
                                "ru": "Сайт использует надежное <w>шифрование</w> для защиты данных вашей кредитной карты во время транзакции."
                            }
                        },
                        {
                            "text": "Without the correct password, the data <w>encryption</w> makes the files completely unreadable to hackers.",
                            "target_lang_translations": {
                                "ru": "Без правильного пароля <w>шифрование</w> данных делает файлы совершенно нечитаемыми для хакеров."
                            }
                        }
                    ],
                    "synonyms": [
                        "encoding",
                        "encipherment"
                    ],
                    "antonyms": [
                        "decryption",
                        "decipherment"
                    ],
                    "common_phrases": [
                        "data encryption",
                        "end-to-end encryption",
                        "encryption key",
                        "strong encryption"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс преобразования информации или данных в код, особенно для предотвращения несанкционированного доступа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шифрование",
                                "target_lang_sense_clarification": "процесс защиты данных"
                            },
                            {
                                "target_lang_word": "кодирование",
                                "target_lang_sense_clarification": "преобразование в код"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88e928eb-1a01-39da-855d-2049b2b94290",
                    "sense_definition": "A specific piece of data that has been hidden or converted into a ciphertext.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cryptography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system must verify if this string is an <w>encryption</w> of the original password.",
                            "target_lang_translations": {
                                "ru": "Система должна проверить, является ли эта строка <w>шифровкой</w> исходного пароля."
                            }
                        },
                        {
                            "text": "Each <w>encryption</w> of the message looks different even if the content remains the same.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>шифровка</w> сообщения выглядит по-разному, даже если содержание остается прежним."
                            }
                        }
                    ],
                    "synonyms": [
                        "ciphertext",
                        "cryptogram"
                    ],
                    "common_phrases": [
                        "encryption of zero",
                        "valid encryption"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный фрагмент данных, который был скрыт или преобразован в зашифрованный текст."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шифровка",
                                "target_lang_sense_clarification": "зашифрованное сообщение или результат"
                            },
                            {
                                "target_lang_word": "криптограмма",
                                "target_lang_sense_clarification": "зашифрованный текст"
                            }
                        ]
                    }
                }
            ]
        }
    ]
