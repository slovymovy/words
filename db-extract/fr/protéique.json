                        "entry_id": "b7a831d0-898f-3c58-8935-3f85c030c9f3",
                        "glosses": [
                            "Qui change fréquemment de forme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "734100bd-25ea-4426-80ef-1a70abdf4b52",
                                "sense_id": "fdd0fb44-7f8b-39de-826d-4c506f8afcca",
                                "text": "On n’oubliera pas de mentionner Michel Butor qui est sans doute l’architecte le plus protéique de la littérature d’aujourd'hui."
                            },
                            {
                                "example_id": "c5bbce24-3407-4121-9af1-b5c53bc81409",
                                "sense_id": "fdd0fb44-7f8b-39de-826d-4c506f8afcca",
                                "text": "Nous assistons à la formation d’un tabou, à la cristallisation déplorable de ce qu’il peut y avoir de plus mouvant et de plus protéique dans l’essence de la revendication humaine"
                            }
                        ]
                    }
                ],
