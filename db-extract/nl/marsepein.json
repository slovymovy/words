                    },
                    {
                        "translation_id": "5931718e-c318-4548-9f76-51d95e87e5d0",
                        "source_entry_id": "d26403fe-afc3-3e27-a54b-3db979ac3c15",
                        "source_sense_id": "adcb5731-b159-3f0d-9a9e-eb03dfc11b3b",
