        "nl-extract.jsonl": [
            {
                "entry_id": "f0c73fe0-7510-3d33-832c-8ed15dadcd30",
                "word": "innaaien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c6d8cf2-d5a0-366b-8fc2-01f84dc19eac",
                        "entry_id": "f0c73fe0-7510-3d33-832c-8ed15dadcd30",
                        "glosses": [
                            "met een draad in iets vastmaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3474ed-9175-493b-a586-b80f389b0771",
                                "sense_id": "3c6d8cf2-d5a0-366b-8fc2-01f84dc19eac",
                                "text": "Om een herinnering te hebben aan hun tocht naar een bedevaartsoord, gingen pelgrims vanaf 1450 insignes innaaien of -plakken in hun gebedenboeken. Hanneke van Asperen schreef er een proefschrift over, waarop zij vrijdag promoveerde in Nijmegen."
                            },
                            {
                                "example_id": "960169df-f1cc-4405-bec0-6c632be805c3",
                                "sense_id": "3c6d8cf2-d5a0-366b-8fc2-01f84dc19eac",
                                "text": "Hóé een pochet gedragen wordt, is aan de klant. Zeker de ervaren pochetdrager kiest daarvoor een van de vele modellen. Bij de trouwkostuums doet de verkoper vaak voor hoe de pochet in het zakje gestoken kan worden. „Vaak vindt een aanstaande bruidegom het fijn wanneer we de pochet er vast innaaien, zodat hij op de ochtend van de trouwdag niet voor een vouwprobleem komt te staan.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "30e1b9c1-98bd-37ff-9845-12b9df51b426",
                        "entry_id": "f0c73fe0-7510-3d33-832c-8ed15dadcd30",
                        "glosses": [
                            "bundels papier met een draad aan elkaar vastmaken"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1a040ba-1745-4f5d-911d-95c39ab68439",
                        "source_entry_id": "f0c73fe0-7510-3d33-832c-8ed15dadcd30",
                        "source_sense_id": "3c6d8cf2-d5a0-366b-8fc2-01f84dc19eac",
                        "target_lang_word": "sew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94b98dc1-8a6f-349d-8dd9-4420042bf627",
                                        "entry_id": "a898fae4-886b-3ba0-91fd-1c3963a4ba3b",
                                        "glosses": [
                                            "To use a needle to pass thread repeatedly through (pieces of fabric) in order to join them together."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8d141f8-c7a1-439f-b752-94ba3afc23c6",
                                                "sense_id": "94b98dc1-8a6f-349d-8dd9-4420042bf627",
                                                "text": "Balls were first made of grass or leaves held together by strings, and later of pieces of animal skin sewn together and stuffed with feathers or hay."
                                            },
                                            {
                                                "example_id": "3fcd6656-1242-45e7-aeff-0dedc306d40d",
                                                "sense_id": "94b98dc1-8a6f-349d-8dd9-4420042bf627",
                                                "text": "She [Kate Spade] took the label, which originally had been on the inside of the bag, and sewed it to the outside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a589e70b-acf9-3aca-a0ee-a8a150959596",
                                        "entry_id": "a898fae4-886b-3ba0-91fd-1c3963a4ba3b",
                                        "glosses": [
                                            "To use a needle to pass thread repeatedly through pieces of fabric in order to join them together."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b60c876c-9df7-30e0-92df-d1f0efcda169",
                                        "entry_id": "a898fae4-886b-3ba0-91fd-1c3963a4ba3b",
                                        "glosses": [
                                            "Followed by into: to enclose by sewing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3232fb0c-d4c2-44d2-9afa-6aefac3a82cc",
                                                "sense_id": "b60c876c-9df7-30e0-92df-d1f0efcda169",
                                                "text": "to sew money into a bag"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6d3516d-fba1-3cc6-94dd-caaaa01e00b5",
                                        "entry_id": "c23d1f50-5729-3300-bc33-ecae0f787b8c",
                                        "glosses": [
                                            "To drain the water from."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06b50a01-ef67-4a88-aa9d-9fc5fb8cae5a",
                                                "sense_id": "a6d3516d-fba1-3cc6-94dd-caaaa01e00b5",
                                                "text": "Now geld with the gelder the ram and the bul, / sew ponds, amend dammes, and sel webster thy wul"
                                            },
                                            {
                                                "example_id": "8a405c19-0b08-46e7-88e0-4ed60fcd1e64",
                                                "sense_id": "a6d3516d-fba1-3cc6-94dd-caaaa01e00b5",
                                                "text": "[…] accommodated a sluce to clense and sew the Pond, with a grate of wood to let out the wast, as in other stews and Vivaries."
                                            },
                                            {
                                                "example_id": "1d2ab0a9-fcb6-47e2-87fd-48bc833ee956",
                                                "sense_id": "a6d3516d-fba1-3cc6-94dd-caaaa01e00b5",
                                                "text": "If the Bank of a Pond sews, it will preserve the Fish in Frost; the Reason, as I imagine, is, because where the Water sews out, the Air will bubble in, which relieves the Fish; or perhaps it might put the Water into some Degree of Motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "018e0a33-0a98-3780-8469-24bfe6245288",
                                        "entry_id": "c23d1f50-5729-3300-bc33-ecae0f787b8c",
                                        "glosses": [
                                            "Of a ship, to be grounded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945fd896-5279-4523-ae4b-b4986c078892",
                                                "sense_id": "018e0a33-0a98-3780-8469-24bfe6245288",
                                                "text": "The upward reaction of the keel blocks may be considered as a negative weight in a moment calculation, producing a decrease in the ship's stability, and it is most important that the vessel remains stable until she takes the blocks along the full length of her keel, i.e. when she is sewed, for until this moment the side shores cannot be successfully rigged."
                                            },
                                            {
                                                "example_id": "bb614627-8512-43c8-8639-87d844286a2c",
                                                "sense_id": "018e0a33-0a98-3780-8469-24bfe6245288",
                                                "text": "A ship resting upon the ground, where the water has fallen, so as to afford no hope of floating until lightened, or the return tide floats her, is said to be sewed, by as much as the difference between the surface of the water, and the ship's floating-mark."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "03d1cd12-5f88-3450-af09-ef76117792ec",
                                        "entry_id": "a02dd8cf-5b68-3376-84a8-1d8b8d47c3c8",
                                        "glosses": [
                                            "Broth, gravy."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94646dc9-6bc9-4e6b-8623-7fa9a69bf434",
                                                "sense_id": "03d1cd12-5f88-3450-af09-ef76117792ec",
                                                "text": "And than as for other Potages, ſtued Trypys, yt is dight redy. And than for to make the Numbleis in ſewe[…]"
                                            },
                                            {
                                                "example_id": "ecac36f6-ff7d-4e5f-8fd4-ecc16c39a66b",
                                                "sense_id": "03d1cd12-5f88-3450-af09-ef76117792ec",
                                                "text": "At Ewle we wonten gambole, daunce, to carrole, and to ſing, To haue gud ſpiced Sewe, and Roſte, and plum-pies for a King[…]"
                                            },
                                            {
                                                "example_id": "d9277cd2-0570-4309-a667-1fd6d1e3760e",
                                                "sense_id": "03d1cd12-5f88-3450-af09-ef76117792ec",
                                                "text": "If a thicke grewell or ſew be made thereof, together with floure, oile, and vinegre, ſo tempered as it may be ſupped[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
