                    {
                        "translation_id": "c71c2dfc-8150-4fbb-a0ab-3ddfb7ae200c",
                        "source_entry_id": "9d1010f0-3484-38a5-a23f-f1d3d400941e",
                        "source_sense_id": "d351d63d-45b9-319d-9e54-9cbeadef5d75",
                        "target_lang_word": "Beschränkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschränkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d331880a-680d-3673-b034-bc37907053c3",
                                        "entry_id": "74347cab-9b76-3659-9e70-88c08bc1e12e",
                                        "glosses": [
                                            "Verfahren, in dem man die Grenzen von etwas noch strenger macht und man deshalb weniger Freiheit erlaubt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee7209b9-3251-48c2-9e8e-69a0d2b89794",
                                                "sense_id": "d331880a-680d-3673-b034-bc37907053c3",
                                                "text": "„Die Beschränkung auf haushaltsnahe Jobs wird dazu führen, dass diese Maßnahme nicht wirklich greifen wird“. (Quelle: Die Welt Online)"
                                            },
                                            {
                                                "example_id": "14ef2438-b5d0-4d55-93cc-e5e50fd770a3",
                                                "sense_id": "d331880a-680d-3673-b034-bc37907053c3",
                                                "text": "„Die bei analogen Telefonanschlüssen übliche Beschränkung der nutzbaren Bandbreite wird mit der DSL-Technik aufgehoben“. (Quelle: Der Spiegel ONLINE)"
                                            },
                                            {
                                                "example_id": "167f3783-7476-421b-8cea-ab02c587d442",
                                                "sense_id": "d331880a-680d-3673-b034-bc37907053c3",
                                                "text": "„[Diskussion ums Tempolimit:] Eigentlich gibt es keinen rationalen Grund dafür, dass Rasen ohne Beschränkung erlaubt ist.“"
                                            },
                                            {
                                                "example_id": "52f3a391-2118-4841-8d0f-3ead8bc1b87f",
                                                "sense_id": "d331880a-680d-3673-b034-bc37907053c3",
                                                "text": "„Neben Beschränkungen der Sportarten selbst beispielweise war das im Westen, aber auch in Polen und der Tschechoslowakei sehr populäre Drachenfliegen in der DDR verboten, wurden manche der stadtnahen Flugplätze wie Saarmund und Eggersdorf willkürlich wegen Fluchtgefahr geschlossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63a151db-b232-327a-af5d-a2237c3955c6",
                                        "entry_id": "74347cab-9b76-3659-9e70-88c08bc1e12e",
                                        "glosses": [
                                            "etwas Beschränkendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a56ce2-6237-4fd2-a7ec-f4404a56a5f1",
                                                "sense_id": "63a151db-b232-327a-af5d-a2237c3955c6",
                                                "text": "„Das Web kann das heute nicht bieten, was mit seiner Beschränkung auf den Sehsinn zu tun hat“. (Quelle: Die Zeit 1997)"
                                            },
                                            {
                                                "example_id": "0573d887-854d-41a5-a41a-68830da1f965",
                                                "sense_id": "63a151db-b232-327a-af5d-a2237c3955c6",
                                                "text": "„Der technischen Beschränkung durch immer noch zu dünne Datenleitungen begegnet die \"Websoap\" pragmatisch“. (Quelle: Die Zeit 2001)"
                                            },
                                            {
                                                "example_id": "748b4b38-13e0-4b89-8bba-e94f5c205c29",
                                                "sense_id": "63a151db-b232-327a-af5d-a2237c3955c6",
                                                "text": "„Das Instrument ist ihm Software und Hardware zugleich, Interpret und Komponist, Inspiration und Beschränkung“. (Quelle: Die Zeit 2002)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fecd6632-ade6-3100-bd42-5dca1097a7f5",
                                        "entry_id": "74347cab-9b76-3659-9e70-88c08bc1e12e",
                                        "glosses": [
                                            "Situation mit eingeschränkten Möglichkeiten oder Mitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3694cfce-c178-43f9-859d-56162be9fdf2",
                                                "sense_id": "fecd6632-ade6-3100-bd42-5dca1097a7f5",
                                                "text": "„In der Beschränkung zeigt sich erst der Meister.“ (Goethe, Sonett in „Was wir bringen“)"
                                            },
                                            {
                                                "example_id": "ce27b4fe-2f12-47d0-a3a7-b623642f9867",
                                                "sense_id": "fecd6632-ade6-3100-bd42-5dca1097a7f5",
                                                "text": "„An der Ostküste sind die Beschränkungen für die Exilanten kaum bemerkbar, und er hofft dort Abstand und Ruhe zu gewinnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
