    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1fa1976a-a9c4-3cb9-8e50-f8105cd67724",
                    "sense_definition": "Characterized by self-control, moderation, or lack of excess; held back or kept under control.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to give a very <w>restrained</w> response despite his growing frustration.",
                            "target_lang_translations": {
                                "nl": "Hij slaagde erin een zeer <w>beheerste</w> reactie te geven ondanks zijn toenemende frustratie."
                            }
                        },
                        {
                            "text": "The room was decorated in an elegant and <w>restrained</w> style.",
                            "target_lang_translations": {
                                "nl": "De kamer was ingericht in een elegante en <w>ingetogen</w> stijl."
                            }
                        }
                    ],
                    "synonyms": [
                        "low-key",
                        "understated"
                    ],
                    "antonyms": [
                        "unrestrained"
                    ],
                    "common_phrases": [
                        "restrained manner",
                        "restrained tone",
                        "restrained elegance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Gekenmerkt door zelfbeheersing, matiging of soberheid; ingetogen of onder controle gehouden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beheerst",
                                "target_lang_sense_clarification": "met zelfbeheersing, kalm"
                            },
                            {
                                "target_lang_word": "ingetogen",
                                "target_lang_sense_clarification": "sober, bescheiden of rustig van stijl"
                            },
                            {
                                "target_lang_word": "terughoudend",
                                "target_lang_sense_clarification": "aarzelend, niet overdreven"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f8818de-55c4-308a-8c9f-8f8bfdea71a8",
                    "sense_definition": "Proscribed, forbidden, or strictly limited.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The court ruled that the suspect had used <w>restrained</w> methods forbidden by law.",
                            "target_lang_translations": {
                                "nl": "De rechtbank oordeelde dat de verdachte <w>verboden</w> methoden had gebruikt die bij wet niet waren toegestaan."
                            }
                        },
                        {
                            "text": "They were punished for attempting to trade in <w>restrained</w> goods.",
                            "target_lang_translations": {
                                "nl": "Ze werden gestraft voor het proberen handelen in <w>verboden</w> goederen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verboden, ontzegd of strikt aan banden gelegd."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verboden",
                                "target_lang_sense_clarification": "niet toegestaan"
                            },
                            {
                                "target_lang_word": "aan banden gelegd",
                                "target_lang_sense_clarification": "strikt beperkt"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "601bf7bc-6221-3bcd-b136-7321a801882e",
                    "sense_definition": "Simple past and past participle of <w>restrain</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Security guards <w>restrained</w> the angry protester before he reached the stage.",
                            "target_lang_translations": {
                                "nl": "Beveiligers <w>hielden</w> de boze demonstrant <w>tegen</w> voordat hij het podium bereikte."
                            }
                        },
                        {
                            "text": "She <w>restrained</w> herself from saying something she might later regret.",
                            "target_lang_translations": {
                                "nl": "Ze <w>weerhield</w> zichzelf ervan iets te zeggen waar ze later spijt van zou kunnen krijgen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd of voltooid deelwoord van tegenhouden, in bedwang houden of weerhouden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "hield tegen",
                                "target_lang_sense_clarification": "verleden tijd van tegenhouden"
                            },
                            {
                                "target_lang_word": "weerhield",
                                "target_lang_sense_clarification": "verleden tijd van weerhouden"
                            },
                            {
                                "target_lang_word": "bedwong",
                                "target_lang_sense_clarification": "verleden tijd van bedwingen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}