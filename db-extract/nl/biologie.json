                "senses": [
                    {
                        "sense_id": "20480204-18a5-3f09-849d-215b9823eeb1",
                        "entry_id": "c67a796c-9d2c-3f0e-9f45-f659627f85b0",
                        "glosses": [
                            "de wetenschap van de levende wezens, levensvormen en levensverschijnselen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921f907e-b328-443f-972b-93d351735ace",
                                "sense_id": "20480204-18a5-3f09-849d-215b9823eeb1",
                                "text": "De Fransman Louis Pasteur - de vader van de biologie van de micro-organismen, en geboren in 1822 - voorspelde het al: „Het zijn de microben die het laatste woord zullen hebben.”."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8ca839a-52f4-3b73-854a-ff8078e81b4b",
                        "entry_id": "c67a796c-9d2c-3f0e-9f45-f659627f85b0",
                        "glosses": [
                            "schoolvak dat gaat over de levende natuur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f3af08f-ebe1-451e-a21e-b65316529a50",
                                "sense_id": "f8ca839a-52f4-3b73-854a-ff8078e81b4b",
                                "text": "Op de middelbare school krijgen alle leerlingen biologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "310ae242-fd98-4c4d-8b92-bc57e7803799",
                        "source_entry_id": "c67a796c-9d2c-3f0e-9f45-f659627f85b0",
                        "source_sense_id": "20480204-18a5-3f09-849d-215b9823eeb1",
                        "source_sense_description": "wetenschap van de levende wezens, levensvormen en levensverschijnselen",
                        "target_lang_word": "Biologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb899bc1-d6de-3914-822e-4cc2c7b6821f",
                                        "entry_id": "46d6a181-c6bd-3ae2-a48d-0c032fb1bdf3",
                                        "glosses": [
                                            "die Lehre beziehungsweise Naturwissenschaft vom Leben, allgemein von allem Lebendigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4825fdd-5a5e-43f6-b6ec-8c570f23822f",
                                                "sense_id": "eb899bc1-d6de-3914-822e-4cc2c7b6821f",
                                                "text": "Petra studiert Biologie."
                                            },
                                            {
                                                "example_id": "d99891f0-9a8a-4682-8239-9562eb2953d3",
                                                "sense_id": "eb899bc1-d6de-3914-822e-4cc2c7b6821f",
                                                "text": "„Die Entstehung distinktiver Merkmale von Phonemen verläuft unter sprachvergleichendem Aspekt innerhalb bestimmter, wohl durch die Biologie des Menschen gesetzter Grenzen wieder arbiträr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbc74bfc-0f25-3888-8046-49b0d4d100b7",
                                        "entry_id": "46d6a181-c6bd-3ae2-a48d-0c032fb1bdf3",
                                        "glosses": [
                                            "ein Unterrichtsfach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963e0772-53ec-4430-9a50-cac57c67005f",
                                                "sense_id": "bbc74bfc-0f25-3888-8046-49b0d4d100b7",
                                                "text": "In der 5. Stunde haben wir Biologie."
                                            },
                                            {
                                                "example_id": "d127993b-3d74-4ed3-828c-dcef24a1abf2",
                                                "sense_id": "bbc74bfc-0f25-3888-8046-49b0d4d100b7",
                                                "text": "„Der Sohn meines Fahrers hatte eine zusätzliche Bitte: ob ich ihm bei der Einschreibung für Abendkurse in Biologie und Naturgeschichte behilflich sein könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd852edd-9e83-45a5-8ac8-de4282c35fc3",
                        "source_entry_id": "c67a796c-9d2c-3f0e-9f45-f659627f85b0",
                        "source_sense_id": "20480204-18a5-3f09-849d-215b9823eeb1",
                        "source_sense_description": "wetenschap van de levende wezens, levensvormen en levensverschijnselen",
                        "target_lang_word": "biology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49dde52f-e0fe-3810-9f0d-e4ce42ec61f0",
                                        "entry_id": "75e6ef95-02c8-3c9d-aea1-76b5ac6777ea",
                                        "glosses": [
                                            "The study of all life or living matter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8c84acd-25c6-4ff2-8ded-d69cee9ba543",
                                                "sense_id": "49dde52f-e0fe-3810-9f0d-e4ce42ec61f0",
                                                "text": "As in much of biology, the most satisfying truths in ecology derive from manipulative experimentation. Tinker with nature and quantify how it responds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac10d663-c40f-3f50-8111-b6f49b29b80b",
                                        "entry_id": "75e6ef95-02c8-3c9d-aea1-76b5ac6777ea",
                                        "glosses": [
                                            "The living organisms of a particular region."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263bb5d8-c53b-4240-86d8-461ed387edb4",
                                                "sense_id": "ac10d663-c40f-3f50-8111-b6f49b29b80b",
                                                "text": "The object of these prizes is to stimulate and encourage original investigation by the aid of the microscope in the biology of North America, and, while the competition is open to all, it is especially commended to advanced students in biology in such of our universities and colleges as furnish opportunity for suitable work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "383bcc1b-931b-3355-a27e-8cd081cc78bd",
                                        "entry_id": "75e6ef95-02c8-3c9d-aea1-76b5ac6777ea",
                                        "glosses": [
                                            "The structure, function, and behavior of an organism or type of organism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09a4c25-4b2c-4fbb-a0e4-e10af4d6b2a2",
                                                "sense_id": "383bcc1b-931b-3355-a27e-8cd081cc78bd",
                                                "text": "the biology of the whale"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84197165-fc23-37c2-9b24-6cb31e3f24e2",
                                        "entry_id": "75e6ef95-02c8-3c9d-aea1-76b5ac6777ea",
                                        "glosses": [
                                            "A biographical history."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d646bb81-f0f8-40c4-a0f9-fe1ce30f77da",
                                                "sense_id": "84197165-fc23-37c2-9b24-6cb31e3f24e2",
                                                "text": "That a Town has a biology of its own has been, since Freeman and Green, a familiar idea to us. But it was not in England, with its old established central governments, that the idea was likely to arise; and we know what the local history of our old antiquaries was like."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
