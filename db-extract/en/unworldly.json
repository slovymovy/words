                "senses": [
                    {
                        "sense_id": "ace4a491-9319-3002-9a6d-9d703e50a186",
                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "glosses": [
                            "Exceeding what is typically found in the world; exceptional, transcendent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "glosses": [
                            "Characterising people who are unconcerned with worldly matters; spiritually minded."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7a0fcc6-bf98-4662-99ec-068894b46e59",
                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                "text": "‘But a good wife—a good unworldly woman—may really help a man, and keep him more independent.’"
                            },
                            {
                                "example_id": "a14859cd-ba13-4ad5-81ca-45cff2cfdee6",
                                "sense_id": "cf5f69ab-0727-3cef-b300-62a0c47a352f",
                                "text": "I am an aspiring theological writer-artist, Alien Christian Mystic, unworldly, contemplative."
                            }
                        ]
                    },
                    {
                        "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "glosses": [
                            "Not belonging to this world; celestial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f790261d-5ad8-4d2b-ae6c-3cb395dd55f1",
                                "sense_id": "4d9dc3a8-e609-3ae9-a937-2afd786d3e38",
                                "text": "This creature from a higher world has not forgotten all that he knew before; he retains his unworldly talents and supreme intelligence."
                            }
                        ]
                    },
                    {
                        "sense_id": "af1e4f53-6c3d-3698-9af8-14796ac47f1d",
                        "entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "glosses": [
                            "Lacking sophistication."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97351558-5b4a-4b5e-a3d5-64ca18b5f39a",
                        "source_entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "source_sense_description": "lacking sophistication",
                        "target_lang_word": "wereldvreemd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wereldvreemd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "39f2778f-28d5-32de-8ca4-a40ddb88c479",
                                        "entry_id": "72e667f0-30af-3bee-9875-a92e0c909535",
                                        "glosses": [
                                            "onbekend met het leven dat zich buiten de directe eigen levenssfeer afspeelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10a0b2d7-90cb-4637-b8a3-f43953e10732",
                                                "sense_id": "39f2778f-28d5-32de-8ca4-a40ddb88c479",
                                                "text": "Die wereldvreemde jongen komt niet van zijn kamer."
                                            },
                                            {
                                                "example_id": "cab82e69-c0cb-42aa-9162-350fe7ef3e49",
                                                "sense_id": "39f2778f-28d5-32de-8ca4-a40ddb88c479",
                                                "text": "Haar komische timing is waanzinnig, de kwetsbaarheid die ze eronder legt is zo mogelijk nog indrukwekkender. Haar koningin Anne is als de film zelf: verschrikkelijk grappig en oneindig tragisch. Wereldvreemd, en daarmee juist zo menselijk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38a5e5b9-e3f0-4cb2-b53d-c6feaa56e257",
                        "source_entry_id": "50ab1503-12c8-3221-9818-f86a057d2d2c",
                        "source_sense_description": "lacking sophistication",
                        "target_lang_word": "weltfremd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weltfremd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                        "entry_id": "6de3c9e3-b256-3fd0-b64d-e2537e219fd5",
                                        "glosses": [
                                            "abgewandt von der Wirklichkeit, wenig Kenntnis von den wirklichen Gegebenheiten habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "453b4e54-d436-4a72-9510-809e5d3b5d02",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "Wie gelähmt schaute die weltfremde Maurine in die Trommel der Waschmaschine."
                                            },
                                            {
                                                "example_id": "8f82e44e-b1f7-4638-b7ed-b4c53516b7f3",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "Als ich sagte: „Hol mal bitte den Laptop.“, schleppte der weltfremde Egon tatsächlich einen Topf aus der Küche herbei - er hatte „schlepp Topp“ verstanden."
                                            },
                                            {
                                                "example_id": "34a6cff7-f2d6-4a83-a4e9-a714800a283c",
                                                "sense_id": "8191ff7a-c403-3a1a-85b9-d7c7ee54d5c5",
                                                "text": "„Das war sicherlich eine Geste des Respekts für einen ihrer führenden Politiker, möglicherweise hegten sie Zweifel, ob der weltfremde Gelehrte sich überhaupt auf den Häuserbau verstand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
