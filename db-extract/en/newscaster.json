                                        "entry_id": "30b4a3d6-7b51-33e5-a185-cb53abf21f22",
                                        "glosses": [
                                            "Celui qui présente les invités d’une émission de télévision ou de radio et plus largement qui l’anime."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c4410fe-9569-4929-a57b-76bca1455e8a",
                                                "sense_id": "645cf1d2-b845-37e4-bc96-d75a0b6b18bc",
                                                "text": "Le présentateur nous incite fortement à aller les applaudir en précisant les dates de représentations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41c2648c-c68c-31e3-85b6-e0bf3f36d72e",
