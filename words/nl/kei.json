                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn broer is een <w>kei</w> in wiskunde en helpt me vaak.",
                            "target_lang_translations": {
                                "en": "My brother is an <w>ace</w> at math and helps me often.",
                                "ru": "Мой брат — <w>ас</w> в математике и часто мне помогает."
                            }
                        },
                        {
                            "text": "Zij is echt een <w>kei</w> in haar vakgebied.",
                            "target_lang_translations": {
                                "en": "She is truly a <w>star</w> in her field of expertise.",
                                "ru": "Она настоящая <w>звезда</w> в своей области."
