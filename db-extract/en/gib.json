            {
                "entry_id": "06459f91-9188-3a5f-b8df-9ce03e4fbeef",
                "word": "GIB",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "c9337de3-a887-4eb5-9ae3-2c13f3c9b075",
                        "entry_id": "06459f91-9188-3a5f-b8df-9ce03e4fbeef",
                        "tags": [
                            "plural"
                        ],
                        "form": "GIBs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3956b80a-efee-32aa-9660-c5d7b09a0d74",
                        "entry_id": "06459f91-9188-3a5f-b8df-9ce03e4fbeef",
                        "glosses": [
                            "Initialism of guy in back (someone who sits in the back of a jet)."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "041adc59-48bf-4428-bb24-ae4b0a44b636",
                                "sense_id": "3956b80a-efee-32aa-9660-c5d7b09a0d74",
                                "text": "You undoubtedly know that each F-4 Phantom jet carried two pilots in separate, tandem cockpits. Major Dennis Harper was the frontseater and was the AC or Aircraft Commander. Jim was the backseater or the GIB."
                            },
                            {
                                "example_id": "9d3fe525-1b5a-4ef2-b34c-b2e5ad20f9f8",
                                "sense_id": "3956b80a-efee-32aa-9660-c5d7b09a0d74",
                                "text": "When I originally checked out in the airplane, we got a few orientation rides in the backseat to familiarize us with the systems, but I was not very knowledgeable about all their intricacies. I came to have a much better appreciation of what the GIBs had to put up with in the back."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "3f5d0038-91a0-4c36-8743-5260c20ed9fa",
                        "source_entry_id": "06459f91-9188-3a5f-b8df-9ce03e4fbeef",
                        "source_sense_ids": [
                            "3956b80a-efee-32aa-9660-c5d7b09a0d74"
                        ],
                        "linkage_type": "synonyms",
                        "word": "backseater"
                    }
                ]
            },
