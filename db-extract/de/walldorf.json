                                "text": "Frau Walldorf ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "47485502-6554-4667-8187-57b2b7fb1a19",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Herr Walldorf wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "35928e36-9fa4-45dc-a997-ddaadd8762e7",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Die Walldorfs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "62e4263b-3d05-47bc-aff9-14384f5725c6",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Der Walldorf trägt nie die Schals, die die Walldorf ihm strickt."
                            },
                            {
                                "example_id": "f1074582-409f-4fbe-bde6-2a67154f3499",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Walldorf kommt, geht der Herr Walldorf.“"
                            },
                            {
                                "example_id": "02f4d41b-5463-4df9-8119-ba4a63259c43",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Walldorf kommt und geht."
                            },
                            {
                                "example_id": "45c7a271-1f35-4cb1-9d4c-fa698fc7afba",
                                "sense_id": "079f79c8-ba1c-396b-a398-b41d48560f72",
                                "text": "Walldorfs kamen, sahen und siegten."
                            }
                        ],
