                        "examples": [
                            {
                                "example_id": "34e7b902-f85f-4713-b59e-47a6350fc0f5",
                                "sense_id": "f327a422-5f25-3956-88bd-825331c7feaf",
                                "text": "Op Heemskerks conduitestaat prijken tien EK's kortebaan, zeven EK's langebaan, vier WK's kortebaan, acht WK's langebaan en vier Olympische Spelen. Daar behaalde ze in totaal 60 medailles."
                            },
                            {
                                "example_id": "54857248-c050-49bb-8ec7-04a43817b938",
                                "sense_id": "f327a422-5f25-3956-88bd-825331c7feaf",
                                "text": "Nu gaat hij naar Go Ahead Eagles, de nummer zeventien van de Jupiler League. Een stap terug zou je zeggen, maar Stegeman vindt dat niet. Hoe is het dan mogelijk dat de trainer die dat op zijn conduitestaat heeft staan, kiest voor de kelder van de Jupiler League? Het antwoord: romantiek, pure voetbalromantiek."
                            }
