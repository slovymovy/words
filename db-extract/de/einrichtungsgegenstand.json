                        "form": "die Einrichtungsgegenstände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                        "entry_id": "078d24a5-2842-39e0-9c10-964422581f37",
                        "glosses": [
                            "Möbelstück oder Gerät, das Teil der Raumausstattung ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b45cd8-2f9f-4b81-8c7c-44b966add09b",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "Das Sofa ist ein Einrichtungsgegenstand."
                            },
                            {
                                "example_id": "565a7fa2-42cf-4057-ad69-d96d8ee87cb6",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "Der Randalierer hat die Einrichtungsgegenstände beschädigt."
                            },
                            {
                                "example_id": "6c0f15f6-a3e6-4e1a-88a9-b78dc4e5e588",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "„Mieter verlangen von Nachmietern immer häufiger hohe Abstandssummen - für Küche, Möbel, Einrichtungsgegenstände.“"
                            },
                            {
                                "example_id": "8cba23c1-39c6-402c-87a5-42d881b21b6d",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "„Das Luxushotel Ritz in Paris versteigert Einrichtungsgegenstände aus fast 120 Jahren Hotelgeschichte.“"
                            },
                            {
                                "example_id": "dd216b89-8d83-4789-ba93-e0b57ec8fbae",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "„Jetzt war für ihn der Zeitpunkt gekommen, sich nicht mehr länger der Betrachtung meiner Einrichtungsgegenstände zu widmen, sondern mich direkt mit der Wucht einer Zeitungsschlagzeile zu konfrontieren.“"
                            },
                            {
                                "example_id": "f1f123e1-7466-437d-9221-0bed00aaf69a",
                                "sense_id": "46424381-05a0-3f98-9523-b9c3e67b2ac9",
                                "text": "„Émile Zola soll verhaftet werden, und darum trug Halldór sämtliche Möbel und Einrichtungsgegenstände aus dem alten Haus, bevor er es anzündete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
