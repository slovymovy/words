                "senses": [
                    {
                        "sense_id": "cc967eb0-6f53-39c4-994e-13dcd87cf9fa",
                        "entry_id": "16524723-5947-3168-b680-94f2fd120c00",
                        "glosses": [
                            "устар. позорящий, оскорбительный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5853f6e0-b97d-4834-b0e2-de5cee6d2b25",
                                "sense_id": "cc967eb0-6f53-39c4-994e-13dcd87cf9fa",
                                "text": "Человек, лишённый имения, чести, лишённый половины своея жизни, в самовольном изгнании, дабы избегнуть поносительного заточения."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81e25b35-ebca-4abb-883b-a0fc1bf5843d",
