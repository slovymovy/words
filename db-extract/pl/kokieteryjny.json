                "translations": [
                    {
                        "translation_id": "20b0bc38-aa9b-4d7a-bdfc-4507aac4d69e",
                        "source_entry_id": "b23c5544-baaf-3ea5-b867-29713def1873",
                        "source_sense_id": "ae6f0bbe-9380-3314-b506-47ee5a5e5872",
                        "target_lang_word": "coquettish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coquettish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8cd54a-dcec-34f9-9e09-b32a74bc5f62",
                                        "entry_id": "4d61ca0e-d6bd-3f27-9890-35cf322cb78b",
                                        "glosses": [
                                            "Of or relating to a young, flirtatious girl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70b84af6-d452-4757-91d0-a1a6ad56ce82",
                                                "sense_id": "ff8cd54a-dcec-34f9-9e09-b32a74bc5f62",
                                                "text": "When Prince Andrew arrived at the house that evening, Maxwell was more coquettish than usual."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d989ebe-a658-3e12-a849-4ddba7b85cfb",
                                        "entry_id": "4d61ca0e-d6bd-3f27-9890-35cf322cb78b",
                                        "glosses": [
                                            "Characteristic of a coquet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5e76ed5-03f4-4e0b-bc41-3ac1078e14da",
                                                "sense_id": "0d989ebe-a658-3e12-a849-4ddba7b85cfb",
                                                "text": "`Is there that about me that should affright a man? Then surely are men changed from what they used to be!' And with a little coquettish movement she turned herself, and held up one arm, so as to show all her loveliness and the rich hair of raven blackness that streamed in soft ripples down her snowy robes, almost to her sandalled feet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23750d96-e18c-4624-94ab-bdafac90c75e",
                        "source_entry_id": "b23c5544-baaf-3ea5-b867-29713def1873",
                        "source_sense_id": "ae6f0bbe-9380-3314-b506-47ee5a5e5872",
                        "target_lang_word": "coquet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9647c81-fbae-3d39-934f-66e2c6a44953",
                                        "entry_id": "2a0f054e-4d6c-38f4-81a7-875c19beae7c",
                                        "glosses": [
                                            "Qui use de coquetterie."
                                        ],
                                        "tags": [],
                                        "note": "Dans ce sens, il est surtout utilisé au féminin et il porte une connotation péjorative",
                                        "examples": [
                                            {
                                                "example_id": "d385dd55-5f4a-4cf0-abb6-0ee362e2f671",
                                                "sense_id": "c9647c81-fbae-3d39-934f-66e2c6a44953",
                                                "text": "[…] tu as été coquette à froid, et cette coquetterie-là, c’est l’amour de tête, le vice le plus affreux de la Française."
                                            },
                                            {
                                                "example_id": "4c7312bc-0ac2-4abc-8842-93ca9e0419eb",
                                                "sense_id": "c9647c81-fbae-3d39-934f-66e2c6a44953",
                                                "text": "Elle résolut alors de lutter avec sa rivale […] de feindre pour son mari un amour qu’elle ne pouvait plus éprouver […] d’être coquette avec lui comme le sont ces capricieuses maîtresses qui se font un plaisir de tourmenter leurs amants."
                                            },
                                            {
                                                "example_id": "d1186e88-2459-494d-a49e-b95084924212",
                                                "sense_id": "c9647c81-fbae-3d39-934f-66e2c6a44953",
                                                "text": "[…] un jeune homme que je connaissais à Évian s’est tué sous la fenêtre d’une de mes amies qui avait été coquette avec lui."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7901e49-0698-34d2-89c3-9b32b333d11a",
                                        "entry_id": "2a0f054e-4d6c-38f4-81a7-875c19beae7c",
                                        "glosses": [
                                            "Qui est recherché dans sa toilette."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1547fcf-546c-4a56-b90d-2fcb451b1bcd",
                                                "sense_id": "f7901e49-0698-34d2-89c3-9b32b333d11a",
                                                "text": "[…] et si je n’ai jamais vu de femme plus hideuse, jamais, jamais je ne vis de plus coquette personne. Une toilette, un bijou aperçu à travers des vitrines éblouissantes, la faisaient tomber en pâmoison."
                                            },
                                            {
                                                "example_id": "9fcc5b57-c51c-4b21-ab15-9d5be54fc71a",
                                                "sense_id": "f7901e49-0698-34d2-89c3-9b32b333d11a",
                                                "text": "Les femmes, très coquettes, revêtent en général le costume traditionnel ; la petite veste très serrée moulant le torse et les bras, passe dans la ceinture d’une culotte flottante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0aafc636-8275-35c0-86bf-821936f85cec",
                                        "entry_id": "2a0f054e-4d6c-38f4-81a7-875c19beae7c",
                                        "glosses": [
                                            "Qui a un aspect élégant, plaisant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87ef5db-b7f8-4b98-9b1b-c23574ec2388",
                                                "sense_id": "0aafc636-8275-35c0-86bf-821936f85cec",
                                                "text": "La hufa est une petite cape de laine noire, ronde, plate, piquée dans les cheveux avec des épingles, et laissant flotter sur l'épaule un long gland de soie noire étranglé dans un petit cylindre d'argent; rien de plus coquet que cette coiffure si simple."
                                            },
                                            {
                                                "example_id": "419ad482-2562-4809-aba2-b5d945c07a33",
                                                "sense_id": "0aafc636-8275-35c0-86bf-821936f85cec",
                                                "text": "Une de ces maisons était un coquet petit hôtel qui se dressait vers le milieu de la rue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f66c99d-730d-3107-bfcc-15a5046d02da",
                                        "entry_id": "2a0f054e-4d6c-38f4-81a7-875c19beae7c",
                                        "glosses": [
                                            "Assez élevée, en parlant d’une somme d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3724b1-253b-4efb-8dae-ba2d79164a90",
                                                "sense_id": "7f66c99d-730d-3107-bfcc-15a5046d02da",
                                                "text": "Une somme coquette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coquet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                        "entry_id": "d21a9096-a967-3363-8d77-c692ae50d711",
                                        "glosses": [
                                            "Personne qui use de coquetterie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8017e823-1c72-43e7-96d5-1d0bcc4ee3ba",
                                                "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                                "text": "Faire le coquet."
                                            },
                                            {
                                                "example_id": "260e9aa5-5c89-4afa-8faf-b8f4a568ef90",
                                                "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                                "text": "C’est une vraie coquette."
                                            },
                                            {
                                                "example_id": "e9d1fc67-552f-4575-a944-b2db7131036a",
                                                "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                                "text": "Le manège d’une coquette."
                                            },
                                            {
                                                "example_id": "8f4850a1-4984-44e0-81a6-185604870554",
                                                "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                                "text": "Une coquette fieffée."
                                            },
                                            {
                                                "example_id": "3b6b22e2-bcf6-49b9-8ff0-5eaecd09638a",
                                                "sense_id": "3f9327c7-8a75-37be-b068-a66421975728",
                                                "text": "Une vieille coquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6a53d5-c661-3d17-bacf-41ef7928be2d",
                                        "entry_id": "d21a9096-a967-3363-8d77-c692ae50d711",
                                        "glosses": [
                                            "Comédienne qui joue certains grands rôles de femme dans la comédie de caractère."
                                        ],
                                        "tags": [
