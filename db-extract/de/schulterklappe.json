                                    },
                                    {
                                        "sense_id": "6a2e4c79-d2ef-3986-ad18-62ddd8a9eefd",
                                        "entry_id": "49984b1c-44e6-334f-8091-18b60a9e0042",
                                        "glosses": [
                                            "The red patch on the shoulders of a red-winged blackbird."
                                        ],
