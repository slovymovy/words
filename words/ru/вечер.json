{
    "word_family": [
        "вечерний",
        "вечерок",
        "вечереть",
        "по-вечернему"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90d1c85d-3732-390c-85c8-302f1372ec65",
                    "sense_definition": "Часть суток, сменяющая день и предшествующая ночи.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этот зимний <w>вечер</w> на улице было очень холодно и темно.",
                            "target_lang_translations": {
                                "en": "It was very cold and dark outside on this winter <w>evening</w>.",
                                "zh": "在这个冬天的<w>晚上</w>，外面又冷又黑。"
                            }
                        },
                        {
                            "text": "Мы любим собираться всей семьёй и пить чай каждый <w>вечер</w>.",
                            "target_lang_translations": {
                                "en": "We love gathering with the whole family and drinking tea every <w>evening</w>.",
                                "zh": "我们喜欢全家人聚在一起，每天<w>晚上</w>喝茶。"
                            }
                        }
                    ],
                    "antonyms": [
                        "утро"
                    ],
                    "common_phrases": [
                        "добрый вечер",
                        "каждый вечер",
                        "под вечер",
                        "поздно вечером",
                        "к вечеру"
                    ],
                    "target_lang_definitions": {
                        "en": "The part of the day that follows the afternoon and precedes the night.",
                        "zh": "一天中从傍晚到深夜的时间段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evening",
                                "target_lang_sense_clarification": "time of day"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚上",
                                "target_lang_sense_clarification": "一天中日落后的时间段"
                            },
                            {
                                "target_lang_word": "黄昏",
                                "target_lang_sense_clarification": "日落时分，天色渐暗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a637b303-1ff3-30c7-a78b-2592872c928e",
                    "sense_definition": "Общественное собрание или встреча людей в вечернее время для отдыха, развлечения или празднования.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Школа организовала для учеников праздничный <w>вечер</w> с музыкой и танцами.",
                            "target_lang_translations": {
                                "en": "The school organized a festive <w>evening</w> for the students with music and dancing.",
                                "zh": "学校为学生们组织了一场有音乐和舞蹈的节日<w>晚会</w>。"
                            }
                        },
                        {
                            "text": "Известный поэт пригласил своих читателей на творческий <w>вечер</w> в библиотеке.",
                            "target_lang_translations": {
                                "en": "The famous poet invited his readers to a creative <w>evening</w> at the library.",
                                "zh": "这位著名诗人邀请读者参加在图书馆举办的文学<w>晚会</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "бал",
                        "раут"
                    ],
                    "common_phrases": [
                        "званый вечер",
                        "выпускной вечер",
                        "литературный вечер",
                        "творческий вечер"
                    ],
                    "target_lang_definitions": {
                        "en": "A social gathering or event held in the evening for entertainment or celebration.",
                        "zh": "在晚上举行的社交聚会或庆祝活动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evening",
                                "target_lang_sense_clarification": "social event"
                            },
                            {
                                "target_lang_word": "party",
                                "target_lang_sense_clarification": "celebration"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚会",
                                "target_lang_sense_clarification": "社交聚会或娱乐活动"
                            },
                            {
                                "target_lang_word": "聚会",
                                "target_lang_sense_clarification": "人们聚集在一起的活动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}