                ],
                "senses": [
                    {
                        "sense_id": "b2abb17f-129a-3ac6-b108-c44922d0ef93",
                        "entry_id": "f94dd59b-a570-3cc7-9d5b-a39f7455bb23",
                        "glosses": [
                            "книжн. подчинять (подчинить) регламенту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98a37496-7506-4128-a8d8-eed868068e2b",
                                "sense_id": "b2abb17f-129a-3ac6-b108-c44922d0ef93",
                                "text": "Но, разрешая изображать священное и сверхъестественное на иконах, церковь тем не менее строго регламентировала эти изображения, создавала каноны."
                            },
                            {
                                "example_id": "2e665288-c5b4-4e89-8ab6-8d40debb2b9b",
                                "sense_id": "b2abb17f-129a-3ac6-b108-c44922d0ef93",
                                "text": "Что же касается конкретной экономики, то энергетиков до сих пор достаточно жёстко контролируют и регламентируют, а это значит, им кое в чём продолжают сохранять условия для экономически неэффективной и безынициативной работы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef06e80a-ec81-4299-be4e-7922c487f6f7",
                        "source_entry_id": "f94dd59b-a570-3cc7-9d5b-a39f7455bb23",
                        "source_sense_id": "b2abb17f-129a-3ac6-b108-c44922d0ef93",
                        "target_lang_word": "reglementieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reglementieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                        "entry_id": "ac04ed07-6826-37ef-8211-50af66634333",
                                        "glosses": [
                                            "durch ein Reglement, durch Vorschriften regeln"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d37c040f-ac92-44ff-ad5d-a99267d1c696",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "Crowdfunding ist demgegenüber noch kaum reglementiert, obwohl der Gesetzgeber nun einige Reformen erwägt."
                                            },
                                            {
                                                "example_id": "69a64243-503b-4af6-ac27-7b15fd2d0a6d",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "Meine Kinder sind mit Computern aufgewachsen. Groß reglementiert haben wir das Medienverhalten zu Hause aber nicht."
                                            },
                                            {
                                                "example_id": "c0a10150-78e2-4db5-b908-b013b410250e",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "80 Gewerbe sind in Österreich reglementiert: Wer sie selbstständig ausüben möchte, muss eine Meisterprüfung oder einen vergleichbaren Befähigungsnachweis vorlegen."
                                            },
                                            {
                                                "example_id": "62f4510a-d76d-4361-92d1-87a9721c4195",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "Obwohl in „Fontana“ bis zur Rasenlänge alles genau reglementiert ist, fühlen sich die Bewohner wohl."
                                            },
                                            {
                                                "example_id": "b5f05650-475b-43d7-b892-8c23fc73903d",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "Am Sonntag singen alle das Hohelied der KMU-Wirtschaft – am Werktag hingegen wird legiferiert, reguliert und reglementiert."
                                            },
                                            {
                                                "example_id": "3b7321b3-198d-46a9-b983-c409fd079e40",
                                                "sense_id": "72578fe3-ca57-39aa-a715-a20bf8aecdca",
                                                "text": "Alles ist reglementiert und schubladisiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
