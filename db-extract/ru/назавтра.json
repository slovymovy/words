        "ru-extract.jsonl": [
            {
                "entry_id": "2c5b4f61-089b-3694-90ca-9f95b1543592",
                "word": "назавтра",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "33ba4ab0-8fd7-3d6c-8b11-639abe5cdfd8",
                        "entry_id": "2c5b4f61-089b-3694-90ca-9f95b1543592",
                        "glosses": [
                            "разг. на следующий (завтрашний) день"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ca9629-ea32-4303-9ed2-f78d19e2603f",
                                "sense_id": "33ba4ab0-8fd7-3d6c-8b11-639abe5cdfd8",
                                "text": "В клубе-то по субботам обед, ну, остатки, то да се, ночью все это к ротмистру сволокут, а назавтра у него полководец пищу принимает."
                            },
                            {
                                "example_id": "00b87ef0-9278-4838-a491-25544d34e42c",
                                "sense_id": "33ba4ab0-8fd7-3d6c-8b11-639abe5cdfd8",
                                "text": "Назавтра боли значительно уменьшились, температура опустилась, больная смотрела бодро и весело."
                            },
                            {
                                "example_id": "65799493-812b-4669-8fbc-baea4c74d273",
                                "sense_id": "33ba4ab0-8fd7-3d6c-8b11-639abe5cdfd8",
                                "text": "За ночь мы все хорошо отдохнули и назавтра продолжали наш путь вниз по реке Иоли."
                            }
                        ]
                    }
                ],
