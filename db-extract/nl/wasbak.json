                        "examples": [
                            {
                                "example_id": "75116197-01f2-44e1-b262-84a01e41a0fb",
                                "sense_id": "b04fac56-2eb4-33ec-adb3-d33a9b6d47b4",
                                "text": "Doe de afwas maar in de wasbak."
                            }
                        ]
