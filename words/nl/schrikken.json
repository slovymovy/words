                {
                    "sense_id": "cfc749a6-f65e-3287-bb41-cf2d9ddd2343",
                    "sense_definition": "iets dat gekookt is direct afkoelen met koud water om het kookproces te stoppen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "koken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het koken moet je de eieren direct <w>schrikken</w> onder de koude kraan.",
                            "target_lang_translations": {
                                "en": "After boiling, you must <w>shock</w> the eggs immediately under the cold tap.",
                                "ru": "После варки нужно сразу <w>обдать</w> яйца холодной водой из-под крана."
                            }
                        },
                        {
                            "text": "Vergeet niet de pasta te <w>schrikken</w> zodat deze niet te zacht wordt.",
                            "target_lang_translations": {
                                "en": "Don't forget to <w>refresh</w> the pasta so that it doesn't become too soft.",
                                "ru": "Не забудь <w>охладить</w> пасту холодной водой, чтобы она не размякла."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkoelen"
                    ],
                    "common_phrases": [
                        "eieren schrikken"
                    ],
                    "target_lang_definitions": {
                        "en": "to immediately cool something that has been boiled with cold water to stop the cooking process",
                        "ru": "сразу охладить что-то вареное холодной водой, чтобы остановить процесс приготовления"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to shock",
                                "target_lang_sense_clarification": "culinary term for plunging food into ice water"
                            },
                            {
                                "target_lang_word": "to refresh",
                                "target_lang_sense_clarification": "to cool cooked vegetables or eggs quickly"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "обдавать холодной водой",
                                "target_lang_sense_clarification": "кулинарный прием для резкого охлаждения"
                            },
                            {
                                "target_lang_word": "охлаждать",
                                "target_lang_sense_clarification": "быстро остужать после варки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6e76f3d-e466-3003-a53f-69e2acbf8208",
                    "sense_definition": "een plotselinge beweging naar achteren maken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het paard begon te <w>schrikken</w> en maakte een onverwachte beweging opzij.",
                            "target_lang_translations": {
                                "en": "The horse began to <w>shy</w> and made an unexpected movement to the side.",
                                "ru": "Лошадь начала <w>шарахаться</w> и сделала неожиданное движение в сторону."
                            }
                        },
                        {
                            "text": "Door de enorme druk van het water begon de dam gevaarlijk te <w>schrikken</w>.",
                            "target_lang_translations": {
                                "en": "Due to the enormous pressure of the water, the dam began to <w>recoil</w> dangerously.",
                                "ru": "Из-за огромного давления воды плотина начала опасно <w>содрогаться</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "terugwijken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a sudden movement backwards or sideways out of fear",
                        "ru": "сделать резкое движение назад или в сторону от испуга"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to shy",
                                "target_lang_sense_clarification": "specifically used for horses jumping aside in fear"
                            },
                            {
                                "target_lang_word": "to recoil",
                                "target_lang_sense_clarification": "to spring back in fear or horror"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "шарахаться",
                                "target_lang_sense_clarification": "резко прыгать в сторону (о лошадях или людях)"
                            },
                            {
                                "target_lang_word": "отпрянуть",
                                "target_lang_sense_clarification": "резко отодвинуться назад от испуга"
                            }
                        ]
                    }
                }
            ]
        },
