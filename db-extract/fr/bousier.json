                        "cross_references": [
                            {
                                "target_word": "mestkever",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "47650850-2bca-3883-80a8-e9c7e0e617b4",
                                        "entry_id": "22be6a8f-b2f2-3412-916e-0e841c931162",
                                        "glosses": [
                                            "een donkergekleurde kever uit een informele groep van kevers die mest eten als larve of imago, er zijn zo'n 5000 soorten. De in Nederland en België bekendere soorten komen uit de familie Geotrupidae. Er zijn ook enkele onderfamilies (Scarabaeinae en Aphodiinae) uit de familie bladsprietkevers (Scarabaeidae) die als mestkever of pillendraaier worden aangeduid"
                                        ],
