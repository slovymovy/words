                        "sense_id": "f56a99fe-2fed-3aa3-a87f-7c59001d788a",
                        "entry_id": "af865e95-7e4a-3131-8142-45e7e0076d63",
                        "glosses": [
                            "groep mensen waarbij iedereen vriend van elkaar is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51fc664-f80a-4f5d-b22b-8955a7c16a05",
                                "sense_id": "f56a99fe-2fed-3aa3-a87f-7c59001d788a",
                                "text": "Vanuit Schalkwijk en omliggende dorpen deden dit jaar meer dan 25 praalwagens mee aan de optocht, waaronder die van de vriendengroep uit het naburige Cothen. Langs de route stonden veel mensen om de wagens te bekijken."
                            },
                            {
                                "example_id": "1c8875ac-0486-4fe6-8eae-b780eb292aa3",
                                "sense_id": "f56a99fe-2fed-3aa3-a87f-7c59001d788a",
                                "text": "De mishandeling, in juli, volgde op een nachtelijke ruzie tussen K. en de vriendengroep van De Ruwe voor de deur van de Utrechtse grillroom."
                            },
                            {
                                "example_id": "9be61f39-40eb-47ca-812e-afe382ac74ee",
                                "sense_id": "f56a99fe-2fed-3aa3-a87f-7c59001d788a",
                                "text": "Daarna vertrok de vriendengroep naar het café aan de Nieuwe Binnenweg in Rotterdam."
                            }
                        ]
                    }
