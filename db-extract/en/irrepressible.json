                "senses": [
                    {
                        "sense_id": "97779874-ae8d-31b8-8ba4-2482b1bc78da",
                        "entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
                        "glosses": [
                            "Not containable or controllable."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "9e91ac31-6d74-4afa-a063-47aded7b761a",
                                "sense_id": "97779874-ae8d-31b8-8ba4-2482b1bc78da",
                                "text": "[...] here the two friends burst into a variety of giggles, and glanced from time to time, over the tops of their pocket-handkerchiefs, at Nicholas, who from a state of unmixed astonishment, gradually fell into one of irrepressible laughter [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                        "entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
                        "glosses": [
                            "Especially high-spirited, outspoken, or insistent."
                        ],
                        "tags": [
                            "not-comparable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ca25def1-45e9-4451-a1d9-9196b1482f69",
                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                "text": "It was Paris' irrepressible High Fashion Doyenne Gabrielle (\"Coco\") Chanel, 80, so-soing this and high-hatting that, while Women's Wear Daily took notes."
                            },
                            {
                                "example_id": "f9fbd47d-7a37-4e06-923f-b9b22761b534",
                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                "text": "The irrepressible landlady gave the freest expression to her feelings."
                            },
                            {
                                "example_id": "19fc47d2-04dd-4153-90f7-bdefe9e2983b",
                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                "text": "Schomberg, [...] an irrepressible retailer of all the scandalous gossip of the place, would, with both elbows on the table, impart an adorned version of the story to any guest who cared to imbibe knowledge along with the more costly liquors."
                            },
                            {
                                "example_id": "24403b57-264e-4dc1-abf7-c1579860b24c",
                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                "text": "\"The irrepressible Yank is knocking at the doors of their temples and he will want to sell 'em carpet-sweepers for their harems.\""
                            },
                            {
                                "example_id": "0a1a4419-3e01-4803-8f2e-d3d9f0757da4",
                                "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                                "text": "High-strung and irrepressible, George Jefferson quickly became one of America’s most popular television characters, a high-energy, combative black man who backed down to no one."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "714a3588-d8d0-4d96-beec-8510dfb0f3de",
                        "source_entry_id": "7e7d7271-1365-3c86-bece-0a000cad7fc6",
