                        "glosses": [
                            "являющийся собственностью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e40bee0-ecac-4d49-bf08-b03f9a703f30",
                                "sense_id": "29772aa6-6b4b-30a2-8dbd-73632864c75f",
                                "text": "За вариантами целесообразно закрепить термин «алломорфема» («эмический» суффикс подчёркивает, что перед нами нечто, принадлежащее языку, а не одной только речи)."
                            }
                        ]
                    }
                ],
