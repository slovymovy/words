                ],
                "senses": [
                    {
                        "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                        "entry_id": "b02d88c5-aacb-30f8-a371-1c2cef4112a6",
                        "glosses": [
                            "im engen Sinn eine ringähnliche Verstärkung aus Metall und/oder Kunststoff, die in ein Segel oder Seil eingearbeitet wird, woraus ein Auge entsteht; im weiteren Sinn synonym für dieses verstärkte Auge gebraucht"
                        ],
                        "tags": [
                            "Seemannssprache"
                        ],
                        "examples": [
                            {
                                "example_id": "2a23df89-c58a-4415-b017-814090c33187",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Kauschen sind gekehlte Metall- oder Kunststoffösen als Einlage oder zur Verstärkung, beispielsweis in einem Tauwerkauge zum Schutz gegen Schamfilen.“"
                            },
                            {
                                "example_id": "e6e09c04-1ed5-4057-9bcb-694fd57778e8",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "Erst durch eine Kausch wird ein Augspleiß richtig belastbar."
                            },
                            {
                                "example_id": "dcea5160-1bc7-421e-8941-1964f61a5636",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Sie sind günstig, leicht und fast unzerstörbar. Für viele Einsatzzwecke sind Kauschen gut oder sogar besser geeignet als Blöcke.“"
                            },
                            {
                                "example_id": "f5fd1931-33b8-4ba8-b411-e4b1407469c3",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "In einen Festmacher sollte man unbedingt ein Auge mit Kausch einspleißen, da anderenfalls durch die ständigen Bewegungen des Schiffes das Auge schamfilen und bald reißen würde."
                            },
                            {
                                "example_id": "d17b55ec-442d-4d1d-b8b4-fb1f7f790bfe",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "[Augspleiß:] „Um ein Schamfilen – darunter versteht man eine Beschädigung durch Scheuern oder Reiben – des Auges zu vermeiden, wird meistens eine Kausch eingespleißt.“"
                            },
                            {
                                "example_id": "3c69dfed-9a3b-491d-b73c-c53916028198",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "[Zweistrang-Bändselknoten:] Wichtig ist, dass die Größe der Kausch zum Seildurchmesser passt. Das Seil soll die Kausch gut ausfüllen. Der Knoten dient als schneller Ersatz für einen Augspleiß mit Kausch."
                            },
                            {
                                "example_id": "86c53ca9-9204-41b3-9c8a-8f34114e6579",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Der Draht wird einfach um die Kausch gebogen, eine Metallhülse um beide Enden geschoben und unter hohem Druck zusammengepreßt, so daß sie fast mit dem Draht verschmilzt.“ [Anmerkung: zusammengepreßt ist seit der Rechtschreibreform 1996 eine in Deutschland veraltete Rechtschreibung, korrekt ist heute zusammengepresst]"
                            },
                            {
                                "example_id": "3609a364-98f5-4812-a7fb-901eff2b37a8",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Der Stropp an der Leitöse ist länger und wird durch eine weitere Kausch geführt […] und bis auf eine Winsch oder Klemme geleitet.“"
                            },
                            {
                                "example_id": "2cb389c1-d154-4fc5-88a6-e56598a00348",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Das Segel wird oben und unten mit den Kauschen der Leine verbunden und aufgerollt, dann die Anlage vor dem Vorstag angeschlagen und am Gennakerfall gesetzt.“"
                            },
                            {
                                "example_id": "b17f940d-a563-48cd-92b6-7866443ab33d",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Je nach Größe sollen die Morf-Blöcke eine sichere Arbeitslast von 400 bis 2500 Kilogramm bieten. Das hängt aber vor allem von der Kausch und dem Softschäkel ab“"
                            },
                            {
                                "example_id": "6839b014-e3c6-4844-ab0e-1d592e23e406",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„So sind die extrem leichten Kauschen, mit zum Teil nur 12 Gramm wiegen sie gut zehnmal weniger als ein Block mit vergleichbarer Arbeitslast, vor allem für Barberholer, Baumniederholer oder andere statisch stark belastete Taljen prädestiniert.“"
                            },
                            {
                                "example_id": "09e44b53-ab58-4065-9ece-3516f5c9feac",
                                "sense_id": "4fa7c903-a8f0-3f8c-855d-90a5fe9551b5",
                                "text": "„Man hakt den Spinnaker mit einer Kausch in einen Karabinerhaken, der direkt an der Nock des Spinnakerbaums fest ist und drückt den Baum von Hand heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
