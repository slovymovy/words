                                "text": "Zatrudnienie dobrego pracownika to nie lada sztuka."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "00489621-eda1-3c55-b17a-d059e2784c86",
