    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "be2e9df7-a769-3a67-a7ca-445087300e2d",
                    "sense_definition": "Exercer une force ou une pression contre quelqu'un ou quelque chose pour le déplacer.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>pousser</w> la porte pour entrer dans le magasin."
                        },
                        {
                            "text": "Les enfants <w>poussent</w> le chariot lourd à travers le jardin."
                        }
                    ],
                    "antonyms": [
                        "tirer"
                    ],
                    "common_phrases": [
                        "pousser la porte",
                        "pousser un chariot"
                    ]
                },
                {
                    "sense_id": "dc213fec-0a57-34ee-838e-72df00a6f113",
                    "sense_definition": "Grandir et se développer en parlant des plantes, des fleurs ou des cheveux.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "croissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les tomates <w>poussent</w> très bien sous cette serre chaude."
                        },
                        {
                            "text": "Ses cheveux ont vite <w>poussé</w> depuis le début de l'été."
                        }
                    ],
                    "synonyms": [
                        "croître",
                        "grandir"
                    ],
                    "common_phrases": [
                        "pousser comme un champignon",
                        "laisser pousser ses cheveux"
                    ]
                },
                {
                    "sense_id": "12d35df1-b49f-3d66-aced-2bf791a36477",
                    "sense_definition": "Inciter ou encourager vivement quelqu'un à agir ou à prendre une décision.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses amis l'ont <w>poussé</w> à postuler pour ce nouvel emploi."
                        },
                        {
                            "text": "La curiosité <w>pousse</w> les jeunes scientifiques à explorer des domaines inconnus."
                        }
                    ],
                    "synonyms": [
                        "encourager",
                        "inciter"
                    ],
                    "antonyms": [
                        "dissuader",
                        "décourager"
                    ],
                    "common_phrases": [
                        "pousser à agir",
                        "pousser au crime"
                    ]
                },
                {
                    "sense_id": "9eb3e0b8-9a9d-3353-a3a2-7c047f9c8ee2",
                    "sense_definition": "Émettre ou proférer avec force un bruit, un cri, un soupir ou une parole.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "voix_son",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a <w>poussé</w> un cri de surprise en ouvrant la boîte."
                        },
                        {
                            "text": "Soulagé par la nouvelle, le voyageur <w>poussa</w> un long soupir."
                        }
                    ],
                    "synonyms": [
                        "lancer",
                        "émettre"
                    ],
                    "antonyms": [
                        "retenir"
                    ],
                    "common_phrases": [
                        "pousser un cri",
                        "pousser un soupir",
                        "pousser un juron"
                    ]
                },
                {
                    "sense_id": "149410b7-0cc8-3f80-87f3-888ede80fb99",
                    "sense_definition": "Exagérer, abuser d'une situation ou dépasser les limites raisonnables.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exagération",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu <w>pousses</w> un peu en lui demandant de tout payer."
                        },
                        {
                            "text": "Il ne faut pas <w>pousser</w>, cette erreur arrive à tout le monde."
                        }
                    ],
                    "synonyms": [
                        "abuser",
                        "exagérer"
                    ],
                    "common_phrases": [
                        "faut pas pousser",
                        "pousser le bouchon"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "802e85aa-8118-34da-8e5f-32218d67c082",
                    "sense_definition": "Poursuivre sa marche ou prolonger son voyage jusqu'à une destination précise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Puisque nous sommes ici, nous devrions <w>pousser</w> jusqu'au sommet."
                        },
                        {
                            "text": "Après la visite de la ville, ils <w>poussèrent</w> jusqu'à la côte."
                        }
                    ],
                    "synonyms": [
                        "continuer",
                        "prolonger"
                    ],
                    "antonyms": [
                        "rebrousser chemin"
                    ],
                    "common_phrases": [
                        "pousser jusqu'à"
                    ]
                }
            ]
        }
    ]
