                "senses": [
                    {
                        "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                        "entry_id": "32d36371-8788-3ee1-8087-d9aa95756b6d",
                        "glosses": [
                            "für das Spiel vorgesehene Tageszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "246d35d3-5e7c-411d-b476-558dbc8e96f4",
                                "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                                "text": "„Im Handballspiel konnte man bisher gut in der Mannschaft sein, ausschlaggebend für die Spielmoral, fair mit seinen Gegnern, initiativ bei Spielnachmittagen.“"
                            },
                            {
                                "example_id": "18e3de4b-bbaa-4c25-8570-ca16dfd7f695",
                                "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                                "text": "„Jeder junge gesunde Lehrer müßte einen Spielnachmittag gestalten können, und Referendare, die dazu nicht in der Lage sind, sollten schlechter beurteilt werden, als solche, die in der Psychoanalyse oder in pädagogischen Theorien Lücken aufzuweisen haben.“"
                            },
                            {
                                "example_id": "a3399ebb-ad52-4c69-bf18-528d478869f8",
                                "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                                "text": "„Mogelspiele passen immer dann besonders gut in den Spielnachmittag oder Spielabend, wenn der Drang zu regelwidrigem Verhalten stark ist.“"
                            },
                            {
                                "example_id": "2cd5a571-d5a4-4eb0-b7f1-a9a4e5c68c31",
                                "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                                "text": "„Viele von uns erinnern sich an die versunkenen Spielnachmittage der Kindheit, die wie im Flug vergingen.“"
                            },
                            {
                                "example_id": "3a0471c5-73a3-4249-b6a9-c5ec5dee3ba5",
                                "sense_id": "1f008d73-8cab-3809-8f55-86fbec9512ef",
                                "text": "„Jedem zu Erkältungen neigenden Schüler wird empfohlen, an den Spielnachmittagen ein wollenes Hemd zu tragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
