                    {
                        "translation_id": "6c2a2976-e74b-4922-805e-87ba0c990703",
                        "source_entry_id": "4b6f4146-b642-33fb-8119-d78d89a1aee1",
                        "source_sense_description": "South American palms of the genus Euterpe",
                        "target_lang_word": "açaï",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "açaï",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98bef771-26cf-3b5f-8ea9-338c8b79262a",
                                        "entry_id": "c5aea961-fb34-3397-9a18-a1a95326d1ca",
                                        "glosses": [
                                            "Nom vernaculaire de Euterpe edulis palmiers du genre Euterpe à feuilles pennées d’Amérique du Sud produisant des drupes sombres et qui produit aussi le cœur de palmier sauvage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6555c138-d9ec-4a84-8265-1204bec4db1b",
                                                "sense_id": "98bef771-26cf-3b5f-8ea9-338c8b79262a",
                                                "text": "En revanche, on en prend, de la graine, et à gogo : lin, chia, chanvre, pavot, sésame, tournesol, courge, sarrasin, fenouil ! Et des baies, d’açaï, de goji ! Et des poudres, guarana, curcuma, thé matcha !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d40bce35-b6bf-3430-8fce-51a917444991",
                                        "entry_id": "c5aea961-fb34-3397-9a18-a1a95326d1ca",
                                        "glosses": [
                                            "Fruit de ce palmier, rouge pourpre tirant sur le violet, s’il évoque la myrtille ou le cassis par sa taille et sa couleur, il comporte un noyau et son goût évoque plutôt celui du chocolat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa4a9cc-6a09-486b-9565-274d08428a62",
                                                "sense_id": "d40bce35-b6bf-3430-8fce-51a917444991",
                                                "text": "Les bienfaits de l’açaï sont réels, mais la petite baie n’est pas la panacée décrite par certains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
