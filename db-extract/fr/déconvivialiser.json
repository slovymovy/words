                ],
                "senses": [
                    {
                        "sense_id": "f97f2d91-657a-35b0-a190-7167f757f511",
                        "entry_id": "cde58a1e-4d54-3e2b-97d9-08df6a629e77",
                        "glosses": [
                            "Faire perdre son caractère convivial à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47957c78-334d-4c4d-8292-56b8c6725485",
                                "sense_id": "f97f2d91-657a-35b0-a190-7167f757f511",
                                "text": "C’est donc une telle famille qu’au fil des années, l’Ecole disloque et déconvivialise progressivement, par l’intermédiaire des jeunes qui la fréquentent sur place au village, et ceux que leurs parents, hors de l’ordre commun, envoient acquérir le même savoir, dans les villes."
                            },
                            {
                                "example_id": "77ecb93d-cb90-4613-acf1-e659e9e1f77c",
                                "sense_id": "f97f2d91-657a-35b0-a190-7167f757f511",
                                "text": "On peut maintenant essayer d’envisager des métiers et des emplois pour réduire le désert mécanisé, le désert déconvivialisé, le désert rural."
                            },
                            {
                                "example_id": "b0604e1c-19e5-43ef-8927-695aae8f4265",
                                "sense_id": "f97f2d91-657a-35b0-a190-7167f757f511",
                                "text": "Diminuer voire effacer la qualité conviviale et informelle du lieu par la présence de professionnels sociaux : « déconvivialiser » un café par la présence de ces derniers."
                            }
                        ]
                    }
                ],
