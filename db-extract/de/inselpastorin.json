                "senses": [
                    {
                        "sense_id": "2dec1afa-651d-3990-819a-c6c23e80a164",
                        "entry_id": "2be75291-d2fa-320a-b677-bf2e82f62e84",
                        "glosses": [
                            "für die Bewohner einer Insel zuständige Pfarrerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d37e36f-f01d-43e4-a271-34b269bda7d4",
                                "sense_id": "2dec1afa-651d-3990-819a-c6c23e80a164",
                                "text": "„Die bisherige Inselpastorin Elisabeth Tobaben konnte sich am späten Sonntagnachmittag entspannt auf ihrem Stuhl in der Inselkirche zwischen den anderen Mitgliedern der Inselkantorei zurücklehnen, denn sie hat in Stefanie Lohmann eine würdige Nachfolgerin gefunden. Die neue Pastorin, die in wenigen Tagen ihren 40. Geburtstag feiert, wurde von Superintendent Dr. Helmut Kirschstein in der evangelischen Inselkirche in einem besonderen Gottesdienst eingeführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
