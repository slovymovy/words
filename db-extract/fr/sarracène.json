                "senses": [
                    {
                        "sense_id": "a7367fd1-4d53-3ca3-be86-d679d786235a",
                        "entry_id": "f2ce9545-fa38-36a7-bcd5-2d311356f2a4",
                        "glosses": [
                            "Genre de plantes (Sarracenia, Sarracéniées) comprenant 8 espèces de vivaces carnivores, persistantes ou caduques, poussant dans les marais acides, du Canada arctique à la Floride."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2c9ac18-92b5-4d46-b258-f9583211ef69",
                                "sense_id": "a7367fd1-4d53-3ca3-be86-d679d786235a",
                                "text": "Il eut même une discussion publique avec Chauveau, qu’il ridiculisa pour avoir désigné par le mot sarrasine (au lieu de sarracène) la plante découverte par le Dr Sarrazin."
                            },
                            {
                                "example_id": "51bad2c1-3b37-45d8-bd4a-814e9eec62b9",
                                "sense_id": "a7367fd1-4d53-3ca3-be86-d679d786235a",
                                "text": "Le ^([sic : La]) sarracène à fleurs jaunes est une plante herbacée carnivore. Il possède des feuilles modifiées en un piège passif à cornet tubulaire étroit pouvant atteindre 30 cm à 1 m de haut."
                            },
                            {
                                "example_id": "732717c2-4528-4e05-8110-fb42235d80be",
                                "sense_id": "a7367fd1-4d53-3ca3-be86-d679d786235a",
                                "text": "Sarracenia purpurea possède l’étendue la plus large des sarracènes, et elle est divisée en deux sous-espèces, une variété, et plusieurs formes."
                            }
                        ]
                    }
                ],
