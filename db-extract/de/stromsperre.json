                ],
                "senses": [
                    {
                        "sense_id": "cd66e803-50e5-3fa6-900c-5157d57c0586",
                        "entry_id": "638ae3c2-3b9a-3148-9f96-e46e7d3fcbea",
                        "glosses": [
                            "Abschaltung der Versorgung mit Strom"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88440c51-5017-45b3-895e-4130bc200d5a",
                                "sense_id": "cd66e803-50e5-3fa6-900c-5157d57c0586",
                                "text": "„Hunger herrschte überall, abends gab es wegen der stundenweisen Stromsperren kein Licht, und es war eiskalt.“"
                            },
                            {
                                "example_id": "328a821f-9e64-40f4-b195-ebc005729df6",
                                "sense_id": "cd66e803-50e5-3fa6-900c-5157d57c0586",
                                "text": "„Aber oft habe ich das leichte Glitzern gesehen, das während der Stromsperre unaufhörlich schien und flackerte – es schien dauernd Stromsperre zu herrschen – und das einzige Licht in dem Dämmern und den Schatten des Zimmers kam von einem kleinen Kerzenstumpf oder von der niedrigen Flamme einer Karbidlampe, die Knoblauchgeruch verbreitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
