                                "target_senses": [
                                    {
                                        "sense_id": "4c04db0b-aeaf-3b86-a836-81978a8c6f23",
                                        "entry_id": "52a8e9b2-9724-39fa-a7d8-dc103be4fb23",
                                        "glosses": [
                                            "Plante grimpante sempervirente tropicale cultivée pour ses fruits aromatiques de nom scientifique Vanilla planifolia (→ voir vanillier à feuilles planes et vanille Bourbon)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb8f8978-7d42-4586-a9ec-ce7bb9118c82",
                                                "sense_id": "4c04db0b-aeaf-3b86-a836-81978a8c6f23",
                                                "text": "Les vieilles danses et les jeux marquisiens ayant été supprimées, l’argent que donnaient aux indigènes la récolte du copra et la culture de la vanille ne pouvait leur procurer aucun plaisir."
                                            },
                                            {
                                                "example_id": "591e4790-3d4f-461f-a4f4-4155ab83ac13",
                                                "sense_id": "4c04db0b-aeaf-3b86-a836-81978a8c6f23",
                                                "text": "Les plantes cultivées sont : la canne à sucre, le café, le cacao, la vanille, le vanillon, le roucou, le manioc, les ignames, les bananes, les patates, les madères, les malangas, le maïs, la casse, les couscous, les ananas, le coton, la muscade, le poivre, la girofle, le bois d’Inde, le cocotier, le tabac, le riz, etc., etc."
                                            },
                                            {
                                                "example_id": "2ffaf83f-85ea-473f-b565-fe43d7473aca",
                                                "sense_id": "4c04db0b-aeaf-3b86-a836-81978a8c6f23",
                                                "text": "Dans 200 g d’huile, faire macérer une gousse de vanille pendant une semaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                        "entry_id": "52a8e9b2-9724-39fa-a7d8-dc103be4fb23",
                                        "glosses": [
                                            "Fruit de l’orchidée Vanilla planifolia appelée communément vanillier, cette sorte de capsule a un parfum et une saveur aromatique."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc10caa6-fa5b-40d3-be54-2c9a1ecc0285",
                                                "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                                "text": "Les principaux pays producteurs de vanille sont par ordre d’importance : Madagascar, les Comores, le Mexique, la Réunion, Tahiti, Nossi Bé."
                                            },
                                            {
                                                "example_id": "fa70f888-8272-4fd4-966d-ad4d45c4f34d",
                                                "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                                "text": "On se gardera bien de rejeter une Vanille couverte d’une fleur saline, ou de petites salines très-fines, entièrement semblables aux fleurs de benjoin, car la fleur de cette plante n’est autre chose qu’un sel essentiel dont le fruit est rempli, qui sort en dehors, quand on l'apporte dans un tems trop chaud."
                                            },
                                            {
                                                "example_id": "4d111a40-a945-4ffb-9781-510ced7a5977",
                                                "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                                "text": "Crème à la vanille."
                                            },
                                            {
                                                "example_id": "66a7ca95-9ff8-46bc-a61c-f7914f738428",
                                                "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                                "text": "Liqueur de vanille."
                                            },
                                            {
                                                "example_id": "a6d63081-7d76-45df-bce6-388e58c9366a",
                                                "sense_id": "59364690-3850-36a6-8336-762d7a33fe87",
                                                "text": "Depuis son départ, elle est restée vide ; le vent de la mer et les années l’ont disjointe et meurtrie ; les broussailles l’ont recouverte, la vanille l’a tapissée, — mais elle a conservé le nom tahitien de Georges, on l’appelle encore « la case de Rouéri…… »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4307910-2689-39ba-8d3f-9ba1e78f34d5",
                                        "entry_id": "52a8e9b2-9724-39fa-a7d8-dc103be4fb23",
                                        "glosses": [
                                            "Arôme naturel extrait de ce fruit, ou synthétique (la vanilline fut le premier arôme synthétisé artificiellement), utilisé en pâtisserie et en confiserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb351249-d344-46ab-a063-cf477a6fdcea",
                                                "sense_id": "c4307910-2689-39ba-8d3f-9ba1e78f34d5",
                                                "text": "Un sachet de vanille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da1aea67-bb1b-3c28-b419-34c2f4735536",
                                        "entry_id": "52a8e9b2-9724-39fa-a7d8-dc103be4fb23",
                                        "glosses": [
                                            "Tresse de cheveux à deux brins, qui peut faire penser à une gousse de vanille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0907e312-ea1b-42bc-b1f8-6adb4d0863bc",
                                                "sense_id": "da1aea67-bb1b-3c28-b419-34c2f4735536",
                                                "text": "Tressé, locksé, en afro ou en vanille… le cheveu dit naturel - ou texturé - peut se coiffer de façons très différentes !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vanille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a063b957-3e20-38d6-bed6-360c6544f162",
                                        "entry_id": "036147c2-e986-39d1-8de0-4af66c57be21",
