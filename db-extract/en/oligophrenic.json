                    }
                ],
                "translations": [
                    {
                        "translation_id": "1537ebb4-51b0-4bd8-8358-d9499d77c500",
                        "source_entry_id": "b7752200-99e7-3756-b51d-30734ae0ab49",
                        "source_sense_id": "eb03535d-c443-3c94-bb7e-a0a59ee29663",
                        "source_sense_description": "Translations",
                        "target_lang_word": "oligophrène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oligophrène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47e261a8-93ed-346a-8f58-9b3f832f678e",
                                        "entry_id": "b7086f1b-f842-3d52-8699-c2719f5fb2a8",
                                        "glosses": [
                                            "Faible d’esprit ; débile mental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9588bfaf-f0f0-402c-8660-066ac97c0bab",
                                                "sense_id": "47e261a8-93ed-346a-8f58-9b3f832f678e",
                                                "text": "L’oligophrène verbalise facilement mais il est incapable d'un raisonnement complexe susceptible d'entraîner une action adéquate."
                                            },
                                            {
                                                "example_id": "51067e2b-7bb1-4333-8660-6abd66200792",
                                                "sense_id": "47e261a8-93ed-346a-8f58-9b3f832f678e",
                                                "text": "Des réflexions très semblables naissent à la lecture de Dugdale qui relève le cas de Max Jukes, un ivrogne vagabond de New York, qui vivait également au XVIIIe et dont on connaissait, en 1915, parmi les 2094 descendants, 140 criminels dont 7 assassins, 300 prostituées, 310 mendiants et 600 oligophrènes."
                                            },
                                            {
                                                "example_id": "739dfb28-6513-4547-b131-a0ddb9cf875c",
                                                "sense_id": "47e261a8-93ed-346a-8f58-9b3f832f678e",
                                                "text": "« Une révolution menée pour l’amour, la vie, le respect et le partage » ne saurait avoir que des amis et pour adversaires que des oligophrènes ou des crapules."
                                            },
                                            {
                                                "example_id": "ad1e96f8-b6b0-4c74-9ace-94bfe0dc75b1",
                                                "sense_id": "47e261a8-93ed-346a-8f58-9b3f832f678e",
                                                "text": "Aujourd'hui, les progrès sont évidents : on devrait bientôt pouvoir fabriquer quantité de monstres puissants, performants, oligophrènes et désérotisés"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
