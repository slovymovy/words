                        "examples": [
                            {
                                "example_id": "6eed3344-4cb0-4b6a-bae7-8f9664e49e95",
                                "sense_id": "bc849838-28d7-3d0e-a59d-15a82feb3a05",
                                "text": "„Zum Nachtisch gab es einen wunderbaren Erdbeerpudding.“"
                            },
                            {
                                "example_id": "5e36dcac-5ce9-4e88-b489-bdfeec89ae86",
                                "sense_id": "bc849838-28d7-3d0e-a59d-15a82feb3a05",
                                "text": "„Ich könnte das ganze Jahr über Erdbeeren essen, Erdbeerpudding, Erdbeereis.“"
                            },
                            {
                                "example_id": "0a663864-a4a2-4330-be62-5830ad8fe99c",
                                "sense_id": "bc849838-28d7-3d0e-a59d-15a82feb3a05",
                                "text": "„Ich finde, es sieht hübsch aus, die kleinen Sahneröschen auf dem Erdbeerpudding.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
