                        "sense_id": "b9a69205-3f20-3a41-990d-812e3e0c8c8c",
                        "entry_id": "22604168-ad57-3843-9d8a-e4b22539961a",
                        "glosses": [
                            "vrouw die met je strijdt om iets dat jullie beiden willen hebben"
                        ],
                        "tags": [
                            "person"
                        ],
                        "examples": [
                            {
                                "example_id": "274de1cc-7ea7-4e00-83ad-dfd5ad34f6d0",
                                "sense_id": "b9a69205-3f20-3a41-990d-812e3e0c8c8c",
                                "text": "Takagi sloeg vrijdag op de 500 meter hard toe en schreef een dag later ook de 1500 meter op haar naam. Voor Wüst was er toen op de afsluitende 5000 meter tegen Takagi geen redden meer aan. De onttroonde titelhoudster moest bijna 12 seconden op haar rivale goedmaken, maar slaagde daar bij lange na niet in, mede door de loodzware omstandigheden in het natte Olympisch Stadion."
                            },
                            {
                                "example_id": "0d056afc-9202-405a-8c7c-96daf5eefc24",
                                "sense_id": "b9a69205-3f20-3a41-990d-812e3e0c8c8c",
                                "text": "Van Vleuten, die zondag had toegeslagen in de tijdrit, arriveerde als veertiende op iets meer dan 2 minuten. Ze verkeerde in het gezelschap van naaste rivale Anna van der Breggen en behield de leiderstrui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffdcd5f8-6562-4e2f-ac87-bb51bd40d350",
                        "source_entry_id": "22604168-ad57-3843-9d8a-e4b22539961a",
                        "source_sense_id": "b9a69205-3f20-3a41-990d-812e3e0c8c8c",
                        "source_sense_description": "vrouw die met je strijdt om iets dat jullie beiden willen hebben",
                        "target_lang_word": "rivale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rivale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b11967-abb0-30cd-9e84-c539afe4f4a1",
                                        "entry_id": "8fac6a14-de43-3f19-8a59-111b68a5717e",
                                        "glosses": [
                                            "Femme rivale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10cb21f-e5ac-4909-b89c-1d786b4d9e36",
                                                "sense_id": "b6b11967-abb0-30cd-9e84-c539afe4f4a1",
                                                "text": "Une femme d’un certain âge, qui veut s’attacher à jamais un homme, commence par en diviniser les défauts, afin de rendre impossible toute rivalité ; car une rivale n’est pas de prime abord dans le secret de cette superfine flatterie à laquelle un homme s’habitue assez facilement."
                                            },
                                            {
                                                "example_id": "89f15b9d-5557-4517-a803-039b5537608b",
                                                "sense_id": "b6b11967-abb0-30cd-9e84-c539afe4f4a1",
                                                "text": "La notaresse était furieuse de ne pas être aussi belle que madame César, car toute femme sait toujours en elle-même à quoi s’en tenir sur la supériorité ou l’infériorité d’une rivale."
                                            },
                                            {
                                                "example_id": "f65d1829-b84d-41ab-a61d-8abb7330c54e",
                                                "sense_id": "b6b11967-abb0-30cd-9e84-c539afe4f4a1",
                                                "text": "— La philosophie, d'abord servante, puis auxiliaire de la foi, devint ainsi sa rivale."
                                            }
                                        ]
                                    }
                                ]
                            },
