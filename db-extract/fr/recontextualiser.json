                "senses": [
                    {
                        "sense_id": "4e7e07ed-5b92-3069-8cc0-9ef6d34f340f",
                        "entry_id": "9e38a900-dbe5-30d7-b4ba-f39e5f3738fb",
                        "glosses": [
                            "Remettre dans son contexte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f341866-c49f-4aeb-b9dc-c04057ec8217",
                                "sense_id": "4e7e07ed-5b92-3069-8cc0-9ef6d34f340f",
                                "text": "Maintenant qu’elle siège au 10, Downing Street, son discours « va devenir national dans la seule idéologie du parti, recontextualise Agnès Alexandre-Collier, professeure à l’université de Bourgogne et co-autrice de Les partis politiques en Grande-Bretagne (Armand Colin). Une fois en place, la realpolitik et les faits vous rattrapent. »."
                            },
                            {
                                "example_id": "c16d0719-a93f-4b97-b694-63cc7a74fe70",
                                "sense_id": "4e7e07ed-5b92-3069-8cc0-9ef6d34f340f",
                                "text": "Il est peut-être nécessaire que je recontextualise comme disent les savants. Je vais donc commencer par me présenter."
                            }
                        ]
                    },
                    {
                        "sense_id": "ac9062c8-fe0a-376e-96cc-d694cf4602f6",
                        "entry_id": "9e38a900-dbe5-30d7-b4ba-f39e5f3738fb",
                        "glosses": [
                            "Utiliser dans un contexte donné ce qui avait été appris ou expérimenté dans des contextes différents."
                        ],
