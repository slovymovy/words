                    {
                        "sense_id": "465f5ede-77c7-30cf-8be9-0637305c0272",
                        "entry_id": "ab648069-c378-3d13-bd41-af905eb2f72e",
                        "glosses": [
                            "iemand die iets heeft gezien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3719593b-9162-4aac-af60-5658f9bbd56a",
                                "sense_id": "465f5ede-77c7-30cf-8be9-0637305c0272",
                                "text": "Er is nog geen bevestiging dat de man ook werkelijk ebola heeft, maar het nieuws heeft angst gezaaid in de hoofdstad. Mensen zijn aan het hamsteren geslagen en eten niet langer in de vele eetstalletjes langs de kanten van de weg uit angst voor besmetting, meldden ooggetuigen."
                            },
                            {
                                "example_id": "3c16cee7-dd6f-4cc1-8cb8-6337176e7b1e",
                                "sense_id": "465f5ede-77c7-30cf-8be9-0637305c0272",
                                "text": "Als áspirant'was het heel goed mogelijk dat Harald als ooggetuige aanwezig had moeten zijn wanneer oudere kameraden debuteerden."
                            }
                        ]
                    },
                    {
                        "sense_id": "30ec9020-6faa-3038-ae7c-056753e4986f",
                        "entry_id": "ab648069-c378-3d13-bd41-af905eb2f72e",
                        "glosses": [
                            "iemand die een getuigenis aflegt van iets wat hij/zij gezien heeft"
                        ],
                        "tags": [],
                        "examples": []
                    }
