                    {
                        "translation_id": "69163c70-3e60-4284-9dd5-05aad3968e1c",
                        "source_entry_id": "26f63c07-04e9-33ca-9bb3-25f938c6002b",
                        "source_sense_id": "c08dcb45-7908-36de-8599-7841e6c594c5",
                        "source_sense_description": "met betrekking tot de kookkunst",
                        "target_lang_word": "culinaire",
