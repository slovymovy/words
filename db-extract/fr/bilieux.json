                "senses": [
                    {
                        "sense_id": "654ddfee-1c53-35d0-a15c-a6ebd7ba2860",
                        "entry_id": "a660f72c-9174-3f9f-96d6-a69d7c5b9390",
                        "glosses": [
                            "Personne qui sécrète beaucoup de bile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bc8289d-e034-42ff-aaaa-0b18a1745a92",
                                "sense_id": "654ddfee-1c53-35d0-a15c-a6ebd7ba2860",
                                "text": "Un gros concierge, un secrétaire rose, nous acclament avec la joie d'un poitrinaire devenu cent kilos, d'un bilieux devenu poupin."
                            }
                        ]
                    },
                    {
                        "sense_id": "04403062-1389-3513-b4e6-35b62078e69e",
                        "entry_id": "a660f72c-9174-3f9f-96d6-a69d7c5b9390",
                        "glosses": [
                            "Personne qui a le tempérament bilieux : enclin à la colère, rancunier."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "87bcce1f-c9d6-42ef-b324-9dd5b0900327",
                                "sense_id": "04403062-1389-3513-b4e6-35b62078e69e",
                                "text": "De telles rêvasseries conviennent aux bilieux hypocondriaques et non point à ces joyeux qui ont la joue vermeille et l’oreille rouge."
                            },
                            {
                                "example_id": "105ad588-8ad4-4e3c-bafe-51d8e1b85a1e",
                                "sense_id": "04403062-1389-3513-b4e6-35b62078e69e",
                                "text": "Au lieu d’écrire des Syllabus qui ne peuvent réjouir que des bilieux, chagrineux, chassieux, ces deux chefs de mon Église distribueraient leurs faveurs à celles et à ceux qui sauraient le mieux m’adorer..."
                            }
                        ]
                    }
