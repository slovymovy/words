                "senses": [
                    {
                        "sense_id": "c771151d-2e48-34d2-b60a-305c9ab6dd34",
                        "entry_id": "dc3acdf5-b2b9-3252-bc9b-f2fe529e9eec",
                        "glosses": [
                            "iets met woorden of klanken heel beeldend kunnen beschrijven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5d1de4-cf20-451c-85ad-b6064950cddb",
                                "sense_id": "c771151d-2e48-34d2-b60a-305c9ab6dd34",
                                "text": "Zulke zinnen schrijft Melchior: gedetailleerd, evocatief, met een vaak eigenaardige spanning erin, en dan soms ineens ook verrassend ontnuchterend of laconiek. Hij spint je in met die zinnen. Hier is beslist geen sprake van mooischrijverij; 'de zwembroek was plotseling een vieze kledder,' lees je iets verderop."
                            },
                            {
                                "example_id": "12a4517c-5b94-4f70-b5be-c8da87dc5167",
                                "sense_id": "c771151d-2e48-34d2-b60a-305c9ab6dd34",
                                "text": "De titel van de cd is vernoemd naar het ruim vijftien minuten durende The Shadows of silence van de hier vrijwel onbekende Noorse componist Bent Sørensen, die in het stuk met veel evocatief talent een bijzonder fraai en melancholiek stemmende wereld van zachte schaduwklanken oproept."
                            }
                        ]
                    }
