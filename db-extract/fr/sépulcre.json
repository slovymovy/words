                                    },
                                    {
                                        "sense_id": "0d39d9f9-1d63-320c-88e4-271475a1b63b",
                                        "entry_id": "92f18dd2-80d6-3c8e-b094-e7038ec05ff9",
                                        "glosses": [
                                            "plaats waar één of meer lijken begraven liggen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7212b469-4b9b-4dba-af98-669858cf4a93",
                                                "sense_id": "0d39d9f9-1d63-320c-88e4-271475a1b63b",
                                                "text": "Algemene graven worden minstens 10 jaar in stand gehouden."
                                            },
                                            {
                                                "example_id": "4795a48b-7738-42d8-a6fc-90a4aa68f4e9",
                                                "sense_id": "0d39d9f9-1d63-320c-88e4-271475a1b63b",
                                                "text": "De rest is geschiedenis, gedetailleerd te zien op de expositie in Assen. Achter het podium met de oude gitaren hangt het scherm waarop de films te zien zijn van de Amerikaanse bluesreizen die Muskee maakte met Albert Haar. Daar zijn ook de beelden te zien van het karige Tutwiler, Mississippi, waar ze op zoek gingen naar het graf van Sonny Boy Williamson II."
                                            },
                                            {
                                                "example_id": "92267e24-44d0-4f17-bbf5-d49932df4621",
                                                "sense_id": "0d39d9f9-1d63-320c-88e4-271475a1b63b",
                                                "text": "En over zijn graf werd een prachtige kerk gebouwd, die het middelpunt werd van de Nicolaasverering."
                                            }
                                        ]
                                    }
                                ]
                            }
