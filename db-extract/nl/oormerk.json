                "forms": [
                    {
                        "form_id": "8e4c0832-6a34-428f-a403-5284762f6493",
                        "entry_id": "462ced81-4186-3506-8296-8bb62a9a9477",
                        "tags": [
                            "plural"
                        ],
                        "form": "oormerken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "24a13832-7c40-325c-8108-d093c8267069",
                        "entry_id": "462ced81-4186-3506-8296-8bb62a9a9477",
                        "glosses": [
                            "een, meestal geel, genummerd label op de oren van rundvee – inclusief waterbuffel en Amerikaanse bizon – en sinds 2005 ook van schapen, geiten en varkens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00c0698d-84ba-4ef0-a50c-4f3c5468802c",
                                "sense_id": "24a13832-7c40-325c-8108-d093c8267069",
                                "text": "De stamboekstier heeft geen oormerken, geen ring door zijn neus en nog echte hoorns. „Ik kon het niet over mijn hart verkrijgen hem weg te doen”, vertelt De Groot. „Het klinkt misschien gek, maar Ysbrand voelt een beetje als familie. Ik heb hem als jong stiertje gekregen en hij liep hier altijd op het erf rond. Ik heb hem altijd veel geaaid en tegen hem gepraat. Daar is hij tam van geworden.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "33346e45-1fc6-365e-9fed-8788dd63043b",
                        "entry_id": "462ced81-4186-3506-8296-8bb62a9a9477",
                        "glosses": [
                            "een herkenningsteken in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb2f9fd4-c54f-4ee7-baf6-77e92cebf0b2",
                                "sense_id": "33346e45-1fc6-365e-9fed-8788dd63043b",
                                "text": "‘Stiekem dromen we ervan dat de paarse krokodil een oormerk wordt’, verklapt Frederik Verhaeghe. ‘Dat je bijvoorbeeld een paarse krokodil op je identiteitskaart of rijbewijs, of zelf het schoolrapport zet en de persoon tegenover jou meteen weet: “Aha, dat is iemand die strijdt tegen bureaucratie”. Nu, we zullen al héél blij zijn als het een tool wordt om een gesprek aan te knopen, of om als werknemer in je eigen bedrijf regels af te schaffen. Vaak ligt dat gevoelig. Via de paarse krokodil kun je de situatie ontmijnen.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "a4cded11-b389-3cd8-b7dc-354116bc98dc",
                        "entry_id": "462ced81-4186-3506-8296-8bb62a9a9477",
                        "glosses": [
                            "van iets dat het alleen maar gebruikt mag worden voor één, van te voren bepaald doel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "778b43ad-ce95-4c6c-a538-017252bf2043",
                                "sense_id": "a4cded11-b389-3cd8-b7dc-354116bc98dc",
                                "text": "Ook leuk aan ondertrouw: je kreeg er een vrije dag voor van je werkgever. Die dag is in veel cao's al langer verdwenen en vervangen door verlof zonder oormerk. ,,Werknemers willen meer flexibiliteit in de bestemming van hun vrije dagen, zegt Jannes van der Velde van werkgeversvereniging AWVN. ,,Wij verwachten dat de vrije dag voor ondertrouw helemaal verdwijnt, zeker nu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02c0c1c-2baa-47d5-92f7-6373aca9339c",
                        "source_entry_id": "462ced81-4186-3506-8296-8bb62a9a9477",
                        "source_sense_id": "24a13832-7c40-325c-8108-d093c8267069",
                        "source_sense_description": "een, meestal geel, genummerd label op de oren van rundvee – inclusief waterbuffel en Amerikaanse bizon...",
                        "target_lang_word": "earmark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "earmark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a32a1786-24c3-3364-b3cc-c6f1a04dfa75",
                                        "entry_id": "1b50950f-4c31-3cdf-898b-f967d16adc01",
                                        "glosses": [
                                            "A mark made or tag attached to the ear of an animal (chiefly a livestock animal), generally to identify or indicate something about the animal, such as ownership, health or gestation status, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f90faf8-5271-4f7c-9d06-cd8bcaa5fa5d",
                                                "sense_id": "a32a1786-24c3-3364-b3cc-c6f1a04dfa75",
                                                "text": "Some mark them [sheep] vvith Raddle and make Ear-marks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                        "entry_id": "1b50950f-4c31-3cdf-898b-f967d16adc01",
                                        "glosses": [
                                            "A distinguishing or identifying mark or sign; specifically (archaic), a mark of ownership."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7af81a88-4fae-41b6-9434-8ee43257ed49",
                                                "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                                "text": "[H]e ſhoulde be dyſcryued by hys rounding and his eare marke: […]"
                                            },
                                            {
                                                "example_id": "a3550ffc-b0b2-48fb-95a8-80ee522033f4",
                                                "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                                "text": "Mr. Bayes, many as proper a man as your ſelf march'd up Holborn for diſtinguiſhing betvvixt the VVealth and the Fanatick: and moreover let me tell you, Fanatick Money hath no Ear-mark."
                                            },
                                            {
                                                "example_id": "e1162fa6-a7cf-4d17-85f2-53d37d6878d5",
                                                "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                                "text": "VVe are likevviſe all agreed that if the goods had remain in ſpecie unſold in the bankrupt's hands at the time of the bankruptcy, the plaintiffs might have recovered them in an action of trover, and that they could not be applied to pay the bankrupt's debts, […] [W]hy are goods conſidered ſtill as the ovvners? becauſe they remain in ſpecie, and ſo may be diſtinguiſhed from the reſt of the bankrupt's eſtate. But as money has no earmark, it cannot be diſtinguiſhed."
                                            },
                                            {
                                                "example_id": "228bdeac-6b55-45bc-8e4b-5f4318480665",
                                                "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                                "text": "I am inclined to think that his most besetting sin in style,—the little earmark by which he is most conspicuous,—is a certain affected familiarity."
                                            },
                                            {
                                                "example_id": "3c29892c-1b11-4eae-9587-12e61266bb24",
                                                "sense_id": "fc00f684-c69e-3338-937c-475666f8c47c",
                                                "text": "[…] I saw in my patient one of the most forbidding men I have ever met. He had all the earmarks of a criminal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca2f47f-45da-344c-9342-a2c3e6ecc72e",
                                        "entry_id": "1b50950f-4c31-3cdf-898b-f967d16adc01",
                                        "glosses": [
                                            "An act of designating certain funds to be used for a specific purpose; specifically (US, politics), a designation by the Congress that certain federal funds be appropriated for a specific project."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "earmark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aca160d2-1d99-384d-9891-dd0eb4bee41f",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "To make a mark or attach a tag to the ear of (an animal, chiefly a livestock animal), generally to identify or indicate something about the animal, such as ownership."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90b68646-efe5-32eb-add6-a93107c10be5",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "To put a distinguishing or identifying mark or sign on (something); to make (something) distinctive or identifiable."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4414e5a1-d7d2-3bf4-a629-0ed78be39fb2",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "To designate or set aside (someone or something) for a particular purpose; to allocate."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "630a11cd-0212-4231-8c47-eda4298c783b",
                                                "sense_id": "4414e5a1-d7d2-3bf4-a629-0ed78be39fb2",
                                                "text": "In barely a decade, the War on Drugs went from being a political slogan to an actual war. Now that police departments were suddenly flush with cash and military equipment earmarked for the drug war, they needed to make use of their new resources."
                                            },
                                            {
                                                "example_id": "d96cb9a1-e2f4-4b8b-b918-a6e68ac8abda",
                                                "sense_id": "4414e5a1-d7d2-3bf4-a629-0ed78be39fb2",
                                                "text": "But even I draw the line at \"doing crunches\" in designer clothes. Fashion sneakers are for swanking around the shops, not for running in. And so, like everyone else, I wear grotty old tracksuits earmarked for Oxfam, and tragic free festival T-shirts that give away my age."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6caac57-6413-31c0-9970-0dd73ae9c33d",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "Chiefly followed by for: to designate (certain funds) to be used for a specific purpose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c22cf36-58c6-4225-a3e7-740770bb8b63",
                                                "sense_id": "d6caac57-6413-31c0-9970-0dd73ae9c33d",
                                                "text": "You can donate to the organization as a whole, or you can earmark your contribution for a particular project."
                                            },
                                            {
                                                "example_id": "41403532-37e0-4705-b790-1951234d84e0",
                                                "sense_id": "d6caac57-6413-31c0-9970-0dd73ae9c33d",
                                                "text": "A widening of the M4 had long been mooted, and the Welsh Government had even earmarked most of the required £1.6bn funding for a new 14-mile, six-lane section around Newport. Then, in the face of opposition from environmentalists, came a realisation that similar road schemes across the world tend merely to encourage greater car use and therefore soon prove ineffective in solving the original problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d318704a-26dc-3db6-a475-86b5f876e878",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "Chiefly followed by for: to designate (certain funds) to be used for a specific purpose.",
                                            "To designate (part of a pension) to be payable to the holder's former spouse or payment when the pension is paid."
                                        ],
                                        "tags": [
                                            "UK",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6840a65b-1af3-3650-a51b-6afc302008bc",
                                        "entry_id": "4bd88264-3d2c-319d-ad18-a2d9a8b18f44",
                                        "glosses": [
                                            "Chiefly followed by for: to designate (certain funds) to be used for a specific purpose.",
                                            "Of the Congress: to designate that certain federal funds be appropriated for a specific project."
                                        ],
                                        "tags": [
                                            "US",
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
