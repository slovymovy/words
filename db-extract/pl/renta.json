                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "σύνταξη",
                                "target_lang_code": "el",
                                "target_senses": [
                                    {
                                        "sense_id": "db32fe30-ed60-3ef7-8403-dcd49a96a0c5",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "η εκφορά του γραπτού ή προφορικού λόγου με συγκεκριμένους κανόνες στη χρήση, θέση και σχέση των λέξεων μιας φράσης"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77f3d9e2-3e0a-4000-a2e1-36b78a44f14d",
                                                "sense_id": "db32fe30-ed60-3ef7-8403-dcd49a96a0c5",
                                                "text": "H σωστή σύνταξη διδάσκεται με το μάθημα του συντακτικού"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58b0353e-e11d-396b-87c9-66189859ad9e",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "το γράψιμο ενός κειμένου, συνήθως επίσημου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61db4018-a5c2-40c9-8d4c-fcff0d2ed49f",
                                                "sense_id": "58b0353e-e11d-396b-87c9-66189859ad9e",
                                                "text": "H σύνταξη του νομοσχεδίου καθυστέρησε με ευθύνη του αρμόδιου υπουργού"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e35ede1-4ffe-30c1-aee4-08dd5add5865",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "στο δημοσιογραφικό κλάδο",
                                            "τα άτομα που εργάζονται γενικά ως δημοσιογράφοι"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2142be4a-9c93-3e1d-91f0-42e04a7caadb",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "στο δημοσιογραφικό κλάδο",
                                            "οι συντάκτες που έχουν ως αντικείμενο την επιμέλεια κειμένων, γραπτών ή προφορικών"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44579e74-0a63-4c7e-98d8-ac73ca56b164",
                                                "sense_id": "2142be4a-9c93-3e1d-91f0-42e04a7caadb",
                                                "text": "※ απομακρύνθηκε (με τη μορφή «παραίτησης») ο διευθυντής σύνταξης της ημερήσιας έκδοσης Μπάμπης Κούτρας και τη θέση του καταλαμβάνει το νέο πουλέν της κυρίας Αγγελοπούλου, ο μέχρι τούδε διευθυντής του κυριακάτικου φύλλου Λάμπρος Σμαΐλης (Χ. Γ. Παπουτσάκης, Αντί, τεύχη 886-891, 2007, σελ. 13)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24aed720-2765-3d5d-af30-0155a7c62a57",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "στο δημοσιογραφικό κλάδο",
                                            "ο χώρος στον οποίο είναι τα γραφεία των δημοσιογράφων"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02f72513-b6d0-307d-aabd-48f198b83187",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "η τοποθέτηση των ανδρών μιας στρατιωτικής μονάδας σε στοίχους και γραμμές κατά την τακτική της συγκέντρωση"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bad778ba-db9d-361d-972e-7cf888a63763",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "η αποχώρηση από την εργασιακή ζωή και η οικονομική επιβίωση με τη μηνιαία είσπραξη ενός ποσού που καταθέτει ο ασφαλιστικός και συνταξιοδοτικός φορέας του πρώην εργαζόμενου"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028de914-47ef-4b8b-993f-3e6b1f1d5bcd",
                                                "sense_id": "bad778ba-db9d-361d-972e-7cf888a63763",
                                                "text": "Ο Κώστας βγήκε στη σύνταξη."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d63911e-1230-3736-bdc2-ed4d5fff6f91",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "το ποσό που εισπράττει μηνιαία ένας συνταξιούχος από τον ασφαλιστικό ή συνταξιοδοτικό φορέα του ή το κράτος όταν για λόγους ηλικίας, ή ατυχήματος ή άλλους, παύει να εργάζεται και δικαιούται να συνταξιοδοτηθεί"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb4d64b-152c-4e02-9cea-8b33404541e3",
                                                "sense_id": "2d63911e-1230-3736-bdc2-ed4d5fff6f91",
                                                "text": "Πόση σύνταξη παίρνεις;"
                                            },
                                            {
                                                "example_id": "81f972aa-77b8-44f1-9a5c-330309bd48aa",
                                                "sense_id": "2d63911e-1230-3736-bdc2-ed4d5fff6f91",
                                                "text": "※ Η σύντα­ξή της δεν έφτανε για να πληρώσει πλυστικά κι η δουλειά για τη χωριάτισσα δεν είχε ούτε ντροπή ούτε λυποκράτημα. (Κωσταντίνος Χατζόπουλος, Ο πύργος του ακροπόταμου, Α, 1915)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e1eace9-9ee1-3688-8070-58082a0b1b68",
                                        "entry_id": "fe7a6ffd-3ca9-3bec-bcc7-0fabfe68db4a",
                                        "glosses": [
                                            "καθορισμός των επιτρεπτών ακολουθιών συμβόλων"
                                        ],
                                        "tags": [
                                            "μαθηματικά",
                                            "λογική"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
