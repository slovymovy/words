                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                                        "glosses": [
                                            "Extinct elephant-like mammal of the genus †Mammut that flourished worldwide from Miocene through Pleistocene times; differs from elephants and mammoths in the form of the molar teeth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e25794e-8d41-4d58-8563-4ffef4af58ed",
                                                "sense_id": "e5e391cb-a625-3ace-80b2-f2a05472f07a",
                                                "text": "When, exactly, Europeans first stumbled upon the bones of an American mastodon is unclear. An isolated molar unearthed in a field in upstate New York was sent off to London in 1705; it was labeled the “tooth of a Giant”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                        "entry_id": "037a4dc2-4dd8-3d6f-9dff-c461d3b4f101",
                                        "glosses": [
                                            "Anything awkwardly large or unwieldy."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266300bf-d949-401c-9c2b-4c64d59f6c95",
                                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                                "text": "The battery is dying, and Natalia's iPhone charger doesn't fit my mastodon of a phone anyway."
                                            },
                                            {
                                                "example_id": "cc8f2d08-7aeb-433a-a0b2-2a36b1b99d6c",
                                                "sense_id": "0d7136f1-93c2-348f-ae15-68c3397ef212",
                                                "text": "Nor does it work for governance: the policy has become such a mastodon that we can't adapt it quickly enough to different regions or different circumstances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c6392d5-6adf-4d92-94d0-880972c926dd",
                        "source_entry_id": "c0ee86d4-0b4d-3813-9b9a-448fd5ff383c",
                        "source_sense_id": "327d164d-864a-3e0e-b787-9a1803a8f88d",
