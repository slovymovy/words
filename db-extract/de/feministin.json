                    {
                        "form_id": "00e38dc1-3eda-450a-8c02-90662ff40e2c",
                        "entry_id": "d926046d-a78e-32e5-a7d6-e5d1820429dd",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Feministin"
                    },
                    {
                        "form_id": "1b1fefff-5b05-4e8f-89f9-41f4e673f04f",
                        "entry_id": "d926046d-a78e-32e5-a7d6-e5d1820429dd",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Feministinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                        "entry_id": "d926046d-a78e-32e5-a7d6-e5d1820429dd",
                        "glosses": [
                            "weibliche Person, die sich für den Feminismus (unter anderem Frauenrechte) einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddd0fbc2-c707-44ec-b949-8392bc6f7915",
                                "sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                                "text": "„Die meisten Feministinnen berufen sich auf Judith Butler und die Theorie, dass das Geschlecht nur eine konstruierte Größe sei.“"
                            },
                            {
                                "example_id": "ac7d6ac9-8da0-4e28-b2dd-1c3035f1f8d2",
                                "sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                                "text": "„Tiefgläubige, verkrampfte Muslime, die keinen Alkohol trinken dürfen, und Feministinnen, die mit dem pfälzischen Humor nichts anfangen können, haben dort schlechte Karten.“"
                            },
                            {
                                "example_id": "11ead451-2700-4b8b-8338-2d6f592ffd28",
                                "sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                                "text": "„Einige Feministinnen behaupten, die Gleichstellung zwischen den Geschlechtern wird erst dann vollendet sein, wenn Frauen heimlich vor der Männerumkleide herumhängen, um den Kerlen beim Umziehen zuzusehen.“"
                            },
                            {
                                "example_id": "f6e5447b-3b2d-4a90-b2ce-cfb208106c04",
                                "sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                                "text": "„In ihr regte sich die junge Feministin, die einst für das Frauenwahlrecht demonstriert und gegen die Ungerechtigkeit aufbegehrt hatte, dass Frauen von allen wichtigen Dingen ferngehalten wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f770d99-eefa-42de-97d2-739c4aec2963",
                        "source_entry_id": "d926046d-a78e-32e5-a7d6-e5d1820429dd",
                        "source_sense_id": "9f4defce-0f70-383d-80e1-b1abac84165f",
                        "source_sense_description": "weibliche Person, die sich für den Feminismus (unter anderem Frauenrechte) einsetzt",
                        "target_lang_word": "feminist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feminist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                        "entry_id": "d427520c-6d49-3187-aa78-b47818d5dadd",
                                        "glosses": [
                                            "Relating to or in accordance with feminism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d495edf-aa1a-45a0-b3ce-7feb6053f4cb",
                                                "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                                "text": "Feminist struggle takes place anytime anywhere any female or male resists sexism, sexist exploitation, and oppression."
                                            },
                                            {
                                                "example_id": "22cd97fc-5bc0-4e23-b199-6859290d0795",
                                                "sense_id": "c93f0138-3b4c-3f26-878e-000292c8c5f0",
                                                "text": "Whatever else, Irréversible is already a succès de scandale. [Gaspar] Noé's claims that it is a \"feminist\" movie sound far-fetched, but he certainly offers an extraordinarily pessimistic view of male sexuality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "feminist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a31b5bf4-ce7c-367b-a68d-0654aaefdc3d",
                                        "entry_id": "491ba3b0-2910-35d7-a215-8694cc604bba",
                                        "glosses": [
                                            "An advocate of feminism; a person who believes in bringing about the equality of the sexes (of women and men) in all aspects of public and private life."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21b889c0-c1ec-364c-9130-060881b2def3",
                                        "entry_id": "491ba3b0-2910-35d7-a215-8694cc604bba",
                                        "glosses": [
                                            "A member of a feminist political movement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
