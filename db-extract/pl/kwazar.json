                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2627c16e-4bdf-4463-881e-6b2812494526",
                        "source_entry_id": "de7b0575-c953-3b7a-8d46-dd25256e98e7",
                        "source_sense_id": "dfbfcf18-0bc1-3342-a8d3-fbcb8020d596",
                        "target_lang_word": "cuásar",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuásar",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "92bc1e45-f982-3b5b-9b58-b5dfe2f99ec9",
                                        "entry_id": "a04d6c2c-0510-341d-9725-af1a2b64d4c4",
                                        "glosses": [
                                            "Uno de los mas de mil objetos localizados fuera de nuestra galaxia, parecidos a estrellas pero con espectros con un gran corrimiento hacia el rojo por lo que se piensa que son objetos muy distantes. Son fuente de grandes cantidades de energía electromagnética incluyendo luz. Algunos cuásares muestran cambios rápidos en su brillantes los hay que experimentan estos cambios en cuestión de horas. El consenso de los científicos es que los cuasares obtienen su energía mediante la absorción de materia por parte de agujeros negros super masivos alojados en el núcleo de galaxias distantes, no se ha encontrado otra explicación a la gran energía y rápida variabilidad de los cuásares."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9fc978c6-c3cb-4c35-98a0-7a293f585513",
                        "source_entry_id": "de7b0575-c953-3b7a-8d46-dd25256e98e7",
                        "source_sense_id": "dfbfcf18-0bc1-3342-a8d3-fbcb8020d596",
                        "target_lang_word": "Quasar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Quasar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c49ca58e-c3be-36d1-84d4-3d93754533f3",
                                        "entry_id": "23d9a5b5-5ebe-38f4-8246-d36236d96ae5",
                                        "glosses": [
                                            "als sehr heller Stern erscheinendes astronomisches Objekt im Zentrum von weit entfernten Galaxien, zumeist mit extrem starker Radiofrequenzstrahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8eed37bd-e3ea-40e9-9a06-833c2d27fadb",
                                                "sense_id": "c49ca58e-c3be-36d1-84d4-3d93754533f3",
                                                "text": "„Quasare gehören zu den hellsten Objekten im Kosmos.“"
                                            },
                                            {
                                                "example_id": "4ff0d495-7194-450a-9690-6b12a3aee328",
                                                "sense_id": "c49ca58e-c3be-36d1-84d4-3d93754533f3",
                                                "text": "Die Ähnlichkeit der Prozesse in den Akkretionsscheiben um stellare Schwarze Löcher eröffnet die Möglichkeit, die viel ferneren galaktischen Schwarzen Löcher in Quasaren und aktiven Galaxien besser zu verstehen - via Analogieschlüsse anhand ihrer kleineren Vettern vor unserer kosmischen Haustür."
                                            },
                                            {
                                                "example_id": "c9a6ff0e-b146-4bce-a553-74f61617d204",
                                                "sense_id": "c49ca58e-c3be-36d1-84d4-3d93754533f3",
                                                "text": "Quasare sind ursprünglich hell leuchtende Objekte, die aussehen wie ein Stern. Doch gibt es Hinweise, dass Quasare entstehen, weil Gase im Zentrum einer Galaxie von einem schwarzen Loch verschlungen werden."
                                            },
                                            {
                                                "example_id": "288d9972-fb27-4ffb-a04d-06b338e31c77",
                                                "sense_id": "c49ca58e-c3be-36d1-84d4-3d93754533f3",
                                                "text": "Leuchtende Galaxien, gleißend helle Quasare und glühende Wolken aus heißem Gas: Was Forscher mithilfe von optischen Teleskopen im Weltraum erblicken, ist atemberaubend schön."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef1d3d39-5f2c-4566-8a17-713aad2aece7",
                        "source_entry_id": "de7b0575-c953-3b7a-8d46-dd25256e98e7",
                        "source_sense_id": "dfbfcf18-0bc1-3342-a8d3-fbcb8020d596",
                        "target_lang_word": "квазар",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "квазар",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1390bebf-9f8a-311f-888f-20dc1b97649c",
                                        "entry_id": "2aba6d2e-38a6-3d3c-beb5-78dc27cb3688",
                                        "glosses": [
                                            "астрон. чрезвычайно далекий, внегалактический объект с очень высокой светимостью и малым угловым размером"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3771e0b3-19fc-4008-8521-27b76077f270",
                                                "sense_id": "1390bebf-9f8a-311f-888f-20dc1b97649c",
                                                "text": "Такой квазар, например, размером с Марс, светил бы в триллион раз ярче Солнца."
                                            },
                                            {
                                                "example_id": "43e928cc-6674-4b0c-b725-cc97a0e60979",
                                                "sense_id": "1390bebf-9f8a-311f-888f-20dc1b97649c",
                                                "text": "Тогда же, в 1963 г., я пришел к выводу, что самый яркий квазар 3C 273, хронологически открытый первым (М. Шмидтом на обсерватории Маунт-Паломар), может менять свою яркость."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
