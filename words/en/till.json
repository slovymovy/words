                            {
                                "target_lang_word": "денежный ящик",
                                "target_lang_sense_clarification": "выдвижной ящик для хранения наличных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收银台",
                                "target_lang_sense_clarification": "结账的地点"
                            },
                            {
                                "target_lang_word": "收银机",
                                "target_lang_sense_clarification": "结账的设备"
                            }
                        ]
                    }
