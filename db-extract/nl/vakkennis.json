                                        "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                        "entry_id": "d0d8c267-e755-3c11-8751-a69c78af7ab8",
                                        "glosses": [
                                            "To make a difference; signify; matter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05eb4665-d6fb-4f61-b268-8659c25ae1a7",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "So then the whole scripture of God, being true, whence soever this be delivered and gathered, it skilleth not […]"
                                            },
                                            {
                                                "example_id": "e5bd937f-63bc-45b9-9738-e52c467def77",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "[…] I should have given’t you to-day morning, but as a madman’s epistles are no gospels, so it skills not much when they are delivered."
                                            },
                                            {
                                                "example_id": "176b93b8-8e4b-42fa-a8fe-a189c3c5034e",
                                                "sense_id": "5bd15e1b-fd64-324a-b027-0c3aab0551a7",
                                                "text": "What skills it, if a bag of stones or gold\nAbout thy neck do drown thee?"
