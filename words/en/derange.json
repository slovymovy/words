                    "frequency": "VeryLow",
                    "semantic_group_id": "disruption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I hope my late arrival does not <w>derange</w> your evening plans in any way."
                        },
                        {
                            "text": "The unexpected blizzard managed to <w>derange</w> the entire railway timetable for days."
                        }
                    ],
                    "synonyms": [
