    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "37c8bf91-91df-30f4-88e3-7fd265e004dd",
                    "sense_definition": "Renseignement ou consigne permettant de s'orienter, de savoir ou d'agir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "renseignement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le guide nous a donné une <w>indication</w> précise pour retrouver facilement le chemin du musée."
                        },
                        {
                            "text": "Grâce aux <w>indications</w> d'un passant, nous avons trouvé la gare sans aucune difficulté."
                        }
                    ],
                    "synonyms": [
                        "information",
                        "instruction",
                        "renseignement"
                    ],
                    "common_phrases": [
                        "donner une indication",
                        "fausse indication"
                    ]
                },
                {
                    "sense_id": "9d09a04d-1310-30ef-8ef1-94448f73bd1a",
                    "sense_definition": "Fait, élément ou marque qui permet de déduire ou de reconnaître quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "signe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son hésitation soudaine était une <w>indication</w> évidente de son grand malaise."
                        },
                        {
                            "text": "La baisse du chômage est une bonne <w>indication</w> de la reprise économique du pays."
                        }
                    ],
                    "synonyms": [
                        "signe"
                    ],
                    "common_phrases": [
                        "indication claire"
                    ]
                },
                {
                    "sense_id": "d862052c-8a72-3529-a4b8-7407f97fa556",
                    "sense_definition": "Valeur ou information fournie par un instrument ou un appareil de mesure.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mesure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>indication</w> du thermomètre montre que la température commence enfin à baisser."
                        },
                        {
                            "text": "Le pilote surveille attentivement chaque <w>indication</w> sur le tableau de bord."
                        }
                    ],
                    "common_phrases": [
                        "indication de température"
                    ]
                },
                {
                    "sense_id": "178837d5-4ea0-3ed3-a7ec-68bcd2434337",
                    "sense_definition": "Raison médicale qui justifie la prescription d'un traitement ou la réalisation d'un examen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "médical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette affection pulmonaire constitue la principale <w>indication</w> de ce médicament."
                        },
                        {
                            "text": "Le médecin a confirmé que l'<w>indication</w> chirurgicale était indispensable pour ce patient."
                        }
                    ],
                    "antonyms": [
                        "contre-indication"
                    ],
                    "common_phrases": [
                        "indication médicale",
                        "indication thérapeutique"
                    ]
                }
            ]
        }
    ]
