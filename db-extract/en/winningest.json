                        "examples": [
                            {
                                "example_id": "0a9ec73b-8650-4f3d-864a-4f9bf39e7016",
                                "sense_id": "23bb9829-9d3a-3d7d-8719-da33304fa1e7",
                                "text": "There can be little doubt that Carroll Shelby deserves the high praise he has received from many quarters. On the record he’s America’s winningest big car driver."
                            },
                            {
                                "example_id": "04223b80-3776-4bc3-b6d1-33c6041f4fa0",
                                "sense_id": "23bb9829-9d3a-3d7d-8719-da33304fa1e7",
                                "text": "[Jody Conradt] is the winningest all-time coach in women's basketball with more than 650 victories."
                            },
                            {
                                "example_id": "3b51f5ee-3ac1-4088-8690-b184c09a64d6",
                                "sense_id": "23bb9829-9d3a-3d7d-8719-da33304fa1e7",
                                "text": "In just a few short years, Don Shula turned the Dolphins from a laughingstock expansion team into an NFL dynasty. He then went on to become the winningest coach in NFL history."
                            }
                        ]
