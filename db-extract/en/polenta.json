                                        "entry_id": "652ca4a5-0f93-38e6-9bec-a440e7fe4ff9",
                                        "glosses": [
                                            "densa pietanza preparata con farina di granoturco o castagne bollita in acqua, originaria dell'Italia nordorientale"
                                        ],
                                        "tags": [
                                            "gastronomia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64d076aa-4ec4-4d96-b86e-06f2fb5ab597",
                                                "sense_id": "52ee0a98-2701-3b57-b44c-3c891db9add0",
                                                "text": "\"Chi vuole un po' di polenta fritta con cipolle e gorgonzola?\""
                                            },
                                            {
                                                "example_id": "19906db8-686d-402e-822f-f5863b20ca01",
                                                "sense_id": "52ee0a98-2701-3b57-b44c-3c891db9add0",
                                                "text": "\"Quasi il massimo? Polenta cotta ai ferri ed aringhe affumicate nonché cipolle rosse in agrodolce!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eb64c91-b5af-362c-846f-cdd997230859",
                                        "entry_id": "652ca4a5-0f93-38e6-9bec-a440e7fe4ff9",
                                        "glosses": [
                                            "sostanza o brodaglia di tipo denso e colloso"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6af5637a-44de-366f-8365-d9372e1b26cf",
                                        "entry_id": "652ca4a5-0f93-38e6-9bec-a440e7fe4ff9",
                                        "glosses": [
                                            "persona lenta, processo o fenomeno lento"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62de74b-3ae5-4479-8be4-2c6d4b3d6184",
                                                "sense_id": "6af5637a-44de-366f-8365-d9372e1b26cf",
                                                "text": "muoviti, polenta!"
                                            },
                                            {
                                                "example_id": "47fd9db3-2559-4737-a099-067aef4273ec",
                                                "sense_id": "6af5637a-44de-366f-8365-d9372e1b26cf",
                                                "text": "che polenta, non finisce più!"
                                            }
