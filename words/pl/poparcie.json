{
    "word_family": [
        "poprzeć",
        "popierać"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0faf3460-3093-3d0e-8fab-95e85ad121c6",
                    "sense_definition": "Pomoc, akceptacja lub wsparcie udzielane komuś w działaniu, poglądach lub dążeniach.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "support_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kandydat na prezydenta zyskał duże <w>poparcie</w> wśród młodych wyborców.",
                            "target_lang_translations": {
                                "ru": "Кандидат в президенты получил большую <w>поддержку</w> среди молодых избирателей.",
                                "en": "The presidential candidate gained significant <w>support</w> among young voters."
                            }
                        },
                        {
                            "text": "Mój projekt nie otrzymał wystarczającego <w>poparcia</w> ze strony zarządu.",
                            "target_lang_translations": {
                                "ru": "Мой проект не получил достаточной <w>поддержки</w> со стороны правления.",
                                "en": "My project did not receive sufficient <w>backing</w> from the board."
                            }
                        }
                    ],
                    "synonyms": [
                        "wsparcie",
                        "pomoc",
                        "aprobata",
                        "akceptacja"
                    ],
                    "antonyms": [
                        "sprzeciw",
                        "opór",
                        "dezaprobata"
                    ],
                    "common_phrases": [
                        "udzielić poparcia",
                        "zyskać poparcie",
                        "mieć poparcie",
                        "szerokie poparcie",
                        "wyrazić poparcie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Помощь, одобрение или содействие, оказываемые кому-либо в действиях, взглядах или стремлениях.",
                        "en": "Help, acceptance, or assistance given to someone in their actions, views, or endeavors."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "помощь, содействие"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "согласие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "general help or backing"
                            },
                            {
                                "target_lang_word": "approval",
                                "target_lang_sense_clarification": "acceptance or agreement"
                            },
                            {
                                "target_lang_word": "backing",
                                "target_lang_sense_clarification": "financial or moral support"
                            },
                            {
                                "target_lang_word": "endorsement",
                                "target_lang_sense_clarification": "public declaration of support"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e163d625-89cf-3709-b5de-bf9740e81db2",
                    "sense_definition": "Rzeczownik odczasownikowy od <w>poprzeć</w>: czynność polegająca na opowiedzeniu się po czyjejś stronie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Samo <w>poparcie</w> wniosku przez komisję nie gwarantuje jeszcze jego sukcesu.",
                            "target_lang_translations": {
                                "ru": "Сама <w>поддержка</w> предложения комиссией еще не гарантирует его успеха.",
                                "en": "The mere <w>support</w> of the application by the committee does not yet guarantee its success."
                            }
                        },
                        {
                            "text": "Jego natychmiastowe <w>poparcie</w> dla tego pomysłu wszystkich zaskoczyło.",
                            "target_lang_translations": {
                                "ru": "Его немедленная <w>поддержка</w> этой идеи всех удивила.",
                                "en": "His immediate <w>endorsement</w> of the idea surprised everyone."
                            }
                        }
                    ],
                    "synonyms": [
                        "wspieranie",
                        "popieranie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отглагольное существительное от «poprzeć»: действие, заключающееся в принятии чьей-либо стороны.",
                        "en": "The act of taking someone's side or advocating for a cause; verbal noun from 'to support'."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддержка",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "выражение согласия"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "support",
                                "target_lang_sense_clarification": "the act of backing someone"
                            },
                            {
                                "target_lang_word": "advocacy",
                                "target_lang_sense_clarification": "active support for a cause"
                            },
                            {
                                "target_lang_word": "seconding",
                                "target_lang_sense_clarification": "formally supporting a motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a70aec1b-de79-3646-bd1b-2daf18c4f54b",
                    "sense_definition": "Forma (miejscownik i wołacz liczby pojedynczej) rzeczownika <w>popart</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W <w>poparcie</w> fascynuje mnie przede wszystkim wykorzystanie przedmiotów codziennego użytku.",
                            "target_lang_translations": {
                                "ru": "В <w>поп-арте</w> меня прежде всего восхищает использование предметов повседневного обихода.",
                                "en": "In <w>pop art</w>, I am primarily fascinated by the use of everyday objects."
                            }
                        },
                        {
                            "text": "Wiele mówi się o <w>poparcie</w> w kontekście sztuki amerykańskiej lat sześćdziesiątych.",
                            "target_lang_translations": {
                                "ru": "Много говорят о <w>поп-арте</w> в контексте американского искусства шестидесятых годов.",
                                "en": "Much is said about <w>pop art</w> in the context of American art of the sixties."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "miejscownik i wołacz liczby pojedynczej"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма (предложный падеж) существительного «popart» (поп-арт).",
                        "en": "The locative and vocative singular form of the noun 'popart' (pop art)."
                    },
                    "translations": {
