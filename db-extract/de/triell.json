                                        "entry_id": "7c7a90ec-042c-33ba-9874-ad42de5dee64",
                                        "glosses": [
                                            "A duel fought between three people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2025eeec-9d1e-43b9-a8cf-4757393ac802",
                                                "sense_id": "695715c4-e4e4-3da4-ae99-ef4822534632",
                                                "text": "To effect a yet more complex and challenging truel, we can void the simplification that each player knows his order of firing ab initio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e0739a0-5cb3-374d-b715-b77aebeb2040",
                                        "entry_id": "7c7a90ec-042c-33ba-9874-ad42de5dee64",
                                        "glosses": [
                                            "A conflict between three contending groups or ideas."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": []
                                    }
                                ]
