                "senses": [
                    {
                        "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                        "entry_id": "88973594-9732-36c0-919a-8ac514e9c253",
                        "glosses": [
                            "etwas, das anstelle eines Zauns verwendet wird, denselben Zweck wie ein Zaun erfüllt (um ein Grundstück oder Areal abzugrenzen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82573782-d899-41c0-99ba-47b8c34b9e78",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Hecken dienen uns als Sichtschutz und Zaunersatz.“"
                            },
                            {
                                "example_id": "9c03f68d-a82d-4c81-aada-c562d844699f",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Ein Beispiel, das auch in der Bürgerversammlung angesprochen wurde, war die Gabionenwand - ein aus Drahtgitterkörben und groben Steinen gefertigter Zaunersatz - an der Rosenstraße.“"
                            },
                            {
                                "example_id": "be038d2a-7ff2-4d56-a695-c3b9e6eada6c",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Sie dienen zum Erosionsschutz an Hängen, als lebende Einzäunungen von Wohnstätten und Gärten, als Zaunersatz für Schafe und Ziegen (in der dornigen Form) und somit auch als Schutz vor Witterungsunbilden und schließlich in […]“"
                            },
                            {
                                "example_id": "e67ec8a7-71e2-49ab-a901-36f4b78ce755",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Wo Zäune erspart werden können, sollte es geschehen und da sie nicht ewig halten, erscheint es ratsam, bei ihrer Anlage gleichzeitig Hecken zu pflanzen, die dann einmal den Zaunersatz übernehmen können.“"
                            },
                            {
                                "example_id": "44d3bab9-870d-44a6-9687-c4e1fdee8d71",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Die Zelte sind mit aus Leinen und Tüchern hergestelltem Zaunersatz umgeben, hinter dem der weibliche Teil der Familie Pilze säubert, während sich der männliche am Bootssteg oder mit Surfbrett oder Ruderboot auf dem See aufhält.“"
                            },
                            {
                                "example_id": "328f3e43-d3d7-46ef-b425-d0fae701e3ef",
                                "sense_id": "d11b03a1-b9b2-3565-903d-c465f6bcfdfd",
                                "text": "„Es ist ja klar, daß die Höhe dieses Zaunersatzes eine bestimmte Grenze haben mußte, daß ferner nicht jedes Verbindungsstück sich für diesen Zweck eignete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
