                ],
                "senses": [
                    {
                        "sense_id": "b6c34a01-5a55-36e2-bb32-95acfb9b362b",
                        "entry_id": "443f96ff-9b22-3098-81b2-a0d292491d22",
                        "glosses": [
                            "Arbeitskraft, die zur Rettung eingesetzt wird"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "56ec1056-610b-4875-8041-ab197800bbf0",
                                "sense_id": "b6c34a01-5a55-36e2-bb32-95acfb9b362b",
                                "text": "„Rettungskräfte suchen in den Trümmern von Hotels und Wohnhäusern nach mehr als hundert Vermissten.“"
                            },
                            {
                                "example_id": "8dcac334-0a6f-40d6-b4d5-9d15498992ab",
                                "sense_id": "b6c34a01-5a55-36e2-bb32-95acfb9b362b",
                                "text": "[Erdbeben in der Türkei 2023:] „Noch immer versuchen Rettungskräfte verzweifelt, in den Trümmern verschüttete Menschen zu retten.“"
                            },
                            {
                                "example_id": "dfafb100-5eef-4acc-94dd-9d493c0c0b09",
                                "sense_id": "b6c34a01-5a55-36e2-bb32-95acfb9b362b",
                                "text": "„Das Feuer auf dem Öltanker Annika ist gelöscht. Rettungskräfte verhinderten eine Katastrophe vor der Küste von Mecklenburg-Vorpommern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
