                "word": "klagend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f406e556-df4b-3400-a1ee-fbbf4e0aa6b4",
                        "entry_id": "3d0c112d-3b0e-3cef-aed2-1089a54e8d16",
                        "glosses": [
                            "bezig met het uiten van ongenoegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c55480bc-a9df-4eea-be00-62222a2abd47",
                                "sense_id": "f406e556-df4b-3400-a1ee-fbbf4e0aa6b4",
                                "text": "Enkele klagende omwonenden die zich tot de gemeente Voorst hebben gewend lijken hierin het gelijk aan hun zijde te hebben, zo blijkt uit extern advies dat de gemeente inwon."
                            },
                            {
                                "example_id": "059cfb7b-e3df-48d3-be99-4fee13366f6e",
                                "sense_id": "f406e556-df4b-3400-a1ee-fbbf4e0aa6b4",
                                "text": "KLM krijgt ook vragen of vrouwen met een diep decolleté eveneens een dekentje aangereikt krijgen om zich te bedekken. Vrijenhoek gaat er niet op in en zegt geduldig uit te blijven leggen aan klagende klanten wat het beleid is. ,,Borstvoeding geven mag gewoon aan boord, maar het is aan de inschatting van onze mensen of ze vragen om de blote borst te bedekken.’’"
                            }
                        ]
                    }
