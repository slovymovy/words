                        "form": "die Kronblätter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                        "entry_id": "89374320-a22f-39e2-bc08-59c94ddad8ad",
                        "glosses": [
                            "„Blatt der inneren Blütenhülle in der Blüte von bedecktsamigen Pflanzen“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4af594c-22af-4a81-b400-9bc08966a079",
                                "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                                "text": "„In ihm eingebettet, liegt ein aus zwei Kronblättern verwachsenes gesporntes, Nektar produzierendes Kronblatt.“"
                            },
                            {
                                "example_id": "b41a7133-d76f-4324-a573-ef78c0190731",
                                "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                                "text": "„Zugleich zeigt uns dieser Durchschnitt, wie die Kelchröhre im Interstitium etwas zurückweicht, wie um dem Kronblatt Platz zu machen.“"
                            },
                            {
                                "example_id": "3320546a-5739-4622-a939-8d8a003ea994",
                                "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                                "text": "„Die Zahl der Kelch- und Kronblätter ist bei dieser Art schwankend, ebenso sind Übergangsformen zwischen beiden häufig.“"
                            },
                            {
                                "example_id": "3f1a1657-0f15-4928-ad07-1babb59b2a5f",
                                "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                                "text": "„In ihm eingebettet, liegt ein aus zwei Kronblättern verwachsenes gesporntes, Nektar produzierendes Kronblatt.“"
                            },
                            {
                                "example_id": "5bb55430-5251-4b68-9d46-b110136a1d5b",
                                "sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                                "text": "„Typisch für ihn sind die fünf violetten Kronblätter mit dem weißen Haargitter, den auch der Fransenenzian besitzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a8cefe5-656d-4bf9-95c6-a56c60f7933c",
                        "source_entry_id": "89374320-a22f-39e2-bc08-59c94ddad8ad",
                        "source_sense_id": "cf170c8b-0358-36da-99d7-d768517b4619",
                        "target_lang_word": "pétale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pétale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                        "entry_id": "8905ec8f-091c-3fe2-8ee9-e1789592b987",
                                        "glosses": [
                                            "Organe floral de la corolle, généralement coloré, situé à l’intérieur du calice et à l’extérieur des organes reproducteurs (étamines et pistil)."
                                        ],
                                        "tags": [
                                            "Anatomie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41b66567-7335-4648-95a7-3f41a042dc44",
                                                "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                                "text": "Des anthocyanes donnent aux pétales les teintes qu’il faut pour attirer les abeilles, blanc, rose ou bleu; si ce sont les oiseaux qu’il s’agit d’attirer, les caroténoïdes donneront des couleurs de carottes, jaune orangé ou rouge."
                                            },
                                            {
                                                "example_id": "939656b5-9003-487c-9259-29132c6c829b",
                                                "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                                "text": "Quand c’est fini, quand les derniers pétales sont tous dispersés sur le sol et font un joli tapis rose, on sait que le printemps suivant, on sera toujours aussi étonné et émerveillé par la beauté de ces petits pétales délicats."
                                            },
                                            {
                                                "example_id": "4ad1d891-2b75-41d6-b88f-f3e56365d3d8",
                                                "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                                "text": "Tu baisses la tête, fit M. Firmin en faisant mine d’arracher un quatrième pétale."
                                            },
                                            {
                                                "example_id": "f3a4d940-f556-4f02-8190-8f4695e7cdde",
                                                "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                                "text": "La fleur est actinomorphe, unisexuée avec un calice de 5 sépales et une corolle de 5 pétales libres."
                                            },
                                            {
                                                "example_id": "4698b3aa-0105-42ea-a2e3-2aea131b3e36",
                                                "sense_id": "c149868d-57b7-3143-acac-eecbee5a6380",
                                                "text": "Quant aux « désespoir du peintre », la finesse des petites taches rouges sur le blanc des pétales m’attirait sans que jamais j’aie pu savoir pourquoi leur irréalité me troublait autant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
