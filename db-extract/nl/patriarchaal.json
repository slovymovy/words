                                "target_senses": [
                                    {
                                        "sense_id": "da2cbe7f-cfb7-37a7-9cf9-67d47342e867",
                                        "entry_id": "88fad36e-714f-3bc0-a794-3efccfc3db24",
                                        "glosses": [
                                            "Characteristic of a patriarch; venerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a90c27-d21a-4fa1-9e31-c53e9042301e",
                                                "sense_id": "da2cbe7f-cfb7-37a7-9cf9-67d47342e867",
                                                "text": "About whose patriarchal knee / Late the little children clung."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c413ca04-fec3-3a75-8fe1-f7dc47cafa34",
