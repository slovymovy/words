                        "target_lang_word": "afbreken",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "afbreken",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ebf6d08f-08f5-3fad-aaf0-6a1cc9721818",
                                        "entry_id": "afb98bf2-ffd8-3427-8d64-e01ed55c6239",
                                        "glosses": [
                                            "met de grond gelijk maken"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5dd3406d-97ce-4eb1-8a02-a950f8a90613",
                                                "sense_id": "ebf6d08f-08f5-3fad-aaf0-6a1cc9721818",
                                                "text": "Het huis werd compleet afgebroken."
                                            },
                                            {
                                                "example_id": "8ade95dd-4036-411c-a10f-b1c61b7e02cd",
                                                "sense_id": "ebf6d08f-08f5-3fad-aaf0-6a1cc9721818",
                                                "text": "Bij zonsopkomst was iedereen druk in de weer om het kampement weer af te breken."
                                            },
                                            {
                                                "example_id": "661395e7-0171-4b74-a407-2b507f75ed89",
                                                "sense_id": "ebf6d08f-08f5-3fad-aaf0-6a1cc9721818",
                                                "text": "Afbreken contra opbouwen. Kwaad tegen goed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf87f7eb-d251-3b3e-9e3b-467283a978a1",
                                        "entry_id": "afb98bf2-ffd8-3427-8d64-e01ed55c6239",
                                        "glosses": [
                                            "voortijdig beëindigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58693cbd-230d-45bb-94bd-70bb2f024b94",
                                                "sense_id": "bf87f7eb-d251-3b3e-9e3b-467283a978a1",
                                                "text": "Als een dam-, schaak- of go-partij niet binnen de afgesproken speeltijd beëindigd is, kan deze worden afgebroken."
                                            },
                                            {
                                                "example_id": "3b4457ef-5751-4cab-93b1-bbf957b982ef",
                                                "sense_id": "bf87f7eb-d251-3b3e-9e3b-467283a978a1",
                                                "text": "„Dank jullie wel. Het is goed dat jullie gekomen zijn,” zegt Distel na 120 seconden. De groep mensen gaat uiteen. Anderen pakken hun afgebroken gesprek weer op. Brandweermannen brengen een groet. Een witte auto start zijn dieselmotor en rijdt weg. De burgemeester hurkt voor het monument en kijkt naar de namen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74c1703b-ac85-384a-8868-a10eb07ad935",
                                        "entry_id": "afb98bf2-ffd8-3427-8d64-e01ed55c6239",
                                        "glosses": [
                                            "door breken scheiden"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "796f517c-0b7c-4d75-a79e-f56fcd3678f1",
                                                "sense_id": "74c1703b-ac85-384a-8868-a10eb07ad935",
                                                "text": "Ouweneel pleit er ook voor dat we bij de viering van het avondmaal van één geheel brood ieder telkens een stukje afbreken."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75852179-86fc-3ac8-b489-77939ed25800",
                                        "entry_id": "afb98bf2-ffd8-3427-8d64-e01ed55c6239",
                                        "glosses": [
                                            "ergens vanaf breken, afknappen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ffcf466-08e2-4648-80e9-2d0b3a334f2c",
                                                "sense_id": "75852179-86fc-3ac8-b489-77939ed25800",
                                                "text": "Door de hevige wind waren er takken van de boom afgebroken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
