                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810ff208-0454-4555-92fc-8201101fc086",
                                                "sense_id": "ab871878-6955-3124-9e57-7c31fcb58643",
                                                "text": "Lange hat Benjamin es an der Seite seiner Frau Hilde nicht ausgehalten."
                                            },
                                            {
                                                "example_id": "16a14915-aad7-401b-9c97-74c06b244e2b",
                                                "sense_id": "ab871878-6955-3124-9e57-7c31fcb58643",
                                                "text": "„Benjamin zeigte sich angemessen beeindruckt, konnte den Blick kaum von den wandhohen Regalen mit Büchern abwenden, sah in jede temperaturgesteuerte Vitrine und ließ die Augen über meine und Amalias Arbeitsflächen unter den gelblichen Neonröhren in der Mitte der Bibliothek wandern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
