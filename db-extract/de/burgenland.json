                        ],
                        "form": "das Burgenland"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                        "entry_id": "d3700bd1-e190-32d3-aec4-63d82a43c11b",
                        "glosses": [
                            "ein Bundesland der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db426703-1878-4b5f-89bd-127bc985fc10",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "Das Burgenland ist das jüngste Bundesland der Republik Österreich."
                            },
                            {
                                "example_id": "e1d94764-da3f-4fc4-aee9-9e885c044291",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "Im Burgenland sind neben der deutschsprachigen Bevölkerung die Minoritäten der burgenländischen Kroaten, Ungarn und Roma beheimatet."
                            },
                            {
                                "example_id": "8b2e2ad6-d141-4857-b92c-1722f0fd888d",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "Mittlerweile ist das Burgenland zwar kein Ziel-eins-Gebiet mehr, wie die strukturschwachen und damit förderungswürdigen EU-Regionen genannt werden. Aber das sogenannte Phasing-out läuft noch bis 2013."
                            },
                            {
                                "example_id": "a9530552-6596-4a0a-a046-fa6b59ee777f",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "„Das Burgenland ist ein modernes, sehr lebenswertes Bundesland geworden“, sagt Christof Schremmer, Experte für Regionalentwicklung am Institut für Raumplanung."
                            },
                            {
                                "example_id": "256d6f27-4a9a-440b-aa83-96386aea3032",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "Im Burgenland gibt es die richtigen Schweinerassen, die besten Mastochsen, dreitausend Paradeisersorten und Konfitüren aus kleinen Manufakturen."
                            },
                            {
                                "example_id": "66816a8f-7b3e-4174-9d00-8488c1c0bb2a",
                                "sense_id": "953fd5fc-a332-366c-95c5-8cf97d1a1c71",
                                "text": "„Mit der Vollendung des flächendeckenden Netzes von Allgemeinbildenden Höheren Schulen war Burgenlands Jugend nunmehr befähigt, ihre Ausbildung an Österreichs Universitäten fortzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
