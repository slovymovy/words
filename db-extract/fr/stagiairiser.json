                "senses": [
                    {
                        "sense_id": "00518c98-fba6-3db4-8332-7e86906b07e5",
                        "entry_id": "1314b074-470c-389f-aee3-e6567a606127",
                        "glosses": [
                            "Prendre comme stagiaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6479bd0d-5702-441c-b4f7-da1db1af3409",
                                "sense_id": "00518c98-fba6-3db4-8332-7e86906b07e5",
                                "text": "Pour pouvoir recruter Gilles Leperlier qui vient de l’Etang-Salé, Maurice Gironcel, maire de Sainte-Suzanne, a dû stagiairiser en vue d’une titularisation un autre \"camarade\" qui, lui, originaire de Saint-Louis, et accessoirement pigiste à Témoignages, était déjà en poste à la Cinor."
                            },
                            {
                                "example_id": "ba170858-c868-44a6-833d-8b5f2530f22e",
                                "sense_id": "00518c98-fba6-3db4-8332-7e86906b07e5",
                                "text": "Il me semble que dans ton cas, la commune peut attendre que tu soies à la fin de ton contrat pour décider de te stagiairiser."
                            }
                        ]
                    }
                ],
