                "senses": [
                    {
                        "sense_id": "04d08dea-7ed5-3a64-9c1f-f0ddb08a5eff",
                        "entry_id": "09445815-6450-3c2c-b8c2-a8d41eab0e5a",
                        "glosses": [
                            "проф. мастер по производству, ремонту и использованию сит"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d7a443-388d-4038-83fa-43d6f77eec43",
                                "sense_id": "04d08dea-7ed5-3a64-9c1f-f0ddb08a5eff",
                                "text": "Работа ситника требует крайнего напряжения зрения — все ситники жалуются на болезни глаз."
                            }
                        ]
                    },
                    {
                        "sense_id": "05d3f650-c0be-3aa4-ba76-a0c110f013b2",
                        "entry_id": "09445815-6450-3c2c-b8c2-a8d41eab0e5a",
                        "glosses": [
                            "устар., проф. подмастерье или подсобный рабочий на мельнице, просеивающий помол"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "07ddf4a9-7822-3bd7-a73d-0e063849e311",
                        "entry_id": "09445815-6450-3c2c-b8c2-a8d41eab0e5a",
                        "glosses": [
                            "устар. ситной хлеб (из просеянной муки)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b687c45-5e83-487f-8c0a-3335fe27ef6d",
                                "sense_id": "07ddf4a9-7822-3bd7-a73d-0e063849e311",
                                "text": "Григорий в семинарии в час ночи просыпается и уж потом до солнышка не спит — ждёт жадно ситника, который выдавался им со сбитнем по утрам"
                            }
                        ]
                    }
                ],
