                                    {
                                        "sense_id": "b9853438-ecc6-36ff-9d69-0bc0ae197a2b",
                                        "entry_id": "92c80ed3-d682-386d-a097-1ba0324fc135",
                                        "glosses": [
                                            "To determine the value of something or the solution to something by a mathematical process."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7cc279e-9060-476d-9367-1ed4d767f8c2",
                                                "sense_id": "b9853438-ecc6-36ff-9d69-0bc0ae197a2b",
                                                "text": "Calculate the square root of 3 to 10 decimal places."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ef83f4-e401-3cc3-ad54-26e5ac8e47e8",
