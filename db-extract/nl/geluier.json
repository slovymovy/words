                        "examples": [
                            {
                                "example_id": "8e548996-dd60-4a3c-a854-5d04755c4c76",
                                "sense_id": "a0492166-ad4f-33ff-8e76-e5d5de5edf76",
                                "text": "Frank: ,,Wat een fantastische week was dit. Van 's ochtends vroeg tot 's avonds laat live muziek zien en horen. Wat een genot! Ik ben moe maar fucking voldaan. En niks geen geluier, dit weekend ga ik gewoon weer naar het Dauwpop festival.\""
                            },
                            {
                                "example_id": "cda8d07e-c309-4ba5-8397-91dd5f0c8b0f",
                                "sense_id": "a0492166-ad4f-33ff-8e76-e5d5de5edf76",
                                "text": "Absoluut geen geluier vandaag voor radiomaker en kunstenaar Ruud Wild. Hij zat een groot deel van de dag in zijn atelier."
                            },
                            {
                                "example_id": "d0b2e39e-1d7a-47fd-af76-126a3eafb2ac",
                                "sense_id": "a0492166-ad4f-33ff-8e76-e5d5de5edf76",
                                "text": "Terug op de camping gaan de zere voeten omhoog en besluiten we dat er toch even geluierd mag worden. In de deuropening van de caravan naast ons pingelt een man op zijn gitaar en langzaam dommelen we in slaap."
                            }
                        ]
                    }
