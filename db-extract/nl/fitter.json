                                        "entry_id": "e6f52add-effa-331c-a36a-e7ddac136a47",
                                        "glosses": [
                                            "A person who fits or assembles something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3056a9f1-5b1b-4d0b-951a-c37f8e47b1e4",
                                                "sense_id": "4308407b-2e17-3fc4-b387-834bdb9df78c",
                                                "text": "a fitter of clothing, or of machinery"
                                            },
                                            {
                                                "example_id": "9d8a2778-1542-4605-8fb8-b2cbf1bb5146",
                                                "sense_id": "4308407b-2e17-3fc4-b387-834bdb9df78c",
                                                "text": "But in the early days of the scheme the new machines created some problems for the fitters, who found them over-complex and their faults hard to diagnose after many years' experience of small, simple steam locomotives."
                                            },
                                            {
                                                "example_id": "02d8dbc3-c3cb-4ea8-838b-2d9fffb3f3a5",
                                                "sense_id": "4308407b-2e17-3fc4-b387-834bdb9df78c",
                                                "text": "\"They have gone past their sell-by date. But the fitters have done an amazing job keeping these units running for as long as they have."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4a8a104-65a8-30e2-ad5e-0b0c02fc19c0",
                                        "entry_id": "e6f52add-effa-331c-a36a-e7ddac136a47",
                                        "glosses": [
