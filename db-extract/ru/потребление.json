                "senses": [
                    {
                        "sense_id": "b61642a4-276e-34e7-877a-73cf4062a9f0",
                        "entry_id": "15ae22cf-54b7-3c12-b1f2-f20d680740cc",
                        "glosses": [
                            "использование продукта в процессе удовлетворения потребностей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f8dafd9-572a-471b-84d8-175036d65039",
                                "sense_id": "b61642a4-276e-34e7-877a-73cf4062a9f0",
                                "text": "При продолжении потребления после окончания эйфории наступает «синдром отмены», сначала маловыраженный, потом мучительный."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0cbd4c8c-efe0-4665-9e17-b3464801755f",
                        "source_entry_id": "15ae22cf-54b7-3c12-b1f2-f20d680740cc",
                        "source_sense_id": "b61642a4-276e-34e7-877a-73cf4062a9f0",
                        "target_lang_word": "consumption",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consumption",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81d6f50b-dd8c-320b-8675-38b2bb0c0da5",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The act of eating, drinking or using."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a1af58-875f-44a5-94b5-3dfa8c75a7c8",
                                                "sense_id": "81d6f50b-dd8c-320b-8675-38b2bb0c0da5",
                                                "text": "The consumption of snails as food is more common in France than in England."
                                            },
                                            {
                                                "example_id": "59e82b28-5b1c-4ecd-b6aa-bb8cd651b603",
                                                "sense_id": "81d6f50b-dd8c-320b-8675-38b2bb0c0da5",
                                                "text": "A Guardia Civil spokesperson said that ayahuasca, San Pedro, toad poison, wild rue and mimosa pudica were prohibited substances in Spain, adding that their consumption was not authorised because, while they were natural substances, they could be highly dangerous to human health."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1658b61-784f-3a56-80be-c5a863eee988",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The amount consumed."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c339f2-8f19-4fb4-9728-771096f83229",
                                                "sense_id": "d1658b61-784f-3a56-80be-c5a863eee988",
                                                "text": "gross national consumption"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The act of consuming or destroying."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2db89d0-3a8d-4c53-9396-1418865455e6",
                                                "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                                "text": "The fire's consumption of the forest caused ecological changes."
                                            },
                                            {
                                                "example_id": "7da5ed1a-0f79-4413-8ebe-b69c8906cb61",
                                                "sense_id": "cd1f2cb9-0aea-3aa8-ba38-5db90a924c00",
                                                "text": "Driving methods have a direct bearing on fuel consumption with every type of motive power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82202a84-7bd1-371b-8c6f-29df8487fe38",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "The wasting away of the human body through disease."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "811c61f7-4f42-3148-8f9a-0e5c6584d3fe",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "Pulmonary tuberculosis and other diseases that cause wasting away, lung infection, etc."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "646dc71a-186a-4317-9e01-55c91cefb7d7",
                                                "sense_id": "811c61f7-4f42-3148-8f9a-0e5c6584d3fe",
                                                "text": "And then as to your ſcurvys, and gouts, rheumatiſms, conſumptions, coughs and catarrhs, tar-vvater and turpentine vvill make you as ſound as a roach."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad969eeb-a585-3d64-a2e3-2b50fc9f9ef0",
                                        "entry_id": "8ade1f9b-ee8d-3dda-ba3e-2599bd997299",
                                        "glosses": [
                                            "Alcoholism as it precipitates a person's death (especially of natural causes)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "euphemistic",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ca34f8f-6ea8-418c-a3e6-9c76228260ea",
                        "source_entry_id": "15ae22cf-54b7-3c12-b1f2-f20d680740cc",
                        "source_sense_id": "b61642a4-276e-34e7-877a-73cf4062a9f0",
                        "target_lang_word": "consommation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consommation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86ed10cf-8296-3773-8f70-164b2156e743",
                                        "entry_id": "f2751518-20f9-37b0-bdde-63790dc8725f",
                                        "glosses": [
                                            "Action de mener une œuvre à son plein achèvement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ab40517-1553-413b-8f84-5e366a438391",
                                                "sense_id": "86ed10cf-8296-3773-8f70-164b2156e743",
                                                "text": "Puissions-nous retrouver le courage et la foi de nos aïeux ! Soldat de l’Église militante, je sais que le combat ne finira qu’à la consommation des siècles."
                                            },
                                            {
                                                "example_id": "aa71c3a2-990a-4d09-940d-ce4892a6430e",
                                                "sense_id": "86ed10cf-8296-3773-8f70-164b2156e743",
                                                "text": "La consommation d’une affaire. - La consommation d’un sacrifice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54812a46-7f8b-35d4-a013-9900655c2cc1",
                                        "entry_id": "f2751518-20f9-37b0-bdde-63790dc8725f",
                                        "glosses": [
                                            "Relation sexuelle entre des époux suivant leur cérémonie nuptiale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c5be118-8126-4fdb-9730-e01b5a7299f2",
                                                "sense_id": "54812a46-7f8b-35d4-a013-9900655c2cc1",
                                                "text": "Il en résulte que la consommation du mariage demeure une notion clef. C'est pourquoi, outre l’impuberté, l’impuissance de l'un ou l'autre des époux constitue un empêchement dirimant, absolu et est une cause incontestable d’annulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b68e5aa-37de-3be9-a13b-7747e658423f",
                                        "entry_id": "f2751518-20f9-37b0-bdde-63790dc8725f",
                                        "glosses": [
                                            "Relation sexuelle d'un couple, qu'il soit marié ou pas."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f824a7b2-c16c-462d-805b-e01642a075a9",
                                                "sense_id": "9b68e5aa-37de-3be9-a13b-7747e658423f",
                                                "text": "Soit les assauts du conquistador s'arrêtaient au seuil de la couche, soit, si la consommation avait lieu, se déchaînaient ensuite une succession interminable d'examens médicaux : sida, syphilis, gonocoque, staphylocoque et j'en passe..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43cf041-59f9-3df3-a831-64589c7cb2a2",
                                        "entry_id": "f2751518-20f9-37b0-bdde-63790dc8725f",
                                        "glosses": [
                                            "Utilisation de choses qui se détruisent par l’usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1d0aeee-eb69-4309-a5fb-8b6667b53a9a",
                                                "sense_id": "a43cf041-59f9-3df3-a831-64589c7cb2a2",
                                                "text": "Les dépenses de simple consommation sont des dépenses qui s'anéantissent elles-mêmes sans retour ; elles ne peuvent être entretenues que par la classe productive, qui, quant à elle, peut se suffire à elle-même."
                                            },
                                            {
                                                "example_id": "bd566809-eeb1-42cb-a54a-f02d7c2850be",
                                                "sense_id": "a43cf041-59f9-3df3-a831-64589c7cb2a2",
                                                "text": "La bière est une boisson rafraîchissante, saine et nourrissante, […] ; à Londres, par exemple, la consommation locale s'élève annuellement au-delà de 250 millions de litres."
                                            },
                                            {
                                                "example_id": "f5abf88b-3801-4f2b-8dc1-36f70feb9bd2",
                                                "sense_id": "a43cf041-59f9-3df3-a831-64589c7cb2a2",
                                                "text": "La consommation d'essence était depuis une huitaine d'heures nettement inférieure à nos estimations, pourtant très tirées."
                                            },
                                            {
                                                "example_id": "fd31f76b-9645-4306-828c-5b8c9dd9f376",
                                                "sense_id": "a43cf041-59f9-3df3-a831-64589c7cb2a2",
                                                "text": "[…] ; les villages traversés, sans perdre beaucoup de leur rusticité primitive, montrent cependant ces traces noirâtres, ces tas d'escarbilles que crée toujours la consommation fréquente de la houille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbfa172-5185-34f4-8c6f-1b218df1e036",
                                        "entry_id": "f2751518-20f9-37b0-bdde-63790dc8725f",
                                        "glosses": [
                                            "Ce que l’on a bu ou mangé dans un restaurant, un café ou un bar."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f275cdb-5f0c-465f-9ced-75ba52a0fe2f",
                                                "sense_id": "3dbfa172-5185-34f4-8c6f-1b218df1e036",
                                                "text": "Si la buvette est ouverte, il me paraît que les consommateurs n’y peuvent trouver qu’un choix restreint de consommations."
                                            },
                                            {
