                                "target_word": "peloponnesisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2447d1c5-93f7-38e7-8c35-ae5b3d6a7307",
                                        "entry_id": "e2e5553b-f1d7-3cbb-808f-9ae992beac91",
                                        "glosses": [
                                            "den Peloponnes betreffend; zum Peloponnes gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16aa7e13-4597-4817-b448-c0f76acdb834",
                                                "sense_id": "2447d1c5-93f7-38e7-8c35-ae5b3d6a7307",
                                                "text": "In Griechenland brennt es vor allem auf der peloponnesischen Halbinsel."
                                            },
                                            {
                                                "example_id": "1fa067e1-7fcc-4c74-83c1-ffd86666c72b",
                                                "sense_id": "2447d1c5-93f7-38e7-8c35-ae5b3d6a7307",
                                                "text": "Rasch durchschnitt die peloponnesische Flotte die schmale Meerenge; den Athenern blieb keine Zeit, ihre Schiffe zu bemannen oder gar sich in Schlachtordnung aufzustellen."
                                            },
                                            {
                                                "example_id": "ee5703e0-ab1e-485b-965d-2d10a446b344",
                                                "sense_id": "2447d1c5-93f7-38e7-8c35-ae5b3d6a7307",
                                                "text": "Im Mai 431 brach der spartanische König Archidamos in Attika ein, dessen Bewohner Zeit gehabt hatten, sich in die Stadt zu flüchten; er zog aus dem verwüsteten Lande bald ab, während Perikles die peloponnesische Küste angriff und die Athener glückliche Taten zur See verrichteten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
