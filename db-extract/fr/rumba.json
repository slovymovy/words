                    {
                        "sense_id": "f8628cb2-1eb1-377a-9128-210d75901211",
                        "entry_id": "2c75d562-29a7-3f7a-9e1f-59163d02505c",
                        "glosses": [
                            "Musique cubaine fait de chants et de percussions apparue au XIX^(ème) siècle dans le milieu afro-cubain de La Havane."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a37863-8383-485a-9df2-89c0ad9e7896",
                                "sense_id": "f8628cb2-1eb1-377a-9128-210d75901211",
                                "text": "Le saxo dévastateur de Gato Barbieri sacrifiait une rumba au jazz dans le petit appareil à cassettes, à moins que ce ne fût une samba. Une percussion latine, en tout cas."
                            },
                            {
                                "example_id": "5da6455e-3457-4b7a-b6bd-047762d5805f",
                                "sense_id": "f8628cb2-1eb1-377a-9128-210d75901211",
                                "text": "On écoutait de la musique toute la journée et je découvrais de nouveaux styles comme le highlife, l’afrobeat, le funk, la soul, la rumba."
                            }
                        ]
                    },
                    {
                        "sense_id": "48dab558-7282-37be-8939-5426bd460320",
                        "entry_id": "2c75d562-29a7-3f7a-9e1f-59163d02505c",
                        "glosses": [
                            "Style de danse sur cette musique ou sur tout autre rythme latino."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "493fa2e2-726c-48a3-8bf7-52e8be4015e1",
                                "sense_id": "48dab558-7282-37be-8939-5426bd460320",
                                "text": "Un rien : souvent les crimes parfaits courent à l’échec parce que, une fois le gros du travail accompli, les coupables ne peuvent résister à l’envie de prendre une petite coupe de champagne sur la tombe de leur victime, ou de danser la rumba sur le cadavre, ce qui n’est pas de la profanation de sépulture mais de l’imbécillité pure."
                            }
                        ]
                    }
