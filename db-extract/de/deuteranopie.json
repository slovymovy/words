                "senses": [
                    {
                        "sense_id": "8fd59a32-4f2f-305b-8705-8aca90da217b",
                        "entry_id": "9c48fd4e-664b-3272-815f-068964e9cff6",
                        "glosses": [
                            "Unfähigkeit, die Farbe Grün zu erkennen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b1934b3-77c0-42e9-8153-1bc11411a4be",
                                "sense_id": "8fd59a32-4f2f-305b-8705-8aca90da217b",
                                "text": "„Bei der Deuteranopie (Grünblindheit) fehlen die Grünzapfen, bei Protanopie (Rotblindheit) die Rotzapfen.“"
                            },
                            {
                                "example_id": "fb0d57c2-c919-4c6f-bca9-acefbacc802b",
                                "sense_id": "8fd59a32-4f2f-305b-8705-8aca90da217b",
                                "text": "„Es gibt drei Arten von Farbenblindheit: Protanopie (Rotblindheit), Deuteranopie (Grünblindheit) und Tritanopie (Blaublindheit).“"
                            },
                            {
                                "example_id": "fd755e06-6816-47b9-a6cc-c9ee6dcfe8ef",
                                "sense_id": "8fd59a32-4f2f-305b-8705-8aca90da217b",
                                "text": "„Hunde sind damit von Natur aus zumindest ähnlich gut ausgestattet wie Menschen, die unter einer partiellen Farbenblindheit, der sogenannten Grünblindheit (Deuteranopie), leiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
