                "senses": [
                    {
                        "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                        "entry_id": "10eae574-81d8-32cb-8834-ac70d10b134b",
                        "glosses": [
                            "die in der Wirtschaftswerbung verwendeten Sprachmittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a76a4ad-b7f1-47d7-b5b5-c2ddfcdf9242",
                                "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                                "text": "Der Ausdruck Werbesprache meint meist nur die Imagewerbung oder die Produktwerbung; andere Formen von Werbung wie Wahlwerbung werden davon unterschieden."
                            },
                            {
                                "example_id": "4086f57a-2234-48af-9ad5-34ee0b762048",
                                "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                                "text": "„Allerdings bringt auch die Werbesprache gegenwärtig Wortschöpfungen hervor, soweit nicht verschiedene Verfahren der Kurzwortbildung genutzt werden…“"
                            },
                            {
                                "example_id": "dbd6375b-92df-4289-9a5b-d49e6975f028",
                                "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                                "text": "„Gerade solche neugebildeten Vokabeln werden meist als Hauptkennzeichen der Werbesprache angesehen…“"
                            },
                            {
                                "example_id": "f78851bf-0d99-4a1d-80cc-967eeb5760c0",
                                "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                                "text": "„Doch die Werbesprache ist nicht identisch mit der Reklamesprache.“"
                            },
                            {
                                "example_id": "e5538a76-6907-4ef3-861e-fbc34fd3ec73",
                                "sense_id": "5ad44b60-6e81-3b40-a2ba-25e4237bca89",
                                "text": "„Politik bedient sich heutzutage zunehmend der Mittel von Werbesprache, arbeitet mit inhaltsleeren Slogans, deren Verpackung blendet und verblendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
