                                        "sense_id": "5d65a9a1-c436-32ce-b51e-14223364fb2b",
                                        "entry_id": "dc56c901-da78-3c88-b083-eaceec7d4b13",
                                        "glosses": [
                                            "sich vollkommen gleichend, vollkommen gleich, vollkommen gleichartig, übereinstimmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82d61747-7b06-41b8-91fe-e2a8fdb4cd14",
                                                "sense_id": "5d65a9a1-c436-32ce-b51e-14223364fb2b",
                                                "text": "Diese Etiketten sind nicht identisch."
                                            }
                                        ],
