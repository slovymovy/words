        "fr-extract.jsonl": [
            {
                "entry_id": "e646fa6b-e7f1-39d5-977c-7f0d983bd5e4",
                "word": "plumetis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "80ea20be-f24b-395c-999e-a8b9e2296ef2",
                        "entry_id": "e646fa6b-e7f1-39d5-977c-7f0d983bd5e4",
                        "glosses": [
                            "Broderie exécutée en relief et fortement bourrée."
                        ],
                        "tags": [
                            "Broderie"
                        ],
                        "examples": [
                            {
                                "example_id": "956d4ce3-dca2-4901-aaf1-8a2ca5c08464",
                                "sense_id": "80ea20be-f24b-395c-999e-a8b9e2296ef2",
                                "text": "Broder au plumetis."
                            },
                            {
                                "example_id": "147d3cad-310c-4f4b-a720-b6cefdfeef2c",
                                "sense_id": "80ea20be-f24b-395c-999e-a8b9e2296ef2",
                                "text": "Le pavillon était, au coin d’une petite rue muette de Neuilly, tout blanc et vert, avec des voilages de plumetis aux fenêtres."
                            },
                            {
                                "example_id": "fdb6fffd-8337-44f5-80ad-7ad9226c43c8",
                                "sense_id": "80ea20be-f24b-395c-999e-a8b9e2296ef2",
                                "text": "Mais je sabotais les ourlets, les surjets, les reprises, les festons, le point de croix, le plumetis, le macramé."
                            },
                            {
                                "example_id": "98fe1f71-bec5-4a91-8b18-a02388c6fa9e",
                                "sense_id": "80ea20be-f24b-395c-999e-a8b9e2296ef2",
                                "text": "Dany se leva, rangea l’album dans le tiroir de sa coiffeuse recouverte de plumetis et quitta la chambre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1880284f-ae42-3fe7-a2a2-d59df0c598a8",
                        "entry_id": "e646fa6b-e7f1-39d5-977c-7f0d983bd5e4",
                        "glosses": [
                            "Édredon en plumes ou édredon en piqué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4546967-26ba-408f-8d00-441536cfdd78",
                                "sense_id": "1880284f-ae42-3fe7-a2a2-d59df0c598a8",
                                "text": "Le lit, composé d'un gros plumetis posé sur un énorme sommier de balle d'avoine."
                            }
                        ]
                    }
                ],
