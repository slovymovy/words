                    {
                        "sense_id": "333952d5-a055-3c99-995a-83a30b7766d7",
                        "entry_id": "e80a44db-f217-3cd3-abbd-7a627a9338bb",
                        "glosses": [
                            "Sorte de couteau pointu, à lame fixe, à un ou deux tranchants, dont on se sert pour disséquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135aa98a-1c49-42f1-a0cf-8d4a9724b73e",
                                "sense_id": "333952d5-a055-3c99-995a-83a30b7766d7",
                                "text": "Le scalpel du chirurgien."
                            },
                            {
                                "example_id": "016ece93-920c-4517-8fa1-1787640daeae",
                                "sense_id": "333952d5-a055-3c99-995a-83a30b7766d7",
                                "text": "Le scalpel de la critique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411b4ee9-3723-4500-8ee9-7c126b55ad50",
                        "source_entry_id": "e80a44db-f217-3cd3-abbd-7a627a9338bb",
                        "source_sense_id": "333952d5-a055-3c99-995a-83a30b7766d7",
                        "target_lang_word": "Skalpell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Skalpell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                        "entry_id": "0316e079-21ec-3be1-ab66-1b3f49d10339",
                                        "glosses": [
                                            "in der Chirurgie eingesetztes, kleines Messer zum Durchtrennen von Gewebe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6108bfe0-781c-49b9-872e-42c96fdac327",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "Die OP-Schwester reichte dem Chirurgen das benötigte Skalpell."
                                            },
                                            {
                                                "example_id": "ac339410-24c7-4e65-8998-8cd6ed8142e8",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Er möchte nämlich eine Trepanation durchführen und mit dem Skalpell eine bestimmte Partie des rechten Gehirnlappens einritzen.“"
                                            },
                                            {
                                                "example_id": "0e1d1751-4755-4656-82cc-80a5cb8c75f9",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Dann holte er plötzlich mit einem kühnen Schwung aus, wobei die Spitze des Skalpells ihre Haut nur gerade eben berührte.“"
                                            },
                                            {
                                                "example_id": "6a469e42-22a7-4ff2-8bf8-84a95d922563",
                                                "sense_id": "5fc68d1d-e44f-3650-8642-b72dc4bea702",
                                                "text": "„Das scharf bestrahlte Gesicht im Spiegel wurde fremd wie eine belebte Maske, als die Hände nach den Skalpells der Pinsel griffen wie nach den Waffen eines Chirurgen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab313fa1-7d33-45a8-abdf-f2b3cbaf317d",
                        "source_entry_id": "e80a44db-f217-3cd3-abbd-7a627a9338bb",
                        "source_sense_id": "333952d5-a055-3c99-995a-83a30b7766d7",
                        "target_lang_word": "Lanzette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lanzette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                        "entry_id": "0e5e7646-ee87-3f61-82b1-aa073ad82a5f",
                                        "glosses": [
                                            "medizinisches Gerät: kleines, zweischneidiges Messer oder Nadel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3e9087-ca2c-463e-817e-40b069baafcd",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Ich weiß nicht, was mich Halbtoten veranlaßte, die Augen zu öffnen; da sah ich den Mann mit der Lanzette, der dabei war, mir die Vene aufzustechen.“"
                                            },
                                            {
                                                "example_id": "e76c384a-28cb-45d0-98e4-7f0cdb7c8b97",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Nun legten sie großen Eifer für die Schutzpockenimpfung an den Tag, lernten an Kohlblättern zur Ader lassen und schafften sich sogar ein paar Lanzetten an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
