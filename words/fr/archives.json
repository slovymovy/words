            "senses": [
                {
                    "sense_id": "20c4bb3a-0c2b-3462-84b8-f0632740de07",
                    "sense_definition": "Ensemble de documents historiques ou administratifs conservés pour être consultés au besoin.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "documents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'historien consulte les vieilles <w>archives</w> de la commune pour rédiger son prochain ouvrage."
                        },
                        {
                            "text": "Toutes les <w>archives</w> de la famille ont été numérisées afin d'éviter qu'elles ne s'abîment avec le temps."
                        }
                    ],
                    "synonyms": [
                        "dossiers",
                        "registres"
                    ],
                    "common_phrases": [
