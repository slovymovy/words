                                    {
                                        "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                        "entry_id": "f4601f9d-574a-355d-994c-d006f3b4aeba",
                                        "glosses": [
                                            "Distinctive, characteristic, indicative of identity."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a3c6e4-3c24-4060-afa7-18243a3bc7c8",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "In its gallant effort to shun the mass-market fragrance industry for something more personal, Le Labo has, unwittingly, created the most ubiquitous scent in fashion; a signature scent that is so signature you can recognize it in every city in the world[…]."
                                            },
                                            {
                                                "example_id": "f016ad47-7e87-4d13-992f-161d3a32e17a",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Rabbit in mustard sauce is my signature dish."
                                            },
                                            {
                                                "example_id": "dd829f52-6a24-41a1-bccb-b9b12fd24bab",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "The signature route of the airline is its daily flight between Buenos Aires and Madrid."
                                            },
                                            {
                                                "example_id": "10109266-f9cc-459e-ac3c-b11f603c71f1",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Consider Las Fallas of Valencia, Spain, arguably the most signature of signature ephemera."
                                            },
                                            {
                                                "example_id": "41c59971-33e6-4192-80cd-0f230fd924ea",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Considered the most signature effect of the Tudor Revival style, half-timbering derived its distinctive[…]."
                                            },
                                            {
                                                "example_id": "4f4c7d80-07d3-4642-8017-74c63bba7d33",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "But it was perhaps the most signature shot Williams ever made in an Illinois uniform, a bullying basket in which he used his power to pound Stoudamire,[…]."
                                            },
                                            {
                                                "example_id": "ea0051d4-bc06-48db-96bd-98d5fb469703",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "He credited his wife, who is British, for giving him the inspiration for Tigger’s signature phrase: TTFN. TA-TA for now."
                                            },
                                            {
                                                "example_id": "91dfaa86-91be-407a-96f1-54506ca01cbe",
                                                "sense_id": "f8ccf859-9597-3965-af2d-a061e1efea1d",
                                                "text": "Restaurant staff were in the process of serving Le Caprice's signature dessert: frozen berries with a hot white chocolate sauce."
                                            }
                                        ]
                                    }
                                ]
                            }
