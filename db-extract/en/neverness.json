                        "entry_id": "a5f882f5-023d-3e38-b32a-e5e7e6224d8e",
                        "glosses": [
                            "The quality of being never, of not ever being extant or present."
                        ],
                        "tags": [
                            "rare",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6110789f-704a-4be1-9860-664353aff712",
                                "sense_id": "d8fd9ca9-62ae-3e73-a466-0652c0b829f3",
                                "text": "He felt a lump in his throat and a hotness in his eyes as he thought of the neverness of her."
                            },
                            {
                                "example_id": "f635165f-fb00-4fcc-a8b2-8c1e76059288",
                                "sense_id": "d8fd9ca9-62ae-3e73-a466-0652c0b829f3",
                                "text": "Reader and writer come together to accomplish the negative, to occupy an alternative to the present. In this threshold instant called reading, we bridge the gap of now and never. The neverness of fiction, what never happened, happens now."
                            }
                        ]
                    }
                ],
