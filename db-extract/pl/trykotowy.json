                ],
                "senses": [
                    {
                        "sense_id": "49e595d0-20b8-32b6-95b7-1beaac691ef9",
                        "entry_id": "65285a98-8014-34f7-8329-48b2fd523cb8",
                        "glosses": [
                            "odnoszący się do trykotu; zrobiony z trykotu; służący do wyrobu trykotaży"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5a87ca73-7673-466e-b450-6e6c42a4e871",
                                "sense_id": "49e595d0-20b8-32b6-95b7-1beaac691ef9",
                                "text": "Mają na sobie marynarskie kostiumy: białe spodnie, trykotowe koszulki w niebieskie pasy"
                            },
                            {
                                "example_id": "72dffee9-ec9e-44c7-8426-dda40ab31413",
                                "sense_id": "49e595d0-20b8-32b6-95b7-1beaac691ef9",
                                "text": "Wynalazek machiny trykotowej w Anglii, postęp w wyrobie mechanicznym tiulów i koronek, który stanowczo zachwiał dotychczasowy przemysł koroniarek, nowe otworzył dla pracy kobiecej pole"
                            },
                            {
                                "example_id": "e0a8ccb8-5412-43c0-a756-188dc9f71794",
                                "sense_id": "49e595d0-20b8-32b6-95b7-1beaac691ef9",
                                "text": "P. Balbina była młoda, niebrzydka, miała na sobie dość czystą sukienkę perkalową w paski, chusteczkę jedwabną na głowie podwiązaną pod brodą, miała na ręku trykotowe rękawiczki, w ręku parasolik czerwony, a na nóżkach, które żywo stąpały po piasku, nie miała nic — gdyż niestety! szła boso"
                            },
                            {
                                "example_id": "c793fb6e-6a1b-4854-a38b-48e964c0f470",
                                "sense_id": "49e595d0-20b8-32b6-95b7-1beaac691ef9",
                                "text": "Dziekan kapituły, nosił się zupełnie jak człowiek świecki, w pluderkach trykotowych, z chustką białą na szyi"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
