                    {
                        "sense_id": "645d56e8-cd85-3b63-ac22-35e6b53c14dc",
                        "entry_id": "d980d967-c2b6-39af-884c-b9909a1baf2f",
                        "glosses": [
                            "A government ruled by God or a god; a theocracy."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "28b62e92-973a-44e0-8d19-c7eb1a92b15d",
                                "sense_id": "645d56e8-cd85-3b63-ac22-35e6b53c14dc",
                                "text": "There ends Monarchy as a Thearchie, or divine dynastie."
                            },
                            {
                                "example_id": "626ffafb-f0c4-4025-a34c-5bfd6b378d96",
                                "sense_id": "645d56e8-cd85-3b63-ac22-35e6b53c14dc",
                                "text": "Thearchie, or Gods Government in Families, a Nation, and all Nations."
                            },
                            {
                                "example_id": "f700c74a-2599-4e70-ba73-4b60d6f4183d",
                                "sense_id": "645d56e8-cd85-3b63-ac22-35e6b53c14dc",
                                "text": "[The Jew's] belief in that direct thearchy, to which he was bound by the ties of gratitude."
                            }
                        ]
                    },
                    {
                        "sense_id": "a17a93c7-2256-348a-8c4d-5e56f75ad6a7",
                        "entry_id": "d980d967-c2b6-39af-884c-b9909a1baf2f",
                        "glosses": [
                            "A system or ordering of deities. (Compare pantheon.)"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "92e30ced-4cac-466d-8f31-49cd7ebbb725",
                                "sense_id": "a17a93c7-2256-348a-8c4d-5e56f75ad6a7",
                                "text": "From rank to rank in Thearchy divine, We angel raylets gladden in thy sight."
                            },
                            {
                                "example_id": "1adc2b13-e6f7-4cad-98fe-d6be76502ff9",
                                "sense_id": "a17a93c7-2256-348a-8c4d-5e56f75ad6a7",
                                "text": "Pan was one of the younger gods in the Hellenic thearchy."
                            },
                            {
                                "example_id": "f7c3bca6-8d43-4665-ba41-b027533d8f69",
                                "sense_id": "a17a93c7-2256-348a-8c4d-5e56f75ad6a7",
                                "text": "When Jesus entered upon his ministry, the Olympian thearchy […] was already tottering to its fall."
                            }
                        ]
                    }
