                ],
                "senses": [
                    {
                        "sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                        "entry_id": "82b9ef1f-9659-307e-a779-5b56f104b811",
                        "glosses": [
                            "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a67fb8ee-307d-4ca6-a390-62330b4b9055",
                                "sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                                "text": "„Er ist Heilung für alle Krankheiten und Sünden und er kommt von der Freigiebigkeit des Freigiebigen, nicht von Trauben.“"
                            },
                            {
                                "example_id": "43347f0e-ed54-4455-bee5-91dfc602520f",
                                "sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                                "text": "„Gleichzeitig muss es sich um eine lebzeitige Zuwendung handeln, die Freigiebigkeit voraussetzt.“"
                            },
                            {
                                "example_id": "672feb10-9dc5-46e3-9c45-7296c33e31a3",
                                "sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                                "text": "„Freigiebigkeit praktiziert der Herrscher vorgeblich ohne Ansehen von Wert und Menge.“"
                            },
                            {
                                "example_id": "901ec969-f07c-4962-bd92-3483e6dc985a",
                                "sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                                "text": "„Die Schenkung ist ein Akt der Freigiebigkeit, durch den eine Person unentgeltlich über eine Sache zugunsten einer anderen Person verfügt, die sie annimmt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "260d60fa-6aaa-42eb-9ad5-9a87b06520b8",
                        "source_entry_id": "82b9ef1f-9659-307e-a779-5b56f104b811",
                        "source_sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                        "source_sense_description": "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken",
                        "target_lang_word": "largess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "largess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                        "entry_id": "ad4c8540-a747-3404-ba60-dc22381c9f34",
                                        "glosses": [
                                            "Alternative spelling of largesse."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a045fd63-d30d-4275-89f9-797adc370aca",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "[T]here vvas good hope that the ſouldiers ſhould have a largeſs dealt amongſt them out of the Kings Treaſure, and be under the command of Captains of better quality, […]"
                                            },
                                            {
                                                "example_id": "dd229757-e44f-4e3e-814e-406d65ce1409",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "But vvhere the Plea of the Receivers is equal, and yet the Diſpenſation of the Benefits vaſtly unequal, there Men are taught that the thing received is Grace; and that they have no claim to it, but the courteſy of the Diſpenſer, and the largeſs of Heaven; vvhich cannot be queſtion'd, […]"
                                            },
                                            {
                                                "example_id": "ace84723-76fb-49aa-872e-9a854762791f",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "[…] I vvould give them three Days, provided, they vvere vvilling to give the Men a Largeſs, as I had done, in Proportion to their Gain."
                                            },
                                            {
                                                "example_id": "bf4d3c7d-cf7d-4fe2-a345-85c9d820b900",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "Yet half mankind maintain a churliſh ſtrife / VVith him, the donor of eternal life, / Becauſe the deed by vvhich his love confirms / The largeſs he beſtovvs, preſcribes the terms."
                                            },
                                            {
                                                "example_id": "269299e1-0976-44be-a911-6c44e5b08033",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "The man to ſolitude accuſtomed long, / Perceives in every thing that lives a tongue; / […] / After long drouht, vvhen rains abundant fall, / He hears the herbs and flovvers rejoicing all: / Knovvs vvhat the freſhneſs of their hue implies, / Hovv glad they catch the largeſs of the skies; […]"
                                            },
                                            {
                                                "example_id": "05026ec0-348d-4aeb-af38-49ffe4cb855f",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "I have not lacked thy mild reproof, / Nor golden largess of thy praise, / But life is full of weary days."
                                            },
                                            {
                                                "example_id": "ffac521c-af50-4379-abaa-6f8d2cfda2be",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "In such case, certainly I would accept / Your bounty: better I than alien hearts / Should execute your planned benevolence / To man, your proposed largess to the Church."
                                            },
                                            {
                                                "example_id": "71064e5e-08d7-43ab-9248-b745a1a18720",
                                                "sense_id": "fe880f9b-4d8d-3755-9b2b-224772728bbb",
                                                "text": "He [Gabriel Matzneff] was invited to the Élysée Palace by President François Mitterrand and socialized with the far-right leader Jean-Marie Le Pen. He benefited from the largess of the fashion designer Yves Saint Laurent and his partner, the business tycoon Pierre Bergé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "410db025-1ed5-4f4a-aaa8-c03d111b3d25",
                        "source_entry_id": "82b9ef1f-9659-307e-a779-5b56f104b811",
                        "source_sense_id": "9a513808-3d0d-3b56-93e9-fab14412351d",
                        "source_sense_description": "persönliche Eigenschaft, gerne etwas den Mitbürgern kostenlos zu überlassen beziehungsweise zu schenken",
                        "target_lang_word": "largesse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "largesse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4b818f6-dce9-3ae7-948c-3675697ff280",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "The trait of being willing to donate money, resources, or time; generosity, liberality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae3f56ee-d4c4-44fb-9a4b-ed2bee3b2497",
                                                "sense_id": "a4b818f6-dce9-3ae7-948c-3675697ff280",
                                                "text": "There is no creature impure or vncleane, yf the conſcience of hym that vſeth it be pure and cleane. And albeit there were any impuritie in the meate, yet with himnes wherwith the larges of god is prayſed before meate and with holy wordes and prayers it ſhoulde be made holy and pure, that before was vncleane."
                                            },
                                            {
                                                "example_id": "ccb5fc2f-29bd-4569-b621-8ec401d0cfd2",
                                                "sense_id": "a4b818f6-dce9-3ae7-948c-3675697ff280",
                                                "text": "But vvhere the Plea of the Receivers is equal, and yet the Diſpenſation of the Benefits vaſtly unequal, there Men are taught that the thing received is Grace; and that they have no claim to it, but the courteſy of the Diſpenſer, and the largeſs of Heaven; vvhich cannot be queſtion'd, […]"
                                            },
                                            {
                                                "example_id": "06c4c6ae-7764-45c5-a08e-7f207f50bb7d",
                                                "sense_id": "a4b818f6-dce9-3ae7-948c-3675697ff280",
                                                "text": "But the dynasty of the Gothic king is in equity and compassion, and his arithmetic is in largesse."
                                            },
                                            {
                                                "example_id": "c9ca14e6-7101-482e-a90b-34d47506552e",
                                                "sense_id": "a4b818f6-dce9-3ae7-948c-3675697ff280",
                                                "text": "He [Gabriel Matzneff] was invited to the Élysée Palace by President François Mitterrand and socialized with the far-right leader Jean-Marie Le Pen. He benefited from the largess of the fashion designer Yves Saint Laurent and his partner, the business tycoon Pierre Bergé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b54c0918-d437-32c3-a2db-3dd64e2c6db6",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "Often preceded by do, give, or make: the generous or liberal giving of gifts or money, especially by someone of high standing on a special occasion; also, excessive or wasteful giving."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e982820-4cc8-4bd9-8355-0a0b9ae6bad1",
                                                "sense_id": "b54c0918-d437-32c3-a2db-3dd64e2c6db6",
                                                "text": "In such case, certainly I would accept / Your bounty: better I than alien hearts / Should execute your planned benevolence / To man, your proposed largess to the Church."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "604cc694-2c1a-33f8-bb2d-8cd96d62b6ab",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "Money, etc., given in this way."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25713b9e-d8e0-4afa-9901-637837ed2f1a",
                                                "sense_id": "604cc694-2c1a-33f8-bb2d-8cd96d62b6ab",
                                                "text": "[F]or our coffers vvith too great a court, / And liberall larges are grovven ſomevvhat light, / VVe are inforſt to farm our royall Realme, / The reuenevv vvhereof ſhall furniſh vs, / For our affaires in hand […]"
                                            },
                                            {
                                                "example_id": "23d5505e-56c7-4d4f-84ef-e745ab2d287b",
                                                "sense_id": "604cc694-2c1a-33f8-bb2d-8cd96d62b6ab",
                                                "text": "Yet half mankind maintain a churliſh ſtrife / VVith him, the donor of eternal life, / Becauſe the deed by vvhich his love confirms / The largeſs he beſtovvs, preſcribes the terms."
                                            },
                                            {
                                                "example_id": "4dca5d0a-66b0-4cac-beb6-45f19599d193",
                                                "sense_id": "604cc694-2c1a-33f8-bb2d-8cd96d62b6ab",
                                                "text": "The procession was brought to a close, by some dozen indomitable warriors of different nations, riding two and two, and haughtily surveying the tame population of Modena: among whom, however, they occasionally condescended to scatter largesse in the form of a few handbills."
                                            },
                                            {
                                                "example_id": "941b3177-b699-41a5-b875-3e8c67e65ca7",
                                                "sense_id": "604cc694-2c1a-33f8-bb2d-8cd96d62b6ab",
                                                "text": "Largesse, in the form of odds and ends of cold cream and pomatum, and also of hairpins, was freely distributed among the attendants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b00f31b0-e06b-37e4-914c-4a85e4a40ada",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "Abundance of something (chiefly beneficial), regarded as having been given generously."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ab0a68f-41c3-417b-844d-6ba6426c122d",
                                                "sense_id": "b00f31b0-e06b-37e4-914c-4a85e4a40ada",
                                                "text": "The man to ſolitude accuſtomed long, / Perceives in every thing that lives a tongue; / […] / After long drought, vvhen rains abundant fall, / He hears the herbs and flovvers rejoicing all: / Knovvs vvhat the freſhneſs of their hue implies, / Hovv glad they catch the largeſs of the skies; […]"
                                            },
                                            {
                                                "example_id": "613866de-5719-4794-9cc6-608c9c49aa4a",
                                                "sense_id": "b00f31b0-e06b-37e4-914c-4a85e4a40ada",
                                                "text": "I have not lacked thy mild reproof, / Nor golden largess of thy praise, / But life is full of weary days."
                                            },
                                            {
                                                "example_id": "c56bed22-f737-42fe-bfc0-441f77679fa9",
                                                "sense_id": "b00f31b0-e06b-37e4-914c-4a85e4a40ada",
                                                "text": "During this period of economic uncertainty, when our standard of living — formerly based upon a larger share of global largesse than we're entitled to — has begun to fall, political and economic hysteria is on the rise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23a8319e-8981-3804-8642-f80aa24c7fa5",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "Chiefly in the form at one's largesse: freedom or liberty to act."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5ee31b-3998-4a94-aa2e-5b62ac8fe706",
                                                "sense_id": "23a8319e-8981-3804-8642-f80aa24c7fa5",
                                                "text": "This captaine then falling in companie vvith a knot of Caualieros, and diſcourſing of the largeſſe & liberty, vvhich ſouldiers enjoy in Italie, in a certaine demand, vvhich one of them made him, he gaue him the you becauſe he vvas native of that place, and the ſonne of meane parents, born in a village of ſome fevv houſes: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f27cf8d-22c4-3785-8172-67c8706ac6b8",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "An act of donating or giving generously."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74728b98-3f01-4f54-8c90-ba4ededa4022",
                                                "sense_id": "0f27cf8d-22c4-3785-8172-67c8706ac6b8",
                                                "text": "So theſe loſing the true glory of virtue vvhich every one ought to have, flie to that vvhich depends upon complaiſance vvith others, courting vulgar applauſe vvith Largeſſes and feaſts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                        "entry_id": "3dd892e3-e7fa-3d72-b4fe-dcbc9af3e8de",
                                        "glosses": [
                                            "A specific gift of money, etc., given in this way, specifically (historical) at harvest time; a donation, a gratuity."
                                        ],
                                        "tags": [
                                            "also",
                                            "countable",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b903a2-8255-4255-af66-4ef88dafd941",
                                                "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                                "text": "Giue gloues to thy reapers, a larges to crie, / And dailie to loiterers haue a good eie."
                                            },
                                            {
                                                "example_id": "5b6fa2fc-e4e9-4281-86eb-e9803f3225c3",
                                                "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                                "text": "Then to our Pallace / Paſſe on in ſtate, let all raryeties / Showre downe from heauen a lardges, that theſe bridals / May exceede mortall pompe."
                                            },
                                            {
                                                "example_id": "237e6d6e-4785-49f4-8ff0-d07d473c6279",
                                                "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                                "text": "[T]here vvas good hope that the ſouldiers ſhould have a largeſs dealt amongſt them out of the Kings Treaſure, and be under the command of Captains of better quality, […]"
                                            },
                                            {
                                                "example_id": "6153d99b-8d71-4d15-a3ce-019e9c92e05f",
                                                "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                                "text": "[…] I vvould give them three Days, provided, they vvere vvilling to give the Men a Largeſs, as I had done, in Proportion to their Gain."
                                            },
                                            {
                                                "example_id": "c86036b4-7202-4b53-8305-e18c1bd2fb65",
                                                "sense_id": "de4e1259-9e5d-3c75-9f9e-190de8551812",
                                                "text": "And he, their courtesy to requite, / Gave them a chain of twelve marks weight, / All as he lighted down. / \"Now largesse, largesse, Lord Marmion, / Knight of the crest of gold! / A blazon'd shield, in battle won, / Ne'er guarded heart so bold.\"— […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a7534e85-f748-4603-8c32-37c15d4e94bb",
                        "source_entry_id": "82b9ef1f-9659-307e-a779-5b56f104b811",
