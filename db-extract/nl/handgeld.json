                        "entry_id": "41f596e9-9f37-3a80-aacc-1754110f74bd",
                        "glosses": [
                            "geld dat de koper van een roerend goed geeft aan de verkoper voordat hij het goed heeft ontvangen meestal betaald bij het afsluiten van een transactie"
                        ],
                        "tags": [],
