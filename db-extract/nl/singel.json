                "senses": [
                    {
                        "sense_id": "bd68d2c9-a054-3271-ba8e-06ea9490a221",
                        "entry_id": "c55c44a9-402f-3808-8cb1-de2c850f1bc3",
                        "glosses": [
                            "gracht om het centrum van een stad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b631ca2e-5af6-4bf1-b38a-7e2715319c19",
                                "sense_id": "bd68d2c9-a054-3271-ba8e-06ea9490a221",
                                "text": "Verslag van de eerste SingelSwim, een zwemtocht door de Singel van Utrecht. Deelnemers zwemmen twee kilometer voor het goede doel, in dit geval onderzoek naar de spierziekte FSHD. O.a. Anita Witzier, Sofie van den Enk en Jan Joost van Gangelen zwemmen mee."
                            }
                        ]
                    },
                    {
                        "sense_id": "5de9ad64-0357-3979-a41c-ba7f75cfc25c",
                        "entry_id": "c55c44a9-402f-3808-8cb1-de2c850f1bc3",
                        "glosses": [
                            "een weg die om het centrum van de stad loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db2e35b9-2962-4f2f-9e53-22c632ac7278",
                                "sense_id": "5de9ad64-0357-3979-a41c-ba7f75cfc25c",
                                "text": "De komende drie weken wordt gewerkt aan de Lasondersingel. De singel krijgt een nieuwe asfaltlaag. Ook wordt de knik in de binnenste ring ter hoogte van de Blijdensteinlaan weggewerkt."
                            }
                        ]
                    },
                    {
                        "sense_id": "b57618ee-bb4d-3b6a-9bd5-91a790af5916",
                        "entry_id": "c55c44a9-402f-3808-8cb1-de2c850f1bc3",
                        "glosses": [
                            "een rij bomen met kreupelhout"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbece6e1-6305-4d69-8374-66bbadc23e33",
                                "sense_id": "b57618ee-bb4d-3b6a-9bd5-91a790af5916",
                                "text": "Akkers en graslanden moeten geschikt worden gemaakt door minder of geen bemesting. Ook moeten de singels ten oosten van de Blokkendijk verdwijnen, evenals hekken en afrastering in het hele gebied. In het gebied worden veel bomen verwijderd."
                            }
                        ]
                    },
