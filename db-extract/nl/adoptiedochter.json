                        "glosses": [
                            "vrouwelijk kind dat men aanneemt als een eigen kind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a5c1c8-4874-4f66-9412-18225d210d6f",
                                "sense_id": "c5eb5b67-5b62-3e50-87b9-d80207a4ea3b",
                                "text": "Nu is ze een dorpelinge met haar eigen bedrijfje en een adoptiedochter, en Gote een vriend met een ruimte-innemend proces."
                            },
                            {
                                "example_id": "f87bd8b8-86c8-4932-8225-955933068a35",
                                "sense_id": "c5eb5b67-5b62-3e50-87b9-d80207a4ea3b",
                                "text": "Vanuit het weeshuis wordt nog altijd geadopteerd, voornamelijk naar de VS. Een Amerikaans stel ontmoet hun adoptiedochter van acht jaar voor het eerst na een procedure van drie jaar. Het meisje springt in de armen van haar adoptiemoeder en komt tijdens ons gesprek met de ouders telkens vrolijk aanhollen."
                            }
                        ]
                    }
