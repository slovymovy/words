                "senses": [
                    {
                        "sense_id": "2d930330-028c-3b90-afb7-c1fa8d6615bd",
                        "entry_id": "af877f14-8b53-3fca-9345-2d0e629f69fb",
                        "glosses": [
                            "Zusammenfassung taxonomisch zusammengehörender Tierarten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e28941b8-37c7-40ff-9b90-4dbd4482faf0",
                                "sense_id": "2d930330-028c-3b90-afb7-c1fa8d6615bd",
                                "text": "„Jedes neue Kapitel beginnt mit einer doppelseitigen Übersicht über die jeweilige Tiergruppe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "504972db-67ff-324b-aa32-39b10ad5fb48",
                        "entry_id": "af877f14-8b53-3fca-9345-2d0e629f69fb",
                        "glosses": [
                            "Zusammenfassung gemeinsam lebender oder gehaltener Tiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f882f5c1-0995-4bb0-a23d-f66f2c605172",
                                "sense_id": "504972db-67ff-324b-aa32-39b10ad5fb48",
                                "text": "„Der Zoo plante mit etwa sieben Hektar Zugewinn, auf denen, anders als im älteren Kernbereich, ein Landschaftszoo mit vergesellschafteten Tiergruppen nach geografischen Gesichtspunkten entstehen sollte.“"
                            },
                            {
                                "example_id": "b55fdd8c-9c62-43e3-874c-19394352bc7e",
                                "sense_id": "504972db-67ff-324b-aa32-39b10ad5fb48",
                                "text": "„Es gab sogar Programmierer, die Tiergruppen in freier Natur studierten, um ihre dort gewonnenen Erkenntnisse auf ihre Computersimulationen zu übertragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e8955cba-0ced-3c5a-8503-3ff06e31c102",
                        "entry_id": "af877f14-8b53-3fca-9345-2d0e629f69fb",
                        "glosses": [
                            "Zusammenfassung von Tieren mit gemeinsamen Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c1be1ee-acc5-4450-bbf2-8b77180f71f9",
                                "sense_id": "e8955cba-0ced-3c5a-8503-3ff06e31c102",
                                "text": "„Dabei stehen nicht Körpergröße oder die große Diskrepanz an Körpergewicht zwischen Mentsch und Tier im Vordergrund, sondern vielmehr die Unterschiede in der Resorption, Metabolisierung und Ausscheidung in den Tiergruppen (Herbivora, Omnivora und Carnivora).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "94d7685d-e251-3489-9ea8-683f9a4760a0",
                        "entry_id": "af877f14-8b53-3fca-9345-2d0e629f69fb",
                        "glosses": [
                            "künstlerische Darstellung mehrerer Tiere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e064db32-5019-439c-93b4-90dbe3a39d67",
                                "sense_id": "94d7685d-e251-3489-9ea8-683f9a4760a0",
                                "text": "„Der Sarkophag hat Wannenform; das Relief ist hoch. An den Seiten je eine Tiergruppe: […]“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
