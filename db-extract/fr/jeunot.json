                        "entry_id": "720a7014-4873-374c-9d31-a0f1cd0c74da",
                        "glosses": [
                            "Jeune avec un trait affectueux ou péjoratif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6c4e2a-e5ce-4777-8626-af5b360e7497",
                                "sense_id": "1adc55eb-d035-35a3-be30-77184dd51375",
                                "text": "Elle est encore toute jeunotte et mais c'est une graine de star."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3575c201-3c72-4161-abb1-42fb0c7cd849",
                        "source_entry_id": "720a7014-4873-374c-9d31-a0f1cd0c74da",
                        "source_sense_id": "1adc55eb-d035-35a3-be30-77184dd51375",
                        "target_lang_word": "youngish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "youngish",
