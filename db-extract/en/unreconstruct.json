                "senses": [
                    {
                        "sense_id": "ad618e6c-4fee-3e08-99f2-651404e75cea",
                        "entry_id": "0d0f55a9-a635-3b11-93e3-2be9129d50d4",
                        "glosses": [
                            "To reverse or undo the effects of reconstruction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29686460-e0ce-4083-87ec-069cc7075f0d",
                                "sense_id": "ad618e6c-4fee-3e08-99f2-651404e75cea",
                                "text": "It is interesting that in cases where the surface does not have the geometry and periodicity of the bulk-terminated plane, the interaction of hydrogen with surface atoms is strong enough to unreconstruct the complicated reconstruction patterns."
                            },
                            {
                                "example_id": "089a2ad1-e31e-4305-8794-9b1b1515599c",
                                "sense_id": "ad618e6c-4fee-3e08-99f2-651404e75cea",
                                "text": "The argument for describing these surfaces as bulk terminated, as chlorine adsorption is known to unreconstruct silicon surfaces, was presented in chapter 1."
                            },
                            {
                                "example_id": "86567c00-35c9-498a-b708-c3dee483069b",
                                "sense_id": "ad618e6c-4fee-3e08-99f2-651404e75cea",
                                "text": "Hydrogen adsorption can unreconstruct surfaces and passivate surface dangling bonds, and thus can change the surface properties dramatically."
                            }
                        ]
                    }
                ],
