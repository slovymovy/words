                ],
                "senses": [
                    {
                        "sense_id": "edb94063-b10a-3adf-a1ea-6b3db7908b91",
                        "entry_id": "6d5da57f-fed9-3d02-9599-a0ee1bb27800",
                        "glosses": [
                            "bewaffneter Konflikt zwischen Drogenkartellen und der Polizei/dem Militär"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "471a80c5-2fca-400d-b5e9-7d07053b98d0",
                                "sense_id": "edb94063-b10a-3adf-a1ea-6b3db7908b91",
                                "text": "„Bereits Ende Oktober lag die Zahl der Opfer des Drogenkriegs bei rund 10.000. So viele Menschen fallen sonst in einem ganzen Jahr dem Gemetzel der Kartelle zum Opfer.“"
                            },
                            {
                                "example_id": "eb1cae8b-7be8-4b63-9280-269c40db2c49",
                                "sense_id": "edb94063-b10a-3adf-a1ea-6b3db7908b91",
                                "text": "„Mit Kolumbien verbinden die meisten Menschen im ersten Moment vor allem eines: den Drogenkrieg.“"
                            },
                            {
                                "example_id": "bc3c62da-35fb-4d72-b77e-2edd6f08de3b",
                                "sense_id": "edb94063-b10a-3adf-a1ea-6b3db7908b91",
                                "text": "„Als es drüben auf der anderen Seite der Grenze die Drogenkriege gab, gab’s nirgends mehr Einweckgläser zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
