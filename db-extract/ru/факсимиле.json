                    {
                        "translation_id": "606ab64e-776d-42ab-9261-fa03480ead93",
                        "source_entry_id": "5c5a45e1-659a-3e2f-b2b4-511d1a79517f",
                        "source_sense_description": "точное воспроизведение; копия",
                        "target_lang_word": "Faksimile",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faksimile",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                        "entry_id": "8040a9e2-bd27-3082-8e78-a9988d157f75",
                                        "glosses": [
                                            "genaue Nachbildung einer Schrift, eines Buches oder einer Zeichnung meist mittels fotografischer Reproduktionsverfahren"
                                        ],
                                        "tags": [
                                            "Grafik",
                                            "Druckereiwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b84777fa-c186-446b-b470-c65d11e7a762",
                                                "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                                "text": "Man kann von vielen alten Büchern Faksimiles erwerben."
                                            },
                                            {
                                                "example_id": "e37c2921-bc4d-48e0-982b-869516dfbf77",
                                                "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                                "text": "„Ein gutes Faksimile entspricht der Vorlage sowohl in Größe, als auch Farbe und Erhaltungszustand.“"
                                            },
                                            {
                                                "example_id": "17a3a496-104f-4474-b4fa-6e40678b9afb",
                                                "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                                "text": "„Das Vocabolari von 1502 war eine Übersetzung eines übersetzenden Werkes. Wir publizieren heute nicht ein Faksimile, sondern das Faksimile eines Faksimiles, nämlich das Faksimile der von Barnills vor genau 75 Jahren besorgten … Faksimile-Ausgabe.“"
                                            },
                                            {
                                                "example_id": "8d74f5e5-a035-4d80-834d-db0d3ee389a8",
                                                "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                                "text": "„Hier kann man diese heiter geschriebene Posse als Faksimile käuflich erwerben oder von Annemarie Kellner als freundliches Gastgeschenk verehrt bekommen, wenn man eine etwas größere Feier bestellt.“"
                                            },
                                            {
                                                "example_id": "b2f093e4-e7b2-4ae3-b09f-c9c33f71d10b",
                                                "sense_id": "3941a1b2-9a42-319c-a4ec-a273964c838e",
                                                "text": "„Der Freund machte einen Stempel, und Schlump arbeitete an dem Faksimile der Unterschrift des Bürgermeisters.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
