                "senses": [
                    {
                        "sense_id": "31c2786a-4a3e-3acd-880f-3dec2b8625b0",
                        "entry_id": "2f06a540-8d86-33e0-8044-b95c41fb7ca2",
                        "glosses": [
                            "aus Gold bestehende Zahnkrone oder aus Gold bestehender Zahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca397eb-8604-4567-a26d-4becb0e5710b",
                                "sense_id": "31c2786a-4a3e-3acd-880f-3dec2b8625b0",
                                "text": "Er ließ sich von seinem Zahnarzt einen Goldzahn einsetzen."
                            },
                            {
                                "example_id": "4474a55d-15da-44e8-a878-909dce325601",
                                "sense_id": "31c2786a-4a3e-3acd-880f-3dec2b8625b0",
                                "text": "„Das Mädchen am Empfang hat einen Goldzahn, der aufleuchtet, wenn sie lächelt.“"
                            },
                            {
                                "example_id": "3a39fe9d-1853-4abe-8728-7963d87d8674",
                                "sense_id": "31c2786a-4a3e-3acd-880f-3dec2b8625b0",
                                "text": "„Gleich nach meiner Ankunft in Berlin vergrub ich die Goldzähne in einem Trümmerfeld.“"
                            },
                            {
                                "example_id": "a0dd3b98-15ef-432a-88b8-35ee6fbc63aa",
                                "sense_id": "31c2786a-4a3e-3acd-880f-3dec2b8625b0",
                                "text": "„Mein Gesprächspartner war ein alter Bürokrat mit vielen Goldzähnen und grauem Haar, das er mit Pomade an die Seiten geklebt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
