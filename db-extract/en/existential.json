                                        "entry_id": "0d588a49-8e12-3e17-840f-2fc889c57bc7",
                                        "glosses": [
                                            "für die Existenz, für das Leben (auch des Einzelnen) wichtig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27532020-b09c-4d74-82b2-325fa5fdb506",
                                                "sense_id": "72933f9e-6f5e-3c1b-8f3a-cdbcfd6e7707",
                                                "text": "„Andere Zeitgenossen hielten Krieg sogar für eine existentielle Bedrohung.“"
                                            }
