                                                "example_id": "07dd9b55-1338-4789-b65e-7e821bb1d5b7",
                                                "sense_id": "2b07fd56-6165-3f90-bd38-6ccc47922966",
                                                "text": "Windsor is very touristy."
                                            },
                                            {
                                                "example_id": "288f7537-7d13-45e0-ba81-4e88ee17659f",
                                                "sense_id": "2b07fd56-6165-3f90-bd38-6ccc47922966",
                                                "text": "These men would find a much bigger and touristier Carmel now. But the scenic oceanfront remains, and there are many intriguing ethnic eating places."
                                            },
                                            {
                                                "example_id": "cb051341-b336-48a6-b37d-2fb27e47dba1",
                                                "sense_id": "2b07fd56-6165-3f90-bd38-6ccc47922966",
                                                "text": "Pick one of the touristiest bars on Duval Street to get the idea that you have to hang out in such bars out of your system early on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "776ed2a9-8988-3ad3-a6eb-76c52c9b7127",
