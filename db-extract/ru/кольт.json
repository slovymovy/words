                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Colt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b354ce9-2374-32c2-87a4-3dde1ecd63c0",
                                        "entry_id": "df0c1c97-53d0-3975-bef3-72652ddfe449",
                                        "glosses": [
                                            "A surname originating as an occupation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c55c6c56-e5f5-37a6-9732-5660392b42ee",
                                        "entry_id": "df0c1c97-53d0-3975-bef3-72652ddfe449",
                                        "glosses": [
                                            "A male given name transferred from the surname."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1886373-9e9f-4392-abbf-14ac06e679f2",
                                                "sense_id": "c55c6c56-e5f5-37a6-9732-5660392b42ee",
                                                "text": "It took two years for Colt and his extended family to find the ideal land on which to spend the rest of their lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a5064c9-6d0f-392c-8756-507919eadf5b",
                                        "entry_id": "df0c1c97-53d0-3975-bef3-72652ddfe449",
                                        "glosses": [
                                            "A town in St. Francis County, Arkansas, United States."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6176bffc-b2f2-3bc5-9592-7dc500132355",
                                        "entry_id": "df0c1c97-53d0-3975-bef3-72652ddfe449",
                                        "glosses": [
                                            "An unincorporated community in St. Tammany Parish, Louisiana, United States."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Colt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c7576c8-8a6d-3ad3-90f3-c01c95795994",
                                        "entry_id": "d8c1b261-9f22-3981-885c-f6c98d6e1fbb",
                                        "glosses": [
                                            "A revolver (gun) (from Colt's Manufacturing Company), associated especially but not exclusively with the American Wild West."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26931efe-c14b-4e99-ab32-870394036e7b",
                                                "sense_id": "2c7576c8-8a6d-3ad3-90f3-c01c95795994",
                                                "text": "Only in it she held a derringer in her hand, not a Colt. But that look of disbelief on Leonard's face could not have been more real."
                                            },
                                            {
                                                "example_id": "10cee0ef-833a-40e4-af6a-cb7e5a4b49eb",
                                                "sense_id": "2c7576c8-8a6d-3ad3-90f3-c01c95795994",
                                                "text": "He saw the shotgunner stagger into the lingering cloud of smoke. He jumped to his feet before the man could reload and charged toward him. The man dropped his shotgun and clawed for his pistol, a blueblack hole in his left leg, near the groin. John stopped and fired his Colt, aiming for the man's heart. But Luke's left leg gave way and tilted him sideways, so the bullet from John's gun struck his right shoulder, spun him like a top. His pistol slipped from his hand."
                                            },
                                            {
                                                "example_id": "060519ec-4171-4053-8182-6abd1fc4a7f9",
                                                "sense_id": "2c7576c8-8a6d-3ad3-90f3-c01c95795994",
                                                "text": "His soldier's instinct had him dropping to the ground before he even thought of it, and Captain Hargreaves fired his Colt. The bullet zoomed over Butsko's head and whacked in the chest of the hapless soldier who'd been standing behind him. Butsko rolled over on the ground, stopped, and brought his rifle quickly to his shoulder as Captain Hargreaves fired again, his bullet burrowing in the muck six inches from Butsko's face. Butsko fired at Captain Hargreaves ..."
                                            },
                                            {
                                                "example_id": "7491f67e-de09-4fb4-8fc1-75b73ddf9dfd",
                                                "sense_id": "2c7576c8-8a6d-3ad3-90f3-c01c95795994",
                                                "text": "Clint snap-aimed and fired his Colt. The man's stetson whirled off his head. So did part of his skull. The second gunman bounced up and fired a shot at the Gunsmith. The bullet struck the dead flesh of Clint's cover. The Gunsmith fired back and saw a crimson spider appear at the man's shoulder. The gunman groaned and bolted for the side exit. Clint pointed his Colt and squeezed the trigger. The hammer struck the firing pin and drove it into an empty chamber."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17c810d9-1045-46eb-b6d2-3c78210c37e1",
                        "source_entry_id": "4eaaccc7-33e6-38c5-ba8f-9ca77de1c285",
                        "source_sense_id": "788afe52-a14a-3f51-896a-c166d494e8c3",
