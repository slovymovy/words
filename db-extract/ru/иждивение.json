                                    },
                                    {
                                        "sense_id": "7a5dfd41-7f8c-3a05-b1e9-812e0d09b771",
                                        "entry_id": "e6dc159f-839e-376e-8bee-1bbdd5b5c38f",
                                        "glosses": [
