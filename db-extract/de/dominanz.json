                                "target_senses": [
                                    {
                                        "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                                        "glosses": [
                                            "Exercice d’une influence ou d’une action prépondérante ; état qui en résulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcffb114-49f8-4376-8dca-50fd9061f1b4",
                                                "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                                                "text": "Paul Broca est le père de la théorie de la dominance cérébrale de l’hémisphère gauche dans le langage articulé qu’il esquisse dès 1861."
                                            },
                                            {
                                                "example_id": "9530e9e9-6c3b-4a0a-96ae-74e9f0bdbb82",
                                                "sense_id": "299e6b85-5a8b-3441-a1d3-79989d18656b",
                                                "text": "L’intérêt de la bourgeoisie étant de conserver avant tout ses prérogatives hiérarchiques de dominance …, elle accepte bien volontiers de diffuser une culture, surtout si elle se vend."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d61ad273-6db0-3882-8fb5-2052dd138b76",
                                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                                        "glosses": [
                                            "Qualité de ce qui domine en importance ou en quantité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16dcd3e4-dd1c-4fff-a636-5b30405cd3ed",
                                                "sense_id": "d61ad273-6db0-3882-8fb5-2052dd138b76",
                                                "text": "[…] pourtant la dominance toute locale du Genêt à balai ou de la Callune ou même de la Fougère Aigle, espèces sociales de « premier plan », confère à la lande une physionomie particulière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f4b4a7d-2620-3cf7-a721-9383b709b000",
                                        "entry_id": "265e7edb-98bd-3d5a-a2ca-702b77e4fa49",
                                        "glosses": [
                                            "Suprématie hiérarchique d’un animal qui exerce une autorité sur les autres."
                                        ],
                                        "tags": [
                                            "Éthologie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "603bedaa-a2f4-3a5d-9a1e-0e203ed53e6f",
