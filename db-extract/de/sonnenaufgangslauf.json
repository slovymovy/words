                "senses": [
                    {
                        "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                        "entry_id": "8985dc43-5f19-39a1-9140-9cbb04c5374c",
                        "glosses": [
                            "Laufen/Joggen am frühen Morgen zur Zeit des Sonnenaufgangs"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "471a66b1-ca10-4315-b292-07830d4a216e",
                                "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                                "text": "„Hat die Unterkunft kein Fitnessstudio, starte doch mal mit einem Sonnenaufgangslauf am Strand oder einem Workout auf der Terrasse.“"
                            },
                            {
                                "example_id": "9f0a3486-e73d-4606-be45-45a73878f4e0",
                                "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                                "text": "„Am Montag haben mich wieder bei einem Sonnenaufgangslauf die Herbstfarben überwältigt.“"
                            },
                            {
                                "example_id": "81c5555a-ac05-403d-94e1-a41a6e0fc0eb",
                                "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                                "text": "„Als Abschluss-Event ging es am Montag früh um 4:30 Uhr noch einmal zu einem Sonnenaufgangslauf.“"
                            },
                            {
                                "example_id": "12cb9f7f-67f5-4091-ad69-255148f938ac",
                                "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                                "text": "„Treffpunkt 05.30 Uhr am Zollfeld, wir hatten vor [sic?] einen Sonnenaufgangslauf auf den Magdalensberg zu machen.“"
                            },
                            {
                                "example_id": "e308c9d2-89fe-40dd-8f28-d3bbe4d1b9c1",
                                "sense_id": "7cc4670a-9cf6-319b-b860-16408ad27935",
                                "text": "„Vor der Zeitumstellung am Wochenende war das jetzt vielleicht für lange Zeit die letzte Möglichkeit, den Tag mit einem Sonnenaufgangslauf zu starten (bald wird es zu spät hell, als dass man sowas an Arbeitstagen noch guten Gewissens durchziehen könnte).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
