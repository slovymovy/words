                        "examples": [
                            {
                                "example_id": "4884a3d5-0b4b-4cbb-a908-da2be128444b",
                                "sense_id": "5205987d-58da-392c-9edb-80064d816c7d",
                                "text": "On peut également avoir du mal à s’approprier sa vie à force de s’auto-ausculter et de s’interroger sur ce qu’il faut ou ne faut pas faire : voici une façon de revenir sans cesse – ou de ne jamais quitter – les questions identitaires adolescentes, et une attitude narcissique qui cache encore une fois une grande peur de s’exposer."
                            },
                            {
                                "example_id": "bf921cc6-5f69-4f19-b64a-96467c34a66f",
                                "sense_id": "5205987d-58da-392c-9edb-80064d816c7d",
                                "text": "A force de s’analyser, de s’auto-ausculter, de peser le poids de leurs sentiments, ils oublient de vivre cette rencontre."
                            }
                        ]
                    }
