                        "glosses": [
                            "Opérette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c7abaf5-9b24-4b34-9486-219486a7a1ce",
                                "sense_id": "e2102616-a50e-3ac4-a255-1bee5096cce3",
                                "text": "Die Operette ist ein musikalisches Bühnenwerk, das wohl aus dem Singspiel, nicht jedoch - wie man aus dem Namen schließen könnte - aus der Oper entstand. — L’opérette est un œuvre scénique musicale qui est issue de la comédie musicale et non de l’opéra - comme on pourrait le déduire du nom."
                            }
                        ]
                    }
                ],
