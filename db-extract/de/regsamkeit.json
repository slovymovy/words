                "senses": [
                    {
                        "sense_id": "79216d19-66ec-30be-baf2-b51fdc85cf74",
                        "entry_id": "66fe2f29-7784-32ff-afc8-b15fe3969f32",
                        "glosses": [
                            "Geschäftigkeit, Lebhaftigkeit, Aktivität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241ec05c-e0f9-44a9-8c84-84f4804bd293",
                                "sense_id": "79216d19-66ec-30be-baf2-b51fdc85cf74",
                                "text": "„Es herrscht ein Verkehr von mittlerer Regsamkeit, ohne viel Lärm und Gedränge […]“ (1909)"
                            },
                            {
                                "example_id": "7750879b-09ca-4298-acee-fa2745a69f9f",
                                "sense_id": "79216d19-66ec-30be-baf2-b51fdc85cf74",
                                "text": "„Im Schatten dieser Aktivität steht eine gegenüber früher ebenfalls stark intensivierte aussenpolitische Regsamkeit der Verwaltung in den einzelnen Departementen.“"
                            },
                            {
                                "example_id": "d2eb6fd0-5d93-45ea-9872-a718768c5160",
                                "sense_id": "79216d19-66ec-30be-baf2-b51fdc85cf74",
                                "text": "„Man muss nicht bis zu den griechischen Philosophen zurückgehen, um zu wissen, dass Weisheit mitunter erst im Alter hervortritt und dass die geistige Regsamkeit von Person zu Person ungemein variiert.“"
                            },
                            {
                                "example_id": "48a260bd-85bd-4b11-b508-ba33d908d825",
                                "sense_id": "79216d19-66ec-30be-baf2-b51fdc85cf74",
                                "text": "„Vor allem die vergangenes Jahr gegründete Afrikanische Union (AU) erwachte in der Woche der Bush-Visite zu überraschender Regsamkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
