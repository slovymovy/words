                        "examples": [
                            {
                                "example_id": "7d950f57-896a-4faa-8bf1-4092f8a2e1fb",
                                "sense_id": "c4832915-87c0-3b22-9949-8592755e97c3",
                                "text": "Cependant Savary, T. I. Col. 448. (édit. de Copenhague, 1759 — 1766) art. Bazac, Baza, ne dit nullement que Bazac soit le nom d'une contrée; il dit que ce mot désigne du coton filé, très beau et très fin, qui vient de Jérusalem; ce qui le fait aussi appeler Coton de Jérusalem. Le demi Bazac, et le moyen Bazac, sont des cotons qui viennent du même endroit, mais d'une qualité beaucoup inférieure."
                            }
                        ]
