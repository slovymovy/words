                                        "entry_id": "95d79f26-c3d5-3cc4-aefa-6aaeca45b959",
                                        "glosses": [
                                            "dat wat in een (rang)ordening met 99 is aangeduid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990d11b0-d565-4a6b-94e6-a38b85f9c75f",
                                                "sense_id": "6c7fbffc-5ef6-3c94-9b70-7347201de610",
                                                "text": "Het is weer de negenennegentig die het niet doet, kunnen we die niet simpel vervangen?"
                                            },
                                            {
                                                "example_id": "a0720161-996e-49bc-83f7-280b0993521b",
                                                "sense_id": "6c7fbffc-5ef6-3c94-9b70-7347201de610",
                                                "text": "Haar honderdste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de negenennegentig eenmaal voorbij was."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3200d159-c88d-3f97-abe8-85ee72b60558",
                                        "entry_id": "95d79f26-c3d5-3cc4-aefa-6aaeca45b959",
                                        "glosses": [
                                            "groep van 99 eenheden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f0fa6e-80dd-41a0-9f24-86a37a4fd383",
                                                "sense_id": "3200d159-c88d-3f97-abe8-85ee72b60558",
                                                "text": "De negenennegentig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
