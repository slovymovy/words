    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "41078995-430b-367e-8c33-9219431112e7",
                    "sense_definition": "Hidden, isolated, or remote from other people or places.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "isolated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent their vacation in a <w>secluded</w> cabin deep in the forest.",
                            "target_lang_translations": {
                                "ru": "Они провели отпуск в <w>уединённом</w> домике в глубине леса."
                            }
                        },
                        {
                            "text": "The hotel is located on a <w>secluded</w> beach away from the busy city.",
                            "target_lang_translations": {
                                "ru": "Отель расположен на <w>уединённом</w> пляже вдали от шумного города."
                            }
                        }
                    ],
                    "synonyms": [
                        "off the grid",
                        "isolated"
                    ],
                    "common_phrases": [
                        "secluded beach",
                        "secluded spot",
                        "secluded area"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрытый, изолированный или удаленный от других людей или мест."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединённый",
                                "target_lang_sense_clarification": "находящийся вдали от людных мест, тихий и безлюдный"
                            },
                            {
                                "target_lang_word": "обособленный",
                                "target_lang_sense_clarification": "расположенный отдельно, в стороне от других"
                            },
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "очень отдаленный, труднодоступный (о месте)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d1f7d3c8-d575-32f0-93a1-0737af205e10",
                    "sense_definition": "Simple past and past participle of <w>seclude</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "isolated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk <w>secluded</w> himself from the world to focus on his prayers.",
                            "target_lang_translations": {
                                "ru": "Монах <w>уединился</w> от мира, чтобы сосредоточиться на своих молитвах."
                            }
                        },
                        {
                            "text": "She has <w>secluded</w> herself in her room for the entire weekend.",
                            "target_lang_translations": {
                                "ru": "Она <w>уединилась</w> в своей комнате на все выходные."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of seclude"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени глагола «уединять» или «изолировать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уединился",
                                "target_lang_sense_clarification": "ушел от людей, остался один (глагол)"
                            },
                            {
                                "target_lang_word": "изолировал",
                                "target_lang_sense_clarification": "отделил кого-либо от общества или среды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
