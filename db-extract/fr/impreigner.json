                "senses": [
                    {
                        "sense_id": "a6f02c34-302d-3936-adc9-941ab96048ff",
                        "entry_id": "e8e3b5eb-9339-3f5c-9b8c-4b0b8111c588",
                        "glosses": [
                            "Variante de imprégner."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "54f5c9e3-1cc6-4e63-b248-8c4ea063df2e",
                                "sense_id": "a6f02c34-302d-3936-adc9-941ab96048ff",
                                "text": "Pringle et Macbride ont fait cette expérience, en se contentant d'impreigner les alimens de salive et d'eau ;"
                            },
                            {
                                "example_id": "bf082c08-bf71-4901-aad2-bb9d6c7f39b0",
                                "sense_id": "a6f02c34-302d-3936-adc9-941ab96048ff",
                                "text": "On a dit : ils seront indépendants ; ils ne viendront pas s'impreigner de notre esprit."
                            },
                            {
                                "example_id": "876334c0-975d-4ba3-8c4f-bfe1c3ca24c5",
                                "sense_id": "a6f02c34-302d-3936-adc9-941ab96048ff",
                                "text": "Deux assemblées d'hommes, se réunissant à part, ne tardent pas, bien que leur origine soit commune, à s'impreigner d'un esprit différent."
                            }
                        ]
                    }
                ],
