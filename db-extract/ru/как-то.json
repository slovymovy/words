                                "sense_id": "0fbfe588-a231-3c15-a94a-24ebeaf0e73b",
                                "text": "Ка́к-то я иду́ по у́лице.",
                                "translation": "At some point, I'm walking down the street.",
                                "english": "At some point, I'm walking down the street."
                            }
                        ]
                    },
                    {
                        "sense_id": "b391c68a-6b03-3c14-a977-51d59667b513",
                        "entry_id": "d43de018-5381-32f1-8389-a9f3934e2b4a",
                        "glosses": [
