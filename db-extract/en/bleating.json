                        "entry_id": "7b243da1-0a0a-3c73-8d6e-3a37d2436c53",
                        "glosses": [
                            "A noise that bleats."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee4bfc77-0a2d-411b-b716-830df9d789c2",
                                "sense_id": "47297bf2-33a0-3830-b105-4103f1772c9e",
                                "text": "And Samuel said, What meaneth then this bleating of the sheep in mine ears, and the lowing of the oxen which I hear?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b4e9e7a5-8a91-353a-aeba-92f620c3735d",
                        "entry_id": "7b243da1-0a0a-3c73-8d6e-3a37d2436c53",
                        "glosses": [
                            "Inane or plaintive chatter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89370117-8bc5-49f2-9fae-1b12e7f50574",
                                "sense_id": "b4e9e7a5-8a91-353a-aeba-92f620c3735d",
                                "text": "Both men seemed to enjoy these contests, always laced with the tension caused by constant government bleating about the ABC's left-wing bias."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44930b0c-043f-4fb8-8ba6-f0b667bbe5af",
                        "source_entry_id": "7b243da1-0a0a-3c73-8d6e-3a37d2436c53",
                        "source_sense_description": "a noise that bleats",
                        "target_lang_word": "бле́яние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бле́яние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d632abd8-e638-30e6-80f0-850a00ecbfaf",
                                        "entry_id": "166f9aaa-9b46-30ed-805a-ef61647c185c",
                                        "glosses": [
                                            "действие по значению гл. блеять"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad22d58-73b1-4692-b23c-a994e6252c11",
                                                "sense_id": "d632abd8-e638-30e6-80f0-850a00ecbfaf",
                                                "text": "Карп встречен был блеянием овец, фырканьем трёх лошадей и глухим чмоканьем коровы, которая в сумерках принимала вид огромного белого камня, брошенного посреди двора."
                                            },
                                            {
                                                "example_id": "b095ff89-f2ed-424a-916f-4909809c65d8",
                                                "sense_id": "d632abd8-e638-30e6-80f0-850a00ecbfaf",
                                                "text": "Когда он в одно и то же время кончил свою записку и услыхал из деревни доносящиеся звуки блеяния стада, скрипа отворяющихся ворот и говора мужиков, собравшихся на сходке, Нехлюдов сказал приказчику, что не надо мужиков звать к конторе, а что он сам пойдёт на деревню, к тому двору, где они соберутся."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe7ba1e-2e8b-3ce4-96ca-033a0a1cf647",
                                        "entry_id": "166f9aaa-9b46-30ed-805a-ef61647c185c",
                                        "glosses": [
                                            "звуки, возникающие в процессе такого действия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1baeac11-4af2-4a17-9494-1137b69024b9",
                                                "sense_id": "ebe7ba1e-2e8b-3ce4-96ca-033a0a1cf647",
                                                "text": "Духота увеличивалась; откуда-то доносилось докучное блеяние верблюжонка, и в ответ ему слышались трескучие крики старого верблюда."
                                            },
                                            {
                                                "example_id": "38e9ada6-7942-4065-8ffd-a1af5f6686dd",
                                                "sense_id": "ebe7ba1e-2e8b-3ce4-96ca-033a0a1cf647",
                                                "text": "Здесь утонули в траве рассыпанные стада баранов, овец и коз, с молодыми ягнятами и козлятами, матки которых всегда ягнятся на траву; далеко слышно их разноголосное блеяние."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
