                "senses": [
                    {
                        "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                        "glosses": [
                            "A person who restores peace, especially by settling disputes; one who engages in peacemaking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d728e5-41e6-4080-aad2-a52120edb83e",
                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                "text": "Bleſſed are the peacemakers: foꝛ they ſhall bee called the childꝛen of God."
                            },
                            {
                                "example_id": "0401d8a3-685d-4910-a7f0-10b86731a53b",
                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                "text": "Mr. Carter has celebrated experience as a peacemaker: he mediated the 1978 peace talks between Israel and Egypt at Camp David."
                            },
                            {
                                "example_id": "3fa77863-5b94-4007-ac0f-1d850656ef1a",
                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                "text": "The peacemakers – clergy, Gray’s family and brave residents – placed themselves in the rioters’ way."
                            },
                            {
                                "example_id": "98146189-16ac-4ab4-884e-48c0303bcd21",
                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                "text": "We're not just the law, Joe. We're the peacemakers. Like the old Colts."
                            },
                            {
                                "example_id": "cbef198a-8033-4e0f-bf7c-0fcd7d21aa7e",
                                "sense_id": "a1bf844b-0219-37e4-807f-eea14b041eb9",
                                "text": "“That’s what I want to be: a peacemaker and a unifier,” he said. His time in office so far has not, at least not yet, been the era of peace."
                            }
                        ]
                    },
                    {
                        "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                        "entry_id": "ea7547d6-f96f-3620-8087-7f42c660cdec",
                        "glosses": [
                            "Catachresis for pacemaker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6b5a8f-305f-422d-af36-80318cb6538b",
                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                "text": "Indeed, although the activity of the heart depends on the intrinsic rhythm of its peacemaker […]"
                            },
                            {
                                "example_id": "a604b10c-e4c9-481b-b2fa-73ae9651e567",
                                "sense_id": "efba3a7e-3287-3f60-8c54-7f80bd31b0ed",
                                "text": "The “heart’s peacemaker” is the node from which the electrical signal for heart beat are […]"
                            }
                        ]
                    }
