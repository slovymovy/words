                ],
                "senses": [
                    {
                        "sense_id": "d20d826d-d49b-3986-a518-60a8801f7423",
                        "entry_id": "c00d325d-0c58-3641-8d6e-b3f6bcecd33c",
                        "glosses": [
                            "Bewohner der Südseeinseln (vornehmlich Neukaledoniens)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e940f49e-4545-46de-85a7-df6cc1735b9a",
                                "sense_id": "d20d826d-d49b-3986-a518-60a8801f7423",
                                "text": "Viele Kanaken pflegen in ihren Stämmen weiterhin ihre eigenen Sprachen und Gebräuche."
                            },
                            {
                                "example_id": "ed5329c8-5082-414e-bfdd-f960ee7d2b9f",
                                "sense_id": "d20d826d-d49b-3986-a518-60a8801f7423",
                                "text": "„In Honolulu, ja sogar im ganzen Königreich Hawaii, gibt es keinen regulären Mietsstall; wenn man also keine reichen Einwohner kennt (die alle gute Pferde besitzen), muß man sich von den Kanaken (das heißt den Eingeborenen) die erbärmlichsten Klepper leihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad736759-f724-3505-ab65-5ba68fb6342b",
                        "entry_id": "c00d325d-0c58-3641-8d6e-b3f6bcecd33c",
                        "glosses": [
                            "Schimpfwort für südländische Ausländer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d96681-7662-4b12-abf5-f05fb24a08cd",
                                "sense_id": "ad736759-f724-3505-ab65-5ba68fb6342b",
                                "text": "„Ich bin zwar nie als Kanake beschimpft worden, allerdings als ›Ausweis-Deutscher‹, vom NPD-Pressesprecher Klaus Beier, der wegen seiner Beleidigung auch eine Anzeige erhielt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbee051a-c85d-4545-b08e-19f51e984714",
                        "source_entry_id": "c00d325d-0c58-3641-8d6e-b3f6bcecd33c",
                        "source_sense_id": "d20d826d-d49b-3986-a518-60a8801f7423",
                        "source_sense_description": "Angehöriger eines melanesischen Volkes",
                        "target_lang_word": "Kanak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                        "entry_id": "c35c40e8-2bfa-37e9-9273-93ef4b45c9ca",
                                        "glosses": [
                                            "An indigenous Melanesian inhabitant of New Caledonia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5c8fe9-3956-4e0c-85be-d6ada93e3b2e",
                                                "sense_id": "e5e6c9f9-bb00-3ebc-8976-e4aa44ff46b6",
                                                "text": "In the working-class districts of Nouméa, which have a high population of indigenous Kanak residents, buildings were burned and wrecked vehicles remained in the middle of the road."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3df6f816-a478-415c-a994-19b2987eccf4",
                        "source_entry_id": "c00d325d-0c58-3641-8d6e-b3f6bcecd33c",
                        "source_sense_id": "d20d826d-d49b-3986-a518-60a8801f7423",
                        "source_sense_description": "Angehöriger eines melanesischen Volkes",
                        "target_lang_word": "kanak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kanak",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4979232-c46b-3838-be26-3b326e90cb68",
                                        "entry_id": "6a496890-cd4b-31be-8337-92090fb76153",
                                        "glosses": [
                                            "Relatif aux Kanaks, habitants autochtones de la Nouvelle-Calédonie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dad66d1-9441-4330-b75a-18b853954eb0",
                                                "sense_id": "f4979232-c46b-3838-be26-3b326e90cb68",
                                                "text": "« N’ayez pas peur des Kanaks », « n’ayez pas peur de la République française » Nicolas Sarkozy a exprimé vendredi à Nouméa son « respect de la culture et des traditions » kanakes, devant les membres du Sénat coutumier, au premier jour d’une visite de deux jours et demi en Nouvelle-Calédonie."
                                            },
                                            {
                                                "example_id": "e704353b-ddaa-491a-b881-819bb1d22495",
                                                "sense_id": "f4979232-c46b-3838-be26-3b326e90cb68",
                                                "text": "L’exposition se clôt avec deux artistes kanak trentenaires, dont une femme, symbole de la place nouvelle des femmes dans la culture et la coutume kanak."
                                            },
                                            {
                                                "example_id": "08c9cca8-660f-4a9a-b093-65ce347271bb",
                                                "sense_id": "f4979232-c46b-3838-be26-3b326e90cb68",
                                                "text": "En 1984, dix militants indépendantistes kanak sont assassinés dans une embuscade. Les auteurs de la tuerie, qui reconnaissent les faits, sont acquittés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
