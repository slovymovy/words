                ],
                "senses": [
                    {
                        "sense_id": "5f1bccec-b5ef-358f-97ae-f0982419ef28",
                        "entry_id": "626796a2-20c6-3ec1-847f-b51b37f63449",
                        "glosses": [
                            "Innenseite des Armgelenks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f49b039d-2ce3-4749-82f6-6c9e8abc50f6",
                                "sense_id": "5f1bccec-b5ef-358f-97ae-f0982419ef28",
                                "text": "„Das Kind aus der Nachbarschaft hat Neurodermitis. Die Armbeugen jucken höllisch, sind entzündet und aufgekratzt.“"
                            },
                            {
                                "example_id": "1c22526c-2bc4-45c2-a27e-99358402bdca",
                                "sense_id": "5f1bccec-b5ef-358f-97ae-f0982419ef28",
                                "text": "„Sie war eindeutig schon länger Mutter, bettete den Kurt viel geschickter in ihre Armbeuge und wusste ihn so zu wiegen, dass er bald eingeschlafen war.“"
                            },
                            {
                                "example_id": "c0d41841-619c-4689-a65c-c206f36be7b1",
                                "sense_id": "5f1bccec-b5ef-358f-97ae-f0982419ef28",
                                "text": "„Wir landeten in der Nähe eines großen Ladens, und als wir durch ein Fenster blickten, sahen wir einen Mann mit einem Gewehr in der Armbeuge im Sitzen schlafen.“"
                            },
                            {
                                "example_id": "e363ab13-0e8d-4cba-99ce-5c2ec62d73e7",
                                "sense_id": "5f1bccec-b5ef-358f-97ae-f0982419ef28",
                                "text": "„Rasch steckte ich meinen ganzen Arm durch das Loch, so daß sie ihre Lippen in die Armbeuge preßte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
