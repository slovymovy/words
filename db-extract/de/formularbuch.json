                "senses": [
                    {
                        "sense_id": "f0ca63b0-6f2a-3904-ad18-05bfe2a240dc",
                        "entry_id": "7467966e-f7e6-3f3e-a144-eb856a3daba2",
                        "glosses": [
                            "ein Buch, das standardisierte Textvorlagen, die um individuelle Angaben ergänzt werden können, enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0a32bee-7204-4a30-a6f2-346ddabb11fa",
                                "sense_id": "f0ca63b0-6f2a-3904-ad18-05bfe2a240dc",
                                "text": "Das Formularbuch erleichtert Ihnen den Umgang mit Behörden."
                            },
                            {
                                "example_id": "205044bf-c5d4-4c9b-a0ad-e034723cd161",
                                "sense_id": "f0ca63b0-6f2a-3904-ad18-05bfe2a240dc",
                                "text": "„Diese Formen wurden eingehalten durch Anlehnung an bekannte Muster (Formulare), die zu diesem Zweck in allen Schreibstuben gesammelt und als Formularbücher jedem Kanzlisten unentbehrlich waren.“"
                            },
                            {
                                "example_id": "0e85b4a4-e218-44ec-994f-8f79261b9a3f",
                                "sense_id": "f0ca63b0-6f2a-3904-ad18-05bfe2a240dc",
                                "text": "„Textmustersammlungen bestehen damals aus (juristisch hieb- und stichfesten) Formeln und Formen; sie heißen in dieser Zeit auch Formularbuch oder Formularium.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
