                                    {
                                        "sense_id": "cd1311ba-90bf-35a8-a65a-9b6d8201e6fc",
                                        "entry_id": "3c2dd537-2822-3411-baa0-8a34a72ae1f5",
                                        "glosses": [
                                            "het zuiveren of het gezuiverd worden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbac4d1e-e51b-4661-8e15-48a6bc8689d9",
                                                "sense_id": "cd1311ba-90bf-35a8-a65a-9b6d8201e6fc",
                                                "text": "Zowel provincie als gemeenten willen een alternatief zónder injectie in de ondergrond. Het gaat in dat geval om volledige zuivering van het afvalwater bij de oliewinning in Schoonebeek zelf. Het volledig gezuiverde water kan dan op het oppervlaktewater worden geloosd. Ook zou het alleen ontdaan kunnen worden van de mijnbouwhulpstoffen waarna het via een pijplijn naar zee kan worden gepompt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b174b673-7901-3863-9b3f-d6932f8d26e9",
                                        "entry_id": "3c2dd537-2822-3411-baa0-8a34a72ae1f5",
                                        "glosses": [
                                            "het verwijderen, uitschakelen van elementen die als onbetrouwbaar worden beschouwd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63565925-5cd7-4444-af7d-b51cd1bc5770",
                                                "sense_id": "b174b673-7901-3863-9b3f-d6932f8d26e9",
                                                "text": "Jozef Stalin liet gruwelijke zuiveringen uitvoeren die tientallen miljoenen het leven kostten"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77257a9f-349e-325c-8dc3-c1c4f6a0e55e",
