                            {
                                "example_id": "6a71701e-1ff4-4030-a742-051f6d14055b",
                                "sense_id": "d8f6d2be-bb14-3daf-81de-185b6d5654bb",
                                "text": "„Man hätte eigene Nachforschungen anstellen müssen – und zu diesem Zweck sandten sie an den Herrn Präfekten eine Bittschrift, auf die jedoch keine Antwort erfolgte.“"
                            }
                        ],
