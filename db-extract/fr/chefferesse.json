                "senses": [
                    {
                        "sense_id": "8356c899-88f3-392d-8942-b944b5077e71",
                        "entry_id": "2a3aade9-dccc-3936-bbf9-156ce1bcd793",
                        "glosses": [
                            "Celle qui est à la tête d’un corps, d’une assemblée, etc., qui y a le premier rang et la principale autorité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79c15559-28fa-45d1-9ff1-83e80ba403ab",
                                "sense_id": "8356c899-88f3-392d-8942-b944b5077e71",
                                "text": "Il est à remarquer que toutes les communautés religieuses ont un chef à qui chaque membre est tenu d'obéir, ou une chefferesse abbesse ; roi ou reine, c’est un maître absolu."
                            },
                            {
                                "example_id": "76f1e92d-4eab-488a-a683-815872d0ccb2",
                                "sense_id": "8356c899-88f3-392d-8942-b944b5077e71",
                                "text": "Une autre chefferesse, la grosse Dongoula, administre son village avec sagesse."
                            },
                            {
                                "example_id": "273544c8-8bf7-4395-93de-8971597adddb",
                                "sense_id": "8356c899-88f3-392d-8942-b944b5077e71",
                                "text": "Lorsqu’elle se leva, les cuisses engluées de sa semence, il rit et se mit face au vent à lancer sa voix dans la campagne qui parut la porter très loin vers les troupeaux rougeoyants du couchant où elle devint chefferesse de transhumance."
                            }
                        ]
                    }
