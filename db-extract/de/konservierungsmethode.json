                        "examples": [
                            {
                                "example_id": "ac8e8632-806f-4aad-b8d5-8e1a1e481d00",
                                "sense_id": "d8425a9a-2260-3536-b4b5-f2d032eaebaf",
                                "text": "„Zu Zeiten unserer Großmütter war das Einmachen noch eine Selbstverständlichkeit und die verbreitetste Konservierungsmethode von Lebensmitteln.“"
                            },
                            {
                                "example_id": "925c55a9-8779-446c-b06e-c0c871d3b749",
                                "sense_id": "d8425a9a-2260-3536-b4b5-f2d032eaebaf",
                                "text": "„Viele im industriellen Maßstab genutzte Konservierungsmethoden sind im Prinzip Jahrtausende alt.“"
                            },
                            {
                                "example_id": "7bd88e59-bf1a-43f5-b2c8-5fed5406b8b0",
                                "sense_id": "d8425a9a-2260-3536-b4b5-f2d032eaebaf",
                                "text": "„Der älteste Sohn wird Anfang des neuen Jahrhunderts jene Konservierungsmethode entdecken, die dann die Kochkunst revolutioniert.“"
                            }
                        ],
