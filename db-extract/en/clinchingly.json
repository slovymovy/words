                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47496f00-5e81-4992-9fd0-c0ad48c892a9",
                                "sense_id": "11550fc1-3e9b-367a-b40b-8c99139327d4",
                                "text": "She waited, till with quickened breath\nShe spoke, as one who banisheth\nReserves that lovecraft heeds so well,\nTo ease some mighty wish to tell:\n“’Twas I,” said she,\n“Who wrote thus clinchingly."
                            },
                            {
                                "example_id": "2ca635ab-3e18-4c14-94a7-0a9f4b644165",
                                "sense_id": "11550fc1-3e9b-367a-b40b-8c99139327d4",
                                "text": "“I wouldn't be at all surprised if he drank a lot,” said Lady Partridge, with a hint of solidarity. ¶ “And then, of course,” said Nick clinchingly, but with a sad loll of the head, “he jumped off a bridge into the Mississippi.”"
                            },
                            {
                                "example_id": "b2163e44-91e8-4490-8bd5-4c21520528bf",
                                "sense_id": "11550fc1-3e9b-367a-b40b-8c99139327d4",
                                "text": "These circumstances are clinchingly against the appellant."
                            }
                        ]
                    }
