                ],
                "senses": [
                    {
                        "sense_id": "195664d3-d093-3736-b76c-57c819cf4029",
                        "entry_id": "797f3aa5-a66a-3fae-a136-3fcdb760afb1",
                        "glosses": [
                            "die Trinkreife oder der vollkommen veredelte Zustand eines Weines in der Flasche oder in einem Fass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac3bc9d-32b7-48fa-92e7-f8fa5e704b96",
                                "sense_id": "195664d3-d093-3736-b76c-57c819cf4029",
                                "text": "„Hat der Wein durch den Stopfen einen Knacks bekommen oder ist sein Aroma ein Ausdruck von Weinreife in der Flasche, einer aromatisch nicht exakt definierten Extratour?“"
                            },
                            {
                                "example_id": "739d8975-e538-4e8d-afa1-4f7f3471f74f",
                                "sense_id": "195664d3-d093-3736-b76c-57c819cf4029",
                                "text": "„Freiherr von Falkenstein stellte die Ansicht auf, daß man zwei verschiedene Zeitpunkte und Stufen der ökonomischen Weinreife zu unterscheiden habe: a. den Zeitpunkt und die erste Trinkreife nach der beendigten tumultuarischen Gährung, oder nach der vollendeten Umbildung des Traubensaftes in Wein; b. den Zeitpunkt und die erreichte Veredlungsgrenze des Weines, durch die fortwährende stille Gährung desselben, während der Einlagerung und Kultur im Keller.“"
                            },
                            {
                                "example_id": "5c30e140-cc83-4d3a-9965-69fe3a6713bc",
                                "sense_id": "195664d3-d093-3736-b76c-57c819cf4029",
                                "text": "„Der Wein ist unbedingt als ein lebendiges Produkt anzusprechen, welches Leben ungezählte Variationen zuläßt, so daß die weinhauerliche Behauptung, beim Weinbau lernt man nie aus, den Nagel auf den Kopf trifft. Mehr vom Standpunkt der Verwertung als vom rein kellerwirtschaftlichen aus gesehen, gibt es beim Wein zwei voneinander zu unterscheidende Reifen: Allgemeine Weinreife und Flaschenreife.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "88924d7a-6248-33fe-8cc6-b537884d99b4",
                        "entry_id": "797f3aa5-a66a-3fae-a136-3fcdb760afb1",
                        "glosses": [
                            "die Zeit der Erntereife der Weintrauben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60aae96d-c045-418e-bc7a-1bb97063cd65",
                                "sense_id": "88924d7a-6248-33fe-8cc6-b537884d99b4",
                                "text": "„Die Zeit der Weinreife rückte heran. Ich war schon in den Bergen und ordnete die verschiedenen Vorbereitungen zur Lese an.“"
                            },
                            {
                                "example_id": "a6828796-94d2-4322-b13b-f3c6a82da917",
                                "sense_id": "88924d7a-6248-33fe-8cc6-b537884d99b4",
                                "text": "„Bei einer der Weinreife so günstigen Witterung gelangten selbst Spätsorten zu nie gekannter Vollkommenheit im Vorjahre. […] In Jahren, die der Weinreife weniger günstig sind, werden um die Weinstöcke am Spalier […] Gräben von 6 Zoll Tiefe gezogen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
