                                "target_senses": [
                                    {
                                        "sense_id": "ba77d37b-328e-3a41-8ea7-9f8ca6521759",
                                        "entry_id": "d540b87a-9d3d-3407-aad9-734d282246c9",
                                        "glosses": [
                                            "Uneven, with many furrows and prominent points, often in reference to the skin or hide of animals."
                                        ],
                                        "tags": [
                                            "of a surface"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7401b502-0ab6-401a-830f-f2a947e49670",
                                                "sense_id": "ba77d37b-328e-3a41-8ea7-9f8ca6521759",
                                                "text": "As the ocean receded from the beach it left the sand appearing wrinkled."
                                            },
                                            {
                                                "example_id": "fff4cf93-0e7b-4976-90fb-d321d546f8c4",
                                                "sense_id": "ba77d37b-328e-3a41-8ea7-9f8ca6521759",
                                                "text": "Lying on the floor was a dead man, in evening dress, with a knife in his heart. He was withered, wrinkled, and loathsome of visage. It was not till they had examined the rings that they recognized who it was."
                                            }
                                        ]
                                    }
