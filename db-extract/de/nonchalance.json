                    {
                        "form_id": "3f0dcb40-755e-401f-ac3a-6f8c76c0c4c0",
                        "entry_id": "d62a727f-d13b-34f2-9e33-01ac3eba9328",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Nonchalance"
                    },
                    {
                        "form_id": "8e8c979c-04aa-4b15-8484-ecbb97f4939a",
                        "entry_id": "d62a727f-d13b-34f2-9e33-01ac3eba9328",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Nonchalance"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                        "entry_id": "d62a727f-d13b-34f2-9e33-01ac3eba9328",
                        "glosses": [
                            "Haltung/Verhalten, eigene Ideen/Interessen zu verfolgen, ohne sich allzu sehr auf andere Betroffene einzustellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad43779d-e911-4945-9d46-97170d954903",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "Seine Nonchalance wirkte auf mich etwas hochnäsig."
                            },
                            {
                                "example_id": "c801cb4c-187b-4b87-bc24-2088903117a2",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "„Zur Anmut gehören Beiläufigkeit, Ungekünsteltheit, Nonchalance, Sprezzatura; und wenn sie in Begleitung ihrer Schwester, der Demut, auftritt, ist sie unbesiegbar.“"
                            },
                            {
                                "example_id": "3f8fcf68-3adb-4e89-9fa7-1c95711b81fc",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "„Er antwortet mit der Nonchalance eines Amerikaners, der nach dem dritten Wortwechsel nach deinem Einkommen fragt.“"
                            },
                            {
                                "example_id": "efca07d2-3b62-4d40-8db8-bde502d937d8",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "„Seine Nonchalance reizte sie.“"
                            },
                            {
                                "example_id": "c8bb0664-313b-4ab3-9f88-486f358b02e2",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "„Nonchalance gehörte mit zur Genialität, und so focht er denn, beide Füße weit vorgestreckt und die linke Hand in der Hosentasche, mit seiner rechten in der Luft umher, um durch lebhafte Gestikulationen seinem Kathedervortrage Nachdruck zu geben.“"
                            },
                            {
                                "example_id": "acc94b0c-e182-4910-9794-e0b511954a74",
                                "sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                                "text": "„Er zuckte mit gespielter Nonchalance mit den Achseln, aber Smithback erkannte, dass er seine Aufregung kaum zügen konnte“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b33793d-b69d-44c5-bb29-0da33cb930aa",
                        "source_entry_id": "d62a727f-d13b-34f2-9e33-01ac3eba9328",
                        "source_sense_id": "71d06300-d9eb-31bf-b9ac-ef95cf9ce086",
                        "target_lang_word": "nonchalance",
