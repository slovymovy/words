{
    "word_family": [
        "imperious",
        "imperial",
        "empire",
        "emperor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7e2f8a2a-6db1-332e-84de-7f895fe25c49",
                    "sense_definition": "Relating to the grammatical mood that expresses a command, request, or advice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher taught us the <w>imperative</w> form today.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил нам сегодня <w>повелительную</w> форму.",
                                "de": "Der Lehrer hat uns heute die <w>Imperativform</w> beigebracht."
                            }
                        },
                        {
                            "text": "In English, the <w>imperative</w> verb often lacks a visible subject.",
                            "target_lang_translations": {
                                "ru": "В английском языке глагол в <w>повелительном наклонении</w> часто не имеет видимого подлежащего.",
                                "de": "Im Englischen fehlt dem Verb im <w>Imperativ</w> oft ein sichtbares Subjekt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "imperative mood",
                        "imperative form"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому наклонению, которое выражает приказ, просьбу или совет.",
                        "de": "Bezieht sich auf den grammatikalischen Modus, der einen Befehl, eine Bitte oder einen Rat ausdrückt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повелительный",
                                "target_lang_sense_clarification": "грамматика"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "imperativisch",
                                "target_lang_sense_clarification": "grammatikalische Form"
                            },
                            {
                                "target_lang_word": "befehlsform",
                                "target_lang_sense_clarification": "grammatikalische Bezeichnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8ce1d8f-98bd-3667-82df-83b604909c0f",
                    "sense_definition": "Extremely important or urgent; essential.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>imperative</w> that you call the doctor immediately.",
                            "target_lang_translations": {
                                "ru": "<w>Крайне необходимо</w>, чтобы вы немедленно позвонили врачу.",
                                "de": "Es ist <w>dringend</w> erforderlich, dass Sie sofort den Arzt rufen."
                            }
                        },
                        {
                            "text": "Water is <w>imperative</w> for the survival of all living things.",
                            "target_lang_translations": {
                                "ru": "Вода <w>жизненно необходима</w> для выживания всех живых существ.",
                                "de": "Wasser ist <w>unerlässlich</w> für das Überleben aller Lebewesen."
                            }
                        }
                    ],
                    "synonyms": [
                        "required"
                    ],
                    "common_phrases": [
                        "absolutely imperative",
                        "it is imperative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно важный или срочный; существенный.",
                        "de": "Äußerst wichtig oder dringend; unerlässlich."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крайне необходимый",
                                "target_lang_sense_clarification": "очень важный"
                            },
                            {
                                "target_lang_word": "обязательный",
                                "target_lang_sense_clarification": "требуемый"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "dringend",
                                "target_lang_sense_clarification": "nicht aufschiebbar"
                            },
                            {
                                "target_lang_word": "unerlässlich",
                                "target_lang_sense_clarification": "absolut notwendig"
                            },
                            {
                                "target_lang_word": "zwingend",
                                "target_lang_sense_clarification": "erforderlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8de83be-be28-3ca2-b1bf-6fa1a00ec872",
                    "sense_definition": "Expressing a command or authority; expecting obedience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She pointed to the door with an <w>imperative</w> gesture.",
                            "target_lang_translations": {
                                "ru": "Она указала на дверь <w>повелительным</w> жестом.",
                                "de": "Sie zeigte mit einer <w>gebieterischen</w> Geste zur Tür."
                            }
                        },
                        {
                            "text": "His <w>imperative</w> tone made everyone stop and listen.",
                            "target_lang_translations": {
                                "ru": "Его <w>повелительный</w> тон заставил всех остановиться и прислушаться.",
                                "de": "Sein <w>befehlender</w> Ton ließ alle innehalten und zuhören."
                            }
                        }
                    ],
                    "common_phrases": [
                        "imperative tone",
                        "imperative gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий приказ или власть; ожидающий повиновения.",
                        "de": "Einen Befehl oder Autorität ausdrückend; Gehorsam erwartend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повелительный",
                                "target_lang_sense_clarification": "о тоне или жесте"
                            },
                            {
                                "target_lang_word": "властный",
                                "target_lang_sense_clarification": "авторитетный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "gebieterisch",
                                "target_lang_sense_clarification": "einen Befehl ausdrückend"
                            },
                            {
                                "target_lang_word": "befehlend",
                                "target_lang_sense_clarification": "autoritär"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdc78d5f-f124-3277-911f-0756c25271b4",
                    "sense_definition": "Relating to a programming paradigm that describes computation as statements that change a program's state.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C and Java are examples of <w>imperative</w> programming languages.",
                            "target_lang_translations": {
                                "ru": "Си и Java — примеры <w>императивных</w> языков программирования.",
                                "de": "C und Java sind Beispiele für <w>imperative</w> Programmiersprachen."
                            }
                        },
                        {
                            "text": "The <w>imperative</w> style focuses on how the computer performs tasks step by step.",
                            "target_lang_translations": {
                                "ru": "<w>Императивный</w> стиль фокусируется на том, как компьютер выполняет задачи шаг за шагом.",
                                "de": "Der <w>imperative</w> Stil konzentriert sich darauf, wie der Computer Aufgaben Schritt für Schritt ausführt."
                            }
                        }
                    ],
                    "antonyms": [
                        "functional"
                    ],
                    "common_phrases": [
                        "imperative programming",
                        "imperative language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к парадигме программирования, описывающей вычисления как инструкции, изменяющие состояние программы.",
                        "de": "Bezieht sich auf ein Programmierparadigma, das Berechnungen als Anweisungen beschreibt, die den Zustand eines Programms ändern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "императивный",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "imperativ",
                                "target_lang_sense_clarification": "Informatik"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64776650-b20e-3f01-94f7-a6742c64ab47",
                    "sense_definition": "The grammatical mood or form used to express a command, request, or advice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grammar_sense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Go away!\" is a sentence in the <w>imperative</w>.",
                            "target_lang_translations": {
                                "ru": "«Уходи!» — это предложение в <w>повелительном наклонении</w>.",
                                "de": "„Geh weg!“ ist ein Satz im <w>Imperativ</w>."
                            }
                        },
                        {
                            "text": "Please conjugate this verb in the <w>imperative</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проспрягайте этот глагол в <w>повелительном наклонении</w>.",
                                "de": "Bitte konjugieren Sie dieses Verb im <w>Imperativ</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "imperative mood"
                    ],
                    "common_phrases": [
                        "in the imperative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грамматическое наклонение или форма, используемая для выражения приказа, просьбы или совета.",
                        "de": "Der grammatikalische Modus oder die Form, die verwendet wird, um einen Befehl, eine Bitte oder einen Rat auszudrücken."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повелительное наклонение",
                                "target_lang_sense_clarification": "грамматический термин"
                            },
                            {
                                "target_lang_word": "императив",
                                "target_lang_sense_clarification": "лингвистика"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Imperativ",
                                "target_lang_sense_clarification": "grammatikalische Form"
                            },
                            {
                                "target_lang_word": "Befehlsform",
                                "target_lang_sense_clarification": "grammatikalische Form"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d5be373-4ab4-3c91-8e1c-d5cf407cac73",
                    "sense_definition": "Something that is absolutely necessary or unavoidable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education is a moral <w>imperative</w> for a progressing society.",
                            "target_lang_translations": {
                                "ru": "Образование — это моральный <w>императив</w> для развивающегося общества.",
                                "de": "Bildung ist ein moralischer <w>Imperativ</w> für eine fortschreitende Gesellschaft."
                            }
                        },
                        {
                            "text": "The economic <w>imperative</w> forced the company to restructure.",
                            "target_lang_translations": {
                                "ru": "Экономическая <w>необходимость</w> вынудила компанию провести реструктуризацию.",
                                "de": "Die wirtschaftliche <w>Notwendigkeit</w> zwang das Unternehmen zur Umstrukturierung."
                            }
                        }
                    ],
                    "common_phrases": [
                        "moral imperative",
                        "political imperative"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то абсолютно необходимое или неизбежное.",
                        "de": "Etwas, das absolut notwendig oder unvermeidbar ist."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "императив",
                                "target_lang_sense_clarification": "требование, долг"
                            },
                            {
                                "target_lang_word": "необходимость",
                                "target_lang_sense_clarification": "насущная потребность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Imperativ",
                                "target_lang_sense_clarification": "moralische oder soziale Notwendigkeit"
                            },
                            {
                                "target_lang_word": "Muss",
                                "target_lang_sense_clarification": "etwas absolut Notwendiges"
                            },
                            {
                                "target_lang_word": "Notwendigkeit",
                                "target_lang_sense_clarification": "unvermeidbare Anforderung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}