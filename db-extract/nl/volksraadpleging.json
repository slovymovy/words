                ],
                "senses": [
                    {
                        "sense_id": "c00e94b2-4511-3ba8-b1d6-c0b92a9e585b",
                        "entry_id": "3130935d-c74a-3aa0-a324-5b7d27913c8d",
                        "glosses": [
                            "voorleggen van een vraag met betrekking tot wetgeving aan de kiesgerechtigden in een land of een bepaald gebied, waarbij de overheid niet verplicht is de uitslag te respecteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaa116fc-0cdf-494e-a2f0-79cb7c9782d3",
                                "sense_id": "c00e94b2-4511-3ba8-b1d6-c0b92a9e585b",
                                "text": "De Britse Brexit-voorvechter Nigel Farage voelt misschien toch wel iets voor een tweede referendum over het Britse EU-lidmaatschap. Hij zei in het programma The Wright Stuff dat een nieuwe volksraadpleging mogelijk een goed middel is om Brexit-critici de mond te snoeren."
                            },
                            {
                                "example_id": "3248e677-819c-430c-a263-fcdc52f4b587",
                                "sense_id": "c00e94b2-4511-3ba8-b1d6-c0b92a9e585b",
                                "text": "Het kabinet maakt haast met het intrekken van het raadgevend referendum. Minister Ollongren (Binnenlandse Zaken) heeft het wetsvoorstel waarmee de volksraadpleging wordt afgeschaft, nu al ingediend bij de Tweede Kamer. Over deze wet kan geen referendum worden aangevraagd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd2c8c56-0095-4dee-8677-e75b960d26e4",
                        "source_entry_id": "3130935d-c74a-3aa0-a324-5b7d27913c8d",
                        "source_sense_id": "c00e94b2-4511-3ba8-b1d6-c0b92a9e585b",
                        "target_lang_word": "plebiscite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plebiscite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "A direct popular vote on an issue of public importance, such as an amendment to the constitution, a change in the sovereignty of the nation, or some government policy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44eacf62-ada4-48f0-939b-00ec74b12f30",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "A political result, we may also say aim, of the frumentarian plebiscite of Gaius was to disattach the city populace from its conservative moorings and to enlist it in the service of reform."
                                            },
                                            {
                                                "example_id": "b2bfb294-7101-4115-8434-6c3b06bda2ab",
                                                "sense_id": "2e259a02-90ad-39eb-afa9-a4ae0262a172",
                                                "text": "Then something changed, and Mr. Mitterrand said he thought it would be a good idea if the Constitution allowed plebiscites, on the recommendation of the President, on issues involving personal freedoms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d83936-a608-380e-bbaf-9ed24d2dd9f6",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "An expression of the public's views on an issue, whether legally binding or not."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc92c3a5-b94c-38a2-99c6-af64d1bae287",
                                        "entry_id": "d3b7864e-1651-3991-9ffc-b085eb65b627",
                                        "glosses": [
                                            "Synonym of plebiscitum (“a law enacted by the common people, under the superintendence of a tribune or some subordinate plebeian magistrate, without the intervention of the senate”)."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58440b4b-a377-4cf1-8c57-96c8d6619b18",
                        "source_entry_id": "3130935d-c74a-3aa0-a324-5b7d27913c8d",
                        "source_sense_id": "c00e94b2-4511-3ba8-b1d6-c0b92a9e585b",
