                                    {
                                        "sense_id": "7afb4b70-27ca-3457-baa8-0fbcd7f6f3ca",
                                        "entry_id": "eda66dbe-6eec-3164-8c66-a9f532b820ef",
                                        "glosses": [
                                            "One who constructs a world, especially a convincing fictional world for literature etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f4824ec-1a05-40a9-8df7-8c784ef3410b",
                                                "sense_id": "7afb4b70-27ca-3457-baa8-0fbcd7f6f3ca",
                                                "text": "Many mistake my approach as hostile to the sacrosanct memory of J. R. R. Tolkien, undoubtedly one of the greatest worldbuilders of the 20th century and indirectly the father of both a literary and a gaming genre."
                                            },
                                            {
                                                "example_id": "00f09516-ba32-4b7b-bb20-f1837efdcc41",
                                                "sense_id": "7afb4b70-27ca-3457-baa8-0fbcd7f6f3ca",
                                                "text": "We are weary of theoretical worldbuilders who strive to construct logical designs that weave together all components of the social fabric."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
