                            },
                            {
                                "target_lang_word": "hinderlich",
                                "target_lang_sense_clarification": "Hindernis bei Projekten, Abläufen"
                            },
                            {
                                "target_lang_word": "störend",
                                "target_lang_sense_clarification": "Lärm, Werbung, Unterbrechungen"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "molesto",
