                "senses": [
                    {
                        "sense_id": "b5018c49-25cf-39c8-a2a3-aa679621749d",
                        "entry_id": "6baf4dce-4eae-3356-afc7-57cac7f8161f",
                        "glosses": [
                            "Qui concerne les animaux."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "fb75c7fb-fd4e-4987-a991-1bb3c2602de7",
                                "sense_id": "b5018c49-25cf-39c8-a2a3-aa679621749d",
                                "text": "La sixième section leur est consacrée sous le titre de morale zootique, ou rapports de l’homme avec les animaux."
                            },
                            {
                                "example_id": "630264af-bc81-4815-9740-0949c7a2de70",
                                "sense_id": "b5018c49-25cf-39c8-a2a3-aa679621749d",
                                "text": "C'est d'abord le kazikumük, qui cumule les trois genres, de sorte qu'il obtient : nᵒ 1 le genre anthropique masculin, nᵒ 2 le genre anthropique féminin, nᵒ 3 le genre animal ou zootique, nᵒ 4 le genre inanimé."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4825e83-e0c5-35a0-b882-d5568053a9e2",
                        "entry_id": "6baf4dce-4eae-3356-afc7-57cac7f8161f",
                        "glosses": [
                            "Qualifie une maladie contractée par contact avec les animaux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "9b9398bc-30a6-472d-95f8-eb9248a3d215",
                                "sense_id": "c4825e83-e0c5-35a0-b882-d5568053a9e2",
                                "text": "J’appelle infection zootique celle qui prend sa source dans les émanations animales et infection paludique celle qui la puise dans le sol."
                            },
                            {
                                "example_id": "ea8aa58d-a390-430a-b859-353255380d60",
                                "sense_id": "c4825e83-e0c5-35a0-b882-d5568053a9e2",
                                "text": "Le bacille peut circuler des rats à l’homme (peste zootique) ou de l’homme à l’homme (peste démique)."
                            }
                        ]
                    },
                    {
                        "sense_id": "17d2ff3e-b70e-302f-9951-73fd89524c3a",
                        "entry_id": "6baf4dce-4eae-3356-afc7-57cac7f8161f",
                        "glosses": [
                            "Qui contient des débris ou fossiles d’animaux."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "1ccff739-f3b1-4f6b-baab-802b212fccd5",
                                "sense_id": "17d2ff3e-b70e-302f-9951-73fd89524c3a",
                                "text": "Il est donc d’un grand intérêt pour la géologie positive de reconnaître les lois qui ont présidé aux dépôts des deux classes de terrain zootique."
                            }
                        ]
                    }
                ],
