                "senses": [
                    {
                        "sense_id": "e0c46e30-7860-3c85-a0d7-0b325f3d32e4",
                        "entry_id": "fc821674-b3a0-3e91-b6e5-22c99b4c30ec",
                        "glosses": [
                            "действие по значению гл. охать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7bf40b9-743c-4194-b187-b77d03d9b373",
                                "sense_id": "e0c46e30-7860-3c85-a0d7-0b325f3d32e4",
                                "text": "Ругательства, крик, оханье раздавались по всей паперти."
                            },
                            {
                                "example_id": "72d706f6-c8d0-4fd7-ab86-ea35833b3b7f",
                                "sense_id": "e0c46e30-7860-3c85-a0d7-0b325f3d32e4",
                                "text": "Пришла гостья дорогая, а я потчую её оханьем да аханьем!"
                            },
                            {
                                "example_id": "fd4760ab-2e42-4109-849e-9e877a2367c1",
                                "sense_id": "e0c46e30-7860-3c85-a0d7-0b325f3d32e4",
                                "text": "Тут не поможешь ни оханьями, ни стонами, ни советами, вроде: кабы ты чуточку-чуточку влево забрал ― ну, и уцелела бы твоя голова!"
                            }
                        ]
                    }
                ],
