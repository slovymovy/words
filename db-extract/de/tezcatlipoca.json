                        "entry_id": "0f803e83-0785-3f4f-b38a-2260179fca12",
                        "glosses": [
                            "Gott der Nacht und der Materie bei den Tolteken und Azteken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab86b1d9-9061-4f94-b00b-0050096bbff3",
                                "sense_id": "1292c675-aecb-33e0-a08f-bb05a741caa5",
                                "text": "„Manche bekannten sich zu Tezcatlipoca, Rauchender Spiegel, einem boshaften Gott, der die Menschheit in einem Tanz anführte und dabei Häuptlingen und Kriegern half, durch Konflikte Veränderungen herbeizuführen.“"
                            },
                            {
                                "example_id": "330b2f34-be95-4bf5-8dff-bcec360fd9e5",
                                "sense_id": "1292c675-aecb-33e0-a08f-bb05a741caa5",
                                "text": "„Zur ersten Kategorie zählte der Gott Tezcatlipoca, der rauchende Spiegel, dem man großen Einfluss auf das Alltagsleben beimaß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
