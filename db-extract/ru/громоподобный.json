                ],
                "senses": [
                    {
                        "sense_id": "a1d08c20-610d-3973-97fe-f0824f88fff7",
                        "entry_id": "0f29c985-c689-347b-ab4e-3ddc250a96db",
                        "glosses": [
                            "звучащий подобно грому; очень громкий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe3a0925-d227-4001-a41b-8a71873c4183",
                                "sense_id": "a1d08c20-610d-3973-97fe-f0824f88fff7",
                                "text": "Толпа смотрела по сторонам, но туч нигде не было: это ракета раздвигала воздух, который и дал громоподобную воздушную волну."
                            },
                            {
                                "example_id": "04b5b3d1-379d-4df9-acec-8d191eee8855",
                                "sense_id": "a1d08c20-610d-3973-97fe-f0824f88fff7",
                                "text": "Раздается громоподобный, подозрительный звук, и водокачка извергает из себя сгустки вонючей плесени и разный мусор."
                            },
                            {
                                "example_id": "fc798275-d366-4f6a-ab1e-3611989bd100",
                                "sense_id": "a1d08c20-610d-3973-97fe-f0824f88fff7",
                                "text": "Этот последний взрыв прозвучал робко, тихо, словно пистолетный выстрел, в сравнении с громоподобными канонадами."
                            }
                        ]
                    }
                ],
