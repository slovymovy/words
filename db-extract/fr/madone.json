                    {
                        "translation_id": "ea4bb870-3e71-4801-a117-b26ca23c0792",
                        "source_entry_id": "1ad13e5a-2bd6-3614-8089-e62d42a0b387",
                        "target_lang_word": "богородица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "богородица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "03e09e31-7308-347f-860e-6dca0bc568b8",
                                        "entry_id": "5ac6cbdd-111a-3737-ac00-6439d1769590",
                                        "glosses": [
                                            "религ. в представлении христиан — дева Мария, непорочно зачавшая и родившая Иисуса Христа от Святого Духа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8964151e-6f55-4df1-b390-2ab5aef29a1e",
                                                "sense_id": "03e09e31-7308-347f-860e-6dca0bc568b8",
                                                "text": "Я всё смеюсь и шалю, я давеча вас рассердила, но уверяю вас, что сейчас, пред тем как взяла перо, я помолилась на образ богородицы, да и теперь молюсь и чуть не плачу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3a53ff7-4901-3d07-ab39-2400d526afc3",
                                        "entry_id": "5ac6cbdd-111a-3737-ac00-6439d1769590",
                                        "glosses": [
