                        "examples": [
                            {
                                "example_id": "ba81b35d-47b8-42f7-bc6f-6c4d1fb2cce8",
                                "sense_id": "98259490-eba8-3a78-ba23-72ffd3e10f71",
                                "text": "„›Glaub mir, wenn du mal zwei Minuten lang durch diesen Scheißsumpf gewatet bist, wirst du dich nach dem Dschungel zurücksehnen.‹“"
                            },
                            {
                                "example_id": "08bc173e-c736-4b7a-9ce6-275b8680c9ca",
                                "sense_id": "98259490-eba8-3a78-ba23-72ffd3e10f71",
                                "text": "„Wenn ich dir sage, du sollst im Sumpf eine Leiche versenken, dann heißt das, du schmeißt sie in den Scheißsumpf, klar?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
