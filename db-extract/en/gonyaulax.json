                            {
                                "example_id": "0b02559e-8a56-4643-b508-6b4cd74d0e65",
                                "sense_id": "e20c48f8-9e07-3146-909c-e905e0c9728b",
                                "text": "Recently, a gonyaulax toxin was purified from an axenic culture of the alga, Gonyaulax catanella, and this toxin has been shown to be chemically identical with saxitoxin (Schantz et al., 1966)."
                            },
                            {
                                "example_id": "a83d0b08-fd26-4cf4-9ce7-f361009ef19c",
                                "sense_id": "e20c48f8-9e07-3146-909c-e905e0c9728b",
                                "text": "Oval, strongly pigmented cells with a gonyaulax-like girdle displacement."
                            },
                            {
                                "example_id": "135be722-b2c7-49e6-bbd6-d7074c83c926",
                                "sense_id": "e20c48f8-9e07-3146-909c-e905e0c9728b",
                                "text": "Most shellfish lose their toxins almost completely within four to six weeks after a gonyaulax outbreak."
                            }
