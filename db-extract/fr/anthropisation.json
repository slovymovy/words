                                "example_id": "7eb899bb-ed81-414b-b732-fcd171700ac6",
                                "sense_id": "f3704ee2-7513-3ef3-894b-8bb6b5acf5ef",
                                "text": "Les recherches portant sur l'apparition des premiers indices d’anthropisation et l’évolution du signal anthropique sur le territoire français se sont particulièrement multipliées au cours de ces dernières années […]."
                            },
                            {
                                "example_id": "dc049b51-71e9-4ec1-949c-165cf5bd289d",
                                "sense_id": "f3704ee2-7513-3ef3-894b-8bb6b5acf5ef",
                                "text": "Bien qu’une dégradation du climat soit souvent proposée à cette époque, l’anthropisation des sols joue assurément un rôle dans l’augmentation de l’humidité en plaine."
                            }
                        ]
                    }
