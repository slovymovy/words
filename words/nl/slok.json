            "senses": [
                {
                    "sense_id": "498f292e-32cd-3f6f-9c70-bf10c7ed003b",
                    "sense_definition": "een hoeveelheid vloeistof die men in één keer doorslikt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "drinken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij nam een grote <w>slok</w> koud water na het hardlopen.",
                            "target_lang_translations": {
                                "en": "He took a large <w>swig</w> of cold water after running."
                            }
                        },
                        {
                            "text": "Zij nam een <w>slok</w> uit haar bidon tijdens de korte pauze.",
                            "target_lang_translations": {
                                "en": "She took a <w>sip</w> from her water bottle during the short break."
                            }
                        }
                    ],
                    "synonyms": [
                        "teug"
                    ],
                    "common_phrases": [
                        "een slok nemen",
                        "een slok water",
                        "een flinke slok"
                    ],
                    "target_lang_definitions": {
