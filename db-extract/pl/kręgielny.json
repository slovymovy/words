                        "examples": [
                            {
                                "example_id": "52db9f3f-4526-49fb-9e42-db1872af56db",
                                "sense_id": "b6134c6f-a276-319b-be79-87cd272c912e",
                                "text": "Car, jak kręgielna kula, między szyki / Wleciał i spytał o zdrowie gawiedzi"
                            },
                            {
                                "example_id": "50fc84e8-05d4-45bf-bd3f-5a2ace1adfed",
                                "sense_id": "b6134c6f-a276-319b-be79-87cd272c912e",
                                "text": "Spadła mu na palce kula kręgielna i pojechał na pogotowie."
                            }
                        ],
