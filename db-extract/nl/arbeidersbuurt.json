                        "source_sense_id": "b828a531-a3e3-3fc2-87e7-d124237a78d3",
                        "target_lang_word": "Arbeiterviertel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arbeiterviertel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f293b11-a9a8-3e24-abc2-52fb1c32339d",
                                        "entry_id": "a47efc47-412b-3fba-b21f-ec4a41bd0795",
                                        "glosses": [
                                            "Stadtteil, in dem vor allem die Arbeiterklasse wohnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2505564-174e-44e2-8b65-b0397bc39deb",
                                                "sense_id": "9f293b11-a9a8-3e24-abc2-52fb1c32339d",
                                                "text": "„Die südlichen Vororte und das Zentrum wurden besetzt, während man die Arbeiterviertel, wo man mit Gegenwehr rechnete, vorläufig in Ruhe ließ.“"
                                            },
                                            {
                                                "example_id": "dd6109e6-8928-4fa0-8b90-9033e1d5e8b1",
                                                "sense_id": "9f293b11-a9a8-3e24-abc2-52fb1c32339d",
                                                "text": "„Trotz des sonnigen Frühlingswetters lag über dem Arbeiterviertel eine explosive Stimmung.“"
                                            },
                                            {
                                                "example_id": "23ab5347-2711-4bf6-bf3c-828faee53ac4",
                                                "sense_id": "9f293b11-a9a8-3e24-abc2-52fb1c32339d",
                                                "text": "„Selbst im Falle von sozialen Protesten, wie etwa 1973 in den Unruhen in Landi und Orangi, zwei Arbeitervierteln in Karatschi, rief er sofort nach der Armee.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
