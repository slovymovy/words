                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Bereitschaft",
                                "target_lang_sense_clarification": "Allgemeiner Zustand des Bereitseins"
                            },
                            {
                                "target_lang_word": "Vorbereitetsein",
                                "target_lang_sense_clarification": "Der Zustand, sich vorbereitet zu haben"
                            }
                        ]
