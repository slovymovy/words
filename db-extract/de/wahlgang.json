                                        "examples": [
                                            {
                                                "example_id": "6d284512-8f3d-4537-9a07-e3026336cdd2",
                                                "sense_id": "8626ba6a-7072-3427-8836-cb2dcfc08080",
                                                "text": "Le scrutin majoritaire à deux tours est un mode de scrutin qui permet l'élection d'un candidat après deux tours de scrutin si aucun n’obtient la majorité au premier tour."
                                            },
                                            {
                                                "example_id": "3e30c324-77fd-4c38-9c5f-a8a549915930",
                                                "sense_id": "8626ba6a-7072-3427-8836-cb2dcfc08080",
                                                "text": "Les élections dans les pays anglo-saxons ne connaissent généralement qu’un tour de scrutin, le candidat ou la liste qui obtient le plus de voix emporte le siège."
                                            }
