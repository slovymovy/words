                "senses": [
                    {
                        "sense_id": "85842671-89d9-3808-9a03-14317f3bb089",
                        "entry_id": "0690560a-e56d-3f40-8683-51b066f97485",
                        "glosses": [
                            "bestimmter Sattel, auf dem Gepäck und Transportgut befestigt werden kann (ohne dass er als Sitz für einen Reiter dient)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87c4c433-61d9-443f-8eef-25df21c09e6b",
                                "sense_id": "85842671-89d9-3808-9a03-14317f3bb089",
                                "text": "„Es gäbe weder Gesetz noch Gericht in dem Lande da drüben. Da könne man jeden Tag von Räubern überfallen werden. Und Wege gäbe es dort gar nicht, sie würden gezwungen sein, all ihr Hab und Gut auf Pferden mit dem Saumsattel zu befördern, so wie drüben in den finnischen Wäldern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
