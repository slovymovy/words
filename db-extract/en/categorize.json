                                                "sense_id": "24b81e02-248f-3cfa-a9da-94d1ed94c2a1",
                                                "text": "Der Bibliothekarsassistent ist seit Tagen damit beschäftigt, die Neuzugänge zu kategorisieren."
                                            },
                                            {
                                                "example_id": "7e4b3d74-71bc-4542-86b1-32bcd397d4b0",
                                                "sense_id": "24b81e02-248f-3cfa-a9da-94d1ed94c2a1",
