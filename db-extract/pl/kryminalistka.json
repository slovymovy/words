                                "target_senses": [
                                    {
                                        "sense_id": "dd79116d-b394-3284-8746-555eea38bbdf",
                                        "entry_id": "06ccab73-e7f9-3373-9dc1-d719e2b61fca",
                                        "glosses": [
                                            "straffällige, weibliche Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8c85aa5-531f-45d2-a0e0-6d1b8b09863f",
                                                "sense_id": "dd79116d-b394-3284-8746-555eea38bbdf",
                                                "text": "Die Kriminelle wurde von der Polizei gestellt."
                                            },
                                            {
                                                "example_id": "768aaeed-e930-41c3-a64b-5db95a177f5f",
                                                "sense_id": "dd79116d-b394-3284-8746-555eea38bbdf",
                                                "text": "Eine Kriminelle entwendete mehrere Goldketten."
                                            },
                                            {
                                                "example_id": "904c1096-c0a5-40c2-8bc5-cbe18e98cfc6",
                                                "sense_id": "dd79116d-b394-3284-8746-555eea38bbdf",
                                                "text": "„Danach redeten sowohl Milena als auch Thomas heftig auf Amalia ein, dass der Anbau von Hanf strafbar und sie eine Kriminelle sei, dass sie die Pflanzen und das inkriminierende Gewächshaus schnellstens verschwinden lassen müsse, am besten noch heute Nacht, und ja, in jedem Fall zu einem Zeitpunkt, zu dem die Nachbarn es nicht bemerken würden.“"
                                            }
