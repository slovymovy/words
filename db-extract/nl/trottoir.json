                        "form": "trottoirtjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                        "entry_id": "58fb8eb3-da02-3763-97be-fdc04ed05061",
                        "glosses": [
                            "verhoging langs de weg waarover voetgangers zich kunnen bewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a211eb6-6f52-4cd3-8521-bc763c5b38a2",
                                "sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                                "text": "Het trottoir zal verbreed worden zodat mensen hier in de toekomst niet meer over de weg zullen hoeven lopen."
                            },
                            {
                                "example_id": "75d47c8c-3368-443d-b789-98e37ff4e73a",
                                "sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                                "text": "Bewoners van de Dokter Schräderlaan in het Brabantse Oisterwijk keken toch wat vreemd op, toen de werkzaamheden voor een nieuwe riolering waren voltooid. De lantaarnpaal die voorheen op het trottoir stond, staat nu plotseling op de rijbaan. Dat dat niet helemaal de bedoeling is, blijkt wel uit het feit dat de paal wordt afgeschermd door een rood-wit waarschuwingsbord. De gemeente Oisterwijk laat in een reactie weten dat het om een tijdelijke situatie gaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4d02a19-e8c5-4eef-85e7-cdea37eb2587",
                        "source_entry_id": "58fb8eb3-da02-3763-97be-fdc04ed05061",
                        "source_sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                        "source_sense_description": "een opvanghuis voor wezen",
                        "target_lang_word": "Bürgersteig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bürgersteig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                        "entry_id": "9114a79c-082c-32bb-9a1f-5262a590a855",
                                        "glosses": [
                                            "(durch eine Bordsteinkante von der Fahrbahn abgegrenzter, erhöhter) Weg für Fußgänger und Fußgängerinnen, der entlang einer Straße führt"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0604242a-0de5-4387-bb6b-81c2008670cb",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "Wir gingen auf dem Bürgersteig weiter."
                                            },
                                            {
                                                "example_id": "42ef80c1-e581-402f-8346-d5ae543394b6",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Es mußte in den letzten Minuten ein leichter Regen gefallen sein, — die Luft war feucht und schwer, um die Laternen zitterte ein bunter Nebel und die Bürgersteige glänzten stellenweise auf.“"
                                            },
                                            {
                                                "example_id": "7d63e45b-4ac5-4e9e-8ee4-efdf31ffdf5a",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Und die schmalen Bürgersteige füllen sich allmählich wieder mit schweigenden und debattierenden Leuten, von denen die meisten auf dem Heimweg von der Arbeit sind, wie man weiß, und fremd in dieser Straße.“"
                                            },
                                            {
                                                "example_id": "2cd7863e-1d94-4a9e-ae74-c665ada61f8b",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Der Haupteingang mit seinen vier Schwingtüren zieht so viele Leute vom Bürgersteig, daß der Trott der Passanten an dieser Stelle aus dem Schritt kommt.“"
                                            },
                                            {
                                                "example_id": "8db03ee2-fa37-4d58-b69a-fc818aef3714",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Der Bürgersteig war schmal.“"
                                            },
                                            {
                                                "example_id": "ba37b777-72dd-4561-9544-6ada9f896d89",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Kinder lutschten Eis und tollten über den Bürgersteig.“"
                                            },
                                            {
                                                "example_id": "70b60e8d-6c71-4717-8b75-1d4e6d170a83",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Auf den Bürgersteigen stand der Schnee kniehoch.“"
                                            },
                                            {
                                                "example_id": "020c5d48-84cb-456c-bd21-1f48b35a3dc8",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Auf den Bürgersteigen herrscht das alltägliche geschäftige Treiben, auf den Terrassen der Cafés bleibt kein Tisch frei.“"
                                            },
                                            {
                                                "example_id": "3e63503f-49fe-4ede-8237-623c1b0ef9f9",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Ihr bunter, wehender Mantel nahm die gesamte Breite des Bürgersteiges ein.“"
                                            },
                                            {
                                                "example_id": "b97a0602-12f8-4957-b808-523523111bac",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Sie ging am äußersten Rand des Bürgersteigs, um nicht von einem Verfolger in einen Hausflur gezogen zu werden.“"
                                            },
                                            {
                                                "example_id": "1c2e2330-1ce8-4be9-a2b9-fa671c735da2",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Die Fahrbahn liegt unbewegt und klar im Schein der Laternen da, und auch der Bürgersteig ist leer und fast schattenlos.“"
                                            },
                                            {
                                                "example_id": "33fd03c6-e32e-4a95-96e8-cebf9c35e328",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Hugo bewegte sich nicht vom Törchen weg, und ich hätte bloß einen kleinen Schritt hinaus auf den Bürgersteig machen müssen, damit er mir gefolgt wäre.“"
                                            },
                                            {
                                                "example_id": "e2d52955-94a9-438a-9753-793d818f5700",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Rasch füllte sich der Bürgersteig hinter ihm mit weiteren Wartenden.“"
                                            },
                                            {
                                                "example_id": "4596c8eb-f872-439e-b179-76919df17e02",
                                                "sense_id": "c8308f0b-514d-3570-bcd7-fe3676063fda",
                                                "text": "„Die Massivität, mit der es nun aus seinen Refugien hinaus in die Straßen und Bürgersteige drängte, machte jede Hoffnung zunichte, es könnte im Laufe des Winters auf mysteriöse Weise zu einem harmlosen Stadtgras mutiert sein wie seinerzeit die Wasserpest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd8520eb-9a50-448a-bf0b-c8953e3cd80b",
                        "source_entry_id": "58fb8eb3-da02-3763-97be-fdc04ed05061",
                        "source_sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                        "source_sense_description": "een opvanghuis voor wezen",
                        "target_lang_word": "Gehweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                        "entry_id": "9691fe60-f0b1-3f6a-a056-0da7fa76ed7b",
                                        "glosses": [
                                            "neben einer Fahrbahn befindliche Verkehrsfläche für Fußgänger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66c49f3e-4cda-4a07-a07c-b8b43ec3ea1c",
                                                "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                                "text": "Wir gingen auf dem Gehweg weiter."
                                            },
                                            {
                                                "example_id": "7bd68497-9eda-44db-b3e4-c33476fa1daa",
                                                "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                                "text": "„Ich fragte ihn, ob die Gehwege nach einem bestimmten System geräumt würden, ob einige Wege als bedeutender galten als andere.“"
                                            },
                                            {
                                                "example_id": "95e3cbcf-bd37-4e57-b482-8c34750307d8",
                                                "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                                "text": "„Die Main Street um 1900; man sieht die Pferdebahn, links und rechts lange Reihen von Läden, die Markisen wegen der Sonne weit heruntergelassen, ein paar Kutschen und Fuhrwerke, Gehwege voller Spaziergänger.“"
                                            },
                                            {
                                                "example_id": "214a9ddd-3c3d-4df4-9dfa-e8e1c4b17fce",
                                                "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                                "text": "„Sie reihten sich so dicht hintereinander, daß Sabina auf der anderen Straßenseite nicht mehr den Gehweg und die Häuser sehen konnte.“"
                                            },
                                            {
                                                "example_id": "3527dc87-8e92-4d45-b3c4-455c32f0b378",
                                                "sense_id": "82108050-580f-3eaf-b6c3-f54d74aff906",
                                                "text": "„In einem regelmäßigen Straßengitter mit teilweise überdachten Gehwegen standen Fachwerkhäuser unterschiedlichster Größe und mit der Front nicht unbedingt an der Straße orientiert – jedes Raster bildete eine Freifläche, auf der sich die unterschiedlichsten Gebäude versammelten, kleine Häuser und größere Gehöfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "595eea73-d7db-30bd-b43a-d430b1aecd1c",
                                        "entry_id": "9691fe60-f0b1-3f6a-a056-0da7fa76ed7b",
                                        "glosses": [
                                            "In der Verwaltungsvorschrift zur deutschen Straßenverkehrsordnung wird das Wort Gehweg an einer Stelle ungenau und vom umgangssprachlichen Gebrauch abweichend für die gesamte neben der Fahrbahn befindliche Verkehrsfläche verwendet, die oft aus Fußweg und Rad(fahr)weg besteht."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bde7bc1c-34b9-33f3-8dd9-8afeba90efd7",
                                        "entry_id": "9691fe60-f0b1-3f6a-a056-0da7fa76ed7b",
                                        "glosses": [
                                            "für den Fußgängerverkehr bestimmter (und als solcher gekennzeichneter) Weg"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9f44647-b618-44f7-9d72-8b2a19cd7466",
                                                "sense_id": "bde7bc1c-34b9-33f3-8dd9-8afeba90efd7",
                                                "text": "„Das zu betreuende Areal umfasste die Gehsteige entlang und die Gehwege innerhalb der Wohnanlage mit einer Gesamtlänge von ca 850 m.“"
                                            },
                                            {
                                                "example_id": "3aa7629f-5d9f-4369-a823-8452575ea41a",
                                                "sense_id": "bde7bc1c-34b9-33f3-8dd9-8afeba90efd7",
                                                "text": "„Langsam, ohne Eile wandern wir Schritt für Schritt den sandigen, kaum einen Meter breiten Gehweg zwischen Wald und den am Waldrand mit Maschendraht eingezäunten Gärten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45b6de33-dae6-4091-b741-8c6a45b9aa85",
                        "source_entry_id": "58fb8eb3-da02-3763-97be-fdc04ed05061",
                        "source_sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                        "source_sense_description": "een opvanghuis voor wezen",
                        "target_lang_word": "Gehsteig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gehsteig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                        "entry_id": "07730481-7cca-3687-8a39-fa203f3675f3",
                                        "glosses": [
                                            "neben einer Fahrbahn befindlicher Weg für Fußgänger; besonderer, meist erhöhter Weg für Fußgänger an der Seite einer Straße"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2947f969-2b50-491d-aa34-aa202a72188d",
                                                "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                                "text": "Wir gingen auf dem Gehsteig weiter."
                                            },
                                            {
                                                "example_id": "061568d9-99a3-402d-a7a3-da26e1be67f2",
                                                "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                                "text": "„Er fuhr an den Gehsteig heran und wandte sich an einen Fußgänger.“"
                                            },
                                            {
                                                "example_id": "b4a1704b-b42e-4f1e-83c9-b41745e18694",
                                                "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                                "text": "„Mitte September begann Ludwig Bertini, den Schutt über dem Keller mit den Steinfliesen des Gehsteiges abzudecken.“"
                                            },
                                            {
                                                "example_id": "2cefd5f5-1257-44b0-96e2-4c812ab5f756",
                                                "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                                "text": "„Pförtner kehrten die Gehsteige und besprengten sie mit Wasserschläuchen.“"
                                            },
                                            {
                                                "example_id": "ecfdea01-38e7-476c-96fe-17a576678bc1",
                                                "sense_id": "1a5fcb74-407f-3e6a-85db-f0de82b6a279",
                                                "text": "„Gehsteig: ein für den Fußgängerverkehr bestimmter, von der Fahrbahn durch Randsteine, Bodenmarkierungen oder dgl. abgegrenzter Teil der Straße; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a89604e-3031-4748-9aaf-8ffacb154a5f",
                        "source_entry_id": "58fb8eb3-da02-3763-97be-fdc04ed05061",
                        "source_sense_id": "ba8aa5e4-1c4c-37a6-a3ec-0515e4ef1e92",
                        "source_sense_description": "een opvanghuis voor wezen",
                        "target_lang_word": "trottoir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trottoir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                        "entry_id": "f6c84d65-e894-31ab-b89b-68016d482b1f",
                                        "glosses": [
                                            "Espace surélevé ménagé sur le côté d’une chaussée, d’un quai, d’une rue pour le passage des piétons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e23007-105d-4352-afbc-f61759664c0e",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "Une pluie glacée tombait dans les rues miroitantes. Je marchais le long des boutiques, m’appuyant au rebord des devantures pour ne point m’écrouler sur le trottoir."
                                            },
                                            {
                                                "example_id": "fb331842-b6da-44da-a37c-b14e44411699",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "Rien qu’à vous promener sur les trottoirs des grandes rues, un soir, quand la journée de travail est finie — pas des petits trottoirs de planches comme à Roberval, mais de beaux trottoirs d’asphalte plats comme une table et larges comme une salle — rien qu’à vous promener de même, avec les lumières, les chars électriques qui passent tout le temps, les magasins, le monde, vous verriez de quoi vous étonner pour des semaines."
                                            },
                                            {
                                                "example_id": "a869224f-0f1e-4b20-bc61-fa8d41541899",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "Mais lorsque Aimery mit pied à terre sur le trottoir de la gare, il lui resta encore un peu de doute, c’est-à-dire une espérance."
                                            },
                                            {
                                                "example_id": "19b6c425-18fa-4579-9cb3-2f557585f2cd",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "[…] rien ne resplendit plus, après minuit, que cinq ou six débits mal fréquentés dont l’éclairage ourle le trottoir d’un morne flamboiement."
                                            },
                                            {
                                                "example_id": "caaeb732-8800-44a2-af1a-d29dcba3f638",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "Quelle cohue sur les trottoirs et comme il est difficile de se mouvoir parmi ces gens qui, sans penser à mal, vous coudoient !"
                                            },
                                            {
                                                "example_id": "24e2f8cf-e296-4a4b-a613-a32a3bd0e192",
                                                "sense_id": "2565ecfe-d8fa-3a71-b3bd-fb118ea87c77",
                                                "text": "Le pourpier pousse partout, dans les jardins mais aussi entre les pavés, les murs, les trottoirs, et tous ces interstices urbains dans lesquels la nature sait si bien se glisser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faa1884a-0869-391e-8fdb-9a315b12cf17",
                                        "entry_id": "f6c84d65-e894-31ab-b89b-68016d482b1f",
                                        "glosses": [
                                            "Bord d’une tarte, d’une pizza."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50f348f4-cfbf-48c3-b9e1-04de3e0a4b6b",
                                                "sense_id": "faa1884a-0869-391e-8fdb-9a315b12cf17",
                                                "text": "D’habitude je ne mange jamais le trottoir mais là il était hors de question de faire un tel gâchis. Les ingrédients de la pizza étaient particulièrement frais et les anchois n’étaient pas collés à la sauce tomate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36d23e8c-03ec-3950-84ac-4e137a88ea68",
                                        "entry_id": "f6c84d65-e894-31ab-b89b-68016d482b1f",
                                        "glosses": [
                                            "Nom d’une sorte de pâtisserie, consistant en une pâte feuilletée, généralement rectangulaire, avec une garniture fruitée recouverte de lanières de pâte entrecroisées, dont l’aspect rappelle celui d’un trottoir ^([1])."
                                        ],
                                        "tags": [
                                            "Québec",
                                            "Pâtisserie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a8de27c-8cc7-3e9b-a1a5-0215c36527b1",
                                        "entry_id": "f6c84d65-e894-31ab-b89b-68016d482b1f",
                                        "glosses": [
                                            "(Enseignement) Interligne sur un cahier d'écriture."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07752024-2e9a-4d8a-b14d-8d8b1356735c",
                                                "sense_id": "9a8de27c-8cc7-3e9b-a1a5-0215c36527b1",
                                                "text": "Ensemble de 4 cahiers d'écriture : trottoirs larges."
                                            },
                                            {
                                                "example_id": "b4c0aa65-0a36-4aa0-a579-927b7cae288f",
                                                "sense_id": "9a8de27c-8cc7-3e9b-a1a5-0215c36527b1",
                                                "text": "Pour se pratiquer: Écriture des chiffres dans les trottoirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
