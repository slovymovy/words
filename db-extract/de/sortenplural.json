                "senses": [
                    {
                        "sense_id": "7cab8edc-8616-33be-95c4-539009b6f261",
                        "entry_id": "ece15462-eda2-30fc-a226-8e544b227cb5",
                        "glosses": [
                            "die Mehrzahl (Plural), bei der verschiedene Sorten, Klassen zusammengefasst werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5f707f-f333-4f0e-9552-8aa781b6d712",
                                "sense_id": "7cab8edc-8616-33be-95c4-539009b6f261",
                                "text": "Spreche ich von ‚Ölen‘, wenn ich ‚Ölsorten‘ meine, ist das ein Sortenplural."
                            },
                            {
                                "example_id": "ad82707d-08fa-4fc5-90c1-8a04badad78a",
                                "sense_id": "7cab8edc-8616-33be-95c4-539009b6f261",
                                "text": "„Wie die Bezeichnung sagt, werden durch den Sortenplural Entitäten unterschiedlicher Art erfaßt: Sie sind qualitativ voneinander unterschieden[.]“"
                            },
                            {
                                "example_id": "9e5c211f-8a84-4734-ba35-5b8647e5b035",
                                "sense_id": "7cab8edc-8616-33be-95c4-539009b6f261",
                                "text": "„Jedoch spielt dieser Sortenplural nur in Fachsprachen eine Rolle, morphologisch unterscheidet er sich nicht vom Plural zählbarer Nomina[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
