                ],
                "senses": [
                    {
                        "sense_id": "1ecad30e-3ef5-35b4-a46d-c9cd5733f454",
                        "entry_id": "d9e424cf-4605-385c-a082-bdfbf1e193cd",
                        "glosses": [
                            "To extend or expand, as from internal pressure; to swell"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "275d63e2-9988-43e3-a96c-4d2a52b3c6c5",
                                "sense_id": "1ecad30e-3ef5-35b4-a46d-c9cd5733f454",
                                "text": "Then came the arrowy flight and form of the hurricane itself—its actual bulk—its imbodied power, pressing along through the forest in a gyratory progress, not fifty yards wide, never distending in width, yet capriciously winding from right to left and left to right."
                            },
                            {
                                "example_id": "39dcf679-1beb-4472-9253-751845f4d301",
                                "sense_id": "1ecad30e-3ef5-35b4-a46d-c9cd5733f454",
                                "text": "I begin to hate the theater, the feeling wickedly distended by histrionics, all the old gestures, clutchings, tears, and applications."
                            }
                        ]
                    },
                    {
                        "sense_id": "516cc372-32c9-3f9b-8b1b-a992028fa852",
                        "entry_id": "d9e424cf-4605-385c-a082-bdfbf1e193cd",
                        "glosses": [
                            "To extend; to stretch out; to spread out."
                        ],
                        "tags": [
                            "archaic",
                            "reflexive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f71c376c-9ca6-4100-ad58-a438fb48add9",
                                "sense_id": "516cc372-32c9-3f9b-8b1b-a992028fa852",
                                "text": "These impure and frail matters are conteined within the angust concave of the Lunar Orb, above which with uninterrupted Series the things Celestial distend themselves."
                            },
                            {
                                "example_id": "3f92e28a-e3b6-46a5-972e-eabc8af1529f",
                                "sense_id": "516cc372-32c9-3f9b-8b1b-a992028fa852",
                                "text": "But say, what mean those coloured streaks in heaven / Distended as the brow of God appeased?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7300bbfd-e4d9-37e1-a5be-c57b3b94e938",
                        "entry_id": "d9e424cf-4605-385c-a082-bdfbf1e193cd",
                        "glosses": [
                            "To cause to swell."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "613c1c58-694d-30f4-a627-a35ab1cf1f3a",
                        "entry_id": "d9e424cf-4605-385c-a082-bdfbf1e193cd",
                        "glosses": [
                            "To cause gravidity."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e30c0301-91be-49ad-ab3d-12ed0c474dca",
                        "source_entry_id": "d9e424cf-4605-385c-a082-bdfbf1e193cd",
                        "source_sense_description": "to extend or expand",
                        "target_lang_word": "distendre",
