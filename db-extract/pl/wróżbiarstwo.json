                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "258fd317-ba74-4ad3-bb4f-c8f219b2b73f",
                                "sense_id": "2bfc8b84-6993-3a79-937a-cf0a419f4a7f",
                                "text": "Harry zdziwił sie, widząc profesor Trelawney, nauczycielkę wróżbiarstwa, siedzącą z drugej strony Hagrida; rzadko opuszczała swój pokój na szczycie wieży i jeszcze nigdy nie zaszczyciła swoją obecnością uczty powitalnej.",
                                "translation": "Harryho překvapilo, že viděl profesorku Trelawneyovou, učitelku věštění, sedět na druhé straně Hagrida; zřídkakdy opouštěla svůj pokoj na vrcholu věže a nikdy neozdobila uvítací hostinu svou přítomností."
                            }
                        ]
                    }
