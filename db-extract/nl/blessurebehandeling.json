                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0ec4c4-1dd1-48b8-8fba-bab69f021097",
                                "sense_id": "dc8873f0-486d-33ee-a644-1474152fb49a",
                                "text": "Pattinama-Kerkhove werd in haar tweede servicegame al gebroken door de Chinese. Wang moest halverwege de eerste set een blessurebehandeling ondergaan aan haar enkel, maar haar spel bleef onverminderd goed. Ze gaf de break voorsprong niet meer uit handen en won de eerste set met 6-3."
                            },
                            {
                                "example_id": "7122d883-8b57-4162-af82-bc8b91d787e4",
                                "sense_id": "dc8873f0-486d-33ee-a644-1474152fb49a",
                                "text": "Barty kende in de eerste ronde tegen Bernarda Pera ook al problemen vanwege haar heupblessure, maar wist toen nog te winnen in drie sets. De nummer één van de wereld ging na de eerste set tegen de Poolse Linette van de baan voor een blessurebehandeling en hield het daarna nog vier games vol."
                            }
                        ]
