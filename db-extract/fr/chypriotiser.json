                "senses": [
                    {
                        "sense_id": "84f95071-de5d-3b43-952b-4dadc68c0a84",
                        "entry_id": "3457a95e-2858-3ea4-9f62-8434798ff918",
                        "glosses": [
                            "Donner un caractère chypriote à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "162c4072-4f34-4a5c-be5c-1694d367fa6d",
                                "sense_id": "84f95071-de5d-3b43-952b-4dadc68c0a84",
                                "text": "Le gouvernement turc veut ainsi « chypriotiser » ces affaires, ce qui renforce son discours selon lequel la « RTCN » étant un État souverain, il lui revient de faire face auxdites affaires."
                            }
                        ]
                    },
                    {
                        "sense_id": "1722b1b7-6c40-3735-87a9-11608de4f5a4",
                        "entry_id": "3457a95e-2858-3ea4-9f62-8434798ff918",
                        "glosses": [
                            "Se faire dessaisir de son argent ou d’une partie de son argent, par l’établissement d’une règlementation officielle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49bd76cc-f09d-44ef-8c42-11189149e657",
                                "sense_id": "1722b1b7-6c40-3735-87a9-11608de4f5a4",
                                "text": "Sans doute que la possibilité de chypriotiser le capital des épargnants, en cas de faillite, serait suffisant?"
                            },
                            {
                                "example_id": "53f11c65-84cf-4f09-8867-1ce54a0c1adf",
                                "sense_id": "1722b1b7-6c40-3735-87a9-11608de4f5a4",
                                "text": "Et ils viendront couiner quand ils se feront chypriotiser dans un paradis fiscal, les petits fraudeurs non initiés..."
                            },
                            {
                                "example_id": "bbb6d021-8e05-43ba-ae7d-028913a524ff",
                                "sense_id": "1722b1b7-6c40-3735-87a9-11608de4f5a4",
                                "text": "Ils projettent avec l'accord officiel de l'Europe de vous la confisquer, en bref on va tous se faire \"chypriotiser\" dans la zone euro."
                            }
                        ]
                    }
                ],
