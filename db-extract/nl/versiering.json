                        ]
                    },
                    {
                        "translation_id": "8db140c1-bbab-457e-b7fa-4149c8140879",
                        "source_entry_id": "1d6c708d-d484-3379-8895-b3b1523e3a08",
                        "source_sense_id": "4ea2b69b-d542-31fd-8f94-948abccfdb98",
