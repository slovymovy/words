                "senses": [
                    {
                        "sense_id": "d49df25d-f6b8-321a-8131-ba5ff9728829",
                        "entry_id": "d3838a82-a394-377f-a017-861fd9a1b6d3",
                        "glosses": [
                            "матем., тысяча миллионов; число, равное 10⁹ и записываемое в десятичной системе как единица с 9 нулями"
                        ],
                        "tags": [
                            "в короткой шкале"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b11277ba-b4cc-3a9a-b23d-a3798b570abb",
                        "entry_id": "d3838a82-a394-377f-a017-861fd9a1b6d3",
                        "glosses": [
                            "матем., миллион миллионов; число, равное 10¹² и записываемое в десятичной системе как единица с 12 нулями"
                        ],
                        "tags": [
                            "в длинной шкале"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8666327e-1145-4b64-a4a8-98e7bad5e9c2",
                        "source_entry_id": "d3838a82-a394-377f-a017-861fd9a1b6d3",
                        "source_sense_description": "тысяча миллионов",
                        "target_lang_word": "billion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                        "entry_id": "8bc49604-e31e-35ac-93c1-7b2bad628c2b",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "a thousand million (logic: 1,000 × 1,000²): 1 followed by nine zeros, 10⁹."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51a34e1-baaa-4a23-a7da-00c26cf2ea76",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "At the last assessment it [the national debt] amounts to seven billion pounds (£7,000,000,000)."
                                            },
                                            {
                                                "example_id": "ecf60928-5a9b-460f-b7b3-35f3418c38be",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "In America alone, people spent $170 billion on “direct marketing”—junk mail of both the physical and electronic varieties—last year. Yet of those who received unsolicited adverts through the post, only 3% bought anything as a result."
                                            },
                                            {
                                                "example_id": "5e324581-c960-471d-9245-fb2fde781fc9",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "However, despite the prospect of HS2 being curtailed and the revelation that the programme is late and billions over budget, for now, at least, work on the scheme appears to be business as usual"
                                            },
                                            {
                                                "example_id": "4e10a3fd-a751-4d1b-b429-a00084f346d7",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "Micron said in a statement that it would bring extreme ultraviolet (EUV) technology to Japan, becoming the first semiconductor company to do so, and expected to invest up to 500 billion yen ($3.6 billion) with support from the Japanese government."
                                            },
                                            {
                                                "example_id": "54155766-4e68-4132-bc07-494420b39539",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "The ChatGPT service which serves as Web front-end to GPT-3.5 and GPT-4 was the fastest-growing service in history to break the 100 million user milestone in January and had 1 billion visits by February 2023."
                                            },
                                            {
                                                "example_id": "1b2f56c5-9d88-4863-902c-8e495263926a",
                                                "sense_id": "3dc180af-c88b-30d3-bc1c-2ada02c5935e",
                                                "text": "Plaintiff States also receive billions of dollars in funds every year directly from Treasury through BFS under federal grant programs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5721c59-728a-3e8d-9ddd-97885f395c58",
                                        "entry_id": "8bc49604-e31e-35ac-93c1-7b2bad628c2b",
                                        "glosses": [
                                            "Either of two large amounts:",
                                            "A million (times a) million (logic: 1,000,000²): a 1 followed by twelve zeros (10¹²); a thousand milliard."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "827f0178-518c-448c-b283-e8462a08372b",
                                                "sense_id": "a5721c59-728a-3e8d-9ddd-97885f395c58",
                                                "text": "n = 1,000,000,000,000, that is, = a billion, or the square of a million"
                                            },
                                            {
                                                "example_id": "8204680b-ef1e-462b-903b-25f0c053c821",
                                                "sense_id": "a5721c59-728a-3e8d-9ddd-97885f395c58",
                                                "text": "There is a bill to be picked up for cleaning the former Soviet countries of £1 billion. By that I mean a British billion, because when I was little I was told that a billion was a million million and then the Americans said that it was a thousand million. Well, I am talking about a million million pounds worth of clean-up to be done."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d208ef-2a77-3cdc-ba52-10acb3520bb8",
                                        "entry_id": "8bc49604-e31e-35ac-93c1-7b2bad628c2b",
                                        "glosses": [
                                            "An unspecified very large number."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1f0600-a416-4c9b-bc5d-dcd5452a37b9",
                                                "sense_id": "62d208ef-2a77-3cdc-ba52-10acb3520bb8",
                                                "text": "Near-synonyms: gazillion; see also Thesaurus:zillion"
                                            },
                                            {
                                                "example_id": "ffd809ec-21cd-4d07-966d-dd23063bef46",
                                                "sense_id": "62d208ef-2a77-3cdc-ba52-10acb3520bb8",
                                                "text": "There were billions of people at the concert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb35da12-b66e-4c52-8c85-deb962554bb9",
                        "source_entry_id": "d3838a82-a394-377f-a017-861fd9a1b6d3",
                        "source_sense_description": "тысяча миллионов",
                        "target_lang_word": "Billion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Billion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                        "entry_id": "064343c6-610c-319e-b3c8-8e243446f77a",
                                        "glosses": [
                                            "1.000.000.000.000 = 10¹² ( eine Million Millionen bzw. eine Million hoch zwei gleich „bi-“);"
                                        ],
                                        "tags": [
                                            "Eselsbrücke"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da7a4619-9315-4db3-9c2c-82aa355573c9",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "Eine Billion ist eine sehr hohe Zahl, die nicht in sehr vielen Kontexten auftaucht."
                                            },
                                            {
                                                "example_id": "402a55ef-ee10-423c-b3b2-b579153ddef8",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "Nach Informationen der Financial Times Deutschland sprach er vor Abgeordneten der schwarz-gelben Koalition über eine Hebelung des Fonds auf maximal eine Billion Euro."
                                            },
                                            {
                                                "example_id": "7be61459-d12c-4b18-acfb-4482f20de7e7",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "„Ich vertrieb mir die Zeit, indem ich den Schreibtisch durchsuchte, allerdings nichts fand außer fünfzig Billionen altes Inflationsgeld, das unser Lieblingswärter sammelte wie jedes andere entwertete Papiergeld.“"
                                            },
                                            {
                                                "example_id": "01b2046a-310a-4ea5-a69b-319bc69f5fc2",
                                                "sense_id": "41c140fe-416c-3cc8-8f53-e4e83660fc4c",
                                                "text": "„Als am Ende der Inflation im Jahre 1923 die Mark von einer Billion auf vier Mark stabilisiert wurde, hatte er Konkurs anmelden müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
