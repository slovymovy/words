                                "sense_id": "601baab7-9b12-362e-8746-df7fd5acbb72",
                                "text": "Mijn fiets heeft nu al 30.000 km gereden zonder al te grote haperingen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d706c23d-2344-3f66-9e2e-dfb800bc2a8f",
                        "entry_id": "751336e3-f699-38d2-88c8-23b3b1ee52a7",
                        "glosses": [
