{
    "word_family": [
        "signal",
        "signalement",
        "signaleur",
        "signalisation",
        "signalétique"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed1f48ec-bf92-3e42-9069-ff18bb4d885f",
                    "sense_definition": "Attirer l'attention sur quelqu'un ou quelque chose en l'indiquant ou en le rapportant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "notification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'hésitez pas à <w>signaler</w> tout bagage abandonné aux agents de surveillance de la gare."
                        },
                        {
                            "text": "L'employé a <w>signalé</w> une panne sur le serveur dès le début de la matinée."
                        }
                    ],
                    "synonyms": [
                        "indiquer",
                        "notifier",
                        "rapporter"
                    ],
                    "antonyms": [
                        "dissimuler",
                        "taire"
                    ],
                    "common_phrases": [
                        "signaler un problème",
                        "signaler une erreur"
                    ]
                },
                {
                    "sense_id": "ed7584c1-ab8c-354c-9a48-b13ff2f79349",
                    "sense_definition": "Faire connaître ou indiquer quelque chose au moyen d'un signal ou d'un dispositif prévu à cet effet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "signal_emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le phare permet de <w>signaler</w> les récifs dangereux aux bateaux naviguant près de la côte."
                        },
                        {
                            "text": "L'automobiliste allume ses feux de détresse pour <w>signaler</w> un arrêt d'urgence."
                        }
                    ],
                    "synonyms": [
                        "avertir",
                        "baliser"
                    ],
                    "common_phrases": [
                        "signaler un danger",
                        "signaler sa présence"
                    ]
                },
                {
                    "sense_id": "4cc3cb1c-aa0c-3faa-b8b7-3de12040b720",
                    "sense_definition": "Se faire remarquer ou se distinguer par une action, une qualité ou un comportement particulier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "distinction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune chercheur s'est <w>signalé</w> par ses découvertes novatrices dans le domaine médical."
                        },
                        {
                            "text": "Le joueur s'est <w>signalé</w> par son engagement exemplaire dès les premières minutes."
                        }
                    ],
                    "synonyms": [
                        "s'illustrer",
                        "se distinguer",
                        "se démarquer"
                    ],
                    "common_phrases": [
                        "se signaler par"
                    ]
                },
                {
                    "sense_id": "d4b6945a-bbc7-3251-9466-2e42e455faa5",
                    "sense_definition": "Marquer ou caractériser une période, une situation ou un événement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "marquer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'importantes réformes administratives ont <w>signalé</w> le mandat de ce gouverneur."
                        },
                        {
                            "text": "Une tempête mémorable a <w>signalé</w> la fin de cet automne particulièrement doux."
                        }
                    ],
                    "synonyms": [
                        "caractériser",
                        "illustrer",
                        "marquer"
                    ]
                }
            ]
        }
    ]
}