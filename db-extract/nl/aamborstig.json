                                    {
                                        "sense_id": "27b22455-ab31-31f9-a20b-e3f4b54fbc82",
                                        "entry_id": "25e00618-1ae3-361d-9e97-80c8719efe90",
                                        "glosses": [
                                            "Out of breath, gasping for air; breathing rapidly, or given to becoming short of breath."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3df6db6a-f09d-3123-a1d1-cc95094c0a7f",
                                        "entry_id": "25e00618-1ae3-361d-9e97-80c8719efe90",
                                        "glosses": [
                                            "Hasty, breathless; rushed."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c60dcbf5-8460-484d-a868-dbb7579a26f9",
                                                "sense_id": "3df6db6a-f09d-3123-a1d1-cc95094c0a7f",
                                                "text": "it is […] what foul dust floated in the wake of his dreams that temporarily closed out my interest in the abortive sorrows and shortwinded elations of men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7338e95b-3e3c-32ab-aa01-61d81807e348",
                                        "entry_id": "25e00618-1ae3-361d-9e97-80c8719efe90",
