                "senses": [
                    {
                        "sense_id": "edd1d4fd-6450-37c7-8e08-b02f9faf16d5",
                        "entry_id": "9ec67bf3-4694-3982-82a1-70320b06d6d3",
                        "glosses": [
                            "an der Ostsee gelegener Hafen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8e644ef-9844-421d-87af-91f5bfcb406f",
                                "sense_id": "edd1d4fd-6450-37c7-8e08-b02f9faf16d5",
                                "text": "„Doch weder Rußland, das den größeren Teil des Hinterlandes, Kongreßpolen, beherrschte, noch Preußen selbst, das Danzig aller Privilegien beraubte und zur Hauptstadt der neu geschaffenen Provinz Westpreußen machte, waren an einer neuen Blüte Danzigs auf Kosten der anderen Ostseehäfen interessiert.“"
                            },
                            {
                                "example_id": "bde509e1-2f84-4c0c-9e7f-4bd6255ccb4f",
                                "sense_id": "edd1d4fd-6450-37c7-8e08-b02f9faf16d5",
                                "text": "„Eine Breitspurbahn vom Elbufer zum Ostseehafen Lübeck-Travemünde und eine Eisenbahnfähre zum sowjetischen Klaipeda, dem früheren Memel, sollen Hamburg mit der längsten Bahnstrecke der Welt verknüpfen […].“"
                            },
                            {
                                "example_id": "cae9c0a5-f1f8-486f-88c5-48ad59ecee5e",
                                "sense_id": "edd1d4fd-6450-37c7-8e08-b02f9faf16d5",
                                "text": "„Wie zum Trotz stapeln sich Tausende betonummantelte Rohre im Ostseehafen Mukran auf Rügen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
