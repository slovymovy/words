            "senses": [
                {
                    "sense_id": "e52a634a-b13b-35be-834e-2e424ef18d4b",
                    "sense_definition": "Iemand die ergens interesse of aandacht voor heeft.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lezing trok veel meer <w>belangstellenden</w> dan de organisatie had verwacht.",
                            "target_lang_translations": {
                                "fr": "La conférence a attiré beaucoup plus d'<w>intéressés</w> que ce que l'organisation avait prévu."
                            }
                        },
                        {
                            "text": "Voor de <w>belangstellende</w> was er na afloop een rondleiding door het gebouw.",
                            "target_lang_translations": {
                                "fr": "Pour les <w>personnes intéressées</w>, une visite guidée du bâtiment était organisée à la fin."
                            }
                        }
                    ],
                    "synonyms": [
                        "geïnteresseerde"
                    ],
                    "common_phrases": [
                        "voor belangstellenden",
                        "veel belangstellenden"
                    ],
                    "target_lang_definitions": {
                        "fr": "Personne qui manifeste de l'intérêt, de l'attention ou de la curiosité pour quelque chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "intéressé",
                                "target_lang_sense_clarification": "personne qui porte un intérêt"
                            },
                            {
                                "target_lang_word": "curieux",
                                "target_lang_sense_clarification": "personne qui s'intéresse par curiosité"
                            }
                        ]
                    }
                }
            ]
        },
