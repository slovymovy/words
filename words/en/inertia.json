{
    "word_family": [
        "inert",
        "inertial",
        "inertially",
        "inertness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "04d9f7c9-424f-3b85-9bbe-af5c18f5d20e",
                    "sense_definition": "The property of matter by which it continues in its existing state of rest or uniform motion in a straight line, unless that state is changed by an external force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics_resistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Because of <w>inertia</w>, the passengers lurched forward when the bus suddenly stopped."
                        },
                        {
                            "text": "The massive spacecraft required a great deal of fuel to overcome its own <w>inertia</w>."
                        }
                    ],
                    "common_phrases": [
                        "moment of inertia",
                        "thermal inertia"
                    ]
                },
                {
                    "sense_id": "88f6f705-d61a-3e46-a84c-25744221139d",
                    "sense_definition": "A tendency to do nothing or to remain unchanged; an unwillingness or inability to take action.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company failed to innovate due to sheer bureaucratic <w>inertia</w>."
                        },
                        {
                            "text": "Overcoming personal <w>inertia</w> is often the hardest part of starting a new project."
                        }
                    ],
                    "synonyms": [
                        "idleness",
                        "laziness",
                        "sloth",
                        "slothfulness"
                    ],
                    "common_phrases": [
                        "bureaucratic inertia",
                        "institutional inertia"
                    ]
                },
                {
                    "sense_id": "34d23829-62b7-3419-a20e-f554473672a0",
                    "sense_definition": "A state of sluggishness or lack of activity in an organ, especially the uterus during labor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inactivity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor administered medication to correct the uterine <w>inertia</w> during childbirth."
                        },
                        {
                            "text": "Secondary <w>inertia</w> occurred after several hours of prolonged labor."
                        }
                    ],
                    "common_phrases": [
                        "uterine inertia"
                    ]
                }
            ]
        }
    ]
}