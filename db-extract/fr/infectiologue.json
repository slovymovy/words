                                        "entry_id": "9dcdc310-0819-32cf-b1e5-d618e682a62f",
                                        "glosses": [
                                            "Medizinerin, die auf Infektionskrankheiten spezialisiert ist, auf dem Gebiet der Infektiologie arbeitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d72f38-80a4-4487-bec1-b4edd4f73e08",
                                                "sense_id": "e18b28fd-1910-37dc-93f6-94894ba665f7",
                                                "text": "„Schließlich findet eine Infektiologin heraus, welche uralte Plage seinen Hof befallen hat. Dr. Kristine Erlandson ist Infektiologin und Internistin an der Klinik.“"
                                            }
