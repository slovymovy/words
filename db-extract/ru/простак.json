                                    {
                                        "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                        "entry_id": "b75494f6-3fcb-32d9-94a1-063f4c24bd5e",
                                        "glosses": [
                                            "A fan of American singer, songwriter, actress, and record producer Mariah Carey (born 1969)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e4eeab8-427a-4de7-81dc-f1539ed5e515",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Part of me revels in the campiness of Mariah’s butterfly metaphors and puppies-and-kittens existence. […] But I also genuinely love her music, including this album. I’m one of her lambs."
                                            },
                                            {
                                                "example_id": "0840924d-08da-4204-aedc-606ffbbf1d59",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Her latest album, “Memoirs of an Imperfect Angel,” is her best work yet, a warmer and more subtle album that makes her more relatable to those of us who aren’t Mariah die-hards—or “lambs,” as she refers to them."
                                            },
                                            {
                                                "example_id": "b817e6ae-a779-42c4-b1b8-218331d61353",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "This year, Ms. Carey debuted a new Las Vegas revue, and, to celebrate, a group of 36 “lambs,” mostly in their 30s and 40s, boarded a party bus and cruised the Vegas strip for about three hours."
                                            },
                                            {
                                                "example_id": "7df40eeb-1c84-471f-af26-0f738fb3f6a8",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "But when I saw Mariah in Detroit last year during the Caution World Tour, I was a proud lamb in my tour T-shirt, my very adult body suddenly transformed into my 14-year-old self when she emerged onstage."
                                            },
                                            {
                                                "example_id": "c1e0fcd2-daac-47fa-8809-02e1765ff42c",
                                                "sense_id": "19f7fe82-9f0c-36ac-a201-940faa347f10",
                                                "text": "Pride Month begins June 1, and Mariah Carey is giving her lambs plenty of new clothes to celebrate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lamb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa806025-a780-30bd-ae2a-072ec18c6130",
                                        "entry_id": "283fba77-2081-3a08-a36a-bf548b0c58f5",
                                        "glosses": [
                                            "Of a sheep, to give birth."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15cdb0ad-ac12-331d-bcc5-2e53f4da5db6",
                                        "entry_id": "283fba77-2081-3a08-a36a-bf548b0c58f5",
                                        "glosses": [
                                            "To assist (sheep) to give birth."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf25f0d-9922-4bb5-aef2-406a551eb17b",
                                                "sense_id": "15cdb0ad-ac12-331d-bcc5-2e53f4da5db6",
                                                "text": "The shepherd was up all night, lambing her young ewes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
