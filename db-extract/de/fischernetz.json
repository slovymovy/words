                                                "sense_id": "86302079-917e-35c1-977f-e9cbf4701781",
                                                "text": "The fishnets were hung over bushes to dry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4629a86d-c117-3277-8eb0-b11e4d02170a",
                                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                                        "glosses": [
                                            "A fabric mesh with an open diamond-shaped structure."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f37ebc-fc23-4954-ad5e-ecbd4d7a92ba",
                                                "sense_id": "4629a86d-c117-3277-8eb0-b11e4d02170a",
                                                "text": "All the little minnows which were not caught for bait this spring may well give thanks to the women of the U. S. who have adopted fishnet turbans, scarfs, belts and skirts as items in their sports outfits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                                        "entry_id": "31b35768-ff64-3a12-b113-116285c99031",
                                        "glosses": [
                                            "Stockings made of fishnet fabric."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ce32c6a-0ab1-4c4e-8499-551e5d79923d",
                                                "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                                                "text": "Fishnets are for catching men."
                                            },
                                            {
                                                "example_id": "015b18ef-8a0f-4f6e-8a3e-e536460338c2",
                                                "sense_id": "6e0e0e8d-b3d0-364c-8d63-4de9b9f81ed9",
                                                "text": "I don't see people walking around in the fishnets, heels and make-up, but I do see alot^([sic]) of guys with the short bleached blonde hair, the baggy sweats, and other Eminemesque fashions..."
                                            }
                                        ]
                                    }
