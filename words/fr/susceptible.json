            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a1bdf32c-a5a7-3c73-bc5b-de714fb31c06",
                    "sense_definition": "Qui s'offense ou se vexe avec une grande facilité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "caractere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Évite de lui faire des remarques sur son travail car il est très <w>susceptible</w>."
                        },
                        {
                            "text": "Elle est devenue particulièrement <w>susceptible</w> depuis qu'elle subit cette période de stress intense."
                        }
                    ],
                    "synonyms": [
                        "ombrageux",
                        "chatouilleux",
                        "irritable"
                    ],
                    "common_phrases": [
