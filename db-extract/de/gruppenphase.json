                ],
                "senses": [
                    {
                        "sense_id": "8d8e0c8c-6443-35fc-891e-bffb9f0dd41d",
                        "entry_id": "87a2bb52-8a9e-3433-949e-909f7c032a28",
                        "glosses": [
                            "erster Abschnitt eines Turniers, bei dem sich die Teilnehmer in verschiedenen Gruppen für das Weiterkommen in die Finalrunde qualifizieren"
                        ],
                        "tags": [
                            "besonders Fußball"
                        ],
                        "examples": [
                            {
                                "example_id": "c8574ca1-b58b-4f92-af47-406431060f1f",
                                "sense_id": "8d8e0c8c-6443-35fc-891e-bffb9f0dd41d",
                                "text": "„Vor acht Jahren bezwangen die Ghanaer in der Gruppenphase Tschechien und die USA und zogen in die K.o.-Runde ein. Dort scheiterten sie dann an Rekord-Weltmeister Brasilien.“"
                            },
                            {
                                "example_id": "7bd496df-81f6-403a-a570-c61f60567049",
                                "sense_id": "8d8e0c8c-6443-35fc-891e-bffb9f0dd41d",
                                "text": "„Fußball-Bundesligist Hannover 96 steht nach der furiosen Begegnung in Breslau vor dem erneuten Einzug in die Gruppenphase der Europa League.“"
                            },
                            {
                                "example_id": "c43076d2-1331-43da-80ee-f61976dca0f8",
                                "sense_id": "8d8e0c8c-6443-35fc-891e-bffb9f0dd41d",
                                "text": "„Es traten sechzehn Nationalmannschaften zunächst in der Gruppenphase in vier Gruppen und danach im K.-o.-System gegeneinander an.“"
                            },
                            {
                                "example_id": "72a6a8af-a103-4c6d-b0ae-4c7b79866383",
                                "sense_id": "8d8e0c8c-6443-35fc-891e-bffb9f0dd41d",
                                "text": "„Handball-Bundesligist Füchse Berlin hat sich in die Gruppenphase des EHF-Pokals gezittert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "79a1a465-620f-44fc-9611-9fabcaa99f71",
                        "source_entry_id": "87a2bb52-8a9e-3433-949e-909f7c032a28",
