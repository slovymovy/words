{
    "word_family": [
        "recognize",
        "recognizable",
        "recognizably",
        "recognizer",
        "recognizance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a546865e-ea96-318c-ae90-fb9a65521afb",
                    "sense_definition": "The act of identifying someone or something that has been seen, heard, or known before.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked at her for a moment before <w>recognition</w> dawned on his face.",
                            "target_lang_translations": {
                                "ru": "Он смотрел на нее мгновение, прежде чем на его лице отразилось <w>узнавание</w>.",
                                "zh": "他看了她一会儿，脸上才露出<w>辨认</w>后的神情。"
                            }
                        },
                        {
                            "text": "The town has changed beyond all <w>recognition</w> in the last ten years.",
                            "target_lang_translations": {
                                "ru": "За последние десять лет город изменился до <w>неузнаваемости</w>.",
                                "zh": "过去十年里，这座小镇已经变得完全认不出来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "identification",
                        "detection"
                    ],
                    "common_phrases": [
                        "beyond recognition",
                        "facial recognition",
                        "voice recognition",
                        "sign of recognition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт идентификации кого-либо или чего-либо, что было увидено, услышано или известно ранее.",
                        "zh": "对先前见过、听过或了解过的人或事物加以认出或识别的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узнавание",
                                "target_lang_sense_clarification": "идентификация знакомого объекта или человека"
                            },
                            {
                                "target_lang_word": "распознавание",
                                "target_lang_sense_clarification": "процесс различения или идентификации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辨认",
                                "target_lang_sense_clarification": "认出以前见过、听过或知道的人或事物"
                            },
                            {
                                "target_lang_word": "识别",
                                "target_lang_sense_clarification": "对人脸、声音、图像等进行识别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e02a0196-51a0-3d77-abe3-b6aa4e61ddc9",
                    "sense_definition": "Public praise, respect, or admiration given to someone for their achievements or service.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received a special award in <w>recognition</w> of her volunteer work.",
                            "target_lang_translations": {
                                "ru": "Она получила специальную награду в знак <w>признания</w> её волонтерской работы.",
                                "zh": "她因志愿工作而获得了一项特别奖，以示<w>表彰</w>。"
                            }
                        },
                        {
                            "text": "The artist finally gained international <w>recognition</w> for his unique paintings.",
                            "target_lang_translations": {
                                "ru": "Художник наконец получил международное <w>признание</w> за свои уникальные картины.",
                                "zh": "这位艺术家最终凭借其独特的画作获得了国际<w>认可</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "appreciation",
                        "acknowledgment",
                        "credit",
                        "honor"
                    ],
                    "antonyms": [
                        "disregard"
                    ],
                    "common_phrases": [
                        "in recognition of",
                        "gain recognition",
                        "deserve recognition",
                        "receive recognition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичная похвала, уважение или восхищение за достижения или заслуги.",
                        "zh": "因某人的成就或服务而给予的公开赞扬、尊重或钦佩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "общественное уважение и высокая оценка"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "положительная оценка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "认可",
                                "target_lang_sense_clarification": "因成就、贡献或服务而得到的公开肯定"
                            },
                            {
                                "target_lang_word": "表彰",
                                "target_lang_sense_clarification": "对功绩或贡献的公开表扬"
                            },
                            {
                                "target_lang_word": "赞誉",
                                "target_lang_sense_clarification": "受到赞扬和敬重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b691e73c-ad43-306b-bdc6-4d66bcf185be",
                    "sense_definition": "The act of accepting or admitting that something exists, is true, or is valid.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new law is a clear <w>recognition</w> of the need for social change.",
                            "target_lang_translations": {
                                "ru": "Новый закон является явным <w>признанием</w> необходимости социальных перемен.",
                                "zh": "这项新法律是对社会变革必要性的明确<w>承认</w>。"
                            }
                        },
                        {
                            "text": "There is a growing <w>recognition</w> that we must protect the environment.",
                            "target_lang_translations": {
                                "ru": "Растет <w>осознание</w> того, что мы должны защищать окружающую среду.",
                                "zh": "人们越来越形成这样一种<w>认识</w>：我们必须保护环境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "acceptance",
                        "admission",
                        "acknowledgment"
                    ],
                    "antonyms": [
                        "denial",
                        "rejection"
                    ],
                    "common_phrases": [
                        "recognition of rights",
                        "seek recognition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт принятия или допущения того, что что-то существует, является истинным или действительным.",
                        "zh": "承认或接受某事存在、真实或有效的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "согласие с фактом или истинностью"
                            },
                            {
                                "target_lang_word": "осознание",
                                "target_lang_sense_clarification": "понимание существования чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承认",
                                "target_lang_sense_clarification": "承认某事存在、属实或有效"
                            },
                            {
                                "target_lang_word": "认识",
                                "target_lang_sense_clarification": "意识到某种事实或必要性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd7ab0ad-53e3-3e08-b1f6-42aa3b2476c8",
                    "sense_definition": "Official acceptance of the legal status of a new government or state by another country.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "diplomacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The newly independent country struggled to achieve diplomatic <w>recognition</w>.",
                            "target_lang_translations": {
                                "ru": "Недавно получившая независимость страна боролась за дипломатическое <w>признание</w>.",
                                "zh": "这个新近独立的国家努力争取<w>外交承认</w>。"
                            }
                        },
                        {
                            "text": "Official <w>recognition</w> was granted after the peace treaty was signed.",
                            "target_lang_translations": {
                                "ru": "Официальное <w>признание</w> было получено после подписания мирного договора.",
                                "zh": "和平条约签署后，才给予了<w>正式承认</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "validation"
                    ],
                    "common_phrases": [
                        "diplomatic recognition",
                        "international recognition",
                        "official recognition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное принятие правового статуса нового правительства или государства другой страной.",
                        "zh": "一国对新政府或新国家法律地位的官方承认。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "дипломатический акт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "外交承认",
                                "target_lang_sense_clarification": "一国对新政府或新国家法律地位的正式接受"
                            },
                            {
                                "target_lang_word": "正式承认",
                                "target_lang_sense_clarification": "官方给予的承认"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "583da5c0-77b3-3ec1-a3c7-00969fe955c0",
                    "sense_definition": "The process by which a molecule, such as an antibody, identifies and binds to a specific target.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Molecular <w>recognition</w> is crucial for the immune system to function correctly.",
                            "target_lang_translations": {
                                "ru": "Молекулярное <w>распознавание</w> имеет решающее значение для правильного функционирования иммунной системы.",
                                "zh": "<w>分子识别</w>对于免疫系统正常运作至关重要。"
                            }
                        },
                        {
                            "text": "The study focuses on the mechanism of antigen <w>recognition</w> by cells.",
                            "target_lang_translations": {
                                "ru": "Исследование посвящено механизму <w>распознавания</w> антигенов клетками.",
                                "zh": "这项研究聚焦于细胞进行抗原<w>识别</w>的机制。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pattern recognition",
                        "molecular recognition"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "biology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс, посредством которого молекула, например антитело, идентифицирует определенную мишень и связывается с ней.",
                        "zh": "分子（如抗体）识别并结合特定靶标的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распознавание",
                                "target_lang_sense_clarification": "биологический или химический процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分子识别",
                                "target_lang_sense_clarification": "分子之间对特定目标的识别与结合过程"
                            },
                            {
                                "target_lang_word": "识别",
                                "target_lang_sense_clarification": "细胞或分子对特定靶标的识别过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61b42722-1cb8-337e-a50f-dbbf8267399a",
                    "sense_definition": "A return of the land to the superior owner, specifically in historical property law contexts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer explained the complex rules regarding the <w>recognition</w> of the estate.",
                            "target_lang_translations": {
                                "ru": "Юрист объяснил сложные правила, касающиеся <w>признания</w> прав на имение.",
                                "zh": "律师解释了有关这份庄园<w>领主收回权</w>的复杂规定。"
                            }
                        },
                        {
                            "text": "In feudal times, <w>recognition</w> could occur if the vassal failed to meet obligations.",
                            "target_lang_translations": {
                                "ru": "В феодальные времена <w>признание</w> могло произойти, если вассал не выполнял обязательства.",
                                "zh": "在封建时代，如果附庸未履行义务，土地就可能归还给上级领主。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возвращение земли вышестоящему собственнику, особенно в контексте исторического имущественного права.",
                        "zh": "在历史财产法语境中，土地归还给上级所有人的情形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "юридическое подтверждение прав или обязательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "领主收回权",
                                "target_lang_sense_clarification": "历史财产法中土地归还给上级领主的权利或情形"
                            },
                            {
                                "target_lang_word": "土地回归",
                                "target_lang_sense_clarification": "封建财产法中土地回归上级所有人的情形"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}