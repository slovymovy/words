{
    "word_family": [
        "Tangier"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "040e8067-daa8-35d0-a550-1012691405e4",
                    "sense_definition": "A small citrus fruit with a loose, orange-colored peel and a sweet-tart flavor.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She peeled a <w>tangerine</w> to enjoy as a healthy afternoon snack.",
                            "target_lang_translations": {
                                "zh": "她剥了一个<w>橘子</w>作为健康的下午茶点心。"
                            }
                        },
                        {
                            "text": "The bowl on the table was filled with fresh <w>tangerines</w>.",
                            "target_lang_translations": {
                                "zh": "桌上的碗里装满了新鲜的<w>橘子</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Citrus tangerina"
                    ],
                    "common_phrases": [
                        "peel a tangerine"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种小型柑橘类水果，果皮松散呈橙色，味道酸甜。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "橘子",
                                "target_lang_sense_clarification": "泛指柑橘类水果，最常用的称呼。"
                            },
                            {
                                "target_lang_word": "柑橘",
                                "target_lang_sense_clarification": "柑橘类水果的总称。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b63ac62-ca56-3e34-95f4-9d4ac5f686ef",
                    "sense_definition": "A deep yellowish-orange color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist painted the sunset using vibrant shades of <w>tangerine</w>.",
                            "target_lang_translations": {
                                "zh": "艺术家用鲜艳的<w>橘黄色</w>描绘了日落。"
                            }
                        },
                        {
                            "text": "She wore a bright <w>tangerine</w> scarf that matched her coat perfectly.",
                            "target_lang_translations": {
                                "zh": "她围了一条明亮的<w>橘黄色</w>围巾，和她的外套非常搭。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种深黄橙色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "橘黄色",
                                "target_lang_sense_clarification": "指像橘子皮一样的颜色。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d64eaed-1177-3a95-a9f5-fb57bfb9feb8",
                    "sense_definition": "A tree that produces tangerines.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small <w>tangerine</w> in the garden is finally starting to bear fruit.",
                            "target_lang_translations": {
                                "zh": "花园里那棵小<w>橘子树</w>终于开始结果了。"
                            }
                        },
                        {
                            "text": "We planted a <w>tangerine</w> near the fence to provide some shade.",
                            "target_lang_translations": {
                                "zh": "我们在篱笆旁种了一棵<w>橘子树</w>来遮阴。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "结橘子的树。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "橘子树",
                                "target_lang_sense_clarification": "指代植物本身。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6347fb90-c853-3e22-8928-0d57eb3b8e3d",
                    "sense_definition": "A person who comes from or lives in Tangier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>Tangerine</w> shared stories about the history of the city.",
                            "target_lang_translations": {
                                "zh": "当地的一位<w>丹吉尔人</w>分享了关于这座城市历史的故事。"
                            }
                        },
                        {
                            "text": "Many <w>Tangerines</w> are proud of their unique cultural heritage.",
                            "target_lang_translations": {
                                "zh": "许多<w>丹吉尔人</w>都为他们独特的文化遗产感到自豪。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "来自丹吉尔的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丹吉尔人",
                                "target_lang_sense_clarification": "指摩洛哥城市丹吉尔的居民。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0a46201c-9c76-327c-9b5d-26395a8b8729",
                    "sense_definition": "Having a deep yellowish-orange color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was decorated with <w>tangerine</w> curtains and pillows.",
                            "target_lang_translations": {
                                "zh": "房间里装饰着<w>橘黄色</w>的窗帘和枕头。"
                            }
                        },
                        {
                            "text": "She chose a <w>tangerine</w> dress for the summer party.",
                            "target_lang_translations": {
                                "zh": "她为夏季派对选了一件<w>橘黄色</w>的裙子。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "深黄橙色的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "橘黄色的",
                                "target_lang_sense_clarification": "形容颜色。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fe4083f-dcde-36a5-991e-c23a1c1f4c21",
                    "sense_definition": "Relating to or originating from the city of Tangier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The exhibition featured traditional <w>tangerine</w> architecture and design.",
                            "target_lang_translations": {
                                "zh": "展览展示了传统的<w>丹吉尔</w>建筑和设计。"
                            }
                        },
                        {
                            "text": "He enjoyed the authentic <w>tangerine</w> cuisine during his visit.",
                            "target_lang_translations": {
                                "zh": "他在访问期间品尝了地道的<w>丹吉尔</w>美食。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与丹吉尔市有关的或起源于该市的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "丹吉尔的",
                                "target_lang_sense_clarification": "形容词，表示产地或风格。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a5035ae-f0d9-305c-bb71-389268a660a6",
                    "sense_definition": "Relating to the Blackpool Football Club.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tangerine</w> supporters cheered loudly as their team scored a goal.",
                            "target_lang_translations": {
                                "zh": "当球队进球时，<w>布莱克浦队</w>的支持者们大声欢呼。"
                            }
                        },
                        {
                            "text": "The players wore their iconic <w>tangerine</w> jerseys during the match.",
                            "target_lang_translations": {
                                "zh": "球员们在比赛中穿着他们标志性的<w>布莱克浦队</w>球衣。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "与布莱克浦足球俱乐部有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布莱克浦队的",
                                "target_lang_sense_clarification": "指代该球队的标志性颜色或相关事物。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}