                                        "entry_id": "d35e42ec-147e-393f-ba94-8e18541a27b1",
                                        "glosses": [
                                            "die Theologie betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689ec0fe-04f9-447a-a949-725c170f1a87",
                                                "sense_id": "da4115da-463c-31a7-8361-269dc22ca451",
                                                "text": "„Etwas theologischer ausgedrückt heißt das: Der historische Jesus ist geschichtlich nicht direkt greifbar.“"
                                            },
                                            {
                                                "example_id": "412579ce-f415-432d-9bf1-fd07b8c23411",
                                                "sense_id": "da4115da-463c-31a7-8361-269dc22ca451",
                                                "text": "„Am schlechtesten steht es um Reinhold Schneider und die Langgässer, die theologischsten unter den Erzählern der Adenauer-Ära.“"
                                            },
                                            {
                                                "example_id": "4b946a60-c67d-4f4d-b9f1-98e14920b206",
                                                "sense_id": "da4115da-463c-31a7-8361-269dc22ca451",
                                                "text": "„Mir ist nicht ganz klar, aus welcher Quelle der Pfarrer seine theologischen Überlegungen bezog.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
