                "senses": [
                    {
                        "sense_id": "5f96a443-afe8-3757-baf9-47f2205961d2",
                        "entry_id": "ade9500c-1f9b-3f39-9926-4970d3d6cb71",
                        "glosses": [
                            "Qualité d’être redevable, en parlant d’une taxe."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "2f7c9660-ff1b-4bc7-a4a0-7c0841a31cb3",
                                "sense_id": "5f96a443-afe8-3757-baf9-47f2205961d2",
                                "text": "La redevabilité de la taxe découle des règles particulières prévues pour localiser le lieu du service et le pays auquel revient la taxe qui lui est applicable."
                            }
                        ]
                    },
                    {
                        "sense_id": "576d21ab-dca7-3946-be61-470f6ff2e846",
                        "entry_id": "ade9500c-1f9b-3f39-9926-4970d3d6cb71",
                        "glosses": [
                            "Obligation de rendre compte."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "a1da0aff-d19c-41b6-be91-7bd54277fec4",
                                "sense_id": "576d21ab-dca7-3946-be61-470f6ff2e846",
                                "text": "La redevabilité engage la responsabilité du dirigeant pendant et après son mandat à la tête de son pays. Or, la plupart des dirigeants africains règnent comme s’ils n’avaient de comptes à rendre à personne, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a29222cc-82a8-429d-a451-1d25f1b6ca27",
                        "source_entry_id": "ade9500c-1f9b-3f39-9926-4970d3d6cb71",
                        "target_lang_word": "Rechenschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rechenschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                        "entry_id": "9295a562-250c-3922-a5c1-e641738a2988",
                                        "glosses": [
                                            "Auskunft über bestimmte Gründe, Handlungen, Umstände oder Verhalten, insbesondere zu gesetzlichen Pflichten (beispielsweise vor Gericht oder in Jahresabschlüssen) oder für übernommene Aufgaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d07396e-5f90-476c-acbc-1c78db2186b7",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "Ich gebe niemandem Rechenschaft darüber, warum ich rauche und trinke."
                                            },
                                            {
                                                "example_id": "a375fb32-f016-4b5a-a533-ee4fff574bd0",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "In den 1950er Jahren mussten Frauen noch ihrem Mann Rechenschaft darüber geben, wie sie das Haushaltsgeld ausgegeben hatten."
                                            },
                                            {
                                                "example_id": "5b04b283-b5fc-4ed1-b6ec-da4678d69785",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "Polen sucht nach 1600 ehemaligen SS-Männern. Sie werden beschuldigt, in deutschen Konzentrationslagern Kriegsverbrechen begangen zu haben. Die Zeit, sie [2018] zur Rechenschaft zu ziehen, wird knapp."
                                            },
                                            {
                                                "example_id": "00e61cfb-494e-4b66-bb41-8f9993aba2e7",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "„Wir müssen erreichen, dass die für das Massaker verantwortlichen israelischen Zuständigen, sowie die israelischen Soldaten, die auf schutzlose Menschen geschossen haben, zur Rechenschaft gezogen werden.“"
                                            },
                                            {
                                                "example_id": "9ef9f07d-4691-42dd-86ef-79fe746d81a4",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "Die Verantwortlichen für die Abgasmanipulation in Autos müssen zur Rechenschaft gezogen werden."
                                            },
                                            {
                                                "example_id": "57193cf6-358d-45ba-9275-3f4b1077c189",
                                                "sense_id": "de373299-dbbb-3ef2-936c-5a5157603360",
                                                "text": "„Von Anfang an ist Hoffmann sich dieser Affinität bewußt, wird sie später aber manchmal ausbauen, ohne sich Rechenschaft darüber zu geben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a922dee4-5571-4e64-8034-1c7fe29064eb",
                        "source_entry_id": "ade9500c-1f9b-3f39-9926-4970d3d6cb71",
                        "target_lang_word": "Rechenschaftspflicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c0f7f47f-ee44-4367-88de-903da650637c",
                        "source_entry_id": "ade9500c-1f9b-3f39-9926-4970d3d6cb71",
                        "target_lang_word": "accountability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accountability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86c307d2-174b-3b46-8158-32224b0acab8",
                                        "entry_id": "71157bf9-38c1-359f-8898-f6c6966c2278",
                                        "glosses": [
                                            "The state of being accountable; liability to be called on to render an account or give an explanation; liability to be held responsible or answerable for something."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d56ff1c-82d7-480a-bc37-21bf1a80cd57",
                                                "sense_id": "86c307d2-174b-3b46-8158-32224b0acab8",
                                                "text": "The United States stands at this time at the pinnacle of world power. It is a solemn moment for the American Democracy. For with primacy in power is also joined an awe-inspiring accountability to the future."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d73619-d089-3033-8093-a99720c84b48",
                                        "entry_id": "71157bf9-38c1-359f-8898-f6c6966c2278",
                                        "glosses": [
                                            "An open determination of one's responsibility for something and imposition of consequences."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5f063d-766a-474f-a27c-8b9f12da0e80",
                                                "sense_id": "c2d73619-d089-3033-8093-a99720c84b48",
                                                "text": "Just think about that: 1 in 4 had an error, and 1 in 20 was seriously wrong. And that is not good. If every 20th Frosty that Wendy’s sold turned out to be a cup of warm goat semen, we would want some accountability and we’d want it fast! At least freeze it!"
                                            },
                                            {
                                                "example_id": "7b9fbaee-b4a9-46d7-b588-128a04e5647d",
                                                "sense_id": "c2d73619-d089-3033-8093-a99720c84b48",
                                                "text": "Levying a charge will not, by itself, guarantee accountability: witness the millions of dissatisfied customers of the private sector travel agents who book the wrong holiday, solicitors who over-charge, builders who do shoddy work, garages that misrepair cars, estate agents who mislead, shops that sell defective goods and refuse refunds, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39607b5f-9eb9-37c4-80db-b4a4aa2d49d1",
                                        "entry_id": "71157bf9-38c1-359f-8898-f6c6966c2278",
                                        "glosses": [
                                            "An acceptance of good faith of one's responsibility for something and of its consequences."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd13dc72-612f-42d8-8402-0735800c65ec",
                                                "sense_id": "39607b5f-9eb9-37c4-80db-b4a4aa2d49d1",
                                                "text": "As the biggest rail player, Network Rail was usually held accountable for failings, but had no authority to change anything to solve the problems. The DfT had been given that authority in 2004 - but consistently ducked accountability."
                                            },
                                            {
                                                "example_id": "77f541a5-f03b-4dcd-9077-3a58ea0e7865",
                                                "sense_id": "39607b5f-9eb9-37c4-80db-b4a4aa2d49d1",
                                                "text": "The erosion of accountability doesn't seem to matter now, but it will matter when things start unraveling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc298e9c-02e9-363a-98d7-120c767c16ec",
                                        "entry_id": "71157bf9-38c1-359f-8898-f6c6966c2278",
                                        "glosses": [
                                            "The obligation imposed by law or regulation on an officer or other person for keeping an accurate record of property, documents, or funds."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
