{
    "word_family": [
        "smirker",
        "smirkingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "743881bd-bb12-38a2-a503-1a3358a431a6",
                    "sense_definition": "An uneven, often crooked smile that is insolent, self-satisfied, conceited or scornful.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>smirk</w> on his face when he realized he had won the argument.",
                            "target_lang_translations": {
                                "ru": "На его лице появилась <w>ухмылка</w>, когда он понял, что выиграл спор.",
                                "cs": "Když si uvědomil, že spor vyhrál, na tváři se mu objevil <w>úšklebek</w>."
                            }
                        },
                        {
                            "text": "The student gave a <w>smirk</w> to his teacher after getting away with the prank.",
                            "target_lang_translations": {
                                "ru": "Студент <w>ухмыльнулся</w> учителю, когда ему удалось избежать наказания за шалость.",
                                "cs": "Student se na učitele <w>ušklíbl</w>, když mu jeho žertík prošel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiped the smirk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неприятная, часто кривая улыбка, выражающая дерзость, самодовольство, высокомерие или насмешку.",
                        "cs": "Nerovný, často křivý úsměv, který je drzý, samolibý, domýšlivý nebo pohrdavý."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухмылка",
                                "target_lang_sense_clarification": "неодобрительная, самодовольная или насмешливая улыбка"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "úšklebek",
                                "target_lang_sense_clarification": "pohrdavý nebo samolibý výraz tváře"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56dbbe64-9ba4-319e-8846-def7518a1855",
                    "sense_definition": "A forced or affected smile.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered a polite but clearly fake <w>smirk</w> to the guests.",
                            "target_lang_translations": {
                                "ru": "Она вежливо, но с явно <w>натянутой улыбкой</w> встретила гостей.",
                                "cs": "Hostům věnovala zdvořilý, ale zjevně <w>strojený úsměv</w>."
                            }
                        },
                        {
                            "text": "His <w>smirk</w> did not reach his eyes during the awkward conversation.",
                            "target_lang_translations": {
                                "ru": "Его <w>вымученная улыбка</w> не отразилась в глазах во время неловкого разговора.",
                                "cs": "Během toho trapného rozhovoru jeho <w>křečovitý úsměv</w> nedosáhl až k očím."
                            }
                        }
                    ],
                    "synonyms": [
                        "simper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вынужденная или притворная улыбка.",
                        "cs": "Vynucený nebo strojený úsměv."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "натянутая улыбка",
                                "target_lang_sense_clarification": "вымученная или неискренняя улыбка"
                            },
                            {
                                "target_lang_word": "вымученная улыбка",
                                "target_lang_sense_clarification": "улыбка, которая выглядит неестественно"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "křečovitý úsměv",
                                "target_lang_sense_clarification": "nepřirozený, vynucený úsměv"
                            },
                            {
                                "target_lang_word": "strojený úsměv",
                                "target_lang_sense_clarification": "úsměv, který není upřímný"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c920e191-2ff9-34cc-b819-d4d6f8398df5",
                    "sense_definition": "To smile in a way that is affected, smug, insolent or contemptuous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>smirk</w> at me while I am trying to explain the rules.",
                            "target_lang_translations": {
                                "ru": "Не <w>ухмыляйся</w> мне, пока я пытаюсь объяснить правила.",
                                "cs": "Ne <w>ušklíbej se</w> na mě, zatímco se snažím vysvětlit pravidla."
                            }
                        },
                        {
                            "text": "He could not help but <w>smirk</w> when his rival made a silly mistake.",
                            "target_lang_translations": {
                                "ru": "Он не смог удержаться и <w>ухмыльнулся</w>, когда его соперник совершил глупую ошибку.",
                                "cs": "Nemohl si pomoct a <w>ušklíbl se</w>, když jeho soupeř udělal hloupou chybu."
                            }
                        }
                    ],
                    "synonyms": [
                        "simper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улыбаться неестественно, самодовольно, дерзко или презрительно.",
                        "cs": "Usmívat se způsobem, který je strojený, samolibý, drzý nebo pohrdavý."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухмыляться",
                                "target_lang_sense_clarification": "несовершенный вид, выражает насмешливое или самодовольное отношение"
                            },
                            {
                                "target_lang_word": "ухмыльнуться",
                                "target_lang_sense_clarification": "совершенный вид, однократное действие"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ušklíbnout se",
                                "target_lang_sense_clarification": "vyjádřit pohrdání nebo samolibost úsměvem"
                            },
                            {
                                "target_lang_word": "ušklíbat se",
                                "target_lang_sense_clarification": "opakovaně nebo trvale se ušklíbat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2ada3b42-8512-3312-8e83-c22960613b8c",
                    "sense_definition": "Smart, spruce, or affected in appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gentleman looked quite <w>smirk</w> in his new tailored suit.",
                            "target_lang_translations": {
                                "ru": "Джентльмен выглядел весьма <w>щеголевато</w> в своем новом костюме, сшитом на заказ.",
                                "cs": "Pán vypadal ve svém novém obleku na míru velmi <w>elegantně</w>."
                            }
                        },
                        {
                            "text": "He walked with a <w>smirk</w> air that suggested he was very pleased with himself.",
                            "target_lang_translations": {
                                "ru": "Он шел с <w>самодовольным</w> видом, который говорил о том, что он очень доволен собой.",
                                "cs": "Kráčel se <w>samolibým</w> výrazem, který naznačoval, že je se sebou velmi spokojený."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Опрятный, щеголеватый или жеманный (устаревшее значение).",
                        "cs": "Úhledný, elegantní nebo strojený ve vzhledu (zastaralé)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щеголеватый",
                                "target_lang_sense_clarification": "нарядный, франтоватый; о внешнем виде"
                            },
                            {
                                "target_lang_word": "самодовольный",
                                "target_lang_sense_clarification": "с видом довольства собой; о манере держаться"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "elegantní",
                                "target_lang_sense_clarification": "vzhledově upravený a vkusný"
                            },
                            {
                                "target_lang_word": "samolibý",
                                "target_lang_sense_clarification": "vyjadřující přehnanou spokojenost se sebou samým"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}