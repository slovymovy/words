                ],
                "senses": [
                    {
                        "sense_id": "c45c381b-53a3-3089-80d7-b1ace87e22db",
                        "entry_id": "c2822744-bd24-30f8-975d-bb9415ce075b",
                        "glosses": [
                            "Qualifie les contrats qui n’ont pas de dénomination particulière"
                        ],
                        "tags": [
                            "Droit romain"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7a9fe4bd-a30d-34df-b2fa-142cfeb5fd03",
                        "entry_id": "c2822744-bd24-30f8-975d-bb9415ce075b",
                        "glosses": [
                            "Qui n’a pas de nom, qui n'a pas encore reçu de nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de908f4c-e24b-40b9-97c5-0d78ca0ad617",
                                "sense_id": "7a9fe4bd-a30d-34df-b2fa-142cfeb5fd03",
                                "text": "Ce fait, relatif à la post-existence de l’être intérieur, si je puis me permettre de forger un mot nouveau pour rendre un effet innommé, me frappa si vivement que j’en ai gardé le souvenir."
                            },
                            {
                                "example_id": "46f03d35-ff8b-428d-913d-3b089dd677ba",
                                "sense_id": "7a9fe4bd-a30d-34df-b2fa-142cfeb5fd03",
                                "text": "Modeste avait soif des souffrances innommées, des grandes douleurs de la pensée."
                            }
                        ]
                    },
                    {
                        "sense_id": "bed4118a-a3d7-337e-8eed-80060ee8ff24",
                        "entry_id": "c2822744-bd24-30f8-975d-bb9415ce075b",
                        "glosses": [
                            "Qui est inconnu, indéfini ou indéterminé."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3b2a4293-c14c-43b4-a972-b6ddc90cf894",
                                "sense_id": "bed4118a-a3d7-337e-8eed-80060ee8ff24",
                                "text": "En rapport, selon son expression, avec les femmes les plus comme il faut de Paris, il les reconduisait avec des salutations de boutiquier en admirant leur grâce, leur façon de porter les modes, et tous les effets innommés de ce qu’on appelle la race."
                            },
                            {
                                "example_id": "563d81f0-450a-4556-b93e-165d3c7efbd3",
                                "sense_id": "bed4118a-a3d7-337e-8eed-80060ee8ff24",
                                "text": "Au cœur de l’optimisme, invisible, innommé, je gardais le soupçon de mon inconsistance."
                            }
                        ]
                    },
                    {
                        "sense_id": "93316c14-8ffc-3272-a0cb-56418d865dfa",
                        "entry_id": "c2822744-bd24-30f8-975d-bb9415ce075b",
                        "glosses": [
                            "Qui n'est pas nommé à une charge, à un poste"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d54ee35-2ac9-463f-8d49-1719cc319d2d",
                                "sense_id": "93316c14-8ffc-3272-a0cb-56418d865dfa",
                                "text": "Ainsi, les diplomates postés à Pékin en étaient réduits à s’adresser à des ministres fictifs et innommés : exercice intéressant qui nécessitait un grand sens de l’abstraction et une admirable audace spéculative."
                            }
                        ]
                    }
                ],
