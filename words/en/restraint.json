{
    "word_family": [
        "restrain",
        "restrained",
        "unrestrained"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b60abea8-4fa4-3fdc-baf3-453c6aac33d3",
                    "sense_definition": "The quality of keeping one's emotions or behavior under control; a sense of caution or reserve.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "self-control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should try to exercise <w>restraint</w> when talking to your boss about the project delays.",
                            "target_lang_translations": {
                                "ru": "Вам следует постараться проявить <w>сдержанность</w>, когда будете обсуждать с начальником задержки по проекту."
                            }
                        },
                        {
                            "text": "The diplomat showed great <w>restraint</w> by remaining calm despite the aggressive questioning from the press.",
                            "target_lang_translations": {
                                "ru": "Дипломат проявил огромное <w>самообладание</w>, сохраняя спокойствие, несмотря на агрессивные вопросы прессы."
                            }
                        }
                    ],
                    "synonyms": [
                        "self-control",
                        "moderation",
                        "reserve",
                        "self-discipline"
                    ],
                    "antonyms": [
                        "abandon",
                        "excess",
                        "indulgence"
                    ],
                    "common_phrases": [
                        "exercise restraint",
                        "show restraint",
                        "admirable restraint",
                        "remarkable restraint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность контролировать свои эмоции или поведение; чувство осторожности или сдержанности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "умение владеть собой"
                            },
                            {
                                "target_lang_word": "самообладание",
                                "target_lang_sense_clarification": "контроль над эмоциями"
                            },
                            {
                                "target_lang_word": "умеренность",
                                "target_lang_sense_clarification": "отсутствие крайностей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "145cae07-bfbf-3cd2-8569-998b06cbac41",
                    "sense_definition": "A physical device or mechanism that limits movement, ties, fastens, or secures someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical limitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before the plane takes off, make sure all the <w>restraints</w> are tight and secure.",
                            "target_lang_translations": {
                                "ru": "Перед взлетом самолета убедитесь, что все <w>ремни безопасности</w> плотно затянуты и надежно закреплены."
                            }
                        },
                        {
                            "text": "The safety <w>restraint</w> on the roller coaster kept the passengers firmly in their seats.",
                            "target_lang_translations": {
                                "ru": "Защитный <w>фиксатор</w> на американских горках надежно удерживал пассажиров в их креслах."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastening",
                        "binding",
                        "constraint",
                        "tether"
                    ],
                    "common_phrases": [
                        "safety restraint",
                        "physical restraint",
                        "child restraint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое устройство или механизм, который ограничивает движение, связывает или закрепляет кого-либо или что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничитель",
                                "target_lang_sense_clarification": "механическое устройство"
                            },
                            {
                                "target_lang_word": "средство фиксации",
                                "target_lang_sense_clarification": "ремень или крепление"
                            },
                            {
                                "target_lang_word": "удерживающее устройство",
                                "target_lang_sense_clarification": "система безопасности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}