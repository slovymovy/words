                                        "entry_id": "9a501030-5ceb-31f1-938c-4c448ee2c032",
                                        "glosses": [
                                            "Capable of being flexed or bent without breaking; able to be turned or twisted without breaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82ef6b58-aa8a-4048-b4b3-f6b5c44dcf8b",
                                                "sense_id": "67bea306-6844-34b1-bcdd-5a69a0a1e101",
                                                "text": "When the splitting wind Makes flexible the knees of knotted oaks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c4f6971-a1fe-31d7-8721-4bbb2d0f564d",
                                        "entry_id": "9a501030-5ceb-31f1-938c-4c448ee2c032",
                                        "glosses": [
                                            "Willing or prone to give way to the influence of others; not invincibly rigid or obstinate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e75af90-db6c-4a9f-8071-787dc7e94c42",
                                                "sense_id": "6c4f6971-a1fe-31d7-8721-4bbb2d0f564d",
                                                "text": "Phocion the Athenian (a man of great severity, and no ways flexible to the will of the people[…]"
                                            },
                                            {
                                                "example_id": "95fa898c-6b75-4c7e-a8aa-e9d6dca56ad8",
                                                "sense_id": "6c4f6971-a1fe-31d7-8721-4bbb2d0f564d",
                                                "text": "Women are soft, mild, pitiful, and flexible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ed1c274-975a-36de-ad3b-044410d6bdd0",
                                        "entry_id": "9a501030-5ceb-31f1-938c-4c448ee2c032",
                                        "glosses": [
                                            "Capable of adapting or changing to suit new or modified conditions or situations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f64227-7ef8-4ff6-b7f0-b478042e7cc3",
                                                "sense_id": "5ed1c274-975a-36de-ad3b-044410d6bdd0",
                                                "text": "You can't always get what you want: you need to learn to be flexible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "959706fe-9668-3244-888a-461aa13ef3b4",
                                        "entry_id": "9a501030-5ceb-31f1-938c-4c448ee2c032",
                                        "glosses": [
                                            "Capable or being adapted or molded in some way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a06bd8f2-9fac-47be-a534-2ab7a1b6a744",
                                                "sense_id": "959706fe-9668-3244-888a-461aa13ef3b4",
                                                "text": "a flexible language"
                                            },
                                            {
                                                "example_id": "d5678ac3-9e02-4317-bb09-464d3445e453",
                                                "sense_id": "959706fe-9668-3244-888a-461aa13ef3b4",
                                                "text": "This they foresaw was a Principle more flexible to their Purpose"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flexible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "210efd89-745d-36be-8c8d-eb95aca66b9f",
                                        "entry_id": "d7cae4bc-8a40-3f34-9ec2-82218f4dbb6a",
                                        "glosses": [
                                            "Something that is flexible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d6faed-d0ab-44c7-bff7-826bb6000635",
                                                "sense_id": "210efd89-745d-36be-8c8d-eb95aca66b9f",
                                                "text": "Alcan is mostly flexibles -- and so it boosts Amcor's flexible packaging business to a globally significant $7 billion one."
                                            }
                                        ]
