                    {
                        "sense_id": "7704623f-a69b-3264-a16c-82daba86aa6e",
                        "entry_id": "471c1f07-a9bd-31eb-95b6-93a57ea786bb",
                        "glosses": [
                            "Robot humanoïde recouvert de peau pouvant reproduire des expressions du visage humain et avoir l’apparence d’agir comme un humain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a1bfe4-4e2e-46c7-9c5b-5a0e4c20a9c8",
                                "sense_id": "7704623f-a69b-3264-a16c-82daba86aa6e",
                                "text": "Développé par Kokoro et l’université d’Osaka, l’actroïde peut « parler, cligner des yeux et afficher sur son visage plusieurs expressions typiquement humaines »."
                            },
                            {
                                "example_id": "0212b556-e095-4269-b30c-ce6652369851",
                                "sense_id": "7704623f-a69b-3264-a16c-82daba86aa6e",
                                "text": "L’actroïde Simroid assez réaliste réagit quand l’opérateur le touche à un endroit sensible. Il permet ainsi de réaliser un apprentissage du métier sans frais."
                            },
                            {
                                "example_id": "3ebcb52f-30a9-4d7d-8caf-672db2513fff",
                                "sense_id": "7704623f-a69b-3264-a16c-82daba86aa6e",
                                "text": "Simple jouet, véritable outil ou arme dangereuse, le robot peut revêtir plusieurs facettes. De l’actroïde à l’humanoïde en passant par la coupe de France de robotique, les lois de la robotique sont-elles en train de changer ?"
                            }
                        ]
                    }
