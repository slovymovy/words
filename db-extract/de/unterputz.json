                ],
                "senses": [
                    {
                        "sense_id": "23c0fe79-6085-336f-8fdb-b08cf251ca26",
                        "entry_id": "406f6631-adfa-3b74-bf87-703c2f44f0e3",
                        "glosses": [
                            "untere Putzschicht, auf der weitere Beschichtungen aufgebracht werden/sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c72c51d1-9fe4-4d6c-ba06-dbdd64a2e166",
                                "sense_id": "23c0fe79-6085-336f-8fdb-b08cf251ca26",
                                "text": "„Das fertige Wandbild besteht aus einem wasserhemmenden Unterputz, der meistens aus Kalk-ZementMörtel hergestellt wird.“"
                            },
                            {
                                "example_id": "87a11f47-a7c8-42b9-8cc4-066e26446d95",
                                "sense_id": "23c0fe79-6085-336f-8fdb-b08cf251ca26",
                                "text": "„Dabei sollte der Unterputz aus einer oder mehreren Lagen bestehen sowie eine Mindestdicke von 20 mm und maximal 100 mm aufweisen.“"
                            },
                            {
                                "example_id": "177c57a8-77e5-4773-afd5-a4163301e2d2",
                                "sense_id": "23c0fe79-6085-336f-8fdb-b08cf251ca26",
                                "text": "„Zur besseren Verarbeitung darf sowohl beim Ober- als auch beim Unterputz bis zu 20 % des Zements durch Kalkhydrat ersetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
