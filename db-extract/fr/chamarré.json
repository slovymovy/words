        "fr-extract.jsonl": [
            {
                "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                "word": "chamarré",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "562e448d-e62b-40eb-ac14-05e0b0b4bb87",
                        "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "tags": [
                            "plural",
                            "masculine"
                        ],
                        "form": "chamarrés"
                    },
                    {
                        "form_id": "900ca2e8-31e8-44c9-a05b-afecee2a2fba",
                        "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "chamarrée"
                    },
                    {
                        "form_id": "4875a098-05bd-4ff0-94f3-ea770c89391e",
                        "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "chamarrées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                        "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "glosses": [
                            "Très coloré, chargé, surchargé d’ornements, couvert de décorations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16f3086d-c07e-4d5f-abf6-0a88cf5ada3a",
                                "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                                "text": "Cet officier […] se faisait distinguer, au sein de cette multitude chamarrée, par le bel uniforme bleu de ciel des officiers d’ordonnance de l’empereur."
                            },
                            {
                                "example_id": "50fb3e8e-2446-4381-8e3d-f64de2021c9e",
                                "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                                "text": "Et les dévotes parlaient presque haut, stupéfaites par le spectacle de ces dames plus chamarrées que les chasubles des chantres."
                            },
                            {
                                "example_id": "0c889a38-69d8-4ecd-9a70-773327af46f3",
                                "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                                "text": "Et pendant que ce crétin chamarré dit des calembredaines aux femmes, savez-vous ce qui se passe à Dublin ?"
                            },
                            {
                                "example_id": "de3271e5-dfea-4de8-8e1a-2de8e1dbc1b2",
                                "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                                "text": "Bien sûr demeuraient nouées ces écharpes multiples, les souvenirs, mais c’était comme s’il fallait désormais que le passé puisse luire aussi chamarré, aussi intense que ce présent où ils n’étaient plus là."
                            },
                            {
                                "example_id": "a6def2e4-28c2-45d0-bb56-12b99776987f",
                                "sense_id": "65abc333-238c-3ce4-9356-d44eb4d7fb9d",
                                "text": "La loge de l’héroïne, également, est intéressante à cet égard, puisqu'elle est constituée d'une roulotte-cage aux barreaux chamarrés."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9e3b3d1-e1ea-37a0-aa42-05337049dd4c",
                        "entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "glosses": [
                            "Pédant."
                        ],
                        "tags": [
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "68b68eb9-cff4-4ee8-a2fc-820517209755",
                                "sense_id": "a9e3b3d1-e1ea-37a0-aa42-05337049dd4c",
                                "text": "Style chamarré de latin, de grec."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdd9a30a-aed4-4f9c-b7ce-f1a93813823f",
                        "source_entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
                        "source_sense_description": "très coloré, chargé, surchargé d’ornements, couvert de décorations",
                        "target_lang_word": "garish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                        "entry_id": "5d157eb8-904a-37b8-bc2d-ebb7a38ea281",
                                        "glosses": [
                                            "Overly ostentatious; so colorful as to be in bad taste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d74da9b9-46c0-470d-a29b-9fdc91c35a96",
                                                "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                                "text": "The dress fits her well, but the pattern is rather garish."
                                            },
                                            {
                                                "example_id": "43dc4a12-bdb7-4c12-a250-60e6143dcdab",
                                                "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                                "text": "\"My tastes,\" he said, still smiling, \"incline me to the garishly sunlit side of this planet.\" And, to tease her and arouse her to combat: \"I prefer a farandole to a nocturne; I'd rather have a painting than an etching; Mr. Whistler bores me with his monochromatic mud; I don't like dull colours, dull sounds, dull intellects;[…].\""
                                            },
                                            {
                                                "example_id": "6d42b71c-6b72-425c-9e2c-4f62df968fb5",
                                                "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                                "text": "On the other hand, to arrive after dusk, when the multitude of garish little public-houses are lit up, giving glimpses of crowded jostling bars and taprooms, is an introduction to a fine city well calculated to affect even the most nonchalant."
                                            },
                                            {
                                                "example_id": "c7c388f3-aea3-4834-846f-d67399c4a058",
                                                "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                                "text": "Leela: He gave me mechanical ears / Effective though just a bit garish."
                                            },
                                            {
                                                "example_id": "2a52f7ae-b41c-4b66-8c47-80c40ea94dbd",
                                                "sense_id": "9b209022-f4da-3f71-a81e-d5793e2a8bd5",
                                                "text": "She also said that Thameslink trains were deliberately garish, so as to lure drivers stuck on the M1, which runs alongside the line around Radlett."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7be03170-b232-45fd-abe2-ecb832ddcc1b",
                        "source_entry_id": "f6bddd9c-132f-3394-9635-8c5ef4243796",
