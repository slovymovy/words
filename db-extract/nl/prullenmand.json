                "senses": [
                    {
                        "sense_id": "d5276c19-77a0-36b4-a1ba-1d7e6c3d7a08",
                        "entry_id": "b9a716a3-13f3-3216-965d-5a3cefea2abf",
                        "glosses": [
                            "mand waarin men, vooral papieren, afval kan gooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cb12ed7-2ea0-4576-baf5-c02541e27d16",
                                "sense_id": "d5276c19-77a0-36b4-a1ba-1d7e6c3d7a08",
                                "text": "Ik gebruik mijn ijzeren prullenmand ook als voetensteuntje."
                            },
                            {
                                "example_id": "1acceb16-ac1a-4e12-9f2b-251d53a2d039",
                                "sense_id": "d5276c19-77a0-36b4-a1ba-1d7e6c3d7a08",
                                "text": "Je moet afval altijd in een prullenmand gooien en niet zomaar op tafel laten liggen."
                            },
                            {
                                "example_id": "a2a60ea4-7f83-4d70-ad8d-7462bce3cc8a",
                                "sense_id": "d5276c19-77a0-36b4-a1ba-1d7e6c3d7a08",
                                "text": "De PVV is tegen ratificatie vanwege de kosten (73 miljard euro tot 2021), de 100 miljard euro extra ontwikkelingshulp die in het verdrag is afgesproken en de \"onbetrouwbaarheid” van de verdragspartners. Bovendien, aldus het PVV-Tweede Kamerlid Barry Madlener, \"ligt het verdrag al in de prullenmand nu de VS afhaakt\"."
                            },
                            {
                                "example_id": "de52688d-ed05-41b9-a25a-d627e97f75e2",
                                "sense_id": "d5276c19-77a0-36b4-a1ba-1d7e6c3d7a08",
                                "text": "En voel je ook vrij om ze allemaal in de prullenmand te gooien of te verbranden."
                            }
                        ]
                    }
                ],
