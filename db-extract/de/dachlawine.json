                ],
                "senses": [
                    {
                        "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                        "entry_id": "6555251e-45e2-3647-a69d-a749cd21adf8",
                        "glosses": [
                            "Schnee, der von Dächern zu Boden rutscht oder fällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5596f12-c2ed-4c61-9fda-ae13e7edd822",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Achtung! Da kommt eine Dachlawine."
                            },
                            {
                                "example_id": "7411f503-d98b-44b7-94e2-52e62cda28ad",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Den ganzen Tag hörte man im Haus das dumpfe Geräusch der Dachlawinen."
                            },
                            {
                                "example_id": "91096ded-7ee3-4a60-818f-fb8f79951b19",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Louis erlitt einige Verletzungen, als er unter einer Dachlawine begraben wurde."
                            },
                            {
                                "example_id": "e1076076-a824-41b2-9cfa-eba049ad7ab8",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Um das Dach von der enormen Schneelast zu befreien, lösten Cordula und ihre Helfer gezielt Dachlawinen aus."
                            },
                            {
                                "example_id": "4448e932-4211-4593-b55e-17c20c8a8c5f",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Die 89-Jährige wurde auf dem Bürgersteig von einer Dachlawine am Kopf getroffen und verstarb wenig später im Krankenhaus."
                            },
                            {
                                "example_id": "28f44173-f301-4bcc-add4-5647aa155f25",
                                "sense_id": "b518738b-543e-3788-80c8-7b29cec441aa",
                                "text": "Mit Einsetzen des Tauwetters steigt die Gefahr von Dachlawinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
