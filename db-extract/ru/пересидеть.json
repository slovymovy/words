                    },
                    {
                        "form_id": "0e6bd08f-ae8f-4732-b0a7-e05f39ddc085",
                        "entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "пересиде́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d0916f60-95eb-38cc-91e6-be0fa472838e",
                        "entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "glosses": [
                            "просидеть где-либо дольше, чем следует, дольше обычного"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2839b626-83ab-3187-8c99-390b97abb923",
                        "entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "glosses": [
                            "пробыть где-либо в течение определённого времени, пережидая кого-либо, что-либо сидя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf57ae5-cc3f-451e-91fe-2e6a42f94055",
                                "sense_id": "2839b626-83ab-3187-8c99-390b97abb923",
                                "text": "Но это уже был чистый вздор, и мы, пораскинув, решили отправиться на вокзал и пересидеть там до утра."
                            },
                            {
                                "example_id": "f6b9b9f3-6e76-4e3a-a191-7e7f20b18884",
                                "sense_id": "2839b626-83ab-3187-8c99-390b97abb923",
                                "text": "Может, лучше было бы пересидеть где-нибудь, сориентироваться и решить, куда двигаться дальше."
                            },
                            {
                                "example_id": "9eb3f7b2-23ef-403c-a2c9-76899ff85400",
                                "sense_id": "2839b626-83ab-3187-8c99-390b97abb923",
                                "text": "Папа сказал, что надо пересидеть полгодика где-нибудь в тихом месте."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8755f89-24e2-366b-8c07-1ab2405bf5c1",
                        "entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "glosses": [
                            "просидеть где-либо дольше других"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dd500327-3847-34a2-adaa-70318e6a8e95",
                        "entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "glosses": [
                            "посидеть неоднократно (обо всех или многих, во всех или многих местах)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84f70f08-4c90-4b83-a301-6ea2eb9b1c9b",
                        "source_entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "source_sense_description": "просидеть где-либо дольше других",
                        "target_lang_word": "outsit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outsit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26183ceb-faa7-3ccd-b74a-6fcfe68fb8e0",
                                        "entry_id": "832577cf-f72e-30f1-bce7-35ba383168c0",
                                        "glosses": [
                                            "To remain sitting, waiting, or in session, longer than, or beyond the time of; to outstay."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec4b4dd5-1959-4b3a-be2d-4829a07c726c",
                                                "sense_id": "26183ceb-faa7-3ccd-b74a-6fcfe68fb8e0",
                                                "text": "No Scotch government will take him at his own, or rather his wife's extravagant valuation; and betwixt his indecision and her insolence, from all I can guess, he will outsit his market, and be had cheap when no one will bid for him."
                                            },
                                            {
                                                "example_id": "2d1dd24f-57e5-437b-989c-89887664e29b",
                                                "sense_id": "26183ceb-faa7-3ccd-b74a-6fcfe68fb8e0",
                                                "text": "Without a note for his sermon he stepped into his pulpit and, buoyed up by the happiness that surged within him, he signified his intention to begin. Landy and the new Mrs. George sat in the front row—she fussily settling to outsit the ordeal and he striking at once an attitude of absorbed interest."
                                            },
                                            {
                                                "example_id": "70812be7-cab8-4441-8e7c-7fbefcf14a91",
                                                "sense_id": "26183ceb-faa7-3ccd-b74a-6fcfe68fb8e0",
                                                "text": "While she had been speaking he had made up his mind what course to take, and now, having outsat everybody else, he decided that it was time for the interview to cease."
                                            },
                                            {
                                                "example_id": "c60f57c5-1474-4486-98d3-963be5d5f2c6",
                                                "sense_id": "26183ceb-faa7-3ccd-b74a-6fcfe68fb8e0",
                                                "text": "Billy said nothing. Captain Powell sat tight, and Billy tried to outsit him. He probably would have failed in this had not some crony of the captain's, living near by, reminded him over the telephone that he had a chess engagement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28d4062f-d9dc-41a9-8904-fbc36532cee6",
                        "source_entry_id": "af4f71d5-aa18-3333-8c83-7b3e0b690b89",
                        "source_sense_description": "просидеть где-либо дольше других",
                        "target_lang_word": "outstay",
