                        "examples": [
                            {
                                "example_id": "7c04ab3e-f5a2-4df5-8ea6-399fe4cad2c8",
                                "sense_id": "5c2b70c8-2194-36af-8803-93898a06f43b",
                                "text": "„Naruhitos Ära wird unter der Losung «Reiwa» stehen, was etwa «schöne Harmonie» bedeutet.“"
                            },
                            {
                                "example_id": "a40d766c-680b-4b50-984e-ecd8f5437fe5",
                                "sense_id": "5c2b70c8-2194-36af-8803-93898a06f43b",
                                "text": "„Warum nehmen Sie nicht den Übergang von der Heisei-Ära zur Reiwa-Ära zum Anlass, sich der Herausforderung eines neuen Go zu stellen?“"
                            },
                            {
                                "example_id": "3e34b9ba-9fb7-4372-98be-ae35da609271",
                                "sense_id": "5c2b70c8-2194-36af-8803-93898a06f43b",
                                "text": "„Während der Arbeit an diesem Buch ist Jahr 1 der Ära Reiwa angebrochen.“"
                            }
