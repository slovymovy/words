{
    "word_family": [
        "smudgy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19c23d4d-5bad-3943-9fe6-38b363379185",
                    "sense_definition": "A dirty mark or smear, often dark or sooty.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a dark <w>smudge</w> on the white paper.",
                            "target_lang_translations": {
                                "zh": "白纸上有一个深色的<w>污迹</w>。"
                            }
                        },
                        {
                            "text": "She tried to wipe the <w>smudge</w> off her glasses.",
                            "target_lang_translations": {
                                "zh": "她试图擦掉眼镜上的<w>污点</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stain",
                        "smear",
                        "smutch"
                    ],
                    "common_phrases": [
                        "ink smudge",
                        "dirty smudge"
                    ],
                    "target_lang_definitions": {
                        "zh": "指脏的痕迹或污点，通常颜色较深或呈烟熏状。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "污点",
                                "target_lang_sense_clarification": "指物体表面留下的脏痕。"
                            },
                            {
                                "target_lang_word": "污迹",
                                "target_lang_sense_clarification": "指擦拭或接触后留下的模糊痕迹。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6167ccc6-48bd-3392-ac81-5003d34d9b76",
                    "sense_definition": "A slow-burning fire used to create smoke to repel insects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We built a <w>smudge</w> to keep the mosquitoes away from our camp.",
                            "target_lang_translations": {
                                "zh": "我们生了一堆<w>驱虫烟火</w>来让蚊子远离我们的营地。"
                            }
                        },
                        {
                            "text": "The thick smoke from the <w>smudge</w> made it hard to breathe.",
                            "target_lang_translations": {
                                "zh": "从<w>驱虫烟火</w>冒出的浓烟让人难以呼吸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "build a smudge"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过缓慢燃烧产生烟雾以驱赶昆虫的火堆。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "驱虫烟火",
                                "target_lang_sense_clarification": "专门用于产生烟雾驱赶蚊虫的火堆。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e4c9ee2-b642-306b-8a06-48c48665dfeb",
                    "sense_definition": "To make something dirty by rubbing it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>smudge</w> the wet ink on your drawing.",
                            "target_lang_translations": {
                                "zh": "别把画上还没干的墨水<w>弄模糊</w>了。"
                            }
                        },
                        {
                            "text": "He accidentally <w>smudged</w> the painting with his thumb.",
                            "target_lang_translations": {
                                "zh": "他不小心用大拇指把画<w>弄脏</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smear",
                        "soil",
                        "smutch"
                    ],
                    "common_phrases": [
                        "smudge the ink"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过摩擦使某物变脏或弄模糊。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "指使物体表面沾上污垢。"
                            },
                            {
                                "target_lang_word": "擦模糊",
                                "target_lang_sense_clarification": "指因摩擦导致字迹或图像变得不清晰。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eed6fb5f-9bb0-34f3-8b39-0837e74c68fd",
                    "sense_definition": "To burn herbs as part of a cleansing ritual.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ritual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>smudge</w> their homes with sage to clear negative energy.",
                            "target_lang_translations": {
                                "zh": "许多人会用鼠尾草<w>烟熏净化</w>房屋以清除负能量。"
                            }
                        },
                        {
                            "text": "She decided to <w>smudge</w> the room before starting her meditation.",
                            "target_lang_translations": {
                                "zh": "她决定在开始冥想前先对房间进行<w>烟熏净化</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "smudge with sage"
                    ],
                    "target_lang_definitions": {
                        "zh": "指通过燃烧草药进行净化仪式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "烟熏净化",
                                "target_lang_sense_clarification": "指通过燃烧草药烟雾来清除负能量的仪式。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bf453c7-e96b-3158-b015-b42d2b432b1a",
                    "sense_definition": "To use smoke to protect an area from insects.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "smoke",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers <w>smudge</w> the fields to protect the crops from pests.",
                            "target_lang_translations": {
                                "zh": "农民们通过<w>熏烟驱虫</w>来保护农作物免受害虫侵害。"
                            }
                        },
                        {
                            "text": "They had to <w>smudge</w> the campsite all night to avoid the gnats.",
                            "target_lang_translations": {
                                "zh": "为了避开蚋虫，他们整晚都必须在营地<w>熏烟驱虫</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fumigate"
                    ],
                    "target_lang_definitions": {
                        "zh": "指利用烟雾保护区域免受昆虫侵害。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "熏烟驱虫",
                                "target_lang_sense_clarification": "指通过制造烟雾来保护作物或区域免受害虫侵扰。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}