    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "752d314e-028b-39ec-a659-4cea8ab3c6a6",
                    "sense_definition": "einen Gegenstand oder die Hand schützend oder abdeckend vor sich beziehungsweise vor jemanden halten; etwas drohend auf jemanden richten",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "halten_vor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim Husten sollte man sich immer die Hand <w>vorhalten</w>."
                        },
                        {
                            "text": "Der Täter bedrohte die Angestellten, indem er ihnen eine Waffe <w>vorhielt</w>."
                        }
                    ],
                    "common_phrases": [
                        "die Hand vorhalten",
                        "eine Waffe vorhalten"
                    ]
                },
                {
                    "sense_id": "f1b805d7-4f2b-3928-88ea-b4394b86fb32",
                    "sense_definition": "jemandem ein Fehlverhalten oder ein Versäumnis tadelnd zur Last legen",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "tadeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sie <w>hielt</w> ihrem Bruder seine ständige Unpünktlichkeit <w>vor</w>."
                        },
                        {
                            "text": "Der Politiker musste sich in der Debatte zahlreiche Fehler <w>vorhalten</w> lassen."
                        }
                    ],
                    "synonyms": [
                        "vorwerfen"
                    ],
                    "common_phrases": [
                        "Fehler vorhalten",
                        "sich etwas vorhalten lassen"
                    ]
                },
                {
                    "sense_id": "8b6c0611-24bb-30ea-b57b-1ad537274cc6",
                    "sense_definition": "etwas für einen künftigen Bedarf oder Notfall bereithalten beziehungsweise auf Vorrat haben",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reservieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Klinik muss für Notfälle stets freie Betten und Personal <w>vorhalten</w>."
                        },
                        {
                            "text": "Unternehmen sollten ausreichende finanzielle Rücklagen für Krisenzeiten <w>vorhalten</w>."
                        }
                    ],
                    "common_phrases": [
                        "Personal vorhalten",
                        "Kapazitäten vorhalten",
                        "Reserven vorhalten"
