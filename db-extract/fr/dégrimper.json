                "senses": [
                    {
                        "sense_id": "0ceeaae5-0896-388b-b2da-d363502dcb22",
                        "entry_id": "79cedc7c-280e-3687-82f1-4728d352bdea",
                        "glosses": [
                            "Redescendre de là où on a grimpé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cabf72e2-4f9c-4b26-8c53-5965925e5ae2",
                                "sense_id": "0ceeaae5-0896-388b-b2da-d363502dcb22",
                                "text": "Mais moi, je dois dégrimper."
                            },
                            {
                                "example_id": "d9c201bf-7dfd-490c-a43f-ca49b91688a7",
                                "sense_id": "0ceeaae5-0896-388b-b2da-d363502dcb22",
                                "text": "Dégrimper stimule ainsi votre proprioception aussi bien consciente qu'inconsciente, grâce aux positions engendrées."
                            },
                            {
                                "example_id": "c1daea05-beb3-4b15-b066-0f02e78e1341",
                                "sense_id": "0ceeaae5-0896-388b-b2da-d363502dcb22",
                                "text": "Il venait juste de dégrimper qu'un de ses élèves commençait à hurler parce qu'il avait entortillé sa corde autour des arbres en redescendant de « Jump or not jump »."
                            }
                        ]
                    }
