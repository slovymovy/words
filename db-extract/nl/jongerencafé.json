                        "examples": [
                            {
                                "example_id": "56718876-6f4b-435d-bbb3-62253b699ce5",
                                "sense_id": "90c60eaa-ebaf-3f1d-abbe-dd8c48b5b6a6",
                                "text": "ENSCHEDE - Café Singers aan de Langestraat 62 is gekocht door Henk-Jan van der Heide en Johnny Beaupain. De eigenaren van de cafés Central Park en Friends Too, beide aan de Langestraat, willen in het voormalige jongerencafé een kroeg beginnen met een nieuw concept."
                            },
                            {
                                "example_id": "1059dea6-c3b0-4016-ade6-a038911ae2b2",
                                "sense_id": "90c60eaa-ebaf-3f1d-abbe-dd8c48b5b6a6",
                                "text": "De vechtpartij vond plaats voor de ingang van het jongerencafé van Grand Café Smit in Losser. Het was daar zeer druk op dat moment vanwege het Bruegheliaans Festijn in Losser. Het slachtoffer stond tussen 01:00 en 01:30 uur met vrienden te wachten voor de ingang van het jongerencafé toen ze door een of twee jongens werd belaagd. Ze werd hard in het gezicht geslagen waardoor ze buiten bewustzijn raakte. Het slachtoffer werd met een ambulance naar het ziekenhuis in Enschede vervoerd."
                            }
                        ]
                    }
