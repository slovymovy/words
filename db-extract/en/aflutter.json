    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                "word": "aflutter",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1fa31205-fc30-43cb-ac3f-70ac24f3f3c6",
                        "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more aflutter"
                    },
                    {
                        "form_id": "204b5984-1732-4d8c-9c54-7fdf6c6436b9",
                        "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most aflutter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "427ad2f5-85c3-32ed-a789-0c4c313f2ed4",
                        "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "glosses": [
                            "Fluttering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4377c6f6-41c8-49de-936c-dd22b93fa4d2",
                                "sense_id": "427ad2f5-85c3-32ed-a789-0c4c313f2ed4",
                                "text": "I can hear / Your heart a-flutter over the snow-hills;"
                            },
                            {
                                "example_id": "4cd14d40-2f5e-4ab3-b44d-1aca7b641930",
                                "sense_id": "427ad2f5-85c3-32ed-a789-0c4c313f2ed4",
                                "text": "1888, W. B. Yeats, “King Gall” in uncredited editor, Poems and Ballads of Young Ireland, Dublin: M.H. Gill, p. 43,\nThey will not hush, the leaves a-flutter round me—the beech leaves old"
                            },
                            {
                                "example_id": "ef29e22c-9a91-452a-887f-7830d045bfde",
                                "sense_id": "427ad2f5-85c3-32ed-a789-0c4c313f2ed4",
                                "text": "The winds bared her limbs, the opposing breezes set her garments aflutter as she ran, and a light air flung her locks streaming behind her."
                            },
                            {
                                "example_id": "723a3266-cf2a-44ec-b749-c24fe0d7d09a",
                                "sense_id": "427ad2f5-85c3-32ed-a789-0c4c313f2ed4",
                                "text": "An electric guitar lick […] imposed itself in his mind as a major symbol of virility and youth, notes rising like scimitars, aftertones aflutter like birds, the bending of a blues note like the rising arc of an erection."
                            }
                        ]
                    },
                    {
                        "sense_id": "38ee258b-b626-3635-b8bc-da0e70896842",
                        "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "glosses": [
                            "Filled or covered (with something that flutters)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "270be8bb-ff66-48e5-8d13-b3a97a324964",
                                "sense_id": "38ee258b-b626-3635-b8bc-da0e70896842",
                                "text": "The day being warm and sultry, the balcony was all aflutter with the feather fans of the ladies of the family and their attendants,"
                            },
                            {
                                "example_id": "68d4da93-c429-4a73-9053-d95fc8346eb4",
                                "sense_id": "38ee258b-b626-3635-b8bc-da0e70896842",
                                "text": "Beyond this lie the gardens of Hafiz and Saadi, each containing the poet’s tomb, and many others equally delicious for their cypresses, pines, and orange trees a-flutter with white pigeons and orchestras of sparrows."
                            },
                            {
                                "example_id": "1896362f-20c1-4b99-a607-abf6b4ea900a",
                                "sense_id": "38ee258b-b626-3635-b8bc-da0e70896842",
                                "text": "When Sammy returned from Virginia, after an interminable gray trip back up U.S. 1, he found their house in Midwood aflutter with bunting."
                            }
                        ]
                    },
                    {
                        "sense_id": "aae75ee9-85ac-3601-af2a-8ad911fcc5e2",
                        "entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "glosses": [
                            "In a state of tremulous excitement, anticipation or confusion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2430baa-8f36-4648-902f-2cc34a73edd2",
                                "sense_id": "aae75ee9-85ac-3601-af2a-8ad911fcc5e2",
                                "text": "[…] she rose, all a-flutter within, it is true, but with a face as nearly sedate as the inborn witchery of her eyes would allow."
                            },
                            {
                                "example_id": "48bf0f88-6a18-4c42-a7b9-e23a5d10db10",
                                "sense_id": "aae75ee9-85ac-3601-af2a-8ad911fcc5e2",
                                "text": "1930, Moss Hart and George S. Kaufman, Once in a Lifetime, Act III, in Burns Mantle (ed.), The Best Plays of 1930-31, New York: Dodd, Mead, 1931, p. 144,\n[…] in breaks Susan Walker a little more aflutter than usual. The picture is wonderful. Seeing her name in lights is wonderful. Everything is just wonderful."
                            },
                            {
                                "example_id": "e4364733-3e89-4a22-af3b-bec35cc3696f",
                                "sense_id": "aae75ee9-85ac-3601-af2a-8ad911fcc5e2",
                                "text": "Once inside the house, everything was aflutter until I was safe and sound."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f5c2cce-3093-4e7f-81c0-090fef0214ed",
                        "source_entry_id": "b0b0d57b-638d-3267-b47c-d86f30885afe",
                        "source_sense_description": "in a state of excited anticipation",
                        "target_lang_word": "tremblé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tremblé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8efd2d42-570e-3b13-984f-8e5f86a2483e",
                                        "entry_id": "f141d672-15b7-38f1-8497-670fc45f7b70",
                                        "glosses": [
                                            "Qui est tracé d’une main tremblante, peu ferme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8dc677-72f3-49b4-b721-125e261a2563",
                                                "sense_id": "8efd2d42-570e-3b13-984f-8e5f86a2483e",
                                                "text": "Une écriture tremblée."
                                            },
                                            {
                                                "example_id": "6017fbd2-0835-43a4-8dd7-44de76e6572a",
                                                "sense_id": "8efd2d42-570e-3b13-984f-8e5f86a2483e",
                                                "text": "Et aux dernières lignes, les lettres étaient énormes et toutes tremblées, de sorte que l’on pensait à un long appel désespéré qui aurait grandi et aurait sangloté avant de s’éteindre pour toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cff4a4a-4314-398c-b500-89eba52573da",
                                        "entry_id": "f141d672-15b7-38f1-8497-670fc45f7b70",
                                        "glosses": [
                                            "Qui est sinueux, qui n’est pas droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e35884ab-0bdf-44e8-8541-9128098280e8",
                                                "sense_id": "9cff4a4a-4314-398c-b500-89eba52573da",
                                                "text": "Des lignes tremblées."
                                            },
                                            {
                                                "example_id": "9da9d2c2-7c48-45ed-a6b1-bb4981b538ca",
                                                "sense_id": "9cff4a4a-4314-398c-b500-89eba52573da",
                                                "text": "Un trait tremblé."
                                            },
                                            {
                                                "example_id": "884a56b2-da2f-45fd-b916-d7ba1e0b02f4",
                                                "sense_id": "9cff4a4a-4314-398c-b500-89eba52573da",
                                                "text": "Comme la première neige qui touche d’un doigt plus solennel la cime la plus haute, sa blancheur irréelle la consacrait mystérieusement, l’enveloppait d’une légère vapeur tremblée qui fumait vers la nuit lunaire, la marquait de l’incandescence d’un charbon ardent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5bc5911-d03d-3a77-bc95-76c299d13004",
                                        "entry_id": "f141d672-15b7-38f1-8497-670fc45f7b70",
                                        "glosses": [
                                            "Qui indique un sentiment de peur, de crainte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5d34a15-4e58-49ed-b9b4-545ef69a0b9b",
                                                "sense_id": "b5bc5911-d03d-3a77-bc95-76c299d13004",
                                                "text": "Il y avait une telle épouvante, une telle détresse dans ces paroles tremblées, balbutiées, que Mathieu en fut remué jusqu’aux entrailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e25f28de-aaba-3b12-8b60-5c67411a22a8",
                                        "entry_id": "f141d672-15b7-38f1-8497-670fc45f7b70",
                                        "glosses": [
                                            "Se dit d'un son ou d'une voix mal assurés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6639f2e-397c-47f7-9281-4d74791c0786",
                                                "sense_id": "e25f28de-aaba-3b12-8b60-5c67411a22a8",
                                                "text": "La professeure de musique, Mlle Chef, qui terrorisait les élèves de sixième, le son tremblé qui sortait de leurs flûtes en plastique, et cette jouissance quand les filles comprenaient que Mlle Chef n'était qu'une femme stupide à la merci de leur pouvoir commun."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tremblé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74beb55e-707f-346d-9693-41adcb5e869a",
                                        "entry_id": "af4fcefd-e4b3-3e87-8905-4c94eadbe2ef",
                                        "glosses": [
                                            "Manière de trembler, type de tremblement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "429cba63-81c5-4d4e-a659-eea19382014a",
                                                "sense_id": "74beb55e-707f-346d-9693-41adcb5e869a",
                                                "text": "En fait, la rambleur ne se voit pas. C’est un rayonnement intérieur. L’attente d’un renversement. Une sorte de tremblé révélant l’ambiguïté des choses et des êtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325b068b-c8b9-3546-bb3e-58b50e0872ff",
                                        "entry_id": "af4fcefd-e4b3-3e87-8905-4c94eadbe2ef",
                                        "glosses": [
                                            "Sorte de filet au dessin sinusoïdal."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fb6f647-5892-30d6-8f43-05cbf99b6085",
                                        "entry_id": "af4fcefd-e4b3-3e87-8905-4c94eadbe2ef",
                                        "glosses": [
                                            "Tracé sinueux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3a21b3-09cf-41cb-99cd-9cfaaf12e9ad",
                                                "sense_id": "0fb6f647-5892-30d6-8f43-05cbf99b6085",
                                                "text": "De grandes lignes bleues symbolisent les lignes aériennes, dont la rectitude contraste avec le tremblé des cours d’eau."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tremblé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae06fa99-5607-37d1-9d17-4baac55d3b36",
                                        "entry_id": "4c281115-ebe0-3de2-b011-550d4e16f541",
                                        "glosses": [
                                            "Participe passé masculin singulier de trembler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "602178d1-7b1a-4a0c-b16f-68821677bfd9",
                                                "sense_id": "ae06fa99-5607-37d1-9d17-4baac55d3b36",
                                                "text": "« {…] On it », renchérissait une blondine ruthène, suspendant un instant le toc-toc de son couteau, « que notre jeune empereur l’aime à la folie, et qu’en l’église des Augustins, sa main a tremblé en lui passant l’anneau au doigt ; alors Élisabeth a levé les yeux, et elle lui a souri. »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
