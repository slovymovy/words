                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Merkwürdigerweise hatte ich den alten Derkum nie fanatisch gefunden, aber vielleicht hatte mein Vater Fanatismus und Konsequenz miteinander verwechselt.“"
                                            },
                                            {
                                                "example_id": "9eae5ca2-6488-481c-b44f-b948a0ea289c",
                                                "sense_id": "4892f8d1-cac8-3ec8-b7e6-14402974e8dd",
                                                "text": "„Ich bin mit Necla Kelek verabredet und möchte mit ihr über Fanatismus und Fundamentalismus reden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
