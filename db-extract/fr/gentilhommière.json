                        "glosses": [
                            "Petit domaine d’un gentilhomme à la campagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "072d761d-e289-4a15-a39e-e4e50d8b3d1d",
                                "sense_id": "c3f3f8ad-ecb7-399a-96f0-61f689987e93",
                                "text": "Sur le revers d’une de ces collines décharnées qui bossuent les Landes, entre Dax et Mont-de-Marsan, s’élevait, sous le règne de Louis XIII, une de ces gentilhommières si communes en Gascogne, et que les villageois décorent du nom de château."
                            },
                            {
                                "example_id": "ec58ca70-049a-47a8-9bff-40795c66d3ee",
                                "sense_id": "c3f3f8ad-ecb7-399a-96f0-61f689987e93",
                                "text": "J'habite depuis huit jours, au fond d'un pays perdu, une gentilhommière qui fleure le bon vieux temps à dix kilomètres à la ronde."
                            }
                        ]
                    }
                ],
