                ],
                "senses": [
                    {
                        "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                        "entry_id": "e5153b28-b768-3c6a-8dbb-ff7cf9013b7c",
                        "glosses": [
                            "weiße Lampe, die rundum (= 360°) leuchtet, auf einem Schiff, das bei Nacht ankert; Schiffe über 50 m Länge müssen nachts vor Anker zwei Ankerlichter führen (eins am Bug und eins am Heck des Schiffes)"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "b2488166-e340-4f38-99f6-d6a281853144",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "In stillen malerischen Buchten kann man nachts viele Ankerlichter von Yachten sehen."
                            },
                            {
                                "example_id": "83534f51-7bc9-4dc9-bfa1-83f9b42d3af4",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Bei Einsetzen der Dämmerung müssen die Ankerlichter eingeschaltet werden, auch wenn sich außer einem gelegentlichen Krabbenkutter nie ein fremdes Gefährt in dieses Gewässer verirrt.“"
                            },
                            {
                                "example_id": "d6757730-ce20-4389-9756-04b819321c91",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Entsprechend den Vorschriften der Seeschiffahrtsstraßenordnung setzt Pegasos nächtens ein Ankerlicht.“"
                            },
                            {
                                "example_id": "a18f165f-e300-480f-aabc-57d15a2acb61",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Ein bisschen Strom braucht man ja vielleicht an Bord für die Navigationslampen und das Ankerlicht, wenn man zum Übernachten den Hafen verlassen muss.“"
                            },
                            {
                                "example_id": "9cd86147-7254-4686-b0fa-47121fd1f698",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Bei anbrechender Dunkelheit sollte man nicht vergessen, das Ankerlicht anzuschalten. Hierzu ist das in der Mastspitze fest montierte Ankerlicht praktisch.“"
                            },
                            {
                                "example_id": "d8ba0d24-7d3c-491a-8d56-b12bd14bc581",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Das Ankerlicht von Segelbooten befindet sich normalerweise auf der Mastspitze.“"
                            },
                            {
                                "example_id": "121a496b-a1fe-4e4d-954d-571693f8ad30",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Außerdem werden andere Schiffe, die nachts in die Ankerbucht kommen, ein Ankerlicht auf Decksniveau besser sehen, als ein Licht auf Sternenhöhe.“"
                            },
                            {
                                "example_id": "3dd6c416-4742-4034-b9ad-8dc712befdf4",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "[Das Sortiment von LED-Navigationslichtern] „umfasst einfarbige und doppelfarbige Seitenlichter sowie Heck-, Topp- und Ankerlicht.“"
                            },
                            {
                                "example_id": "bb48a53a-a5a3-4279-9369-b0188cd0532d",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Sehr lange Schiffe setzen neben dem Ankerlicht im Bug in der Regel auch noch ein solches im Heck.“"
                            },
                            {
                                "example_id": "3fa5bd6c-dd7d-4c49-b256-4872a043daeb",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Anstelle des üblichen einfachen Ankerlichtes am Bug setzte sie ein weiteres am Heck des Schiffes. In der Nacht wurde sie mittschiffs von der Blenheim gerammt, da deren Kapitän die France nachts für zwei Schiffe oder Fischerboote hielt, zwischen denen er durchfahren wollte.“"
                            },
                            {
                                "example_id": "f9bd81c5-4bbd-4e55-8034-e9e6cd40c4f3",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Das Dock führte ein weißes Ankerlicht und war durch zwei Schifffahrtszeichen (Tonnen) gekennzeichnet.“"
                            },
                            {
                                "example_id": "2b00093c-bb0d-4d9c-b853-3df1a495f37c",
                                "sense_id": "63aab49f-fb9a-3e96-8ee9-44aa4e3d9a5e",
                                "text": "„Der Strom würde also vom Stecker hoch in den Mast durch das Ankerlicht fließen, es zum Leuchten bringen und wieder zurückkehren zum anderen Pol des Steckers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
