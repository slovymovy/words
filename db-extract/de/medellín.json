                ],
                "senses": [
                    {
                        "sense_id": "abc6d154-9051-3660-b65c-3a47e538c7e6",
                        "entry_id": "3715f734-71fc-34a1-bed5-9e5e206ee560",
                        "glosses": [
                            "Großstadt in Kolumbien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961d1e35-3265-4f9d-b9de-a5aa3f5b508c",
                                "sense_id": "abc6d154-9051-3660-b65c-3a47e538c7e6",
                                "text": "„Als sie wieder zu sich kam, fuhr sie geradewegs in das Viertel Los Olivos im Süden des Stadzentrums von Medellín, wo es nach Angaben der Fernseh- und Rundfunkreporter passiert war.“"
                            },
                            {
                                "example_id": "a3f9eeca-6fe2-4521-bfd4-f6475bb3b2de",
                                "sense_id": "abc6d154-9051-3660-b65c-3a47e538c7e6",
                                "text": "„Er ging die Liste durch und fand zwei Flüge innerhalb der nächsten Stunde: nach Medellín und Havanna.“"
                            },
                            {
                                "example_id": "e9038da1-43fc-4ca1-a60f-49245d6758ee",
                                "sense_id": "abc6d154-9051-3660-b65c-3a47e538c7e6",
                                "text": "„Aber Pablito Escobar, der Herr von Medellín, hatte auch außerhalb Kolumbiens ein Problem: Die US-amerikanische Polizei, die er nicht bestechen konnte, beschlagnahmte zu viele seiner Ladungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7cd95bdb-0bb0-3a00-8012-6487a7a957a6",
                        "entry_id": "3715f734-71fc-34a1-bed5-9e5e206ee560",
                        "glosses": [
                            "Ort in der spanischen Autonomen Gemeinschaft Extremadura"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5dfb70e-b11a-4414-b6a0-32c3ba5a5429",
                                "sense_id": "7cd95bdb-0bb0-3a00-8012-6487a7a957a6",
                                "text": "„Ansätze zu einem Denkmal für Cortés in Mexiko scheiterten immer wieder am Widerstand der Bevölkerung und 2010 war selbst in seinem Geburtsort Medellín in Spanien die Statue vor Vandalismus nicht mehr sicher.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
