            {
                "entry_id": "e77a23f2-b6b3-3b1b-be2c-fc1d727c9eb5",
                "word": "Moselle",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                        "entry_id": "e77a23f2-b6b3-3b1b-be2c-fc1d727c9eb5",
                        "glosses": [
                            "Rivière qui traverse la Lorraine, le Luxembourg et l’Allemagne pour se jeter dans le Rhin."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "3f14c35c-0f8e-4d73-a022-10eea4ec176b",
                                "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                                "text": "Voici le Madon, affluent de la Moselle, dont les eaux limoneuses invitent peu à la baignade, malgré la grande chaleur."
                            },
                            {
                                "example_id": "3ac2efbb-1ca2-42c9-abe7-a58e328d30b2",
                                "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                                "text": "La Moselle aussi avait changé d’aspect. Ce n’était plus la rivière qui coulait en aval, tournoyante et rapide, brisée sur des barrages dont la grande voix emplissait le val."
                            },
                            {
                                "example_id": "04112e65-e304-4705-86e9-f885d1b87157",
                                "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                                "text": "Depuis l’aube, les troupes passaient la Moselle. C'était, sur le tremblement des ponts de bois, l’avalanche interminable des régiments."
                            },
                            {
                                "example_id": "fb4f2522-a915-46ed-ab80-5a2dbc3b6c05",
                                "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                                "text": "Il s'agit d'un système d’information transnational de crues mis en place dans les bassins de la Moselle, de la Nahe et, pour partie, de celui du Rhin (environ 55 000 km2)."
                            },
                            {
                                "example_id": "b1cffbc8-c442-48a3-8c23-50c478d14be1",
                                "sense_id": "5907998b-6f31-322e-b910-648ec07f59b5",
                                "text": "[…], Beau Geste se leva et, […], se mit à tonner :\n “Aubergiste, à boire ou je tue le chien ! Donne à mes hussards ton meilleur vin de Moselle et descends pour nous dans la cave. Tu devrais trouver dans un recoin poussiéreux deux belles bouteilles de chambertin qui ne sont pas loin d'avoir mon âge."
                            }
                        ]
                    },
                    {
                        "sense_id": "11c33b55-9d7c-3093-b288-b6a7fb9ea568",
                        "entry_id": "e77a23f2-b6b3-3b1b-be2c-fc1d727c9eb5",
                        "glosses": [
                            "Département français de la région Grand Est, autour de Metz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "026c23bd-5a8c-496e-bf11-45aad11abc55",
                                "sense_id": "11c33b55-9d7c-3093-b288-b6a7fb9ea568",
                                "text": "Fondé en 1872, à l’initiative de Richard Stieve, un magistrat allemand installé à Saverne, le Club vosgien est devenu, en 1995, une fédération regroupant 130 associations situées dans les départements du Bas-Rhin, Haut-Rhin, des Vosges, du Territoire de Belfort, de Meurthe-et-Moselle et Moselle ainsi qu’une association à Paris et une autre dans le Gard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "28117a36-da65-4944-8915-8d63f396d49a",
                        "source_entry_id": "e77a23f2-b6b3-3b1b-be2c-fc1d727c9eb5",
                        "source_sense_description": "rivière",
                        "target_lang_word": "Mosel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mosel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                        "entry_id": "3adee324-5e52-3128-b33c-94dc2074c1e4",
                                        "glosses": [
                                            "linker Nebenfluss des Rheins; entspringt in den südlichen Vogesen, durchfließt die lothringische Stufenlandschaft, tritt bei Trier in das mittelrheinische Schiefergebirge ein, das sie mit Weinbergen tief einschneidet und mündet in Koblenz in den Rhein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323299bb-0789-4df6-b820-9094aea7a2a0",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "Die Mosel fließt in Koblenz in den Rhein."
                                            },
                                            {
                                                "example_id": "f8273112-7fe1-40a2-a5cb-0db87de8f443",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "An der Mosel gibt es viele Staustufen."
                                            },
                                            {
                                                "example_id": "7dd87dc9-f99e-4392-90fc-e7eb8e5ef319",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Die Mosel liegt abseits, ihre Reize sind abseits.“"
                                            },
                                            {
                                                "example_id": "40ba8468-a129-43c8-8dce-92c1870ae601",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Die Mosel ist erwacht aus der mittelalterlichen Abgeschlossenheit.“"
                                            },
                                            {
                                                "example_id": "43bf334c-d028-4fbf-b3c7-f14f8afd1d41",
                                                "sense_id": "93a79afb-1289-362a-844c-f58456a70603",
                                                "text": "„Das Wandern war also ganz einfach, denn wir brauchten überhaupt keine Karten, wir gingen einfach immer an der Mosel entlang, die Mosel war unser Reiseführer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mosel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad7d337-0c9b-3917-8f41-55475a4107c3",
                                        "entry_id": "cb44fbea-d6af-37a0-96a1-11b477131e87",
                                        "glosses": [
                                            "Wein von der Mosel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43442ec9-31c3-414b-9967-7de90b952463",
                                                "sense_id": "3ad7d337-0c9b-3917-8f41-55475a4107c3",
                                                "text": "„Wernicke gießt den Rest des Mosels in die Gläser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
