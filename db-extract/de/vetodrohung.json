                "senses": [
                    {
                        "sense_id": "66b32ad3-411d-390c-b4af-c15457ee87c7",
                        "entry_id": "134c076a-d6c2-3921-9385-6c2382e9c8af",
                        "glosses": [
                            "Ankündigung, eine Sache (mittels Veto) zu verhindern/zu unterbinden/abzulehnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25eaaddc-7ac2-4185-ba76-5fcd9b90994e",
                                "sense_id": "66b32ad3-411d-390c-b4af-c15457ee87c7",
                                "text": "„Trotz einer russischen Vetodrohung will der UN-Sicherheitsrat noch heute über eine Syrien-Resolution entscheiden.“"
                            },
                            {
                                "example_id": "4f92c4d7-469d-4f5d-80b2-dd5525e5ce99",
                                "sense_id": "66b32ad3-411d-390c-b4af-c15457ee87c7",
                                "text": "„Wegen der Vetodrohung war bereits ein Resolutionsentwurf im Frühsommer gescheitert, der aktuelle Entwurf war erheblich entschärft worden.“"
                            },
                            {
                                "example_id": "b05ea70b-4e32-40d6-9ce2-c5c90aca24c3",
                                "sense_id": "66b32ad3-411d-390c-b4af-c15457ee87c7",
                                "text": "„Das Londoner Angebot von Ende Juni hat EU-Ratspräsident Donald Tusk als unzureichend zurückgewiesen, das EU-Parlament hatte es gar zum Anlass für eine Vetodrohung gegen das gesamte Austrittsabkommen genommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
