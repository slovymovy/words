                "senses": [
                    {
                        "sense_id": "9db95fc1-c1c8-350b-af43-ce2e876bf131",
                        "entry_id": "e7bbaaf5-83d2-3e67-b2bd-b9f52a443b62",
                        "glosses": [
                            "Esclave autochtone de la colonie du Canada, souvent originaires des Grandes Plaines et du bassin des Grands Lacs."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "c849c8a6-8087-4f1d-9231-73267ac9645d",
                                "sense_id": "9db95fc1-c1c8-350b-af43-ce2e876bf131",
                                "text": "Les nègres et panis des deux sexes resteront en leur qualité d'esclaves en la possession des Français et Canadiens, à qui ils appartiennent: il leur sera libre de les garder à leur service dans la colonie ou de les vendre ; ils pourront aussi continuer à les faire élever dans la religion romaine."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b544d62d-438b-3e16-90cc-5f9d92f28c15",
                "word": "panis",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f3222f20-fa54-4d72-b164-c17f15cf2d5a",
                        "entry_id": "b544d62d-438b-3e16-90cc-5f9d92f28c15",
                        "tags": [],
