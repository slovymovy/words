                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окружа́ть",
                                "target_lang_sense_clarification": "находиться вокруг кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "обступа́ть",
                                "target_lang_sense_clarification": "встать вокруг кого-либо плотной группой"
                            }
