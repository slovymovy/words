                        "glosses": [
                            "positiv geladenes Lepton (ein Elementarteilchen); das Antiteilchen des Elektrons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa394cb0-8043-49cf-b2cd-3cf9adb76782",
                                "sense_id": "3c4d9072-4f12-3daa-909d-086d73453ed7",
