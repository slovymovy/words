                    },
                    {
                        "sense_id": "04fdec58-80e9-3a9b-a507-77fdf3e11589",
                        "entry_id": "d30dd87b-1ae9-31dc-b9f0-1c563d756638",
                        "glosses": [
                            "Any actuator disk whose working fluid is air."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4619ac-82f4-42a4-9ee1-ea9f3d52105c",
                                "sense_id": "04fdec58-80e9-3a9b-a507-77fdf3e11589",
                                "text": "The [wind] tunnel will be housed in a separate building close to the Railway Research Laboratory. It will be operated by an airscrew driven by a 50 h.p. motor which will draw air through at varying speeds up to 100 m.p.h."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a6c5753-e44a-4fc5-b475-2decd1e8812a",
                        "source_entry_id": "d30dd87b-1ae9-31dc-b9f0-1c563d756638",
                        "source_sense_description": "propeller of an aircraft",
                        "target_lang_word": "Luftschraube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftschraube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                                        "entry_id": "f6ed001e-ed5b-37e5-bdc6-014d1983eb77",
                                        "glosses": [
                                            "Propeller, der bei einem Flugzeug für den Vortrieb sorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b089c4e-c58a-4619-86fa-2cb44090c3d2",
                                                "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                                                "text": "„Außerdem zählt eine Propellerbremse zur Ausstattung, welche die Trockenmasse um rund 22 Kilogramm erhöht. Sie verhindert das Drehen der Luftschraube im Ruhezustand.“"
                                            },
                                            {
                                                "example_id": "0796e0d5-0237-4b3f-a1a9-79546a14130f",
                                                "sense_id": "d2bdac85-8117-37a1-9903-ee6a091c4b6a",
                                                "text": "„Mit ihren beiden je 5,5 Meter Durchmesser betragenden Luftschrauben (den größten der Welt) erreicht die \"Transall\" beim Ausfall eines Triebwerks bim Start nur eine Steigleistung von 30 Metern in der Minute, während die viermotorige \"Hercules\" unter denselben Bedingungen 195 Meter in der Minute steigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "245398bf-9f2a-4431-8d80-828f5b9d6f58",
                        "source_entry_id": "d30dd87b-1ae9-31dc-b9f0-1c563d756638",
                        "source_sense_description": "propeller of an aircraft",
                        "target_lang_word": "Flugzeugpropeller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugzeugpropeller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                                        "entry_id": "adec22b8-4357-3b67-bd1d-4872599d8cce",
                                        "glosses": [
                                            "Propeller, der bei einem Flugzeug für den Vortrieb sorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8f4ec16-c0e7-469c-87d6-1d5a7240a64f",
                                                "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                                                "text": "„Wie Boomerangs schleudert der Flugzeugpropeller seine Rotorblätter in die Tiefe - so scheint es zumindest auf der Videoaufnahme.“"
                                            },
                                            {
                                                "example_id": "f3c4f8ca-b8f9-47c7-9cb4-5c835389e139",
                                                "sense_id": "d5a14ad0-03ee-33d4-b794-0619b0aa8d59",
                                                "text": "„Die Erkenntnisse können helfen, nicht nur künftige Flugzeugpropeller zu verbessern, sondern auch Hubschrauberrotoren und Windkraftanlagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
