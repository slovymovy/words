                                "target_senses": [
                                    {
                                        "sense_id": "37ae5251-c040-3a4d-af81-80d7f7934628",
                                        "entry_id": "9f9cf687-5fce-34b4-ae4f-480cea565973",
                                        "glosses": [
                                            "Commune, ville de la région flamande de Belgique et chef-lieu de la province d'Anvers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "418ad7b7-57dc-4085-9882-98108d990f19",
                                                "sense_id": "37ae5251-c040-3a4d-af81-80d7f7934628",
                                                "text": "Il était le gendre de l’imprimeur Plantin qu’il remplaça à Anvers avant de diriger, à partir de 1585, une imprimerie à Leyde."
                                            },
                                            {
                                                "example_id": "4df9e763-b5ab-4472-93c0-5b947fe65a5d",
                                                "sense_id": "37ae5251-c040-3a4d-af81-80d7f7934628",
                                                "text": "Cette religieuse naît, le 26 mai 1605, à Anvers, pendant les guerres qui désolent la Flandre, au moment même où le Prince Maurice de Nassau investit la ville."
                                            },
                                            {
                                                "example_id": "6f8c3c12-3146-453a-b661-96dfdab03f12",
                                                "sense_id": "37ae5251-c040-3a4d-af81-80d7f7934628",
                                                "text": "Jacques Monceau de Tournai avait étudié à Genève en 1566 et y avait exercé le ministère ; appelé au pastorat d’Anvers, il vint visiter Lille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a6ef557-4f80-3029-b973-92eb24190d83",
                                        "entry_id": "9f9cf687-5fce-34b4-ae4f-480cea565973",
                                        "glosses": [
                                            "Province belge néerlandophone autour de cette ville, située en Flandre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
