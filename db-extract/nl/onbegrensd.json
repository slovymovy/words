                "senses": [
                    {
                        "sense_id": "31ffadfe-eb48-32e8-b69a-70984ab57149",
                        "entry_id": "0ca2f1f5-3a25-3c41-9214-3807557fb7ac",
                        "glosses": [
                            "zonder grenzen, zonder einde, zonder beperkingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58f63510-7060-49e0-8911-e2d137c12c7d",
                                "sense_id": "31ffadfe-eb48-32e8-b69a-70984ab57149",
                                "text": "Bruna’s werk bestaat uit een opvallend beeld dat in een lege vlakte drijft. „Juist door het traditionele perspectief te laten vallen, was ik opeens in staat alles te doen wat ik wilde”, zei hij. „Als ik in een tekening geen ruimte hoefde te creëren, kon ik alles, was ik onbegrensd.” Ukiyo-e prenten bestaan ook vaak uit een enkele dominante vorm zonder perspectief omringd door veel negatieve ruimte voor evenwicht."
                            },
                            {
                                "example_id": "a786a429-f7b5-48de-bcdd-28c582fcab80",
                                "sense_id": "31ffadfe-eb48-32e8-b69a-70984ab57149",
                                "text": "Decennialang riep Afrika in het Westen vooral associaties op met armoede en oorlog, maar sinds een paar jaar publiceren consultants als McKinsey het ene na het andere rapport over de onbegrensde mogelijkheden van het continent. Snelle bevolkingstoename, opkomst van de middenklasse en indrukwekkende groeicijfers beloven gouden tijden, zeker aan bedrijven die er de weg kennen, zoals Vlisco."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c965551c-ef53-46cf-b7bd-cf525ab4e5e2",
                        "source_entry_id": "0ca2f1f5-3a25-3c41-9214-3807557fb7ac",
                        "source_sense_id": "31ffadfe-eb48-32e8-b69a-70984ab57149",
                        "source_sense_description": "zonder grenzen, zonder einde, zonder beperkingen",
                        "target_lang_word": "infinite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Indefinably large, countlessly great; immense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631c9765-cfdd-408f-8ad1-08a75143ad55",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "The number is so infinite, that verily it would be an easier matter for me to reckon up those that have feared the same."
                                            },
                                            {
                                                "example_id": "ecf376fb-0bc6-4e16-baef-e65954eea58d",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "Whatever is finite, as finite, will admit of no comparative relation with infinity; for whatever is less than infinite is still infinitely distant from infinity; and lower than infinite distance the lowest or least cannot sink."
                                            },
                                            {
                                                "example_id": "d75abdcd-8101-44cf-a528-31a10ca2275e",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "infinite riches in a little room"
                                            },
                                            {
                                                "example_id": "f5799593-fb0c-49d0-84fc-31450c22b767",
                                                "sense_id": "f9ce0f00-5c30-3db2-99d4-8c32a5bb2152",
                                                "text": "which infinite calamity shall cause to human life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9589ef1c-3d82-3713-b686-1450987cd5d4",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Boundless, endless, without end or limits; innumerable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f306ccec-93e6-4dfc-a1fc-efd32c71cdaa",
                                                "sense_id": "9589ef1c-3d82-3713-b686-1450987cd5d4",
                                                "text": "Great is our Lord, and of great power; his understanding is infinite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2228defa-528c-35fd-bb59-c4f648ca97d8",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Infinitely many."
                                        ],
                                        "tags": [
                                            "with plural noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec3a044d-d73a-4e69-9596-78c6a59c72b4",
                                                "sense_id": "2228defa-528c-35fd-bb59-c4f648ca97d8",
                                                "text": "Huxley's theory says that if you provide infinite monkeys with infinite typewriters, some monkey somewhere will eventually create a masterpiece – a play by Shakespeare, a Platonic dialogue, or an economic treatise by Adam Smith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d436a436-fd8e-3ff4-a7a6-90c013516506",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Greater than any positive quantity or magnitude; limitless."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ba1b5e8-388e-399c-b01e-af0f3c7a658c",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Having infinitely many elements."
                                        ],
                                        "tags": [
                                            "of a set"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296a91bd-6667-45c3-a912-29916d03b350",
                                                "sense_id": "6ba1b5e8-388e-399c-b01e-af0f3c7a658c",
                                                "text": "For any infinite set, there is a 1-1 correspondence between it and at least one of its proper subsets. For example, there is a 1-1 correspondence between the set of natural numbers and the set of squares of natural numbers, which is a proper subset of the set of natural numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "108a4be3-85e9-38e6-9954-4aa94272c210",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Not limited by person or number."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58a54ab3-6e2b-3eac-ad61-d2fdd36e85c3",
                                        "entry_id": "44542a37-2e8d-362e-9369-36493e706ded",
                                        "glosses": [
                                            "Capable of endless repetition; said of certain forms of the canon, also called perpetual fugues, constructed so that their ends lead to their beginnings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a3869a4-122d-3d73-ae9e-c5b558a7f543",
                                        "entry_id": "790e323a-01ef-32dc-a97a-c39d4da68b24",
                                        "glosses": [
                                            "Infinitely many."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "infinite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                        "entry_id": "46b65a2c-66e7-386b-942c-d6391de5d304",
                                        "glosses": [
                                            "Something that is infinite in nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f64a78-56cf-4c5b-a471-8f6d48d3f0af",
                                                "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                                "text": "Sooner Earth / Might go round Heaven, and the strait girth of Time / Inswathe the fulness of Eternity, / Than language grasp the infinite of Love."
                                            },
                                            {
                                                "example_id": "ef05bb74-53eb-4a94-af83-559a687b0bd6",
                                                "sense_id": "cd65d847-7ab1-326d-9612-ea4b14f203c9",
                                                "text": "Cautiously, Hobbes avoided asserting the equality of these infinites, and explicitly characterized the relation between them as non-inequality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ff5e5b-902d-3f30-95df-ddb828e68a58",
                                        "entry_id": "46b65a2c-66e7-386b-942c-d6391de5d304",
                                        "glosses": [
                                            "A combo that can be used repeatedly without interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "445303a1-3336-4ec0-b758-25d7c5fba8e9",
                                                "sense_id": "d1ff5e5b-902d-3f30-95df-ddb828e68a58",
                                                "text": "[…] prevents overpowered combos and infinites […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
