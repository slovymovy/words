                    {
                        "translation_id": "36127889-1478-4490-b2d8-f7b473be9b87",
                        "source_entry_id": "59a8df98-b1d5-350e-9538-f5a7825a7b09",
                        "source_sense_id": "d11753ad-94f9-3edc-9181-eaa8fee08fcf",
                        "target_lang_word": "telecopier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "telecopier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d460cb68-f663-36c0-aead-875579fd260d",
                                        "entry_id": "c9b6cb3f-f2d0-3fc1-bb7f-fa71edb121f2",
                                        "glosses": [
                                            "Synonym of fax machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d62973f-7e3a-4ea4-9ecc-c50a4b57127c",
                                                "sense_id": "d460cb68-f663-36c0-aead-875579fd260d",
                                                "text": "Sorte and his team had moved to the offices of their lawyers, Davis Polk, because they had a bank of six telecopiers."
                                            },
                                            {
                                                "example_id": "12a551b6-6669-4958-bfee-966bd877dd7a",
                                                "sense_id": "d460cb68-f663-36c0-aead-875579fd260d",
                                                "text": "From a computer perspective, however, fax operates as a teleprinter rather than a telecopier, a printer that operates by remote control miles away from your computer."
                                            },
                                            {
                                                "example_id": "fcb4feb2-bc42-44b4-8171-aeab2e19d733",
                                                "sense_id": "d460cb68-f663-36c0-aead-875579fd260d",
                                                "text": "Although fax is not an acronym, it is often written as \"FAX\". The device is also known as a telecopier in certain industries."
                                            }
                                        ]
                                    }
                                ]
                            }
