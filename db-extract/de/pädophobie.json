                                "target_senses": [
                                    {
                                        "sense_id": "2dafeebb-9db3-3979-a924-7ee444aba82f",
                                        "entry_id": "ffa0478c-3482-38ac-91c2-0126cbc4fd8f",
                                        "glosses": [
                                            "Aversion, peur exagérée des enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30b7ad0e-7173-41c3-820c-82cb93334d12",
                                                "sense_id": "2dafeebb-9db3-3979-a924-7ee444aba82f",
                                                "text": "Ce qu’on appelle la pédophilie est en réalité une pédophobie, une fascination doublée de peur et d’agressivité."
                                            }
                                        ]
