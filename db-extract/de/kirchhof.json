                        "form": "den Kirchhof"
                    },
                    {
                        "form_id": "5314dde0-c64d-4466-9b72-26343481fb1c",
                        "entry_id": "2ff7f00f-705f-3cea-b92a-8ec579dafb80",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kirchhöfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "33c284fd-aba4-3ae5-bed2-54e3c5249e05",
                        "entry_id": "2ff7f00f-705f-3cea-b92a-8ec579dafb80",
                        "glosses": [
                            "Hof, Innenhof an, in oder bei einer Kirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a1bdd9-32f0-469d-b3f8-97548929b3b0",
                                "sense_id": "33c284fd-aba4-3ae5-bed2-54e3c5249e05",
                                "text": "Diesen Kirchhof habe ich kartografiert."
                            },
                            {
                                "example_id": "51c748fd-5ef2-4519-82cd-61c2dda3dec2",
                                "sense_id": "33c284fd-aba4-3ae5-bed2-54e3c5249e05",
                                "text": "„Dieser Ecke schräg gegenüber, unmittelbar hinter dem Pfarrhause, steigt der Kirchhof lehnan, auf ihm, so ziemlich in seiner Mitte, die frühmittelalterliche Feldsteinkirche mit einem aus dem vorigen Jahrhundert stammenden Dachreiter und einem zur Seite des alten Rundbogenportals angebrachten Holzarm, dran eine Glocke hängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                        "entry_id": "2ff7f00f-705f-3cea-b92a-8ec579dafb80",
                        "glosses": [
                            "Friedhof, der direkt an einer Kirche liegt"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "4cfe74e1-481e-468d-961d-4a9997f10e07",
                                "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                                "text": "„Wir laufen durch ein Tor über den Kirchhof auf ein Denkmal zu.“"
                            },
                            {
                                "example_id": "514c0aa9-44f3-489e-8cfc-5b9879cc5ede",
                                "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                                "text": "Du willst doch noch nicht auf den Kirchhof kommen?"
                            },
                            {
                                "example_id": "e4be9d56-36c9-4b3b-8f53-b70159b31cf1",
                                "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                                "text": "„Im 18. Jahrhundert begann man in Europa zu begreifen, daß es zwischen der miserablen Hygiene der Innenstädte und der in ihnen befindlichen Kirchhöfe Zusammenhänge gab.“"
                            },
                            {
                                "example_id": "f3f74b0e-e499-4f10-a1ef-ce7b2c1d8492",
                                "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                                "text": "„Einige Männer stellten sich ihnen auf dem Kirchhof in den Weg.“"
                            },
                            {
                                "example_id": "2a4534b6-7e1b-4ebd-b84c-f04fad030e23",
                                "sense_id": "971a65b9-fee2-3798-80a6-1533c95e3929",
                                "text": "„Victoire bückte sich, um hastig davon zu pflücken, und als Schach und Frau von Carayon im nächsten Augenblick den eigentlichen Hauptweg des Kirchhofes heraufkamen, ging ihnen Victoire entgegen und gab der Mutter die Veilchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25f1a38b-8d18-41a4-8a51-daee1abc8e43",
                        "source_entry_id": "2ff7f00f-705f-3cea-b92a-8ec579dafb80",
                        "source_sense_id": "33c284fd-aba4-3ae5-bed2-54e3c5249e05",
                        "source_sense_description": "Hof, Innenhof an, in oder bei einer Kirche",
                        "target_lang_word": "churchyard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "churchyard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "39e3e5d5-5207-32bb-b82b-d97413eb794a",
                                        "entry_id": "55a57b81-9f39-348d-93b3-0a0d677ebd61",
                                        "glosses": [
                                            "A patch of land adjoining a church, often used as a graveyard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca7398be-0f15-4894-bfcf-7fe05e1e77fd",
                                                "sense_id": "39e3e5d5-5207-32bb-b82b-d97413eb794a",
                                                "text": "They said nothing further, but tramped on in the growing darkness, past farm steadings, into the little village, through the silent churchyard where generations of the Pallisers lay, and up the beech avenue that led to Northrop Hall."
                                            },
                                            {
                                                "example_id": "78f71e18-187c-41cf-b236-86697b7adc5c",
                                                "sense_id": "39e3e5d5-5207-32bb-b82b-d97413eb794a",
                                                "text": "Ayot St Lawrence's most famous inhabitant, George Bernard Shaw, moved into the New Rectory in 1906 because, it is said, of a gravestone epitaph in the churchyard. This recorded the death of a woman who lived to be 70 with the comment 'Her time was short'. Shaw thought that a place that considered a life of 70 years short was the right place for him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
