                "senses": [
                    {
                        "sense_id": "83c6a89a-90bc-3678-9a82-2d6ff4d25e26",
                        "entry_id": "425c9945-42d5-32d8-9a68-71b077da1b6e",
                        "glosses": [
                            "Sediment, das aus den Überresten von Lebewesen entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7ef4295-7e4f-49f2-9738-40a8f0f5e3b9",
                                "sense_id": "83c6a89a-90bc-3678-9a82-2d6ff4d25e26",
                                "text": "„Neben einer Untergliederung nach pflanzlicher (phytogen) oder tierischer Herkunft (zoogen), werden biogene Sedimente auch als Biolithe bezeichnet und in brennbar (Kaustobiolithe) und nicht brennbar (Akaustobiolithe) eingeteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb867506-34eb-49bc-a1d5-acd08e2b0490",
                        "source_entry_id": "425c9945-42d5-32d8-9a68-71b077da1b6e",
                        "source_sense_id": "83c6a89a-90bc-3678-9a82-2d6ff4d25e26",
                        "source_sense_description": "Geologie: Sediment, das aus den Überresten von Lebewesen entstanden ist",
                        "target_lang_word": "biolith",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biolith",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c6537de-f119-373f-a07f-622ed567e3bf",
                                        "entry_id": "ae30d12d-5441-3ad3-90c8-17d2928a769e",
                                        "glosses": [
                                            "A rock or other geological feature formed by living organisms."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4d1e9dc-f103-4ea1-a5f1-a0dab509b058",
                                                "sense_id": "7c6537de-f119-373f-a07f-622ed567e3bf",
                                                "text": "By extraction of a combustible biolith with different solvents, Holde was able to obtain as much as 7.7 percent of fatty, wax-like or colophony-like bodies."
                                            },
                                            {
                                                "example_id": "b543822c-a73f-45d2-a7f9-cfbd95af66ce",
                                                "sense_id": "7c6537de-f119-373f-a07f-622ed567e3bf",
                                                "text": "The third theory which was advanced to explain the formation of phosphorites is the classical biolith hypothesis."
                                            },
                                            {
                                                "example_id": "4300d743-8a2c-484a-8420-cfa472989c05",
                                                "sense_id": "7c6537de-f119-373f-a07f-622ed567e3bf",
                                                "text": "Under conditions of strong oxidation, Cd is likely to form minerals (CdO, CdCO₃) and is also likely to be accumulated in phosphate and in biolith deposits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
