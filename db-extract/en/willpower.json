                "senses": [
                    {
                        "sense_id": "10ae6f03-e7fb-3abf-a7b3-5b97199ecdad",
                        "entry_id": "0d78590d-759a-386a-b69e-00a6244df46a",
                        "glosses": [
                            "The unwavering strength of will to carry out one's wishes."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bf205d0-782b-4e24-b305-3d3c2838891f",
                                "sense_id": "10ae6f03-e7fb-3abf-a7b3-5b97199ecdad",
                                "text": "\"A remarkable woman, gentlemen,\" said he, \"a very noteworthy woman. I had prided myself that my willpower was the most powerful in the country--I had never met any to match it--but I do not mind admitting that, for firmness and tenacity, this lady is my equal. ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17406ef7-5812-4c6a-91bc-9034634bd091",
