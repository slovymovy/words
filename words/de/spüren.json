                    "frequency": "High",
                    "semantic_group_id": "wahrnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Sommer <w>spürt</w> man die angenehme Wärme der Sonne auf der Haut."
                        },
                        {
                            "text": "Nach dem langen Lauf <w>spürte</w> er jeden Muskel in seinen Beinen."
                        }
                    ],
                    "synonyms": [
