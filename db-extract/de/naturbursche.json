                "senses": [
                    {
                        "sense_id": "9b3c9708-c037-31b6-8819-2661e3546c4a",
                        "entry_id": "6aaa0b4d-b22e-3bc3-835d-cf04b1e8f7b0",
                        "glosses": [
                            "junger Mann, dessen Lebensweise sehr naturnah ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86eef7dd-3a02-44f6-a117-72e390b5c0f4",
                                "sense_id": "9b3c9708-c037-31b6-8819-2661e3546c4a",
                                "text": "„Nur eine Minderheit der Siedler lebte als Farmer auf dem Land, doch waren sie tonangebend, da sie sich als Pioniere, als eine Gruppe besonders männlicher Naturburschen verstanden - ein Selbstbild, das sie vor allem in der Zeit nach dem Zweiten Weltkrieg der Dekadenz Europas entgegensetzten.“"
                            },
                            {
                                "example_id": "ddde379a-7ca6-4768-af3c-851d0b9a8605",
                                "sense_id": "9b3c9708-c037-31b6-8819-2661e3546c4a",
                                "text": "„Geneigter Twitterer, mein Vater, ganz der Naturbursche, delektiert uns mit opulentem Grunzen.“"
                            },
                            {
                                "example_id": "c40eea7f-dc21-429b-ad28-283733d301a3",
                                "sense_id": "9b3c9708-c037-31b6-8819-2661e3546c4a",
                                "text": "„Als Stadtmensch schien Leyds neben dem Naturburschen Kruger hier fehl am Platz zu sein, trotz des inzwischen gewachsenen Bartes.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
