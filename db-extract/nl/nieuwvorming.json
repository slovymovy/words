                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef3a5d39-0890-4e16-8454-a46948cd13fd",
                                "sense_id": "3dde27cd-83cb-38eb-a31e-c3139dec53ab",
                                "text": "Ongeveer een derde van de gemunte woorden is inheems en twee derde is gevormd van oorspronkelijke leenwoorden (die alle inheems gevoeld worden, anders zouden ze niet gebruikt worden in een nieuwvorming)."
                            }
                        ]
                    },
