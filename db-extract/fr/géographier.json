                ],
                "senses": [
                    {
                        "sense_id": "1991b6b2-bab9-33f0-a8aa-34bc599052cd",
                        "entry_id": "6afcb57b-d170-306f-8eea-e150d0ccd03d",
                        "glosses": [
                            "Décrire du point de vue géographique."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5553d8a8-6ce0-475b-a4c5-cdb3843162e4",
                                "sense_id": "1991b6b2-bab9-33f0-a8aa-34bc599052cd",
                                "text": "Qui veut géographier doit concevoir et exposer l'enchaînement des phénomènes inorganiques, biologiques et humains dont le monde est le théâtre perpétuellement changeant."
                            },
                            {
                                "example_id": "a9ef9fb0-3554-49b3-911d-f962bde19404",
                                "sense_id": "1991b6b2-bab9-33f0-a8aa-34bc599052cd",
                                "text": "Pour le premier, il faut \"géographier\" la modernité, pour le second, il faut \"géographier\" malgré elle, et au-delà d'elle."
                            },
                            {
                                "example_id": "1dbee690-6ae3-4f4b-a44e-47446e9ce43d",
                                "sense_id": "1991b6b2-bab9-33f0-a8aa-34bc599052cd",
                                "text": "Si la géographie est bien enseignée, elle livre aussi l'esprit géographique c'est-à-dire qu'elle rend l'étudiant apte à « géographier » par lui-même."
                            }
                        ]
                    }
                ],
