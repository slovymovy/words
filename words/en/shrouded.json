{
    "word_family": [
        "shroud",
        "unshroud"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "782926d3-b8c3-3ff1-bdba-630e62deebae",
                    "sense_definition": "Concealed, covered, or hidden from sight, as if by a veil or cloth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "covered_hidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain peak was <w>shrouded</w> in thick clouds throughout the early morning.",
                            "target_lang_translations": {
                                "it": "La vetta della montagna è rimasta <w>avvolta</w> da fitte nuvole per tutta la prima parte della mattinata."
                            }
                        },
                        {
                            "text": "The details of the government project remained <w>shrouded</w> in secrecy for decades.",
                            "target_lang_translations": {
                                "it": "I dettagli del progetto governativo rimasero <w>avvolti</w> nel segreto per decenni."
                            }
                        }
                    ],
                    "synonyms": [
                        "cloaked",
                        "veiled",
                        "hidden",
                        "concealed"
                    ],
                    "antonyms": [
                        "exposed",
                        "revealed",
                        "uncovered"
                    ],
                    "common_phrases": [
                        "shrouded in secrecy",
                        "shrouded in mist",
                        "shrouded in mystery",
                        "shrouded in fog"
                    ],
                    "target_lang_definitions": {
                        "it": "Nascosto, coperto o sottratto alla vista, come da un velo o un drappo."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "avvolto",
                                "target_lang_sense_clarification": "circondato o coperto da nebbia, mistero o segreto"
                            },
                            {
                                "target_lang_word": "velato",
                                "target_lang_sense_clarification": "coperto da un velo o reso poco visibile"
                            },
                            {
                                "target_lang_word": "ammantato",
                                "target_lang_sense_clarification": "coperto come da un manto, spesso in senso figurato o letterario"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "233ce350-0f33-33d5-bcc5-85611d5e484d",
                    "sense_definition": "Wearing, covered with, or wrapped in a burial shroud.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "covered_hidden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient tomb contained a <w>shrouded</w> body preserved carefully by priests.",
                            "target_lang_translations": {
                                "it": "L'antica tomba conteneva un corpo <w>avvolto in un sudario</w>, conservato con cura dai sacerdoti."
                            }
                        },
                        {
                            "text": "Frightened villagers claimed to see a <w>shrouded</w> figure roaming the graveyard at midnight.",
                            "target_lang_translations": {
                                "it": "Gli abitanti del villaggio, spaventati, affermavano di vedere una figura <w>ammantata</w> aggirarsi nel cimitero a mezzanotte."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shrouded figure",
                        "shrouded corpse"
                    ],
                    "target_lang_definitions": {
                        "it": "Coperto, avvolto o vestito con un sudario funebre."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "avvolto in un sudario",
                                "target_lang_sense_clarification": "riferito a cadavere o figura funebre"
                            },
                            {
                                "target_lang_word": "insudariato",
                                "target_lang_sense_clarification": "letterario o raro, coperto da sudario"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "44145b8d-3e00-35fa-b8d8-be18b53680fc",
                    "sense_definition": "Simple past and past participle of <w>shroud</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A dense autumn fog quickly <w>shrouded</w> the entire valley before nightfall.",
                            "target_lang_translations": {
                                "it": "Una fitta nebbia autunnale <w>avvolse</w> rapidamente l'intera valle prima che calasse la notte."
                            }
                        },
                        {
                            "text": "The company has <w>shrouded</w> its financial troubles behind complex accounting methods.",
                            "target_lang_translations": {
                                "it": "L'azienda ha <w>celato</w> i suoi problemi finanziari dietro a complessi metodi contabili."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Passato e participio passato di shroud (avvolgere, celare, occultare)."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "avvolto",
                                "target_lang_sense_clarification": "participio passato di avvolgere"
                            },
                            {
                                "target_lang_word": "avvolse",
                                "target_lang_sense_clarification": "passato remoto di avvolgere"
                            },
                            {
                                "target_lang_word": "celato",
                                "target_lang_sense_clarification": "participio passato di celare o nascondere"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}