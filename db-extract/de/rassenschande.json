                        "entry_id": "314d2602-11a2-31e3-b8ac-aebddc9787e1",
                        "glosses": [
                            "sexuelle Beziehung zwischen einem Juden und einem Arier"
                        ],
                        "tags": [
                            "nationalsozialistischer Sprachgebrauch im Deutschen Reich"
                        ],
                        "examples": [
                            {
                                "example_id": "c959fe05-73cd-41c0-af4d-a4b37c478d71",
                                "sense_id": "cce367c0-537a-3002-b42b-49ea5ca28780",
                                "text": "„Zwischen 1935 und 1943 wurden 2.211 Männer wegen „Rassenschande“ verurteilt.“"
                            },
                            {
                                "example_id": "fcc23f8d-a896-46f3-95b7-aadc29c401ac",
                                "sense_id": "cce367c0-537a-3002-b42b-49ea5ca28780",
                                "text": "„Über die Verhaftung, ihre Gründe, den Inhalt des Begriffes Rassenschande, die Gefährdung, die jede Beziehung zu einem nichtjüdischen Mädchen bedeutete, wurde nicht gesprochen.“"
                            }
                        ],
