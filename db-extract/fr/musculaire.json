                    {
                        "translation_id": "9b37e2dd-9eb0-4f5f-8dc8-b8b3b509adba",
                        "source_entry_id": "dd569fc6-aeb9-3cbf-be66-123068f70849",
                        "source_sense_description": "En rapport aux muscles",
                        "target_lang_word": "muscular",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "muscular",
