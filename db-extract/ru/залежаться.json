                "senses": [
                    {
                        "sense_id": "0da04da6-a9e2-3cbf-8420-b22dd47705b1",
                        "entry_id": "10b0a61a-1da9-384d-b7e1-7e28261fc111",
                        "glosses": [
                            "пролежать слишком долго, дольше чем следует"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bddff63-d189-4714-85ea-dfc3619ddba6",
                                "sense_id": "0da04da6-a9e2-3cbf-8420-b22dd47705b1",
                                "text": "Смотрите, чтобы дети не залежались в постелях."
                            },
                            {
                                "example_id": "641a4a56-27a8-48e3-86ba-71fd0b336753",
                                "sense_id": "0da04da6-a9e2-3cbf-8420-b22dd47705b1",
                                "text": "Некоторые больные залежались в больнице."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d4698cd-5688-39e6-b81a-92a877179ea0",
                        "entry_id": "10b0a61a-1da9-384d-b7e1-7e28261fc111",
                        "glosses": [
                            "быть долгое время без употребления"
                        ],
                        "tags": [],
                        "examples": [
                            {
