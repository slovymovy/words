                        "examples": [
                            {
                                "example_id": "5af19b84-7eaf-495b-bd85-5e55eda55dac",
                                "sense_id": "b02562d9-f900-31bb-8529-2ddf46848865",
                                "text": "Venetië doet mij aan als een oord in de gulden schemering van een droom gezien. De vreemde steenen pracht dezer stad, uit het water ontbloeid, de zonderlinge afwezigheid van elk onschoon en wanklinkend gerucht - geen auto's, geen rijtuigen, geen karrengerij - geven u den indruk of ge door de gangen en de zalen van een tooverpaleis doolt."
                            }
                        ]
                    }
