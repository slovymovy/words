                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55245c33-66c0-4e5b-a7d4-1b921c4ee7bb",
                                                "sense_id": "e41b5193-143a-31ac-8566-8b94f48f551e",
                                                "text": "Ich konnte nicht mit Alexis ins Kino, sondern musste stattdessen ihre Schwester mitnehmen, weil Alexis in der Zeit lieber mit zwei Nachbarinnen zusammen Bäume fällen wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
