                    {
                        "translation_id": "d2ab8c5e-9b07-4348-839c-aaf78cc66794",
                        "source_entry_id": "7132e7e3-dd0a-3c99-97e2-42cf2e7353e5",
                        "source_sense_id": "103993bd-c06a-3d6d-a4a6-34de92a6891d",
                        "target_lang_word": "огород",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "огород",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d37b5c4a-028a-3802-9dc7-cda029d403ce",
                                        "entry_id": "7dd06920-aae9-3f7c-8a26-23652683ca5e",
                                        "glosses": [
                                            "участок земли, занятый под гряды для выращивания овощей"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aec2b5e-4f3d-4835-b77f-3ef4cd188c10",
                                                "sense_id": "d37b5c4a-028a-3802-9dc7-cda029d403ce",
                                                "text": "В каждом дворе имелся свой огород, где росли репа, редиска, свёкла, морковка и другие разные овощи."
                                            },
                                            {
                                                "example_id": "31253569-6727-46c4-b8e1-84ecd7af1539",
                                                "sense_id": "d37b5c4a-028a-3802-9dc7-cda029d403ce",
                                                "text": "К Дарье Усвятской… кто через огород шастал? — Говорил же… Огурчиков набрать."
                                            },
                                            {
                                                "example_id": "e166699f-eeca-4b21-8f6d-8afcb449da94",
                                                "sense_id": "d37b5c4a-028a-3802-9dc7-cda029d403ce",
                                                "text": "— Тихо! Я щас огородами пройду, аха… — Куда ты огородами‑то без штанов?!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aef0557-227c-355f-9fe5-471860a4a1a2",
                                        "entry_id": "7dd06920-aae9-3f7c-8a26-23652683ca5e",
                                        "glosses": [
                                            "рег. ограда, забор"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f84af5da-d6fe-430d-b339-086d2f8d82e9",
                                                "sense_id": "9aef0557-227c-355f-9fe5-471860a4a1a2",
                                                "text": "Иван Африканович подождал, пока он слезал на лужок и привязывал к огороду кобылу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e51ef928-8440-3a3b-bf9e-89d6fbbf1678",
                                        "entry_id": "7dd06920-aae9-3f7c-8a26-23652683ca5e",
                                        "glosses": [
                                            "спорт. в футболе — поле очень низкого качества, на котором тяжело из-за этого играть"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4e215e8-ac59-438e-846c-8ec7adcb4f61",
                                                "sense_id": "e51ef928-8440-3a3b-bf9e-89d6fbbf1678",
                                                "text": "Посмотрите на поля в Томске, Нижнем Новгороде — отличные газоны. У нас же настоящий огород! Это просто безобразие…"
                                            }
                                        ]
                                    }
                                ]
                            },
