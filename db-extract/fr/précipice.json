        "fr-extract.jsonl": [
            {
                "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                "word": "précipice",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5c95ee57-bc0f-4c25-8683-1a94b52425ac",
                        "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "tags": [
                            "plural"
                        ],
                        "form": "précipices"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                        "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "glosses": [
                            "Abîme, gouffre, cavité très profonde et très escarpée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8facbb77-1a36-4786-b3b7-32bb1f5a263a",
                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                "text": "Nous commençâmes à côtoyer la pente rapide du col, ayant à notre droite un précipice de cinq ou six cents pieds de profondeur, et au-delà de ce précipice une montagne à pic."
                            },
                            {
                                "example_id": "c6abcdef-9c0a-485c-a404-9f25e4cebeac",
                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                "text": "Le capitaine et les quatre hommes […], avaient descendu la pente des rochers, au risque de se briser mille fois en tombant dans les précipices qui s’ouvraient sous leurs pieds."
                            },
                            {
                                "example_id": "d5a45215-3db5-41a2-9c93-d607be025780",
                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                "text": "Le Drac ! s’était écrié l’abbé Gévresin, montrant, au fond du précipice, un serpent liquide qui rampait et se tordait, colossal, entre des rocs, ainsi qu’entre les crocs d’un gouffre."
                            },
                            {
                                "example_id": "c453d353-bcee-4045-9503-5cb38ab79b54",
                                "sense_id": "ce0a98fe-1153-3ca8-9a0f-754a47cee94e",
                                "text": "La route est très belle maintenant ; mais toujours pas de parapet, et nos chevaux s’entêtent dans leur manie de trotter au ras du bord. — Il y a près de nous des précipices dont l’obscurité qui vient ne nous laisse déjà plus voir le fond."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                        "entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "glosses": [
                            "Grand malheur, disgrâce, catastrophe."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6eca3826-702f-476a-a4b5-ce82d5dd1262",
                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                "text": "Crise du système, crise bipolaire, crise nucléaire, c’est Cuba en 1962 qui plonge le monde dans l’angoisse nucléaire, au bord du précipice de la mort planétaire."
                            },
                            {
                                "example_id": "4edd6fd5-9262-4478-a733-65c245c7c8b1",
                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                "text": "Le développement de la société occidentale était le triomphe de l’indépendance de l’homme et de sa puissance. Et voilà que soudain, au XXᵉ siècle, on a vu — avec quelle netteté ! — que cette société était fragile et bâtie sur des précipices."
                            },
                            {
                                "example_id": "a852ac31-4386-41ac-ac91-1be6af21da09",
                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                "text": "Une vaine ambition l’a poussé jusqu’au bord du précipice."
                            },
                            {
                                "example_id": "877b1542-9a24-41fc-ae63-6e4f6b61ac34",
                                "sense_id": "2dd7124e-4a0f-3bd6-b932-7605176169b7",
                                "text": "Il marche sur le bord du précipice ; s’il ne change pas de conduite, il est perdu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ce1285b-3d5e-4e92-89d5-c39b9699e194",
                        "source_entry_id": "4271c93b-da5a-35f0-b35b-728c2f880c2f",
                        "target_lang_word": "Abgrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abgrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad119db-3f4d-36ac-a943-3b6c95b332ff",
                                        "entry_id": "19d57ae2-e31c-3e33-9abf-bb2bc4f68ca6",
                                        "glosses": [
                                            "schauerliche, gefährliche Tiefe"
                                        ],
                                        "tags": [
                                            "räumlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4529076b-358c-4f95-b20d-384cff4257b4",
                                                "sense_id": "3ad119db-3f4d-36ac-a943-3b6c95b332ff",
                                                "text": "Sie blickten in einen tiefen Abgrund, der sich rechts und links weit hinzog."
                                            },
                                            {
                                                "example_id": "88fb3704-6e59-45e4-beaa-9c3bde148ef0",
                                                "sense_id": "3ad119db-3f4d-36ac-a943-3b6c95b332ff",
                                                "text": "„Evoziert wird eine Situation des Höhenschwindels, die an Rousseaus Faszination für Wasserfälle und Abgründe erinnert.“"
                                            },
                                            {
                                                "example_id": "0315b155-58ec-4eba-8274-732d8db60fa0",
                                                "sense_id": "3ad119db-3f4d-36ac-a943-3b6c95b332ff",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f0aff68-1ba6-3dfa-a6e5-fb2df1b448f2",
                                        "entry_id": "19d57ae2-e31c-3e33-9abf-bb2bc4f68ca6",
                                        "glosses": [
                                            "unverständliche, gefährliche Tiefe, die trennt oder ins Unglück führt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ca7d9e5-e2a4-455c-a314-424bff64087e",
                                                "sense_id": "2f0aff68-1ba6-3dfa-a6e5-fb2df1b448f2",
                                                "text": "Da tun sich Abgründe auf!"
                                            },
                                            {
                                                "example_id": "b774d718-5bd9-4703-8184-e8a33479fce2",
                                                "sense_id": "2f0aff68-1ba6-3dfa-a6e5-fb2df1b448f2",
                                                "text": "Um meine Erinnerungen zu dämpfen, um die Schmerzen zu dämpfen, vertiefte ich mich in meine Arbeit, machte Überstunden, machte Abendkurse, alles um nicht nachdenken zu müssen. Das brachte mich an den Rand des Abgrundes."
                                            },
                                            {
                                                "example_id": "62948a65-3cf6-4a34-83e6-023cfdbc6d32",
                                                "sense_id": "2f0aff68-1ba6-3dfa-a6e5-fb2df1b448f2",
                                                "text": "„Neben dem rechtsextremistischen Gewaltpotenzial gehörten die Abgründe an Häme und Hass inmitten unserer Gesellschaft gegenüber denen, die in unserem Land Verantwortung übernähmen, zu den beklemmenden Erfahrungen der jüngsten Tage, sagte Schäuble.“"
                                            },
                                            {
                                                "example_id": "63d05cae-38bd-4f1a-9487-e98a106cbd52",
                                                "sense_id": "2f0aff68-1ba6-3dfa-a6e5-fb2df1b448f2",
                                                "text": "„Er hat in Abgründe geleuchtet, die vergessen schienen, und Zusammenhänge aufgewiesen, die sich noch keiner einzugestehen gewagt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
