                "senses": [
                    {
                        "sense_id": "fa1f342d-7d27-3a1a-9d69-eda207334bbb",
                        "entry_id": "35caa8b0-f316-3cdc-a64a-dc6217571a5c",
                        "glosses": [
                            "eine Art (Typ), die so in der Natur vorkommt; Urform bevor Mutationen/Züchtungen zu Veränderungen führen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12257f03-be6b-4efe-b2e0-918761c6c725",
                                "sense_id": "fa1f342d-7d27-3a1a-9d69-eda207334bbb",
                                "text": "Für den Wildtyp typisch sind die kleineren Beeren."
                            },
                            {
                                "example_id": "01c468d7-7416-4771-856b-ba2c1fc76dd0",
                                "sense_id": "fa1f342d-7d27-3a1a-9d69-eda207334bbb",
                                "text": "Im Laufe der Selektion wurde der Wildtyp von der Mutante verdrängt."
                            },
                            {
                                "example_id": "1f2afc48-9cf8-41f9-a905-dd8c1a04b731",
                                "sense_id": "fa1f342d-7d27-3a1a-9d69-eda207334bbb",
                                "text": "„Die vor einiger Zeit in Großbritannien (\"B.1.1.7\"), Südafrika (\"B.1.351\") oder zuletzt in Brasilien und Japan (\"P.1\") aufgetauchten Varianten weisen jeweils mehrere Mutationen gemeinsam auf, durch die sie sich vom \"Wildtyp\" unterscheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
