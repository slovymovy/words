                "senses": [
                    {
                        "sense_id": "f2e2913e-5ee8-3703-9261-5bc886b4de90",
                        "entry_id": "dcd012e7-2a34-3ab3-8762-8b16a8aefed6",
                        "glosses": [
                            "Aufbau/Zusammensetzung einer Gesellschaft aus ihren sozialen Gruppen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bde44ac8-9429-4899-82c9-c61c6ff9a2ed",
                                "sense_id": "f2e2913e-5ee8-3703-9261-5bc886b4de90",
                                "text": "„Genau genommen sind wir der permanent tagende Integrationsgipfel der 16 Bundesländer, die mit ihren unterschiedlichen Sozialstrukturen, Lebensverhältnissen und regionalen Eigenarten hier aufschlagen, um die berühmte Berliner Luft zu schnuppern.“"
                            },
                            {
                                "example_id": "96d7eb91-c157-4701-80d1-35ebff4428ac",
                                "sense_id": "f2e2913e-5ee8-3703-9261-5bc886b4de90",
                                "text": "„Hochzeiten und Scheidungen gehen häufig mit sozio-ökonomischen Brüchen einher. Fertilitätsrückgang, zunehmende Scheidungen und nichteheliche Lebensgemeinschaften und ein höherer Anteil allein Erziehender sind Ausdruck einer Familiendynamik, die sich auch auf die Sozialstruktur niederschlägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
