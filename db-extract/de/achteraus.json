                        ],
                        "examples": [
                            {
                                "example_id": "342e7b4b-b985-4b44-9d76-16612109ff78",
                                "sense_id": "ad24759e-4120-34dd-b506-4b6eecabb91b",
                                "text": "Ein anderes Segelschiff kreuzte achteraus vorbei."
