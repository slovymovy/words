                    "frequency": "Middle",
                    "semantic_group_id": "châtiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cavalier refuse de <w>fouetter</w> son cheval pour le faire avancer plus vite."
                        },
                        {
                            "text": "Dans les récits anciens, on pouvait <w>fouetter</w> publiquement les prisonniers en guise de punition."
                        }
                    ],
                    "synonyms": [
                        "donner le fouet",
                        "flageller"
                    ],
                    "common_phrases": [
                        "fouetter un cheval"
                    ]
                },
                {
                    "sense_id": "95f78a1d-ab35-3795-8149-bb74e32823ba",
                    "sense_definition": "Frapper avec violence une surface ou le corps, en parlant du vent ou de la pluie.",
