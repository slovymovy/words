                    "frequency": "High",
                    "semantic_group_id": "thee_zetten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij deed een <w>theezakje</w> in haar mok en goot er heet water op.",
                            "target_lang_translations": {
                                "en": "She put a <w>teabag</w> in her mug and poured hot water over it."
                            }
                        },
                        {
                            "text": "Vergeet niet het <w>theezakje</w> weg te gooien als de thee sterk genoeg is.",
                            "target_lang_translations": {
                                "en": "Don't forget to throw away the <w>teabag</w> when the tea is strong enough."
                            }
                        }
                    ],
                    "common_phrases": [
