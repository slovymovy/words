                            },
                            {
                                "target_lang_word": "corpulento",
                                "target_lang_sense_clarification": "constitución robusta, tono formal"
                            },
                            {
                                "target_lang_word": "rollizo",
                                "target_lang_sense_clarification": "sobre todo niños y bebés"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胖",
                                "target_lang_sense_clarification": "口语，体型偏胖"
                            },
                            {
                                "target_lang_word": "富态",
                                "target_lang_sense_clarification": "体态圆润，多指中年人"
                            },
                            {
                                "target_lang_word": "丰满",
                                "target_lang_sense_clarification": "体态圆润，多指女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f154ed-14b0-3fd5-9d6d-5f0eeed8b629",
                    "sense_definition": "Obscur, embarrassé ou ambigu, où l'on donne plus à entendre qu'on n'en exprime nettement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ministre a répondu aux critiques par un discours particulièrement <w>enveloppé</w>.",
                            "target_lang_translations": {
                                "en": "The minister responded to the criticism with a particularly <w>veiled</w> speech.",
                                "ru": "Министр ответил на критику особенно <w>завуалированной</w> речью.",
                                "de": "Der Minister antwortete auf die Kritik mit einer besonders <w>verklausulierten</w> Rede.",
                                "es": "El ministro respondió a las críticas con un discurso especialmente <w>velado</w>.",
                                "zh": "部长用一番格外<w>含蓄</w>的讲话回应了批评。"
                            }
                        },
                        {
                            "text": "Il a formulé ses reproches d'une manière <w>enveloppée</w> afin de ne heurter personne.",
                            "target_lang_translations": {
                                "en": "He phrased his criticism in a <w>roundabout</w> way so as not to upset anyone.",
                                "ru": "Он высказал свои упрёки в <w>уклончивой</w> манере, чтобы никого не задеть.",
                                "de": "Er hat seine Vorwürfe auf <w>verklausulierte</w> Weise formuliert, um niemanden zu verärgern.",
                                "es": "Formuló sus reproches de manera <w>indirecta</w> para no ofender a nadie.",
                                "zh": "他用<w>委婉</w>的方式提出批评，以免得罪任何人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ambigu",
                        "détourné",
                        "obscur"
                    ],
                    "antonyms": [
                        "clair",
                        "direct",
                        "explicite"
                    ],
                    "common_phrases": [
                        "discours enveloppé",
                        "manière enveloppée"
                    ],
                    "target_lang_definitions": {
                        "en": "Vague, evasive or ambiguous, suggesting more than is clearly said.",
                        "ru": "Неясный, уклончивый или двусмысленный, когда многое подразумевается, но прямо не высказывается.",
                        "de": "Unklar, ausweichend oder mehrdeutig, sodass mehr angedeutet als deutlich gesagt wird.",
                        "es": "Poco claro o ambiguo, que sugiere más de lo que se dice con claridad.",
                        "zh": "形容说话或表达含蓄隐晦，模棱两可，不直截了当地说明。"
                    },
                    "translations": {
                        "en": [
