                "senses": [
                    {
                        "sense_id": "5e2b7b38-008c-32f4-85af-cc2fbbef80ab",
                        "entry_id": "e87debfe-3c6d-31d8-a3ae-ee545a1bb9b5",
                        "glosses": [
                            "aus Leder bestehender Einband"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ff1f61e-8f13-42a2-9bf5-bc605640b871",
                                "sense_id": "5e2b7b38-008c-32f4-85af-cc2fbbef80ab",
                                "text": "„Sobald ihr der Codex 1253 in die Hände gelegt worden war, strahlte die mit schlichtem Ledereinband über Buchenholz gebundene Handschrift eine ästhetische Anziehungskraft auf sie aus.“"
                            },
                            {
                                "example_id": "85b0fd03-c0ac-4417-8eff-51a5971d803a",
                                "sense_id": "5e2b7b38-008c-32f4-85af-cc2fbbef80ab",
                                "text": "„Zwei dicke Leinenfäden klebten jetzt am Ledereinband des anderen Buches fest.“"
                            },
                            {
                                "example_id": "b9cecd8b-c5e4-4372-b616-28cacbe32b59",
                                "sense_id": "5e2b7b38-008c-32f4-85af-cc2fbbef80ab",
                                "text": "„Sein Ledereinband musste ersetzt werden, bevor ich ihn an den Sammler weiterverkaufen konnte, der ihn bei mir bestellt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
