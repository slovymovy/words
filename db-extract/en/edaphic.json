                                    {
                                        "sense_id": "5ac88561-bc7c-3b49-902c-58d433b05789",
                                        "entry_id": "4a1530f9-400f-315b-9c90-43c2e24d6368",
                                        "glosses": [
                                            "den Boden betreffend, auf den Boden und seine ökologischen Funktionen bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb0e8099-9313-462b-b802-cc063030e767",
                                                "sense_id": "5ac88561-bc7c-3b49-902c-58d433b05789",
                                                "text": "Die edaphisch bedingte Trockenheit (Durchlässigkeit des sandigen Untergrundes), Hangneigung, Exposition und Höhenlage bestimmten weiterhin die Wuchsbedingungen."
                                            },
                                            {
                                                "example_id": "7a052eaa-b533-43d2-a14d-ba9f94098162",
                                                "sense_id": "5ac88561-bc7c-3b49-902c-58d433b05789",
                                                "text": "Für Nabaos ist offensichtlich der Nutzungsgradient entscheidend, während für Gellap-Ost die edaphische Feuchte der Standorte ausschlaggebend ist."
                                            },
                                            {
                                                "example_id": "a3dcc622-a770-4e74-b55a-115055316346",
                                                "sense_id": "5ac88561-bc7c-3b49-902c-58d433b05789",
                                                "text": "Die isländischen Wüsten sind vorwiegend edaphisch und nicht so sehr klimatisch bedingt."
                                            }
