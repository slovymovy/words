                "senses": [
                    {
                        "sense_id": "cf8bda82-ac6b-3783-8efd-0e7623fd86bb",
                        "entry_id": "92ded707-415b-3ecd-ba38-84521cc3061a",
                        "glosses": [
                            "maar net voldoende, maar net op tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922789dd-41c5-4614-acea-a7d8d2003430",
                                "sense_id": "cf8bda82-ac6b-3783-8efd-0e7623fd86bb",
                                "text": "Zij behaalden deze keer een nipte zege, maar de zorgen voor het verdere verloop bleven."
                            },
                            {
                                "example_id": "28457730-e1a6-4ee1-87f5-3ec140c2dfbd",
                                "sense_id": "cf8bda82-ac6b-3783-8efd-0e7623fd86bb",
                                "text": "Sunak en Javid behoren beiden tot de Conservatieve Partij van Johnson. Binnen zijn eigen partij werd al langer gevraagd om het vertrek van de premier. Zo overleefde Johnson begin juni nipt een vertrouwensstemming, waarbij minder dan zes op de tien partijgenoten steun voor hem uitspraken."
                            }
                        ]
                    }
                ],
