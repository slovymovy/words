        "fr-extract.jsonl": [
            {
                "entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                "word": "yéti",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b4427cc9-a261-4737-b260-a0f7a8a6d1ea",
                        "entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "tags": [
                            "plural"
                        ],
                        "form": "yétis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                        "entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "glosses": [
                            "Animal mythologique censé vivre dans les montagnes du Tibet, conformé comme un primate velu au poil blanc, avec un visage ressemblant à celui de l’homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea10dc28-6459-4ae3-a634-ffd5b17edaaa",
                                "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                                "text": "Les cryptides les plus célèbres sont le monstre du loch Ness ou le yéti."
                            },
                            {
                                "example_id": "63680112-de56-4b2d-822c-053b4d5b2f33",
                                "sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                                "text": "Une analyse d’ADN de 30 échantillons de poils de plusieurs continents lève le voile sur le yéti. S’il existe bien un étrange animal, qui pourrait être un ours préhistorique, dans l’Himalaya, les autres créatures ne sont que des espèces connues."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81099c3c-6c4a-47af-a3fa-49540ab63eae",
                        "source_entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "source_sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                        "source_sense_description": "Animal mythologique",
                        "target_lang_word": "Yeti",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yeti",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                        "entry_id": "9591864e-71ce-36e9-9358-53f808199508",
                                        "glosses": [
                                            "ein legendenhafter, menschenähnlicher Großprimat, der in den Hochgebirgsregionen Asiens (Himalaya, Pamir) leben soll, bisher aber nur aus Fußspuren, Exkrementen und behaupteten Begegnungen erschlossen ist. Die Existenz des Yeti ist wissenschaftlich nicht nachgewiesen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1997ca0-20e5-4408-94c9-90bdabd2c9f8",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "Möglicherweise ist der Yeti nur eine Erfindung phantasiebegabter Menschen."
                                            },
                                            {
                                                "example_id": "e2f00738-3ba4-495e-89b4-f7ec093fcc33",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„In einer chinesischen Apotheke fand ein deutscher Paläontologe Zähne eines Riesenprimaten. Vielleicht waren frühe Menschen dem Giganten noch begegnet - und schufen die Legende vom Yeti.“"
                                            },
                                            {
                                                "example_id": "b517559f-096a-4c3f-ad70-5a7c6dfe98bc",
                                                "sense_id": "fb90338a-60b7-33f4-9b89-3b1d6244a95a",
                                                "text": "„… Was es hingegen mit dem Yeti auf sich hat, ob Gigantopithecus für ihn Modell stand, wird sich wohl nie klären lassen - auch wenn Einzelne unserer Zeitgenossen den Riesen in einsamen Gegenden des Himalayas gesehen haben wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68b6d100-4148-4351-a8de-b08d858b07aa",
                        "source_entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "source_sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                        "source_sense_description": "Animal mythologique",
                        "target_lang_word": "Schneemensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneemensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b0808a1-b515-38f4-ac70-4bb76335db22",
                                        "entry_id": "e5389665-36e0-3594-b666-ded8a70044c3",
                                        "glosses": [
                                            "zweibeiniges, behaartes Fabelwesen des Himalaya"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097cbcc5-4f34-4f93-b28e-9266fedbc4c8",
                                                "sense_id": "4b0808a1-b515-38f4-ac70-4bb76335db22",
                                                "text": "„So ist es mittlerweile fast egal, daß der Yeti kein Schneemensch ist, nicht einmal ein Affe, sondern ein ordinärer Bär.“"
                                            },
                                            {
                                                "example_id": "8b77a207-5060-4a20-80f5-6a0847c36ccf",
                                                "sense_id": "4b0808a1-b515-38f4-ac70-4bb76335db22",
                                                "text": "„Im letzten Jahr hatte die Gebietsverwaltung bereits die Nachricht verbreitet, im schwer zugänglichen Bergland von Gornaja Schorija sei ein anderthalb bis zwei Meter großer Schneemensch von Jägern gesichtet worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88e5e29e-a8e4-44dc-86a2-004a05b4b9f2",
                        "source_entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "source_sense_id": "d9687253-f4af-355c-a654-8245e3229010",
                        "source_sense_description": "Animal mythologique",
                        "target_lang_word": "yeti",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yeti",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                        "entry_id": "34e283c6-c49b-3b5a-a522-a4f20d078f81",
                                        "glosses": [
                                            "An unidentified humanoid animal said to live in the Himalayas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f53c57-8600-4b02-9e62-97b8b4ad4f50",
                                                "sense_id": "94528f24-3b34-313e-9fbd-b7d52ec841ce",
                                                "text": "There is no doubt that the Sherpas accept the fact that the Yeti really exists. But then they believe just as confidently that their gods live in comfort on the summit of Mount Everest. We found it quite impossible to divorce the Yeti from the supernatural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e96f7ce-25e7-4ee4-86c3-ba1dc0945246",
                        "source_entry_id": "a1cd067f-2b38-3238-aa27-5cb50d225bf4",
                        "source_sense_id": "d9687253-f4af-355c-a654-8245e3229010",
