                "senses": [
                    {
                        "sense_id": "d445151a-25e7-3c49-9a0e-a943c2401054",
                        "entry_id": "c0f165e6-27a5-31e7-9d2d-7812e1d6568c",
                        "glosses": [
                            "A musician who plays a bass instrument, especially the bass guitar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2212dab2-6925-4426-9336-346db9524e8c",
                                "sense_id": "d445151a-25e7-3c49-9a0e-a943c2401054",
                                "text": "And the cello concerto was strikingly different on Sunday: at Weill, the ensemble included two violinists and one violist, cellist, bassist and lutenist, but on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                            },
                            {
                                "example_id": "86412003-9926-4046-8b59-93108f54d8ba",
                                "sense_id": "d445151a-25e7-3c49-9a0e-a943c2401054",
                                "text": "By and large back then, bassists weren’t bandleaders; Mingus was an anomaly."
                            }
                        ]
                    }
                ],
