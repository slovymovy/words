                        "examples": [
                            {
                                "example_id": "6777f236-3443-400d-8b25-4e1b70bafafa",
                                "sense_id": "bb92e138-a954-326c-9ec0-80831c54a208",
                                "text": "Hij had een troebele blik in zijn ogen na het drinken van te veel alcohol."
                            },
                            {
                                "example_id": "c098a5bc-9136-4f42-ab3a-b9e94cbdb935",
                                "sense_id": "bb92e138-a954-326c-9ec0-80831c54a208",
                                "text": "In werkelijkheid kunnen ze alleen maar wadend in de troebele poel hun dood tegemoet zijn gelopen - een nabij ravijn is nergens te bekennen."
                            }
                        ]
