                "senses": [
                    {
                        "sense_id": "9d0dd17b-3bcd-3dd7-a06b-c74bb958bcb8",
                        "entry_id": "12b22269-ceba-30bd-8882-56429375cfe9",
                        "glosses": [
                            "A stag in its second year, before its horns have started branching."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adbf3742-b3e1-4e7b-8996-6a5bd95fda71",
                                "sense_id": "9d0dd17b-3bcd-3dd7-a06b-c74bb958bcb8",
                                "text": "Near-synonyms: knobber, knobbler, pricket, spitter"
                            },
                            {
                                "example_id": "16393c84-3ff9-44c6-9b84-d4c78e037365",
                                "sense_id": "9d0dd17b-3bcd-3dd7-a06b-c74bb958bcb8",
                                "text": "“Why, a stag is called a brocket until he is three years old, at four years he is a staggart; at five years a warrantable stag; and after five years he becomes a hart royal.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "0a15831c-5ece-394f-8ca2-603622dd3dee",
                        "entry_id": "12b22269-ceba-30bd-8882-56429375cfe9",
                        "glosses": [
                            "A brocket deer, a member of genus Mazama, of short-horned deer of the tropical Americas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef081993-d489-4f21-9a53-4f2878f5d3be",
                                "sense_id": "0a15831c-5ece-394f-8ca2-603622dd3dee",
                                "text": "Before fighting, brockets rear and jump in display; when fighting, they jump over each other, striking the opponent with the hooves of the forelegs or hind legs in passing."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c4f4d20-d518-4ee7-a898-1d22ad3c15f1",
                        "source_entry_id": "12b22269-ceba-30bd-8882-56429375cfe9",
                        "source_sense_description": "young stag with straight horns",
                        "target_lang_word": "daguet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daguet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4b070d7-15e0-3cd4-b7d5-fe9c82b6b9a5",
                                        "entry_id": "fbec42be-5ca0-35f2-b9b1-1591583069e9",
                                        "glosses": [
                                            "Jeune cerf ou jeune daim qui en est à sa première ramure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "154e2532-9a84-44cd-91bd-6fe0867ac9fc",
                                                "sense_id": "c4b070d7-15e0-3cd4-b7d5-fe9c82b6b9a5",
                                                "text": "Le veneur doit juger l'âge et le sexe ; il doit savoir distinguer et reconnaître précisément si le cerf qu'il a détourné avec son limier, est un daguet, un jeune cerf, un cerf de dix cors jeunement, un cerf de dix cors, ou un vieux cerf ; et les principaux indices qui peuvent donner cette connaissance, sont le pied et les fumées."
                                            },
                                            {
                                                "example_id": "a24261a3-1a17-43eb-8b97-fbde2f0a1ddc",
                                                "sense_id": "c4b070d7-15e0-3cd4-b7d5-fe9c82b6b9a5",
                                                "text": "Peut-être votre Majesté préfère-t-elle la chasse à courre ? Moi aussi, alors ! Daguet ou vieux dix-cors, ça m’est égal !"
                                            },
                                            {
                                                "example_id": "f61a4a08-c89d-4ba1-864c-182936c6ae06",
                                                "sense_id": "c4b070d7-15e0-3cd4-b7d5-fe9c82b6b9a5",
                                                "text": "La gracieuse maman s’appelait Daguette, parce que, entre deux ou trois ans, les jeunes chevreuils se nomment daguets, à cause de leurs cornes en forme de petites dagues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
