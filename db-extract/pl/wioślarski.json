                        "examples": [
                            {
                                "example_id": "ffdc43bb-040a-41c7-888b-f4b444c951fb",
                                "sense_id": "9d26c1a5-edad-3492-a2a6-a3ce2503f4f6",
                                "text": "Związek Sokolstwa Polskiego, tradycyjnie uprawiający gimnastykę zbiorową, zaczął także formować sekcje wioślarskie, kolarskie, jeździeckie"
