                                        "entry_id": "515e566c-1292-3101-be6e-3ffee3800577",
                                        "glosses": [
                                            "Pflanze, die zwischen 10 cm und 2 m hoch wächst und glocken- oder sternförmige meist violette oder blaue Blüten hat"
                                        ],
                                        "tags": [
                                            "Flora"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b5c844a-252f-45f8-a83a-641085ae8afc",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Es ist der letzte Februartag, die Sonne scheint, im Hof sind die ersten Glockenblumen aufgeblüht.“"
                                            },
                                            {
                                                "example_id": "9a6f60ed-4fbd-4a36-9c16-3e640835d259",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Glockenblumen sind beliebte Schnitt- und Rabattblumen.“"
                                            },
                                            {
                                                "example_id": "bfa98b19-d56a-475b-97b9-836f94fbc299",
                                                "sense_id": "e29a0307-eeb5-3294-bca4-68436c5f24c3",
                                                "text": "„Leicht erkennbar sind Glockenblumen an ihren glocken-, röhren- oder sternförmigen Blüten, die sich je nach Art und Sorte zwischen Juni und September öffnen.“"
                                            }
                                        ],
