        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "3bb18ea6-6e45-3533-ad3f-9ea4b59bdb91",
                "word": "USB",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                        "entry_id": "3bb18ea6-6e45-3533-ad3f-9ea4b59bdb91",
                        "glosses": [
                            "Initialism of Universal Serial Bus; a serial bus standard for connecting devices."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "364ac67e-a113-42fa-8a16-0b3b938e44cd",
                                "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                                "text": "New signage is being installed to enhance wayfinding and USB sockets are being added in the main concourse area and Platform 8's waiting area."
                            },
                            {
                                "example_id": "4c79cfdc-733e-428f-a748-db9701d4dc13",
                                "sense_id": "cfd425dd-bdda-349d-a309-c9886762ccc3",
                                "text": "USB-C isn’t just how many PC laptops are charged; it’s also how the Chromecast With Google TV draws power. It’s also the only USB port in any modern MacBook, and it’s used for charging and data transfer in many Samsung Galaxy phones (dating back to 2016’s infamous Galaxy Note 7)."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a40d09-e198-37da-a494-49697342e66b",
                        "entry_id": "3bb18ea6-6e45-3533-ad3f-9ea4b59bdb91",
                        "glosses": [
                            "Initialism of US Bancorp."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "8a4236c5-e44c-4f6c-9d27-3635287432f1",
                                "sense_id": "d2a40d09-e198-37da-a494-49697342e66b",
                                "text": "Squeri also said during a conference call with analysts Friday morning that AmEx is holding up well despite increased competition from technology companies like Square (SQ) and Venmo owner PayPal (PYPL) as well as traditional card issuers such as Capital One (COF) and US Bancorp (USB)."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
