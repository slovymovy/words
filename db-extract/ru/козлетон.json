                "senses": [
                    {
                        "sense_id": "376a75ed-b3d0-3c18-b7a4-a838e2e5bf76",
                        "entry_id": "4570e5ab-d23e-347a-83f9-fbf800a2398b",
                        "glosses": [
                            "разг. ирон. неприятный, фальшивый голос у певца"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7edc35d1-d048-4f7c-98e6-7bda7f95c743",
                                "sense_id": "376a75ed-b3d0-3c18-b7a4-a838e2e5bf76",
                                "text": "Хоть козлетон на лавочке под гитару."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdbb48e2-9286-4283-98db-533d58c3e307",
                        "source_entry_id": "4570e5ab-d23e-347a-83f9-fbf800a2398b",
                        "source_sense_id": "376a75ed-b3d0-3c18-b7a4-a838e2e5bf76",
                        "target_lang_word": "singing out of tune",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fc9c18fb-51b2-4008-a6fc-1f74836f8c65",
                        "source_entry_id": "4570e5ab-d23e-347a-83f9-fbf800a2398b",
                        "source_sense_id": "376a75ed-b3d0-3c18-b7a4-a838e2e5bf76",
                        "target_lang_word": "voix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96c6c3c4-65a9-33a0-bd2f-b61a0ee25c54",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Ensemble de sons produits par les cordes vocales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b85b7f-448d-4dc7-81c2-3f017fe5303a",
                                                "sense_id": "96c6c3c4-65a9-33a0-bd2f-b61a0ee25c54",
                                                "text": "Et sa voix alors prenait une intonation dolente et uniforme, enflant les mots, appuyant indéfiniment sur les syllabes. Cela m’agaçait beaucoup."
                                            },
                                            {
                                                "example_id": "437a4ad6-45ee-4d18-a19b-3c16dba985a8",
                                                "sense_id": "96c6c3c4-65a9-33a0-bd2f-b61a0ee25c54",
                                                "text": "Si Dris Ben-Aâlem, le caïd el-mechouar, gouverneur de la cour, commandant de la garde chérifienne, porte-parole du Sultan, était un mulâtre gigantesque à voix stentorienne."
                                            },
                                            {
                                                "example_id": "0411e232-92be-4058-b5c7-8090037bbed8",
                                                "sense_id": "96c6c3c4-65a9-33a0-bd2f-b61a0ee25c54",
                                                "text": "Trop sensible à la voix des êtres. Il me semble qu’elle m’en dit plus sur eux que le regard ou les mains, qui pourtant avouent presque tout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5b866df-fd04-3228-9694-ddb3e9abb806",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Son articulé de la parole, voyelle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2010a8-7255-4477-b59d-a8208a3cbabb",
                                                "sense_id": "f5b866df-fd04-3228-9694-ddb3e9abb806",
                                                "text": "J’eus pour toute récompense un thank you, sir, qui est prononcé d’une voix sèche, extrêmement britannique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ebbb023-a122-3e14-ae0b-c37f4a33a3fa",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Son modulé dans le chant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77633a2-4f40-4001-b211-e903fe2c85c9",
                                                "sense_id": "4ebbb023-a122-3e14-ae0b-c37f4a33a3fa",
                                                "text": "Tu n’as pas une vilaine voix et la mienne est très bien. De tous les chanteurs de plages que j’ai entendus, il n’y en a pas un seul que je n’aurais dégoté facilement."
                                            },
                                            {
                                                "example_id": "afaaa794-f659-40aa-9316-5f43b9c586a1",
                                                "sense_id": "4ebbb023-a122-3e14-ae0b-c37f4a33a3fa",
                                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                                            },
                                            {
                                                "example_id": "58884952-20de-4b36-8105-f46ad1f552a7",
                                                "sense_id": "4ebbb023-a122-3e14-ae0b-c37f4a33a3fa",
                                                "text": "Seulement, j’ai toujours chanté comme une gamelle, et il suffisait que je me mêle à une chorale pour que ma voix fasse dérailler tous les autres."
                                            },
                                            {
                                                "example_id": "8d73b90f-49ff-4607-a66f-7097539731f8",
                                                "sense_id": "4ebbb023-a122-3e14-ae0b-c37f4a33a3fa",
                                                "text": "[…], j'ai entendu une voix féminine qui chantait d'une justesse plus qu'approximative, deux chansons d'une ringardise affligeante, à cent mille lieues de tes goûts musicaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cb6d9c-19cd-3c52-92d9-6d8faefb2d95",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Parties instrumentales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce97941d-cfc0-47b0-9080-374514aadc05",
                                                "sense_id": "14cb6d9c-19cd-3c52-92d9-6d8faefb2d95",
                                                "text": "Une fugue à trois, à quatre voix : Une fugue à trois, à quatre parties simultanées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccb6588a-270e-328d-8698-69a4cacd9468",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Son de certains instruments de musique ou certains bruits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d18b59b-07da-4afe-9ef2-1cd559f40342",
                                                "sense_id": "ccb6588a-270e-328d-8698-69a4cacd9468",
                                                "text": "Les voix de viole avaient l’air si plaintives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4655393-6fbc-3959-a79c-b2107e8eb7f1",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Se dit aussi en parlant de certains animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a78045e2-9a27-4544-8bf3-bf7827a758a8",
                                                "sense_id": "b4655393-6fbc-3959-a79c-b2107e8eb7f1",
                                                "text": "Les chiens commencèrent à donner de la voix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53489e6-3de0-31b9-b5c7-2009a725df83",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Son de certaines choses."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ecf30eb-6bbd-4fa4-ad58-4a75b5a14953",
                                                "sense_id": "c53489e6-3de0-31b9-b5c7-2009a725df83",
                                                "text": "La voix du tonnerre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03efdeea-8b68-3008-888e-6b319602f80b",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Ce qui nous parle ou qui nous inspire. Mouvement intérieur qui nous porte à faire quelque chose ou qui nous en détourne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "358a7bd9-d640-4816-99fd-64cda9e6370a",
                                                "sense_id": "03efdeea-8b68-3008-888e-6b319602f80b",
                                                "text": "Écouter la voix de la raison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d5ca26c-b38a-39de-9909-26d8a27fb388",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Expression d’une opinion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4177d74-a044-42a3-abcd-7f89358d7ceb",
                                                "sense_id": "3d5ca26c-b38a-39de-9909-26d8a27fb388",
                                                "text": "La liberté passait sur le monde, l’internationale était sa voix criant par dessus les frontières les revendications des déshérités."
                                            },
                                            {
                                                "example_id": "86e25968-22b0-4d8a-ba4f-929cbc4fc016",
                                                "sense_id": "3d5ca26c-b38a-39de-9909-26d8a27fb388",
                                                "text": "On attend désormais les contributions extérieures dans le cadre des États généraux de la régulation numérique. Nous voulons entendre toutes les voix sur le sujet, y compris celles des plates-formes et des associations de défense des libertés numériques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc0c4421-71bd-3546-8490-7518e97a6663",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Expression d’un vote ; suffrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4be16996-7b23-4458-a50b-1208f14f169e",
                                                "sense_id": "cc0c4421-71bd-3546-8490-7518e97a6663",
                                                "text": "Les grands et les mages étaient les juges. […] On allait aux voix ; le roi prononçait le jugement."
                                            },
                                            {
                                                "example_id": "bedcbc27-eb01-41aa-af79-26d186362007",
                                                "sense_id": "cc0c4421-71bd-3546-8490-7518e97a6663",
                                                "text": "Je suis plein d’ardeur. J’invente la parité, en lançant la liste « femme, homme » avec laquelle non seulement je vais perdre des voix mais aussi me couvrir de ridicule — on va l’appeler la « liste chabadabada »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3ad019a-d5d5-3a1a-94fa-79cf5f603286",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Mode d’expression d’une action par rapport au sujet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daccd713-892f-42bf-ab22-82cd205745b8",
                                                "sense_id": "b3ad019a-d5d5-3a1a-94fa-79cf5f603286",
                                                "text": "Voix active (le sujet accomplit l’action), voix passive (le sujet subit l’action)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e91713a0-3108-3a13-9bfb-20fe63a58067",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Échanges par téléphone."
                                        ],
                                        "tags": [
                                            "Télécommunication"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a851ad4-ee2d-4ed9-93d6-d99630359230",
                                                "sense_id": "e91713a0-3108-3a13-9bfb-20fe63a58067",
                                                "text": "La première [offre] joue l’illimité voix, y compris vers une quarantaine de destinations internationales, et SMS, avec 3 Go de données pour 19,99 euros mensuels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12c93958-e411-3304-9d75-568872c3d484",
                                        "entry_id": "b31ff14f-ebdd-3bb7-a4d7-7bc1a884be55",
                                        "glosses": [
                                            "Appel, injonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a69ef4e-b6a0-4260-8794-8b61cc568a97",
                                                "sense_id": "12c93958-e411-3304-9d75-568872c3d484",
                                                "text": "Pas un de ces braves Écossais, partis à la voix de leur laird, ne manquait à l’appel, tous revenaient à leur vieille Écosse…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
