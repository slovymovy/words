                    "semantic_group_id": "participle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do upieczenia tego ciasta potrzebny jest świeżo <w>mielony</w> cynamon oraz cukier puder.",
                            "target_lang_translations": {
                                "ru": "Для выпечки этого пирога нужна свеже<w>молотая</w> корица и сахарная пудра."
                            }
                        },
                        {
                            "text": "Rano w kuchni unosi się wspaniały zapach świeżo <w>mielonej</w> kawy z ekspresu.",
                            "target_lang_translations": {
                                "ru": "Утром на кухне витает чудесный запах свеже<w>молотого</w> кофе из кофемашины."
