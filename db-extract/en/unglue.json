                "translations": [
                    {
                        "translation_id": "67abd705-5208-40ce-b9c1-9de1f6a028a9",
                        "source_entry_id": "a6b28a59-8513-3fcf-9e7d-2fd97265d175",
                        "source_sense_description": "To separate that which was held by glue",
                        "target_lang_word": "ablösen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablösen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5da6c0b-95c9-320a-b9d8-4c86d9c03ca2",
                                        "entry_id": "8b1b96a0-9d8c-30a2-bc54-8c186ddae9de",
                                        "glosses": [
                                            "eine Aufgabe für jemanden übernehmen, jemanden ersetzen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11994b28-2e01-4c75-b3bd-08bc0c39fff9",
                                                "sense_id": "e5da6c0b-95c9-320a-b9d8-4c86d9c03ca2",
                                                "text": "Ich löste meinen Bruder mit der Wache ab."
                                            },
                                            {
                                                "example_id": "15bd6f94-05d1-492b-96f0-6047d33da2cf",
                                                "sense_id": "e5da6c0b-95c9-320a-b9d8-4c86d9c03ca2",
                                                "text": "„Zwischen 1824 und 1891 darf mit einiger Berechtigung von einem zweiten saudischen Staat gesprochen werden, auch wenn dieser nie die Ausmaße des ersten erreichte und sich verschiedene Familienflügel in der Herrschaft ablösten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e40bfa08-3dea-392c-aae3-c86dfc88b51d",
                                        "entry_id": "8b1b96a0-9d8c-30a2-bc54-8c186ddae9de",
                                        "glosses": [
                                            "etwas von etwas trennen, entfernen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db5e492f-04d9-44e5-92b7-1114ef2c47be",
                                                "sense_id": "e40bfa08-3dea-392c-aae3-c86dfc88b51d",
                                                "text": "Das Pflaster sollte vorsichtig abgelöst werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d88ef14f-5c76-389d-a74f-18d077f84790",
                                        "entry_id": "8b1b96a0-9d8c-30a2-bc54-8c186ddae9de",
                                        "glosses": [
                                            "sich von etwas trennen, lösen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1c7c3f-a24d-47a3-97c7-e6a74e1d91e5",
                                                "sense_id": "d88ef14f-5c76-389d-a74f-18d077f84790",
                                                "text": "Die Tapete löst sich von der Wand ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94c1d906-5e65-42d7-adf6-db34a585d652",
                        "source_entry_id": "a6b28a59-8513-3fcf-9e7d-2fd97265d175",
                        "source_sense_description": "To cease to follow attentively",
                        "target_lang_word": "losreißen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "losreißen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                        "entry_id": "e9b47259-1f8d-303c-a6e9-5c24b2663548",
                                        "glosses": [
                                            "sich plötzlich und mit Kraft von etwas lösen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bbc70804-313f-4852-a0c8-e5b70e67dd3f",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "Der Hund riss sich von der Leine los und jagte dem Kaninchen hinterher."
                                            },
                                            {
                                                "example_id": "41a519c5-a1a0-4298-8764-a8ef4765b036",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "„Beim Trabrennen am Pockinger Bürgerfest ist gestern Nachmittag ein Pferd ausgebüxt und panisch durch die Innenstadt gelaufen. […] Wie sich das Pferd losreißen konnte, ist bislang laut Polizei unklar.“"
                                            },
                                            {
                                                "example_id": "8dad4fd7-e804-4ff6-a589-f66216ede593",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "Das Mädchen riss sich von der Hand der Kindergärtnerin los und rannte auf die Straße."
                                            },
                                            {
                                                "example_id": "2a6f73ae-021b-4863-830f-44b2926fc1d2",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "„Nach Angaben der Polizei riss sich [der drei Jahre alte Junge] am Mittwochnachmittag im Rintelner Ortsteil Steinbergen auf dem Gehweg von seinen Eltern los und geriet auf die Fahrbahn.“"
                                            },
                                            {
                                                "example_id": "edf1c198-65be-497a-9ec5-aca838725458",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "[Messerstecherei:] „Der 35-jährige wehrte die Stiche ab und erlitt Schnittwunden an der Augenbraue und am Hinterkopf. Er konnte sich schließlich losreißen.“"
                                            },
                                            {
                                                "example_id": "f44b868d-9e57-4c7d-9241-572928c4a01d",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "[Ladendiebstahl:] „Sicherheitsmitarbeiter versuchten ihn aufzuhalten. Der Mann konnte sich laut Polizei aber losreißen und flüchten.“"
                                            },
                                            {
                                                "example_id": "08c51f80-3c77-4573-a9f9-6e74249c355a",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "Mehrere Dachziegel waren vom Sturm losgerissen worden, der Dachdecker musste kommen und es reparieren."
                                            },
                                            {
                                                "example_id": "7a694e0f-b99f-4328-a7ce-e4314d20e5f4",
                                                "sense_id": "4bb35693-7b1d-3dce-8f1f-7d387d825556",
                                                "text": "„Geisternetze sind herrenlose Netze, die sich von Fangschiffen losgerissen haben und im Meer umhertreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                        "entry_id": "e9b47259-1f8d-303c-a6e9-5c24b2663548",
                                        "glosses": [
                                            "sich von etwas lösen, was ihn/sie fasziniert"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6def6259-e28b-43ce-9f67-439501f1c3f8",
                                                "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                                "text": "Sie war so schön, ich konnte meinen Blick nicht von ihr losreißen."
                                            },
                                            {
                                                "example_id": "705b6c98-bd2c-4a29-929e-c9516d944e57",
                                                "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                                "text": "Dieses Buch/Dieses Computerspiel/Diese Serie war so spannend, ich konnte mich auch um Mitternacht kaum davon losreißen."
                                            },
                                            {
                                                "example_id": "3648372e-95cd-49a8-b8fb-5d1c6078c677",
                                                "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                                "text": "[Radtour:] „Irgendwann muss man sich wieder aus dieser Idylle losreißen und aufs Rad schwingen, wenn man noch bis Fürstenfeldbruck kommen will.“"
                                            },
                                            {
                                                "example_id": "820488a2-b297-4101-ae2e-01edabe6433e",
                                                "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                                "text": "[Konzert:] „Ich war als Reporterin da, sollte an diesem Abend noch zu einem anderen Termin, aber ich konnte mich nicht losreißen. Konstantin Wecker hatte mich mit seiner Musik und seinen Liedern gefangen.“"
                                            },
                                            {
                                                "example_id": "21f581eb-0bae-4150-bcaf-fb5edfccf697",
                                                "sense_id": "2e6948ea-8515-3b40-a73f-8f0720ea6b99",
                                                "text": "„[…] Dreizehenmöwen, Papageientaucher, Basstölpel und viele weitere Vögel. […] Nur schwer können wir uns von dem geschäftigen Treiben in der Luft und auf den Felsen losreißen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
