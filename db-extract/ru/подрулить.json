                "senses": [
                    {
                        "sense_id": "418a5b19-0a16-3ef7-bcec-87794b9213d5",
                        "entry_id": "cce6ed6b-17a0-3057-b0de-0047d1684327",
                        "glosses": [
                            "управляя рулем (машины, судна и т. п.), подъехать куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5922e303-a273-458b-99bc-411f7c3fc11d",
                                "sense_id": "418a5b19-0a16-3ef7-bcec-87794b9213d5",
                                "text": "Я подрулил к обочине дороги и заглушил мотор."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b4e5dd-1e2e-38d2-a3b4-2b2fdc57eac2",
                        "entry_id": "cce6ed6b-17a0-3057-b0de-0047d1684327",
                        "glosses": [
                            "подъехать, маневрируя (о транспортном средстве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9f0b1f-d9e8-4ef5-92e5-841a1614d90a",
                                "sense_id": "89b4e5dd-1e2e-38d2-a3b4-2b2fdc57eac2",
                                "text": "Тем временем автобус подрулил к зданию белизской таможни."
                            }
                        ]
                    },
                    {
                        "sense_id": "38c58867-dc93-345e-ae05-1b2e0f687df8",
                        "entry_id": "cce6ed6b-17a0-3057-b0de-0047d1684327",
                        "glosses": [
                            "перен., жарг. подойти, приблизиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e192bf-4c90-4c94-9f32-04b7400e70d0",
                                "sense_id": "38c58867-dc93-345e-ae05-1b2e0f687df8",
                                "text": "Там к ней подрулила продавщица галантерейного отдела тетя Клава в халатике на водолазку да с перманентом, взяла ее за мизинчик и говорит: ― Девочка Ира, купи пуговицу!"
                            }
                        ]
                    }
