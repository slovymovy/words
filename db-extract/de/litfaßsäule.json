                "senses": [
                    {
                        "sense_id": "fe2b97f7-cc61-3c5d-97ad-0a2fb2698faf",
                        "entry_id": "17e808d4-27ec-3c02-a33e-a61efb8e53e0",
                        "glosses": [
                            "Morris column (column or pillar used to display posters, advertising, etc.)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "a1df559f-0643-4311-a154-85b60deb37f2",
                                "sense_id": "fe2b97f7-cc61-3c5d-97ad-0a2fb2698faf",
                                "text": "1887, Die Gartenlaube, “Unter den Linden”, vol. 20, p. 336",
                                "translation": "In the background the big-city life of the residence, gentlemen in civilian clothes and unifrm, ladies in fashionable spring outfits, moves past the Morris columns that announce the ever-new expositions and wonders of the residence to the public addicted to pleasure.",
                                "english": "In the background the big-city life of the residence, gentlemen in civilian clothes and unifrm, ladies in fashionable spring outfits, moves past the Morris columns that announce the ever-new expositions and wonders of the residence to the public addicted to pleasure."
                            },
                            {
                                "example_id": "6d904f87-2c96-4ba2-848b-9e72fb59f523",
                                "sense_id": "fe2b97f7-cc61-3c5d-97ad-0a2fb2698faf",
                                "text": "Auf allen Litfaßsäulen steht dein Name […]",
                                "translation": "Your name is on all the Morris columns […]",
                                "english": "Your name is on all the Morris columns […]"
                            },
                            {
                                "example_id": "d71e6b76-8585-484e-9563-e74124d040ac",
                                "sense_id": "fe2b97f7-cc61-3c5d-97ad-0a2fb2698faf",
                                "text": "Es stehen die Litfaßsäulen\nVerstreut, den Leuchttürmen gleich,\nUnd lassen vom Wind sich umheulen",
                                "translation": "The Morris columns stand\nStrewn about, like lighthouses,\nAnd let the wind howl around them\nAnd soften in the rain.",
                                "english": "The Morris columns stand\nStrewn about, like lighthouses,\nAnd let the wind howl around them\nAnd soften in the rain."
                            }
                        ]
                    }
                ],
