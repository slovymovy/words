    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cab588a-fee0-3a24-bf73-bab3d59b2fde",
                    "sense_definition": "To involve someone deeply in an argument, conflict, or difficult situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "involve",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried hard not to <w>embroil</w> himself in the ongoing family dispute."
                        },
                        {
                            "text": "The company was careful not to <w>embroil</w> its partners in unnecessary legal battles."
                        }
                    ],
                    "synonyms": [
                        "entangle",
                        "implicate",
                        "involve"
                    ],
                    "common_phrases": [
                        "embroil in controversy",
                        "embroil in conflict"
                    ]
                },
                {
                    "sense_id": "71ddb2b9-381c-3d8a-9566-c5bff88f89fc",
                    "sense_definition": "To throw into disorder, confusion, or uproar; to complicate or jumble.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected political scandal threatened to <w>embroil</w> the entire administration."
                        },
                        {
                            "text": "Contradictory witness statements serve only to <w>embroil</w> the ongoing investigation further."
                        }
                    ],
                    "synonyms": [
                        "confuse",
                        "disorder"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "More commonly used today regarding people or nations than abstract situations"
                        }
                    ]
                },
                {
                    "sense_id": "19d95a90-d361-3e70-b7ee-00aaa6ad269e",
                    "sense_definition": "To set on fire or consume with flames.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fierce blaze appeared to <w>embroil</w> the wooden cabins along the shore."
                        },
                        {
                            "text": "Sparks from the altar threatened to <w>embroil</w> the sacred draperies nearby."
                        }
                    ],
                    "synonyms": [
                        "burn"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in modern English"
                        }
                    ]
                }
            ]
        },
        {
