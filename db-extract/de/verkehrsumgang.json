                "senses": [
                    {
                        "sense_id": "956e1817-6772-3130-819d-ded40b4b4f3f",
                        "entry_id": "f58b15fc-cb61-3ae5-98b6-81ee7c763869",
                        "glosses": [
                            "das Verhalten, die Kommunikation und Kooperation der Verkehrsteilnehmer untereinander"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "200d42b9-d188-438c-a5c7-3e4573f87de0",
                                "sense_id": "956e1817-6772-3130-819d-ded40b4b4f3f",
                                "text": "„Verkehrserziehung muss mehr leisten als Unfälle zu vermeiden. Sie muss einen Beitrag leisten zur Humanisierung und Persönlichung des Verkehrsumgangs.“"
                            },
                            {
                                "example_id": "c3a49d63-7f9c-4d52-8d18-db07169e2626",
                                "sense_id": "956e1817-6772-3130-819d-ded40b4b4f3f",
                                "text": "„Nach meiner Erfahrung verroht der Verkehrsumgang mehr und mehr.“"
                            },
                            {
                                "example_id": "7c093341-a5b6-4789-a132-48c028ad3a61",
                                "sense_id": "956e1817-6772-3130-819d-ded40b4b4f3f",
                                "text": "„Im täglichen Verkehr und in der Rechtsprechung kennzeichnet der Begriff das regelkonforme Verhalten beim praktischen Verkehrsumgang.“"
                            },
                            {
                                "example_id": "82822ba9-e45c-43a7-9c0e-a9e16557c441",
                                "sense_id": "956e1817-6772-3130-819d-ded40b4b4f3f",
                                "text": "„Konzentrationsübungen zur Verringerung von Ablenkungsfaktoren für einen sicheren Verkehrsumgang der Kinder waren ebenfalls Bestandteil dieses Verkehrssicherheitstages.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
