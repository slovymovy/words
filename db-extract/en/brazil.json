                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86a58fae-0b9b-4e87-abfb-97ad7cb70102",
                        "source_entry_id": "24d1b1ed-94c0-30ed-9d85-56e566893a92",
                        "source_sense_id": "ddf974b1-d45a-329c-99fb-12ce52bb51fd",
                        "source_sense_description": "Brasilien",
                        "target_lang_word": "Brasilien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brasilien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                        "entry_id": "a3d1a5a8-c22f-3c0d-8f08-96495da8ab79",
                                        "glosses": [
                                            "das größte Land Südamerikas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b363f692-a984-48e5-a615-c120a2505122",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "Brasilia ist die Hauptstadt von Brasilien."
                                            },
                                            {
                                                "example_id": "29b34a94-6c55-4f9a-8f14-b7c39ff5550a",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Brasiliens Landschaft ist geprägt von ausgedehnten Regenwäldern des Amazonas-Tieflands im Norden und Hochebenen, Hügeln und Gebirgen im Süden.“"
                                            },
                                            {
                                                "example_id": "8ec6ef6a-ad04-4e21-9e3b-72224256c71b",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "Aufgrund der Einwanderung gibt es in Brasilien zahlreiche Minderheitensprachen."
                                            },
                                            {
                                                "example_id": "303d281d-00ff-4db4-819d-15a5e1d73d3d",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Brasiliens Präsident Luiz Inácio Lula da Silva, der häufig als ‚Anti-Chávez‘ bezeichnet wird, sagte im Zusammenhang mit der globalen Finanzkrise: ‚Die Zeiten sind vorbei, in denen wir, die aufstrebenden Volkswirtschaften, vom Internationalen Währungsfonds abhängig waren. … Die Zeit ist vorbei, in der Lateinamerika keine eigene Stimme hatte.‘““"
                                            },
                                            {
                                                "example_id": "0c438002-2ca1-4b1f-8cad-246b0c13d14e",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Er ist einer der besten Gleitschirmpiloten der Welt, war 2004 Gesamtsieger im Worldcup, viermal deutscher Meister, ist bei Wettkämpfen in Südafrika, Brasilien und Australien angetreten.“"
                                            },
                                            {
                                                "example_id": "e7aaebb7-a98a-4a62-9e68-9911e97012c7",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„Umweltschäden verursacht das Soja zudem auch in Brasilien.“"
                                            },
                                            {
                                                "example_id": "45c7434c-5d40-4674-8266-501493dcb2b3",
                                                "sense_id": "f2007264-77f3-3051-9341-add0a806b7b6",
                                                "text": "„In Brasilien werden Regenwälder gerodet, um zusätzliche Anbauflächen für Zuckerrohr für die Bioethanolproduktion zu schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b8896c9-b8a3-4537-9461-cb9b2be3d415",
                        "source_entry_id": "24d1b1ed-94c0-30ed-9d85-56e566893a92",
                        "source_sense_id": "ddf974b1-d45a-329c-99fb-12ce52bb51fd",
                        "source_sense_description": "Brasilien",
                        "target_lang_word": "Brésil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brésil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f91b14-c29d-38c9-ace3-480883417f75",
                                        "entry_id": "43c7ca8d-4ba9-3487-af63-d8df84f4c473",
                                        "glosses": [
                                            "Grand pays d’Amérique du Sud (cinquième pays du monde par sa superficie), de langue principale portugaise, qui est bordé par l’Atlantique à l'est, par l’Uruguay et l’Argentine au sud, par le Paraguay au sud-ouest, par la Bolivie et le Pérou à l'ouest, par la Colombie et le Venezuela au nord-ouest, par la Guyane, le Suriname et la Guyane française au nord, et dont la capitale est Brasilia."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "855d9a1e-5e4a-4a75-8f3e-b069997c5f22",
                                                "sense_id": "b6f91b14-c29d-38c9-ace3-480883417f75",
                                                "text": "La liaison par dirigeable entre le Brésil et l'Allemagne devait d'ailleurs durer sept jours cette fois là."
                                            },
                                            {
                                                "example_id": "d5cf2f48-9f5f-41c7-b6c4-385432043c51",
                                                "sense_id": "b6f91b14-c29d-38c9-ace3-480883417f75",
                                                "text": "L’espérance moyenne de vie est de trente ans en Bolivie ou au nord-est du Brésil. Cette situation va s'aggraver, car l'Amérique latine accuse le taux de croissance démographique le plus élevé du monde : 3 %."
                                            },
                                            {
                                                "example_id": "24d36707-e8c8-4bcd-b104-f2d01c1e435f",
                                                "sense_id": "b6f91b14-c29d-38c9-ace3-480883417f75",
                                                "text": "— C’est l’équipe du Brésil, ça ?\n— Oui, c'est l’équipe du Brésil.\n— Ils sont super, hein ?\n— Oui, ils sont super.\n— Bon, eh ben salut, alors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "c83d2e42-31e1-45a4-84b7-b13cf5ab8ddd",
