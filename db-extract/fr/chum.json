                        ],
                        "examples": [
                            {
                                "example_id": "f25d9b39-11f1-4c01-9174-c7a3748b5025",
                                "sense_id": "34e35088-ae92-3561-a524-e16305abd22e",
                                "text": "Elle m'a présenté son nouveau chum.",
                                "translation": "She introduced me to her new boyfriend.",
                                "english": "She introduced me to her new boyfriend."
                            },
                            {
                                "example_id": "19ace45a-b5da-4361-a6a1-279bda15a16a",
                                "sense_id": "34e35088-ae92-3561-a524-e16305abd22e",
                                "text": "Je croyais qu'il était rien qu'un ami à Éric mais en fait c'est son chum.",
                                "translation": "I believed that he was just another of Éric's friends, but in fact, it's his boyfriend.",
                                "english": "I believed that he was just another of Éric's friends, but in fact, it's his boyfriend."
                            }
                        ]
                    },
                    {
                        "sense_id": "547b272c-cfca-3ffa-96c6-fbcdbd0b17c1",
                        "entry_id": "a5ed4c76-5bae-3f82-a4ea-11f423a65d23",
                        "glosses": [
                            "a friend, usually male; a chum"
                        ],
                        "tags": [
                            "Canada",
                            "Quebec",
                            "masculine",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "068f4d4f-9412-4457-86fb-06c897cb5d60",
                                "sense_id": "547b272c-cfca-3ffa-96c6-fbcdbd0b17c1",
                                "text": "J'suis allé danser avec une gang de chums.",
                                "translation": "I went to dance with a group of my chums.",
                                "english": "I went to dance with a group of my chums."
                            }
                        ]
                    }
