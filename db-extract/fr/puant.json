                ],
                "senses": [
                    {
                        "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                        "entry_id": "cf91b26f-3546-3f4e-976f-5f69bb506ea7",
                        "glosses": [
                            "Qui sent mauvais, qui a une mauvaise odeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b5be4b5-fb6a-4b40-9575-18ee5941c24a",
                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                "text": "Il mangeait une maigre et puante pitance, faite de créton et d’eau sale qu’on lui apportait le matin, dans une écuelle de grès ébréché, […]."
                            },
                            {
                                "example_id": "3ae24780-fb64-459c-94fe-7b7c71d9f2b4",
                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                "text": "Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d’habitation y sont exécrables."
                            },
                            {
                                "example_id": "d514d6ec-50b5-4453-817a-7d0d18c39706",
                                "sense_id": "0b326d23-b22d-34e9-8e7c-e55e52924860",
                                "text": "Et le feu d’un petit brasero avec trois grelotteux autour qui louchaient dans la fumée puante. On n’était pas très bien."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cb1359b-d4bc-3bed-83e4-b709c9e3d350",
                        "entry_id": "cf91b26f-3546-3f4e-976f-5f69bb506ea7",
                        "glosses": [
                            "Qui est d’une fatuité, d’une vanité insupportable."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1e047221-1d58-4e10-949b-31fa576436e8",
                                "sense_id": "8cb1359b-d4bc-3bed-83e4-b709c9e3d350",
                                "text": "Il est puant."
                            }
                        ]
                    }
                ],
