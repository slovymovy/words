                                "it": "D'inverno svuotavano la <w>piscina</w>.",
                                "cs": "V zimě <w>bazén</w> vypouštěli.",
                                "tr": "Kışın <w>havuzu</w> boşaltıyorlardı.",
                                "es": "En invierno vaciaban la <w>piscina</w>."
                            }
                        },
                        {
                            "text": "Het water in het <w>zwembad</w> is lekker warm.",
                            "target_lang_translations": {
                                "ru": "Вода в <w>бассейне</w> приятно теплая.",
                                "en": "The water in the <w>swimming pool</w> is nice and warm.",
                                "pl": "Woda w <w>basenie</w> jest przyjemnie ciepła.",
                                "de": "Das Wasser im <w>Schwimmbad</w> ist angenehm warm.",
                                "fr": "L'eau de la <w>piscine</w> est agréablement chaude.",
                                "it": "L'acqua della <w>piscina</w> è piacevolmente calda.",
                                "cs": "Voda v <w>bazénu</w> je příjemně teplá.",
                                "tr": "<w>Havuzdaki</w> su güzelce sıcak.",
                                "es": "El agua de la <w>piscina</w> está agradablemente templada."
                            }
                        }
