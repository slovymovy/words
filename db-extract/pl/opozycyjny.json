                                "target_senses": [
                                    {
                                        "sense_id": "81a6d90b-50e6-3b93-99d3-f5c505dd25a3",
                                        "entry_id": "257ba059-2292-3d46-8089-1377e6c557bf",
                                        "glosses": [
                                            "Of, pertaining to, or exhibiting opposition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75be754-3946-4052-8f63-76132b017bbb",
                                                "sense_id": "81a6d90b-50e6-3b93-99d3-f5c505dd25a3",
                                                "text": "And he has brought to oppositional politics the same energy and aggression that characterized his chess, attacking Mr. Putin and the Kremlin — or the regime, as he repeatedly calls it — with language rarely spoken so bluntly in Russia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
