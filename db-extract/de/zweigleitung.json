                "senses": [
                    {
                        "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                        "entry_id": "99a0e600-52b1-3195-a9cb-4beecabc3179",
                        "glosses": [
                            "Rohrleitung oder elektrische Leitung, die von einer anderen abzweigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d6ccc3-8083-493f-81fd-ee80cb3f147e",
                                "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                                "text": "„Zunächst ist ersichtlich, dass die sämtlichen Zweigleitungen nicht mehr und nicht weniger Dampf, Wasser und Elektricität transportieren werden, als ihnen durch die Hauptleitung zugeführt wird.“"
                            },
                            {
                                "example_id": "b6d3a896-da5d-4b56-a114-b9138e5838a7",
                                "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                                "text": "„Nun ist aber das Kontaktstück einer Hauptleitung nicht in unmittelbarem Zusammenhange mit einem zugehörigen Kontaktstück einer Zweigleitung.“"
                            },
                            {
                                "example_id": "a9fa05d2-93e3-4eea-a59c-cc03d8f38913",
                                "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                                "text": "„Hier wird aus dem Druckraum oder der Druckleitung ein Teil des Pumpenvolumenstroms abgezweigt und durch eine Zweigleitung (Bypass) über ein Regulierorgan vor den Saugtrichter der Pumpe zurückgeführt.“"
                            },
                            {
                                "example_id": "80857ac8-abb4-4233-a2cd-383bb2f241ce",
                                "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                                "text": "„Bei langsamem, allmählichem Luftzutritt von der Hauptleitung her bleibt die Kugel K in ihrer Ruhelage und gestattet der Luft in die Zweigleitung Z zu dringen.“"
                            },
                            {
                                "example_id": "41f5cc3e-d545-4b79-89aa-562e5f7888fd",
                                "sense_id": "f8aab7c4-fb8b-3d0c-ade6-f98f117b4f96",
                                "text": "„Jedenfalls muß in der obersten Zweigleitung noch ein Wasserüberdruck von mindestens einer halben Atmosphäre vorhanden sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
