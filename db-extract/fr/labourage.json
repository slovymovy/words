                    {
                        "sense_id": "8ca2153b-ee7a-3a18-9f39-5db0dbc7ef8b",
                        "entry_id": "99c709f5-4540-3fa0-bbb0-8f7a6d0a8dd4",
                        "glosses": [
                            "Action de labourer la terre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2ecb8329-9f85-4567-89fe-cdfcc45cc515",
                                "sense_id": "8ca2153b-ee7a-3a18-9f39-5db0dbc7ef8b",
                                "text": "Le sillonnage prend place après le labourage, le sous-solage et le hersage."
                            },
                            {
                                "example_id": "48a16f0b-7cfb-4b4f-9c1b-c498a5c63e36",
                                "sense_id": "8ca2153b-ee7a-3a18-9f39-5db0dbc7ef8b",
                                "text": "La permaculture préconise de travailler en lasagne ou en butte pour éviter de labourer ; néanmoins, notre précédente expérience et celle que nous expérimentons actuellement nous confirment que le labourage peut être très utile."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a0f36e0-fb2f-385a-b709-58b5180d4b1e",
                        "entry_id": "99c709f5-4540-3fa0-bbb0-8f7a6d0a8dd4",
                        "glosses": [
                            "Action de décharger, en parlant de marchandises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e71c9502-8908-4d81-bce8-a79842df37b0",
                                "sense_id": "7a0f36e0-fb2f-385a-b709-58b5180d4b1e",
                                "text": "On appelle labourage & déchargeage des vins, cidres & autres liqueurs , la sortie de ces liqueurs hors des bateaux qui les ont amenées dans quelques ports."
                            }
                        ]
                    }
                ],
