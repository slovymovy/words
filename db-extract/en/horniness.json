                                                "example_id": "d674ad8b-923e-493e-9bd9-ea102aee7a27",
                                                "sense_id": "014c22d9-413b-3b78-b674-df15d83cb1da",
                                                "text": "≈ συνώνυμα: κάψα, μανία, τρέλα"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8871013-f1d1-33f8-a111-6898aefc5a83",
                                        "entry_id": "1b35ab40-abcd-35c3-a76d-fff6599b08d3",
