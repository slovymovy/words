                    }
                ],
                "senses": [
                    {
                        "sense_id": "f1ad48b6-a86b-3d78-b625-69164d44f338",
                        "entry_id": "b83ba877-8b60-35c5-bcae-58da695b3968",
                        "glosses": [
                            "Relatif aux terpènes ou qui en est dérivé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db4d6aba-883e-49aa-bf11-cd6ea1857c15",
                                "sense_id": "f1ad48b6-a86b-3d78-b625-69164d44f338",
                                "text": "Dans certains cas la plante fait elle-même l’hydrolyse et utilise le sucre libéré. Le produit terpénique s’accumule alors et la plante devient odorante."
                            },
                            {
                                "example_id": "a663cd8d-8f12-4f41-90be-8c2c355fa232",
                                "sense_id": "f1ad48b6-a86b-3d78-b625-69164d44f338",
                                "text": "Il est, en outre, envisagé de contre-indiquer les suppositoires à base de camphre (ou d’autres dérivés terpéniques) avant l’âge de 30 mois."
                            },
                            {
                                "example_id": "42c4dfe8-eb18-4082-88ba-27e8fa6fcb2d",
                                "sense_id": "f1ad48b6-a86b-3d78-b625-69164d44f338",
                                "text": "L’exemple suivant concerne l’oxydation du géraniol, un alcool terpénique, en géranial, un aldéhyde possédant un carbonyle conjugué avec une double liaison éthylénique sans isomérisation en néral, pourtant plus stable."
                            },
                            {
                                "example_id": "4f73429f-097e-4441-9a8c-5004514bc39f",
                                "sense_id": "f1ad48b6-a86b-3d78-b625-69164d44f338",
                                "text": "Le caoutchouc naturel est un biopolymère terpénique constitué de plusieurs milliers de molécules d’isoprène (molécules à 5 atomes de carbone), reliées par des liaisons cis-1,4. Il est issu essentiellement de l'hévéa."
                            }
                        ]
                    }
                ],
