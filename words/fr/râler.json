                            "comment": "registre familier très courant"
                        }
                    ]
                },
                {
                    "sense_id": "f7450073-80ea-3eac-883b-1e44729770d0",
                    "sense_definition": "Produire un bruit rauque et pénible en respirant, en particulier lors d'une maladie grave ou à l'approche de la mort.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "respiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le malade respirait avec une grande difficulté et commençait à <w>râler</w> doucement."
                        },
                        {
                            "text": "Le médecin écoutait attentivement le patient qui <w>râlait</w> sur son lit d'hôpital."
                        }
                    ]
                },
                {
                    "sense_id": "3ec8f717-1acc-3f18-8fdb-9e121171f03f",
                    "sense_definition": "Être à l'agonie, approcher de sa fin.",
