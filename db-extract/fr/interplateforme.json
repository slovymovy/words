                        "form_id": "c951ec43-1acf-4375-bbaa-edfc1e39f059",
                        "entry_id": "957367f2-b4d9-3679-9606-c4887673a32e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "interplateformes"
                    },
                    {
                        "form_id": "96321e36-6ef3-4d79-8da5-f595323aaed6",
                        "entry_id": "957367f2-b4d9-3679-9606-c4887673a32e",
                        "tags": [],
                        "form": "inter-plateforme"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "493d39a0-07d0-3846-8f39-931cbfa8ad17",
                        "entry_id": "957367f2-b4d9-3679-9606-c4887673a32e",
                        "glosses": [
                            "Se dit de la fonctionnalité d’un jeu vidéo multijoueur en ligne qui permet aux utilisateurs de plateformes de jeu différentes de jouer une même partie simultanément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3863ce9f-f942-46bd-8198-6c161162297d",
                                "sense_id": "493d39a0-07d0-3846-8f39-931cbfa8ad17",
                                "text": "Les versions PlayStation 4 et Xbox One peuvent jouer en jeu interplateforme. La version Switch n'est pas compatible avec le jeu interplateforme."
                            },
                            {
                                "example_id": "7ab23cbf-c7cf-43ce-8f15-bde411049b80",
                                "sense_id": "493d39a0-07d0-3846-8f39-931cbfa8ad17",
                                "text": "Microsoft, lui, se veut toujours aussi rassurant : il aurait même tout intérêt à garder Call of Duty sur PlayStation ne serait ce que pour des raisons économiques ou pour maintenir l'intérêt du jeu interplateforme."
                            }
                        ]
                    },
                    {
                        "sense_id": "972db1d5-cbd2-3648-adf9-1ad96d180b0f",
                        "entry_id": "957367f2-b4d9-3679-9606-c4887673a32e",
                        "glosses": [
                            "Jeu vidéo offrant cette fonctionnalité."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "5eb67d63-25dd-4940-bbbb-35b9db603c17",
                                "sense_id": "972db1d5-cbd2-3648-adf9-1ad96d180b0f",
                                "text": "De plus, avec la montée en puissance des jeux interplateformes, les joueurs peuvent désormais rivaliser ou coopérer avec leurs amis, quel que soit l’appareil de jeu, élargissant ainsi l’écosystème multijoueur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d900b77d-9102-4e47-83fa-28a77b2ea394",
                        "source_entry_id": "957367f2-b4d9-3679-9606-c4887673a32e",
                        "target_lang_word": "crossplay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crossplay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7dca74-71d4-375a-baf2-dd81d34ef1c6",
                                        "entry_id": "9562f132-e003-3fe9-9ad3-4245807cd566",
                                        "glosses": [
                                            "The ability to record data with one device and play back the data on a different, compatible device."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6661d3-49dd-4233-ab32-84040c45b886",
                                                "sense_id": "7f7dca74-71d4-375a-baf2-dd81d34ef1c6",
                                                "text": "The problem with the crossplay of plastic-based (Mylar) tape is that it's pliable; any difference in temperature or mechanical stress, induced by various transports, will distort track patterns recorded on the compliant tape."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc6c012a-eff3-3f7f-9a49-485e9a5b5d0b",
                                        "entry_id": "9562f132-e003-3fe9-9ad3-4245807cd566",
                                        "glosses": [
                                            "Subordinate communication between participants in a conversation."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8274c73-8d8a-4346-a3ba-9d93a8b9e6d7",
                                                "sense_id": "bc6c012a-eff3-3f7f-9a49-485e9a5b5d0b",
                                                "text": "Although in all three events the requests were performed in front of and for the benefit of the student audience as intended bystanders, the crossplay observed in the guest-student episode was absent from the guest-teacher interactions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2505395b-5567-3a51-9b16-e62b52b49f46",
                                        "entry_id": "9562f132-e003-3fe9-9ad3-4245807cd566",
                                        "glosses": [
                                            "Cross-platform multiplayer functionality."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crossplay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4628b28-4a51-39ad-bc79-7efe543bc54c",
                                        "entry_id": "681ede25-d1fb-33e1-a15e-1de498a7af90",
                                        "glosses": [
                                            "A form of cosplay in which one dresses up as a character of the opposite sex."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb6f6a96-dfd9-4bc2-b00c-b573d4e28de5",
                                                "sense_id": "c4628b28-4a51-39ad-bc79-7efe543bc54c",
                                                "text": "Incidentally, I'm not sure you're bucking the trend so much as going along with it; FTM crossplay is getting pretty popular, although you see more women going for bishounen and visual-kei genderfucky stars than anything else."
                                            },
                                            {
                                                "example_id": "2e4831cb-77e0-4b2a-b1e5-3ee6573e4561",
                                                "sense_id": "c4628b28-4a51-39ad-bc79-7efe543bc54c",
                                                "text": "Crossplay is where a cosplayer employs gender reversal (i.e., a female who dresses as a male character or vice versa)."
                                            },
                                            {
                                                "example_id": "0fdf8efb-1c05-4fbd-b280-17cbeffd4c41",
                                                "sense_id": "c4628b28-4a51-39ad-bc79-7efe543bc54c",
                                                "text": "At CCI, where a large number of people cosplay, crossplay becomes a mode to \"stand out.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crossplay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ceeb299-9340-3550-8fbc-7de0cdbb464e",
                                        "entry_id": "23fd48ca-a659-3722-a555-e8348896dece",
                                        "glosses": [
                                            "To cosplay as a character of the opposite sex."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43e380c0-7201-4fb8-9def-4ecc23d517e9",
                                                "sense_id": "4ceeb299-9340-3550-8fbc-7de0cdbb464e",
                                                "text": "[Replying to: \"Really, I'll be wearing a costume as well...] Me too...but I won't be crossplaying..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6048bc5e-8b35-31f2-bf2c-6316042bd72d",
                                        "entry_id": "23fd48ca-a659-3722-a555-e8348896dece",
                                        "glosses": [
                                            "To cosplay as (a character of the opposite sex)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fac9500f-7102-4716-b155-391167357012",
                                                "sense_id": "6048bc5e-8b35-31f2-bf2c-6316042bd72d",
                                                "text": "BTW, one can be a touch hefty and pull off Urd. You don't even have to be a woman. A *guy* crossplayed Urd at C-Kon and won the cosplay contest!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61cd99b1-7301-3708-a58c-b302823e1b54",
                                        "entry_id": "23fd48ca-a659-3722-a555-e8348896dece",
                                        "glosses": [
                                            "To roleplay as a character of the opposite sex, especially in a MUD."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "224850c3-ddd7-4223-9a5e-0f1db0734e4c",
                                                "sense_id": "61cd99b1-7301-3708-a58c-b302823e1b54",
                                                "text": "Admittedly, BruceMud attracted more than its usual share of weenies, but as a female wizard I received even more attention for being female than I did on most other sites. Note that it wasn't exactly a secret that I was crossplaying. I seem to recall Random bitching at Julia for reporting that I was female on more than one occasion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
