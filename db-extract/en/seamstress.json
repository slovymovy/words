                    },
                    {
                        "translation_id": "9b644264-87d4-4569-9d22-7844fa3b0c52",
                        "source_entry_id": "1cbc25bf-67b7-34dd-a9ea-4f6509a8f4fa",
                        "source_sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                        "source_sense_description": "woman who sews clothes professionally",
                        "target_lang_word": "couturière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couturière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59966fb8-c79b-3c34-ad43-367519042d13",
                                        "entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
                                        "glosses": [
                                            "Celle qui invente des costumes, prêt-à-porter ou sur mesure."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6236d6eb-fd37-4a06-9370-96892e48354e",
                                                "sense_id": "59966fb8-c79b-3c34-ad43-367519042d13",
                                                "text": "Pour le désespoir des femmes, sa toilette était irréprochable, et toutes lui envièrent une coupe de robe, une forme de corsage dont l’effet fut attribué généralement à quelque génie de couturière inconnue…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                                        "entry_id": "7a5b9c5d-0979-34ed-94ce-b6b35f26313d",
                                        "glosses": [
                                            "Celle qui exécute des travaux de couture, qui fabrique des vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3abc3b-7f16-486a-9e61-bd36561f05fc",
                                                "sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                                                "text": "Petite couturière. — Couturière en chambre. — Couturière à la journée."
                                            },
                                            {
                                                "example_id": "a795a206-4286-481b-b68d-886616bfc399",
                                                "sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                                                "text": "Je croyais que maman me conduirait chez « Léonie sœurs » qui habille les dames élégantes de la ville. Elle m’a menée chez une couturière en chambre, Mˡˡᵉ Bernet."
                                            },
                                            {
                                                "example_id": "cdcf2da7-7907-4a19-885c-cf3461d64371",
                                                "sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                                                "text": "Elle avait entre vingt-cinq et trente ans. Elle était de taille moyenne, un peu grasse. Ses vêtements étaient faits par une petite couturière, ou alors, s’ils sortaient d’une bonne maison, elle ne savait pas les porter."
                                            },
                                            {
                                                "example_id": "aed185a3-d78b-40e5-a4d2-8c4f34393df6",
                                                "sense_id": "6fee35a4-a1cc-37bd-9f9d-630f4648b2ba",
                                                "text": "C’était Pierson. Il était agenouillé, et avec un mètre de couturière il paraissait très occupé à mesurer le sol. Ses manches étaient retroussées, ses mains tachées de terre, et il y avait une petite pelle à ses côtés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couturière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d333ce68-83d1-327e-9e56-90b62f919fd4",
                                        "entry_id": "1f59684c-09ba-308d-8bda-81388d5209a0",
                                        "glosses": [
                                            "Répétition en costume précédant la générale qui permettait aux couturières de faire les ultimes retouches aux costumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74301494-c587-4125-af67-691c5c0d0a1c",
                                                "sense_id": "d333ce68-83d1-327e-9e56-90b62f919fd4",
                                                "text": "Le public a ainsi l’impression d’assister à ce qu’on appelle « la couturière », terme désignant la dernière répétition avant la générale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "couturière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec54443d-4b6e-3016-a11a-5ebb0d0aea27",
                                        "entry_id": "dbc87b99-e532-398e-b4fa-e2047b614da1",
                                        "glosses": [
                                            "Féminin singulier de couturier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "022909f8-e213-302a-a70b-716740f8665b",
                                        "entry_id": "dbc87b99-e532-398e-b4fa-e2047b614da1",
                                        "glosses": [
                                            "Féminin singulier de couturier.",
                                            "Chaise couturière : chaise à dossier arrondi, utilisée pour les travaux de couture."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "103e244a-9041-44ab-bf8f-d67e8a7540d5",
                                                "sense_id": "022909f8-e213-302a-a70b-716740f8665b",
                                                "text": "Il y a beaucoup de meubles poussiéreux, […] ce qui reste de ce que mon arrière-grand-père avait acheté à la Compagnie des Indes. Je m’assois sur une chaise couturière, très basse, et je regarde par la lucarne, vers le cirque de montagnes qui émerge de l’ombre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0979df6-9b61-461b-a2e7-8ab4c6b2ed26",
                        "source_entry_id": "1cbc25bf-67b7-34dd-a9ea-4f6509a8f4fa",
                        "source_sense_id": "0fbf49f5-906d-3db5-9cde-478e4c2cee7b",
                        "source_sense_description": "woman who sews clothes professionally",
                        "target_lang_word": "Näherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Näherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                        "entry_id": "71dd254c-d039-35b5-8a89-c77a5505c859",
                                        "glosses": [
                                            "weibliche Person, die (meist beruflich) näht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c520b11f-c3da-4266-ac57-d8c94a4aba39",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "Er brachte seine kaputten Hemden zur Näherin."
                                            },
                                            {
                                                "example_id": "6edb511c-d8ee-4f17-b526-6daa5bffe864",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Mama arbeitet nicht mehr in der Produktion, sie hat eine Stelle als Näherin in einem der Kinderheime bekommen.“"
                                            },
                                            {
                                                "example_id": "06ccdf99-321f-46b5-9723-58c0f0fae5cb",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Die Näherin war schon bestellt, der Heiratsvertrag war aufgesetzt, da bekam der Bauer einen Schlaganfall und starb, ohne wieder zu sich gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "57f95e8d-906c-4ee3-a054-86141dbd1d88",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Auch dazu habe ich an anderer Stelle eine Nachkriegsvariante erzählt, wo eine Lehrerin in den Fünfzigerjahren ihre Schülerinnen fragt, was sie denn werden wollten, und die alle brav mit den damals typischen Frauenberufen antworteten: Stenotypistin will die eine werden, Näherin die andere, Kosmetikerin die dritte, und schließlich sagt eine, dass sie Prostituierte werden will.“"
                                            },
                                            {
                                                "example_id": "90520402-8762-40f6-9f50-60d4bfe2a176",
                                                "sense_id": "be6dd66e-154e-3482-b896-b58d5881ff12",
                                                "text": "„Offiziell war er der Singer-Ausbilder für die vielen Näherinnen der Region.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
