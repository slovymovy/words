                                "sense_id": "62062feb-4e4b-3a9b-b102-737dc641924c",
                                "text": "Hansi erhält täglich Pakete."
                            },
                            {
                                "example_id": "73fce4fe-298d-4692-8c52-fcd4b0978726",
                                "sense_id": "62062feb-4e4b-3a9b-b102-737dc641924c",
                                "text": "Dennis hat Hansis Luftmatratze durchlöchert."
                            },
                            {
                                "example_id": "9aaa7250-fce8-41b4-92f3-f17f2c440dba",
                                "sense_id": "62062feb-4e4b-3a9b-b102-737dc641924c",
                                "text": "„Hansi, und mit ihm noch ein paar andere, ist jetzt in einem Alter, in dem wissbegierig und experimentierfreudig alles Neue aufgenommen wird.“"
                            }
