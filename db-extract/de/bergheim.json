                ],
                "senses": [
                    {
                        "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                        "entry_id": "ba9848f3-b7e7-3991-93ed-fbb6b3ea0013",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51a32568-6750-4698-8a16-0d17ff593492",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Frau Bergheim ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d76d7388-4bbd-4a38-b4da-613a15e41f6c",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Herr Bergheim wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fa61169c-c4fa-4a90-8570-1c85ad47a277",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Die Bergheims fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cce16578-1b7c-4712-a23d-f90cb9599061",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Der Bergheim trägt nie die Schals, die die Bergheim ihm strickt."
                            },
                            {
                                "example_id": "ec909b08-eb17-42d6-b05e-018b85ef3dea",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau ´Bergheim kommt, geht der Herr Bergheim.“"
                            },
                            {
                                "example_id": "a5a86454-065f-4b2c-895b-8c0a032e77a6",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Bergheim kommt und geht."
                            },
                            {
                                "example_id": "0bac4fa6-2f83-46b1-bb0a-f54ca73a3a0c",
                                "sense_id": "53be42f0-3843-3804-a912-88ad1723f139",
                                "text": "Bergheims kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
