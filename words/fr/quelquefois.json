                {
                    "sense_id": "0d38440e-5cb9-35de-a7b7-53431cc574e4",
                    "sense_definition": "Au cas où, à tout hasard.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eventualite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Emporte un pull chaud avec toi, <w>quelquefois</w> que la soirée se rafraîchisse.",
                            "target_lang_translations": {
                                "en": "Take a warm sweater with you, <w>just in case</w> the evening gets cooler.",
                                "ru": "Возьми с собой тёплый свитер <w>на всякий случай</w>, вдруг вечер станет прохладнее.",
                                "nl": "Neem een warme trui mee, <w>voor het geval dat</w> de avond koeler wordt.",
                                "de": "Nimm <w>vorsichtshalber</w> einen warmen Pullover mit, falls der Abend kühler wird.",
                                "pl": "Weź ze sobą ciepły sweter <w>na wypadek</w>, gdyby wieczór się ochłodził.",
                                "it": "Porta con te un maglione caldo, <w>caso mai</w> la serata si rinfreschi.",
                                "cs": "Vezmi si s sebou teplý svetr <w>pro jistotu</w>, kdyby se večer ochladil.",
                                "tr": "Yanına sıcak bir kazak al, <w>olur ya</w> akşam hava serinler.",
                                "es": "Llévate contigo un jersey abrigado, <w>por si acaso</w> la noche se pone más fresca.",
                                "zh": "你带件暖和的毛衣，<w>以防万一</w>晚上变凉。"
                            }
                        },
                        {
                            "text": "Regarde bien au fond du placard, <w>quelquefois</w> qu'il y aurait encore du café.",
                            "target_lang_translations": {
                                "en": "Look carefully at the back of the cupboard, <w>just in case</w> there is still some coffee left.",
                                "ru": "Посмотри хорошенько в глубине шкафа, <w>вдруг</w> там ещё остался кофе.",
                                "nl": "Kijk goed achterin de kast, <w>voor het geval dat</w> er nog koffie over is.",
                                "de": "Schau im Schrank ganz hinten nach, <w>für alle Fälle</w>, vielleicht ist noch Kaffee da.",
                                "pl": "Zajrzyj dobrze w głąb szafki, <w>na wszelki wypadek</w> - może jeszcze zostało trochę kawy.",
                                "it": "Guarda bene in fondo all'armadietto, <w>caso mai</w> ci fosse ancora del caffè.",
                                "cs": "Pořádně se podívej vzadu do skříňky, <w>pro každý případ</w>, kdyby tam ještě zbývala káva.",
                                "tr": "Dolabın dibine iyice bak; <w>olur ya</w> hâlâ biraz kahve kalmıştır.",
                                "es": "Mira bien al fondo del armario, <w>por si acaso</w> todavía queda café.",
                                "zh": "仔细看看柜子深处，<w>万一</w>还剩点咖啡呢。"
                            }
                        }
