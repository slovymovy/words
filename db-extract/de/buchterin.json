                "senses": [
                    {
                        "sense_id": "ec724b8b-082f-3d20-8610-67df5b63c65b",
                        "entry_id": "8db54079-62db-32ad-a7a1-5f47a5a9707b",
                        "glosses": [
                            "Namibia Spitzname für eine Bewohnerin der Lüderitzbucht, insbesondere für eine Einwohnerin der in dieser Bucht gelegenen Stadt Lüderitz"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b5823587-b35d-4856-aae9-e7cd7806bb8e",
                                "sense_id": "ec724b8b-082f-3d20-8610-67df5b63c65b",
                                "text": "„‚[…]Was haben wir ihnen getan, dass sie das mit uns machen?‘, sagt die 23-jährige ‚Buchterin‘, die in der Hauptstadt bei einer Aids-Initiative arbeitet.“"
                            },
                            {
                                "example_id": "9809f47b-613a-4dc6-be9e-9f95b04554ca",
                                "sense_id": "ec724b8b-082f-3d20-8610-67df5b63c65b",
                                "text": "„‚Ich bin enttäuscht und verstört, dass die Mächtigen uns das einfach aufzwängen wollen‘, sagte etwa die 23-jährige ‚Buchterin‘ Justine Hamupolo einer Zeitung, die über den kuriosen Namenstreit berichtete.“"
                            },
                            {
                                "example_id": "5e58cb2f-4e56-4a4b-adb2-9069bc44faa0",
                                "sense_id": "ec724b8b-082f-3d20-8610-67df5b63c65b",
                                "text": "„Laut van Gysen hatte bei dem Treffen zunächst die Buchterin Christel Jantjies das Wort, die auf die Gesetzgebung hingewiesen hatte und somit deutlich machte, dass die Namensänderung nicht rechtmäßig abgelaufen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
