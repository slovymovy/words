        "nl-extract.jsonl": [
            {
                "entry_id": "279f7a8a-681a-3350-9595-0d005d0fa580",
                "word": "daarginder",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b73abd64-2656-3b74-a4f5-25d93b55a03f",
                        "entry_id": "279f7a8a-681a-3350-9595-0d005d0fa580",
                        "glosses": [
                            "daar in de verte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d867618b-db13-40fd-a292-323eb811371c",
                                "sense_id": "b73abd64-2656-3b74-a4f5-25d93b55a03f",
                                "text": "Ik moet van Amsterdam naar Groningen, want daarginder wachten mensen op me die zich met Groningse groene zeep hebben gewassen om een hele avond naar me te luisteren."
                            },
                            {
                                "example_id": "efd39c3d-343d-4565-92d9-85e8a22e622d",
                                "sense_id": "b73abd64-2656-3b74-a4f5-25d93b55a03f",
                                "text": "Alle herinneringen aan de afgelopen periode in de grote wachtkamer daarginder zijn al gewist, maar vlak voordat we de lift instappen drukt de engel van dienst, om die procedure te bezegelen, nog heel even zijn wijsvinger tegen het zachtje stukje huid tussen neus en mond."
                            },
                            {
                                "example_id": "d16db724-0bc5-4c0b-a195-32c52c35b08a",
                                "sense_id": "b73abd64-2656-3b74-a4f5-25d93b55a03f",
                                "text": "Over de weg richting Reet, onder Antwerpen, gaat de zondagse wielerkoers. De bomen kleuren goud en vrijwilligers in stewardhesjes genieten in de berm van een eerste pint. Dit is het zonovergoten pastorale leven zoals Vlaams Belang-voorzitter Gerolf Annemans het graag ziet. Op recreatieterrein De Schorre wijst hij naar de blauwe hemel. „Wij hebben een goeie connectie met daarginder boven.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "96f689ea-96f3-44d7-b6db-20392e9788b1",
                        "source_entry_id": "279f7a8a-681a-3350-9595-0d005d0fa580",
                        "source_sense_id": "b73abd64-2656-3b74-a4f5-25d93b55a03f",
                        "target_lang_word": "over there",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "over there",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                        "entry_id": "f324955b-1d1d-3477-829b-0cf6d83881c1",
                                        "glosses": [
                                            "In that place; there (at some distance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22c9367e-0960-40c8-9a3e-316660282464",
                                                "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                                "text": "You see that house over there? That's where I used to live."
                                            },
                                            {
                                                "example_id": "5bcc92d5-85f6-4738-9ecc-a31e43c45b39",
                                                "sense_id": "4c8aa7c7-b267-385f-b724-490ed38aa7dd",
                                                "text": "Shepard: I'm looking for an asari.\nDr. Palon: Asari? Well, there's Dr. Iallis over there.\nDr. Palon: There's also our guest, Lady Benezia. Captain Ventralis might know where she is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8183779e-4824-343e-9f15-7fcdeaa1b8e2",
                                        "entry_id": "f324955b-1d1d-3477-829b-0cf6d83881c1",
                                        "glosses": [
                                            "To that place; thither (at some distance)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a817f239-ed59-4d6c-961d-33d7717e3fb2",
                                                "sense_id": "8183779e-4824-343e-9f15-7fcdeaa1b8e2",
                                                "text": "Let's head over there."
                                            }
                                        ]
                                    },
                                    {
