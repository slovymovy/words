        "fr-extract.jsonl": [
            {
                "entry_id": "08755132-5371-358c-a79f-a39a3cf35d8b",
                "word": "retournement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d1cdda2c-5103-482f-9855-b1c09918ceb7",
                        "entry_id": "08755132-5371-358c-a79f-a39a3cf35d8b",
                        "tags": [
                            "plural"
