                        "examples": [
                            {
                                "example_id": "1fc79dac-59d4-44c0-aad2-c804aeb743e6",
                                "sense_id": "11ede2db-b31c-39af-b44a-d8d765ba956a",
                                "text": "Meine Freundin und ich haben bisher nur Petting gemacht."
                            },
                            {
                                "example_id": "fbf0100d-707d-48eb-a82a-3b86ea18bfb0",
                                "sense_id": "11ede2db-b31c-39af-b44a-d8d765ba956a",
                                "text": "„Junge Leute beginnen meistens in der Form des Petting ihre ersten sexuellen Erfahrungen zu sammeln, mit Liebkosungen, Streicheln, Küssen oder sich aneinander schmiegen.“"
                            },
                            {
                                "example_id": "cb53f8e5-0d43-4abb-8914-cfa98a55fe08",
                                "sense_id": "11ede2db-b31c-39af-b44a-d8d765ba956a",
                                "text": "„In seinem ersten Studienjahr hatte Roth sein Glück bei Cheerleaderinnen wie Pat McCall und Annette Littlefield versucht, die jedoch in Sachen Petting gar nichts zuließen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
