                                "target_senses": [
                                    {
                                        "sense_id": "f9c0d7ff-e11e-3205-afd9-ec12a28981c8",
                                        "entry_id": "0a635543-be32-3b43-a91e-5adccb4c4889",
                                        "glosses": [
                                            "zart gebaut, zierlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3d29f55-e729-4e4f-b9d7-71c6431ada1a",
                                                "sense_id": "f9c0d7ff-e11e-3205-afd9-ec12a28981c8",
                                                "text": "„Mal ließ sie ihre Models grazil und zerbrechlich, mal kriegerisch und dominant über den Laufsteg schreiten. Die Kollektion spielte mit Androgynie, sie vereinte sinnlich-weibliche Elemente mit männlich-kriegerischen und verlieh der femininen Silhouette bisweilen kühle Dominanz.“"
                                            },
                                            {
                                                "example_id": "efc1c244-1d1c-4d9e-867b-1bb3a62ebcbc",
                                                "sense_id": "f9c0d7ff-e11e-3205-afd9-ec12a28981c8",
                                                "text": "„Es war eine unsäglich feine Figur: schlank, grazile Glieder, geistvolles Profil, griechische Nase. Dunkle, glattgescheitelte Lockenwellen fielen über Schläfe, Ohr und Nacken; ein durchsichtiger, jünglinghafter Flaum bedeckte Kinn und Lippen.“"
                                            },
                                            {
                                                "example_id": "284ff113-d13c-4e30-ba37-bae8a6777404",
                                                "sense_id": "f9c0d7ff-e11e-3205-afd9-ec12a28981c8",
                                                "text": "„»Nichts hindert Sie, mir in einem Auto zu folgen. Meine Frauen« – sie wandte sich an die jungen, grazilen Malayinnen – »ziehen, wie ich sie kenne, Pferde dem Benzinkasten vor.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
