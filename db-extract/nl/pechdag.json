                            {
                                "example_id": "870bbe3d-e2d7-431c-8e61-a6b2e879cd56",
                                "sense_id": "c1516b56-ca3c-3705-88cd-a083f629d848",
                                "text": "Het is een ongekende pechdag voor honderden Nederlandse vakantiegangers onderweg naar de Dominicaanse Republiek. Door een blikseminslag in hun vliegtuig en een aanrijding van het vervangende toestel vertraagt hun vlucht met dagen."
                            },
                            {
                                "example_id": "077045c6-db76-4071-bf48-b40d762dfe71",
                                "sense_id": "c1516b56-ca3c-3705-88cd-a083f629d848",
                                "text": "Voor Annemiek van Vleuten is 7 augustus een serieuze pechdag. In 2015 én 2016 belandde de wielrenster op deze dag in het ziekenhuis."
                            }
                        ]
