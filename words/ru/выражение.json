                                "target_lang_sense_clarification": "传达思想或情感的行为"
                            },
                            {
                                "target_lang_word": "表示",
                                "target_lang_sense_clarification": "通过言语或行为显露"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76909f58-0748-3224-bfa1-49f9ca94e630",
                    "sense_definition": "Совокупность математических знаков, чисел и символов, описывающая отношения между величинами.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ученик должен был упростить сложное алгебраическое <w>выражение</w>.",
                            "target_lang_translations": {
                                "en": "The student had to simplify a complex algebraic <w>expression</w>.",
                                "tr": "Öğrenci karmaşık bir cebirsel <w>ifadeyi</w> sadeleştirmek zorundaydı.",
                                "zh": "学生必须化简一个复杂的代数<w>表达式</w>。"
                            }
                        },
                        {
                            "text": "Чтобы решить задачу, нужно правильно составить числовое <w>выражение</w>.",
                            "target_lang_translations": {
                                "en": "To solve the problem, one needs to correctly compose a numerical <w>expression</w>.",
                                "tr": "Problemi çözmek için sayısal <w>ifadeyi</w> doğru kurmak gerekir.",
                                "zh": "为了解决这个问题，需要正确列出数值<w>算式</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "алгебраическое выражение",
                        "числовое выражение",
                        "значение выражения",
                        "упростить выражение"
                    ],
                    "target_lang_definitions": {
                        "en": "A combination of mathematical signs, numbers, and symbols describing relationships between quantities.",
                        "tr": "Büyüklükler arasındaki ilişkileri tanımlayan matematiksel işaretler, sayılar ve semboller topluluğu.",
                        "zh": "指由数学符号、数字和变量组成的，描述量与量之间关系的式子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expression",
                                "target_lang_sense_clarification": "mathematical formula"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ifade",
                                "target_lang_sense_clarification": "matematiksel formül veya terim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表达式",
                                "target_lang_sense_clarification": "数学式子"
                            },
                            {
                                "target_lang_word": "算式",
                                "target_lang_sense_clarification": "数值计算的式子"
                            }
                        ]
                    }
                }
            ]
        }
