{
    "word_family": [
        "понятный",
        "понимать",
        "понимание",
        "понятие",
        "понятливость"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "95f0e7c0-75bc-3e66-ab0f-89920e3ee8ab",
                    "sense_definition": "Оценка ситуации или чьих-либо действий как ясных, очевидных и не вызывающих сомнений.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "predicative_clear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне сразу стало <w>понятно</w>, что мы заблудились в лесу.",
                            "target_lang_translations": {
                                "en": "It immediately became <w>clear</w> to me that we were lost in the forest.",
                                "zh": "我立刻<w>清楚</w>我们迷路了。"
                            }
                        },
                        {
                            "text": "Теперь всё <w>понятно</w>, вопросов больше нет.",
                            "target_lang_translations": {
                                "en": "Now everything is <w>clear</w>, there are no more questions.",
                                "zh": "现在一切都<w>清楚</w>了，没问题了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ясно",
                        "очевидно"
                    ],
                    "antonyms": [
                        "непонятно",
                        "неясно",
                        "туманно"
                    ],
                    "common_phrases": [
                        "всё понятно",
                        "мне понятно",
                        "стало понятно"
                    ],
                    "target_lang_definitions": {
                        "en": "Describes a situation or action as clear, obvious, and leaving no doubt.",
                        "zh": "形容情况或行为清晰、显而易见，不容置疑。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "adjective/predicative, obvious"
                            },
                            {
                                "target_lang_word": "obvious",
                                "target_lang_sense_clarification": "easily perceived or understood"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清楚",
                                "target_lang_sense_clarification": "形容情况明了"
                            },
                            {
                                "target_lang_word": "显然",
                                "target_lang_sense_clarification": "显而易见"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55f5539d-3cbc-312b-9b2b-6d8ba5777f92",
                    "sense_definition": "Доступно для понимания, вразумительно, разборчиво.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "manner_clear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Учитель объяснял новую тему очень <w>понятно</w> и интересно.",
                            "target_lang_translations": {
                                "en": "The teacher explained the new topic very <w>clearly</w> and interestingly.",
                                "zh": "老师把新课题讲得非常<w>清楚</w>且有趣。"
                            }
                        },
                        {
                            "text": "Постарайся написать адрес <w>понятно</w>, чтобы письмо дошло.",
                            "target_lang_translations": {
                                "en": "Try to write the address <w>clearly</w> so the letter arrives.",
                                "zh": "尽量把地址写得<w>清楚</w>些，好让信能寄到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "вня́тно",
                        "я́сно",
                        "доходчиво",
                        "доступно"
                    ],
                    "antonyms": [
                        "непонятно",
                        "запутанно"
                    ],
                    "common_phrases": [
                        "говорить понятно",
                        "объяснять понятно"
                    ],
                    "target_lang_definitions": {
                        "en": "In a way that is easy to understand, hear, or read.",
                        "zh": "以容易理解、听清或看清的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clearly",
                                "target_lang_sense_clarification": "in a clear manner"
                            },
                            {
                                "target_lang_word": "understandably",
                                "target_lang_sense_clarification": "in an intelligible manner"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清楚地",
                                "target_lang_sense_clarification": "以清晰的方式"
                            },
                            {
                                "target_lang_word": "易懂地",
                                "target_lang_sense_clarification": "以容易理解的方式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "eb0d8816-2e75-333c-8c74-d70d17fff572",
                    "sense_definition": "Слово, используемое для выражения согласия или подтверждения того, что информация принята.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Завтра встречаемся в семь. — <w>Понятно</w>, я буду вовремя.",
                            "target_lang_translations": {
                                "en": "— We are meeting tomorrow at seven. — <w>Got it</w>, I will be on time.",
                                "zh": "— 明天七点见。— <w>明白</w>，我会准时到。"
                            }
                        },
                        {
                            "text": "Вам <w>понятно</w> ваше домашнее задание?",
                            "target_lang_translations": {
                                "en": "Is your homework <w>clear</w> to you?",
                                "zh": "你<w>明白</w>你的家庭作业了吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "я́сно",
                        "хорошо",
                        "ладно"
                    ],
                    "common_phrases": [
                        "ну понятно",
                        "всё понятно"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное выражение согласия"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express agreement, confirmation, or that information has been received.",
                        "zh": "用于表示同意、确认或已收到信息。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "got it",
                                "target_lang_sense_clarification": "informal confirmation"
                            },
                            {
                                "target_lang_word": "I see",
                                "target_lang_sense_clarification": "acknowledgment of information"
                            },
                            {
                                "target_lang_word": "understood",
                                "target_lang_sense_clarification": "formal confirmation"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "知道了",
                                "target_lang_sense_clarification": "非正式确认"
                            },
                            {
                                "target_lang_word": "明白",
                                "target_lang_sense_clarification": "确认已理解信息"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bae48c6-2ae4-3a19-a5e7-bc703bfa3847",
                    "sense_definition": "Вводное слово, выражающее уверенность говорящего; соответствует словам «конечно», «разумеется».",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parenthetical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы, <w>понятно</w>, поможем вам с переездом в новую квартиру.",
                            "target_lang_translations": {
                                "en": "We, <w>naturally</w>, will help you with the move to the new apartment.",
                                "zh": "我们<w>当然</w>会帮你搬进新公寓。"
                            }
                        },
                        {
                            "text": "Он, <w>понятно</w>, не хотел признавать свою ошибку перед всеми.",
                            "target_lang_translations": {
                                "en": "He, <w>understandably</w>, did not want to admit his mistake in front of everyone.",
                                "zh": "他<w>当然</w>不想在大家面前承认自己的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "конечно",
                        "есте́ственно",
                        "разуме́ется"
                    ],
                    "common_phrases": [
                        "понятно что"
                    ],
                    "target_lang_definitions": {
                        "en": "A parenthetical word expressing that something is natural, expected, or understandable.",
                        "zh": "插入语，表示某事是自然的、预料之中的或可以理解的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "naturally",
                                "target_lang_sense_clarification": "as might be expected"
                            },
                            {
                                "target_lang_word": "of course",
                                "target_lang_sense_clarification": "certainly, obviously"
                            },
                            {
                                "target_lang_word": "understandably",
                                "target_lang_sense_clarification": "for reasons that are easy to understand"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "当然",
                                "target_lang_sense_clarification": "理所当然"
                            },
                            {
                                "target_lang_word": "自然",
                                "target_lang_sense_clarification": "意料之中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d6941edd-5bd9-3363-a73e-5e74b1bea457",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>понятный</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "adj_short",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это правило просто и <w>понятно</w> каждому ученику.",
                            "target_lang_translations": {
                                "en": "This rule is simple and <w>understandable</w> to every student.",
                                "zh": "这条规则对每个学生来说都很简单且<w>易懂</w>。"
                            }
                        },
                        {
                            "text": "Твоё желание мне вполне <w>понятно</w>.",
                            "target_lang_translations": {
                                "en": "Your wish is quite <w>understandable</w> to me.",
                                "zh": "你的愿望我完全<w>理解</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "краткая форма прилагательного"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Capable of being understood; intelligible.",
                        "zh": "能够被理解的；可理解的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "understandable",
                                "target_lang_sense_clarification": "able to be understood"
                            },
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "easy to perceive or understand"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可理解",
                                "target_lang_sense_clarification": "能够被理解"
                            },
                            {
                                "target_lang_word": "清楚",
                                "target_lang_sense_clarification": "容易感知或理解"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}