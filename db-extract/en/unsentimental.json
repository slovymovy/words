                "senses": [
                    {
                        "sense_id": "f8e021cc-ffb9-33fd-ab95-cac9811f7938",
                        "entry_id": "df91475e-bc17-315b-b078-4041b8a519e9",
                        "glosses": [
                            "Not sentimental."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7787a0c5-7a09-462e-a3fa-a4ef5e15e8a2",
                                "sense_id": "f8e021cc-ffb9-33fd-ab95-cac9811f7938",
                                "text": "The traditional British signal is on its way out. Unsentimental officials will doubtless decree colour-lights from Kings Cross to Waverley, and from Paddington to Penzance, with upper quadrants on minor branches."
                            },
                            {
                                "example_id": "9cf79c79-981a-483f-9c15-a077c5120a39",
                                "sense_id": "f8e021cc-ffb9-33fd-ab95-cac9811f7938",
                                "text": "But my favorite line of the sequence, and possibly the entire episode, is Homer asking his deeply irritated elderly neighbor, “Trying to run out the clock in Florida, eh?” That’s such a brutally funny, boldly unsentimental and coldly true bit of dialogue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6017365d-b954-4a97-9e8b-f67c5c1e4995",
