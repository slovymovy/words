                        "sense_id": "6f50e396-6bda-3527-8270-a3b07326595d",
                        "entry_id": "5cf9f5bf-0cbd-3966-b8cc-5b58ca2abe8d",
                        "glosses": [
                            "To decline rapidly in health (but not as rapidly as crash)."
                        ],
                        "tags": [
                            "US",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a6ecf82e-49b9-488c-9fb7-1068b72dde09",
                                "sense_id": "6f50e396-6bda-3527-8270-a3b07326595d",
                                "text": "I can only be in one place at a time, so sometimes I just have to say, “Listen, I’ve got this other patient that’s crumping down the hall.[”]"
                            },
                            {
                                "example_id": "3ec3cda7-a81e-42d1-98a6-90800e59c7c8",
                                "sense_id": "6f50e396-6bda-3527-8270-a3b07326595d",
                                "text": "if the patient is acutely crumping from cardiac arrest, do not waste time doing an ECG when you could be performing CPR."
                            },
                            {
                                "example_id": "04a05df1-c7ea-419d-b743-956ce71693ba",
                                "sense_id": "6f50e396-6bda-3527-8270-a3b07326595d",
                                "text": "Not to be confused with the dance style, doctors use 'crumping' when they have a patient that is 'crashing, but not aggressively,' the Chicago doctor told Daily Mail Online."
                            }
                        ]
                    }
                ],
