                "senses": [
                    {
                        "sense_id": "03a52b0e-88a0-3ea7-916b-b48488c9851b",
                        "entry_id": "24aba46e-f6e1-356c-91a8-69fe83d41353",
                        "glosses": [
                            "starożytny żydowski pisarz, autor Księgi Koheleta"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "3f1241ae-ba3b-49bb-8f84-0ed7315365bf",
                                "sense_id": "03a52b0e-88a0-3ea7-916b-b48488c9851b",
                                "text": "Eklezjastes zabierał głos na zebraniach synagogalnych."
                            },
                            {
                                "example_id": "84be6e8c-73ad-4e73-a274-224e4ecd0954",
                                "sense_id": "03a52b0e-88a0-3ea7-916b-b48488c9851b",
                                "text": "Waga słów Eklezjastesa jest tak wielka, jak gdyby wypowiedział je sam mądry król Salomon."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
