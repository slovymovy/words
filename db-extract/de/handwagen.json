                "senses": [
                    {
                        "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                        "entry_id": "8565bef1-9cf9-3f69-9c5b-84b4d00ec644",
                        "glosses": [
                            "kleiner Wagen, den man „mit der Hand“ hinter sich herziehen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d6013a5-282c-46df-9807-74ab7853bc47",
                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                "text": "Für den Abtransport der Abfälle hatten wir nur einen Handwagen zur Verfügung."
                            },
                            {
                                "example_id": "eaaa1ef1-6455-4eb5-8d31-5894ec7bca64",
                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                "text": "„Jetzt kam der Mann nach Haus, offensichtlich aus dem Wald, denn er hatte hinter dem Haus Holz aus einem Handwagen abgeladen.“"
                            },
                            {
                                "example_id": "75e2c864-a64c-4d1c-8e99-28603eff0a10",
                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                "text": "„Nach der Zerstörung der Bahnstation und einiger Wohnhäuser am Südende von Velda wurde die Evakuierung angeordnet, und die Dörfler machten sich mit Handwagen und Ochsenkarren auf den Weg.“"
                            },
                            {
                                "example_id": "a9ee5a4a-5e0b-47ca-bb86-0ebdd316924b",
                                "sense_id": "d912547d-7bca-3ec5-acd6-90c3e41d5a33",
                                "text": "„Es gab nur ein kurzes rhythmisches Geräusch, das von dem Quietschen und Rassseln eines mit etwas Unheimlichem beladenen, kleinen Handwagen kam, den ein Junge über die Straße zog, und vom Klappern seiner Holzsohlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
