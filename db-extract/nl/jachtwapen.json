                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8432971c-f322-43c4-9201-ccbf8b746893",
                                "sense_id": "90e3f0cf-3c89-3bd3-82fb-7a377ce1eff3",
                                "text": "De schutter heeft mogelijk een jachtwapen gebruikt. De politie onderzoekt vanaf waar is geschoten. Mogelijk gebeurde dat vanaf een viaduct over de A7."
                            },
                            {
                                "example_id": "65d6b2a9-c2a3-4fea-ab31-68d10681d191",
                                "sense_id": "90e3f0cf-3c89-3bd3-82fb-7a377ce1eff3",
                                "text": "De openbaar aanklaagster eiste een boete van 50.000 euro, intrekking van de jachtvergunning en in beslagname van het jachtwapen. Het OM kan nog in hoger beroep tegen de uitspraak maar is dat volgens Fülscher niet van plan."
                            }
                        ]
                    }
