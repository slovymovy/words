                        "entry_id": "771b9eea-402c-3a4d-a2fd-068639ea1bbd",
                        "glosses": [
                            "Innate, possessed by an organism at birth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c71a5f48-74a7-43ff-a21a-1bf250001e26",
                                "sense_id": "5e602cbd-9712-31c5-8d14-8a78bfddabf5",
                                "text": "inborn talent"
                            },
                            {
                                "example_id": "50aa1c62-b42e-4d98-bbe0-443bb238c4ea",
                                "sense_id": "5e602cbd-9712-31c5-8d14-8a78bfddabf5",
                                "text": "inborn instincts"
                            },
                            {
                                "example_id": "b19d84dd-61eb-42ea-8a40-482eac707b15",
                                "sense_id": "5e602cbd-9712-31c5-8d14-8a78bfddabf5",
                                "text": "However, a scientific study just published in American Psychologist provides strong reasons to doubt that there are many inborn differences between genders."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d58e5f8-da1b-34ac-894d-099ea63437ec",
