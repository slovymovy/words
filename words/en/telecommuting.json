{
    "word_family": [
        "telecommute",
        "telecommuter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b1b72d27-38f4-3bf0-96bd-259b6629734f",
                    "sense_definition": "The practice of working from a remote location, such as home, using telecommunications technology.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remote_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many companies now offer <w>telecommuting</w> as a standard benefit for their employees.",
                            "target_lang_translations": {
                                "ru": "Многие компании сейчас предлагают <w>удалённую работу</w> в качестве стандартного бонуса для своих сотрудников."
                            }
                        },
                        {
                            "text": "The rise of <w>telecommuting</w> has significantly reduced the number of daily commuters on the road.",
                            "target_lang_translations": {
                                "ru": "Распространение <w>удалённой работы</w> значительно сократило количество людей, ежедневно добирающихся на работу по дорогам."
                            }
                        }
                    ],
                    "synonyms": [
                        "working from home",
                        "teleworking",
                        "remote work"
                    ],
                    "common_phrases": [
                        "allow telecommuting",
                        "support telecommuting",
                        "increase telecommuting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика выполнения работы из удалённого места, например из дома, с использованием телекоммуникационных технологий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удалённая работа",
                                "target_lang_sense_clarification": "наиболее общепринятый и нейтральный термин"
                            },
                            {
                                "target_lang_word": "удалёнка",
                                "target_lang_sense_clarification": "разговорный, очень популярный термин"
                            },
                            {
                                "target_lang_word": "дистанционная работа",
                                "target_lang_sense_clarification": "официальный термин, часто используемый в трудовых договорах"
                            },
                            {
                                "target_lang_word": "работа из дома",
                                "target_lang_sense_clarification": "описательный термин, подчеркивающий место выполнения работы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bafc8ce1-ed40-3f3c-8317-5095ddbc3d44",
                    "sense_definition": "The present participle and gerund of <w>telecommute</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remote_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>telecommuting</w> from a small cabin in the mountains.",
                            "target_lang_translations": {
                                "ru": "В настоящее время она <w>работает удалённо</w> из небольшого домика в горах."
                            }
                        },
                        {
                            "text": "He enjoys <w>telecommuting</w> because it gives him more time with his family.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>работать удалённо</w>, потому что это даёт ему больше времени для общения с семьёй."
                            }
                        }
                    ],
                    "common_phrases": [
                        "start telecommuting",
                        "keep telecommuting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb telecommute."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «работать удалённо»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "работающий удалённо",
                                "target_lang_sense_clarification": "причастие, описывающее процесс или состояние"
                            },
                            {
                                "target_lang_word": "удалённая работа",
                                "target_lang_sense_clarification": "герундиальное значение, обозначающее сам процесс"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}