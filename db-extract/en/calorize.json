                ],
                "senses": [
                    {
                        "sense_id": "34ea6644-8314-3055-b77c-fb5e108f62d9",
                        "entry_id": "84752796-6f7f-3567-9546-897ebc766b15",
                        "glosses": [
                            "To follow a diet that focuses on the number of calories in food."
                        ],
                        "tags": [
                            "dated",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d2a2523b-e3cf-4099-945d-751fd05e75bd",
                                "sense_id": "34ea6644-8314-3055-b77c-fb5e108f62d9",
                                "text": "She too is calorizing. She will retain her flapper figure--- and starve herself to do it!"
                            },
                            {
                                "example_id": "0d1fb705-348d-4249-bf2b-f1358f09747f",
                                "sense_id": "34ea6644-8314-3055-b77c-fb5e108f62d9",
                                "text": "Mr. Coffey does not tell us whether he accomplished this admirable stabilization of his avoirdupois by exercising, by calorizing, or by reading James Joyce."
                            },
                            {
                                "example_id": "b95a6cd9-3e76-42e2-8114-5742b5ba31f2",
                                "sense_id": "34ea6644-8314-3055-b77c-fb5e108f62d9",
                                "text": "He will vitaminize and calorize you into gaining weight."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec54e53c-7880-38e8-97a8-802710eaba10",
                        "entry_id": "84752796-6f7f-3567-9546-897ebc766b15",
                        "glosses": [
                            "To provide information about the number of calories in (a food item)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "373ee39f-3670-4778-8308-103a20fe51ad",
                                "sense_id": "ec54e53c-7880-38e8-97a8-802710eaba10",
                                "text": "Candy calorized has endeavored to show a woman that she puts on no more pounds eating candy than she does eating something else."
                            },
                            {
                                "example_id": "c4c36fe8-c233-46d3-9921-4f2a9cbefa63",
                                "sense_id": "ec54e53c-7880-38e8-97a8-802710eaba10",
                                "text": "Diet Plan: l3 to l4 days of completely calorized menus with the all-important basic four food groups included in each meal."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ab2f55f-ef50-3bc7-ac64-acb36f3afe64",
                        "entry_id": "84752796-6f7f-3567-9546-897ebc766b15",
                        "glosses": [
                            "To make (food) with high-calorie ingredients."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e33e027e-bdf3-448f-b9ce-923849540690",
                                "sense_id": "0ab2f55f-ef50-3bc7-ac64-acb36f3afe64",
                                "text": "While calorized feeds for poultry were being developed, scientists were also looking into an improved milk replacer for calves."
                            }
                        ]
                    }
