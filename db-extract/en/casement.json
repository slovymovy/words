                                        "sense_id": "6fe64562-2010-34d2-adbb-721401506221",
                                        "entry_id": "28b95c54-8fd3-31d4-82ff-91b432675f65",
                                        "glosses": [
                                            "Teil eines mindestens zweiteiligen Fensters"
                                        ],
                                        "tags": [],
