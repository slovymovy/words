    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2baec9b4-7869-3dfc-8a20-3d6637a58559",
                    "sense_definition": "To vibrate or produce a sound in response to another vibration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vibration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The glass began to <w>resonate</w> when the singer hit a high note."
                        },
                        {
                            "text": "The floorboards <w>resonate</w> with every heavy step taken in the hallway."
                        }
                    ],
                    "synonyms": [
                        "vibrate",
                        "reverberate"
                    ],
                    "common_phrases": [
                        "resonate with sound"
                    ]
                },
                {
                    "sense_id": "4aa9fc7a-c168-3dca-abc0-55b0f12fa35e",
                    "sense_definition": "To have a significant impact or influence on people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's message <w>resonates</w> with voters who are tired of the status quo."
                        },
                        {
                            "text": "Her powerful speech <w>resonated</w> deeply with the entire audience."
                        }
                    ],
                    "synonyms": [
                        "impact",
                        "influence"
                    ],
                    "common_phrases": [
                        "resonate with audience",
                        "resonate with public"
                    ]
                },
                {
                    "sense_id": "602f5496-16d8-3766-91dc-828f758f8e34",
                    "sense_definition": "To feel a sense of agreement or emotional connection with an idea or experience.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>resonate</w> with the themes of loss and hope in this novel."
                        },
                        {
                            "text": "Many people <w>resonate</w> with the idea that work-life balance is essential for happiness."
                        }
                    ],
                    "synonyms": [
                        "empathize",
                        "identify"
                    ],
                    "common_phrases": [
