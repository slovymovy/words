    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                "word": "inwardness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "37c7debf-865e-4d3f-9535-434485645253",
                        "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "tags": [
                            "plural"
                        ],
                        "form": "inwardnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1e7c17b-c2e6-37eb-9ea2-aac4dd0bdf84",
                        "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "glosses": [
                            "The characteristic of being inward or directed towards the inside."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "12a3b1fa-638d-3154-92ee-2bc086be056f",
                        "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "glosses": [
                            "The internal or true state; the essential nature."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7adaecd2-86f5-4f54-a732-80868c9461c2",
                                "sense_id": "12a3b1fa-638d-3154-92ee-2bc086be056f",
                                "text": "the inwardness of conduct"
                            },
                            {
                                "example_id": "5e5b8207-2649-4129-bf35-a8ffcdad60b5",
                                "sense_id": "12a3b1fa-638d-3154-92ee-2bc086be056f",
                                "text": "Sense cannot arrive at th’inwardness of things."
                            }
                        ]
                    },
                    {
                        "sense_id": "14b96646-7984-32e6-8670-c11ed31ea027",
                        "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "glosses": [
                            "Familiarity; intimacy."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "669a7e5b-f7fe-4ceb-ab9a-548417165e10",
                                "sense_id": "14b96646-7984-32e6-8670-c11ed31ea027",
                                "text": "Signior Leonato, let the friar advise you: / And though you know my inwardness and love / Is very much unto the prince and Claudio, / Yet, by mine honour, I will deal in this / As secretly and justly as your soul / Should with your body."
                            }
                        ]
                    },
                    {
                        "sense_id": "c24b4ea6-5567-39cc-abc1-95bb60316f4f",
                        "entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "glosses": [
                            "Earnestness; heartiness."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "2af24ea4-e3ac-4202-bf3a-586977f2a4f1",
                                "sense_id": "c24b4ea6-5567-39cc-abc1-95bb60316f4f",
                                "text": "The prophets perpetually reminded their nation of the superiority of judgment and justice to any exterior ceremony like sacrifice. […] [W]hat was wanted was more inwardness, more feeling. This was given by adding mercy and humbleness to judgment and justice."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cea31d66-aa25-44e2-bd86-c27957598cc2",
                        "source_entry_id": "16f7f4b9-d6e4-3742-a979-f2cc2ca72258",
                        "source_sense_description": "true state; essential nature",
                        "target_lang_word": "су́щность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "су́щность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc75a23-3a64-322a-a7c2-41c9bb171e6a",
                                        "entry_id": "f125f10a-9310-38bf-9910-2fe3dae8e218",
                                        "glosses": [
                                            "главное, существенное в ком-либо, чем-либо, суть кого-либо, чего-либо; существо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d15677e1-aa0d-455e-8cb2-7d88f8a41016",
                                                "sense_id": "6cc75a23-3a64-322a-a7c2-41c9bb171e6a",
                                                "text": "Рассказав детям событие, причём вы должны делать сильное ударение на факты, собственные имена или выражения, составляющие сущность рассказа, вы можете потом обратиться к детям с вопросами, и сначала с такими вопросами, в ответ на которые дети передали бы вам главные черты события."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6cf4a52-3eb5-3055-aa24-03e690638473",
                                        "entry_id": "f125f10a-9310-38bf-9910-2fe3dae8e218",
                                        "glosses": [
                                            "филос. совокупность таких свойств предмета, без которых он неспособен существовать и которые определяют все остальные его свойства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "902a6830-3012-4119-812e-27165e48122a",
                                                "sense_id": "c6cf4a52-3eb5-3055-aa24-03e690638473",
                                                "text": "Волю же свою, составляющую сущность его жизни, человек сознаёт и не может сознавать иначе, как свободною."
                                            },
                                            {
                                                "example_id": "7f24a14f-5e36-4c0d-b5c9-efd76836b1fe",
                                                "sense_id": "c6cf4a52-3eb5-3055-aa24-03e690638473",
                                                "text": "Где у меня первоначальные причины, на которые я упрусь, где основания? Откуда я их возьму? Я упражняюсь в мышлении, а следственно, у меня всякая первоначальная причина тотчас же тащит за собою другую, ещё первоначальнее, и так далее в бесконечность. Такова именно сущность всякого сознания и мышления."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1ed08cb-345c-3f69-922f-38bfdad33375",
                                        "entry_id": "f125f10a-9310-38bf-9910-2fe3dae8e218",
                                        "glosses": [
                                            "вводн. сл. если рассматривать основу, суть дела; на деле, в действительности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b42e3e5-09ad-43ea-8d7c-93487bf7e762",
                                                "sense_id": "f1ed08cb-345c-3f69-922f-38bfdad33375",
                                                "text": "Печорин, в сущности, тоже уповает на бессмертие души, хотя нигде в романе таких слов нет, есть другие .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
