                        "entry_id": "227319d6-be36-3966-85e7-853d9c734d58",
                        "glosses": [
                            "Arbrisseau originaire du Mexique et du sud des États-Unis, à feuilles argentées et aux petites fleurs blanches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85f18d5d-691e-4a65-af48-a586e7ce2e94",
                                "sense_id": "11babeef-3c64-3508-925e-bfda5559dddb",
                                "text": "Il contacta pour la première fois George Carnahan, de l’IRC, en 1918 pour des échantillons de guayule et, en 1917 comme en 1923, Edison manifesta un véritable enthousiasme pour le potentiel de l’arbuste."
                            },
                            {
                                "example_id": "512f86bf-9d1b-4072-952c-835430c95e30",
                                "sense_id": "11babeef-3c64-3508-925e-bfda5559dddb",
                                "text": "Le latex du guayule fournit un caoutchouc hypoallergénique recherché."
                            }
                        ]
                    }
                ],
