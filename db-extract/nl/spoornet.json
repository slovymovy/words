                        "examples": [
                            {
                                "example_id": "c5889666-3c95-4991-9b29-4bef65bcae09",
                                "sense_id": "a677e081-ea96-34bd-9ba6-c8a1a4146d29",
                                "text": "Maar volgens de organisatie is het niet mogelijk iedereen tevreden te stellen. De capaciteit van het spoornet is volgens Rover niet groot genoeg om én het treinverkeer richting Schiphol op te voeren én treinen over Lelylaan te laten rijden."
                            },
                            {
                                "example_id": "6aa885d4-88e5-431e-b231-c3ad24618daa",
                                "sense_id": "a677e081-ea96-34bd-9ba6-c8a1a4146d29",
                                "text": "Die technieken gaat NS op het hele Nederlandse spoornet invoeren. „Doel is om reizigers zoveel mogelijk te spreiden over de trein. Zelfs in de spits is er vaak nog plaats genoeg om te zitten. Op je mobiele telefoon is dat nu zichtbaar”, aldus Joosten."
                            }
                        ]
