                "senses": [
                    {
                        "sense_id": "03f175b0-2ef6-3e71-a977-bcd511dfbd63",
                        "entry_id": "82a9fede-14f2-30df-ab38-0855bdf60a56",
                        "glosses": [
                            "a person’s main given name by which they are usually known (typically, but in German-speaking Europe not necessarily, the first given name)"
                        ],
                        "tags": [
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "2da5fccc-423a-414b-87c4-bc8a4f55ef91",
                                "sense_id": "03f175b0-2ef6-3e71-a977-bcd511dfbd63",
                                "text": "Meine Vornamen sind Hans Emil Werner, aber mein Rufname ist Emil.",
                                "translation": "My given names are Hans Emil Werner, but I am called Emil.",
                                "english": "My given names are Hans Emil Werner, but I am called Emil."
                            },
                            {
                                "example_id": "2cd06323-b976-4859-b4da-49b4d224a70f",
                                "sense_id": "03f175b0-2ef6-3e71-a977-bcd511dfbd63",
                                "text": "Geben Sie bitte alle Vornamen an und unterstreichen Sie den Rufnamen!",
                                "translation": "Please indicate all your given names and underline that by which you are commonly known.",
                                "english": "Please indicate all your given names and underline that by which you are commonly known."
                            }
                        ]
                    }
                ],
