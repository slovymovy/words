        "fr-extract.jsonl": [
            {
                "entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
                "word": "promontoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "621104ac-95ca-4980-8c4c-7c266278b105",
                        "entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
                        "tags": [
                            "plural"
                        ],
                        "form": "promontoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                        "entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
                        "glosses": [
                            "Cap ; pointe de terre élevée qui s’avance dans la mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f89677a-a87a-4e11-bfe0-6ee067761d49",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "Le village indien de Sticoë, avec ses tombes pyramidales et ses huttes en ruines, se montrait à notre gauche, au détour d’un promontoire ; […]."
                            },
                            {
                                "example_id": "67cf489d-f5b6-4047-bc1a-5b4771ea5715",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "Sur la côte inhospitalière de l’Atlantique battue par les vents et la houle du large, à mi-chemin environ entre le cap Spartel et Mogador, s'ouvre une baie spacieuse, entre un promontoire rocheux et une presqu’île frangée d'écume."
                            },
                            {
                                "example_id": "5fb22bce-7821-4782-9637-5d16710dee57",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "La rade de Casablanca, comprise entre la presqu'île d’Oukacha à l'est et le promontoire d'El-Anq que prolongent des écueils dangereux à l'ouest, est spacieuse, mais trop évasée et exposée par suite à l'assaut des vents violents et des lames qui déferlent jusqu'à terre."
                            },
                            {
                                "example_id": "6f760238-65ff-44f7-9650-e997ac52bab5",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "Le navire ayant été dépallé dans le Sud par un courant polaire, le cap Brewster, promontoire septentrional du Scoresby Sund, était à une dizaine de milles au N.-W."
                            },
                            {
                                "example_id": "47bede1b-4770-480a-a379-92b8eca87027",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "— Je m’engage sur la pente. Zinder est là-bas, au centre d’une vaste crique à l’apparence de golfe desséché que bornent, à l’Est et à l’Ouest, des coteaux pierreux en forme de promontoire."
                            },
                            {
                                "example_id": "09d59263-877d-4f77-b3c1-e1fac5f13f40",
                                "sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                                "text": "Lisa redémarra et se dirigea vers la rive nord, surplombée par l'église de Saint-Martin-du-Tertre, perchée sur un promontoire calcaire comme un phare céleste pour la ville entière. Sur le clapot des eaux sombres de l'Yonne, le ciel plombé créait des ondes oscillant entre le gris et le noirâtre, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "111a3ad1-103d-4052-9257-5ab2fc29966b",
                        "source_entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
                        "source_sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                        "target_lang_word": "Vorgebirge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorgebirge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                        "entry_id": "853f43a3-fe64-3421-9943-52be6d1db66c",
                                        "glosses": [
                                            "vorgelagertes Gebirge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f0ba5d7-2373-4c63-a8a4-121b2bd173f4",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„In dem Moment, da wir die Landspitzen oder Vorgebirge hinter uns gelassen hatten, bekamen wir einen günstigen Wind, um den Kanal hinaufzufahren.“"
                                            },
                                            {
                                                "example_id": "dcdfd8e5-aed2-4945-9ffa-3cfd104c1b55",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„Er residiere auf dem Vorgebirge, in dem fernen Gebäude, dessen Giebelfenster man zuweilen im Spiel des Lichts aufblitzen sehe.“"
                                            },
                                            {
                                                "example_id": "7d686781-7576-47eb-978b-ef271e418689",
                                                "sense_id": "e224c7a6-ed43-3b21-80dd-6a64953bb4aa",
                                                "text": "„Zuerst war eine ungeheure Wasserfläche, aus der mit Flechten überwucherte Vorgebirge herausragten; kein Lebewesen, kein Laut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "581aef02-2ea1-4ae2-b638-da4d6400b3be",
                        "source_entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
                        "source_sense_id": "1df67be1-51f2-3592-8c87-238a068f5248",
                        "target_lang_word": "Kap",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kap",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8b09e8c-d877-3bff-83a4-1197a2afde89",
                                        "entry_id": "65a687f4-4c56-3881-a181-d049cc2a6afa",
                                        "glosses": [
                                            "ein weit ins Meer vorgeschobener Endpunkt eines Gebirges, ein vorspringender Teil einer Felsenküste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "044938a3-45ca-45ae-a0c4-df52b4fc9a68",
                                                "sense_id": "c8b09e8c-d877-3bff-83a4-1197a2afde89",
                                                "text": "„Hobhouse hatte im Dezember 1900 Südafrika besucht, wo seit einem Jahr ein erbitterter Krieg um die Vorherrschaft am Kap tobte.“"
                                            },
                                            {
                                                "example_id": "232b1b0e-9488-4888-899f-6c6b03ca034b",
                                                "sense_id": "c8b09e8c-d877-3bff-83a4-1197a2afde89",
                                                "text": "„Cook sollte die Nordwestpassage suchen, jene so sehnsüchtig erträumte Abkürzung zwischen Atlantik und Pazifik, die den britischen Schiffen einen Weg in den Orient eröffnen würde, ohne um die Kaps fahren zu müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28c766b2-e2b6-42b8-af51-c15f1e49659c",
                        "source_entry_id": "f8acff7e-4f79-3c0c-bcf5-f1ede75dcd75",
