                        "examples": [
                            {
                                "example_id": "321e7e6a-e6fa-4b78-8ca8-eb6118733214",
                                "sense_id": "0348d133-a440-3f47-add5-32b019b2e8c8",
                                "text": "Dopiero pokój westfalski dał szansę ewangelikom na posiadanie własnych świątyń"
                            },
                            {
                                "example_id": "a307938d-95db-46c5-aa81-25a03bc094db",
                                "sense_id": "0348d133-a440-3f47-add5-32b019b2e8c8",
                                "text": "Wierni Kościołów ewangelickich, zwani ewangelikami, wyznają tzw. pięć zasad protestantyzmu sformułowanych w XVI wieku podczas reformacji"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
