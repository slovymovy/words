                "senses": [
                    {
                        "sense_id": "20eecb3d-014f-3bdb-b0a7-5a5fa141a148",
                        "entry_id": "9d052711-d1d2-37e2-955d-6308f72b7b8c",
                        "glosses": [
                            "elektronisches Gerät, das auf Kurzwelle gesendete Signale empfangen und verarbeiten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8a4996e-cce9-494a-bf31-cd57349584b5",
                                "sense_id": "20eecb3d-014f-3bdb-b0a7-5a5fa141a148",
                                "text": "„Die Schuld daran geben sie der Propaganda, den KW-Empfängern.“"
                            },
                            {
                                "example_id": "07f99223-fe9e-4034-8658-565d870dc143",
                                "sense_id": "20eecb3d-014f-3bdb-b0a7-5a5fa141a148",
                                "text": "„Einen eigenen KW-Empfänger benötigen Sie hierzu nicht!“"
                            },
                            {
                                "example_id": "4f9502cb-0731-4923-aed2-aed62cb61d17",
                                "sense_id": "20eecb3d-014f-3bdb-b0a7-5a5fa141a148",
                                "text": "„Damals war mir noch nicht bekannt, daß die sowjetischen Genossen Lysenko, Drapkin und Schelsnjak 1943 selbst einen KW-Empfänger bauten und sehr gut verstanden, diesen zu tarnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
