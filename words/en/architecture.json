    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4d5a2b1-8b11-3609-8d9f-fef650377d01",
                    "sense_definition": "The art and science of designing and constructing buildings and other physical structures.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "building_design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>architecture</w> at the university.",
                            "target_lang_translations": {
                                "ru": "Она решила изучать <w>архитектуру</w> в университете.",
                                "de": "Sie entschied sich, an der Universität <w>Architektur</w> zu studieren.",
                                "zh": "她决定在大学里学习<w>建筑学</w>。"
                            }
                        },
                        {
                            "text": "The city is famous for its beautiful and historic <w>architecture</w>.",
                            "target_lang_translations": {
                                "ru": "Город славится своей красивой и исторической <w>архитектурой</w>.",
                                "de": "Die Stadt ist berühmt für ihre schöne und historische <w>Architektur</w>.",
                                "zh": "这座城市以其美丽且具有历史意义的<w>建筑</w>而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "landscape architecture",
                        "study architecture",
                        "degree in architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство и наука проектирования и строительства зданий и других сооружений.",
                        "de": "Die Kunst und Wissenschaft des Entwerfens und Konstruierens von Gebäuden und anderen physischen Strukturen.",
                        "zh": "设计和建造建筑物及其他物理结构的艺术与科学。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "архитекту́ра",
                                "target_lang_sense_clarification": "наука и искусство"
                            },
                            {
                                "target_lang_word": "зо́дчество",
                                "target_lang_sense_clarification": "высокий стиль, искусство строительства"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Architektur",
                                "target_lang_sense_clarification": "wissenschaftliche Baukunst"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建筑学",
                                "target_lang_sense_clarification": "作为学科或艺术的建筑"
                            },
                            {
                                "target_lang_word": "建筑",
                                "target_lang_sense_clarification": "指建筑设计与建造的整体领域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09071202-2d23-36df-ba5a-29b83bc6bef2",
                    "sense_definition": "A particular style or method of building design.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "building_design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cathedral is a stunning example of Gothic <w>architecture</w>.",
                            "target_lang_translations": {
                                "ru": "Этот собор — потрясающий образец готической <w>архитектуры</w>.",
                                "de": "Die Kathedrale ist ein beeindruckendes Beispiel gotischer <w>Architektur</w>.",
                                "zh": "这座大教堂是哥特式<w>建筑</w>的绝佳典范。"
                            }
                        },
                        {
                            "text": "We admired the modern <w>architecture</w> of the new library.",
                            "target_lang_translations": {
                                "ru": "Мы восхищались современной <w>архитектурой</w> новой библиотеки.",
                                "de": "Wir bewunderten die moderne <w>Architektur</w> der neuen Bibliothek.",
                                "zh": "我们赞叹新图书馆现代化的<w>建筑风格</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "style",
                        "design",
                        "construction",
                        "building design"
                    ],
                    "common_phrases": [
                        "modern architecture",
                        "classical architecture",
                        "Gothic architecture",
                        "colonial architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный стиль или метод проектирования зданий.",
                        "de": "Ein bestimmter Stil oder eine Methode der Gebäudeplanung.",
                        "zh": "特定的建筑设计风格或方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "архитекту́ра",
                                "target_lang_sense_clarification": "стиль постройки"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Architektur",
                                "target_lang_sense_clarification": "stilistische Ausführung eines Bauwerks"
                            },
                            {
                                "target_lang_word": "Baustil",
                                "target_lang_sense_clarification": "architektonischer Stil eines Gebäudes"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建筑风格",
                                "target_lang_sense_clarification": "指特定的设计流派或样式"
                            },
                            {
                                "target_lang_word": "建筑",
                                "target_lang_sense_clarification": "指具体的建筑设计表现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28a0e85a-ea3e-3d9f-8ef5-29c4cb2e9795",
                    "sense_definition": "The conceptual structure and logical organization of a computer system, software, or network.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "system_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineers are discussing the <w>architecture</w> of the new database system.",
                            "target_lang_translations": {
                                "ru": "Инженеры обсуждают <w>архитектуру</w> новой системы баз данных.",
                                "de": "Die Ingenieure diskutieren über die <w>Architektur</w> des neuen Datenbanksystems.",
                                "zh": "工程师们正在讨论新数据库系统的<w>架构</w>。"
                            }
                        },
                        {
                            "text": "Good software <w>architecture</w> makes the application easier to maintain and update.",
                            "target_lang_translations": {
                                "ru": "Хорошая <w>архитектура</w> программного обеспечения упрощает обслуживание и обновление приложения.",
                                "de": "Eine gute Software-<w>Architektur</w> macht die Anwendung einfacher zu warten und zu aktualisieren.",
                                "zh": "良好的软件<w>架构</w>使应用程序更易于维护和更新。"
                            }
                        }
                    ],
                    "synonyms": [
                        "structure",
                        "design"
                    ],
                    "common_phrases": [
                        "software architecture",
                        "system architecture",
                        "network architecture",
                        "computer architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Концептуальная структура и логическая организация компьютерной системы, программного обеспечения или сети.",
                        "de": "Die konzeptionelle Struktur und logische Organisation eines Computersystems, einer Software oder eines Netzwerks.",
                        "zh": "计算机系统、软件或网络的逻辑组织与概念结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "архитекту́ра",
                                "target_lang_sense_clarification": "компьютерная/системная"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Architektur",
                                "target_lang_sense_clarification": "technische Basiskonstruktion eines Systems"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "架构",
                                "target_lang_sense_clarification": "系统或软件的底层逻辑结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cdd72a2-7bde-309c-a96a-216376419ec0",
                    "sense_definition": "The complex structure or arrangement of the parts of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "system_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>architecture</w> of the novel involves multiple timelines and perspectives.",
                            "target_lang_translations": {
                                "ru": "<w>Архитектура</w> романа включает в себя множество временных линий и точек зрения.",
                                "de": "Der <w>Aufbau</w> des Romans umfasst mehrere Zeitebenen und Perspektiven.",
                                "zh": "这部小说的<w>结构</w>包含了多条时间线和视角。"
                            }
                        },
                        {
                            "text": "Scientists are studying the complex <w>architecture</w> of the human brain.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают сложную <w>архитектуру</w> человеческого мозга.",
                                "de": "Wissenschaftler untersuchen die komplexe <w>Struktur</w> des menschlichen Gehirns.",
                                "zh": "科学家们正在研究人类大脑复杂的<w>构造</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "structure",
                        "composition",
                        "makeup",
                        "construction"
                    ],
                    "common_phrases": [
                        "internal architecture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложная структура или расположение составных частей чего-либо.",
                        "de": "Die komplexe Struktur oder Anordnung der Teile von etwas.",
                        "zh": "事物各部分复杂的结构或排列方式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "архитекту́ра",
                                "target_lang_sense_clarification": "перен., строение сложного объекта"
                            },
                            {
                                "target_lang_word": "строе́ние",
                                "target_lang_sense_clarification": "структура"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Struktur",
                                "target_lang_sense_clarification": "Aufbau oder Anordnung von Komponenten"
                            },
                            {
                                "target_lang_word": "Aufbau",
                                "target_lang_sense_clarification": "innere Zusammensetzung eines komplexen Systems"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结构",
                                "target_lang_sense_clarification": "事物的组成方式"
                            },
                            {
                                "target_lang_word": "构造",
                                "target_lang_sense_clarification": "事物的内部组成或布局"
                            }
                        ]
                    }
                }
