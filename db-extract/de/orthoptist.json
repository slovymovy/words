                "senses": [
                    {
                        "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                        "entry_id": "2c600a00-b5e4-32e2-8cbf-cfd1de0a054b",
                        "glosses": [
                            "selbstständig tätiger Mitarbeiter des Augenarztes bei der Diagnose, Prävention und Therapie von Funktionserkrankungen der Augen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a8e8aed-8c95-4406-ac1c-18735774ada3",
                                "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                                "text": "Wer die Berufsbezeichnung „Orthoptistin“ oder „Orthoptist“ führen will, bedarf der Erlaubnis."
                            },
                            {
                                "example_id": "7f4ab3df-9446-41fc-8384-1f59add0999f",
                                "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                                "text": "Derzeit sind die Berufsaussichten für staatlich examinierte Orthoptisten gut, die Augenspezialisten sind gefragt."
                            },
                            {
                                "example_id": "c8392dca-c7e0-4d4b-a979-7f5b15842538",
                                "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                                "text": "Viele Orthoptisten sind in Teilzeit bei mehreren Arbeitgebern tätig. 42 Prozent der Orthoptisten haben einen Arbeitgeber, bei 58 Prozent sind es zwei oder mehr Arbeitgeber."
                            },
                            {
                                "example_id": "9914e82c-4775-42b8-a582-2eb1682c14f8",
                                "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                                "text": "Orthoptist ist ein spannender und gutbezahlter Beruf für alle die gerne im medizinischen Bereich arbeiten, Diagnosen erstellen und Behandlungen planen."
                            },
                            {
                                "example_id": "2f2a50b8-0c3d-40b0-b34d-ae7802e0e2bb",
                                "sense_id": "7d25e0dd-952e-32df-bc39-96a509fc4404",
                                "text": "Orthoptistinnen und Orthoptisten sind in Schielambulanzen von Augenkliniken, Augenabteilungen, Facharztpraxen und Rehabilitationszentren sowie freiberuflich tätig."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
