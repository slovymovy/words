                "senses": [
                    {
                        "sense_id": "b7c5dbce-ba3e-3198-a977-e9d0096e5e32",
                        "entry_id": "15e859d6-b65e-3aa2-a327-5cdfb43a5e52",
                        "glosses": [
                            "een geheel uit hout opgetrokken kerkgebouw, met een typische bouwstijl die voornamelijk in Scandinavië wordt aangetroffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc2c47c-2b02-42c9-bced-0f30a8c80384",
                                "sense_id": "b7c5dbce-ba3e-3198-a977-e9d0096e5e32",
                                "text": "In die staafkerk in Noorwegen kun je tijdens de vakantie mooi luisteren naar liturgische gezangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09ab3eb1-08eb-41a7-826f-c8963c5d45a5",
                        "source_entry_id": "15e859d6-b65e-3aa2-a327-5cdfb43a5e52",
                        "source_sense_id": "b7c5dbce-ba3e-3198-a977-e9d0096e5e32",
                        "source_sense_description": "een geheel uit hout opgetrokken kerkgebouw, met een typische bouwstijl die voornamelijk in Scandinavië wordt aangetroffen",
                        "target_lang_word": "Stabkirche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stabkirche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                        "entry_id": "f5b9ed3f-b392-30b0-9153-049a404a8cc2",
                                        "glosses": [
                                            "ein Versammlungsgebäude einer Glaubensgemeinschaft; Holzgebäude, mit senkrechten Pfosten/Masten, das zum Abhalten von Ritualen vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3f68fc1-bdd2-41d9-acd1-6886b2ec3f94",
                                                "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                                "text": "„Die meisten Stabkirchen stehen heute in Norwegen.“"
                                            },
                                            {
                                                "example_id": "d65df2eb-7235-40c0-9618-32a2dc246b04",
                                                "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                                "text": "„Der älteste Teil der Kirche zu Ringebu, ihr Westteil, stammt aus dem 13. Jahrhundert und wurde als Stabkirche errichtet, während das Querschiff und der Kirchturm Resultat eines Umbaus um ca. 1630 durch Baumeister Werner Olsen sind.“"
                                            },
                                            {
                                                "example_id": "8e40b690-8d7d-4737-b2e0-9cd8bdd331cf",
                                                "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                                "text": "„Die meistbesuchte und am häufigsten fotografierte Stabkirche Norwegens ist die Stabkirche Borgund in Lærdal am Sognefjord.“"
                                            },
                                            {
                                                "example_id": "46475eaa-8ba3-4efc-a750-e279e8d28bb9",
                                                "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                                "text": "„Die senkrechten Stäbe der Kirchenwand aus stark harzhaltigem Kiefernholz haben ihr den Namen gegeben: Stabkirche.“"
                                            },
                                            {
                                                "example_id": "db931f6e-77fe-409a-97a3-589ef831fcd3",
                                                "sense_id": "b387a596-d585-3d79-bac5-698550ce1144",
                                                "text": "„Die älteste noch erhaltene Stabkirche steht in Urnes (Sogn og Fjordane) am Lusterfjord. Ihre Gründung geht zurück auf das Jahr 1060.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
