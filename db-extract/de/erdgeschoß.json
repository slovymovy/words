                    {
                        "form_id": "18f65de2-cb01-48b6-b94a-3f81c6117115",
                        "entry_id": "a30fa4e3-36df-35b1-8a97-5880632f9781",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Erdgeschoße"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                        "entry_id": "a30fa4e3-36df-35b1-8a97-5880632f9781",
                        "glosses": [
                            "Geschoss, Stockwerk, das sich zu ebener Erde befindet"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "f28708f1-ff21-4f20-83bd-5df7bb1560d3",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "„Da die übrigen Etagen des ausgebombten Hauses eingestürzt waren, bildete das Erdgeschoß den letzten Stock.“"
                            },
                            {
                                "example_id": "44edfbbb-e199-4e0c-9ce2-8aefc2437afd",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "Wir wohnen im Erdgeschoß."
                            },
                            {
                                "example_id": "ec7cdb0d-ddc9-4acb-a688-dbc488931273",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "„Aus dem Erdgeschoß des Hotels kam Radiomusik - der Donauwalzer.“"
                            },
                            {
                                "example_id": "2c2685c9-4011-4d75-8361-58d3db9fbd68",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "„Das Café, vor dem ich unschlüssig saß, lag im Erdgeschoß eines prominenten Siedlerhauses.“"
                            },
                            {
                                "example_id": "5590b2bc-4ce9-42df-ab63-dd1b96dcc8fd",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "„Im Erdgeschoß stieg ich aus und ging auf die Straße.“"
                            },
                            {
                                "example_id": "f7a74182-9681-4336-9172-4104bf1b7066",
                                "sense_id": "ba74cf77-2d08-3a0c-b2dc-df46e109d671",
                                "text": "„Als Geschoße gelten das Erdgeschoß sowie Ober- und Untergeschoße.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
