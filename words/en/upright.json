                        {
                            "text": "He adjusted the tool to a more <w>upright</w> angle for better precision.",
                            "target_lang_translations": {
                                "ru": "Он настроил инструмент под более <w>вертикальным</w> углом для большей точности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in specific mechanical or sporting contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий головку примерно под прямым углом к рукоятке или стержню."
