    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2afe5dd6-19e5-3b90-ba65-2293475787eb",
                    "sense_definition": "doprowadzić sprawę do końca, uregulować formalności lub wykonać jakieś zadanie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "realizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę dzisiaj pójść do urzędu i <w>załatwić</w> ważną sprawę.",
                            "target_lang_translations": {
                                "ru": "Мне нужно сегодня пойти в ведомство и <w>уладить</w> важное дело."
                            }
                        },
                        {
                            "text": "Czy zdołałeś już <w>załatwić</w> wszystkie formalności związane z nowym mieszkaniem?",
                            "target_lang_translations": {
                                "ru": "Ты уже успел <w>оформить</w> все формальности, связанные с новой квартирой?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "załatwić sprawę",
                        "załatwić formalności"
                    ],
                    "target_lang_definitions": {
                        "ru": "довести дело до конца, уладить формальности или выполнить какую-то задачу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уладить",
                                "target_lang_sense_clarification": "дело, формальности"
                            },
                            {
                                "target_lang_word": "решить",
                                "target_lang_sense_clarification": "вопрос, проблему"
                            },
                            {
                                "target_lang_word": "оформить",
                                "target_lang_sense_clarification": "документы, формальности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58e52c68-5294-337f-8ae6-63bad626d8fd",
                    "sense_definition": "zdobyć coś, zorganizować lub znaleźć dla kogoś dzięki staraniom lub znajomościom",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organizacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój znajomy obiecał, że <w>załatwi</w> nam bilety na ten koncert.",
                            "target_lang_translations": {
                                "ru": "Мой знакомый пообещал, что <w>достанет</w> нам билеты на этот концерт."
                            }
                        },
                        {
                            "text": "Marek pomógł mi i szybko <w>załatwił</w> pracę w nowo otwartym sklepie.",
                            "target_lang_translations": {
                                "ru": "Марек помог мне и быстро <w>устроил</w> на работу в недавно открывшийся магазин."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprawić"
                    ],
                    "common_phrases": [
                        "załatwić bilety",
                        "załatwić pracę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie zdobywania lub organizowania czegoś"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "добыть, организовать или найти что-то благодаря стараниям или связям"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достать",
                                "target_lang_sense_clarification": "билеты, вещи, с трудом или по знакомству"
                            },
                            {
                                "target_lang_word": "пробить",
                                "target_lang_sense_clarification": "место, возможность"
                            },
                            {
                                "target_lang_word": "устроить",
                                "target_lang_sense_clarification": "на работу, помочь с получением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9cc0c26b-644b-3a70-82f3-74b105bac049",
                    "sense_definition": "doprowadzić do zniszczenia, zepsucia lub zaszkodzić komuś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uszkodzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten mróz kompletnie <w>załatwił</w> wszystkie delikatne rośliny na balkonie.",
                            "target_lang_translations": {
                                "ru": "Этот мороз полностью <w>угробил</w> все нежные растения на балконе."
                            }
                        },
                        {
                            "text": "Jazda po wybojach całkowicie <w>załatwiła</w> zawieszenie w starym samochodzie.",
                            "target_lang_translations": {
                                "ru": "Езда по ухабам окончательно <w>добила</w> подвеску в старой машине."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne znaczenie uszkodzenia lub zniszczenia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сломать, испортить, разрушить или навредить"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угробить",
                                "target_lang_sense_clarification": "испортить, сломать, сгубить"
                            },
                            {
                                "target_lang_word": "доконать",
                                "target_lang_sense_clarification": "окончательно испортить или вывести из строя"
                            },
                            {
                                "target_lang_word": "добить",
                                "target_lang_sense_clarification": "окончательно доломать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df63e0b2-3e01-3d48-876c-3dab748051bb",
                    "sense_definition": "oddać mocz lub wypróżnić się",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizjologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Muszę wyjść z psem na krótki spacer, aby mógł się spokojnie <w>załatwić</w>.",
                            "target_lang_translations": {
                                "ru": "Мне нужно выйти с собакой на короткую прогулку, чтобы она могла спокойно <w>сделать свои дела</w>."
                            }
                        },
                        {
                            "text": "Przed długą podróżą samochodem dziecko powinno się <w>załatwić</w> w domu.",
                            "target_lang_translations": {
                                "ru": "Перед долгой поездкой на машине ребенку стоит <w>сходить в туалет</w> дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "załatwić potrzebę"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "eufemistyczne i potoczne określenie potrzeb fizjologicznych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сходить в туалет, справить нужду"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справиться",
                                "target_lang_sense_clarification": "справить нужду (эвфемизм)"
                            },
                            {
                                "target_lang_word": "сходить в туалет",
                                "target_lang_sense_clarification": "опорожнить кишечник или мочевой пузырь"
                            },
                            {
                                "target_lang_word": "сделать свои дела",
                                "target_lang_sense_clarification": "разг., о детях или животных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5dd5ead6-756a-33ea-ae13-f543c0057537",
                    "sense_definition": "pozbawić życia, zabić kogoś",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eliminacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bandyci zagrozili świadkowi, że go bez wahania <w>załatwią</w>, jeśli pójdzie na policję.",
                            "target_lang_translations": {
                                "ru": "Бандиты пригрозили свидетелю, что без колебаний его <w>прикончат</w>, если он пойдет в полицию."
                            }
                        },
                        {
                            "text": "W starym filmie gangsterskim przestępca <w>załatwił</w> swojego dawnego wspólnika.",
                            "target_lang_translations": {
                                "ru": "В старом гангстерском фильме преступник <w>убрал</w> своего бывшего сообщника."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprzątnąć"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "slangowe, przestępcze określenie morderstwa"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "лишить жизни, убить кого-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прикончить",
                                "target_lang_sense_clarification": "разг., убить"
                            },
                            {
                                "target_lang_word": "убрать",
                                "target_lang_sense_clarification": "крим. жарг., устранить"
                            },
                            {
                                "target_lang_word": "завалить",
                                "target_lang_sense_clarification": "жарг., убить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
