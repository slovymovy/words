            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9c2ac3e-f793-312e-b711-6732741b6518",
                    "sense_definition": "ein fremdes Schiff gewaltsam betreten und unter seine Kontrolle bringen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schifffahrt_angriff",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Piraten näherten sich heimlich in der Nacht und wollten das fremde Schiff <w>entern</w>."
                        },
                        {
                            "text": "Nach einem heftigen Gefecht auf hoher See wurde der Frachter von Seeräubern <w>geentert</w>."
                        }
                    ],
                    "synonyms": [
                        "kapern",
                        "aufbringen"
                    ],
                    "common_phrases": [
                        "ein Schiff entern"
                    ]
                },
                {
                    "sense_id": "7a9013ba-dc0e-3d3c-a99d-dbbc4bc1ad27",
                    "sense_definition": "in die Takelage oder auf die Masten eines Segelschiffs hinaufklettern",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "schifffahrt_klettern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Matrosen mussten bei schwerem Sturm die Masten <w>entern</w>, um die Segel einzuholen."
                        },
                        {
                            "text": "Der junge Seemann lernte rasch, wie man geschickt und sicher in die Takelage <w>entert</w>."
                        }
                    ],
                    "synonyms": [
                        "erklimmen",
                        "besteigen"
                    ],
                    "common_phrases": [
                        "die Masten entern"
                    ]
                },
                {
                    "sense_id": "da78c165-2ff9-362f-b3f8-101c659d9e6f",
                    "sense_definition": "ein Objekt, Fahrzeug oder Gebäude überraschend erklettern oder besetzen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "klettern_besetzen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mehrere Umweltaktivisten versuchten am frühen Morgen, die umstrittene Plattform im Meer zu <w>entern</w>."
                        },
                        {
                            "text": "Die Demonstranten <w>enterten</w> das Gerüst vor dem Gebäude, um dort ein großes Banner zu befestigen."
                        }
                    ],
                    "synonyms": [
                        "erklimmen",
                        "besteigen"
                    ],
                    "common_phrases": [
                        "eine Bohrinsel entern"
                    ]
                }
            ]
        }
