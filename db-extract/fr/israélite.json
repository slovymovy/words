                    {
                        "form_id": "3ca16348-60b4-4dd6-8421-06eb8a8dd483",
                        "entry_id": "fe223da1-e307-3478-b66d-a253f0f68371",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "israélites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                        "entry_id": "fe223da1-e307-3478-b66d-a253f0f68371",
                        "glosses": [
                            "Juif ; juive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2cd4e46-75dd-461c-a923-30063274ae45",
                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                "text": "Il était coiffé d’un bonnet jaune, long et carré, d’une mode singulière et assignée à sa nation pour distinguer les israélites des chrétiens."
                            },
                            {
                                "example_id": "58b664ab-0b36-4dc6-a129-3540414abc26",
                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                "text": "D’après Stanislas Plater, la Pologne, en 1765, sur 20 millions d’habitants, possédait environ 8 million de catholiques romains, près de 4 millions de catholiques grecs, 3 millions de catholiques schismatiques, 2 millions de protestants, 2 millions d’israélites, près de 200.000 raskolniks ou espèces de bohémiens et de missionnaires russes, et 56 000 mahométans."
                            },
                            {
                                "example_id": "674959ce-02bf-4a91-9748-382e275d939f",
                                "sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                                "text": "Casablanca toute entière tenait alors dans l’enceinte de ses murailles. Elle comptait environ 25.000 indigènes dont un cinquième d’israélites et une colonie européenne, femmes et enfants compris, d’approximativement 500 têtes, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a905179-b9f4-43fb-be68-ac83454f9acc",
                        "source_entry_id": "fe223da1-e307-3478-b66d-a253f0f68371",
                        "source_sense_id": "c3b10daf-1037-324c-af91-ce0cdaec69e2",
                        "target_lang_word": "Israelite",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Israelite",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbe93c11-5abf-3662-96c7-ef6d04d524cc",
                                        "entry_id": "965bac67-f114-385f-8779-0969850c9aac",
                                        "glosses": [
                                            "A native or inhabitant of"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd53a7e-d23f-4b05-b7c8-4242b0a695c1",
                                                "sense_id": "cbe93c11-5abf-3662-96c7-ef6d04d524cc",
                                                "text": "Celesliall brightnesse ceazed on his face,\nThat did the wondring Israelites amaze,\nWhen he returned from that souereigne place,\nHis browes encireled with splendidious rayes."
                                            },
                                            {
                                                "example_id": "075d2fb5-e39e-46cf-b348-ba524cd847fa",
                                                "sense_id": "cbe93c11-5abf-3662-96c7-ef6d04d524cc",
                                                "text": "The token of God is upon him, let him now, by his own profession of faith, acknowledge it, as God's token, bringing him under the responsibilities and blessings of the covenant, and he will be received, unquestionably, as \"an Israelite indeed.\""
                                            },
                                            {
                                                "example_id": "27248e4c-b9f4-49d6-b360-71e27a35999f",
                                                "sense_id": "cbe93c11-5abf-3662-96c7-ef6d04d524cc",
                                                "text": "Papponymy is not documented among Israelites. The only exception, Tahat son of 'Elyada' son of Tahat is doubtful and is not a papponymy sensu stricto."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a81b5c2e-2afe-3b95-9002-8f4dfd8753f0",
                                        "entry_id": "965bac67-f114-385f-8779-0969850c9aac",
                                        "glosses": [
                                            "A native or inhabitant of\\n (i) the united nation of ancient Israel (under the Judges, and then kings Saul, David and Solomon), or\\n (ii) the later ancient northern kingdom centered in Samaria, distinct from the kingdom of Judah centered in Jerusalem.",
                                            "the united nation of ancient Israel (under the Judges, and then kings Saul, David and Solomon), or"
                                        ],
