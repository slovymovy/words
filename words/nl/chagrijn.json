            "senses": [
                {
                    "sense_id": "3da887fd-af45-3e8d-8f46-dfbee7fcd020",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>chagrijnen</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>chagrijn</w> misschien een beetje omdat ik slecht geslapen heb.",
                            "target_lang_translations": {
                                "en": "I <w>am</w> maybe <w>being a bit grumpy</w> because I slept poorly.",
                                "de": "Ich <w>bin</w> vielleicht etwas <w>mürrisch</w>, weil ich schlecht geschlafen habe."
                            }
                        },
                        {
                            "text": "Als ik honger heb, <w>chagrijn</w> ik altijd direct.",
                            "target_lang_translations": {
                                "en": "When I am hungry, I always <w>get grumpy</w> immediately.",
                                "de": "Wenn ich Hunger habe, <w>schmolle</w> ich immer sofort."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm"
                        }
                    ],
                    "target_lang_definitions": {
