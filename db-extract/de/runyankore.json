                    {
                        "sense_id": "35b3d8bd-ef72-3a0d-a2cd-6960c8635bcf",
                        "entry_id": "8edb8050-e530-3c9c-8804-722f43378829",
                        "glosses": [
                            "Bantusprache, die vor allem im Südwesten Ugandas gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e3130d9-d473-4918-a4d9-fb508688f8c2",
                                "sense_id": "35b3d8bd-ef72-3a0d-a2cd-6960c8635bcf",
                                "text": "Gegenwärtig wird der Versuch gemacht, die vier eng verwandten südwestugandischen Sprachen Rukiga, Runyankore, Runyoro und Rutoro unter dem Namen Runyakitara zu einer einheitlichen Sprache zu standardisieren."
                            },
                            {
                                "example_id": "049748ea-c346-4783-b7c2-0667df7e2d88",
                                "sense_id": "35b3d8bd-ef72-3a0d-a2cd-6960c8635bcf",
                                "text": "Im Runyankore, der Sprache der Banyankore von Uganda, gibt es nach den Untersuchungen von Paul van Thiel (1969) im ganzen vier Zeitwörter, mit denen die Aktion des „Spielens“ von Musikinstrumenten ausgedrückt wird."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
