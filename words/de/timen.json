{
    "word_family": [
        "Timer",
        "Timing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7ca6b8e2-0f48-3f32-895a-bea3505df0a7",
                    "sense_definition": "etwas zeitlich planen oder aufeinander abstimmen, sodass es zu einem günstigen oder bestimmten Zeitpunkt geschieht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zeitplanung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das wichtige Treffen war hervorragend <w>getimt</w>, sodass alle Teilnehmer völlig stressfrei anreisen konnten."
                        },
                        {
                            "text": "Wir müssen den Start der neuen Werbekampagne sorgfältig <w>timen</w>, um möglichst viele Kunden zu erreichen."
                        }
                    ],
                    "synonyms": [
                        "abstimmen",
                        "koordinieren",
                        "planen"
                    ],
                    "common_phrases": [
                        "gut getimt",
                        "schlecht getimt",
                        "einen Termin timen"
                    ]
                },
                {
                    "sense_id": "d734b558-f22f-3616-933f-3deb9cea06f5",
                    "sense_definition": "die für einen bestimmten Vorgang benötigte Zeit mit einer Stoppuhr oder einem anderen Zeitmessgerät ermitteln",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "zeitmessung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Trainer lässt die Läufer antreten und will jede einzelne Runde auf der Bahn genau <w>timen</w>."
                        },
                        {
                            "text": "Die einzelnen Arbeitsphasen sollten mit einer Uhr exakt <w>getimt</w> werden, um Fehler zu vermeiden."
                        }
                    ],
                    "synonyms": [
                        "abstoppen",
                        "messen",
                        "stoppen"
                    ],
                    "common_phrases": [
                        "mit der Stoppuhr timen",
                        "eine Runde timen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7dee791-42af-347a-a55e-1734c1ca8327",
                    "sense_definition": "das zeitliche Abstimmen oder Stoppen von Vorgängen; Substantivierung des Verbs <w>timen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zeitplanung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ein gutes <w>Timen</w> aller Arbeitsschritte ist für den reibungslosen Ablauf in der Restaurantküche entscheidend."
                        },
                        {
                            "text": "Beim Backen kommt es oft auf das präzise <w>Timen</w> der Ruhezeiten an."
                        }
                    ],
                    "synonyms": [
                        "Timing",
                        "Zeitabstimmung"
                    ],
                    "common_phrases": [
                        "perfektes Timen",
                        "präzises Timen"
                    ]
                }
            ]
        }
    ]
}