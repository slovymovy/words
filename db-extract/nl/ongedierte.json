        "nl-extract.jsonl": [
            {
                "entry_id": "db66b8db-264e-391f-b6eb-62182b12a3fa",
                "word": "ongedierte",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "594d0ece-2b9d-376d-8c32-725162d58418",
                        "entry_id": "db66b8db-264e-391f-b6eb-62182b12a3fa",
                        "glosses": [
                            "ongewenste dieren, die de mens op een of andere manier last bezorgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea181c08-ca54-480f-8313-4cfd87babbe0",
                                "sense_id": "594d0ece-2b9d-376d-8c32-725162d58418",
                                "text": "Om overlast van het ongedierte te voorkomen, besteedt de gemeente vanaf dit jaar jaarlijks een kwart miljoen euro extra aan preventie. Dat is een verdubbeling. De gemeente waarschuwt dat het doden van de dieren niet bijdraagt aan het verminderen van overlast. \"Als de oorzaken van rattenoverlast niet worden weggenomen, keren ratten altijd terug en blijft overlast terugkomen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eb2d256-ecc9-4c17-8c93-58cf77f9e1f1",
                        "source_entry_id": "db66b8db-264e-391f-b6eb-62182b12a3fa",
                        "source_sense_id": "594d0ece-2b9d-376d-8c32-725162d58418",
                        "source_sense_description": "ongewenste dieren, die de mens op een of andere manier last bezorgen",
                        "target_lang_word": "Ungeziefer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungeziefer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                        "entry_id": "e6473638-72b6-3542-b5f1-d1d0da5ed528",
                                        "glosses": [
                                            "bestimmte unerwünschte oder für schädlich gehaltene kleine Tiere, insbesondere Insekten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93abd0c6-6620-4d91-9289-e91727d5a436",
                                                "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                                "text": "Flöhe und Läuse sind Ungeziefer."
                                            },
                                            {
                                                "example_id": "e2bf0baa-26cd-489f-9d5b-f0661176b341",
                                                "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                                "text": "„Als Gregor Samsa eines Morgens aus unruhigen Träumen erwachte, fand er sich in seinem Bett zu einem ungeheueren Ungeziefer verwandelt.“"
                                            },
                                            {
                                                "example_id": "a20652eb-b112-43e4-bb80-248b91496f4c",
                                                "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                                "text": "„Bald schwärmten Fliegen, Wespen und Hornissen um das tote Tier; sie mussten es in den Graben werfen und dem Ungeziefer überlassen.“"
                                            },
                                            {
                                                "example_id": "e2fe94b9-fdea-4481-8c34-37ddf14dcc7f",
                                                "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                                "text": "„Das Ungeziefer, das mich peinigte, milderte jedoch die Todesangst, die mir die Ratten einflößten, und gerade diese Todesangst wiederum ließ mich die Insektenstiche weniger spüren.“"
                                            },
                                            {
                                                "example_id": "2ccd48db-bc91-4d91-b2c1-ad9a8e4a1731",
                                                "sense_id": "104e708b-1a80-3a28-9e5a-08606490719b",
                                                "text": "„Ein Student erkundigt sich bei der Vermieterin einer mittelalterlichen möblierten Bude nach der Freiheit von Wanzen und anderem Ungeziefer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a778489-43f9-4e5f-85dd-dd87e0aa4258",
                        "source_entry_id": "db66b8db-264e-391f-b6eb-62182b12a3fa",
                        "source_sense_id": "594d0ece-2b9d-376d-8c32-725162d58418",
                        "source_sense_description": "ongewenste dieren, die de mens op een of andere manier last bezorgen",
                        "target_lang_word": "vermin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "Any of various common types of small insects or other animals which cause harm and annoyance."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fbd62d3-d636-468c-a71c-24a9e4b47509",
                                                "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                                "text": "The area was crawling with all sorts of vermin: fleas, lice, mice, and rats to name a few. Thus, we felt as if vermin were crawling over us."
                                            },
                                            {
                                                "example_id": "30e8b11f-10fe-4eea-84eb-57cf475aae7c",
                                                "sense_id": "11f88d3c-f547-301c-8c57-b7a959159565",
                                                "text": "Vermin was everywhere; night and day it crawled gaily over the walls and ceiling, about our bodies, and into our very food, and, although the subject did not interest us, a naturalist would have delighted in the ever-changing varieties of insect life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "354360d8-397a-36d4-9dc1-779cf0e40caa",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "An animal that preys on game, such as a fox or a weasel."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ad4dc78-633b-33a1-8c65-e193d261b2ed",
                                        "entry_id": "89c2753c-6208-3842-af86-4a0083cbbad2",
                                        "glosses": [
                                            "An obnoxious or mean and offensive person."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80e72c75-1e92-42a9-a0bc-3d13e8cbc90d",
                                                "sense_id": "6ad4dc78-633b-33a1-8c65-e193d261b2ed",
                                                "text": "Bring these vermin to the Palace of Justice."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09647f7c-8c43-46b6-bdbf-f055bc958540",
                        "source_entry_id": "db66b8db-264e-391f-b6eb-62182b12a3fa",
                        "source_sense_id": "594d0ece-2b9d-376d-8c32-725162d58418",
                        "source_sense_description": "ongewenste dieren, die de mens op een of andere manier last bezorgen",
                        "target_lang_word": "vermine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2290fa7b-b411-352c-b1ac-4e92917eca8b",
                                        "entry_id": "8b43a553-e682-3d8b-be32-f4700bf54f3a",
                                        "glosses": [
                                            "Ensemble d’insectes parasites, malpropres, nuisibles et incommodes, comme les poux, les puces, les punaises, etc. ; utilisé pour les insectes infectant les humains, les animaux ou les plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22d056d1-edda-4730-8370-9e9b2354853e",
                                                "sense_id": "2290fa7b-b411-352c-b1ac-4e92917eca8b",
                                                "text": "Soit pour des mésanges, des fauvettes, des becs fins comme les hirondelles : ça détruit la vermine! Mais les mauvis […]?"
                                            },
                                            {
                                                "example_id": "edf3b352-ba13-4db8-911f-5e58799893ee",
                                                "sense_id": "2290fa7b-b411-352c-b1ac-4e92917eca8b",
                                                "text": "Sa maison était propre, bien tenue ; elle tranchait avec la blancheur gaie de sa façade et le luisant de ses meubles, sur les taudis immondes où, d’ordinaire, croupissent dans la fange et dans la vermine, les marins bretons."
                                            },
                                            {
                                                "example_id": "430427ce-7cb5-409c-8afb-504767060292",
                                                "sense_id": "2290fa7b-b411-352c-b1ac-4e92917eca8b",
                                                "text": "Les hommes sont internés en Lituanie, dans les camps de Milejgany, Jewie et Roon où ils souffrent du froid intense, du manque de nourriture et d'eau potable, des conditions précaires d'hébergement, de la vermine et des humiliations."
                                            },
                                            {
                                                "example_id": "e1a3fe02-a5e7-4fce-ac74-2657dcd89b30",
                                                "sense_id": "2290fa7b-b411-352c-b1ac-4e92917eca8b",
                                                "text": "Chaque lundi, l'instituteur inspectait les ongles, le haut du tricot de corps, les cheveux à cause de la vermine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "321b4805-48c1-33f0-9f09-87ee9e31356c",
                                        "entry_id": "8b43a553-e682-3d8b-be32-f4700bf54f3a",
                                        "glosses": [
                                            "Toute sorte de gens de mauvaise vie, de garnements dangereux ou incommodes pour la société."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7728e533-958a-4218-b942-1f73768032dd",
                                                "sense_id": "321b4805-48c1-33f0-9f09-87ee9e31356c",
                                                "text": "Quand le marchand d’huile comprit quel marché de dupe il avait fait, il ne lui était plus permis de se débarrasser d’Aristide ; la dot d’Angèle se trouvait engagée dans des spéculations qui tournaient mal. Il dut garder le ménage chez lui, exaspéré, frappé au cœur par le gros appétit de sa belle-fille et par les fainéantises de son fils. Vingt fois, s’il avait pu les désintéresser, il aurait mis à la porte cette vermine qui lui suçait le sang, selon son énergique expression."
                                            },
                                            {
                                                "example_id": "3ed15c11-799f-4b34-9cda-9661116b1127",
                                                "sense_id": "321b4805-48c1-33f0-9f09-87ee9e31356c",
                                                "text": "La vermine des catacombes s'épanouissait lentement au soleil ; les couvents et monastères champignonnaient, rongeant le sol gaulois comme une lèpre hideuse."
                                            },
                                            {
                                                "example_id": "6bfb0fcd-c714-4033-82dd-9051477cf42c",
                                                "sense_id": "321b4805-48c1-33f0-9f09-87ee9e31356c",
                                                "text": "Ce monsieur était tellement méchant que dans son livre, il disait qu’il fallait tuer tous les Juifs, car ils étaient de la vermine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vermine",
                                "target_lang_code": "fr",
                                "target_senses": [
