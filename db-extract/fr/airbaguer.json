                "senses": [
                    {
                        "sense_id": "c17f610d-7957-3e95-bd88-836d7afa9025",
                        "entry_id": "b76bab81-0533-3652-9de7-1e95dcd5496c",
                        "glosses": [
                            "Protéger en utilisant un airbag."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "51606c7c-49ed-43b6-b0ab-4cba081e664f",
                                "sense_id": "c17f610d-7957-3e95-bd88-836d7afa9025",
                                "text": "Ne pas oublier \"d'airbaguer\" Marc pour la traversée....!!!"
                            },
                            {
                                "example_id": "ccc4493c-fd58-4b19-a5a3-07ed07c4ff68",
                                "sense_id": "c17f610d-7957-3e95-bd88-836d7afa9025",
                                "text": "Les parents n’étaient pas en reste, surveillant leurs rejetons du coin de l’œil, amusés par cette curiosité remarquable, égarée parmi le catalogue des véhicules proprets et conforme au monde sanglé, airbagué, standardisé, condomisé, dans des carrosseries sans rayures, sans gloire, et sans nicotine, dont l’ultime conquête aura été l’extinction et la mise à mort des cendriers."
                            },
                            {
                                "example_id": "62d88217-f250-4771-8b5c-226be718169a",
                                "sense_id": "c17f610d-7957-3e95-bd88-836d7afa9025",
                                "text": "Conclusion : \"airbaguez-vous!\""
                            }
                        ]
                    }
