                        "glosses": [
                            "Of, like, or pertaining to dogs or the dog family; canine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb84af8e-fd37-44c4-aa68-3687529c3d70",
                                "sense_id": "c2296c19-e929-3e03-9a9c-390a3591b6a4",
                                "text": "If a chicken invades your garden to steal seed and your dog barks at it in the line of dogly duty, the chicken's owner has the legal right to kill your dog."
                            },
                            {
                                "example_id": "bd185609-9885-466b-87df-41a4e4621058",
                                "sense_id": "c2296c19-e929-3e03-9a9c-390a3591b6a4",
                                "text": "I had a little dog who practiced all the dogly virtues. He never tried to get into any chairs or on any couches."
                            },
                            {
                                "example_id": "b9e76aac-f49b-4cb2-9237-837bf929e9d7",
                                "sense_id": "c2296c19-e929-3e03-9a9c-390a3591b6a4",
                                "text": "[Seminole Sam to the Dog:] It ain't dogly to bark \"ahem\"."
                            },
                            {
                                "example_id": "1ab79fb3-cdc8-41ad-afc1-6e699e6a11e2",
                                "sense_id": "c2296c19-e929-3e03-9a9c-390a3591b6a4",
                                "text": "It was a halfhearted attempt to get him to stop, because truly, I was hoping the dog would do the dogly thing and chew up the Frisbee."
                            }
                        ]
                    }
