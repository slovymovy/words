                    {
                        "translation_id": "ed60da1f-2c00-4afb-93a7-ab78ef8302bf",
                        "source_entry_id": "4413f38d-9c02-3f4a-900b-01fd724d7bab",
                        "source_sense_id": "504e9dc9-5f6d-30f8-99cd-2b23b27ebfa6",
                        "source_sense_description": "Spending a full amount of time",
                        "target_lang_word": "à plein temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à plein temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "11dc35d5-ca5d-3e11-9d78-b012e6ba6857",
                                        "entry_id": "80177eb2-1682-369a-98ff-0121ba4f5b9c",
                                        "glosses": [
                                            "Qualifie un emploi dont la durée effective est égale à sa durée légale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e176cacb-a071-4ad5-b22a-02fb87d0817e",
                                                "sense_id": "11dc35d5-ca5d-3e11-9d78-b012e6ba6857",
                                                "text": "Françoise était perplexe. Valait-il mieux gagner plus en travaillant au bureau à plein temps, comme cet homme le lui proposait, ou gagner moins en continuant de travailler à domicile sans être tenue par un horaire ?"
                                            },
                                            {
                                                "example_id": "3c282cfe-85db-4eb9-a3ef-c942a00b3c32",
                                                "sense_id": "11dc35d5-ca5d-3e11-9d78-b012e6ba6857",
                                                "text": "La flexibilisation des horaires de travail : recul du travail à plein temps et développement du travail à temps partiel, irrégulier et sur appel, avec heures brisées ou horaires flexibles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98959e1e-5442-31f8-8f59-59e82fa56649",
                                        "entry_id": "80177eb2-1682-369a-98ff-0121ba4f5b9c",
                                        "glosses": [
                                            "Qualifie le travailleur qui occupe un tel emploi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b22525d-1f08-4abb-99b5-4d56576bdf55",
                                                "sense_id": "98959e1e-5442-31f8-8f59-59e82fa56649",
                                                "text": "Au milieu des années 90, la rémunération horaire des travailleurs à temps partiel était inférieure d’environ 25 % à celle des travailleurs à plein-temps."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "à plein temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9c1e4f18-1598-38b9-937b-3b0e269ebac1",
                                        "entry_id": "13f01351-a469-3746-89c1-3bddf2bb60be",
                                        "glosses": [
                                            "En occupant tout son temps disponible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10cda2c2-e602-444c-9281-1d0eafed5c19",
                                                "sense_id": "9c1e4f18-1598-38b9-937b-3b0e269ebac1",
                                                "text": "Premièrement, plus l’âge de la mère est élevé lors de la séparation, plus elle est susceptible de travailler à plein temps."
                                            }
                                        ]
                                    }
                                ]
                            }
