                "senses": [
                    {
                        "sense_id": "fc91f746-c842-386b-aa52-9f3867edeff8",
                        "entry_id": "cbee8b6a-00b1-394a-b9b3-8029785b830b",
                        "glosses": [
                            "Qui s’effectue ou se situe à l’intérieur de la carotide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91cf915c-3512-4935-8671-aede1fb8ba97",
                                "sense_id": "fc91f746-c842-386b-aa52-9f3867edeff8",
                                "text": "Enfin MM. Bochefontaine et Lépine ont constaté, dans des expériences de ce genre, une augmentation subite et considérable de la pression intracarotidienne."
                            },
                            {
                                "example_id": "dde45009-c3df-4c31-abc9-b5159716b29c",
                                "sense_id": "fc91f746-c842-386b-aa52-9f3867edeff8",
                                "text": "M. Trélat était bien sûr qu’il s’agissait d’un abcès intracarotidien, puisque la carotide battait en dehors."
                            },
                            {
                                "example_id": "200921e5-6df2-4604-af0a-e30c871fc17c",
                                "sense_id": "fc91f746-c842-386b-aa52-9f3867edeff8",
                                "text": "L’évaluation préchirurgicale inclut souvent un test à l’amobarbital intracarotidien (TAI), aussi connu sous les termes de test de Wada ou d’amytal sodique."
                            }
                        ]
                    }
