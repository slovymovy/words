                "senses": [
                    {
                        "sense_id": "9f6af493-9a22-380f-a18c-025ef381ea6b",
                        "entry_id": "0bcd8d2a-20ef-3580-897b-c973ecf9928a",
                        "glosses": [
                            "Autre orthographe de bonnir."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "12f06a02-8d58-46d5-af29-705be4fef48e",
                                "sense_id": "9f6af493-9a22-380f-a18c-025ef381ea6b",
                                "text": "Or, tandis qu’il bonissait avec cette verve joviale, son œil rusé m’observait…"
                            },
                            {
                                "example_id": "9930794c-8011-4598-9b8e-eea723e0ce5a",
                                "sense_id": "9f6af493-9a22-380f-a18c-025ef381ea6b",
                                "text": "Il fallait l'entendre ! En trois coups de cuiller à pot, il les a tous retournés. Il leur a boni un coup de sentiment à faire renifler le diable et l’enfer !"
                            },
                            {
                                "example_id": "102095bd-e73f-43fc-89ee-f2557901c6cb",
                                "sense_id": "9f6af493-9a22-380f-a18c-025ef381ea6b",
                                "text": "« A ta disposition, ma Divine, que j’lui bonis, mais ne t’agite pas comme ça, sinon tu vas claquer ton soutien-gorge. »"
                            },
                            {
                                "example_id": "a9c53356-6158-4c13-98f8-89be6a8668fb",
                                "sense_id": "9f6af493-9a22-380f-a18c-025ef381ea6b",
                                "text": "A moi de bonir, maintenant."
                            }
                        ]
                    }
                ],
