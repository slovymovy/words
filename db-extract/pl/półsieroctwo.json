                        "source_entry_id": "a7d5aee5-b1e1-3b00-802c-6226c6957088",
                        "source_sense_id": "71f2e383-b5b5-3155-849c-7e3570e2de53",
                        "target_lang_word": "fatherlessness",
                        "target_lang_code": "en",
