        "fr-extract.jsonl": [
            {
                "entry_id": "72ec2820-1248-35ea-b716-d2728046168b",
                "word": "pendaison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3d1a1bf6-4b4d-4d7c-962a-324e8ddc899b",
                        "entry_id": "72ec2820-1248-35ea-b716-d2728046168b",
                        "tags": [
