            "senses": [
                {
                    "sense_id": "b4179b16-8dad-3311-950a-8a8d79eea24a",
                    "sense_definition": "geestelijke of lichamelijke pijn en verdriet",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotionele pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is hem in zijn leven behoorlijk wat <w>leed</w> aangedaan.",
                            "target_lang_translations": {
                                "en": "He has been caused a considerable amount of <w>suffering</w> in his life."
                            }
                        },
                        {
                            "text": "Zij kon het grote <w>leed</w> van haar dochter niet langer verdragen.",
                            "target_lang_translations": {
                                "en": "She could no longer bear her daughter's great <w>grief</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed aandoen",
                        "groot leed"
                    ],
                    "target_lang_definitions": {
                        "en": "mental or physical pain and sorrow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffering",
                                "target_lang_sense_clarification": "general physical or mental pain"
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "deep sorrow, especially caused by loss"
                            },
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "distress caused by loss or disappointment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e702db1d-98d8-33b5-ba38-f8bb5ff0167e",
                    "sense_definition": "schade of onrecht dat iemand wordt toegebracht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "schade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De storm heeft veel <w>leed</w> veroorzaakt onder de lokale bevolking.",
                            "target_lang_translations": {
                                "en": "The storm caused much <w>suffering</w> among the local population."
                            }
                        },
                        {
                            "text": "Zij probeerden het <w>leed</w> te verzachten na de vreselijke gebeurtenis.",
                            "target_lang_translations": {
                                "en": "They tried to ease the <w>misery</w> after the terrible event."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed verzachten"
                    ],
                    "target_lang_definitions": {
                        "en": "harm or injustice inflicted upon someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffering",
                                "target_lang_sense_clarification": "hardship or distress caused by events"
                            },
                            {
                                "target_lang_word": "misery",
                                "target_lang_sense_clarification": "great distress or discomfort"
                            },
                            {
                                "target_lang_word": "harm",
                                "target_lang_sense_clarification": "damage or injury"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37e8ee45-07c4-3b26-acaf-cac563d3bd9e",
                    "sense_definition": "enkelvoud verleden tijd van <w>lijden</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>leed</w> jarenlang aan een ernstige ziekte.",
                            "target_lang_translations": {
                                "en": "He <w>suffered</w> from a serious illness for years."
                            }
                        },
                        {
                            "text": "De organisatie <w>leed</w> onder een gebrek aan goede leiding.",
                            "target_lang_translations": {
                                "en": "The organization <w>suffered</w> from a lack of good leadership."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leed aan"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "singular past tense of 'to suffer'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "suffered",
                                "target_lang_sense_clarification": "past tense of experiencing pain or hardship"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
