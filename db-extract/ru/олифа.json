                                                "sense_id": "5afda2e8-f1f2-3627-917e-b4f66f2476dd",
                                                "text": "Um den Firnis erneuern zu können, sollte er abnehmbar sein."
                                            },
                                            {
                                                "example_id": "9e910720-ba5b-4518-9d53-1312e7088bb4",
                                                "sense_id": "5afda2e8-f1f2-3627-917e-b4f66f2476dd",
                                                "text": "„Ihr kultureller Firnis ist die erstklassige kubanische Vergangenheit, aber ihre Ermächtigungen entspringen ihrer Eitelkeit.“"
                                            },
                                            {
                                                "example_id": "6b554157-31d6-4ba2-954a-d0ddccae4d19",
                                                "sense_id": "5afda2e8-f1f2-3627-917e-b4f66f2476dd",
                                                "text": "„Im ersten Moment konnte ich unter dem gelblichen Firnis nichts erkennen.“"
                                            }
                                        ],
