                        ],
                        "form": "ursidés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "522085d3-5139-397e-be55-ede88600a3d9",
                        "entry_id": "75625cac-c279-36d6-8127-643ee0c5df57",
                        "glosses": [
                            "Mammifère caniforme plantigrade de l’ordre des carnivores, dont le type est l’ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8ea928-839e-4558-8928-c2599f7adae3",
                                "sense_id": "522085d3-5139-397e-be55-ede88600a3d9",
                                "text": "Avec les conditions sanitaires qui prévalaient le printemps dernier, ce sont presqu'exclusivement des Québécois qui ont récolté des ursidés."
                            },
                            {
                                "example_id": "354cee56-39c9-4b06-9efa-cf324a54084f",
                                "sense_id": "522085d3-5139-397e-be55-ede88600a3d9",
                                "text": "L’ours polaire (Ursus maritimus) est le plus grand ursidé."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc6e2370-4f38-36ac-aa4c-287d22fd3257",
                        "entry_id": "75625cac-c279-36d6-8127-643ee0c5df57",
                        "glosses": [
                            "pluriel Famille comprenant les ours et les grands pandas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "298c5e4f-12ec-447f-b2b3-c77777c46798",
                                "sense_id": "cc6e2370-4f38-36ac-aa4c-287d22fd3257",
                                "text": "On hésite encore à classer le petit panda parmi les ursidés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43b7d702-e31b-4b38-b9b0-fbd7e54e0675",
                        "source_entry_id": "75625cac-c279-36d6-8127-643ee0c5df57",
                        "target_lang_word": "Bär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Tier (Raubtier, Säugetier) aus der Familie Ursidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b29e6f4-ded4-4c3b-8235-088fa9b9872c",
                                                "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                                "text": "Der Bär gilt als blutrünstiges Raubtier, ist aber ein Allesfresser."
                                            },
                                            {
                                                "example_id": "fe98ceb5-09b5-4185-9786-1f0e55a698a5",
                                                "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                                "text": "„Der Bär war schon alt.“"
                                            },
                                            {
                                                "example_id": "b18941ed-17b4-43cc-a4fc-94930ef49e32",
                                                "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                                "text": "„Der kleine Bär steigt die Treppen hinunter, geht zum Tisch, setzt sich in den kleinen Stuhl und schaut in sein Schüsselchen.“"
                                            },
                                            {
                                                "example_id": "10956a2a-d22d-4c79-b099-8855a1472fbb",
                                                "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                                "text": "„Der Bär grub sich dann zur Hibernierung unter einer zerfallenen Scheune dicht neben dem Weg ein und störte uns nicht, wir ihn auch nicht, und man bekam ihn nie zu Gesicht, nur im Vorfrühling roch man ihn, wenn der Wind von Südwesten wehte.“"
                                            },
                                            {
                                                "example_id": "5791f920-19fc-45c2-90c4-cf6b575a199b",
                                                "sense_id": "e21df9c4-cf1b-396a-af9e-e725d68f48ce",
                                                "text": "„Die Bären im Torgauer Gehege waren Luther wohl egal, im Unterschied zu den frei laufenden Säuen in Wittenberg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9c8f2631-2c6e-3a2b-ac6a-5c5f777f828a",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Kuscheltier in Gestalt eines Bären ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29547c85-c835-485a-ab7e-3014710b04d0",
                                                "sense_id": "9c8f2631-2c6e-3a2b-ac6a-5c5f777f828a",
                                                "text": "Als Kind bin ich nie ohne meinen Bären ins Bett gegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "294afdb0-d448-30d3-9050-d98db12fa26c",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Sternbild des Nordhimmels"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9efe5f00-3802-4e30-b984-f9adc0fdac17",
                                                "sense_id": "294afdb0-d448-30d3-9050-d98db12fa26c",
                                                "text": "Dort oben siehst du den großen Bären!"
                                            },
                                            {
                                                "example_id": "53e06c2e-1b6d-45d1-a8bd-9c3cc4e0a02f",
                                                "sense_id": "294afdb0-d448-30d3-9050-d98db12fa26c",
                                                "text": "„Er spielt dabei auf das Sternbild \"Bär\" alias \"Wagen\" an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2c450e6f-fe83-36a1-8dd2-7493ad791cfb",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Schambehaarung der Frau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26fa9d3e-469b-4820-94e7-c3e5d7a2af44",
                                                "sense_id": "2c450e6f-fe83-36a1-8dd2-7493ad791cfb",
                                                "text": "Da sie keine Unterwäsche anhatte, konnte man deutlich ihren Bären erkennen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c76738f2-a887-3b4b-9911-e0b5c506af82",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Nachtfalter aus der Familie Arctiidae"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96c1516-b210-49a2-85b9-5efc9bbe338e",
                                                "sense_id": "c76738f2-a887-3b4b-9911-e0b5c506af82",
                                                "text": "Bären zählen zwar zu den Nachtfaltern, sind aber tagaktiv."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "ed38169d-47c2-3d67-82c4-719d7ec9bf2c",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "ein Wappentier"
                                        ],
                                        "tags": [
                                            "Heraldik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b57fdd1f-966e-4fe3-8e80-a7dd12b4a896",
                                                "sense_id": "ed38169d-47c2-3d67-82c4-719d7ec9bf2c",
                                                "text": "Das Berliner Wappen zeigt in silbernem (weißem) Schild einen rot bewehrten und rot gezungten, aufrecht schreitenden schwarzen Bären."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "286e0899-523a-38bc-91ca-e9ebb2cb3d21",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "männliches Murmeltier"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bad7b45e-37a9-47aa-b2ed-9724fa7a7e4b",
                                                "sense_id": "286e0899-523a-38bc-91ca-e9ebb2cb3d21",
                                                "text": "Da unter Jägern die erlegte Beute nicht selten größer gemacht wird, als sie tatsächlich ist, hat sich im 19. Jahrhundert eingebürgert, dass männliche Murmeltiere als Bären bezeichnet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "1ccbcee8-9478-3901-a18a-4b020f56b29b",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "Schwuler oder bisexueller Mann mit starker Körperbehaarung und ausgeprägtem Barthaar"
                                        ],
                                        "tags": [
                                            "Jargon",
                                            "LGBTQ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b34ab3b2-4373-43fe-abcc-3c7e4d093740",
                                                "sense_id": "1ccbcee8-9478-3901-a18a-4b020f56b29b",
                                                "text": "„Aufgrund seines Interesses für die schwulen Bären war Ali häufig auf der Suche nach Schwulen, die sich als Bär sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "4f62aae3-0b70-35c8-b9b4-b7c1202f13ae",
                                        "entry_id": "50c323a1-85c7-3d15-8ab8-d5fe201afafa",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089819be-4f1d-4bfb-8f26-b373dad4ac82",
                                                "sense_id": "4f62aae3-0b70-35c8-b9b4-b7c1202f13ae",
                                                "text": "„Du hast schon richtig gehört, du bist mein Bär. Oder ist es noch zu früh für bildhafte Kosenamen?„"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Bär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "023c3120-3447-367d-a29e-eac57e362a86",
                                        "entry_id": "848dfbe6-8dac-3ecf-9b5f-3c49e5d5c6c3",
