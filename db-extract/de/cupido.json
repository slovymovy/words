                    {
                        "translation_id": "04931528-5019-4a13-a4e8-262ac2cac295",
                        "source_entry_id": "3e53d478-33b2-3e6a-b3c7-5c76c832dfc2",
                        "source_sense_id": "337d8b21-b2a6-3cc2-aa67-c00d97a506f0",
