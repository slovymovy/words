    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                "word": "obeisance",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2e511bc8-9a39-4365-a7ae-c91709310fbe",
                        "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                        "tags": [
                            "plural"
                        ],
                        "form": "obeisances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                        "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                        "glosses": [
                            "Demonstration of an obedient attitude, especially by bowing deeply; a deep bow which demonstrates such an attitude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "16f64986-fbe5-4960-8d18-8d10bd7c071c",
                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                "text": "In there stepped a stately raven of the saintly days of yore; / Not the least obeisance made he; not a minute stopped or stayed he;"
                            },
                            {
                                "example_id": "282692e9-85e3-493b-a815-0d9dcefc7f2f",
                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                "text": "But looking upwards in the blaze of the moon I suddenly saw colossi sitting near, and towering up and blotting out the stars and filling the night with blackness; and at those idols’ feet I saw praying and making obeisance kings and the days that are and all times and all cities and all nations and all their gods."
                            },
                            {
                                "example_id": "8ef9d522-c1b1-4534-afa9-a7e47f493fd9",
                                "sense_id": "4fdec79a-c754-309b-ae1b-3d0bba8253e2",
                                "text": "The situation in the case of actions which are non-linguistic but similar to performative utterances in that they are the performance of a conventional action (here ritual or ceremonial) is rather like this: suppose I bow deeply before you; it might not be clear whether I am doing obeisance to you or, say, stooping to observe the flora or to ease my indigestion."
                            }
                        ]
                    },
                    {
                        "sense_id": "521f9b24-96fe-34c0-b06e-f1a2c83fbf61",
                        "entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                        "glosses": [
                            "An obedient attitude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86f80801-d847-41ec-adee-16e671254eb2",
                        "source_entry_id": "07391505-c56c-3138-8872-7f820e9d9e20",
                        "source_sense_description": "demonstration of an obedient attitude, especially by bowing deeply; a deep bow which demonstrates such an attitude",
                        "target_lang_word": "Verbeugung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verbeugung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                        "entry_id": "ddfba586-7632-34be-ab07-274db005bdbd",
                                        "glosses": [
                                            "der Vorgang des Verbeugens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6cdef7c-adf3-457b-8578-e2e0dd393db2",
                                                "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                                "text": "Die Verbeugung beim Judo heißt Kotau."
                                            },
                                            {
                                                "example_id": "5cf781d3-15a1-4425-9dc0-d6921c2560ff",
                                                "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                                "text": "„Valenti machte eine artige Verbeugung vor ihr.“"
                                            },
                                            {
                                                "example_id": "81c4a334-7085-4bcc-9d1b-b795744d7dec",
                                                "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                                "text": "„Der Gendarmerieoffizier macht eine Verbeugung und entfernt sich, er geht wieder zu seinen beiden Soldaten und spricht leise mit ihnen.“"
                                            },
                                            {
                                                "example_id": "7987af4b-7802-4c8b-927c-69ab33cfde32",
                                                "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                                "text": "„Der Mann mit dem Kind kommt indessen eilig heran – und verblüfft und beehrt mich mit formvollendeter Verbeugung samt Handkuß.“"
                                            },
                                            {
                                                "example_id": "89dc8e22-af3d-47e4-a785-21c2dd999baa",
                                                "sense_id": "b77d9d5a-ea93-3cc6-9d0f-64f2ea476580",
                                                "text": "„Ramin deutet eine Verbeugung an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
