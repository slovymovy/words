                    {
                        "sense_id": "aa1ab714-3a61-3f9d-9e45-3b175855e074",
                        "entry_id": "9f53343a-2b94-3887-99c5-85c367b1cc4b",
                        "glosses": [
                            "Einheit eines Einheitensystems, auf der alle andere Einheiten basieren"
                        ],
                        "tags": [
                            "Naturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "c2f92fce-452c-46e2-b68b-9ea2f306ca8e",
                                "sense_id": "aa1ab714-3a61-3f9d-9e45-3b175855e074",
                                "text": "Aus den Basiseinheiten werden alle andere Einheiten des Einheitssystems abgeleitet."
                            },
                            {
                                "example_id": "3295d046-6324-4cd6-8ad1-8ddb3de74a30",
                                "sense_id": "aa1ab714-3a61-3f9d-9e45-3b175855e074",
                                "text": "„Einem Frequenz- oder Zeitnormal kommt dabei eine besonders wichtige Rolle zu, da sich davon die SI-Basiseinheit \"Meter\" über die Festlegung der Lichtgeschwindigkeit ableitet und ein Frequenznormal über Josephson- und Quanten-Hall-Effekt mit der Basiseinheit \"Ampere\" verknüpft ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
