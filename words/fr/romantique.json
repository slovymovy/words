                        "poésie romantique"
                    ]
                },
                {
                    "sense_id": "3d67ac54-4c8e-319c-8033-cfbdda76b297",
                    "sense_definition": "Qui touche la sensibilité et invite à la rêverie par son aspect pittoresque ou mystérieux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esthetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce vieux château entouré de brume offre un paysage particulièrement <w>romantique</w>."
                        },
                        {
                            "text": "Les artistes aimaient peindre ces jardins secrets à l'atmosphère sauvage et <w>romantique</w>."
