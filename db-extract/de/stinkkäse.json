                "senses": [
                    {
                        "sense_id": "882bc4f5-5832-3036-a18c-849725131190",
                        "entry_id": "3a18b03a-a05c-3245-8d8d-40fd02268a22",
                        "glosses": [
                            "Käse, der extrem und unangenehm riecht – was aber nicht bedeuten muss, dass er schlecht schmeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9671ddba-9736-4f13-80df-3c355edfbc06",
                                "sense_id": "882bc4f5-5832-3036-a18c-849725131190",
                                "text": "Als sie den Kühlschrank öffnete, roch sie sofort, dass ihr Mann auf dem Wochenmarkt wieder diesen Stinkkäse gekauft hatte."
                            },
                            {
                                "example_id": "1c894e02-7c23-4e74-977d-1ef37bba84d4",
                                "sense_id": "882bc4f5-5832-3036-a18c-849725131190",
                                "text": "Allgäuer Kässpatzen werden durch ein Stück Stinkkäse (z. B. Weißlacker) erst perfekt."
                            },
                            {
                                "example_id": "417cc01c-a2ca-438f-a01b-c9ecc6f7225d",
                                "sense_id": "882bc4f5-5832-3036-a18c-849725131190",
                                "text": "„Soll ein Käse richtig stinken, muss er auch Stinkkäse heißen. Das haben Forscher jetzt herausgefunden, als sie den Einfluss von Wörtern auf die Geruchswahrnehmung untersuchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
