                    {
                        "sense_id": "1877c67c-b622-3921-a0e2-4934eb32bb32",
                        "entry_id": "38ff3fc5-bf37-3bd4-8cf5-fb9b461f1193",
                        "glosses": [
                            "Plat composé de moules et de frites, populaire en Belgique et dans le nord de la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "618ad5ec-ee91-4587-9b76-a5763a42b47a",
                                "sense_id": "1877c67c-b622-3921-a0e2-4934eb32bb32",
                                "text": "Environ 6 000 visiteurs sur les trois jours, 350 convives au dîner du vendredi soir et presque 600 le samedi soir, le tout autour des traditionnelles moules-frites."
                            },
                            {
                                "example_id": "cb3acc14-9fc2-4c52-ba85-99c6fa88a88c",
                                "sense_id": "1877c67c-b622-3921-a0e2-4934eb32bb32",
                                "text": "Après l’annulation de la Grande Braderie de Lille, la moules-frites, son plat emblématique, veut se montrer solidaire."
                            },
                            {
                                "example_id": "2ec13f86-6a02-4680-8d73-1b610c129daf",
                                "sense_id": "1877c67c-b622-3921-a0e2-4934eb32bb32",
                                "text": "Après la soirée moules-frites qui a rassemblé près de cent soixante-dix personnes, le foyer rural de Saint-Paul remercie les personnes participantes et s’excuse auprès de ceux qui n’ont pas pu être retenus."
                            }
                        ]
                    }
