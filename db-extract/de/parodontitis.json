                    {
                        "sense_id": "673336ea-7aca-34c4-af4c-a3767c6d340e",
                        "entry_id": "1ce63ab1-8f8c-3c07-9332-988d097e0aa0",
                        "glosses": [
                            "Bezeichnung einer Erkrankung des Zahnhalteapparates, je nach Schweregrad mit Lockerung der Zähne"
                        ],
                        "tags": [
                            "Zahnmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "e6f78b2a-ccf4-4880-af29-ee75dba5dff0",
                                "sense_id": "673336ea-7aca-34c4-af4c-a3767c6d340e",
                                "text": "\"Besonders schlimm war Ötzis Parodontitis: Manche Zahnhälse lagen fast bis zu den Wurzelspitzen frei.\""
                            },
                            {
                                "example_id": "418f0853-7292-4154-9b0a-428bfc0b92b3",
                                "sense_id": "673336ea-7aca-34c4-af4c-a3767c6d340e",
                                "text": "\"Viele entdecken eine Parodontitis erst, wenn sich ein Zahn lockert.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a82237a5-df9f-40b9-b33d-99c0cfd61576",
                        "source_entry_id": "1ce63ab1-8f8c-3c07-9332-988d097e0aa0",
