                "senses": [
                    {
                        "sense_id": "a4d114ee-8407-3b88-8c41-11cb3b86727b",
                        "entry_id": "a4b64176-9456-3749-8cdc-c66f93f7a583",
                        "glosses": [
                            "lijkend op vet; eigenschappen hebben die vet ook heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ac79972-cee6-408e-9839-ead08e7458e0",
                                "sense_id": "a4d114ee-8407-3b88-8c41-11cb3b86727b",
                                "text": "Utrechtse wetenschappers hebben een belangrijke stap gezet in het onderzoek naar de bestrijding van tuberculose. Ze ontdekten in het menselijk bloed afweercellen die vetachtige stoffen in tuberculosebacteriën herkennen. Deze stoffen kunnen het vaccin tegen tuberculose verbeteren. Dat meldt de Universiteit Utrecht woensdag."
                            },
                            {
                                "example_id": "8eff5aba-213a-4269-a187-62abe14e9611",
                                "sense_id": "a4d114ee-8407-3b88-8c41-11cb3b86727b",
                                "text": "Hart- en vaatziekten worden vaak in verband gebracht met een te hoog cholesterol. Wie denkt dat cholesterol alleen maar slecht voor ons is, slaat de plank mis. “We kunnen niet leven zonder cholesterol”, vertelt Wittekoek. “Dit vetachtige stofje zorgt voor de aanmaak van nieuwe cellen en de productie van hormonen.”"
                            },
                            {
                                "example_id": "7fe3935f-2c33-4d75-99ca-4c2e2c4a2803",
                                "sense_id": "a4d114ee-8407-3b88-8c41-11cb3b86727b",
                                "text": "Knipperen is een natuurlijke functie om het oog vochtig te houden en tegen vuil te beschermen. Door te knipperen activeer je de traanklier bovenop je oogbal die een vetachtige vloeistof afgeeft."
                            }
                        ]
                    }
