                        "entry_id": "570969cb-7d63-35f0-abf4-b8c49f709c75",
                        "glosses": [
                            "Calvados."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "d261eb24-3036-4064-8e12-7eb25b277e9c",
                                "sense_id": "1119aee8-7385-3ffe-96e1-471e235fdb9e",
                                "text": "Ça sera… ça sera, ça sera, ça sera — un vieux calva, mon enfant."
                            },
                            {
                                "example_id": "54f0e1c1-a1c9-4e17-ad79-5b147da1ef45",
                                "sense_id": "1119aee8-7385-3ffe-96e1-471e235fdb9e",
                                "text": "Là-dessus, le Maillard sortit un litre de sa musette et lampa une forte gorgée de calva, pour se redonner du courage."
                            },
                            {
                                "example_id": "67581f0a-14da-4b92-a417-d3ed8fdd5181",
                                "sense_id": "1119aee8-7385-3ffe-96e1-471e235fdb9e",
                                "text": "Le patron, Bertin, un grand homme aux cheveux blond-roux, aux pommettes hautes et aux yeux clairs, servait un calva unique au monde, puisque censé vous donner la jeunesse éternelle en vous fouettant correctement l’intérieur au lieu de vous expédier directement dans la tombe."
                            }
                        ]
                    }
