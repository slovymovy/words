                        "examples": []
                    },
                    {
                        "sense_id": "2ba10666-dd44-3ad4-bf0a-b7f6383ccad8",
                        "entry_id": "d67a813d-561d-35a3-a1e1-da27bd9f96a4",
                        "glosses": [
                            "Initialism of continuing resolution."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "countable",
                            "initialism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c14960-af7c-425b-87cf-1c1bde20ccc3",
                                "sense_id": "2ba10666-dd44-3ad4-bf0a-b7f6383ccad8",
                                "text": "Most continuing resolutions are temporary measures that expire on the date specified in the CR, or are superseded by enactment of the regular appropriations act."
                            },
                            {
                                "example_id": "0fdeda4d-83f9-4b4a-b2a0-020604e492a3",
                                "sense_id": "2ba10666-dd44-3ad4-bf0a-b7f6383ccad8",
                                "text": "A few days later in a meeting with the president, Clinton asked Gingrich for a continuing resolution (CR) to continue funding the government until they could work out a compromise. “If I go back and try to get a longterm CR without a budget from you, the next time you'll be dealing with Speaker Armey,\" he said."
                            },
                            {
                                "example_id": "88eb7495-dcb8-4c87-ab14-59f6e83e47a9",
                                "sense_id": "2ba10666-dd44-3ad4-bf0a-b7f6383ccad8",
                                "text": "CRs are a common occurrence because it is highly unusual for Congress and the president to pass all 13 appropriations bills by the start of the new fiscal year."
                            }
                        ]
                    },
