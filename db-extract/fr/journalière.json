                        "glosses": [
                            "Personne qui travaille à la journée."
                        ],
                        "tags": [
                            "Par substantivation"
                        ],
                        "examples": [
                            {
                                "example_id": "95f6bb50-9daa-46af-bbc9-2e861c61b1e3",
                                "sense_id": "77d1e28b-109c-3470-bb88-1ee16da3dc24",
                                "text": "Étaient là, avec les Misanger et Christophe, Léa, Maxime et une vieille journalière toute ridée mais brave encore et dont les bras, par ces temps difficiles, ne chômaient point."
                            },
                            {
                                "example_id": "1df614a7-3e50-426b-ab38-f6efdf3cc4d7",
                                "sense_id": "77d1e28b-109c-3470-bb88-1ee16da3dc24",
                                "text": "Eulalie Pellerin, tailleuse à Pornic, âgée de 28 ans, dort avec sa mère, une journalière de 48 ans et avec sa fille naturelle, âgée de 6 ans."
                            }
                        ]
                    }
