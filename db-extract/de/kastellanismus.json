                "senses": [
                    {
                        "sense_id": "31858bd8-8481-310b-87b7-c330c23ad959",
                        "entry_id": "ed9f705c-91cd-3a15-a8bf-0d15d3531765",
                        "glosses": [
                            "Ausdruck der kastilischen (spanischen) Sprache, der in eine andere Sprache entlehnt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a670f41-c84d-4e36-a0fa-78440050c18f",
                                "sense_id": "31858bd8-8481-310b-87b7-c330c23ad959",
                                "text": "„Etwas anders sieht die Situation im Katalanischen aus, gilt doch pues vielen erwachsenen Sprechern, insbesondere den sehr normbewussten, als Kastellanismus und daher als Fehler."
                            },
                            {
                                "example_id": "db6da8db-2427-4d29-a2ee-9fc7b3128da1",
                                "sense_id": "31858bd8-8481-310b-87b7-c330c23ad959",
                                "text": "„Diese Form wird in der Norm nicht zugelassen und gilt als Kastellanismus.“"
                            },
                            {
                                "example_id": "9a9d675d-d4d5-420f-a55b-e7ff49b73045",
                                "sense_id": "31858bd8-8481-310b-87b7-c330c23ad959",
                                "text": "„Seguir + Gerund wird als Kastellanismus empfunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
