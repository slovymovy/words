                    }
                ],
                "senses": [
                    {
                        "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                        "entry_id": "63247a80-d884-394f-bb63-d62244106cb9",
                        "glosses": [
                            "rechteckiges, paniertes Fischfilet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8544a792-482c-4a40-b9d9-2efbfef597f3",
                                "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                                "text": "Kinder, heute gibt es Fischstäbchen!"
                            },
                            {
                                "example_id": "9629e866-ec28-45d4-800e-b31eee1a71f0",
                                "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                                "text": "Fischstäbchen können frittiert, gebraten oder im Backofen zubereitet werden."
                            },
                            {
                                "example_id": "04e42233-f3ea-4718-a8a3-ed6196257afa",
                                "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                                "text": "Zu den Fischstäbchen gibt es Kartoffeln und Spinat als Beilage."
                            },
                            {
                                "example_id": "6d65867b-ba46-435f-a90c-1b3ffe41e650",
                                "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                                "text": "Wenn Papa Jan angeln geht, macht Mama Mona lieber Fischstäbchen."
                            },
                            {
                                "example_id": "515b02eb-89d0-43f0-bc54-e1612c101cff",
                                "sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                                "text": "„Ich nahm mir vor, auf richtigen Fisch umzusteigen. Vor Zeugen hätte ich in meinem Alter sowieso kein Fischstäbchen mehr essen wollen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a7da73c-b571-4c69-a9ec-e0d6775b8e80",
                        "source_entry_id": "63247a80-d884-394f-bb63-d62244106cb9",
                        "source_sense_id": "f8063011-1a3d-334f-809d-c8ce66352d24",
                        "source_sense_description": "rechteckiges, paniertes Fischfilet",
                        "target_lang_word": "fish finger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fish finger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                        "entry_id": "4eade6c7-dc77-33a4-b7f8-a4dbd69f74d1",
                                        "glosses": [
                                            "A rectangular stick of processed fish coated in breadcrumbs that is cooked by frying or grilling."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "697a0b1f-a540-40a0-80ac-655652dc51b9",
                                                "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                                "text": "“Birds Eye fish fingers,” he said, “are made from cod, and when, a short while back there was talk of some strange deep sea varieties creeping into fish fingers, we, as a company spent £500 000 reassuring the consumer[…].”"
                                            },
                                            {
                                                "example_id": "c37a3f24-51d6-4431-add9-dc3a812df0fd",
                                                "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                                "text": "Next week will solve your problems / But now, fish fingers all in a line"
                                            },
                                            {
                                                "example_id": "90eecb9d-3c01-4566-8631-0a74278a2302",
                                                "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                                "text": "After green peas, the product that most helped Birds Eye was fish fingers."
                                            },
                                            {
                                                "example_id": "5a08e574-a4b8-4ece-9b5d-9432c6d0aadc",
                                                "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                                "text": "2009, Linda Larsen, The $7 Meals Cookbook: 301 Delicious, Nutritious Recipes the Whole Family Will Love, Adams Media, MA, page 148,\nFish fingers are usually sold in very large packages, about 3–5 pounds."
                                            },
                                            {
                                                "example_id": "488998d6-66fa-425d-9fad-ef29b2120553",
                                                "sense_id": "da9f4186-b8dc-3215-86c6-e4141a77ba1c",
                                                "text": "If chip butties are the king of beige, fish finger sarnies are the queen. Home-made fish fingers are super-easy to make and freeze well, so make a large batch and keep them for a rainy day."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
