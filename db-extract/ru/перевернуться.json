                            "active",
                            "past"
                        ],
                        "form": "переверну́вшийся"
                    },
                    {
                        "form_id": "a200ac1e-8fc0-4142-b2b7-bba3def66ada",
                        "entry_id": "7053356f-49da-3b67-8318-329d437275c6",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "переверну́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c434edc-1c89-3bb7-b663-d6fff5ca6328",
                        "entry_id": "7053356f-49da-3b67-8318-329d437275c6",
                        "glosses": [
                            "повернуться противоположной стороной, с одной стороны на другую"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18b2f7b6-cde3-4bf0-b28c-54efdbdc8aa3",
                                "sense_id": "7c434edc-1c89-3bb7-b663-d6fff5ca6328",
                                "text": "Он с силой оттолкнулся от брусьев, пролетел упругой дугой на полторы сажени вперёд, перевернулся в воздухе и ловко, по-кошачьи, присел на землю."
                            },
                            {
                                "example_id": "8fa0d8e0-4854-4e84-9ffd-85e29b954f9a",
                                "sense_id": "7c434edc-1c89-3bb7-b663-d6fff5ca6328",
                                "text": "Корабль скрипел и трещал, толстые доски разлетались в щепки, волны перекатывались через палубу — вот грот-мачта переломилась, как тростинка, корабль перевернулся набок, и вода хлынула в трюм."
                            }
                        ]
                    },
                    {
                        "sense_id": "24143239-055c-3d07-aad7-3927c4cea77a",
                        "entry_id": "7053356f-49da-3b67-8318-329d437275c6",
                        "glosses": [
                            "повернуться нижней стороной кверху; опрокинуться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f001e61c-6cc3-4d53-bde6-bb9899100551",
                                "sense_id": "24143239-055c-3d07-aad7-3927c4cea77a",
                                "text": "Напор его был так силен, что встретившийся на его дороге стул, задетый им на лету, отскочил на сажень и перевернулся на месте."
                            },
                            {
                                "example_id": "32374be8-70c0-4400-8b63-927c0709d1c5",
                                "sense_id": "24143239-055c-3d07-aad7-3927c4cea77a",
                                "text": "Он перевернулся на спину и заложил руки за голову. Несколько мгновений прошло в молчании."
                            }
                        ]
                    },
                    {
                        "sense_id": "70062616-8ab0-308f-86a0-ecb236f66df1",
                        "entry_id": "7053356f-49da-3b67-8318-329d437275c6",
                        "glosses": [
                            "перен. стать совершенно иным, резко измениться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1a7348a-f685-403c-af9c-046e804286ca",
                                "sense_id": "70062616-8ab0-308f-86a0-ecb236f66df1",
                                "text": "Он, казалось, по-старому продолжал жить в станице, но в душе у него всё перевернулось."
                            },
                            {
                                "example_id": "8f74e8c5-e55d-4b11-8019-07aadcfbe4e4",
                                "sense_id": "70062616-8ab0-308f-86a0-ecb236f66df1",
                                "text": "Сердце моё сжалось и перевернулось от чувства, которое нельзя назвать ни жалостью, ни состраданием, потому что оно было сильнее этих чувств."
                            },
                            {
                                "example_id": "c078ea67-e865-4d1f-86d8-e4d8f753e80c",
                                "sense_id": "70062616-8ab0-308f-86a0-ecb236f66df1",
                                "text": "До того всё было невозможно, до того непонятно адмиралу, привыкшему к безусловному повиновению и не знавшему никогда никакой препоны своей воле. И вдруг этот щенок! Эти решительные, смелые глаза! Уж не перевернулся ли свет?.."
                            }
                        ]
                    }
                ],
