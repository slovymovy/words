                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1636078-1385-4a02-94fe-0e4a56924381",
                                "sense_id": "66351e03-353c-3ca1-8751-edd039eac319",
                                "text": "La plupart des exoplanètes découvertes jusqu'à aujourd'hui sont des géantes gazeuses, comme Jupiter, qui gravitent sur une orbite très proche de leur étoile.",
                                "translation": "Większość do dziś odkrytych planet pozasłonecznych to gazowe olbrzymy takie jak Jowisz, które poruszają się po orbicie bardzo zbliżonej do swojej gwiazdy. (Science & vie, nr 1085, luty 2008"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [],
