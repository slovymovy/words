{
    "word_family": [
        "candied",
        "candymaker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "008176b6-3741-33f2-b22e-dd95942c8031",
                    "sense_definition": "Sweet food made mainly from sugar or syrup, often flavored with fruit, chocolate, nuts, or spices.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ate too much <w>candy</w> at the birthday party.",
                            "target_lang_translations": {
                                "ru": "Дети съели слишком много <w>сладостей</w> на дне рождения.",
                                "zh": "孩子们在生日派对上吃了太多的<w>糖果</w>。"
                            }
                        },
                        {
                            "text": "She bought a bag of hard <w>candy</w> from the store.",
                            "target_lang_translations": {
                                "ru": "Она купила в магазине пакет <w>леденцов</w>.",
                                "zh": "她从商店买了一袋硬<w>糖</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sweets",
                        "confectionery",
                        "sugar candy"
                    ],
                    "common_phrases": [
                        "cotton candy",
                        "candy bar",
                        "hard candy",
                        "eye candy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкое блюдо, приготовленное в основном из сахара или сиропа, часто с добавлением фруктов, шоколада, орехов или специй.",
                        "zh": "主要由糖或糖浆制成的甜食，常添加水果、巧克力、坚果或香料调味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сладости",
                                "target_lang_sense_clarification": "кондитерские изделия в целом"
                            },
                            {
                                "target_lang_word": "конфеты",
                                "target_lang_sense_clarification": "собирательное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糖果",
                                "target_lang_sense_clarification": "泛指各类甜食"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbfa970c-56f3-3b49-a9ce-f10c6504bc34",
                    "sense_definition": "A single piece of sweet confectionery.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_confectionery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take a <w>candy</w> from the bowl on the table.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, возьми <w>конфету</w> из вазочки на столе.",
                                "zh": "请从桌上的碗里拿<w>一颗糖</w>。"
                            }
                        },
                        {
                            "text": "He gave me a peppermint <w>candy</w> after dinner.",
                            "target_lang_translations": {
                                "ru": "После ужина он дал мне мятную <w>конфету</w>.",
                                "zh": "晚饭后他给了我一颗薄荷<w>糖</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sweet",
                        "lolly"
                    ],
                    "common_phrases": [
                        "piece of candy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельное кондитерское изделие.",
                        "zh": "单块的甜食。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конфета",
                                "target_lang_sense_clarification": "одна штука"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一颗糖",
                                "target_lang_sense_clarification": "指代单块糖果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea714594-b1f4-3da8-bbac-6eeb4bccc57a",
                    "sense_definition": "Crack cocaine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "drugs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the dealer for selling <w>candy</w> on the street corner.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала дилера за продажу <w>крэка</w> на углу улицы.",
                                "zh": "警察因该毒贩在街角兜售<w>快克</w>而将其逮捕。"
                            }
                        },
                        {
                            "text": "He ruined his health and career by using <w>candy</w>.",
                            "target_lang_translations": {
                                "ru": "Он разрушил свое здоровье и карьеру, употребляя <w>крэк</w>.",
                                "zh": "他因吸食<w>快克</w>而毁掉了健康和事业。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Крэк-кокаин.",
                        "zh": "快克可卡因。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крэк",
                                "target_lang_sense_clarification": "наркотик (слэнг)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快克",
                                "target_lang_sense_clarification": "毒品俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07354003-2f81-32ad-8af7-a4b674c25824",
                    "sense_definition": "An accessory, such as a bracelet, made from colorful beads and associated with rave culture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fashion_subculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore colorful <w>candy</w> on both wrists to the music festival.",
                            "target_lang_translations": {
                                "ru": "Она надела разноцветные <w>фенечки</w> на оба запястья на музыкальный фестиваль.",
                                "zh": "她戴着色彩斑斓的<w>串珠手链</w>去参加音乐节。"
                            }
                        },
                        {
                            "text": "The ravers traded <w>candy</w> as a sign of friendship.",
                            "target_lang_translations": {
                                "ru": "Рейверы обменивались <w>браслетами</w> в знак дружбы.",
                                "zh": "锐舞客们通过交换<w>串珠手链</w>来表达友谊。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "candy raver"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аксессуар, например браслет, сделанный из разноцветных бусин и ассоциирующийся с рейв-культурой.",
                        "zh": "一种由彩色珠子制成的饰品，如手链，常与锐舞文化相关。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фенечка",
                                "target_lang_sense_clarification": "браслет из бисера"
                            },
                            {
                                "target_lang_word": "канди",
                                "target_lang_sense_clarification": "рейверский браслет"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "串珠手链",
                                "target_lang_sense_clarification": "锐舞文化中的饰品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e566428c-1c92-30a4-a4b1-5a99c5262930",
                    "sense_definition": "A unit of weight used in southern India, roughly equal to 500 pounds but varying locally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant ordered a <w>candy</w> of spices for the market.",
                            "target_lang_translations": {
                                "ru": "Торговец заказал <w>канди</w> специй для рынка.",
                                "zh": "商人为市场订购了一<w>坎迪</w>香料。"
                            }
                        },
                        {
                            "text": "In the old records, the harvest was measured by the <w>candy</w>.",
                            "target_lang_translations": {
                                "ru": "В старых записях урожай измерялся в <w>канди</w>.",
                                "zh": "在旧记录中，收成是以<w>坎迪</w>来衡量的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maunee"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "India"
                        },
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица веса, используемая в южной Индии, примерно равная 500 фунтам, но варьирующаяся в зависимости от местности.",
                        "zh": "印度南部使用的一种重量单位，约等于500磅，各地略有差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "канди",
                                "target_lang_sense_clarification": "мера веса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坎迪",
                                "target_lang_sense_clarification": "历史重量单位"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "268a7cba-0b9c-3631-a533-f1d51faf4ebf",
                    "sense_definition": "To cook something in sugar syrup or coat it with sugar.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother likes to <w>candy</w> orange peels for the holidays.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка любит <w>засахаривать</w> апельсиновые корки к праздникам.",
                                "zh": "我祖母喜欢在节日时把橘子皮<w>糖渍</w>起来。"
                            }
                        },
                        {
                            "text": "You can <w>candy</w> ginger to make a spicy and sweet treat.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>засахарить</w> имбирь, чтобы получить пряное и сладкое лакомство.",
                                "zh": "你可以把姜<w>糖渍</w>起来，做成一种辛甜的零食。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "candy fruit",
                        "candy peel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Варить что-либо в сахарном сиропе или покрывать сахаром.",
                        "zh": "将食物放入糖浆中煮或裹上糖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засахаривать",
                                "target_lang_sense_clarification": "покрывать сахаром"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糖渍",
                                "target_lang_sense_clarification": "用糖浆烹煮或裹上糖"
                            },
                            {
                                "target_lang_word": "蜜饯",
                                "target_lang_sense_clarification": "做成糖渍果脯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d35ac432-aca1-3da6-b52b-be2ffbdcb87c",
                    "sense_definition": "To form into sugar crystals or solidify into a mass.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you boil the syrup too long, it will start to <w>candy</w>.",
                            "target_lang_translations": {
                                "ru": "Если варить сироп слишком долго, он начнет <w>засахариваться</w>.",
                                "zh": "如果糖浆煮得太久，它就会开始<w>结晶</w>。"
                            }
                        },
                        {
                            "text": "The old honey in the jar began to <w>candy</w> and turn white.",
                            "target_lang_translations": {
                                "ru": "Старый мед в банке начал <w>засахариваться</w> и белеть.",
                                "zh": "罐子里陈年的蜂蜜开始<w>结晶</w>并变白了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Превращаться в сахарные кристаллы или застывать в массу.",
                        "zh": "形成糖结晶或凝固成块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "засахариваться",
                                "target_lang_sense_clarification": "кристаллизоваться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结晶",
                                "target_lang_sense_clarification": "指糖分析出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a3f1ca5b-f026-399e-ba49-ef65091a1b4b",
                    "sense_definition": "A female given name, often a short form of Candace or Candice.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I went to school with a girl named <w>Candy</w>.",
                            "target_lang_translations": {
                                "ru": "Я ходил в школу с девочкой по имени <w>Кэнди</w>.",
                                "zh": "我和一个叫<w>坎迪</w>的女孩上过同一所学校。"
                            }
                        },
                        {
                            "text": "<w>Candy</w> is coming to visit us this weekend.",
                            "target_lang_translations": {
                                "ru": "<w>Кэнди</w> приедет навестить нас в эти выходные.",
                                "zh": "<w>坎迪</w>这个周末要来看我们。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, часто сокращение от Кэндис или Кэнди.",
                        "zh": "女性名字，常为Candace或Candice的昵称。"
                    },
                    "translations": {
