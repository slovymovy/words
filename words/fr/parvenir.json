    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d03d9029-0726-3c4f-86fb-cf305615a10f",
                    "sense_definition": "Réussir à faire quelque chose après des efforts, ou atteindre un lieu, un terme fixé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "atteindre_reussir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs heures de marche, nous sommes enfin <w>parvenus</w> au sommet de la montagne."
                        },
                        {
                            "text": "Elle est <w>parvenue</w> à résoudre ce problème complexe sans aucune aide extérieure."
                        }
                    ],
                    "synonyms": [
                        "réussir",
                        "arriver"
                    ],
                    "antonyms": [
                        "échouer"
                    ],
                    "common_phrases": [
                        "parvenir au sommet",
                        "parvenir à ses fins"
                    ]
                },
                {
                    "sense_id": "334e7941-f57f-3ebd-8a23-426df9eeb062",
                    "sense_definition": "Arriver à destination, être transmis ou perçu, en parlant d'un courrier, d'un message ou d'un bruit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "arriver_destination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Votre colis devrait vous <w>parvenir</w> d'ici deux jours ouvrables."
                        },
                        {
                            "text": "Un faible murmure est <w>parvenu</w> jusqu'à nos oreilles malgré le vacarme de la rue."
                        }
                    ],
                    "synonyms": [
                        "arriver"
                    ],
                    "common_phrases": [
                        "parvenir à destination",
                        "parvenir aux oreilles"
                    ]
                },
                {
                    "sense_id": "5ae7fd35-c650-3ae1-8da4-ee11df838545",
                    "sense_definition": "S'élever dans la société, faire fortune et obtenir une haute position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "elevation_sociale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme très ambitieux était prêt à tout pour <w>parvenir</w> dans le monde des affaires."
                        },
                        {
                            "text": "Grâce à son travail acharné, elle a su <w>parvenir</w> aux plus hautes fonctions de l'État."
                        }
                    ],
                    "synonyms": [
                        "réussir",
                        "s'élever"
                    ]
                }
            ]
        }
    ]
