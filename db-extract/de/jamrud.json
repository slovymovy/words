                "senses": [
                    {
                        "sense_id": "3ef6de77-b3ad-3fe3-987e-28187fb0f0b1",
                        "entry_id": "570dcab0-79b1-3055-9c14-1483a512f4e8",
                        "glosses": [
                            "Stadt in der pakistanischen Provinz Khyber Pakhtunkhwa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43b5f9ce-7c99-4a99-881c-b4c9a424cecb",
                                "sense_id": "3ef6de77-b3ad-3fe3-987e-28187fb0f0b1",
                                "text": "„Mister Bob tarnte sich als logistischer Koordinator einer Hilfsorganisation namens World Benefactors. Daher verfügte er über eine Erlaubnis, sich außerhalb von Peshawar bis zu einem Warenhaus für Hilfsgüter westlich der Stadt Jamrud frei zu bewegen.“"
                            },
                            {
                                "example_id": "15b462a3-5f8f-4ae3-bf8e-e6b6e4e972d1",
                                "sense_id": "3ef6de77-b3ad-3fe3-987e-28187fb0f0b1",
                                "text": "„Seit nunmehr fünf Jahren lebte er zurückgezogen in einem sechsgeschossigen Mietshaus am Stadtrand von Long Beach. Jamrud fehlte ihm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
