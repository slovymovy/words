                "senses": [
                    {
                        "sense_id": "e2a68583-d24c-3ee3-85a8-ef14004271bd",
                        "entry_id": "b64f3e04-b5f3-3ee0-860b-4c0b1894985d",
                        "glosses": [
                            "Introduire un élément indésirable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd03a10-e1e1-4af8-80fa-0e1448a8b08d",
                                "sense_id": "e2a68583-d24c-3ee3-85a8-ef14004271bd",
                                "text": "En effet, on nous l’a infestibulé, avec quelque fonction diplomatique mal définie, mais suffisante pour lui assurer l’immunité, dès que Luisa s’est fait draguer par M. Marchandise à New York ou Washington, et remorquer en France."
                            },
                            {
                                "example_id": "adf2f7b8-707c-46fd-9af6-7b3eafee1e2c",
                                "sense_id": "e2a68583-d24c-3ee3-85a8-ef14004271bd",
                                "text": "II ne faisait que vous infestibuler sa passion d'apôtre..."
                            },
                            {
                                "example_id": "55cd0264-731a-4520-a985-132bb91f0665",
                                "sense_id": "e2a68583-d24c-3ee3-85a8-ef14004271bd",
                                "text": "Mais il l’acceptera en tremblant, en craignant que ces derniers ne lui infestibulent un agent de pénétration à eux."
                            },
                            {
                                "example_id": "740361df-b8b2-491b-938d-b3798ec4ae8c",
                                "sense_id": "e2a68583-d24c-3ee3-85a8-ef14004271bd",
                                "text": "La vacherie était que j’étais infestibulé du virus indestructible qui s’appelle timidité."
                            }
                        ]
                    }
                ],
