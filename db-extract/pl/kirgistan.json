                                                "text": "„Das Klima Kirgisistans ist von trockenen und kontinentalen heißen Sommern und von kalten Wintern geprägt.“"
                                            },
                                            {
                                                "example_id": "adbe9bf3-f0cf-427d-80ae-9d6432d0f624",
                                                "sense_id": "31d2d351-1342-324f-b89b-182f1c6d55f5",
                                                "text": "Kirgisistan hat eine eher schlechte Infrastruktur."
                                            },
                                            {
                                                "example_id": "d2ac6fa3-f745-48a8-b6cd-9a1e1e3cc73b",
                                                "sense_id": "31d2d351-1342-324f-b89b-182f1c6d55f5",
                                                "text": "Bischkek ist die Hauptstadt von Kirgisistan."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
