                                        "sense_id": "a9c2600f-c64c-3068-adf0-757361b34ee9",
                                        "entry_id": "da7544de-8579-3d09-b1c5-12da12fca95a",
                                        "glosses": [
                                            "A crescent moon, or an object shaped like it."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15d752d4-7dff-4bd9-b931-c6efb239ee36",
                                                "sense_id": "a9c2600f-c64c-3068-adf0-757361b34ee9",
                                                "text": "And from Crabbe's own forehead sweat dripped or gathered into a kind of meniscus to be scooped off."
                                            },
                                            {
                                                "example_id": "e84c333c-f2c4-4706-9a9d-738a603117c9",
                                                "sense_id": "a9c2600f-c64c-3068-adf0-757361b34ee9",
                                                "text": "He opened wide both casements; they gave on a parking place four floors below; the thin meniscus overhead was too wan to illumine the roofs of the houses descending toward the invisible lake [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d28f770-1581-3022-85df-cef7d9617738",
