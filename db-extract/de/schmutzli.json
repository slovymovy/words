                ],
                "senses": [
                    {
                        "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                        "entry_id": "a5f89555-efa6-3e42-b3ec-7b2f13ccd9cd",
                        "glosses": [
                            "meist in dunkelfarbigem Gewand und dunklem Rauschebart gekleideter Begleiter und Gehilfe des Samichlaus (Nikolaus), der ursprünglich ungehorsame Kinder bestrafte"
                        ],
                        "tags": [
                            "Swiss Standard German"
                        ],
                        "examples": [
                            {
                                "example_id": "79fb917d-b025-46f3-be36-cde887fb1800",
                                "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                                "text": "„Der Schmutzli sei kein böser, bulliger Bodyguard, sagt Jauch.“"
                            },
                            {
                                "example_id": "cceb5e0a-67d1-4c88-9d6d-67740d7b1ea5",
                                "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                                "text": "„Der treue Begleiter des Samichlaus ist der Schmutzli.“"
                            },
                            {
                                "example_id": "52883ed9-0d5b-49ca-8c92-ff39bdf01bfe",
                                "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                                "text": "„Der Samichlaus und sein Schmutzli empfingen am letzten Donnerstag im Waldschulzimmer in Weinfelden Familien.“"
                            },
                            {
                                "example_id": "51d659bf-80d4-45a5-91ff-e7a4eafa4866",
                                "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                                "text": "„Bist du selbst als Samichlaus, Engel oder Schmutzli unterwegs und zauberst den Kindern ein Lächeln ins Gesicht?“"
                            },
                            {
                                "example_id": "14d18735-39c0-415b-9c15-5694d17bf675",
                                "sense_id": "046291d1-50cd-3f36-8934-72c4f9dea4f2",
                                "text": "„Der Tag, an dem der Samichlaus bestenfalls mit Schmutzli und Eseli an die Türe klopft und Kindern nicht nur Herzklopfen, sondern auch Mandarinli und Nüssli bringt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
