                                        "entry_id": "c11033b6-8943-3449-9385-0dea1820f3ee",
                                        "glosses": [
                                            "To make better, or improve, something perceived to be in a negative condition."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7808e682-b532-4909-b0c0-d05bbf42c881",
                                                "sense_id": "255492a4-6f12-3c99-882b-761f62f75e61",
                                                "text": "They offered some compromises in an effort to ameliorate the situation."
                                            },
                                            {
                                                "example_id": "506be452-bbb8-44af-beb3-c5dd29184798",
                                                "sense_id": "255492a4-6f12-3c99-882b-761f62f75e61",
                                                "text": "In every human being there is a wish to ameliorate his own condition."
                                            },
                                            {
                                                "example_id": "82893207-40bc-46ac-bb59-22b6c0d09ea3",
                                                "sense_id": "255492a4-6f12-3c99-882b-761f62f75e61",
                                                "text": "We further show that an implementable rule for the central bank's long bond portfolio significantly ameliorates the adverse consequences of a binding ZLB on the policy rate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e96b0976-f404-3fce-b895-91299d03ada5",
                                        "entry_id": "c11033b6-8943-3449-9385-0dea1820f3ee",
                                        "glosses": [
                                            "To become better; improve."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a06433cf-8900-41b3-b975-6dad5aa72a92",
                        "source_entry_id": "753dc5df-e2e5-34fe-9263-6aac8245f71f",
                        "source_sense_id": "e01078ef-084d-3cf2-9ec4-99bec9964122",
                        "target_lang_word": "turn around",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turn around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef1a229-834f-332d-8b31-01c11b266369",
                                        "entry_id": "0420f020-d630-3559-a672-f5a46c4805d7",
                                        "glosses": [
                                            "Alternative spelling of turnaround."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "turn around",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To physically rotate (usually around a vertical axis) for a half turn (180 degrees), a whole turn (360 degrees), or an indefinite amount."
                                        ],
                                        "tags": [
                                            "ergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0ced41-ae4d-4c04-ab40-2a32e47757e5",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "At the end of the road, we turned around and walked back to the hotel."
                                            },
                                            {
                                                "example_id": "e49a2bd8-aeb5-4b30-8613-9acffc67589b",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "The world turns around once every twenty-four hours."
                                            },
                                            {
                                                "example_id": "cb45b29a-9639-4816-8f3f-e5da88f83a3b",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "Turn around once or twice so I can see your new dress."
                                            },
                                            {
                                                "example_id": "34a8d0ab-0750-4510-afe2-5a78a294c05a",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "A wheel turns around on an axle."
                                            },
                                            {
                                                "example_id": "19591219-d1ca-4a10-8db5-57d025d19224",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "If you kids don't cut it out I will turn this car around!"
                                            },
                                            {
                                                "example_id": "1efbee7c-44e5-4a4d-920b-f2f672135b1a",
                                                "sense_id": "0511439f-b806-31c1-9603-864e6075a69d",
                                                "text": "...and called him his father; this overpowered the brave man's heart, and obliged him to turn around, to prevent the tears that stood ready to gush from his eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65df6bdf-32d7-3585-8f9e-ec4745164b9a",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To change drastically in a fundamental way, often for the better; to change to the opposite (opinion or position)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f3b55fc-0bba-4fd7-9672-1f6478ff74c7",
                                                "sense_id": "65df6bdf-32d7-3585-8f9e-ec4745164b9a",
                                                "text": "She turned her position around and now she is in favor of the merger."
                                            },
                                            {
                                                "example_id": "884a2d2d-ad34-425c-9445-5b6551265717",
                                                "sense_id": "65df6bdf-32d7-3585-8f9e-ec4745164b9a",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic who still resists the idea that something drastic needs to happen for him to turn his life around."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To reverse an expected outcome (of a game, etc.), usually from a losing outcome to a winning one; to return (a business, department, etc.) to effectiveness, profitability, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf8ca803-b04f-4a81-87f4-6d46dddcf563",
                                                "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                                "text": "Pollard, who went into the semifinals with an unsatisfactory 63% return from the kicking tee, turned it around splendidly against Wales and he continued that form despite missing his first attempt in the final."
                                            },
                                            {
                                                "example_id": "186e672f-272a-4c6a-8ffc-2ad42f5518e7",
                                                "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                                "text": "The new management team has really turned the company around 180 degrees, and they expect a good profit next year."
                                            },
                                            {
                                                "example_id": "6d390ba1-17cd-4a9a-9fd1-c9669e586da3",
                                                "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                                "text": "The team really turned it around in the second half for a great win."
                                            },
                                            {
                                                "example_id": "4bf9ef8f-ec31-4395-8413-923ac29059bc",
                                                "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                                "text": "They were way ahead but the game turned around on them and they lost 4–3."
                                            },
                                            {
                                                "example_id": "8c468ea8-68d8-4cc0-a559-6c906b86d11a",
                                                "sense_id": "f9879779-8ad1-36d0-a534-4f23a79b2d2e",
                                                "text": "It took changes from Wenger and a rare defensive lapse from Everton before Arsenal finally turned the game around with two goals in the space of five minutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68c9472-b5ea-3afb-940c-b0b7992d58d5",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To convert (an agent) to work for one's own side."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eee4856-a3cf-4485-bcdc-ff08875660d9",
                                                "sense_id": "a68c9472-b5ea-3afb-940c-b0b7992d58d5",
                                                "text": "Some months ago, the Captain had come to the FBI with a story that he had been contacted by Soviet agents, and the FBI had “turned him around” and used him to plant false and specially made up classified material of no importance on the Soviets."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c9909c6-2fd8-3ebf-963d-d72724defe16",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To suddenly change or reverse one's opinion, point of view, stated position, behaviour, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6eb7592-5496-4b3e-bf2f-47a23bbd18b2",
                                                "sense_id": "2c9909c6-2fd8-3ebf-963d-d72724defe16",
                                                "text": "You can't just turn around and say that it was all my fault."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ef54b31-3446-3ee6-bf4e-99bd19bbd3aa",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "To consider from a different viewpoint."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f87eb35-faaf-421b-920c-4b4751f9b9a2",
                                                "sense_id": "6ef54b31-3446-3ee6-bf4e-99bd19bbd3aa",
                                                "text": "Let's turn that around and look at it from another angle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20574a5b-77b8-3290-bf35-de4c817b6389",
                                        "entry_id": "d6796755-6a41-3868-8e8b-efb44e14f678",
                                        "glosses": [
                                            "(often with a unit of time) To produce; to output; to generate."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35bda655-79ca-489b-b687-117302243aea",
                                                "sense_id": "20574a5b-77b8-3290-bf35-de4c817b6389",
                                                "text": "We can turn around 500 units by next week."
                                            },
                                            {
                                                "example_id": "74e48c85-3d45-4d97-93f2-9d34043647c8",
                                                "sense_id": "20574a5b-77b8-3290-bf35-de4c817b6389",
                                                "text": "Typically, this meant that the teams were turning around two sets a week, with a train rolling into the depot on a Sunday for what Hinze describes as a \"big strip-out\". This would pull the carriages back almost to the bare bones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
