                "senses": [
                    {
                        "sense_id": "eb6a291e-517f-39ee-9d59-04e16976afd7",
                        "entry_id": "049bf138-22c9-3ac6-a6bd-0a2062fb20d7",
                        "glosses": [
                            "zentraler Raum eines Kohlemeilers (auch kurz für den Quandelpfahl)"
                        ],
                        "tags": [
                            "Köhlerei"
                        ],
                        "examples": [
                            {
                                "example_id": "1cc943ae-ba3b-4547-b88c-ae841cad1e1d",
                                "sense_id": "eb6a291e-517f-39ee-9d59-04e16976afd7",
                                "text": "„Die in der Grundfläche liegende Erde wird alsdann nach der Quandel hingeworfen, dass der Boden in der Quandel am höchsten, 6 bis 8 Zoll höher, als im Umkreise liegt, und von der Quandel aus nach dem Umkreise allmälig abfällt. (1809)“"
                            },
                            {
                                "example_id": "d8c1a7e8-53ea-4418-aa8c-79b55779e293",
                                "sense_id": "eb6a291e-517f-39ee-9d59-04e16976afd7",
                                "text": "„Auf dem Boden macht man eine gerade Fenerröhre gegen den Wind vom Umfange des Meilers bis an die Quandel. (1820)“"
                            },
                            {
                                "example_id": "abd1bfaa-4bd9-496c-943e-efdfdb00c6e9",
                                "sense_id": "eb6a291e-517f-39ee-9d59-04e16976afd7",
                                "text": "„Es dürfte übrigens bekannt sein, daß diese Methode nur einen Stoß und darauf sogleich die Haube setzt, daß das Quandel nur durch den Stoß reicht und in eine Spitze zusammenläuft, und daß die Anfeuerung mit einem offenen Kranze am Saume Statt hat. (1847)“"
                            },
                            {
                                "example_id": "2ff5b3e5-81c6-44ff-a6f0-ca4dad061df6",
                                "sense_id": "eb6a291e-517f-39ee-9d59-04e16976afd7",
                                "text": "„Er stellte drei Quandeln auf, wie die Pfähle hierfür heißen, schichtete um sie herum die Scheite zu einem Haufen auf und umgab ihn mit einer Decke von Rasen und Erde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
