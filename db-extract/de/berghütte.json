                "senses": [
                    {
                        "sense_id": "92bb1338-7ffb-3cc0-8d1c-1f7b7c46370f",
                        "entry_id": "537de660-fe9b-36ac-adde-fb2d8ab1f756",
                        "glosses": [
                            "Hütte in den Bergen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "961b280a-8bfb-46a8-8f21-64d6dcd923c3",
                                "sense_id": "92bb1338-7ffb-3cc0-8d1c-1f7b7c46370f",
                                "text": "„Als Kind war Romero in einer einfachen Berghütte gefunden worden, als der einzige Überlebende einer Epidemie, die in der Gegend tödlich gewütet hatte.“"
                            },
                            {
                                "example_id": "5d701f85-2144-4baf-a06f-d2ed2e73f2d3",
                                "sense_id": "92bb1338-7ffb-3cc0-8d1c-1f7b7c46370f",
                                "text": "„Ich ging mit ihm in seine Berghütte, und meine Eltern sahen mich nur ein Mal in der Woche.“"
                            },
                            {
                                "example_id": "fe632787-95c9-44c9-a192-361988c543d0",
                                "sense_id": "92bb1338-7ffb-3cc0-8d1c-1f7b7c46370f",
                                "text": "„Einige Zeit später sah Giyoung in Seoul den zu diesem Zeitpunkt schon etwas älteren Film The Shining von Stanley Kubrick. Darin spielte Jack Nicholson einen Mann, der in einer Berghütte in den Rockies allmählich verrückt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
