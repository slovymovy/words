                "senses": [
                    {
                        "sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
                        "entry_id": "0876249b-9b7d-3306-a3b0-fa6172ad34e9",
                        "glosses": [
                            "trynitarne wyznanie chrześcijańskie, mające system dogmatyczno-doktrynalny oparty na Biblii i tradycji, uznające siedem sakramentów, autorytet Kościoła oraz kult maryjny i świętych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f7cd395-1196-4fbc-aa77-f396a3c86b2f",
                                "sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
                                "text": "Procentowo najwięcej wyznawców katolicyzmu mieszka w Europie i Ameryce Południowej."
                            },
                            {
                                "example_id": "31230e83-fec4-48e9-b883-53c31286aa39",
                                "sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
                                "text": "Katolicyzm to największy odłam chrześcijaństwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "251020c1-4d06-4fa8-9259-5e220a6efa73",
                        "source_entry_id": "0876249b-9b7d-3306-a3b0-fa6172ad34e9",
                        "source_sense_id": "bfa61aa4-bba5-3ebc-9f51-e2fbf6683dc1",
