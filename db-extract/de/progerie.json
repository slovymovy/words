                "senses": [
                    {
                        "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                        "entry_id": "e1babb5f-9f2c-3fe1-a981-de6f164c4484",
                        "glosses": [
                            "vorzeitige Vergreisung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d01f42a-1260-484f-bc26-8fee3622db0a",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Kinder mit der Erbkrankheit Progerie sterben früh. Sie werden in aller Regel maximal 15 Jahre alt."
                            },
                            {
                                "example_id": "e66194c4-e1f5-47c3-aaef-6fefdb7ecfbd",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Im Kampf gegen die seltene Erbkrankheit Progerie, bei der Kinder fünf bis zehn Mal schneller altern als gewöhnlich und im Durchschnitt mit 14 bis 15 Jahren sterben, sind zwei Forscherteams in den USA und in Frankreich am weitesten vorangekommen."
                            },
                            {
                                "example_id": "023b6591-7cff-44cb-b73d-6b6f0e2d85d9",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Schon mit zehn Jahren hatte sie den Körper einer alten Frau – nun ist die an Progerie erkrankte Hayley Okines gestorben."
                            },
                            {
                                "example_id": "92b67f53-876c-4494-a524-ec3e9b1fa529",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Sie sind betroffen von Progerie, einer Krankheit, die gerade mal eines unter vier Millionen Kindern heimsucht."
                            },
                            {
                                "example_id": "1b434e80-012a-4935-adff-64f1b4450670",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Jung geblieben ist nur ihr Geist, Burcus Gehirn ist - wie das von allen Progerie-Kindern - von den unheimlichen Vorgängen in ihrem Körper nicht betroffen."
                            },
                            {
                                "example_id": "23a55ca2-ec5b-4a68-ac7f-e6e40d0461e1",
                                "sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                                "text": "Im Gegensatz zum bekannteren Progerie Typ 1, tritt Typ 2 nicht im Kindesalter, sondern erst im Erwachsenenalter in Erscheinung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5b71f3b0-8bd8-4fa1-ba66-ddfd9839b1a8",
                        "source_entry_id": "e1babb5f-9f2c-3fe1-a981-de6f164c4484",
                        "source_sense_id": "314067e7-de76-3783-9ca3-af2fb5d6d81e",
                        "source_sense_description": "Medizin: vorzeitige Vergreisung",
                        "target_lang_word": "progeria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "progeria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9f33f57-3f31-376f-aeb3-2f3fd1e6c71e",
                                        "entry_id": "51681a05-607f-3740-bfc8-eeda31e6c722",
                                        "glosses": [
                                            "An extremely rare genetic condition wherein symptoms resembling aspects of aging are manifested at an early age."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0508027c-70ff-46fb-a643-68958945c87a",
                                                "sense_id": "f9f33f57-3f31-376f-aeb3-2f3fd1e6c71e",
                                                "text": "Hutchinson–Gilford syndrome or progeria (derived from pro, before, and geras, old age) is characterized by premature ageing (Fig. 18.1) and the early onset of age-related symptoms such as joint restriction and cerebral and myocardial infarction. Progeria occurs in about one in eight million people (DeBusk, 1972), but the true incidence may be somewhat higher (Sarkar and Shinton, 2001)."
                                            },
                                            {
                                                "example_id": "357add69-a0c9-46e5-9c23-ae1a3c9c6255",
                                                "sense_id": "f9f33f57-3f31-376f-aeb3-2f3fd1e6c71e",
                                                "text": "Hutchinson-Gilford progeria is a syndrome commonly characterized by accelerated aging. Children affected by progeria have a life expectancy of approximately 13 years. Progeria results from damage to the LMNA gene that codes for the protein lamin A."
                                            },
                                            {
                                                "example_id": "d8e2e52e-0f40-4fda-a3d8-bc0470e00180",
                                                "sense_id": "f9f33f57-3f31-376f-aeb3-2f3fd1e6c71e",
                                                "text": "Hutchinson Gilford progeria syndrome (progeria) is a rare childhood disease, affecting 1 in 4 million births worldwide (Hennekam, 2006) and recapitulates certain aspects of the normal aging process at an accelerated rate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
