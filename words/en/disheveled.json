    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5d9d176b-4a16-3128-bee9-a594d243c38c",
                    "sense_definition": "Having a messy or untidy appearance, especially of hair or clothing, being an alternative form of <w>dishevelled</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He arrived at the meeting looking <w>disheveled</w> after his long flight.",
                            "target_lang_translations": {
                                "ru": "Он пришел на встречу, выглядя <w>растрепанным</w> после долгого перелета.",
                                "tr": "Uzun uçuşundan sonra toplantıya <w>dağınık</w> bir halde geldi."
                            }
                        },
                        {
                            "text": "The <w>disheveled</w> appearance of the room suggested that someone had been searching for something in a hurry.",
                            "target_lang_translations": {
                                "ru": "<w>Неопрятный</w> вид комнаты наводил на мысль, что кто-то в спешке что-то искал.",
                                "tr": "Odanın <w>dağınık</w> görünümü, birinin aceleyle bir şey aradığını düşündürüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "untidy",
                        "messy",
                        "scruffy"
                    ],
                    "antonyms": [
                        "neat",
                        "tidy"
                    ],
                    "common_phrases": [
                        "disheveled appearance",
                        "look disheveled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий неопрятный или растрепанный вид, особенно в отношении волос или одежды.",
                        "tr": "Özellikle saç veya kıyafet açısından dağınık veya düzensiz bir görünüme sahip olma durumu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растрепанный",
                                "target_lang_sense_clarification": "обычно о волосах или внешнем виде"
                            },
                            {
                                "target_lang_word": "неопрятный",
                                "target_lang_sense_clarification": "общий вид человека или одежды"
                            },
                            {
                                "target_lang_word": "взлохмаченный",
                                "target_lang_sense_clarification": "о сильно растрепанных волосах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dağınık",
                                "target_lang_sense_clarification": "genel görünüm veya saç için"
                            },
                            {
                                "target_lang_word": "pasaklı",
                                "target_lang_sense_clarification": "kişinin genel bakımsız görünümü için"
                            },
                            {
                                "target_lang_word": "darmadağın",
                                "target_lang_sense_clarification": "çok düzensiz ve karışık görünüm için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bfd540a8-2628-3149-ac85-5ceb00d8429f",
                    "sense_definition": "Simple past and past participle of <w>dishevel</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind <w>disheveled</w> her hair as she walked along the beach.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер <w>растрепал</w> ее волосы, пока она шла по пляжу.",
                                "tr": "Sahilde yürürken sert rüzgar saçlarını <w>dağıttı</w>."
                            }
                        },
                        {
                            "text": "He had <w>disheveled</w> his clothes while trying to climb over the fence.",
                            "target_lang_translations": {
                                "ru": "Он <w>растрепал</w> свою одежду, пытаясь перелезть через забор.",
                                "tr": "Çitin üzerinden tırmanmaya çalışırken kıyafetlerini <w>dağıtmıştı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Past tense and past participle form of the verb."
                        }
                    ],
                    "target_lang_definitions": {
