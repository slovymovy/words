                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Баскетбольный бросок, при котором мяч проходит через сетку, не касаясь обода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чи́стый бросо́к",
                                "target_lang_sense_clarification": "баскетбольный термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e672fd39-fe07-310b-8757-f8aa5710718d",
                    "sense_definition": "A sweeping movement through the air",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>swish</w> of his tail, the dog knocked the glass over.",
                            "target_lang_translations": {
                                "ru": "Быстрым <w>взмахом</w> хвоста собака опрокинула стакан."
                            }
                        },
                        {
                            "text": "The <w>swish</w> of the broom cleared the dust from the floor.",
                            "target_lang_translations": {
                                "ru": "От <w>взмаха</w> метлы пыль с пола исчезла."
                            }
                        }
                    ],
                    "synonyms": [
                        "flick",
                        "sweep"
                    ],
                    "common_phrases": [
                        "quick swish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размашистое движение по воздуху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взмах",
                                "target_lang_sense_clarification": "резкое движение"
                            },
                            {
                                "target_lang_word": "движе́ние",
                                "target_lang_sense_clarification": "общее понятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f6c04b4-e077-3596-8710-e67580dbd048",
                    "sense_definition": "The sound of liquid moving inside a container",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "liquid_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I could hear the <w>swish</w> of water inside the heavy barrel.",
                            "target_lang_translations": {
                                "ru": "Я слышал <w>плеск</w> воды внутри тяжелой бочки."
                            }
                        },
                        {
                            "text": "The <w>swish</w> of the liquid told me the bottle was half full.",
                            "target_lang_translations": {
                                "ru": "<w>Плеск</w> жидкости подсказал мне, что бутылка наполовину полна."
                            }
                        }
                    ],
                    "synonyms": [
                        "slosh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звук жидкости, перемещающейся внутри емкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плеск",
                                "target_lang_sense_clarification": "звук жидкости"
                            },
                            {
                                "target_lang_word": "булька́нье",
                                "target_lang_sense_clarification": "звук переливания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4203d7d-0065-321e-8295-941fb9579c4a",
                    "sense_definition": "A rapid or careless swing with a bat or similar object",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He missed the ball with a wild <w>swish</w> of his bat.",
                            "target_lang_translations": {
                                "ru": "Он промахнулся по мячу, сделав неистовый <w>взмах</w> битой."
                            }
                        },
                        {
                            "text": "A careless <w>swish</w> cost him the game.",
                            "target_lang_translations": {
                                "ru": "Один неосторожный <w>взмах</w> стоил ему игры."
                            }
                        }
                    ],
                    "synonyms": [
                        "swing"
                    ],
                    "target_lang_definitions": {
