                "senses": [
                    {
                        "sense_id": "6526baa1-d484-318a-87ca-3e3573da512c",
                        "entry_id": "753d31aa-3dc0-362d-8752-1f1adc6458ad",
                        "glosses": [
                            "Organ, das der Hervorbringung von Sprachlauten dient"
                        ],
                        "tags": [
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "fc0fba88-0e40-49fe-8af3-d11954f3d753",
                                "sense_id": "6526baa1-d484-318a-87ca-3e3573da512c",
                                "text": "Wenn man ein [b] oder [p] bilden will, muss man beide Lippen als Artikulationsorgane einsetzen."
                            },
                            {
                                "example_id": "266000d8-3b45-4f2c-a716-3efe822a4bcc",
                                "sense_id": "6526baa1-d484-318a-87ca-3e3573da512c",
                                "text": "„Den größten Teil des Buches nehmen indessen die Kapitel drei und vier mit Einlassungen zu den »Sprechwerkzeugen«, also den Artikulatoren und Artikulationsorganen und dem Lautinventar europäischer Sprachen bei.“"
                            },
                            {
                                "example_id": "f2a9c126-c1d9-406b-b148-c8b6cd59e35c",
                                "sense_id": "6526baa1-d484-318a-87ca-3e3573da512c",
                                "text": "„Nutzen Sie deshalb jede Gelegenheit einerseits die Artikulationsorgane zu lockern und andererseits deutlich zu sprechen.“"
                            },
                            {
                                "example_id": "a2dcf02b-aab3-48bf-a811-0193d0ce4654",
                                "sense_id": "6526baa1-d484-318a-87ca-3e3573da512c",
                                "text": "„Wie Sie sich vorstellen können, ist rein phonetisch nur schwer zu beschreiben, wie die Artikulationsorgane mit Information versorgt werden können, die sie erst viel später haben dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
