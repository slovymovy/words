                                "sense_id": "eeb74506-c738-3d48-8d83-daac67ae851d",
                                "text": "„Holla!“, piepste die Maus. „Streng dich nicht so an, mein Dicker!“ (Nach einer Fabel von Äsop)"
                            },
                            {
                                "example_id": "191958f7-4b93-47c3-98db-a18523565743",
                                "sense_id": "eeb74506-c738-3d48-8d83-daac67ae851d",
                                "text": "„Holla! Wo kam jetzt der Ball her?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ced4a683-0c87-4f3b-88c6-9fcf5a729ba7",
