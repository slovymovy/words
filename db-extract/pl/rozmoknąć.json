                                                "sense_id": "d691b45d-033d-316b-8378-db15f368877d",
                                                "text": "„Er wird auch in Eistorte und Tiramisu oder aufgeweicht als Babynahrung verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cbca5380-3e3d-3c89-9596-8d7b75d9e4ba",
                                        "entry_id": "0bc455fc-664f-37cf-8e0c-f3fd104ffc39",
                                        "glosses": [
                                            "von innen her schwächen oder zerstören"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d87e1e1-0f98-4f47-918f-9636436d3b0a",
                                                "sense_id": "cbca5380-3e3d-3c89-9596-8d7b75d9e4ba",
                                                "text": "„Ob sie die Dominanz der Rasur-Riesen aufweichen können, muss sich zeigen.“"
                                            },
                                            {
                                                "example_id": "df3809b5-724b-4027-9052-64790739e5f3",
                                                "sense_id": "cbca5380-3e3d-3c89-9596-8d7b75d9e4ba",
                                                "text": "Als Reaktion auf die jüngsten Anschläge in Deutschland will Bundesinnenminister Thomas de Maizière nach einem Bericht der \"Bild\"-Zeitung die ärztliche Schweigepflicht aufweichen."
                                            },
                                            {
                                                "example_id": "4d2e827f-d75b-4d80-b116-e0c5bc6418eb",
                                                "sense_id": "cbca5380-3e3d-3c89-9596-8d7b75d9e4ba",
                                                "text": "Man müsse bestehende Gesetze durchsetzen und nicht andere aufweichen, sagt der EU-Abgeordnete Manfred Weber."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f59ddae4-6c9b-3bca-9e06-fe62cdb5e851",
                                        "entry_id": "0bc455fc-664f-37cf-8e0c-f3fd104ffc39",
                                        "glosses": [
                                            "durch Einwirkung von Feuchtigkeit weich werden"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cabac6b4-e132-42fe-89f8-3bb62d5639f7",
                                                "sense_id": "f59ddae4-6c9b-3bca-9e06-fe62cdb5e851",
                                                "text": "Die unbefestigten Straßen sind durch den Dauerregen komplett aufgeweicht."
                                            },
                                            {
                                                "example_id": "baddec9e-3dba-4e0c-8b9e-c5f33a220ba2",
                                                "sense_id": "f59ddae4-6c9b-3bca-9e06-fe62cdb5e851",
                                                "text": "Vorbei an blühenden Alpenrosen und duftenden Latschen wandern wir zu dem bergumzackten, dunkelgrün schimmernden See, laufen über Wege, die vom Regen aufgeweicht sind, treffen keinen Menschen."
                                            }
