                "senses": [
                    {
                        "sense_id": "f931c07e-e520-30a2-a042-93389e398541",
                        "entry_id": "690a95ac-f131-31bb-983c-e2309d3e8730",
                        "glosses": [
                            "het onbeweeglijk zijn; het onvervormbaar zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba6d722b-5a79-4ea0-b1fe-935035462bf2",
                                "sense_id": "f931c07e-e520-30a2-a042-93389e398541",
                                "text": "De starheid van de borst van de pop is ook in te stellen. Zo bootst de pop het reanimeren van iele en gezette personen beter na."
                            }
                        ]
                    },
                    {
                        "sense_id": "50eb0923-73f9-3a8e-bffb-55f830a4f19b",
                        "entry_id": "690a95ac-f131-31bb-983c-e2309d3e8730",
                        "glosses": [
                            "het zich niet kunnen of willen aanpassen aan de (gewijzigde) omstandigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "287ddf8c-ad5c-4105-9e23-2e7dd2f7f4d2",
                                "sense_id": "50eb0923-73f9-3a8e-bffb-55f830a4f19b",
                                "text": "Paul Knuvers van GroenLinks verwijt het college starheid: „Duidelijk is dat door uw Samen Anders beleid ’t Spieker zijn grote huurders is kwijtgeraakt. Dat is het bestuur niet te verwijten. Wel zou het verwijtbaar zijn als het bestuur van ’t Spieker niet ‘out of the box’ gaat bij het bedenken van (tijdelijke) financiële oplossingen."
                            },
                            {
                                "example_id": "2401df01-0a4d-4d84-81a7-5e3505190a20",
                                "sense_id": "50eb0923-73f9-3a8e-bffb-55f830a4f19b",
                                "text": "Rohani's voorganger Mahmoud Ahmadinejad hield van geheimzinigheid en confrontatie, maar volgens waarnemers kan de Iraanse regering zich deze starheid nu niet meer veroorloven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6775cf9b-94ef-4a7d-a3f2-15ab2b7f01e7",
                        "source_entry_id": "690a95ac-f131-31bb-983c-e2309d3e8730",
                        "source_sense_id": "f931c07e-e520-30a2-a042-93389e398541",
                        "target_lang_word": "starkness",
