                    "common_phrases": [
                        "frozen wastes",
                        "vast waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обширная территория земли, которая пуста, необитаема или была разрушена."
                    },
                    "translations": {
                        "ru": [
