                        "entry_id": "2923832b-3938-356a-91a2-f4e47b748856",
                        "glosses": [
                            "In an unsteady manner, so as to shake or falter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74c3cf60-abbc-4ba9-8bef-5cbfbb166477",
                                "sense_id": "62d8a85f-9fa9-34e9-ab4f-487a78e43b8c",
                                "text": "He climbed the stairs unsteadily, grasping the banister and gasping for breath."
                            },
                            {
                                "example_id": "928b163b-9c2a-4957-a285-3b41b80dce6b",
                                "sense_id": "62d8a85f-9fa9-34e9-ab4f-487a78e43b8c",
                                "text": "Terry's fist lashed out, but Simpson, anticipating the blow, stepped quickly to one side. Another followed, however, and caught the older man fairly on the chin, sent him reeling back. He stood swaying unsteadily, a little smile on his lips."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b084b85-1e57-3edf-825b-52c7da661f6d",
                        "entry_id": "2923832b-3938-356a-91a2-f4e47b748856",
                        "glosses": [
                            "In an uncertain manner; with hesitation or timidity."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87b351ab-d20f-48b9-bb4b-1e29ae927d1d",
                                "sense_id": "8b084b85-1e57-3edf-825b-52c7da661f6d",
                                "text": "\"I reckon. It's powerful fine to hear that,\" replied Lassiter, unsteadily."
                            }
                        ]
                    }
