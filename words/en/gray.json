                        "dreary",
                        "bleak",
                        "dismal",
                        "cheerless",
                        "somber"
                    ],
                    "antonyms": [
                        "bright",
                        "cheerful",
                        "sunny"
                    ],
                    "common_phrases": [
                        "gray day",
                        "gray mood",
                        "gray skies"
                    ],
                    "target_lang_definitions": {
