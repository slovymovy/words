                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "779e97dd-2141-4cb6-81ee-8e39a77c845d",
                                "sense_id": "fe8c557d-2299-3b6b-a66d-94bedcea6017",
                                "text": "Ces blocs proviennent d'un édifice plus ancien, et l'on a dans quelques parties, gratté ou restuqué les hiéroglyphes."
                            },
                            {
                                "example_id": "942ea9e1-e06e-4264-9f79-0118694ef769",
                                "sense_id": "fe8c557d-2299-3b6b-a66d-94bedcea6017",
                                "text": "Auparavant, on avait refait le sol de la superstructure (par une couche de stuc maintenue par une rangée de dalles le long des bords) et restuqué murs et banquettes."
                            }
                        ]
                    }
