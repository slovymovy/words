{
    "word_family": [
        "marinade",
        "marination"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "90892c33-b3d5-3ae8-957a-7b73c0492cb1",
                    "sense_definition": "to soak food in a seasoned liquid before cooking to add flavor or soften it",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You will get a much better flavor from the chicken if you <w>marinate</w> it overnight.",
                            "target_lang_translations": {
                                "ru": "Курица получится гораздо вкуснее, если вы <w>замаринуете</w> её на ночь."
                            }
                        },
                        {
                            "text": "It is important to <w>marinate</w> the meat in the refrigerator to keep it safe.",
                            "target_lang_translations": {
                                "ru": "Важно <w>мариновать</w> мясо в холодильнике, чтобы оно не испортилось."
                            }
                        }
                    ],
                    "synonyms": [
                        "soak",
                        "steep"
                    ],
                    "common_phrases": [
                        "marinate the meat",
                        "marinate overnight",
                        "marinate in sauce"
                    ],
                    "target_lang_definitions": {
                        "ru": "выдерживать продукты в маринаде перед приготовлением для придания вкуса или мягкости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мариновать",
                                "target_lang_sense_clarification": "процесс выдерживания в маринаде"
                            },
                            {
                                "target_lang_word": "замариновать",
                                "target_lang_sense_clarification": "завершить процесс маринования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e282688-68f0-34cd-a353-e07d881ee2d8",
                    "sense_definition": "to allow ideas or feelings to develop or settle in the mind over a period of time",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mental_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need to let that suggestion <w>marinate</w> for a few days before I make a final decision.",
                            "target_lang_translations": {
                                "ru": "Мне нужно дать этому предложению <w>отлежаться</w> несколько дней, прежде чем я приму окончательное решение."
                            }
                        },
                        {
                            "text": "The creative concept began to <w>marinate</w> in his mind until it became a complete story.",
                            "target_lang_translations": {
                                "ru": "Творческая концепция начала <w>созревать</w> в его голове, пока не превратилась в полноценную историю."
                            }
                        }
                    ],
                    "synonyms": [
                        "ponder",
                        "ruminate"
                    ],
                    "common_phrases": [
                        "let it marinate",
                        "marinate in the mind"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically for thoughts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "давать идеям или чувствам развиться или устояться в уме в течение некоторого времени"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынашивать",
                                "target_lang_sense_clarification": "об идее или плане"
                            },
                            {
                                "target_lang_word": "переварить",
                                "target_lang_sense_clarification": "осмыслить информацию"
                            },
                            {
                                "target_lang_word": "дать устояться",
                                "target_lang_sense_clarification": "позволить мысли оформиться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcb79a0c-16ea-32b3-ba99-9a22ab1c77c1",
                    "sense_definition": "to allow a new appearance, such as a haircut, to settle so that one becomes comfortable with it",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new style looks strange now, but you just have to let it <w>marinate</w> for a week.",
                            "target_lang_translations": {
                                "ru": "Новый стиль сейчас выглядит странно, но нужно просто <w>привыкнуть</w> к нему недельку."
                            }
                        },
                        {
                            "text": "After I let the haircut <w>marinate</w>, I realized it actually suited my face quite well.",
                            "target_lang_translations": {
                                "ru": "Когда я <w>свыкся</w> со стрижкой, я понял, что она на самом деле мне очень идет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "let the haircut marinate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "specifically regarding personal style or haircuts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "дать новому образу (например, стрижке) время, чтобы привыкнуть к нему и почувствовать себя комфортно"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привыкнуть",
                                "target_lang_sense_clarification": "к новому образу"
                            },
                            {
                                "target_lang_word": "обжиться",
                                "target_lang_sense_clarification": "с новым стилем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4319331e-7629-3bc3-ba37-585219246784",
                    "sense_definition": "being in a state of having been <w>marinated</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef prepared a <w>marinate</w> herring dish that was very popular at the restaurant.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар приготовил блюдо из <w>маринованной</w> сельди, которое пользовалось большой популярностью в ресторане."
                            }
                        },
                        {
                            "text": "We served the <w>marinate</w> vegetables alongside the grilled fish for a fresh summer meal.",
                            "target_lang_translations": {
                                "ru": "Мы подали <w>маринованные</w> овощи к рыбе на гриле — получился отличный летний ужин."
                            }
                        }
                    ],
                    "synonyms": [
