                "senses": [
                    {
                        "sense_id": "3fcd2b7e-9dc7-3bb3-9c68-c79f0a7effa5",
                        "entry_id": "2b28ff74-d3b0-3223-bb18-b2d29ee6b998",
                        "glosses": [
                            "Kabel mit feinen Strängen aus Glasfasern zur Übertragung von Daten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57d71d9a-4115-4425-9e3d-3b7023cc6136",
                                "sense_id": "3fcd2b7e-9dc7-3bb3-9c68-c79f0a7effa5",
                                "text": "Wenn in Deutschland mehr Glaserfaserleitungen verlegt würden, hätten wir eine bessere Versorgung mit schnellem Internet."
                            },
                            {
                                "example_id": "3b14a4a9-2e0c-45f0-88c3-0e0c187eb069",
                                "sense_id": "3fcd2b7e-9dc7-3bb3-9c68-c79f0a7effa5",
                                "text": "Nach dem Beschluss \"Brandenburg Glasfaser 2020\" wurde für Diehlo festgelegt, dass eine Glasfaserleitung (50 Megabit pro Sekunde) bis Ende März 2015 verfügbar sein soll."
                            },
                            {
                                "example_id": "0e913425-c078-4b90-b4b6-64f01a456f69",
                                "sense_id": "3fcd2b7e-9dc7-3bb3-9c68-c79f0a7effa5",
                                "text": "Wir werden nicht alle Gemeinden auf dem Lande an die Glasfaserleitung anschließen können: zu teuer."
                            },
                            {
                                "example_id": "b2392803-bd03-43cd-a6e1-7e4702775269",
                                "sense_id": "3fcd2b7e-9dc7-3bb3-9c68-c79f0a7effa5",
                                "text": "Die Schnelligkeit in den Transaktionen [an der Börse] entscheidet sich durch die Nähe. Es kann durchaus einen Unterschied machen ob eine Glasfaserleitung hundert Meter oder einen Kilometer entfernt ist. Daher versuchen wir auch als Unternehmen möglichst nah an den Handelsplätzen zu sein."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
