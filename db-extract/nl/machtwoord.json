                                "example_id": "6c4b82db-4e57-441e-b65a-b1456a7cfb42",
                                "sense_id": "4acc3263-b6fc-3897-b04d-111dcf47aac9",
                                "text": "Hij sprak het machtwoord om alle tegenstanders het zwijgen op te leggen."
                            },
                            {
                                "example_id": "49355ce5-5e8e-47d7-af1a-4cf1e402ab8e",
                                "sense_id": "4acc3263-b6fc-3897-b04d-111dcf47aac9",
                                "text": "Of een oplossing te bereiken is zonder het machtwoord van de politiek of zonder sociale strijd valt steeds meer te betwijfelen. In beide gevallen vallen we terug op de door macht opgeworpen blokkade die werkelijke rationele oplossingen van maatschappelijke vraagstukken in de weg staat."
                            }
                        ]
