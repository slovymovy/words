                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af715b42-6e5b-3440-b118-9223b737bd34",
                                        "entry_id": "cc02a4dd-1683-3502-80d1-09b97729e6db",
                                        "glosses": [
                                            "Very annoyed, upset, angry."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic",
                                            "mildly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c30c090-b991-4c92-95af-6c4dd5e9ffda",
                                                "sense_id": "af715b42-6e5b-3440-b118-9223b737bd34",
                                                "text": "You cant disagree with the adopted values of a bunch of people without they get pissed off at you^([sic])"
                                            },
                                            {
                                                "example_id": "e8fe8913-4ac2-475d-83d7-c3d97397c3f7",
                                                "sense_id": "af715b42-6e5b-3440-b118-9223b737bd34",
                                                "text": "1984, Dorothy Nelkin and Michael Stuart Brown, Workers at Risk: Voices from the Workplace, page 103,\nThey don't like that kind of talk and that made me even more pissed off."
                                            },
                                            {
                                                "example_id": "4ab28b23-e5fe-4d1d-b77e-074c0fd9bc23",
                                                "sense_id": "af715b42-6e5b-3440-b118-9223b737bd34",
                                                "text": "2001, in The Year's Best Science Fiction, page 196,\nWhen he'd cracked the tank and lifted Jesus the Rhesus out of the waters of rebirth, the monkey had seemed more pissed off at being sopping wet […]"
                                            },
                                            {
                                                "example_id": "969c8b20-d107-4353-90e9-cba5c8e2e8fe",
                                                "sense_id": "af715b42-6e5b-3440-b118-9223b737bd34",
                                                "text": "It's better to be pissed off than be pissed on. Unless you have a snakebite or you're on fire."
                                            }
                                        ]
                                    }
                                ]
                            },
