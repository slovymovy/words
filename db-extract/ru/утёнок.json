                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec1cea73-2b40-307f-9969-5d84eb8f092f",
                        "entry_id": "0367398d-1b7b-3887-8d3b-5b3e46e21b8d",
                        "glosses": [
                            "птенец утки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8700669b-ff96-44fd-ac2e-6c5485051be9",
                                "sense_id": "ec1cea73-2b40-307f-9969-5d84eb8f092f",
                                "text": "Сперва перешёл он через мост, потом очутился на небольшой заросшей травой площадке, обогнул небольшой пруд, у которого ворчали утки с утятами, и наконец очутился близ церкви."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "674b2517-4f2b-4d11-a40e-0428abdb985e",
                        "source_entry_id": "0367398d-1b7b-3887-8d3b-5b3e46e21b8d",
                        "source_sense_id": "ec1cea73-2b40-307f-9969-5d84eb8f092f",
                        "target_lang_word": "duckling",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duckling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "902bc275-6d76-3cb8-a0e7-101ef35391ad",
                                        "entry_id": "d981c062-ee85-334f-801d-2c721c6c4567",
                                        "glosses": [
                                            "A young duck."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                        "entry_id": "d981c062-ee85-334f-801d-2c721c6c4567",
                                        "glosses": [
                                            "A young duck.",
                                            "A young female duck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1f2ef1a-4a11-4f1b-9a68-27bdcfa72eab",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Good night, darling; take that kiss to your respected mother, and tell her with my compliments that we can’t afford to make ducks and drakes of the romance of our little pet’s life: she will hatch those birds for herself in due time, and remain cluck-clucking, wisely, but sadly, like a perplexed old hen, when her ducklings and drakelings have unexpectedly taken the water."
                                            },
                                            {
                                                "example_id": "4e54f0af-cf5b-4193-963f-7192bcb830a8",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Referring to Table 1 it will be seen that if a breeding duck produces 40 marketable progeny each year (and in practice this should be achieved) half of which are ducklings and the other half drakelings, and these birds realise 2s. per lb. live weight, then that breeding duck would return approximately £15 10s. over feeding costs for the 12 months."
                                            },
                                            {
                                                "example_id": "02a4b868-3ec9-4a04-894e-34858f9a824d",
                                                "sense_id": "581679ba-99a1-309f-aa48-be3b12450c88",
                                                "text": "Muscovy ducks with ducklings. This is the most popular breed for table purposes. They make weights of up to 5 lb. for ducklings at 13 to 14 weeks, and up to 9 lb. for drakelings at 16 weeks when correctly handled."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
