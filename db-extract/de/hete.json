                        "glosses": [
                            "異性戀者"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5809fef2-4810-4cc1-918a-04b64f5d0aa5",
                                "sense_id": "024731e3-4de8-3715-b4ad-3f3f5f981689",
                                "text": "\"Läßt Du wohl meinen Freund in Ruhe? Er ist eine Hete.\""
                            },
                            {
                                "example_id": "f59ee84d-8460-443c-9788-041dd137eff5",
                                "sense_id": "024731e3-4de8-3715-b4ad-3f3f5f981689",
                                "text": "Ja, viele Heten wollten unbedingt bei uns buchen, weil sie gehört hätten, wie nett es bei uns zugeht und es war manchmal richtig süß zu lesen, was sie alles anführten, um zu zeigen, daß sie mit Schwulen und Lesben kein Problem hatten."
                            },
                            {
                                "example_id": "c20aa9a7-7b62-4c92-8a95-714c94112770",
                                "sense_id": "024731e3-4de8-3715-b4ad-3f3f5f981689",
                                "text": "Berührungsängste hat sie nicht. Manche Heten denken, dass sich unglückliche Lesben im nächsten Augenblick auf sie stürzen, und bekommen Panik."
                            }
                        ]
                    }
