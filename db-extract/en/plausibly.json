                                        "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                        "entry_id": "7be5f29d-3e18-3f0c-9aa2-c0c2f99776b9",
                                        "glosses": [
                                            "so, dass man es glauben, nachvollziehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc6e344-6942-4805-8cac-44a21abc672e",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "Das ist eine plausible Erklärung."
                                            },
                                            {
                                                "example_id": "b6f198ab-df3d-4770-892d-a59d0a3c9251",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "„Es scheint sich herumgesprochen zu haben, dass die Existenz des christlichen Gottes genauso plausibel ist wie die der anderen Götter.“"
                                            },
                                            {
                                                "example_id": "1c05722e-f2ac-4129-947b-3c1c0caccf28",
                                                "sense_id": "e1541017-9649-3351-8e1b-e1ab74c40b01",
                                                "text": "„Sie klingen oftmals ebenso plausibel wie empörend - und sind doch frei erfunden. Der EU-Kommissionschef verlangt mehr Selbstkontrolle der sozialen Netzwerke, um sogenannte Fake-News zu verbannen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21507674-32aa-421d-a759-114198336517",
                        "source_entry_id": "2e5403b7-cc80-3725-8a14-bc3fe3294eae",
                        "source_sense_id": "f2dfcdb0-1d09-3c8f-8657-980bb0ebb971",
                        "source_sense_description": "plausibel, glaubhaft, glaubwürdig, einleuchtend, überzeugend",
                        "target_lang_word": "glaubhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glaubhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45d4debe-41a7-3a0f-aa8e-0d3c3219d77f",
                                        "entry_id": "91b1edee-3806-35e1-af0f-26f17133f66e",
                                        "glosses": [
                                            "so dargestellt, dass es für wahr gehalten werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "805f3b4f-791d-4767-af6f-d112b5af9b5c",
                                                "sense_id": "45d4debe-41a7-3a0f-aa8e-0d3c3219d77f",
                                                "text": "Er konnte mir glaubhaft versichern, dass er die Wahrheit sagt."
                                            }
                                        ],
