                ],
                "senses": [
                    {
                        "sense_id": "843b497b-0971-31c2-95ed-80d3398f730b",
                        "entry_id": "6c8638ee-6d79-34fb-aaf8-dd21e0a7ebd8",
                        "glosses": [
                            "Se redresser ; ne pas rester à sa place. — Note d’usage : Se dit surtout, mais pas uniquement, en parlant des cheveux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f063f8-ea11-44d0-a930-890e7d75fc79",
                                "sense_id": "843b497b-0971-31c2-95ed-80d3398f730b",
                                "text": "Il s’oignit de gomina, et traqua plaqua implacablement les touquettes qui rebiquaient."
                            },
                            {
                                "example_id": "8b2ba8b3-aeb5-48ba-98b6-a2bec527eeb9",
                                "sense_id": "843b497b-0971-31c2-95ed-80d3398f730b",
                                "text": "Ses yeux larmoyants étaient surplombés de sourcils broussailleux tranchant avec son crâne lisse ; quelques touffes rescapées rebiquaient derrière des oreilles aux lobes effondrés de bouddha."
                            },
                            {
                                "example_id": "6fcb113c-9d7b-415e-b1a0-5785cfb3d8a5",
                                "sense_id": "843b497b-0971-31c2-95ed-80d3398f730b",
                                "text": "Il vint se poster devant la glace et tenta de remettre droite la pointe de son col de chemise, qui rebiquait."
                            },
                            {
                                "example_id": "25521cac-a8dc-4bf3-961a-07bae8deb3cc",
                                "sense_id": "843b497b-0971-31c2-95ed-80d3398f730b",
                                "text": "Il avait plus de quarante ans, de grands pieds plats, et son menton qui rebiquait vers le ciel rejoignait presque ses épaisses moustaches noires."
                            }
                        ]
                    },
                    {
                        "sense_id": "87dfa0db-521f-3fa0-ad6e-5f5de372166e",
                        "entry_id": "6c8638ee-6d79-34fb-aaf8-dd21e0a7ebd8",
                        "glosses": [
                            "Irriter, énerver quelqu’un."
                        ],
