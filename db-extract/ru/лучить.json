                "senses": [
                    {
                        "sense_id": "b7640b65-b9ce-364c-a1d7-fed370778fb1",
                        "entry_id": "c08cf1ae-c165-3bdb-9707-9f559e885299",
                        "glosses": [
                            "рег. бить рыбу ночью острогой, освещая воду лучом света (от горящей лучины, бересты, факела и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da1e4a9e-34dd-4eaf-a670-30fed6a9f3ce",
                                "sense_id": "b7640b65-b9ce-364c-a1d7-fed370778fb1",
                                "text": "Впереди .. ночной рыбак лучил рыбу: спокойное отражение его огня в воде было похоже на зажжённую длинную восковую свечу."
                            },
                            {
                                "example_id": "275b0729-7cbd-4224-a220-af4aff6dc519",
                                "sense_id": "b7640b65-b9ce-364c-a1d7-fed370778fb1",
                                "text": "Обычно лучат вдвоём ― один на вёслах, другой на носу с острогой."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a9701a5-5ef8-320d-b4aa-8e19881acf06",
                        "entry_id": "c08cf1ae-c165-3bdb-9707-9f559e885299",
                        "glosses": [
                            "рег. охотиться на кого-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec9e029-6d14-41da-b6b7-b0033e0e1f21",
                                "sense_id": "7a9701a5-5ef8-320d-b4aa-8e19881acf06",
                                "text": "Лучить тетеревей (накрывая их сетью)."
                            }
                        ]
                    },
                    {
                        "sense_id": "22a5c758-b214-3f39-bea3-218e9a2b6de9",
                        "entry_id": "c08cf1ae-c165-3bdb-9707-9f559e885299",
                        "glosses": [
                            "разг. браконьерски охотиться на животных ночью с использованием яркого источника света (например, тракторной или автомобильной фары)"
                        ],
