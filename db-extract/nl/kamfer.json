                    },
                    {
                        "translation_id": "efb64b25-c893-4efe-9d88-8d29cad730d3",
                        "source_entry_id": "6a382097-0a1f-33fd-afa7-38283a49edc6",
                        "source_sense_id": "4d2c609e-d8e1-3490-a65c-b674cc0d82f5",
                        "target_lang_word": "Kampfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kampfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "46d545e4-22e6-333d-9008-3f6bdbf63869",
                                        "entry_id": "14eb4c3e-a508-3c9d-9611-df91ee406ff8",
                                        "glosses": [
                                            "weiße, schnell verdunstende Masse, die durch die Wasserdampfdestillation von Pflanzenteilen des Kampferbaumes oder synthetisch gewonnen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2897f532-21cc-423a-b92c-98bc36c9e3df",
                                                "sense_id": "46d545e4-22e6-333d-9008-3f6bdbf63869",
                                                "text": "Die tschechische Salbe Opodeldok enthält neben Lavendel und Rosmarin auch Kampfer."
                                            },
                                            {
                                                "example_id": "f76b5215-e108-4785-863e-84dc19bc7d8b",
                                                "sense_id": "46d545e4-22e6-333d-9008-3f6bdbf63869",
                                                "text": "„Das große Privatauto, in das Franz Biberkopf gelegt wird - ohne Bewußtsein, er hat Kampfer und Skopolaminmorphium bekommen - rast zwei Stunden.“"
                                            },
                                            {
                                                "example_id": "8a52b055-76c6-4cd8-9aa8-1a58e62e8aa8",
                                                "sense_id": "46d545e4-22e6-333d-9008-3f6bdbf63869",
                                                "text": "„In diesem Zimmer, das nach Kampfer und Naphthalin roch, habe ich einige der entscheidendsten Augenblicke meines Lebens verbracht.“"
                                            },
                                            {
                                                "example_id": "330b104e-8270-4df3-baf4-5be23f44fa2e",
                                                "sense_id": "46d545e4-22e6-333d-9008-3f6bdbf63869",
                                                "text": "„Das beste Mittel, sie loszuwerden, ist der Kampfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b89ab94-99e0-4173-9c86-122d167d8302",
                        "source_entry_id": "6a382097-0a1f-33fd-afa7-38283a49edc6",
                        "source_sense_id": "4d2c609e-d8e1-3490-a65c-b674cc0d82f5",
                        "target_lang_word": "camphor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camphor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4392584f-711e-3fcd-8a63-5b73c514a5a9",
                                        "entry_id": "73ecb7bf-1c4b-3263-8ad1-ae46e3a0cfb8",
                                        "glosses": [
                                            "A white transparent waxy crystalline isoprenoid ketone, 1,7,7-trimethylbicyclo[2.2.1]heptan-2-one, with a strong pungent odour, used in pharmacy, also known as laurel camphor or common/ordinary camphor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bf5d2aa-7cf3-415e-8039-50b6f8450cb2",
                                                "sense_id": "4392584f-711e-3fcd-8a63-5b73c514a5a9",
                                                "text": "Yet, oddly enough, I found a far unlikelier substance, and that was camphor. I found it in a sealed jar, that by chance, I suppose, had been really hermetically sealed. I fancied at first that it was paraffin wax, and smashed the glass accordingly. But the odour of camphor was unmistakable. In the universal decay this volatile substance had chanced to survive, perhaps through many thousands of centuries."
                                            },
                                            {
                                                "example_id": "e87244d2-0850-4967-9303-d62d176070f9",
                                                "sense_id": "4392584f-711e-3fcd-8a63-5b73c514a5a9",
                                                "text": "A form of camphor known as monobromated camphor is said to have an anaphrodisiac effect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63f99f91-f2be-307b-96df-f3207db243b6",
                                        "entry_id": "73ecb7bf-1c4b-3263-8ad1-ae46e3a0cfb8",
                                        "glosses": [
                                            "a plant-extracted crystalline substance similar to common camphor, especially Borneo camphor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a76ee89-c8b4-4111-8289-b43a65306e78",
                        "source_entry_id": "6a382097-0a1f-33fd-afa7-38283a49edc6",
                        "source_sense_id": "4d2c609e-d8e1-3490-a65c-b674cc0d82f5",
                        "target_lang_word": "camphre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camphre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                        "entry_id": "c31048fb-3e79-3b28-90d6-b1feb839ac66",
                                        "glosses": [
                                            "Cétone se présentant sous forme de cristaux blanchâtre et demi-transparente, d’une odeur très forte, d’une saveur amère et brûlante, qu’on extrait principalement du camphrier (Cinnamomum camphora chémotype à camphre). Il possède une action cardiotonique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a0a4639-9fcf-4078-9b76-3a062238f225",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "Tiens, je t’offre de fioler avec nous une tasse de café et un verre de camphre, ça va-t-il ?"
                                            },
                                            {
                                                "example_id": "6090fce9-6ee5-474a-a95a-664504fb3f1e",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "Le camphre est une sorte d’acétone dérivée d’un alcool, le bornéol. On le prépare en distillant avec de l’eau le bois du camphrier (Laurus camphora)."
                                            },
                                            {
                                                "example_id": "edad9ee2-e333-456d-8b87-0b640c9edfad",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "L’huile de camphre est obtenue en distillant les branches du camphrier ; on obtient un produit qui est un mélange d’huile et de camphre solide."
                                            },
                                            {
                                                "example_id": "7719211b-0e5f-4db3-95e3-bce7e1d7df9f",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "Il avait essayé de la consoler, pendant qu’elle rangeait leurs affaires dans une armoire où, d’un côté, pendaient les robes de Mme Loiseau, exhalant une odeur de camphre et de lait caillé, et dans le tiroir de la commode qui leur était réservé, les deux autres étant occupés par les effets de feu M. Loiseau."
                                            },
                                            {
                                                "example_id": "6b3dd66a-4ea1-42eb-abb9-57ba5ad11202",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "Le docteur Lantelme était obligé de faire faux bond un soir sur deux et bourrait de camphre toute la maison. Il allait en écraser jusque sur les carreaux de la cuisine et partait en faisant claquer les portes, poursuivi par les imprécations de « Pov' fille » et de tout le monde."
                                            },
                                            {
                                                "example_id": "fc52c1cf-cac4-422f-89ed-ca9c3198d26b",
                                                "sense_id": "834b41c7-4e5c-3d48-a8f9-984d9df616b2",
                                                "text": "Angelo essaya de soigner quelques-uns de ces foudroyés. Les ouvriers parlaient de la méthode Raspail et avaient grande confiance dans le camphre. Mais ils le considéraient plutôt comme un préservatif et ils en portaient des sachets pendus par des cordons au creux de la poitrine comme des scapulaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00256bc3-51e3-3c8d-8206-d4a1ccf02f4d",
                                        "entry_id": "c31048fb-3e79-3b28-90d6-b1feb839ac66",
                                        "glosses": [
                                            "Nom donné autrefois à divers produits odorants proches du camphre, extrait souvent d'arbre dont le nom vernaculaire est camphrier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b03147e8-5e51-4815-8415-d29990d28106",
                                                "sense_id": "00256bc3-51e3-3c8d-8206-d4a1ccf02f4d",
                                                "text": "Le camphre de Bornéo, n'est pas du camphre (chimiquement parlant), c'est du bornéol."
                                            },
                                            {
                                                "example_id": "2fcf7eb9-ce2d-4503-a4ed-b7e56b816191",
                                                "sense_id": "00256bc3-51e3-3c8d-8206-d4a1ccf02f4d",
                                                "text": "Quelques chimistes ont donné le nom de camphre a toutes ses huiles volatiles concrètes à la température ordinaire et qui ne sont pas mélangées avec des quantités trop appréciables d'huiles fluides ; ainsi l'on distinguait le camphre de tabac , le camphre d'anémone , le camphre de cantharides , le camphre d'asaret , le camphre d'aunée (inula helenium), …. — (François-Vincent Raspail, Nouveau système de chimie organique, éd. Baillière, 1833)"
                                            }
                                        ]
                                    }
                                ]
                            },
