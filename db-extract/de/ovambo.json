                "senses": [
                    {
                        "sense_id": "33004f88-fd5a-3bae-952f-7716466cbb5c",
                        "entry_id": "0d5073ff-cb1e-3a94-a347-4947cb28bdf9",
                        "glosses": [
                            "Bantusprache, die vor allem in Namibia, aber auch im Süden Angolas gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdfc100a-3beb-46ed-a78b-8e54c4b331a4",
                                "sense_id": "33004f88-fd5a-3bae-952f-7716466cbb5c",
                                "text": "„Ein ähnlich eigenwilliger Vergleich findet sich im Ovambo: The world is like a dog’s penis.“"
                            },
                            {
                                "example_id": "e8c5e5f2-2f7d-4500-8f49-22c9148c5171",
                                "sense_id": "33004f88-fd5a-3bae-952f-7716466cbb5c",
                                "text": "„das Wort selbst stammt aus dem Ovambo: „tava“, was die Bewegungen eines Neugeborenen bei der Geburt beschreibt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
