                {
                    "sense_id": "48e91095-88e7-3119-9510-dfe49b5b321f",
                    "sense_definition": "Laisser des marques visibles et durables sur la peau ou sur le corps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette maladie infantile a profondément <w>cicatrisé</w> son visage pendant des années."
                        },
                        {
                            "text": "Le violent accident a <w>cicatrisé</w> ses avant-bras d'une manière tout à fait indélébile."
                        }
                    ],
                    "synonyms": [
                        "marquer"
                    ],
                    "common_phrases": [
