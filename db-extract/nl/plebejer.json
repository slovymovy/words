                        "form_id": "bfe31469-8c8f-4bbb-9aad-791b44912de0",
                        "entry_id": "a0cf6de4-ec29-38fc-96ff-ace148d03626",
                        "tags": [
                            "plural"
                        ],
                        "form": "plebejers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ae08e1a-01da-3cf7-8137-bda37f118fd1",
                        "entry_id": "a0cf6de4-ec29-38fc-96ff-ace148d03626",
                        "glosses": [
                            "een lid van het gewone volk"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8b269868-d351-49d5-ae73-46052cb439b0",
                                "sense_id": "5ae08e1a-01da-3cf7-8137-bda37f118fd1",
                                "text": "Wat is de eerste ergernis van de plebejer bij aankomst in den vreemde? De code van de wifi. En wat is de tweede ergernis van de plebejer bij aankomst in den vreemde? De hoek van de kamer waar die ene morzel wifi zich ophoudt. Het ontbrak allemaal in The Lanesborough. Er was geen paswoord en er was overal wifi. Maar goed, eerst moest ik naar mijn kamer. Zonder sleutel! Want wat is de derde ergernis van de plebejer bij aankomst in den vreemde? Het kaartje van de deur. Het slot klikt, het lampje blijft rood, je kunt niet binnen en je haat het. De rechtgeaarde plebejer blijft voor de veiligheid altijd uit de minibar en hij nodigt zeker de butler niet uit voor een diner."
                            },
                            {
                                "example_id": "25cf3ae0-951f-4d4c-8f97-8d0a197f9534",
                                "sense_id": "5ae08e1a-01da-3cf7-8137-bda37f118fd1",
                                "text": "Hij had de houding van een plebejer die overal lak aan heeft. Een koning uit de onderwereld. Hij is onberekenbaar en gevaarlijk en ik vrees dat de Duitse bondskanselier Angela Merkel gelijk heeft als ze zegt dat Poetin het zicht op de werkelijkheid verloren heeft.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fe3ce81-c222-4a53-9c5d-d8b18a315b97",
                        "source_entry_id": "a0cf6de4-ec29-38fc-96ff-ace148d03626",
                        "source_sense_id": "5ae08e1a-01da-3cf7-8137-bda37f118fd1",
                        "source_sense_description": "(pejoratief) een lid van het gewone volk",
                        "target_lang_word": "scum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c59d30d9-8e28-3b80-ad43-cf3033675566",
                                        "entry_id": "c3f188df-17fd-394e-a459-b49c454d4908",
                                        "glosses": [
                                            "A layer of impurities that accumulates at the surface of a liquid (especially molten metal or water)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97e1ace8-98ed-49c6-83d2-3a2a4a4ab224",
                                                "sense_id": "c59d30d9-8e28-3b80-ad43-cf3033675566",
                                                "text": "During smelting, scum rises to the surface and is then removed by the smelter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761cf125-ec98-3c1b-8826-626d145e1cf8",
                                        "entry_id": "c3f188df-17fd-394e-a459-b49c454d4908",
                                        "glosses": [
                                            "A greenish water vegetation (such as algae), usually found floating on the surface of ponds"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c1c47a6-7605-40d3-9ee8-6462b57315f9",
                                                "sense_id": "761cf125-ec98-3c1b-8826-626d145e1cf8",
                                                "text": "These organisms form scum in large quantities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac690cd-0f15-3308-bdc6-414db1613f4c",
                                        "entry_id": "c3f188df-17fd-394e-a459-b49c454d4908",
                                        "glosses": [
                                            "The topmost liquid layer of a cesspool or septic tank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcf25887-1a0f-3323-a043-3eac63e91790",
                                        "entry_id": "c3f188df-17fd-394e-a459-b49c454d4908",
                                        "glosses": [
                                            "Semen."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a64412cd-8a03-42eb-b574-76f7e6fa15f6",
                                                "sense_id": "dcf25887-1a0f-3323-a043-3eac63e91790",
                                                "text": "Horse, who was always talking about facts, said, “Man, that can't be scum, ’cause scum is white.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25e38f5b-fd49-3f22-adbe-730a8b15e8db",
                                        "entry_id": "c3f188df-17fd-394e-a459-b49c454d4908",
                                        "glosses": [
                                            "A reprehensible person or persons."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fca970f0-a60c-4a70-81a2-59eeff5afc88",
                                                "sense_id": "25e38f5b-fd49-3f22-adbe-730a8b15e8db",
                                                "text": "People who sell used-up pens are scum, just total low-lives."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "scum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20c00142-53da-3f79-b0eb-539e692014c3",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To remove the layer of scum from (a liquid etc.)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b104e9d0-6492-3ce2-a0c8-8fd62acfdf83",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To remove (something) as scum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "975386e7-1b5d-445c-9338-f38a5effebdb",
                                                "sense_id": "b104e9d0-6492-3ce2-a0c8-8fd62acfdf83",
                                                "text": "Some scumd the drosse, that from the metall came; / Some stird the molten owre with ladles great[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae4480c-e303-39fc-8355-7b41b362c8f4",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To become covered with scum."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef85f7f4-d276-4554-a129-b5ab2f5713e5",
                                                "sense_id": "aae4480c-e303-39fc-8355-7b41b362c8f4",
                                                "text": "Take the smallest Cucumbers you can get, and as free from Spots as possible, put them into a strong Salt and Water for nine or ten Days, or 'till they are quite Yellow, and stir them twice a Day at least, or they will scum over, and grow soft"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3821006-2073-3d52-9ca6-59c99c5f200a",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To scour (the land, sea, etc.)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd4ea50d-872f-4346-9c9c-db2fbbd4c739",
                                                "sense_id": "e3821006-2073-3d52-9ca6-59c99c5f200a",
                                                "text": "SOo by Merlyns aduys ther were sente fore rydars to skumme the Countreye / & they mette with the fore rydars of the north / and made hem to telle whiche wey the hooste cam / and thenne they told it to Arthur / and by kyng Ban and Bors counceill they lete brenne and destroye alle the contrey afore them there they shold ryde"
                                            },
                                            {
                                                "example_id": "4e47f8ca-53a9-4d0c-9407-af3955395453",
                                                "sense_id": "e3821006-2073-3d52-9ca6-59c99c5f200a",
                                                "text": "Wandering up and down without certain seat, they lived by scumming those seas and shores as pirates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f327e1f4-eed8-34eb-9b2a-200751d08115",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To gather together, as scum."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5a145ab-4b62-4ea4-a86c-6ab9979e3899",
                                                "sense_id": "f327e1f4-eed8-34eb-9b2a-200751d08115",
                                                "text": "A great majority of the members are scummed together from the Jacobinical dregs of former periods of the revolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a06416fa-c815-3d6c-903e-a5c590919409",
                                        "entry_id": "6fad1334-f29f-314e-b776-d024a66563ce",
                                        "glosses": [
                                            "To startscum or savescum."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
