                                    {
                                        "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "das Beachten aller bedeutsamen Umstände, vorausschauendes Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89c7df2f-b019-42fb-8e45-83b5a43bab00",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "Durch Umsicht werden Fehler vermieden."
                                            },
                                            {
                                                "example_id": "10f14003-206c-4dff-8476-3847746acde7",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Händler/innen haben mit der gebotenen Umsicht zur Einhaltung der anwendbaren Sicherheitsanforderungen beizutragen, indem sie insbesondere keine Produkte liefern, von denen sie wissen oder auf Grund der ihnen bei zumutbarer Sorgfalt zugänglichen Informationen wissen müssten, dass sie diesen Anforderungen nicht genügen.“"
                                            },
                                            {
                                                "example_id": "ca5bf55c-9967-40aa-95ae-2596f8b6550b",
                                                "sense_id": "c43a6bbb-2f1f-336d-ba83-7b45d1841fdc",
                                                "text": "„Die goldene Regel des Drachenfliegens heißt, möglichst viel Umsicht walten lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                        "entry_id": "60645f6c-d455-370f-a483-88de3360a949",
                                        "glosses": [
                                            "Rundblick, Aussicht"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc035f98-3af8-4ee4-9446-1b2248bd01d2",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Von der Höhe des Damms, auf dem der Wettlauf gehalten wurde, bietet sich eine prachtvolle Umsicht dar.“"
                                            },
                                            {
                                                "example_id": "dc6d35c6-118d-469d-ba12-c4a91c79d117",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Erst 1845 hören wir von einem acht Meter hohen hölzernen Gerüst auf dem Gipfel, welches »eine fast unbeschränkte Umsicht gewähre«.“"
                                            },
                                            {
                                                "example_id": "fadc99af-3a69-4841-ba1c-89cd0e267ffa",
                                                "sense_id": "be8a4294-5d76-3b05-bcb2-3dbe720950b8",
                                                "text": "„Denn die Aussicht von diesem Thurm ist so entzückend schön, so über alle Maßen reichhaltig, daß kein Berg in dem großen Riesengebirge diese herrliche Umsicht gewährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d8c6690-97d3-4285-8132-ebe1b10d2ebe",
                        "source_entry_id": "f77eba5e-1848-3f14-b326-8ddc29d8ce27",
                        "source_sense_id": "1226516c-7254-35e4-8b18-088ccfc61843",
                        "target_lang_word": "Vernunft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vernunft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                        "entry_id": "55e28f10-c942-3ca1-96ec-1cb19a1e6300",
                                        "glosses": [
                                            "Fähigkeit des menschlichen Denkens; geistiges Vermögen des Menschen, mit seinem Verstand durch Beobachtung und Erfahrung erfasster Sachverhalte universelle Zusammenhänge der Wirklichkeit durch Schlussfolgerung herstellen zu können, deren Bedeutung zu erkennen, Regeln und Prinzipien aufzustellen und danach zu handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bc56367-909a-4c34-af70-5e664666d25e",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "Nur der Mensch ist zur Vernunft fähig."
                                            },
                                            {
                                                "example_id": "f3286ca4-9a29-4c2b-b231-d2ab59026cab",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "Die Vernunft ist das oberste Erkenntnisvermögen, das den Verstand kontrolliert und diesem Grenzen setzt bzw. dessen Beschränkungen erkennt."
                                            },
                                            {
                                                "example_id": "d2c520a0-876d-4533-821a-a9ab004ac649",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "„Wo die moralische Verdächtigung zu herrschen beginnt, hat die Vernunft keine Chance."
                                            },
                                            {
                                                "example_id": "f2bd9adb-f207-4f66-a54e-8f10f7550ad5",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "Nimm doch Vernunft an!"
                                            },
                                            {
                                                "example_id": "703717c2-4577-419c-a01a-1cd5c8a2c912",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "„In ihrer Aufgabe, die Vernunft praktisch werden zu lassen, beruht die Politik für Leibniz nicht auf einem Interessenausgleich, sondern ihr Ziel ist die Durchsetzung einer als richtig und wahr erkannten Ordnung durch den Staat.“"
                                            },
                                            {
                                                "example_id": "b960dcea-d816-4add-b0b4-2ea794dfdc2d",
                                                "sense_id": "d007e3aa-97d7-39ba-81a2-4ece067d2a3c",
                                                "text": "„Jetzt aber erwies sich die klare Vernunft der Familie Binnet für mich als ein Segen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
