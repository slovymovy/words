                    },
                    {
                        "form_id": "3268e8ea-d23e-49ba-8ae0-40662bf8f4f4",
                        "entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Postillion"
                    },
                    {
                        "form_id": "a3d6b91d-fec3-4eb3-a941-980fc376a2fe",
                        "entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Postillione"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                        "entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "glosses": [
                            "Fahrer einer Postkutsche"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5427de45-f07c-4490-9b2e-b149f44cdfb1",
                                "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                                "text": "„Im 19. Jahrhundert trugen die Postillione, Pferdewagen und Briefkästen in den vielen deutschen Fürstentümern und Königreichen meist die bunten Farben des jeweiligen Landesherrn.“"
                            },
                            {
                                "example_id": "0e94ea25-5370-41c8-932c-8a1841288ce8",
                                "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                                "text": "„Beim Zurückreiten oder Fahren mit ledigen Pferden und Wagen darf der Postillion sich unterweges nicht aufhalten.“"
                            },
                            {
                                "example_id": "a4735d57-9bd9-4c7b-84ab-4f0be9dab942",
                                "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                                "text": "„Schlechte und schlammige Wege, auf denen der Postillion - und manchmal auch die Mitreisenden - in die Speichen greifen mussten, Reparaturen, Wetterkapriolen und Raubüberfälle machten die Ankunftszeiten unberechenbar.“"
                            },
                            {
                                "example_id": "59de01be-25f4-4d73-9029-c4c0441e733b",
                                "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                                "text": "„Unten auf dem Wege wandern Leute und Pferde, ein Postillion fährt vorbei und stößt in sein Horn.“"
                            },
                            {
                                "example_id": "69992138-058d-4b10-bf85-5c2839fb44d6",
                                "sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                                "text": "„Die beiden Postillione, davon auf der Kutsche Herr Zimmermann, beteiligen sich mit einer Vierspänner-Fahrpostkutsche am Festzug der 1000-Jahrfeier der Stadt Duderstadt im Juli 1929.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79cd30f0-465e-39d7-b4c1-a75dfe573d8e",
                        "entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "glosses": [
                            "ein Schmetterling (wissenschaftlich: Colias croceus)"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f81ec9e5-2e98-4a91-8874-f630bf54dd00",
                        "source_entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "source_sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                        "source_sense_description": "historisch: Fahrer einer Postkutsche",
                        "target_lang_word": "postilion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postilion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                        "entry_id": "52465d67-d47c-3657-85ea-eb8c08800028",
                                        "glosses": [
                                            "A rider mounted on the near (left) leading horse who guides the team pulling a carriage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dec64cbc-b87e-4fa2-929d-eeea36e17afa",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "C’est un garcon de bonne fortune, said the landlord, pointing through the window to half a dozen wenches who had got round about La Fleur, and were most kindly taking their leave of him, as the postilion was leading out the horses."
                                            },
                                            {
                                                "example_id": "92e61ce1-4e98-4d48-81e7-435b1d6347e7",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "The postilion seized one of his fat horses by the tail, and swung himself up to his seat again."
                                            },
                                            {
                                                "example_id": "b02ae3db-e32c-4b7d-b67c-a25a43d8a9e2",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "And now the carriage had fairly left the village; yet the postilions slackened their speed, and drew up gradually before a line of almshouses, […]"
                                            },
                                            {
                                                "example_id": "25190953-20cf-461d-b354-ed5cddfda92d",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "The rain drove into the bride and bridegroom's faces as they passed to the chariot. The postilions' favours draggled on their dripping jackets."
                                            },
                                            {
                                                "example_id": "d4102b8c-6f06-4ca7-a419-0c69cd90180a",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "To play the postilion is not an easy thing. It is a trade by itself—half a gunner's and half a groom's. It has to do with horses—that is bad enough ; but also it involves some knowledge of the road."
                                            },
                                            {
                                                "example_id": "2a26bc3e-ea5b-4496-b0bd-c540ddeec259",
                                                "sense_id": "8626616e-0051-3da1-96ac-f9dc3363eecd",
                                                "text": "A very spirited affair it looked with its red body and yellow wheels, bouncing about on its high C springs [...] with its four horses going full stretch and two postilions in knee-cords and top-boots laying into the horses in a lather of dust and excitement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36dec191-2309-3bd6-a8ca-ca3a984e0dbd",
                                        "entry_id": "52465d67-d47c-3657-85ea-eb8c08800028",
                                        "glosses": [
                                            "A post-boy, a messenger boy, a swift letter carrier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c492ea5b-3c75-4844-a3d0-4159f99542d3",
                        "source_entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "source_sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                        "source_sense_description": "historisch: Fahrer einer Postkutsche",
                        "target_lang_word": "postillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c484213f-c22d-3b5a-b73a-cd1fa4fe3f3d",
                                        "entry_id": "c54281e7-1b31-3182-824c-b306584c0335",
                                        "glosses": [
                                            "Alternative spelling of postilion."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a1d917b-5acb-4c2f-ba11-bf1506b8b170",
                                                "sense_id": "c484213f-c22d-3b5a-b73a-cd1fa4fe3f3d",
                                                "text": "So saying, he ordered the postillion to the horses' heads, there to await his return."
                                            },
                                            {
                                                "example_id": "465b5aab-6d9b-4632-bfd0-73bcc9dd663e",
                                                "sense_id": "c484213f-c22d-3b5a-b73a-cd1fa4fe3f3d",
                                                "text": "Barouches with gleaming lamps, a couple of gendarmes posted before the doors, a babel of postillions’ cries—nothing..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b931ed58-9208-4245-95a2-cd051be2541e",
                        "source_entry_id": "6043f942-b2c0-393a-bb2c-e214829be605",
                        "source_sense_id": "dfc77836-6b79-3bb4-be77-f02de3aea7b0",
                        "source_sense_description": "historisch: Fahrer einer Postkutsche",
                        "target_lang_word": "postillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                        "entry_id": "c91ecfcc-5804-3883-9a4c-97d042b7722c",
                                        "glosses": [
                                            "Celui qui menait en le montant un des chevaux d’un attelage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81493f87-dca8-4e3d-9771-e934e27f9566",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "[…], les claquements de fouet d’un postillon comptant sur un large pourboire apprirent le retour des deux soldats à leurs familles."
                                            },
                                            {
                                                "example_id": "a85611d4-d069-41b0-ad80-9000dbb1d95c",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "Sans cesse, je lui fournis des chevaux pour des parties de plaisir dans les bois de Burelviller, que vous voyez là-bas, au bout de la plaine ; et Dieu sait ce qu’on fait dans ces bois ! L’on enivre toujours mes postillons, pour les empêcher de voir et d’entendre. Du diable si, en rentrant, ils peuvent me dire un mot."
                                            },
                                            {
                                                "example_id": "c7c6d9aa-ef76-484c-b8d1-bbe9da8d6323",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "Un trait venait de se briser par suite du mouvement impétueux que, sur l’ordre de son maître, un jeune postillon avait imprimé à quatre des plus vigoureux chevaux du relais."
                                            },
                                            {
                                                "example_id": "53f3ca2c-5e63-44fc-828c-442edf1c40f1",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "Ce qui achève le cauchemar, c’est le lugubre postillon en vieille cape déguenillée qui sautille éternellement dans la clarté jaunâtre."
                                            },
                                            {
                                                "example_id": "857446bf-b891-4402-b617-a157727cd22d",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "Assis de côté sur son siège, les jambes croisées, le chapeau de paille en arrière, dans la pose que devait prendre le postillon de Longjumeau lorsqu’il « conduisait une dame de haut parage, » il était très commodément placé pour diriger ses chevaux et en même temps pour faire la conversation avec sa voyageuse, si celle-ci voulait parler."
                                            },
                                            {
                                                "example_id": "d00606f2-73c1-4e59-9dae-accc52dadb4e",
                                                "sense_id": "4d5441e2-cef2-36dc-bfbb-e25c9c3a84cf",
                                                "text": "Il nous chantait « Le Postillon de Longjumeau ». Il arrivait rarement au bout. Il s’essoufflait et semblait prendre son élan pour dire : le Pos, le Pos, le Postillon, le Postillon de Longjumeau. Sa femme, Sylvie, le regardait avec extase, en dodelinant de la tête. Cher oncle Nicolas !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08da071e-281a-34e1-93ca-0daa65a65e36",
                                        "entry_id": "c91ecfcc-5804-3883-9a4c-97d042b7722c",
                                        "glosses": [
                                            "Homme attaché au service de la poste aux chevaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6fd24f6-bb23-48e4-af8b-2da759fbe760",
                                                "sense_id": "08da071e-281a-34e1-93ca-0daa65a65e36",
                                                "text": "Derrière elle, dans un nuage de poussière et emportée par la descente, une malle-poste au grand galop se précipitait comme une trombe. En voyant cette femme qui ne se dérangeait pas, le conducteur se dressa par-dessus la capote, et le postillon criait aussi pendant que ses quatre chevaux, qu’il ne pouvait retenir, accéléraient leur train."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1650db27-bf20-31c1-92ff-a531ab10c433",
                                        "entry_id": "c91ecfcc-5804-3883-9a4c-97d042b7722c",
                                        "glosses": [
                                            "Gouttelette de salive que l’on projette en parlant."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f74d7b58-84fb-4b1d-95f9-27c2beb69f24",
                                                "sense_id": "1650db27-bf20-31c1-92ff-a531ab10c433",
                                                "text": "Envoyer, lancer des postillons."
                                            },
                                            {
                                                "example_id": "54ee20c8-9233-4a15-8be3-74d8a4fdd23a",
                                                "sense_id": "1650db27-bf20-31c1-92ff-a531ab10c433",
                                                "text": "C’était un ivrogne par surcroît, qui se raccrochait à votre vareuse pour vous parler interminablement en lançant des postillons."
                                            },
                                            {
                                                "example_id": "33ab4f06-b039-4f24-b633-70e94ae75fda",
                                                "sense_id": "1650db27-bf20-31c1-92ff-a531ab10c433",
                                                "text": "Jean voulut intervenir, mais il fut interrompu par la vision de Lucien recevant un direct, on vit voler les postillons."
                                            }
                                        ]
                                    },
                                    {
