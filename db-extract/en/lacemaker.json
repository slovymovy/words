                                        "sense_id": "cedd6bb6-7d0a-3ce1-8b78-a0a627daa276",
                                        "entry_id": "4649f62e-7914-3dce-83fa-d2de369c2f28",
                                        "glosses": [
                                            "Relatif à la dentelle et à sa fabrication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eee02be4-add9-4f32-ab03-7948929d4a69",
                                                "sense_id": "cedd6bb6-7d0a-3ce1-8b78-a0a627daa276",
                                                "text": "L’industrie dentellière."
                                            },
                                            {
                                                "example_id": "f9c9f3cc-9e66-4ebe-9e8e-2f6f84c5ec0b",
                                                "sense_id": "cedd6bb6-7d0a-3ce1-8b78-a0a627daa276",
                                                "text": "Maison des dentelles. […]. Belles collections de pièces du 16e au 20e s., témoignages du passé dentellier d'Argentan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcd9709d-ce85-438b-894a-9e1af3867355",
                        "source_entry_id": "337587e6-ddaf-3da1-8bbf-525779bd4bec",
                        "source_sense_id": "3fdfe3fb-37ae-3529-8886-ca0294d40a47",
                        "source_sense_description": "person who makes lace",
                        "target_lang_word": "dentellière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dentellière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88b15640-6671-3736-8778-f72518ba21c8",
                                        "entry_id": "2c0c9437-4ffa-368e-a66a-aa5158f7b643",
                                        "glosses": [
                                            "Celle qui fait de la dentelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf0ca03-6e2d-4906-bb6b-83989e302dd1",
                                                "sense_id": "88b15640-6671-3736-8778-f72518ba21c8",
                                                "text": "Nous en avons assez des dentellières et de leurs racontars, et nous remontons vers la ville haute."
                                            },
                                            {
                                                "example_id": "fb24a3e2-c2e1-4cbf-9624-3aad290357ac",
                                                "sense_id": "88b15640-6671-3736-8778-f72518ba21c8",
                                                "text": "Ma mère, orpheline dès l’âge de treize ans et obligée de gagner sa vie comme dentellière, ne savait rien, mais rien, du ménage."
                                            },
                                            {
                                                "example_id": "b3b09e0e-7f24-4fce-9706-261dcd9bcd2c",
                                                "sense_id": "88b15640-6671-3736-8778-f72518ba21c8",
                                                "text": "La beauté soudaine et non délibérée qui émanait de Pomme à ses tâches quotidiennes, lorsqu’elle lavait, qu’elle préparait à dîner, empreinte de la simple majesté de son geste de « Dentellière », était du même au-delà, sans doute, qu’une symphonie de Mahler."
                                            },
                                            {
                                                "example_id": "b761cc24-1c53-4731-8c56-6fcad5a28094",
                                                "sense_id": "88b15640-6671-3736-8778-f72518ba21c8",
                                                "text": "Généralement, le travail est distribué par un dentellier qui recherche la clientèle, qui exécute ou fait exécuter les modèles à la demande […]. Fréquemment, le dentellier recourt à une entrepreneuse chargée des relation avec les dentellières."
                                            }
                                        ]
                                    }
                                ]
                            },
