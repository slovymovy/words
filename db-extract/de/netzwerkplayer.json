                "senses": [
                    {
                        "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                        "entry_id": "9c5e3ac2-aab2-39cb-8ffa-24bb43254723",
                        "glosses": [
                            "Zusatzgerät an einer Stereo- oder Multimediaanlage, das das Hören von Internetradio, Audio- oder Videostreaming-Diensten aus dem Internet ermöglicht"
                        ],
                        "tags": [
                            "Unterhaltungselektronik"
                        ],
                        "examples": [
                            {
                                "example_id": "c3f8a0e8-b945-4916-8c74-78f0822793e9",
                                "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                                "text": "„Satellitenreceiver sorgen längst nicht mehr nur für den TV-Empfang: Sie dienen als Rekorder, Abspielgerät für Medien oder Netzwerkplayer.“"
                            },
                            {
                                "example_id": "53d2b955-e3b7-4ec9-b133-815ba716a08f",
                                "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                                "text": "„Windows 7 kann als Medienstreaming-Server dienen. Das heißt, Sie können Musik und Videos über das Multimedia-Protokoll UpnPAV an Wiedergabegeräte (Netzwerkplayer, WLANRadios etc.) im Netz senden […]“"
                            },
                            {
                                "example_id": "b9010211-3da9-4a9d-b4db-116b573eab2f",
                                "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                                "text": "„Teilweise werden eher vorhandene Geräte kombiniert werden (z.B. Netzwerkplayer, die Filme auf der PC-Festplatte finden und über den Fernseher abspielen).“"
                            },
                            {
                                "example_id": "23d8a0fc-58fb-4e64-be05-23591e09575f",
                                "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                                "text": "„Mit ihm schickt M3 Electronic ein sehr vielseitiges Radiogerät mit Netzwerkplayer in den Handel. „Die Verkäufe des IR 715 waren mehr als zufriedenstellend“, […]“"
                            },
                            {
                                "example_id": "7105fb11-2b8d-420e-bc19-4dfae4d6af7f",
                                "sense_id": "51352043-d1ed-3a7c-ae3b-22546a05f5af",
                                "text": "Ich habe mir gestern einen Netzwerkplayer gekauft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9a2d7cc-ca37-316b-935c-523b82b00f80",
                        "entry_id": "9c5e3ac2-aab2-39cb-8ffa-24bb43254723",
                        "glosses": [
                            "Person oder Organisation, die besonders intensiv und effektiv in sozialen und wirtschaftlichen Netzwerken agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4d50eee-6f7b-4ca6-833a-53021214eb9a",
                                "sense_id": "b9a2d7cc-ca37-316b-935c-523b82b00f80",
                                "text": "„Im vorliegenden, ersten Teil liegt der Schwerpunkt neben der Identifikation der Netzwerkplayer vor allem auf der Analyse des strategischen Umfelds, in welchem das Netzwerk agiert […].“"
                            },
                            {
                                "example_id": "c337ffdd-f1a8-4955-934e-e1afdafe0ed0",
                                "sense_id": "b9a2d7cc-ca37-316b-935c-523b82b00f80",
                                "text": "„Unsere Märkte verfügen zudem über hervorragendes Wachstumspotenzial. […]. Dagegen gewinnen die europäischen Netzwerk-Player schon jetzt deutlich an Fahrt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
