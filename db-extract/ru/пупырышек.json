                    },
                    {
                        "translation_id": "223a94d5-348e-46bd-8461-e74835f06c61",
                        "source_entry_id": "92e8d8fd-c81b-3ff0-9f9c-48aa507fe626",
                        "target_lang_word": "bouton",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b821fed-1d03-3d7f-aa06-15c05e3eb953",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petite pièce de diverses matières, ordinairement ronde ou plate, quelquefois bombée ou en boule, qui sert généralement à retenir ensemble différentes parties d’un vêtement et que l’on passe, à cet effet, dans les fentes appelées boutonnières, dans les ganses ou dans les brides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e0627b-a994-4e9e-89ad-83a7b4e1e3c3",
                                                "sense_id": "2b821fed-1d03-3d7f-aa06-15c05e3eb953",
                                                "text": "Les marches boueuses portaient l’enseigne de chaque métier en offrant aux regards des découpures de cuivre, des boutons cassés, des brimborions de gaze, de sparterie."
                                            },
                                            {
                                                "example_id": "ec368d0e-8402-4252-b85d-bfe011304aff",
                                                "sense_id": "2b821fed-1d03-3d7f-aa06-15c05e3eb953",
                                                "text": "M. Hyacinthe a revêtu son costume le plus somptueux : une redingote, que son embonpoint soumet à des efforts de plus en plus tendus. C’est qu’elle ne date pas d’hier. Il l’a inaugurée il y a douze ans. Et dame ! depuis lors il a grossi. L’étoffe se tire tellement à l’endroit des boutons que ceux-ci ressemblent à des comètes, dont la queue en éventail est faite d’une infinité de plis."
                                            },
                                            {
                                                "example_id": "a2ee232a-13e7-4a28-a81a-1897577e07e1",
                                                "sense_id": "2b821fed-1d03-3d7f-aa06-15c05e3eb953",
                                                "text": "Boutons-olives, bleu vif ou vert cru, tous les rouges, verts et bleus des boutons en corozo encore cousus sur des cartons bordés d’un filet doré tout terni. Boutons enfilés sur un fil noué, sortes de bracelets, ainsi qu’en faisaient les ménagères économes avant de jeter un vêtement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877dcd81-05c8-398b-b7c1-530f6cffd6af",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petit corps arrondi ou allongé qui poussent sur les arbres et les arbustes et d’où naissent les branches, les feuilles ou les fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43dc4136-f790-4ac9-b31d-fe282e3edf03",
                                                "sense_id": "877dcd81-05c8-398b-b7c1-530f6cffd6af",
                                                "text": "Bouton à bois. Boutons à feuilles. Bouton à fruit."
                                            },
                                            {
                                                "example_id": "2a2b3460-40bb-4ab9-8b4d-3a8f68f32b20",
                                                "sense_id": "877dcd81-05c8-398b-b7c1-530f6cffd6af",
                                                "text": "Il y a beaucoup de boutons à cet arbre."
                                            },
                                            {
                                                "example_id": "58b6430e-9910-4b62-a0b4-880c5f5b8de5",
                                                "sense_id": "877dcd81-05c8-398b-b7c1-530f6cffd6af",
                                                "text": "Ce fut par un de ces mauvais jours que Pascal, s’étant approché d’une fenêtre, aperçut son voisin, M. Bellombre, le professeur retraité, en train de faire le tour de ses arbres, pour voir s’ils avaient beaucoup de boutons à fruit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "073b266c-748e-3ed5-bb44-e80d08bc9dc2",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Fleur qui n’est pas encore épanouie."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bad2603-e2ac-466b-9750-cfeacfb53ac7",
                                                "sense_id": "073b266c-748e-3ed5-bb44-e80d08bc9dc2",
                                                "text": "Le platycodon, que l'on connaît peu, appartient à la famille des campanulacées. Ses boutons bien ronds donnent en s'ouvrant de magnifiques fleurs bleues et sucrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "344acf3b-6d6e-3fe2-ad9f-33964cc95e97",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Ornement décoratif sculpté figurant une fleur qui n’est pas éclose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31054ea3-2d6d-3f65-a5ca-bf34d24925de",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petites tumeurs arrondies qui se forment sur la peau, soit au visage, soit en diverses parties du corps."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1165a6-a58c-41f4-8b7e-b7fae625b047",
                                                "sense_id": "31054ea3-2d6d-3f65-a5ca-bf34d24925de",
                                                "text": "[…] d’abord pisiformes, durs et peu sensibles, ces boutons grossissent, s’abcèdent, deviennent douloureux et fluctuants."
                                            },
                                            {
                                                "example_id": "d3981f7f-a2fa-4474-ba01-eb8deb244eba",
                                                "sense_id": "31054ea3-2d6d-3f65-a5ca-bf34d24925de",
                                                "text": "Si on a tendance à avoir des boutons de rasage, on applique une crème hydratante ou un après-rasage adapté, quelle que soit la technique de rasage utilisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4903048-72ed-34e9-9460-09a040e049e6",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Insigne qui est une marque de la profession qu’on exerce ou de la dignité dont on est revêtu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a032e09a-dda1-44b3-9e54-b83ffd38b086",
                                                "sense_id": "e4903048-72ed-34e9-9460-09a040e049e6",
                                                "text": "Bouton de livrée, de mandarin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf257d5-fffc-3e19-b24f-8d147fa78fed",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petite pièce de métal qui garnit l’extrémité d’un fleuret pour le rendre inoffensif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c59f6ad2-70fc-4122-868d-2c7daad2aa99",
                                                "sense_id": "ccf257d5-fffc-3e19-b24f-8d147fa78fed",
                                                "text": "Chacun d’eux emboîta à la pointe de son épée un de ces boutons d’acier qui transforme une rapière en fleuret de salle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f011f90c-cd0f-3fc8-bf96-3fa9a88f2a07",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Partie saillante et arrondie à l’aide de laquelle on pousse et on tire le pêne d’une serrure ou un verrou."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d806bfe5-2df3-4741-b20f-612fd0494abb",
                                                "sense_id": "f011f90c-cd0f-3fc8-bf96-3fa9a88f2a07",
                                                "text": "Le Brun surveillera l’étonnant Cussy, l’Italien qu’il gardera près de lui, tandis qu’il cisèle les crémones, les targettes, les boutons de porte, ces menus travaux d’une perfection incomparable, et qui confèrent à Versailles sa primauté."
                                            },
                                            {
                                                "example_id": "57716b70-a462-48d5-8f19-82e571bcd6d0",
                                                "sense_id": "f011f90c-cd0f-3fc8-bf96-3fa9a88f2a07",
                                                "text": "Le bouton d’une serrure, d’un verrou. Le bouton d’un tiroir, d’un couvercle. Le bouton d’une porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d3645dd-f7c4-34a4-bad2-0711c0f3e099",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Pièce de fer ou de cuivre, qui est ordinairement de forme ronde ou ovale et qui sert à tirer à soi une porte ou à l’ouvrir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06582a5b-c3b2-4f72-8492-6af610f71d26",
                                                "sense_id": "0d3645dd-f7c4-34a4-bad2-0711c0f3e099",
                                                "text": "Elle chercha à tâtons le bouton d’un huis, finit par le trouver, et entra dans une pièce sombre."
                                            },
                                            {
                                                "example_id": "a53734dc-a66d-4b31-a5b9-61af74e144ab",
                                                "sense_id": "0d3645dd-f7c4-34a4-bad2-0711c0f3e099",
                                                "text": "J'ai en un domestique mysophobe; son bonheur, c'était de passer sa journée à nettoyer les cuivres, les chenets, boutons de porte, lustres, enfin tout ce qui dans l'appartement était en métal ou susceptible de briller; […]."
                                            },
                                            {
                                                "example_id": "51f25cc9-0acd-4117-a653-689404672310",
                                                "sense_id": "0d3645dd-f7c4-34a4-bad2-0711c0f3e099",
                                                "text": "D'une main, j’ai empoigné la poignée de ma valoche et de l'autre le bouton de porte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8cf1353-42ed-3577-99f3-7f310685ae41",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petit anneau de cuir qui coule le long des rênes et qui sert à les resserrer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "672f6b4a-6d9a-41e7-9eab-ab24bdd895ea",
                                                "sense_id": "f8cf1353-42ed-3577-99f3-7f310685ae41",
                                                "text": "Le bouton de la bride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0044c3a3-74b7-38a4-97a0-ea752e8a7d8e",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petite portion d’or ou d’argent qui reste après la coupellation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a8f19232-5574-35b2-a519-911ba69012b5",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Petit organe de commande d’un appareil, surtout bouton-poussoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012d0dd7-92c6-45ec-a2fd-038a451932aa",
                                                "sense_id": "a8f19232-5574-35b2-a519-911ba69012b5",
                                                "text": "M. Constant pressa le bouton d’une sonnerie et jeta un ordre au gardien qui surgit dans l’entre-bâillement de la porte […]"
                                            },
                                            {
                                                "example_id": "45d2b93b-707c-4649-9617-5bff20902181",
                                                "sense_id": "a8f19232-5574-35b2-a519-911ba69012b5",
                                                "text": "Il appuya sur le bouton d’une sonnette. Un domestique en livrée parut aussitôt."
                                            },
                                            {
                                                "example_id": "e522eb65-2e15-4a00-976d-ab2bd6da2768",
                                                "sense_id": "a8f19232-5574-35b2-a519-911ba69012b5",
                                                "text": "Il faut bien avouer que l' ergonomie des commandes est en retrait depuis la généralisation des touches numériques. Les boutons à poussoir présentent l'avantage d'être actionnables en un geste auquel le conducteur se familiarise d'ailleurs rapidement. Un vrai plus en termes de sécurité routière apprécié par beaucoup d'automobilistes. Leurs homologues tactiles, eux, obligent souvent à quitter la route des yeux, surtout lorsque la fonctionnalité choisie est accessible via des menus, pas toujours intuitifs au demeurant. Or c'est précisément ce que dénonce le dirigeant d'Euro NCAP. Qui explique : « La surutilisation des écrans tactiles est un problème à l'échelle de l'industrie. Presque tous les constructeurs automobiles déplacent les commandes clés sur des écrans tactiles centraux, obligeant les conducteurs à quitter la route des yeux et augmentant le risque d'accidents liés à la distraction. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb125c1-97b8-3c70-9a16-6b261a2e76f7",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Commande manuelle d’un interrupteur, d’un potentiomètre, etc."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5af5155a-729a-3218-802a-cfcfb2f03e74",
                                        "entry_id": "d1ce9fb6-4e48-3e6f-bf83-3dc8e1277688",
                                        "glosses": [
                                            "Zones d’interface, icônes numériques d’un écran, d’un site ou d’un programme qui permet d’interagir avec ces derniers."
                                        ],
                                        "tags": [
                                            "Interface graphique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "191f91e8-dc6f-4015-bd54-98a4f28e8a93",
                                                "sense_id": "5af5155a-729a-3218-802a-cfcfb2f03e74",
                                                "text": "Sélectionne le bouton « désinstaller » et confirme pour te débarrasser de ce programme."
                                            },
                                            {
                                                "example_id": "2ca55a56-69ab-4f17-bcfd-3b1b02acfbf2",
                                                "sense_id": "5af5155a-729a-3218-802a-cfcfb2f03e74",
                                                "text": "Appuie sur le bouton « annuler » pour éviter de télécharger n’importe quoi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
