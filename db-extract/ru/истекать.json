                        "examples": [
                            {
                                "example_id": "065b149b-9ea6-445e-8bc5-7dd6b5181a16",
                                "sense_id": "f5d09bcd-bdf4-348b-82f9-090d07933264",
                                "text": "истека́ть кро́вью",
                                "translation": "to bleed",
