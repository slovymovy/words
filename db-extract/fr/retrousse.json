                                "sense_id": "e96680d9-2a26-31a5-856b-944cac0fbb84",
                                "text": "Pour ce pressoir, la retrousse s'effectue manuellement en remaniant l'extérieur du gâteau de maie vers le centre du pressoir."
                            },
                            {
                                "example_id": "78d46fa6-7aa6-4bf8-97c9-c5d5b00fbac9",
                                "sense_id": "e96680d9-2a26-31a5-856b-944cac0fbb84",
                                "text": "Quand l'écoulement du moût devient insignifiant, on pratique la retrousse."
                            }
                        ]
                    }
