                                        "entry_id": "d4d491db-04a5-3cd2-83a2-722b838914a4",
                                        "glosses": [
                                            "Plante du genre Œnothera de la famille des onagracées (Onagraceae)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e8f8e5-c0ee-4e28-99d5-d7b3bb27b3cd",
                                                "sense_id": "a15f3d7e-8e44-31ad-bd59-d7cf3da1fd41",
                                                "text": "La chenille du sphinx de l’épilobe ou sphinx de l’œnothère se nourrit sur des épilobes, des onagres (œnothères) ou des salicaires."
                                            },
                                            {
                                                "example_id": "389b25a5-ea71-4ccc-b222-979b324b0ea8",
                                                "sense_id": "a15f3d7e-8e44-31ad-bd59-d7cf3da1fd41",
                                                "text": "Onagre, l’autre nom de l’œnothère porte à confusion."
                                            }
                                        ]
