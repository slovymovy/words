                        "cross_references": [
                            {
                                "target_word": "одногодок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1d1494e5-3ee5-3c3f-a473-4f12ab327517",
                                        "entry_id": "f77bd908-5dcb-3eaf-9a0d-069ecd046847",
                                        "glosses": [
                                            "разг. тот, кто одних лет с кем-либо; ровесник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ff9be04-f1da-4ed9-8d09-08a42e75747c",
                                                "sense_id": "1d1494e5-3ee5-3c3f-a473-4f12ab327517",
                                                "text": "Физически я был не таким сильным, как мой одногодок Игорь Коган, который отжимался более двухсот раз, но зато пластичным и мягким."
                                            },
                                            {
                                                "example_id": "07c5cbaf-5dbe-44d2-8ef2-50b8648485a0",
                                                "sense_id": "1d1494e5-3ee5-3c3f-a473-4f12ab327517",
                                                "text": "Наши дети родились в один год, и мужья одногодки, но к моменту её приезда ничего не забылось ― и всё изменилось."
                                            },
                                            {
                                                "example_id": "ad11771e-28b0-4208-912d-80e9e44d7d07",
                                                "sense_id": "1d1494e5-3ee5-3c3f-a473-4f12ab327517",
                                                "text": "Это были мальчишка и девчонка, одногодки ― лет шестнадцати или чуть больше."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41cc0f24-c443-3884-b001-3e2e6cf61239",
                                        "entry_id": "f77bd908-5dcb-3eaf-9a0d-069ecd046847",
                                        "glosses": [
                                            "разг. животное или растение в возрасте одного года"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
