{
    "word_family": [
        "dim",
        "dimness",
        "dimmer"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                    "sense_definition": "In a way that lacks light or clarity, making something difficult to see or understand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old candle burned <w>dimly</w> in the corner of the dark room.",
                            "target_lang_translations": {
                                "ru": "Старая свеча <w>тускло</w> горела в углу темной комнаты."
                            }
                        },
                        {
                            "text": "I could only <w>dimly</w> remember the events from my early childhood.",
                            "target_lang_translations": {
                                "ru": "Я лишь <w>смутно</w> помнил события из своего раннего детства."
                            }
                        },
                        {
                            "text": "The streetlights shone <w>dimly</w> through the thick evening fog.",
                            "target_lang_translations": {
                                "ru": "Уличные фонари <w>слабо</w> светили сквозь густой вечерний туман."
                            }
                        },
                        {
                            "text": "She began <w>dimly</w> to understand the complex situation she was in.",
                            "target_lang_translations": {
                                "ru": "Она начала <w>смутно</w> понимать сложную ситуацию, в которой оказалась."
                            }
                        }
                    ],
                    "synonyms": [
                        "faintly",
                        "vaguely",
                        "obscurely",
                        "shadowily"
                    ],
                    "antonyms": [
                        "brightly",
                        "clearly",
                        "distinctly",
                        "vividly"
                    ],
                    "common_phrases": [
                        "burn dimly",
                        "dimly lit",
                        "dimly remember",
                        "dimly understand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что не хватает света или ясности, что затрудняет восприятие или понимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тускло",
                                "target_lang_sense_clarification": "о слабом свете"
                            },
                            {
                                "target_lang_word": "смутно",
                                "target_lang_sense_clarification": "о воспоминаниях или понимании"
                            },
                            {
                                "target_lang_word": "слабо",
                                "target_lang_sense_clarification": "о проявлении признака или света"
                            },
                            {
                                "target_lang_word": "неясно",
                                "target_lang_sense_clarification": "о плохой видимости или понимании"
                            }
                        ]
                    }
                }
            ]
        }
    ]
