                        "entry_id": "17a6c6c0-41ec-33de-82fb-d72203246121",
                        "glosses": [
                            "present imperfective adverbial participle of говори́ть (govorítʹ): while speaking"
                        ],
                        "tags": [
                            "adverbial",
                            "form-of",
                            "imperfective",
