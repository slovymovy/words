                "senses": [
                    {
                        "sense_id": "53494401-f2b2-3b2e-91b8-454bd67220fa",
                        "entry_id": "12afa3b1-558a-3e4f-a7ec-6db591d48af0",
                        "glosses": [
                            "Dessous-de-plat."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "a0600239-7ef7-4d2d-960d-13eb26c6c185",
                                "sense_id": "53494401-f2b2-3b2e-91b8-454bd67220fa",
                                "text": "Le sous-plat modulable est devenu un classique et le cale porte avec sa poignée en cuir aussi."
                            },
                            {
                                "example_id": "f5ff8607-3632-4c45-bf12-f8a467f18d11",
                                "sense_id": "53494401-f2b2-3b2e-91b8-454bd67220fa",
                                "text": "L’élégance de cette cocotte ronde (3,6 litres) et de son sous-plat (23 cm) en fonte au motif de lys rendra votre table encore plus appétissante."
                            },
                            {
                                "example_id": "c456dc30-61a9-4e96-b460-a3d5f15e3c2b",
                                "sense_id": "53494401-f2b2-3b2e-91b8-454bd67220fa",
                                "text": "Il ne nous serait simplement pas donné de rester là, en pâmoison devant tous ces chefs-d’œuvre dont aucun mug, aucun sous-plat, aucun insta ne rendra jamais la profondeur, l’effervescence et l’émotion véritable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84ac24e0-368e-4392-ba08-ac4e71f1bac6",
                        "source_entry_id": "12afa3b1-558a-3e4f-a7ec-6db591d48af0",
