                "senses": [
                    {
                        "sense_id": "5ee012b2-998a-3d17-8155-7683fdf3d3da",
                        "entry_id": "8e2309f7-f857-3323-9440-a4a027cea585",
                        "glosses": [
                            "Serving to declare; having the quality of a declaration."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c6bd0a03-ac4a-3e5d-8df9-ac4c165c4f54",
                        "entry_id": "8e2309f7-f857-3323-9440-a4a027cea585",
                        "glosses": [
                            "Expressing truth."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5419c375-1ea8-4229-a671-fe67ebda58e5",
                                "sense_id": "c6bd0a03-ac4a-3e5d-8df9-ac4c165c4f54",
                                "text": "Palmer (1986:26–28) suggested that all languages have a clear way of indicating that the speaker is making a statement which (s)he believes to be true. Such statements are usually expressed by the declarative grammatical structure and the respective mood is called either \"declarative\" or \"indicative\"..."
                            }
                        ]
                    },
                    {
                        "sense_id": "94689606-5d38-3e95-a31e-ff487de08070",
                        "entry_id": "8e2309f7-f857-3323-9440-a4a027cea585",
                        "glosses": [
                            "That declares a construct."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4b013490-1821-3a43-b7e8-6e923b1dfaf8",
                        "entry_id": "8e2309f7-f857-3323-9440-a4a027cea585",
                        "glosses": [
                            "A way of programming that is most akin to just stating what is wanted, rather than having to describe how to do it. Declarative programming"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
