                    "sense_definition": "Wykrzyknienie używane dla potwierdzenia prawdziwości swoich słów lub złożenia obietnicy.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "promise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Słowo</w>, nie miałem pojęcia, że to spotkanie jest dzisiaj!",
                            "target_lang_translations": {
                                "ru": "Честное <w>слово</w>, я понятия не имел, что эта встреча сегодня!"
