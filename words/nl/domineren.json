{
    "word_family": [
        "dominant",
        "dominantie",
        "dominator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3b3a4c4f-2d3a-3018-97c4-76524df9fdfe",
                    "sense_definition": "macht of sterke invloed uitoefenen over anderen of over een situatie",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "overheersen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In deze relatie probeert hij de ander voortdurend te <w>domineren</w>.",
                            "target_lang_translations": {
                                "en": "In this relationship, he constantly tries to <w>dominate</w> the other person."
                            }
                        },
                        {
                            "text": "De grote bedrijven <w>domineren</w> de markt en laten weinig ruimte voor kleine ondernemers.",
                            "target_lang_translations": {
                                "en": "The large companies <w>dominate</w> the market and leave little room for small entrepreneurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "overheersen"
                    ],
                    "common_phrases": [
                        "de markt domineren",
                        "het gesprek domineren"
                    ],
                    "target_lang_definitions": {
                        "en": "to exercise power or strong influence over others or over a situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dominate",
                                "target_lang_sense_clarification": "to control or rule over"
                            },
                            {
                                "target_lang_word": "overpower",
                                "target_lang_sense_clarification": "to be much stronger than"
                            },
                            {
                                "target_lang_word": "rule",
                                "target_lang_sense_clarification": "to exercise authority over"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f6d548a-a8dd-3f57-a535-a0ded603f6be",
                    "sense_definition": "het meest opvallend of nadrukkelijk aanwezig zijn",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overheersen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kleur blauw <w>domineert</w> in het interieur van de nieuwe woonkamer.",
                            "target_lang_translations": {
                                "en": "The color blue <w>dominates</w> the interior of the new living room."
                            }
                        },
                        {
                            "text": "Het onderwerp van de verkiezingen <w>domineerde</w> de politieke discussie gedurende de hele avond.",
                            "target_lang_translations": {
                                "en": "The subject of the elections <w>dominated</w> the political discussion throughout the entire evening."
                            }
                        }
                    ],
                    "synonyms": [
                        "overheersen"
                    ],
                    "common_phrases": [
                        "de discussie domineren",
                        "het beeld domineren"
                    ],
                    "target_lang_definitions": {
                        "en": "to be the most prominent or emphatically present element"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dominate",
                                "target_lang_sense_clarification": "to be the most noticeable feature"
                            },
                            {
                                "target_lang_word": "prevail",
                                "target_lang_sense_clarification": "to be the most frequent or common"
                            },
                            {
                                "target_lang_word": "predominate",
                                "target_lang_sense_clarification": "to be the strongest or main element"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}