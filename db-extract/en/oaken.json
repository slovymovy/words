                                    {
                                        "sense_id": "2a37abf1-b0c4-351b-882e-c9b74d5542cb",
                                        "entry_id": "b09ed625-e993-3db4-bc30-0348c42e181e",
                                        "glosses": [
                                            "aus Eichenholz bestehend oder gemacht"
                                        ],
                                        "tags": [
                                            "attributiv"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75cddf58-52ec-4280-93d6-a293fd53155c",
                                                "sense_id": "2a37abf1-b0c4-351b-882e-c9b74d5542cb",
                                                "text": "„Im November 1771 bestellte der Wilhelmstein-Kommandant Major d’Etienne einen eichenen Kiel für den ‚Steinhuder Fisch‘, offensichtlich war der Bau nun befohlen worden.“"
                                            },
                                            {
                                                "example_id": "4da2e6be-c38a-44ee-bbff-8164948575cc",
                                                "sense_id": "2a37abf1-b0c4-351b-882e-c9b74d5542cb",
                                                "text": "„Er hatte immer nur an Betten, einen Klubsessel aus Leder und einen eichenen Diplomaten gedacht.“"
                                            },
                                            {
                                                "example_id": "85e3fb7a-a6f2-4438-8b8d-8bc5707d6c96",
                                                "sense_id": "2a37abf1-b0c4-351b-882e-c9b74d5542cb",
                                                "text": "„Jedes Boot bekam einen dreiundzwanzig Fuß langen Schlitten aus eisenbeschlagenen Kufen mit eichenen Querbalken und verlaschten Stützkeilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
