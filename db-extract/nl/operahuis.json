                "senses": [
                    {
                        "sense_id": "881ea6b3-56e0-3316-a14a-a92f611d4cd1",
                        "entry_id": "e985a695-2632-3e3d-9031-5176e5b66628",
                        "glosses": [
                            "een gebouw waarin opera's worden opgevoerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5a1093c-9002-436f-8b32-4c42cedd0c52",
                                "sense_id": "881ea6b3-56e0-3316-a14a-a92f611d4cd1",
                                "text": "Woensdagavond volgt een banket in het Operahuis in Oslo, dat wordt aangeboden door de Noorse regering. Koning Harald vierde in februari zijn tachtigste verjaardag al in familiekring, koningin Sonja hoopt in juli dit kroonjaar te bereiken."
                            },
                            {
                                "example_id": "ca2d39bc-57fb-41a9-8b51-40a459a8c404",
                                "sense_id": "881ea6b3-56e0-3316-a14a-a92f611d4cd1",
                                "text": "Als Pierre Audi (Beiroet, 1957) straks in juli voor het laatst de deur van zijn werkkamer achter zich sluit (misschien laat hij hem openstaan), doet hij dat als langstzittende artistiek directeur van een operahuis ter wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7086300a-8850-440b-b278-6f2151efefd9",
                        "source_entry_id": "e985a695-2632-3e3d-9031-5176e5b66628",
                        "source_sense_id": "881ea6b3-56e0-3316-a14a-a92f611d4cd1",
                        "source_sense_description": "een gebouw waarin opera's worden opgevoerd",
                        "target_lang_word": "Opernhaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Opernhaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc3eb8d1-676f-37f4-b9d7-457e8d9eba1a",
                                        "entry_id": "c62d53b8-12e3-39fb-9ea7-eb8d6cf9dd59",
                                        "glosses": [
                                            "Gebäude zur Aufführung von musikalisch und tänzerisch geprägten Theaterstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cbc8c84-5ba9-49ef-aa8a-bea364ea8199",
                                                "sense_id": "fc3eb8d1-676f-37f4-b9d7-457e8d9eba1a",
                                                "text": "„Der Eisberg an Steuerbord hat Ähnlichkeit mit dem Opernhaus von Sydney und ist bestimmt dreihundert Meter lang und einhundert Meter groß.“"
                                            },
                                            {
                                                "example_id": "184a3d4d-ecbf-46cd-88cc-6ebd9263dcbd",
                                                "sense_id": "fc3eb8d1-676f-37f4-b9d7-457e8d9eba1a",
                                                "text": "„Kurz vor sieben hielt die Droschke vor dem Opernhause, und der allezeit bereitstehende Wagenschlagöffner sagte mit der ihm eigenen und bei Glatteis und trockenem Wetter immer gleichklingenden Fürsorge: »Nehmen Sie sich in acht«.“"
                                            },
                                            {
                                                "example_id": "f3abf14d-70c8-49d4-8134-eb9f7e89b2b5",
                                                "sense_id": "fc3eb8d1-676f-37f4-b9d7-457e8d9eba1a",
                                                "text": "„In Schutt und Asche lagen die Wahrzeichen der Stadt, der Dom, das Schloss, die Universität, das Opernhaus, das Kneiphöfische Rathaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
