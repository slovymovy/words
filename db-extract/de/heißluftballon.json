                        "form": "die Heißluftballons"
                    },
                    {
                        "form_id": "700ec95a-cef4-4aad-9ea4-f7b3cd43f80c",
                        "entry_id": "9c4e5131-8319-3150-b986-a6f77a86de32",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Heißluftballone"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                        "entry_id": "9c4e5131-8319-3150-b986-a6f77a86de32",
                        "glosses": [
                            "als Luftfahrzeug verwendeter Ballon, bei dem der Auftrieb durch Aufheizen der in der Ballonhülle enthaltenen Luft mit Hilfe eines Gasbrenners erzeugt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e51f23a-6bb0-46df-aeb8-59a09a9ff55a",
                                "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                                "text": "„Ein Heißluftballon ist gestern Abend in der Innenstadt der deutschen Stadt Köln notgelandet.“"
                            },
                            {
                                "example_id": "a13450eb-b79f-4f31-8561-a714c8702031",
                                "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                                "text": "„Nach dem Absturz eines Heißluftballons in der Türkei ist eine dritte Touristin ihren schweren Verletzungen erlegen.“"
                            },
                            {
                                "example_id": "cc8347d0-ba53-4a2a-becd-2dd167b0feee",
                                "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                                "text": "2.607.500 US-Dollar, umgerechnet gut zwei Millionen Euro, kostet das exklusive Vergnügen, mit einem Heißluftballon über den höchsten Berg der Erde zu fahren. In gut 9000 Meter Höhe, mit Flaschensauerstoff, versteht sich."
                            },
                            {
                                "example_id": "04ff4d1e-1a85-4a01-883a-837723845888",
                                "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                                "text": "„Probanden ließen sich zum Beispiel bereitwillig weismachen, sie seien als Kind mal in einem Heißluftballon geflogen.“"
                            },
                            {
                                "example_id": "9794faa7-65a8-4b68-9b70-5d0b6a7c7722",
                                "sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
                                "text": "„Einen Heißluftballon erwarben französische Ballonfahrer für den Schnäppchenpreis von 6400 Euro - normalerweise kostet ein solches Fluggerät mehrere zehntausend Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d17dcbf4-bb51-46cc-b642-b75bd1930061",
                        "source_entry_id": "9c4e5131-8319-3150-b986-a6f77a86de32",
                        "source_sense_id": "5e7d3fc2-702b-3c8a-8f5b-7328cdcf589b",
