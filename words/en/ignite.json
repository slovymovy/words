                },
                {
                    "sense_id": "0ee1fc48-3359-3ee2-bb31-bec7e68e4942",
                    "sense_definition": "To trigger or spark a strong emotion, interest, or reaction in someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trigger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher's passionate lecture helped to <w>ignite</w> curiosity in the students.",
                            "target_lang_translations": {
                                "ru": "Страстная лекция учителя помогла <w>пробудить</w> любопытство у студентов."
                            }
                        },
                        {
                            "text": "Her speech was designed to <w>ignite</w> passion among the young voters.",
                            "target_lang_translations": {
                                "ru": "Ее речь была призвана <w>разжечь</w> страсть среди молодых избирателей."
                            }
