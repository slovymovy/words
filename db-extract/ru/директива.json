                                "target_senses": [
                                    {
                                        "sense_id": "6cf3e1e9-108e-3ae6-b723-7a1b0c99477c",
                                        "entry_id": "88169538-6174-3f65-b050-7f931ecb51a1",
                                        "glosses": [
                                            "That which directs; serving to direct, indicate, or guide."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84bdfd9a-ad00-4acd-ab3c-9b65674a9959",
                                                "sense_id": "6cf3e1e9-108e-3ae6-b723-7a1b0c99477c",
                                                "text": "A directive management style is stronger among owners with 'lifestyle' as a business objective than among those with business/economic objectives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc3ffa26-37ac-35a3-adf7-f43ae6751619",
                                        "entry_id": "88169538-6174-3f65-b050-7f931ecb51a1",
                                        "glosses": [
                                            "Relating to the directive case."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "directive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ab9235-d8be-3fd5-8ef5-a804e693ae55",
                                        "entry_id": "76c5fafe-c5fc-3ba0-94ed-954dcb02da92",
                                        "glosses": [
                                            "An instruction or guideline that indicates how to perform an action or reach a goal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c23f3ade-2f49-3106-b215-022cc33200be",
                                        "entry_id": "76c5fafe-c5fc-3ba0-94ed-954dcb02da92",
                                        "glosses": [
                                            "A construct in source code that indicates how it should be processed but is not necessarily part of the program to be run."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8cce4ffe-be5f-3db1-b82e-73daab2d5c27",
                                        "entry_id": "76c5fafe-c5fc-3ba0-94ed-954dcb02da92",
                                        "glosses": [
                                            "An authoritative decision from an official body, which may or may not have binding force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d320813-325c-3e0a-a55c-7724ac91b10e",
                                        "entry_id": "76c5fafe-c5fc-3ba0-94ed-954dcb02da92",
                                        "glosses": [
                                            "A form of legislative act addressed to the member states. The directive binds the member state to reach certain objectives in their national legislation."
                                        ],
                                        "tags": [
                                            "European-Union"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c3c4a3a-9d6c-300c-8933-bb2aaa031753",
                                        "entry_id": "76c5fafe-c5fc-3ba0-94ed-954dcb02da92",
                                        "glosses": [
                                            "The directive case."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5276ba8a-1c8f-49a3-a456-2a099a6cbdc0",
                        "source_entry_id": "dd5c439e-5169-36d9-9dea-6f894d58d4e0",
                        "target_lang_word": "instruction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instruction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "The act of instructing, teaching, or providing with information or knowledge."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f19e2308-8eff-4686-82ae-ec07d6e3a113",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Students receive instruction in the arts and sciences."
                                            },
                                            {
                                                "example_id": "c86c01d8-86af-4695-aea1-0e25a643c1cf",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Instruction will be provided on how to handle difficult customers."
                                            },
                                            {
                                                "example_id": "5b62af6c-5c82-44e4-b33b-3a50735d5110",
                                                "sense_id": "2bda2d9e-053d-3fec-8749-9c619ca9c091",
                                                "text": "Anstruther laughed good-naturedly. “[…] I shall take out half a dozen intelligent maistries from our Press and get them to give our villagers instruction when they begin work and when they are in the fields.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0633c6d0-59b2-32b8-8769-83fd26ceb30a",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "An instance of the information or knowledge so furnished."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1ca4972-f762-433d-99af-4a2e5f3697a1",
                                                "sense_id": "0633c6d0-59b2-32b8-8769-83fd26ceb30a",
                                                "text": "If my instructions may be your guide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ad274ad-95b5-3e25-a9cf-5f82c1393b02",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "An order or command."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0bd04fb-e5ab-4d58-961e-1122a1ce7c05",
                                                "sense_id": "8ad274ad-95b5-3e25-a9cf-5f82c1393b02",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9cc7fbb-1cd6-3a11-9689-2a40f318e7a8",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "A set of directions provided by a manufacturer for the users of a product or service."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "02a4c346-afd9-3cfe-ac49-24dc0e8cebe8",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "The directions given by a client to their lawyer in relation to a particular legal matter, which govern the purpose and scope of their work."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a4ed2b3-0b52-4c2e-a8ad-9b949dc64c7a",
                                                "sense_id": "02a4c346-afd9-3cfe-ac49-24dc0e8cebe8",
                                                "text": "I cannot act until I have taken instructions from my client."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61647c10-289e-3055-92db-f2d1462f018b",
                                        "entry_id": "14a601fa-9275-300e-90b4-ca3a762260d9",
                                        "glosses": [
                                            "A single operation of a processor defined by an instruction set architecture."
                                        ],
                                        "tags": [
