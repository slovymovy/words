                                        "entry_id": "a84e9dab-4b16-318a-bbff-8aee87b07333",
                                        "glosses": [
                                            "człowiek pracujący w branży filmowej"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
