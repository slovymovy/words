                "senses": [
                    {
                        "sense_id": "1cb3e9b1-493a-31d9-b92d-2fdcdcf14962",
                        "entry_id": "41349350-7e21-3ea0-944d-15f4c503e5dd",
                        "glosses": [
                            "erkende asiezoeker, erkende vluchteling volgens Rijksoverheid in Nederland."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33b7f62c-a895-4af3-8420-67b4cb96caa5",
                                "sense_id": "1cb3e9b1-493a-31d9-b92d-2fdcdcf14962",
                                "text": "Vlijt kenmerkt zijn aanpak van het aanleren van de Nederlandse taal. ,,YouTube is mijn vriend, mijn beste vriend. YouTube is een heel groot boek’’, betoogt statushouder Hasan Fakhane. Via die video’s verwerft hij zijn vocabulaire. Kleuren bijvoorbeeld kent hij dankzij een Irakees filmpje. Eén voor één verschijnen alle kleuren in beeld met de Arabische vertaling erbij."
                            },
                            {
                                "example_id": "586b1035-0122-4773-839e-4172fc4682e1",
                                "sense_id": "1cb3e9b1-493a-31d9-b92d-2fdcdcf14962",
                                "text": "Enschede moest in 2017 jaar bijvoorbeeld 212 statushouders huisvesten, maar kwam uit op 227. Een gemeente die niet verplichte minimale aantal statushouders huisvest, loopt het risico om voor huisvestingskosten, bijvoorbeeld in het azc, van niet geplaatste statushouders op te draaien."
                            },
                            {
                                "example_id": "914d0449-d031-49ff-b562-2dc0f0d11e52",
                                "sense_id": "1cb3e9b1-493a-31d9-b92d-2fdcdcf14962",
                                "text": "De tientallen initiatieven en projecten om statushouders aan werk te helpen leveren nog te weinig resultaat op. Duizenden asielzoekers dreigen daarom nog jarenlang in de bijstand te blijven hangen."
                            }
                        ]
                    }
