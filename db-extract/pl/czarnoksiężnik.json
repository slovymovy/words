                        "cross_references": [
                            {
                                "target_word": "brujo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a837e8e6-9998-3c70-a6ff-6bdd32a0bd29",
                                        "entry_id": "a3e25ecc-59f8-383f-b9d9-9250481cdcbc",
                                        "glosses": [
                                            "Varón que posee o al que se le adjudican poderes mágicos, especialmente de origen religioso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "612e5b78-7c24-4b19-a284-ff6afb939f39",
                                                "sense_id": "a837e8e6-9998-3c70-a6ff-6bdd32a0bd29",
                                                "text": "Acá en esta cuadra viven mil\nClavamos el tiempo en un cartel\nSomos como brujos del reloj\nNinguno parece envejecer"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
