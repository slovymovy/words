                        "glosses": [
                            "An expression, chiefly unfriendly, remarking disagreement with someone else's order of priorities; that someone takes the wrong action compared to something else, or in the wrong order. Get your priorities straight."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "986755e8-147e-41f3-89f7-03da47b021c0",
                                "sense_id": "55491021-0d98-3602-a0a8-91f19de99434",
                                "text": "The house was on fire, but Alex still insisted to complete that game before evacuating. Priorities."
                            },
                            {
                                "example_id": "9b4ebdc6-83c6-4f70-96f9-5094b719ee15",
                                "sense_id": "55491021-0d98-3602-a0a8-91f19de99434",
                                "text": "So you decided to buy a fancy teacup instead of paying rent? Well, I mean... priorities."
                            }
                        ]
                    }
