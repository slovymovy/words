{
    "word_family": [
        "staan",
        "aanstaand",
        "afstaan",
        "bijstaan",
        "ontstaan",
        "opstaan",
        "uitstaan",
        "bijstand",
        "toestand"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16816a3c-df8a-30f7-83b5-f700823583ae",
                    "sense_definition": "In werking zijn of ingeschakeld zijn, zoals bij elektrische apparaten of verlichting.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "werking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik zag dat het licht in de keuken nog <w>stond</w> <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "I saw that the light in the kitchen was still <w>on</w>.",
                                "ru": "Я заметил, что свет на кухне всё ещё <w>горел</w>."
                            }
                        },
                        {
                            "text": "Vergeet niet de verwarming uit te doen, want de kachel moet niet de hele nacht <w>aanstaan</w>.",
                            "target_lang_translations": {
                                "en": "Don't forget to turn off the heating, because the heater shouldn't <w>be on</w> all night.",
                                "ru": "Не забудь выключить отопление, потому что обогреватель не должен <w>работать</w> всю ночь."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de kachel laten aanstaan",
                        "het licht staat aan",
                        "de televisie laten aanstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be in operation or switched on, as with electrical appliances or lighting.",
                        "ru": "Быть включенным или находиться в рабочем состоянии (об электроприборах, освещении или отоплении)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be on",
                                "target_lang_sense_clarification": "of a device or light"
                            },
                            {
                                "target_lang_word": "be running",
                                "target_lang_sense_clarification": "of an engine or heater"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "быть включенным",
                                "target_lang_sense_clarification": "о приборе или свете"
                            },
                            {
                                "target_lang_word": "гореть",
                                "target_lang_sense_clarification": "о свете"
                            },
                            {
                                "target_lang_word": "работать",
                                "target_lang_sense_clarification": "о технике или отоплении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7474ed26-47ea-3cfd-a69a-de9552a1d2d5",
                    "sense_definition": "In de smaak vallen of een positieve indruk maken op iemand.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jouw brutale toon <w>staat</w> me helemaal niet <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "Your rude tone doesn't <w>please</w> me at all.",
                                "ru": "Твой дерзкий тон мне совсем не <w>нравится</w>."
                            }
                        },
                        {
                            "text": "De nieuwe plannen van de directie <w>stonden</w> de werknemers totaal niet <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The management's new plans didn't <w>suit</w> the employees at all.",
                                "ru": "Новые планы руководства совершенно не <w>устраивали</w> сотрудников."
                            }
                        }
                    ],
                    "synonyms": [
                        "behagen",
                        "bevallen"
                    ],
                    "antonyms": [
                        "mishagen",
                        "tegenstaan"
                    ],
                    "common_phrases": [
                        "iemand niet aanstaan",
                        "de toon staat aan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be to someone's liking or to make a positive impression on someone.",
                        "ru": "Нравиться кому-либо или производить положительное впечатление."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "please",
                                "target_lang_sense_clarification": "to satisfy or give pleasure to"
                            },
                            {
                                "target_lang_word": "suit",
                                "target_lang_sense_clarification": "to be acceptable or convenient"
                            },
                            {
                                "target_lang_word": "appeal to",
                                "target_lang_sense_clarification": "to be attractive or interesting"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "нравиться",
                                "target_lang_sense_clarification": "быть по вкусу"
                            },
                            {
                                "target_lang_word": "прийтись по душе",
                                "target_lang_sense_clarification": "понравиться"
                            },
                            {
                                "target_lang_word": "устраивать",
                                "target_lang_sense_clarification": "быть подходящим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ef177e6-7a4e-3feb-94c7-72b5c2cba523",
                    "sense_definition": "Een klein beetje geopend zijn, meestal gezegd van een deur of raam.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je de deur op een kier laten <w>aanstaan</w> voor de frisse lucht?",
                            "target_lang_translations": {
                                "en": "Can you leave the door <w>ajar</w> for some fresh air?",
                                "ru": "Можешь оставить дверь <w>приоткрытой</w> для свежего воздуха?"
                            }
                        },
                        {
                            "text": "Het raam <w>stond</w> de hele nacht <w>aan</w> waardoor het erg koud werd in de kamer.",
                            "target_lang_translations": {
                                "en": "The window was <w>ajar</w> all night, which made the room very cold.",
                                "ru": "Окно <w>было приоткрыто</w> всю ночь, из-за чего в комнате стало очень холодно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de deur laten aanstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To be slightly open, usually said of a door or window.",
                        "ru": "Быть слегка приоткрытым (обычно о двери или окне)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be ajar",
                                "target_lang_sense_clarification": "slightly open"
                            },
                            {
                                "target_lang_word": "be cracked open",
                                "target_lang_sense_clarification": "opened a tiny bit"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "быть приоткрытым",
                                "target_lang_sense_clarification": "о двери или окне"
                            },
                            {
                                "target_lang_word": "стоять настежь",
                                "target_lang_sense_clarification": "в значении 'оставаться открытым'"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}