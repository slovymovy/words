                                "target_lang_word": "yetkin",
                                "target_lang_sense_clarification": "gerekli bilgi ve beceriye sahip"
                            },
                            {
                                "target_lang_word": "yetenekli",
                                "target_lang_sense_clarification": "bir işi iyi yapabilen"
                            },
                            {
                                "target_lang_word": "kalifiye",
                                "target_lang_sense_clarification": "mesleki yeterliliği olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd61f9e6-3a60-3637-82bc-3e2574ba5155",
                    "sense_definition": "Having the legal jurisdiction or official authority to deal with a particular matter.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>competent</w> court shall be the Springfield Circuit Court for any disagreements arising from this contract.",
                            "target_lang_translations": {
                                "ru": "<w>Компетентным</w> судом для любых споров, возникающих из этого контракта, является окружной суд Спрингфилда.",
                                "tr": "Bu sözleşmeden doğabilecek her türlü anlaşmazlıkta <w>yetkili</w> mahkeme Springfield Bölge Mahkemesi olacaktır."
                            }
                        },
                        {
                            "text": "You must submit your application to the <w>competent</w> authority in your home country.",
                            "target_lang_translations": {
                                "ru": "Вы должны подать заявление в <w>соответствующий</w> орган в вашей стране.",
                                "tr": "Başvurunuzu kendi ülkenizdeki <w>yetkili</w> makama sunmalısınız."
                            }
                        }
