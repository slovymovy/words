                    {
                        "sense_id": "51b2d767-fde8-3da7-b7ea-237bb623d433",
                        "entry_id": "3c361122-10d9-3a45-9a5a-bf32fe31d886",
                        "glosses": [
                            "amtliche Bezeichnung eines Staatsbürgers von Nordmazedonien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1393e6-09a9-4e81-b281-9e573936c115",
                                "sense_id": "51b2d767-fde8-3da7-b7ea-237bb623d433",
                                "text": "Die Tür ging auf und der Mazedonier kam herein."
