                                    },
                                    {
                                        "sense_id": "e49266ce-04d1-35cd-9dd6-b9629032b9f3",
                                        "entry_id": "71b80d9c-caae-3ee2-893e-5a1019c7ba78",
                                        "glosses": [
                                            "To put in order; to sort; to tidy up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2723937-d48b-40e2-b95d-c1289b6ff688",
                                                "sense_id": "e49266ce-04d1-35cd-9dd6-b9629032b9f3",
                                                "text": "to straighten one's affairs, or an account"
                                            },
                                            {
                                                "example_id": "555a96cf-421f-4c51-9bea-c9fb488bc159",
                                                "sense_id": "e49266ce-04d1-35cd-9dd6-b9629032b9f3",
                                                "text": "Tuilagi and Ashton started in lively fashion, centre Tuilagi doing what he does best, straightening and bursting into the line, and Ashton always looking to leave his wing and get involved in the action."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed03a89d-ed35-307a-9987-f4737e03d6d8",
                                        "entry_id": "71b80d9c-caae-3ee2-893e-5a1019c7ba78",
                                        "glosses": [
                                            "To clarify a situation or concept to (an audience)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "265937f6-9306-3e9a-8b72-d9acfa0d8550",
                                        "entry_id": "71b80d9c-caae-3ee2-893e-5a1019c7ba78",
                                        "glosses": [
                                            "To bribe or corrupt."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "136dbeb5-6503-312b-983b-69b270f8abd7",
                                        "entry_id": "71b80d9c-caae-3ee2-893e-5a1019c7ba78",
                                        "glosses": [
                                            "To stand up, especially from a sitting position."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df2ecd8f-637f-37e3-8e36-80fae5a26142",
                                        "entry_id": "71b80d9c-caae-3ee2-893e-5a1019c7ba78",
                                        "glosses": [
                                            "To make heterosexual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "718c9941-e101-4289-afd0-533c068bdeaa",
                                                "sense_id": "df2ecd8f-637f-37e3-8e36-80fae5a26142",
                                                "text": "It has been said that to survive in this Wasp society, Blacks must straighten their hair, Jews must straighten their noses, and Gays must straighten themselves. But we will no longer tolerate being straightened. It is the doctors and the straight society who must change."
                                            },
                                            {
                                                "example_id": "a86af98b-e940-436e-9cf5-92bb0e1f8688",
                                                "sense_id": "df2ecd8f-637f-37e3-8e36-80fae5a26142",
                                                "text": "It raises the prospect that pregnant women could one day be offered a treatment to reduce or eliminate the chance that their offspring will be homosexual. Experts say that, in theory, the \"straightening\" procedure on humans could be as simple as a hormone supplement for mothers-to-be, worn on the skin like an anti-smoking nicotine patch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "015580bb-1281-446f-b5d3-ae06037f318e",
                        "source_entry_id": "66b72159-b355-3ad8-a0e0-250dc7620c1b",
                        "source_sense_description": "дёрнув вниз, поправить, привести в порядок одежду",
                        "target_lang_word": "straighten out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "straighten out",
