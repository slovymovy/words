                {
                    "sense_id": "b673c52d-c8b6-3b50-8073-388b950e76e0",
                    "sense_definition": "Een referentienummer of code op een document of in een administratie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vermeld bij betaling altijd het juiste <w>kenmerk</w>.",
                            "target_lang_translations": {
                                "ru": "При оплате всегда указывайте правильный <w>ссылочный номер</w>.",
                                "en": "Always state the correct <w>reference</w> when making a payment.",
                                "pl": "Przy dokonywaniu płatności należy zawsze podać właściwy <w>numer referencyjny</w>."
                            }
                        },
                        {
                            "text": "In de brief stond een <w>kenmerk</w> waarnaar ik moest verwijzen.",
                            "target_lang_translations": {
                                "ru": "В письме был указан <w>идентификатор</w>, на который мне нужно было сослаться.",
                                "en": "The letter contained a <w>reference</w> to which I had to refer.",
                                "pl": "W liście znajdowała się <w>sygnatura</w>, na którą musiałem się powołać."
                            }
                        }
                    ],
                    "synonyms": [
                        "referentienummer",
                        "referentie"
