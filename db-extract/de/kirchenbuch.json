                "senses": [
                    {
                        "sense_id": "0ce15fce-c2e8-3d9c-8fcb-8b80b0b9baa7",
                        "entry_id": "14729fc5-5be6-3a30-9581-14d051d69871",
                        "glosses": [
                            "chronologisches Verzeichnis über Ereignisse wie Taufe, Konfirmation/Firmung, Trauung und Tod/Beerdigung von Kirchenmitgliedern, das von der Pfarrgemeinde geführt wird"
                        ],
                        "tags": [
                            "Verwaltung",
                            "speziell Christentum"
                        ],
                        "examples": [
                            {
                                "example_id": "0e5574e7-18fe-4558-9d5c-7eedf9a80f7c",
                                "sense_id": "0ce15fce-c2e8-3d9c-8fcb-8b80b0b9baa7",
                                "text": "Der Pfarrer trug das Sterbedatum in das Kirchenbuch ein."
                            },
                            {
                                "example_id": "9edd22a7-c710-45b4-a993-343199340985",
                                "sense_id": "0ce15fce-c2e8-3d9c-8fcb-8b80b0b9baa7",
                                "text": "„Die Kirchenbücher von Groß Döbern verbrennt die Rote Armee.“"
                            },
                            {
                                "example_id": "55b33014-4ed8-4f82-9aa1-6071c291b44d",
                                "sense_id": "0ce15fce-c2e8-3d9c-8fcb-8b80b0b9baa7",
                                "text": "„Es ist kein einziges Kirchenbuch dabei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
