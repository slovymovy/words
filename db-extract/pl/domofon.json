                                    {
                                        "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                        "entry_id": "b4873ba0-71c3-32f3-8fc0-629a221d68f8",
                                        "glosses": [
                                            "elektrische Installation, die eine Sprechverbindung zwischen Innenräumen und Außentür des Hauses oder zwischen verschiedenen Räumen innerhalb einer Wohnung/eines Büros ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6494ea65-8511-4def-a3af-880bc273c2f8",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Für die damalige Zeit sei es eine sehr moderne und gut ausgestattete Wohnung gewesen, mit einer Sprechanlage und mit einem Müllschlucker.“"
                                            },
                                            {
                                                "example_id": "b3a86b72-1fec-492b-b8bf-a60b231ee7f2",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Die Stimme, die aus der Sprechanlage kam, klang reizend, wenn auch mit einem Unterton von Härte.“"
                                            },
                                            {
                                                "example_id": "453a9a8e-49c1-455a-a40b-94d1aac75a84",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Durch die Sprechanlage höre ich ein Auto vorbeifahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
