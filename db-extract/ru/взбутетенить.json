                "senses": [
                    {
                        "sense_id": "5cfee517-99c3-349e-a252-cde5c72bac4b",
                        "entry_id": "99af0153-363c-3aa1-b1d7-696d284f7e36",
                        "glosses": [
                            "устар., прост. сделать взбучку; высечь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca0c534e-40cd-4e9b-badb-47d2afefdc46",
                                "sense_id": "5cfee517-99c3-349e-a252-cde5c72bac4b",
                                "text": "Долго преследовал парень побитый // Барина бранью своей ядовитой: // «Мы-ста тебя взбутетеним дубьём // Вместе с горластым твоим холуём!»"
                            },
                            {
                                "example_id": "f8dc64e2-696b-4e5f-9f0f-53b03f818827",
                                "sense_id": "5cfee517-99c3-349e-a252-cde5c72bac4b",
                                "text": "Тавля наклонился… ― Взбутетень его! ― Взъерепень его!"
                            },
                            {
                                "example_id": "a9b0ce4c-1d8c-4edf-b453-2449f59a0f2f",
                                "sense_id": "5cfee517-99c3-349e-a252-cde5c72bac4b",
                                "text": "... и «глупейший рассказ» о капитане Копейкине, и слова «тюрюк», «взбутетенить» и пр."
                            }
                        ]
                    }
                ],
