                        "source_entry_id": "4a93f86d-42b5-3c03-8353-30e632712753",
                        "source_sense_id": "4dc05440-2329-3f1d-bb51-206245d869e4",
                        "source_sense_description": "Wissenschaftler, der sich damit beschäftigt, Meinungen der Bevölkerung zu erforschen",
                        "target_lang_word": "pollster",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
