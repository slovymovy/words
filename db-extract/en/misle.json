                    {
                        "sense_id": "7838c88a-5dba-36cb-85d5-69c8b6dc337f",
                        "entry_id": "7d952e62-9b49-33aa-9641-1a9526ffb7fa",
                        "glosses": [
                            "To rain in fine drops; to mizzle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d85850bf-c3d8-4e52-9efa-84b630a3c33e",
                                "sense_id": "7838c88a-5dba-36cb-85d5-69c8b6dc337f",
                                "text": "I know a woman of fashion, who is perpetually employed in remarks upon the weather, who observes from morning to noon, that it is likely to rain, and from noon to night, that it spits, that it misles, that it is set in for a wet evening; and, being incapable of any other discourse, is as insipid a companion and just as pedantic as he who quotes Aristotle over his tea, or talks Greek at a card-table."
                            }
                        ]
                    }
                ],
