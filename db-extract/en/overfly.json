                    }
                ],
                "senses": [
                    {
                        "sense_id": "7feb82e5-b311-3443-a3ab-a8a945223d23",
                        "entry_id": "2f5d17ac-e2ee-33db-828e-53ecf56fcba7",
                        "glosses": [
                            "To fly over something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44217590-1892-47fd-8a70-fd38d53e8a63",
                                "sense_id": "7feb82e5-b311-3443-a3ab-a8a945223d23",
                                "text": "My family planned to take pictures from the ground as I overflew them in the hot air balloon."
                            },
                            {
                                "example_id": "41c91f95-885d-44f1-ad57-176c9160d99a",
                                "sense_id": "7feb82e5-b311-3443-a3ab-a8a945223d23",
                                "text": "In the canopy, friendly birds (not the desperate, demented scavengers that sometimes overflew the plains) chirped and laboured on their nests."
                            }
                        ]
                    },
                    {
                        "sense_id": "004d4f8b-b85f-37e2-9e2a-2987df40331a",
                        "entry_id": "2f5d17ac-e2ee-33db-828e-53ecf56fcba7",
                        "glosses": [
                            "To fly too far past something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b27031b-ea78-449d-8b03-7efa449092ef",
                                "sense_id": "004d4f8b-b85f-37e2-9e2a-2987df40331a",
                                "text": "The small size of the airstrip meant that pilots would frequently overfly and have to circle back."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ccacc21-59ae-4bfb-a0df-072720fdf4b0",
                        "source_entry_id": "2f5d17ac-e2ee-33db-828e-53ecf56fcba7",
                        "source_sense_description": "fly over something",
                        "target_lang_word": "survoler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "survoler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "585088a8-e610-3cab-a6c5-3e9d2a1e6874",
                                        "entry_id": "bb353f1b-ee5c-35f0-a8cc-138b9ce1bf3d",
                                        "glosses": [
                                            "Voler par-dessus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15bb118a-c5c7-442a-858b-551bfbdbaa21",
                                                "sense_id": "585088a8-e610-3cab-a6c5-3e9d2a1e6874",
                                                "text": "À 11 heures, nous devons descendre au ras de la mer ; une masse nuageuse nous barre la route ; elle est beaucoup trop élevée pour être survolée."
                                            },
                                            {
                                                "example_id": "dc8dc697-8dfd-426a-9467-d6a263ce8a03",
                                                "sense_id": "585088a8-e610-3cab-a6c5-3e9d2a1e6874",
                                                "text": "Vers 15 heures, alors que le défilé de la débâcle continuait, un bruit d'avions inquiéta la population. Trois ou quatre chasseurs bombardiers survolaient la ville, et les habitants gagnèrent en hâte les abris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71632b5c-2925-3779-af08-55fe192ebc4e",
                                        "entry_id": "bb353f1b-ee5c-35f0-a8cc-138b9ce1bf3d",
                                        "glosses": [
                                            "Traiter rapidement et sommairement un sujet."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cec354e9-f06d-4193-922a-f1ef3b904fbb",
                                                "sense_id": "71632b5c-2925-3779-af08-55fe192ebc4e",
                                                "text": "Dans son discours, il n’a fait que survoler l’étude des causes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8583ada9-9df3-3240-885c-18bdcd84fa91",
                                        "entry_id": "bb353f1b-ee5c-35f0-a8cc-138b9ce1bf3d",
                                        "glosses": [
                                            "Lire un texte de façon rapide et superficielle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d2fa4797-f880-3297-957d-ce22ebf52973",
                                        "entry_id": "bb353f1b-ee5c-35f0-a8cc-138b9ce1bf3d",
                                        "glosses": [
                                            "Dominer fortement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9adb6ed0-2690-43c2-a919-d0d9b4163c0b",
                                                "sense_id": "d2fa4797-f880-3297-957d-ce22ebf52973",
                                                "text": "Quatre jours après avoir été sérieusement secoué d’emblée à Haïfa (Israël), le PSG a, cette fois, survolé l’entame du match à Décines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "217db53c-88c4-4a1c-8ef5-4214af994765",
                        "source_entry_id": "2f5d17ac-e2ee-33db-828e-53ecf56fcba7",
