                    ]
                },
                {
                    "sense_id": "5568a8e2-a509-33c6-aa9e-3218c91cc121",
                    "sense_definition": "Генеральный директор компании или организации.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "leader",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Наш <w>генерал</w> сегодня проводит важное совещание с инвесторами."
                        },
                        {
                            "text": "Все сотрудники боятся, когда <w>генерал</w> заходит в офис без предупреждения."
