                        ]
                    },
                    {
                        "translation_id": "5b568e16-d432-4e2e-9131-58e3b6e82774",
                        "source_entry_id": "ec676728-7bcd-3883-b69a-bb968ab128e7",
                        "source_sense_description": "country",
                        "target_lang_word": "Irak",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Irak",
