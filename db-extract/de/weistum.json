                        "entry_id": "eedce06e-5877-3799-927a-76dc5e4f0313",
                        "glosses": [
                            "Auskunft über rechtliche Fragen, die von rechtskundigen Männern erteilt wurde"
                        ],
                        "tags": [
                            "Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "ffd2aec5-00ea-402a-b3a6-7affeea0baa2",
                                "sense_id": "ae69c946-a1ac-3040-911b-cadd43a0c6f8",
                                "text": "Im Mittelalter wurde das Recht mündlich von Rechtskundigen überliefert und auf Gerichtstagen den anderen \"gewiesen\", von diesen übernommen und als Weistum weitergegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4509288f-c4b7-30d0-b27e-36be9f518100",
                        "entry_id": "eedce06e-5877-3799-927a-76dc5e4f0313",
                        "glosses": [
                            "schriftliche Aufzeichnungen zu Rechtsfragen, Rechtsgewohnheiten und -belehrungen"
                        ],
                        "tags": [
                            "Neuzeit"
                        ],
                        "examples": [
                            {
                                "example_id": "6302be90-1e9e-4618-8380-3aabf1895698",
                                "sense_id": "4509288f-c4b7-30d0-b27e-36be9f518100",
                                "text": "Im Laufe des ausgehenden Mittelalters oder in der frühen Neuzeit wurde das mündlich überlieferte Recht aufgeschrieben und somit konnte es auf den Gerichtstagen als Weistum vorgetragen werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
