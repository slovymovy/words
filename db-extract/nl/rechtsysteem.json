                        "glosses": [
                            "geheel van bindende regels, hun handhaving en opvattingen over rechtvaardigheid voor een samenleving of voor een zelfstandig deel daarvan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bacfdd23-402e-42b5-86cd-87001741359a",
                                "sense_id": "e8d8a30a-c088-3906-b1ef-4b782933df53",
                                "text": "Tot nu toe hebben vrijwel alle Europese landen verzoeken geweigerd wegens twijfel aan het Rwandese rechtsysteem."
                            },
                            {
                                "example_id": "5d39e1e8-a0cc-4d96-98f1-5986bd68d5db",
                                "sense_id": "e8d8a30a-c088-3906-b1ef-4b782933df53",
                                "text": "Ik noemde 'deze transpositie eenvoudig, niet alleen omdat zij de verbroken harmonie in het rechtsysteem herstelt, maar vooral ook, omdat wij bij de twee andere schrijvers, die hetzelfde onderwerp behandelen, volkomen denzelfden gedachtengang terugvinden, dien wij hier bij Ulpianus aantrefffen."
                            }
                        ]
                    }
