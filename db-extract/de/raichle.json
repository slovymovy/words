                ],
                "senses": [
                    {
                        "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                        "entry_id": "51b3c897-9214-3253-8a8f-2d84fe224f56",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74db9fa0-8081-4252-88ac-dac45efc026c",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Herr Raichle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ec69a2ed-cb1a-4f10-bef2-ef887280b5f5",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Die Raichles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3a0db084-9b45-4e85-b8c1-0b71922bd1af",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Frau Raichle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b273b31c-50ad-456b-bd98-5b1fa868dfeb",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Der Raichle trägt nie die Schals, die die Raichle ihm strickt."
                            },
                            {
                                "example_id": "7167f4cb-1a2c-482b-861b-7f16e1c0c037",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Raichle kommt, geht der Herr Raichle.“"
                            },
                            {
                                "example_id": "0279874f-aea5-4d18-97c1-221cba8f8efa",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Raichle kommt und geht."
                            },
                            {
                                "example_id": "d48f3562-a10c-461f-87b9-11fb36a4a1eb",
                                "sense_id": "3b927de8-5997-3cb3-b94f-d0a88cf18739",
                                "text": "Raichles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
