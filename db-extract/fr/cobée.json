                    {
                        "sense_id": "153b2e8a-5b77-371e-b774-b06982a847a4",
                        "entry_id": "5f200357-e07d-3941-bf65-2b443f1ac5e8",
                        "glosses": [
                            "Plante grimpante originaire du Mexique aux grandes fleurs bleues ou blanches (selon l’espèce) en forme de cloche, elle appartient au genre Cobaea, famille des Polémoniacées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75835839-ef96-4528-9e83-65b2547b1af2",
                                "sense_id": "153b2e8a-5b77-371e-b774-b06982a847a4",
                                "text": "Les cobées sont des arbrisseaux grimpants particuliers à l’Amérique tropicale."
                            },
                            {
                                "example_id": "fd0b7d45-d123-41b9-af91-30c68379c426",
                                "sense_id": "153b2e8a-5b77-371e-b774-b06982a847a4",
                                "text": "La maison est tapissée par une belle vigne et contre le mur de clôture s’élèvent des rosiers Crimson Rambler et de la cobée grimpante."
                            }
                        ]
                    }
                ],
