                        "examples": [
                            {
                                "example_id": "7285c750-16ef-403d-b25f-4f2ea53e63a2",
                                "sense_id": "56c8cbb1-9a21-324e-bd75-3bcd1f970469",
                                "text": "Op dezelfde manier kan een zenboeddhistische kom, waarvan vorm en ontwerp zinspelen op bescheidenheid, waardige eenvoud en welwillende aanvaarding van onvolmaaktheid, de aanschouwer terugbrengen naar de grondbeginselen van de zenleer."
                            },
                            {
                                "example_id": "9459a288-dd6e-485e-9916-a70deea1344a",
                                "sense_id": "56c8cbb1-9a21-324e-bd75-3bcd1f970469",
                                "text": "De dwaasheden van de emigrés heeft ons hiertoe gedwongen; en bij de aanvaarding was het noodzakelijk er geen twijfel aan te laten bestaan dat deze te goeder trouw was."
                            }
                        ]
                    }
                ],
