                        "form": "oursons"
                    },
                    {
                        "form_id": "d392d983-163c-4f85-a9c9-a99ce24dc35d",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "tags": [
                            "feminine"
                        ],
                        "form": "oursonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "491d2ec2-af03-3290-827d-ef5eecbae559",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "glosses": [
                            "Petit de l’ours ou jeune ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cdfdb03-103f-4851-8576-0c1749bda983",
                                "sense_id": "491d2ec2-af03-3290-827d-ef5eecbae559",
                                "text": "Les Aventures d’un ourson russe, par Slivitzki, est l’histoire d’un ourson nommé Michouk."
                            },
                            {
                                "example_id": "ea003c50-187d-4626-8bd4-47f9cf7c9044",
                                "sense_id": "491d2ec2-af03-3290-827d-ef5eecbae559",
                                "text": "Un ourson orphelin vient de faire un long trajet. La communauté atikamekw de Manawan qui l'avait adopté vient de le confier au refuge animal Cécropia de Saint-Alexis-des-Monts, en Mauricie."
                            },
                            {
                                "example_id": "1d815aba-2285-4f3a-a4c2-4cf80eee48e5",
                                "sense_id": "491d2ec2-af03-3290-827d-ef5eecbae559",
                                "text": "Cette année pourtant, des images du fantôme des montagnes ont été capturées à plusieurs reprises par les caméras automatiques de l’Office français de la biodiversité : d’abord la femelle Sorita et ses deux oursons en vallée d’Ossau, puis d’autres spécimens en Haute-Garonne ou en Ariège."
                            }
                        ]
                    },
                    {
                        "sense_id": "41a524b6-afd5-314d-97d4-502a1a4e6214",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "glosses": [
                            "Fourrure d’ours."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3fca5acb-1573-3312-9d77-7358e5226a41",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "glosses": [
                            "En chapellerie, variété de taupé à poil long évoquant la fourrure d’ours."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c2eb433f-657e-3da2-a6df-efe99903a5c4",
                        "entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "glosses": [
                            "Bonnet à poil."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd38f905-222c-45ac-bf43-d668f87728f6",
                        "source_entry_id": "8b7ea6b5-7bd0-392c-82da-70602573d4fe",
                        "source_sense_description": "Petit d’un ours",
                        "target_lang_word": "Bärenjunges",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärenjunges",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a06e88-eda8-3fd9-b0d1-217cb3caceda",
                                        "entry_id": "b2aef7d8-37c1-3264-a7ed-bea68f3f64ff",
                                        "glosses": [
                                            "Jungtier eines Bären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccf6bd2c-2ef9-4f1c-ab63-4322fa28a30d",
                                                "sense_id": "c3a06e88-eda8-3fd9-b0d1-217cb3caceda",
                                                "text": "„Auf einmal nahm er rechts im Dickicht eine Bewegung wahr. Reh oder Wolf? Bitte kein Bärenjunges. Shaw konnte schneller laufen als viele Tierarten. Eine wütende Schwarzbär-Mutter zählte vermutlich nicht dazu.“"
                                            },
                                            {
                                                "example_id": "eca056ef-a835-41ff-bdbe-a0efc5939331",
                                                "sense_id": "c3a06e88-eda8-3fd9-b0d1-217cb3caceda",
                                                "text": "„Sie packte die Sachen so methodisch in den Korb, dass auch noch Platz für ein Bärenjunges gewesen wäre, wenn sie eins hätte hineinsetzen wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
