            {
                "entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                "word": "farthing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "11a6b61c-3c60-46d5-bb4f-e3e8a0b84464",
                        "entry_id": "5af4021b-d376-3b46-a2cb-ace73ab4626a",
                        "tags": [
                            "plural"
