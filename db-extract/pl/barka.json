                "senses": [
                    {
                        "sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
                        "entry_id": "e15b6eb0-c15e-3a17-93ff-1ad174ff828e",
                        "glosses": [
                            "rodzaj statku o płaskim dnie, służącego do transportu ładunków zazwyczaj w żegludze śródlądowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c8dd5c3-0594-4157-bedf-b95bd771fe55",
                                "sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
                                "text": "Barka przewiozła urobek z pogłębiarki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49c27457-a5e2-4ade-9c84-4afd2c7e62fb",
                        "source_entry_id": "e15b6eb0-c15e-3a17-93ff-1ad174ff828e",
                        "source_sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
                        "target_lang_word": "bateau-mouche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bateau-mouche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8c8685b-1a4e-31e6-8dbe-8f2315cbeaef",
                                        "entry_id": "3bf57b0f-2b0a-36ef-b8aa-92ff667494c9",
                                        "glosses": [
                                            "Bateau de tourisme fluvial opérant à Paris et appartenant à la société « Compagnie des Bateaux Mouches »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30155c94-679b-44c8-9856-2183163df93a",
                                                "sense_id": "c8c8685b-1a4e-31e6-8dbe-8f2315cbeaef",
                                                "text": "Il ajouta, dans un rire plus fort, une vieille plaisanterie que tout le ministère trouvait délicieuse : — « Il ne faudrait pas les envoyer par eau inspecter la station navale du Point-du-Jour, ils seraient malades sur les bateaux-mouches. »"
                                            },
                                            {
                                                "example_id": "ab3d28f6-cce9-431f-a6cf-9e6d90589478",
                                                "sense_id": "c8c8685b-1a4e-31e6-8dbe-8f2315cbeaef",
                                                "text": "À cet instant, le bateau-mouche est apparu. Il glissait vers la pointe de l’île, sa guirlande de projecteurs braquée sur les maisons des quais."
                                            },
                                            {
                                                "example_id": "1bcf268d-a1ba-40e3-bac9-7ea8185e11c4",
                                                "sense_id": "c8c8685b-1a4e-31e6-8dbe-8f2315cbeaef",
                                                "text": "Les Parisiens ne prennent jamais les bateaux-mouches et peu d’entre eux sont montés un jour sur la tour Eiffel. Ou alors il y vont, obligés, quand ils reçoivent la visite de Léo, le cousin de province, pourvoyeur en mousseux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23bf8bb9-98a7-4653-bcf7-b5a80dc49434",
                        "source_entry_id": "e15b6eb0-c15e-3a17-93ff-1ad174ff828e",
                        "source_sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
                        "target_lang_word": "péniche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péniche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf6b0bae-26cf-38a1-9679-800badd396f2",
                                        "entry_id": "2b47edb5-e6a3-3516-b7ce-d6fae57878b6",
                                        "glosses": [
                                            "Bateau à fond plat destiné essentiellement aux transports par fleuves et canaux. Très longues, elles vont parfois par convois."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe51f6c6-2721-4d17-90c4-1e01e029b2c9",
                                                "sense_id": "bf6b0bae-26cf-38a1-9679-800badd396f2",
                                                "text": "Ils appréhendent le voyage à cent vingt dans la péniche, mais ils sont déterminés et ils se sont mis d’accord sur le fait que ce serait faisable, même s’ils vont être serrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc635430-d4af-3a8c-a5c9-53017904533c",
                                        "entry_id": "2b47edb5-e6a3-3516-b7ce-d6fae57878b6",
                                        "glosses": [
                                            "Chaussure un peu trop grande, dans laquelle on flotte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25294dad-21fc-4452-b0b7-2cfca7606961",
                                                "sense_id": "fc635430-d4af-3a8c-a5c9-53017904533c",
                                                "text": "Qu’on me rende mon Malcolm, sa voix grave, ses yeux bleus, ses péniches taille 44."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968ee877-8e3c-4510-876e-de3beee996c4",
                        "source_entry_id": "e15b6eb0-c15e-3a17-93ff-1ad174ff828e",
                        "source_sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
                        "target_lang_word": "barque",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barque",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Petit bateau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9b4b398-e528-4e69-bc66-7c249dc50a63",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Ayant acquis la preuve des relations qui existaient entre Césaire et les assiégeants, les habitants décidèrent de déposer l’évêque dans une barque et de le lâcher sur le Rhône."
                                            },
                                            {
                                                "example_id": "3abb9dd9-5aa5-4f7f-a630-fa080187e41b",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Pendant que sous la mer profonde\nLes cachalots et les requins\nCes écumeurs géants de l’onde\nLibres dévorent le fretin\nNous autres cloués à la rive\nOù la bourrasque a rejeté\nNotre barque un instant rétive\nNous pleurons notre liberté."
                                            },
                                            {
                                                "example_id": "c3eb3f87-eda0-4706-a1dc-d440e56332d9",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "À Mogador, nouvelle relâche, mais la barque envoyée à terre pour rapporter de l’eau fraîche faillit être capturée par les Arabes."
                                            },
                                            {
                                                "example_id": "3dad7d74-df26-4779-b142-b3fe8038bd26",
                                                "sense_id": "1080066c-594e-3709-a8c3-a3583fe7d462",
                                                "text": "Le Vieux-Port, où je me rappelle avoir vu naguère des rangées serrées de goélettes et de tartanes, le Vieux-Port n’est plus qu’un grand bassin des Tuileries où flotte, mais rigoureusement alignée, toute une poussière de yachts et de barques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8454fc6-cc9a-3b45-a3cd-4fb3a021a8ef",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Type de grand voilier dont tous les mâts, sauf celui situé à l’arrière, sont gréés à voiles carrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c4476ec-a6a9-47a0-92db-11c01c255ae6",
                                                "sense_id": "a8454fc6-cc9a-3b45-a3cd-4fb3a021a8ef",
                                                "text": "Le trois-mâts barque porte des voiles carrées uniquement au grand mât et au mât de misaine. C’est le plus répandu des gréements équipant la flotte marchande du XIXème siècle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a05dbed-3264-3d3b-84f2-efc7152cd64d",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Cette sorte de gréement."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b04667e4-f7bf-30aa-a8cf-b56d65ee41fd",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "La nacelle dans laquelle les anciens poètes supposaient qu’après la mort les âmes traversaient le Styx pour entrer dans les enfers."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cb1da38-cdde-4cfa-875d-51d18775ad39",
                                                "sense_id": "b04667e4-f7bf-30aa-a8cf-b56d65ee41fd",
                                                "text": "Dans la deuxième partie sont tous les coupables, qui s’empressent de passer le fleuve Achéron dans la barque du nautonier des Enfers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2cd41e8d-3c4c-3708-a12b-77dc20b2d125",
                                        "entry_id": "3538d59a-de19-3501-b2a5-24ad8e4da2ee",
                                        "glosses": [
                                            "Grande cuve métallique (parfois en bois) de forme parallélépipédique utilisée par les teinturiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76e6e7a6-9b7e-49f9-8935-7d5f236ed0ac",
                                                "sense_id": "2cd41e8d-3c4c-3708-a12b-77dc20b2d125",
                                                "text": "La teinture des tricots en pièce à haute température sur barque à tourniquet et sur machine à jet est comparée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9817ebf1-b25e-402e-a0df-7efa9e70f7a3",
                        "source_entry_id": "e15b6eb0-c15e-3a17-93ff-1ad174ff828e",
                        "source_sense_id": "3214c385-7be8-37a0-b72a-4edd70602961",
