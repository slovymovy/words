                "senses": [
                    {
                        "sense_id": "c3b67a8c-f497-3c87-a6e2-134f94104757",
                        "entry_id": "934eb4d8-6023-3cc7-92da-781523ddcc97",
                        "glosses": [
                            "aus Holz bestehender Gegenstand zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a368a06-e45c-4b68-9d33-2cdfee83ad7a",
                                "sense_id": "c3b67a8c-f497-3c87-a6e2-134f94104757",
                                "text": "„Eine Holzeisenbahn, wie überhaupt Holzspielzeug im Sand, ist wenig günstig, da es sich durch die häufige Berührung mit Wasser dehnt, reißt, der Lack oder die Farbe absplittert, die Räder an den Achsen reiben, die Unterseite fault. Kurzum, das stabilste Holzspielzeug geht unter diesen Umständen seinem baldigen Ende entgegen.“"
                            },
                            {
                                "example_id": "60feb1a6-d4ce-4128-8d76-9e467ef3ebc7",
                                "sense_id": "c3b67a8c-f497-3c87-a6e2-134f94104757",
                                "text": "„Die Kinder legten einander selbst gebasteltes Holzspielzeug auf den kargen Gabentisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
