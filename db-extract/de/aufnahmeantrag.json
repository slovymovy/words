                "senses": [
                    {
                        "sense_id": "ebaf3224-0eb0-3ceb-9900-800080fa8dfc",
                        "entry_id": "a20c26e8-d495-3728-8432-44bd5b77e239",
                        "glosses": [
                            "Beantragung der Mitgliedschaft in einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad39f4ed-287a-4126-83bc-f2652ed6a94e",
                                "sense_id": "ebaf3224-0eb0-3ceb-9900-800080fa8dfc",
                                "text": "„Eine Garantie dafür, dass diese Aufnahmeanträge vor Kriegsende bearbeitet würden, gab es nicht.“"
                            },
                            {
                                "example_id": "a78062fe-4985-445e-a5be-1ffda66d50c2",
                                "sense_id": "ebaf3224-0eb0-3ceb-9900-800080fa8dfc",
                                "text": "„Außerdem war in den nächsten Tagen die Musterungsaufforderung zur Bundeswehr zu erwarten, und vorher mußten die Aufnahmeanträge für verschiedene Universitäten ausgefüllt und abgesandt werden.“"
                            }
                        ],
