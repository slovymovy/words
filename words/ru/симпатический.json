    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "428989a3-f2bc-3ce5-a816-c1bb99b7093a",
                    "sense_definition": "относящийся к отделу вегетативной нервной системы, регулирующему деятельность внутренних органов и адаптацию к стрессу",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Во время сильного стресса <w>симпатическая</w> нервная система заставляет сердце биться быстрее."
                        },
                        {
                            "text": "Учёные подробно исследуют, как именно <w>симпатический</w> отдел мозга влияет на кровеносные сосуды."
                        }
                    ],
                    "common_phrases": [
                        "симпатическая нервная система",
                        "симпатический отдел"
                    ]
                },
                {
                    "sense_id": "3256a763-66ee-3d99-9105-ec06462d715b",
                    "sense_definition": "невидимый на бумаге и проявляющийся только при нагревании или химической обработке (о чернилах)",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для секретной переписки шпионы нередко использовали специальные <w>симпатические</w> чернила."
                        },
                        {
                            "text": "Текст, нанесённый <w>симпатическими</w> чернилами, проявился только после лёгкого нагревания бумаги над свечой."
                        }
                    ],
                    "synonyms": [
                        "невидимый"
                    ],
                    "common_phrases": [
                        "симпатические чернила"
                    ]
                },
                {
                    "sense_id": "1f33615b-42a5-3c5e-8574-63178f8db3a5",
                    "sense_definition": "вызывающий к себе симпатию, приятный, располагающий к себе; <w>симпатичный</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это был на редкость добрый человек с открытым и <w>симпатическим</w> взглядом."
                        },
                        {
                            "text": "В старом романе автор описывает героя как весьма <w>симпатического</w> и благородного юношу."
                        }
                    ],
                    "synonyms": [
                        "симпатичный"
                    ],
                    "common_phrases": [
                        "симпатическое лицо",
                        "симпатический взгляд"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "c639bdfd-78bb-3149-b3f4-7f76b9c9d349",
                    "sense_definition": "основанный на взаимном влечении, душевной близости, взаимопонимании",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Между давними друзьями всегда существовала особая, глубокая <w>симпатическая</w> связь."
                        },
                        {
                            "text": "Такая <w>симпатическая</w> привязанность между людьми возникает лишь при полном доверии."
                        }
                    ],
                    "synonyms": [
                        "сочувственный"
                    ],
                    "common_phrases": [
                        "симпатическая связь",
                        "симпатическая привязанность"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": ""
                        }
                    ]
                },
                {
                    "sense_id": "f8fbe667-4489-3754-9383-ac890d34c6e6",
                    "sense_definition": "отражённо возникающий в парном или соседнем органе при поражении другого",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medicine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При травме одного глаза у пациента возникло опасное <w>симпатическое</w> воспаление другого."
                        },
                        {
                            "text": "Врач внимательно следил за симптомами, чтобы вовремя предотвратить <w>симпатическое</w> поражение тканей."
