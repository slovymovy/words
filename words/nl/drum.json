            "senses": [
                {
                    "sense_id": "be53b64d-b8b4-3e82-ba4a-6727e10d2602",
                    "sense_definition": "Een trommel die deel uitmaakt van een drumstel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "muziekinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>drum</w> klonk erg hard tijdens het concert.",
                            "target_lang_translations": {
                                "en": "The <w>drum</w> sounded very loud during the concert."
                            }
                        },
                        {
                            "text": "Hij slaat met zijn stokken op de <w>drum</w>.",
                            "target_lang_translations": {
                                "en": "He hits the <w>drum</w> with his sticks."
                            }
                        }
                    ],
                    "synonyms": [
                        "trommel"
                    ],
                    "common_phrases": [
                        "op de drum slaan"
                    ],
                    "target_lang_definitions": {
                        "en": "A drum that is part of a drum kit."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drum",
                                "target_lang_sense_clarification": "musical instrument"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b962119-ef96-3c4b-885c-7db80565b0b4",
                    "sense_definition": "Een groot vat, vaak gebruikt voor vloeistoffen zoals olie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opslagvat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De olie werd opgeslagen in een grote metalen <w>drum</w>.",
                            "target_lang_translations": {
                                "en": "The oil was stored in a large metal <w>drum</w>."
                            }
                        },
                        {
                            "text": "Er lekte vloeistof uit de oude <w>drum</w> in de fabriek.",
                            "target_lang_translations": {
                                "en": "Liquid was leaking from the old <w>drum</w> in the factory."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A large container, often used for liquids such as oil."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drum",
