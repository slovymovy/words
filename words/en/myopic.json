{
    "word_family": [
        "myopia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                    "sense_definition": "Near-sighted; unable to see distant objects clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She brought the book very close to her <w>myopic</w> eyes to read the small print.",
                            "target_lang_translations": {
                                "zh": "她把书凑到那双<w>近视</w>的眼睛前，以便看清小字。"
                            }
                        },
                        {
                            "text": "A stronger prescription for <w>myopic</w> night drivers is often needed.",
                            "target_lang_translations": {
                                "zh": "夜间开车的<w>近视</w>司机通常需要度数更高的眼镜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "near-sighted",
                        "short-sighted"
                    ],
                    "antonyms": [
                        "hyperopic"
                    ],
                    "common_phrases": [
                        "myopic eyes"
                    ],
                    "target_lang_definitions": {
                        "zh": "近视的；无法看清远处物体的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "近视",
                                "target_lang_sense_clarification": "指视力状况，即只能看清近处物体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                    "sense_definition": "Lacking foresight; focused only on short-term results.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's <w>myopic</w> strategy ignored the long-term needs of the environment.",
                            "target_lang_translations": {
                                "zh": "这家公司<w>目光短浅</w>的策略忽视了环境的长期需求。"
                            }
                        },
                        {
                            "text": "His <w>myopic</w> obsession with profit led to the eventual collapse of the business.",
                            "target_lang_translations": {
                                "zh": "他<w>目光短浅</w>地沉迷于利润，最终导致了企业的倒闭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "short-sighted"
                    ],
                    "common_phrases": [
                        "myopic strategy",
                        "myopic obsession"
                    ],
                    "target_lang_definitions": {
                        "zh": "缺乏远见；只关注短期结果的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "目光短浅",
                                "target_lang_sense_clarification": "形容缺乏远见，只顾眼前利益。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                    "sense_definition": "Narrow-minded or lacking a broad perspective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perspective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientific advances can draw us outside of our <w>myopic</w> comfort zone.",
                            "target_lang_translations": {
                                "zh": "科学进步能将我们从<w>狭隘</w>的舒适区中拉出来。"
                            }
                        },
                        {
                            "text": "He refused to listen to other ideas because of his <w>myopic</w> opinion on the matter.",
                            "target_lang_translations": {
                                "zh": "由于他对这件事持有<w>狭隘</w>的看法，他拒绝听取其他意见。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "myopic opinion"
                    ],
                    "target_lang_definitions": {
                        "zh": "心胸狭窄或缺乏广阔视野的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "狭隘",
                                "target_lang_sense_clarification": "形容心胸或见识狭窄。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "946f17a9-30ff-34d8-9798-d2fcc5951b9d",
                    "sense_definition": "A person who is near-sighted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clinic specializes in treating <w>myopics</w> with advanced laser surgery.",
                            "target_lang_translations": {
                                "zh": "这家诊所专门用先进的激光手术治疗<w>近视者</w>。"
                            }
                        },
                        {
                            "text": "Many <w>myopics</w> rely on contact lenses to see the world clearly.",
                            "target_lang_translations": {
                                "zh": "许多<w>近视者</w>依靠隐形眼镜来清晰地看世界。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "近视的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "近视者",
                                "target_lang_sense_clarification": "指患有近视的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}