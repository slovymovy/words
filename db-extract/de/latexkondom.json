                ],
                "senses": [
                    {
                        "sense_id": "b649dbda-550d-3bc7-ae20-294f7e138d9a",
                        "entry_id": "fd4f1301-9552-3276-b44b-fd8b46dd9d8b",
                        "glosses": [
                            "aus Latex hergestelltes Präservativ"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fa0052a-d962-4d18-8de7-3e3dcd7dd19b",
                                "sense_id": "b649dbda-550d-3bc7-ae20-294f7e138d9a",
                                "text": "„Latexkondome sind für die meisten Paare die beste Wahl, weil sie höchst elastisch und für wenig Geld überall erhältlich sind.“"
                            },
                            {
                                "example_id": "6db38d98-a2e9-44fc-b771-c4e0ccc4540d",
                                "sense_id": "b649dbda-550d-3bc7-ae20-294f7e138d9a",
                                "text": "„Die Latexkondome sind dabei im Vorteil, weil sie im Vergleich zu Kondomen aus natürlichen Membranen keine Poren haben (Pinkerton und Abramson 1997, Drew et al . 1990).“"
                            },
                            {
                                "example_id": "2bca147f-79e3-4bed-ab2d-72edaa3150d1",
                                "sense_id": "b649dbda-550d-3bc7-ae20-294f7e138d9a",
                                "text": "„Ab 1870 fertigte man serienmäßig Gummi-, 1912 nahtlose und 1930 Latexkondome.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
