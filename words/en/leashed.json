            "senses": [
                {
                    "sense_id": "6202edee-729d-352b-ae1a-1551d10b221c",
                    "sense_definition": "Having or depicted with a leash, especially of a specified color in heraldry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldic_charge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coat of arms displayed a hound collared and <w>leashed</w> gules.",
                            "target_lang_translations": {
                                "ru": "На гербе была изображена гончая с ошейником и червлёным <w>поводком</w>."
                            }
                        },
                        {
                            "text": "Each supporter was a greyhound proper, <w>leashed</w> in azure along the flank.",
                            "target_lang_translations": {
                                "ru": "Каждым щитодержателем была натуральная борзая <w>с лазоревым поводком</w> вдоль бока."
                            }
                        }
                    ],
                    "target_lang_definitions": {
