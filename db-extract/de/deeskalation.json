                        "target_lang_word": "apaisement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apaisement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5bbda7e5-5f22-32c6-ae74-94f67af6359b",
                                        "entry_id": "74c24475-6438-3877-8d35-d8b826054831",
                                        "glosses": [
                                            "Action d’apaiser ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acd29bd0-8d2e-463a-8c5f-75012ffa10e7",
                                                "sense_id": "5bbda7e5-5f22-32c6-ae74-94f67af6359b",
                                                "text": "Mais il a aussi la propriété de diminuer le mouvement des vagues à la surface, ce qui explique l’apaisement des flots dans cette zone qui est une aire de repos pour les bateaux en difficulté."
                                            },
                                            {
                                                "example_id": "3ea4d643-ccc0-48b0-b235-e6fe4066c157",
                                                "sense_id": "5bbda7e5-5f22-32c6-ae74-94f67af6359b",
                                                "text": "Apaisement ! apaisement ! Hélas ! nous écoutera-t-on ?"
                                            },
                                            {
                                                "example_id": "bca3b3fd-7a78-4be3-9a93-f9a60643a84f",
                                                "sense_id": "5bbda7e5-5f22-32c6-ae74-94f67af6359b",
                                                "text": "Une loi peut être de combat ou dʼapaisement."
                                            },
                                            {
                                                "example_id": "04e93494-fba2-4646-9065-42aae9db48fe",
                                                "sense_id": "5bbda7e5-5f22-32c6-ae74-94f67af6359b",
                                                "text": "Les cycles infinis du désir cherchant la satisfaction pour goûter à l’apaisement, puis renaissant avec un autre désir, un autre cycle, sont l'essence même de la vie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
