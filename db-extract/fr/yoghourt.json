        "fr-extract.jsonl": [
            {
                "entry_id": "56e63bdb-adc5-3492-b91e-ce4968da86b6",
                "word": "yoghourt",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ba1b136a-8051-4e87-95ba-08f3fb171e30",
                        "entry_id": "56e63bdb-adc5-3492-b91e-ce4968da86b6",
                        "tags": [
