                                        "sense_id": "51e4a203-0e99-3ded-a075-f75c1f703ad9",
                                        "entry_id": "a75a861b-96e9-310d-aecf-1aa5afe08c45",
                                        "glosses": [
                                            "The condition or the characteristic quality of a bigot, especially religious, anti-religious or racial intolerant prejudice; opinionatedness; fanaticism; fanatic intolerance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa7572c-007c-4f24-b1f6-66c6ea5ed128",
                                                "sense_id": "51e4a203-0e99-3ded-a075-f75c1f703ad9",
                                                "text": "The remarkable resilience of the Ku Klux Klan is a sad reminder of the persistence of racial and religious bigotry in the United States. No terrorist organization can match the Klan's mystique or long history, and few can match its success."
                                            },
                                            {
                                                "example_id": "45422335-a9da-43bb-9261-8ea8593c502e",
                                                "sense_id": "51e4a203-0e99-3ded-a075-f75c1f703ad9",
                                                "text": "For boys like Battuta, white women — never mind fat, Jewish, non-deferential white women — were for fucking and throwing over. What one hates in whites — love of brown sugar — one must also hate when it turns up, inverted, in black. Bigotry is not only a function of power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "611d259f-d581-36fe-9a23-a5c8dcce69db",
                                        "entry_id": "a75a861b-96e9-310d-aecf-1aa5afe08c45",
                                        "glosses": [
                                            "Obstinate prejudice or opinionatedness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
