                        "entry_id": "5a0b3f18-2bd1-3633-81f3-271cbc25a88d",
                        "glosses": [
                            "powtarzalne zachowania o charakterze agresywnym jednego lub grupy sprawców wobec ofiary"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "4a57968c-2938-4f6b-bec4-66c8a78faf8f",
                                "sense_id": "3603eb55-3754-37a9-bf0a-9e8a1f1f83d2",
                                "text": "Sprawcami bullyingu zwykle są osoby impulsywne, dominujące, bez empatii, postrzegające pozytywnie przemoc, łaknące społecznego prestiżu, z wysoką samooceną"
                            },
                            {
                                "example_id": "d37864e4-75bc-43a2-bb45-25f308e9fab7",
                                "sense_id": "3603eb55-3754-37a9-bf0a-9e8a1f1f83d2",
                                "text": "O ile bullying w szkole jest zazwyczaj prymitywny, w pracy przybiera inne formy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
