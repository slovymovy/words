                                            {
                                                "example_id": "bccba48a-9626-4b4c-a05f-b8c0f240766f",
                                                "sense_id": "4a995b0d-a922-3d00-9d34-220c9254e2d3",
                                                "text": "Während meiner Schulzeit war die Klassenlehrerin meine einzige Verbündete."
                                            },
                                            {
                                                "example_id": "21b83058-44cb-4730-9499-85aed2082bec",
                                                "sense_id": "4a995b0d-a922-3d00-9d34-220c9254e2d3",
                                                "text": "„Eigentlich hatte ich gehofft, in Amalia eine Verbündete zu haben, die verstand, dass ich besser mit der Welt zurechtkam, wenn eine Schicht Papier zwischen uns lag.“"
                                            }
