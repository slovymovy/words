                "senses": [
                    {
                        "sense_id": "db44981a-11cb-3aac-a35f-73767eb98c78",
                        "entry_id": "21d3ccb1-1094-3cfc-8246-c473dae35f0a",
                        "glosses": [
                            "de zijde (van een berg, boot of gebouw) die van de wind af gekeerd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3051da62-d8dc-4fcc-88eb-cb8693b2231e",
                                "sense_id": "db44981a-11cb-3aac-a35f-73767eb98c78",
                                "text": "Als het sneeuwt, is het vaak maar weinig. Dat komt omdat stuwingsneerslag ontbreekt. Dat fenomeen wordt veroorzaakt nadat wolken tegen de loefzijde van een gebergte stuiten. De loefzijde ligt in de wind, de lijzijde in de luwte. Bij bergen of eilanden is de lijzijde vaak de droge zijde."
                            },
                            {
                                "example_id": "270dd496-6613-47ee-8878-62ccc64e07bc",
                                "sense_id": "db44981a-11cb-3aac-a35f-73767eb98c78",
                                "text": "Maar de belangrijkste regel is misschien wel: kijk tijdens het watersporten regelmatig achterom, zodat je niet ineens verrast wordt door een schip dat u dreigt te overvaren. En verder, aldus Jim Heilijgers: ,,Blijf vooral ook de lijzijde van je zeil in de gaten houden.´´"
                            }
                        ]
                    }
