                        ],
                        "form": "die Maskenpflicht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e15a88e6-45ee-34a6-96cc-91f4b07977fc",
                        "entry_id": "4e149ac9-3800-3fcc-a1ad-ed180686770e",
                        "glosses": [
                            "Vorschrift, Teile des Gesichts zu verhüllen, um eine Ansteckung zu vermeiden oder um nicht erkannt zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b384c95-6635-4aa6-8ec6-34ce0d6cc63b",
                                "sense_id": "e15a88e6-45ee-34a6-96cc-91f4b07977fc",
                                "text": "„Wie die meisten Redoutenreglements bestand auch die Ballordnung des Kölner Kurfürsten Maximilian Friedrich von 1776 auf der Maskenpflicht für alle Redoutenteilnehmer, deren Mißachtung streng geahndet wurde und von der nur die Personen seines Gefolges ausgenommen waren: […]“"
                            },
                            {
                                "example_id": "0b75ff75-7101-4d59-86a2-dd7ff4bb5ab7",
                                "sense_id": "e15a88e6-45ee-34a6-96cc-91f4b07977fc",
                                "text": "„Wenn Sie nur gegen die Maskenpflicht verstoßen hätten, könnte ich darüber hinwegsehen.“"
                            },
                            {
                                "example_id": "f292d555-7d62-4bd1-b746-69b1402a401a",
                                "sense_id": "e15a88e6-45ee-34a6-96cc-91f4b07977fc",
                                "text": "„Die Staatsinquisitoren überwachten die Einhaltung der Maskenpflicht gemäß dem Gesetz zur Moderation der Vergnügungen von 1508.“"
                            },
                            {
                                "example_id": "0a58bf1e-cfee-42e0-ad47-70c5d22c1dc1",
                                "sense_id": "e15a88e6-45ee-34a6-96cc-91f4b07977fc",
                                "text": "„Innensenator Andreas Geisel (SPD) äußerte sich skeptisch zu einer Maskenpflicht in der Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
