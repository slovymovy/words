                "senses": [
                    {
                        "sense_id": "b34905c1-7fba-36c3-9c90-7179a863dd5c",
                        "entry_id": "ef9d9c4a-d256-3a80-94dd-22cfc0aff990",
                        "glosses": [
                            "To cook with a showy technique where an alcoholic beverage, such as brandy, is added to hot food and then the fumes are ignited."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6572bbd-3582-4f3b-8979-1df06d04b138",
                                "sense_id": "b34905c1-7fba-36c3-9c90-7179a863dd5c",
                                "text": "“Flambé the dessert”, ordered the Chef, “but take the dish off the heat before adding the brandy or you'll burn your eyebrows off.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f8ef5c-94c9-44df-a866-994fa91087ee",
                        "source_entry_id": "ef9d9c4a-d256-3a80-94dd-22cfc0aff990",
                        "source_sense_id": "b34905c1-7fba-36c3-9c90-7179a863dd5c",
