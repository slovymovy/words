                        "entry_id": "8e80c5c3-dca4-3072-942e-203688d5b76f",
                        "glosses": [
                            "Proportion pour cent, mesurée en pour cent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe84b50-e508-490e-84ce-4926d3b11755",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Quel pourcentage exigez-vous dans cette affaire ?"
                            },
                            {
                                "example_id": "5cabcc80-3617-407d-a49d-4c4f09f4f277",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Le pourcentage des bénéfices."
                            },
                            {
                                "example_id": "98a49f02-86aa-498f-8386-18e9b978674d",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Le pourcentage des naissances est très bas cette semaine."
                            },
                            {
                                "example_id": "25c8753f-bf20-4d36-9d8f-b6125b58db40",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Établir un pourcentage."
                            },
                            {
                                "example_id": "c83efa7d-257e-4b78-84d9-38b8fed197eb",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Déterminer le pourcentage."
                            },
                            {
                                "example_id": "669712b7-04fa-4296-bd30-2a9226ec9699",
                                "sense_id": "4f109ab8-2c5e-3c5b-b153-4f2ef7ee0ea1",
                                "text": "Le taux de rejets ou de rebuts : mesure le pourcentage de produits rejetés ou de rebuts dans le processus de production."
                            }
                        ]
                    }
