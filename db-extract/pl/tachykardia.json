                "forms": [],
                "senses": [
                    {
                        "sense_id": "65b6272c-89d3-31ae-b430-d03e08c097dd",
                        "entry_id": "050044af-a6a6-3e78-9481-b45ab66977be",
                        "glosses": [
                            "szybka czynność rytmu serca"
                        ],
                        "tags": [],
