                    {
                        "sense_id": "4571da53-286b-3521-a9a8-fba32cfe9740",
                        "entry_id": "79c98a05-40bb-3eb7-8526-ff18877f97aa",
                        "glosses": [
                            "Sterben zahlreicher Arten in einem erdgeschichtlich relativ eng umgrenzten Zeitraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbe87f81-7719-4ce6-aea7-e5c92bde9f0c",
                                "sense_id": "4571da53-286b-3521-a9a8-fba32cfe9740",
                                "text": "Das bisher größte Artensterben auf der Erde hat vor circa 250 Millionen Jahren stattgefunden."
                            },
                            {
                                "example_id": "447727c0-5668-46b3-a475-88c20f832040",
                                "sense_id": "4571da53-286b-3521-a9a8-fba32cfe9740",
                                "text": "„Einer der Gründe für das Artensterben von Bienen und anderen Insekten und damit auch für den Verlust unserer Biodiversität ist der zunehmende Einsatz von Pestiziden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
