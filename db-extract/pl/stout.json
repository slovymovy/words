                        "translation_id": "60b1a961-aeb4-4be8-8971-17afb6939f9d",
                        "source_entry_id": "2f2a2ba8-f26b-3c2f-9690-c719f896707c",
                        "source_sense_id": "0319fef1-279b-3d23-b036-0c3fd13465b9",
