                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4ebda855-21ff-4426-8bf3-a17205fcdb71",
                                "sense_id": "8a2ca6d3-3877-3f5b-ba5c-6bfd746c68e4",
                                "text": "This is tops for a musical. Popular with the audience."
                            },
                            {
                                "example_id": "a936ec4d-f2f7-46a9-b7d7-0154e2742e5f",
                                "sense_id": "8a2ca6d3-3877-3f5b-ba5c-6bfd746c68e4",
                                "text": "Everyone who has ever eaten a torte loves it. It is tops in the dessert field."
                            },
                            {
                                "example_id": "dbebdd80-cd59-4a1c-923a-6b0c6a8525cf",
                                "sense_id": "8a2ca6d3-3877-3f5b-ba5c-6bfd746c68e4",
                                "text": "Joe Issenberg, Al Kahn, A. Amato and B. B. Saunders all agreed that it was tops for a meeting place."
                            },
                            {
                                "example_id": "2b5a6f70-c1b7-44a4-a9e8-0be4ea9b5b66",
                                "sense_id": "8a2ca6d3-3877-3f5b-ba5c-6bfd746c68e4",
                                "text": "But if you feel like sitting down for an evening of *cinema* (or just wanna put something on in the background that you can make out to) sexy movies are kinda tops."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
