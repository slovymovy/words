                "senses": [
                    {
                        "sense_id": "523a37a7-4910-3ed6-94bf-0e9f3e0dfd43",
                        "entry_id": "b221d982-4072-3cc3-9b71-94573a698fa5",
                        "glosses": [
                            "Kletterpflanze mit weißen duftenden Blüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63bf3085-3d24-493d-9aa5-fd1d28ce6102",
                                "sense_id": "523a37a7-4910-3ed6-94bf-0e9f3e0dfd43",
                                "text": "„Hinter dem Gewölbevorsprung der Brücke schwebten Leuchtkäfer, ein Geflirre unter der Nacht; im Wind lag ein berauschender Duft nach Geißblatt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf385953-3a62-481a-b542-bc3b4152a5af",
                        "source_entry_id": "b221d982-4072-3cc3-9b71-94573a698fa5",
                        "source_sense_id": "523a37a7-4910-3ed6-94bf-0e9f3e0dfd43",
                        "source_sense_description": "Kletterpflanze",
                        "target_lang_word": "honeysuckle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honeysuckle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95ba7cf8-a024-38bb-9fc5-64e62643d029",
                                        "entry_id": "eb0da0cd-cddb-337b-877a-9fb307e82404",
                                        "glosses": [
                                            "Any of the many species of arching shrubs and climbing vines of the genus Lonicera in the Caprifoliaceae family, many with sweet smelling, bell-shaped flowers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef51c9f8-3e8d-4ac2-907f-dd684936e05e",
                                                "sense_id": "95ba7cf8-a024-38bb-9fc5-64e62643d029",
                                                "text": "There was nothing of that luxuriance of blossom which had hitherto clothed the wood, for there were no hawthorns; but the bog-myrtle imparted its tender fragrance, and the caressing honeysuckle wound round many an ancient trunk, odours exhaling from every fairy-like tube—fit trumpets for the heralds of Titania."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0690e7a-e379-3c25-b10f-4a3646c30f29",
                                        "entry_id": "eb0da0cd-cddb-337b-877a-9fb307e82404",
                                        "glosses": [
                                            "Any of several species of superficially similar plants from Australia"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c3d94db-51ce-43a7-bf07-27fade0f0cc1",
                                                "sense_id": "c0690e7a-e379-3c25-b10f-4a3646c30f29",
                                                "text": "Bothered by the conviction of making no impression on her, he pulled up at a strip of road shaded by tall spotted gums, blackbutt, and honeysuckle, and produced a packet of cigarettes. \"About time for a smoke-O,\" he said, \"Have a fag, Cora.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8943afcf-727a-322b-8d9f-552602928d1a",
                                        "entry_id": "eb0da0cd-cddb-337b-877a-9fb307e82404",
                                        "glosses": [
                                            "Any of several species of superficially similar plants from Australia",
                                            "Banksia aquilonia (northern banksia)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34fb2370-22d4-385e-a205-76d525f9f49e",
                                        "entry_id": "eb0da0cd-cddb-337b-877a-9fb307e82404",
                                        "glosses": [
