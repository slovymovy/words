                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45f6ccde-fffa-4e25-8be0-3044777f6102",
                                "sense_id": "025bc9e7-2b87-3704-aabe-cc72e5fabeda",
                                "text": "Возрождение в целом и Высокое Возрождение в частности пыталось совместить духовность и телесность, вечность и посюсторонность."
                            }
                        ]
                    },
                    {
