                "entry_id": "df00bd0c-96e7-3a43-bad5-7877e0611348",
                "word": "racahout",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4e59af21-e6b4-3e51-9f35-2aac494b6c3c",
                        "entry_id": "df00bd0c-96e7-3a43-bad5-7877e0611348",
                        "glosses": [
                            "Poudre alimentaire composée entre autre de farine de riz et de gland, de fécule de pomme de terre, de cacao, de salep, de sucre, de vanille, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbeb4bf3-b1b1-4a7a-8430-ebd5fd16b4a6",
                                "sense_id": "4e59af21-e6b4-3e51-9f35-2aac494b6c3c",
                                "text": "Le racahout des Arabes est une marque déposé au XIXᵉ siècle par M. de Langrenier"
                            },
                            {
                                "example_id": "edff852d-eb5f-49f8-8451-c74b120c4068",
                                "sense_id": "4e59af21-e6b4-3e51-9f35-2aac494b6c3c",
                                "text": "Eaux de Vichy, de Seltz et de Barèges, robs dépuratifs, médecine Raspail, racahout des Arabes, pastilles Darcet, pâte Regnault"
                            },
                            {
                                "example_id": "414f6c22-d4dc-49cf-9447-55fe58a3b7e9",
                                "sense_id": "4e59af21-e6b4-3e51-9f35-2aac494b6c3c",
                                "text": "La célébrité toujours croissante du racahout des Arabes a éveillé partout la cupidité. Des individus sans probité essayent de le contrefaire avec des substances de vil prix, pour tenter le public par le bon marché, en vendant, sous le masque du nom de Racahout, des poudres insignifiantes, ou plutôt nuisibles à la santé."
                            }
                        ]
                    }
