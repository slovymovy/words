                "senses": [
                    {
                        "sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                        "entry_id": "ccb4d50e-4705-3188-8d70-3b6f03bc166f",
                        "glosses": [
                            "um jeden Preis, auf jeden Fall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f482d176-e143-47d7-8d34-75f30e0e6aee",
                                "sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                                "text": "Er will partout nicht mitkommen."
                            },
                            {
                                "example_id": "17f93dea-d830-49c4-9153-a80f9c8afa23",
                                "sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                                "text": "„Nur beim alten Zdulko fiel uns partout nichts ein, was ihn bewegte und am Leben hielt.“"
                            },
                            {
                                "example_id": "92ecd533-3f49-4961-bdb3-77039628f34a",
                                "sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                                "text": "„Und genau das ist es, was die Deutschen an sich selbst partout nicht charmant finden können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417234e3-7ad9-4c90-85e1-4bf9be7ef950",
                        "source_entry_id": "ccb4d50e-4705-3188-8d70-3b6f03bc166f",
                        "source_sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                        "source_sense_description": "um jeden Preis, auf jeden Fall",
                        "target_lang_word": "absolutely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "In an absolute or unconditional manner; utterly, positively, wholly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "Independently; viewed without relation to other things or factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c81a4da-f091-4ce0-a15a-9077506450cf",
                                                "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                                "text": "Another characteristic of numbers, which does not concern their mutual relations so much as themselves absolutely, is their ability, according to the ideas of Nicomachus, to conform to geometrical arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "As an intensive: extremely, very, indeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ebdec5-29be-4c20-868f-3073a912b06b",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "But when it came to posing for publicity pictures they proved absolutely brilliant doing just what came naturally."
                                            },
                                            {
                                                "example_id": "c38bfa8f-c587-4bcb-acca-4ede84befecf",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The strength of the mouse is absolutely spectacular for various kinds of issues, until you find out that the mouse has absolutely no extracellular matrix to speak of in his optic nerve head."
                                            },
                                            {
                                                "example_id": "a29e99e0-44ab-4143-98bb-d8995ba39d0f",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The most absolutely terrifying creature lifted her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                        "entry_id": "dafa4a83-cdd1-3e27-bd0c-eb0b7ac7b9bc",
                                        "glosses": [
                                            "Yes, certainly; expression indicating strong agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ac9752-fa44-4cd8-b952-dca657402b56",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Is Bob a good teacher?\nAbsolutely!"
                                            },
                                            {
                                                "example_id": "cd181f96-9d79-4997-b6f4-98a9933b0ae2",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Do you want a free cookie with that coffee?\nAbsolutely!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac712d6a-b434-4d01-9a58-37c6dc1cbcbe",
                        "source_entry_id": "ccb4d50e-4705-3188-8d70-3b6f03bc166f",
                        "source_sense_id": "d2ac7615-0aca-39d3-a972-3c478f7c2e7b",
                        "source_sense_description": "um jeden Preis, auf jeden Fall",
                        "target_lang_word": "à tout prix",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à tout prix",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a9ec9d8-17d9-38f6-99e8-1047395ebdfd",
                                        "entry_id": "1ed48d1c-1a15-3f2f-b917-1c8e330bb244",
                                        "glosses": [
                                            "Malgré tout."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dad3545-7e26-401c-94f2-a1441353e6cf",
                                                "sense_id": "3a9ec9d8-17d9-38f6-99e8-1047395ebdfd",
                                                "text": "Les adversaires de notre comte, voulant à tout prix avoir raison contre lui, exigeaient impérieusement qu’il interrompît les travaux de sa forteresse, et qu’il mît en liberté le Seigneur de Courville sans demander de rançon."
                                            },
                                            {
                                                "example_id": "81242fcf-ec97-4901-b4fc-ffdf0be1639e",
                                                "sense_id": "3a9ec9d8-17d9-38f6-99e8-1047395ebdfd",
                                                "text": "L’idéologisation médiatique de l’antitotalitarisme s'est développée autour d'une assimilation abusive de la défense de la démocratie avec la conservation à tout prix des démocraties libérales telles qu'elles sont, érigées en incarnation définitive du meilleur des régimes possibles."
                                            },
                                            {
                                                "example_id": "6c154b92-3446-4064-97f0-5730e259ec37",
                                                "sense_id": "3a9ec9d8-17d9-38f6-99e8-1047395ebdfd",
                                                "text": "C'était ma sœur tout craché : elle ne pouvait pas rester sérieuse. Il fallait à tout prix qu’elle désamorce les tensions avec des références de geek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef715446-cc99-3010-a874-f0f4ae8a8bdc",
                                        "entry_id": "1ed48d1c-1a15-3f2f-b917-1c8e330bb244",
                                        "glosses": [
                                            "Absolument ; sans faute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e42a7ebe-731f-4421-83c7-4f6e5ac2274f",
                                                "sense_id": "ef715446-cc99-3010-a874-f0f4ae8a8bdc",
                                                "text": "Le 58ᵉ bataillon de chasseurs marchait des Normands sur Petit-Ban, où il traversait des avant-postes de la division marocaine, puis sur Écordal. A 7 h. 30, il faisait demi-tour et retournait sur Les Normands, avec ordre d’attaquer Wignicourt et de s’en emparer « à tout prix »."
                                            },
                                            {
                                                "example_id": "c5ac190e-d4f9-44d0-9e09-4d22dbd222b6",
                                                "sense_id": "ef715446-cc99-3010-a874-f0f4ae8a8bdc",
                                                "text": "Gardez bien votre sens de la réalité et suivez votre instinct à tout prix."
                                            },
                                            {
                                                "example_id": "c8490d6e-ef81-446c-8c3a-07ad2a78b6ef",
                                                "sense_id": "ef715446-cc99-3010-a874-f0f4ae8a8bdc",
                                                "text": "Puisqu'il ne faut jamais mentir, alors il faut mentir de temps en temps : l'obligation d'être véridique à tout prix contraint à mentir quand la vérité elle-même est plus fallacieuse que le mensonge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
