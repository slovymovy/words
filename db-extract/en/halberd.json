                    },
                    {
                        "translation_id": "79198237-f81f-46fc-8d5b-24bda3747565",
                        "source_entry_id": "521ceda4-606a-34c6-a5e0-c9a3c5e70508",
                        "source_sense_id": "15e0551d-2884-3ba5-90c2-6482cc41e215",
                        "source_sense_description": "hand weapon",
                        "target_lang_word": "hallebarde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallebarde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                        "entry_id": "1b421098-2045-3b18-9f7f-f2bb1d73cfd2",
                                        "glosses": [
                                            "Arme d’hast garnie par en haut d’un fer long, large et pointu, traversé d’un autre fer en forme de croissant."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7047889d-10ca-4027-910e-ab2ecfa1c598",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "Bédouin, vêtu d’un pantalon de gendarme, d’un habit rouge, coiffé d’un bicorne et nanti de sa hallebarde de suisse, vint le prendre à son banc, et, de force, le contraignit à se mettre à genoux au milieu de la nef."
                                            },
                                            {
                                                "example_id": "8ebd8d1f-e8a7-4597-af82-37b4c61d7f0b",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "L’Officier. – Hors de là, canaille ! laissez passer la justice du duc, si vous n’aimez pas les coups de hallebardes."
                                            },
                                            {
                                                "example_id": "97a0bb66-9738-4875-a9c5-85e81f66eb65",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "Les Suisses avaient laissé leurs hallebardes et les dames d’honneur leurs petits ouvrages harponnés d’un crochet hâtif."
                                            },
                                            {
                                                "example_id": "28c81c7b-aeb5-4844-9316-2ca97d4df568",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "Le grincement des charnières et des essieux rouillés réveillèrent à l’autre bout de la ville le veilleur de nuit qui, soulevant sa hallebarde, s’écria à tue-tête : « Qui va là ? »"
                                            },
                                            {
                                                "example_id": "7037c968-3c0b-4c54-abb7-80871f39bd18",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "Elle ne signait pas en vain Nieuport-la-Noble ; elle ne portait pas pour rien sur son blason un lion lampassé issant d’une nef et brandissant une hallebarde."
                                            },
                                            {
                                                "example_id": "33ec6792-9ed6-4e1e-ae48-3f8f9bfcb33c",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "La foule était considérable. En tête, dans sa tenue d’apparat, coiffé d’un bicorne, hallebarde sur l’épaule, le bedeau ouvrait le ban."
                                            },
                                            {
                                                "example_id": "ac8659f3-5600-4db8-96b8-2bbbcc5a58cc",
                                                "sense_id": "6b118188-ee18-3562-b57a-da1404878c17",
                                                "text": "une grande image de saint Antoine élevée en pierre: après plusieurs propos scandaleux par eux tenus de ladite image par dérision l’armèrent d'un morion & d'une hallebarde, lui disant ces mots avec grands & exécrables blasphèmes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1dedf8f-4f56-3e5e-bc3e-d9a5b0dde509",
                                        "entry_id": "1b421098-2045-3b18-9f7f-f2bb1d73cfd2",
                                        "glosses": [
                                            "Meuble représentant l’arme du même nom dans les armoiries. À rapprocher de hast et ranseur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88454a88-2cb5-43b0-80ad-9ed879f2145a",
                                                "sense_id": "c1dedf8f-4f56-3e5e-bc3e-d9a5b0dde509",
                                                "text": "Parti : au 1ᵉʳ d’argent à la hallebarde d’or, le fût d’azur, au 2ᵉ coupé au I de gueules à deux haches d’armes d’argent passées en sautoir, au II d’azur au mur de ville d’argent ouvert du champ avec une tour à dextre crénelée et couverte d’argent, qui est de la commune de Longueil-Sainte-Marie de l’Oise → voir illustration « armoiries avec une hallebarde »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7be71818-1101-46db-ab85-015a91c13be2",
                        "source_entry_id": "521ceda4-606a-34c6-a5e0-c9a3c5e70508",
                        "source_sense_id": "15e0551d-2884-3ba5-90c2-6482cc41e215",
                        "source_sense_description": "hand weapon",
                        "target_lang_word": "Hellebarde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hellebarde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                        "entry_id": "2b708770-42f3-3c57-915c-480ea1be209d",
                                        "glosses": [
                                            "spätmittelalterlich bis frühneuzeitliche Hieb- und Stoßwaffe, die eine axtförmige Bartenklinge mit scharfer Spitze oder Knauf auf langem Stiel besitzt"
                                        ],
                                        "tags": [
                                            "Waffenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e287207-ff23-427c-b450-0eb4ba3bf033",
                                                "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                                "text": "Die Hellebarde gehört zur gebräuchlichen und altertümlichen Tracht der heutigen päpstlichen Garde."
                                            },
                                            {
                                                "example_id": "3991cba7-0949-4962-86cd-e63eaa69a809",
                                                "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                                "text": "„Der stellte seine Hellebarde beiseite und zeigte uns alte Siegel unter Glas.“"
                                            },
                                            {
                                                "example_id": "30b7c48c-c2ea-4f6d-9004-8a8a54b06ab5",
                                                "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                                "text": "„Am schnellsten war Zone B mit Briefmarken zu Ehren des 1. Mai, und als Motiv wählte man eine kräftige, jubelnde Frau neben dem Staatssymbol der Hellebarde.“"
                                            },
                                            {
                                                "example_id": "c968a297-9bb5-46f7-a376-a2742633aebd",
                                                "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                                "text": "„Acht oder zehn Minuten später sah ich eine große Schar Bauern mit Gewehren, Gabeln oder langen Hellebarden den Berg herunterkommen.“"
                                            },
                                            {
                                                "example_id": "847f2869-b1a5-4f02-b5f4-e08b3c09726e",
                                                "sense_id": "c176e532-9747-3784-94e1-f134b2eed532",
                                                "text": "„Diese etwas über zwei Meter langen Hellebarden mit Stoßspitzen und Beilen und Haken an den Seiten werden von kampferfahrenen, den sogenannten ›probierten Knechten‹ geführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
