                                                "example_id": "dc9e4065-de49-4dde-9e46-b23e6f2baae0",
                                                "sense_id": "0b341fc4-78ab-343b-8781-14c1199a4239",
                                                "text": "A motion sensor detected movement in the empty room."
                                            }
