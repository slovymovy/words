        "fr-extract.jsonl": [
            {
                "entry_id": "d1db7d5e-6d14-3f25-a59e-e667042cec38",
                "word": "radiotélescope",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "180186c0-5bc0-44c6-b836-1f0a1725bb6b",
                        "entry_id": "d1db7d5e-6d14-3f25-a59e-e667042cec38",
                        "tags": [
                            "plural"
                        ],
                        "form": "radiotélescopes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f79cc1b1-484e-3a12-bdde-271d62f8e281",
                        "entry_id": "d1db7d5e-6d14-3f25-a59e-e667042cec38",
                        "glosses": [
                            "Antenne radio directionnelle utilisée en radioastronomie pour capter le signal radio des satellites ou issu de l’espace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4d32589-ac0a-4d78-9360-e10833680b16",
                                "sense_id": "f79cc1b1-484e-3a12-bdde-271d62f8e281",
                                "text": "Depuis 40 ans, le programme SETI (Search for Extraterrestrial Intelligence), s’appuyant sur les données d’une panoplie d’immenses radiotélescopes, n’a pu décrypter aucun message de source interstellaire."
                            },
                            {
                                "example_id": "0d869df7-1a58-4b68-849b-a295d2ba7e7c",
                                "sense_id": "f79cc1b1-484e-3a12-bdde-271d62f8e281",
                                "text": "Le radiotélescope géant d'Arecibo, situé sur l'île de Porto Rico dans les Caraïbes, s'est effondré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f38d9a55-2eb6-44bf-8847-7c07510f5925",
                        "source_entry_id": "d1db7d5e-6d14-3f25-a59e-e667042cec38",
                        "source_sense_id": "f79cc1b1-484e-3a12-bdde-271d62f8e281",
                        "source_sense_description": "antenne radio",
                        "target_lang_word": "Radioteleskop",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radioteleskop",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9916305-f7af-3985-9d49-89a4a1cdb925",
                                        "entry_id": "14ea2f2f-ac77-35f6-bdfb-ecffc117de83",
                                        "glosses": [
                                            "Messgerät, mit dem astronomische Objekte beobachtet werden, die elektromagnetische Wellen im Spektralbereich der Radiowellen ausstrahlen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f021e3d6-2cfa-4bd4-963f-ef9d91e46bc7",
                                                "sense_id": "f9916305-f7af-3985-9d49-89a4a1cdb925",
                                                "text": "„Über die gesamte Erde verteilte Radioteleskope können gleichzeitig dieselbe Quelle beobachten.“"
                                            },
                                            {
                                                "example_id": "7316c668-7325-493b-964d-b8ad275bbda1",
                                                "sense_id": "f9916305-f7af-3985-9d49-89a4a1cdb925",
                                                "text": "„Eine alternative Methode, den Weltraum zu erforschen, ist die Himmelsbeobachtung durch Radioteleskope.“"
                                            },
                                            {
                                                "example_id": "af1a613c-aa6b-4c81-8fce-1a0e6500dbd7",
                                                "sense_id": "f9916305-f7af-3985-9d49-89a4a1cdb925",
                                                "text": "„Das mit am einfachsten zu beobachtende Molekül ist Kohlenmonoxid (CO), dessen Spektrallinien mit Radioteleskopen nachgewiesen werden können.“"
                                            },
                                            {
                                                "example_id": "b5b4fb20-4efc-4fbf-8171-d432fc94d529",
                                                "sense_id": "f9916305-f7af-3985-9d49-89a4a1cdb925",
                                                "text": "„In Südafrika ist das bisher größte und stärkste Radioteleskop der südlichen Hemisphäre in Betrieb genommen worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
