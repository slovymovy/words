                ],
                "senses": [
                    {
                        "sense_id": "9686fb83-4aab-30aa-8fb8-36aee755be6f",
                        "entry_id": "81578443-060c-32dc-a76e-725c931cf9eb",
                        "glosses": [
                            "Beseitigung eines Fehlers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4eb55749-9eae-4b35-83d5-479b7f809568",
                                "sense_id": "9686fb83-4aab-30aa-8fb8-36aee755be6f",
                                "text": "„Eine Software, deren Code unsystematisch und wenig dokumentiert ist, funktioniert zwar zunächst genauso gut. Geht es jedoch an die Weiterentwicklung oder Fehlerbehebung, kann auch ein geübter Programmierer Probleme haben, Zweck und Funktionsweise dieses Codes zu verstehen. Ästhetik ist dann nicht mehr eine Frage des guten Tons oder gar die Abkehr vom schnellen Arbeiten, sondern Voraussetzung für ein optimales Ergebnis.“"
                            },
                            {
                                "example_id": "391a365c-0337-4af8-8525-d3601cef6aa2",
                                "sense_id": "9686fb83-4aab-30aa-8fb8-36aee755be6f",
                                "text": "„Durch lokale Unterstützung in der Benutzer-Betreuung kann T-Systems rasche Fehlerbehebung und effizientes Change Management gewährleisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
