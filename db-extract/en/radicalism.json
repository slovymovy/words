                    {
                        "translation_id": "f5b82e70-9d96-43c4-9cb9-37e6d42e889b",
                        "source_entry_id": "cf27bfef-8a55-305b-bb70-b4b3e32ac4b0",
                        "source_sense_id": "d966d3be-8ea3-3ca5-ba79-50828cf9e0e6",
                        "source_sense_description": "Translations",
                        "target_lang_word": "radicalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radicalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85ef1f66-db34-3822-a896-d68143052406",
                                        "entry_id": "fa9f6f8a-67cb-3879-a287-104f6d6b7d2c",
                                        "glosses": [
                                            "Système des radicaux, parti des radicaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3dbeba-8bd5-4051-bfc0-24128cce559f",
                                                "sense_id": "85ef1f66-db34-3822-a896-d68143052406",
                                                "text": "Son adresse aux électeurs, et le discours qu’il a prononcé après sa nomination, nous montrent en lui le défenseur du radicalisme le plus pur, le plus effrayant."
                                            },
                                            {
                                                "example_id": "84b28823-8b2b-4ef4-9698-d9c0a3d761f9",
                                                "sense_id": "85ef1f66-db34-3822-a896-d68143052406",
                                                "text": "La bourgeoisie a encouragé le développement de cette littérature niaise et démoralisante ; elle occupe l’esprit populaire, l’endort et le détourne, ainsi que les chinoiseries politiques du radicalisme, de l’étude de ses véritables intérêts de classe."
                                            },
                                            {
                                                "example_id": "51709849-7ce6-437e-b15c-853eeb808de3",
                                                "sense_id": "85ef1f66-db34-3822-a896-d68143052406",
                                                "text": "Les grands hommes du socialisme ont toujours poursuivi, poursuivront toujours un rêve : absorber le radicalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e888a99-f795-4b86-866a-ad902f103875",
                        "source_entry_id": "cf27bfef-8a55-305b-bb70-b4b3e32ac4b0",
                        "source_sense_id": "d966d3be-8ea3-3ca5-ba79-50828cf9e0e6",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Radikalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radikalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6c21b8a3-29ae-3579-9871-ecb7d7da174a",
                                        "entry_id": "1714b45e-e91c-3b33-b3f1-3b42d2f74eee",
                                        "glosses": [
                                            "radikale Einstellung, rigorose Denk- und Handlungsweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7f20865-74b9-465c-9c31-16a6f3343c0d",
                                                "sense_id": "6c21b8a3-29ae-3579-9871-ecb7d7da174a",
                                                "text": "„Er war ein Vertreter des freisinnigen Radikalismus und galt als ehrgeizige Persönlichkeit mit autoritären Zügen.“"
                                            },
                                            {
                                                "example_id": "caaf20e5-5d2c-41fd-898e-b579df45487d",
                                                "sense_id": "6c21b8a3-29ae-3579-9871-ecb7d7da174a",
                                                "text": "„Der denkerische Radikalismus, die erotischen Phantasieexzesse, das Studieren und Lesen, die oben erwähnte normale Hervorbringung werden zyklisch gewechselt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "503e3bbc-dce4-3508-a3bc-b7cb3af22af5",
                                        "entry_id": "1714b45e-e91c-3b33-b3f1-3b42d2f74eee",
                                        "glosses": [
                                            "radikale weltanschauliche Gesinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f871bae8-c148-421a-91c0-d89a758f0fd4",
                                                "sense_id": "503e3bbc-dce4-3508-a3bc-b7cb3af22af5",
                                                "text": "Der Demonstration gegen Fremdenfeindlichkeit und Radikalismus folgten über zehntausend Teilnehmer."
                                            },
                                            {
                                                "example_id": "4cb7a34a-9b46-4f0e-b35e-61549c7aa57d",
                                                "sense_id": "503e3bbc-dce4-3508-a3bc-b7cb3af22af5",
                                                "text": "„Das [Mittel des parlamentarischen Kampfes] sei [in diesem Fall] der einzig mögliche Weg, jeder andere werde in wildem Radikalismus und Anarchismus enden“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
