{
    "word_family": [
        "mock",
        "mocker",
        "mockery"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3320c23-54f8-3d0d-99fc-5a2f02873b64",
                    "sense_definition": "Expressing contempt or ridicule toward someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a <w>mocking</w> smile when I told him about my mistake.",
                            "target_lang_translations": {
                                "nl": "Hij gaf een <w>spottende</w> glimlach toen ik hem over mijn fout vertelde.",
                                "de": "Er zeigte ein <w>spöttisches</w> Lächeln, als ich ihm von meinem Fehler erzählte."
                            }
                        },
                        {
                            "text": "The critic wrote a <w>mocking</w> review of the new play.",
                            "target_lang_translations": {
                                "nl": "De recensent schreef een <w>smalende</w> recensie over het nieuwe toneelstuk.",
                                "de": "Der Kritiker schrieb eine <w>höhnische</w> Rezension über das neue Theaterstück."
                            }
                        }
                    ],
                    "synonyms": [
                        "derisive",
                        "scornful",
                        "contemptuous"
                    ],
                    "antonyms": [
                        "respectful",
                        "admiring"
                    ],
                    "common_phrases": [
                        "mocking tone",
                        "mocking smile"
                    ],
                    "target_lang_definitions": {
                        "nl": "Het uiten van minachting of spot naar iemand of iets toe.",
                        "de": "Ausdruck von Verachtung oder Spott gegenüber jemandem oder etwas."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spottend",
                                "target_lang_sense_clarification": "met een toon van minachting of spot"
                            },
                            {
                                "target_lang_word": "smalend",
                                "target_lang_sense_clarification": "met een bittere of minachtende ondertoon"
                            },
                            {
                                "target_lang_word": "hoonlachend",
                                "target_lang_sense_clarification": "met een lach die minachting uitdrukt"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "spöttisch",
                                "target_lang_sense_clarification": "mit einer Haltung von Spott oder Verachtung"
                            },
                            {
                                "target_lang_word": "höhnisch",
                                "target_lang_sense_clarification": "mit einer bitteren, verächtlichen Note"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e83bd96f-df21-3bb1-aee2-94e47ef44323",
                    "sense_definition": "Playfully teasing or taunting in a way that is not necessarily malicious.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children shared a <w>mocking</w> laugh while playing tag in the park.",
                            "target_lang_translations": {
                                "nl": "De kinderen lachten <w>plagerig</w> terwijl ze tikkertje speelden in het park.",
                                "de": "Die Kinder lachten <w>scherzhaft</w>, während sie im Park Fangen spielten."
                            }
                        },
                        {
                            "text": "She ignored his <w>mocking</w> comments because she knew he was just joking.",
                            "target_lang_translations": {
                                "nl": "Ze negeerde zijn <w>plagerige</w> opmerkingen omdat ze wist dat hij maar een grapje maakte.",
                                "de": "Sie ignorierte seine <w>plänkelnden</w> Kommentare, weil sie wusste, dass er nur scherzte."
                            }
                        }
                    ],
                    "synonyms": [
                        "teasing",
                        "playful"
                    ],
                    "common_phrases": [
                        "mocking laugh",
                        "mocking laughter"
                    ],
                    "target_lang_definitions": {
                        "nl": "Speels plagen of uitdagen op een manier die niet per se kwaadaardig is.",
                        "de": "Spielerisches Necken oder Herausfordern, das nicht unbedingt böswillig gemeint ist."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "plagerig",
                                "target_lang_sense_clarification": "op een speelse, niet-serieuze manier"
                            },
                            {
                                "target_lang_word": "schertsend",
                                "target_lang_sense_clarification": "grapjes makend, niet serieus bedoeld"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "plänkelnd",
                                "target_lang_sense_clarification": "auf eine spielerische, nicht ernsthafte Weise"
                            },
                            {
                                "target_lang_word": "scherzhaft",
                                "target_lang_sense_clarification": "nicht ernst gemeint, zum Spaß"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8954d455-f272-3660-a3e6-cdcaafb8ecf9",
                    "sense_definition": "The act of ridiculing or making fun of someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ridicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>mocking</w> from his classmates made him feel very isolated.",
                            "target_lang_translations": {
                                "nl": "De constante <w>bespotting</w> door zijn klasgenoten zorgde ervoor dat hij zich erg geïsoleerd voelde.",
                                "de": "Die ständige <w>Verspottung</w> durch seine Klassenkameraden ließ ihn sich sehr isoliert fühlen."
                            }
                        },
                        {
                            "text": "She could not stand the cruel <w>mocking</w> directed at her during the meeting.",
                            "target_lang_translations": {
                                "nl": "Ze kon de wrede <w>bespotting</w> die tijdens de vergadering op haar gericht was niet verdragen.",
                                "de": "Sie konnte den grausamen <w>Hohn</w> nicht ertragen, der ihr während des Meetings entgegengebracht wurde."
                            }
                        }
                    ],
                    "synonyms": [
                        "ridicule",
                        "taunting"
                    ],
                    "target_lang_definitions": {
                        "nl": "De handeling van het bespotten of belachelijk maken van iemand.",
                        "de": "Der Akt, jemanden zu verspotten oder lächerlich zu machen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bespotting",
                                "target_lang_sense_clarification": "het proces van iemand belachelijk maken"
                            },
                            {
                                "target_lang_word": "gehoon",
                                "target_lang_sense_clarification": "het uiten van minachtende spot"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verspottung",
                                "target_lang_sense_clarification": "das Handeln, jemanden lächerlich zu machen"
                            },
                            {
                                "target_lang_word": "Hohn",
                                "target_lang_sense_clarification": "das Äußern von verächtlichem Spott"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77d88321-b9db-359f-8239-9fb2d74af3bf",
                    "sense_definition": "Present participle and gerund of <w>mock</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stop <w>mocking</w> the way he speaks because it is very rude.",
                            "target_lang_translations": {
                                "nl": "Stop met het <w>bespotten</w> van de manier waarop hij praat, want dat is erg onbeleefd.",
                                "de": "Hör auf, die Art, wie er spricht, zu <w>verspotten</w>, denn das ist sehr unhöflich."
                            }
                        },
                        {
                            "text": "He was <w>mocking</w> his brother for wearing such a silly hat.",
                            "target_lang_translations": {
                                "nl": "Hij was zijn broer aan het <w>uitlachen</w> omdat hij zo'n gekke hoed droeg.",
                                "de": "Er war dabei, seinen Bruder <w>auszulachen</w>, weil er so einen albernen Hut trug."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Tegenwoordig deelwoord en gerundium van 'mock' (bespotten).",
                        "de": "Partizip Präsens und Gerundium von 'mock' (verspotten)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bespotten",
                                "target_lang_sense_clarification": "iemand belachelijk maken"
                            },
                            {
                                "target_lang_word": "uitlachen",
                                "target_lang_sense_clarification": "iemand bespotten door te lachen"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "verspottend",
                                "target_lang_sense_clarification": "jemanden lächerlich machend"
                            },
                            {
                                "target_lang_word": "auslachend",
                                "target_lang_sense_clarification": "jemanden durch Lachen herabwürdigend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}