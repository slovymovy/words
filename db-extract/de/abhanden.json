        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "356bf7d3-453d-31bb-9cd3-a0636efe62ad",
                "word": "abhanden",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f9e3493-3f96-3520-950f-ffb4bd7753b6",
                        "entry_id": "356bf7d3-453d-31bb-9cd3-a0636efe62ad",
                        "glosses": [
                            "gone, lost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "415eb234-b09f-4ca2-aa5f-712d2757f944",
                                "sense_id": "4f9e3493-3f96-3520-950f-ffb4bd7753b6",
                                "text": "Ich bin der Welt abhanden gekommen, / Mit der ich sonst viele Zeit verdorben, / Sie hat so lange nichts von mir vernommen, / Sie mag wohl glauben, ich sei gestorben!",
                                "translation": "I am lost to the world / with which I used to waste so much time; / it has heard nothing from me for so long, / it may well believe that I am dead!",
                                "english": "I am lost to the world / with which I used to waste so much time; / it has heard nothing from me for so long, / it may well believe that I am dead!"
                            }
                        ]
                    }
                ],
