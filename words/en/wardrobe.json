{
    "word_family": [
        "wardrobing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9bf6e65c-6a27-331f-bd00-170e87e54588",
                    "sense_definition": "A large, tall piece of furniture or a built-in cupboard used for hanging or storing clothes.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She hung her new dress inside the <w>wardrobe</w> to keep it from getting wrinkled.",
                            "target_lang_translations": {
                                "ru": "Она повесила свое новое платье в <w>шкаф</w>, чтобы оно не помялось."
                            }
                        },
                        {
                            "text": "The heavy wooden <w>wardrobe</w> in the bedroom was filled with winter coats.",
                            "target_lang_translations": {
                                "ru": "Тяжелый деревянный <w>шкаф</w> в спальне был забит зимними пальто."
                            }
                        }
                    ],
                    "synonyms": [
                        "closet",
                        "cupboard",
                        "press"
                    ],
                    "common_phrases": [
                        "fitted wardrobe",
                        "wooden wardrobe",
                        "bedroom wardrobe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой высокий предмет мебели или встроенный шкаф, используемый для развешивания или хранения одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шкаф",
                                "target_lang_sense_clarification": "для одежды"
                            },
                            {
                                "target_lang_word": "гардероб",
                                "target_lang_sense_clarification": "предмет мебели"
                            },
                            {
                                "target_lang_word": "шифоньер",
                                "target_lang_sense_clarification": "шкаф для белья и одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24a26f4c-f0bc-3b1b-8f6b-0d6e8988f063",
                    "sense_definition": "A person's entire collection of clothes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "clothing_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to update his entire <w>wardrobe</w> before starting his new job at the bank.",
                            "target_lang_translations": {
                                "ru": "Он решил полностью обновить свой <w>гардероб</w> перед выходом на новую работу в банке."
                            }
                        },
                        {
                            "text": "A capsule <w>wardrobe</w> consists of a few essential items that never go out of style.",
                            "target_lang_translations": {
                                "ru": "Капсульный <w>гардероб</w> состоит из нескольких основных вещей, которые никогда не выходят из моды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "capsule wardrobe",
                        "winter wardrobe",
                        "entire wardrobe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Весь набор одежды, принадлежащий человеку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гардероб",
                                "target_lang_sense_clarification": "совокупность одежды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e7edc37e-4a50-3d71-90aa-7a755237b37e",
                    "sense_definition": "The department in a theater or movie studio responsible for costumes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "theater_department",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actors had to report to <w>wardrobe</w> at six in the morning for their fittings.",
                            "target_lang_translations": {
                                "ru": "Актеры должны были явиться в <w>костюмерную</w> в шесть утра для примерки."
                            }
                        },
                        {
                            "text": "She works in the <w>wardrobe</w> department of a major film production company.",
                            "target_lang_translations": {
                                "ru": "Она работает в <w>костюмерном</w> отделе крупной кинокомпании."
                            }
                        }
                    ],
                    "synonyms": [
                        "costume department"
                    ],
                    "common_phrases": [
                        "wardrobe department",
                        "wardrobe mistress",
                        "wardrobe assistant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдел в театре или киностудии, отвечающий за костюмы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "костюмерная",
                                "target_lang_sense_clarification": "отдел или помещение"
                            },
                            {
                                "target_lang_word": "гардероб",
                                "target_lang_sense_clarification": "костюмерный цех"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e2c54cc-36b8-3d30-b5a1-cb36ec0ee2c0",
                    "sense_definition": "A small room or walk-in area used for dressing and keeping clothes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rooms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The master suite includes a spacious walk-in <w>wardrobe</w> with plenty of shelving.",
                            "target_lang_translations": {
                                "ru": "В главной спальне есть просторная <w>гардеробная</w> с множеством полок."
                            }
                        },
                        {
                            "text": "In the old mansion, each bedroom had a private <w>wardrobe</w> for the guests' attire.",
                            "target_lang_translations": {
                                "ru": "В старинном особняке при каждой спальне была отдельная <w>гардеробная</w> для нарядов гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "closet"
                    ],
                    "common_phrases": [
                        "walk-in wardrobe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая комната или зона, используемая для переодевания и хранения одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гардеробная",
                                "target_lang_sense_clarification": "отдельная комната"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b28f920a-bf16-3706-9ba2-94ff238c2caf",
                    "sense_definition": "A private room, often used as a bedroom or sometimes as a bathroom.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rooms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical text mentioned the king retiring to his <w>wardrobe</w> for the evening.",
                            "target_lang_translations": {
                                "ru": "В историческом тексте упоминалось, что король удалился в свои <w>покои</w> на вечер."
                            }
                        },
                        {
                            "text": "In medieval times, the term <w>wardrobe</w> could refer to a private sleeping chamber.",
                            "target_lang_translations": {
                                "ru": "В средневековье термин wardrobe мог относиться к личной <w>опочивальне</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedroom",
                        "bathroom"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Личная комната, часто используемая как спальня или иногда как ванная комната (устаревшее)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покои",
                                "target_lang_sense_clarification": "личная комната"
                            },
                            {
                                "target_lang_word": "уборная",
                                "target_lang_sense_clarification": "комната для одевания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4310f00-3af5-3f93-a2df-33c39ce0f1fc",
                    "sense_definition": "The waste or feces of a badger.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hunter identified the presence of the animal by the fresh <w>wardrobe</w> near the burrow.",
                            "target_lang_translations": {
                                "ru": "Охотник определил присутствие животного по свежему <w>помету</w> возле норы."
                            }
                        },
                        {
                            "text": "Tracking badgers requires a keen eye for signs like their distinctive <w>wardrobe</w>.",
                            "target_lang_translations": {
                                "ru": "Выслеживание барсуков требует зоркого глаза, чтобы замечать такие признаки, как их характерные <w>экскременты</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "specific to hunting or regional tracking terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Экскременты барсука (охотничий термин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "экскременты",
                                "target_lang_sense_clarification": "барсука"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16e213bb-f190-350e-bfe1-3790aecdf911",
                    "sense_definition": "To provide or supply a person or production with a set of clothes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "supply_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The production team spent weeks <w>wardrobing</w> the cast for the historical drama.",
                            "target_lang_translations": {
                                "ru": "Команда постановщиков потратила недели на <w>подбор костюмов</w> для актеров исторической драмы."
                            }
                        },
                        {
                            "text": "They were well <w>wardrobed</w> for the event by a local fashion designer.",
                            "target_lang_translations": {
                                "ru": "Местный модельер отлично <w>подобрал им наряды</w> для этого мероприятия."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать или снабжать человека или постановку набором одежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подбирать гардероб",
                                "target_lang_sense_clarification": "снабжать одеждой"
                            },
                            {
                                "target_lang_word": "одевать",
                                "target_lang_sense_clarification": "обеспечивать костюмами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "203d169c-be38-3c36-80c5-b507830ad5b0",
                    "sense_definition": "The practice of buying clothes, wearing them once, and then returning them for a refund.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retail_fraud",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Retailers are losing millions of dollars every year due to customers <w>wardrobing</w> expensive outfits.",
                            "target_lang_translations": {
                                "ru": "Ритейлеры ежегодно теряют миллионы долларов из-за того, что покупатели <w>возвращают поношенную одежду</w>."
                            }
                        },
                        {
                            "text": "The store implemented a stricter return policy to prevent people from <w>wardrobing</w> their evening wear.",
                            "target_lang_translations": {
                                "ru": "Магазин ужесточил правила возврата, чтобы люди не могли <w>сдавать обратно</w> вечерние наряды после одного выхода."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "retail industry jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Практика покупки одежды, ее разового использования и последующего возврата в магазин для получения возмещения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вардробинг",
                                "target_lang_sense_clarification": "вид потребительского мошенничества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}