                                "target_senses": [
                                    {
                                        "sense_id": "f48ce652-289b-3ae3-8aab-0d8794127214",
                                        "entry_id": "0881b6f5-3046-3606-893b-cc0c490ac7f4",
                                        "glosses": [
                                            "eine Sprache, die in Nepal gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83601a71-ec19-4106-acb3-a6b092cd32f9",
                                                "sense_id": "f48ce652-289b-3ae3-8aab-0d8794127214",
                                                "text": "„Handgeschriebene Bücher in Newari und Inschriften finden sich erst seit der Malaa-Zeit im 14. Jahrhundert.“"
                                            },
                                            {
                                                "example_id": "f004f7b6-6fe6-45ef-953f-7112bde36f93",
                                                "sense_id": "f48ce652-289b-3ae3-8aab-0d8794127214",
                                                "text": "„Die Tibetische ist mit mehreren Dialekten in den oberen Himalayaregionen von Kaschmir über Nepal (Bhote, Sherpa) bis nach Sikkim und Bhutan vertreten; das relativ früh bezeugte Newari ist im Kathmandu-Tal verbreitet, das Naga vor allem in Assam (Nagaland) und das Meithei in Manipur.“"
                                            },
                                            {
                                                "example_id": "4a41e60e-4509-4c88-bde4-f15c6186e12b",
                                                "sense_id": "f48ce652-289b-3ae3-8aab-0d8794127214",
                                                "text": "„Die Erhaltung des Newari war wol von jenen drei Ursachen vorzüglich abhängig, welche Hodgson anführt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
