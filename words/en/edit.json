{
    "word_family": [
        "editor",
        "edition",
        "editorial",
        "editable",
        "unedited",
        "editorship"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4e9943b-b79c-35a4-84b2-b4b004361dcb",
                    "sense_definition": "To prepare a text or document for publication by correcting errors, shortening it, or making improvements.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "text_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>edit</w> your essay carefully before you hand it in.",
                            "target_lang_translations": {
                                "ru": "Тебе следует внимательно <w>отредактировать</w> свое эссе, прежде чем сдавать его.",
                                "zh": "交作业前，你应该仔细<w>编辑</w>你的文章。"
                            }
                        },
                        {
                            "text": "The author had to <w>edit</w> the chapter to make it fit the page limit.",
                            "target_lang_translations": {
                                "ru": "Автору пришлось <w>сократить</w> главу, чтобы уложиться в лимит страниц.",
                                "zh": "作者不得不<w>删改</w>这一章以符合页数限制。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alter",
                        "fix up",
                        "cut",
                        "correct",
                        "revise"
                    ],
                    "common_phrases": [
                        "edit a document",
                        "edit out",
                        "edit text"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовить текст или документ к публикации, исправляя ошибки, сокращая или улучшая его.",
                        "zh": "为出版准备文本或文档，通过纠正错误、删减或改进内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редактировать",
                                "target_lang_sense_clarification": "общий термин: вносить изменения в текст"
                            },
                            {
                                "target_lang_word": "править",
                                "target_lang_sense_clarification": "исправлять ошибки, вносить корректуры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编辑",
                                "target_lang_sense_clarification": "通用术语，对文本进行修改"
                            },
                            {
                                "target_lang_word": "校订",
                                "target_lang_sense_clarification": "侧重于纠正错误和润色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4126cb9-4a4b-3a07-a254-01ba5888ff7a",
                    "sense_definition": "To prepare a film, recording, or photograph by removing parts, rearranging material, or adjusting the quality.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "media_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took him three days to <w>edit</w> the wedding video.",
                            "target_lang_translations": {
                                "ru": "У него ушло три дня, чтобы <w>смонтировать</w> свадебное видео.",
                                "zh": "他花了三天时间<w>剪辑</w>这段婚礼视频。"
                            }
                        },
                        {
                            "text": "She used software to <w>edit</w> the photo and remove the red eyes.",
                            "target_lang_translations": {
                                "ru": "Она использовала программу, чтобы <w>обработать</w> фотографию и убрать эффект красных глаз.",
                                "zh": "她用软件<w>处理</w>了这张照片，去掉了红眼。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cut",
                        "retouch",
                        "modify",
                        "adjust"
                    ],
                    "common_phrases": [
                        "edit a video",
                        "edit a photo",
                        "edit down"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрабатывать видео, аудио или фотографии, удаляя части, меняя порядок или улучшая качество.",
                        "zh": "通过删除片段、重新排列素材或调整质量来处理电影、录音或照片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монтировать",
                                "target_lang_sense_clarification": "видео или фильм"
                            },
                            {
                                "target_lang_word": "редактировать",
                                "target_lang_sense_clarification": "фотографии или общая обработка медиа"
                            },
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "улучшать качество (фото/аудио)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剪辑",
                                "target_lang_sense_clarification": "针对视频或电影的后期处理"
                            },
                            {
                                "target_lang_word": "处理",
                                "target_lang_sense_clarification": "针对照片或音频的质量优化"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "642610bb-4d4b-3d27-9b8f-f97153d4a8f4",
                    "sense_definition": "To be responsible for the content and publication of a newspaper, magazine, or other periodical.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "publication_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>edits</w> a popular fashion magazine in New York.",
                            "target_lang_translations": {
                                "ru": "Он <w>редактирует</w> популярный модный журнал в Нью-Йорке.",
                                "zh": "他在纽约<w>主编</w>一本流行的时尚杂志。"
                            }
                        },
                        {
                            "text": "She was hired to <w>edit</w> the local newspaper after the previous manager retired.",
                            "target_lang_translations": {
                                "ru": "Ее наняли <w>редактировать</w> местную газету после того, как предыдущий руководитель ушел на пенсию.",
                                "zh": "前任经理退休后，她被聘请来<w>编辑</w>当地的报纸。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "edit a magazine",
                        "edit a newspaper"
                    ],
                    "target_lang_definitions": {
                        "ru": "Руководить изданием газеты, журнала или другого периодического издания, отвечая за его содержание.",
                        "zh": "负责报纸、杂志或其他期刊的内容和出版工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редактировать",
                                "target_lang_sense_clarification": "быть редактором издания"
                            },
                            {
                                "target_lang_word": "возглавлять редакцию",
                                "target_lang_sense_clarification": "руководить издательским процессом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "主编",
                                "target_lang_sense_clarification": "担任出版物的负责人"
                            },
                            {
                                "target_lang_word": "编辑",
                                "target_lang_sense_clarification": "负责某刊物的编辑工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27dde5af-6704-33dc-bf45-16d8d0b04051",
                    "sense_definition": "To alter the genetic structure or DNA sequence of an organism.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dna_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are developing new ways to <w>edit</w> genes to treat hereditary diseases.",
                            "target_lang_translations": {
                                "ru": "Ученые разрабатывают новые способы <w>редактировать</w> гены для лечения наследственных заболеваний.",
                                "zh": "科学家们正在开发治疗遗传病的新型基因<w>编辑</w>方法。"
                            }
                        },
                        {
                            "text": "The laboratory attempts to <w>edit</w> the genome of the crop to make it resistant to pests.",
                            "target_lang_translations": {
                                "ru": "Лаборатория пытается <w>изменить</w> геном сельскохозяйственной культуры, чтобы сделать ее устойчивой к вредителям.",
                                "zh": "实验室试图<w>改造</w>农作物的基因组，使其具有抗虫性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "splice"
                    ],
                    "common_phrases": [
                        "edit genes",
                        "edit DNA"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменять генетическую структуру или последовательность ДНК организма.",
                        "zh": "改变生物体的基因结构或DNA序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "редактировать",
                                "target_lang_sense_clarification": "изменять геном"
                            },
                            {
                                "target_lang_word": "изменять",
                                "target_lang_sense_clarification": "вносить изменения в структуру"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "编辑",
                                "target_lang_sense_clarification": "指基因编辑技术"
                            },
                            {
                                "target_lang_word": "改造",
                                "target_lang_sense_clarification": "改变生物的遗传特性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d700c7f-d543-33dc-9f3d-ed348790218f",
                    "sense_definition": "A change or correction made to a text, file, or piece of code.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "text_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I made a few <w>edits</w> to the report before sending it to the manager.",
                            "target_lang_translations": {
                                "ru": "Я внес несколько <w>правок</w> в отчет перед отправкой менеджеру.",
                                "zh": "在发给经理之前，我对报告做了几处<w>修改</w>。"
                            }
                        },
                        {
                            "text": "The software automatically saves every <w>edit</w> you make to the document.",
                            "target_lang_translations": {
                                "ru": "Программа автоматически сохраняет каждое <w>изменение</w>, которое вы вносите в документ.",
                                "zh": "软件会自动保存你对文档所做的每一处<w>改动</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an edit",
                        "quick edit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменение или исправление, внесенное в текст, файл или код.",
                        "zh": "对文本、文件或代码所做的更改或修正。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правка",
                                "target_lang_sense_clarification": "конкретное исправление"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "любая перемена в документе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修改",
                                "target_lang_sense_clarification": "对内容进行的变动"
                            },
                            {
                                "target_lang_word": "订正",
                                "target_lang_sense_clarification": "针对错误的修正"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30985b48-73ce-3bbd-ab35-38c0035cdd43",
                    "sense_definition": "A specific version of a film, video, or recording after it has been modified or arranged.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_modification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director's <w>edit</w> of the movie includes scenes that were cut from the theatrical release.",
                            "target_lang_translations": {
                                "ru": "Режиссерский <w>монтаж</w> фильма включает сцены, которые были вырезаны из версии для кинотеатров.",
                                "zh": "导演<w>剪辑版</w>的电影包含了院线公映时被删减的片段。"
                            }
                        },
                        {
                            "text": "We listened to the radio <w>edit</w> of the song, which is shorter than the album version.",
                            "target_lang_translations": {
                                "ru": "Мы слушали радио-<w>версию</w> песни, которая короче альбомной.",
                                "zh": "我们听了这首歌的电台<w>版本</w>，它比专辑原版要短。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "final edit",
                        "radio edit",
                        "rough edit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Версия фильма, видео или аудиозаписи после монтажа или обработки.",
                        "zh": "电影、视频或录音经过剪辑或处理后的特定版本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монтаж",
                                "target_lang_sense_clarification": "версия фильма (напр. режиссерский монтаж)"
                            },
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "вариант записи (напр. радио-версия)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "剪辑版",
                                "target_lang_sense_clarification": "指特定的电影或视频版本"
                            },
                            {
                                "target_lang_word": "版本",
                                "target_lang_sense_clarification": "指经过处理后的成品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e327e9f-982b-3924-8fd7-228618c3506c",
                    "sense_definition": "A curated selection of products, such as clothing or accessories, chosen for a specific theme or purpose.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "fashion_collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brand launched a new summer <w>edit</w> featuring bright colors and light fabrics.",
                            "target_lang_translations": {
                                "ru": "Бренд выпустил новую летнюю <w>подборку</w>, отличающуюся яркими цветами и легкими тканями.",
                                "zh": "该品牌推出了以明亮色彩和轻薄面料为特色的夏季<w>精选</w>系列。"
                            }
                        },
                        {
                            "text": "She browsed the luxury <w>edit</w> on the website to find a gift.",
                            "target_lang_translations": {
                                "ru": "Она просматривала люксовую <w>коллекцию</w> на сайте, чтобы найти подарок.",
                                "zh": "她在网站上浏览了奢侈品<w>精选</w>，想找一份礼物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "summer edit",
                        "collection edit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "marketing"
                        },
                        {
                            "trait_type": "form",
                            "comment": "fashion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специально отобранная коллекция товаров (одежды, аксессуаров), объединенная общей темой.",
                        "zh": "为特定主题或目的而精心挑选的一系列产品，如服装或配饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подборка",
                                "target_lang_sense_clarification": "избранные товары"
                            },
                            {
                                "target_lang_word": "коллекция",
                                "target_lang_sense_clarification": "набор вещей определенной тематики"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精选",
                                "target_lang_sense_clarification": "指精心挑选的商品系列"
                            },
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "指特定主题的商品集合"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}