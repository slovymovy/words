                "senses": [
                    {
                        "sense_id": "d21d9553-0348-356f-bba4-a104b719ecbf",
                        "entry_id": "a1fcb256-c6d1-3469-a92d-1ccfe9fd3f6d",
                        "glosses": [
                            "die Zeitspanne von einem astronomischen Mittag zum anderen, in Häfen auch die Zeitspanne von Mitternacht bis Mitternacht"
                        ],
                        "tags": [
                            "Seemannssprache",
                            "niederdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "3e788d85-3a07-470e-9519-1de6868f11ba",
                                "sense_id": "d21d9553-0348-356f-bba4-a104b719ecbf",
                                "text": "Wir schliefen bis tief in den Mittag hinein, so spanisch waren wir in einem Etmal schon geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96273f75-2608-3116-bb1c-4d9a2259af5f",
                        "entry_id": "a1fcb256-c6d1-3469-a92d-1ccfe9fd3f6d",
                        "glosses": [
                            "die von einem Schiff in der unter [1] genannten Zeitspanne zurückgelegte Strecke"
                        ],
                        "tags": [
                            "Seemannssprache",
                            "niederdeutsch"
                        ],
                        "examples": [
                            {
                                "example_id": "4b44eb7d-3760-4967-9255-0ba30bac9028",
                                "sense_id": "96273f75-2608-3116-bb1c-4d9a2259af5f",
                                "text": "„Am ersten Tag hatten wir insgesamt 12 Schleusen und 5 Hebebrücken zu bewältigen und legten ein gewaltiges Etmal von 9 Kilometern zurück.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
