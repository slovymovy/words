                    {
                        "sense_id": "57092818-47dd-3a2c-a19e-2a00bbe98417",
                        "entry_id": "4007e722-add0-33c0-83ad-800601b89d52",
                        "glosses": [
                            "abgewandelte, moderne Art des ursprünglichen japanischen Schwertkampfes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89eecc42-63a7-4ee3-8b46-4a92bec7e92c",
                                "sense_id": "57092818-47dd-3a2c-a19e-2a00bbe98417",
                                "text": "Er ist in einem Kendo-Verein."
                            },
                            {
                                "example_id": "75ba894d-516f-4262-9d9d-61938fe0a0d5",
                                "sense_id": "57092818-47dd-3a2c-a19e-2a00bbe98417",
                                "text": "Neues zum Kendo: Den Titel im Mannschaftswettkampf der Herren errang Japan."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e82038a6-8264-34cf-9eb8-8ead5d1ac1bc",
                        "entry_id": "4007e722-add0-33c0-83ad-800601b89d52",
                        "glosses": [
                            "die japanische Schwertkunst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48190817-b98c-4a77-999f-4db3307a8fb5",
                                "sense_id": "e82038a6-8264-34cf-9eb8-8ead5d1ac1bc",
                                "text": "Er ist in einem Kendo-Verein."
                            },
                            {
                                "example_id": "a83c622c-f1b8-4782-a881-3c5b0c925a9d",
                                "sense_id": "e82038a6-8264-34cf-9eb8-8ead5d1ac1bc",
                                "text": "Kendo bedeutet, den Weg durch das Schwert finden. Das Ziel ist es, einen Geist zu erschaffen, den nichts überraschen kann, der fest und zielgerichtet ist."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
