                    "frequency": "High",
                    "semantic_group_id": "daten_und_medien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für das Meeting müssen wir die statistischen Daten übersichtlich <w>aufbereiten</w>."
                        },
                        {
