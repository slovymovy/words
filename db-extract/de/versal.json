                    {
                        "translation_id": "2bdd0be3-aa43-4687-8a87-fcd40ff996d8",
                        "source_entry_id": "ddb32617-4d3a-32ad-8a1d-3b164a504a5e",
                        "source_sense_id": "24757c9a-720d-3b39-aa26-e5c397fd0e11",
