                "senses": [
                    {
                        "sense_id": "abb67487-4134-3096-95a3-94ebb9bb51a0",
                        "entry_id": "3813883e-40bf-35a0-8536-78fcf4d18a32",
                        "glosses": [
                            "een sterk omhulsel dat een cel om het plasmamembraan heen kan synthetiseren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40e1b8c8-7b3d-416a-9e59-8dc35c2ea999",
                                "sense_id": "abb67487-4134-3096-95a3-94ebb9bb51a0",
                                "text": "De celwand geeft een cel stevigheid en voorkomt lyse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8971839-4c85-413e-a240-27ccdeba43be",
                        "source_entry_id": "3813883e-40bf-35a0-8536-78fcf4d18a32",
                        "source_sense_id": "abb67487-4134-3096-95a3-94ebb9bb51a0",
                        "source_sense_description": "(biologie) een sterk omhulsel dat een cel om het plasmamembraan heen kan synthetiseren",
                        "target_lang_word": "Zellwand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zellwand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d03140b-a1b1-36b2-ad26-a3cb40459d2a",
                                        "entry_id": "41ac25bc-72c3-3857-9846-c3add00e489f",
                                        "glosses": [
                                            "Wand einer Zelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eff073e3-c23d-4a31-996e-db68a70e976c",
                                                "sense_id": "9d03140b-a1b1-36b2-ad26-a3cb40459d2a",
                                                "text": "„Die Zellwand ist eine aus organischen Polymeren aufgebaute Hülle, die einige Bakterien, Pflanzen und Pilze umgibt.“"
                                            },
                                            {
                                                "example_id": "361b237b-d4fd-4bb8-a0e1-e85895e8a65e",
                                                "sense_id": "9d03140b-a1b1-36b2-ad26-a3cb40459d2a",
                                                "text": "„So stammt Vanillearoma etwa aus Lignin, das in Zellwänden vorkommt, also in Hölzern.“"
                                            },
                                            {
                                                "example_id": "6f1591f1-e4a1-4475-ae31-9d9f2b4e96b6",
                                                "sense_id": "9d03140b-a1b1-36b2-ad26-a3cb40459d2a",
                                                "text": "[Pilze:] „Während die Zellwände von Pflanzen überwiegend aus Zellulose bestehen, enthalten Pilzzellwände Chitin, einen Stoff, der auch im Exoskelett von Insekten und Krebstieren vorkommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c57ace5-cd57-4536-974f-fe1c35f42086",
                        "source_entry_id": "3813883e-40bf-35a0-8536-78fcf4d18a32",
                        "source_sense_id": "abb67487-4134-3096-95a3-94ebb9bb51a0",
                        "source_sense_description": "(biologie) een sterk omhulsel dat een cel om het plasmamembraan heen kan synthetiseren",
                        "target_lang_word": "cell wall",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cell wall",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2299394-f034-38da-8e3a-e66d5088380c",
                                        "entry_id": "5f7a05e6-7ba3-3b56-99a0-b446225654f5",
                                        "glosses": [
                                            "A thick, fairly rigid, layer formed around individual cells of bacteria, Archaea, fungi, plants, and algae (but not animals and other protists which generally have cell membranes without cell walls). The cell wall is external to the cell membrane and serves a structural function helping the cell maintain its shape and protecting the cell from damage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ee1cc3-87c9-4dd9-bb5f-162417b18344",
                                                "sense_id": "a2299394-f034-38da-8e3a-e66d5088380c",
                                                "text": "The name of Chlamydomonas is applied to certain microscopic green bodies, each of which consists of a protoplasmic central substance invested by a structureless sac. The latter contains cellulose, as in ordinary plants; and the chlorophyll which gives the green colour enables the Chlamydomonas to decompose carbonic acid and fix carbon, as they do. Two long cilia protrude through the cell-wall, and effect the rapid locomotion of this \"monad,\" which, in all respects except its mobility, is characteristically a plant."
                                            },
                                            {
                                                "example_id": "61d4f697-0467-447f-b504-de64bee0c618",
                                                "sense_id": "a2299394-f034-38da-8e3a-e66d5088380c",
                                                "text": "The structural distinctiveness of the cell—in plants especially—is dues in large part to the presence of an outer layer, or coat, the cell wall, which in plants is usually firm, and often hard and thick; in animals, delicate or lacking."
                                            },
                                            {
                                                "example_id": "8ec54e17-56df-4055-ae5e-3b87be368334",
                                                "sense_id": "a2299394-f034-38da-8e3a-e66d5088380c",
                                                "text": "Terrestrial vascular plants contain considerable quantities of lignin, an amorphous phenylpropanoid structural polymer that binds cell wall components and cell walls together providing structural stability to plants."
                                            },
                                            {
                                                "example_id": "32fe3615-8243-44b3-9bda-960c61b2d63e",
                                                "sense_id": "a2299394-f034-38da-8e3a-e66d5088380c",
                                                "text": "Think of the cell wall as a wicker basket in which a balloon has been inflated so that it exerts pressure from the inside. Such a basket is very rigid and resistant to mechanical damage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
