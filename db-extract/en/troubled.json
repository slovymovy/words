                                    {
                                        "sense_id": "f0badfd2-d248-3129-8cf8-0424ec3f9b92",
                                        "entry_id": "4f186b87-6b4d-3cdc-a2b8-b58813f3ea84",
                                        "glosses": [
                                            "in einer zwischenmenschlichen Beziehung beeinträchtigt sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f2f9909-649a-4d0f-b361-a14bb8e82c9d",
                                                "sense_id": "f0badfd2-d248-3129-8cf8-0424ec3f9b92",
                                                "text": "Ihr Verhältnis gilt seit jeher als gestört: US-Präsident Obama sagte noch einmal in aller Deutlichkeit, was er von der Politik des israelischen Premiers Netanjahu und dessen Aussagen zu einem Palästinenserstaat hält."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a77008fe-be36-3a61-9d9f-dc2909e34fc1",
                                        "entry_id": "4f186b87-6b4d-3cdc-a2b8-b58813f3ea84",
                                        "glosses": [
                                            "aus dem Gleichgewicht sein (Gesundheit, Politik, Umwelt, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30ae2fe4-2c52-48b3-8ef8-f7af1ab20b5f",
                                                "sense_id": "a77008fe-be36-3a61-9d9f-dc2909e34fc1",
                                                "text": "Heftiger Schneefall und Glatteis haben den Verkehr in Deutschland und den angrenzenden Ländern wieder erheblich gestört. Zeitweise ging nichts mehr."
                                            },
                                            {
                                                "example_id": "29003f0c-dac5-4ee7-8e3d-0565e601eb39",
                                                "sense_id": "a77008fe-be36-3a61-9d9f-dc2909e34fc1",
                                                "text": "Laut Polizei legten Unbekannte Feuer an einem Schaltkasten für Signalanlagen; zudem wurde ein Kabel zerschnitten. Der Zugverkehr war massiv gestört."
                                            },
                                            {
                                                "example_id": "e806e795-789e-4fa3-be1f-84630d4806b9",
                                                "sense_id": "a77008fe-be36-3a61-9d9f-dc2909e34fc1",
                                                "text": "Rund 800.000 Menschen in Deutschland gehören zu dieser Gruppe: zu denjenigen, bei denen der Redefluss gestört ist, zu Menschen, die stottern."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "401525a9-ba45-3785-a153-4ed4ccc41fcd",
                                        "entry_id": "4f186b87-6b4d-3cdc-a2b8-b58813f3ea84",
                                        "glosses": [
                                            "verrückt sein; geistig nicht normal sein; psychisch krank sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dc9a7c9-07d9-4b3d-ac64-3514e3c58510",
                                                "sense_id": "401525a9-ba45-3785-a153-4ed4ccc41fcd",
                                                "text": "Die Veteranen aus den Kriegen in den 1990-er Jahren im ehemaligen Jugoslawien sind heute […] häufig psychisch gestört. Doch die Gesellschaft schaut weg."
                                            },
                                            {
                                                "example_id": "0c2da925-c953-4396-aefb-33aa8f45164d",
                                                "sense_id": "401525a9-ba45-3785-a153-4ed4ccc41fcd",
                                                "text": "Der französische Innenminister Bernard Cazeneuve hatte dazu am Sonntagabend im Fernsehsender TF1 gesagt, der zum Islam konvertierte Täter von Joué-lès-Tours erscheine ihm \"sowohl rätselhaft als auch seelisch gestört\"."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
