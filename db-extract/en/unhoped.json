                                "example_id": "0426a92a-8325-47d2-8b0e-4de6dca9cfe2",
                                "sense_id": "de441a17-b861-3afe-a625-cee3abc5470d",
                                "text": "Men on cycles, lean-faced, unkempt, scorched along every country lane, shouting of unhoped deliverance, shouting to gaunt, staring figures of despair."
