                                        "entry_id": "b7a569b8-70d9-3414-8649-7a8918b309d4",
                                        "glosses": [
                                            "A small or short album (in various senses)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79b64baa-2ab0-4ca9-932e-bcc962fc2c4f",
                                                "sense_id": "296996bb-c4e4-3c74-b66a-78e66999328b",
                                                "text": "There were minialbums, midline albums — popular oldies, reissues, and new acts listing at $5.98. In total 5,375 new records were issued."
                                            },
                                            {
                                                "example_id": "8b516b83-6bb8-4cae-9910-9d5d9a15a936",
                                                "sense_id": "296996bb-c4e4-3c74-b66a-78e66999328b",
                                                "text": "He set down the pictures and pulled out a minialbum. The first page was her senior picture, with her swirly handwriting documenting important events."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
