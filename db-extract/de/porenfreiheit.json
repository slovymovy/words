                "senses": [
                    {
                        "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                        "entry_id": "7d733c33-f8cd-3845-ae2e-2b6af6faf52e",
                        "glosses": [
                            "Eigenschaft, keine Poren (kleine Hohlräume oder Öffnungen) zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "960b76f4-01c8-4c00-ae59-524865f75b64",
                                "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                                "text": "„Die innere Porenfreiheit des Laminates geht meist auch mit einer hohen Oberflächengüte des fertigen Bauteils auf der Formwerkzeugseite einher.“"
                            },
                            {
                                "example_id": "2261712b-13c2-4cb1-8038-99950cf823cc",
                                "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                                "text": "„Es ist zweckmäßig, Materialproben im Laboratorium insbesondere auf Porenfreiheit und Trennbruchsicherheit zu prüfen.“"
                            },
                            {
                                "example_id": "e8daf023-bbf1-465c-8cbc-5702e5bb21b7",
                                "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                                "text": "„Nach Herstellerangaben kann reproduzierbar Porenfreiheit erreicht werden, die aufgeschweißte Zone ist also zu 100 % dicht.“"
                            },
                            {
                                "example_id": "769e83c1-ad53-4082-a164-135e03008b85",
                                "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                                "text": "„Porenfreiheit wird überall dort gefordert, wo ein Kontakt mit aggressiven oder empfindlichen Füllgütern eine dichte Oberfläche erfordert oder eine besondere Korrosionsfestigkeit verlangt wird.“"
                            },
                            {
                                "example_id": "de26509b-7eb9-4157-8a25-df24f474bb24",
                                "sense_id": "d5c5ebcc-cf33-32e7-9884-e5422e0fadf6",
                                "text": "„Die Glätte, innere Dichtigkeit und Porenfreiheit des solchergestalt gepreßten Bleies dient ihm so sehr zur Empfehlung, daß man auch Platten auf diesem Wege herstellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
