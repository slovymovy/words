                ],
                "senses": [
                    {
                        "sense_id": "6131500b-ef97-3fb1-a6f6-cc8a4de933b5",
                        "entry_id": "493741c1-e521-3c16-a56a-c16fdfc9a9a2",
                        "glosses": [
                            "faschistische Bewegung in Österreich zwischen 1933 und 1938"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abac2a5-a68b-4231-90b0-58911148fcca",
                                "sense_id": "6131500b-ef97-3fb1-a6f6-cc8a4de933b5",
                                "text": "„Ungeachtet dessen, dass seit dem Ende der österreichischen Diktatur des Austrofaschismus mehr als 70 Jahren vergangen sind, ist diese im politischen Diskurs ebenso wie in wissenschaftlichen Analysen weiterhin präsent.“"
                            },
                            {
                                "example_id": "b34fe12c-a121-4a55-95ac-edabf346c630",
                                "sense_id": "6131500b-ef97-3fb1-a6f6-cc8a4de933b5",
                                "text": "„Die Tage des schrecklichen Bürgerkriegs vom Februar 1934, der zum katholischen Austrofaschismus und damit zum Ende der ersten Republik Österreichs führt, verbringt das Ehepaar Canetti meistens zusammen in der Ferdinandstraße, wo Elias mehr und mehr wohnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
