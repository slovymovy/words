                    {
                        "sense_id": "c2b0fb82-3c5f-3011-bc32-a68a173e9d05",
                        "entry_id": "493807dd-3ded-3fff-b8e6-43e9ef14bbcf",
                        "glosses": [
                            "Calmer."
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "11fef46d-2e89-4c02-815a-3c9eb6223fe2",
                                "sense_id": "c2b0fb82-3c5f-3011-bc32-a68a173e9d05",
                                "text": "Although the breeze had now utterly ceased, we had made a great deal of way during the night, and were now lying becalmed about half a mile to the south-east of the low eastern coast."
                            }
                        ]
