                "senses": [
                    {
                        "sense_id": "0c45f056-4d4c-3e0d-afd2-6cfc4d4dc4ea",
                        "entry_id": "e18dc995-73dd-3a12-92e0-d0be8b6abab8",
                        "glosses": [
                            "Donner un caractère amazigh à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce1fa12a-4ebc-4bb3-a913-8120ff56f43f",
                                "sense_id": "0c45f056-4d4c-3e0d-afd2-6cfc4d4dc4ea",
                                "text": "Mon ami, tu sais pertinement qu'il est impossible d'amazighiser 30 millions d'arabes."
                            },
                            {
                                "example_id": "6a4d3847-e93f-4839-b445-e7bed11ea776",
                                "sense_id": "0c45f056-4d4c-3e0d-afd2-6cfc4d4dc4ea",
                                "text": "Nous revendiquons aujourd'hui l'égalité totale entre arabe et amazigh, ceci ne dit pas que nous allons amazighiser le système scolaire."
                            },
                            {
                                "example_id": "689c002c-47c0-4fbe-a03e-1d185523af46",
                                "sense_id": "0c45f056-4d4c-3e0d-afd2-6cfc4d4dc4ea",
                                "text": "Alors, on a leur a concocté des programmes pour les arabiser, pour les islamiser, pour les amazighiser."
                            }
                        ]
                    }
                ],
