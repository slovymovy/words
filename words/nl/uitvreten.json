{
    "word_family": [
        "vreten",
        "afvreten",
        "opvreten",
        "vervreten",
        "vraat",
        "vretend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4cb4f2c5-5040-3f81-b2ea-12a303a0e6a0",
                    "sense_definition": "Iets slechts, ondeugends of ongepasts doen of beramen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat hij ook <w>uitvrat</w>, zijn moeder bleef hem altijd steunen en vergeven.",
                            "target_lang_translations": {
                                "en": "No matter what he <w>got up to</w>, his mother always continued to support and forgive him."
                            }
                        },
                        {
                            "text": "De jongens waren verdacht stil, dus ik vroeg me af wat ze nu weer <w>uitvraten</w>.",
                            "target_lang_translations": {
                                "en": "The boys were suspiciously quiet, so I wondered what they <w>were up to</w> this time."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitspoken",
                        "uithalen"
                    ],
                    "common_phrases": [
                        "kattenkwaad uitvreten",
                        "niks uitvreten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak informeel gebruikt voor kattenkwaad of foute streken."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To do or scheme something bad, mischievous, or inappropriate."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be up to",
                                "target_lang_sense_clarification": "informal, doing mischief or scheming"
                            },
                            {
                                "target_lang_word": "get up to",
                                "target_lang_sense_clarification": "doing something mischievous or secret"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c904a8ef-090d-35a2-849f-ae517ad24b9b",
                    "sense_definition": "Profiteren van de vrijgevigheid van anderen door op hun kosten te eten of leven.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij weigert te werken en zit al maandenlang zijn familie <w>uit</w> te <w>vreten</w>.",
                            "target_lang_translations": {
                                "en": "He refuses to work and has been <w>sponging off</w> his family for months."
                            }
                        },
                        {
                            "text": "Niemand stelt het op prijs als je alleen maar komt om anderen <w>uit</w> te <w>vreten</w>.",
                            "target_lang_translations": {
                                "en": "Nobody appreciates it if you only show up to <w>freeload off</w> others."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Negatief pejoratief geladen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To take advantage of others by living or eating at their expense; to sponge or freeload off someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sponge off",
                                "target_lang_sense_clarification": "parasitize or live off someone"
                            },
                            {
                                "target_lang_word": "freeload off",
                                "target_lang_sense_clarification": "exploit someone's hospitality or food"
                            },
                            {
                                "target_lang_word": "mooch off",
                                "target_lang_sense_clarification": "informal, live at another's expense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bfbbcf6-e4e9-3d32-99a9-d13c7a51d3f2",
                    "sense_definition": "Door chemische werking langzaam aantasten of uithollen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het sterke zuur <w>vrat</w> het oppervlak van de metalen buis langzaam <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "The strong acid slowly <w>ate away at</w> the surface of the metal pipe."
                            }
                        },
                        {
                            "text": "Als de roest niet tijdig verwijderd wordt, zal het de hele constructie <w>uitvreten</w>.",
                            "target_lang_translations": {
                                "en": "If the rust is not removed in time, it will <w>corrode</w> the entire structure."
                            }
                        }
                    ],
                    "synonyms": [
                        "aantasten",
                        "bijten",
                        "corroderen",
                        "uitbijten",
                        "wegvreten"
                    ],
                    "target_lang_definitions": {
                        "en": "To slowly erode, corrode, or hollow out through chemical action."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "corrode",
                                "target_lang_sense_clarification": "eat away chemically"
                            },
                            {
                                "target_lang_word": "eat away at",
                                "target_lang_sense_clarification": "gradually destroy or erode"
                            },
                            {
                                "target_lang_word": "erode",
                                "target_lang_sense_clarification": "wear away slowly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa59e6af-70d5-3172-9a5c-cd735d8ac75c",
                    "sense_definition": "Iets gulzig of volledig leegeten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De uitgehongerde dieren <w>vraten</w> de hele voorraadbak in een mum van tijd <w>uit</w>.",
                            "target_lang_translations": {
                                "en": "The starving animals <w>cleaned out</w> the entire feed container in no time."
                            }
                        },
                        {
                            "text": "Tegen de avond had de hond het hele bord tot op de laatste kruimel <w>uitgevreten</w>.",
                            "target_lang_translations": {
                                "en": "By evening, the dog had <w>licked</w> the whole plate <w>clean</w> down to the very last crumb."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Afgeleid van het platte woord 'vreten'."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To greedily or completely eat everything out of something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gorge empty",
                                "target_lang_sense_clarification": "eat out voraciously"
                            },
                            {
                                "target_lang_word": "clean out",
                                "target_lang_sense_clarification": "eat all food out of something"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}