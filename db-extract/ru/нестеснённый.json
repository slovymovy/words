                "senses": [
                    {
                        "sense_id": "37c09be4-7d4e-364b-a6c8-abe39608c50d",
                        "entry_id": "71ebf529-8b66-33eb-bd48-f51d9e69c9d5",
                        "glosses": [
                            "не чувствующий или не имеющий ограничений, стеснения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1b0f057-0aac-4c68-847e-b39f932f3568",
                                "sense_id": "37c09be4-7d4e-364b-a6c8-abe39608c50d",
                                "text": "Сосед и друг говорил о нестесненном небесном своде, о звездах ночи; говорил, что в общении с природой я буду счастлива."
                            }
                        ]
                    }
                ],
