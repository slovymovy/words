{
    "word_family": [
        "stiff",
        "stiffness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f2813331-304c-308a-9318-e78ec3db8038",
                    "sense_definition": "To become rigid or less flexible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "stiffen_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete's muscles <w>stiffened</w> after the long race in the cold weather.",
                            "target_lang_translations": {
                                "cs": "Sportovci po dlouhém závodě v chladném počasí <w>ztuhly</w> svaly."
                            }
                        },
                        {
                            "text": "His body <w>stiffened</w> when he heard the sudden noise behind him.",
                            "target_lang_translations": {
                                "cs": "Jeho tělo <w>ztuhlo</w>, když za sebou uslyšel náhlý hluk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscles stiffen"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stát se tuhým, nepružným nebo ztuhlým."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ztuhnout",
                                "target_lang_sense_clarification": "stát se tuhým nebo méně poddajným"
                            },
                            {
                                "target_lang_word": "ztvrdnout",
                                "target_lang_sense_clarification": "stát se tvrdým nebo pevným"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ef63093-b712-3397-825d-6af1702b6838",
                    "sense_definition": "To make something rigid or less flexible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "stiffen_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They used a special spray to <w>stiffen</w> the fabric before sewing it.",
                            "target_lang_translations": {
                                "cs": "Před šitím použili speciální sprej, aby látku <w>ztužili</w>."
                            }
                        },
                        {
                            "text": "The new law will <w>stiffen</w> penalties for those who break the rules.",
                            "target_lang_translations": {
                                "cs": "Nový zákon <w>zpřísní</w> tresty pro ty, kteří porušují pravidla."
                            }
                        }
                    ],
                    "synonyms": [
                        "starken"
                    ],
                    "common_phrases": [
                        "stiffen penalties"
                    ],
                    "target_lang_definitions": {
                        "cs": "Učinit něco tuhým, pevným nebo méně ohebným."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ztužit",
                                "target_lang_sense_clarification": "učinit látku nebo materiál pevnějším"
                            },
                            {
                                "target_lang_word": "zpřísnit",
                                "target_lang_sense_clarification": "učinit pravidla nebo tresty přísnějšími"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}