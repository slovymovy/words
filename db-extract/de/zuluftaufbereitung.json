                ],
                "senses": [
                    {
                        "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                        "entry_id": "3f5a8b2b-0fa1-3a54-828c-a82150e5de06",
                        "glosses": [
                            "Vorbereitung der Zuluft zur Nutzung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4284956-5186-4ddb-9f40-f23fe9fd6b79",
                                "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                                "text": "„In Klimakästen findet die Zuluftaufbereitung für die Passagiere eines Schienenfahrzeuges statt.“"
                            },
                            {
                                "example_id": "43c75a09-6505-4d21-8e17-9fe9f60c2696",
                                "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                                "text": "„In den Niederlanden ebenso wie unter hiesigen Klimabedingungen liegt das Hauptaugenmerk auf der Reduzierung der notwendigen Heizenergie der Zuluftaufbereitung.“"
                            },
                            {
                                "example_id": "18c16ec4-3805-4007-b713-52ef677ed3a0",
                                "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                                "text": "„Neben dem Coater selbst gehören die Zuluftaufbereitung, die Abluftanlage, die Steuerung, die Flüssigkeitsdosierung, die Tanks, Beschickungs- und Entleerungskomponenten und die CIP-Anlage zum LHC-Coatingsystem.“"
                            },
                            {
                                "example_id": "e8654f02-8658-44db-908e-8760aec1aa4e",
                                "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                                "text": "„Die Zuluftaufbereitung im Keller ist seit 53 Jahren in Betrieb und in einem schlechten baulichen Zustand.“"
                            },
                            {
                                "example_id": "fd066a64-ed9d-4666-b1b9-ddcdc6a4fb47",
                                "sense_id": "7aba57da-f1c2-38b3-9629-5372d9406bed",
                                "text": "„Dies ist aus dem Grund, dass eine Vielzahl von Geraeten die Zuluftaufbereitung und -verteilung uebernehmen und sich dadurch kleine Einzelgeraete und ein schlankes Verteilungssystem ergibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
