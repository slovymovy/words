{
    "word_family": [
        "steenbokantilope"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0834f65-7953-3494-9463-0c1eae5156c0",
                    "sense_definition": "Een wild berggeit (Capra ibex) met grote, achterovergebogen hoorns die in de Alpen leeft.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens onze wandeling in de Alpen zagen we plotseling een prachtige <w>steenbok</w> op de rotsen staan.",
                            "target_lang_translations": {
                                "en": "During our hike in the Alps, we suddenly saw a beautiful <w>ibex</w> standing on the rocks."
                            }
                        },
                        {
                            "text": "De <w>steenbok</w> kan moeiteloos tegen steile bergwanden opklimmen.",
                            "target_lang_translations": {
                                "en": "The <w>ibex</w> can climb steep mountain walls effortlessly."
                            }
                        }
                    ],
                    "common_phrases": [
                        "alpen steenbok"
                    ],
                    "target_lang_definitions": {
                        "en": "A wild mountain goat (Capra ibex) with large, backward-curving horns that lives in the Alps."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ibex",
                                "target_lang_sense_clarification": "wild mountain goat"
                            },
                            {
                                "target_lang_word": "Alpine ibex",
                                "target_lang_sense_clarification": "specifically Capra ibex"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c96a733-3db1-34de-b2b2-14c734ffcd4a",
                    "sense_definition": "Een kleine Afrikaanse antilope (Raphicerus campestris).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het Zuid-Afrikaanse wildpark zagen we een kleine <w>steenbok</w> tussen de struiken ritselen.",
                            "target_lang_translations": {
                                "en": "In the South African game reserve, we saw a small <w>steenbok</w> rustling in the bushes."
                            }
                        },
                        {
                            "text": "De <w>steenbok</w> is een schuw dier dat zich snel uit de voeten maakt bij gevaar.",
                            "target_lang_translations": {
                                "en": "The <w>steenbok</w> is a shy animal that quickly runs away in case of danger."
                            }
                        }
                    ],
                    "synonyms": [
                        "steenbokantilope"
                    ],
                    "target_lang_definitions": {
                        "en": "A small African antelope (Raphicerus campestris)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "steenbok",
                                "target_lang_sense_clarification": "African antelope"
                            },
                            {
                                "target_lang_word": "steinbuck",
                                "target_lang_sense_clarification": "alternative spelling for the antelope"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e837db9e-4881-3dc2-8fb5-ccaef6fefcc6",
                    "sense_definition": "Iemand die geboren is onder het sterrenbeeld Steenbok (tussen ca. 22 december en 20 januari).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astrologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn zus is een echte <w>steenbok</w>; ze is erg ambitieus en praktisch ingesteld.",
                            "target_lang_translations": {
                                "en": "My sister is a real <w>Capricorn</w>; she is very ambitious and practical."
                            }
                        },
                        {
                            "text": "Als <w>steenbok</w> houdt hij niet zo van onverwachte veranderingen.",
                            "target_lang_translations": {
                                "en": "As a <w>Capricorn</w>, he doesn't really like unexpected changes."
                            }
                        }
                    ],
                    "common_phrases": [
                        "een echte steenbok"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone born under the zodiac sign of Capricorn (between approx. December 22 and January 20)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Capricorn",
                                "target_lang_sense_clarification": "person born under this sign"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "9ccf3844-8725-32e2-97a7-38f3c8c73097",
                    "sense_definition": "Een sterrenbeeld van de dierenriem, of het bijbehorende astrologische teken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astrologie",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "In de winter is het sterrenbeeld <w>Steenbok</w> aan de nachthemel te zien.",
                            "target_lang_translations": {
                                "en": "In winter, the constellation <w>Capricornus</w> can be seen in the night sky."
                            }
                        },
                        {
                            "text": "Haar horoscoop voorspelt veel goeds voor het teken <w>Steenbok</w> deze maand.",
                            "target_lang_translations": {
                                "en": "Her horoscope predicts great things for the sign of <w>Capricorn</w> this month."
                            }
                        }
                    ],
                    "synonyms": [
                        "Cap",
                        "Capr"
                    ],
                    "common_phrases": [
                        "sterrenbeeld steenbok",
                        "teken van de steenbok"
                    ],
                    "target_lang_definitions": {
                        "en": "A constellation of the zodiac, or the corresponding astrological sign."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Capricorn",
                                "target_lang_sense_clarification": "astrological sign"
                            },
                            {
                                "target_lang_word": "Capricornus",
                                "target_lang_sense_clarification": "astronomical constellation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}