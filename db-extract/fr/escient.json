                "senses": [
                    {
                        "sense_id": "c23b52ae-f13a-3033-80b8-bacdd683c8e3",
                        "entry_id": "b09b4d62-5e02-39a8-ba7e-8d9ae4024cc0",
                        "glosses": [
                            "Pleine connaissance d’une chose."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b4ca0ace-b5e2-470a-b322-d222ce844765",
                                "sense_id": "c23b52ae-f13a-3033-80b8-bacdd683c8e3",
                                "text": "Votre cerveau est performant si vous l’utilisez à bon escient."
                            },
                            {
                                "example_id": "385fd951-b7ca-41a7-8a96-756f794fed2f",
                                "sense_id": "c23b52ae-f13a-3033-80b8-bacdd683c8e3",
                                "text": "Elle ne faisait de malentendu qu’à bon escient, et lorsque le malentendu lui paraissait utile."
                            },
                            {
                                "example_id": "d1927a5b-6e82-4b7a-8207-6a74f54c5e82",
                                "sense_id": "c23b52ae-f13a-3033-80b8-bacdd683c8e3",
                                "text": "Pourquoi nous demandez-vous cela ? fit la femme, d’un accent qui annonçait l’intention bien arrêtée de ne répondre qu’à bon escient."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e53d0b7a-479d-401d-a29c-6af68509baa7",
                        "source_entry_id": "b09b4d62-5e02-39a8-ba7e-8d9ae4024cc0",
                        "source_sense_id": "c23b52ae-f13a-3033-80b8-bacdd683c8e3",
                        "source_sense_description": "bon ou mauvais usage d’une chose",
