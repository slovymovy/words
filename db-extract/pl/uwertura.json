                    {
                        "translation_id": "e19546ec-299d-40dc-8c99-f505946b5a20",
                        "source_entry_id": "e9c40aba-3a14-3b00-86a1-839893dc9578",
                        "source_sense_id": "bfdeb8bd-ef6f-3e55-b06a-446f49f68763",
                        "target_lang_word": "Ouvertüre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ouvertüre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                        "entry_id": "4c40349b-0fe8-3949-8770-02d291a1f251",
                                        "glosses": [
                                            "instrumentales Einleitungsstück einer Oper, das üblicherweise bei noch geschlossenem Vorhang gespielt wird und oft die wichtigsten musikalischen Gedanken des Werkes bereits vorab zusammenfassend vorstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18e3da21-f432-4e4e-b524-005fddc3d30f",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "„Wie klingt das Scheitern? Beethoven führt es uns in seiner \"Coriolan\"-Ouvertüre vor. Er zieht dabei alle Register des musikalisch Geheimnisvollen, Aufgewühlten, Zerbrechlichen und schreibt eine radikal ausdrucksstarke Musik.“"
                                            },
                                            {
                                                "example_id": "a1b582b7-668f-4f71-912d-4428987e0b61",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "„In diesem Augenblick ertönten die letzten Akkorde der Ouvertüre, und man hörte den Kapellmeister mit dem Dirigentenstabe klopfen.“"
                                            },
                                            {
                                                "example_id": "c03e68ac-2c86-4367-bdcb-cd45d424ef21",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "„Gordon freute sich des voll und glänzend besetzten Hauses und ließ von seinem Umschauhalten erst ab, als der Taktstock sich erhob und die Ouvertüre begann.“"
                                            },
                                            {
                                                "example_id": "61c4ef16-e089-473f-9cbf-0f1d12cbd5b8",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "„Die Ouvertüre begann und der Vorhang flog hoch.“"
                                            },
                                            {
                                                "example_id": "69b69a07-d27e-461a-8018-546f12dfc2e0",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "Bei der Ouvertüre war das Orchester noch nicht ganz in Form."
                                            },
                                            {
                                                "example_id": "d95e5a46-229d-4c6f-b882-4673b6956d27",
                                                "sense_id": "c7e5f0ea-c566-33da-a977-f7f2ceb43c17",
                                                "text": "„Seine Schubladen stecken voller Sonaten, Lieder für Klavier und Gitarre, Messen und Ouvertüren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "984545f4-db7a-3cc6-987f-8549fc17d20c",
                                        "entry_id": "4c40349b-0fe8-3949-8770-02d291a1f251",
                                        "glosses": [
                                            "Eröffnungssatz der Suite"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9da2d6be-f183-421d-9816-83e6794257e7",
                                                "sense_id": "984545f4-db7a-3cc6-987f-8549fc17d20c",
                                                "text": "Bei der Ouvertüre war das Orchester noch nicht ganz in Form."
                                            },
                                            {
                                                "example_id": "dcc23fe9-8921-4f8d-94a2-2e4d4978e39f",
                                                "sense_id": "984545f4-db7a-3cc6-987f-8549fc17d20c",
                                                "text": "„Seine Schubladen stecken voller Sonaten, Lieder für Klavier und Gitarre, Messen und Ouvertüren.“"
                                            }
