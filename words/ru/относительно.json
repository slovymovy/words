                                "es": "Fue una tarea <w>relativamente</w> fácil para los estudiantes.",
                                "fr": "C'était une tâche <w>relativement</w> facile pour les étudiants.",
                                "zh": "这对学生来说是一项<w>相对</w>简单的任务。",
                                "de": "Das war eine <w>relativ</w> leichte Aufgabe für die Studenten."
                            }
                        },
                        {
                            "text": "Мы живём <w>относительно</w> недалеко от центра города.",
                            "target_lang_translations": {
                                "en": "We live <w>relatively</w> close to the city center.",
                                "es": "Vivimos <w>relativamente</w> cerca del centro de la ciudad.",
                                "fr": "Nous habitons <w>relativement</w> près du centre-ville.",
                                "zh": "我们住的地方距离市中心<w>相对</w>近。",
                                "de": "Wir wohnen <w>relativ</w> nah am Stadtzentrum."
                            }
