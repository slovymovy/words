{
    "word_family": [
        "kwalijk",
        "kwelgeest",
        "kwelling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16ea1df5-46f6-3be0-9a3d-5dff12018a48",
                    "sense_definition": "Een lichamelijke of psychische aandoening of ziekte, vaak van chronische of minder ernstige aard.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gezondheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het wordt al eeuwenlang aangeprezen omdat het tegen alle <w>kwalen</w> zou helpen.",
                            "target_lang_translations": {
                                "en": "It has been praised for centuries because it is said to help against all <w>ailments</w>."
                            }
                        },
                        {
                            "text": "Ouderdom komt helaas vaak met verschillende kleine <w>kwalen</w>.",
                            "target_lang_translations": {
                                "en": "Old age unfortunately often comes with various minor <w>complaints</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tegen alle kwalen",
                        "kleine kwalen",
                        "last van kwalen"
                    ],
                    "target_lang_definitions": {
                        "en": "A physical or mental condition or disease, often of a chronic or less serious nature."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ailment",
                                "target_lang_sense_clarification": "a minor or chronic physical disorder"
                            },
                            {
                                "target_lang_word": "complaint",
                                "target_lang_sense_clarification": "a medical condition or illness, often minor"
                            },
                            {
                                "target_lang_word": "malady",
                                "target_lang_sense_clarification": "a disease or ailment, often used more formally"
                            },
                            {
                                "target_lang_word": "illness",
                                "target_lang_sense_clarification": "a general state of being unwell"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6c59108-48ed-3b35-9865-6ef11d9871aa",
                    "sense_definition": "Een toestand van grote geestelijke of lichamelijke pijn of lijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lijden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voortdurende onzekerheid over de toekomst was voor hem een ware <w>kwaal</w>.",
                            "target_lang_translations": {
                                "en": "The constant uncertainty about the future was a true <w>affliction</w> for him."
                            }
                        },
                        {
                            "text": "Zij probeerde haar innerlijke <w>kwaal</w> te verbergen voor de buitenwereld.",
                            "target_lang_translations": {
                                "en": "She tried to hide her inner <w>torment</w> from the outside world."
                            }
                        }
                    ],
                    "synonyms": [
                        "kwelling"
                    ],
                    "common_phrases": [
                        "een ware kwaal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary or formal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A state of great mental or physical pain or suffering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "affliction",
                                "target_lang_sense_clarification": "something that causes great pain or suffering"
                            },
                            {
                                "target_lang_word": "torment",
                                "target_lang_sense_clarification": "severe physical or mental suffering"
                            },
                            {
                                "target_lang_word": "scourge",
                                "target_lang_sense_clarification": "a person or thing that causes great trouble or suffering"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}