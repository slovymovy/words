    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f6d1f9e-fc83-3ed7-9765-2ded7ffaca73",
                    "sense_definition": "Simple past and past participle of <w>crucify</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thousands of rebels were <w>crucified</w> by the Romans after the revolt was crushed.",
                            "target_lang_translations": {
                                "zh": "起义被镇压后，成千上万的叛乱者被罗马人<w>钉死在十字架上</w>。"
                            }
                        },
                        {
                            "text": "They <w>crucified</w> him for his beliefs during the rebellion.",
                            "target_lang_translations": {
                                "zh": "在叛乱期间，他们因为他的信仰将他<w>钉在十字架上</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle of crucify"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 crucify 的过去式和过去分词，指将人钉在十字架上处死。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "钉死在十字架上",
                                "target_lang_sense_clarification": "指通过钉在十字架上执行死刑。"
                            },
                            {
                                "target_lang_word": "钉在十字架上",
                                "target_lang_sense_clarification": "指被处以十字架刑罚。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ad036973-45a4-3e8d-af5c-c86f40ec7d09",
                    "sense_definition": "Having been subjected to the act of crucifixion",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crucified</w> man was left on the cross until sunset.",
                            "target_lang_translations": {
                                "zh": "那名<w>被钉在十字架上</w>的男子直到日落时分仍留在十字架上。"
                            }
                        },
                        {
                            "text": "Ancient texts describe the suffering of the <w>crucified</w> prisoners.",
                            "target_lang_translations": {
                                "zh": "古代文献描述了那些<w>被钉在十字架上</w>的囚犯所遭受的痛苦。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "形容词，指已经被钉在十字架上的人或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被钉在十字架上的",
                                "target_lang_sense_clarification": "描述遭受了十字架刑罚的状态。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
