                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "Something that creates a division, gap or distance between things."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "245b88f6-a4fc-4db1-a398-cb065c376a6e",
                                                "sense_id": "ab32c3b5-82b6-32bb-9566-2623e6492703",
                                                "text": "It is one of the ironies of capital cities that each acts as a symbol of its nation, and yet few are even remotely representative of it. London has always set itself apart from the rest of Britain — but political, economic and social trends are conspiring to drive that wedge deeper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67448a88-0bb7-3ed5-b2c0-82fb66029f39",
                                        "entry_id": "f5316aae-52d7-3d89-9661-eeec07603458",
                                        "glosses": [
                                            "A five-sided polyhedron with a rectangular base, two rectangular or trapezoidal sides meeting in an edge, and two triangular ends."
                                        ],
