                "translations": [
                    {
                        "translation_id": "5f82494a-f651-4f9e-8ee4-644ab49953df",
                        "source_entry_id": "f789c6b0-280d-37ce-ba1d-8f887dfe0218",
                        "source_sense_id": "74a936af-2af3-35fc-b05c-dd06b60a8bd6",
                        "target_lang_word": "Kryptogramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryptogramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fbc8d54-d511-3cab-be97-6e183c378129",
                                        "entry_id": "257d42a5-a8c3-38b4-ac30-a2d889ca7914",
                                        "glosses": [
                                            "verschlüsselter, schriftlicher Text"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "346feecf-6611-4fda-94bf-5e94b3ff7ef4",
                                                "sense_id": "8fbc8d54-d511-3cab-be97-6e183c378129",
                                                "text": "„Der ominöse Killer verschickte insgesamt vier Kryptogramme, die allesamt merkwürdige Symbole enthielten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4850734e-a6b5-4d17-af9a-a6174a79188e",
                        "source_entry_id": "f789c6b0-280d-37ce-ba1d-8f887dfe0218",
                        "source_sense_id": "74a936af-2af3-35fc-b05c-dd06b60a8bd6",
                        "target_lang_word": "cryptogram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptogram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                        "entry_id": "529fca24-ddb1-33d4-aba5-2e12d7247e7f",
                                        "glosses": [
                                            "Encrypted text."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "912d6e2e-962e-41d7-8e48-78f486593737",
                                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                                "text": "It's a big help in solving cryptograms if you know how a cryptogram is constructed. The constructor normally uses two alphabets, one for plaintext, one for the substitute cipher letters."
                                            },
                                            {
                                                "example_id": "1bf6d5b4-f2ba-4d22-8323-b535fa2fba0f",
                                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                                "text": "To anyone who does not know the key, the five characters of the cryptogram are different but the genuine receiver is in no danger of confusion."
                                            },
                                            {
                                                "example_id": "0faa99a4-57f2-463e-b8fa-1d574155685c",
                                                "sense_id": "e8eb1847-ed6b-35dc-9325-c19a07d3e3d0",
                                                "text": "Indeed, Willaert was unable to read Charles's musical notation because it was actually a musical cryptogram passing for a madrigal, making absolutely no sense to a mere musician's naked eye, despite his towering talent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0373b19-e768-3154-ac5a-b41a06ce5876",
                                        "entry_id": "529fca24-ddb1-33d4-aba5-2e12d7247e7f",
                                        "glosses": [
                                            "A type of word puzzle in which text encoded by a simple cipher is to be decoded."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b58ff596-c92e-4db1-a012-b58f973166ce",
                                                "sense_id": "a0373b19-e768-3154-ac5a-b41a06ce5876",
                                                "text": "You already know this if you are an amateur codebreaker. On the comics pages of many newspapers, you will find a little puzzle known as a cryptogram. It's usually a famous quotation that has been encrypted in a very straightforward way […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9624fc60-57e5-4819-9b7a-c1bfd44ecb96",
                        "source_entry_id": "f789c6b0-280d-37ce-ba1d-8f887dfe0218",
                        "source_sense_id": "74a936af-2af3-35fc-b05c-dd06b60a8bd6",
                        "target_lang_word": "cryptogramme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cryptogramme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                        "entry_id": "663f447a-4852-307a-83d2-ddb9ec327132",
                                        "glosses": [
                                            "Message chiffré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c0a261a-bc3c-4026-8ad3-e6e341944cf3",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Jules Verne utilise plusieurs fois les cryptogrammes dans ses romans. Dans La Jangada, un juge doit déchiffrer un message pour sauver un condamné. Dans Voyage au centre de la Terre, le professeur Lidenbrock doit résoudre le mystère d'un parchemin sur lequel est inscrit un message incompréhensible en signes runiques."
                                            },
                                            {
                                                "example_id": "4a00e3c3-a3ed-4d46-8200-9f3db2b03cb7",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "On soupçonna dès lors l’anagramme de Grosser d’être une pure coïncidence, et l’hypothèse chrétienne fut contestée par ceux qui jugeaient improbable, à cette date, la création d’un tel cryptogramme par des chrétiens, voire l’existence même d’une communauté chrétienne à Pompéi."
                                            },
                                            {
                                                "example_id": "f747de58-b47a-41a5-99ed-5ce60224d61c",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Il faut évoquer ici le thème récurrent du « cryptogramme ». Certains romans commencent par la découverte d’un document écrit – incomplet ou chiffré– dont le déchiffrement va jouer un rôle décisif dans l’affabulation."
                                            },
                                            {
                                                "example_id": "ca16393d-a32e-4ccf-829b-22f057a6a4d7",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Je supposai donc que le cryptogramme était anglais"
                                            },
                                            {
                                                "example_id": "92f9df37-43de-44ea-bf1a-ed7564192ac8",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Une autre mention intéressante est celle des nombres dont l’emploi dans les cryptogrammes nous rappelle les origines mathématiques du chiffrement."
                                            },
                                            {
                                                "example_id": "a7eaacf1-b14b-4772-9dc9-de06e4e93396",
                                                "sense_id": "3542068c-d15f-3b0e-ae15-231e3989befb",
                                                "text": "Au terme du travail de déchiffrement, pas moins de 2 900 cryptogrammes soviétiques furent décodés, dont 49 avaient pour objet le projet Manhattan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "986a7893-530f-34b5-ad14-61d70511d79a",
                                        "entry_id": "663f447a-4852-307a-83d2-ddb9ec327132",
                                        "glosses": [
                                            "Problème à résoudre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c28e90e8-9f9b-427f-a043-f6725b564357",
                                                "sense_id": "986a7893-530f-34b5-ad14-61d70511d79a",
                                                "text": "Les passions sont toutes bonnes de leur nature disait Descartes. Il faut les comprendre, au vrai, affirme Fourier toutes « sans excepter celles que la morale fait passer pour les plus indignes égarements de l'esprit et des sens, constituent un cryptogramme indivisible que l'homme est appelé à déchiffrer»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
