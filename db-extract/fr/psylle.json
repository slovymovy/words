                "senses": [
                    {
                        "sense_id": "2e7b1c3d-8a0a-3681-b9ae-212b6be94160",
                        "entry_id": "cf04c9c4-1845-3b48-a0e3-d1c851285611",
                        "glosses": [
                            "Charmeur de serpents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25edf0c1-2c3c-4297-aa50-e5439aa29277",
                                "sense_id": "2e7b1c3d-8a0a-3681-b9ae-212b6be94160",
                                "text": "Le psylle, à ma prière, entra dans ma chambre, en fit le tour et revint en disant qu'il y avait une vipère."
                            },
                            {
                                "example_id": "31ab3133-316b-4906-8366-68d43662d27b",
                                "sense_id": "2e7b1c3d-8a0a-3681-b9ae-212b6be94160",
                                "text": "Il semble hermétique à l'excitation générale que provoque la musique. Soit leur pouvoir de psylle pour lobotomisés ne fonctionne pas sur tout le monde, soit celui-là est sourd."
                            },
                            {
                                "example_id": "35bf7fda-8780-4ec2-bc56-387841ffe775",
                                "sense_id": "2e7b1c3d-8a0a-3681-b9ae-212b6be94160",
                                "text": "Il y a aussi des chanteurs, des lutteurs et des psylles qui ont de gros serpents roulés autour du cou."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
