                    {
                        "sense_id": "e65e7577-8ce8-3998-a34b-80d56bc8c29c",
                        "entry_id": "fc09b76c-c2b8-3549-aeea-d1b0a76cf467",
                        "glosses": [
                            "Operating or functioning in two directions (usually opposite)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "34431ac3-c5c5-42b6-9b3c-868f878117d5",
                                "sense_id": "e65e7577-8ce8-3998-a34b-80d56bc8c29c",
                                "text": "However, statistical modelling paints a different picture. We found that the influence of mental health and ideology on harmful attitudes and beliefs was two-and-a-half times stronger than networking. We also found that mental health and ideology shared a potential bidirectional relationship, with poor mental health causing greater buy-in to ideology and vice versa."
                            }
                        ]
                    }
                ],
