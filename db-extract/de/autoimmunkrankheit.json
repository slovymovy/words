                        "entry_id": "2d68f6b5-f6d8-3344-b54d-75e8b52c4655",
                        "glosses": [
                            "Krankheit, bei der sich das Immunsystem gegen den eigenen Körper richtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "977b18ea-874e-4f82-ba02-6c8be23046e9",
                                "sense_id": "11ae0121-43d3-3b27-abfb-143d693e3fff",
                                "text": "Multiple Sklerose ist eine Autoimmunkrankheit."
                            },
                            {
                                "example_id": "2deccb85-0b58-4a7a-9c8c-75ca1c0142df",
                                "sense_id": "11ae0121-43d3-3b27-abfb-143d693e3fff",
                                "text": "„1935 war bei Klee die Autoimmunkrankheit Sklerodermie ausgebrochen, die zu einer Verhärtung der Haut und des Bindegewebes führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
