                                "target_senses": [
                                    {
                                        "sense_id": "c983ac00-e066-3a88-ab23-46af987fe1d6",
                                        "entry_id": "23315d87-e671-3e90-be31-bf05401f7a8f",
                                        "glosses": [
                                            "Person, die eine andere (oder mehrere) beherrscht/unterdrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02fb4dc8-c4f7-48b6-aa73-21000b41c994",
                                                "sense_id": "c983ac00-e066-3a88-ab23-46af987fe1d6",
                                                "text": "„Tokeah, wie wir gesehen haben, war ein Mann, ergraut in Gefahren und jenem Mißtrauen, das den gedrückten schwächern Indianern gegenüber ihren stärkern weißen Unterrückern natürlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "614c5558-ac15-4517-9ee3-f4c6e44f3256",
                        "source_entry_id": "6c74c39c-60ce-319c-98de-7192e4fdaca1",
                        "source_sense_id": "bec91fb3-f9b1-3008-ad0f-af3da474fbba",
                        "target_lang_word": "oppressor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
