                "senses": [
                    {
                        "sense_id": "f942978c-ba7b-3b37-a0a6-ca25cdaf4217",
                        "entry_id": "a842527f-d69b-3f95-b136-0d186507fc4a",
                        "glosses": [
                            "kugelförmiger Bauteil einer Kugelkopfschreibmaschine, auf dem die Schriftzeichen angebracht sind"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "582fdf0a-4b89-48b5-a471-116edffdfa32",
                                "sense_id": "f942978c-ba7b-3b37-a0a6-ca25cdaf4217",
                                "text": "„Er konnte dort tagelang vor seiner Schreibmaschine sitzen, einer elektrischen IBM mit Kugelkopf, dort saß er ebenso fest verwachsen wie die Wurzeln unter dem Dach, und wenn er erschöpft war, befreite er sich vorsichtig von den Wortwurzeln, warf sich aufs Sofa und schlief zufrieden unter einer gewebten Decke ein.“"
                            }
                        ],
