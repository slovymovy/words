                "senses": [
                    {
                        "sense_id": "6556f758-32a2-37b8-8081-92c5ec82c1c5",
                        "entry_id": "649f2489-78ef-3065-a578-b002b54d7cc3",
                        "glosses": [
                            "bezüglich des südlichen Afrikas ein mit Bäumen durchsetztes Grasland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6c5bed4-84eb-4689-a6f5-88c2c2a20e3d",
                                "sense_id": "6556f758-32a2-37b8-8081-92c5ec82c1c5",
                                "text": "Unser Camp im Hlane Wildpark /Swaziland ist umgeben von herrlichem Afrikanischen Buschveld."
                            },
                            {
                                "example_id": "09e156af-348d-46b9-b2d3-1ec887929f6d",
                                "sense_id": "6556f758-32a2-37b8-8081-92c5ec82c1c5",
                                "text": "Der Nordwesten Simbabwes besteht hauptsächlich aus Plateaus, bewachsen mit Buschveld und unterbrochen von kleineren, rauen Felsauswüchsen und glattgeschliffenen Felsrücken, die eine abwechslungsreiche Landschaft entstehen lassen."
                            },
                            {
                                "example_id": "a3c78381-b354-45fd-8a91-eeb12e24bab1",
                                "sense_id": "6556f758-32a2-37b8-8081-92c5ec82c1c5",
                                "text": "Entlang des unteren Okavango lebte als wichtigster Stamm der der Mbukushu, während in dem dazwischen liegenden Buschveld die Buschmänner ein Auskommen suchten. (Bruchmann, Rainer D.K.: Caprivi ein afrikanischer Krisenherd, Selbstverlag, Northcliff/RSA, 2001)"
                            },
                            {
                                "example_id": "fe569861-e29a-43fa-abf7-5d81c29a0816",
                                "sense_id": "6556f758-32a2-37b8-8081-92c5ec82c1c5",
                                "text": "Durch Wälder und Wiesen, über Steppen und Savannen, durch lichtes Buschveld und fast undurchdringliche Dickungen zieht bei Tag und bei Nacht in aller Welt eine unfaßbare Vielfalt von Wildtieren ein Netz von Spuren und Fährten. (Strassen, Helmut zur: Wildspore Wildfährten Game Spoor Namibia, Gamsberg Macmillan, Windhoek o. J. [die erste Auflage erschien 1995])"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "73beaae1-417d-3955-a909-481f1062c694",
                        "entry_id": "649f2489-78ef-3065-a578-b002b54d7cc3",
                        "glosses": [
                            "bezüglich Südafrika östlich und nordöstlich gelegene Savannenlandschaft, die sich über Teile des Highvelds und über das Lowveld erstreckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4db7417d-f561-4b02-b621-dab1a2b6341d",
                                "sense_id": "73beaae1-417d-3955-a909-481f1062c694",
                                "text": "Im Grasland des Buschveld wachsen nur vereinzelt Bäume und Büsche."
                            },
                            {
                                "example_id": "a014b812-5f16-4806-869c-e04ca6fb4d74",
                                "sense_id": "73beaae1-417d-3955-a909-481f1062c694",
                                "text": "Das Landschaftsbild ist größtenteils von Savannen-Buschveld mit niedrigen Gräsern und Buschvegetation geprägt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
