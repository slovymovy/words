                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f0ee852-93d6-3124-8481-cea43b692c25",
                        "entry_id": "530453b1-d7c2-36e5-b39f-1ac80926d405",
                        "glosses": [
                            "A local ruler or official in various parts of central and eastern Europe, especially early semi-independent rulers of Transylvania."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2815db63-a72f-4caa-b04b-ae0af1f72de4",
                                "sense_id": "1f0ee852-93d6-3124-8481-cea43b692c25",
                                "text": "George Sechell[…], having been defeated in a battle by the Vayvoda of Transylvania, and taken Prisoner, was for three days together tied naked to a wooden horse, exposed to all manner of tortures, any man might devise against him[…]."
                            },
                            {
                                "example_id": "38b08fad-3e5f-48f5-acab-812f09b6d724",
                                "sense_id": "1f0ee852-93d6-3124-8481-cea43b692c25",
                                "text": "Who was it but one of my own race who as Voivode crossed the Danube and beat the Turk on his own ground? This was a Dracula indeed!"
                            }
                        ]
                    },
                    {
                        "sense_id": "3e6694e0-ddd5-3ee3-b845-b20212ace255",
                        "entry_id": "530453b1-d7c2-36e5-b39f-1ac80926d405",
                        "glosses": [
                            "An administrative chief in modern Poland."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
