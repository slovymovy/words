                        "source_entry_id": "4521a4f9-666b-3b61-b5d7-1c5bb302b237",
                        "source_sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                        "source_sense_description": "Zeitraum (in den Tropen), in dem besonders viel Regen fällt",
                        "target_lang_word": "regentijd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regentijd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                                        "entry_id": "01dc11f3-8ed9-3dc9-bd6c-47cacbf0405a",
                                        "glosses": [
                                            "tijd van het jaar dat het veel regent in de tropen (april tot september in het noorden, van oktober tot maart in het zuiden)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c88175-6429-4608-9b9b-f6e923dd37a9",
                                                "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                                                "text": "De regentijd in India duurt van juni tot september en de onweersfronten zorgen jaarlijks voor vele slachtoffers."
                                            },
                                            {
                                                "example_id": "e0d00d4a-a44c-401c-bad3-e79a7c294294",
                                                "sense_id": "7afff0dc-c795-3664-9aa9-17fa34e21482",
                                                "text": "De autoriteiten gaan ervan uit dat het ergste leed geleden is wanneer de regentijd intreedt, over een maand. Het is onwaarschijnlijk dat de bevuiling de stenen van het monument van de liefde op den duur echt aantast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "583b582e-9458-4baa-ba2c-2b51f27b2fbe",
                        "source_entry_id": "4521a4f9-666b-3b61-b5d7-1c5bb302b237",
                        "source_sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                        "source_sense_description": "Zeitraum (in den Tropen), in dem besonders viel Regen fällt",
                        "target_lang_word": "pora deszczowa",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pora deszczowa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f50b732-54a0-3134-ab6a-2af95a9ed8db",
                                        "entry_id": "381dcff1-1e14-3fb7-8617-bff4e2589a1d",
                                        "glosses": [
                                            "jedna z dwóch pór roku w klimacie podzwrotnikowym charakteryzująca się bardzo dużymi opadami atmosferycznymi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325410cb-304b-4ee1-8b55-29692ea01927",
                                                "sense_id": "2f50b732-54a0-3134-ab6a-2af95a9ed8db",
                                                "text": "A nie można przecież zapominać o porze deszczowej; trzeba niezłej siły, żeby się oprzeć wodzie lecącej z kilkunastometrowych gór i to przez kilka miesięcy z rzędu codziennie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "2aaf3394-8601-3c6f-a6fc-742c52d30b5b",
                                        "entry_id": "381dcff1-1e14-3fb7-8617-bff4e2589a1d",
                                        "glosses": [
                                            "okres opadów deszczu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8b0058a-9967-45e5-a115-52e8d1c3c3a8",
                                                "sense_id": "2aaf3394-8601-3c6f-a6fc-742c52d30b5b",
                                                "text": "Jeżeli, zwłaszcza w porze deszczowej, z ustępów zalatuje odór, trzeba je zasypać i wykopać nowe"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
