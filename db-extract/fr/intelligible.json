                                                "sense_id": "875727aa-6995-34f5-9f6f-c72d11d562d8",
                                                "text": "Der Sterbende sagte mit kaum vernehmbarer Stimme „Mehr Licht!“."
                                            },
                                            {
                                                "example_id": "05785935-681f-4b14-83f0-8cc82d090eba",
                                                "sense_id": "875727aa-6995-34f5-9f6f-c72d11d562d8",
                                                "text": "Wer gesund genug ist, vor Gericht vernommen zu werden, wird nicht als „vernehmbar“ bezeichnet, sondern als „vernehmungsfähig“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
