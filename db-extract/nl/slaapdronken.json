                "senses": [
                    {
                        "sense_id": "86e7757a-7b57-3e77-b5a7-1b0c7872182c",
                        "entry_id": "79b19639-e48a-3106-b6bd-b28b5e835eb1",
                        "glosses": [
                            "nog niet helemaal helder wakker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7cf5b2e-df72-4bf4-9f51-b92c10c49c5c",
                                "sense_id": "86e7757a-7b57-3e77-b5a7-1b0c7872182c",
                                "text": "De controle vond zaterdag tussen 05.30 en 08.00 uur plaats op het Sint-Annaplein in Gent. ‘Op een tijdstip dat sommigen slaapdronken naar de bakker sloffen, kruipen anderen beschonken achter het stuur van hun wagen."
                            },
                            {
                                "example_id": "9534b697-200a-4270-9001-4464bb7a342e",
                                "sense_id": "86e7757a-7b57-3e77-b5a7-1b0c7872182c",
                                "text": "Hij was nog slaapdronken toen zijn buurman hem rond half 11 's avonds wakker maakte."
                            },
                            {
                                "example_id": "ee97731f-7dee-456c-a080-976305a9c52e",
                                "sense_id": "86e7757a-7b57-3e77-b5a7-1b0c7872182c",
                                "text": "Slaapdronken zat ik op de bank naar mijn laptop te staren. Door het tijdsverschil met Australië was ik om tien voor zes ’s ochtends uit bed gestapt om de Formule 1 te kunnen zien. De 17-jarige Max Verstappen ging zich als ‘jongste coureur aller tijden’ meten met de grote mannen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1945fcde-a36f-46f3-a1c1-78bdbbc15b17",
                        "source_entry_id": "79b19639-e48a-3106-b6bd-b28b5e835eb1",
                        "source_sense_id": "86e7757a-7b57-3e77-b5a7-1b0c7872182c",
