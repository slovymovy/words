                ],
                "senses": [
                    {
                        "sense_id": "d89c3549-b7d4-3c56-9513-b3dfba107d3a",
                        "entry_id": "7d8574f3-1d1b-3fcf-b83c-fd67d4bca3ac",
                        "glosses": [
                            "sehr müde"
                        ],
                        "tags": [
                            "colloquial",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "fd036fe6-7d79-4fa5-a29f-dbbbf779f4b7",
                                "sense_id": "d89c3549-b7d4-3c56-9513-b3dfba107d3a",
                                "text": "„Sie hatte nicht gemerkt, dass sie eingeschlafen war. Das Brausen der Rotoren muss sie eingelullt haben. Sie muss offenbar wirklich scheißmüde sein.“"
                            },
                            {
                                "example_id": "2b496b90-dc02-4dce-9afc-d257f9f45943",
                                "sense_id": "d89c3549-b7d4-3c56-9513-b3dfba107d3a",
                                "text": "„Was ihn allerdings nicht besonders freute oder mit Stolz erfüllte, nein, jetzt um drei Uhr nachts war er schlicht und einfach nur noch scheißmüde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
