                    },
                    {
                        "translation_id": "f87f91f3-fdb9-45ac-a3d7-0cf2dbadd3fd",
                        "source_entry_id": "27111d8c-b950-3465-8236-1ccedf309ad5",
                        "source_sense_id": "91039229-75ac-3e57-bc1c-7a3c40c3de47",
                        "source_sense_description": "elektronische en mechanische delen in en om computersystemen",
                        "target_lang_word": "hardware",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hardware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a5fb0a-9436-379c-bb47-f68ac5f76825",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "Fixtures, equipment, fasteners, tools, and devices used for general-purpose construction and repair of a structure or object. Also such equipment as sold as stock by a store of the same name, e.g. hardware store."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31fa64a7-63bf-4f4f-b4be-5291f9bd8dea",
                                                "sense_id": "62a5fb0a-9436-379c-bb47-f68ac5f76825",
                                                "text": "He needed a hammer, nails, screws, nuts, bolts and other assorted hardware, so he went to the hardware store."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40111ff8-a2ef-34ed-a8bf-bf54d9c9ce2a",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "Equipment."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f49db4d-af85-45b2-afbd-12b5f6ea6fe1",
                                                "sense_id": "40111ff8-a2ef-34ed-a8bf-bf54d9c9ce2a",
                                                "text": "military hardware"
                                            },
                                            {
                                                "example_id": "c06394a0-7024-41c8-bc2d-71467ab53435",
                                                "sense_id": "40111ff8-a2ef-34ed-a8bf-bf54d9c9ce2a",
                                                "text": "BOWEN: The monster trucks of Mars rovers, joke scientists, equipped with an array of sophisticated hardware to look for signs of water and answer scientists questions."
                                            },
                                            {
                                                "example_id": "026f1f27-89c5-4f83-86c5-44ee36b3ebd3",
                                                "sense_id": "40111ff8-a2ef-34ed-a8bf-bf54d9c9ce2a",
                                                "text": "It is one thing to see an intercooler as a simple entry in a textbook, but to witness the actual hardware as it crawled down the road was awe-inspiring."
                                            },
                                            {
                                                "example_id": "b63db6ba-adfb-42c0-90b7-3f36f8f4bc41",
                                                "sense_id": "40111ff8-a2ef-34ed-a8bf-bf54d9c9ce2a",
                                                "text": "Smaller, turbocharged engines are one way to increase engine efficiency by 8 to 10 percent, but the extra hardware is expensive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b85bfc-a3e7-3524-bb38-e43a50bb1fa3",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "The part of a computer that is fixed and cannot be altered without replacement or physical modification; motherboard, expansion cards, etc. Compare software."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c049ad0-7711-4303-aca7-2a234a453db0",
                                                "sense_id": "a2b85bfc-a3e7-3524-bb38-e43a50bb1fa3",
                                                "text": "Hardware is the generally accepted colloquism for anything inside a computer other than an engineer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "220a480f-0dd4-3835-bf47-e45fbdde2e18",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "Electronic equipment."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1064be5a-d56f-364c-b780-3ed53e15efab",
                                        "entry_id": "21942f0c-39a6-374e-99a0-e6afd774b98e",
                                        "glosses": [
                                            "Metal implements."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f61b6722-165e-484d-9a0e-14a463bf9ecc",
                                                "sense_id": "1064be5a-d56f-364c-b780-3ed53e15efab",
                                                "text": "The designers have put their logo on the hardware of this bag here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a39f820f-8abc-3976-9985-426448c27fd9",
