                "senses": [
                    {
                        "sense_id": "5d6b0b26-15de-3b04-aece-cf1e214eb607",
                        "entry_id": "c9ad02f0-15f0-3f5d-8924-73d75dea1ae5",
                        "glosses": [
                            "Amt und Würde der Duumvirn"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "021ca493-fd74-42c6-a763-825daa3897c7",
                                "sense_id": "5d6b0b26-15de-3b04-aece-cf1e214eb607",
                                "text": "„Den Abschluß des cursus honorum bildete der Duumvirat, eventuell mit zensorischen Vollmachten.“"
                            },
                            {
                                "example_id": "35c99453-3fb3-4313-bb85-0ed5f4932bb6",
                                "sense_id": "5d6b0b26-15de-3b04-aece-cf1e214eb607",
                                "text": "„Der Duumvirat konnte aber auch ehrenhalber einer Person übertragen werden, die nicht einmal Bürger der Stadt war.“"
                            },
                            {
                                "example_id": "a6f8699f-9c3c-49d7-afd1-645e8d26d67c",
                                "sense_id": "5d6b0b26-15de-3b04-aece-cf1e214eb607",
                                "text": "„In den venusinischen Fasten folgt der Quästur der Duumvirat, ob aber die Ädilität vorher bekleidet wurde, ist fraglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
