                "senses": [
                    {
                        "sense_id": "cffd5734-8973-3bb9-92b9-ecbeb106eb60",
                        "entry_id": "88a0c4cf-2620-352b-a25a-2bd0c3498206",
                        "glosses": [
                            "Constituer la cime de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5313e9d-49cb-4617-b82f-fff32b95dd50",
                                "sense_id": "cffd5734-8973-3bb9-92b9-ecbeb106eb60",
                                "text": "La légende disait que nul mieux que lui ne connaissait le « Coudreau », les « Quatre Frères », l’étang de « l’Ardonnière », celui du « Carroir » ou l’étang de « Gorgeat », sans oublier les soixante hectares d’eau de la « mer rouge », qui s’étendent au pied de ce château du Bouchet qui domine toute la région, du haut de la seule butte qui la cime."
                            }
                        ]
                    },
                    {
                        "sense_id": "7eca311f-b62c-388d-b648-db81dbdaf30d",
                        "entry_id": "88a0c4cf-2620-352b-a25a-2bd0c3498206",
                        "glosses": [
                            "Utiliser une ou plusieurs figures comme cimier dans les ornements extérieurs des armoiries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf5826f-98e9-4d10-97d3-952d0ff224dd",
                                "sense_id": "7eca311f-b62c-388d-b648-db81dbdaf30d",
                                "text": "Gaucher de Monteil, 1335, cime d’une tête de cheval entre deux damoiselles."
                            },
                            {
                                "example_id": "f196cd21-e039-45ea-82db-ccfc71a57337",
                                "sense_id": "7eca311f-b62c-388d-b648-db81dbdaf30d",
                                "text": "Les seigneurs de Sars, de Ville, au XVe siècle, ciment de deux serres."
                            }
                        ]
                    }
