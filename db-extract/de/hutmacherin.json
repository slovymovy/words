                        "examples": [
                            {
                                "example_id": "15f99a7a-7a28-4bea-a8b7-eb5638b8f5cd",
                                "sense_id": "9a7a07a7-a4a1-3ea6-af7e-07886931ef9d",
                                "text": "„Die Bälge und wertvollen Schwanzfedern schickt er heim zu seiner Mutter, einer Hutmacherin.“"
