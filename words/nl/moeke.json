    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cfb035a-18c8-342e-a26d-8a9667a689c1",
                    "sense_definition": "Verkleinwoord van <w>moe</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn lieve <w>moeke</w> bakt altijd de lekkerste appeltaart voor ons.",
                            "target_lang_translations": {
                                "fr": "Ma chère <w>maman</w> prépare toujours la meilleure tarte aux pommes pour nous."
                            }
                        },
                        {
                            "text": "Het kleine kind riep enthousiast naar haar <w>moeke</w> in de tuin.",
                            "target_lang_translations": {
                                "fr": "Le petit enfant a appelé avec enthousiasme sa <w>maman</w> dans le jardin."
                            }
                        }
                    ],
                    "synonyms": [
                        "moesje",
                        "mama",
                        "mammie"
                    ],
                    "target_lang_definitions": {
                        "fr": "Diminutif affectueux pour désigner une maman."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "maman",
                                "target_lang_sense_clarification": "terme affectueux courant pour désigner une mère"
                            },
                            {
                                "target_lang_word": "petite maman",
                                "target_lang_sense_clarification": "traduction littérale du diminutif affectueux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bfd3903a-961b-3e3f-a2af-384e71627aa9",
                    "sense_definition": "Ouderwetse of informele benaming voor een moeder.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "familie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die oude <w>moeke</w> zorgt nog steeds voor al haar kleinkinderen.",
                            "target_lang_translations": {
                                "fr": "Cette <w>vieille dame</w> s'occupe encore de tous ses petits-enfants."
                            }
                        },
                        {
                            "text": "Vroeger noemde iedereen in het dorp haar gewoon <w>moeke</w>.",
                            "target_lang_translations": {
                                "fr": "Autrefois, tout le monde au village l'appelait simplement <w>maman</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ma",
                        "mam",
                        "mama"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Wordt vaak als ouderwets of informeel ervaren."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Terme familier ou vieilli pour désigner une mère."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "maman",
                                "target_lang_sense_clarification": "terme courant et informel"
                            },
                            {
                                "target_lang_word": "ma",
                                "target_lang_sense_clarification": "terme très familier et parfois vieilli"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df39a8eb-28bd-3e15-9834-5f4b1d3f82cf",
                    "sense_definition": "Vrouw die zich overmatig inspant voor het huishouden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "huishouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ze gedraagt zich als een echte <w>moeke</w> die de hele dag alleen maar poetst.",
                            "target_lang_translations": {
                                "fr": "Elle se comporte comme une vraie <w>ménagère</w> qui ne fait que nettoyer toute la journée."
                            }
                        },
                        {
                            "text": "Hij zoekt een <w>moeke</w> die het hele huishouden voor hem regelt.",
                            "target_lang_translations": {
                                "fr": "Il cherche une <w>ménagère</w> qui gère tout le foyer pour lui."
                            }
                        }
                    ],
                    "synonyms": [
                        "huissloof",
                        "sloof"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Kan een negatieve of neerbuigende bijklank hebben."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Femme qui se consacre excessivement aux tâches ménagères."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "ménagère",
                                "target_lang_sense_clarification": "terme neutre pour quelqu'un qui s'occupe du ménage"
                            },
                            {
                                "target_lang_word": "esclave domestique",
                                "target_lang_sense_clarification": "terme péjoratif pour quelqu'un qui travaille trop à la maison"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d3b7146-9227-3eee-a597-5f63781b66d8",
                    "sense_definition": "Een bejaarde vrouw.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "leeftijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die lieve <w>moeke</w> zit elke middag op het bankje in het park.",
                            "target_lang_translations": {
                                "fr": "Cette gentille <w>vieille dame</w> est assise chaque après-midi sur le banc dans le parc."
                            }
                        },
                        {
                            "text": "De hoogbejaarde <w>moeke</w> vertelde prachtige verhalen over vroeger.",
                            "target_lang_translations": {
                                "fr": "La <w>vieille dame</w> très âgée racontait de magnifiques histoires d'autrefois."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informeel en soms wat neerbuigend."
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Une femme âgée."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "vieille dame",
                                "target_lang_sense_clarification": "terme respectueux pour une femme âgée"
                            },
                            {
                                "target_lang_word": "bonne femme",
                                "target_lang_sense_clarification": "terme familier, parfois légèrement condescendant"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}