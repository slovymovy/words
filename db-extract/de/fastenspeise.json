                            {
                                "example_id": "79645cf5-9c3b-4ca0-8ac0-0fcba97b75c2",
                                "sense_id": "47d8f9e5-88c6-31e2-9c05-16fdbebc4152",
                                "text": "Was als Fastenspeise gilt, unterliegt religiösen Regeln. Manche Genussmittel und vor allem Fleisch gelten in der katholischen Kirche nicht als Fastenspeise."
                            },
                            {
                                "example_id": "90d98264-9060-414d-80e2-56cf1d03f47b",
                                "sense_id": "47d8f9e5-88c6-31e2-9c05-16fdbebc4152",
                                "text": "„Aus Ergebenheit für seinen Orden aß er nur Fastenspeisen, und das Öl war schlecht.“"
                            }
