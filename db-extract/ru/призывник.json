                            {
                                "target_word": "conscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b7f36f4-d6e8-31c5-9c22-989ff22cd541",
                                        "entry_id": "5e781571-c0df-3b02-abc6-6e554287f45a",
                                        "glosses": [
                                            "To enroll compulsorily; to draft; to induct."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18987d48-a271-4b42-802c-21c1ca2164b4",
                                                "sense_id": "7b7f36f4-d6e8-31c5-9c22-989ff22cd541",
                                                "text": "Other rich families are being accused of sending their sons abroad before they can be conscripted. Every Taiwanese man must spend three years in the army and another 20 in the reserves."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "conscript",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35b862bc-1f99-38c5-a9cc-afc583e4aa81",
