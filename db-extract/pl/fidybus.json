                        "entry_id": "7e548ff7-09dc-397d-bf76-018633786862",
                        "glosses": [
                            "podłużny zwitek papieru albo cienkie drewienko służące do zapalania fajki, papierosa lub cygara"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6bccd997-26b8-49c7-8c08-55a5a74e91d8",
                                "sense_id": "c1ac00e4-cab8-3dd4-b22c-7fe9ca50dda3",
                                "text": "(…) zapraszał co znaczniejsze osoby do jedzenia i picia, a nawet podawał fajki i własnoręcznie zapalał fidybusy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80b01efe-6b97-4f4e-891b-42a6eac41ca8",
                        "source_entry_id": "7e548ff7-09dc-397d-bf76-018633786862",
                        "source_sense_id": "c1ac00e4-cab8-3dd4-b22c-7fe9ca50dda3",
                        "target_lang_word": "Fidibus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fidibus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "520d621d-0878-372f-a6e9-65dab0e77953",
                                        "entry_id": "ba8aa2f2-ccd7-3296-9fa0-592bbdbc34f4",
                                        "glosses": [
                                            "leicht entzündlicher Holzspan oder Papierstreifen, der zum Entfachen eines Feuers genutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b52748-00fb-46c4-9fbd-8f414249cdd5",
                                                "sense_id": "520d621d-0878-372f-a6e9-65dab0e77953",
                                                "text": "Mit einem Fidibus lässt sich das Feuer besser anzünden als nur mit dem Feuerzeug."
                                            },
                                            {
                                                "example_id": "cb7b0565-1b67-4b76-88c8-6116ca07f36c",
                                                "sense_id": "520d621d-0878-372f-a6e9-65dab0e77953",
                                                "text": "Darüber ward schon die gekrümmte Pfeife gestopft und von Bierbichel mittels Fidibus in Gang gebracht."
                                            },
                                            {
                                                "example_id": "c7d445eb-564a-400c-90cf-713c6eb0a026",
                                                "sense_id": "520d621d-0878-372f-a6e9-65dab0e77953",
                                                "text": "Schiller, der liebe Mensch, war wieder einmal in die Betrachtung der deutschen Geschichte vertieft, und sein tiefernstes Auge streifte Tabaksbeutel und Fidibus bisweilen gedankenverloren…"
                                            },
                                            {
                                                "example_id": "63ad2802-fc8c-4658-98ca-03f4a686949e",
                                                "sense_id": "520d621d-0878-372f-a6e9-65dab0e77953",
                                                "text": "„Harbert hielt das Flämmchen vorsichtig an den Fidibus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
