                    },
                    {
                        "translation_id": "bd126433-f7d0-43ee-b13c-18d4686a82ac",
                        "source_entry_id": "389eace4-6827-34da-bce7-8de0c47d363b",
                        "source_sense_id": "fa513e06-b72b-3ef6-81c8-561ee137ce2d",
                        "source_sense_description": "the spirit of the age",
                        "target_lang_word": "esprit du temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2754e92c-33a6-4c3a-85d7-5124ddec8416",
                        "source_entry_id": "389eace4-6827-34da-bce7-8de0c47d363b",
                        "source_sense_id": "fa513e06-b72b-3ef6-81c8-561ee137ce2d",
                        "source_sense_description": "the spirit of the age",
                        "target_lang_word": "air du temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "air du temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e8c7d4f4-91b8-32a4-be78-2fdd03938cc6",
                                        "entry_id": "61debfde-87aa-3f7c-b70e-ebb4956c515d",
                                        "glosses": [
                                            "Pratique du moment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "598799a2-39bd-4cb2-80f1-3d9cf958c602",
                                                "sense_id": "e8c7d4f4-91b8-32a4-be78-2fdd03938cc6",
                                                "text": "L’air du temps est de réévaluer les grands noms de la culture, notamment dans les musées anglo-saxons, et de nettoyer les cartels d’œuvres de leurs marqueurs raciaux – nègre devient noir, etc."
                                            },
                                            {
                                                "example_id": "fe67905e-6b68-428a-a74e-beab52a1fe23",
                                                "sense_id": "e8c7d4f4-91b8-32a4-be78-2fdd03938cc6",
                                                "text": "Insultes, dégradations, refus de l’autorité municipale… Pour le maire de Clairac comme pour ceux de communes voisines, l’air du temps a changé, sans qu’ils aient les moyens d’y remédier."
                                            },
                                            {
                                                "example_id": "02cc642d-09be-4ad9-a60d-8bdf7802770b",
                                                "sense_id": "e8c7d4f4-91b8-32a4-be78-2fdd03938cc6",
                                                "text": "Elle se compose également une série de références culturelles qu'elle choisit comme ses accessoires vestimentaires: selon l'air du temps, avec un talent certain pour ressembler à sa voisine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4152d368-8d30-49f9-a035-bb9a3d9b8e62",
                        "source_entry_id": "389eace4-6827-34da-bce7-8de0c47d363b",
                        "source_sense_id": "fa513e06-b72b-3ef6-81c8-561ee137ce2d",
                        "source_sense_description": "the spirit of the age",
                        "target_lang_word": "Zeitgeist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitgeist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                        "entry_id": "4b0a8aa6-b389-317c-89db-3ee9a4be8323",
                                        "glosses": [
                                            "verbreitetes Gedankengut einer Generation oder Epoche; die Einstellung der meisten Leute einer bestimmten Gesellschaft zu einer bestimmten Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc922ff-c256-4190-8efc-e37f2913dea6",
                                                "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                                "text": "Der Zeitgeist der 60er und 70er Jahre ist bereits Vergangenheit."
                                            },
                                            {
                                                "example_id": "efb0f498-186a-42be-b673-9f838f8b53e9",
                                                "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                                "text": "„Umstände und Zeitgeist verwandelten seine zunächst vielversprechende Karriere in eine Tragödie.“"
                                            },
                                            {
                                                "example_id": "51f0108a-1109-42e6-9f43-9a6396b5746b",
                                                "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                                "text": "„Nein, er ist kein Anhänger des Zeitgeistes.“"
                                            },
                                            {
                                                "example_id": "d7cd39d6-9fb4-41df-9130-dc3c238754d2",
                                                "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                                "text": "„Es ist merkwürdig, dieser Zeitgeist war im Grunde dazu auserkoren, bei uns Isländern das Verlangen nach etwas zu wecken, das über die sterile Stabreimdichtung und die landesweit verbreitete Stammesforschung hinausging.“"
                                            },
                                            {
                                                "example_id": "4fabb388-77dc-438b-a592-486d86472018",
                                                "sense_id": "a21de0a4-d33e-3b3e-87f2-22a79d96178d",
                                                "text": "„Bis dahin waren sie Sänger, Stimmungsmenschen, Erzähler gewesen, nun wurden sie vom Zeitgeist ergriffen und wurden Arbeiter, Erzieher, Reformatoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
