{
    "word_family": [
        "massacre",
        "massacreur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fe88baf4-2da3-30e8-bdf0-a99302f1f9d4",
                    "sense_definition": "Tuer en grand nombre et avec sauvagerie des personnes sans défense.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant l'attaque du village, les soldats ennemis ont <w>massacré</w> des civils innocents."
                        },
                        {
                            "text": "Les envahisseurs voulaient <w>massacrer</w> la population pour semer la terreur dans toute la région."
                        }
                    ],
                    "synonyms": [
                        "exterminer",
                        "égorger",
                        "décimer"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "massacrer la population",
                        "massacrer des civils"
                    ]
                },
                {
                    "sense_id": "d8dde72b-6c06-3b12-a5ab-e9038dd1d772",
                    "sense_definition": "Exécuter ou interpréter très mal une œuvre artistique, un texte ou un travail.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gacher",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chanteur amateur a complètement <w>massacré</w> cette chanson magnifique devant un public très embarrassé."
                        },
                        {
                            "text": "Je refuse de jouer ce morceau au piano car j'ai peur de le <w>massacrer</w>."
                        }
                    ],
                    "synonyms": [
                        "bousiller",
                        "gâcher",
                        "saboter"
                    ],
                    "common_phrases": [
                        "massacrer une chanson",
                        "massacrer un morceau"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "au sens figuré"
                        }
                    ]
                },
                {
                    "sense_id": "7203aacb-32f4-3cbd-84f2-ff461f276282",
                    "sense_definition": "Prononcer très mal un mot ou déformer le nom de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prononciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le présentateur a encore <w>massacré</w> le nom du réalisateur étranger lors de la cérémonie officielle."
                        },
                        {
                            "text": "Ne t'inquiète pas pour ton accent, personne ne t'en voudra de <w>massacrer</w> quelques mots en débutant."
                        }
                    ],
                    "synonyms": [
                        "écorcher"
                    ],
                    "common_phrases": [
                        "massacrer un nom",
                        "massacrer la prononciation"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "90584ed5-088f-3588-9b24-8e24e1b3a07d",
                    "sense_definition": "Détériorer, abîmer gravement des objets par maladresse ou négligence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "detruire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les déménageurs imprudents ont fini par <w>massacrer</w> des meubles anciens dans l'escalier trop étroit."
                        },
                        {
                            "text": "En voulant réparer la table sans les bons outils, il a complètement <w>massacré</w> le bois précieux."
                        }
                    ],
                    "synonyms": [
                        "abîmer",
                        "dégrader",
                        "défigurer"
                    ],
                    "antonyms": [
                        "réparer",
                        "restaurer"
                    ],
                    "common_phrases": [
                        "massacrer des meubles"
                    ]
                },
                {
                    "sense_id": "78146bac-2717-389e-892f-f8af0f8ea648",
                    "sense_definition": "Tuer des animaux en grand nombre, souvent de manière cruelle ou excessive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Plusieurs associations écologistes dénoncent les navires qui continuent de <w>massacrer</w> des cétacés en haute mer."
                        },
                        {
                            "text": "Les braconniers ont <w>massacré</w> des dizaines d'éléphants uniquement pour récupérer leur ivoire."
                        }
                    ],
                    "common_phrases": [
                        "massacrer des animaux",
                        "massacrer du gibier"
                    ]
                }
            ]
        }
    ]
}