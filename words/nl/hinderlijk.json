                },
                {
                    "sense_id": "2c4c498b-805a-3d38-99df-bea1eea77d89",
                    "sense_definition": "het proces van voortgang vertragen of bemoeilijken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belemmering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De grote koffer was een <w>hinderlijk</w> object tijdens de drukke treinreis.",
                            "target_lang_translations": {
                                "en": "The large suitcase was a <w>cumbersome</w> object during the busy train journey.",
                                "it": "La grande valigia era un oggetto <w>ingombrante</w> durante il viaggio in treno affollato."
                            }
                        },
                        {
                            "text": "Een <w>hinderlijke</w> onderbreking zorgde ervoor dat het project vertraging opliep.",
                            "target_lang_translations": {
                                "en": "An <w>obstructive</w> interruption caused the project to suffer a delay.",
                                "it": "Un'interruzione <w>d'intralcio</w> ha fatto sì che il progetto subisse un ritardo."
                            }
                        }
                    ],
                    "synonyms": [
                        "belemmerend",
                        "stagnerend"
                    ],
                    "antonyms": [
                        "bevorderlijk",
                        "helpend"
                    ],
                    "common_phrases": [
                        "hinderlijke onderbreking",
                        "hinderlijke obstructie"
                    ],
                    "target_lang_definitions": {
                        "en": "slowing down or making the process of progress more difficult",
                        "it": "che rallenta il progresso o rende difficile lo svolgimento di un processo"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "obstructive",
                                "target_lang_sense_clarification": "blocking or hindering progress"
                            },
                            {
                                "target_lang_word": "cumbersome",
                                "target_lang_sense_clarification": "clumsy or difficult to manage, slowing things down"
                            },
                            {
                                "target_lang_word": "hindering",
                                "target_lang_sense_clarification": "making it difficult for someone to do something"
                            },
                            {
                                "target_lang_word": "impeding",
                                "target_lang_sense_clarification": "delaying or preventing someone or something"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "d'intralcio",
