                    {
                        "sense_id": "ab3b9cbe-100a-37a8-b75f-066ca0f24467",
                        "entry_id": "b880a099-4301-37c3-9006-6a58cfe5309a",
                        "glosses": [
                            "deska na kółkach, służąca do rekreacji oraz sportu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "305821ac-0616-4044-8929-830971b3cb4e",
                                "sense_id": "ab3b9cbe-100a-37a8-b75f-066ca0f24467",
                                "text": "Lubię jeździć na deskorolce."
                            },
                            {
                                "example_id": "85a6535f-3dcc-4399-931b-fb0be73bc87b",
                                "sense_id": "ab3b9cbe-100a-37a8-b75f-066ca0f24467",
                                "text": "Deskorolka przydatna jest jako środek transportu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "656bdb34-6ebf-4703-bd55-229e1d9a1979",
                        "source_entry_id": "b880a099-4301-37c3-9006-6a58cfe5309a",
                        "source_sense_id": "ab3b9cbe-100a-37a8-b75f-066ca0f24467",
                        "target_lang_word": "skateboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skateboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76ef885f-1997-3edd-9f6f-55d09a0fb4d2",
                                        "entry_id": "1145d660-f0a0-39c8-bb0f-af31790dcf3a",
                                        "glosses": [
                                            "A narrow, wooden or plastic platform mounted on pairs of wheels, on which one stands and propels oneself by pushing along the ground with one foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eea6e6a8-9aea-41c9-a1f8-97f484295542",
                                                "sense_id": "76ef885f-1997-3edd-9f6f-55d09a0fb4d2",
                                                "text": "In its May 1965 issue, Life magazine condemned skateboards as a “menace to limb and even to life,” and cautioned readers about riders who “take over the paths made for peaceful strollers.”"
                                            },
                                            {
                                                "example_id": "01f00bba-e954-4dc3-9bde-04f03d7511d7",
                                                "sense_id": "76ef885f-1997-3edd-9f6f-55d09a0fb4d2",
                                                "text": "“Maybe it’s a video to talk about the situation. They use the skateboard as their weapons to (educate) the generation around Europe and the world,” Tutenges said. “It’s a good way to keep talking about Ukraine.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0b00e7f-2fdb-3b52-9f90-8ca5b1b15e8c",
                                        "entry_id": "1145d660-f0a0-39c8-bb0f-af31790dcf3a",
                                        "glosses": [
                                            "A vehicle chassis format, used for electric vehicles, which holds the drive motors and power energy store (ie. batteries), forming the vehicular base."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "skateboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c963a0cf-63c9-3602-b61a-caa18ba9fb3f",
                                        "entry_id": "24e79ed1-6342-3257-8f63-bde0e61e3b31",
                                        "glosses": [
                                            "To use a skateboard."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e53b8e5-4774-448d-a106-73c64d8b4a75",
                                                "sense_id": "c963a0cf-63c9-3602-b61a-caa18ba9fb3f",
                                                "text": "“Mentally, it’s hard to live here,” a teenage skateboarder named Konstantino told him. “So we skateboard to free ourselves and heal ourselves. We go out into the street every day, as if it were our medicine.”"
                                            },
                                            {
                                                "example_id": "059c58ff-2e77-491d-ba63-fa8610d21db7",
                                                "sense_id": "c963a0cf-63c9-3602-b61a-caa18ba9fb3f",
                                                "text": "He explained how the race was initially his idea, but it was Gay – a Bend resident ranked fourth in the world for the most miles skateboarded in 24 hours – who had to “sell the whole idea to the city” while seeking permission to host the race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4e71937-373e-4635-bf5a-1b12c1b22d8e",
                        "source_entry_id": "b880a099-4301-37c3-9006-6a58cfe5309a",
                        "source_sense_id": "ab3b9cbe-100a-37a8-b75f-066ca0f24467",
                        "target_lang_word": "planche à roulettes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planche à roulettes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c7a1ab9-afe5-33e0-a5ef-ebb6a1542623",
                                        "entry_id": "a6174130-abc7-354e-829e-f2b55c33cf0d",
                                        "glosses": [
                                            "Planche terrestre munie de quatre roues utilisée en tant que loisir ou que sport pour rouler sur le sol dur et glisser éventuellement en faisant des figures plus ou moins compliquées."
                                        ],
                                        "tags": [
                                            "Sports de glisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dccfbb95-b1ee-4c43-92b1-926693a2b698",
                                                "sense_id": "6c7a1ab9-afe5-33e0-a5ef-ebb6a1542623",
                                                "text": "Ses yeux tombent soudain sur la planche à roulettes dont parlait le vieil homme ; Théo a rectifié de lui-même en cherchant un skate. Mais c'est bien une planche à roulettes, comme celles qu'on trouvait autrefois, roues en plastique coloré, appui large en bois."
                                            },
                                            {
                                                "example_id": "b1dd72f8-a061-477e-9cec-b03f8f1f3663",
                                                "sense_id": "6c7a1ab9-afe5-33e0-a5ef-ebb6a1542623",
                                                "text": "La société Funboard importe des planches à roulettes de Corée et de Taïwan selon les modèles. La dernière commande concerne l’importation de 8 000 planches à roulettes au prix unitaire de 100 USD CIF Le Havre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93357e7b-468f-3de9-82a0-6c531111b085",
                                        "entry_id": "a6174130-abc7-354e-829e-f2b55c33cf0d",
                                        "glosses": [
                                            "Sport avec cette planche."
                                        ],
                                        "tags": [
                                            "Sports de glisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9fa07e3-48ba-4cb1-b844-76e6575d0a0a",
                                                "sense_id": "93357e7b-468f-3de9-82a0-6c531111b085",
                                                "text": "Originaire de Boucherville, Pierre-Luc Gagnon vit en Californie depuis 16 ans. Il y a acquis ses lettres de noblesse en tant que champion de planche à roulettes. L’exil forcé lui a permis de développer sa passion et d’en devenir l’un des meilleurs au monde. Ses 21 médailles accumulées au fil des ans dans les championnats X Gamesen font foi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
