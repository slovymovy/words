                "translations": [
                    {
                        "translation_id": "de1e5c29-5315-47aa-9fdd-6c6a09e41c86",
                        "source_entry_id": "6419eeac-6117-3bdf-a4e1-71b7ac92a104",
                        "source_sense_id": "20b08a50-1237-3120-90ba-ab9e7922d696",
                        "target_lang_word": "protector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "protector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "Someone who protects or guards, by assignment or on their own initiative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52e3d028-c801-4164-aeb3-31022b86c016",
                                                "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                                "text": "I stand before you in the spirit of pure public service — not as a protector of the status quo, but as an agent of change."
                                            },
                                            {
                                                "example_id": "f11c631e-3f48-4e7d-9e72-5dac85fa994e",
                                                "sense_id": "24544674-a4b0-385d-843e-9988500e6c28",
                                                "text": "They [the Lightners] were like Gods to us. Our protectors. Our creators. Those who gave us purpose... Then, one day we were all locked away in this prison... And the Lightners never returned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a808f6a-8578-349d-a71b-7df97945e0e4",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "Someone who protects or guards, by assignment or on their own initiative.",
                                            "A headmate who primarily fronts, or otherwise protects the system, in situations where the system is at risk of psychological harm."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd466f02-1066-3492-a9d7-862962fe1e44",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "A device or mechanism which is designed to protect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad1e75a4-2c97-3727-bc6c-3e5b755176f1",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "One who prevents interference."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d847e5cc-3438-3431-bae2-56d98cf63ab4",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "A state or other subject under international law, exercising a protectorate over another subject in international law."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f6ef50a8-9476-3b54-88e5-06df03ce09a1",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "One having the care of the kingdom during the king's minority; a regent."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2930644-706e-4dbf-8368-9f08be41b1bb",
                                                "sense_id": "f6ef50a8-9476-3b54-88e5-06df03ce09a1",
                                                "text": "My Lord Protector, ’tis his Highnes pleaſure, You do prepare to ride vnto S. Albons, / Where as the King and Queene do mean to Hawke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07913cf0-1a2a-3219-a17f-0c945cb6b9b3",
                                        "entry_id": "0c50b573-ad7b-3297-b1a3-ff5ef4bf6c29",
                                        "glosses": [
                                            "A cardinal, from one of the more considerable Roman Catholic nations, who looks after the interests of his people at Rome; also, a cardinal who has the same relation to a college, religious order, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
