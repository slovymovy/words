                ],
                "senses": [
                    {
                        "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                        "entry_id": "99091cab-06df-3cb5-877c-e1a1360b0c06",
                        "glosses": [
                            "am Weg stehendes kirchliches Kreuz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5df7b77b-2254-454c-be36-9cc577050444",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„ Die entwicklungsgeschichtliche Untersuchung des Brauchtums hat sich zunächst mit der Frage zu befassen, welche Vorbedingungen im Volk so tiefgreifende Beziehungen zu den Wegkreuzen ermöglichten, daß ihre Setzung zum Volksbrauch wurde“"
                            },
                            {
                                "example_id": "4c34a45a-17a4-431c-a805-1bf8642a4ce1",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„Die Wegkreuze treten auf dem freien Feld an Wegrändern, Kreuzungen oder an exponierten Stellen wie Anhöhen auf; starke Verbreitung vor allem in katholischen Gegenden.“"
                            },
                            {
                                "example_id": "c354c2bc-3ac3-4e90-94b2-8e133e98d902",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„Wegkreuze in der Karwoche mit Kerzen zu schmücken, ist ein alter sorbischer Brauch, einer ethnischen Minderheit in der Lausitz. Aloys Andritzki, ein Sorbe, wurde in Radebor geboren, in Bautzen zum Priester geweiht, in Dresden Kaplan und Präses der dortigen Kolpingsfamilie, von den Nazis verhaftet und am 3. Februar 1943 von den NS-Schergen des Dachauer KZs todgespritzt. Aloys Andritzki wurde 2011 selig gesprochen werden.“"
                            },
                            {
                                "example_id": "9ee415b7-33b7-4eba-a1e0-da75c91795fb",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„Die meisten dieser Wegkreuze stammen aus vergangenen Jahrhunderten.“"
                            },
                            {
                                "example_id": "7a4aa705-b1e9-47ea-bfce-5915f26d84d3",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„Das Wegkreuz im Garten des Gasthauses »Zum Wildem Mann« hat eine interessante, aber auch traurige Geschichte. Katharina Meßmer war Ende des 19. Jahrhunderts Eigentümerin der Gaststätte.“"
                            },
                            {
                                "example_id": "3eab4f31-e1b2-40a4-95a0-9a37bd0a7d22",
                                "sense_id": "fb981e10-b39a-3c8d-9060-213389f7b3b6",
                                "text": "„In neuem Glanz zeigt sich das alte Wegkreuz an der Landesstraße 42 zwischen Geilenkirchen und Teveren seit einigen Tagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
