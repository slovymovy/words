                        "examples": [
                            {
                                "example_id": "31edd468-4a3b-488a-b9ae-f464589b481b",
                                "sense_id": "1d26455a-5170-3698-9ddd-039c0348aeee",
                                "text": "Wöchentlich zweimal kam die Zugehfrau und reinigte die Wohnräume."
