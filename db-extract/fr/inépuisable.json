                        ],
                        "form": "inépuisables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1b6ce8e-c309-3217-ab56-52f2310f9ce8",
                        "entry_id": "4a6f2d55-db82-36af-8afb-88a9b9eebf85",
                        "glosses": [
                            "inexhaustible (that cannot be used up)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3148f3e-a170-4d22-95ab-45b2a01b61d9",
                                "sense_id": "b1b6ce8e-c309-3217-ab56-52f2310f9ce8",
                                "text": "C'est ainsi qu'il peut se placer au-dessus de l'instinct aveugle et trouver dans la source inépuisable de ses sens un objet de stimulation pour un plaisir plus noble, un mobile qui le pousse au travail sérieux et à la lutte pour l'idéal."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
