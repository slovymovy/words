                                        "glosses": [
                                            "męski hormon płciowy, wytwarzany przez jądra, otrzymywany także syntetycznie, stosowany domięśniowo jako lek przy schorzeniach na tle niedomogi płciowej u mężczyzn, jak również przy niektórych chorobach kobiecych oraz nowotworowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febef0fc-2e05-46d6-8f2f-e1c21bdde710",
                                                "sense_id": "60362dc9-186b-329e-9b53-aaed456279da",
                                                "text": "Nadmierny łojotok występuje w okresie pokwitania, przy zaburzeniach czynności hormonalnych, przy stosowaniu niektórych leków hormonalnych, w tym androgenów i testosteronu"
                                            }
                                        ],
