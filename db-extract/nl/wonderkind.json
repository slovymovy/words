                        "target_lang_word": "enfant prodige",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfant prodige",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                        "entry_id": "157ebc1c-3a00-3de5-b181-601f7e906d70",
                                        "glosses": [
                                            "Enfant maitrisant un ou plusieurs domaines scientifiques ou techniques à un âge précoce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a7951b3-f1d2-47ec-b54b-8da567768629",
                                                "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                                "text": "Arrêtez un écolier à seize ans ; tout intelligent que vous le fassiez, cet enfant prodige, fixé à trois lustres, restera un imbécile […]"
                                            },
                                            {
                                                "example_id": "218d9da2-264b-4bfd-8a03-87d1af9f3f57",
                                                "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                                "text": "Je savais aussi que Yehudi avait été un enfant prodige."
                                            },
                                            {
                                                "example_id": "8c1e0c78-c814-41c0-8b36-177d7a2800bd",
                                                "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                                "text": "Lorsque j’arrivai sur le plateau d’Antenne 2, Christian me prit dans ses bras en me donnant du « Wunderkind » (enfant prodige). Je ne l’ai pas oublié."
                                            },
                                            {
                                                "example_id": "6b676067-8281-462f-bf77-ced725da433a",
                                                "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                                "text": "Le gouverneur de la province entendit parler de lui comme d’un enfant prodige et le fit venir pour l’examiner. Hoa répondit à merveille à toutes les questions sur les choses célestes et terrestres."
                                            },
                                            {
                                                "example_id": "b6859288-117a-4739-bd13-ad1054465f5e",
                                                "sense_id": "15c637ad-a18d-3cba-8117-68aefa09cc42",
                                                "text": "Wolfgang Amadeus Mozart fut un enfant prodige."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
