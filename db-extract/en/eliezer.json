                "senses": [
                    {
                        "sense_id": "bffb4e27-6d9b-352a-8cdd-9055831db422",
                        "entry_id": "3714979c-42d8-3578-8b11-f3f136df45c3",
                        "glosses": [
                            "Any of a number of men in the Old Testament, including a son of Moses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e24fb29-2341-4a25-b049-6b35ae9991bd",
                                "sense_id": "bffb4e27-6d9b-352a-8cdd-9055831db422",
                                "text": "And the name of the other was Eliezer: for the God of my father, said he, was mine helpe, and deliuered me from the sword of Pharaoh."
                            }
                        ]
                    },
                    {
                        "sense_id": "8501c4ed-a157-3a41-ae4b-123cfb2e5553",
                        "entry_id": "3714979c-42d8-3578-8b11-f3f136df45c3",
                        "glosses": [
                            "A male given name from Hebrew of biblical origin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "373e2aef-2097-4339-8081-d295764c4fa3",
                                "sense_id": "8501c4ed-a157-3a41-ae4b-123cfb2e5553",
                                "text": "Eliezer Yudkowsky, a 44-year-old academic wearing a grey polo shirt, rocks slowly on his office chair and explains with real patience – taking things slowly for a novice like me – that every single person we know and love will soon be dead."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0caafa39-7b35-4dba-8587-989a144e9b49",
                        "source_entry_id": "3714979c-42d8-3578-8b11-f3f136df45c3",
                        "source_sense_description": "biblical character",
                        "target_lang_word": "Éliézer",
