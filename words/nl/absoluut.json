                    ],
                    "common_phrases": [
                        "absolute monarchie",
                        "absolute macht"
                    ],
                    "target_lang_definitions": {
                        "en": "completely independent and with unlimited power, often said of a monarch",
                        "ru": "полностью независимый и с неограниченной властью, часто о монархе"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "absolute",
                                "target_lang_sense_clarification": "unrestricted by laws or checks"
                            },
                            {
                                "target_lang_word": "unlimited",
                                "target_lang_sense_clarification": "without any boundaries or controls"
                            },
                            {
                                "target_lang_word": "despotic",
                                "target_lang_sense_clarification": "ruling with absolute power in a cruel way"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "абсолютный",
                                "target_lang_sense_clarification": "неограниченный законом или конституцией"
