                    },
                    {
                        "translation_id": "1fa880ab-29ff-4bc2-b9a7-cc35b09a8277",
                        "source_entry_id": "bb7cf5cd-2c62-37ab-9219-564a45395060",
                        "source_sense_id": "93e327b1-ae15-34f9-b5ea-8dd30b1bd87a",
                        "target_lang_word": "pistone swept volume",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f4279425-33ce-4fd2-9b8c-f5261b968726",
                        "source_entry_id": "bb7cf5cd-2c62-37ab-9219-564a45395060",
                        "source_sense_id": "93e327b1-ae15-34f9-b5ea-8dd30b1bd87a",
                        "target_lang_word": "cylindrée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cylindrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39904388-033d-3d39-87a5-667968fffdb8",
                                        "entry_id": "e4948dd5-6b10-34c6-8504-77f757c42da2",
                                        "glosses": [
                                            "Volume intérieur d'un cylindre, correspondant à la course du piston dans une pompe ou dans un moteur à explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90512d2c-097b-42e2-8db1-6ab2c4aa260c",
                                                "sense_id": "39904388-033d-3d39-87a5-667968fffdb8",
                                                "text": "Contrairement aux pompes à cylindrée fixe, les pompes à cylindrée variable permettent de faire varier le débit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd4491a7-72eb-3595-b7b4-6e945fd99483",
                                        "entry_id": "e4948dd5-6b10-34c6-8504-77f757c42da2",
                                        "glosses": [
                                            "Volume cumulé des cylindres d'un moteur à explosion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc08563-b257-4f20-b30c-7ec69998f090",
                                                "sense_id": "cd4491a7-72eb-3595-b7b4-6e945fd99483",
                                                "text": "Il présente cette année une huit-cylindres en ligne, dont on connaîtra le rendement en apprenant qu'elle dépasse le 130 en palier avec un moteur de deux litres de cylindrée, c'est-à-dire de douze chevaux."
                                            },
                                            {
                                                "example_id": "f7aee1d4-a4ad-44ea-8117-83ec742bd05d",
                                                "sense_id": "cd4491a7-72eb-3595-b7b4-6e945fd99483",
                                                "text": "Et, comme cela n'était pas suffisant, Vallese a augmenté la dose du Twin Cam en y greffant des pistons Wiseco portant la cylindrée à 1 550 cc (au lieu de 1 450 cc) et en retravaillant l’embiellage, les arbres à cames, la cartographie d'injection ou l'embrayage (via un kit Barnett)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d64aeec-eccd-39be-8c6d-c644d2f237ee",
                                        "entry_id": "e4948dd5-6b10-34c6-8504-77f757c42da2",
                                        "glosses": [
                                            "(Par métonymie, avec un adjectif) Voiture automobile ou motocyclette d'une certaine cylindrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcdc2461-c6e9-48c3-b8db-9885796c8014",
                                                "sense_id": "2d64aeec-eccd-39be-8c6d-c644d2f237ee",
                                                "text": "On étudie ici le moteur deux temps de marque Marinelli équipant des scooters. Ce moteur, inventé en 1860 par Étienne Lenoir, concerne les petites cylindrées de l'ordre de 50 cm³."
                                            },
                                            {
                                                "example_id": "71da8066-3b1d-407f-8347-35aecf5c654f",
                                                "sense_id": "2d64aeec-eccd-39be-8c6d-c644d2f237ee",
                                                "text": "Après la mort du jeune cycliste Paul Varry, écrasé par le conducteur d’un SUV à Paris mercredi 16 octobre, la question de la dangerosité des automobilistes et des véhicules à grosses cylindées revient sur le devant de la scène."
                                            },
                                            {
                                                "example_id": "095e8017-65d1-4308-8e3c-7593e53c0e6c",
                                                "sense_id": "2d64aeec-eccd-39be-8c6d-c644d2f237ee",
                                                "text": "Dans ce milieu et même si l’athlétisme rassemble des sommes nettement moins importantes que d’autres disciplines encore plus médiatiques, on peut cependant rapidement flamber, profiter des avantages, rouler avec une belle cylindrée, crâner, s’afficher dans les journaux avec des mannequins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cylindrée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85e05078-7e1b-320a-87be-733e202710e0",
                                        "entry_id": "18edacde-9424-3362-99fb-f10fb8c01c26",
