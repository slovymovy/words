                    }
                ],
                "senses": [
                    {
                        "sense_id": "40847c37-61cf-3e44-9595-827c7d69c542",
                        "entry_id": "a78f7b79-5873-3143-bc60-2a40d2f5b2b0",
                        "glosses": [
                            "Se relever alors qu’on était à genoux."
                        ],
                        "tags": [
                            "intransitive",
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "65d8c5f7-2e97-4422-8dd7-7f15a0565556",
                                "sense_id": "40847c37-61cf-3e44-9595-827c7d69c542",
                                "text": "Et dans un murmure confus, dans un froufrouement de soies embaumées comme les fleurs dont planait le parfum, on vit les mariés se désagenouiller, puis, calmes et graves, bien qu’un pli de bonheur leur éclairât le front, se diriger vers la sacristie, suivis du fouillis des robes roses, des chapeaux bleus et des habits noirs."
                            },
                            {
                                "example_id": "8a4a528e-250e-4840-8140-a154a3201e77",
                                "sense_id": "40847c37-61cf-3e44-9595-827c7d69c542",
                                "text": "Dès lors il se désagenouilla. Le voilà droit comme un pic."
                            },
                            {
                                "example_id": "863f7755-ef37-4ad7-8434-d464be877e69",
                                "sense_id": "40847c37-61cf-3e44-9595-827c7d69c542",
                                "text": "Je m’inclinai derechef en me désagenouillant à reculons, au prix d’une rechute aiguë du lumbago."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0a293d8-a5df-3e5e-bc7a-1aba582925a8",
                        "entry_id": "a78f7b79-5873-3143-bc60-2a40d2f5b2b0",
                        "glosses": [
                            "Faire se relever quelqu’un qui était à genoux."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "54ef6dfc-e5a7-46e9-b788-973b1257a87c",
                                "sense_id": "e0a293d8-a5df-3e5e-bc7a-1aba582925a8",
                                "text": "La seule souveraineté qui ne devait rien en lui à l’habileté des intrigues et au calcul des assurances prises, cette principauté d’une parole qu’il pouvait galvauder, sans en tarir pourtant le brûlant de lave — cette souveraineté-là lui laissait, à chaque jour de sa vie, la possibilité de dominer son destin, de se désaveugler, de désagenouiller sa fierté humiliée et sa conscience offensée."
                            }
                        ]
                    }
                ],
