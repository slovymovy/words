                    {
                        "sense_id": "4f2227ba-ad66-3835-b333-a77f6c3a073f",
                        "entry_id": "d1cd87a3-fa9d-3844-ae64-721a2390978a",
                        "glosses": [
                            "gebied of overdekte galerij waar meerdere winkels en horecazaken zijn gevestigd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c42ed230-dc53-4a8c-a25a-ebe8244471bf",
                                "sense_id": "4f2227ba-ad66-3835-b333-a77f6c3a073f",
                                "text": "We gingen een middagje winkelen in het plaatselijk winkelcentrum."
                            },
                            {
                                "example_id": "cd73deca-4974-4172-b5c4-8aa11ec0c440",
                                "sense_id": "4f2227ba-ad66-3835-b333-a77f6c3a073f",
                                "text": "Bij de balie van het hotel stond een kleine roze leenfiets waarop ik tevreden richting het winkelcentrum fietste."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22d390c5-6414-4ef6-b89c-fbaea1a00ade",
                        "source_entry_id": "d1cd87a3-fa9d-3844-ae64-721a2390978a",
                        "source_sense_id": "4f2227ba-ad66-3835-b333-a77f6c3a073f",
                        "source_sense_description": "gebied of overdekte galerij waar meerdere winkels en horecazaken zijn gevestigd",
