                    "frequency": "High",
                    "semantic_group_id": "organisation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur cherche des solutions concrètes pour <w>équilibrer</w> le budget avant la fin de l'année."
