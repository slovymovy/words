            {
                "entry_id": "13d4bc00-385c-391a-9836-912a43daab54",
                "word": "battologie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9b53fdd8-00c2-4d26-80cd-31041f027f8e",
                        "entry_id": "13d4bc00-385c-391a-9836-912a43daab54",
                        "tags": [
