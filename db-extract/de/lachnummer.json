                ],
                "senses": [
                    {
                        "sense_id": "4340fefe-7c8b-31e8-b81c-5f82b7b81386",
                        "entry_id": "dde7cc9c-5400-3fc3-9941-44f08411e150",
                        "glosses": [
                            "Sache, Person oder Verhalten, über die/das man nur lachen kann; etwas, das man nicht ernst nimmt und über das man sich lustig macht"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c535e47b-e2f7-4949-b777-006a16b0e3f7",
                                "sense_id": "4340fefe-7c8b-31e8-b81c-5f82b7b81386",
                                "text": "Dein Auftritt war eine reine Lachnummer."
                            },
                            {
                                "example_id": "66ef21e5-c61f-4c01-a81f-94d373975b9a",
                                "sense_id": "4340fefe-7c8b-31e8-b81c-5f82b7b81386",
                                "text": "„Und wie man sie vorführt, die Talkshowgäste, zur Lachnummer macht für hämische Zuschauer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "932dcd25-7bdb-41dd-8003-00b5d3942f5c",
                        "source_entry_id": "dde7cc9c-5400-3fc3-9941-44f08411e150",
                        "source_sense_id": "4340fefe-7c8b-31e8-b81c-5f82b7b81386",
                        "target_lang_word": "laughing stock",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laughing stock",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                        "entry_id": "73bb39e5-dc33-3ad2-b9a7-c8e1da1990af",
                                        "glosses": [
                                            "An object of ridicule, someone who is publicly ridiculed; the butt of a joke."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1b71170-1a4d-4ac3-8dca-c06276d57daf",
                                                "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                                "text": "Pray you let us not be\nlaughing-stocks to other men's humours."
                                            },
                                            {
                                                "example_id": "28dd023f-d325-4a02-91c4-2ef7313c4a62",
                                                "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                                "text": "When he talked, he talked nonsense, and made himself the laughing-stock of his hearers."
                                            },
                                            {
                                                "example_id": "81d2f634-f887-4eda-895c-742c2fb72fb1",
                                                "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                                "text": "If anyone can restore dignity to a franchise that has been close to a laughing stock in the last few years, it's Gibbs."
                                            },
                                            {
                                                "example_id": "a09c509d-352b-4ecb-bca7-32334f8fff69",
                                                "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                                "text": "The split was supposedly triggered by racism — specifically anti-Jewish racism. But on this front, the Independent Group have already become a laughingstock."
                                            },
                                            {
                                                "example_id": "1f581191-529b-4118-8c1c-2e6cd37a2e01",
                                                "sense_id": "e843fe83-7b42-3152-9212-01d342ef7565",
                                                "text": "Toronto Transit Corporation had real issues. [...] My boss was removed in a coup three months after my arrival. I stood in and my learning curve went through the roof. Over five years, we went from being a laughing stock to winning awards."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f7dcd93-bcf5-4923-ace6-aede54e8853a",
                        "source_entry_id": "dde7cc9c-5400-3fc3-9941-44f08411e150",
                        "source_sense_id": "4340fefe-7c8b-31e8-b81c-5f82b7b81386",
                        "target_lang_word": "risée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "risée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1266eeb2-16b7-331e-8d3e-699bb54915fb",
                                        "entry_id": "9a0f5497-09fc-3d28-890f-bb3726847aff",
                                        "glosses": [
                                            "Grand éclat de rire que font plusieurs personnes ensemble, en se moquant de quelqu’un ou de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "525edfed-7246-4a5f-a897-f49fe9db0686",
                                                "sense_id": "1266eeb2-16b7-331e-8d3e-699bb54915fb",
                                                "text": "Il s’éleva une grande risée, une risée universelle de toute l’assemblée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9570007a-5bcc-3d50-b552-b92bc85d3260",
                                        "entry_id": "9a0f5497-09fc-3d28-890f-bb3726847aff",
                                        "glosses": [
                                            "Moquerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13dfbdf1-2547-43b9-abdb-363f1e5d9aea",
                                                "sense_id": "9570007a-5bcc-3d50-b552-b92bc85d3260",
                                                "text": "S’exposer à la risée du public."
                                            },
                                            {
                                                "example_id": "42e856c4-d7fd-4557-8ac6-e04a960b9de1",
                                                "sense_id": "9570007a-5bcc-3d50-b552-b92bc85d3260",
                                                "text": "Son cauchemar habituel était la peur d’être exposé à la risée publique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "908d3a1c-3d36-34c6-b4fd-f62b3fd79271",
                                        "entry_id": "9a0f5497-09fc-3d28-890f-bb3726847aff",
                                        "glosses": [
                                            "Objet de la risée, de la moquerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8801ed-97ea-4773-bd9f-57ab024aeb99",
                                                "sense_id": "908d3a1c-3d36-34c6-b4fd-f62b3fd79271",
                                                "text": "Ce grand homme, révéré par M. d’Artagnan père, servait de risée aux mousquetaires de M. de Tréville."
                                            },
                                            {
                                                "example_id": "a458f720-554a-4096-afa6-7ce8940a3052",
                                                "sense_id": "908d3a1c-3d36-34c6-b4fd-f62b3fd79271",
                                                "text": "Maintenant la calomnie allait grossir, […], s'emparer de Charlotte, l'étreindre, l'étouffer, la meurtrir, faire d'elle, du beau lis de la vallée, mélancolique et pur, la risée d'un pays, le misérable et impuissant jouet de toute une population ameutée contre elle."
                                            },
                                            {
                                                "example_id": "6cdc4fd3-304c-412c-b9fb-de8a70e46d6e",
                                                "sense_id": "908d3a1c-3d36-34c6-b4fd-f62b3fd79271",
                                                "text": "[…], ils avaient passé tous trois un délicieux après-midi à faire de la musique et à discuter des dernières productions romantiques, en particulier de celles de « Mocieu Victor Hugo », lequel était, de l’avis d’Étienne, la honte des lettres françaises et la risée de l’Europe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "risée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3696bb-979f-36bd-97d9-a7fd2e7cbf3d",
                                        "entry_id": "51459332-7370-3170-9d8e-256730237f3e",
                                        "glosses": [
                                            "Augmentation soudaine et brève de l'intensité du vent à la surface de l'eau. Une risée est moins violente que la rafale : son augmentation n'est que de 2 ou 3 nœuds par rapport au vent nominal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed325d6-dae2-4861-b23d-4a78e695396c",
                                                "sense_id": "aa3696bb-979f-36bd-97d9-a7fd2e7cbf3d",
                                                "text": "… une rivière coulait à pleins bords dans ces vallées profondes ; la risée qui courait alors hérissait sa surface comme celle d'une peau transie de froid …."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0ccae44-58b0-3a22-aa5a-c8dd6f9c34cd",
                                        "entry_id": "51459332-7370-3170-9d8e-256730237f3e",
                                        "glosses": [
                                            "Rides qu'elle provoque à la surface de l'eau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b7b2cbc-bd9d-468b-b410-919b422f3eb7",
                                                "sense_id": "a0ccae44-58b0-3a22-aa5a-c8dd6f9c34cd",
                                                "text": "Ciel assez beau avec un vent de nord qui menace de fraîchir. Au large, de longues risées verdâtres courant à la surface de la mer. Il est possible que la nuit soit plus dure qu’on ne le supposait."
                                            },
                                            {
                                                "example_id": "ddfb1245-21a4-48e1-98e0-95c8515b44ad",
                                                "sense_id": "a0ccae44-58b0-3a22-aa5a-c8dd6f9c34cd",
                                                "text": "Les risées locales apparaissent comme des zones plus sombres, dues à la présence d’un plus grand nombre de vagues capillaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "risée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24f1d6ee-0b41-3c75-a5e8-a6fe0981d414",
                                        "entry_id": "66556ed3-f4eb-3db7-b473-a7e680f94db1",
                                        "glosses": [
                                            "Participe passé féminin singulier de riser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
