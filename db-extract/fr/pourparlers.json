                                "target_senses": [
                                    {
                                        "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                        "entry_id": "ddf4fba5-1424-3340-ba39-f38a1690e5b4",
                                        "glosses": [
                                            "A conference, especially one between enemies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38a0b76e-aedf-4146-ba45-02833632ffbb",
                                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                                "text": "We yield on parley, but are stormed in vain."
                                            },
                                            {
                                                "example_id": "f88d07c1-3159-439d-a467-c59425f6b923",
                                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                                "text": "Without further parley Garland rode off up the hog's-back and the sheriff rode off down it [...]"
                                            },
                                            {
                                                "example_id": "3a324378-25c9-4098-bcaa-945398abc299",
                                                "sense_id": "8b7975ff-9751-358a-ace2-2a1f6ac7df23",
                                                "text": "In the highest-level parley of leaders of the two countries since the accident, President Obama is to meet with Pakistan’s prime minister, Yousaf Raza Gilani, on Tuesday in Seoul, South Korea, after a nuclear security conference there, to discuss Afghanistan and other security issues."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd7a7e3-fd91-3d7d-9b46-b71856823028",
                                        "entry_id": "18a36e09-365e-35c2-b6f1-003e5a9a9390",
                                        "glosses": [
                                            "To have a discussion, especially one between enemies."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ee1a51-d4d9-41da-a278-93a8829be89b",
                                                "sense_id": "ddd7a7e3-fd91-3d7d-9b46-b71856823028",
                                                "text": "[...] at day break we found the villaine, who, loath to parlee in fire and ſhot, fled amaine and left us [...]"
                                            },
                                            {
                                                "example_id": "7bcad4f5-9b1b-435b-8772-100fea0f80a1",
                                                "sense_id": "ddd7a7e3-fd91-3d7d-9b46-b71856823028",
                                                "text": "\"That is droll. Listen yet one time. You are very spiritual. Can you make a honorable lady of Her?\" / \"Don't be so malicious,\" says Mr. Bucket. / \"Or a haughty gentleman of Him?\" cries Madamoiselle, referring to Sir Leicester with ineffable disdain. \"Eh! O then regard him! The poor infant! Ha! ha! ha!\" / \"Come, come, why this is worse Parlaying than the other,\" says Mr. Bucket. \"Come along!\""
                                            },
                                            {
                                                "example_id": "2dfe7cde-32fc-425b-8d6d-6c9ee10d239c",
                                                "sense_id": "ddd7a7e3-fd91-3d7d-9b46-b71856823028",
                                                "text": "Jack \"parlayed\" with them until he had completed his task, and then he closed the gate in their faces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
