                                                "example_id": "219eb753-87ae-487c-97e0-0624e7747854",
                                                "sense_id": "26e76cc6-479c-381e-9ed7-fb54258cea35",
                                                "text": "Florence, hardly glancing round her, lest she should remind him freshly of their last parting […] led him out to a coach that was waiting at the door, and carried him away."
                                            },
                                            {
                                                "example_id": "6f0b271b-f7d2-4fdf-886b-645375555242",
                                                "sense_id": "26e76cc6-479c-381e-9ed7-fb54258cea35",
                                                "text": "Filter cards were prepared from freshly collected blood (EDTA blood, 2–6 h old) and from hemolyzed blood (EDTA blood, 2–4 days stored at -20°C)."
                                            },
                                            {
                                                "example_id": "a8a0c4b9-66c0-4d1e-806d-e59b5d4a6989",
                                                "sense_id": "26e76cc6-479c-381e-9ed7-fb54258cea35",
