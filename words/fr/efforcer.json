                    "frequency": "Low",
                    "semantic_group_id": "effort_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>efforce</w> pas autant en soulevant ce meuble lourd, tu risques de te blesser."
                        },
