                ],
                "senses": [
                    {
                        "sense_id": "98215800-f866-34ed-99ee-40c226b2bff1",
                        "entry_id": "142379ff-9e88-3eb9-b6b8-88e702349bd3",
                        "glosses": [
                            "A domestic cat of a breed with little or no hair, a narrow long head, and webbed feet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117b23a0-d77e-4d46-a21b-b17579e4a032",
                                "sense_id": "98215800-f866-34ed-99ee-40c226b2bff1",
                                "text": "Sphynx cats are often called hairless cats. But Sphynx do have hair. Very short, fine hairs called down cover the Sphynx’s body."
                            }
                        ]
                    }
                ],
