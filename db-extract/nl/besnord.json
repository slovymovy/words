                "senses": [
                    {
                        "sense_id": "fb097322-c686-3354-b9f2-8bbed5688556",
                        "entry_id": "6c0beb70-146d-3130-af4b-f40a21e9b4f7",
                        "glosses": [
                            "een snor dragend; in het bezit zijn van een snor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e5da16b-5087-49ed-a6e8-548da21e49c4",
                                "sense_id": "fb097322-c686-3354-b9f2-8bbed5688556",
                                "text": "Het zijn kleurige tekeningen die een officier van het militaire opleidingsinstituut en een generaal verbeelden - bebaard en besnord, in blauwe uniformjassen met koppelriem en epauletten. Kinderlijk naïeve impressies van de omgeving vol wapengekletter waarin hij opgroeide."
                            },
                            {
                                "example_id": "8abddb19-d076-4082-81a0-bc38c07df0e8",
                                "sense_id": "fb097322-c686-3354-b9f2-8bbed5688556",
                                "text": "Ondertussen lachte zijn veel jongere vriendin Lena op de tribune maar wat mee; het moet toch geen fijn idee zijn dat haar lief de voorkeur geeft aan de naam van de besnorde voetbalanalist boven de hare. „Nee, zij staat nog nergens”, bekende Brusselmans desgevraagd aan presentator Wilfred Genee."
                            },
                            {
                                "example_id": "206d854c-df77-47f6-9787-8131aae0fcc0",
                                "sense_id": "fb097322-c686-3354-b9f2-8bbed5688556",
                                "text": "Het is tijd voor een feestje! Mario, de wereldbekende jolige besnorde held van Nintendo heeft ondanks zijn vele avonturen en sportactiviteiten namelijk ook nog wel eens tijd om een knalfuif te organiseren."
                            }
                        ]
                    }
