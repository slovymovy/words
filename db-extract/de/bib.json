                ],
                "senses": [
                    {
                        "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                        "entry_id": "d45492a8-90f2-30af-9fa3-aee2795c1ff5",
                        "glosses": [
                            "Bibliothek; Institution, in der Bücher oder sonstige Medien gelesen oder ausgeliehen werden können"
                        ],
                        "tags": [
                            "colloquial",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "898adeec-0f77-4884-9a88-ddcaf2f38c48",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "Ich gehe am Wochenende in die Bib."
                            },
                            {
                                "example_id": "2c76ec39-3c66-4f4e-975d-642097ffa013",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "„[…] auf dem Campus, der die Suche nach einem geeigneten Platz zu einem schwierigen Unterfangen macht: ‚Wollten erst in die Bib, dort darf man aber nicht reden, dann in die Chemie-Bib –> darf nichts trinken, draußen tröpfelt es –> Studentenhaus.‘“"
                            },
                            {
                                "example_id": "41c51374-a6a0-42f4-bd6a-b33b3915e690",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "„Die bot sich Freitag leider nicht wirklich, als du hinter mir aus der Bib nach draußen geeilt bist, ein schnelles ›Danke‹ fürs Aufhalten der Tür gesagt hast, doch dann fix an mir vorbei und ins Institutsgebäude geeilt bist.“"
                            },
                            {
                                "example_id": "9da0464b-3d56-4ba0-bfcf-3c3929b61fdf",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "„Natürlich wollen wir dir die wichtigsten Infos zur WU Wien Bibliothek nicht länger vorenthalten. Hast du denn schon einen Punkt, der dich in der Bib besonders interessiert, so empfehlen wir dir, unsere Schnellauswahl zu nutzen.“"
                            },
                            {
                                "example_id": "6ba87157-4314-418b-9c88-9e9fbda51be6",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "„Früher ging man in Jogginghosen und ungeschminkt in die Bib, was auch sinnvoll war, weil man da einfach nur lange herumsitzt und es die Hausarbeit nicht interessiert, wie man aussieht.“"
                            },
                            {
                                "example_id": "2b318e16-f4f4-4011-a888-a24bf9ca3290",
                                "sense_id": "a0df63fb-87a5-3805-a57d-5b689b55fdbc",
                                "text": "„Wenn meine Freunde morgens schreiben, sie gehen in die Bib, springe ich sofort auf, weil ich dabei sein will, wenn beim Mittagessen die Klausurschwerpunkte diskutiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
