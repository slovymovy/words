                ],
                "senses": [
                    {
                        "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                        "entry_id": "9435fd98-ffa5-3c97-b7ec-9a6c2ab67720",
                        "glosses": [
                            "Sinneseindruck ohne nachweisbaren äußeren Reiz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ea0a56-59a5-4a02-93ed-adad44ba476b",
                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                "text": "Typisch für eine Schizophrenie sind vor allem akustische Halluzinationen."
                            },
                            {
                                "example_id": "0823e3f6-f759-4499-8435-d7d4212da438",
                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                "text": "„Das war einfach eine Halluzination gewesen.“"
                            },
                            {
                                "example_id": "4847b2d8-4ee6-495e-83c4-61d9b8e1bae8",
                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                "text": "„Bei Halluzinationen handelt es sich meist um sehr zahlreich auftretende Bilder, die entweder der gewünschten Zukunft oder der analysierten Vergangenheit, je nach Krankheitsintensität oder Erschöpfung des Gehirns gestuft, entspringen.“"
                            },
                            {
                                "example_id": "e868cdd0-3fa0-4414-9dc3-295549bc7441",
                                "sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                                "text": "„Hitze und Langeweile führten zu mancherlei Halluzinationen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f871f514-4123-451f-adbf-44c50dc1f5b1",
                        "source_entry_id": "9435fd98-ffa5-3c97-b7ec-9a6c2ab67720",
                        "source_sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                        "source_sense_description": "Sinneseindruck ohne nachweisbaren äußeren Reiz",
                        "target_lang_word": "hallucination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallucination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "A sensory perception of something that does not exist, often arising from disorder of the nervous system, as in delirium tremens."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5286a4ee-12da-47d4-9e47-0e209439083c",
                                                "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                                "text": "Hallucinations are always evidence of cerebral derangement and are common phenomena of insanity."
                                            },
                                            {
                                                "example_id": "16b5d453-22b8-4160-b354-8f1d9628df76",
                                                "sense_id": "a1e20531-61a0-389f-bf45-bab8c2cc7e17",
                                                "text": "The authorities said that the spinach had caused “possible food-related toxic reactions” with those affected experiencing symptoms including delirium, hallucinations, blurred vision, rapid heartbeat and fever."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce743bb5-1ebd-33fb-b21b-0d44aa0f9057",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "The act of hallucinating; a wandering of the mind; an error, mistake or blunder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97150574-b486-4653-80c9-960417312674",
                                                "sense_id": "ce743bb5-1ebd-33fb-b21b-0d44aa0f9057",
                                                "text": "This must have been the hallucination of the transcriber."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                        "entry_id": "8cced221-0d44-3e4c-a37a-b26a33d07e9e",
                                        "glosses": [
                                            "A confident but incorrect response given by an artificial intelligence; a confabulation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5683a0db-e1d1-404c-821a-f9352c7219a9",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "Chatbots even forget that they are a bot and experience \"hallucinations\", Meta's description for when a bot confidently says something that is not true."
                                            },
                                            {
                                                "example_id": "ba34fc7c-22e2-4022-a42f-fba0e9b7968f",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "Hallucinations are about adhering to the truth; when A.I. systems get confused, they have a bad habit of making things up rather than admitting their difficulties."
                                            },
                                            {
                                                "example_id": "6c9c668f-32b9-497d-8d6b-5781f42d7374",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "It may tell you that the official currency of Switzerland is the euro (it’s actually the Swiss franc) or that Mark Twain’s Celebrated Jumping Frog of Calaveras County could not only jump but talk. A.I. researchers call this generation of untruths “hallucination.”"
                                            },
                                            {
                                                "example_id": "a6ef38a1-e04a-42ef-bc54-4ef14535f104",
                                                "sense_id": "08ed37d6-ef7d-36bb-8f42-b806e0a64e05",
                                                "text": "The hallucinations common to AI also came under fire in the suit for potentially damaging the value of the Times' reputation, and possibly damaging human health as a side effect. “A GPT model completely fabricated that “The New York Times published an article on January 10, 2020, titled ‘Study Finds Possible Link between Orange Juice and Non-Hodgkin’s Lymphoma,’” the suit alleges. “The Times never published such an article.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bba17cb-0f01-4350-928e-4774c0b6c1a4",
                        "source_entry_id": "9435fd98-ffa5-3c97-b7ec-9a6c2ab67720",
                        "source_sense_id": "bb4b73a2-d368-37c9-8eb5-574b4390f535",
                        "source_sense_description": "Sinneseindruck ohne nachweisbaren äußeren Reiz",
                        "target_lang_word": "hallucination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hallucination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                        "entry_id": "2c3c4864-6b8b-303f-83cf-bea6faee6057",
                                        "glosses": [
                                            "Perception sans objet réel, qui peut affecter la vision, l'audition, l'olfaction, le toucher et le goût. Le sujet n'est pas conscient de son caractère pathologique contrairement à l'hallucinose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5608dbe6-aab2-42b3-806a-543bcf8e26c8",
                                                "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                                "text": "Un délicieux témoignage a été laissé par Théophile Gautier dans sa nouvelle le Club des Haschichins. Le Dʳ Moreau chargeait tellement en shit son dawamesk que le pauvre Gautier, au-delà de l’euphorie, eut parfois des hallucinations."
                                            },
                                            {
                                                "example_id": "22ed1fe5-f46b-457e-a224-b7230244bc09",
                                                "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                                "text": "Fines herbes psychotropiques, notamment silène, spergule et saponaire, concoctées avec ester stéarique de glycérine et jus de coquelicot ranci. Recette infaillible pour susciter hallucinations catachrétiques."
                                            },
                                            {
                                                "example_id": "581a03ed-49ee-4322-bcca-6229f434743e",
                                                "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                                "text": "Tu conçois l’hallucination comme une tromperie alors qu'elle met fin aux tromperies. Loin de produire une illusion, l'hallucination révèle la vérité."
                                            },
                                            {
                                                "example_id": "046974d2-19e6-43e3-bc8d-656038690e1d",
                                                "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                                "text": "Les rituels des psychotiques ont souvent des fonctions de protection contre les hallucinations. L'oreille coupée de Van Gogh est probablement l'effet d'un rituel qui devait le protéger contre des hallucinations auditives."
                                            },
                                            {
                                                "example_id": "110bdb3a-5c1f-4f07-a7e1-1ffca2279951",
                                                "sense_id": "4aeba759-803e-3d83-951e-790eb709a738",
                                                "text": "Les crises d’épilepsie que l'on regroupe sous le nom d’épilepsie temporale sont complexes et leurs manifestations cliniques très variées ; parmi elles on décrit les hallucinations, les troubles instinctivo-affectifs, les troubles du comportement moteur et verbal, des troubles gnosiques auditifs et visuels, des troubles phasiques, des troubles de la conscience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bd30cd3-5319-3230-ba8a-c487c9362d9c",
                                        "entry_id": "2c3c4864-6b8b-303f-83cf-bea6faee6057",
                                        "glosses": [
                                            "Illusion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b238d704-3fe3-43a5-b0e0-88175b4c5512",
                                                "sense_id": "6bd30cd3-5319-3230-ba8a-c487c9362d9c",
                                                "text": "Les histoires vraisemblables ne méritent plus d'être racontées. Le naturalisme les a décriées au point de faire naître, chez tous les intellectuels, un besoin famélique d'hallucination littéraire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f768f981-a9f4-3182-8117-0043a99e3d53",
                                        "entry_id": "2c3c4864-6b8b-303f-83cf-bea6faee6057",
                                        "glosses": [
                                            "Réponse vraisemblable mais incorrecte donnée par une intelligence artificielle."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "008e528a-9090-4181-865f-ea1ccc821729",
                                                "sense_id": "f768f981-a9f4-3182-8117-0043a99e3d53",
                                                "text": "Ces IA sont notamment soupçonnées de répandre des réponses fausses à des questions des utilisateurs (« hallucinations ») ainsi que des photos, vidéos ou sons générés ou modifiés artificiellement mais ayant l’apparence du vrai (« deepfakes »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
