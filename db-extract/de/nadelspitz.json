                ],
                "senses": [
                    {
                        "sense_id": "a259b6fe-f66e-3b17-bef4-88e62fb54889",
                        "entry_id": "cf587859-ce7a-3ef4-b07c-b513d121147b",
                        "glosses": [
                            "sehr spitz, spitz zulaufend wie eine Nadel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c864f5-a762-43ab-8c07-1bdf8a1346cc",
                                "sense_id": "a259b6fe-f66e-3b17-bef4-88e62fb54889",
                                "text": "„Dort am äußersten weißen Horizont hinter der grotesken Stadt erkannten wir jetzt eine dunkle, verhexte Linie violetter Gipfel, deren nadelspitze Zinnen sich undeutlich vor dem lockenden Rosenrot des Himmels abhoben.“"
                            },
                            {
                                "example_id": "fdcb44e1-0b0c-4111-9a54-e615b8d2ccd0",
                                "sense_id": "a259b6fe-f66e-3b17-bef4-88e62fb54889",
                                "text": "„Der Faustschild mit dem Stoßdorn, die Keule, das Breitschwert, das Jagdmesser, die Streitaxt und der nadelspitze Dolch fielen klirrend vor dem Obsidianblock zu Boden.“"
                            },
                            {
                                "example_id": "93c9e7c1-6ca1-4bdf-a82a-b7250e43d860",
                                "sense_id": "a259b6fe-f66e-3b17-bef4-88e62fb54889",
                                "text": "„Johnny hatte uns beide jetzt wieder ganz klar im Blickfeld, doch seine Pupillen waren nadelspitz und seine Gliedmaßen schlaff und schwammig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
