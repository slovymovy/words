                "senses": [
                    {
                        "sense_id": "997492a9-f19d-38e4-a643-819158c47172",
                        "entry_id": "0686bcb6-20af-3569-b5ec-04ed9f68b03e",
                        "glosses": [
                            "einem Plakat ähnelnde Präsentationsform, bei der man etwas aufklappen kann und die durch Faltbüchlein, Taschen und Ähnliches zum Entdecken einlädt"
                        ],
                        "tags": [
                            "Schule"
                        ],
                        "examples": [
                            {
                                "example_id": "97b1fd19-8836-41ab-b3c0-173a3d8341f9",
                                "sense_id": "997492a9-f19d-38e4-a643-819158c47172",
                                "text": "„Lapbooks werden in nordamerikanischen Schulen sehr häufig im Rahmen der Beschäftigung mit einem Sachthema eingesetzt.“"
                            },
                            {
                                "example_id": "3ab04939-4170-4b49-916b-320465125766",
                                "sense_id": "997492a9-f19d-38e4-a643-819158c47172",
                                "text": "„Jedes Lapbook ist individuell, keines gleicht dem anderen.“"
                            },
                            {
                                "example_id": "34fdb750-4a5e-454e-92c8-7ce7ab098904",
                                "sense_id": "997492a9-f19d-38e4-a643-819158c47172",
                                "text": "„In einem Lapbook können in Kleingruppen oder mit der ganzen Lerngruppe wichtige Erkenntnisse, Informationen zu verschiedenen Aspekten und persönliche Wertungen schriftlich und zeichnerisch festgehalten werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
