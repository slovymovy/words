                ],
                "senses": [
                    {
                        "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                        "entry_id": "69a623d9-4a70-3794-8e69-9c473b97e9d6",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cbbdcb9-a9de-4287-9429-0de3bc34cb1d",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Frau Meinhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "233baa2d-2324-42dd-a878-cade00483ad9",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Herr Meinhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c3118562-c4e7-491e-881a-15cefe190137",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Die Meinhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ab5b6ef6-d377-40f8-ae30-41d5b140484f",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Der Meinhardt trägt nie die Schals, die die Meinhardt ihm strickt."
                            },
                            {
                                "example_id": "2a57fa35-7b23-4ff7-87bd-2718e2df6e37",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meinhardt kommt, geht der Herr Meinhardt.“"
                            },
                            {
                                "example_id": "8ae7287e-4f08-40b7-bb05-627fcf4825b5",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Meinhardt kommt und geht."
                            },
                            {
                                "example_id": "67012358-c21d-4d39-ab52-b795f20c42e1",
                                "sense_id": "fee75547-f251-3b74-85ee-423f517bc999",
                                "text": "Meinhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
