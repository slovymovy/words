                        "entry_id": "9c8a7ced-028b-3787-8462-b004b3642584",
                        "glosses": [
                            "Rahmenbedingungen und Beschreibung des Ablaufs einer Prüfung (eines Tests, meist Softwaretests)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa5c7688-4cfd-4009-b6c0-e9500efd0b1f",
                                "sense_id": "11c7cb18-e1e9-38cb-b3a4-769ef4e81197",
                                "text": "Die Testinfrastruktur soll gewährleisten, dass die gewählte Strategie umgesetzt werden kann und alle vorgesehenen Prüfungen durchgeführt werden können."
                            },
                            {
                                "example_id": "a5a09934-fe9f-410e-afc5-f9ac0ac6dc2e",
                                "sense_id": "11c7cb18-e1e9-38cb-b3a4-769ef4e81197",
                                "text": "Die Testinfrastruktur umfasst die notwendigen Räumlichkeiten, die Technik, ein Testlabor, die definierte Testumgebung, ein Testdatenset und die Umgebung für den Test des Antwortzeitverhaltens."
                            }
                        ],
