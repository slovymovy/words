{
    "word_family": [
        "condimental"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2751e78d-bf26-36b3-9ee1-57d2ff8dfe22",
                    "sense_definition": "A substance, such as a sauce, powder, or spice, used to enhance the flavor of food, especially when added after cooking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mustard is a popular <w>condiment</w> that people often put on hot dogs and hamburgers.",
                            "target_lang_translations": {
                                "ru": "Горчица — популярная <w>приправа</w>, которую люди часто добавляют в хот-доги и гамбургеры."
                            }
                        },
                        {
                            "text": "The restaurant table was set with a small tray containing salt, pepper, and other <w>condiments</w>.",
                            "target_lang_translations": {
                                "ru": "На ресторанном столике стоял небольшой поднос с солью, перцем и другими <w>приправами</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "seasoning",
                        "relish"
                    ],
                    "common_phrases": [
                        "popular condiment",
                        "table condiment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, такое как соус, порошок или специя, используемое для улучшения вкуса пищи, особенно добавляемое после приготовления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправа",
                                "target_lang_sense_clarification": "соус, специя или добавка к еде"
                            },
                            {
                                "target_lang_word": "специи",
                                "target_lang_sense_clarification": "вкусовые добавки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "42668705-6691-3d30-94bd-675c6653b791",
                    "sense_definition": "To season or flavor food with condiments.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seasoning_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef decided to <w>condiment</w> the dish lightly so as not to overpower the natural flavor of the fish.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил слегка <w>приправить</w> блюдо, чтобы не заглушить естественный вкус рыбы."
                            }
                        },
                        {
                            "text": "He prefers to <w>condiment</w> his meals at the table rather than during the cooking process.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает <w>сдабривать</w> еду приправами за столом, а не во время приготовления."
                            }
                        }
                    ],
                    "synonyms": [
                        "season",
                        "flavor",
                        "spice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приправлять или сдабривать пищу специями, соусами или приправами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приправлять",
                                "target_lang_sense_clarification": "добавлять приправы или соусы"
                            },
                            {
                                "target_lang_word": "сдабривать",
                                "target_lang_sense_clarification": "улучшать вкус пищи добавками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ac2c234-0e1d-3971-9c84-8e633097b880",
                    "sense_definition": "To preserve food by pickling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "seasoning_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, families would <w>condiment</w> their autumn harvest of vegetables to last through the winter.",
                            "target_lang_translations": {
                                "ru": "В прежние времена семьи <w>консервировали</w> осенний урожай овощей, чтобы его хватило на всю зиму."
                            }
                        },
                        {
                            "text": "The recipe explains how to <w>condiment</w> cucumbers in a spiced vinegar solution.",
                            "target_lang_translations": {
                                "ru": "В рецепте объясняется, как <w>мариновать</w> огурцы в пряном растворе уксуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "pickle",
                        "preserve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean pickling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Консервировать продукты путем маринования или засолки (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мариновать",
                                "target_lang_sense_clarification": "консервировать в уксусе со специями"
                            },
                            {
                                "target_lang_word": "консервировать",
                                "target_lang_sense_clarification": "заготавливать впрок"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}