                        "glosses": [
                            "Dienstleistungsunternehmen für das Sammeln, Befördern und Zustellen von Briefen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6c1b86-3360-424a-8b0e-67d2f971b234",
                                "sense_id": "77985cea-8161-3c75-84cc-20e14d175238",
                                "text": "„Das Bundesfinanzministerium hat am 24.09.2008 ein Gesetz entworfen, das besagt, dass ab dem Jahr 2010 alle Postanbieter für eine Auswahl häufig genutzter Produkte und Dienstleistungen umsatzsteuerbefreit sind.“"
                            },
                            {
                                "example_id": "16542731-467d-4293-8b26-d08a41f4ef72",
                                "sense_id": "77985cea-8161-3c75-84cc-20e14d175238",
                                "text": "„Wie die Postregulationsbehörde (PostReg) am Dienstag mitteilte, erteilte der Chef des Departements für Umwelt, Verkehr, Energie und Kommunikation (UVEK) die neuen Konzessionen für die beiden privaten Postanbieter auf ihre Empfehlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
