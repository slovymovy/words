                "senses": [
                    {
                        "sense_id": "23579a6f-43d3-344b-a04f-a24095a31678",
                        "entry_id": "ed943dcf-a7cb-396b-950e-e5675364ed1f",
                        "glosses": [
                            "Danser le rigaudon, s’ébattre joyeusement."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6aef1404-47fc-44ac-81a4-e8194908d194",
                                "sense_id": "23579a6f-43d3-344b-a04f-a24095a31678",
                                "text": "Pars donc, et que ce soir, Nelson, ne t’en déplaise,\nAvec ta femme ici rigaudonne à son aise."
                            },
                            {
                                "example_id": "284df222-5597-456a-a3ce-37c23f4cab72",
                                "sense_id": "23579a6f-43d3-344b-a04f-a24095a31678",
                                "text": "Toutes les classes de la société sont galvanisées par la Dansomanie ; on rigaudonne jusque dans les greniers misérables des faubourgs ; plusieurs bals champêtres se sont établis dans les caves de restaurateurs, dans les sous-sols de boutiquiers."
                            }
                        ]
                    }
