                                        "entry_id": "fd2d7d85-4c90-38c6-b082-a7cb42d6819a",
                                        "glosses": [
                                            "The act of storing documents in an archive; archiving."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "060f91fb-b3e8-3b3a-a5c0-2ba4e1219e10",
                                        "entry_id": "fd2d7d85-4c90-38c6-b082-a7cb42d6819a",
                                        "glosses": [
                                            "Something that has been officially filed; a document on file."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1288cdd4-0bb4-4d07-950c-13f56ef5f073",
                                                "sense_id": "060f91fb-b3e8-3b3a-a5c0-2ba4e1219e10",
                                                "text": "Mueller said in a court filing that Cohen had admitted he briefed Trump and unidentified Trump family members about the progress of the project more extensively than was previously known."
                                            }
