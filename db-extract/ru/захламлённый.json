                "senses": [
                    {
                        "sense_id": "8622b014-a1a5-3770-8fa1-1c5fefbeb626",
                        "entry_id": "4cf44b61-b175-3f96-bacb-000b8e37e532",
                        "glosses": [
                            "страд. прич. прош. вр. от захламить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "f346e6c5-f85e-49eb-b77f-68121e084f2a",
                                "sense_id": "8622b014-a1a5-3770-8fa1-1c5fefbeb626",
                                "text": "Две спаленки первого этажа, кухня, совмещённая со столовой, и чердак были порядочно захламлены."
                            }
                        ]
                    },
                    {
                        "sense_id": "c86b3346-67a3-34ca-a3e2-4f6fa4ff12fb",
                        "entry_id": "4cf44b61-b175-3f96-bacb-000b8e37e532",
                        "glosses": [
                            "адъектив. заставленный, заваленный хламом, ненужными вещами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceae5c78-152e-4fa6-a0c8-70a5d5e83aba",
                                "sense_id": "c86b3346-67a3-34ca-a3e2-4f6fa4ff12fb",
                                "text": "В квартиру подселили многолюдное и многодетное семейство, в результате чего она превратилась в захламлённую и тесную коммуналку."
                            }
                        ]
                    }
