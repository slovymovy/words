                        "bei hohem Wellengang schlingern"
                    ]
                },
                {
                    "sense_id": "0086c999-edd7-3425-9be5-a7f07ef36ae1",
                    "sense_definition": "aufgrund von Trunkenheit oder Schwäche unsicher und schwankend gehen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Abend in der Kneipe <w>schlingerte</w> der Mann mühsam durch die Gassen."
                        },
                        {
                            "text": "Völlig entkräftet von der langen Wanderung <w>schlingerte</w> er über die Ziellinie."
