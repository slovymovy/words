                                            {
                                                "example_id": "97316750-3910-4359-b7ae-4113a4aba8cc",
                                                "sense_id": "6075ef69-1512-3f34-8cae-0ecf1de9f2d9",
                                                "text": "Кирпичи с грузовика как ветром срывало, так что уцелевших почти не оставалось, а только половняк."
                                            }
                                        ]
                                    }
