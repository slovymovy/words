                ],
                "senses": [
                    {
                        "sense_id": "c6d0306d-db1f-32be-be38-717e93a76228",
                        "entry_id": "78a1a17a-adf6-3cc1-ac4c-d126929b520e",
                        "glosses": [
                            "das Massieren der Füße"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2859266e-6f28-4e0b-b8c3-3080dd229add",
                                "sense_id": "c6d0306d-db1f-32be-be38-717e93a76228",
                                "text": "„Kümmere dich diese Woche doch einmal ganz bewusst um deine Füße und gönne dir zum Beispiel eine Pediküre, eine Fußmassage oder ein Fußbad.“"
                            },
                            {
                                "example_id": "2c96881c-c04c-4882-8f8a-4a30baf48078",
                                "sense_id": "c6d0306d-db1f-32be-be38-717e93a76228",
                                "text": "„Vor allem den Menschen, die aufgrund von Übelkeit und Schmerzen starke Schlafprobleme haben, kann eine Fußmassage enorm helfen.“"
                            },
                            {
                                "example_id": "fbb9ab43-8b45-454b-a68e-227a63eff8ee",
                                "sense_id": "c6d0306d-db1f-32be-be38-717e93a76228",
                                "text": "„Da sein Hobby die Fußmassage ist, massiert er meine Füße, was sehr wohltuend ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
