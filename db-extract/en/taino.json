                                            {
                                                "example_id": "6c43eb74-6c93-49aa-a5f2-9b7a62eba945",
                                                "sense_id": "f6dd2e98-0918-3b9c-83c3-5d4b4af9ed1a",
                                                "text": "Victimes de maladies importées et d’assimilation forcée, les taïnos ont pratiquement disparu des Caraïbes."
                                            }
                                        ]
                                    }
                                ]
                            },
