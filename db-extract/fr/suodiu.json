                        "glosses": [
                            "Plat chinois comportant des cailloux, que les consommateurs sucent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3175ba01-8516-4679-be92-31f7665858b3",
                                "sense_id": "c1dc4895-6aa1-3644-8704-4820755640b9",
                                "text": "Le suodiu a été inventé par les bateliers de la région qui, à court d'animaux et de légumes lorsqu'ils voyageaient sur le fleuve Yangtze, se tournaient vers les minéraux."
                            },
                            {
                                "example_id": "394651b0-d94f-45e8-9f48-324d99de9eb7",
                                "sense_id": "c1dc4895-6aa1-3644-8704-4820755640b9",
                                "text": "Le suodiu, plat traditionnel chinois, a la réputation d’être le plat le plus dur du monde, en raison d’un de ses ingrédients : des pierres."
                            },
                            {
                                "example_id": "c9c8065b-3be5-44e1-af97-cbaf1816c08d",
                                "sense_id": "c1dc4895-6aa1-3644-8704-4820755640b9",
                                "text": "Le suodiu est un plat traditionnel chinois un peu particulier en raison de son ingrédient principal : des cailloux."
                            }
                        ]
                    }
