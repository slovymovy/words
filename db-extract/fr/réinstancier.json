                                        "glosses": [
                                            "To instantiate again."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19b5ed7c-ac49-45ad-93a3-81a69af7bd1e",
                                                "sense_id": "f18e351a-5ecf-3199-bb36-bf0ba9af8359",
                                                "text": "with the claim that ontogeny recapitulates phylogeny clearly implying that it reinstantiates some underlying unitary force or principle"
                                            },
                                            {
                                                "example_id": "baf5cb61-bddf-4032-b816-558f4b865604",
                                                "sense_id": "f18e351a-5ecf-3199-bb36-bf0ba9af8359",
                                                "text": "The TRC setting begins to reverse this double trauma: it simultaneously helps to reinstantiate her subjectivity and her membership in the community."
