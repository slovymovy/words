                                "example_id": "cb020bec-cb66-404a-abfd-a1446e596db7",
                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                "text": "Un ministre, un préfet démissionnaire."
                            },
                            {
                                "example_id": "95a7e6a1-1345-48e0-bb0d-2b14e9c5ec19",
                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                "text": "— Les élèves perturbateurs, c'est à la schlague qu'il faut les remettre au pas. Quant aux parents démissionnaires, on va leur supprimer les allocs !"
                            },
                            {
                                "example_id": "1b518923-ae36-4471-b57c-5d0cb3539c7c",
                                "sense_id": "c2f91919-9465-31e5-a4b8-3a21f5072002",
                                "text": "Le salarié présumé démissionnaire ne bénéficiera pas des allocations chômage et devra exécuter son préavis de démission."
                            }
                        ]
                    }
