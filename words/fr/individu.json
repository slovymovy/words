                    "frequency": "High",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La société moderne doit respecter la liberté fondamentale de chaque <w>individu</w>."
                        },
                        {
                            "text": "Dans ce pays, les droits de l'<w>individu</w> sont protégés par la constitution."
                        }
                    ],
                    "synonyms": [
                        "personne",
                        "être humain"
                    ],
                    "antonyms": [
                        "collectivité"
                    ],
                    "common_phrases": [
                        "droits de l'individu",
                        "liberté de l'individu"
                    ]
                },
                {
                    "sense_id": "301bbc71-c8bd-3fe6-a343-445a236bfdb2",
                    "sense_definition": "Personne indéterminée, souvent désignée avec méfiance ou de façon péjorative dans un contexte policier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police recherche un <w>individu</w> suspect aperçu près de la banque hier soir."
                        },
                        {
                            "text": "Cet étrange <w>individu</w> refusait catégoriquement de décliner son identité."
                        }
                    ],
                    "synonyms": [
                        "quidam",
                        "type"
                    ],
                    "common_phrases": [
                        "individu suspect",
                        "individu dangereux"
                    ]
                },
                {
                    "sense_id": "a06bff0f-18f5-30da-af78-113e5574fe66",
                    "sense_definition": "Chaque spécimen vivant d'une espèce animale ou végétale pris isolément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque <w>individu</w> de cette colonie d'oiseaux contribue à la surveillance du nid."
                        },
                        {
                            "text": "Les biologistes ont bagué un jeune <w>individu</w> avant de le relâcher dans la nature."
