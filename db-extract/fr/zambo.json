                "senses": [
                    {
                        "sense_id": "f77da6d3-69c8-3629-bfd4-b7f4fccc5413",
                        "entry_id": "95c04002-ab65-3f79-89cd-fc28d94afb2f",
                        "glosses": [
                            "Enfant de Noirs d’Afrique et d’indigènes dans certaines parties de l’Amérique espagnole."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "44b49841-520a-4896-b6cd-d5eb93edfa35",
                                "sense_id": "f77da6d3-69c8-3629-bfd4-b7f4fccc5413",
                                "text": "Éclaireurs et mercenaires pour le compte des pirates, depuis le cap Gracias a Dios jusqu’au río San Juan – au sud de la Moskitia – , en passant par les îles de Corn Island , les zambos inaugurent une longue tradition de combats aux côtés des Anglais, contre les Espagnols installés côté Pacifique et soigneusement maintenus à distance."
                            },
                            {
                                "example_id": "5210ce25-9442-4cbf-a5d8-d9ed93003b80",
                                "sense_id": "f77da6d3-69c8-3629-bfd4-b7f4fccc5413",
                                "text": "La Cadillac frôle un groupe de zambos, pauvrement vêtus, porteurs de parapluies qui semblent égarés, là, et jettent à la voiture des regards apeurés."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f3f36f1-16cd-3780-886d-eff9430b3380",
                        "entry_id": "95c04002-ab65-3f79-89cd-fc28d94afb2f",
                        "glosses": [
                            "Poisson de la famille des éléotridés, de nom scientifique Dormitator latifrons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "047b04fe-ac35-4016-888f-30ee1651d095",
                                "sense_id": "0f3f36f1-16cd-3780-886d-eff9430b3380",
                                "text": "« Les zambos sont de vrais petits guerriers face au Zika : ils mangent toutes les larves dans les récipients où nous stockons l’eau », déclare Rafael Gonzalez, 30 ans, pêcheur dans ce village situé à 45 km de San Salvador."
                            }
                        ]
                    }
