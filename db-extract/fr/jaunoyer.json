                        ],
                        "examples": [
                            {
                                "example_id": "7bfeb6a9-1401-4efc-a8b1-ee59cd2842ef",
                                "sense_id": "b085fd10-4fd8-3586-8005-9a04c9fbacc7",
                                "text": "Moi j’entre en mon avril, une blonde jeunesse\nÀ peine a fait jaunoyer un coton\nQui crespelu folâtre encore sur mon menton."
                            },
                            {
                                "example_id": "46f0dc3d-183d-4330-a584-b64d39419aec",
                                "sense_id": "b085fd10-4fd8-3586-8005-9a04c9fbacc7",
                                "text": "Au-dessus de la mer le soleil commença à jaunoyer puis à rougeoyer. C’était très joli."
                            }
                        ]
                    }
