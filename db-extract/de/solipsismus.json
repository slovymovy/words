                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "The idea that the self is all that exists or that can be proven to exist."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "Self-absorption, an unawareness of the views or needs of others; self-centeredness; egoism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c212b797-e152-4758-9fd8-f3025674288d",
                                                "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                                "text": "The solipsism that too frequently infects high commands has no place on a battlefield."
                                            },
                                            {
                                                "example_id": "b7491c68-5e98-466b-8f31-21723e797c35",
                                                "sense_id": "c76fc401-1c14-3045-9ec4-60f3aa3cb2c8",
                                                "text": "Self-mythology has always been part of The Darkness’ shtick, but here Hawkins and crew forget to back it up with music catchy enough to transcend the solipsism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15c484cb-a32b-3768-ae6d-58531be8ec67",
                                        "entry_id": "387f721e-35ec-3119-915a-7333bc7eb46b",
                                        "glosses": [
                                            "Self-absorption, an unawareness of the views or needs of others; self-centeredness; egoism.",
                                            "Masturbation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05b09263-543f-41e7-b2e3-0f01e4e05463",
                        "source_entry_id": "382283a5-dc51-3268-9f71-be0ca3d3c0da",
