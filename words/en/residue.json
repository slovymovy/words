{
    "word_family": [
        "residual",
        "residuary",
        "residuum"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8af68a0b-7e55-326f-a9ff-6a455a893a11",
                    "sense_definition": "Whatever remains after something else has been removed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After cleaning the window with soap, a thin <w>residue</w> of film was still visible.",
                            "target_lang_translations": {
                                "ru": "После мытья окна с мылом все еще был виден тонкий <w>налет</w>."
                            }
                        },
                        {
                            "text": "The sticky <w>residue</w> left by the tape was very difficult to remove from the table.",
                            "target_lang_translations": {
                                "ru": "Липкий <w>остаток</w>, оставленный скотчем, было очень трудно удалить со стола."
                            }
                        }
                    ],
                    "synonyms": [
                        "remnant"
                    ],
                    "common_phrases": [
                        "sticky residue",
                        "oily residue",
                        "leave a residue"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что остается после того, как что-то другое было удалено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "налет",
                                "target_lang_sense_clarification": "тонкий слой на поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56f8197c-7610-34e0-b17e-6bf8ba86cfb7",
                    "sense_definition": "The substance that remains after evaporation, distillation, filtration or any similar process.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist analyzed the white <w>residue</w> left in the flask after the liquid evaporated.",
                            "target_lang_translations": {
                                "ru": "Химик проанализировал белый <w>осадок</w>, оставшийся в колбе после испарения жидкости."
                            }
                        },
                        {
                            "text": "Filtering the mixture left a sandy <w>residue</w> on the paper.",
                            "target_lang_translations": {
                                "ru": "После фильтрации смеси на бумаге остался песчаный <w>осадок</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical residue",
                        "pesticide residue",
                        "filter residue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, остающееся после испарения, дистилляции, фильтрации или любого подобного процесса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осадок",
                                "target_lang_sense_clarification": "в химии"
                            },
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "после процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ee3e6d4-dca0-38b9-a45f-7411d99a22b9",
                    "sense_definition": "Whatever property or effects are left in an estate after payment of all debts and specific bequests.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remainder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The will stated that the <w>residue</w> of the estate should be donated to charity.",
                            "target_lang_translations": {
                                "ru": "В завещании было указано, что <w>остаток</w> имущества должен быть передан на благотворительность."
                            }
                        },
                        {
                            "text": "After all debts were paid, the <w>residue</w> was divided among the surviving children.",
                            "target_lang_translations": {
                                "ru": "После выплаты всех долгов <w>оставшаяся часть</w> была разделена между выжившими детьми."
                            }
                        }
                    ],
                    "common_phrases": [
                        "residue of the estate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество или средства, оставшиеся в наследственной массе после выплаты всех долгов и конкретных завещательных отказов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "наследства"
                            },
                            {
                                "target_lang_word": "оставшаяся часть",
                                "target_lang_sense_clarification": "имущества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89ccc532-6f00-3d04-a5d0-9de7d32bfa90",
                    "sense_definition": "A molecule that is part of a polymer chain, such as an amino acid in a polypeptide.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "scientific_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each amino acid <w>residue</w> in the protein sequence plays a vital role in its folding.",
                            "target_lang_translations": {
                                "ru": "Каждый аминокислотный <w>остаток</w> в последовательности белка играет жизненно важную роль в его сворачивании."
                            }
                        },
                        {
                            "text": "The researchers identified a specific <w>residue</w> that was essential for the enzyme's activity.",
                            "target_lang_translations": {
                                "ru": "Исследователи идентифицировали конкретный <w>остаток</w>, который был необходим для активности фермента."
                            }
                        }
                    ],
                    "common_phrases": [
                        "amino acid residue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "biochemistry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Молекула, являющаяся частью полимерной цепи, например, аминокислота в полипептиде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "аминокислотный или кислотный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdb9bb20-d51a-34cf-b5c5-3489af08c971",
                    "sense_definition": "The nonnegative remainder after dividing a number by a base in modular arithmetic.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this calculation, we need to find the least positive <w>residue</w> modulo seven.",
                            "target_lang_translations": {
                                "ru": "В этом вычислении нам нужно найти наименьший положительный <w>вычет</w> по модулю семь."
                            }
                        },
                        {
                            "text": "The <w>residue</w> of fifteen divided by four is three.",
                            "target_lang_translations": {
                                "ru": "<w>Остаток</w> от деления пятнадцати на четыре равен трем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "quadratic residue"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неотрицательный остаток после деления числа на основание в модульной арифметике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "остаток",
                                "target_lang_sense_clarification": "при делении"
                            },
                            {
                                "target_lang_word": "вычет",
                                "target_lang_sense_clarification": "в теории чисел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "debaf499-3e6d-3453-9a26-95c57917cb72",
                    "sense_definition": "A complex number proportional to the contour integral of a meromorphic function around a singularity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematical_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "By taking <w>residues</w>, we can represent this integral in terms of a Jackson integral.",
                            "target_lang_translations": {
                                "ru": "Используя <w>вычеты</w>, мы можем представить этот интеграл через интеграл Джексона."
                            }
                        },
                        {
                            "text": "The sum of the <w>residues</w> at the poles determines the value of the closed loop integral.",
                            "target_lang_translations": {
                                "ru": "Сумма <w>вычетов</w> в полюсах определяет значение интеграла по замкнутому контуру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "calculus of residues"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "complex analysis"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комплексное число, пропорциональное контурному интегралу мероморфной функции вокруг особой точки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вычет",
                                "target_lang_sense_clarification": "в комплексном анализе"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}