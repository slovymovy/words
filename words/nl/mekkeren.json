{
    "word_family": [
        "gemekker",
        "gemekkerd"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "93b5fe5e-eae9-3d4d-a90b-101c0159c35d",
                    "sense_definition": "het geluid van een geit of schaap maken",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "dierengeluiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als ik de geiten in de wei hoor <w>mekkeren</w> weet ik dat ik dichtbij huis ben.",
                            "target_lang_translations": {
                                "en": "When I hear the goats <w>bleating</w> in the meadow, I know I am close to home."
                            }
                        },
                        {
                            "text": "Het kleine lammetje begon luid te <w>mekkeren</w> toen het zijn moeder niet meer zag.",
                            "target_lang_translations": {
                                "en": "The little lamb started to <w>bleat</w> loudly when it could no longer see its mother."
                            }
                        }
                    ],
                    "synonyms": [
                        "blaten"
                    ],
                    "common_phrases": [
                        "geiten horen mekkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to make the sound of a goat or sheep"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bleat",
                                "target_lang_sense_clarification": "the sound of a goat or sheep"
                            },
                            {
                                "target_lang_word": "baa",
                                "target_lang_sense_clarification": "the sound of a sheep"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "526d6f42-656e-39a3-87d5-4c285b6f4588",
                    "sense_definition": "op een vervelende manier klagen of zeuren over onbelangrijke zaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zit toch niet zo te <w>mekkeren</w> en eet je eten op!",
                            "target_lang_translations": {
                                "en": "Stop <w>whining</w> and eat your food!"
                            }
                        },
                        {
                            "text": "Hij blijft maar <w>mekkeren</w> over het weer, terwijl we er niets aan kunnen veranderen.",
                            "target_lang_translations": {
                                "en": "He keeps <w>griping</w> about the weather, even though we can't do anything about it."
                            }
                        }
                    ],
                    "synonyms": [
                        "dreinen",
                        "jengelen",
                        "zaniken",
                        "zeiken",
                        "zeuren"
                    ],
                    "common_phrases": [
                        "zitten te mekkeren",
                        "altijd wat te mekkeren hebben"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik voor zeuren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to complain or nag in an annoying way about unimportant matters"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whine",
                                "target_lang_sense_clarification": "to complain in an annoying way"
                            },
                            {
                                "target_lang_word": "nag",
                                "target_lang_sense_clarification": "to persistently complain or find fault"
                            },
                            {
                                "target_lang_word": "gripe",
                                "target_lang_sense_clarification": "to complain about minor things"
                            },
                            {
                                "target_lang_word": "moan",
                                "target_lang_sense_clarification": "to grumble or complain"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a783f15-6dd6-3f41-aa05-51d68ae882e8",
                    "sense_definition": "iemand zachtjes zingend of neuriënd in slaap wiegen",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slapen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn moeder moest hem altijd rustig <w>mekkeren</w>, anders bleef hij de hele nacht wakker.",
                            "target_lang_translations": {
                                "en": "His mother always had to <w>lull</w> him quietly, otherwise he would stay awake all night."
                            }
                        },
                        {
                            "text": "De grootmoeder probeerde het kind in slaap te <w>mekkeren</w> met een oud volksliedje.",
                            "target_lang_translations": {
                                "en": "The grandmother tried to <w>croon</w> the child to sleep with an old folk song."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in slaap mekkeren"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "deze betekenis is zeer specifiek en komt weinig voor in standaardtaal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to lull someone to sleep by singing or humming softly"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lull",
                                "target_lang_sense_clarification": "to soothe someone to sleep"
                            },
                            {
                                "target_lang_word": "croon",
                                "target_lang_sense_clarification": "to sing or hum in a soft, low voice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}