                            {
                                "example_id": "8a129b63-4e9c-45f6-a6b1-bf01b44e1509",
                                "sense_id": "b099de35-fed4-3189-9654-d193df6aa794",
                                "text": "Bei der Auslebung von Asphyxiophilie ist besondere Vorsicht geboten, da entsprechende Praktiken sehr gefährlich sein können."
                            },
                            {
                                "example_id": "d61eae3f-fe50-44ac-a1ca-6b908e62bceb",
                                "sense_id": "b099de35-fed4-3189-9654-d193df6aa794",
                                "text": "„Über die Häufigkeit von Unfällen in Verbindung mit Asphyxiophilie lässt sich nur schwer etwas sagen, da nur die tödlich endenden Fälle dokumentiert werden können.“"
                            },
                            {
                                "example_id": "0a551f79-de0d-4669-abd8-01dcaf0341d8",
                                "sense_id": "b099de35-fed4-3189-9654-d193df6aa794",
                                "text": "„Scheinbar stand Mandy auf Asphyxiophilie, der Reduktion von Sauerstoff durch Strangulation, um einen intensiveren Höhepunkt zu erleben.“"
                            }
                        ],
