                                        "glosses": [
                                            "Qui n’appartient pas à la religion, par opposition à ce qui la concerne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215c0c05-1692-4732-a0e4-dc8464a97b9c",
                                                "sense_id": "ee1b0dab-bc9b-316b-9222-855799f48f40",
                                                "text": "Mais le seul nom qui ait été sauvé de l'oubli, dans la poésie profane, est celui de ce médiocre rimeur de Mathieu-le-Juif, d'Arras, qui vivait au XIIIe siècle […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1aacbf95-1fc5-3b5c-8c38-0c9c3035eb20",
                                        "entry_id": "d6f9ca46-ea9a-3419-bd68-2425d7553293",
                                        "glosses": [
                                            "Qui va contre le respect qu’on doit aux choses sacrées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ba0a4f3-e795-4ee9-a1cc-e9d781736f58",
                                                "sense_id": "1aacbf95-1fc5-3b5c-8c38-0c9c3035eb20",
                                                "text": "C’est une action profane et impie."
                                            },
                                            {
                                                "example_id": "53d582c6-e2e9-44d8-ba3d-eaf535c0b369",
                                                "sense_id": "1aacbf95-1fc5-3b5c-8c38-0c9c3035eb20",
                                                "text": "Discours profane."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "profane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31f86c23-b0ac-3381-b725-f00bc938d9e4",
                                        "entry_id": "20d36cae-9cdf-3f26-8e08-5e85fbe56db4",
                                        "glosses": [
                                            "Personne qui manque de respect pour les choses de la religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5104f571-17ba-472a-b73e-175225224979",
                                                "sense_id": "31f86c23-b0ac-3381-b725-f00bc938d9e4",
                                                "text": "Il n’y a qu’un profane qui puisse parler de la sorte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7afd2075-0438-394b-8fa5-aac0e22da15a",
                                        "entry_id": "20d36cae-9cdf-3f26-8e08-5e85fbe56db4",
                                        "glosses": [
                                            "Celui ou celle qui n’était pas initié à des mystères."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "138faca3-088f-492d-83cd-690ee21501d0",
                                                "sense_id": "7afd2075-0438-394b-8fa5-aac0e22da15a",
                                                "text": "éloigner les profanes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d16275c-879a-3f21-8eee-fc83e193152b",
                                        "entry_id": "20d36cae-9cdf-3f26-8e08-5e85fbe56db4",
                                        "glosses": [
                                            "Personne qui n’est pas initiée à une science, aux lettres, aux arts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ebacd37-14cf-461c-9a8a-aa6d73d71b28",
                                                "sense_id": "1d16275c-879a-3f21-8eee-fc83e193152b",
                                                "text": "Il n’appartient pas à un profane de parler sur ce sujet."
                                            },
                                            {
                                                "example_id": "dbb585e3-cdf6-4e87-9d02-a2a68227baa4",
                                                "sense_id": "1d16275c-879a-3f21-8eee-fc83e193152b",
                                                "text": "Longtemps, l’entrée d’un profane en franc-maçonnerie n’était possible que par cooptation."
                                            },
                                            {
                                                "example_id": "9d0cdcb4-39f2-4094-9bab-da83e50f65f3",
                                                "sense_id": "1d16275c-879a-3f21-8eee-fc83e193152b",
                                                "text": "Ce sont choses dont l’intelligence est interdite aux profanes, Que ne peuvent comprendre ceux qui n’y sont pas initiés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "profane",
