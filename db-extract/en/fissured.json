                                            "von Haut"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ec026c8-3101-4e1c-9275-b9acc454b4e7",
                                                "sense_id": "ffc7df58-aec0-336f-bc77-9d114d1b2546",
                                                "text": "Er cremte seine schrundigen Hände ein.."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2db5ff01-cd23-3775-a3a8-d64bb5a23e53",
                                        "entry_id": "379ae546-cb89-3f58-82b9-93689538f61a",
                                        "glosses": [
                                            "Spalten oder Risse erkennen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6dad0c-e3c8-480e-a58a-e1ebba8714d2",
                                                "sense_id": "2db5ff01-cd23-3775-a3a8-d64bb5a23e53",
                                                "text": "„Amerikanische Schauspieler, die hier gedreht haben, bleiben, weil sie die Stadt mögen – das Zart-Rohe ihrer alten Häuser und jungen Gesichter, den schrundigen Charme von Berlin.“"
                                            },
                                            {
                                                "example_id": "896a1dcf-9106-468c-a31a-c7cfc14d74e2",
                                                "sense_id": "2db5ff01-cd23-3775-a3a8-d64bb5a23e53",
                                                "text": "„Humboldt berührte den schrundigen Stamm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
