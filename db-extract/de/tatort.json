                "senses": [
                    {
                        "sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                        "entry_id": "a39ed4cd-a80d-328e-8b7a-ab0a46fc429d",
                        "glosses": [
                            "Ort, an dem eine Straftat stattfand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9a64d49-2b17-4131-bfc6-a8753dfb6641",
                                "sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                                "text": "Am Tatort fanden die Ermittler viele Spuren."
                            },
                            {
                                "example_id": "a5db5902-a73a-42be-9375-86e364b53be3",
                                "sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                                "text": "„Es war die DNA eines Mannes, der nur fünf Kilometer vom Tatort entfernt wohnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff5210ab-ba39-43b5-8a1a-5c681429a514",
                        "source_entry_id": "a39ed4cd-a80d-328e-8b7a-ab0a46fc429d",
                        "source_sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                        "source_sense_description": "Ort, an dem eine Straftat stattfand",
                        "target_lang_word": "crime scene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crime scene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd3f83a-1ade-36b8-856c-7e00ee98b8d4",
                                        "entry_id": "57a5ae23-d189-3018-b8d2-ec8ee35d1c8e",
                                        "glosses": [
                                            "The location of a crime, especially one at which forensic evidence is collected in a controlled manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b44f139-93c7-4c62-ab13-ef709b11cf1d",
                                                "sense_id": "3fd3f83a-1ade-36b8-856c-7e00ee98b8d4",
                                                "text": "The Police may declare a crime scene so nobody is allowed near, and the idea of allowing trains to pass on an adjacent line would horrify the increasing crowd of bystanders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99d49546-9952-40a5-a193-9b09660e0190",
                        "source_entry_id": "a39ed4cd-a80d-328e-8b7a-ab0a46fc429d",
                        "source_sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                        "source_sense_description": "Ort, an dem eine Straftat stattfand",
                        "target_lang_word": "lieu du crime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9d81ab17-f721-4e1e-9cea-9b6f8d906a86",
                        "source_entry_id": "a39ed4cd-a80d-328e-8b7a-ab0a46fc429d",
                        "source_sense_id": "7349a5b2-5b0d-30dd-aecf-83fe2f0fc37b",
                        "source_sense_description": "Ort, an dem eine Straftat stattfand",
                        "target_lang_word": "scène de crime",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "scène de crime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4222cb8-64c7-3d46-ae71-31a51a70e632",
                                        "entry_id": "4d83d662-350e-312b-ac18-22b34f676287",
                                        "glosses": [
                                            "Endroit où a eu lieu un crime, un meurtre, où les indices (empreintes, traces de pas, traces de poudre, etc.) sont collectés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5004c2d-76ba-408f-a405-55808e04c84f",
                                                "sense_id": "a4222cb8-64c7-3d46-ae71-31a51a70e632",
                                                "text": "Sur la scène de crime, au 13ᵉ étage d’un bâtiment du quartier chic de Puerto Madero, les policiers retrouvent uniquement un revolver, qui s’avère avoir été prêté par un ami deux jours avant, et une douille de calibre 22."
                                            },
                                            {
                                                "example_id": "93f45dff-619e-4258-9a87-bd564ba6ea82",
                                                "sense_id": "a4222cb8-64c7-3d46-ae71-31a51a70e632",
                                                "text": "Si la justice n’est pas en mesure d’attester l’objectif du tueur, les enquêteurs se félicitent de pouvoir, désormais, s’appuyer sur une compréhension de la scène de crime corroborée par les expertises."
                                            },
                                            {
                                                "example_id": "63f648b8-5c3b-449b-8914-a374b35a53e7",
                                                "sense_id": "a4222cb8-64c7-3d46-ae71-31a51a70e632",
                                                "text": "Avec les « techniciens de scène de crime » de l’Identité judiciaire (IJ), en combinaisons immaculées, Eric, ganté de latex, saisit et place sous scellés l’arme du crime, mais aussi « un mégot de cigarette Marlboro » et « 11 poils d’origine indéterminée »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ae6283-72eb-3d2e-a4ba-613f8d7a6cb6",
                                        "entry_id": "4d83d662-350e-312b-ac18-22b34f676287",
                                        "glosses": [
                                            "Acte dans lequel prend lieu un crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a7a480b-4665-4c26-ba51-8442d6c0e1e8",
                                                "sense_id": "61ae6283-72eb-3d2e-a4ba-613f8d7a6cb6",
                                                "text": "Maurice Duplay, dans son roman « Léo » a fait une œuvre à la fois sobre et brutale. Les descriptions y sont aussi exactes et rapides que les gestes des personnages sont brusques et décisifs. Il y a là une scène de crime – une symphonie en rouge – de quoi faire pâmer d’horreur nos sentimentales en quête d’émotions."
                                            },
                                            {
                                                "example_id": "9c56c06a-ac83-4fa6-8a99-6b45f9895d8c",
                                                "sense_id": "61ae6283-72eb-3d2e-a4ba-613f8d7a6cb6",
                                                "text": "Cette scène de crime a été si habilement menée, que le poète en jouit et veut nous en faire jouir comme d’un chef-d’œuvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1bdef07-6f2c-3814-9936-ba1b5ccd532f",
                                        "entry_id": "4d83d662-350e-312b-ac18-22b34f676287",
                                        "glosses": [
                                            "Action du crime."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "006286bf-539f-4aca-900b-9b348dd30970",
                                                "sense_id": "a1bdef07-6f2c-3814-9936-ba1b5ccd532f",
                                                "text": "Toutes les deux, d’interrogatoire en interrogatoire, précisent, complètent, accumulent les détails et permettent aux magistrats de reconstituer toute une scène de crime."
                                            },
                                            {
                                                "example_id": "15840e3f-13c1-46d9-a41f-b06023e78086",
                                                "sense_id": "a1bdef07-6f2c-3814-9936-ba1b5ccd532f",
                                                "text": "La même scène de crime se passait à la troisième voiture ; mais Bonnier, moins heureux que son collègue, fut haché à coups de sabre et resta mort sur la place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
