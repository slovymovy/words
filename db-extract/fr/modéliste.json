                                        "sense_id": "8fbbb708-5d56-3d85-af8a-ed1a5d52c324",
                                        "entry_id": "c68230ab-f675-3993-b1f0-9bf430194243",
                                        "glosses": [
                                            "One who builds models, especially scale models.",
                                            "One who does so avocationally as a hobby."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af8484a-e71b-4539-b3c4-945cb20cd821",
                                                "sense_id": "8fbbb708-5d56-3d85-af8a-ed1a5d52c324",
                                                "text": "His father was a locally renowned modelmaker whose model cars and airplanes were on display in his barbershop for many years."
                                            },
                                            {
                                                "example_id": "e354b172-74a4-4600-a4bf-febecd303c03",
                                                "sense_id": "8fbbb708-5d56-3d85-af8a-ed1a5d52c324",
                                                "text": "But if modelmaking is not art, why is it that, in the upper reaches of modeldom, where the best do their work, there is an identifiable difference in \"feel\" between the work of one modelmaker and another?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09c98ae4-5a43-397f-88ba-4ae83bbb7320",
                                        "entry_id": "c68230ab-f675-3993-b1f0-9bf430194243",
                                        "glosses": [
                                            "One who builds models, especially scale models.",
                                            "One who does so vocationally in industry."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1990be4-6949-4208-b506-0ed3aa0f223e",
                                                "sense_id": "09c98ae4-5a43-397f-88ba-4ae83bbb7320",
                                                "text": "Near-synonym: scale modeler"
                                            },
                                            {
                                                "example_id": "861a5105-93e1-46a9-a2f7-6dfeaa309776",
                                                "sense_id": "09c98ae4-5a43-397f-88ba-4ae83bbb7320",
                                                "text": "His grandfather was a modelmaker for a heavy engineering firm."
                                            }
                                        ]
