                ],
                "senses": [
                    {
                        "sense_id": "87bab046-662e-3571-b765-79b1b91f9583",
                        "entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "glosses": [
                            "las lub zagajnik sosnowy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7935ce2a-e675-4f9c-932d-47ee99669ca8",
                                "sense_id": "87bab046-662e-3571-b765-79b1b91f9583",
                                "text": "A w tych borach olsztyńskich • dobrze z psami wędrować. • A w tych jarach olsztyńskich • sośnina i dąbrowa"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "10d1dc5f-bff2-38a9-a3d3-e00fc5af0848",
                        "entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "glosses": [
                            "drewno z sosny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1581352e-045d-4bb1-afa4-d0ad5ffabee4",
                                "sense_id": "10d1dc5f-bff2-38a9-a3d3-e00fc5af0848",
                                "text": "Po co mam dawać na kościół do nowych drzwi deski dębowe, kiedy i sośnina wystarczy?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "3b654a3d-f767-3bfb-a4be-9e92ef994f83",
                        "entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "glosses": [
                            "świeżo ścięte gałęzie sosny"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "adc690ed-a51a-49b7-9f8a-e2168381648f",
                        "source_entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "source_sense_id": "87bab046-662e-3571-b765-79b1b91f9583",
                        "target_lang_word": "сосняк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сосняк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                        "entry_id": "a78ff0a1-e602-37e4-8f39-5ea9e1c892fd",
                                        "glosses": [
                                            "сосновый лес"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029e7e65-e13b-4d41-8559-ce2ee470f95c",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Это был частый сосняк, росший на песчаном грунте."
                                            },
                                            {
                                                "example_id": "1fe9c0f8-4382-4fdc-b477-8a90f3587746",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Вспоминался из детства темный с просинью сосняк, дорога и на ней яркая-яркая красная рубаха: ехал мужик верхом на лошади."
                                            },
                                            {
                                                "example_id": "39be42e4-ab15-435c-9a6c-0ac797114a78",
                                                "sense_id": "8ce34b0a-3d43-3d9f-aa74-b98dea0af897",
                                                "text": "Там, в кедрачах, вот уже второй месяц работал передвижной лесопункт, вырубающий мачтовый сосняк и кедры."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a14d55c-4519-3419-98d5-595882b78f28",
                                        "entry_id": "a78ff0a1-e602-37e4-8f39-5ea9e1c892fd",
                                        "glosses": [
                                            "сосновые брёвна, доски"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa109e14-0007-4f18-af05-3e46a0248667",
                                                "sense_id": "7a14d55c-4519-3419-98d5-595882b78f28",
                                                "text": "Приходят по весне какие-то люди, валят сосняк поровней, ошкуривают…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a717c74b-307f-4720-9db0-2f1382824f55",
                        "source_entry_id": "9d33035c-c04d-35fd-b46b-7e800ca7229a",
                        "source_sense_id": "10d1dc5f-bff2-38a9-a3d3-e00fc5af0848",
