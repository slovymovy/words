                "senses": [
                    {
                        "sense_id": "7ed3c5f3-5c31-3720-aff2-9170a6a43b0c",
                        "entry_id": "f6d79861-a864-3c43-801d-162f1994e2de",
                        "glosses": [
                            "Donner un caractère rappelant Halloween à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed76fa30-795c-410c-882a-3c38529f9ba5",
                                "sense_id": "7ed3c5f3-5c31-3720-aff2-9170a6a43b0c",
                                "text": "Loin de moi l’idée d’halloweeniser Les Trappeuses, mais… des courges, c’est génial, non ?"
                            },
                            {
                                "example_id": "a871b041-861c-4b38-b20e-c004ce45430e",
                                "sense_id": "7ed3c5f3-5c31-3720-aff2-9170a6a43b0c",
                                "text": "Mais quelqu’un tient le couvert fermé, fait en sorte qu’on continue d’halloweeniser l’ovni, d’en rire, d’en avoir peur via le cinéma."
                            },
                            {
                                "example_id": "fe76a289-52ed-41fb-836e-9ecc728ff13d",
                                "sense_id": "7ed3c5f3-5c31-3720-aff2-9170a6a43b0c",
                                "text": "Quant à moi je prévois d’« halloweeniser » mon blog en octobre, pour rester dans l’ambiance…"
                            }
                        ]
                    }
