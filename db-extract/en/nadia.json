                                            {
                                                "example_id": "c252923f-ab5f-4279-ac4a-742e6c116b2b",
                                                "sense_id": "f9309ea0-36f1-3f83-bb4a-59e90101dbbc",
                                                "text": "À l’origine de cette opération : un lingot de cuivre trouvé dans l’anse, probablement dans les années 1970, puis deux autres trouvés en 1978 par Guy et Nadia Larchevêque."
                                            },
                                            {
                                                "example_id": "61e4f6c8-e661-483c-9873-9311266afeb0",
                                                "sense_id": "f9309ea0-36f1-3f83-bb4a-59e90101dbbc",
                                                "text": "Et la réalisatrice a beau assurer que « ce n’est pas un biopic », on reconnaît très bien Valeria sous les traits de Nadia Tereskiewicz."
                                            },
                                            {
                                                "example_id": "b637546f-852f-4f2d-ba6e-0aa96c2a69ad",
                                                "sense_id": "f9309ea0-36f1-3f83-bb4a-59e90101dbbc",
                                                "text": "Esmée ne voyait pas de rapport entre son ambition de partir sur Élène et les cours de théâtre-thérapie de Nadia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
