    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                "word": "contentment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f65639ab-02d6-4bfc-ab77-fa93c66aec30",
                        "entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "tags": [
                            "plural"
                        ],
                        "form": "contentments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "faf66811-da0f-34c4-b93b-b6c09a4ae499",
                        "entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "glosses": [
                            "The state or degree of being contented or satisfied."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "57f50aa0-54da-424b-a39a-40149a02aa33",
                                "sense_id": "faf66811-da0f-34c4-b93b-b6c09a4ae499",
                                "text": "[…]purſued his vnneighbourly purpoſe in ſuch ſort: that hee being the ſtronger perſwader, and ſhe (belike) too credulous in beleeuing or elſe ouer-feeble in reſiſting, from priuate imparlance, they fell to action; and continued their cloſe fight a long while together, vnſeene and vvithout ſuſpition, no doubt to their equall ioy and contentment."
                            },
                            {
                                "example_id": "95c4b32d-fc7a-4c45-8aad-8ff41c49f810",
                                "sense_id": "faf66811-da0f-34c4-b93b-b6c09a4ae499",
                                "text": "Then they got out their boat from the boat-house, sculled down the river home, and at a very late hour sat down to supper in their own cosy riverside parlour, to the Rat's great joy and contentment."
                            }
                        ]
                    },
                    {
                        "sense_id": "977c9888-31dd-3df0-873f-d5df383231df",
                        "entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "glosses": [
                            "Happiness in one's situation; satisfaction"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5506551e-c603-354f-808c-a5ce14757b9b",
                        "entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "glosses": [
                            "The neurophysiological experience of satisfaction and being at ease in one's situation, body, and/or mind."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "afa86826-0840-4bf2-8618-0711a7bcb07b",
                        "source_entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "source_sense_description": "state or degree of being contented",
                        "target_lang_word": "contentement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contentement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                        "entry_id": "bae069b4-4746-37ee-8f44-264f6440d099",
                                        "glosses": [
                                            "État de celui qui est content, satisfait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd699e5-af68-42b7-96bb-37093c3db741",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "[…], mais on peut aussi être tout à la fois très riche et très malheureux, car l’argent ne donne ni la santé, ni le contentement de soi-même, et il ne préserve pas de l’ennui, cette plaie des oisifs opulents."
                                            },
                                            {
                                                "example_id": "1c28fd9c-4961-4174-ad23-014dac9491bd",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Rougon lui-même se laissa prendre à ce contentement de l’homme illettré qui voit ses enfants devenir plus savants que lui."
                                            },
                                            {
                                                "example_id": "14ff22fb-a36c-4eb4-a579-e65302d7fcf3",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Un chaud contentement lui venait, grâce à cette demi-bouteille de Pouilly."
                                            },
                                            {
                                                "example_id": "3d142dd1-1bce-4d5f-be79-24408e99acc2",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Angelo avait surveillé avec grand soin l’ébullition de l’eau pour le thé. Il montra aussi beaucoup de contentement personnel du sac de farine de maïs, de la cassonade et de douze œufs durs qu’il avait eu l’esprit de faire préparer."
                                            },
                                            {
                                                "example_id": "575337ba-3285-467f-9ea7-bebdccb51e8b",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "– Y a qu’la cavalerie ! Ça, c’est quelque chose ! T’as un cheval à toi, c’est ton compagnon, et si tu l’soignes bien, si tu l’dresses comme il faut, sans brutalité, avec lui t’as que des contentements."
                                            },
                                            {
                                                "example_id": "1b3519d9-10cd-44f6-9f10-8f87a26ad2f8",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": "Une sorte de contentement donnait à son teint une lueur presque phosphorescente."
                                            },
                                            {
                                                "example_id": "cc12210f-4529-473c-9dbc-f6d53b6b4385",
                                                "sense_id": "365f5235-d102-388a-b8ea-8115037cbb4b",
                                                "text": ". Immobiles, calmes et droits, nous étions enfin capables de comprendre pourquoi il émanait des chats au carreau cette gravité des êtres parvenus au contentement intégral, synonyme de la vie réussie, antipode de l’inquiétude humaine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d044ff9a-33df-44fd-b0c5-e4889d8d6db4",
                        "source_entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "source_sense_description": "state or degree of being contented",
                        "target_lang_word": "Zufriedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zufriedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b612798f-f571-328e-887a-70f66e0feed7",
                                        "entry_id": "1cb2b5ac-0ef5-329e-9a73-fa87f7879664",
                                        "glosses": [
                                            "das Frohsein mit einer Situation oder einem Umstand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa1b70b-05c7-42e1-bf54-d1ab1694c277",
                                                "sense_id": "b612798f-f571-328e-887a-70f66e0feed7",
                                                "text": "Seine Zufriedenheit war nur von kurzer Dauer."
                                            },
                                            {
                                                "example_id": "81336f16-f760-433a-9dec-874c1ead6e6e",
                                                "sense_id": "b612798f-f571-328e-887a-70f66e0feed7",
                                                "text": "„Ein Strahl von Zufriedenheit überzog das erstorbene Gesicht des Greises, als er den Sarg beendigt sah.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b8e6314-58ad-3c90-aefc-3751f8ecd309",
                                        "entry_id": "1cb2b5ac-0ef5-329e-9a73-fa87f7879664",
                                        "glosses": [
                                            "Ausmaß oder Grad von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19a91f7-a40d-4a76-be2d-c33997471eb5",
                                                "sense_id": "8b8e6314-58ad-3c90-aefc-3751f8ecd309",
                                                "text": "„Dieses Ungleichgewicht würden Sie, sehr geehrter Herr Wulff, sicherlich mit obigen Maßnahmen leicht beseitigen können und damit die Zufriedenheit der Lehrer steigern können. (“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "09e648a1-6a2f-49ba-908b-c9b39db21f16",
                        "source_entry_id": "0147d0f2-bb25-35fd-ba81-4bb7510f43cd",
                        "source_sense_description": "state or degree of being contented",
                        "target_lang_word": "Genügsamkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genügsamkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b70af4a0-18ae-3b87-8988-38ffc184afbf",
                                        "entry_id": "558984ee-08f3-3652-bd5a-b3e9aa931771",
                                        "glosses": [
                                            "die Art, mit wenig zufrieden zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f874c0-7e31-47a8-b82c-b955774d7a67",
                                                "sense_id": "b70af4a0-18ae-3b87-8988-38ffc184afbf",
                                                "text": "Die Genügsamkeit der Leute hat mich beeindruckt."
                                            },
                                            {
                                                "example_id": "a9d73140-5a34-4aa8-9312-0290ce17a722",
                                                "sense_id": "b70af4a0-18ae-3b87-8988-38ffc184afbf",
                                                "text": "„Genügsamkeit ist die Tugend derer, die etwas haben.“"
                                            },
                                            {
                                                "example_id": "0942b1c4-f540-486c-ae54-cc99b0df0a12",
                                                "sense_id": "b70af4a0-18ae-3b87-8988-38ffc184afbf",
                                                "text": "„Man müsse nur Genügsamkeit lernen (nicht ganz leicht, aber ungleich weniger anstrengend als das Suchen nach Gütern und Erfolg) und sich eine gewisse Unempfindlichkeit gegen Verkennung und üble Nachrede zulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
