                        "entry_id": "0a1e751e-9bff-368c-b6ad-1cb67efdb0ea",
                        "glosses": [
                            "aardolieproduct dat in aanwezigheid van voldoende zuurstof bij compressie vanzelf tot ontbranding overgaat en zo geen ontstekingsmechanisme nodig heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
