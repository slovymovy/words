                "senses": [
                    {
                        "sense_id": "db5c399b-e61e-3979-8c05-a465901618af",
                        "entry_id": "a4a331bf-aa71-3edc-97ce-e14c5b5aa6ae",
                        "glosses": [
                            "муз. аккорд, состоящий из пяти звуков, которые можно расположить по терциям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2064fb-d7cf-4fda-84bd-70d2da847e62",
                                "sense_id": "db5c399b-e61e-3979-8c05-a465901618af",
                                "text": "Поэтому так примечательно наблюдать в историческом развитии данных нонаккордов противоречие их логической и интонационной сторон."
                            },
                            {
                                "example_id": "1f49c008-f201-4890-a261-96c5ab643eef",
                                "sense_id": "db5c399b-e61e-3979-8c05-a465901618af",
                                "text": "А что, если в левой руке, в аккомпанементе на «раз, два, три» дать вначале разделенный нонаккорд другой тональности?.."
                            }
                        ]
                    }
