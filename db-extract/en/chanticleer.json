                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "15a38a5e-064b-36f6-b51e-ee2a8a89f6e0",
                        "entry_id": "5897df89-4c5b-3deb-b20d-815abbf45792",
                        "glosses": [
                            "männliches Haushuhn"
                        ],
                        "tags": [
                            "poetic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ae038ed-6795-4995-a2e1-c57c20f350bf",
                        "source_entry_id": "5897df89-4c5b-3deb-b20d-815abbf45792",
                        "source_sense_id": "15a38a5e-064b-36f6-b51e-ee2a8a89f6e0",
                        "source_sense_description": "poetisch: männliches Haushuhn",
                        "target_lang_word": "Hahn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bd4cec5a-9cc6-3bda-a197-6674dff84b04",
                                        "entry_id": "fcfc828f-093a-3025-8a98-3ded23e3afc9",
                                        "glosses": [
                                            "das männliche Tier verschiedener Vogelarten"
                                        ],
                                        "tags": [
                                            "Plural 1 und 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5927dcb9-0675-4fc2-8082-dcf53c0a634e",
                                                "sense_id": "bd4cec5a-9cc6-3bda-a197-6674dff84b04",
                                                "text": "„Seht ihr laufen den fremden Hahn?“"
                                            },
                                            {
                                                "example_id": "b12fd3bf-23a7-4fe9-8796-6d7aefe4e6d3",
                                                "sense_id": "bd4cec5a-9cc6-3bda-a197-6674dff84b04",
                                                "text": "Jesus sprach zu ihm: Wahrlich, ich sage dir: In dieser Nacht, ehe der Hahn kräht, wirst du mich dreimal verleugnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7180359d-c1f5-35a8-9245-a0416091e5d9",
                                        "entry_id": "fcfc828f-093a-3025-8a98-3ded23e3afc9",
                                        "glosses": [
                                            "das männliche Huhn"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d75375-c2be-4509-87b4-20e9e870b791",
                                                "sense_id": "7180359d-c1f5-35a8-9245-a0416091e5d9",
                                                "text": "„Ich öffne die Tür zum Kiosk, ein Hahn kräht mechanisch.“"
                                            },
                                            {
                                                "example_id": "1050d025-f69f-4d54-beed-b311faa058c1",
                                                "sense_id": "7180359d-c1f5-35a8-9245-a0416091e5d9",
                                                "text": "„Ein Hahn krähte in der Ferne, ein zweiter antwortete ihm in der Nähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6378b682-b152-3a4b-8e4c-f9ea37b6053d",
                                        "entry_id": "fcfc828f-093a-3025-8a98-3ded23e3afc9",
                                        "glosses": [
                                            "eine Wetterfahne in Form eines Hahns [2]"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4007439f-9833-4c23-b02c-d23713d02dc6",
                                                "sense_id": "6378b682-b152-3a4b-8e4c-f9ea37b6053d",
                                                "text": "Der Hahn auf dem Kirchturm glänzte golden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "85b3d89b-6896-3f5d-87bf-d0d40c9f64f6",
                                        "entry_id": "fcfc828f-093a-3025-8a98-3ded23e3afc9",
                                        "glosses": [
                                            "eine mechanische Vorrichtung, mit der der Durchfluss von Flüssigkeiten oder Gasen gesteuert werden kann"
                                        ],
                                        "tags": [
                                            "Plural 1",
                                            "fachsprachlich auch Plural 2"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a72787-7d38-4f1f-8372-a621ffb98abf",
                                                "sense_id": "85b3d89b-6896-3f5d-87bf-d0d40c9f64f6",
                                                "text": "„Dreh den Hahn gefälligst ganz zu!“"
                                            },
                                            {
                                                "example_id": "fb6cc032-8a55-45ba-8f6b-6bc8a6bb98ad",
                                                "sense_id": "85b3d89b-6896-3f5d-87bf-d0d40c9f64f6",
                                                "text": "„Ich bin der letzte Kunde, ich komm' nicht los vom Hahn.",
                                                "translation": "Ich bin der letzte Kunde und immer noch nicht blau.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "32330d5e-1b04-3e2d-b75c-aa3bb8335b6a",
                                        "entry_id": "fcfc828f-093a-3025-8a98-3ded23e3afc9",
                                        "glosses": [
                                            "eine Vorrichtung an Schusswaffen zum Auslösen des Schusses"
                                        ],
                                        "tags": [
                                            "nur Plural 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d418257-7dab-4be2-be0a-ca862b1c44fa",
                                                "sense_id": "32330d5e-1b04-3e2d-b75c-aa3bb8335b6a",
                                                "text": "Der Hahn des Gewehrs ist aus Vollmetall."
                                            },
                                            {
                                                "example_id": "9d29b4f7-994e-4796-b1cb-0efb86a24d5d",
                                                "sense_id": "32330d5e-1b04-3e2d-b75c-aa3bb8335b6a",
                                                "text": "„Kroch nach der weggeprellten Büchse, nach Kugelbeutel und Pulverhorn, das erste; das zweite, daß er die Waffe, Mündung und Pfanne, Hahn, Flint und Kolben sorgfältig abtastete und im Dunkel nach geübtem Gefühle lud.“"
                                            },
                                            {
                                                "example_id": "b3361bcf-8538-4993-a9aa-464f19e415f1",
                                                "sense_id": "32330d5e-1b04-3e2d-b75c-aa3bb8335b6a",
                                                "text": "„Das Schloß seiner Büchse war glücklicherweise trocken geblieben, schnell zog er den Hahn auf, und mit dem linken Arm auf dem Holze ruhend, während er mit den Füßen langsam austrat, zielte er in dieser keineswegs bequemen Lage auf den Panther, der jetzt eben glatt und triefend dem Wasser entstieg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hahn",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "823087e5-3655-37ea-b7d7-a58bb432d966",
                                        "entry_id": "f7587537-9477-37b1-be54-13dc8a6f7673",
                                        "glosses": [
