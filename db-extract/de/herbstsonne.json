                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Herbstsonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                        "entry_id": "7c2a5542-710a-3970-a51c-f33ccc429c8f",
                        "glosses": [
                            "die Sonne in ihrer Art, wie sie im Herbst scheint"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "492ca1a7-5cda-4f42-8ed6-ce0bbcc6dcf0",
                                "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                                "text": "„Wieder einmal sitzt man von goldener Herbstsonne beschienen unter einem Nußbaum im Garten beieinander.“"
                            },
                            {
                                "example_id": "6963adce-21b4-463d-bf0f-278dc8ae2f9c",
                                "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                                "text": "„Inzwischen war es kalt geworden, von der spanischen Herbstsonne war kaum mehr ein blasser Schimmer am immergrauen Himmel zu entdecken.“"
                            },
                            {
                                "example_id": "d4280299-b362-4d5d-aef1-b22371ca4002",
                                "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                                "text": "„Es war später Nachmittag, die Herbstsonne stand tief und blendete.“"
                            },
                            {
                                "example_id": "3caecc5d-8dc4-4954-a573-31f63f2f2970",
                                "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                                "text": "„Die meisten Pflanzen hat sie selbst aus den Samen, die sie noch in der Herbstsonne getrocknet hat, gezogen.“"
                            },
                            {
                                "example_id": "1b3db94b-1a45-4792-8d62-792732671e9c",
                                "sense_id": "84a57a84-49b5-3ffd-b314-8582da10afcd",
                                "text": "„Beide waren mit Handarbeiten beschäftigt, und die Herbstsonne leuchtete zu ihnen herein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
