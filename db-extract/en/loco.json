                    }
                ],
                "senses": [
                    {
                        "sense_id": "c96f11a5-ee5b-377b-acda-0344b762d88d",
                        "entry_id": "24f57078-5fa8-3f8b-849d-630fe1c9f072",
                        "glosses": [
                            "A locomotive."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b86cfc75-7c84-4702-a39a-4ebacb95f82a",
                                "sense_id": "c96f11a5-ee5b-377b-acda-0344b762d88d",
                                "text": "A locomotive is, next to a marine engine, the most sensitive thing man ever made; and No. .007, besides being sensitive, was new. The red paint was hardly dry on his spotless bumper-bar, his headlight shone like a fireman’s helmet, and his cab might have been a hard-wood-finish parlour. They had run him into the round-house after his trial—he had said good-bye to his best friend in the shops, the overhead travelling-crane—the big world was just outside; and the other locos were taking stock of him."
                            },
                            {
                                "example_id": "b20093f5-25c0-4b16-9f7d-89f7f9562f4d",
                                "sense_id": "c96f11a5-ee5b-377b-acda-0344b762d88d",
                                "text": "Small boys in 1963 could have traction engines with real steam coming out of the funnel, and Old Western locos had flashing lights, hooters and cow-pushers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fdf5e88d-6167-43a9-8b04-73d520fe4970",
                        "source_entry_id": "24f57078-5fa8-3f8b-849d-630fe1c9f072",
                        "source_sense_id": "c96f11a5-ee5b-377b-acda-0344b762d88d",
                        "source_sense_description": "locomotive (short form)",
                        "target_lang_word": "Lok",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lok",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23f5a7b2-1c93-3521-b617-1e8c839980b3",
                                        "entry_id": "e89e7105-f3cf-3612-bb04-d6cbd3c0de71",
                                        "glosses": [
                                            "Lokomotive"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14cd892d-df31-4a96-b4ce-b14e5a0982d4",
                                                "sense_id": "23f5a7b2-1c93-3521-b617-1e8c839980b3",
                                                "text": "Dieser Zug hat aus Sicherheitsgründen sogar zwei Loks."
                                            },
                                            {
                                                "example_id": "2139ffa8-54d3-4655-83d9-180d8fdea0cb",
                                                "sense_id": "23f5a7b2-1c93-3521-b617-1e8c839980b3",
                                                "text": "„Dann pfiff die Lok schrill auf, und eine schnelle Wolke Dampf stieg aus ihrer Pfeife.“"
                                            },
                                            {
                                                "example_id": "29e9ac34-2a75-43a0-9306-8bfde1f45df7",
                                                "sense_id": "23f5a7b2-1c93-3521-b617-1e8c839980b3",
                                                "text": "„Quer durch hügelige Landschaften – Julia Scherzer fährt Triebwagen und schwere Loks bei den ÖBB. Zuvor absolvierte sie eine Ausbildung zur Schlosserin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f93cdff-c4fc-4ba6-86c2-941448c73ae0",
                        "source_entry_id": "24f57078-5fa8-3f8b-849d-630fe1c9f072",
