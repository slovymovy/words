                ],
                "senses": [
                    {
                        "sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                        "entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "glosses": [
                            "rodzaj kapy zakładanej na konia pod siodło, chroniącej grzbiet zwierzęcia, krótszej od kropierza, czasem ozdobnej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb2f801-30de-4146-b5d2-15000212bce5",
                                "sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                                "text": "Przed królem jechali rycerze na koniach odzianych w zdobne czapraki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                        "entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "glosses": [
                            "derka lub okrycie zakładane koniowi lub psu, które zabezpieczają przed chłodem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d6e5183-7ba4-4709-8ff1-b98df4c1e739",
                                "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                                "text": "Nasza klaczka dostanie nowy czaprak."
                            },
                            {
                                "example_id": "265a7f6f-2756-44d6-9a8a-291adfa0aed1",
                                "sense_id": "4f749b1e-e19a-37c1-8369-780c0c524eaa",
                                "text": "Babciny jamnik okryty wełnianym czaprakiem siedział na kolanach."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "0fdbadaa-635a-37e4-a9d3-6a4af8de69a9",
                        "entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "glosses": [
                            "wyprawiona skóra zwierząt, od której odcięto łapy i inne odstające części"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d83c0f63-c536-4f2b-8ced-1884a19bd3f4",
                                "sense_id": "0fdbadaa-635a-37e4-a9d3-6a4af8de69a9",
                                "text": "Handlarz wyłożył na ladę trzy czapraki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b78578b-8c62-441f-a46b-d97f94bf5a46",
                        "source_entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "source_sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                        "target_lang_word": "shabrack",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shabrack",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "521bd4ef-c816-3339-b512-748683be2dea",
                                        "entry_id": "e190d592-4ff2-317d-9600-8fa3c50a260d",
                                        "glosses": [
                                            "The saddlecloth of a cavalry horse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1dad3dc-6afc-4ee0-bc56-68bdeb5d4456",
                                                "sense_id": "521bd4ef-c816-3339-b512-748683be2dea",
                                                "text": "Oudet and Papilette, two of the best sub-officers in the regiment, were at their head. When I had them formed up in fours, all in silver grey and upon chestnut horses, with their leopard skin shabracks and their little red panaches, my heart beat high at the sight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b359332-25dc-49f6-9870-e1f44fff5607",
                        "source_entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "source_sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                        "target_lang_word": "Satteldecke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "afedd211-0c17-430c-bd79-3bf095f8ad40",
                        "source_entry_id": "a414ab62-8544-3b22-96a5-6a0369345f3b",
                        "source_sense_id": "0b491609-1fe1-39ae-a86e-a1bc4309aa7e",
                        "target_lang_word": "Schabracke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schabracke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "eine besondere Form der Satteldecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4a82106-ec4e-4a30-b8cb-484155acf7be",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Nun, der Herr Obrist hätte ebensogut einziehen können wie einer durch den Argen Trumph (Arc de triomphe), und ich hätte dem Schimmel die neue Schabracke aufgelegt - Zacker, der hätte die Ohren gespitzt!"
                                            },
                                            {
                                                "example_id": "7e763a08-ecd0-4936-a9ed-14448979dc7d",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "Als die acht Tage herum waren, hatte sie eine wunderschöne Schabracke gestickt, mit der schickte sie ihn auf den Markt, er dürfe sie aber nicht anders geben als für fünfhundert Gulden."
                                            },
                                            {
                                                "example_id": "6c059435-9bbc-48ae-a898-9e84d9a09a28",
                                                "sense_id": "0130fa9a-4b41-3ca7-8883-bbcb01424fad",
                                                "text": "„Wer zu den Reitern will, muss ein Pferd mitbringen, auch einen Sattel mit Schabracke und einen Woilach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "unattraktive, ungepflegte, auch streitsüchtige, zänkische oder ältere Frau, Ehefrau oder Schwiegermutter (Österreich, Deutschland: Niederrhein, Westfalen, Mitteldeutschland, Ostdeutschland)"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedc4bc5-5582-4116-a815-01fbf9e5a662",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Inzwischen ist aus der Diva eine Schabracke geworden. (Der Tagesspiegel online, Alte Diva ohne Partner, 19.12.2003)"
                                            },
                                            {
                                                "example_id": "4f762b0c-7c3a-48dd-a26e-d1c157e51f2d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "Mit aufgedonnerten Haaren, schwarz anlackiert und mit Strass-Schabracke als Kleidervorhang: Prädestiniert zur Tunten-Mutti der Nation, die sie in der Tat lange war."
                                            },
                                            {
                                                "example_id": "8288f755-1df5-4c5e-9e14-21518259895d",
                                                "sense_id": "42af1cb1-a383-3d07-84a7-a2688dec082d",
                                                "text": "„…sie hatte ihr Klavier zur Verfügung gestellt, die alte Schabracke, und ihren Salon, ihre Partituren…“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Stoffleiste an der Gardinenleiste, Übergardine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f9ce811-325f-44d0-88f1-436eddc6c656",
                                                "sense_id": "faa180a2-e713-3feb-b790-e17125b205f0",
                                                "text": "Verwendung findet alles – die silberne Halterung für die Troddeln, die im Wohnzimmer eine Schabracke zieren, waren einmal Joghurtbecher und der scheinbar uralte geraffte Vorhang eine Mülltüte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e0ddb209-9ad0-3a61-869d-67c6894ccaa2",
                                        "entry_id": "bd550fe4-dff0-3af2-a7d0-ef20adabfa6d",
                                        "glosses": [
                                            "Sattelfleck, ein Zeichnungsmuster bei mehreren Tierarten (abgeleitet von [1])"
                                        ],
                                        "tags": [
                                            "Jägersprache"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
