{
    "word_family": [
        "usurpation",
        "usurper",
        "usurpative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b99d7d45-5df1-3d66-98b7-dfbd85ed65c1",
                    "sense_definition": "To take control of power or a position from someone else without having the legal right to do so.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seize_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general attempted to <w>usurp</w> the throne after the king suddenly passed away.",
                            "target_lang_translations": {
                                "ru": "Генерал попытался <w>узурпировать</w> трон после внезапной кончины короля."
                            }
                        },
                        {
                            "text": "The rebels tried to <w>usurp</w> power from the government during the political crisis.",
                            "target_lang_translations": {
                                "ru": "Во время политического кризиса мятежники попытались <w>захватить</w> власть у правительства."
                            }
                        }
                    ],
                    "synonyms": [
                        "seize",
                        "appropriate",
                        "commandeer"
                    ],
                    "common_phrases": [
                        "usurp power",
                        "usurp control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно или силой захватывать власть, престол или полномочия, не имея на это законных прав."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "узурпировать",
                                "target_lang_sense_clarification": "власть, престол"
                            },
                            {
                                "target_lang_word": "захватывать",
                                "target_lang_sense_clarification": "силой власть"
                            },
                            {
                                "target_lang_word": "присваивать",
                                "target_lang_sense_clarification": "полномочия, права"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8abb402b-396f-3148-9a3b-27c833ac18cd",
                    "sense_definition": "To take over a role, space, or right that belongs to someone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "seize_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that his colleague was trying to <w>usurp</w> his position as the team leader.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что коллега пытается <w>присвоить себе</w> его должность руководителя группы."
                            }
                        },
                        {
                            "text": "The new software should not <w>usurp</w> the role of the human operator in critical decisions.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение не должно <w>подменять</w> роль человека-оператора при принятии критически важных решений."
                            }
                        }
                    ],
                    "synonyms": [
                        "supplant",
                        "replace"
                    ],
                    "common_phrases": [
                        "usurp the role"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неправомерно занимать чьё-либо место, брать на себя чужую роль, должность или права."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "присваивать себе",
                                "target_lang_sense_clarification": "чужую роль или положение"
                            },
                            {
                                "target_lang_word": "вытеснять",
                                "target_lang_sense_clarification": "занимать чужое место"
                            },
                            {
                                "target_lang_word": "перенимать",
                                "target_lang_sense_clarification": "незаконно или самовольно роль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f15d085-b892-3b01-acff-1422d7d95c5a",
                    "sense_definition": "To illegally adopt or display the heraldic coat of arms belonging to another person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nobleman was accused of trying to <w>usurp</w> the family crest of his rival.",
                            "target_lang_translations": {
                                "ru": "Дворянина обвинили в попытке <w>присвоить</w> фамильный герб своего соперника."
                            }
                        },
                        {
                            "text": "It was considered a grave insult to <w>usurp</w> the coat of arms of a higher-ranking house.",
                            "target_lang_translations": {
                                "ru": "<w>Самовольно использовать</w> герб более знатного дома считалось тяжким оскорблением."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to historical heraldic practices."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самовольно и незаконно присваивать или использовать чужой герб."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаконно присваивать",
                                "target_lang_sense_clarification": "чужой герб"
                            },
                            {
                                "target_lang_word": "самовольно использовать",
                                "target_lang_sense_clarification": "чужую геральдику"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc60ba5-147b-303e-8624-f3ba017efed1",
                    "sense_definition": "To make use of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher argued that humans <w>usurp</w> the physical world through their five senses.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что люди <w>постигают и осваивают</w> физический мир через пять чувств."
                            }
                        },
                        {
                            "text": "One should not <w>usurp</w> these resources for personal gain without proper authorization.",
                            "target_lang_translations": {
                                "ru": "Не следует <w>использовать</w> эти ресурсы в личных целях без соответствующего разрешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "utilize",
                        "employ"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in an older sense of utilizing or consuming."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать, употреблять что-либо (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "использовать",
                                "target_lang_sense_clarification": "устаревшее употребление"
                            },
                            {
                                "target_lang_word": "употреблять",
                                "target_lang_sense_clarification": "в значении пользоваться чем-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}