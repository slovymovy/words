                                "example_id": "5ab07ea9-28bf-4102-b70e-38f584b1cbe4",
                                "sense_id": "48b2ef79-2dcb-3a00-b924-570312cb5f84",
                                "text": "Mój lapek po dwóch latach nieformatowania i zasyfiania go zaczął się chrzanić w ten sposób, że użycie procesora skakało do 100%"
                            },
                            {
                                "example_id": "92f45a41-18d4-4642-964d-81fbb1663995",
                                "sense_id": "48b2ef79-2dcb-3a00-b924-570312cb5f84",
                                "text": "Na twoim lapku ta gra płynnie nie będzie działać."
                            }
                        ],
