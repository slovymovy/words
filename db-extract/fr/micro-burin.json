                        "sense_id": "9cf5f113-8188-33cc-a1a5-24c6ad4a9c91",
                        "entry_id": "dd6f4c68-2652-3d1e-b423-d6a9b34f6b92",
                        "glosses": [
                            "Microlithe à forme de burin."
                        ],
                        "tags": [
                            "Préhistoire"
                        ],
                        "examples": [
                            {
                                "example_id": "cc73beaf-fc35-4140-a6c5-64ed6b75c483",
                                "sense_id": "9cf5f113-8188-33cc-a1a5-24c6ad4a9c91",
                                "text": "Il n’y avait pas fouilleur plus délicat que lui pour dégager les vestiges fugaces et les micro-burins des chasseurs magdaléniens."
                            },
                            {
                                "example_id": "f2a227d4-3660-4b42-8eda-2699477e7a30",
                                "sense_id": "9cf5f113-8188-33cc-a1a5-24c6ad4a9c91",
                                "text": "Il n’y a été trouvé qu’un tesson non décoré protohistorique et une lamelle en silex atypique (Senée et Bénard, 1983), ainsi qu’un couteau à dos et un micro-burin (Hinout, 1976b)."
                            },
                            {
                                "example_id": "c907bc53-350f-475c-a24f-1f99684b2037",
                                "sense_id": "9cf5f113-8188-33cc-a1a5-24c6ad4a9c91",
                                "text": "Parmi ce matériel, on distingue plusieurs outils différents : des lamelles, des micro-burins, des grattoirs, des outils à denticules."
                            }
                        ]
                    }
