                "senses": [
                    {
                        "sense_id": "fffb547b-b8c4-3e35-9a28-f820b6ec43dd",
                        "entry_id": "b02ddf44-f0a5-3dd0-ae63-d7284f7226bf",
                        "glosses": [
                            "To bore through an existing hole, generally to correct its shape, or to enlarge."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6333ec37-ed0c-4449-bf25-dd617b07c8b1",
                                "sense_id": "fffb547b-b8c4-3e35-9a28-f820b6ec43dd",
                                "text": "If you want to keep using that rifle, you'll have to rebore the barrel."
                            },
                            {
                                "example_id": "7f8573e6-87b9-42bb-ab05-5bd4e4e7d857",
                                "sense_id": "fffb547b-b8c4-3e35-9a28-f820b6ec43dd",
                                "text": "The cylinders of your engine are so worn the rings don't seal any more; you have to have it rebored to stop it from burning oil."
                            },
                            {
                                "example_id": "512641fa-9c3a-42a1-abed-1f0477cb96c8",
                                "sense_id": "fffb547b-b8c4-3e35-9a28-f820b6ec43dd",
                                "text": "Every major bridge, and many of the smaller ones, have been rebuilt, tunnels have been rebored, and long sections of track realigned."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
