                                    },
                                    {
                                        "sense_id": "9d73b332-53da-37bb-86d5-76b418ea9867",
                                        "entry_id": "1e0b5efc-4635-3d66-8c67-d7765bc648c8",
                                        "glosses": [
                                            "Lust auf etwas habend; etwas mögend, daran Vergnügen findend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
