                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ef2c890-61ef-43cf-a93e-4be65f8a2bb5",
                        "source_entry_id": "e36b45aa-f7be-3adc-8056-0f4b2aa68c19",
                        "source_sense_description": "ancient silver coin",
                        "target_lang_word": "obole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77a53092-5a89-3d82-b080-04c069873067",
                                        "entry_id": "08aed1e3-f40b-3149-b774-872deaf4088f",
                                        "glosses": [
                                            "Nom d’une ancienne monnaie de peu de valeur, employée dans l’antiquité grecque."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65caf519-4ca3-4197-8ddb-8b554c822c7d",
                                                "sense_id": "77a53092-5a89-3d82-b080-04c069873067",
                                                "text": "La chanteuse tendit la main aux passants qui faisaient cercle autour d'elle, et recueillit quatre oboles qu'elle glissa dans sa chaussure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "825e0bca-218c-3346-ab20-68813385a9f2",
                                        "entry_id": "08aed1e3-f40b-3149-b774-872deaf4088f",
                                        "glosses": [
                                            "Monnaie de cuivre valant un demi-denier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fb6ff5d-6d63-3624-a657-2b3d1aa2a844",
                                        "entry_id": "08aed1e3-f40b-3149-b774-872deaf4088f",
                                        "glosses": [
                                            "Petite somme d’argent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "178382e8-beca-45da-911b-5d9d4dcde206",
                                                "sense_id": "9fb6ff5d-6d63-3624-a657-2b3d1aa2a844",
                                                "text": "Quel est le Grec qui, sans déplaire à Dieu, pourrait dire qu’une obole en numéraire lui a été ravie depuis que je gouverne la Crète ?"
                                            },
                                            {
                                                "example_id": "f92be1bb-b42b-4356-802e-5e7dabe88e9c",
                                                "sense_id": "9fb6ff5d-6d63-3624-a657-2b3d1aa2a844",
                                                "text": "J’ai songé effectivement que si vous goûtiez de ce que j’ai dans ma bague, je ne donnerais pas une obole de votre immortalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62376b59-1290-33a9-82e4-71064be0982f",
                                        "entry_id": "08aed1e3-f40b-3149-b774-872deaf4088f",
                                        "glosses": [
                                            "Modeste offrande ou don peu important."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf106c4e-8b25-45fe-b5f1-6198adb22009",
                                                "sense_id": "62376b59-1290-33a9-82e4-71064be0982f",
                                                "text": "Le lendemain, nous voulûmes y retourner, porter une dernière obole, et mon père, à qui nous l'avions dépeint, nous accompagna."
                                            },
                                            {
                                                "example_id": "5a7434ce-97bb-4f7c-bebb-8417de6674e6",
                                                "sense_id": "62376b59-1290-33a9-82e4-71064be0982f",
                                                "text": "Les syndicats n’accepteront pas l’obole du ministre."
                                            },
                                            {
                                                "example_id": "d09e36a1-f232-478c-b3f9-13efcfee4a1b",
                                                "sense_id": "62376b59-1290-33a9-82e4-71064be0982f",
                                                "text": "je n’en donnerais pas une obole, je ne fais aucun cas de cela, je n’en donnerais pas le moindre prix."
                                            },
                                            {
                                                "example_id": "d56212e0-2595-4b5e-a476-7c60ef3a8adf",
                                                "sense_id": "62376b59-1290-33a9-82e4-71064be0982f",
                                                "text": "Les fonctionnaires voient leurs salaire défalqué d’une contribution, des collectes sont même organisées auprès des écoliers invités à donner « librement » une obole. — (Mikal Hem, Et si je devenais dictateur, traduit du norvégien par Jean-Baptiste Coursaud, Gaïa, 2017, page 172)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
