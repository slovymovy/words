                "senses": [
                    {
                        "sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                        "entry_id": "8b5bcaad-5de8-3fd6-b23f-c736b84a1fc7",
                        "glosses": [
                            "Filter, der unerwünschte Bestandteile aus der ihn durchströmenden Luft entfernt/zurückhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3091c12d-4f6a-4b4d-b656-b809843e3789",
                                "sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                                "text": "Alle Luftfilter in Lüftungsanlagen müssen regelmäßig gewechselt werden. Die Luftfilterüberwachung zeigt die Verschmutzung des Luftfilters an."
                            },
                            {
                                "example_id": "1c7b1838-0d1d-41a0-9a51-b750144a31f5",
                                "sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                                "text": "„Grundsätzlich sind Luftfilter der Differenzdrucküberwachung unterworfen.“"
                            },
                            {
                                "example_id": "d7ef7003-8142-4002-a9c6-e95ccf251df5",
                                "sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                                "text": "„Die EN 779:2011 wurde vom Technischen Komitee CEN/TC 195 »Luftfilter für die allgemeine Raumlufttechnik« erarbeitet.“"
                            },
                            {
                                "example_id": "20834f5e-1246-4d5b-96ab-baecc2db3a50",
                                "sense_id": "9e341c49-d5ad-3e6c-bf16-b4f172e2b946",
                                "text": "„Luftfilter tragen dazu bei, die geforderte Luftqualität in den belüfteten Bereichen zu sichern und schützen die Anlagenkomponenten sowie das luftführende Leitungsnetz vor Verschmutzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
