                        "glosses": [
                            "Couvrir de plantes de nouveaux un lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ce9b6d-4658-47a6-91d0-e186f4b051d6",
                                "sense_id": "a1d868bd-5688-3105-a20c-4ae05f21ab2e",
                                "text": "La ville reste un terrain difficile à revégétaliser. Des travaux de génie civil sont souvent nécessaires afin de contourner les «obstacles souterrains et aériens» pour offrir des entourages vitaux perméables aux arbres."
                            },
                            {
                                "example_id": "59747c5f-a83a-49cb-a051-7359fcf6adf7",
                                "sense_id": "a1d868bd-5688-3105-a20c-4ae05f21ab2e",
                                "text": "Pour le confort des visiteurs, la cour du musée va aussi être revégétalisée « et les sculptures mises en valeur », annonce le musée."
                            }
                        ]
                    }
