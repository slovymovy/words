                "senses": [
                    {
                        "sense_id": "314914ad-caae-38d6-a9c1-6a34ffa7a599",
                        "entry_id": "05e73c22-e565-3ed4-a53b-1ada86143cbe",
                        "glosses": [
                            "Doctrine de Spinoza, surtout considérée en tant qu’athéisme qui oppose à la conception transcendante du divin une philosophie matérialiste de l’immanence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3573e3af-50d9-4145-9cf6-2d4e6d1b501a",
                                "sense_id": "314914ad-caae-38d6-a9c1-6a34ffa7a599",
                                "text": "Si la Nature est Dieu, toute croyance en un Dieu surnaturel ou transcendant est en effet exclue, et tel est bien le sens du spinozisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93629305-5c00-4c50-82c5-36dee3562041",
                        "source_entry_id": "05e73c22-e565-3ed4-a53b-1ada86143cbe",
                        "source_sense_id": "314914ad-caae-38d6-a9c1-6a34ffa7a599",
                        "target_lang_word": "Spinozism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spinozism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c540002-c3a0-3ab6-b67c-e02e53e4c45b",
                                        "entry_id": "bd718984-b1da-3ade-a9e8-991f2097581a",
                                        "glosses": [
                                            "The philosophical doctrine of Baruch Spinoza (1632-1677) and his followers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c835f97e-e822-4e4b-9dd6-26aff35deb42",
                                                "sense_id": "8c540002-c3a0-3ab6-b67c-e02e53e4c45b",
                                                "text": "A common weapon against Cartesians in those latter days was an accusation of Spinozism."
                                            },
                                            {
                                                "example_id": "f01a9d65-bf86-4cc2-8550-f20f95b95f43",
                                                "sense_id": "8c540002-c3a0-3ab6-b67c-e02e53e4c45b",
                                                "text": "But of course Spinozism in an empiricist mode is Spinozism with a considerable difference, as ethics written in Hume's preferred nonabstruse style (and increasingly nonabstruse from Treatise to Essays and Enquiries) sets a different tone from ethics in ordine geometrico."
                                            },
                                            {
                                                "example_id": "28f9a140-c1db-4d08-bc5e-8a33493145d2",
                                                "sense_id": "8c540002-c3a0-3ab6-b67c-e02e53e4c45b",
                                                "text": "Monism, as characterized here, seems to be a commitment both of Spinoza and of variants of Spinozism influential in Germany in the 1780s and 90s."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
