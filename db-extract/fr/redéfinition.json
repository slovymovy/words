                "senses": [
                    {
                        "sense_id": "d2d83521-e421-3817-932b-c4b9ea6f9937",
                        "entry_id": "58b8c02d-e49c-331e-af37-81485e6dc6bd",
                        "glosses": [
                            "Action de changer, de reformuler une définition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b83ef98b-3818-4fe5-835e-be5257026d58",
                                "sense_id": "d2d83521-e421-3817-932b-c4b9ea6f9937",
                                "text": "une comparaison méthodique montrerait tout de suite que la prétendue « montée inexorable » des « violences urbaines » est avant tout une thématique politico-médiatique visant à faciliter la redéfinition des problèmes sociaux en termes de sécurité."
                            },
                            {
                                "example_id": "9648bcfd-3a6c-4180-bfd5-dcb8696e6ff4",
                                "sense_id": "d2d83521-e421-3817-932b-c4b9ea6f9937",
                                "text": "L’écosocialisme conserve les objectifs émancipateurs du socialisme première version et rejette les buts atténués, réformistes, de la social-démocratie et les structures productivistes du socialisme bureaucratique. Il insiste sur une redéfinition des voies et du but de la production socialiste dans un cadre écologique."
                            }
                        ]
                    },
                    {
                        "sense_id": "be9abd99-f947-3ab7-8be2-0184bab2e345",
                        "entry_id": "58b8c02d-e49c-331e-af37-81485e6dc6bd",
                        "glosses": [
                            "Écrasement d’une méthode d’une classe dans une de ses instances."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "13385204-6d03-4b7c-8e26-f3f64ad91b8f",
                                "sense_id": "be9abd99-f947-3ab7-8be2-0184bab2e345",
                                "text": "La redéfinition autorise donc deux objets liés par une relation d'héritage à utiliser une même signature de méthode pour des méthodes qui réalisent des choses différentes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe26574-bafa-41f0-a698-289edb8615f7",
                        "source_entry_id": "58b8c02d-e49c-331e-af37-81485e6dc6bd",
