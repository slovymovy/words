                            {
                                "example_id": "66463124-17e3-4b97-801b-d0d4dfeaccf1",
                                "sense_id": "1aac771a-d26d-3527-a5c9-2cbd06364964",
                                "text": "Die Agrarökonomin Priska Baur von der Eidgenössischen Forschungsanstalt für Wald, Schnee und Landschaft (WSL) zeigt Verständnis."
                            },
                            {
                                "example_id": "33ca2c76-bd5e-424d-907f-d27be6b28b23",
                                "sense_id": "1aac771a-d26d-3527-a5c9-2cbd06364964",
                                "text": "Auf Initiative der Grünen Priska Hinz hin fordert der vierte Antrag, das Stammzellgesetz nicht zu ändern und es bei der bisherigen Stichtagsregelung zu belassen."
                            },
                            {
                                "example_id": "474369cf-3f0e-4125-871c-b2ea1e8e1809",
                                "sense_id": "1aac771a-d26d-3527-a5c9-2cbd06364964",
                                "text": "Als Soziologin mit dem Schwerpunkt „Soziale Bewegungen und Zivilgesellschaft“ hat Priska Daphi im vergangenen Jahr an der Humboldt-Universität zu Berlin promoviert."
                            }
                        ],
                        "sense_index_json": "\"1\""
