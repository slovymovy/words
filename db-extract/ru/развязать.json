                    },
                    {
                        "sense_id": "2debfe1a-25a0-34ff-841c-41abaa60a573",
                        "entry_id": "27a1689a-2a15-3220-b36d-741d86904b27",
                        "glosses": [
                            "перен. разг. привести к завершению, развязке"
