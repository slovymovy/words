                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85aa0f50-0a84-4b1e-bbf3-2b6dc3a27a60",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "Er kommt nie über Redensarten hinaus, und ein etwas subtileres Denken wäre ihm zu wünschen."
                                            },
                                            {
                                                "example_id": "0a64be27-edd1-4dc5-8fb1-b64e7a45c3d1",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "Eine pampige Behauptung siegt oft über eine subtile Begründung."
                                            },
                                            {
                                                "example_id": "ac126007-8292-49c3-8e94-6441ce874fd8",
                                                "sense_id": "af697d11-7edb-3e11-9061-809dde15d326",
                                                "text": "„… Er bat mich, gnädigster König,",
                                                "translation": "Goethe, Reineke Fuchs, Sechster Gesang"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                        "entry_id": "573809f5-3e1d-3751-a2a9-1fae9ab62566",
                                        "glosses": [
                                            "scharfsinnig, auf eine eher negative Art hinten herum; mit verhüllten Zielen"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acb7209f-b763-4581-855d-db0d31fd80a1",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "„… Er bat mich, gnädigster König,",
                                                "translation": "Goethe, Reineke Fuchs, Sechster Gesang"
                                            },
                                            {
                                                "example_id": "02f5a00a-4230-40ec-b129-273997fdc3e6",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "Ich meine, wir sind besser in einigen Belangen… Wir sind subtiler… Benutzen mehr Worte und rechtliche Kniffe, um alles zu legitimieren."
                                            },
                                            {
                                                "example_id": "01f5b183-06a5-4325-8452-6e791e90b3f6",
                                                "sense_id": "183bc657-64ab-3e44-9e97-9a0f46e867b5",
                                                "text": "Das ist besser, als einfach mitten in der Nacht zu verschwinden. Aber nur, weil etwas subtiler ist, macht es das Ganze nicht richtig.\" (Bradley Manning)"
