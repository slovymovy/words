                "senses": [
                    {
                        "sense_id": "e2041744-f0b0-345a-8806-554987b62577",
                        "entry_id": "70032e8d-7e37-3662-808f-048c497212d0",
                        "glosses": [
                            "Person, die in der Lage ist für ein vorhandenes Problem eine passende Lösung zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a22685-efe4-47e6-8d55-77b636eba690",
                                "sense_id": "e2041744-f0b0-345a-8806-554987b62577",
                                "text": "„'Mathematikerinnen und Mathematiker sind universelle Problemlöser', bringt es Professor Dr. Burkhard Kümmerer von der Technischen Universität Darmstadt auf den Punkt.“"
                            },
                            {
                                "example_id": "28ee2d99-1a45-42ce-9533-3ac5efe4eb65",
                                "sense_id": "e2041744-f0b0-345a-8806-554987b62577",
                                "text": "„Ein Problemlöser sieht seine Probleme als intellektuelle Herausforderung oder als Rätsel, das es zu lösen gilt.“"
                            },
                            {
                                "example_id": "098a6feb-ac3d-4c5e-bc8b-2a5fce652845",
                                "sense_id": "e2041744-f0b0-345a-8806-554987b62577",
                                "text": "„Erfolgreiche Problemlöser haben gewisse identische Techniken und Methoden, welche sie immer wieder sehr effektiv zur Anwendung bringen.“"
                            },
                            {
                                "example_id": "1dae5384-b252-4536-bddb-323bc53bf3ed",
                                "sense_id": "e2041744-f0b0-345a-8806-554987b62577",
                                "text": "„Mit dem Fellowship-Programm prämiert und fördert die Organisation Problemlöser weltweit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
