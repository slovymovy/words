                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                        "entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                        "glosses": [
                            "Misspelling of trouper (“one who stoically endures adversity”) ."
                        ],
                        "tags": [
                            "alt-of",
                            "colloquial",
                            "figuratively",
                            "misspelling"
                        ],
                        "examples": [
                            {
                                "example_id": "32e903eb-2837-4caa-9c45-48140d53a112",
                                "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                                "text": "He was a real trooper about taking care of the kids for the weekend."
                            },
                            {
                                "example_id": "56215519-2e86-45db-b5b6-20297bf1867e",
                                "sense_id": "a77a9584-8166-3f56-935f-879e44d6e28b",
                                "text": "Because his father and brothers were in the department, he had to be. She knew he was never really comfortable with the job but still he did it like a trooper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8a46aef-688a-447f-aa9b-f5fadfd5eab2",
                        "source_entry_id": "da7db54a-072f-39a7-93e8-969c69f1bcd7",
                        "source_sense_description": "a soldier",
                        "target_lang_word": "troupier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "troupier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                        "entry_id": "3ffc4237-824f-31ce-8758-1f069f94bc21",
                                        "glosses": [
                                            "Soldat ; homme de troupe."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ec59248-1b2f-4672-b080-e01d379db2ed",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "Ah ! brigands, vous ne jetterez pas à l’eau comme une huître un ancien troupier de Napoléon."
                                            },
                                            {
                                                "example_id": "5d7b8f41-f3f6-4497-b193-9edf9b76668b",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "Les troupiers avertis s'étaient garés, et déjà les uns aidaient les sapeurs à couper les maîtresses branches pour en faire des abattis, pendant que les autres commençaient le feu par les créneaux."
                                            },
                                            {
                                                "example_id": "611f90d3-081b-48b4-b5a7-9658819cd298",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "La bouteille de limonade, dont elle accepta de boire un verre, demeura, dans le souvenir du troupier, mémorablement délicieuse."
                                            },
                                            {
                                                "example_id": "5ae4856e-8135-4947-baf1-bf45c3e04b99",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "[…], on pourrait dire que le soldat était convaincu que la moindre défaillance du moindre des troupiers pouvait compromettre le succès de l’ensemble et la vie de tous ses camarades - et que le soldat agissait en conséquence."
                                            },
                                            {
                                                "example_id": "e7cda13b-7eac-4b14-8429-540112af3d43",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "Ce sont des harrâba, des soldats dressés à Gibraltar pour servir d’instructeurs à leurs camarades; mais ils se sont empressés d'oublier ce qu'ils avaient appris et ne se distinguent guère des autres troupiers marocains."
                                            },
                                            {
                                                "example_id": "7d08b692-9913-4675-ae74-e603e10d39ce",
                                                "sense_id": "6750a06b-c51f-309e-9176-216b5d4c79c3",
                                                "text": "Ces bribes du passé ne l’intéressaient qu’en tant que résidus d’une expérience qui n’était plus à refaire. « Tout ça », disait-il, usant d’une de ces expressions de troupier qu’un homme qui a passé par l’armée emploie souvent jusqu’à la fin de ses jours, « tout ça a compté dans le congé »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "troupier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a9faae59-b892-38f8-93a0-9a82d097d3ca",
                                        "entry_id": "11cabcce-c9b2-3c80-921f-f3b9e6e0732a",
                                        "glosses": [
                                            "Qui a un rapport avec une troupe ou un troupier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0cfca80-7b97-4eb6-8d57-ccfd71ecb7b6",
                                                "sense_id": "a9faae59-b892-38f8-93a0-9a82d097d3ca",
                                                "text": "Et pour se reprendre en main il employait le langage troupier, avec le plus possible de foutre et de bougre."
                                            },
                                            {
                                                "example_id": "88a0704d-701c-493c-bc0c-8b3eebd52852",
                                                "sense_id": "a9faae59-b892-38f8-93a0-9a82d097d3ca",
                                                "text": "pour les puristes, il appartient à cette génération troupière dont les batailles ont rendu l’écorce rude, mais dont l’esprit est devenu plus vif, plus saillant,plus original"
                                            },
                                            {
                                                "example_id": "354ec7af-7476-479c-a073-b6e7fef7dc0d",
                                                "sense_id": "a9faae59-b892-38f8-93a0-9a82d097d3ca",
                                                "text": "Si vous trouvez la sœur Olympe trop troupière, c’est sa faute plus que la mienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
