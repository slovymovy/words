                "senses": [
                    {
                        "sense_id": "241ddc14-e938-34ba-a949-dd2b17028239",
                        "entry_id": "a15f72a6-b260-3970-bde9-50da01122d20",
                        "glosses": [
                            "eine Niger-Kongo-Sprache (genauer: atlantische Sprache), die in Westafrika und Zentralafrika verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bd65cb8-2081-4077-ad1b-5f781327ae85",
                                "sense_id": "241ddc14-e938-34ba-a949-dd2b17028239",
                                "text": "„[Vor] etwa 12–15 Jahren war in der Gegend um Mubi vornehmlich Fulfulde und nicht Hausa die Umgangssprache[.]“"
                            },
                            {
                                "example_id": "908d942e-5b3b-44de-bec2-09c144f66171",
                                "sense_id": "241ddc14-e938-34ba-a949-dd2b17028239",
                                "text": "„In der Schulausbildung dominiert das Französische. In den unteren Klassen finden daneben auch Bambara, Fulfulde, Songai, und Tamasheq Berücksichtigung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
