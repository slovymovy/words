                "translations": [
                    {
                        "translation_id": "0bc6ecea-1461-4d06-a7d8-a984ce6308bf",
                        "source_entry_id": "13f98150-a26a-3e1f-927f-7546a3ecee20",
                        "source_sense_id": "76f45f4b-a17c-3777-9365-94aac10c0f34",
                        "target_lang_word": "personification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "personification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A person, thing or name typifying a certain quality or idea; an embodiment or exemplification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1688a5c0-8aa1-4e7b-b1ae-e6869779f355",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "Adolf Hitler was the personification of anti-Semitism."
                                            },
                                            {
                                                "example_id": "41d88554-d9b9-46bc-9aed-53309f6c53fb",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "He might have sat for a personification of fear: if he moved, he seemed rather afraid of his own shadow following him too closely; if he laughed, he soon checked himself, quite alarmed at the sound."
                                            },
                                            {
                                                "example_id": "4fa256ba-c9b9-447e-8bda-6eacb7666477",
                                                "sense_id": "d51e0bfc-7a73-324e-b887-761ec523aa64",
                                                "text": "De Coude was the personification of coolness—was he not the best shot in France?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "A literary device in which an inanimate object or an idea is given human qualities."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "261f660c-c3b9-4669-8b3e-f55079e01faf",
                                                "sense_id": "b52182ef-99ae-3a33-9a59-09c0f3235d9d",
                                                "text": "The writer used personification to convey her ideas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                        "entry_id": "dbe32dfe-170c-3a1f-ab3a-32e353c02573",
                                        "glosses": [
                                            "An artistic representation of an abstract quality as a human"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9c6de46-4d09-475e-a82f-9e63dfe8bc6e",
                                                "sense_id": "6b5cf9ed-6530-3d17-9192-4dce304525c5",
                                                "text": "The Grim Reaper is a personification of death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
