    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                "word": "dwale",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7a995476-c353-4b7e-aefb-1391ac24ee45",
                        "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                        "tags": [
                            "plural"
                        ],
                        "form": "dwales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "43e335f5-67cb-3f11-a287-33503c6c0c0c",
                        "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                        "glosses": [
                            "Belladonna or a similar soporific plant."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3b1792a2-e5df-40ab-9634-45523a6a5a1a",
                                "sense_id": "43e335f5-67cb-3f11-a287-33503c6c0c0c",
                                "text": "Beneath and around the clumps of ragged moss-grown elder and hoary stunted whitethorn (...) rise thickets of tall nettles and rank hemlock, concealing the deadly but alluring dwale —"
                            },
                            {
                                "example_id": "690d4eb2-b97a-4b69-87f8-264a08dea2c6",
                                "sense_id": "43e335f5-67cb-3f11-a287-33503c6c0c0c",
                                "text": "All parts of the dwale are poisonous, said to resemble snake bite, but the roots are said to be four or five times as virulent as the rest of the plant."
                            },
                            {
                                "example_id": "137e859a-39e0-4d42-903d-7be62f863420",
                                "sense_id": "43e335f5-67cb-3f11-a287-33503c6c0c0c",
                                "text": "It was not bog myrtle at all, it was dwale."
                            },
                            {
                                "example_id": "a7cb149b-c191-45c0-9363-f097c139bf94",
                                "sense_id": "43e335f5-67cb-3f11-a287-33503c6c0c0c",
                                "text": "Monkshood and dwale belong to Hecate, the moon goddess of the witches, and by their use are witches able to fly."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd3cdaaa-ba58-3fc2-bfcb-80d5212fce22",
                        "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                        "glosses": [
                            "A sleeping-potion, especially one made from belladonna."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b4514c1f-a192-47a4-850d-5e661a0c0bf3",
                                "sense_id": "bd3cdaaa-ba58-3fc2-bfcb-80d5212fce22",
                                "text": "The authors studied the ingredients and method of administration to try to ascertain whether dwale was effective, and they found it certainly could have worked."
                            },
                            {
                                "example_id": "16c6bf03-e984-445f-a8a0-8372fb24a447",
                                "sense_id": "bd3cdaaa-ba58-3fc2-bfcb-80d5212fce22",
                                "text": "'That is all?' Payne askes. 'You need no salve? No dwale?'"
                            },
                            {
                                "example_id": "c302b3a7-a318-427e-a73c-1ec85984b206",
                                "sense_id": "bd3cdaaa-ba58-3fc2-bfcb-80d5212fce22",
                                "text": "Dwale was a solution of wine mixed with a number of other ingredients, Some were pretty mile, like lettuce and boar bile. But the recipe also called for hemlock and belladonna, both known to be highly poisonous."
                            },
                            {
                                "example_id": "2ba93bc8-6ca1-4a20-9d73-e0f050cb87ff",
                                "sense_id": "bd3cdaaa-ba58-3fc2-bfcb-80d5212fce22",
                                "text": "Cadell agrees the vial contains arsenic, not willow bark, and it is no wonder Rollo found relief from what was in the flask since it isn't wine but dwale."
                            }
                        ]
                    },
                    {
                        "sense_id": "2daeb234-98e6-33f5-9239-fb5c5c9f3344",
                        "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                        "glosses": [
                            "A torpor."
                        ],
                        "tags": [
                            "countable",
                            "dialectal",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "56e7a771-b767-413d-b983-b316d7c85fbc",
                                "sense_id": "2daeb234-98e6-33f5-9239-fb5c5c9f3344",
                                "text": "He's in a dwale, a dead sleep; a common expression in the North of England."
                            },
                            {
                                "example_id": "79fe6443-dcfb-474a-ab05-6a56b9c0ba3b",
                                "sense_id": "2daeb234-98e6-33f5-9239-fb5c5c9f3344",
                                "text": "I stayed up there in a dwale – not seeing, not even thinking – until suddenly the wind got up and its chill woke me."
                            }
                        ]
                    },
                    {
                        "sense_id": "671ea094-5e6c-3e0b-b8e0-d3e18f0c490b",
                        "entry_id": "6c049d2e-131b-38d3-89f8-d670c92ba6bc",
                        "glosses": [
                            "A bugbear."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "76a6ba78-af2b-4eef-9b79-3b607d676e6c",
                                "sense_id": "671ea094-5e6c-3e0b-b8e0-d3e18f0c490b",
                                "text": "Consume us; shake the darkness like a tree, And fill the night with mischiefs, — blights and dwales, Weevils, and rots, and cankers!"
                            },
                            {
                                "example_id": "93377fe9-1b63-4ac7-8848-2196638452c8",
                                "sense_id": "671ea094-5e6c-3e0b-b8e0-d3e18f0c490b",
                                "text": "Tickle under their chins microscopical djinns or tease geloscopical dwales who live in The Tree That Can Never Be and fish for chocolate whales?"
                            }
                        ]
                    }
                ],
