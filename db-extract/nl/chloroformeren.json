                "translations": [
                    {
                        "translation_id": "be0af6d9-fa99-4477-9e3e-e8516237ab48",
                        "source_entry_id": "8aa987ae-6f5a-3b4e-9671-5438a6a8c058",
                        "source_sense_id": "0e6ab9ec-daca-3a34-9a50-551de24fc274",
                        "source_sense_description": "gevoelloos maken met chloroform",
                        "target_lang_word": "chloroformer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chloroformer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b7319e7-c2c9-3102-9e96-e8c2abdb8ab4",
                                        "entry_id": "e3c7ead9-f33a-323a-99c6-ddf161a5c692",
                                        "glosses": [
                                            "Soumettre à l’action du chloroforme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f88090-fc37-4bfb-802b-03e0f5ca5cd6",
                                                "sense_id": "5b7319e7-c2c9-3102-9e96-e8c2abdb8ab4",
                                                "text": "Elle rassembla toute l’énergie qui lui restait et chloroforma tous ses chats, un par un. Une odeur suffoquante emplissait le logement, la « Mort aux Chats » commençait à s’endormir elle-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c89c5aee-39e7-3d2c-a6de-1660d4d686e6",
                                        "entry_id": "e3c7ead9-f33a-323a-99c6-ddf161a5c692",
                                        "glosses": [
                                            "Rendre insensible, passif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "016870b8-f9c2-4ad5-8678-da2e11edec0b",
                                                "sense_id": "c89c5aee-39e7-3d2c-a6de-1660d4d686e6",
                                                "text": "Les titres des articles sont particulièrement fantaisistes. « Chloroformez les jitter-bugs, s’écrie Panassié. » Je n’ai naturellement rien dit de semblable."
                                            },
                                            {
                                                "example_id": "6e4702b1-5591-4df7-9ec0-3f2ed3bd27cd",
                                                "sense_id": "c89c5aee-39e7-3d2c-a6de-1660d4d686e6",
                                                "text": "Tuer le désir n’est pas possible. On peut le tromper, l’endormir, le chloroformer avec des prières – c’est tout."
                                            },
                                            {
                                                "example_id": "87851d35-e155-497b-adba-394ee2c0372d",
                                                "sense_id": "c89c5aee-39e7-3d2c-a6de-1660d4d686e6",
                                                "text": "Un silence gêné suit le rituel « On va peut-être attendre un minute les retardataires. » Ensuite, l’ordre du jour est lu dans une atmosphère distraite, presque chloroformée. La première question évoquée ne dissipe en rien cette lourdeur hibernante."
                                            },
                                            {
                                                "example_id": "28de79b8-9462-46fb-884f-0d3f7d498174",
                                                "sense_id": "c89c5aee-39e7-3d2c-a6de-1660d4d686e6",
                                                "text": "Elles stigmatisaient une littérature de la résignation, s’adressant à une population chloroformée, s’abandonnant aux petites choses et renonçant aux grandes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
