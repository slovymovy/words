                "senses": [
                    {
                        "sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
                        "entry_id": "41ca6dde-7ad8-3fa1-818a-4d053477306d",
                        "glosses": [
                            "eine Maschine, die nach Bezahlung ein gewähltes Produkt auswirft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00cc7aa7-a398-49b7-b2df-f1d4246fa87f",
                                "sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
                                "text": "Man findet Verkaufsautomaten mit Getränken und Süßigkeiten auf vielen deutschen Bahnsteigen."
                            },
                            {
                                "example_id": "fd55350a-f020-4d69-9042-154ae464426b",
                                "sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
                                "text": "Als ich in der Nacht einen Platten hatte, kaufte ich mir einen neuen Schlauch an einem Verkaufsautomaten für Fahrradschläuche."
                            },
                            {
                                "example_id": "7bf6133e-3f70-4b54-b012-dfcbcc7421a4",
                                "sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
                                "text": "In Belgien kann man sogar ganze Brote an Verkaufsautomaten erwerben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f97ad62-339e-4b54-a982-8932060eda73",
                        "source_entry_id": "41ca6dde-7ad8-3fa1-818a-4d053477306d",
                        "source_sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
                        "source_sense_description": "eine Maschine, die nach Bezahlung ein gewähltes Produkt auswirft",
                        "target_lang_word": "vending machine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vending machine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                        "entry_id": "bfecb651-26fe-31c7-bcb7-ecb94edad81d",
                                        "glosses": [
                                            "An automatic machine that dispenses merchandise (often food or beverages) in return for payment (originally coins; now also often paper money, credit cards, and wirelessly via digital payment apps)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb2eb514-b91c-4704-b222-86815d7b1f94",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "Meronyms: bill acceptor, card swipe, change slot, coin return, coin slot, flavor strip"
                                            },
                                            {
                                                "example_id": "97490405-058c-4e77-9d72-913e9ca4bb8b",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "It is not clear to all operators of vending machines, though, that their future lies in dispensing meals, rather than snacks or candy."
                                            },
                                            {
                                                "example_id": "48deb037-dce3-43ee-8113-1d4f26affd51",
                                                "sense_id": "92d7804c-0d06-30bb-b380-f0b67c90235e",
                                                "text": "Passengers may find themselves in a catch-22 situation, unable to buy a ticket for any number of reasons, ranging from an out-of-order ticket vending machine to a lengthy queue to use one, and yet then fall foul of the penalty fare regime."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d7d8f4f-bd4a-46b0-a365-1b4b272f3b15",
                        "source_entry_id": "41ca6dde-7ad8-3fa1-818a-4d053477306d",
                        "source_sense_id": "c581ffe6-be2c-3be7-9809-30f64c3f7839",
