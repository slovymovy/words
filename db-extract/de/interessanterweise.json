                    {
                        "sense_id": "520c64c1-70ca-36ad-b83a-bf1b320f17ce",
                        "entry_id": "45d37160-583e-3dc4-a9e0-ca7c59fb5ad8",
                        "glosses": [
                            "auf eine Art und Weise, die interessant ist"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0665ea2d-8b95-4231-a596-99b9828529ff",
                                "sense_id": "520c64c1-70ca-36ad-b83a-bf1b320f17ce",
                                "text": "Alle sagen zum Beispiel, Erziehungsarbeit sei wichtig. Aber interessanterweise will kaum ein Mann diese wichtige Arbeit leisten. Auf die Bürger ist kein Verlass, in: DIE ZEIT 29.04.1999, Seite 33, Seite 748"
                            },
                            {
                                "example_id": "56a0698d-879c-44ec-9970-5459c057ab50",
                                "sense_id": "520c64c1-70ca-36ad-b83a-bf1b320f17ce",
                                "text": "„Interessanterweise griffen viele Naturforscher und Ärzte unter dem Eindruck des Mesmerismus noch in der Mitte des 19. Jahrhunderts auf die Tradition der antiken Traumdeutung zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d241c468-def8-4143-b783-40ec644bb893",
                        "source_entry_id": "45d37160-583e-3dc4-a9e0-ca7c59fb5ad8",
                        "source_sense_id": "520c64c1-70ca-36ad-b83a-bf1b320f17ce",
                        "source_sense_description": "umgangssprachlich: auf eine Art und Weise, die interessant ist",
                        "target_lang_word": "interestingly",
                        "target_lang_code": "en",
