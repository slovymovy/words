                ],
                "senses": [
                    {
                        "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                        "entry_id": "c3b9eaa0-4d54-3637-98da-b75283842408",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8853c3ee-5cc6-4804-b40b-9196b2c0ee3b",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Frau Breyer ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e64ff468-b19f-48e3-bd9b-d9e1d8e457d3",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Herr Breyer wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b3b2a945-61f4-4b0a-8583-1ccab1d79866",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Die Breyers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "24f6236c-45ff-43dc-aba1-289fb6c4e2f9",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Der Breyer trägt nie die Schals, die die Breyer ihm strickt."
                            },
                            {
                                "example_id": "5ba07dab-bb84-4d40-8771-1629490115e6",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Breyer kommt, geht der Herr Breyer.“"
                            },
                            {
                                "example_id": "1d510945-b91f-45df-b12c-c31b9e613323",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Breyer kommt und geht."
                            },
                            {
                                "example_id": "b4c86d99-2bcd-4b1f-81bd-689bc8ee54af",
                                "sense_id": "51f04b4a-31e9-3075-a77c-7709bd3bae61",
                                "text": "Breyers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
