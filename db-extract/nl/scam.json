                        "entry_id": "41c0f985-e693-31cd-b896-71e781d14222",
                        "glosses": [
                            "vorm van bedrog, een misdrijf waarbij de dader een ander ontdoet van geld of van waardevolle goederen, tegenwoordig vaak met behulp van het internet"
                        ],
                        "tags": [
                            "misdaad"
