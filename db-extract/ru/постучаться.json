                "senses": [
                    {
                        "sense_id": "0c5e5fc5-4368-3380-8107-dc65025f1509",
                        "entry_id": "7be3a310-b15b-303b-922b-129f4218616d",
                        "glosses": [
                            "to knock"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfbeadd6-518f-44bd-8a2d-d3b9ed1f5f04",
                                "sense_id": "0c5e5fc5-4368-3380-8107-dc65025f1509",
                                "text": "постуча́ться в дверь",
                                "translation": "to knock at the door",
                                "english": "to knock at the door"
                            },
                            {
                                "example_id": "1f90527e-0ea7-4e5a-a216-f38da00d1642",
                                "sense_id": "0c5e5fc5-4368-3380-8107-dc65025f1509",
                                "text": "Ду́мая, что э́то Чо́нкин, старшина́, не поверну́в головы́, сказа́л:\n— Вы́йди, постучи́сь и войди́ сно́ва.\nЕму́ отве́тили:\n— Я тебе́ постучу́сь.",
                                "translation": "Thinking it was Chonkin again, Peskov said, without turning his head: “Go back out, knock, and come in again.”\n“I'll knock you” was the answer he received.",
                                "english": "Thinking it was Chonkin again, Peskov said, without turning his head: “Go back out, knock, and come in again.”\n“I'll knock you” was the answer he received."
                            }
                        ]
                    }
                ],
