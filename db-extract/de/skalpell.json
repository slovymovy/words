                        "source_sense_description": "Medizin: in der Chirurgie eingesetztes, kleines Messer zum Durchtrennen von Gewebe",
                        "target_lang_word": "bistouri",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
