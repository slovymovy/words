        "fr-extract.jsonl": [
            {
                "entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
                "word": "implicite",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ac61dcd5-4c8f-4d62-b7ab-40eaec298435",
                        "entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "implicites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                        "entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
                        "glosses": [
                            "Qui est contenu dans un discours, dans une clause, dans une proposition, non pas en termes clairs, exprès et formels, mais qui s’en tire naturellement par induction, par déduction et par conséquence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d201688e-15f7-44d8-ab98-7dc7b88b321e",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Alors que le capital économique peut (dans certaines limites puisqu’il y a la légitimité, etc.) se transmettre très vite, de la main à la main, de personne à personne, le capital culturel ne se transmet qu’au prix d’une dépense considérable de temps, et un critère implicite des hiérarchies culturelles est la longueur du temps d’acquisition."
                            },
                            {
                                "example_id": "4c35e288-c0d6-4e0a-a0ab-7f7d05cbc3c2",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Cela est contenu dans le contrat d’une manière implicite."
                            },
                            {
                                "example_id": "626d7be9-26f9-4fd4-b429-9137787667e9",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Condition implicite, qu’on suppose obligatoirement à partir du contexte."
                            },
                            {
                                "example_id": "7bf29fb7-7d65-45e5-9412-988d3a0db7f4",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Foi implicite, celle d’un homme qui, sans être instruit en détail de tout ce que l’Église a décidé, se soumet à tout ce qu’elle croit;par extension, confiance absolue dans l’opinion, dans les paroles de quelqu’un."
                            },
                            {
                                "example_id": "0ffa6ad9-e9fe-4715-a0f9-2951b051f6fc",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Volonté implicite, celle qui se manifeste, moins par des paroles que par certaines actions."
                            },
                            {
                                "example_id": "e99a7aac-641b-4836-8a70-9313711f8490",
                                "sense_id": "4857bdac-e3cd-3163-b52c-dc7357cf1947",
                                "text": "Fonction implicite, se dit d'une grandeur reliée à une autre par une équation qui n’est pas résolue par rapport à la première ; se dit aussi de l’équation qui exprime ces conditions."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0f41693-31d4-37d1-9189-355288608152",
                        "entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
                        "glosses": [
                            "Qui n'est pas explicitement contenu dans un contexte clair, exprès et formel, mais qui est susceptible d'être supposé ou compris par induction, par déduction et par conséquence, tels que des bonnes pratiques ou des attentes raisonnables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18600bb8-c956-4ae8-86b1-522a6a8321a5",
                                "sense_id": "c0f41693-31d4-37d1-9189-355288608152",
                                "text": "Il comprend aussi des zones implicites, plus ou moins claires : des \"bonnes pratiques\", des \"attentes raisonnables\" vis-à-vis des comportements, voire des présupposés ou des hypothèses totalement implicites sur les comportements des différents acteurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "794299dd-f06e-4bec-ab73-0910875fd60a",
                        "source_entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
                        "target_lang_word": "implizit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implizit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddaa2e67-7ef6-3416-85a8-3df02123cd3f",
                                        "entry_id": "ba32e9be-2929-3577-b150-a24c31403fc5",
                                        "glosses": [
                                            "unausgesprochen mitgemeint, mitverstanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33becc70-86c2-429d-a2d9-aacb781ecd74",
                                                "sense_id": "ddaa2e67-7ef6-3416-85a8-3df02123cd3f",
                                                "text": "Sie brachten ihre Kritik vorsichtshalber nur implizit an und waren dadurch nicht angreifbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ae2f9a67-4a25-35b7-a184-1b9fc0634844",
                                        "entry_id": "ba32e9be-2929-3577-b150-a24c31403fc5",
                                        "glosses": [
                                            "im Inneren eines Termes angegeben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47433068-efbd-4aed-a465-04d320ec2a91",
                                                "sense_id": "ae2f9a67-4a25-35b7-a184-1b9fc0634844",
                                                "text": "„Diese Frage ist deshalb so wichtig, weil viele Kurven in der Mathematik nicht explizit, sondern implizit definiert sind und man trotzdem wichtige Aussagen über sie treffen will.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93d8e317-88b8-4d03-b3b0-d8fa341d5ae3",
                        "source_entry_id": "7546cdbf-b88b-397e-b7c3-d7e00827c480",
