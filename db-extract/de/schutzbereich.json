                ],
                "senses": [
                    {
                        "sense_id": "11e9f529-eeca-3b4b-adf8-abc1fc13c030",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "verfassungsmäßig verbürgter Tatbestand eines Grundrechts, der die rechtlichen und tatsächlichen Voraussetzungen beschreibt, unter denen der Bürger oder ein anderer Grundrechtsträger von seinem Grundrecht Gebrauch machen kann"
                        ],
                        "tags": [
                            "Verfassungsrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "40165bea-2213-4f1e-97f8-fce331dc01d9",
                                "sense_id": "11e9f529-eeca-3b4b-adf8-abc1fc13c030",
                                "text": "„Die durch Art. 9 Abs. 3 GG geschützte Koalitionsfreiheit der Beschwerdeführerin wird durch die Entscheidung des Bundesarbeitsgerichts nicht verletzt. Es kann dahinstehen, ob der Schutzbereich der Koalitionsfreiheit eröffnet ist und ob ein Eingriff in den Schutzbereich der Koalitionsfreiheit vorliegt. Ein solcher wäre jedenfalls aus den gleichen Gründen gerechtfertigt, wie ein Eingriff in Art. 12 Abs. 1 GG.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bab70a79-67d2-364f-b1ba-e637a728d0a2",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "örtliche Zuständigkeit einer Dienststelle der Polizei ( der Feuerwehr)"
                        ],
                        "tags": [
                            "Polizeirecht",
                            "Ordnungsrecht",
                            "österr. auch"
                        ],
                        "examples": [
                            {
                                "example_id": "e6fa68dd-e793-4424-b37d-87c195860936",
                                "sense_id": "bab70a79-67d2-364f-b1ba-e637a728d0a2",
                                "text": "„Der 47-jährige … war … nach dem zweiten juristischen Staatsexamen in den brandenburgischen Polizeidienst eingetreten. Er leitete unter anderem den Schutzbereich Bernau und war Leiter des Stabes im Polizeipräsidium Potsdam, bevor er im November 2005 zum Leiter der Staatsschutzabteilung beim Landeskriminalamt und Vertreter des LKA-Direktors ernannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3b3e2e43-ce85-3ffe-80fe-21431dac2b50",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "Umgebung eines Flugplatzes, die zum Zwecke des Lärmschutzes nach dem Fluglärmgesetz in bestimmte Zonen eingeteilt wird, ausgewiesen durch eine Rechtsverordnung"
                        ],
                        "tags": [
                            "Umweltrecht"
                        ],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "58684e4e-0e91-39ab-add0-bbec4d056fc4",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "Gelände, für dessen Nutzung aus militärischen Gründen nach dem Schutzbereichgesetz bestimmte Beschränkungen gelten (beispielsweise für die landwirtschaftliche Nutzung), die durch eine Rechtsverordnung festgesetzt werden"
                        ],
                        "tags": [
                            "Wehrrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "eff0cbe2-4b03-4752-b7ad-3ffca0d0e336",
                                "sense_id": "58684e4e-0e91-39ab-add0-bbec4d056fc4",
                                "text": "„Ein Schutzbereich ist ein Gebiet, in dem die Benutzung von Grundstücken auf Grund besonderer Anordnung der zuständigen Bundesbehörde für Zwecke der Verteidigung, insbesondere auch, um die Verpflichtungen des Bundes aus zwischenstaatlichen Verträgen über die Stationierung und Rechtsstellung von Streitkräften auswärtiger Staaten im Bundesgebiet zu erfüllen, nach Maßgabe dieses Gesetzes beschränkt ist.“ (§ 1 Abs. 1 Schutzbereichsgesetz)"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "c8de0e06-7184-3f97-aa86-f6f84d8efdba",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "Bildausschnitt, der bei einer Filmaufnahme stets im Bild zu sehen sein soll, unabhängig von der Größe und vom Seitenverhältnis der Projektion oder des Fernsehgeräts, mit dem der Film später betrachtet wird"
                        ],
                        "tags": [
                            "Film",
                            "Fernsehen"
                        ],
                        "examples": [],
                        "sense_index_json": "\"5\""
                    },
                    {
                        "sense_id": "8a374306-98ef-3b81-a35a-d9114fef1184",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "Bereich innerhalb eines Gebäudes oder einer Wohnung (insbesondere Badezimmer), für den bestimmte Anforderungen an die Sicherheit von elektrischen Installationen bestehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7be9e4a-f735-4ad5-8861-ebaf620bfd61",
                                "sense_id": "8a374306-98ef-3b81-a35a-d9114fef1184",
                                "text": "„Die genauen Anforderungen an die Installation sind in der DIN-Norm DIN VDE 0100-0701:2008-10 festgelegt. Es werden verschiedene Schutzzonen bzw. Schutzbereiche unterschieden. …“"
                            }
                        ],
                        "sense_index_json": "\"6\""
                    },
                    {
                        "sense_id": "e5ca7889-daa1-3730-a90c-00d8e9c0b495",
                        "entry_id": "9eb6b3ae-df21-3b2b-8a35-5e3002140c2d",
                        "glosses": [
                            "das Gebäude oder die Räume, die durch eine Feuerlöschanlage gegen einen Brand geschützt werden; örtliche Zuständigkeit der Feuerwehr"
                        ],
                        "tags": [
                            "Brandschutz",
                            "österr. auch"
                        ],
                        "examples": [
                            {
                                "example_id": "ff60087a-c4b9-4c04-ada0-c5cf73d9e3f3",
                                "sense_id": "e5ca7889-daa1-3730-a90c-00d8e9c0b495",
                                "text": "„Sprühwasser-Löschanlagen kommen an Orten zum Einsatz, an welchen mit einer schnellen Brandausbreitung zu rechnen ist. Im Brandfall wird das Löschmittel umgehend im gesamten Schutzbereich verteilt. Auf diese Weise wird das Brandgut abgekühlt und durch die Wasserdampfentwicklung entsteht ein Stickeffekt. Zudem wird der Umgebungsluft die Wärme entzogen.“"
                            }
                        ],
                        "sense_index_json": "\"7\""
                    }
                ],
