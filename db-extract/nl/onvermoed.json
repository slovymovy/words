                                        "sense_id": "43a929a5-7a61-3bf4-8767-caa99e4ec0fa",
                                        "entry_id": "f681cf61-657f-3718-b2cd-1e36192ffa8d",
                                        "glosses": [
                                            "Not suspected; not having raised suspicion."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8d59a07-ebeb-4a91-b0a9-a4500b4f2d5f",
                                                "sense_id": "43a929a5-7a61-3bf4-8767-caa99e4ec0fa",
                                                "text": "The police uncovered his unsuspected drug dealing whilst investigating another matter."
                                            },
                                            {
                                                "example_id": "8a2a3ddb-f349-4628-b09a-44056d475f0a",
                                                "sense_id": "43a929a5-7a61-3bf4-8767-caa99e4ec0fa",
                                                "text": "At that time it was thought that the critical section, in which an irruption of water from the river was to be feared, lay under the Shoots, but this proved not to be the case. Indeed, relatively little trouble was experienced from the Severn. The very serious flooding, which twice submerged part of the works, came from an underground river, (now known as the Great Spring), the presence of which was unsuspected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5b4938c-4e77-42e9-b2f4-2b266f3a19de",
                        "source_entry_id": "f1c8e3c1-57e8-31ed-8f0f-047203252558",
                        "source_sense_id": "c535ea29-bde0-3b27-ac44-11bfb3e91b3b",
                        "target_lang_word": "unexpected",
                        "target_lang_code": "en",
