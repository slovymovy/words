                "senses": [
                    {
                        "sense_id": "b356cc46-ee84-3aee-a5c3-e2ba252690f5",
                        "entry_id": "f6dc04e2-0b76-36c7-b8d4-b785c1e7f3c6",
                        "glosses": [
                            "Gebrauchsanweisung und technisches Sammelwerk in knapper Fassung über die Lüftungstechnik, insbesondere in Buchform"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00a3b9e8-325f-43b8-88a0-31b9dadb20ae",
                                "sense_id": "b356cc46-ee84-3aee-a5c3-e2ba252690f5",
                                "text": "„Mit diesem neuen Promat-Lüftungshandbuch erhalten Sie aktuelle Informationen über die brandschutztechnischen Konstruktionen und Systeme unseres Hauses für Lüftung und Entrauchung.“"
                            },
                            {
                                "example_id": "f52da56f-6502-4a1a-b5e5-da15edb1209b",
                                "sense_id": "b356cc46-ee84-3aee-a5c3-e2ba252690f5",
                                "text": "„Baumeister Johannes Dinhobl erläutert, warum er gemeinsam mit BM Trözmüller das Projekt Lüftungshandbuch initiiert hat: „Die vielschichtigen Erfahrungen mit dem Einsatz von Lüftungsanlagen zwingen uns Baumeister, in diesem Bereich auch tätig zu werden, um gesicherte Ausführungsanforderungen zu bekommen!““"
                            },
                            {
                                "example_id": "a6278744-7bae-4431-8c43-128020a87429",
                                "sense_id": "b356cc46-ee84-3aee-a5c3-e2ba252690f5",
                                "text": "Von der Vorbereitung im Vorfeld, über die Arbeit auf der Baustelle bis hin zu Einzelbereichen wie KWL, Wärmeaustauscher oder Luftfilter - das Lüftungshandbuch liefert auf 319 Seiten einen umfassenden Gesamtüberblick."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
