                "translations": [
                    {
                        "translation_id": "1f4d53b1-e6bc-425e-851d-588c7d663ef6",
                        "source_entry_id": "70e0e93a-2996-3b24-9e54-bb79fa4c969e",
                        "source_sense_id": "af57d26a-61b4-3165-8d81-fc2ba00ce008",
                        "target_lang_word": "feeler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "feeler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a30830d-4431-3b09-bdda-9fd596cf18fa",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "Someone or something that feels."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c0637bf-d103-4dea-9246-82bbe28ad74d",
                                                "sense_id": "8a30830d-4431-3b09-bdda-9fd596cf18fa",
                                                "text": "Are you more of a feeler or more of a thinker?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "232cc8a4-dc52-370d-aa2f-35b48eb71a67",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "An antenna or appendage used for feeling, especially on an insect."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "Something ventured to test another's feelings, opinion, or position."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8bbbb90-4255-4fd7-89c8-baaa9d73a96f",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "I sent out some feelers but they didn't seem interested."
                                            },
                                            {
                                                "example_id": "c3ce6a72-2e72-4fe0-8e3f-9ccd16a7d162",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "This survey is designed to get a feeler about how the citizens feel about the proposed new highway."
                                            },
                                            {
                                                "example_id": "5154a1a8-c319-4cf2-bc3c-9b907e8a519c",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "In 1905, the Russo-Japanese war fought itself to a standstill, and with the destruction of Rozhiestvensky's fleet at Tsushima, the Japanese, for financial reasons, had to put out feelers for peace."
                                            },
                                            {
                                                "example_id": "bd43fb02-3fa8-4e2b-b606-f1a8934ce159",
                                                "sense_id": "c1ea6b79-3251-3ac6-9251-e7bfb7da5c47",
                                                "text": "Mr. Dayan's peace feeler would he more attractive to Cairo if it were accompanied by suggestions from Jerusalem, public private, for safeguarding Israeli security interests there without sacrificing Cairo's claim to ultimate sovereignty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa67cd5-da7d-3af1-80b5-f2ed55187b65",
                                        "entry_id": "cd24b8ea-2fdc-3ea7-af09-5dfec5845b78",
                                        "glosses": [
                                            "a presumptive person; someone who bases on gut feeling, such as assuming or imagining that something said or done, whether positive or negative, was for a person despite having no concrete confirmation but gut feeling, or someone who assumes one's affection is reciprocated, or indulges in one's own wishful thinking or flatters oneself"
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a21cce47-ec42-4934-8eb5-15699e024fe6",
                        "source_entry_id": "70e0e93a-2996-3b24-9e54-bb79fa4c969e",
                        "source_sense_id": "af57d26a-61b4-3165-8d81-fc2ba00ce008",
                        "target_lang_word": "antenna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antenna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "An appendage used for sensing on the head of an insect, crab, or other animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d020c7e-329e-4ee8-85ff-7f3eeee96256",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "The overall shape of most insect antennae is elongate and cylindrical, although elaborations into plumose, lamellate, or pectinate forms have arisen many times in different insect lineages."
                                            },
                                            {
                                                "example_id": "7d3f8b8c-0d0c-4b53-bae7-fc8c2cc35942",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "He put his fingers over his head like two antennas, crossed his eyes, and waggled his tongue like some kind of insect.\nIn the same work, Brown uses antennae to refer to both aerials and feelers during more technical descriptions."
                                            },
                                            {
                                                "example_id": "3406a603-a7db-4f1a-ad33-a3c8561b8cfe",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "The basis of these relationships lies in the olfactory chemoreceptors of insect antennas..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a69c3c-1432-3735-9d1a-55a779cf1ade",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "An apparatus to receive or transmit electromagnetic waves and convert respectively to or from an electrical signal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "The faculty of intuitive astuteness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de35c38f-01e6-4098-adb2-33d7ebb78e0b",
                                                "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                                "text": "Most nurses believe they are born with an antenna of sorts, which is able to guide them through clinical practice and help them determine what is right and what is not..."
                                            },
                                            {
                                                "example_id": "31dc1bf6-98bb-4b85-9284-756bb025e9ed",
                                                "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                                "text": "Obama is astute. He approaches things with the help of a sensitive antenna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beddd1c0-e94e-36a7-b466-a306bb4ca266",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "A fragment of an oligosaccharide"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e0ec5f5-bffa-356c-9218-521fa102e7b4",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "The spar to which a lateen sail is attached, which is then hoisted up the mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef47f18e-9efc-4116-91f9-ee6e85b75982",
                        "source_entry_id": "70e0e93a-2996-3b24-9e54-bb79fa4c969e",
                        "source_sense_id": "af57d26a-61b4-3165-8d81-fc2ba00ce008",
