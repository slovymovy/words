{
    "word_family": [
        "barkowy",
        "barkować"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "44d31251-42f4-312d-9d66-fd3445210949",
                    "sense_definition": "część ciała w miejscu połączenia ręki lub kończyny przedniej z tułowiem",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "anatomia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znów zwichnąłem sobie <w>bark</w>.",
                            "target_lang_translations": {
                                "ru": "Я снова вывихнул себе <w>плечо</w>."
                            }
                        },
                        {
                            "text": "Po ciężkiej pracy bolą mnie <w>barki</w>.",
                            "target_lang_translations": {
                                "ru": "После тяжелой работы у меня болят <w>плечи</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ramię"
                    ],
                    "common_phrases": [
                        "szerokie barki",
                        "zwichnięty bark"
                    ],
                    "target_lang_definitions": {
                        "ru": "часть тела в месте соединения руки с туловищем"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плечо",
                                "target_lang_sense_clarification": "анатомическая часть тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d642629e-87d1-3905-9cf6-baf82dd2e684",
                    "sense_definition": "element uprzęży konnej służący do połączenia orczyka z wozem",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas jazdy pękł <w>bark</w> przy wozie.",
                            "target_lang_translations": {
                                "ru": "Во время езды сломалась <w>вага</w> у повозки."
                            }
                        },
                        {
                            "text": "Stary rolnik naprawił zepsuty <w>bark</w> w swoim wozie.",
                            "target_lang_translations": {
                                "ru": "Старый фермер починил сломанную <w>вагу</w> в своей повозке."
                            }
                        }
                    ],
                    "synonyms": [
                        "orczyk"
                    ],
                    "target_lang_definitions": {
                        "ru": "деталь конской упряжи для соединения валька с повозкой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вага",
                                "target_lang_sense_clarification": "поперечный брус в упряжи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4968f997-9987-3380-ac37-7615667d10b4",
                    "sense_definition": "wygięty element konstrukcyjny w kształcie łuku",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Metalowy <w>bark</w> podtrzymuje całą konstrukcję dachu.",
                            "target_lang_translations": {
                                "ru": "Металлическая <w>дуга</w> поддерживает всю конструкцию крыши."
                            }
                        },
                        {
                            "text": "Architekt zaprojektował ozdobny <w>bark</w> nad wejściem.",
                            "target_lang_translations": {
                                "ru": "Архитектор спроектировал декоративную <w>арку</w> над входом."
                            }
                        }
                    ],
                    "synonyms": [
                        "pałąk",
                        "obłąk"
                    ],
                    "target_lang_definitions": {
                        "ru": "изогнутый конструктивный элемент в форме дуги"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дуга",
                                "target_lang_sense_clarification": "изогнутая деталь конструкции"
                            },
                            {
                                "target_lang_word": "арка",
                                "target_lang_sense_clarification": "дугообразный элемент"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2ac93a4d-670e-331b-b1c1-03560c98ec7d",
                    "sense_definition": "żaglowiec mający co najmniej trzy maszty, z których ostatni ma ożaglowanie skośne",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "żeglarstwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasza żaglówka jest bardzo mała przy tym <w>barku</w>.",
                            "target_lang_translations": {
                                "ru": "Наша парусная лодка очень мала по сравнению с этим <w>барком</w>."
                            }
                        },
                        {
                            "text": "W porcie zacumował wielki <w>bark</w> z pełnym ożaglowaniem.",
                            "target_lang_translations": {
                                "ru": "В порту пришвартовался большой <w>барк</w> с полным парусным вооружением."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "парусное судно с тремя и более мачтами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барк",
                                "target_lang_sense_clarification": "тип парусного судна"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}