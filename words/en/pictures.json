        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3b9f8d8-25af-3510-a25e-d05c1858ddc4",
                    "sense_definition": "Third-person singular simple present indicative of <w>picture</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>pictures</w> himself living in a big house by the ocean one day.",
                            "target_lang_translations": {
                                "ru": "Он <w>представляет</w>, как однажды будет жить в большом доме у океана.",
                                "zh": "他<w>想象</w>着自己有一天能住在海边的大房子里。"
                            }
                        },
                        {
                            "text": "The novel <w>pictures</w> life in the nineteenth century with remarkable accuracy.",
                            "target_lang_translations": {
                                "ru": "Этот роман <w>изображает</w> жизнь девятнадцатого века с удивительной точностью.",
                                "zh": "这部小说非常准确地<w>描绘</w>了十九世纪的生活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pictures himself",
                        "pictures it"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "third-person singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Третье лицо единственного числа настоящего времени глагола \"picture\" (представлять себе, изображать).",
                        "zh": "在脑海中想象，或在文学艺术作品中描绘。"
                    },
