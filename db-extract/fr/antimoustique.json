                    }
                ],
                "senses": [
                    {
                        "sense_id": "e43218c4-d657-3908-b6b3-fa480591314b",
                        "entry_id": "81a7737b-f23d-3a66-81f1-3d0d9712703b",
                        "glosses": [
                            "Contre les moustiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1509189c-f095-45cb-80b3-eb3098cc58c4",
                                "sense_id": "e43218c4-d657-3908-b6b3-fa480591314b",
                                "text": "Paradoxalement, le soleil brillait dimanche sur les zones inondées en Allemagne, obligeant les milliers de personnes affairées à remplir des sacs de sable à appliquer de la crème solaire et de la crème antimoustique."
                            },
                            {
                                "example_id": "6ae8f33f-f19d-4cba-86db-55c126daa8db",
                                "sense_id": "e43218c4-d657-3908-b6b3-fa480591314b",
                                "text": "Ana était chargée de disposer sous les tables des spirales d’encens antimoustiques. — (Gaël Faye, Petit Pays, Grasset, 2016, page 102)"
                            },
                            {
                                "example_id": "07803911-0973-44aa-8328-482d34b0a7cd",
                                "sense_id": "e43218c4-d657-3908-b6b3-fa480591314b",
                                "text": "Faites brûler une bougie, de l’encens ou un serpentin aux huiles essentielles antimoustique."
                            },
                            {
                                "example_id": "764c6f85-ea1d-455b-92f4-d020aea983ea",
                                "sense_id": "e43218c4-d657-3908-b6b3-fa480591314b",
                                "text": "Comment raconter les crises ? Comment dire l’effondrement d’un pays et de sa capitale ? En écrivant un livre d’histoires. […]. Pour dire le manque d’électricité, raconter cette soudaine pénurie de gidouilles antimoustiques dans les magasins."
                            }
                        ]
                    }
                ],
