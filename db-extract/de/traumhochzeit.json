                "senses": [
                    {
                        "sense_id": "af76c879-e3aa-3722-b1a2-6ebcf052e539",
                        "entry_id": "67679bc5-a1da-35fe-b1ba-12849c5c420f",
                        "glosses": [
                            "zauberhaft schöne, romantische Hochzeitsfeier, so wie man sie sich in seinen Träumen ausmalt"
                        ],
                        "tags": [
                            "emotional"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff28062-ea20-4311-88ac-43b15a3eed2d",
                                "sense_id": "af76c879-e3aa-3722-b1a2-6ebcf052e539",
                                "text": "„Die Traumhochzeit des kommenden Jahres steigt passenderweise im Wonnemonat: Prinz Harry und Meghan Markle werden im Mai 2018 in der St.-George’s-Kapelle auf Schloss Windsor heiraten.“"
                            },
                            {
                                "example_id": "4b4e26d5-d6a2-4288-ae93-2fd0832c4335",
                                "sense_id": "af76c879-e3aa-3722-b1a2-6ebcf052e539",
                                "text": "„Nach Traumhochzeit in Venedig und dem gemeinsamen Umzug nach Amerika haben die beiden nun ihr erstes Baby bekommen.“"
                            },
                            {
                                "example_id": "a812668c-0081-4d6e-aceb-d51988626f18",
                                "sense_id": "af76c879-e3aa-3722-b1a2-6ebcf052e539",
                                "text": "„Die PR-Leute am Hof wissen sehr genau: Nichts ist so gut fürs Image des Königshauses wie Kinder und Traumhochzeiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
