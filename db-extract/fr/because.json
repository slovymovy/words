                        "examples": [
                            {
                                "example_id": "0663f5e3-1ca8-44e1-a2a9-86582aaf09bd",
                                "sense_id": "c1ddfe72-3987-37aa-b611-e33ad444067f",
                                "text": "La fenêtre était ouverte because la chaleur aoûtienne, si moite.",
                                "translation": "The window was open because of the muggy August heat.",
                                "english": "The window was open because of the muggy August heat."
                            },
                            {
                                "example_id": "59a65589-5e7b-47ff-87be-7493e419dede",
                                "sense_id": "c1ddfe72-3987-37aa-b611-e33ad444067f",
                                "text": "\"Enfin, juste comme Mariette commence à redevenir un peu nerveuse, because ce poireautage mortel, l’inspecteur Fabre, qui guettait peut-être ce moment, s’amène et lui fait signe de le suivre.\"",
                                "translation": "‘Finally, just as Mariette starts to rebecome a little nervous because of this deadly wait, interpsector Fabre, who was maybe watching at that moment, comes along and gives her hope for survival.’",
                                "english": "‘Finally, just as Mariette starts to rebecome a little nervous because of this deadly wait, interpsector Fabre, who was maybe watching at that moment, comes along and gives her hope for survival.’"
                            },
                            {
                                "example_id": "21055389-76aa-47d6-997f-567c21557aa7",
                                "sense_id": "c1ddfe72-3987-37aa-b611-e33ad444067f",
                                "text": "Après un séjour à New York, qui lui a fait le plus grand bien, Helen se rend compte que la vie parisienne lui convient tout de même mieux, du fait de ses problèmes de santé — poids, hypertension… « En somme, quelle que soit l’alternative que je choisis, je suis désormais condamnée à la nostalgie permanente, vivace et stimulée à New York, mais because hypertension, la détente à Paris est peut-être préférable¹⁴. »",
                                "translation": "After a trip to New York, which did the greatest good for her, Helen realises that Parisian life suits her better anyway due to her health problems: weight, hypertension… ‘In sum, whatever the alternative that I choose, I am henceforth condemned to permanent nostalgia, vivacious and stimulated at New York, but because of hypertension, maybe relaxing in Paris is preferable.’",
                                "english": "After a trip to New York, which did the greatest good for her, Helen realises that Parisian life suits her better anyway due to her health problems: weight, hypertension… ‘In sum, whatever the alternative that I choose, I am henceforth condemned to permanent nostalgia, vivacious and stimulated at New York, but because of hypertension, maybe relaxing in Paris is preferable.’"
                            }
                        ]
