                                        ]
                                    },
                                    {
                                        "sense_id": "7aa4cf19-c195-3419-832a-d63475b99119",
                                        "entry_id": "613c6937-88eb-3b16-83fd-7eb2f7c35a87",
                                        "glosses": [
