                        ],
                        "examples": [
                            {
                                "example_id": "da264c09-2a32-4427-8660-7beb900b315b",
                                "sense_id": "6ad7741e-b985-392e-a65d-7db4cd7dcb8e",
                                "text": "The expression “Allon” indicates the unique character of this relationship: that of being together in contraposition. I belong to the Allon, and yet detach myself from it."
                            }
                        ]
