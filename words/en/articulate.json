{
    "word_family": [
        "articulation",
        "articulatory",
        "articulable",
        "disarticulate",
        "inarticulate",
        "multi-articulated"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aa4a145c-2e18-3a3c-a940-b1d407781735",
                    "sense_definition": "To pronounce words clearly and distinctly so that they are easily understood.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher asked the student to <w>articulate</w> each syllable of the new vocabulary word.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил ученика четко <w>выговорить</w> каждый слог нового слова.",
                                "zh": "老师要求学生<w>清晰发音</w>新单词的每一个音节。"
                            }
                        },
                        {
                            "text": "It is important to <w>articulate</w> clearly when you are giving a speech to a large audience.",
                            "target_lang_translations": {
                                "ru": "Важно <w>артикулировать</w> четко, когда вы выступаете с речью перед большой аудиторией.",
                                "zh": "在面对大量听众演讲时，<w>吐字清晰</w>非常重要。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "articulate clearly",
                        "articulate every word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произносить слова четко и отчетливо, чтобы они были легко понятны.",
                        "zh": "清晰且准确地发音，以便他人容易理解。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выговаривать",
                                "target_lang_sense_clarification": "четко произносить звуки"
                            },
                            {
                                "target_lang_word": "артикулировать",
                                "target_lang_sense_clarification": "работать органами речи для четкости"
                            },
                            {
                                "target_lang_word": "произносить",
                                "target_lang_sense_clarification": "отчетливо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清晰发音",
                                "target_lang_sense_clarification": "清楚地读出每一个音节"
                            },
                            {
                                "target_lang_word": "吐字清晰",
                                "target_lang_sense_clarification": "说话发音准确"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84da74dd-d521-3b12-b9da-54661c978c9e",
                    "sense_definition": "To express an idea, feeling, or thought in words in a clear and effective way.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She found it difficult to <w>articulate</w> her feelings about the sudden change in plans.",
                            "target_lang_translations": {
                                "ru": "Ей было трудно <w>выразить</w> свои чувства по поводу внезапного изменения планов.",
                                "zh": "她发现很难<w>表达</w>自己对计划突然改变的感受。"
                            }
                        },
                        {
                            "text": "The manager was able to <w>articulate</w> a vision that inspired the entire team.",
                            "target_lang_translations": {
                                "ru": "Менеджер смог <w>сформулировать</w> видение, которое вдохновило всю команду.",
                                "zh": "经理能够<w>阐述</w>一个激励了整个团队的愿景。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "articulate a vision",
                        "articulate thoughts",
                        "articulate feelings"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ясно и эффективно выражать идеи, чувства или мысли словами.",
                        "zh": "用言语清晰且有效地表达思想、感受或观点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формулировать",
                                "target_lang_sense_clarification": "облекать мысли в слова"
                            },
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "последовательно выражать идеи"
                            },
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "передавать чувства или мысли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表达",
                                "target_lang_sense_clarification": "将想法或情感说出来"
                            },
                            {
                                "target_lang_word": "阐述",
                                "target_lang_sense_clarification": "详细且清晰地说明观点"
                            },
                            {
                                "target_lang_word": "明确表达",
                                "target_lang_sense_clarification": "清晰地陈述想法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f390aa0d-9c24-3d4c-b521-a3b82975f518",
                    "sense_definition": "To form a joint or to be connected by a joint, especially in anatomy or mechanics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The humerus <w>articulates</w> with the scapula to form the shoulder joint.",
                            "target_lang_translations": {
                                "ru": "Плечевая кость <w>сочленяется</w> с лопаткой, образуя плечевой сустав.",
                                "zh": "肱骨与肩胛骨<w>连接</w>形成肩关节。"
                            }
                        },
                        {
                            "text": "The robotic arm is designed to <w>articulate</w> at three different points for maximum range.",
                            "target_lang_translations": {
                                "ru": "Роботизированная рука спроектирована так, чтобы <w>сгибаться</w> в трех различных точках для максимального охвата.",
                                "zh": "机械臂设计在三个不同点<w>铰接</w>，以实现最大活动范围。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "articulate with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать сустав или соединяться с помощью сустава (в анатомии или механике).",
                        "zh": "指骨骼或机械部件通过关节连接在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочленяться",
                                "target_lang_sense_clarification": "соединяться подвижно"
                            },
                            {
                                "target_lang_word": "соединяться",
                                "target_lang_sense_clarification": "образовывать сустав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连接",
                                "target_lang_sense_clarification": "通过关节相连"
                            },
                            {
                                "target_lang_word": "铰接",
                                "target_lang_sense_clarification": "机械结构上的连接"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c916c3ef-2b6d-38c3-99bd-237e5af591cc",
                    "sense_definition": "Able to express thoughts and feelings easily and clearly in speech or writing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate was highly <w>articulate</w> and answered every question with great confidence.",
                            "target_lang_translations": {
                                "ru": "Кандидат был очень <w>красноречив</w> и отвечал на каждый вопрос с большой уверенностью.",
                                "zh": "这位候选人非常<w>口齿伶俐</w>，自信地回答了每一个问题。"
                            }
                        },
                        {
                            "text": "She is an <w>articulate</w> speaker who can explain complex topics in simple terms.",
                            "target_lang_translations": {
                                "ru": "Она — <w>умеющий четко излагать свои мысли</w> оратор, который может объяснить сложные темы простыми словами.",
                                "zh": "她是一位<w>善于表达</w>的演讲者，能用简单的语言解释复杂的主题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "eloquent",
                        "well-spoken"
                    ],
                    "antonyms": [
                        "inarticulate"
                    ],
                    "common_phrases": [
                        "articulate speaker",
                        "highly articulate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный легко и ясно выражать свои мысли и чувства в речи или письме.",
                        "zh": "指人能够轻松、清晰地表达思想和情感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красноречивый",
                                "target_lang_sense_clarification": "умеющий хорошо говорить"
                            },
                            {
                                "target_lang_word": "умеющий четко излагать свои мысли",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "членораздельный",
                                "target_lang_sense_clarification": "о ясной речи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "口齿伶俐",
                                "target_lang_sense_clarification": "说话清晰，善于表达"
                            },
                            {
                                "target_lang_word": "善于表达",
                                "target_lang_sense_clarification": "能够清楚地陈述观点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f098f72-3b5f-36ef-a93e-9f9f80945a9c",
                    "sense_definition": "Having joints or segments that are connected together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum displayed several <w>articulate</w> skeletons of prehistoric creatures.",
                            "target_lang_translations": {
                                "ru": "В музее было выставлено несколько <w>сочлененных</w> скелетов доисторических существ.",
                                "zh": "博物馆展出了几具史前生物的<w>有关节的</w>骨架。"
                            }
                        },
                        {
                            "text": "Insects are <w>articulate</w> animals with bodies divided into distinct segments.",
                            "target_lang_translations": {
                                "ru": "Насекомые — это <w>суставчатые</w> животные, тела которых разделены на отчетливые сегменты.",
                                "zh": "昆虫是身体分为不同节段的<w>分节</w>动物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "articulate limbs"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий суставы или сегменты, соединенные между собой.",
                        "zh": "指具有相互连接的关节或分节的结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочлененный",
                                "target_lang_sense_clarification": "состоящий из звеньев"
                            },
                            {
                                "target_lang_word": "суставчатый",
                                "target_lang_sense_clarification": "имеющий суставы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有关节的",
                                "target_lang_sense_clarification": "具有连接结构"
                            },
                            {
                                "target_lang_word": "分节的",
                                "target_lang_sense_clarification": "身体由多个部分组成"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15f998a9-75e7-3ffa-90c1-371b987ece04",
                    "sense_definition": "An animal belonging to the Articulata, characterized by having segmented bodies and jointed limbs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researcher specialized in the study of marine <w>articulates</w> from the Paleozoic era.",
                            "target_lang_translations": {
                                "ru": "Исследователь специализировался на изучении морских <w>членистых</w> палеозойской эры.",
                                "zh": "这位研究员专门研究古生代的海洋<w>节肢动物</w>。"
                            }
                        },
                        {
                            "text": "Early biologists grouped various segmented creatures under the general category of <w>articulates</w>.",
                            "target_lang_translations": {
                                "ru": "Ранние биологи объединяли различных сегментированных существ в общую категорию <w>членистых</w>.",
                                "zh": "早期的生物学家将各种分节生物归类为<w>节肢动物</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Животное, относящееся к типу членистых, характеризующееся сегментированным телом и суставчатыми конечностями.",
                        "zh": "属于节肢动物门，具有分节身体和有关节肢体的动物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "членистое",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "节肢动物",
                                "target_lang_sense_clarification": "生物学分类"
                            }
                        ]
                    }
                }
            ]
        }
    ]
