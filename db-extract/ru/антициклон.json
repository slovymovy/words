                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa85b00d-ff17-4aa4-8697-9ad626133961",
                                                "sense_id": "736a0515-0750-38f7-86d0-e123563e0781",
                                                "text": "Das Hoch bescherte uns endlich schönes Wetter."
