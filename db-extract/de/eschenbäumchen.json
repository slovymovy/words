                ],
                "senses": [
                    {
                        "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                        "entry_id": "d4c1e1e2-5401-358d-9573-cac33fccd1d0",
                        "glosses": [
                            "kleiner Eschenbaum"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad9821bb-20a0-4552-a96f-f70bae2eaf00",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„Er reißt bei Westried ein völlig vertrocknetes Eschenbäumchen aus dem Boden, um die verheerende Wirkung des Schädlings zu zeigen.“"
                            },
                            {
                                "example_id": "bf25fd5f-b9a8-4e54-8d04-74414317afc2",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„André schaute sich um und entdeckte einen Sperling im Eschenbäumchen.“"
                            },
                            {
                                "example_id": "83d81bb9-20dc-48dc-bb9f-e2aea1e09f73",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„In das Strohdach hatten sich mit der Zeit allerhand Dinge eingenistet, welche von rechtswegen nicht dahin gehören, man sah dort nicht nur ein Eschenbäumchen, nein, zur Sommerzeit auch ein Büschel Aehren blühen, die Saamenkörner hatten freundliche Winde auf ihre Flügel genommen und dahin getragen.“"
                            },
                            {
                                "example_id": "a8ad2d04-f674-49dd-80ab-80eb13a11535",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„Rings um den ursprünglich schon mit Sand belegten halbrunden Platz C zog ich den Halbkreis D und bepflanzte ihn dicht mit Haselnußstauden und Pappeln, welche auf beiden Seiten mit Eschenbäumchen eingefaßt wurden.“"
                            },
                            {
                                "example_id": "141c2c9f-6274-4b2d-9d23-c50503ec3a5f",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„Auch die Koblenzer Straße bis zum Eschenbäumchen wird, wenn das Wetter gut und die Hitze noch erträglich ist, von Spazierenden belebt.“"
                            },
                            {
                                "example_id": "4ec4545e-7ec0-47f1-b494-4b9aa3f516c2",
                                "sense_id": "aa824632-cabb-3cce-9743-0a467f84ed7c",
                                "text": "„Die 30 Jahre sind die Zeit, welche die Wurzeln des Eschenbäumchens brauchten, um durch den hohlen mit Holzmüll gefüllten Lindenstamm in den fruchtbaren Erdboden zu gelangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
