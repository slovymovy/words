                    {
                        "sense_id": "67f92bce-6a7f-35eb-b72d-f68acd2edf14",
                        "entry_id": "1fb01f4b-9293-3677-bb50-9e0ce5d4fcc5",
                        "glosses": [
                            "Bateau de plaisance ou de pêche pourvu d’une cabine (ou éventuellement d’un autre type d’abri)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4424a34f-417f-47a4-acec-8bd57e255b88",
                                "sense_id": "67f92bce-6a7f-35eb-b72d-f68acd2edf14",
                                "text": "L’appellation cabinier regroupe à la fois des bateaux de type day-cruiser dotés d'une grande cabine offrant une belle hauteur sous barrot et les sundeck pourvus d’une grande plateforme surélevée à l’avant qui peut faire office de poste de lancer."
                            },
                            {
                                "example_id": "2b2af2d8-4d37-431a-8cc4-3cc86c9e094e",
                                "sense_id": "67f92bce-6a7f-35eb-b72d-f68acd2edf14",
                                "text": "En plus d’un nouveau design, ce cabinier élargit son programme de pêche au cabotage en couple. Son habitacle abrite un couchage double, et le carré peut se transformer en une couchette simple."
                            }
                        ]
                    }
                ],
