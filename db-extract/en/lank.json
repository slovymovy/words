                                            {
                                                "example_id": "eb832976-d6f4-49a1-82c3-2d4d3b67c45d",
                                                "sense_id": "6436b780-36cc-3e34-98d8-31c54404b764",
                                                "text": "Můj otec byl dlouho nemocný a málo jedl, proto je teď konečně hubený!"
                                            },
                                            {
                                                "example_id": "37e4873d-bf55-48f9-a9e2-5dbc4e67de58",
                                                "sense_id": "6436b780-36cc-3e34-98d8-31c54404b764",
                                                "text": "Tetička byla vždycky dost při těle a ohledně hubnutí a diet měla takovou průpovídku: „Až bude válka, tak my tlustý budem hubený a hubený budou studený“."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f8d282f-ca7b-3ed3-b192-41222dde37a7",
                                        "entry_id": "3d9e26bb-fe74-3291-90dc-bef0e827db1d",
                                        "glosses": [
                                            "přinášející málo prospěchu"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
