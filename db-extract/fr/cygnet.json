                    {
                        "sense_id": "2dfdb2c8-75e1-3650-aca1-2042c622cbb7",
                        "entry_id": "0696cf26-7092-3636-8208-1cb21c85644e",
                        "glosses": [
                            "Jeune cygne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "178e5515-34df-4a5f-bf1e-1cad043177cf",
                                "sense_id": "2dfdb2c8-75e1-3650-aca1-2042c622cbb7",
                                "text": "Les cygnets sont marqués annuellement par les gardiens, de la même manière que jadis."
                            },
                            {
                                "example_id": "86fcf0a4-a555-4335-b9cf-12a772d51b77",
                                "sense_id": "2dfdb2c8-75e1-3650-aca1-2042c622cbb7",
                                "text": "Dans cent ans d’ici, il viendra un cygnet qui vous chantera un autre chant ; et ce cygne, vous ne pourrez le brûler."
                            },
                            {
                                "example_id": "c4dec114-2b44-4a77-be55-b39c4bd1b4da",
                                "sense_id": "2dfdb2c8-75e1-3650-aca1-2042c622cbb7",
                                "text": "Un cygnet d’un an n’a que le tiers de la grosseur d’un adulte, et il n’est propre à la reproduction qu’à la fin de sa troisième année."
                            }
                        ]
                    }
                ],
