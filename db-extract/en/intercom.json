                    },
                    {
                        "translation_id": "895a0502-00ac-41fc-ac9f-5b01c25e720b",
                        "source_entry_id": "300f61cd-48db-3382-83ea-c73f3124c43a",
                        "source_sense_id": "8de26d7f-8fde-31fa-9fb5-a1d10a163be0",
                        "source_sense_description": "an electronic communication system",
                        "target_lang_word": "parlophone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parlophone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                        "entry_id": "1a44ab6e-68d3-3b2b-a7eb-bca6942ec084",
                                        "glosses": [
                                            "Dispositif acoustique électronique interne à un immeuble, placé à l’entrée et dans une ou plusieurs pièces de celui-ci, afin d’en contrôler l’accès à l’aide d’un ouvre-porte."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266356bc-ecd1-4564-b918-d0f3857a614a",
                                                "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                                "text": "Commençons par boucher ce parlophone au moyen de mon mouchoir..."
                                            },
                                            {
                                                "example_id": "09fc3622-1971-4675-865f-6e52e8d32090",
                                                "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                                "text": "Cet appareil permet, d’ouvrir la porte de l’immeuble. Il est généralement combiné avec un parlophone pour se rendre compte, préalablement, de l’identité du visiteur."
                                            },
                                            {
                                                "example_id": "c490926a-7a2d-42db-b50a-8f6a4a6a244c",
                                                "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                                "text": "Le parlophone crachote la voix de Li. Elle est en bas."
                                            },
                                            {
                                                "example_id": "d302ed77-545f-4aea-9ab6-34583d0a8b32",
                                                "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                                "text": "Le système de parlophone de l’immeuble de bureaux crachote des informations inaudibles ; les portes vitrées sont fermées quand on les croit ouvertes."
                                            },
                                            {
                                                "example_id": "a46c2b75-33e4-4446-a68b-f50cc5dd2eec",
                                                "sense_id": "3799716c-f087-3577-b92b-56d0feb12ed2",
                                                "text": "Une petite voix tremblante émit un léger «oui ?» dans le chuintement du parlophone. «C’est moi», dit-il simplement. «Montez, c’est au quatrième», répondit Marielle presque machinalement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be894e1-7b14-4e77-9cce-b797f06996cf",
                        "source_entry_id": "300f61cd-48db-3382-83ea-c73f3124c43a",
                        "source_sense_id": "8de26d7f-8fde-31fa-9fb5-a1d10a163be0",
                        "source_sense_description": "an electronic communication system",
                        "target_lang_word": "Gegensprechanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gegensprechanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d86af88c-fd79-3ea5-99e6-6afd006e3c4b",
                                        "entry_id": "5edb343d-0ba1-31d6-8285-a510bf9b27dc",
                                        "glosses": [
                                            "technische kabelgebundene Einrichtung, die gleichzeitiges Sprechen zwischen zwei oder mehreren Endstellen ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cae269e-372b-4bfe-92a2-81057bc4db74",
                                                "sense_id": "d86af88c-fd79-3ea5-99e6-6afd006e3c4b",
                                                "text": "„Die äußere Haustür kann über die Gegensprechanlage von jeder einzelnen Wohnung aus geöffnet werden.“"
                                            },
                                            {
                                                "example_id": "ba38aee6-deb5-42be-80da-73b1275848a2",
                                                "sense_id": "d86af88c-fd79-3ea5-99e6-6afd006e3c4b",
                                                "text": "„Wer denkt schon daran, dass eine Gegensprechanlage für einen Gehörlosen ein fast unüberwindbares Hindernis ist?“"
                                            },
                                            {
                                                "example_id": "302fb961-0675-4880-b798-5dad07cc7337",
                                                "sense_id": "d86af88c-fd79-3ea5-99e6-6afd006e3c4b",
                                                "text": "„An einem Schreibtisch saß eine Frau mit Kopftuch, die ihr Kommen über eine Gegensprechanlage weitermeldete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c857f4c6-6bf2-4ddc-a1d7-fa188fbeaafe",
                        "source_entry_id": "300f61cd-48db-3382-83ea-c73f3124c43a",
                        "source_sense_id": "8de26d7f-8fde-31fa-9fb5-a1d10a163be0",
                        "source_sense_description": "an electronic communication system",
                        "target_lang_word": "Sprechanlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sprechanlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                        "entry_id": "b4873ba0-71c3-32f3-8fc0-629a221d68f8",
                                        "glosses": [
                                            "elektrische Installation, die eine Sprechverbindung zwischen Innenräumen und Außentür des Hauses oder zwischen verschiedenen Räumen innerhalb einer Wohnung/eines Büros ermöglicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6494ea65-8511-4def-a3af-880bc273c2f8",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Für die damalige Zeit sei es eine sehr moderne und gut ausgestattete Wohnung gewesen, mit einer Sprechanlage und mit einem Müllschlucker.“"
                                            },
                                            {
                                                "example_id": "b3a86b72-1fec-492b-b8bf-a60b231ee7f2",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Die Stimme, die aus der Sprechanlage kam, klang reizend, wenn auch mit einem Unterton von Härte.“"
                                            },
                                            {
                                                "example_id": "453a9a8e-49c1-455a-a40b-94d1aac75a84",
                                                "sense_id": "fec06c44-8548-3073-bb99-bbbafe9c3b36",
                                                "text": "„Durch die Sprechanlage höre ich ein Auto vorbeifahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
