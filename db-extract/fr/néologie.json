                    {
                        "sense_id": "404f095d-bace-3294-8267-d90a85756ed9",
                        "entry_id": "4bcf09c3-2154-3504-ad9e-1a92031b41cb",
                        "glosses": [
                            "Création de mots nouveaux et introduction de ceux-ci dans une langue donnée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7091f1-df30-4d1d-9d47-d6479416baa6",
                                "sense_id": "404f095d-bace-3294-8267-d90a85756ed9",
                                "text": "Elle était atteinte d’une inflammation assez ordinairement mortelle, que les femmes se confient à l’oreille, et à laquelle notre néologie n’a pas encore su trouver de nom."
                            },
                            {
                                "example_id": "85f47129-3e34-4679-b275-cdff65a1f127",
                                "sense_id": "404f095d-bace-3294-8267-d90a85756ed9",
                                "text": "Les points de vue sur la néologie restent très tranchés après la création de l'Académie française […]."
                            }
                        ]
