                    {
                        "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                        "entry_id": "c41e3ac4-219c-3bf8-88b5-f54dfc94b158",
                        "glosses": [
                            "Moelleux en parlant du pain."
                        ],
                        "tags": [
                            "Sud-Ouest",
                            "Limousin"
                        ],
                        "examples": [
                            {
                                "example_id": "a12742bc-e422-4938-b0c6-d1aee524bf15",
                                "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                                "text": "En parlant du pain , moufle signifie tendre."
                            },
                            {
                                "example_id": "346a8297-1827-40ad-9d3b-a89ac75173ff",
                                "sense_id": "b9dc3080-a980-3174-b451-9263eea47407",
                                "text": "L'un aime mieux un pain “moufle”. Ou bien il préfère peut-être un pain à croûte très dure ; dans ce cas il lui faut un \"pistolet\" ou un \"bton\"."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
