                        "glosses": [
                            "Haute société (d’un pays anglophone)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83eccade-2a12-4904-903c-7c64a3f2238f",
                                "sense_id": "363b5080-313f-31aa-8ccd-3a4eaddf118a",
                                "text": "Non seulement, vous arrivez à Vienne avec un pantin de la « high-society » mais encore au lieu de l’obliger à se tenir tranquille, vous l’emmenez partout avec vous, vous lui confiez nos histoires !"
                            },
                            {
                                "example_id": "1cea01bc-c1fe-4a2e-af35-16ee04bf0578",
                                "sense_id": "363b5080-313f-31aa-8ccd-3a4eaddf118a",
                                "text": "Paul, en fait, faisait partie de la high-society new-yorkaise."
                            },
                            {
                                "example_id": "c73474c9-5199-4aba-b490-06f56ae4955f",
                                "sense_id": "363b5080-313f-31aa-8ccd-3a4eaddf118a",
                                "text": "Julien de Chalençon offrait à peu près tous les dehors du parfait gentleman, et s’il l’avait désiré ardemment, il aurait pu faire un mariage excellent avec n’importe quelle des plus jolies demoiselles de la high-society."
                            }
                        ]
                    }
