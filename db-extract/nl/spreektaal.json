                    {
                        "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                        "entry_id": "cbb41739-c5ca-310b-ba7c-b1aa805ca5dc",
                        "glosses": [
                            "vernacular (everyday/colloquial speech), spoken language, everyday language"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "54bc07be-f24b-4378-86e1-6dae5326dfb7",
                                "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                                "text": "In deze regio wordt een specifieke spreektaal gebruikt die afwijkt van de standaardtaal.",
                                "translation": "In this region, a specific vernacular is used that differs from the standard language.",
                                "english": "In this region, a specific vernacular is used that differs from the standard language."
                            },
                            {
                                "example_id": "d556277f-0101-46bd-8523-6f1dec811b90",
                                "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                                "text": "De docent moedigt de studenten aan om ook buiten de les de spreektaal te oefenen.",
                                "translation": "The teacher encourages the students to practice the spoken language outside of class as well.",
                                "english": "The teacher encourages the students to practice the spoken language outside of class as well."
                            },
                            {
                                "example_id": "c4dec8da-d824-4619-8a7b-3fb21c15e586",
                                "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                                "text": "Het is belangrijk om de spreektaal te leren naast de geschreven taal.",
                                "translation": "It is important to learn the everyday language alongside the written language.",
                                "english": "It is important to learn the everyday language alongside the written language."
                            },
                            {
                                "example_id": "91cf603d-e304-460b-be6b-38f087874bcc",
                                "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                                "text": "In informele gesprekken gebruiken mensen vaak meer spreektaal dan in formele situaties.",
                                "translation": "In informal conversations, people often use more colloquial speech than in formal situations.",
                                "english": "In informal conversations, people often use more colloquial speech than in formal situations."
                            },
                            {
                                "example_id": "7d549f5c-f0eb-430e-809f-b58f2e00af19",
                                "sense_id": "d6936067-fe9e-30ce-a77f-2a496e09df58",
                                "text": "Het begrijpen van de lokale spreektaal kan helpen bij het integreren in een nieuwe gemeenschap.",
                                "translation": "Understanding the local vernacular can help with integrating into a new community.",
                                "english": "Understanding the local vernacular can help with integrating into a new community."
                            }
                        ]
                    }
                ],
