                                    {
                                        "sense_id": "84f6faef-4f89-3084-97e6-3be2ef5df427",
                                        "entry_id": "17047f77-6c5c-3fe0-8359-17274406f39b",
                                        "glosses": [
                                            "Qui est à la retraite ; qui touche une pension de retraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43afa686-6479-4f82-b63d-3d188436a357",
                                                "sense_id": "84f6faef-4f89-3084-97e6-3be2ef5df427",
                                                "text": "Quelque 11 800 personnes, récemment retraitées du NHS (infirmières, médecins, aides-soignants), ont­ ­accepté de reprendre du service pour compenser les personnels absents,en isolation ou malades."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retraité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                        "entry_id": "cc3b0e6f-e546-3c24-8a3d-8387da4ad1f7",
                                        "glosses": [
                                            "Personne à la retraite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4b2a64-e75e-4d00-a9dc-20e062696ce2",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "— J'en pense qu'une fille qui habite Le Faouët peut très bien faire ses courses à Gourin, si elle travaille quelque part entre les deux communes, voire même à Gourin, répliqua le retraité de sa grosse voix, en grattant sa barbe poivre et sel."
                                            },
                                            {
                                                "example_id": "ec8b9699-495a-4cf7-b3ef-14417b6f0d05",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "Un adolescent marche dans la rue\nDernier résistant d’une époque révolue\nCar l’arrondissement vieux de 35 ans\nEst maintenant peuplé de gentils retraités."
                                            },
                                            {
                                                "example_id": "6adbcd76-f519-48b2-a8c0-28d733ab4173",
                                                "sense_id": "1b48b856-10a2-3ae9-82bb-f562bee972df",
                                                "text": "Son auteur, James Mazeaud, est un retraité de 88 ans, installé à L’Isle d’Espagnac."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "retraité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd55cfd7-397f-3710-94fb-836118e79c10",
                                        "entry_id": "7a22f81e-e40f-3dde-a140-f504fa0c7bb1",
                                        "glosses": [
                                            "Participe passé masculin singulier de retraiter."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b104e7c8-2182-4667-80f2-f3dfb769ffb3",
                                                "sense_id": "fd55cfd7-397f-3710-94fb-836118e79c10",
                                                "text": "Ils m’ont désexpatrié et retraité, après tout je ne suis qu’un paramètre d’ajustement, non ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d03690c-3498-4e9d-8397-205e09277902",
                        "source_entry_id": "dbe9dbc0-8a7a-330f-af3c-920c7444f0e9",
                        "source_sense_id": "7aab40e9-ab08-38f4-b14d-30a13be9661b",
                        "source_sense_description": "someone who has retired from active working",
                        "target_lang_word": "Rentner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rentner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                        "entry_id": "4993cdc1-0561-34cc-9e83-a8bed73eafcb",
                                        "glosses": [
                                            "Person, die nicht mehr überwiegend erwerbstätig ist und ihren Lebensunterhalt aus einer Rente, also einer gesetzlichen oder privaten Versicherungsleistung, bestreitet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5d363f-d7bf-4624-962f-add91258470a",
                                                "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                                "text": "\"Als Rentner habe ich nun noch weniger Zeit!\", sagte mein Opa immer."
                                            },
                                            {
                                                "example_id": "3eba1339-4e2a-49b9-bb4e-5b2611df9bc7",
                                                "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                                "text": "„Es ist nicht leicht, eine Gruppe deutscher Rentner zufriedenzustellen, doch es ist überraschend aufregend, mit ihnen zu reisen.“"
                                            },
                                            {
                                                "example_id": "10a62c9f-91c7-4e7e-90b0-6427bcd4aa52",
                                                "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                                "text": "„Ich bin nun allein auf diesem Boot, allein auf einer Kreuzfahrt, allein zwischen Rentnern und Pensionären.“"
                                            },
                                            {
                                                "example_id": "93d1ff20-a479-4a84-86b1-5b6a419a8ddd",
                                                "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                                "text": "„Jetzt war er Rentner und suchte, sich im Haus nützlich zu machen.“"
                                            },
                                            {
                                                "example_id": "0d6e11a7-9d1d-4807-ab5d-6b1c4e8a2bff",
                                                "sense_id": "11e29efa-1b46-3a15-95c4-e0b3ae5eeea6",
                                                "text": "„Sicher will man mit den frei werdenden Mitteln notleidenden Rentnern eine Freude machen oder die Eintrittspreise ermäßigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "021f7664-04dd-464d-affd-58dffcef5585",
                        "source_entry_id": "dbe9dbc0-8a7a-330f-af3c-920c7444f0e9",
