                "senses": [
                    {
                        "sense_id": "5bc29d84-4c9d-3d0d-a45c-738a737ddcc2",
                        "entry_id": "6c16076a-fac5-3d3f-8638-9cecc0b56a95",
                        "glosses": [
                            "Relatif à des composés à quatre atomes de carbone hydrogénés, comme les alcools butyliques, les aldéhydes butyliques."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "fa063ae2-a489-4a2a-bae6-fe781791ac30",
                                "sense_id": "5bc29d84-4c9d-3d0d-a45c-738a737ddcc2",
                                "text": "Si on veut avoir surtout de l’alcool butylique, on fera fermenter de la pomme de terre en fragments."
                            },
                            {
                                "example_id": "b4da3ab4-b8e6-419b-acc7-4363a6327cf1",
                                "sense_id": "5bc29d84-4c9d-3d0d-a45c-738a737ddcc2",
                                "text": "La masse pâteuse ainsi obtenue est ensuite mélangée avec de l’alcool éthylique, méthylique, butylique, amylique, de l’ammoniaque, de la soude caustique, de la potasse, du borax, des carbonates alcalins… — n’en jetez plus ! —, pour en faire une chouette gomme d’enrobage, de couleur orangée ou blond doré."
                            }
                        ]
                    }
                ],
