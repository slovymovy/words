                "translations": [
                    {
                        "translation_id": "67d4c2d3-f293-4fd9-8890-e4b151b3b3bf",
                        "source_entry_id": "b2d74b66-c1e1-3887-8133-0dfd8a7911d8",
                        "source_sense_id": "77769abe-effe-32af-a435-6d7133da9c21",
                        "target_lang_word": "Marktwirtschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marktwirtschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                        "entry_id": "abcdbb06-da1e-3462-8982-72d382bff29e",
                                        "glosses": [
                                            "eine Wirtschaftsordnung, in der Produktion und Verteilung der Güter und Dienstleistungen über Angebot und Nachfrage geregelt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e47eade7-ecf8-4773-9d99-2ce73d13bf24",
                                                "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                                "text": "Der Vorsitzende der Gewerkschaft ver.di, Frank Bsirske, hat als Konsequenz aus der Wirtschaftskrise eine neue Form der Marktwirtschaft gefordert."
                                            },
                                            {
                                                "example_id": "f13a578a-b847-4940-abab-d0d2be4c5728",
                                                "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                                "text": "„Das nennt man Wettbewerbsvorteil und ist ein Instrument der freien Marktwirtschaft, über das sich streiten lässt.“"
                                            },
                                            {
                                                "example_id": "26f21a68-b604-4b23-8b3a-91881f7b4165",
                                                "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                                "text": "„In einer Marktwirtschaft ist niemand und nichts so mächtig wie das Portemonnaie des Verbrauchers.“"
                                            },
                                            {
                                                "example_id": "16f0f5b6-a9ab-413f-886b-22efb8591249",
                                                "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                                "text": "Uns fehlen Pflegekräfte. Uns fehlen viele Pflegekräfte. Uns werden in Zukunft noch mehr fehlen. Das liegt auch an der niedrigen Bezahlung. Nach den Gesetzen von Angebot und Nachfrage, der Marktwirtschaft, müssten deren Löhne unmittelbar steigen. Aber seit Jahren Fehlanzeige!"
                                            },
                                            {
                                                "example_id": "2a673ed5-1859-40ae-90d2-6dc09d737612",
                                                "sense_id": "c23ad03c-dec6-3427-a38f-34435f136ea0",
                                                "text": "„Ich las Bücher von Neurobiologie bis Marktwirtschaft, doch je mehr ich recherchierte, desto verwirrter wurde ich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "091f742e-3023-495e-9e19-8ab0d49ea145",
                        "source_entry_id": "b2d74b66-c1e1-3887-8133-0dfd8a7911d8",
                        "source_sense_id": "77769abe-effe-32af-a435-6d7133da9c21",
                        "target_lang_word": "market economy",
