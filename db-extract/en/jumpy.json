                        "sense_id": "21a0d410-81e6-31f7-b597-177ed4af6e08",
                        "entry_id": "882c9160-3c61-30f4-9b00-f229df54dc2b",
                        "glosses": [
                            "Nervous and excited."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86a0afd3-ba01-4d01-8463-915644112359",
                                "sense_id": "21a0d410-81e6-31f7-b597-177ed4af6e08",
                                "text": "It was the butler who saw him go. Twelve o'clock at night and raining hard. So next night I was up at the house and, sure enough, master was off again. Stephens and I went after him, but it was jumpy work, for it would have been a bad job if he had seen us."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d727112-c0a4-36eb-a8af-101cba50e344",
                        "entry_id": "882c9160-3c61-30f4-9b00-f229df54dc2b",
                        "glosses": [
                            "Tending to jump; full of jumps."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb04d9c6-8191-436d-ac31-d41bc68b7ab9",
                                "sense_id": "0d727112-c0a4-36eb-a8af-101cba50e344",
                                "text": "We moved at a good clip, so I reached up to pull shut the window coverings, just in case this jumpy frog decided to escape."
                            },
                            {
                                "example_id": "cec20ba4-f4db-40d5-b657-31ef76d1522f",
                                "sense_id": "0d727112-c0a4-36eb-a8af-101cba50e344",
                                "text": "Meanwhile, the car pursued its jumpy course, and I could not prevent myself laughing."
                            }
                        ]
                    }
                ],
                "translations": [
