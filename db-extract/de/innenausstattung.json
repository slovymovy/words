                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6325fdd9-21db-478a-9e9a-b546884ec72f",
                                "sense_id": "0f28c165-5161-3d06-b745-f4f9f1a3bda4",
                                "text": "Die Inneneinrichterinnen suchen sich für die Innenausstattung des Raumes die richtige Innenfarbe aus."
                            },
                            {
                                "example_id": "ddf281c5-325f-4397-af5b-a6e6fee58a66",
                                "sense_id": "0f28c165-5161-3d06-b745-f4f9f1a3bda4",
                                "text": "„Die Innenausstattung war aus Oslo bestellt worden: Stabparkett für die Wohnzimmer, Strohtapete für die Bibliothek, Wasserhähne aus Messing und das erste Wasserklosett im Dorf.“"
                            }
                        ],
