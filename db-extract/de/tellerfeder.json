                "senses": [
                    {
                        "sense_id": "a7960eeb-f8a9-301d-8422-80b9a3d94d8d",
                        "entry_id": "f05d9925-921a-3c17-88de-efef5de0a594",
                        "glosses": [
                            "kreisförmiger, flacher Kegelstumpf aus Metall oder Kunststoff, der durch seine Elastizität vertikal wirkende Energie aufnehmen und abgeben kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83addfea-3177-4c3a-8ab1-2b804a37e7ab",
                                "sense_id": "a7960eeb-f8a9-301d-8422-80b9a3d94d8d",
                                "text": "„Zweckmäßiger Weise sollte die Kraftübertragung an der Auflagefläche der Tellerfeder am Anfang bzw. Ende der Federsäule auf dem Außenrand erfolgen.“"
                            },
                            {
                                "example_id": "4d6434f7-e9d7-4895-88dc-d8c07c89ed38",
                                "sense_id": "a7960eeb-f8a9-301d-8422-80b9a3d94d8d",
                                "text": "„Da die Geometrie der Stützfeder die Krafteingriffspunkte bestimmt und dadurch das Verhalten der Tellerfeder beeinflusst, müssen die zur Modellerstellung erforderlichen geometrischen Merkmale auch berücksichtig werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
