                "senses": [
                    {
                        "sense_id": "cdf5f2a7-1ef4-34e9-a25c-a608b444e364",
                        "entry_id": "bd16f0ec-f19a-343c-9a5d-143c50987c10",
                        "glosses": [
                            "eine Situation extremer Gefahr eines Schiffes (oder auch Flugzeuges) durch Feuer, Strandung, Explosion oder anderer kritischer Umstände auf See"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e69e908c-ce1a-47eb-ac1b-ae10f974e76e",
                                "sense_id": "cdf5f2a7-1ef4-34e9-a25c-a608b444e364",
                                "text": "„Wie die Matrosen in Seenot ließ sie verzweifelte Blicke über die öde ihres Daseins schweifen und suchte fern in den dunstigen Weiten ein weißes Segel.“"
                            },
                            {
                                "example_id": "356a25cc-1fe4-4bbf-afe5-68c3945b9458",
                                "sense_id": "cdf5f2a7-1ef4-34e9-a25c-a608b444e364",
                                "text": "Viele Schiffe sind bei diesem Orkan in Seenot geraten."
                            },
                            {
                                "example_id": "20da2dad-a869-4dab-a9bf-a9df687ab08f",
                                "sense_id": "cdf5f2a7-1ef4-34e9-a25c-a608b444e364",
                                "text": "„Kurz darauf sanken zwei weitere Fähren oder gerieten in Seenot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
