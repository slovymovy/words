                                "example_id": "84846195-1df4-4ff3-8847-9b54781c777d",
                                "sense_id": "276f34f7-11ca-3cf7-8d45-2f96a42d23b1",
                                "text": "„Ein Erdrutsch fordert in der chilenischen Stadt Antofagasta mindestens 150 Tote und Vermisste […]“"
                            },
                            {
                                "example_id": "8ee619cb-3b5e-4016-bd5b-f958fd33d985",
                                "sense_id": "276f34f7-11ca-3cf7-8d45-2f96a42d23b1",
                                "text": "„Die dritte Andenbahn, 1948 eröffnet, verbindet Salta über den 3857 m hohen Socompapass mit Antofagasta; die Südstrecke (Transandino del Sur) führt von Neuquén über Zapala nach Concepción.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
