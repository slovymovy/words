                ],
                "senses": [
                    {
                        "sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                        "entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
                        "glosses": [
                            "badanie dziedziczności pozagenowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772b4d84-be23-40d0-9e14-4e1dd32d74b3",
                                "sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                                "text": "Inne możliwe wpływy biologiczne obejmują ewolucję, genetykę, epigenetykę i hormony"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a066b83-1e35-470a-b733-191c65a55615",
                        "source_entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
                        "source_sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                        "target_lang_word": "epigenetics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigenetics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7bd0a29-cd8b-3b18-ae65-fc31be6bdf5a",
                                        "entry_id": "2713165b-9afe-38db-b46c-f29b6e6a3bd5",
                                        "glosses": [
                                            "The study of the processes involved in the genetic development of an organism, especially the activation and deactivation of genes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de2a0399-a19a-4cc1-ad29-d193a73d5228",
                                                "sense_id": "b7bd0a29-cd8b-3b18-ae65-fc31be6bdf5a",
                                                "text": "Epigenetics deals with the regulation of genetic activity within a cell - which genes are switched on or off, and when it happens."
                                            },
                                            {
                                                "example_id": "3f87c166-718c-43c9-94ce-94a595730b89",
                                                "sense_id": "b7bd0a29-cd8b-3b18-ae65-fc31be6bdf5a",
                                                "text": "The nuts and bolts of how this happens revolves around the massively trendy field of “epigenetics,” revealing how early life experience causes long-lasting changes in gene expression in particular brain regions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff788f12-f363-3a02-9fee-58f4bf7798d4",
                                        "entry_id": "2713165b-9afe-38db-b46c-f29b6e6a3bd5",
                                        "glosses": [
                                            "The study of heritable changes caused by the activation and deactivation of genes without any change in DNA sequence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d18fb355-49f7-4923-ba4d-df0b34ed17ee",
                        "source_entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
                        "source_sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                        "target_lang_word": "epigenetika",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d2567305-6002-446e-ba31-97640766096f",
                        "source_entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
                        "source_sense_id": "83732859-a873-3d1c-bb86-4f7d9dfe66cc",
                        "target_lang_word": "épigénétique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épigénétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc935ff7-1023-3567-ac01-692f3d50e3c9",
                                        "entry_id": "7624aba7-72f1-33ab-8fe8-67bee112ffb8",
                                        "glosses": [
                                            "Relatif à l’influence de l’environnement sur l’expression des gènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff75f490-aa7c-4123-84a4-78dc4ff9c9c0",
                                                "sense_id": "bc935ff7-1023-3567-ac01-692f3d50e3c9",
                                                "text": "Contrairement à l’hérédité génétique, cependant, un statut épigénétique peut généralement être inversé ; par exemple, les chromosomes X sont réactivés avant la formation des gamètes."
                                            },
                                            {
                                                "example_id": "53523a9f-0727-43c2-a204-7417b6a6c171",
                                                "sense_id": "bc935ff7-1023-3567-ac01-692f3d50e3c9",
                                                "text": "On parle d’épigénétique, par opposition à génétique pour désigner une hérédité non codée dans l’ADN."
                                            },
                                            {
                                                "example_id": "1ede85d1-49d8-4c6b-80b5-1cb78c802102",
                                                "sense_id": "bc935ff7-1023-3567-ac01-692f3d50e3c9",
                                                "text": "Une étude publiée l'an dernier dans « l'American Journal of Human Genetics» montre, par exemple , que fumer pendant la grossesse entraîne, au niveau de l'ADN du fœtus, des modifications chimiques en des milliers de points – lesquelles perdurent au moins pour partie. Parmi les zones impactées, des gènes impliqués dans le développement des poumons et du système nerveux. Entendons nous bien, : il ne s'agit pas de mutations des gènes eux-mêmes, mais d'une sorte de marquage modifiant leur « expression ». Un phénomène dont l'étude relève d'une discipline en plein essor : l'épigénétique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16678f50-5ed9-394b-aea8-629233ffb968",
                                        "entry_id": "7624aba7-72f1-33ab-8fe8-67bee112ffb8",
                                        "glosses": [
                                            "Dû à un cours d’eau qui a érodé la couche supérieure (épigénie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650fa480-f35c-49ac-8bee-3c39efef669c",
                                                "sense_id": "16678f50-5ed9-394b-aea8-629233ffb968",
                                                "text": "Les deux courbes de droite se rapportent à des dolomies hettangiennes probablement épigénétiques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "épigénétique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "533660e1-8af8-35d1-8124-1afdeaf4488b",
                                        "entry_id": "f5b3024c-99f4-3b21-8ed1-d40544bf09a8",
                                        "glosses": [
                                            "Discipline qui étudie l’interaction permanente entre environnement, histoire individuelle et gènes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e88fd864-f319-408c-ada1-545d71efd452",
                                                "sense_id": "533660e1-8af8-35d1-8124-1afdeaf4488b",
                                                "text": "Alors que la génétique correspond à l’étude des gènes, l’épigénétique s’intéresse à une \"couche\" d’informations complémentaires qui définit comment ces gènes vont être utilisés par une cellule … ou ne pas l’être."
                                            },
                                            {
                                                "example_id": "524d91df-38ad-49e8-9b2c-ce7e69d3d643",
                                                "sense_id": "533660e1-8af8-35d1-8124-1afdeaf4488b",
                                                "text": "Le patron de méthylation peut-être transmis, ce qui donne toute son importance à ce mécanisme dans l’épigénétique."
                                            },
                                            {
                                                "example_id": "aeb5333e-f268-47eb-b9a8-a9b355ac8735",
                                                "sense_id": "533660e1-8af8-35d1-8124-1afdeaf4488b",
                                                "text": "S’il ne s’agit pas de deux groupes distincts, il est alors difficile de comprendre le genre d’information qui mène les différents groupes à agir différemment, mais on peut supposer que la génétique ou l’épigénétique sont probablement impliquées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27934011-1d9b-4fca-a583-8564734ceea0",
                        "source_entry_id": "a6e526c9-c984-36ae-acf0-3af2c9970570",
