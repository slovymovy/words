                "senses": [
                    {
                        "sense_id": "59bf8e75-5d93-3e4c-a0e0-30a76177bea0",
                        "entry_id": "720ca3ec-97dc-33a8-b911-ed07354d5e14",
                        "glosses": [
                            "confidant"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "e57b597a-dac9-4d7c-a90c-6cb17a4bbd41",
                                "sense_id": "59bf8e75-5d93-3e4c-a0e0-30a76177bea0",
                                "text": "— Зна́ете ли, князь, я всё-таки не понима́ю, почему́ вам взду́малось вы́брать и́менно меня́ конфиде́нтом ва́ших тайн и любо́вных… стремле́ний.",
                                "translation": "“Do you know, prince, I still can’t understand why you have selected me as a confidant of your secrets and your amorous propensities.”",
                                "english": "“Do you know, prince, I still can’t understand why you have selected me as a confidant of your secrets and your amorous propensities.”"
                            }
                        ]
                    }
                ],
