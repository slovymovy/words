                "forms": [],
                "senses": [
                    {
                        "sense_id": "83984857-ddb4-38f9-b420-e3eec020bafe",
                        "entry_id": "58308467-3619-3aae-bdee-0edbd497554d",
                        "glosses": [
                            "gelber, lipophiler (fettlöslicher) Farbstoff, der unter anderem in grünen Pflanzen, im Getreide und im Eidotter vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95f0eb68-097a-4527-943f-4afb2132d5fa",
                                "sense_id": "83984857-ddb4-38f9-b420-e3eec020bafe",
                                "text": "„Found in green leafy vegetables such as spinach and kale, lutein is employed by organisms as an antioxidant and for blue light absorption.“"
                            },
                            {
                                "example_id": "58b32653-0c58-488c-8645-4d63ec67bf84",
                                "sense_id": "83984857-ddb4-38f9-b420-e3eec020bafe",
                                "text": "„The yellow color of the human macula lutea (literally, yellow spot) in the retina of the eye comes from the lutein and zeaxanthin it contains, both xanthophylls again derived from the diet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
