                "entry_id": "ad3ae733-2d83-3242-a599-7b6ac375e226",
                "word": "krupy",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da19f24f-c9d7-3562-ad66-e14bc68e384e",
                        "entry_id": "ad3ae733-2d83-3242-a599-7b6ac375e226",
                        "glosses": [
                            "otłuczone ziarno"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "a3047b0c-8f9d-4387-a576-de2be2e2554d",
                                "sense_id": "da19f24f-c9d7-3562-ad66-e14bc68e384e",
                                "text": "Sernik z krupami odróżnia się od innych ciast tym, że zawsze na wierzchu ciasta ma jasnobrązową kratę z ciasta i w tę kratę wrzucone krupy z kaszy gryczanej"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "8e9dedb0-5fa2-3beb-bdaa-31ca3029b5e8",
                        "entry_id": "ad3ae733-2d83-3242-a599-7b6ac375e226",
                        "glosses": [
                            "kasza lub polewka gotowana z krup (1.1), polenta, plutes"
                        ],
                        "tags": [
                            "Old-Polish"
                        ],
                        "examples": [
                            {
                                "example_id": "07a03568-c4ae-4e4d-9caf-925cfeb202cb",
                                "sense_id": "8e9dedb0-5fa2-3beb-bdaa-31ca3029b5e8",
                                "text": "Wodnista polewka na krupach nie kusząc swym smakiem, nie zachęcała też do prędkiego jedzenia."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "a8c3af72-daf5-3eed-bd61-509c34f012cb",
                        "entry_id": "ad3ae733-2d83-3242-a599-7b6ac375e226",
                        "glosses": [
                            "opad w postaci drobnych grudek lodowych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa336836-9c15-46b8-a191-4514ff03a5e4",
                                "sense_id": "a8c3af72-daf5-3eed-bd61-509c34f012cb",
                                "text": "Krupom niesionym wiatrem trudno było się oprzeć, więc zrezygnowaliśmy z dalszej wspinaczki"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
