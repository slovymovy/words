                    }
                ],
                "senses": [
                    {
                        "sense_id": "14a25ee0-a9d3-3dc5-b7f8-cb8e62bd46c7",
                        "entry_id": "b34baf54-04fe-3483-9174-86a58b13319b",
                        "glosses": [
                            "The quality of being impatient; lacking patience; restlessness and intolerance of delays; anxiety and eagerness, especially to begin something."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db2d85a7-4eda-4f2e-8f83-59a96c2dfebb",
                        "source_entry_id": "b34baf54-04fe-3483-9174-86a58b13319b",
                        "source_sense_id": "14a25ee0-a9d3-3dc5-b7f8-cb8e62bd46c7",
                        "source_sense_description": "quality of being impatient",
                        "target_lang_word": "netrpělivost",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "netrpělivost",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "402a5700-d34d-3274-a70c-ea3f2ac594c5",
                                        "entry_id": "a848c2aa-169b-378b-b47c-0f3569306f56",
                                        "glosses": [
                                            "neochota dlouho klidně čekat resp. opakovaně vykonávat určitou činnost, než se dostaví žádoucí výsledek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694d52bd-23d1-4ca8-a80a-550a85f0f797",
                                                "sense_id": "402a5700-d34d-3274-a70c-ea3f2ac594c5",
                                                "text": "Proč Západ nezvolil stejnou taktiku? Protože něco takového je v rozporu s jeho kulturou netrpělivosti, touhou řešit všechny problémy rychle, s co nejmenšími náklady a zátěží. Ale jak se ukázalo tenhle přístup s covidem nefunguje. „Podle mého názoru souvisí netrpělivost s ideologickým přístupem, který za nejhodnotnější cíl lidského života považuje ekonomický úspěch, dosažený co nejrychleji to jde,“ píše Milanović."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89e16d84-a158-4af8-9018-c0f8d1b5bf7c",
                        "source_entry_id": "b34baf54-04fe-3483-9174-86a58b13319b",
                        "source_sense_id": "14a25ee0-a9d3-3dc5-b7f8-cb8e62bd46c7",
                        "source_sense_description": "quality of being impatient",
                        "target_lang_word": "ongeduld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ongeduld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f145fff2-9b05-338f-80bd-e769259fceb9",
                                        "entry_id": "be490f6d-3672-3b59-94d8-fa761793d53b",
                                        "glosses": [
                                            "drift, boosheid, woedeaanval, zonder geduld"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10ce75e2-62a8-3125-a888-8f9f0082acac",
                                        "entry_id": "be490f6d-3672-3b59-94d8-fa761793d53b",
                                        "glosses": [
                                            "de emotie die men ondervindt als men ongewild ergens op moet wachten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1009572f-191e-4261-b213-22531f8515d0",
                                                "sense_id": "10ce75e2-62a8-3125-a888-8f9f0082acac",
                                                "text": "Veel mensen wachtten vol ongeduld op hun postdozen die door de bosbranden veel vertraging hadden opgelopen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ad28fc1-d393-4d2e-b11b-c412a54e100e",
                        "source_entry_id": "b34baf54-04fe-3483-9174-86a58b13319b",
                        "source_sense_id": "14a25ee0-a9d3-3dc5-b7f8-cb8e62bd46c7",
                        "source_sense_description": "quality of being impatient",
                        "target_lang_word": "impatience",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impatience",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Manque de patience, sentiment d’inquiétude ou d’irritation que l’on éprouve, soit dans la souffrance d’un mal, soit dans l’attente de quelque bien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8205734-26ea-4a9b-b222-77eb6fbcbd5d",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Maintenant, toutes les jeunes filles, romanesques ou non, peuvent imaginer dans quelle impatience vécut Modeste pendant quelques jours !"
                                            },
                                            {
                                                "example_id": "0d04f94c-b21b-49c9-bae0-88ea23c33fd4",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Pendant une conversation donner les signes d'impatience."
                                            },
                                            {
                                                "example_id": "f0478468-27fb-48e4-9147-3ebb7ecae435",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Et maintenant, parti dès l'aube par la belle route de Lambèse, il pressait son cheval, pris d'une impatience qui l'étonnait lui-même."
                                            },
                                            {
                                                "example_id": "94ec418b-d4a3-4ebf-b6da-d5eb44368509",
                                                "sense_id": "72f13485-d3dc-38a4-9323-fb6b8e32c6be",
                                                "text": "Ainsi pour mon malheur, toujours brûlant des ardeurs de l’impatience, je dois soupirer sans cesse après ma santé, la demander instamment, et ne rien omettre pour l’obtenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b3e2cbc-4b0c-3736-98a1-71f48e5fbf01",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Sorte d’irritation nerveuse que cause l’impatience."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "311aed1d-d49c-4037-9e22-185569460f7d",
                                                "sense_id": "2b3e2cbc-4b0c-3736-98a1-71f48e5fbf01",
                                                "text": "Cet homme parle avec une lenteur qui donne des impatiences à ceux qui l’écoutent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bdfb43a-a761-3b62-bfae-63b2ba93845b",
                                        "entry_id": "bb69a4ae-a69f-352d-b619-18bec7935d32",
                                        "glosses": [
                                            "Sorte de démangeaison."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bed3b9a1-7eaa-4a8e-9dfa-641c22b51215",
                                                "sense_id": "1bdfb43a-a761-3b62-bfae-63b2ba93845b",
                                                "text": "Les impatiences, encore dénommées le syndrome des jambes sans repos, provoquent des manifestations désagréables dans les jambes qui peuvent être modérées ou très invalidantes. Celles-ci surviennent davantage le soir et au cours de la nuit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "244fb6fb-b554-4c80-93c5-05d70bf3ee76",
                        "source_entry_id": "b34baf54-04fe-3483-9174-86a58b13319b",
                        "source_sense_id": "14a25ee0-a9d3-3dc5-b7f8-cb8e62bd46c7",
                        "source_sense_description": "quality of being impatient",
                        "target_lang_word": "Ungeduld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ungeduld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                        "entry_id": "05c04a11-073a-3d5c-8d72-5e41dd8b8035",
                                        "glosses": [
                                            "Mangel an Ausdauer, auf etwas zu warten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab7880c-9b39-47ea-b0c4-c02d097158a9",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "Sie wartete mit großer Ungeduld, bis sie endlich an der Reihe war."
                                            },
                                            {
                                                "example_id": "bc5294fc-de1a-47fe-8796-ea3741adc69f",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Hagen versuchte seine Ungeduld zu verbergen.“"
                                            },
                                            {
                                                "example_id": "271392c5-791c-4e17-905d-8a7b834d00bd",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Er wandte sich ab und wartete mit Ungeduld auf die Rückkehr des Fürsten Andrej.“"
                                            },
                                            {
                                                "example_id": "d9c221cc-b896-4eb4-85f4-85e410d2ddcf",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Die Liebe wird nur in der Ungedult des Verlangens unvorsichtig; aber wenn es darum geht, die Wiederkehr eines Glücks zu betreiben, dem widrige Umstände Hindernisse in den Weg legen, wird die Liebe alles mit größtem Scharfsinn sehen und voraussehen.“"
                                            },
                                            {
                                                "example_id": "4d8f9d81-1e0f-4db9-aab2-fbd9c3fe7fc2",
                                                "sense_id": "4884c8c2-5af5-39d9-a574-83b1f4b33193",
                                                "text": "„Der Pflanzer hatte beide mit Ungeduld angehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
