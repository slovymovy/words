                "senses": [
                    {
                        "sense_id": "2426085a-b9c6-3b84-a5ee-6ab86c65b968",
                        "entry_id": "1da2e343-429b-3dfa-96a1-791d1850d9e5",
                        "glosses": [
                            "gesamte Tätigkeit des Staates in der Ordnung der Arbeit; staatliche Institution, die alle Rechte/Pflichten/Maßnahmen zum Thema Erwerbsarbeit regelt/umsetzt"
                        ],
                        "tags": [
                            "auch"
                        ],
                        "examples": [
                            {
                                "example_id": "8c1cc783-18aa-486d-b135-8e7a8445e3e8",
                                "sense_id": "2426085a-b9c6-3b84-a5ee-6ab86c65b968",
                                "text": "„Ausländische Arbeitnehmer bedürfen in Deutschland einer Zustimmung zur Ausübung einer Beschäftigung von der Arbeitsverwaltung (Bundesagentur für Arbeit), die Voraussetzung für die Erteilung einer Aufenthaltserlaubnis ist.“"
                            },
                            {
                                "example_id": "25dba822-6c08-4a5a-90c7-f56ba3735a51",
                                "sense_id": "2426085a-b9c6-3b84-a5ee-6ab86c65b968",
                                "text": "„Mit dem am 01.07.1969 vom Parlament verabschiedeten Arbeitsförderungsgesetz (AFG) wurde der Gesetzesauftrag der Arbeitsverwaltung neu definiert.“"
                            },
                            {
                                "example_id": "13ebf70f-39ec-4f44-a0a9-506435548172",
                                "sense_id": "2426085a-b9c6-3b84-a5ee-6ab86c65b968",
                                "text": "„Außerhalb des öffentlichen Dienstes wird das Kindergeld von den Familienkassen der Arbeitsverwaltung ausgezahlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
