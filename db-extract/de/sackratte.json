                "senses": [
                    {
                        "sense_id": "e5160d70-1263-31d0-ae64-b1865afcf9c8",
                        "entry_id": "95ad71a2-3f19-3a1d-aed5-47ce118e10a8",
                        "glosses": [
                            "ein Insekt (Pthirus pubis), welches hauptsächlich in den menschlichen Schamhaaren lebt"
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c2c203ea-2994-4a31-96f1-054a124f03ab",
                                "sense_id": "e5160d70-1263-31d0-ae64-b1865afcf9c8",
                                "text": "„Ich weiß, werte Filzlaus, alte Sackratte, Schamlaus, Matrose am Mast - wie immer man dich genannt hat, dich zum ‚Helden‘ zu machen, ist mehr Konfetti auf dein Haupt als du verdienst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c91ccffc-5bd8-31e0-a974-64c773494f75",
                        "entry_id": "95ad71a2-3f19-3a1d-aed5-47ce118e10a8",
                        "glosses": [
                            "abstoßende, lästige Person"
                        ],
                        "tags": [
                            "Schimpfwort"
                        ],
                        "examples": [
                            {
                                "example_id": "6895d0b0-9f93-40b3-b1aa-4e1edba59024",
                                "sense_id": "c91ccffc-5bd8-31e0-a974-64c773494f75",
                                "text": "„Wie soll diese kleine Sackratte Respekt vor mir haben, wenn schon die Mutter keinen hat?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
