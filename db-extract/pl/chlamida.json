                        "translation_id": "30607d2e-b9fe-41d1-8638-2172a2d78a56",
                        "source_entry_id": "aef0f8f0-3e41-3161-90ed-ceb640b0daa8",
                        "source_sense_id": "a85721c3-152b-37a7-91e3-fdbe254a50af",
