{
    "word_family": [
        "gull"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14add8bb-4dac-387a-944b-547b8aba6d5d",
                    "sense_definition": "A narrow channel or ravine formed by water erosion on a hillside.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geological_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heavy rain carved a deep <w>gully</w> into the side of the mountain.",
                            "target_lang_translations": {
                                "ru": "Сильный дождь прорезал глубокую <w>промоину</w> на склоне горы."
                            }
                        },
                        {
                            "text": "The hikers had to cross a muddy <w>gully</w> to reach the trail.",
                            "target_lang_translations": {
                                "ru": "Туристам пришлось пересечь грязную <w>ложбину</w>, чтобы добраться до тропы."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Узкий канал или овраг, образованный эрозией почвы под воздействием воды на склоне холма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промоина",
                                "target_lang_sense_clarification": "углубление, вымытое потоком воды"
                            },
                            {
                                "target_lang_word": "вымоина",
                                "target_lang_sense_clarification": "углубление на поверхности земли, образованное вымыванием"
                            },
                            {
                                "target_lang_word": "буерак",
                                "target_lang_sense_clarification": "небольшой овраг или рытвина"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c06e7ed-d6a4-3f5e-859d-c1bfe0c69d3b",
                    "sense_definition": "A small valley.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geological_feature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small stream flowed peacefully through the green <w>gully</w>.",
                            "target_lang_translations": {
                                "ru": "Маленький ручей мирно протекал через зеленую <w>ложбину</w>."
                            }
                        },
                        {
                            "text": "They built their cabin in a sheltered <w>gully</w> to avoid the wind.",
                            "target_lang_translations": {
                                "ru": "Они построили свой домик в защищенной <w>ложбине</w>, чтобы укрыться от ветра."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая долина."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложбина",
                                "target_lang_sense_clarification": "неглубокое понижение рельефа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bb9ab9d-ae28-3158-912e-6f9605f58290",
                    "sense_definition": "A drain located on a road to collect rainwater.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "infrastructure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city workers cleaned the street <w>gully</w> to prevent flooding.",
                            "target_lang_translations": {
                                "ru": "Городские службы прочистили уличный <w>водосток</w>, чтобы предотвратить наводнение."
                            }
                        },
                        {
                            "text": "Water pooled on the road because the <w>gully</w> was blocked by leaves.",
                            "target_lang_translations": {
                                "ru": "На дороге скопилась вода, потому что <w>водосток</w> был забит листьями."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Водосточная решетка или канал на дороге для сбора дождевой воды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ливневая канализация",
                                "target_lang_sense_clarification": "система сбора дождевых вод"
                            },
                            {
                                "target_lang_word": "водосток",
                                "target_lang_sense_clarification": "устройство для отвода воды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d512ac6-e273-3997-b926-9d8f6a02cae5",
                    "sense_definition": "A specific fielding position in cricket located behind the slips.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cricket",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The batsman edged the ball directly to the fielder at <w>gully</w>.",
                            "target_lang_translations": {
                                "ru": "Бэтсмен отбил мяч прямо к игроку на позиции <w>галли</w>."
                            }
                        },
                        {
                            "text": "He is an excellent fielder when positioned in the <w>gully</w>.",
                            "target_lang_translations": {
                                "ru": "Он отличный полевой игрок, когда стоит на позиции <w>галли</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специфическая позиция игрока в крикете, расположенная за слипами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "галли",
                                "target_lang_sense_clarification": "позиция игрока в крикете (транслитерация)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e84e4a97-2bc4-32be-b45f-d6b90a98cd7f",
                    "sense_definition": "To erode or wear away land into a channel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "erosion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy storm began to <w>gully</w> the dirt path behind the house.",
                            "target_lang_translations": {
                                "ru": "Сильный шторм начал <w>размывать</w> грунтовую дорожку за домом."
                            }
                        },
                        {
                            "text": "Poor farming practices caused the rain to <w>gully</w> the entire field.",
                            "target_lang_translations": {
                                "ru": "Из-за неправильных методов ведения сельского хозяйства дождь <w>размыл</w> всё поле."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Размывать почву, образуя каналы или овраги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размывать",
                                "target_lang_sense_clarification": "разрушать почву потоком воды"
                            },
                            {
                                "target_lang_word": "промывать",
                                "target_lang_sense_clarification": "образовывать углубления в результате эрозии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7fb4fd5c-5468-3ab5-bd3f-361b89192cbd",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gully</w> is the new teacher at our school.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Галли</w> — новый учитель в нашей школе."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Gully</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил женщину по имени Сара <w>Галли</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
