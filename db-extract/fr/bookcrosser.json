                "senses": [
                    {
                        "sense_id": "c2df20b5-68e4-3bd3-b10e-afc328cbad0e",
                        "entry_id": "bcc5fbe7-d8ab-305b-af2a-7c17d9d76224",
                        "glosses": [
                            "Pratiquer le bookcrossing, laisser des livres dans des lieux publics pour qu’ils circulent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79c2c05c-b70f-47fd-9f30-4fbb96114c54",
                                "sense_id": "c2df20b5-68e4-3bd3-b10e-afc328cbad0e",
                                "text": "Bookcrosser n’est pas jeter : le bookcrossing, lancé il y a une dizaine d’années, consiste à laisser un livre qu’on a aimé dans un endroit public, après l’avoir immatriculé et enrichi de commentaires."
                            },
                            {
                                "example_id": "18b41191-c919-4696-bffb-fb90880a1ac5",
                                "sense_id": "c2df20b5-68e4-3bd3-b10e-afc328cbad0e",
                                "text": "Fichtre, déjà 20 ans que je bookcrosse!"
                            }
                        ]
                    },
                    {
                        "sense_id": "44c46614-0a26-3526-b249-58650f466189",
                        "entry_id": "bcc5fbe7-d8ab-305b-af2a-7c17d9d76224",
                        "glosses": [
                            "Laisser (un livre) dans des lieux publics pour qu’il circule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcee4414-7f78-47b8-99e1-1889c87a1159",
                                "sense_id": "44c46614-0a26-3526-b249-58650f466189",
                                "text": "Baci lit des livres qu'elle ne bookcrosse pas"
                            }
                        ]
                    }
