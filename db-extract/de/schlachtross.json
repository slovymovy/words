                ],
                "senses": [
                    {
                        "sense_id": "37ee8575-774a-3fb9-924f-d3b9afe7add8",
                        "entry_id": "86dcb54f-c892-3ae3-8ba4-a3f472de6793",
                        "glosses": [
                            "in Kämpfen von Reitern genutztes Pferd, das speziell für seinen Einsatz abgerichtet war"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c4762120-b158-4e76-b5d8-98497fd606dc",
                                "sense_id": "37ee8575-774a-3fb9-924f-d3b9afe7add8",
                                "text": "„Bobby dachte an den Bücherbus und stellte sich vor, er würde sich in diesem Augenblick wie ein treues Schlachtross hinter ihm aufbäumen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "095f0762-6e32-4a63-a335-c6426b605c72",
                        "source_entry_id": "86dcb54f-c892-3ae3-8ba4-a3f472de6793",
                        "source_sense_id": "37ee8575-774a-3fb9-924f-d3b9afe7add8",
                        "source_sense_description": "historisch: in Kämpfen von Reitern genutztes Pferd, das speziell für seinen Einsatz abgerichtet war",
                        "target_lang_word": "warhorse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warhorse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "Any horse used in horse-cavalry, but especially one bearing an armoured knight."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab25a72f-ee42-477c-8962-e9cc3c3bfe15",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "Just within the inner edge of the circle stood a soldier, in the military attire of a strange nation; and without it was his warhorse, in the center of a collection of mounted domestics, seemingly in readiness to undertake some distant journey."
                                            },
                                            {
                                                "example_id": "a0f43e27-259d-48e8-8f0f-49d634f31943",
                                                "sense_id": "18e0279e-0c54-3b33-ba9e-9e13713f349e",
                                                "text": "As he spoke, the knight-errant, who had remounted his war-horse, galloped forward to the royal stand, with a silken kerchief bound round his wounded arm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "An experienced person who has been through many battles, situations or contests; someone who has given long service."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10c4133d-c4d1-412f-9d0d-8cc52c7afcc5",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Near-synonym: workhorse"
                                            },
                                            {
                                                "example_id": "b78bd018-c017-4464-b4b9-33a1d6830faf",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Among other accidents of that year was a Democratic president. Judge Atwood was a warhorse of Democracy."
                                            },
                                            {
                                                "example_id": "322c37eb-6621-42a3-9a65-40d0dfbf0425",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Certainly this was a bold proposal to an old warhorse like Ecuyer, and, like a true English bulldog, he voiced a reply which made the Indians wince."
                                            },
                                            {
                                                "example_id": "27692a21-7652-402c-84ab-658e479517e1",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "“I don't know. I never notice much. Oh, they do kid me about not being in the army—especially the old warhorses, the old men that aren't going themselves. And this Bogart boy. And Mr. Hicks's son—he's a horrible brat. But probably he's licensed to say what he thinks about his father's hired man!”"
                                            },
                                            {
                                                "example_id": "6b715c56-a55d-446b-a52f-773f1fd9de78",
                                                "sense_id": "1fe5e5d2-7f1d-3619-9ce1-c77eba50536f",
                                                "text": "Srinath: India's warhorse [title]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                        "entry_id": "8d72281c-db86-39b8-86a8-b1d6a7f1f533",
                                        "glosses": [
                                            "A regularly revived theatrical or musical work, as with Hamlet or a Beethoven symphony, or as excerpts thereto. May imply that the work in question has become hackneyed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b560fc-0d4a-4c37-9782-5824ec1d0584",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "a Wagner warhorse"
                                            },
                                            {
                                                "example_id": "80b89e3b-e486-4335-bfa8-7d89ac73d809",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "I remember taking the old warhorse, “Una Voce Poco Fa,” from Il Barbiere (Rossini) to three of the greatest living singing masters in Italy."
                                            },
                                            {
                                                "example_id": "b962e7ee-1509-479b-aae3-7f4c0745ff47",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "Les Ballets Trockadero de Monte Carlo[…] presented a typical program of Russian warhorses of the 19th and early 20th centuries[…]"
                                            },
                                            {
                                                "example_id": "64e5ad9e-fc3f-49b7-b1ce-63a60810b634",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "A Mendelssohn Warhorse Gets the Perlman Treatment [title]"
                                            },
                                            {
                                                "example_id": "f463cba4-a769-4a32-917e-f9fc0b6866ea",
                                                "sense_id": "6515c693-4e07-3031-9f9a-27b039f2df3d",
                                                "text": "[…] the ROH mounts a new production of an Italian repertory warhorse that is fully on the level of the one it replaces […"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
