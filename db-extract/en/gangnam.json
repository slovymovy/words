        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "cccfcd1e-62a2-3358-8f2c-fdf807fd92e7",
                "word": "Gangnam",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d6dbfc1-8e6d-3a08-87ff-efdc30e6a264",
                        "entry_id": "cccfcd1e-62a2-3358-8f2c-fdf807fd92e7",
                        "glosses": [
                            "A district (Korean: 구 (gu)) of Seoul, South Korea known for being a demographically young, affluent part of the city."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1baf21-4016-400d-a59a-de3076543ea5",
                                "sense_id": "7d6dbfc1-8e6d-3a08-87ff-efdc30e6a264",
                                "text": "The advanced design studio has moved from Bupyeong, Incheon, to the fashionable Seoul neighborhood of Gangnam, evidently Seoul’s answer to Greenwich Village."
                            },
                            {
                                "example_id": "629e8603-296a-47e4-acba-bdfb61da6915",
                                "sense_id": "7d6dbfc1-8e6d-3a08-87ff-efdc30e6a264",
                                "text": "The Seoul neighborhood of Gangnam is synonymous worldwide with conspicuous consumption and glitzy high-rises, thanks to K-pop singer Psy’s megahit “Gangnam Style.” Lesser known is a shantytown in a corner of Gangnam district, whose makeshift homes were destroyed by a fire on Friday."
                            },
                            {
                                "example_id": "46a66976-17be-45e3-8dd9-4dc9d8b34f28",
                                "sense_id": "7d6dbfc1-8e6d-3a08-87ff-efdc30e6a264",
                                "text": "\"Gangnam Style\" is a Korean term referring to the lifestyle associated with the Gangnam District of Seoul where people are trendy, hip and exude a certain supposed \"class.\""
                            }
                        ]
                    }
                ],
