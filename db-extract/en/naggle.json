                "senses": [
                    {
                        "sense_id": "d39de36e-474a-3309-9c36-0f633c18aabc",
                        "entry_id": "e6cf9e1e-d329-323f-9993-14db0bdbe266",
                        "glosses": [
                            "A minor irritant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d95c2be0-540a-41e7-a141-ca65d02dc928",
                                "sense_id": "d39de36e-474a-3309-9c36-0f633c18aabc",
                                "text": "So they all revolved round their trailing orbits in the sand, revolved round the naggles in their brains; all, except the sergeant."
                            }
                        ]
                    }
                ],
                "translations": [],
