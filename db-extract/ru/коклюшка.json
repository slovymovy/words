                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eede986a-0257-4d57-bcb5-b18b8499c0d9",
                                "sense_id": "26fc304b-ca3d-3742-b944-1d1fd169e173",
                                "text": "Победителям первого всероссийского конкурса кружевниц вручат дипломы, призы и настоящие серебряные коклюшки."
                            }
                        ]
