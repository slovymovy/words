                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f76e18e3-c5da-3d18-8542-8883e2a8c2f2",
                                        "entry_id": "fd7e0733-4c8e-3bf2-8385-3b35b36ff14c",
                                        "glosses": [
                                            "Well-being, satisfaction, pleasure, or happiness."
                                        ],
