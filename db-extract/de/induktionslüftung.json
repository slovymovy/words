                "senses": [
                    {
                        "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                        "entry_id": "9b8f621a-4af0-3713-a149-1933b6e74cf7",
                        "glosses": [
                            "im Deckenbereich zugeführte, impulsarme Luftströmung die sich mit der Raumluft vermischt und von oben nach unten strömt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adb9b394-d007-423c-bc5d-ace919137e45",
                                "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                                "text": "„Luftheizungen im Passivhaus werden immer als Induktionslüftung ausgeführt, da aufgrund der warmen Zuluft (bis 52° C) das Quellluftprinzip nicht in der gewünschten Weise funktioniert.“"
                            },
                            {
                                "example_id": "34a27e6f-bcea-449b-ad12-f04fe85cf77d",
                                "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                                "text": "„Mischlüftung, auch Verdünnungs-, Strahl- oder Induktionslüftung genannt: Luft wird punktuell eingeblasen und vermischt sich mit der Raumluft.“"
                            },
                            {
                                "example_id": "533f0982-6f4a-4ddc-b3d3-c8d00fcf9d07",
                                "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                                "text": "„Auch bei Sanierungen wird aufgrund der eingeschränkten Möglichkeiten der Rohrsysteme meist eine Induktionslüftung eingesetzt.“"
                            },
                            {
                                "example_id": "08f4bce6-dbc0-4af3-955f-b4840b13b56b",
                                "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                                "text": "„Rentschler Reven nutzte das bildgebende Verfahren für die Entwicklung einer Induktionslüftung im Großküchenbereich.“"
                            },
                            {
                                "example_id": "08d1b00d-298d-436a-9506-198550afe55c",
                                "sense_id": "dc15cd2b-db2e-3fcd-b559-b58c430917ab",
                                "text": "„Bei der Induktionslüftung (Mischluftsystem) wird die Luft mit höherer Geschwindigkeit im oberen Raumbereich - deutlich über Kopfhöhe – eingebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
