    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af9e7389-e75c-306c-bad0-3d9f8f9aa4c7",
                    "sense_definition": "A statement about what someone thinks will happen in the future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "future statement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather forecaster made a <w>prediction</w> of heavy rain for tomorrow afternoon.",
                            "target_lang_translations": {
                                "ru": "Синоптик составил <w>прогноз</w> о сильном дожде на завтрашний день."
                            }
                        },
                        {
                            "text": "It is often very difficult to make an accurate <w>prediction</w> about the stock market.",
                            "target_lang_translations": {
                                "ru": "Часто бывает очень трудно сделать точный <w>прогноз</w> относительно фондового рынка."
                            }
                        }
                    ],
                    "synonyms": [
                        "forecast",
                        "foretelling",
                        "prognosis"
                    ],
                    "common_phrases": [
                        "make an accurate prediction",
                        "prediction came true",
                        "bold prediction",
                        "weather prediction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление о том, что, по чьему-либо мнению, произойдет в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предсказание",
                                "target_lang_sense_clarification": "сообщение о том, что произойдет"
                            },
                            {
                                "target_lang_word": "прогноз",
                                "target_lang_sense_clarification": "суждение о развитии событий на основе данных"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aa70cb7-9893-3bd2-b5b1-95925f354fec",
                    "sense_definition": "An estimation of probability or outcomes based on statistical methods and data analysis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "statistical estimation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer model provides a statistical <w>prediction</w> based on the last ten years of data.",
                            "target_lang_translations": {
                                "ru": "Компьютерная модель выдает статистический <w>прогноз</w> на основе данных за последние десять лет."
                            }
                        },
                        {
                            "text": "Scientists use a statistical <w>prediction</w> to determine the likely path of the hurricane.",
                            "target_lang_translations": {
                                "ru": "Ученые используют статистическое <w>прогнозирование</w>, чтобы определить вероятный путь урагана."
                            }
                        }
                    ],
                    "synonyms": [
                        "prognosis",
                        "prognostication"
                    ],
                    "common_phrases": [
                        "statistical prediction",
                        "model prediction",
                        "data-driven prediction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценка вероятности или результатов на основе статистических методов и анализа данных."
                    },
                    "translations": {
