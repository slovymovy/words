                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ccfb046b-05df-32a7-94bb-59062a894c18",
                                        "entry_id": "843ebb0f-074b-3e8c-a7d0-fe543a0eefcd",
                                        "glosses": [
                                            "A prophet, the author of the Book of Isaiah."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f3b4f64-714e-4421-9f3e-a5d7426bc169",
                                                "sense_id": "ccfb046b-05df-32a7-94bb-59062a894c18",
                                                "text": "The family tree boasts an astonishing array of celebrated historical figures from the prophet Isaiah to Sir Isaiah Berlin, from Felix Mendelssohn to Karl Marx and Moses Montefiore. The list also includes Yehudi Menuhin, Helena Rubinstein, the Rothschilds and even Rosenstein himself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "831162a0-2009-3bdb-821f-3532f8347535",
                                        "entry_id": "843ebb0f-074b-3e8c-a7d0-fe543a0eefcd",
                                        "glosses": [
                                            "A male given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af863edf-618b-4a45-9f3f-5eee4ea5a07c",
                                                "sense_id": "831162a0-2009-3bdb-821f-3532f8347535",
                                                "text": "The family tree boasts an astonishing array of celebrated historical figures from the prophet Isaiah to Sir Isaiah Berlin, from Felix Mendelssohn to Karl Marx and Moses Montefiore. The list also includes Yehudi Menuhin, Helena Rubinstein, the Rothschilds and even Rosenstein himself."
                                            }
