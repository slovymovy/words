                    {
                        "sense_id": "68cf7588-97a8-34c5-be9a-b01baf642508",
                        "entry_id": "abfb38fe-835f-3f02-a398-db0d0992a7c7",
                        "glosses": [
                            "Technique associée au drainage, consistant en la création de galeries moulées dans un sol plastique suffisamment stable et débouchant dans un fossé ou une tranchée drainante très perméable."
                        ],
                        "tags": [
                            "Hydraulique",
                            "Drainage agricole"
                        ],
                        "examples": [
                            {
                                "example_id": "d493867b-4895-412b-9211-1f4951caf855",
                                "sense_id": "68cf7588-97a8-34c5-be9a-b01baf642508",
                                "text": "Les techniques associées comprennent la mise en place de drains à grand écartement et la réalisation d'opération de drainage-taupe ou de sous-solage, suivant une direction oblique par rapport aux files de drains et à la direction du labour."
                            },
                            {
                                "example_id": "67276122-c614-4e35-80f7-f2c193a1dfe5",
                                "sense_id": "68cf7588-97a8-34c5-be9a-b01baf642508",
                                "text": "Par ailleurs, le drainage-taupe n'a qu'une efficacité temporaire, limitée par les éboulements possibles de la terre non soutenue."
                            }
                        ]
                    }
                ],
