{
    "word_family": [
        "palatial"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c6f03a1-8c2c-3c95-ad9f-7608cb17775a",
                    "sense_definition": "The official home of a king, queen, president, or other high-ranking leader.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "residence_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The queen waved to the crowd from the balcony of her <w>palace</w>.",
                            "target_lang_translations": {
                                "ru": "Королева помахала толпе с балкона своего <w>дворца</w>.",
                                "zh": "女王从她<w>宫殿</w>的阳台上向人群挥手。"
                            }
                        },
                        {
                            "text": "Tourists often visit the royal <w>palace</w> to see the changing of the guard.",
                            "target_lang_translations": {
                                "ru": "Туристы часто посещают королевский <w>дворец</w>, чтобы посмотреть на смену караула.",
                                "zh": "游客经常参观皇家<w>宫殿</w>以观看卫兵换岗仪式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "castle"
                    ],
                    "common_phrases": [
                        "royal palace",
                        "presidential palace",
                        "Buckingham Palace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная резиденция короля, королевы, президента или другого высокопоставленного лидера.",
                        "zh": "君主、总统或其他高级领导人的正式官邸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворец",
                                "target_lang_sense_clarification": "резиденция правителя"
                            },
                            {
                                "target_lang_word": "чертог",
                                "target_lang_sense_clarification": "устар. пышное здание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宫殿",
                                "target_lang_sense_clarification": "统治者的正式居所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "100caf57-c646-3792-afcb-c5df5e603b65",
                    "sense_definition": "A very large, expensive, and impressive private house.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "residence_private",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After winning the lottery, they built a <w>palace</w> in the countryside.",
                            "target_lang_translations": {
                                "ru": "Выиграв в лотерею, они построили <w>дворец</w> в сельской местности.",
                                "zh": "中彩票后，他们在乡下盖了一座<w>豪宅</w>。"
                            }
                        },
                        {
                            "text": "Their new home is so huge that it feels like living in a <w>palace</w>.",
                            "target_lang_translations": {
                                "ru": "Их новый дом такой огромный, что кажется, будто живешь во <w>дворце</w>.",
                                "zh": "他们的新家太大了，感觉就像住在<w>宫殿</w>里一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mansion",
                        "manor",
                        "castle"
                    ],
                    "antonyms": [
                        "shack",
                        "hovel"
                    ],
                    "common_phrases": [
                        "live in a palace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, дорогой и впечатляющий частный дом.",
                        "zh": "非常大、昂贵且令人印象深刻的私人住宅。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворец",
                                "target_lang_sense_clarification": "роскошный дом"
                            },
                            {
                                "target_lang_word": "особняк",
                                "target_lang_sense_clarification": "большой частный дом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "豪宅",
                                "target_lang_sense_clarification": "豪华的私人住宅"
                            },
                            {
                                "target_lang_word": "宫殿般的住宅",
                                "target_lang_sense_clarification": "形容极其宽敞奢华的住所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2a8a91c-b92f-3261-9d9d-64b2f69696c1",
                    "sense_definition": "A large public building designed for entertainment or exhibitions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "building_public",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old movie <w>palace</w> has been restored to show classic films.",
                            "target_lang_translations": {
                                "ru": "Старый кинотеатр-<w>дворец</w> был отреставрирован для показа классических фильмов.",
                                "zh": "那座老电影<w>宫殿</w>已被修复，用于放映经典电影。"
                            }
                        },
                        {
                            "text": "They visited a glass <w>palace</w> that was built for the great exhibition.",
                            "target_lang_translations": {
                                "ru": "Они посетили стеклянный <w>дворец</w>, построенный для великой выставки.",
                                "zh": "他们参观了一座为大型展览而建的玻璃<w>宫殿</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "movie palace",
                        "gin palace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое общественное здание, предназначенное для развлечений или выставок.",
                        "zh": "用于娱乐或展览的大型公共建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дворец",
                                "target_lang_sense_clarification": "общественное здание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宫殿",
                                "target_lang_sense_clarification": "指代宏伟的公共建筑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c765e184-d1a7-33fe-8b27-5b0875e66a2e",
                    "sense_definition": "A nickname for the Crystal Palace Football Club.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "The fans cheered loudly when <w>Palace</w> scored the winning goal.",
                            "target_lang_translations": {
                                "ru": "Болельщики громко ликовали, когда «<w>Пэлас</w>» забил победный гол.",
                                "zh": "当<w>水晶宫</w>队打进致胜一球时，球迷们欢呼雀跃。"
                            }
                        },
                        {
                            "text": "He has been a loyal supporter of <w>Palace</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он был преданным болельщиком «<w>Пэлас</w>» более двадцати лет.",
                                "zh": "他做<w>水晶宫</w>队的忠实支持者已经超过二十年了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used by football fans"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прозвище футбольного клуба «Кристал Пэлас».",
                        "zh": "水晶宫足球俱乐部的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пэлас",
                                "target_lang_sense_clarification": "футбольный клуб"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水晶宫",
                                "target_lang_sense_clarification": "足球俱乐部名称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b43d8a9-c823-3970-8a49-5776fe6f5f4c",
                    "sense_definition": "A short name for Malacañang Palace, the official residence of the President of the Philippines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Reporters gathered outside the <w>Palace</w> waiting for the official statement.",
                            "target_lang_translations": {
                                "ru": "Репортеры собрались у <w>Дворца</w> в ожидании официального заявления.",
                                "zh": "记者们聚集在<w>马拉卡南宫</w>外，等待官方声明。"
                            }
                        },
                        {
                            "text": "The decision came directly from the <w>Palace</w> late last night.",
                            "target_lang_translations": {
                                "ru": "Решение поступило прямо из <w>Дворца</w> поздно ночью.",
                                "zh": "该决定是昨晚深夜直接从<w>马拉卡南宫</w>传出的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название дворца Малакананг, официальной резиденции президента Филиппин.",
                        "zh": "马拉卡南宫的简称，菲律宾总统的正式官邸。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Дворец",
                                "target_lang_sense_clarification": "администрация президента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "马拉卡南宫",
                                "target_lang_sense_clarification": "菲律宾总统府"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "37b629e3-47ef-37c7-b65a-64f128882288",
                    "sense_definition": "To decorate or adorn something in a magnificent way.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The winter landscape was <w>palaced</w> in white snow and ice.",
                            "target_lang_translations": {
                                "ru": "Зимний пейзаж был <w>по-царски украшен</w> белым снегом и льдом.",
                                "zh": "冬日的景色被白雪和冰霜<w>装饰</w>得如宫殿般华丽。"
                            }
                        },
                        {
                            "text": "The poet described a city <w>palaced</w> with gold and jewels.",
                            "target_lang_translations": {
                                "ru": "Поэт описал город, <w>украшенный</w> золотом и драгоценностями.",
                                "zh": "诗人描述了一座用黄金和珠宝<w>装饰</w>的城市。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать или декорировать что-либо великолепным образом.",
                        "zh": "以宏伟的方式装饰或装点某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшать",
                                "target_lang_sense_clarification": "великолепно, по-царски"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装饰",
                                "target_lang_sense_clarification": "华丽地装点"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}