                                "target_lang_word": "старый",
                                "target_lang_sense_clarification": "о следе или запахе"
                            },
                            {
                                "target_lang_word": "давно горящий",
                                "target_lang_sense_clarification": "о сигнале светофора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0c21f1f-2869-38b5-9d59-e1af0bffe980",
                    "sense_definition": "Out of date or unpaid for an unreasonable amount of time, particularly regarding checks.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bank refused to honor the <w>stale</w> cheque because it was over six months old.",
                            "target_lang_translations": {
                                "ru": "Банк отказался принять <w>просроченный</w> чек, так как ему было более шести месяцев."
                            }
                        },
                        {
                            "text": "Businesses often have policies regarding how to handle a <w>stale</w> check from a customer.",
                            "target_lang_translations": {
                                "ru": "У компаний часто есть правила относительно того, как поступать с <w>просроченными</w> чеками от клиентов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stale cheque",
                        "stale check"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Просроченный, недействительный из-за истечения срока давности (особенно о банковских чеках)."
