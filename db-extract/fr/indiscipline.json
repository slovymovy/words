                                        "entry_id": "5a369366-d8d6-3ca3-aa66-6edc96db7315",
                                        "glosses": [
                                            "Eigenschaft/Haltung/Handlungsweise, die in deutlichem Maße zeigt, dass Regeln nicht eingehalten werden, keine Disziplin vorhanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50f243ca-fe37-43b2-acb8-27ff0d6ea0ad",
                                                "sense_id": "0cb419d5-655f-351a-b12d-4c32fa2529b1",
                                                "text": "Er wurde wegen Disziplinlosigkeit vorzeitig aus dem Dienst entlassen."
                                            },
                                            {
                                                "example_id": "1c9b3496-f6d6-49d2-a1ae-fa9f7147de1a",
                                                "sense_id": "0cb419d5-655f-351a-b12d-4c32fa2529b1",
                                                "text": "Ich lasse mir Ihre Disziplinlosigkeiten nicht länger bieten!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
