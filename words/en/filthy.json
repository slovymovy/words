                                "target_lang_word": "inmundo",
                                "target_lang_sense_clarification": "extremadamente sucio, que causa asco"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e6be5ba-1b98-303c-a7da-51c9c2b2e7c0",
                    "sense_definition": "Obscene or offensive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher sent him to the principal for using <w>filthy</w> language in class.",
                            "target_lang_translations": {
                                "ru": "Учитель отправил его к директору за использование <w>непристойных</w> выражений в классе.",
                                "zh": "老师因为他在课堂上使用<w>下流</w>的语言而把他送到了校长办公室。",
                                "es": "El profesor lo envió al director por usar lenguaje <w>obsceno</w> en clase."
                            }
                        },
                        {
                            "text": "He has a <w>filthy</w> mind and turns everything into a rude joke.",
                            "target_lang_translations": {
                                "ru": "У него <w>пошлый</w> ум, и он превращает всё в грубые шутки.",
                                "zh": "他思想<w>猥亵</w>，总把什么事都变成粗俗的笑话。",
                                "es": "Tiene una mente <w>sucia</w> y convierte todo en una broma grosera."
                            }
                        }
                    ],
                    "synonyms": [
                        "smutty"
                    ],
                    "antonyms": [
                        "holy"
                    ],
                    "common_phrases": [
                        "filthy language",
                        "filthy mind",
                        "filthy joke"
                    ],
                    "target_lang_definitions": {
