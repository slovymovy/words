                        "target_lang_word": "Samtblume",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Samtblume",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                        "entry_id": "5c6786b3-1d7a-3ffe-b292-00b61d05b1cf",
                                        "glosses": [
                                            "stark aromatisch duftende Pflanze mit gelben bis braunen, oft gefüllten Blüten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf74a5c2-af6a-419c-b6ef-8e70495e5c35",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "Die Samtblume blüht in Mitteleuropa vom Juli bis Oktober."
                                            },
                                            {
                                                "example_id": "0a8f57a3-47d6-4d6f-9711-a62f78f3bb21",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "Die Samtblume ist von Mexiko und Arizona bis Argentinien verbreitet."
                                            },
                                            {
                                                "example_id": "53ff8eac-97e3-4add-92d1-1a4b3c3a26c3",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "Die stark duftende Studentenblume oder Samtblume kam ursprünglich aus Mexiko."
                                            },
                                            {
                                                "example_id": "1864f4b0-c189-40d6-b987-1d6cbebdb3c9",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "Auch an religiöser Symbolik mangelt es der Samtblume nicht."
                                            },
                                            {
                                                "example_id": "5cdaa7d2-deb1-42d6-b1d8-bb46980d953c",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "Tora hatte einen schwarzlackierten Strohhut, den vorn eine rote Samtblume zierte."
                                            },
                                            {
                                                "example_id": "06bc10aa-658a-416a-a367-3576d98db68d",
                                                "sense_id": "8a8285b5-44df-3ec4-b5d3-67a8ad1f57b4",
                                                "text": "…; besuche eine Gesellschaft weniger, stelle ein Kleid einfacher her, nimm statt der kostbaren französischen Samtblume einige frische Blüten aus deinem Garten ins Haar, und von dem, was du ersparst, kannst du so manche Kummerthräne trocknen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
