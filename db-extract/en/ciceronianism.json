                        "examples": [
                            {
                                "example_id": "56b8e940-1e87-4f8c-b106-1532a255a415",
                                "sense_id": "2817f654-b300-3c56-875c-1cd8ae07dc80",
                                "text": "And being purposed to cure her lord of his Ciceronianism by some means or another she consulted her ladies one summer evening, while they were walking together in the shady alleys that were all around the castle, as to how she should best make the duke to amend his ways and live more like a good Christian gentleman for the future."
                            },
                            {
                                "example_id": "594be85b-9547-4d41-a125-e35b5b851f0f",
                                "sense_id": "2817f654-b300-3c56-875c-1cd8ae07dc80",
                                "text": "great study in Ciceronianism, the chief abuse of Oxford"
                            }
                        ]
                    },
                    {
                        "sense_id": "5079644f-9034-3e1c-82dd-222dfa2eff63",
                        "entry_id": "cadf9ebf-ebf6-39dc-9f5e-418235ab345b",
                        "glosses": [
                            "A Ciceronian phrase or expression."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "9a32de66-2933-45a1-8866-e3bf57f0f726",
                                "sense_id": "5079644f-9034-3e1c-82dd-222dfa2eff63",
                                "text": "For had an Angel bin his discipliner, unlesse it were for dwelling too much upon Ciceronianisms, & had chastiz'd the reading, not the vanity, it had bin plainly partiall; first to correct him for grave Cicero, and not for scurrill Plautus, whom he confesses to have bin reading not long before"
                            }
                        ]
                    }
