        "nl-extract.jsonl": [
            {
                "entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                "word": "vijandschap",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a74a2e6e-2647-4cb4-bbdf-dc280f9794ab",
                        "entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "tags": [
                            "plural"
                        ],
                        "form": "vijandschappen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "glosses": [
                            "een toestand van op voet van oorlog zijn, een toestand waarin men elkaar als tegenstander ziet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b9328e0-24d3-488d-8c16-83d3083cbc77",
                                "sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                                "text": "De vijandschap tussen Joden en Palestijnse Arabieren duurt al vele jaren."
                            },
                            {
                                "example_id": "653a97af-160c-43a3-b193-962940afcc4d",
                                "sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                                "text": "Van de vijandschap die de Roodhoofden eerst getoond hadden was niets meer over. Integendeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e108158-1df9-494b-9de2-666bf68a1c6a",
                        "source_entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "source_sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "source_sense_description": "een toestand van op voet van oorlog zijn",
                        "target_lang_word": "Feindschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feindschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc5a8639-8a9a-3505-bfc2-a5634110cdd5",
                                        "entry_id": "ba81322d-90c4-35b1-8f37-7e9805553e41",
                                        "glosses": [
                                            "Gegnerschaft; feindliche Haltung/Gesinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6868e5d4-b6aa-4663-a7ec-74b62786fb13",
                                                "sense_id": "fc5a8639-8a9a-3505-bfc2-a5634110cdd5",
                                                "text": "Ich habe nur etwas Sorge, dass ich mir die Feindschaft der Mächtigen zuziehe."
                                            },
                                            {
                                                "example_id": "ae06b856-1104-4127-8321-1c86452a5756",
                                                "sense_id": "fc5a8639-8a9a-3505-bfc2-a5634110cdd5",
                                                "text": "„Die großen territorialen Erfolge hatten den Askaniern die Feindschaft aller Nachbarn eingetragen.“"
                                            },
                                            {
                                                "example_id": "6face46d-6bb3-4145-bf97-87035d02f4fd",
                                                "sense_id": "fc5a8639-8a9a-3505-bfc2-a5634110cdd5",
                                                "text": "„Diese kurze Feindschaft begründete ihre jahrelange Freundschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd7f97ed-5a42-4928-aff0-1c9560d774d5",
                        "source_entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "source_sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "source_sense_description": "een toestand van op voet van oorlog zijn",
                        "target_lang_word": "hostility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "The state of being hostile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d59f2fc-f757-4a0f-85cf-c745b6ed3b97",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "My resentment and anger towards you caused hostility and a division between us."
                                            },
                                            {
                                                "example_id": "ea990558-94ef-4c52-a74f-572894267c08",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "There is no hostilitie so excellent, as that which is absolutely Christian."
                                            },
                                            {
                                                "example_id": "bced59d3-8aa0-4a69-9d9c-dd8efade346a",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "But with Goodison Park openly directing its full hostility towards Atkinson, Liverpool went ahead when Carroll turned in his first Premier League goal of the season after 70 minutes."
                                            },
                                            {
                                                "example_id": "c080f4fe-3a47-4e2e-a9af-933eec9ccc11",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "The polarization of wealth and the polarization of attitudes to diversity are not unrelated. A key reason for popular hostility to immigrants is that to many people, particularly within working-class communities, immigration has become a symbol of unacceptable change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "A hostile action, especially a military action. See hostilities for specific plural definition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb4c81c-aec6-4f2b-a0b6-e46a68b42b43",
                                                "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                                "text": "As the revivals died down in the 1740s, the revivalist camp made concessions to their opponents, admonished prorevivalists who continued with the hostilities, and generally sought to heal divisions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "447417e1-b828-4455-a6a0-1f4154d5748b",
                        "source_entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "source_sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "source_sense_description": "een toestand van op voet van oorlog zijn",
                        "target_lang_word": "enmity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enmity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                        "entry_id": "12fd08e1-9d6f-3973-92f8-3e0f3685a9df",
                                        "glosses": [
                                            "The quality of being an enemy; hostile or unfriendly disposition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9184aa39-fb49-4168-a0c3-480b397201b2",
                                                "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                                "text": "We know from their literature that to our Saxon ancestors waste places of moor and forest and marshes were the resort of a host of supernatural creatures at enmity with mankind."
                                            },
                                            {
                                                "example_id": "aaf74400-f5de-4982-8d98-43819a3e1a9d",
                                                "sense_id": "8dc9c99e-f98b-3375-bbe6-b4670834b158",
                                                "text": "Some later Muses from Ionia and Sicily reckoned it safest to weave together both versions and say that that which is both many and one, held together by both enmity and amity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                        "entry_id": "12fd08e1-9d6f-3973-92f8-3e0f3685a9df",
                                        "glosses": [
                                            "A state or feeling of opposition, hostility, hatred or animosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c668352-700d-4673-8941-f90d62a22d20",
                                                "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                                "text": "I merely repeat, remember always your duty of enmity towards Man and all his ways."
                                            },
                                            {
                                                "example_id": "91b2cad2-b6de-4ed9-b458-b18fc579aed9",
                                                "sense_id": "0f12af84-c875-35e7-a158-5ac920fa8c08",
                                                "text": "Maybe only a system that can contain the deep enmity between people who spell the metal aluminum and those who spell it aluminium is up to the task of preserving our fragile democratic institutions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b5009fc-88be-482a-ad8c-d1803e8c847c",
                        "source_entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "source_sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "source_sense_description": "een toestand van op voet van oorlog zijn",
                        "target_lang_word": "inimitié",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inimitié",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d97bccbf-d16c-3564-8a7a-0be6669c8ffb",
                                        "entry_id": "0a85f19d-7bc4-3870-b339-5d3be3b6d282",
                                        "glosses": [
                                            "Aversion qu’on a pour quelqu’un, et qui ordinairement dure longtemps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3dddd05-1704-44fe-9934-09dd2011c12a",
                                                "sense_id": "d97bccbf-d16c-3564-8a7a-0be6669c8ffb",
                                                "text": "Il n’y a plus aujourd’hui d’inimitiés irréconciliables, parce qu’il n’y a plus de sentiments désintéressés : c’est un bien né d’un mal."
                                            },
                                            {
                                                "example_id": "53e662ef-f522-4ef6-a1d3-6fe43a4aad8c",
                                                "sense_id": "d97bccbf-d16c-3564-8a7a-0be6669c8ffb",
                                                "text": "Le sujet de la profonde inimitié qui régnait entre les Reybert et les Moreau provenait d’une blessure faite par Mme de Reybert à Mme Moreau, par suite d’une première pointillerie que s’était permise la femme du régisseur à l’arrivée des Reybert, afin de ne pas laisser entamer sa suprématie par une femme née de Corroy."
                                            },
                                            {
                                                "example_id": "91856e58-339f-4609-8ddf-f6ee2634f586",
                                                "sense_id": "d97bccbf-d16c-3564-8a7a-0be6669c8ffb",
                                                "text": "Les inimitiés d’un homme en disent souvent plus long que ses accointances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56fd9f6f-fbae-3f52-80fc-2013d1d8f954",
                                        "entry_id": "0a85f19d-7bc4-3870-b339-5d3be3b6d282",
                                        "glosses": [
                                            "Antipathie naturelle qui existe entre certains animaux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe35559-d279-494c-8aaa-90e7dfd69173",
                                                "sense_id": "56fd9f6f-fbae-3f52-80fc-2013d1d8f954",
                                                "text": "Il y a de l’inimitié, une inimitié naturelle entre le chien et le chat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb073ae9-d4bf-430b-a2a2-a484a69c05f5",
                        "source_entry_id": "e5546440-32e9-38b0-a536-9c059e84a764",
                        "source_sense_id": "7f1ac309-ba68-39a0-b701-a4bb370371a1",
                        "source_sense_description": "een toestand van op voet van oorlog zijn",
                        "target_lang_word": "hostilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Acte d’un ennemi ou état de guerre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c03b0e-e578-4116-b759-4e26065458d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Un commencement d’hostilités, commencer les hostilités."
                                            },
                                            {
                                                "example_id": "24657e8c-d769-4f5f-8092-9dd6da6e5da9",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Suspendre les hostilités."
                                            },
                                            {
                                                "example_id": "5594bd17-f1ab-431c-ae7c-999762fcd6d0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "Le monde entier prenait part aux hostilités, sans pouvoir envisager la possibilité d’une paix prochaine, sans même l’espoir de recouvrer jamais la paix."
                                            },
                                            {
                                                "example_id": "fa481410-6422-4c62-ad86-1a22907232f0",
                                                "sense_id": "5ad68bf4-92bb-34bc-8e7b-96799ab2a500",
                                                "text": "L'Autriche déclarait en outre, qu'elle trouvait inadmissible que, dans l'article 3, les puissances se congratulassent de la signature de la paix entre la Prusse et le Danemarck, les hostilités ayant formellement repris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Comportement d’inimitié ou d’opposition ; disposition hostile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a36321f-b4d0-4dd7-94ee-7449cf69738a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Voici, pour commencer, ce que j’écrivais, il y a six ans, dans un livre de colère que l’hostilité générale s’efforça d’étouffer par tous les moyens imaginables."
                                            },
                                            {
                                                "example_id": "5f1dc349-91c2-4ac6-bcb5-14c3d54fe625",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "L’indifférence en matière de foi était devenue de règle, car d’hostilité on n’en sentait point trop encore ; à peine sourdait-elle, peut-être, dans quelques propos sacrilèges que les mauvaises langues : […], s’essayaient malicieusement dans l’ombre à propager."
                                            },
                                            {
                                                "example_id": "f6d22563-06c5-4ad0-8066-790c375a6c6b",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Pavlov ne s’est pas borné à abdiquer simplement la psychologie en tant que science. Il voyait naître en lui le sentiment d’hostilité irréconciliable envers cette « alliée de la physiologie » qui n’a pas fait ses preuves."
                                            },
                                            {
                                                "example_id": "056d800d-0095-4f69-a9b3-10fb5abe728c",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Victime de l’hostilité d’Arago en France et de Humboldt en Allemagne, Paravey a la mentalité d'un persécuté. Il se plaint dès 1835 « de sourdes et odieuses manœuvres qui tendent sans cesse à se renouveler. »"
                                            },
                                            {
                                                "example_id": "25c40919-ceca-4be6-a962-dae008b7036a",
                                                "sense_id": "c5e4ce06-4540-300d-9bf5-13dd468cca99",
                                                "text": "Il n’y avait pas encore de déclin appréciable dans l’influence des ordres soufis. L’hostilité que leur manifestaient les wahhabites avait peu de poids en dehors de l’Arabie centrale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                        "entry_id": "d77f7115-6660-3847-889f-f03831e27b03",
                                        "glosses": [
                                            "Sentiment d’animosité, déclaré ou dissimulé, qui incline une personne à l’agression."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7844982-3108-4e9d-83a5-be0541af86b2",
                                                "sense_id": "13d7421c-bf1d-388f-b8cf-378640130cbd",
                                                "text": "Il éprouvait pour elle une hostilité à peine voilée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
