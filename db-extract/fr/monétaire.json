                        "source_sense_id": "9e9e3b0f-99b5-3bbe-8d3a-d85b9218431a",
                        "target_lang_word": "monetary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monetary",
