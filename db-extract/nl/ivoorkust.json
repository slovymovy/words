                                                "example_id": "71024424-b44b-4275-aa5d-0e097588da92",
                                                "sense_id": "4b7b1f29-d440-33bf-90c9-3e363097368e",
                                                "text": "„Ojukwu floh in die Elfenbeinküste und Biafra wurde am 15. Januar 1970 wieder in Nigeria integriert.“"
                                            },
                                            {
                                                "example_id": "defa8255-e85d-4aa5-9800-af1e0ed1f80c",
                                                "sense_id": "4b7b1f29-d440-33bf-90c9-3e363097368e",
                                                "text": "„Der Mann von der Elfenbeinküste steht wieder neben mir.“"
                                            }
                                        ],
