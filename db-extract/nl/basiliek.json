                        ],
                        "form": "basiliekjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3503efd6-c681-3eae-a739-1eb5b142af4b",
                        "entry_id": "88487db4-507e-3b70-9624-486327e9cffe",
                        "glosses": [
                            "een ere-titel voor een Katholieke Kerk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25f7ee0a-f62a-4db7-96e1-ec06cd609467",
                                "sense_id": "3503efd6-c681-3eae-a739-1eb5b142af4b",
                                "text": "In Almelo staat een basiliek."
                            },
                            {
                                "example_id": "2c48cee3-ad1f-45c1-b096-9b2455d4dee4",
                                "sense_id": "3503efd6-c681-3eae-a739-1eb5b142af4b",
                                "text": "Ik keek. De gestrenge gevels met de arcades stuurden de blik met majesteitelijk gezag in de richting van de basiliek van San Marco, die met haar koepels en ronde vormen een bubbelend en bijna buitenaards contrast vormde met het wereldse machtsvertoon van het plein."
                            },
                            {
                                "example_id": "a1e1b87a-e66a-4232-b623-af0f96d428aa",
                                "sense_id": "3503efd6-c681-3eae-a739-1eb5b142af4b",
                                "text": "Toen de deuren van de basiliek van de stad vanochtend om zes uur opengingen, hadden zich al enige duizenden mensen verzameld. Verwacht wordt dat rond de honderdduizend mensen de kerk zullen aandoen. De organisatoren verwachten zelfs bussen uit Slovenië, Polen en Libanon."
                            }
                        ]
                    },
                    {
                        "sense_id": "5489a4bf-146d-36cc-990f-74ca164dc2f7",
                        "entry_id": "88487db4-507e-3b70-9624-486327e9cffe",
                        "glosses": [
                            "een rechthoekig meerschepige kerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81395fa4-a611-4122-bc7f-d65577483080",
                                "sense_id": "5489a4bf-146d-36cc-990f-74ca164dc2f7",
                                "text": "De basiliek stamt af van de basilica uit de romeinse tijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fef3e3a5-e483-476f-a378-d576d1e518c6",
                        "source_entry_id": "88487db4-507e-3b70-9624-486327e9cffe",
                        "target_lang_word": "Basilika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basilika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6f5a34eb-dab7-3bcf-82e7-94b34ff15e4b",
                                        "entry_id": "fb33149b-f1d4-3987-a21a-3d85679c862a",
                                        "glosses": [
                                            "ein öffentliches, langgestrecktes Hallengebäude mit überhöhtem, mit Fenstern versehenem Mittelschiff und an den Langseiten befindlichen durch Pfeiler oder Säulen getrennten Seitenschiffen"
                                        ],
                                        "tags": [
                                            "Griechisch-römische"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11cef3af-6522-4bb3-8c70-c0960442772b",
                                                "sense_id": "6f5a34eb-dab7-3bcf-82e7-94b34ff15e4b",
                                                "text": "Die griechisch-römischen Basiliken dienten profanen Zwecken wie dem Markt- oder Börsenverkehr oder als Ort für Gerichtsverhandlungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0a86e1a7-2f62-3f6a-af25-954622a4389a",
                                        "entry_id": "fb33149b-f1d4-3987-a21a-3d85679c862a",
                                        "glosses": [
                                            "eine Kirche der frühchristlichen Zeit"
                                        ],
                                        "tags": [
                                            "Frühchristliche Architektur",
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a65c52d-bf90-423d-8d53-c36df4ea2ff0",
                                                "sense_id": "0a86e1a7-2f62-3f6a-af25-954622a4389a",
                                                "text": "„Das Christentum übernahm seit dem 4. Jahrhundert in modifizierter Form die Anlage der profanen Basilika als Sakralraum; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "91447183-3fd8-35b3-8589-4e6491aa36c3",
                                        "entry_id": "fb33149b-f1d4-3987-a21a-3d85679c862a",
                                        "glosses": [
                                            "ein großes Kirchengebäude, dessen Seitenschiffe niedriger und durch Säulen oder Pfeiler vom Hauptschiff abgetrennt sind"
                                        ],
                                        "tags": [
                                            "Christliche Architektur",
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a8279d0-8240-4595-a28b-5925633a16f5",
                                                "sense_id": "91447183-3fd8-35b3-8589-4e6491aa36c3",
                                                "text": "„Im heutigen Sprachgebrauch versteht man unter Basilika zum Unterschied von Hallenkirche einen längsgerichteten Kirchenbau, dessen Mittelraum über die seitlich angefügten Portiken emporragt, der durch den damit verbundenen Lichtgaden eine zentrale Lichtzufuhr erhält und an der durch den Altar betonten Schmalseite mittels einer Apsis abgeschlossen wird.“"
                                            },
                                            {
                                                "example_id": "b4ca37ec-8a4c-48a6-aa92-b414c8bc8ae7",
                                                "sense_id": "91447183-3fd8-35b3-8589-4e6491aa36c3",
                                                "text": "Die Basilika ist renovierungsbedürftig."
                                            },
                                            {
                                                "example_id": "38054c8b-3e0e-43b6-bae5-89bc4e19a396",
                                                "sense_id": "91447183-3fd8-35b3-8589-4e6491aa36c3",
                                                "text": "„Wie roh die Basilika war, überhaupt nicht schön.“"
                                            },
                                            {
                                                "example_id": "3af7a24e-bfbd-45b8-8ee2-6d0f3374179f",
                                                "sense_id": "91447183-3fd8-35b3-8589-4e6491aa36c3",
                                                "text": "„Ich fragte sie, ob sie mit mir in die Basilika ›Nuestra Señora de Atocha‹ gehen wolle; sie zeigte sich gern bereit und warf ihrem Vater einen Blick zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "901bbbde-498f-3d4f-9bdb-98b7efc6fd7f",
                                        "entry_id": "fb33149b-f1d4-3987-a21a-3d85679c862a",
                                        "glosses": [
                                            "Titel für eine Kirche von herausgehobener Bedeutung, die diese entweder durch die Tradition (Patriarchalbasiliken, Basilicae majores) oder durch die Ernennung durch einen Papst (Basilicae minores) erworben hat"
                                        ],
                                        "tags": [
                                            "Katholische Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74ae126f-d4a6-487a-a5be-e80e5fccbe2b",
                                                "sense_id": "901bbbde-498f-3d4f-9bdb-98b7efc6fd7f",
                                                "text": "Seit dem 18. Jahrhundert wird das Wort \"Basilika\" als auszeichnender Titel für besonders herausragende Kirchen benutzt."
                                            },
                                            {
                                                "example_id": "f268fec5-fa78-41bc-8639-d686b5d8d51a",
                                                "sense_id": "901bbbde-498f-3d4f-9bdb-98b7efc6fd7f",
                                                "text": "Papst Benedikt XVI. hat die Sagrada Família am 7. November 2010 in den Rang einer Basilika erhoben."
                                            },
                                            {
                                                "example_id": "8c8276c1-2102-4443-b477-8c920a973a7e",
                                                "sense_id": "901bbbde-498f-3d4f-9bdb-98b7efc6fd7f",
                                                "text": "„Die große Basilika des Petersdoms war beeindruckend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
