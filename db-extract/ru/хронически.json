                                                "sense_id": "3ad5a734-5a6d-3391-bb2b-01270ae95f25",
                                                "text": "Der Patient leidet unter chronischer Epilepsie."
                                            },
                                            {
                                                "example_id": "f8c7ab76-b376-4abb-a180-331aab7e7487",
                                                "sense_id": "3ad5a734-5a6d-3391-bb2b-01270ae95f25",
                                                "text": "Vielen behinderten und chronisch kranken Studenten sieht man die Beeinträchtigung nicht an."
                                            },
                                            {
                                                "example_id": "11b33038-db44-4345-a5ef-8de04079532a",
                                                "sense_id": "3ad5a734-5a6d-3391-bb2b-01270ae95f25",
                                                "text": "Menschen mit chronischen Schmerzen können Cannabis zur Eigentherapie anbauen."
                                            }
                                        ],
