                ],
                "senses": [
                    {
                        "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                        "entry_id": "79bc8886-855d-3c09-90f7-d927a04f9217",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc1d2a01-170d-44a6-8144-15cc15fa52be",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Frau Wober ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e5b645b-3e46-4de9-ba27-cf5b489a3235",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Herr Wober wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a5951649-62d9-46b5-b59e-7c7b5cd42da0",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Die Wobers kommen heute aus Mainz."
                            },
                            {
                                "example_id": "80610d2f-79e6-4604-b466-9ec51a71e2a5",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Der Wober trägt nie die Schals, die die Wober ihm strickt."
                            },
                            {
                                "example_id": "2ee3f36d-7a60-4691-b1e4-f6c68af6572b",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wober kommt, geht der Herr Wober.“"
                            },
                            {
                                "example_id": "4eaba572-21cf-4683-a8fc-da796a8406f6",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Wober kommt und geht."
                            },
                            {
                                "example_id": "2e5c0ace-eeae-4c8b-876a-8a27998914ed",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "Wobers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "88f42851-757b-4051-8814-97672c844ba1",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "An verregneten Herbsttagen ist Familie Wobers liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "5f32d603-2d84-43b8-bfb3-57e469869814",
                                "sense_id": "e71235f4-25c2-3844-ae4a-35af04305cd7",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Wober das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
