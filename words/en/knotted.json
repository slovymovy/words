{
    "word_family": [
        "knot",
        "knotty"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a650e781-fed8-3662-900b-3b6a663d7905",
                    "sense_definition": "Tied in knots.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "knot_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>knotted</w> rope was strong enough to hold the heavy boat.",
                            "target_lang_translations": {
                                "zh": "那根<w>打结的</w>绳子足够结实，能拴住那艘重船。"
                            }
                        },
                        {
                            "text": "She struggled to untie the <w>knotted</w> string on the package.",
                            "target_lang_translations": {
                                "zh": "她费力地解开包裹上<w>打结的</w>细绳。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangled"
                    ],
                    "antonyms": [
                        "untied"
                    ],
                    "common_phrases": [
                        "knotted rope",
                        "knotted string"
                    ],
                    "target_lang_definitions": {
                        "zh": "打成结的；系成结的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打结的",
                                "target_lang_sense_clarification": "形容物体被系上了结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "627edacf-db37-3200-bc97-da6a27257070",
                    "sense_definition": "Tangled or matted, especially referring to hair or fibers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "knot_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her hair was <w>knotted</w> after the long day at the beach.",
                            "target_lang_translations": {
                                "zh": "在海滩度过漫长的一天后，她的头发都<w>打结了</w>。"
                            }
                        },
                        {
                            "text": "The brush could not get through the <w>knotted</w> hair.",
                            "target_lang_translations": {
                                "zh": "梳子梳不通那些<w>纠结的</w>头发。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tangled",
                        "matted",
                        "snarled"
                    ],
                    "antonyms": [
                        "smooth"
                    ],
                    "common_phrases": [
                        "knotted hair"
                    ],
                    "target_lang_definitions": {
                        "zh": "纠缠在一起的，尤指头发或纤维"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打结的",
                                "target_lang_sense_clarification": "形容头发或纤维纠缠成团"
                            },
                            {
                                "target_lang_word": "纠结的",
                                "target_lang_sense_clarification": "形容头发凌乱、缠绕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a76f8ef3-12cc-3d49-a42a-f443fc8d5574",
                    "sense_definition": "Full of knots or having a rough, bumpy texture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "knot_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter chose a piece of <w>knotted</w> wood for the rustic table.",
                            "target_lang_translations": {
                                "zh": "木匠选了一块<w>多节的</w>木头来制作那张乡村风格的桌子。"
                            }
                        },
                        {
                            "text": "The <w>knotted</w> surface of the old oak tree felt very rough.",
                            "target_lang_translations": {
                                "zh": "那棵老橡树<w>多节的</w>表面摸起来非常粗糙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knotty"
                    ],
                    "common_phrases": [
                        "knotted wood"
                    ],
                    "target_lang_definitions": {
                        "zh": "多节的；表面粗糙不平的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多节的",
                                "target_lang_sense_clarification": "形容木材等表面有许多节疤"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dbea2aa4-375b-3eac-b040-fb8134ed6c19",
                    "sense_definition": "Having the shape or form of a knot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "knot_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>knotted</w> muscle in his shoulder from working too hard.",
                            "target_lang_translations": {
                                "zh": "因为工作太劳累，他肩膀上的肌肉<w>结成块了</w>。"
                            }
                        },
                        {
                            "text": "The old man had a <w>knotted</w> nose that looked like a piece of ginger.",
                            "target_lang_translations": {
                                "zh": "老人的鼻子<w>结节状的</w>，看起来像一块姜。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "knotted muscle"
                    ],
                    "target_lang_definitions": {
                        "zh": "呈结状的；隆起的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "结状的",
                                "target_lang_sense_clarification": "形容形状像结一样隆起"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d8cf672f-297a-3433-84e8-186e56c0b99d",
                    "sense_definition": "Simple past and past participle of <w>knot</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "knot_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>knotted</w> the laces together so they would not come undone.",
                            "target_lang_translations": {
                                "zh": "他把鞋带<w>打结</w>系在一起，这样它们就不会松开了。"
                            }
                        },
                        {
                            "text": "The fisherman <w>knotted</w> the net to repair the large hole.",
                            "target_lang_translations": {
                                "zh": "渔夫通过<w>打结</w>来修补渔网上的大洞。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "knotted laces"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "打结（knot的过去式及过去分词）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打结",
                                "target_lang_sense_clarification": "动词，指系上结"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}