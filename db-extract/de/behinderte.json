                        "glosses": [
                            "weibliche Person mit einer starken und dauerhaften körperlichen und/oder geistigen Beeinträchtigung der gesellschaftlichen und wirtschaftlichen Teilhabe"
                        ],
                        "tags": [],
                        "examples": [
