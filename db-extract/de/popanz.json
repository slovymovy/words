                            "singular"
                        ],
                        "form": "den Popanz"
                    },
                    {
                        "form_id": "b73061e3-0ef0-4847-9048-1c7665c18ddf",
                        "entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Popanze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e442adde-fe81-31ea-8027-a763814f0294",
                        "entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "glosses": [
                            "eine nicht ganz ernst zu nehmende Schreckgestalt, mithin eine spaßige Figur oder Strohpuppe oder Vogelscheuche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3477fbf8-c4d2-41c7-be12-a03a4780853c",
                                "sense_id": "e442adde-fe81-31ea-8027-a763814f0294",
                                "text": "„Ich bin zum Beispiel durchaus kein Popanz, kein Moral-Ungeheuer, – ich bin sogar eine Gegensatz-Natur zu der Art Mensch, die man bisher als tugendhaft verehrt hat.“ (Nietzsche, Ecce Homo, Vorwort)"
                            },
                            {
                                "example_id": "62277a5a-4d67-455c-9f2c-4b52c8f1c775",
                                "sense_id": "e442adde-fe81-31ea-8027-a763814f0294",
                                "text": "„Die Knaben machten nämlich aus Stroh eine menschliche Figur, behingen sie mit Lumpen, steckten diesen Popanz an eine Stange und trieben ihn so mit großem Geschrei und unter Absingung eines besonderen Reims durch die Stadt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c7346f89-756e-3518-a496-8e0059d86486",
                        "entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "glosses": [
                            "ein willenloses Geschöpf, eine unselbstständige Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e108ad02-0dcd-44a2-b066-a0d8693e29e0",
                                "sense_id": "c7346f89-756e-3518-a496-8e0059d86486",
                                "text": "Sollen wir uns zum Popanz der Regierenden machen?"
                            },
                            {
                                "example_id": "39e7c617-84ea-4c8c-866d-2aed61af92f3",
                                "sense_id": "c7346f89-756e-3518-a496-8e0059d86486",
                                "text": "Ich lasse mich von dir doch nicht zum Popanz machen!"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "87be2b09-3e5d-3b67-bb06-143e897c84b7",
                        "entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "glosses": [
                            "eine Person, die sich vor anderen fürchtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af06962-e170-4d67-b2ad-78d9782ba486",
                                "sense_id": "87be2b09-3e5d-3b67-bb06-143e897c84b7",
                                "text": "Er ist ein solcher Popanz."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "a3682ff7-da46-3f2d-8bc4-c9663f7cbdd3",
                        "entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "glosses": [
                            "Wichtigtuer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b420b38-de19-4d82-9884-cb9c35dfadf6",
                                "sense_id": "a3682ff7-da46-3f2d-8bc4-c9663f7cbdd3",
                                "text": "Heute kehrt er aber wirklich den Popanz raus. Könnte ihn bitte einmal jemand stoppen?"
                            },
                            {
                                "example_id": "10173dfc-70f3-4636-b149-5b6e7a822673",
                                "sense_id": "a3682ff7-da46-3f2d-8bc4-c9663f7cbdd3",
                                "text": "„So sank ein Popanz der Macht, ein Großsprecher nach dem andern hin, während ein teuflischer Gestank aufstieg.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02e2dcc3-3ec9-488b-94ad-139d61146a36",
                        "source_entry_id": "6c7d6608-dbef-3197-8dbb-590e9baddf5e",
                        "source_sense_id": "e442adde-fe81-31ea-8027-a763814f0294",
                        "target_lang_word": "bugbear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bugbear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db1c18d1-6565-37ae-928e-879a70b597ea",
                                        "entry_id": "9c5569c8-21fa-34c3-804d-803592df3c16",
                                        "glosses": [
                                            "An ongoing problem; a recurring obstacle or adversity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc7e337-8242-4b3a-a905-01e7426a5ddb",
                                                "sense_id": "db1c18d1-6565-37ae-928e-879a70b597ea",
                                                "text": "Stone ballast is now used throughout the main line, and has the additional advantage of eliminating the previous bugbear of dust."
                                            },
                                            {
                                                "example_id": "cc0a8154-c811-434d-849a-47458bd7bc86",
                                                "sense_id": "db1c18d1-6565-37ae-928e-879a70b597ea",
                                                "text": "Level crossings are the bugbear of railway operation at Hull. There are no fewer than 16 within the city boundary."
                                            },
                                            {
                                                "example_id": "ed050b4f-5a8b-4067-b44b-8d70f84af88a",
                                                "sense_id": "db1c18d1-6565-37ae-928e-879a70b597ea",
                                                "text": "Next, they operate in constrained worlds. Apple is a particular bugbear for Mr Zuckerberg and Mr Sweeney."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa7d8a7-cc38-317a-89ea-51cf07d9f5d7",
                                        "entry_id": "9c5569c8-21fa-34c3-804d-803592df3c16",
                                        "glosses": [
                                            "A source of dread; resentment; or irritation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae9fa46-1a76-47b6-8f07-34075165722f",
                                                "sense_id": "aaa7d8a7-cc38-317a-89ea-51cf07d9f5d7",
                                                "text": "What has this Bugbear Death to frighten Man,\nIf Souls can die, as well as Bodies can?"
                                            },
                                            {
                                                "example_id": "1fc69154-537b-403f-bf9c-f86ca4fc748d",
                                                "sense_id": "aaa7d8a7-cc38-317a-89ea-51cf07d9f5d7",
                                                "text": "But, to the world no bugbear is so great\nAs want of figure and a small estate."
                                            },
                                            {
                                                "example_id": "7fb5b8de-da20-43cb-b28c-b6f8b54cd022",
                                                "sense_id": "aaa7d8a7-cc38-317a-89ea-51cf07d9f5d7",
                                                "text": "What have I done to be made a bugbear of, and to be shunned and dreaded as if I brought the plague?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "009e8444-bea6-3f30-95fe-9c37b51d375d",
                                        "entry_id": "9c5569c8-21fa-34c3-804d-803592df3c16",
                                        "glosses": [
                                            "A generic creature, often described as a large goblin, meant to inspire fear in children."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b7b7ee3-c737-4af9-9ee9-4fe03dc74c11",
                                                "sense_id": "009e8444-bea6-3f30-95fe-9c37b51d375d",
                                                "text": "Ha, ha: alas poore wretch: a poore Chipochia, haſt not ſlept to night? would he not (a naughty man) let it ſleepe: a bug-beare take him."
                                            },
                                            {
                                                "example_id": "8d4e0188-304c-4eb8-aac6-ab996b0959e3",
                                                "sense_id": "009e8444-bea6-3f30-95fe-9c37b51d375d",
                                                "text": "“How could you lie so glaringly as to affirm I hated the ‘poor child’? and invent bugbear stories to terrify her from my door-stones?[…]”"
                                            },
                                            {
                                                "example_id": "ca72d7c7-3172-40b6-a340-6a421a842774",
                                                "sense_id": "009e8444-bea6-3f30-95fe-9c37b51d375d",
                                                "text": "\"My young friends,\" quietly replied Jason, \"I do not wonder that you think the dragon very terrible. You have grown up from infancy in the fear of this monster, and therefore still regard him with the awe that children feel for the bugbears and hobgoblins which their nurses have talked to them about.[…]\""
                                            },
                                            {
                                                "example_id": "b828c638-1eff-47e1-8db4-a5b7f5ddb5d9",
                                                "sense_id": "009e8444-bea6-3f30-95fe-9c37b51d375d",
                                                "text": "The partisans of the Administration object to the word “imperialism,” calling it a mere bugbear having no real existence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bugbear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e6a95ac-3742-3e96-9932-af440cf94b89",
                                        "entry_id": "5ca2167b-f540-3c66-a648-34a4bcedd137",
                                        "glosses": [
                                            "To alarm with idle phantoms."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
