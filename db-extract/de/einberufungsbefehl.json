                "senses": [
                    {
                        "sense_id": "e9a72815-5385-3939-a1b8-a0536743bf5c",
                        "entry_id": "227a6947-3ee1-3fd6-a25c-3c357c2618da",
                        "glosses": [
                            "amtliche Aufforderung, sich bei der Truppe zu melden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f001de8-a786-4343-b69d-ad79882aec19",
                                "sense_id": "e9a72815-5385-3939-a1b8-a0536743bf5c",
                                "text": "„Diesmal suchte ich das Haus nicht nach Einberufungsbefehlen ab.“"
                            },
                            {
                                "example_id": "84274c5d-60df-4ec6-b31f-481f4f486a32",
                                "sense_id": "e9a72815-5385-3939-a1b8-a0536743bf5c",
                                "text": "„Bald bekam auch Johann als Reservist seinen Einberufungsbefehl und wurde ins Reich eingezogen.“"
                            },
                            {
                                "example_id": "e6c856ad-96cf-4cd6-b071-b7bf4cc40910",
                                "sense_id": "e9a72815-5385-3939-a1b8-a0536743bf5c",
                                "text": "„Nachdem am 1. August 1914 um 17 Uhr die Generalmobilmachung in Deutschland verkündet wurde, bekam Onkel August umgehend den Einberufungsbefehl.“"
                            },
                            {
                                "example_id": "d1877de3-e725-481d-a8ee-0cbdd4f911ff",
                                "sense_id": "e9a72815-5385-3939-a1b8-a0536743bf5c",
                                "text": "„Als Philip Finkel seinen Einberufungsbefehl bekam, änderte er seinen Namen in Bara und machte sich auf den Weg zu seinem älteren Bruder Nathan, der in Elisabeth, New Jersey, lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
