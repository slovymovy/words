                "senses": [
                    {
                        "sense_id": "4b361b8e-9540-3a2b-bed2-e735098c9998",
                        "entry_id": "b0fd1608-9236-3bad-a6f9-b56084a1e8c6",
                        "glosses": [
                            "kleines Körnchen, Partikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9460ae1c-2476-4953-b306-a71525fd2ee7",
                                "sense_id": "4b361b8e-9540-3a2b-bed2-e735098c9998",
                                "text": "„Die weiche Ausleuchtung lässt jede Unebenheit und jedes Stäubchen hell aufleuchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ba0aea47-deb5-3371-99d4-74419074458a",
                        "entry_id": "b0fd1608-9236-3bad-a6f9-b56084a1e8c6",
                        "glosses": [
                            "einzelnes Staubkorn/Staubteilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2f0be2-ac5e-4419-af3d-0b2c3656f118",
                                "sense_id": "ba0aea47-deb5-3371-99d4-74419074458a",
                                "text": "Da sie jedes Stäubchen aufregte, musste sie tagtäglich immer wieder Staub wischen."
                            },
                            {
                                "example_id": "a7c93b9f-f234-4814-8f56-4f1534471f94",
                                "sense_id": "ba0aea47-deb5-3371-99d4-74419074458a",
                                "text": "„Kein Stäubchen lag auf den Möbeln, aber auch kein Hauch einer Erinnerung.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "5bf3f934-36d1-3041-a8cf-e96c2935456d",
                        "entry_id": "b0fd1608-9236-3bad-a6f9-b56084a1e8c6",
                        "glosses": [
                            "eine Prise"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c028979-331f-4c95-ab34-8dc6b5d750a3",
                                "sense_id": "5bf3f934-36d1-3041-a8cf-e96c2935456d",
                                "text": "„Die wird gesalzen, »ein Stäubchen Zucker macht die Zwiebeln mild.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0305821-df5c-4fc4-9d76-6f60cdd49abd",
                        "source_entry_id": "b0fd1608-9236-3bad-a6f9-b56084a1e8c6",
                        "source_sense_id": "4b361b8e-9540-3a2b-bed2-e735098c9998",
