                        "form": "^((h aspiré))\\ɔ.jo\\"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bd77e809-78f7-3937-a10a-e4bb0116cbf8",
                        "entry_id": "3ec188de-410d-3ad0-8227-842e936dd86d",
                        "glosses": [
                            "Houe à lame forte, aplatie, à deux fourchons, qui était employée au défoncement des terrains et aux façons de la petite culture qui demandent le plus de force."
                        ],
                        "tags": [
                            "Histoire des techniques"
                        ],
                        "examples": [
                            {
                                "example_id": "71d68a9d-cc70-40fa-81ec-e693ce0b5b78",
                                "sense_id": "bd77e809-78f7-3937-a10a-e4bb0116cbf8",
                                "text": "N'allez pas croire que Pomone et Vertumne vous sachent beaucoup de gré d’avoir sauté en leur honneur […] il n'y a d’autre Pomone ni d’autre Vertumne que la bêche et le hoyau du jardinier."
                            },
                            {
                                "example_id": "cb511335-d2ee-46bd-a720-aa1b8e021c8d",
                                "sense_id": "bd77e809-78f7-3937-a10a-e4bb0116cbf8",
                                "text": "Plus loin des hommes réunis deux à deux binent la terre avec des hoyaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "8479eb11-027a-3cdb-a29f-29b94be7225a",
                        "entry_id": "3ec188de-410d-3ad0-8227-842e936dd86d",
                        "glosses": [
                            "Le même outil avec un fer de pioche."
                        ],
                        "tags": [
                            "Parfois"
                        ],
                        "examples": [
                            {
                                "example_id": "947a7480-908c-4bd8-8e8e-3c6aed98179c",
                                "sense_id": "8479eb11-027a-3cdb-a29f-29b94be7225a",
                                "text": "Le hoyau ou piochon est en quelque sorte une demi-pioche ; la moitié tranchante du fer subsiste seule."
                            },
                            {
                                "example_id": "1e7cb922-0031-4cba-8ddd-dc4836f5d274",
                                "sense_id": "8479eb11-027a-3cdb-a29f-29b94be7225a",
                                "text": "D’un coup sec de hoyau qui éventre la glaise, elle plante des patates."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42174dbc-dbe2-4363-89bb-aa86befc7f8b",
                        "source_entry_id": "3ec188de-410d-3ad0-8227-842e936dd86d",
                        "target_lang_word": "Haue",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haue",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01753d65-f91f-3e4d-bdd2-1bf3f6378e2e",
                                        "entry_id": "4e573a36-92e9-39f8-a278-357592e95d5b",
                                        "glosses": [
                                            "Prügel, Hiebe"
                                        ],
