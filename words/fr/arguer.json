{
    "word_family": [
        "argument",
        "argumentaire",
        "argumentatif",
        "argumentation",
        "argumenter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48cb178d-8317-3820-9fe6-20f9f7b889e9",
                    "sense_definition": "Affirmer ou soutenir quelque chose pour appuyer son raisonnement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense <w>argue</w> que son client ignorait tout de cette transaction financière douteuse."
                        },
                        {
                            "text": "Pour justifier son absence imprévue, il <w>argua</w> timidement qu'un contretemps familial l'avait retenu."
                        }
                    ],
                    "synonyms": [
                        "alléguer",
                        "avancer",
                        "prétendre",
                        "soutenir"
                    ],
                    "common_phrases": [
                        "arguer que"
                    ]
                },
                {
                    "sense_id": "17cf2aff-8089-3053-b2a7-1ef04a6ea201",
                    "sense_definition": "Invoquer un fait, un droit ou une circonstance pour en tirer un avantage ou une justification.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prévenu a tenté d'<w>arguer</w> de sa bonne foi pour convaincre le tribunal de son innocence."
                        },
                        {
                            "text": "Elle <w>argue</w> de son droit de réponse pour intervenir immédiatement dans ce débat public."
                        }
                    ],
                    "synonyms": [
                        "invoquer",
                        "prétexter"
                    ],
                    "common_phrases": [
                        "arguer de sa bonne foi"
                    ]
                },
                {
                    "sense_id": "83ae9f09-ab5a-318d-9f23-72ad21791688",
                    "sense_definition": "Tirer une conséquence logique d'un fait ou d'un principe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "raisonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ces observations scientifiques préliminaires, que peut-on véritablement <w>arguer</w> quant à l'évolution du climat ?"
                        },
                        {
                            "text": "On ne saurait <w>arguer</w> de son silence un quelconque consentement aux propositions formulées hier."
                        }
                    ],
                    "synonyms": [
                        "conclure",
                        "déduire",
                        "inférer"
                    ]
                },
                {
                    "sense_id": "f2b81d73-5098-3a2c-95c1-b487f99fbf89",
                    "sense_definition": "Accuser formellement ou contester en justice la sincérité ou la validité d'un document.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a décidé d'<w>arguer</w> de faux l'attestation fournie par le témoin principal."
                        },
                        {
                            "text": "Les juges ont estimé qu'on ne pouvait pas <w>arguer</w> cet acte de faux sans preuves matérielles."
                        }
                    ],
                    "synonyms": [
                        "accuser",
                        "attaquer",
                        "contester"
                    ],
                    "common_phrases": [
                        "arguer de faux"
                    ]
                },
                {
                    "sense_id": "d1dc74f7-19d5-390e-b6c3-9773ec929cd8",
                    "sense_definition": "Filer l'or ou l'argent en le faisant passer à travers la filière d'une argue.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "artisanat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cet atelier spécialisé, l'artisan <w>arguait</w> patiemment les métaux précieux pour fabriquer des fils très fins."
                        },
                        {
                            "text": "Pour réaliser ces riches broderies, l'orfèvre devait d'abord <w>arguer</w> des lingots d'argent pur."
                        }
                    ]
                }
            ]
        }
    ]
}