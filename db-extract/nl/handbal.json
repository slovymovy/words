                    {
                        "translation_id": "3f4624b6-efd1-473c-93c0-0c0848fe88a6",
                        "source_entry_id": "03fe3d0f-d0ef-38af-98a9-cebaf0b2a5e4",
                        "source_sense_id": "255efcd1-87fa-3ff2-a024-94b8d1e2592f",
