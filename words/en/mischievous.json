{
    "word_family": [
        "mischief"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dfae8ee-006f-3ade-a276-b8a4c7524f68",
                    "sense_definition": "Troublesome, cheeky, or playful in a way that causes minor annoyance or harmless trouble.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>mischievous</w> puppy chewed on my favorite pair of leather shoes.",
                            "target_lang_translations": {
                                "tr": "<w>Yaramaz</w> köpek en sevdiğim deri ayakkabılarımı çiğnedi."
                            }
                        },
                        {
                            "text": "He had a <w>mischievous</w> grin on his face after playing a harmless trick on his sister.",
                            "target_lang_translations": {
                                "tr": "Kız kardeşine zararsız bir şaka yaptıktan sonra yüzünde <w>yaramaz</w> bir gülümseme vardı."
                            }
                        }
                    ],
                    "synonyms": [
                        "badly-behaved",
                        "naughty"
                    ],
                    "common_phrases": [
                        "mischievous grin",
                        "mischievous child"
                    ],
                    "target_lang_definitions": {
                        "tr": "Küçük çaplı rahatsızlıklara veya zararsız sorunlara yol açan, yaramaz, şımarık veya oyuncu."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yaramaz",
                                "target_lang_sense_clarification": "Söz dinlemeyen, uslu durmayan, yasaklanan şeyleri yapmakta ısrarcı olan."
                            },
                            {
                                "target_lang_word": "haşarı",
                                "target_lang_sense_clarification": "Yerinde duramayan, yaramaz çocuk."
                            },
                            {
                                "target_lang_word": "afacan",
                                "target_lang_sense_clarification": "Zeki ve yaramaz çocuk."
                            },
                            {
                                "target_lang_word": "haylaz",
                                "target_lang_sense_clarification": "Hoşa gitmeyen davranışlarda bulunan, aylaklık eden."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05db5f34-92eb-3cd9-a24c-47c47725992f",
                    "sense_definition": "Causing harm, damage, or injury to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "harm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spread of <w>mischievous</w> rumors can destroy a person's reputation permanently.",
                            "target_lang_translations": {
                                "tr": "<w>Zararlı</w> dedikoduların yayılması bir kişinin itibarını kalıcı olarak yok edebilir."
                            }
                        },
                        {
                            "text": "Some chemicals have a <w>mischievous</w> effect on the local environment if not disposed of correctly.",
                            "target_lang_translations": {
                                "tr": "Bazı kimyasallar doğru şekilde bertaraf edilmezse yerel çevre üzerinde <w>zararlı</w> bir etkiye sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmful",
                        "hurtful",
                        "detrimental",
                        "noxious",
                        "pernicious",
                        "destructive"
                    ],
                    "antonyms": [
                        "beneficial",
                        "harmless"
                    ],
                    "common_phrases": [
                        "mischievous effect",
                        "mischievous rumors"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birine veya bir şeye zarar, hasar veya ziyan veren."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "zararlı",
                                "target_lang_sense_clarification": "Kötü etkisi olan, hasar veren."
                            },
                            {
                                "target_lang_word": "yıkıcı",
                                "target_lang_sense_clarification": "Tahrip edici, zarar verici nitelikte."
                            },
                            {
                                "target_lang_word": "kötücül",
                                "target_lang_sense_clarification": "Kötülük içeren, zarar verme amacı güden."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}