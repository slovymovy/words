                "senses": [
                    {
                        "sense_id": "4c0268f7-783c-3ceb-a954-a37b72818f14",
                        "entry_id": "2d383309-03e9-30ac-b02f-92197fce1db7",
                        "glosses": [
                            "истор. старинная мужская меховая или бархатная шапка с плоской тульёй (в Московском государстве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4faa430-11d2-4e0a-8151-b8f518b1bf96",
                                "sense_id": "4c0268f7-783c-3ceb-a954-a37b72818f14",
                                "text": "Во всей России, кроме славянофилов, никто не носит мурмолок."
                            },
                            {
                                "example_id": "b430609f-1144-44e3-859f-064dd717cf61",
                                "sense_id": "4c0268f7-783c-3ceb-a954-a37b72818f14",
                                "text": "Не смотрела бы из окошечка // Я на молодца разудалого, // Как он ехал по нашей улице, // Набекрень заломивши мурмолку.."
                            },
                            {
                                "example_id": "a7fe17f0-1faf-43ad-8d98-ab0aad2c85fc",
                                "sense_id": "4c0268f7-783c-3ceb-a954-a37b72818f14",
                                "text": "В китайский красный халат был одет барин, с золотыми головастыми змеями, и золотая мурмолка сияла на голове, как солнце."
                            }
                        ]
                    }
