{
    "word_family": [
        "uniqueness",
        "uniquely"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aeb07cda-3c27-3ced-9e0f-feb7a381f8a4",
                    "sense_definition": "Being the only one of its kind; unlike anything else.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Each person has a <w>unique</w> fingerprint that can be used for identification.",
                            "target_lang_translations": {
                                "ru": "У каждого человека есть <w>уникальный</w> отпечаток пальца, который можно использовать для идентификации.",
                                "tr": "Her insanın kimlik tespiti için kullanılabilecek <w>benzersiz</w> bir parmak izi vardır."
                            }
                        },
                        {
                            "text": "This is a <w>unique</w> opportunity to visit the ancient ruins before they close.",
                            "target_lang_translations": {
                                "ru": "Это <w>уникальная</w> возможность посетить древние руины до их закрытия.",
                                "tr": "Bu, antik kalıntıları kapanmadan önce ziyaret etmek için <w>eşsiz</w> bir fırsat."
                            }
                        }
                    ],
                    "synonyms": [
                        "one of a kind",
                        "singular",
                        "unequaled",
                        "unparalleled",
                        "unmatched",
                        "unrivalled"
                    ],
                    "antonyms": [
                        "common"
                    ],
                    "common_phrases": [
                        "unique opportunity",
                        "unique experience",
                        "totally unique",
                        "unique position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единственный в своём роде; не похожий ни на что другое.",
                        "tr": "Türü olan tek; eşi benzeri olmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уника́льный",
                                "target_lang_sense_clarification": "единственный в своём роде"
                            },
                            {
                                "target_lang_word": "неповтори́мый",
                                "target_lang_sense_clarification": "не имеющий аналогов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "benzersiz",
                                "target_lang_sense_clarification": "eşi benzeri olmayan"
                            },
                            {
                                "target_lang_word": "eşsiz",
                                "target_lang_sense_clarification": "tek ve tekil olan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b4a71b9-f9f3-3cdf-9d89-eb9ec0c7f818",
                    "sense_definition": "Very special, unusual, or good.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The restaurant offers a <w>unique</w> dining experience with food from around the world.",
                            "target_lang_translations": {
                                "ru": "Ресторан предлагает <w>уникальный</w> гастрономический опыт с блюдами со всего мира.",
                                "tr": "Restoran, dünyanın dört bir yanından yemeklerle <w>eşsiz</w> bir yemek deneyimi sunuyor."
                            }
                        },
                        {
                            "text": "She has a very <w>unique</w> style that makes her stand out in a crowd.",
                            "target_lang_translations": {
                                "ru": "У неё очень <w>неповторимый</w> стиль, который выделяет её из толпы.",
                                "tr": "Kalabalıkta öne çıkmasını sağlayan çok <w>özgün</w> bir tarzı var."
                            }
                        }
                    ],
                    "synonyms": [
                        "incomparable",
                        "matchless",
                        "peerless",
                        "nonpareil"
                    ],
                    "antonyms": [
                        "common",
                        "normal"
                    ],
                    "common_phrases": [
                        "very unique",
                        "quite unique",
                        "truly unique"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особенный, необычный или превосходный.",
                        "tr": "Çok özel, alışılmadık veya mükemmel olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исключи́тельный",
                                "target_lang_sense_clarification": "выдающийся, особенный"
                            },
                            {
                                "target_lang_word": "неповтори́мый",
                                "target_lang_sense_clarification": "замечательный, своеобразный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "eşsiz",
                                "target_lang_sense_clarification": "harika, olağanüstü"
                            },
                            {
                                "target_lang_word": "özgün",
                                "target_lang_sense_clarification": "kendine has, orijinal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "05b958aa-f17f-3e5f-9a37-ad7f937f5969",
                    "sense_definition": "Belonging or connected to one particular person, place, or thing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The koala is an animal that is <w>unique</w> to Australia.",
                            "target_lang_translations": {
                                "ru": "Коала — это животное, <w>уникальное</w> для Австралии.",
                                "tr": "Koala, Avustralya'ya <w>özgü</w> bir hayvandır."
                            }
                        },
                        {
                            "text": "These challenges are not <w>unique</w> to our company; many businesses face them.",
                            "target_lang_translations": {
                                "ru": "Эти проблемы <w>свойственны</w> не только нашей компании; с ними сталкиваются многие предприятия.",
                                "tr": "Bu zorluklar yalnızca şirketimize <w>has</w> değil; birçok işletme bunlarla karşı karşıya."
                            }
                        }
                    ],
                    "common_phrases": [
                        "unique to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принадлежащий или относящийся исключительно к конкретному человеку, месту или предмету.",
                        "tr": "Belli bir kişiye, yere veya şeye ait ya da özgü olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свойственный",
                                "target_lang_sense_clarification": "присущий только кому-либо/чему-либо"
                            },
                            {
                                "target_lang_word": "уника́льный",
                                "target_lang_sense_clarification": "специфический для"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "özgü",
                                "target_lang_sense_clarification": "yalnızca bir şeye/kimseye ait olan"
                            },
                            {
                                "target_lang_word": "has",
                                "target_lang_sense_clarification": "bir yere veya kimseye mahsus"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "80dba136-7eb7-383f-84c4-486f5098a50d",
                    "sense_definition": "A person or thing that is unlike anything else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a world of mass production, this handmade chair is a <w>unique</w>.",
                            "target_lang_translations": {
                                "ru": "В мире массового производства этот стул ручной работы — настоящий <w>уникум</w>.",
                                "tr": "Seri üretim dünyasında bu el yapımı sandalye tam bir <w>ünik</w> parçadır."
                            }
                        },
                        {
                            "text": "He is considered a <w>unique</w> among his peers because of his extraordinary talent.",
                            "target_lang_translations": {
                                "ru": "Его считают <w>уникумом</w> среди сверстников из-за его выдающегося таланта.",
                                "tr": "Olağanüstü yeteneği nedeniyle akranları arasında bir <w>istisna</w> olarak kabul ediliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "one of a kind",
                        "nonpareil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, не имеющие аналогов.",
                        "tr": "Eşi benzeri olmayan kişi veya şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́никум",
                                "target_lang_sense_clarification": "исключительный экземпляр"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ünik",
                                "target_lang_sense_clarification": "eşi benzeri olmayan nadir şey veya kimse"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}