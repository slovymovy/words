                                        "entry_id": "7d65e580-7d20-332f-bce0-4b2277eb3a66",
                                        "glosses": [
                                            "Ensemble de ce qui est désignable dans un contexte donné par une méthode d’accès donnée faisant usage de noms symboliques (par exemple des chaînes de caractères avec ou sans restriction d’écriture), où le même nom réfère à la même entité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820897a7-358a-4b73-95f9-5d9c1579c043",
                                                "sense_id": "f468c427-3df8-3677-ab3f-a08c8776700a",
                                                "text": "L’espace de noms associé à un annuaire téléphonique est celui des abonnés au téléphone (du moins ceux qui ne sont pas en liste rouge)."
                                            }
                                        ]
                                    }
                                ]
