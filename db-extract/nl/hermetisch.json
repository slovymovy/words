                                                "example_id": "702cbbd5-ea6c-4e02-b254-90b0d407ee6c",
                                                "sense_id": "f6533140-95d2-3156-9ed0-217b623ac9ad",
                                                "text": "Die hermetischen Nachrichten konnte niemand entschlüsseln."
                                            }
                                        ],
