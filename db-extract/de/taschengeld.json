                    {
                        "translation_id": "59728907-18d6-4b8c-9afc-d1303e9052b6",
                        "source_entry_id": "1f4e660e-9a83-31fb-861c-49618533733b",
                        "source_sense_id": "699a2ea6-3fc8-3883-8541-a5f5309084b4",
                        "source_sense_description": "Geld, bereitgestellt zur freien Verfügung",
                        "target_lang_word": "argent de poche",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "argent de poche",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93a4e7d6-6946-3386-ba7e-c7f2703d7863",
                                        "entry_id": "fc2d45e4-c613-34bd-8747-9baa0127b949",
                                        "glosses": [
                                            "Somme qu’on destine à ses menus plaisirs, à ses petites dépenses personnelles."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a02d7a72-e079-4aa6-882b-9b9ce4972552",
                                                "sense_id": "93a4e7d6-6946-3386-ba7e-c7f2703d7863",
                                                "text": "Il s'était donc résigné à se passer de train de maison. […]. Sa devise était tout pour l’argent de poche, et il la mettait en pratique.\n Aussi, avait-il, comme on dit, le louis facile, et ces dames du monde où l'on s'amuse lui en savaient gré."
                                            },
                                            {
                                                "example_id": "31c8a708-7a04-4a0b-8917-2afe9b2812bd",
                                                "sense_id": "93a4e7d6-6946-3386-ba7e-c7f2703d7863",
                                                "text": "Ce caractère modeste est bien sûr relatif car tributaire des ressources de chacun, mais la modicité des sommes en cause reste avant tout un élément de définition de l’argent de poche."
                                            },
                                            {
                                                "example_id": "6bba83f4-3f13-4335-8f83-f4de99b46b33",
                                                "sense_id": "93a4e7d6-6946-3386-ba7e-c7f2703d7863",
                                                "text": "En fait, Edna ne possédait aucune économie et, jusqu'au matin de ses noces, versait son salaire entier à sa mère, qui lui remettait l'argent de poche grâce auquel elle se payait le cinéma et les sundaes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
