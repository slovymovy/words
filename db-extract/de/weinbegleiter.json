                "senses": [
                    {
                        "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                        "entry_id": "62b68666-5d30-36d6-a471-c1b5ab5e0965",
                        "glosses": [
                            "etwas (eine Speise oder Getränk), das man nach dem Genuss von Wein begleitend zu sich nimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0167c58d-f368-47d0-ac89-2d5049f84adb",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„Als Weinbegleiter zu Gerichten mit Morcheln sind reife Weiß- und Rotweine, zum Beispiel aus dem Anbaugebiet Jura, zu empfehlen.“"
                            },
                            {
                                "example_id": "d999ee12-0e72-4dc5-9848-0a8748da3c8c",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„Lammgeschmack und orientalische Gewürze benötigen einen Weinbegleiter mit einem breitgefächerten Aromenspektrum.“"
                            },
                            {
                                "example_id": "1fd6e1a2-aa36-4896-9f82-095bd4e45537",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„So lag es für den Gundelsheimer nicht nur auf der Hand, sondern noch mehr auf der Zunge, Schokolade als Weinbegleiter zu entwickeln.“"
                            },
                            {
                                "example_id": "ba901ff2-246e-4f43-8e7a-9e2255283357",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„So ist Wasser umso geeigneter als Essens- und Weinbegleiter, wenn es nur leise oder eben überhaupt nicht sprudelt.“"
                            },
                            {
                                "example_id": "0fcabeaf-344b-473b-9627-3df2622a324b",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„Markus Del Monego, 1998 zum Weltmeister der Wein-Sommeliers gekürt, hat 26 internationale Mineralwässer verkostet und auf ihre Tauglichkeit als Weinbegleiter geprüft.“"
                            },
                            {
                                "example_id": "398fd348-4d35-4beb-8676-ffc682264129",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„Wie wäre es mal mit einem Weinbegleiter, der zwei der drei Klassiker kombiniert und dazu noch hübsch aussieht?“"
                            },
                            {
                                "example_id": "46a8b822-5461-4264-a3d7-7c31a4a996fd",
                                "sense_id": "93fdd199-211c-3890-a4df-ce418b955a0e",
                                "text": "„Die passenden Weinbegleiter zum Essen hält Ali Güngörmüs in seiner gut sortierten Weinkarte bereit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
