                                        "glosses": [
                                            "In a sententious manner, concisely, pithily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce88b5bc-ebec-4440-ac4c-c2f329964611",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "\"We shall see to-morrow,\" said the doctor. \"We shall,\" replied Lady Anne, very sententiously."
                                            },
                                            {
                                                "example_id": "fd2a3b1c-cc35-4099-b088-2f63a75ea8c6",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "\"It 's an ill wind dat blows nowhar, — dat ar a fact,\" said Sam, sententiously, giving an additional hoist to his pantaloons, and adroitly substituting a long nail in place of a missing suspender-button, with which effort of mechanical genius he seemed highly delighted."
                                            },
                                            {
                                                "example_id": "760c1cae-d0c7-4a13-b3e5-8d82c088a013",
                                                "sense_id": "28a86d9d-dfc7-34a6-a6e8-ba3b0048f201",
                                                "text": "He became very cool and collected all at once. ‘I am not such a fool as I look, quoth Plato to his disciples,’ he said sententiously, emptied his glass with great resolution, and we rose."
                                            }
                                        ]
                                    }
                                ]
