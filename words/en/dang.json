                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "or archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время от глагола ding (звенеть).",
                        "zh": "动词 ding 的简单过去式。"
                    },
                    "translations": {
