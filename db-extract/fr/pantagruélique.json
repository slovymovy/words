                        "examples": [
                            {
                                "example_id": "eb3a1668-3099-4950-a2bf-e0c7576bc225",
                                "sense_id": "e01919fe-5e30-3385-878e-8cce4dd79e85",
                                "text": "C'est généralement aux abords de la Porte Maillot qu'ont lieu, pendant la belle saison, ces réunions pantagruéliques qui se prolongent indéfiniment, et qui bien souvent laissent aux heureux conjoints le souvenir de leur plus belle indigestion.",
                                "translation": "It is generally around Porte Maillot that these pantagruelian meetings take place during the summer months, which go on indefinitely and often leave the happy couple with the memory of their greatest indigestion.",
                                "english": "It is generally around Porte Maillot that these pantagruelian meetings take place during the summer months, which go on indefinitely and often leave the happy couple with the memory of their greatest indigestion."
                            }
                        ]
                    }
