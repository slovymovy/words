            {
                "entry_id": "0ff6bf5c-2511-31cd-9323-ecae73ef6e35",
                "word": "hypocauste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4bbbf465-87d8-4c51-ac89-9b90dcddcb54",
                        "entry_id": "0ff6bf5c-2511-31cd-9323-ecae73ef6e35",
                        "tags": [
                            "plural"
                        ],
