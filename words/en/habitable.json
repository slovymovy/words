    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef44c388-dfa1-3ca4-be25-ddb173c681c2",
                    "sense_definition": "Safe and comfortable enough for humans or animals to live in; fit for living.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "livability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After months of hard work, the old cottage was finally <w>habitable</w> and ready for the new family.",
                            "target_lang_translations": {
                                "ru": "После нескольких месяцев упорной работы старый коттедж стал наконец <w>жилым</w> и готовым к приему новой семьи."
                            }
                        },
                        {
                            "text": "The landlord must ensure that the apartment remains in a <w>habitable</w> condition throughout the lease.",
                            "target_lang_translations": {
                                "ru": "Арендодатель должен гарантировать, что квартира остается в <w>пригодном для жилья</w> состоянии на протяжении всего срока аренды."
                            }
                        }
                    ],
                    "synonyms": [
                        "inhabitable"
                    ],
                    "antonyms": [
                        "unhabitable",
                        "uninhabitable"
                    ],
                    "common_phrases": [
                        "habitable condition",
                        "habitable space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достаточно безопасный и комфортный для проживания людей или животных; пригодный для жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жилой",
                                "target_lang_sense_clarification": "о помещении или здании"
                            },
                            {
                                "target_lang_word": "пригодный для жилья",
                                "target_lang_sense_clarification": "соответствующий нормам проживания"
                            },
                            {
                                "target_lang_word": "обитаемый",
                                "target_lang_sense_clarification": "в котором можно жить"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58529a8d-a269-3ca1-97e9-0f7ded57b297",
                    "sense_definition": "Capable of supporting or giving rise to life, especially in the context of planets or moons.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "livability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are searching for a <w>habitable</w> planet that might sustain human life in the future.",
                            "target_lang_translations": {
                                "ru": "Ученые ищут <w>пригодную для жизни</w> планету, которая могла бы поддерживать человеческую жизнь в будущем."
                            }
                        },
                        {
                            "text": "The telescope discovered a new world located within the <w>habitable</w> zone of its star.",
                            "target_lang_translations": {
                                "ru": "Телескоп обнаружил новый мир, расположенный в <w>обитаемой</w> зоне своей звезды."
                            }
                        }
                    ],
                    "antonyms": [
                        "uninhabitable"
                    ],
                    "common_phrases": [
                        "habitable zone",
                        "habitable world"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный поддерживать жизнь или способствовать её возникновению, особенно в контексте планет или лун."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пригодный для жизни",
                                "target_lang_sense_clarification": "о планетах и космических телах"
                            },
                            {
                                "target_lang_word": "обитаемый",
                                "target_lang_sense_clarification": "способный поддерживать жизнь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}