            {
                "entry_id": "87d9309e-4545-3ad7-8118-8ca7355ca04e",
                "word": "barbaresque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a139db0-2831-48ba-98af-292e42d22b33",
                        "entry_id": "87d9309e-4545-3ad7-8118-8ca7355ca04e",
                        "tags": [
                            "plural"
