        "ploughshare"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a274b508-c21c-3076-94f8-7f3e38b552ec",
                    "sense_definition": "simple past and past participle of <w>plough</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer <w>ploughed</w> the field before planting the wheat.",
                            "target_lang_translations": {
                                "de": "Der Bauer <w>pflügte</w> das Feld, bevor er den Weizen säte."
                            }
                        },
                        {
                            "text": "The tractor <w>ploughed</w> through the deep snow to clear the road.",
                            "target_lang_translations": {
                                "de": "Der Traktor <w>pflügte sich</w> durch den tiefen Schnee, um die Straße freizumachen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ploughed the field",
                        "ploughed through snow"
                    ],
                    "target_lang_definitions": {
                        "de": "Präteritum und Partizip Perfekt von pflügen"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "pflügte",
                                "target_lang_sense_clarification": "Präteritum von pflügen"
                            },
                            {
                                "target_lang_word": "gepflügt",
                                "target_lang_sense_clarification": "Partizip Perfekt von pflügen"
                            },
                            {
                                "target_lang_word": "pflügte sich",
                                "target_lang_sense_clarification": "sich mühsam durch etwas hindurchbewegen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ae1ef86f-259a-396d-ba4d-49a5e73cf8d2",
                    "sense_definition": "Turned over with the blade of a plough to create furrows (usually for planting crops).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The birds gathered in the <w>ploughed</w> field to look for worms.",
                            "target_lang_translations": {
                                "de": "Die Vögel versammelten sich auf dem <w>gepflügten</w> Feld, um nach Würmern zu suchen."
                            }
                        },
                        {
                            "text": "Walking across the freshly <w>ploughed</w> land was difficult and muddy.",
                            "target_lang_translations": {
                                "de": "Das Gehen über das frisch <w>gepflügte</w> Land war mühsam und schlammig."
                            }
                        }
                    ],
                    "synonyms": [
                        "tilled",
                        "cultivated"
                    ],
                    "antonyms": [
                        "unploughed",
                        "untilled"
                    ],
                    "common_phrases": [
                        "freshly ploughed field",
                        "ploughed land"
                    ],
                    "target_lang_definitions": {
                        "de": "Mit der Pflugschar umgeworfen, um Furchen zu ziehen (meist für die Aussaat)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "gepflügt",
                                "target_lang_sense_clarification": "Ackerland"
                            },
                            {
                                "target_lang_word": "ackert",
                                "target_lang_sense_clarification": "umgegraben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97ddcacc-70e9-34b0-85fb-863f2b800e9f",
                    "sense_definition": "Well-trodden or well-researched, previously explored.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "explored",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor chose a topic that was not already <w>ploughed</w> by other researchers.",
                            "target_lang_translations": {
                                "de": "Der Professor wählte ein Thema, das nicht bereits von anderen Forschern <w>durchackert</w> worden war."
                            }
                        },
                        {
                            "text": "He wanted to find a new angle rather than writing on a well <w>ploughed</w> subject.",
                            "target_lang_translations": {
                                "de": "Er wollte einen neuen Blickwinkel finden, anstatt über ein bereits viel <w>durchackertes</w> Thema zu schreiben."
                            }
                        }
                    ],
                    "synonyms": [
                        "explored",
                        "well-trodden"
                    ],
                    "antonyms": [
                        "unexplored"
                    ],
                    "common_phrases": [
                        "well ploughed field"
                    ],
                    "target_lang_definitions": {
                        "de": "Bereits gründlich erforscht oder untersucht"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "durchackert",
                                "target_lang_sense_clarification": "ein Thema intensiv erforscht"
                            },
                            {
                                "target_lang_word": "abgearbeitet",
                                "target_lang_sense_clarification": "bereits erschöpfend behandelt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd9583d-529c-3e00-8407-e7c3783090f2",
                    "sense_definition": "Drunk; intoxicated by alcohol.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intoxicated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They went to the pub and got completely <w>ploughed</w>.",
                            "target_lang_translations": {
                                "de": "Sie gingen in die Kneipe und haben sich völlig <w>zugesoffen</w>."
                            }
                        },
                        {
                            "text": "He was so <w>ploughed</w> that he could barely remember his own name.",
                            "target_lang_translations": {
                                "de": "Er war so <w>voll</w>, dass er sich kaum noch an seinen eigenen Namen erinnern konnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "wasted",
                        "hammered",
                        "plastered"
                    ],
                    "antonyms": [
                        "sober"
                    ],
                    "common_phrases": [
                        "got completely ploughed"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal slang for drunk"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Betrunken; stark alkoholisiert (Umgangssprache)"
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "voll",
                                "target_lang_sense_clarification": "umgangssprachlich für betrunken"
                            },
                            {
                                "target_lang_word": "zu",
                                "target_lang_sense_clarification": "umgangssprachlich für stark alkoholisiert"
                            },
                            {
                                "target_lang_word": "dicht",
                                "target_lang_sense_clarification": "umgangssprachlich für betrunken"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}