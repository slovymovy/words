                        ]
                    },
                    {
                        "translation_id": "34287ddc-edb2-4937-8cf0-dd153b2d0ecd",
                        "source_entry_id": "ad21e05f-4b69-3313-abe4-49a109adff31",
                        "source_sense_id": "79ac4301-90df-3bd4-b264-57bee2220fbc",
                        "target_lang_word": "perpétuel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perpétuel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f1702cf-873c-3184-addc-9f49b8049bb6",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qui ne cesse pas ; qui dure toujours."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cde813d-99f1-445c-8e2b-33d1794f0005",
                                                "sense_id": "4f1702cf-873c-3184-addc-9f49b8049bb6",
                                                "text": "En supposant le taux de l’intérêt stationnaire et égal, par exemple, à 5 pour 100, un capital de 100 fr. vaut une rente perpétuelle de 5 fr., […]."
                                            },
                                            {
                                                "example_id": "a876079e-7c50-4ceb-bae6-217c5c85d8a3",
                                                "sense_id": "4f1702cf-873c-3184-addc-9f49b8049bb6",
                                                "text": "Ils convainquirent mes grands-parents d’agrandir leur maison de deux étages. Ils auraient à engager environ trois mille francs. Mon père fit remarquer que cette somme en rente perpétuelle à 3 p. 100 leur rapporterait à peine cent francs, alors que la location des deux étages leur assurerait un revenu d’au moins cinq cents francs."
                                            },
                                            {
                                                "example_id": "e0324b15-4919-4933-9167-9714416bd31d",
                                                "sense_id": "4f1702cf-873c-3184-addc-9f49b8049bb6",
                                                "text": "Les comptes nationaux sont une construction sociale, en perpétuelle évolution, reflétant toujours les préoccupations d'une époque. Les chiffres qui en sont issus ne doivent pas être fétichisés."
                                            },
                                            {
                                                "example_id": "552658cc-19e1-4a25-bd2b-38f404c47903",
                                                "sense_id": "4f1702cf-873c-3184-addc-9f49b8049bb6",
                                                "text": "Cette plante est extraordinairement vivace, elle ne se resème pas chaque année comme le chanvre et le lin: elle est perpétuelle, et devient de plus en plus vigoureuse et féconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b8453db-43ca-3200-b714-c40c5f14b0d7",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qualifie les neiges qui ne fondent jamais."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9fa3089d-ca92-35b0-904f-bd4a5a931546",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qualifie des plantes dites aussi remontantes, qui fleurissent, fructifient pendant toute la bonne saison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cabd460-f7e9-3c85-a5eb-d85da02c6d39",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qui dure toute la vie d’un homme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9617a906-1e11-4f8d-9a14-c9a564835ac1",
                                                "sense_id": "1cabd460-f7e9-3c85-a5eb-d85da02c6d39",
                                                "text": "Il suffit de rappeler qu'en 1629, un arrêt, provoqué par le procureur-général, interdit aux moines d'infliger aux leurs la prison perpétuelle, l’In pace, etc. Ces cruautés continuèrent, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43ffd5de-4405-3208-b6d9-148865286182",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qualifie certaines charges, certaines dignités dont on est pourvu pour toute la vie, à la différence de celles qu’on ne possède que pour un temps limité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7294d8b-3c41-45d0-8655-2a81ca2fc53f",
                                                "sense_id": "43ffd5de-4405-3208-b6d9-148865286182",
                                                "text": "Après des discussions très prolongées […] l’Académie, très partagée, pour se tirer d’affaire, s’en remit purement et simplement à son secrétaire perpétuel, M. Joseph Thoulier, abbé d’Olivet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33a07ffa-4ac7-37cc-b554-80686c4a4341",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qui est continuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3c9e82-ae8a-4b47-971c-1a7687c68786",
                                                "sense_id": "33a07ffa-4ac7-37cc-b554-80686c4a4341",
                                                "text": "[…] le progrès est un perpétuel devenir, nulle méthode ne saurait être considérée comme immuable, tout est en mouvement, tout est continuellement améliorable, tout ce qui existe aujourd’hui sera demain mieux encore…"
                                            },
                                            {
                                                "example_id": "8fe5d390-0766-4a07-b538-d905670a8553",
                                                "sense_id": "33a07ffa-4ac7-37cc-b554-80686c4a4341",
                                                "text": "Son emploi lui donne un travail perpétuel, une occupation perpétuelle."
                                            },
                                            {
                                                "example_id": "c02fd533-e7f2-4679-9f63-fc6cb54be17e",
                                                "sense_id": "33a07ffa-4ac7-37cc-b554-80686c4a4341",
                                                "text": "C’est un tourment perpétuel que de vivre avec de telles responsabilités."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e761502a-20bc-37f6-b830-40185f7c1baf",
                                        "entry_id": "f9e0b9c2-ea97-3f08-984b-2d9a00f59703",
                                        "glosses": [
                                            "Qui est fréquent, habituel."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b196cebe-8269-4f17-b866-d1882506c084",
                                                "sense_id": "e761502a-20bc-37f6-b830-40185f7c1baf",
                                                "text": "Camus […], se saisit de la corde au bout de laquelle Blanchette bêlante, la queue animée d’un perpétuel frétillement, attendait qu’on se mit en route."
                                            },
                                            {
                                                "example_id": "df1fc64a-f72f-4782-969f-aeb0ab970ba3",
                                                "sense_id": "e761502a-20bc-37f6-b830-40185f7c1baf",
                                                "text": "Ce sont des vicissitudes perpétuelles."
                                            },
                                            {
                                                "example_id": "ee26e03c-c017-4395-aeee-a52d4e606454",
                                                "sense_id": "e761502a-20bc-37f6-b830-40185f7c1baf",
                                                "text": "De perpétuelles interruptions."
                                            },
                                            {
                                                "example_id": "26c3352e-a63c-44a3-8676-fc049daa4955",
                                                "sense_id": "e761502a-20bc-37f6-b830-40185f7c1baf",
                                                "text": "Des débats perpétuels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
