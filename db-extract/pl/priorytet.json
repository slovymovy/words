                "senses": [
                    {
                        "sense_id": "30755b41-6910-3d7a-b3c1-0e3bc1d1c65c",
                        "entry_id": "d5e1836f-48e2-3cc6-95f3-726d205639c5",
                        "glosses": [
                            "pierwszeństwo przysługujące czemuś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9af39ab3-ee01-4199-a7e1-1b97dac9b0da",
                                "sense_id": "30755b41-6910-3d7a-b3c1-0e3bc1d1c65c",
                                "text": "… Rząd japoński przyznał priorytet rozwojowi technologii budowy mikrourządzeń. …"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3608c79e-5533-3dc8-b8cc-d1fbee3f6f19",
                        "entry_id": "d5e1836f-48e2-3cc6-95f3-726d205639c5",
                        "glosses": [
                            "coś, co ma pierwszeństwo przed czymś innym; sprawa/kwestia bardzo ważna"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e856d17-d4e5-4a5a-9d15-6175081cfc33",
                                "sense_id": "3608c79e-5533-3dc8-b8cc-d1fbee3f6f19",
                                "text": "Posłowie ustalali priorytety polskiej polityki zagranicznej."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9351a9a-9afe-4fd0-ad16-a89f99a4a6b6",
                        "source_entry_id": "d5e1836f-48e2-3cc6-95f3-726d205639c5",
                        "source_sense_id": "30755b41-6910-3d7a-b3c1-0e3bc1d1c65c",
                        "target_lang_word": "priority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "An item's relative importance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b91f3308-6e28-42ef-aeb2-3a7b8ee970d2",
                                                "sense_id": "f2725557-7a9e-3f60-83cc-1cfbde8aafff",
                                                "text": "He set his e-mail message's priority to high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A goal of a person or an organisation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7db7fd2f-9c4a-4e96-8332-8e61e08fdecb",
                                                "sense_id": "71ba40b5-de8e-3c89-ad9c-6c3ebe02e3bc",
                                                "text": "She needs to get her priorities straight and stop playing games."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "The quality of being earlier or coming first compared to another thing; the state of being prior."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34d29bbf-1aa4-40eb-8918-d2f1ecc4af84",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "In bankruptcy law, a business' debt to its employees has priority over its debt to a landlord, so the employees must be paid first."
                                            },
                                            {
                                                "example_id": "d4e810b0-735b-4934-b029-3b88110788db",
                                                "sense_id": "da14edcf-3263-3452-906e-6640ba80a8d4",
                                                "text": "But it's now platform extension work which will allow the station to handle LNER Azuma trains which needs to take priority, if a direct service to London King's Cross is to begin in 2021."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "A superior claim to use by virtue of being validly published at an earlier date."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcaa2689-d64e-4dc0-81d7-23e5523c44d6",
                                                "sense_id": "705613fc-41e3-3a4d-984c-e267b4ed175e",
                                                "text": "Neither [Jones][…] nor I (in 1966) could conceive of reducing our \"science\" to the ultimate absurdity of reading Finnish newspapers almost a century and a half old in order to establish \"priority.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Precedence; superior rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac628060-3ec0-4b4c-87bd-b8ed87554a1e",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Follow Cominius. We must follow you. / Right worthy you priority."
                                            },
                                            {
                                                "example_id": "d80b4eb4-21dd-4cc5-a3ae-afe378786bc0",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Sozomen is not criticizing Constantine but rather asserting that bishops have priority over emperors, in case the readers might not have understood this […]"
                                            },
                                            {
                                                "example_id": "055b54b7-0afb-4c1d-a50d-8de51b3bea77",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "Who has priority, one's mother or one's wife? Question: To whom should a married man should give much preference, either his mother or wife?"
                                            },
                                            {
                                                "example_id": "a54bc13e-9c29-4ada-a1b3-18a4a9419250",
                                                "sense_id": "65b9ae79-869f-3f63-be77-91b67750a751",
                                                "text": "The Holy Ghost is here and He has priority—remember that. The Holy Ghost has priority over your pastor, your church, your teachers—priority over every human thing. He is God, and being God, His voice has priority over all voices,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "334b610e-9bc3-3cef-b8f1-a5435da52d5b",
                                        "entry_id": "e6075514-db7d-338b-9a01-fc75c318c68a",
                                        "glosses": [
                                            "Right of way; The right to pass (an intersection) before other road users."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f28460c8-c62a-4bef-b21e-14948cbc44dd",
                        "source_entry_id": "d5e1836f-48e2-3cc6-95f3-726d205639c5",
                        "source_sense_id": "30755b41-6910-3d7a-b3c1-0e3bc1d1c65c",
                        "target_lang_word": "priorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                        "entry_id": "2b7ac309-4228-394b-9a53-6af4eba05bfb",
                                        "glosses": [
                                            "Le fait de venir avant, dans l’ordre du temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b7dc1c6-d316-4e18-9fef-01ac1683f6dd",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Priorité d’hypothèque."
                                            },
                                            {
                                                "example_id": "49ff50b9-70f9-4671-85d6-22ca70256153",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Ce savant revendique la priorité de sa découverte."
                                            },
                                            {
                                                "example_id": "d74caed6-6927-4e52-8c7e-1dce484cb7de",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Cet orateur réclame la priorité, Il réclame le droit de prendre la parole avant un autre."
                                            },
                                            {
                                                "example_id": "a065f5d0-5ee9-4ba0-b29e-38ebe09b80af",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Donner la priorité à un amendement, décider qu’il sera discuté avant un autre."
                                            },
                                            {
                                                "example_id": "e14ab4c8-1b63-491b-86d0-88c53281cc92",
                                                "sense_id": "a62bb87f-8f9b-36e1-82f1-10e0c1b703c3",
                                                "text": "Actions de priorité, celles qui sont investies du droit de participer avant les autres à la répartition des bénéfices ou de l’actif social."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                        "entry_id": "2b7ac309-4228-394b-9a53-6af4eba05bfb",
                                        "glosses": [
                                            "Droit, établi par des règlements, de passer avant un autre sur une route, de monter avant les autres dans une voiture de transports publics, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "764dfe7a-9e6b-474c-ad33-68bbed0a8d72",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Cette voiture avait la priorité, elle avait le droit de s’engager la première sur telle route."
                                            },
                                            {
                                                "example_id": "9e439978-bcfc-42c6-8d97-ccc221e2b2c1",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Cette péniche a la priorité, elle a le droit d’accéder avant les autres à telle écluse, à telle gare, à tel quai."
                                            },
                                            {
                                                "example_id": "f225d5a2-c29a-498e-bc79-737d1b2081b8",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "Carte de priorité, carte qui assure la priorité."
                                            },
                                            {
                                                "example_id": "12b6400f-77a8-4ae0-aad6-b437331ebe55",
                                                "sense_id": "5e03eb6c-408f-3684-aebb-301d791e3190",
                                                "text": "La carte de priorité pour personne handicapée est délivrée par la CDAPH à toute personne atteinte d’une incapacité inférieure à 80 % rendant la station debout pénible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
