                                            {
                                                "example_id": "c33ffe6e-7927-4c4a-9e7d-b2743944e3d6",
                                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                                "text": "„Eine übermäßige Talgproduktion der Haut kann zu fettiger Haut führen und Unreinheiten begünstigen.“"
                                            },
                                            {
                                                "example_id": "af6568d5-4c49-49d1-8acd-321818f485f6",
                                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                                "text": "„Falten, Unreinheiten, Pigmentflecken sowie ein fahler Teint lassen sich demnach nicht nur auf schädliche UV-Strahlen zurückführen, sondern angeblich auch auf Feinstaub aus Autoabgasen, Industrie-Emissionen, Smog und Rauch.“"
                                            },
                                            {
                                                "example_id": "672c8db9-bfc2-4c15-8ba3-92dbca4ea71a",
                                                "sense_id": "c4b570d7-5808-3a25-bbf4-8928aed633ce",
                                                "text": "„Die Deckkraft kann sich sehen lassen: Rötungen und Unreinheiten sind komplett verschwunden.“"
                                            }
