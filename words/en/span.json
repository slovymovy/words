                            "target_lang_translations": {
                                "ru": "Мистер <w>Спэн</w> был известен своим вкладом в местную библиотеку.",
                                "zh": "<w>斯潘</w>先生因对当地图书馆的贡献而闻名。"
                            }
                        },
                        {
                            "text": "We invited the <w>Span</w> family to the neighborhood gathering.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Спэн</w> на соседскую вечеринку.",
                                "zh": "我们邀请了<w>斯潘</w>一家来参加社区聚会。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "一个姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спэн",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "斯潘",
