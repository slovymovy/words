                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec140e61-d55a-4714-a0be-76213b4f210c",
                                                "sense_id": "d853e5dc-ada3-3dff-80d8-9a54d9495d11",
                                                "text": "Ich habe lange auf dich gewartet."
                                            },
                                            {
                                                "example_id": "97c3510b-dc55-4bee-a83b-57ab7eeef5df",
                                                "sense_id": "d853e5dc-ada3-3dff-80d8-9a54d9495d11",
                                                "text": "Das ist lange her."
                                            },
                                            {
                                                "example_id": "5faf8f64-8493-4417-a650-4c5403228333",
                                                "sense_id": "d853e5dc-ada3-3dff-80d8-9a54d9495d11",
                                                "text": "Sie arbeitete lange, länger als gewöhnlich, weil die wöchentliche Konferenz diesmal länger als gewöhnlich gedauert hatte. Am längsten zogen sich diese Termine hin, als die Umstellung des Betriebssystems beschlossen werden sollte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
