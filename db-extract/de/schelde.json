                                        "entry_id": "01218a27-99ef-3897-87f3-de4a6081a76e",
                                        "glosses": [
                                            "een rivier die ontspringt in de gemeente Gouy in noordelijk Frankrijk en door Henegouwen en Vlaanderen via Gent en Antwerpen naar de Noordzee stroomt"
                                        ],
                                        "tags": [
                                            "toponiem: rivier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57a7c821-33d9-412f-8c12-9e0eab317286",
                                                "sense_id": "6a831942-07a2-3d7f-950c-b98f18393c69",
                                                "text": "Tijdens haar loop van bron tot monding wordt de Schelde gevoed door meerdere zijrivieren."
                                            }
                                        ]
                                    }
                                ]
                            }
