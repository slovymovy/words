                ],
                "senses": [
                    {
                        "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                        "entry_id": "1c038a53-d824-31eb-9a41-1b7aa1e22dae",
                        "glosses": [
                            "Ce qu’on attache sur le genou pour le protéger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8d613b-943e-4c94-8ac8-7d3720696018",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Genouillère de couvreur."
                            },
                            {
                                "example_id": "c3322804-59fa-48ec-ac6e-5bcc2c9c4837",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Bottes à genouillère."
                            },
                            {
                                "example_id": "4a43c106-c333-4143-a12d-ffb4f83655ee",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Il se trouva dans une petite rue fort noire qu’on lui avait indiquée ; elle était si étroite, que les genouillères de ses bottes touchaient aux deux murs."
                            },
                            {
                                "example_id": "ee2315b8-03cb-463f-b8de-36ce84cf26a3",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Les jambes aussi, gonflées sous les pantalons par les diverses protections de caoutchouc, de mousse durcie et de matières plastiques, genouillères, cuissières et chevillières, semblaient ne pas appartenir à des têtes aussi juvéniles."
                            },
                            {
                                "example_id": "c462826c-7fee-4868-ab3a-0886b567985d",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Atteint de rhumatismes, il dut mettre des genouillères."
                            },
                            {
                                "example_id": "51cd425b-1162-4bcd-abaf-a2d845c8db14",
                                "sense_id": "2b3173fb-4e70-38d2-a5f6-8762a59e9723",
                                "text": "Genouillère de cheval."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2f06262-3de7-3325-963f-f52263c750b7",
                        "entry_id": "1c038a53-d824-31eb-9a41-1b7aa1e22dae",
                        "glosses": [
                            "Partie de l’armure qui servait à couvrir le genou."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5a860634-3a05-3958-b92a-6e66d77ea160",
