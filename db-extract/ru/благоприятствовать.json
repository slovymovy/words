                                                "example_id": "0586b0ca-bb7c-48b9-b2ab-c00a712f6cee",
                                                "sense_id": "db317304-3007-32ab-b7e5-1996ce968fa7",
                                                "text": "I need a favour. Could you lend me £5 until tomorrow, please?"
                                            },
