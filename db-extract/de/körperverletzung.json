                                                "example_id": "76b90381-6267-4bf2-8412-0eecc70949ae",
                                                "sense_id": "6f608eed-3e48-33e0-b1ce-740d702a0cec",
                                                "text": "Unshaken bears the assault / Of their most dreaded foe, the strong southwest."
                                            },
