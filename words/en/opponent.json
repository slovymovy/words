{
    "word_family": [
        "oppose",
        "opposition",
        "opposing",
        "oppositional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7ed6d2c0-3dcd-3e72-825f-9393027f85d7",
                    "sense_definition": "A person who plays against another in a game, sport, or competition.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_opposing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer knocked out his <w>opponent</w> in the first round.",
                            "target_lang_translations": {
                                "ru": "Боксер нокаутировал своего <w>противника</w> в первом раунде.",
                                "tr": "Boksör, ilk rauntta <w>rakibini</w> nakavt etti."
                            }
                        },
                        {
                            "text": "She shook hands with her <w>opponent</w> after the tennis match.",
                            "target_lang_translations": {
                                "ru": "Она пожала руку своей <w>сопернице</w> после теннисного матча.",
                                "tr": "Tenis maçından sonra <w>rakibiyle</w> el sıkıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "adversary",
                        "rival"
                    ],
                    "antonyms": [
                        "supporter"
                    ],
                    "common_phrases": [
                        "defeat an opponent",
                        "beat an opponent",
                        "face an opponent",
                        "tough opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который играет против другого в игре, спорте или соревновании.",
                        "tr": "Bir oyunda, sporda veya yarışmada başkasına karşı oynayan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "в спорте, игре или соревновании"
                            },
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "в единоборствах или военных играх"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rakip",
                                "target_lang_sense_clarification": "spor, oyun veya yarışmada"
                            },
                            {
                                "target_lang_word": "karşı taraf",
                                "target_lang_sense_clarification": "müsabakada karşı karşıya gelinen taraf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bb1ac9e-9c0a-3bab-b034-30971e4c493a",
                    "sense_definition": "A person who disagrees with a plan, policy, or idea and tries to change or stop it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "person_opposing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a vocal <w>opponent</w> of the new tax law for years.",
                            "target_lang_translations": {
                                "ru": "Он был ярым <w>противником</w> нового налогового закона в течение многих лет.",
                                "tr": "Yıllardır yeni vergi yasasının sesli bir <w>karşıtı</w> olmuştur."
                            }
                        },
                        {
                            "text": "The senator is a fierce <w>opponent</w> of the proposed changes to the healthcare system.",
                            "target_lang_translations": {
                                "ru": "Сенатор является яростным <w>противником</w> предлагаемых изменений в системе здравоохранения.",
                                "tr": "Senatör, sağlık sisteminde önerilen değişikliklerin sert bir <w>muhalifidir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "antagonist",
                        "adversary"
                    ],
                    "antonyms": [
                        "proponent",
                        "advocate",
                        "supporter"
                    ],
                    "common_phrases": [
                        "political opponent",
                        "vocal opponent",
                        "staunch opponent",
                        "opponent of the regime"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который не согласен с планом, политикой или идеей и пытается изменить или остановить их.",
                        "tr": "Bir plana, politikaya veya fikre katılmayan ve bunu değiştirmeye veya durdurmaya çalışan kişi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "тот, кто выступает против чего-либо"
                            },
                            {
                                "target_lang_word": "оппонент",
                                "target_lang_sense_clarification": "в политике или публичных дебатах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşıt",
                                "target_lang_sense_clarification": "bir fikre veya politikaya karşı olan kimse"
                            },
                            {
                                "target_lang_word": "muhalif",
                                "target_lang_sense_clarification": "siyasette veya görüşlerde karşı duran"
                            },
                            {
                                "target_lang_word": "rakip",
                                "target_lang_sense_clarification": "siyasi veya toplumsal mücadelede karşı taraf"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75db4a88-0a1a-3e42-9425-3b3b005ecd58",
                    "sense_definition": "Someone who competes with or fights against another person in a general context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_opposing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is difficult to convince an <w>opponent</w> who refuses to listen to reason.",
                            "target_lang_translations": {
                                "ru": "Трудно убедить <w>оппонента</w>, который отказывается прислушаться к голосу разума.",
                                "tr": "Mantığı dinlemeyi reddeden bir <w>rakibi</w> ikna etmek zordur."
                            }
                        },
                        {
                            "text": "She viewed her business rival as a formidable <w>opponent</w>.",
                            "target_lang_translations": {
                                "ru": "Она рассматривала своего конкурента по бизнесу как грозного <w>противника</w>.",
                                "tr": "İş dünyasındaki rakibini dişli bir <w>rakip</w> olarak görüyordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "adversary",
                        "antagonist"
                    ],
                    "antonyms": [
                        "supporter",
                        "advocate"
                    ],
                    "common_phrases": [
                        "formidable opponent",
                        "worthy opponent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, кто соревнуется или сражается с другим человеком в общем контексте.",
                        "tr": "Genel anlamda başka bir kişiyle rekabet eden veya ona karşı mücadele eden kimse."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противник",
                                "target_lang_sense_clarification": "враг или недоброжелатель"
                            },
                            {
                                "target_lang_word": "соперник",
                                "target_lang_sense_clarification": "конкурент"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "rakip",
                                "target_lang_sense_clarification": "genel rekabet veya iş hayatında"
                            },
                            {
                                "target_lang_word": "karşıt",
                                "target_lang_sense_clarification": "karşı tarafta yer alan kimse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9f6c517f-cc47-3f66-91e0-23a4ea67ea03",
                    "sense_definition": "The participant who opens a formal academic debate by proposing objections to a thesis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "debate_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical disputation, the <w>opponent</w> presented three arguments against the theory.",
                            "target_lang_translations": {
                                "ru": "В историческом диспуте <w>оппонент</w> представил три аргумента против теории.",
                                "tr": "Tarihi münazarada, <w>muhalif</w> teoriye karşı üç argüman sundu."
                            }
                        },
                        {
                            "text": "The <w>opponent</w> and the respondent took turns speaking during the formal debate.",
                            "target_lang_translations": {
                                "ru": "<w>Оппонент</w> и респондент выступали по очереди во время официальных дебатов.",
                                "tr": "Resmi tartışma sırasında <w>karşı taraf</w> ve yanıtlayan sırayla konuştu."
                            }
                        }
                    ],
                    "antonyms": [
                        "respondent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical academic context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участник официальных дебатов, выдвигающий возражения против тезиса.",
                        "tr": "Resmi bir akademik tartışmada bir teze karşı argümanlar sunarak tartışmayı açan katılımcı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оппонент",
                                "target_lang_sense_clarification": "участник диспута или защиты диссертации"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "muhalif",
                                "target_lang_sense_clarification": "tartışmada karşı tezi savunan"
                            },
                            {
                                "target_lang_word": "opponend",
                                "target_lang_sense_clarification": "akademik tartışmalarda karşı görüş bildiren kişi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5baa705-0ae3-3c30-86de-48dbcdbe860f",
                    "sense_definition": "Acting against something or someone; opposing or antagonistic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight raised his shield against the <w>opponent</w> forces.",
                            "target_lang_translations": {
                                "ru": "Рыцарь поднял свой щит против <w>вражеских</w> сил.",
                                "tr": "Şövalye, <w>düşman</w> güçlerine karşı kalkanını kaldırdı."
                            }
                        },
                        {
                            "text": "They struggled against the <w>opponent</w> wind to reach the shore.",
                            "target_lang_translations": {
                                "ru": "Они боролись со <w>встречным</w> ветром, чтобы добраться до берега.",
                                "tr": "Kıyıya ulaşmak için <w>karşı</w> rüzgara karşı mücadele ettiler."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly literary or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий против чего-либо или кого-либо; противостоящий или враждебный.",
                        "tr": "Bir şeye veya birine karşı hareket eden; karşı koyan veya düşmanca olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "враждебный",
                                "target_lang_sense_clarification": "настроенный против"
                            },
                            {
                                "target_lang_word": "противостоящий",
                                "target_lang_sense_clarification": "оказывающий сопротивление"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşı",
                                "target_lang_sense_clarification": "karşı koyan, muhalif olan"
                            },
                            {
                                "target_lang_word": "düşman",
                                "target_lang_sense_clarification": "karşı tarafta yer alan güçler için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df13e201-67b3-3acf-8c45-dd02f6e41740",
                    "sense_definition": "Situated in front of or opposite to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood on the <w>opponent</w> bank of the river looking across.",
                            "target_lang_translations": {
                                "ru": "Он стоял на <w>противоположном</w> берегу реки и смотрел на другую сторону.",
                                "tr": "Nehrin <w>karşı</w> kıyısında durmuş karşı tarafa bakıyordu."
                            }
                        },
                        {
                            "text": "The two houses stood on <w>opponent</w> sides of the street.",
                            "target_lang_translations": {
                                "ru": "Два дома стояли на <w>противоположных</w> сторонах улицы.",
                                "tr": "İki ev caddenin <w>karşı</w> kenarlarında duruyordu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly literary or obsolete usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Расположенный напротив или на другой стороне.",
                        "tr": "Bir şeyin önünde veya tam karşısında yer alan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоположный",
                                "target_lang_sense_clarification": "находящийся напротив"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "karşı",
                                "target_lang_sense_clarification": "karşı tarafta bulunan"
                            },
                            {
                                "target_lang_word": "karşıt",
                                "target_lang_sense_clarification": "karşı karşıya duran"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}