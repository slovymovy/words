                        "examples": [
                            {
                                "example_id": "f5988043-1298-4530-a2f8-6af1becbeaae",
                                "sense_id": "caadf2e0-80aa-3a55-85ec-afae5b12f663",
                                "text": "„Ihm nachgehend fand sich Robert inmitten von Kellergelassen, deren nackte Steinwände ohne Decke durch die Trümmer in die Luft ragten.“"
                            },
                            {
                                "example_id": "3280cbe0-a8ca-4e6c-84bf-9f714844ba44",
                                "sense_id": "caadf2e0-80aa-3a55-85ec-afae5b12f663",
                                "text": "„Sie verlässt den Ehemann und lebt mit ihrem Sohn für 75 Pfennige im Monat in einem Kellergelass, das sie einem Portier abgemietet hat.“"
                            }
                        ],
