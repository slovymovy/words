                                "target_senses": [
                                    {
                                        "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                        "entry_id": "4070f833-38b4-3e44-b8bf-7b42faad3810",
                                        "glosses": [
                                            "A direct popular vote on a proposed law or constitutional amendment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bcc566-cef3-496e-a491-d158cffa2b81",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "a referendum on …"
                                            },
                                            {
                                                "example_id": "d663936e-4f2d-4ac6-823f-2448e7d781be",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "In some cases, a referendum on the proposed bond issue must be held."
                                            },
                                            {
                                                "example_id": "54881714-0832-4699-9c8a-e932da37eedd",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "Article 74: The Republic of Karakalpakstan shall have the right to secede from the Republic of Uzbekistan on the basis of a nation-wide referendum held by the people of Karakalpakstan."
                                            },
                                            {
                                                "example_id": "673248b8-8ed8-42a6-9176-94b75f46d52a",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "Although the Cook Islands held a referendum in 1994, when voters rejected a name change, the yearning for a decolonised identity has not disappeared."
                                            },
                                            {
                                                "example_id": "4e4b3365-3194-4657-8b19-fa61722c48ec",
                                                "sense_id": "ed04879f-0952-312c-bd61-1ea1f738bd79",
                                                "text": "[Salvador] Illa ascribed the nationalist surge in Catalonia that fuelled support for the 2017 referendum – and Brexit in the UK – as populist responses to the financial crisis of 2008."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7746282b-147a-3950-b8b5-29ac42d14d32",
                                        "entry_id": "4070f833-38b4-3e44-b8bf-7b42faad3810",
                                        "glosses": [
                                            "An action, choice, etc., which is perceived as passing judgment on another matter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98fc076e-0924-4cb0-be4f-14cca2dc7de6",
                                                "sense_id": "7746282b-147a-3950-b8b5-29ac42d14d32",
                                                "text": "My father is taking my decision on whether to go to university as a referendum on his performance as a parent, and it's very stressful."
                                            }
                                        ]
                                    }
                                ]
