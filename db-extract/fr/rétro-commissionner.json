                        "entry_id": "556a59b5-b5ac-3c46-8faf-f3aac79b168a",
                        "glosses": [
                            "Verser une rétro-commission à quelqu’un."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b61d53b-7d06-4ff1-86f7-894d62815776",
                                "sense_id": "af24f873-52ce-30d6-bd1e-b9428c439da6",
                                "text": "On avait aussi entendu dire qu'il fallait aussi \"rétro-commissionner\" pour vendre ses produits à Carrefour."
                            },
                            {
                                "example_id": "b8d6aa55-bd9f-4972-a750-27f61e5a0e2e",
                                "sense_id": "af24f873-52ce-30d6-bd1e-b9428c439da6",
                                "text": "C'est bien connu : les politiques n'agissent pas pour les lobbies, ne se font pas rétro-commissionner…"
                            },
                            {
                                "example_id": "35a41687-99a7-45c4-b07c-0d19fe3af6cf",
                                "sense_id": "af24f873-52ce-30d6-bd1e-b9428c439da6",
                                "text": "Que ce soit pour récompenser un filleul, offrir pour le plaisir ou rétro-commissionner un ami, cette vidéo vous sera utile !"
                            }
                        ]
                    }
