                    {
                        "translation_id": "29f3e902-db3a-4232-89cf-ba27e5fc053b",
                        "source_entry_id": "9a940cc7-1abd-3fc2-ad62-3e1e2d6f2574",
                        "source_sense_id": "b653a940-eb49-3a6c-a07f-febf97c5fb86",
                        "source_sense_description": "eindeutige, aus Ziffern bestehende Kennung zur Anwahl eines Telefonanschlusses",
                        "target_lang_word": "numéro de téléphone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "numéro de téléphone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9848d7d9-1cf8-33da-96dc-0e568430e029",
                                        "entry_id": "03876de2-d876-3815-9a4e-20fa03f8fec7",
                                        "glosses": [
                                            "Suite de chiffres (et plus rarement de lettres) qui identifie de façon unique un abonné téléphonique, et permet de l’appeler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae7c212a-3c1e-4cfd-93bd-ae692f4af3a7",
                                                "sense_id": "9848d7d9-1cf8-33da-96dc-0e568430e029",
                                                "text": "Qui aurait pu penser que Claire se servirait du numéro de téléphone qu'il avait collé sur le frigo en cas de problème, et ce depuis neuf ans qu'il accompagnait cette excursion?"
                                            },
                                            {
                                                "example_id": "e824f6b5-d19b-4261-80ef-dee49f9667c0",
                                                "sense_id": "9848d7d9-1cf8-33da-96dc-0e568430e029",
                                                "text": "Tout ceci est lié au numéro de téléphone de l’utilisateur, lui-même enregistré sous son identité. Le gouvernement a accès aux données collectées par Baidu, Alibaba, Tencent, Xiaomi et autres opérateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
