                        "sense_id": "10633894-ef72-3422-99ef-141d213c5b74",
                        "entry_id": "c3009b2c-693d-366f-a777-0504a051b15a",
                        "glosses": [
                            "Grand bâtiment de charge que l’Espagne employait autrefois pour transporter en Europe les produits des mines du Pérou, du Mexique, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7eac9bd-697b-4453-b7d2-8007e8201ad1",
                                "sense_id": "10633894-ef72-3422-99ef-141d213c5b74",
                                "text": "Armer un galion."
                            },
                            {
                                "example_id": "1790fb45-1200-43a2-9c8f-a1ef71914cb5",
                                "sense_id": "10633894-ef72-3422-99ef-141d213c5b74",
                                "text": "Les galions de Vigo."
                            },
                            {
                                "example_id": "552924b5-79c9-4621-8d18-87d676c08c78",
                                "sense_id": "10633894-ef72-3422-99ef-141d213c5b74",
                                "text": "Un galion toute voilure déployée ne ressemble pas à une galère."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2a37a7e-4e97-4d2f-bdcf-eb639db88183",
                        "source_entry_id": "c3009b2c-693d-366f-a777-0504a051b15a",
                        "source_sense_id": "10633894-ef72-3422-99ef-141d213c5b74",
                        "target_lang_word": "Galeone",
                        "target_lang_code": "de",
