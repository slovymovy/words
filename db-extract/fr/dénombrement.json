        "fr-extract.jsonl": [
            {
                "entry_id": "dcefc7c4-291a-3b17-9045-058db3f27bf0",
                "word": "dénombrement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dfb4e985-5bdb-4320-8516-56138a08219e",
                        "entry_id": "dcefc7c4-291a-3b17-9045-058db3f27bf0",
                        "tags": [
                            "plural"
                        ],
                        "form": "dénombrements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ddf4136c-5da2-3891-b770-f41e44259651",
                        "entry_id": "dcefc7c4-291a-3b17-9045-058db3f27bf0",
                        "glosses": [
                            "Action de dénombrer ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "984aa5a7-7cbb-4263-b41e-e81a5e759d68",
                                "sense_id": "ddf4136c-5da2-3891-b770-f41e44259651",
                                "text": "Homère, dans le second chant de l’Iliade, fait le dénombrement des Grecs qui étaient au siège de Troie."
                            },
                            {
                                "example_id": "96d5d9d4-4903-4437-adbb-6091b9f5160e",
                                "sense_id": "ddf4136c-5da2-3891-b770-f41e44259651",
                                "text": "La pauvre innocente, en effet, avait un culte pour les moutons et s’acquittait très bien du rôle de bergère, moins le dénombrement, à la rentrée, qu’elle n’était pas en état de faire."
                            },
                            {
                                "example_id": "3ac2f519-bb93-40f5-a54d-900c89e88007",
                                "sense_id": "ddf4136c-5da2-3891-b770-f41e44259651",
                                "text": "Mais je m'écarte de l'histoire Hapley-Pawkins.\nElle a commencé, il y a bien des années , à l'occasion d'un dénombrement, fait par Pawkins, des microlépidoptères (dont je ne veux rien dire), dans lequel il portait comme disparue une nouvelle espèce inventée par Hapley."
                            },
                            {
                                "example_id": "23f80ad5-d73a-4377-9aaa-73895f2f1bf7",
                                "sense_id": "ddf4136c-5da2-3891-b770-f41e44259651",
                                "text": "Ireneo Funes, ce héros d’une nouvelle de Borges qui, à la suite d’un accident, avait acquis une faculté de dénombrement presque pathologique, au point de percevoir « tous les rejets, les grappes et les fruits qui composent une treille »."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e648b3c-df69-36d9-8d9f-ea43f992024f",
                        "entry_id": "dcefc7c4-291a-3b17-9045-058db3f27bf0",
                        "glosses": [
                            "Énonciation dans les prémisses de données dont dépend la conclusion."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbf52898-2f9e-4690-9025-36c9994597b7",
                        "source_entry_id": "dcefc7c4-291a-3b17-9045-058db3f27bf0",
                        "target_lang_word": "численность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "численность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7b4c7084-d763-375f-91ba-6800f686f6d6",
                                        "entry_id": "0b03dfd4-ae67-3650-8aa4-ce3f1afc7f34",
                                        "glosses": [
                                            "количество, численный состав чего-либо (обычно о населении, коллективах людей, поголовье животных и других счётных множествах)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3924eedf-5a44-4877-936c-23f926b509b7",
                                                "sense_id": "7b4c7084-d763-375f-91ba-6800f686f6d6",
                                                "text": "Имперская армия по удалении Валленштейна убыла до 40 000 человек и численностью сравнялась с протестантскою."
                                            },
                                            {
                                                "example_id": "b548cad1-eea5-448d-9abc-d39888c3b80b",
                                                "sense_id": "7b4c7084-d763-375f-91ba-6800f686f6d6",
                                                "text": "Одновременно парашютисты должны были сообщать своему командованию о численности войск противника."
                                            },
                                            {
                                                "example_id": "256a72d2-0fa7-4c75-8dfe-8d91c9905fbb",
                                                "sense_id": "7b4c7084-d763-375f-91ba-6800f686f6d6",
                                                "text": "Левые течения, представленные преимущественно студентами-медиками, преобладали и по численности, и по настойчивости своей тактики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
