                    {
                        "sense_id": "23fa8b0b-be7e-3d4e-aae4-066c9ce1d05d",
                        "entry_id": "98c3b268-720d-3697-813f-cc51a87448b8",
                        "glosses": [
                            "in het merendeel van de gevallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc3dae8-bf85-4fe9-88d4-0128af561f11",
                                "sense_id": "23fa8b0b-be7e-3d4e-aae4-066c9ce1d05d",
                                "text": "Daarover wordt meestal niet gesproken."
                            },
                            {
                                "example_id": "eaeb4c62-0fcb-4617-8fab-0862bc7a7074",
                                "sense_id": "23fa8b0b-be7e-3d4e-aae4-066c9ce1d05d",
                                "text": "Op de tweede dag na, ben ik elke ochtend steeds de eerste die aan het ontbijt verschijnt. Meestal nog eerder dan Vincenzo, maar vandaag zit hij al klaar."
                            },
                            {
                                "example_id": "eace05e8-ea37-4b38-b5dd-d1f3719eb23a",
                                "sense_id": "23fa8b0b-be7e-3d4e-aae4-066c9ce1d05d",
                                "text": "Het bijzondere aan alleen reizen is dat je nieuwe mensen ontmoet. Thuis verkeerde ik meestal in mijn vertrouwde kringetjes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c89c8b48-78e0-4bc1-9553-053ffc420ed1",
                        "source_entry_id": "98c3b268-720d-3697-813f-cc51a87448b8",
                        "source_sense_id": "23fa8b0b-be7e-3d4e-aae4-066c9ce1d05d",
                        "source_sense_description": "in het merendeel van de gevallen",
                        "target_lang_word": "meistens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
