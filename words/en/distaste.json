{
    "word_family": [
        "taste",
        "tasty",
        "tasteless",
        "distasteful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0f34bf4-8e69-356b-ab3d-cf4ca458bf24",
                    "sense_definition": "A feeling of dislike, aversion, or antipathy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She looked at the messy room with clear <w>distaste</w>.",
                            "target_lang_translations": {
                                "zh": "她看着那间凌乱的房间，流露出明显的<w>厌恶</w>。"
                            }
                        },
                        {
                            "text": "He expressed his <w>distaste</w> for the new company policy.",
                            "target_lang_translations": {
                                "zh": "他表达了对公司新政策的<w>反感</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "aversion",
                        "dislike",
                        "antipathy"
                    ],
                    "antonyms": [
                        "liking",
                        "fondness"
                    ],
                    "common_phrases": [
                        "show distaste",
                        "express distaste"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种厌恶、反感或不喜欢的心理感受。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "指对某人或某事产生强烈的反感。"
                            },
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "指对某种行为或观点感到不赞同或不舒服。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e281e866-45b3-3740-a998-35f635c3823b",
                    "sense_definition": "To feel dislike for something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "dislike",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people <w>distaste</w> the idea of working on weekends.",
                            "target_lang_translations": {
                                "zh": "许多人对周末加班的想法感到<w>厌恶</w>。"
                            }
                        },
                        {
                            "text": "He <w>distasted</w> the way his colleagues treated the new intern.",
                            "target_lang_translations": {
                                "zh": "他很<w>反感</w>同事们对待那位实习生的方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dislike",
                        "abhor"
                    ],
                    "antonyms": [
                        "relish"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This verb usage is now rare and often considered literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对某事感到不喜欢（现多为文学或古旧用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "厌恶",
                                "target_lang_sense_clarification": "表示对某事物的排斥感。"
                            },
                            {
                                "target_lang_word": "反感",
                                "target_lang_sense_clarification": "表示对某事物的抵触情绪。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}