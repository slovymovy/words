                        "glosses": [
                            "In a joyful manner; joyfully."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "647c9378-238c-470b-8263-3f838549d951",
                                "sense_id": "6eb28fe7-f78f-3dd1-8319-41c1dcd34c7e",
                                "text": "Uncle Henry was milking the cows in the barnyard, and Toto had jumped out of her arms and was running toward the barn, barking joyously."
                            },
                            {
                                "example_id": "da26a79a-88b7-48b1-983b-5727d95f05db",
                                "sense_id": "6eb28fe7-f78f-3dd1-8319-41c1dcd34c7e",
                                "text": "Unusually, it runs non-stop from Hounslow to Barnes, and we took this 5¾ miles so joyously that we had to wait nearly two minutes at Barnes for the right-away!"
                            }
                        ]
                    }
                ],
