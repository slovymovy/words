                        "entry_id": "1aa034e6-6c6a-3828-8679-0b2a4798974f",
                        "glosses": [
                            "Plant de tomate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89dcfad7-a2f3-40bf-9c5c-58e7cf72cc88",
                                "sense_id": "10176042-f03a-3b8a-a85a-f9640ba48f40",
                                "text": "J'ai eu la surprise de voir un tomatier monter à l'assaut de la gloriette."
                            },
                            {
                                "example_id": "7474f5f8-2a1e-4cd4-9096-ad2068de851c",
                                "sense_id": "10176042-f03a-3b8a-a85a-f9640ba48f40",
                                "text": "Soit par exemple deux noms de plantes absents des dictionnaires: tomatier et belocier."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dbdf55a-75b8-3130-9aa7-6a2b3db2704f",
                        "entry_id": "1aa034e6-6c6a-3828-8679-0b2a4798974f",
                        "glosses": [
                            "Cultivateur de tomates."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f19092eb-b5f4-4942-a267-9b51e7d8a632",
                                "sense_id": "4dbdf55a-75b8-3130-9aa7-6a2b3db2704f",
                                "text": "[La Société américaine Libby] offrait entre autres aux tomatiers des machines à ensemencer directement, et cette suppression du repiquage diminue évidemment les frais de main d'œuvre."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fa079f9-3863-3a50-9864-d0d1a685982d",
                        "entry_id": "1aa034e6-6c6a-3828-8679-0b2a4798974f",
                        "glosses": [
                            "Gâteau à la tomate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf38802f-6075-4782-b146-822094553118",
                                "sense_id": "5fa079f9-3863-3a50-9864-d0d1a685982d",
                                "text": "Un faux air de fraiser, le tomatier."
                            }
                        ]
                    }
