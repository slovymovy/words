                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eee2dca4-faec-4c07-83f2-c1376cef4606",
                                "sense_id": "d0447d43-ffa9-3310-ae9b-cefe23f9ec4b",
                                "text": "„Ausgerechnet beim 15. Geburtstag hat es für Österreichs Slalom-Asse die bitterste Niederlage im Schladminger Weltcup-Nachtslalom gegeben.“"
                            },
                            {
                                "example_id": "62d1930c-9287-4968-8bdd-975680be0b61",
                                "sense_id": "d0447d43-ffa9-3310-ae9b-cefe23f9ec4b",
                                "text": "„Alexander Choroschilow gewinnt mit großem Vorsprung den Nachtslalom von Schladming vor Stefano Gross.“"
                            },
                            {
                                "example_id": "b1f798d9-40a7-4e1c-8c60-870bf63d0a1f",
                                "sense_id": "d0447d43-ffa9-3310-ae9b-cefe23f9ec4b",
                                "text": "„Der Berner Luca Aerni kämpft sich beim Weltcup-Nachtslalom von Madonna vom 26. auf den 5. Rang vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
