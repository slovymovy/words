{
    "word_family": [
        "dégradation",
        "dégradant",
        "dégradable",
        "biodégradable",
        "biodégradation",
        "indégradable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "383481c7-8275-3ff2-b483-2b7e112dfed8",
                    "sense_definition": "Détériorer, endommager ou altérer l'état matériel de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deteriorer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des individus ont été surpris en train de <w>dégrader</w> les murs extérieurs de l'établissement."
                        },
                        {
                            "text": "L'humidité permanente finit par <w>dégrader</w> les peintures et les structures en bois."
                        }
                    ],
                    "synonyms": [
                        "détériorer",
                        "endommager",
                        "abîmer"
                    ],
                    "common_phrases": [
                        "dégrader le matériel",
                        "dégrader un bâtiment"
                    ]
                },
                {
                    "sense_id": "846db3da-4991-350f-9b40-1832c5eb834c",
                    "sense_definition": "Avilir, rabaisser ou porter atteinte à la dignité morale d'une personne.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avilir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces attaques personnelles cherchent uniquement à <w>dégrader</w> l'image de son adversaire politique."
                        },
                        {
                            "text": "Il refuse d'accepter des ordres injustes qui visent à le <w>dégrader</w> devant ses collègues."
                        }
                    ],
                    "synonyms": [
                        "avilir",
                        "rabaisser",
                        "humilier"
                    ],
                    "common_phrases": [
                        "dégrader l'image",
                        "dégrader la dignité"
                    ]
                },
                {
                    "sense_id": "7e7ebb00-0737-327a-a6fd-a84d94d652a0",
                    "sense_definition": "Décomposer chimiquement ou biologiquement une matière en éléments plus simples.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decomposer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certaines bactéries sont capables de <w>dégrader</w> les matières plastiques enfouies dans le sol."
                        },
                        {
                            "text": "Ce produit chimique met plusieurs années à se <w>dégrader</w> complètement dans l'eau douce."
                        }
                    ],
                    "synonyms": [
                        "décomposer"
                    ],
                    "common_phrases": [
                        "dégrader les plastiques",
                        "dégrader les déchets organiques"
                    ]
                },
                {
                    "sense_id": "5b10a9bf-e7b5-3b77-bbe1-2b457676aa5e",
                    "sense_definition": "Destituer solennellement quelqu'un de son grade ou de ses fonctions, en particulier dans l'armée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "destituer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal militaire a décidé de <w>dégrader</w> cet officier après sa lourde faute."
                        },
                        {
                            "text": "Le coupable a été solennellement <w>dégradé</w> devant l'ensemble des troupes rassemblées dans la cour."
                        }
                    ],
                    "synonyms": [
                        "destituer"
                    ],
                    "antonyms": [
                        "promouvoir"
                    ],
                    "common_phrases": [
                        "dégrader un soldat",
                        "dégrader un officier"
                    ]
                },
                {
                    "sense_id": "1b0225f6-e19c-3479-a03d-487542742251",
                    "sense_definition": "Faire passer insensiblement une couleur ou une teinte d'une nuance à une autre plus claire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a choisi de <w>dégrader</w> les nuances du ciel pour accentuer l'effet du crépuscule."
                        },
                        {
                            "text": "Il utilise un pinceau doux pour <w>dégrader</w> le bleu foncé vers le blanc pur."
                        }
                    ],
                    "synonyms": [
                        "estomper"
                    ],
                    "common_phrases": [
                        "dégrader les couleurs",
                        "dégrader les tons"
                    ]
                },
                {
                    "sense_id": "c5e6ef5f-bdf7-3334-b058-545c0e0ba931",
                    "sense_definition": "Perdre son aptitude à fournir du travail mécanique, en parlant d'une forme d'énergie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sous l'effet des frottements mécaniques, l'énergie cinétique a tendance à se <w>dégrader</w> en chaleur."
                        },
                        {
                            "text": "Dans ce système thermodynamique, une partie du travail produit va se <w>dégrader</w> spontanément."
                        }
                    ],
                    "common_phrases": [
                        "dégrader l'énergie"
                    ]
                }
            ]
        }
    ]
}