                        "glosses": [
                            "A member of a 13th-century school of interpretation of canon law that emphasized the decretals (letters issued by the Popes on matters of church discipline) in preference to the Decretum Gratiani (1141), which their rivals, the decretists, favoured."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "591bafc6-60a7-4313-962c-1f50f2a004a1",
                                "sense_id": "45f51bd9-4399-3a91-b434-14d37558e2cc",
                                "text": "If the decretalists were concerned that prospective spouses be able to carry out their moral obligations, they were no less interested in preserving spousely rights after the conjugal knot was tied."
                            }
                        ]
                    }
