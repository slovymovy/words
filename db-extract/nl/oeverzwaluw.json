                        "entry_id": "06d141aa-67f8-34e7-a4a8-5ade79983d6e",
                        "glosses": [
                            "Riparia riparia een zangvogel uit de familie van de zwaluwen (Hirundinidae)"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
                            {
                                "example_id": "bf547bc0-417b-456a-b4a1-68a2d98e74f0",
                                "sense_id": "d8919957-c16e-358f-ab6b-9dc42540a700",
                                "text": "De oeverzwaluw laat een kwetterend en zoemend lied horen dat tijdens de vlucht continu doorgaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23ae44d2-8fb4-4c0d-a55d-697f76deaf82",
                        "source_entry_id": "06d141aa-67f8-34e7-a4a8-5ade79983d6e",
                        "source_sense_id": "d8919957-c16e-358f-ab6b-9dc42540a700",
                        "target_lang_word": "sand martin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sand martin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                        "entry_id": "c9b1ea41-311a-3ac1-a25e-bf1f42d6c094",
                                        "glosses": [
                                            "A migratory passerine bird of the swallow family, Riparia riparia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cad6d407-9c69-4b27-b9e7-baca089a8204",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "1668, John Wilkins, An Essay Towards a Real Character, and a Philosophical Language, London: Sa. Gellibrand and John Martyn, Part 2, Chapter 5, p. 151,\nSAND-MARTIN, Shore-bird."
                                            },
                                            {
                                                "example_id": "cc317de6-c558-446a-8901-131c8514a6fe",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "1774, Gilbert White, Letter 20 in The Natural History and Antiquities of Selborne, London: B. White & Son, 1789, p. 175,\nThe only instance I ever remember where this species haunts any building is at the town of Bishop’s Waltham, in this county, where many sand-martins nestle and breed in the scaffold-holes of the back-wall of William of Wykeham’s stables:"
                                            },
                                            {
                                                "example_id": "1af3f0c1-b910-4697-b3dd-63a73a754711",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "The position was perched on a sort of razor-back of limestone with dug-outs driven horizontally into the cliff like sand-martins’ nests."
                                            },
                                            {
                                                "example_id": "bb371cb5-31cf-439e-bec1-3ee35cedf178",
                                                "sense_id": "6a2288ac-59fc-3b07-afee-42f7045e3cf3",
                                                "text": "The sandmartins’ nests were loopholes of darkness in the riverbank."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3ad24cb-ba80-466e-a0cd-b2b9198b14b4",
                        "source_entry_id": "06d141aa-67f8-34e7-a4a8-5ade79983d6e",
                        "source_sense_id": "d8919957-c16e-358f-ab6b-9dc42540a700",
                        "target_lang_word": "hirondelle de rivage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
