                "senses": [
                    {
                        "sense_id": "957d4c79-d0e4-3b8d-b105-5b13660d3440",
                        "entry_id": "2dcde6ca-5cd9-3331-ab40-1d1f606ece65",
                        "glosses": [
                            "ein Gerät, das die Platzierung, zum Beispiel das Auftragen oder Einführen, erleichtert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02a00505-bd8a-4475-8d59-36160c2c5e2c",
                                "sense_id": "957d4c79-d0e4-3b8d-b105-5b13660d3440",
                                "text": "„Die in Deutschland angebotenen dienen alle zur lokalen Behandlung als Salbe mit und ohne Applikator oder als Zäpfchen.“"
                            },
                            {
                                "example_id": "4eb989c6-348e-4e56-a3f6-6b01cd8b0472",
                                "sense_id": "957d4c79-d0e4-3b8d-b105-5b13660d3440",
                                "text": "„Dabei wird mit einem speziellen Applikator ein dünnes Gummibändchen platziert.“"
                            },
                            {
                                "example_id": "ceb1da69-954f-4c97-8908-30f9a881c340",
                                "sense_id": "957d4c79-d0e4-3b8d-b105-5b13660d3440",
                                "text": "„Mittels Applikatoren, d. h. speziellen Vorrichtungen, können ein bzw. mehrere Strahler bei der Brachytherapie mit umschlossenen Radionukliden in die gewünschte Position des zu bestrahlenden Gewebes oder an dessen Oberfläche gebracht werden.“"
                            },
                            {
                                "example_id": "63928828-2690-4c6c-9b91-cbbe0046dc9c",
                                "sense_id": "957d4c79-d0e4-3b8d-b105-5b13660d3440",
                                "text": "„Zum Schattieren verwende ich einen grauschwarzen Lidschatten, den ich am besten mit einem weichen, flächigen Pinsel oder einem Applikator wirklich nur auf das bewegliche Lid auftrage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
