                                    },
                                    {
                                        "sense_id": "ff0b8957-e7d4-3db8-ad3b-0ce9dfd199da",
                                        "entry_id": "35beccdf-9681-350a-8f6a-0dff7528439a",
                                        "glosses": [
                                            "Atelier où travaille le menuisier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5e9bd7-c2b0-42ac-8f19-4dea3d8561c4",
                                                "sense_id": "ff0b8957-e7d4-3db8-ad3b-0ce9dfd199da",
                                                "text": "Chaque matin, je pars livrer du bois à la menuiserie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "063183a9-ce8e-32ee-9ace-351e2d9bc687",
                                        "entry_id": "35beccdf-9681-350a-8f6a-0dff7528439a",
                                        "glosses": [
                                            "Métier du menuisier. Art de travailler le bois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bce7ee9-2500-40f9-a96c-d0c7c1b8a5da",
                                                "sense_id": "063183a9-ce8e-32ee-9ace-351e2d9bc687",
                                                "text": "Elle y a emménagé, il y a un an, afin de suivre un apprentissage en menuiserie dans l’entreprise Euseda."
                                            },
                                            {
                                                "example_id": "f87c6d05-d6f1-46e4-b0f0-b7d9fbb891c9",
                                                "sense_id": "063183a9-ce8e-32ee-9ace-351e2d9bc687",
                                                "text": "J'ai deux cordes à mon arc : la menuiserie et la taille de pierres."
                                            },
                                            {
                                                "example_id": "3f624f30-a9cc-4bf9-907f-d13f29e7e5d2",
                                                "sense_id": "063183a9-ce8e-32ee-9ace-351e2d9bc687",
                                                "text": "Cette réalisation reprend un grand nombre de techniques de menuiserie : traçages, découpes, entaillages à la scie circulaire et au ciseau à bois, assemblages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a56ae45-0bfd-3087-8228-bad57ee09908",
                                        "entry_id": "35beccdf-9681-350a-8f6a-0dff7528439a",
                                        "glosses": [
                                            "Ouvrage en bois réalisé par un menuisier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2a1504-87ad-4aff-b2d0-bdc5b51f4b73",
                                                "sense_id": "6a56ae45-0bfd-3087-8228-bad57ee09908",
                                                "text": "Voilà de la belle menuiserie !"
                                            },
                                            {
                                                "example_id": "459f3ba4-69c4-47b1-b587-84f37f62986d",
                                                "sense_id": "6a56ae45-0bfd-3087-8228-bad57ee09908",
                                                "text": "On peut admirer dans cette église un magnifique exemple de menuiserie du XVᵉ siècle."
                                            }
                                        ]
                                    }
