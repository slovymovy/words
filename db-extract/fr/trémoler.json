                "senses": [
                    {
                        "sense_id": "7517bc09-d3d6-3194-acf5-65c47c4ff53b",
                        "entry_id": "2208714f-1c17-365c-8039-8f686ce4c96e",
                        "glosses": [
                            "Faire un trémolo."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89a0a926-6425-4769-8ed5-cf24abc9a63b",
                                "sense_id": "7517bc09-d3d6-3194-acf5-65c47c4ff53b",
                                "text": "Trois paires de choucas font des circuits prudents autour de la cabane et, comme rien ne bouge, s’abattent en caquetant devant la porte ; soudain décollent, effarés, avec un grand froufroutement de plumes, car un chant mystérieux s’enfle rythmiquement au sein de la bâtisse, hésite, s’épanouit enfin en ut bémol et trémolant : Antoine ronfle…"
                            },
                            {
                                "example_id": "e4518e37-169b-45bc-8406-3461d409a041",
                                "sense_id": "7517bc09-d3d6-3194-acf5-65c47c4ff53b",
                                "text": "Le cheval s’octroya une pause, sensible à la crispation de son maître qui se cambra, vibra, puis se détendit en laissant trémoler une douce plainte."
                            },
                            {
                                "example_id": "28fafd20-10e2-4a6f-832f-da442fb347f7",
                                "sense_id": "7517bc09-d3d6-3194-acf5-65c47c4ff53b",
                                "text": "Depuis la salle de bains, il doit l'écouter trémoler, sa gerce."
                            },
                            {
                                "example_id": "661024df-5598-4270-bffa-736179975172",
                                "sense_id": "7517bc09-d3d6-3194-acf5-65c47c4ff53b",
                                "text": "N’y tenant plus, Snaky trémola : — Tu crois qu’y en a ?"
                            }
                        ]
                    }
                ],
