                    {
                        "sense_id": "949821d4-f783-3eb1-af77-6222b069cffc",
                        "entry_id": "d72a8418-2484-3726-8a55-0ce6fad0d9a6",
                        "glosses": [
                            "Statut de l'État du Canada selon l'appellation donnée par les Britanniques à la constitution de celui-ci en 1867."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "note": "Cette appellation, de même que sa traduction officielle Puissance, est désuète depuis les années 1930",
                        "examples": [
                            {
                                "example_id": "432bb32c-0290-4bc8-8e13-19a201e6cd22",
                                "sense_id": "949821d4-f783-3eb1-af77-6222b069cffc",
                                "text": "La population de la confédération canadienne appelée par les natifs du nom de Dominion ou Puissance, s’élève donc à 3 507 475 habitants."
                            },
                            {
                                "example_id": "3debd3f4-0664-401b-b8e7-8a5419f77afb",
                                "sense_id": "949821d4-f783-3eb1-af77-6222b069cffc",
                                "text": "Je déteste crier à la « québecophobie ». On doit évidemment pouvoir critiquer le Québec. Mais quelle autre minorité culturelle ou nationale dans notre Dominion a droit à des généralisations de ce type de la part d’universitaires ?"
                            }
                        ]
                    }
