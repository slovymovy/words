                    {
                        "sense_id": "e55e1f91-d36c-37da-90c1-c60825676028",
                        "entry_id": "d46d9361-02b0-3e05-b325-6bf133e2356d",
                        "glosses": [
                            "Action d’adjurer, formule qu’on prononce dans les exorcismes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "476f0b48-94b7-4c81-ad8e-7ca4a36f456d",
                                "sense_id": "e55e1f91-d36c-37da-90c1-c60825676028",
                                "text": "Lorsqu'elle eut achevé et préparé le cercle de la manière qu'elle le souhaitait, elle se plaça et s'arrêta au milieu, où elle fit des adjurations, et récita des versets de l'Alcoran."
                            }
                        ]
                    },
                    {
                        "sense_id": "181d8e09-127c-35fd-9482-bfc8af167ba0",
                        "entry_id": "d46d9361-02b0-3e05-b325-6bf133e2356d",
                        "glosses": [
                            "D’une manière générale, il signifie prière instante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "935bbadf-acf9-437f-8ded-0af74102e2af",
                                "sense_id": "181d8e09-127c-35fd-9482-bfc8af167ba0",
                                "text": "… a déclaré Asa, le visage illuminé d'une pathétique adjuration."
                            }
                        ]
                    }
                ],
