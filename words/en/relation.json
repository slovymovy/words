    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bb180138-0b1a-3873-9009-798960422602",
                    "sense_definition": "The manner in which two or more things are connected or associated.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists are studying the <w>relation</w> between diet and long-term health.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают <w>связь</w> между диетой и долгосрочным здоровьем."
                            }
                        },
                        {
                            "text": "There is a direct <w>relation</w> between the amount of practice and your final score.",
                            "target_lang_translations": {
                                "ru": "Существует прямая <w>зависимость</w> между количеством практики и вашим итоговым баллом."
                            }
                        }
                    ],
                    "synonyms": [
                        "connection",
                        "link",
                        "relationship",
                        "association",
                        "relevance"
                    ],
                    "antonyms": [
                        "irrelation"
                    ],
                    "common_phrases": [
                        "direct relation",
                        "in relation to",
                        "close relation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способ, которым две или более вещи связаны или ассоциированы друг с другом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "взаимная зависимость или соединённость объектов"
                            },
                            {
                                "target_lang_word": "отношение",
                                "target_lang_sense_clarification": "взаимное положение объектов или связь между ними"
                            },
                            {
                                "target_lang_word": "зависимость",
                                "target_lang_sense_clarification": "подверженность влиянию или функциональная связь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afd90ba6-5226-3017-bf61-ddf7b80a1126",
                    "sense_definition": "A person who is connected by blood or marriage; a member of one's family.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a distant <w>relation</w> of mine whom I only see at weddings.",
                            "target_lang_translations": {
                                "ru": "Он мой дальний <w>родственник</w>, которого я вижу только на свадьбах."
                            }
                        },
                        {
                            "text": "She invited every close <w>relation</w> to her graduation party.",
                            "target_lang_translations": {
                                "ru": "Она пригласила каждого близкого <w>родственника</w> на свой выпускной."
                            }
                        }
                    ],
                    "synonyms": [
                        "member of one's family"
                    ],
                    "common_phrases": [
                        "distant relation",
                        "close relation",
                        "blood relation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, связанный кровным родством или браком; член семьи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "родственник",
                                "target_lang_sense_clarification": "человек, имеющий общих предков"
                            },
                            {
                                "target_lang_word": "родственница",
                                "target_lang_sense_clarification": "женщина, имеющая общих предков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3398c306-dbbc-3398-9406-3e5ded538ceb",
                    "sense_definition": "The way in which people, groups, or countries behave toward each other or deal with each other.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foreign <w>relations</w> of the United States are managed by the State Department.",
                            "target_lang_translations": {
                                "ru": "Внешними <w>отношениями</w> Соединенных Штатов управляет Государственный департамент."
                            }
                        },
                        {
                            "text": "Improving diplomatic <w>relations</w> between the two neighbors is a top priority.",
                            "target_lang_translations": {
                                "ru": "Улучшение дипломатических <w>отношений</w> между двумя соседями является главным приоритетом."
                            }
                        }
                    ],
                    "synonyms": [
                        "relationship",
                        "association"
                    ],
                    "common_phrases": [
                        "foreign relations",
                        "diplomatic relations",
                        "public relations",
                        "international relations"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как люди, группы или страны ведут себя по отношению друг к другу или взаимодействуют."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отношения",
                                "target_lang_sense_clarification": "взаимодействия между людьми, организациями или сообществами"
                            },
                            {
                                "target_lang_word": "связи",
                                "target_lang_sense_clarification": "деловые или официальные контакты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b79afd9-9665-341b-b5d8-d1c0dfecbd19",
                    "sense_definition": "The act of having sexual intercourse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intercourse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer asked if the defendant had sexual <w>relations</w> with the victim.",
                            "target_lang_translations": {
                                "ru": "Адвокат спросил, вступал ли подсудимый в половые <w>отношения</w> с потерпевшей."
                            }
                        },
                        {
                            "text": "They were accused of having <w>relations</w> outside of their marriage.",
                            "target_lang_translations": {
                                "ru": "Их обвинили в наличии <w>связи</w> вне брака."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sexual relations",
                        "have relations with"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт совершения полового акта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "половые отношения",
                                "target_lang_sense_clarification": "сексуальная связь"
                            },
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "любовные или интимные отношения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "847311ec-380a-3a96-a073-deaad91f9752",
                    "sense_definition": "The act of telling or recounting a story or a series of events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your <w>relation</w> of the events is quite different from what I remember.",
                            "target_lang_translations": {
                                "ru": "Ваше <w>изложение</w> событий сильно отличается от того, что помню я."
                            }
                        },
                        {
                            "text": "The witness gave a detailed <w>relation</w> of the accident to the police.",
                            "target_lang_translations": {
                                "ru": "Свидетель представил полиции подробный <w>рассказ</w> о происшествии."
                            }
                        }
                    ],
                    "synonyms": [
                        "recounting",
                        "tell",
                        "reference"
                    ],
                    "common_phrases": [
                        "detailed relation"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "more common in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт рассказывания или изложения истории или серии событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изложение",
                                "target_lang_sense_clarification": "пересказ или описание событий"
                            },
                            {
                                "target_lang_word": "повествование",
                                "target_lang_sense_clarification": "связный рассказ о событиях"
                            },
                            {
                                "target_lang_word": "рассказ",
                                "target_lang_sense_clarification": "словесное изложение событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf084292-ee7b-39c2-8125-0e6f5d4ddaca",
                    "sense_definition": "A set of ordered tuples or pairs in mathematics or logic.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Equality is a symmetric <w>relation</w> in basic arithmetic.",
                            "target_lang_translations": {
                                "ru": "Равенство — это симметричное <w>отношение</w> в элементарной арифметике."
                            }
                        },
                        {
                            "text": "A binary <w>relation</w> defines how elements from two sets are paired.",
                            "target_lang_translations": {
                                "ru": "Бинарное <w>отношение</w> определяет, как группируются элементы из двух множеств."
                            }
                        }
                    ],
                    "synonyms": [
                        "correspondence"
                    ],
                    "common_phrases": [
                        "binary relation",
                        "symmetric relation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор упорядоченных кортежей или пар в математике или логике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отношение",
                                "target_lang_sense_clarification": "математическая зависимость или пропорция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b6d645cd-6af2-3cce-a72e-d7e03e4b9fac",
                    "sense_definition": "A set of data tuples organized as a table within a database system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>relation</w> uses the customer's social security number as a primary key.",
                            "target_lang_translations": {
                                "ru": "Это <w>отношение</w> использует номер социального страхования клиента в качестве первичного ключа."
                            }
                        },
                        {
                            "text": "In a relational database, each <w>relation</w> must have a unique name.",
                            "target_lang_translations": {
                                "ru": "В реляционной базе данных каждое <w>отношение</w> должно иметь уникальное имя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "database relation"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in computer science"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор кортежей данных, организованных в виде таблицы в системе баз данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отношение",
                                "target_lang_sense_clarification": "таблица в реляционной базе данных"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}