                "senses": [
                    {
                        "sense_id": "e0bec646-d881-31d4-8617-80e367f11742",
                        "entry_id": "5a4aa2bf-48c3-3e48-9e33-b3e46bec2db5",
                        "glosses": [
                            "Variante orthographique de rendormir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1b7cbe1-c42b-41a9-abdf-752fb89ffb0e",
                                "sense_id": "e0bec646-d881-31d4-8617-80e367f11742",
                                "text": "Cassius, persuadé qu’il rêvait, se recoucha, et chercha à se r’endormir."
                            },
                            {
                                "example_id": "afb40118-f230-4ab2-9d5c-baad651acef6",
                                "sense_id": "e0bec646-d881-31d4-8617-80e367f11742",
                                "text": "S’éveiller et reconnoistre son erreur est une marque que l’on n’a plus dessein de se r’endormir ;"
                            },
                            {
                                "example_id": "b703ed90-8032-4eb8-a0c9-5dd833c580ab",
                                "sense_id": "e0bec646-d881-31d4-8617-80e367f11742",
                                "text": "Je fais que me r’endormir on dirais un narcoleptique ça me fume"
                            },
                            {
                                "example_id": "eab81743-5872-4170-9475-4ba6ed869151",
                                "sense_id": "e0bec646-d881-31d4-8617-80e367f11742",
                                "text": "J’arrive même pas à me r’endormir jrme crois qu’on est dans une dimension parallèle"
                            }
                        ]
                    }
