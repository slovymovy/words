                                "target_senses": [
                                    {
                                        "sense_id": "e597a0e3-4040-3452-9b44-8efd511545de",
                                        "entry_id": "02da841e-fba7-37e5-8138-a7919602f25c",
                                        "glosses": [
                                            "Mujer con quien alguien tiene una relación filial, especialmente si fue engendrado por ella."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f810211-3511-4442-99f8-12845e6bf219",
                                                "sense_id": "e597a0e3-4040-3452-9b44-8efd511545de",
                                                "text": "Estoy contando esta historia por mi madre. Mi mamá y mi papá estaban pasando por un tiempo difícil. Mi papá le había sido infiel a mi mamá y se habían separado."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aedd061b-c679-37b7-b887-d4b9a83983ba",
                                        "entry_id": "02da841e-fba7-37e5-8138-a7919602f25c",
                                        "glosses": [
                                            "Persona o animal del sexo femenino que ha concebido o tenido uno o más hijos."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0919f74c-5e15-49dd-82c3-a85cda549494",
                                                "sense_id": "aedd061b-c679-37b7-b887-d4b9a83983ba",
                                                "text": "Se acercó con cautela y... ¡sorpresa! Era una mamá jirafa con sus dos hijitas que aparentemente acababan de nacer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae72601e-4f19-32aa-8be3-ba0db23d7ff5",
