                                        "glosses": [
                                            "To create a dimple in one's face by smiling."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4248a75a-2e3e-4bbd-bc25-869b0cc2727e",
                                                "sense_id": "1ea5ffd6-9f27-3a12-bba5-a5be48b0e39b",
                                                "text": "The young girl dimpled in glee as she was handed a cupcake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "588a9d7f-0682-3d96-abd0-9b7966b8ce14",
                                        "entry_id": "43ffc212-f320-3724-b8ef-8babd657b80c",
