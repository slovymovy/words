            "senses": [
                {
                    "sense_id": "8cee0568-bb36-3c14-8bd1-2d772e9476bc",
                    "sense_definition": "Een oppervlak bedekken met een zachte, kneedbare of vloeibare substantie.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>besmeerde</w> zijn boterham met een dikke laag roomboter en jam.",
                            "target_lang_translations": {
                                "ru": "Он <w>намазал</w> свой бутерброд толстым слоем сливочного масла и варенья."
                            }
                        },
                        {
                            "text": "Voordat het deeg in de oven gaat, moet je de bakvorm met olie <w>besmeren</w>.",
                            "target_lang_translations": {
                                "ru": "Прежде чем тесто отправится в духовку, форму для выпечки нужно <w>смазать</w> маслом."
                            }
                        }
                    ],
                    "synonyms": [
                        "insmeren",
                        "bestrijken"
                    ],
                    "common_phrases": [
                        "een boterham besmeren"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность мягким, пластичным или жидким веществом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намазывать",
                                "target_lang_sense_clarification": "хлеб, тост или форму маслом, кремом"
                            },
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "покрывать тонким слоем жира или масла"
                            },
                            {
                                "target_lang_word": "намазать",
                                "target_lang_sense_clarification": "совершенный вид: нанести слой чего-либо"
                            },
                            {
                                "target_lang_word": "смазать",
                                "target_lang_sense_clarification": "совершенный вид: обработать поверхность маслом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2166625f-0700-3313-a5b0-7abe33dafd0b",
                    "sense_definition": "Vuil maken door er een vettige of vieze substantie over uit te wrijven.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kind had tijdens het eten zijn hele gezicht met chocolade <w>besmeerd</w>.",
                            "target_lang_translations": {
                                "ru": "Во время еды ребёнок <w>измазал</w> всё лицо шоколадом."
                            }
                        },
                        {
                            "text": "De monteur <w>besmeerde</w> zijn werkbroek per ongeluk met zwarte machineolie.",
                            "target_lang_translations": {
                                "ru": "Механик случайно <w>испачкал</w> рабочие брюки чёрным машинным маслом."
                            }
                        }
                    ],
                    "synonyms": [
