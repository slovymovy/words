                                "target_lang_word": "choose",
                                "target_lang_sense_clarification": "to decide on a path"
                            },
                            {
                                "target_lang_word": "go for",
                                "target_lang_sense_clarification": "to decide on a specific option"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "sich entscheiden für",
                                "target_lang_sense_clarification": "eine bewusste Wahl treffen"
                            },
                            {
                                "target_lang_word": "wählen",
                                "target_lang_sense_clarification": "einen Weg oder eine Option bevorzugen"
                            },
                            {
                                "target_lang_word": "bevorzugen",
                                "target_lang_sense_clarification": "etwas lieber mögen oder vorziehen"
                            }
                        ]
