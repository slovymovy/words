                ],
                "senses": [
                    {
                        "sense_id": "05bfe204-6a52-3754-b05f-2a04d7ebaa17",
                        "entry_id": "80c5a383-ce42-398a-b456-3bd7065932e3",
                        "glosses": [
                            "allgemeingültige Aussage über die Veränderung der Sprache in der Zeit"
                        ],
                        "tags": [
                            "Historiolinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "af588aef-db7e-4557-8e44-dac0a9ff289e",
                                "sense_id": "05bfe204-6a52-3754-b05f-2a04d7ebaa17",
                                "text": "Die Lautgesetze der Junggrammatiker sind Sprachwandelgesetze; sie machen allgemeine Aussagen über die lautlichen Veränderungen in der Geschichte einer Sprache."
                            },
                            {
                                "example_id": "dd60bf78-bdd3-4b42-a8e1-440bf31c74b5",
                                "sense_id": "05bfe204-6a52-3754-b05f-2a04d7ebaa17",
                                "text": "„Aus dem universalen Sprachwandelgesetz ergibt sich eine Reihe von Konsequenzen, negative wie positive.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4eb022f1-c6af-37fd-a71f-658da9451707",
                        "entry_id": "80c5a383-ce42-398a-b456-3bd7065932e3",
                        "glosses": [
                            "allgemeingültige, mathematisch formulierte Aussage über den Verlauf von Sprachwandelprozessen"
                        ],
                        "tags": [
                            "Quantitative Linguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "6ca4a90f-c02d-4b6b-89f2-29b5d7842070",
                                "sense_id": "4eb022f1-c6af-37fd-a71f-658da9451707",
                                "text": "Das Sprachwandelgesetz entspricht in vielen Fällen den Wachstumsgesetzen in anderen Wissenschaften."
                            },
                            {
                                "example_id": "6b1b9db2-47d8-4fbc-ba58-0830b0a861b6",
                                "sense_id": "4eb022f1-c6af-37fd-a71f-658da9451707",
                                "text": "„Das Sprachwandelgesetz von Altmann, das - wie in der vorliegenden Arbeit - die ersten empirischen Tests durchläuft, scheint aber Chancen zu haben, Bestandteil einer solchen zu entwickelnden allgemeinen (Synchronie und Diachronie umfassenden) Sprachtheorie zu werden.“"
                            },
                            {
                                "example_id": "23f194a4-04c3-4a81-8d78-45e8725c8652",
                                "sense_id": "4eb022f1-c6af-37fd-a71f-658da9451707",
                                "text": "„Zunächst werden aber die Formen, die das Sprachwandelgesetz annehmen kann, kurz vorgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
