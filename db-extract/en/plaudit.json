    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c8cdfe99-01b9-3052-b6b8-b4d68cfbb1ce",
                "word": "plaudit",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a5dac376-27db-4883-b2a4-83efc71a9c23",
                        "entry_id": "c8cdfe99-01b9-3052-b6b8-b4d68cfbb1ce",
                        "tags": [
                            "plural"
                        ],
                        "form": "plaudits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                        "entry_id": "c8cdfe99-01b9-3052-b6b8-b4d68cfbb1ce",
                        "glosses": [
                            "A mark or expression of applause; praise bestowed."
                        ],
                        "tags": [
                            "in-plural",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "c2e0e4f0-2161-4eff-a1be-1cb909c5c412",
                                "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                                "text": "The plaudits reverberated thunderously in the auditorium."
                            },
                            {
                                "example_id": "1129c540-4171-4253-a7ca-dce4ced3ffcb",
                                "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                                "text": "The roof now rung with bravos, handkerchiefs were waved on every side, “three cheers,” again and again, and plaudit upon plaudit following in such quick succession, begun, ended, and begun again, that it was some time before the toast with which Mr. Irving concluded, could be heard."
                            },
                            {
                                "example_id": "d8479901-e790-47f5-b471-8871f244364f",
                                "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                                "text": "They were very orderly- there were neither scoffs nor plaudits, and when they saw us at the window above them there were many who buried their faces in their arms and wept."
                            },
                            {
                                "example_id": "d13dfbe0-a49e-4ebc-bebb-8e375d2a57f1",
                                "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                                "text": "City have lapped up the plaudits this season for a series of handsome wins but manager Roberto Mancini has demanded that his side also learn to grind out results when they do not play well. He now has an example to point to."
                            },
                            {
                                "example_id": "8294d9ce-f085-4fc8-ab06-bd1ed70e6469",
                                "sense_id": "e3687d8f-40b2-3d4a-b9c1-d4a1089a8434",
                                "text": "NR has earned plaudits from far and wide for completing the project in difficult circumstances and for maintaining some access to Drax throughout."
                            }
                        ]
                    },
                    {
                        "sense_id": "8d250660-ea5d-345c-9d61-c99ee1a49799",
                        "entry_id": "c8cdfe99-01b9-3052-b6b8-b4d68cfbb1ce",
                        "glosses": [
                            "An award or commendation; a formal recognition of approval or achievement."
                        ],
                        "tags": [
                            "in-plural",
                            "often",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "d9968e58-0c39-4dee-a759-679aa24279cd",
                                "sense_id": "8d250660-ea5d-345c-9d61-c99ee1a49799",
                                "text": "Sofie has been showered in plaudits for her paradigm-shifting discoveries."
                            },
                            {
                                "example_id": "468a07b8-61c7-4a43-a42a-625bc88c2519",
                                "sense_id": "8d250660-ea5d-345c-9d61-c99ee1a49799",
                                "text": "Today, beyond its magnificent courtyard entrance, there is a spa and a plaudit-winning restaurant, Pearl, but Carla remembers: “There were hiccups and we were late opening, but we finally got there on December 16. […]"
                            },
                            {
                                "example_id": "3b3a6b7b-2b9d-4cca-9bdb-72918b81c19d",
                                "sense_id": "8d250660-ea5d-345c-9d61-c99ee1a49799",
                                "text": "A former Wanaka-based builder has been awarded a plaudit for his education efforts to combine sustainable building designs alongside the carpentry courses he now teaches at the Waikato Institute of Technology."
                            }
                        ]
                    }
                ],
