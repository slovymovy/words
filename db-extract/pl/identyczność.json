                                                "sense_id": "b2106bc2-b99b-3616-b79d-5fb6dde41514",
                                                "text": "Meine Identität ändert sich auch nicht, wenn ich meine Haare färbe, ich bleibe immer noch dieselbe."
                                            },
                                            {
                                                "example_id": "33d532a5-8280-4578-970e-ce07ce518e21",
                                                "sense_id": "b2106bc2-b99b-3616-b79d-5fb6dde41514",
                                                "text": "„Seine Identität war die Summe vielfältiger Rollen.“"
                                            },
