                            {
                                "target_lang_word": "запас",
                                "target_lang_sense_clarification": "состояние уволенного со службы до мобилизации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1ddfb06-18a2-37bc-aa33-e6708262c32d",
                    "sense_definition": "oddział wojskowy pozostawiony poza walką w celu użycia w decydującym momencie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dowódca trzymał pancerną <w>rezerwę</w> na wypadek niespodziewanego kontrataku wroga.",
                            "target_lang_translations": {
                                "ru": "Командир держал танковый <w>резерв</w> на случай неожиданной контратаки противника."
                            }
                        },
                        {
                            "text": "Generał wysłał ostatnie oddziały z <w>rezerwy</w> na pomoc skrzydłu.",
                            "target_lang_translations": {
                                "ru": "Генерал отправил последние подразделения из <w>резерва</w> на помощь флангу."
                            }
                        }
                    ],
                    "synonyms": [
