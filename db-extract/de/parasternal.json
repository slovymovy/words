                        "glosses": [
                            "Medizin: neben dem Brustbein liegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b54e8ac-8ff3-4536-afa4-45418dbd4c13",
                                "sense_id": "b8cf4af0-6b98-3688-934a-956dddc83fa0",
                                "text": "„Bei der TTE, der Transthorakalen Echokardiografie, wird das Herz zunächst durch Ansetzen des Ultraschallkopfes auf den Brustkorb untersucht, und zwar von parasternal, also neben dem Sternum, und von apikal, das heißt von der Herzspitze aus.“"
                            }
                        ],
