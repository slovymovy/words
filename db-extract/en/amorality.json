                "forms": [
                    {
                        "form_id": "9276bfce-c6f8-41d2-b27b-438e8c17dc90",
                        "entry_id": "fee47895-01c3-3525-a827-7324d98dcead",
                        "tags": [
                            "plural"
                        ],
                        "form": "amoralities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94e6251b-9805-3fd4-81b8-8bc45ca59c76",
                        "entry_id": "fee47895-01c3-3525-a827-7324d98dcead",
                        "glosses": [
                            "Lack or absence of morality."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c9b5d84c-2eb4-42a9-8bbd-8dbca7dae58c",
                                "sense_id": "94e6251b-9805-3fd4-81b8-8bc45ca59c76",
                                "text": "\"I don't think we're headed for a grey-goo scenario here, but we'd all feel really bad if the local biosphere got consumed by nanobots after we left.\" \"We'd still get paid, right?\" \"I'm going to treat that as a humorous stab at your own exaggerated amorality, and then move on if you don't mind.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "885f4aff-dfae-3a2b-ab36-f2b66956bf0b",
                        "entry_id": "fee47895-01c3-3525-a827-7324d98dcead",
                        "glosses": [
                            "The metaethical belief that nothing is morally right or morally wrong, that morality does not exist."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "19b019aa-b34f-4ae2-b722-6e35b9e74ad5",
                                "sense_id": "885f4aff-dfae-3a2b-ab36-f2b66956bf0b",
                                "text": "In law school, when we students thought the outcome of a case was determined by a rule we had studied, leftist professors admonished us, “Tools not rules!” In other words, rules control nothing; they’re merely tools you manipulate for the results you want. The fancy word for this kind of amorality is “instrumentalism,” and it subverts the rule of law."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1b25f1e-9bdc-4379-9b80-a31a7daafd90",
                        "source_entry_id": "fee47895-01c3-3525-a827-7324d98dcead",
                        "source_sense_description": "lack of morality",
                        "target_lang_word": "amoraliteit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "350d4f10-e8e4-45c2-b48c-595a77f5c2e2",
                        "source_entry_id": "fee47895-01c3-3525-a827-7324d98dcead",
                        "source_sense_description": "lack of morality",
