                        "glosses": [
                            "Creux du terrain, généralement lié à la présence de cours d’eau."
                        ],
                        "tags": [
                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5d9ea26c-5081-4fd6-8cc5-66963dc8084b",
                                "sense_id": "208e8525-3ca0-3eff-be7a-4f710f934991",
                                "text": "A deux lieues au nord de la Champignole, dans une légère dévallation au bord d’un ruisseau, était enfin un hameau nommé Font-Richard."
                            },
                            {
                                "example_id": "711f774c-1e00-40e7-83d7-973cc7c1b0a7",
                                "sense_id": "208e8525-3ca0-3eff-be7a-4f710f934991",
                                "text": "Une dévallation. C’est la Déla qui conflue avec la Bamba."
                            },
                            {
                                "example_id": "e8d46c67-ec91-4849-9ff8-8d033f1d046b",
                                "sense_id": "208e8525-3ca0-3eff-be7a-4f710f934991",
                                "text": "Son village natal, accroché aux flancs abrupts des montagnes de la Chartreuse, se dresse sur une petite bosse de terrain - entre un mur à pic, en haut, et une dévallation presque droite, vers la riche vallée du Grésivaudan."
                            }
                        ]
                    }
