    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fd12a4b1-4ecd-3d62-881d-a4a929ce9b01",
                    "sense_definition": "Revêtement textile épais et doux utilisé pour recouvrir entièrement le sol d'une pièce.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "revetement_sol",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons décidé de poser une nouvelle <w>moquette</w> beige dans la chambre."
                        },
                        {
                            "text": "Il est difficile d'enlever les taches de café sur cette <w>moquette</w> épaisse."
                        }
                    ],
                    "common_phrases": [
                        "poser de la moquette",
                        "nettoyer la moquette"
                    ]
                },
                {
                    "sense_id": "73d38abd-9d50-30a0-aecc-30a51fd172a3",
                    "sense_definition": "Pilosité abondante et fournie sur le torse d'un homme.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomie_argot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À la plage, il exhibe fièrement la <w>moquette</w> qui recouvre sa poitrine."
                        },
                        {
                            "text": "Avec toute cette <w>moquette</w> sur le torse, il n'a jamais froid en hiver."
                        }
                    ],
                    "common_phrases": [
                        "avoir de la moquette sur le torse"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier ou humoristique"
                        }
                    ]
                },
                {
                    "sense_id": "00eb7872-eaae-34e2-b391-6807ba912bde",
                    "sense_definition": "Étoffe veloutée en laine ou en fil servant à confectionner des tapis ou des garnitures d'ameublement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "textile",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce fauteuil ancien a été retapissé avec une <w>moquette</w> de velours très élégante."
                        },
                        {
                            "text": "L'artisan tisse une <w>moquette</w> ornée de motifs géométriques traditionnels."
                        }
                    ]
                },
                {
                    "sense_id": "3638103c-088c-37e2-a408-4e021c3b11d1",
                    "sense_definition": "Oiseau vivant attaché près d'un piège pour servir d'appeau et attirer d'autres oiseaux.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse_appeau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chasseur a placé une <w>moquette</w> dans la clairière pour attirer le gibier."
                        },
                        {
                            "text": "Autrefois, on utilisait souvent une <w>moquette</w> vivante pour capturer de petits passereaux."
                        }
                    ],
                    "synonyms": [
                        "appelant",
                        "appeau"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme de vénerie ancien"
                        }
                    ]
                },
                {
                    "sense_id": "0c072a08-d7cc-3bf5-a786-cd8ae307eff3",
                    "sense_definition": "Excrément de certains gibiers comme le chevreuil ou le lièvre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chasse_traces",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le garde forestier a identifié le passage de l'animal grâce aux <w>moquettes</w> fraîches trouvées par terre."
                        },
                        {
                            "text": "Ces petites <w>moquettes</w> disséminées dans les sous-bois indiquent la présence récente d'un chevreuil."
                        }
                    ]
                }
            ]
        }
    ]
