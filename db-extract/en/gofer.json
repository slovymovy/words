                "senses": [
                    {
                        "sense_id": "b6129ff8-5a35-30e2-8eed-663d9f71a54c",
                        "entry_id": "b9c27bb4-e475-307e-a017-4dabf5a5c63e",
                        "glosses": [
                            "A worker who runs errands; an errand boy."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "8c5b1524-dcae-4aec-b343-77432fd0b893",
                                "sense_id": "b6129ff8-5a35-30e2-8eed-663d9f71a54c",
                                "text": "They were learning to do what in all my years in the music business I never saw — which was women running a record company, women producing concerts, women learning to be engineers, women moving into this absolutely all-male enclave. You never saw a woman in any of those positions, in any of that work except as secretaries and \"go-fers\"."
                            },
                            {
                                "example_id": "57d06a63-3c4a-4b19-b30f-6bd3a6489501",
                                "sense_id": "b6129ff8-5a35-30e2-8eed-663d9f71a54c",
                                "text": "More and more people agreed to help with the mailings, the hand-distribution of flyers, and telephonings. Others agreed to be gofers and fetchers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c2de425-c7c3-4808-85ad-b7f947c086db",
                        "source_entry_id": "b9c27bb4-e475-307e-a017-4dabf5a5c63e",
                        "source_sense_id": "b6129ff8-5a35-30e2-8eed-663d9f71a54c",
