                                                "sense_id": "5623c33c-a615-3d28-a21a-3f7481f5ca0d",
                                                "text": "His mortgage payments left him short on dough."
                                            },
                                            {
                                                "example_id": "ee1c04dd-2a98-4b80-8238-4a4b3f1e4389",
                                                "sense_id": "5623c33c-a615-3d28-a21a-3f7481f5ca0d",
                                                "text": "\"I want to see four dollars before goin' any further on th' thrip. Have ye got th' dough?\""
                                            },
                                            {
                                                "example_id": "4e155d52-ab83-43b7-9cd7-72731df3a431",
                                                "sense_id": "5623c33c-a615-3d28-a21a-3f7481f5ca0d",
                                                "text": "I am astonished, really astonished, that you didn't put away some dough. You must be bananas."
                                            },
                                            {
