                        "entry_id": "0e9258ed-eb8e-3129-8eec-377481b4ca5d",
                        "glosses": [
                            "The killing of one's mother."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7134a89b-3805-4325-a31f-8f89d45da58d",
                                "sense_id": "3e954c65-2130-3748-85e2-d84ef3c6ecbf",
                                "text": "Gerald was imprisoned for matricide: he strangled his mother."
                            }
                        ]
                    },
                    {
                        "sense_id": "32188499-ccf7-3671-8855-4a894c62a2dd",
                        "entry_id": "0e9258ed-eb8e-3129-8eec-377481b4ca5d",
                        "glosses": [
                            "A person who kills his or her mother."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "05462817-240c-4b96-80a4-42d39f92e666",
                                "sense_id": "32188499-ccf7-3671-8855-4a894c62a2dd",
                                "text": "Nancy was a matricide; it happened four years ago."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0404af5-defe-47b3-bb23-5ac6933d5152",
