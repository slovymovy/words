                                        "entry_id": "49698276-af90-393d-b95d-a8a8cf1f5010",
                                        "glosses": [
                                            "Sache, die nicht einheitlich gleichartig, vom gleichen Typ wie alles andere, ist"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
