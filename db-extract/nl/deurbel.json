                        "entry_id": "f23153ec-f760-3eba-b69f-a2d8a7caa006",
                        "glosses": [
                            "een instrument waarmee bezoekers aangeven dat ze aan de deur staan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79fec9d0-d5c9-4828-a666-7763ad423f24",
                                "sense_id": "c614a7c7-66ec-39c9-91fd-042363a79cef",
                                "text": "Omdat de radio hard stond kon hij de deurbel niet horen."
                            },
                            {
                                "example_id": "a03d8ace-8554-443b-a4ca-aea192104b23",
                                "sense_id": "c614a7c7-66ec-39c9-91fd-042363a79cef",
                                "text": "Een van hun favoriete spelletjes stond op het punt van beginnen: talloze malen kort op de deurbel drukken totdat hun vader met een quasi kwaad gezicht opendeed."
                            }
                        ]
                    }
                ],
