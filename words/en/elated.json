    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a26c40d4-2142-305d-89f7-7362791035ca",
                    "sense_definition": "Extremely happy and excited; delighted; pleased, euphoric.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "happiness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>elated</w> with her new car.",
                            "target_lang_translations": {
                                "de": "Sie war <w>überglücklich</w> über ihr neues Auto.",
                                "nl": "Ze was <w>uitgelaten</w> over haar nieuwe auto."
                            }
                        },
                        {
                            "text": "The team felt <w>elated</w> after winning the championship game.",
                            "target_lang_translations": {
                                "de": "Das Team war nach dem Gewinn der Meisterschaft in <w>Hochstimmung</w>.",
                                "nl": "Het team voelde zich <w>euforisch</w> na het winnen van de kampioenswedstrijd."
                            }
                        }
                    ],
                    "synonyms": [
                        "ecstatic",
                        "euphoric",
                        "exultant",
                        "joyful",
                        "jubilant",
                        "overjoyed",
                        "giddy"
                    ],
                    "antonyms": [
                        "displeased",
                        "dissatisfied"
                    ],
                    "common_phrases": [
                        "elated with",
                        "elated by"
                    ],
                    "target_lang_definitions": {
                        "de": "Außerordentlich glücklich und aufgeregt; voller Freude und Begeisterung.",
                        "nl": "Extreem gelukkig en opgewonden; zeer vrolijk en blij."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "in Hochstimmung",
                                "target_lang_sense_clarification": "beschreibt einen Zustand großer Freude und Begeisterung"
                            },
                            {
                                "target_lang_word": "freudig erregt",
                                "target_lang_sense_clarification": "beschreibt eine freudige Aufregung oder Euphorie"
                            },
                            {
                                "target_lang_word": "überglücklich",
                                "target_lang_sense_clarification": "sehr gebräuchliches Wort für extreme Freude"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "uitgelaten",
                                "target_lang_sense_clarification": "zeer vrolijk en blij en dat ook laten merken"
                            },
                            {
                                "target_lang_word": "in de wolken",
                                "target_lang_sense_clarification": "idiomatische uitdrukking voor extreem gelukkig zijn"
                            },
                            {
                                "target_lang_word": "euforisch",
                                "target_lang_sense_clarification": "een staat van intense vreugde en opwinding"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57abd86a-46f7-3975-bd27-e07ae6ed5179",
                    "sense_definition": "Simple past and past participle of <w>elate</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news <w>elated</w> the entire family.",
                            "target_lang_translations": {
                                "de": "Die Nachricht <w>erfreute</w> die ganze Familie.",
                                "nl": "Het nieuws <w>verheugde</w> de hele familie."
                            }
                        },
                        {
                            "text": "He was <w>elated</w> by the unexpected promotion.",
                            "target_lang_translations": {
                                "de": "Er war <w>erfreut</w> über die unerwartete Beförderung.",
                                "nl": "Hij was <w>verheugd</w> door de onverwachte promotie."
