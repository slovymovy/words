                            {
                                "example_id": "7b0e0504-0ca7-4818-b32a-dffa1722b907",
                                "sense_id": "33c6f933-be68-3180-8248-4364f275e3f6",
                                "text": "„Mit Beginn des heurigen Studienjahrs müssen angehende Volksschullehrer anstelle eines dreijährigen Bachelorstudiums vier Jahre Bachelor- und ein Jahr Masterstudium absolvieren.“"
                            },
                            {
                                "example_id": "82be63dc-0d6a-449a-b48c-33b44de8f6e7",
                                "sense_id": "33c6f933-be68-3180-8248-4364f275e3f6",
                                "text": "„Volksschullehrer gibt es auf dem Arbeitsmarkt keine mehr, sie alle wurden zum Schuljahresbeginn eingestellt.“"
                            },
                            {
                                "example_id": "2a9cd2b1-e609-4ce6-8108-22e230acad51",
                                "sense_id": "33c6f933-be68-3180-8248-4364f275e3f6",
                                "text": "„Schlecht waren auch die materielle Lage der Volksschulen und die wirtschaftliche Situation der Volksschullehrer.“"
                            }
                        ],
