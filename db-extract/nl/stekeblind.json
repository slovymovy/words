                            {
                                "example_id": "3c919209-7af2-4658-a31d-42a00f7b5836",
                                "sense_id": "9fcb2f10-167e-326e-85d4-baf3f50c08fb",
                                "text": "Albino-olifantje Little Pinky dreigt stekeblind te worden"
                            },
                            {
                                "example_id": "9625fb3b-641e-44b4-9835-2f3877722eeb",
                                "sense_id": "9fcb2f10-167e-326e-85d4-baf3f50c08fb",
                                "text": "Íedereen in dit dossier is stekeblind geweest', zegt Paci in Het Laatste Nieuws. 'Zijn voormalige advocaat, het gevangeniswezen, het parket en justitie. En mijn cliënt zelf? Die snapt het gewoon niet', aldus de advocate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63e47041-65b3-44a1-95ed-dbc28554abeb",
                        "source_entry_id": "5616712b-e31d-30d1-895f-1efda9bc3fb8",
                        "source_sense_id": "9fcb2f10-167e-326e-85d4-baf3f50c08fb",
                        "target_lang_word": "stone-blind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stone-blind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e10687d-34f7-3479-a4bf-99a9015aa437",
                                        "entry_id": "1e6d3af4-140d-31fb-a5fa-6d8480bfa2f9",
                                        "glosses": [
                                            "Completely blind."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20bdc974-5283-4c41-bc99-fb13031317d3",
                                                "sense_id": "3e10687d-34f7-3479-a4bf-99a9015aa437",
                                                "text": "While recently addressing a large open-air audience in the district city itself, a man came forward and warmly invited me to dine with him. On inquiry, it turned out that he had formerly been stone-blind, but had been completely restored to sight by a simple operation at the hospital. Now, here was a man who would speak well of us, at all hazard ; and who, as a matter of fact, came home to his friends to tell them how great things the Lord had done for him."
                                            },
                                            {
                                                "example_id": "9eb1092d-7e28-4196-962b-a6234b0ff362",
                                                "sense_id": "3e10687d-34f7-3479-a4bf-99a9015aa437",
                                                "text": "A deaf man may be anything from hard of hearing to as deaf as a post; a blind man may be as blind as a bat or an owl; he may be gravel-blind or stone-blind; a bald man as bald as a coot or as a billiard ball."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
