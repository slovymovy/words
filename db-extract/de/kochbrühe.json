                ],
                "senses": [
                    {
                        "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                        "entry_id": "6c23218c-a153-3271-8057-51cb822773b1",
                        "glosses": [
                            "(gesalzenes) Wasser oder andere Flüssigkeit, in der Fleisch, Fisch oder Gemüse gegart wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cd9cf0a-d3b8-404b-aefa-7371c926f22a",
                                "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                                "text": "„Die Zutaten werden in wenig Salzwasser gegart und anschließend mitsamt der Kochbrühe püriert.“"
                            },
                            {
                                "example_id": "ce28ce57-1f13-4fff-80ae-6106091ce03e",
                                "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                                "text": "„Den Giersch nun in einem Sieb abtropfen lassen, die Kochbrühe aufheben, den Giersch pürieren. Diesen wieder in die Kochbrühe geben und gut durchrühren […].“"
                            },
                            {
                                "example_id": "c8e68d1c-4413-4942-87a3-a4c18af1da00",
                                "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                                "text": "„Die Ärmeren mussten mit der Mettensuppe, der würzigen Kochbrühe der Blut- und Leberwürste, vorliebnehmen. Die mundete köstlich mit viel frisch gebackenem Brot, reichlich Fettaugen und den Brocken der einen oder anderen geplatzten Wurst […].“"
                            },
                            {
                                "example_id": "b44e85d1-966f-4675-b40b-51488c4ee535",
                                "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                                "text": "„Als der Fisch gar und ein wenig in seiner Kochbrühe abgekühlt ist, lege ich ihn auf eine Schüssel und ziehe ihm die Haut mit den Schuppen ab.“"
                            },
                            {
                                "example_id": "7df1ee7f-9052-4bb2-861d-ae5bcb9779a6",
                                "sense_id": "11c5f030-37eb-35c3-8084-2059c1a6bfbf",
                                "text": "„Eine halbe Tasse Kochbrühe für die Soße aufheben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
