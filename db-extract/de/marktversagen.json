                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "3ef88bfa-9278-4434-899d-655ad2f0fdc9",
                        "entry_id": "29d7db10-f7c7-3c61-99b9-f249ab5a2ea7",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "das Marktversagen"
                    },
                    {
                        "form_id": "a8ba6ec2-cb36-4b5b-87c0-121095a92b95",
                        "entry_id": "29d7db10-f7c7-3c61-99b9-f249ab5a2ea7",
                        "tags": [
                            "genitive",
