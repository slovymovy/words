                ],
                "senses": [
                    {
                        "sense_id": "d629b56c-0093-357d-a4a9-fc43fb6249ec",
                        "entry_id": "25a8ca22-05f7-3849-bab0-63602629cbd1",
                        "glosses": [
                            "hochwertige Bluejeans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d029d7a-c09d-43ca-93f9-44417d544ebb",
                                "sense_id": "d629b56c-0093-357d-a4a9-fc43fb6249ec",
                                "text": "„Dem Wetter entsprechend trug er einen hellgrauen Baumwollrolli zur Edeljeans und ausnahmsweise keine Hosenträger.“"
                            },
                            {
                                "example_id": "6c2dabbd-0fdb-44ec-bad5-cc5f5e69717e",
                                "sense_id": "d629b56c-0093-357d-a4a9-fc43fb6249ec",
                                "text": "„Auf dem nassen Randstreifen lag ein gut genährter Mittvierziger, rasierte Glatze, Edeljeans, weißes Hemd mit so guter Passform, dass es maßgeschneidert sein konnte, italienische Lederslipper in Dunkelblau.“"
                            },
                            {
                                "example_id": "6e21714b-79f6-4187-b0bb-201d8a70e9a1",
                                "sense_id": "d629b56c-0093-357d-a4a9-fc43fb6249ec",
                                "text": "„Einer hatte eine Edeljeans, der andere eine Kakihose an, und beide trugen schwarze Poloshirts, verspiegelte Sonnenbrillen und Bluetooth-Headsets.“"
                            },
                            {
                                "example_id": "6ad0f675-7f66-4821-b27f-92d46a1acfa8",
                                "sense_id": "d629b56c-0093-357d-a4a9-fc43fb6249ec",
                                "text": "„Er trottete, gekleidet in schwarzen Edeljeans und dunkelblauem Nicki, hinterher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
