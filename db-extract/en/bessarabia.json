                        "target_lang_word": "Bessarabie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bessarabie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ffa8d3-cb03-3971-a392-0e726eb059c9",
                                        "entry_id": "28d0f558-c9ec-3e25-96ae-fe3089677f86",
                                        "glosses": [
                                            "Région d’Europe qui correspond plus ou moins à l'actuelle Moldavie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d840f18f-59c0-4081-a21c-d47a88092f8d",
                                                "sense_id": "e3ffa8d3-cb03-3971-a392-0e726eb059c9",
                                                "text": "La nouvelle Roumanie, surnommée la Grande Roumanie, fut créée en plusieurs étapes : le 27 mars/7 avril 1918 les représentants politiques de la Bessarabie votèrent l’union de cette province avec la Roumanie ; le 18/28 novembre 1918 les représentants politiques de la Bucovine décidèrent aussi l’union avec la Roumanie ; enfin, le 1ᵉʳ décembre 1918, les délégués des Roumains votèrent à Alba Iulia l’union de la Transylvanie avec la Roumanie."
                                            },
                                            {
                                                "example_id": "75aaea52-578e-45e1-8250-f4cfcac7ad1b",
                                                "sense_id": "e3ffa8d3-cb03-3971-a392-0e726eb059c9",
                                                "text": "Au delà, c’est le désert gris de l’Ukraine. Rien ! De l’herbe sèche et rase. Derrière nous, un autre Sahara : la Bessarabie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ef250da-c655-319c-9cef-c192e1ca7dbf",
                                        "entry_id": "28d0f558-c9ec-3e25-96ae-fe3089677f86",
                                        "glosses": [
                                            "Région au sud de la Moldavie, actuel Boudjak."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "842d9a8d-d66a-495d-ada5-5daefdeb20d9",
                                                "sense_id": "4ef250da-c655-319c-9cef-c192e1ca7dbf",
                                                "text": "BESSARABIE ou BUDZIAC, (Géog.) petite contrée entre la Moldavie, le Danube, la mer Noire, & la petite Tartarie."
                                            },
                                            {
                                                "example_id": "9cffc822-3da7-4777-a892-87942374a8fb",
                                                "sense_id": "4ef250da-c655-319c-9cef-c192e1ca7dbf",
                                                "text": "BESSARABIE. Bessarabia. Province de la Turquie, en Europe, bornée au nord par la Podolie, au couchant par la Moldavie, au midi par le Danube, qui la sépare de la Bulgarie, & au levant par la mer Noire. La Bulgarie fut anciennement une partie de la Dace, & la demeure des Arpiens, des Tyrangites, & des Britolages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
