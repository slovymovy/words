                "senses": [
                    {
                        "sense_id": "d17c2105-5af0-3d45-83af-f25194c1f77f",
                        "entry_id": "30701acf-101e-38d0-a849-c76eec95f6dc",
                        "glosses": [
                            "een zeer hoog gebouw dat met bewolkt weer zichtbaar in de wolken kan steken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c62d546-7256-46ea-ad09-67a9fc1de024",
                                "sense_id": "d17c2105-5af0-3d45-83af-f25194c1f77f",
                                "text": "Het bouwen van wolkenkrabbers is een ingewikkelde zaak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3898075b-8b32-47d8-b2af-0a09006778b1",
                        "source_entry_id": "30701acf-101e-38d0-a849-c76eec95f6dc",
                        "source_sense_id": "d17c2105-5af0-3d45-83af-f25194c1f77f",
                        "source_sense_description": "een zeer hoog gebouw dat met bewolkt weer zichtbaar in de wolken kan steken",
                        "target_lang_word": "Wolkenkratzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wolkenkratzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d5cd7740-7784-3006-9e66-6a26e78af37e",
                                        "entry_id": "74e9615b-1862-3b89-946c-3bc106e3507d",
                                        "glosses": [
                                            "sehr hohes Gebäude, hohes Hochhaus; üblicherweise über 100 Meter hoch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25784520-ffd2-426d-a661-e7bac72ae66a",
                                                "sense_id": "d5cd7740-7784-3006-9e66-6a26e78af37e",
                                                "text": "„So viel Licht sprudelte aus den Wolkenkratzern, daß ich am liebsten eine leere Mineralwasserflasche genommen hätte und Lichterperlen hineingefüllt, um sie meiner Mutter später nach Amsterdam zu bringen.“"
                                            },
                                            {
                                                "example_id": "9e8b5786-da36-4357-944b-d80b9096a6e9",
                                                "sense_id": "d5cd7740-7784-3006-9e66-6a26e78af37e",
                                                "text": "„Ein Grossbrand in einem Wolkenkratzer von Dubai hält die Feuerwehr kurz vor dem Jahreswechsel in Atem.“"
                                            },
                                            {
                                                "example_id": "27872cd9-30e5-494f-bb24-add028cf1a84",
                                                "sense_id": "d5cd7740-7784-3006-9e66-6a26e78af37e",
                                                "text": "„In einem der höchsten Wolkenkratzer der Golfmetropole Dubai ist zum zweiten Mal binnen weniger Jahre ein Großbrand ausgebrochen.“"
                                            },
                                            {
                                                "example_id": "9bfca61b-dae2-4bd6-9724-426f3e396976",
                                                "sense_id": "d5cd7740-7784-3006-9e66-6a26e78af37e",
                                                "text": "„Die Wolkenkratzer von Manhattan wuchsen riesenhaft in den blendenden Himmel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7232a34-5a5d-4240-974e-90605fd5fab6",
                        "source_entry_id": "30701acf-101e-38d0-a849-c76eec95f6dc",
                        "source_sense_id": "d17c2105-5af0-3d45-83af-f25194c1f77f",
                        "source_sense_description": "een zeer hoog gebouw dat met bewolkt weer zichtbaar in de wolken kan steken",
                        "target_lang_word": "skyscraper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "skyscraper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                        "entry_id": "49daf8be-9a41-3169-8971-ae581aecd549",
                                        "glosses": [
                                            "A very tall building with a large number of floors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1f8070c-7245-4a0f-affc-2769155a71cb",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "As the curve of Sandy Hook blotted from sight the last, low glimpse of the skyscrapers which point Manhattan, Blake touched Annette's arm."
                                            },
                                            {
                                                "example_id": "7fb01b17-7c66-4a4a-a44c-b01f6ed1fbfc",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "The solitary attic—if one could thus designate a space of about three square feet—which comprised Hamar's lodging—had the advantage of being situated in the top storey of a skyscraper—at least a skyscraper for that part of the city."
                                            },
                                            {
                                                "example_id": "45f0d4d8-fd65-4c44-aa55-1fb99ee28e21",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "Then he noticed, as a prosaic business man will notice suddenly, that a skyscraper which he has passed daily for months is out of line with its neighbor, that the seat behind the new little girl was unoccupied and that she stood alone in the aisle during exercises."
                                            },
                                            {
                                                "example_id": "a217b70c-12a8-4364-a506-95e09362eb01",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "The Wards are open-topped, with skyscrapers rising from the superstructure. Towers are sealed against vacuum, as the breathable atmosphere envelope is only maintained to a height of about seven meters. The atmosphere is contained by the centrifugal force of rotation and a \"membrane\" of dense, colorless sulphur hexafluoride gas, held in place by carefully managed mass effect fields."
                                            },
                                            {
                                                "example_id": "0a7d7050-ec64-44dc-a731-9fd19f855bb8",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "From the ground, Colombo’s port does not look like much.[…] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka’s capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India’s southern tip."
                                            },
                                            {
                                                "example_id": "e1b8fa80-f34a-464b-a378-efdc80efeac6",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "Construction of the world’s tallest unoccupied skyscraper may resume as early as next week, almost 10 years after work ground to a halt, according to Chinese state media."
                                            },
                                            {
                                                "example_id": "6b4ce126-2d70-4be3-80e5-15270b6e48a3",
                                                "sense_id": "3c580c38-7a91-3758-8d05-88ee2fb6dc3e",
                                                "text": "Its steel helped build America, from the skyscrapers dotting city landscapes to the cars speeding down highways, to the appliances inside millions of homes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d8a6b2c-de08-3e03-adff-225e3805d6fb",
                                        "entry_id": "49daf8be-9a41-3169-8971-ae581aecd549",
                                        "glosses": [
                                            "A small sail atop a mast of a ship; a triangular skysail."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed340adf-6123-32f7-b4a0-e4d0d0bff19f",
                                        "entry_id": "49daf8be-9a41-3169-8971-ae581aecd549",
                                        "glosses": [
                                            "Anything very tall or high."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec46d22-84d9-4886-821a-ff94b9d08e7c",
                                                "sense_id": "ed340adf-6123-32f7-b4a0-e4d0d0bff19f",
                                                "text": "It was no surprise to see Hanley bat a skyscraper out to left."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd2ed49b-d5f2-4a25-82fb-6de863c2d042",
                        "source_entry_id": "30701acf-101e-38d0-a849-c76eec95f6dc",
                        "source_sense_id": "d17c2105-5af0-3d45-83af-f25194c1f77f",
                        "source_sense_description": "een zeer hoog gebouw dat met bewolkt weer zichtbaar in de wolken kan steken",
                        "target_lang_word": "gratte-ciel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gratte-ciel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26f0776c-c77c-3a7f-97a3-44bcb4a33880",
                                        "entry_id": "50fcd453-e3fe-34fe-bc06-347d470b2e16",
                                        "glosses": [
                                            "Édifice habitable ayant plus de 150 mètres de hauteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e6aeb7-66c5-47fa-a1bd-fc28902966e8",
                                                "sense_id": "26f0776c-c77c-3a7f-97a3-44bcb4a33880",
                                                "text": "Mais sous les gratte-ciel flamboyants vibre une ville parallèle : un New York d’épaves humaines qui irriguent un vaste réseau de tunnels, de niches et de cavités."
                                            },
                                            {
                                                "example_id": "dd15caa1-21a0-4862-9568-f047021c1fd1",
                                                "sense_id": "26f0776c-c77c-3a7f-97a3-44bcb4a33880",
                                                "text": "À New-York, on jetait par terre des gratte-ciel encore neufs pour en construire de plus hauts et de plus chers."
                                            },
                                            {
                                                "example_id": "151a6b38-91d6-4fe9-be51-49f87941c229",
                                                "sense_id": "26f0776c-c77c-3a7f-97a3-44bcb4a33880",
                                                "text": "Lagos comptait alors environ 5 millions d’habitants. J’aimais cette métropole lagunaire avec ses pieds dans l’eau, notamment dans les bidonvilles sous les ponts autoroutiers reliant ses îles et péninsules à la terre ferme, et sa tête dans les nuages le long de la marina – une cordillère de gratte-ciel qui étaient à cette époque encore rares au sud du Sahara."
                                            },
                                            {
                                                "example_id": "fdc9180d-6831-47bf-a5d5-f4aa42863b80",
                                                "sense_id": "26f0776c-c77c-3a7f-97a3-44bcb4a33880",
                                                "text": "Il m’a rendue suicidaire, moi si légère. Je peux pas fermer les yeux sans me figurer que je tombe d’un gratte-ciel de mille étages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
