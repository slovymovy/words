                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b90ddf0-85f6-4483-9a97-a7e5e6766076",
                                                "sense_id": "aa9e2187-8cd6-36e4-bcd2-4df417f77a71",
                                                "text": "„Ich ging die fünfte Avenue entlang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "52e9a6e2-06f7-35e0-87ae-2a4fc58b9c42",
                                        "entry_id": "c8dc2979-d1b5-34fa-b1f6-f9108ed3dfe8",
                                        "glosses": [
                                            "Prachtstraße in einer Stadt, die mit Bäumen bepflanzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e4edade-a6d7-4d35-bd2f-554ba0a202bd",
                                                "sense_id": "52e9a6e2-06f7-35e0-87ae-2a4fc58b9c42",
                                                "text": "„Die Avenue nahm in beide Richtungen kein Ende.“"
                                            }
                                        ],
