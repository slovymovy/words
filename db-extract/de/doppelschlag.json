                    {
                        "sense_id": "a940f93f-e8af-32ea-8c20-10ebd5142e22",
                        "entry_id": "8d5fdc66-8ca7-3aba-8733-09d0f9e19e87",
                        "glosses": [
                            "a kind of firecracker"
                        ],
