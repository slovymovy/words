                        "examples": [
                            {
                                "example_id": "ad6d6838-dcbf-4917-ac8b-09cbaff5eea3",
                                "sense_id": "4c9274a5-719c-353b-abd2-51a6b8560caa",
                                "text": "„Unter den Pferdehufen wirbelte Staub auf.“"
                            },
                            {
                                "example_id": "87b9adf9-d17c-40d6-8e1b-441ad6010893",
                                "sense_id": "4c9274a5-719c-353b-abd2-51a6b8560caa",
                                "text": "„Außer dem Getrappel der Pferdehufe auf dem Kopfsteinpflaster war kein Geräusch zu hören.“"
                            },
                            {
                                "example_id": "75180e93-74ad-4211-8e9b-53953a5d4198",
                                "sense_id": "4c9274a5-719c-353b-abd2-51a6b8560caa",
                                "text": "„Ich war gerade tief und fest eingeschlafen, als mich das Stampfen von Pferdehufen und die Schreie einiger Männer weckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
