                            {
                                "example_id": "d160860e-b03b-4afd-8426-f64fc53b0e0a",
                                "sense_id": "373b1207-c2fa-35b8-937c-985693eea1d8",
                                "text": "A l’argent, dont on craint qu’il ne déclenche chez l’aliénée l’appât du gain, autre vice, on préfère des encouragements, des distributions de gâteaux, de tabac, cadeaux subventionnés par des donations privées."
                            },
                            {
                                "example_id": "e9266d8b-19d9-43a7-a27d-6e2e67c8756a",
                                "sense_id": "373b1207-c2fa-35b8-937c-985693eea1d8",
                                "text": "Sans parler de Vessières, de Piédesclop, de tous les braillards. D’Amélie Lagueyte, la Soiffarde aux violences d’aliénée."
                            }
                        ]
                    }
