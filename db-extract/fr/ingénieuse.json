                                        "entry_id": "3594a9b1-8df8-368a-a7a3-55c17e64de9c",
                                        "glosses": [
                                            "Berufsbezeichnung für Absolventinnen technischer Studiengänge/der Ingenieurwissenschaften"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b102a49d-d47c-4c4d-8052-06b2268555fd",
                                                "sense_id": "640ffb3a-87a5-3636-a1ea-e79d19f508b8",
                                                "text": "„Sie vollendet gerade ihre Ausbildungszeit als Ingenieurin und ist eine der Aktivistinnen des Werkes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
