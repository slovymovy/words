                        "sense_id": "9c956ebf-bdbe-3284-a5fd-8da60b432085",
                        "entry_id": "65b7ea40-5771-3618-82e4-16079299cc0c",
                        "glosses": [
                            "Se dit d’une rime qui utilise sur des vers consécutifs des voyelles changeantes avec la même consonne d’appui. Le plus souvent, les voyelles sont dans l’ordre a, e, i, o, u, d’où le mot de rimes babebines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f693d32-3cf5-43bf-9f84-1fcaaa268779",
                                "sense_id": "9c956ebf-bdbe-3284-a5fd-8da60b432085",
                                "text": "Les rimes babebines gardent l’identité de la consonne d’appui, mais en changeant les voyelles dans un certain ordre."
                            },
                            {
                                "example_id": "e68f8aae-d44d-4640-90ba-d3e8a85c0185",
                                "sense_id": "9c956ebf-bdbe-3284-a5fd-8da60b432085",
                                "text": "Et voici, à l’usage des amateurs, un petit Manuel pratique des rimes babebines avec vingt-huit exemples de poèmes babebins."
                            }
                        ]
                    }
