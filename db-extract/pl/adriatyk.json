                "senses": [
                    {
                        "sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
                        "entry_id": "bb02c615-80eb-38ee-99b2-402528ff76a9",
                        "glosses": [
                            "zob. Morze Adriatyckie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f3c8356-1f90-490c-a959-c44f836bff6a",
                                "sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
                                "text": "Do Adriatyku uchodzą rzeki Pad i Neretwa."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7883b2e-4df9-4abc-b77f-718ca972fce7",
                        "source_entry_id": "bb02c615-80eb-38ee-99b2-402528ff76a9",
                        "source_sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
                        "target_lang_word": "Adriatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adriatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "273ecc1a-bf0d-3398-a787-ff63735cf36b",
                                        "entry_id": "293dff6f-7063-3841-9cdd-e715e6ea7750",
                                        "glosses": [
                                            "Of or pertaining to the Adriatic Sea."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b0c8fdd-bb53-42e2-81f1-873f9e927eb4",
                                                "sense_id": "273ecc1a-bf0d-3398-a787-ff63735cf36b",
                                                "text": "She moves me not, or not removes, at least,\nAffection's edge in me, were she as rough\nAs are the swelling Adriatic seas:"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Adriatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                        "entry_id": "1244f4ac-e24e-32b7-acd3-2cdf2788a1e3",
                                        "glosses": [
                                            "A sea between Italy and the Balkan Peninsula; an extension of the Mediterranean located between the boot of Italy and the Dalmatian coast of the Balkans; in full, Adriatic Sea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62cfd34c-7f92-409c-a99d-89c46a782de0",
                                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                                "text": "Her husband sail'd upon the Adriatic,\nAnd made some voyages, too, in other seas,"
                                            },
                                            {
                                                "example_id": "6ec23d3a-2f66-41ea-a8f2-ee35b914fa10",
                                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                                "text": "A strange story comes from the Adriatic."
                                            },
                                            {
                                                "example_id": "bfa1d723-8611-4c71-aff1-78dfbdda58c6",
                                                "sense_id": "139d72f6-3d8a-3c78-832e-20a31ff606d5",
                                                "text": "From Stettin in the Baltic to Trieste in the Adriatic, an iron curtain has descended across the Continent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f91ae0-3b0f-4c82-b084-9d6238d34ae4",
                        "source_entry_id": "bb02c615-80eb-38ee-99b2-402528ff76a9",
                        "source_sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
