                        "entry_id": "ced6024f-eccc-32db-8401-f530cc8966df",
                        "glosses": [
                            "Petit cours d’eau (en Charente-Maritime)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b95aa9-254a-4e1a-bf32-86ebb10f8afb",
                                "sense_id": "8f2b3cd8-b949-396e-b7ae-8ebfc93450cf",
                                "text": "Au cours de leur périple, ces galériens consentants auront notamment à traverser le riveau (petit cours d’eau) qui longe le Parc des sports."
                            },
                            {
                                "example_id": "48bd66c0-57b3-415b-b289-60f82f86e0e0",
                                "sense_id": "8f2b3cd8-b949-396e-b7ae-8ebfc93450cf",
                                "text": "Il mettait un appât au milieu, il descendait le panier au bout d’une ficelle dans un riveau ou d’autres cours d'eau, puis au bout d’un certain temps, il remontait le panier avec plus ou moins bonne fortune, ne gardant que les prises les plus grosses et rejetant les étrilles."
                            },
                            {
                                "example_id": "6e0ac71e-ee54-4f49-b30e-c056cadb9f56",
                                "sense_id": "8f2b3cd8-b949-396e-b7ae-8ebfc93450cf",
                                "text": "Pour peu que les baigneurs se plaignent et que l’on bouche les riveaux, les prairies de Nauzan et de Bernezac redeviendront des marais insalubres."
                            }
                        ]
                    }
