                    {
                        "translation_id": "b91eccba-3fbd-440f-8c43-e7edada74ddc",
                        "source_entry_id": "fb75f235-745f-3322-8d0d-5c39f009765b",
                        "source_sense_id": "ecd09c0c-bec7-3d42-9537-3bd7601b08b6",
                        "source_sense_description": "een middel om de was te reinigen",
                        "target_lang_word": "lessive",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lessive",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ef96a7-2a92-3ff1-8971-5352d6d9eb33",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Eau chaude que l’on verse sur du linge à blanchir, qui est entassé dans un cuvier et sur lequel on a mis un lit de soude, de potasse ou de cendre de bois."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f59d6c8c-d6e9-47ae-ac9a-51268f1c4097",
                                                "sense_id": "f2ef96a7-2a92-3ff1-8971-5352d6d9eb33",
                                                "text": "Cinq ou six grabats se touchant, dans l’unique pièce où les buées d’une lessive répandaient leur tiédeur acide […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc1d1b2-a194-3c1a-b697-075196b41b55",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Action de laver, de nettoyer le linge par des procédés chimiques ou mécaniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "469afdbc-3398-4d2e-aba5-fb2cd7acee87",
                                                "sense_id": "7fc1d1b2-a194-3c1a-b697-075196b41b55",
                                                "text": "[…] elle admettait au temps de grande presse une femme de journée pour les lessives, plus abondantes à cette époque de l’année."
                                            },
                                            {
                                                "example_id": "0ed825ef-bb60-48c5-8701-355bb7ef1852",
                                                "sense_id": "7fc1d1b2-a194-3c1a-b697-075196b41b55",
                                                "text": "Nous faisons une lessive à la main, les guêtres et les chaussures aussi, et mettons tout à sécher dehors sur un tancarville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81809fc8-4d47-3b39-827d-94e2159dc234",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Linge sale qui doit être lessivé, qui a été lavé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6da5cf-2845-430e-aacf-12a9879bfa06",
                                                "sense_id": "81809fc8-4d47-3b39-827d-94e2159dc234",
                                                "text": "Il faut pendre la lessive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "219af2a3-171b-3791-a996-cf7b3504f001",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Toute sorte d’eau détersive, rendue telle par quelque matière convenable."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7fc0176-3cea-45ca-8e3e-75d94eb98636",
                                                "sense_id": "219af2a3-171b-3791-a996-cf7b3504f001",
                                                "text": "On fait une sorte de lessive aux olives pour en ôter l’amertume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5910686-4740-3c47-8c6e-700e6aba514d",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Poudre ou liquide détergente que l'on dissout dans l'eau pour laver le linge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c77e5388-7145-4c76-baa3-33a20b7505d9",
                                                "sense_id": "e5910686-4740-3c47-8c6e-700e6aba514d",
                                                "text": "Acheter de la lessive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1754ef23-b7b1-3755-ba4f-0c73d7439f56",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Nettoyage, action de débarrasser un organisme industriel, commercial, administratif, etc., des gens qui en compromettent le bon fonctionnement."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e114e730-f8af-4e9b-abad-0e1c057b1b46",
                                                "sense_id": "1754ef23-b7b1-3755-ba4f-0c73d7439f56",
                                                "text": "C'est la victoire de tous les vrais Marséguais ! […] ! Nous allons lancer aujourd'hui nos forces dans la bataille et préparer la grande lessive. Dehors les feignants ! Dehors les bicots ! Dehors les boumians ! Dehors les pédoules ! Dehors les salopes ! Dehors les négros ! […] ! Dehors les profiteurs !\n— Et les coiffeurs ? dit Gracieux Castapiane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d980a98-3c47-3593-8ae6-c24e5bea8050",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Solution aqueuse alcaline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13dddd0a-5d6d-4562-badc-f94021f25b9b",
                                                "sense_id": "9d980a98-3c47-3593-8ae6-c24e5bea8050",
                                                "text": "Notons enfin que la soie sauvage résiste aussi mieux aux lessives alcalines que la soie véritable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "016c8ba6-90cc-3f47-b864-7f205705a4e6",
                                        "entry_id": "47a4df55-1561-33c4-bcc8-22f5451039e3",
                                        "glosses": [
                                            "Opération qui consiste à verser plusieurs fois de l’eau chaude ou froide sur des matières terreuses ou autres pour en extraire les parties solubles qu’elles contiennent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
