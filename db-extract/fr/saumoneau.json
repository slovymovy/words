                        "glosses": [
                            "Petit saumon, saumon qui n’a pas encore atteint tout son développement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96b77b59-c4a8-4aa1-a05d-d18d48bcacca",
                                "sense_id": "f106f6bb-d296-3e9c-98a5-34e8217a0449",
                                "text": "Grâce à une transformation de ses branchies, le saumoneau va pouvoir passer de l’eau douce à l’eau salée."
                            }
                        ]
