                "senses": [
                    {
                        "sense_id": "5fe07a14-a515-3a65-b5de-99a0f5532e18",
                        "entry_id": "75ee3dc6-fefb-30c0-a320-bfb15ff524ff",
                        "glosses": [
                            "Pilz, der seine Sporen in schlauchförmigen Organen bildet"
                        ],
                        "tags": [
                            "Mykologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6396f161-736b-4844-a92f-b05ca417f33d",
                                "sense_id": "5fe07a14-a515-3a65-b5de-99a0f5532e18",
                                "text": "Der Mutterkornpilz ist ein Schlauchpilz und wächst auf jungen Fruchtknoten von Gräsern, zum Beispiel Roggen. Dadurch bildet sich das schwarze giftige Mutterkorn."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83396a3c-776c-3d42-8d39-a915d5895337",
                        "entry_id": "75ee3dc6-fefb-30c0-a320-bfb15ff524ff",
                        "glosses": [
                            "eine Abteilung im Reich Pilze"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "006782e0-a39a-4cff-a259-fc768cfc056e",
                                "sense_id": "83396a3c-776c-3d42-8d39-a915d5895337",
                                "text": "Schlauchpilze haben eine vielfältige Beziehung zu Menschen; einige Arten verursachen Krankheiten bei Nutzpflanzen, andere Arten sind nützlich bei der Herstellung von Lebensmitteln und Antibiotika."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
