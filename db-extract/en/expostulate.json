                "senses": [
                    {
                        "sense_id": "cfbcea27-f6fc-3434-80c7-8e377bf64171",
                        "entry_id": "33b9bbb2-0327-3f74-9b49-a47f7a2bdd92",
                        "glosses": [
                            "To protest or remonstrate; to reason earnestly with a person on some impropriety of conduct [(often) with with]."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9630e232-3647-4583-92a3-e3567f5eab6f",
                                "sense_id": "cfbcea27-f6fc-3434-80c7-8e377bf64171",
                                "text": "The tears would run plentifully down my face when I made these reflections; and sometimes I would expostulate with myself why Providence should thus completely ruin His creatures, and render them so absolutely miserable; so without help, abandoned, so entirely depressed, that it could hardly be rational to be thankful for such a life."
                            },
                            {
                                "example_id": "7bbfbfec-7476-4f70-ae49-5dd870aa0487",
                                "sense_id": "cfbcea27-f6fc-3434-80c7-8e377bf64171",
                                "text": "[…] he affectionately loved many persons to whom he never or hardly ever shewed a countenance of love. Once on my venturing to expostulate with him on the subject, he reminded me of Solomon: “Many sons I have; it is not fit that I should smile on them.”"
                            },
                            {
                                "example_id": "def9b820-9ad1-40b8-b407-6ddea0bd7610",
                                "sense_id": "cfbcea27-f6fc-3434-80c7-8e377bf64171",
                                "text": "Men expostulate with erring friends; they bring accusations against enemies who have done them a wrong."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "487321dc-d91b-49a3-b241-ab805ed728ce",
                        "source_entry_id": "33b9bbb2-0327-3f74-9b49-a47f7a2bdd92",
                        "source_sense_id": "cfbcea27-f6fc-3434-80c7-8e377bf64171",
                        "source_sense_description": "to protest",
                        "target_lang_word": "усовещивать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "усовещивать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91f6c147-13cd-3b03-9ab3-a573d85c22e5",
                                        "entry_id": "3927ff4b-c3fd-39b6-ab53-c3393ceada0c",
                                        "glosses": [
                                            "стыдить, стараясь привести к осознанию проступка и раскаянию"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f236c6fc-77b5-4d07-8c3f-2ca40e81a639",
                                                "sense_id": "91f6c147-13cd-3b03-9ab3-a573d85c22e5",
                                                "text": "Мало-помалу он стал ободряться, он усовещивал себя всеми силами ободриться и опомниться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
