                        "target_lang_word": "grundlegend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grundlegend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6525851f-5de1-39a5-80b1-e266201bb51f",
                                        "entry_id": "1e6da1ef-7233-352e-95aa-635db36cc19c",
                                        "glosses": [
                                            "die Grundlage herstellend, die Basis bildend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f94195c-eb00-4e64-9448-4e6b2384cf2c",
                                                "sense_id": "6525851f-5de1-39a5-80b1-e266201bb51f",
                                                "text": "Vom grundlegenden Schöpfungsgedanken haben sie sich aber nicht verabschiedet."
                                            },
                                            {
                                                "example_id": "ef1845c1-6a6e-4a00-b079-ad87376936e8",
                                                "sense_id": "6525851f-5de1-39a5-80b1-e266201bb51f",
                                                "text": "Seine Hochschulpartner arbeiten eher an grundlegenden Techniken, er ist an Anwendungen interessiert."
                                            },
                                            {
                                                "example_id": "f3fcfded-0ee3-4c1f-9091-4c2a0da1fa3a",
                                                "sense_id": "6525851f-5de1-39a5-80b1-e266201bb51f",
                                                "text": "Die grundlegendsten Unterschiede gibt es beim Thema Gesundheitsversorgung."
                                            },
                                            {
                                                "example_id": "4c44ca4e-d102-464b-815b-5389e05f934a",
                                                "sense_id": "6525851f-5de1-39a5-80b1-e266201bb51f",
                                                "text": "„In der Literatur bisher weniger beachtet wurden die in den siebziger Jahren entwickelten Curricula […] zu einem mehrperspektivischen Unterricht […], in denen Lernen in Projekten und Kursen das grundlegende Vermittlungsverfahren ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1007f1f3-1d0d-3836-88db-a1e710497ffd",
                                        "entry_id": "1e6da1ef-7233-352e-95aa-635db36cc19c",
                                        "glosses": [
                                            "sehr, von Grund auf, vollständig neu"
                                        ],
                                        "tags": [
                                            "bei Adjektiven und Verben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "040951d1-9a7f-4ac3-937c-8da91cedba31",
                                                "sense_id": "1007f1f3-1d0d-3836-88db-a1e710497ffd",
                                                "text": "Ein Einstellungswandel der Sparer könnte die Situation daher grundlegend ändern."
                                            },
                                            {
                                                "example_id": "4b3dbcb6-b287-4a29-970e-f33f1c36ca39",
                                                "sense_id": "1007f1f3-1d0d-3836-88db-a1e710497ffd",
                                                "text": "Die globalen Krisen, die die letzten beiden Jahre gebracht haben – Welternährungskrise, neue Epidemien, Finanzkrise, Klimawandel – hängen ja zusammen: Sie gehen alle darauf zurück, dass ein paar Dinge in unserem Wirtschaftssystem grundlegend falsch sind."
                                            },
                                            {
                                                "example_id": "77984dc0-8d8e-4700-9c4d-b924895ea61f",
                                                "sense_id": "1007f1f3-1d0d-3836-88db-a1e710497ffd",
                                                "text": "In Großbritannien formiert sich eine neue Parlamentariergruppe, die das Verhältnis Großbritanniens zur EU grundlegend reformieren will."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
