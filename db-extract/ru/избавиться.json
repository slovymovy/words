                        "target_lang_word": "se débarrasser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "se débarrasser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "16b4dcd5-12e1-3a7a-b6eb-2a920f7be3cc",
                                        "entry_id": "23fcad34-0d66-347f-ba42-096c2f8df996",
                                        "glosses": [
                                            "Éloigner de soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09c54726-06da-418a-9570-22de85a43b23",
                                                "sense_id": "16b4dcd5-12e1-3a7a-b6eb-2a920f7be3cc",
                                                "text": "Il songeait, d’autre part, […] à se débarrasser de ses deux encombrants gardes du corps qui le tenaient chacun par un bras après lui avoir mis les poucettes."
                                            },
                                            {
                                                "example_id": "9b7f834f-1191-4f8b-a585-252986689c1e",
                                                "sense_id": "16b4dcd5-12e1-3a7a-b6eb-2a920f7be3cc",
                                                "text": "Nous avons donc toutes sortes de bonnes raisons pour considérer les plantes adventices comme nuisibles, et pour chercher à nous en débarrasser : […]."
                                            },
                                            {
                                                "example_id": "be3848c4-06a3-4b68-b0ec-9800af3e6761",
                                                "sense_id": "16b4dcd5-12e1-3a7a-b6eb-2a920f7be3cc",
                                                "text": "Les Chasseurs n’étaient peut-être pas non plus étrangers à cette manigance. Parbleu, en se débarrassant d’un concurrent, ils profitaient de son gibier."
                                            },
                                            {
                                                "example_id": "eda8a876-d098-4ed4-a3fd-0117661bd2b2",
                                                "sense_id": "16b4dcd5-12e1-3a7a-b6eb-2a920f7be3cc",
