                ],
                "senses": [
                    {
                        "sense_id": "fa783ae5-f9e0-3722-885e-27a0f26086b6",
                        "entry_id": "de2a5be1-d831-3bd5-8efe-77858aec26a1",
                        "glosses": [
                            "Comfortable, cosy, pleasant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7544305-19d3-49b7-9efb-a3c61bdc3bdd",
                                "sense_id": "fa783ae5-f9e0-3722-885e-27a0f26086b6",
                                "text": "Judy told me of its charms because its gemütlich, nineteenth-century naïveté appealed strongly to her; either she was innocent in her tastes or else sophisticated in seeing in this humble little work delights and possibilities the other girls missed."
                            },
                            {
                                "example_id": "796e4396-c978-4a0b-9dac-8997f8e5a108",
                                "sense_id": "fa783ae5-f9e0-3722-885e-27a0f26086b6",
                                "text": "For several years, the center of her world has been the gemütlich studio of her Eastern European piano teacher, Mr. Bilderbach, and his wife, Anna."
                            },
                            {
                                "example_id": "c5d8e4be-7a5a-499e-ac60-bbdeb054a379",
                                "sense_id": "fa783ae5-f9e0-3722-885e-27a0f26086b6",
                                "text": "Underneath all the gemütlich verbs lurks a suggestion that some readers may find chilling: a vision of the “common good” so obvious to Deneen that it’s not up for debate or discussion."
                            }
                        ]
                    },
                    {
                        "sense_id": "1899aa2e-2ab2-3532-a47a-c8c9e4e9d421",
                        "entry_id": "de2a5be1-d831-3bd5-8efe-77858aec26a1",
                        "glosses": [
                            "Friendly, genial, cheerful, easy-going."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d80e72-eb87-4645-946d-293027cadf82",
                                "sense_id": "1899aa2e-2ab2-3532-a47a-c8c9e4e9d421",
                                "text": "The censors cut one in which Judd Hirsch, who plays Mr. Goldblum's gemutlich, Yiddish-spouting father,"
                            }
                        ]
                    }
                ],
