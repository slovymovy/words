                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il s'est <w>attardé</w> au bureau pour terminer ce dossier urgent avant la fin de semaine."
                        },
                        {
                            "text": "Le professeur s'est <w>attardé</w> sur cette règle difficile afin que tous les étudiants la comprennent."
