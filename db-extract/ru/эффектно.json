                "senses": [
                    {
                        "sense_id": "00701dc3-af52-3383-91fa-bd026d244168",
                        "entry_id": "1d442c9c-9ec8-34db-bbe6-f489c83ac606",
                        "glosses": [
                            "производя эффект, сильное впечатление"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c9e6f2-91a6-472a-90a2-4f9dc2808760",
                                "sense_id": "00701dc3-af52-3383-91fa-bd026d244168",
                                "text": "Роль, которую внутренне не чувствуешь, выгоднее преподнести зрителю внешне эффектно, под аплодисмент."
                            },
                            {
                                "example_id": "18bcfe3f-c66b-48fd-92eb-b5ef8388391f",
                                "sense_id": "00701dc3-af52-3383-91fa-bd026d244168",
                                "text": "Солнце закатывалось и так эффектно играло на его лице и на красной рубахе, что мне захотелось набросать его красками."
                            },
                            {
                                "example_id": "bc478190-156d-44f0-9580-b64502bbaeb4",
                                "sense_id": "00701dc3-af52-3383-91fa-bd026d244168",
                                "text": "И, сознавая своё суетное величие, гордая им, она хотела бы взойти на Каменную Могилу и там эффектно умереть."
                            }
                        ]
                    }
