                                                "sense_id": "b01e34e7-6990-3851-ac14-ca6f1bee43e6",
                                                "text": "Zu Beginn der Schlacht wurde aus allen Rohren geschossen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9450e520-3b02-33cd-8590-7a0f94b0ab48",
                                        "entry_id": "efd05afc-a45c-303b-8067-963fbe74210a",
                                        "glosses": [
