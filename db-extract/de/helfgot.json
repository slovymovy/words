                "senses": [
                    {
                        "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                        "entry_id": "8d5ec5b0-711e-3715-8f19-0e1b03cfb1fd",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6886d93e-ca93-46a6-933e-b3fbfdabb517",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Frau Helfgot ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "25936003-8b14-4d33-ae70-36f74767b685",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Herr Helfgot wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b0f911b1-77b0-491d-9775-1c44e91083f1",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Die Helfgots fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "e56b899b-41a7-4dcf-b211-5e57f69ce2ed",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Der Helfgot trägt nie die Schals, die die Helfgot ihm strickt."
                            },
                            {
                                "example_id": "733d7581-636c-41c0-b238-41fde39832d1",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Helfgot kommt, geht der Herr Helfgot.“"
                            },
                            {
                                "example_id": "81f0402e-b694-4238-a897-012a3230e75f",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Helfgot kommt und geht."
                            },
                            {
                                "example_id": "044505af-e716-4cfe-9533-40690450d252",
                                "sense_id": "62ca5a7e-911c-3d7e-a96f-ddda348563f5",
                                "text": "Helfgots kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
