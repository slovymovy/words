                "senses": [
                    {
                        "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                        "entry_id": "c7ff8080-c0b8-36d7-8615-4210f1fd36b9",
                        "glosses": [
                            "Birkenart mit bläulichgrünen Blättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f52cfeab-406d-4ad6-81b7-e6096252c3f9",
                                "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                                "text": "„[…]: es ist eben nicht jede Birke, die in irgendeiner Hinsicht als blau beschrieben werden kann, eine Blaubirke, sondern nur eine Birke mit blauen Blättern.“"
                            },
                            {
                                "example_id": "3689ee50-b575-4d65-b125-12f3d70ad159",
                                "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                                "text": "„Zu den Versuchen wurde ein Bestand von 3-4jähr. Blaubirken verwendet.“"
                            },
                            {
                                "example_id": "3092d4b7-d662-40da-bd16-83bd89422710",
                                "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                                "text": "Die Komposita Blaubirke und Gelbbirke illustrieren dies."
                            },
                            {
                                "example_id": "a187f3cd-8873-42ee-9a77-c1a39860d299",
                                "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                                "text": "X coerulea Blanchard (B. coerulea-grandis X populifolia), Blaubirke. Baum, bis 10 m, meist niedriger, Zweige dünn, ansteigend, mit vielen kleinen, hellen Lentizellen, im Austrieb etwas zottig behaart, später kahl und rotbraun."
                            },
                            {
                                "example_id": "15066ca0-cd63-4c36-89a4-1d734211ca0b",
                                "sense_id": "f8cadf1f-e4d6-3a6e-a34a-59a202b4e4c9",
                                "text": "Die Blaubirke (Betula caerulea) ist eine Pflanzenart, die zur Familie der Birkengewächse (Betulaceae) gehört."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
