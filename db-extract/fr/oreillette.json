                    {
                        "sense_id": "3f407b77-df78-3433-8998-bf9bcb462701",
                        "entry_id": "212bec8e-2348-339b-8875-b1a08f7e7190",
                        "glosses": [
                            "an oreillette (ear-covering on a medieval helmet, civilian hood, etc)"
                        ],
                        "tags": [
