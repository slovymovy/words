                                    },
                                    {
                                        "sense_id": "e42c33bb-c728-3c5c-9a56-fd543d5e1a20",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A thin metal sheet, plate, or strip, as of lead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6edabd-6f0f-4ef1-b749-eef13ad6bc58",
                                                "sense_id": "e42c33bb-c728-3c5c-9a56-fd543d5e1a20",
                                                "text": "[…] And there with ſtately pompe by heapes they wend, / And Chriſtians ſlaine rolle vp in webs of lead […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96a82612-a84e-3e61-9e25-aa5619e2d1a8",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A thin metal sheet, plate, or strip, as of lead.",
                                            "The blade of a sword."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab84fef4-d393-498c-8960-fcfdeb1b76d2",
                                                "sense_id": "96a82612-a84e-3e61-9e25-aa5619e2d1a8",
                                                "text": "Argant a ſword, whereof the web was ſteele, / Pommell, rich ſtone ; hilts, gold, approu’d by tuch, / With rareſt workmanſhip all forged weele, / The curious art exceld the ſubſtance much."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "606834e3-9e13-3a61-9565-b0ce899db4ba",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A thin metal sheet, plate, or strip, as of lead.",
                                            "The blade of a saw."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc28ae3a-1720-36c3-9a5e-a0ebb61127e8",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A thin metal sheet, plate, or strip, as of lead.",
                                            "The thin, sharp part of a colter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc67b6e1-41a8-385e-a5eb-88db86ff914c",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A thin metal sheet, plate, or strip, as of lead.",
                                            "The bit of a key."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f20541e-a680-33e5-b90c-03a10a43f6e9",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A major broadcasting network."
                                        ],
                                        "tags": [
                                            "US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "769d197a-cc76-407b-8d79-42fafabf406a",
                                                "sense_id": "9f20541e-a680-33e5-b90c-03a10a43f6e9",
                                                "text": "[…] the first big move toward a contract for television performers was made Friday (20) when the webs agreed to pay them according to the length of the show. […] Altho the major TV webs — NBC and CBS — may fall in line soon, an agreement may possibly be held up by the opposition of DuMont […]"
                                            },
                                            {
                                                "example_id": "a206bd2d-2895-4737-bd23-9d4d4951d278",
                                                "sense_id": "9f20541e-a680-33e5-b90c-03a10a43f6e9",
                                                "text": "ABC-TV this week put into effect its long anticipated plans to move into daytime programming in a bigger way by opening up its 4-5 across-the-board strip. The web is using its \"Mickey Mouse Club,\" which is stoutly anchored in the 5-6 p.m. slot, as a backing up point for its afternoon expansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83161838-a6f9-363a-a806-315bf038d460",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A section of a groin vault, separated by ribs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "943dc9ff-d87c-3c5b-9c25-7ccf258bdbf7",
                                        "entry_id": "353ada90-59f5-32a4-945b-ea485a68cd8e",
                                        "glosses": [
                                            "A cataract of the eye."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "web",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d206e81-f6b2-3941-a573-c66b4ade3a15",
                                        "entry_id": "d642319b-6c41-33fd-8668-892012c30874",
                                        "glosses": [
                                            "Alternative letter-case form of Web: the World Wide Web."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0ea936-d2b4-41c0-ab9d-b292dba68cbc",
                                                "sense_id": "3d206e81-f6b2-3941-a573-c66b4ade3a15",
                                                "text": "Let me search the web for that."
                                            },
                                            {
                                                "example_id": "3b3e18b6-f869-4e62-866f-d839d849bc5d",
                                                "sense_id": "3d206e81-f6b2-3941-a573-c66b4ade3a15",
                                                "text": "No, the web probably isn't addictive in the sense that nicotine or heroin are; no, Facebook and Twitter aren't guilty of \"killing conversation\" or corroding real-life friendship or making children autistic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "web",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d40dffc-08b0-36ec-9c6f-da8cc30ab939",
                                        "entry_id": "c5823258-33b9-3c3f-849f-3d1d3361a201",
                                        "glosses": [
                                            "To construct or form a web."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9691af70-3cdc-38f2-a19e-ba91dac83191",
                                        "entry_id": "c5823258-33b9-3c3f-849f-3d1d3361a201",
                                        "glosses": [
                                            "To cover with a web or network."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87dd5c8-94d4-4553-a69c-7c214c6a8bfb",
                                                "sense_id": "9691af70-3cdc-38f2-a19e-ba91dac83191",
                                                "text": "The canker worm has no shelter upon the tree, but lies out upon the leaf or branch ; this forms itself a house by webbing the corner of a leaf, into which it retreats on the first appearance of danger[…]"
                                            },
                                            {
                                                "example_id": "b1741215-5a36-47f6-8ee5-8b0365adf4bf",
                                                "sense_id": "9691af70-3cdc-38f2-a19e-ba91dac83191",
                                                "text": "In the meantime continents were being ribbed with railways, the atmosphere was being webbed with telegraph wires connecting every important commercial centre[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fb43f25-2cc5-3ac9-9396-b50f95e75dd1",
                                        "entry_id": "c5823258-33b9-3c3f-849f-3d1d3361a201",
                                        "glosses": [
                                            "To ensnare or entangle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fbcbc52-6bc4-3d49-b8bd-c7b71c426621",
                                        "entry_id": "c5823258-33b9-3c3f-849f-3d1d3361a201",
                                        "glosses": [
                                            "To provide with a web."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "660ed39f-e6c9-34af-ad9c-58a5ce4c4ca7",
                                        "entry_id": "c5823258-33b9-3c3f-849f-3d1d3361a201",
                                        "glosses": [
                                            "To weave."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6daffd76-16cd-447d-bb9a-e1fc74b31988",
                                                "sense_id": "660ed39f-e6c9-34af-ad9c-58a5ce4c4ca7",
                                                "text": "Item that the Wever whiche shall have the wevyng of eny wollen yerne to be webbed into cloth shall weve werk[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
