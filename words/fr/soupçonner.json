{
    "word_family": [
        "soupçon",
        "soupçonneux",
        "insoupçonnable",
        "insoupçonné"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d673c68b-1279-3737-93e9-fbe0a36ebc10",
                    "sense_definition": "Attribuer à quelqu'un, sans preuve formelle, une faute, un délit ou des intentions malveillantes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "doute_méfiance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police <w>soupçonne</w> cet homme d'avoir participé au cambriolage de la bijouterie."
                        },
                        {
                            "text": "Elle a toujours <w>soupçonné</w> son voisin de mentir sur ses réelles activités professionnelles."
                        }
                    ],
                    "synonyms": [
                        "suspecter"
                    ],
                    "common_phrases": [
                        "soupçonner le pire",
                        "soupçonner quelqu'un de"
                    ]
                },
                {
                    "sense_id": "343c7158-23de-3d44-a506-f5da70155306",
                    "sense_definition": "Former une simple conjecture, présumer ou supposer quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>soupçonne</w> qu'il prépare une fête surprise pour l'anniversaire de son frère."
                        },
                        {
                            "text": "Son comportement étrange nous laisse <w>soupçonner</w> un changement important dans sa vie."
                        }
                    ],
                    "common_phrases": [
                        "laisser soupçonner"
                    ]
                },
                {
                    "sense_id": "00291841-15f2-3d72-bd15-f63b26dca878",
                    "sense_definition": "Pressentir, deviner ou avoir une intuition préalable d'une chose à venir ou cachée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne pouvait <w>soupçonner</w> l'ampleur des bouleversements que cette invention allait provoquer."
                        },
                        {
                            "text": "Les touristes marchaient dans les ruines sans rien <w>soupçonner</w> des trésors enfouis sous leurs pieds."
                        }
                    ],
                    "common_phrases": [
                        "sans rien soupçonner",
                        "pouvoir soupçonner"
                    ]
                }
            ]
        }
    ]
}