                "senses": [
                    {
                        "sense_id": "5e73c5c9-4463-397f-ba34-20ccffa8a658",
                        "entry_id": "87c7867e-91dd-3b2e-bf53-7e3f6dbb664e",
                        "glosses": [
                            "kaltes Tauchbad der Unterarme nach Sebastian Kneipp, welches das Herz beruhigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e958d6a-8507-4603-aab6-1732a6e8c641",
                                "sense_id": "5e73c5c9-4463-397f-ba34-20ccffa8a658",
                                "text": "„Sanitätsrat Dr. Schalle betont die Wirkung des kalten Armbades als ‚Herzbad‘, Sanitätsrat Dr. Scholz und viele andere erweisen die Lebendigkeit der Lehre an einer Reihe ausgezeichneter Einzeldarstellungen, Dr. Kapferer stellt die Einheit zum hippokratischen Denken und Handeln heraus, und wir sehen gleichzeitig, wie die Kneippschen Diätregeln von ihren einfachen, primitiven Anfängen sich immer deutlicher zur Diätkur im Sinne unserer heutigen Ernährungslehre entwickeln."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19039783-b32c-37a8-89d8-ef9e8b4a6c81",
                        "entry_id": "87c7867e-91dd-3b2e-bf53-7e3f6dbb664e",
                        "glosses": [
                            "speziell für Herzkranke geeigneter Badeort (vor allem mit kohlendioxidhaltiger Heilquelle)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae7f9192-0e3a-4c57-8b18-6279d3e5abb7",
                                "sense_id": "19039783-b32c-37a8-89d8-ef9e8b4a6c81",
                                "text": "„Alle Hotels des Herzbades dienen jetzt wieder ihrer Aufgabe, Stätten der gepflegten Gastlichkeit zu sein, in denen ein nicht unwesentlicher Beitrag zum Heilerfolg geleistet wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
