                    {
                        "translation_id": "ccaaa41f-2f50-4399-ba06-81cf2aaa4ed0",
                        "source_entry_id": "ee2e1fd7-fbea-311f-9aea-495f2156099a",
                        "source_sense_id": "00c4e44e-6bd3-3b09-aa24-7ecd4f1c0cff",
                        "source_sense_description": "der den Staubbeutel tragende Faden einer Blüte",
                        "target_lang_word": "filament",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "filament",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "80c1f80b-e2da-3062-9271-5b5a97ea7de2",
                                        "entry_id": "392dfaec-c3fa-3460-8a44-bc9e1d760bf6",
                                        "glosses": [
                                            "Petit fil, petit brin long et délié, semblable à celui qui se tire de l’écorce du chanvre ou du lin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9445e403-12f5-4e00-bd1f-53b7e36dafca",
                                                "sense_id": "80c1f80b-e2da-3062-9271-5b5a97ea7de2",
                                                "text": "Les premiers essais de fabrication datent de 1855 où Adhémar de Lausanne, prenait brevet pour la production d’une « soie végétale », transformation en filaments d’une dissolution de nitro-cellulose."
                                            },
                                            {
                                                "example_id": "4976fd2f-e518-45e6-8d1b-b6fb22c3398d",
                                                "sense_id": "80c1f80b-e2da-3062-9271-5b5a97ea7de2",
                                                "text": "Des filaments pareils à des larmes de lait\nOnt pleuré, sous le vent cruel qui les repousse,\nÀ travers de petits caillots de marne rousse\nPour s’aller perdre où la pente les appelait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37bbe07a-c7c7-38c5-b1d4-f98f82299d64",
                                        "entry_id": "392dfaec-c3fa-3460-8a44-bc9e1d760bf6",
                                        "glosses": [
                                            "Élément lumineux, fin et allongé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab7774b1-1df1-4bfa-bf88-39e211a9242f",
                                                "sense_id": "37bbe07a-c7c7-38c5-b1d4-f98f82299d64",
                                                "text": "Je n’aime pas beaucoup l’aube, on dirait que le ciel est malade. Trop de filaments blêmes, trop de lueurs malsaines, et tous ces bruits qui commencent, ces bruits d’herbe et d’oiseaux qui viennent gâcher le beau silence obscur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19cfbd1a-bc00-31e5-8669-30dcac76f302",
                                        "entry_id": "392dfaec-c3fa-3460-8a44-bc9e1d760bf6",
                                        "glosses": [
                                            "Fibrille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af65e7df-b56e-49b7-bc99-dd63b9403837",
                                                "sense_id": "19cfbd1a-bc00-31e5-8669-30dcac76f302",
                                                "text": "Les filaments qui composent les nerfs, les muscles."
                                            },
                                            {
                                                "example_id": "7f6f71b1-cb2c-4912-8a77-51b17fb72550",
                                                "sense_id": "19cfbd1a-bc00-31e5-8669-30dcac76f302",
                                                "text": "Filament nerveux, musculaire, cellulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b603b3b2-aad3-3ca2-9006-093f71532ac5",
                                        "entry_id": "392dfaec-c3fa-3460-8a44-bc9e1d760bf6",
                                        "glosses": [
                                            "Mince fil, souvent métallique, partie active d'une ampoule à incandescence."
                                        ],
                                        "tags": [
                                            "Électrotechnique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15b08e3-3b2f-4b4c-89bf-d22133796916",
                                                "sense_id": "b603b3b2-aad3-3ca2-9006-093f71532ac5",
                                                "text": "Les lots de lampes à filament de carbone, étalonnées en bougies nouvelles, continueront à servir d’étalons pratiques, le recours au corps noir-platine n’étant envisagé que pour le contrôle périodique de ces groupes de lampes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba4f40c8-d07c-3e85-9d65-df196fb120c8",
                                        "entry_id": "392dfaec-c3fa-3460-8a44-bc9e1d760bf6",
                                        "glosses": [
                                            "Filament solaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
