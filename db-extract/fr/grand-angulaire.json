                        "entry_id": "db114060-2614-3b2b-8a53-ecfeed6cd14f",
                        "glosses": [
                            "Qualifie les objectifs de caméra ou d’appareil photo dont l’angle de champ est supérieur à 70°."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5349cd3f-b9f9-4076-95cc-de0929bafe63",
                                "sense_id": "ff7ba9b1-8a6a-3517-8f51-eea83e394341",
                                "text": "Mais parfois, recourir à des optiques grand-angulaires ou fish-eyes, et photographier un sujet en se rapprochant de lui peut s’avérer plus judicieux."
                            },
                            {
                                "example_id": "159e68f2-d133-4637-a141-f774d49a1833",
                                "sense_id": "ff7ba9b1-8a6a-3517-8f51-eea83e394341",
                                "text": "Les objectifs grands-angulaires couvrent généralement entre 100° et 60°;"
                            }
                        ]
                    }
