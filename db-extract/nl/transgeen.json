                "senses": [
                    {
                        "sense_id": "dedc3a6b-8781-3ff6-aa6b-89576a6a8dc6",
                        "entry_id": "977343b8-57ee-385c-908b-15725e9f848d",
                        "glosses": [
                            "genetisch materiaal uit meerdere dier- of plantensoorten bevattende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef179df-2fb5-4d95-bd52-56b9b45842c8",
                                "sense_id": "dedc3a6b-8781-3ff6-aa6b-89576a6a8dc6",
                                "text": "Eind 2015 besliste de Amerikaanse overheid (de Food and Drug Administration, FDA, die ook de geneesmiddelen registreert) dat de zalm op de markt mocht komen. Dat was volle vijf jaar nadat diezelfde FDA had beslist dat de vis geschikt was voor consumptie. Half 2016 volgde het Canadese ministerie van Volksgezondheid: ‘De ggo-zalm is even veilig en voedzaam als conventionele zalm.’ In beide landen moet het etiket niet vermelden dat het om een transgeen product gaat."
                            },
                            {
                                "example_id": "560e6eab-fa15-4181-9469-8f343e3d4f10",
                                "sense_id": "dedc3a6b-8781-3ff6-aa6b-89576a6a8dc6",
                                "text": "Intussen wordt Europa steeds meer overspoeld door genproducten van buiten. Een kleine 50 voedingsgewassen zijn inmiddels toegestaan in de EU. Van al het Europese veevoer is inmiddels meer dan 70 procent transgeen. Wat dat betreft heeft Europa genetisch gemodificeerde boter op het hoofd, denken mensen die de cijfers kennen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9590e373-d290-43c2-bcee-b6be50dc26c0",
                        "source_entry_id": "977343b8-57ee-385c-908b-15725e9f848d",
                        "source_sense_id": "dedc3a6b-8781-3ff6-aa6b-89576a6a8dc6",
                        "target_lang_word": "transgenic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transgenic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                        "entry_id": "29fc594e-b901-3af1-9524-746c0799ed8e",
                                        "glosses": [
                                            "Of, or pertaining to an organism whose genome has been changed by the addition of a gene from another species; (of an organism) whose genome has been changed by such addition, genetically modified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "befe3467-4372-43d9-89a3-35d01ff51b82",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "The third type are human transgenic embryos, made by injecting a segment of animal DNA into a human egg."
                                            },
                                            {
                                                "example_id": "385d57bb-8594-454c-b65f-b13d3c91746b",
                                                "sense_id": "cad6ccfd-2ff3-38c4-8bae-e92f2ac2ce37",
                                                "text": "Common ingredients like corn, vegetable oil, maltodextrin, soy protein, lecithin, monosodium glutamate, cornstarch, yeast extract, sugar and corn syrup are almost always produced from transgenic crops."
                                            }
                                        ]
                                    }
                                ]
                            },
