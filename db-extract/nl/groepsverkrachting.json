                                        "glosses": [
                                            "Ereignis, bei dem mehrere Personen sexuelle Handlungen an mindestens einer weiteren Person vornehmen, die damit nicht einverstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46dcdfab-22bf-4cdc-a3a1-575a19001e1f",
                                                "sense_id": "60b5d5cb-26c4-3326-84eb-5b73ef32d349",
                                                "text": "Gruppenvergewaltigungen sind etwas sehr brutales."
                                            },
                                            {
                                                "example_id": "b4256b89-6be2-4ce2-8f17-e67ed1badfb5",
                                                "sense_id": "60b5d5cb-26c4-3326-84eb-5b73ef32d349",
                                                "text": "„Als Strafe dafür, dass ihr damals zwölfjähriger Bruder die Nähe eines Mädchens der Jatoi-biraderi gesucht haben soll, wurde sie das Opfer einer Gruppenvergewaltigung durch vierzehn Männer ihres Dorfes.“"
                                            },
                                            {
                                                "example_id": "931c5475-2491-4016-a8ac-04706202731a",
                                                "sense_id": "60b5d5cb-26c4-3326-84eb-5b73ef32d349",
                                                "text": "„Im selben Jahr wird er zusammen mit acht anderen Jugendlichen unter 18 Jahren als Erwachsener wegen der Gruppenvergewaltigung eines zwölfjährigen Mädchens angeklagt.“"
                                            },
                                            {
                                                "example_id": "91084a3a-e420-4aff-997a-792eea7087cf",
                                                "sense_id": "60b5d5cb-26c4-3326-84eb-5b73ef32d349",
                                                "text": "„Das erinnert mich an den Spruch, dass neun von zehn Leuten Spaß an einer Gruppenvergewaltigung haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
