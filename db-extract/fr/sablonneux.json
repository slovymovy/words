                        ],
                        "form": "sablonneuse"
                    },
                    {
                        "form_id": "5f8ec4de-20d4-4dd1-9ad1-e7451d8ac2fd",
                        "entry_id": "ce0bad6a-f6c7-3638-824a-cc1ffe19c8ed",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "sablonneuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                        "entry_id": "ce0bad6a-f6c7-3638-824a-cc1ffe19c8ed",
                        "glosses": [
                            "Où il y a beaucoup de sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "634d48d9-c985-4f6e-bee4-b3b53b7da36e",
                                "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                                "text": "Toutes les autres conditions étant égales, les formations argilo-siliceuses, argilo-loessiques ou molassiques, plus riches en zéolithes et sels minéraux podzolisent plus lentement et donnent des podzols moins prononcés que les formations sablonneuses."
                            },
                            {
                                "example_id": "3001d3fb-df97-4ff6-bb50-3949d0d9ca15",
                                "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                                "text": "La terre que je cultive, située sur le territoire de Chanteheux, se monte à 500 jours de terre (100 hect.), et 140 fauchées de prés (28 hect.) ; le terrain est sec, sablonneux et graveleux."
                            },
                            {
                                "example_id": "11d3204a-05ab-43ab-8130-35de88a63585",
                                "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                                "text": "L'argille convient pour améliorer les terres sablonneuses , graveleuses ou pierreuses ; on s'en sert beaucoup dans la Province de Stafford."
                            },
                            {
                                "example_id": "65b7838e-c641-47a6-88f7-f55da01d90c8",
                                "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                                "text": "On suivait des ondulations sablonneuses d’un terrain à pentes douces."
                            },
                            {
                                "example_id": "6f113b6c-e55a-4c75-aad3-a639267f0012",
                                "sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                                "text": "Nous marchâmes encore une heure environ, dans des sentiers sablonneux, sur des terrains que Tatari me dit appartenir à la reine Pomaré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22aed69c-3ac3-42d0-9438-93e9c8747a40",
                        "source_entry_id": "ce0bad6a-f6c7-3638-824a-cc1ffe19c8ed",
                        "source_sense_id": "b527b0fd-54d4-3bea-bd8d-9419b6640259",
                        "target_lang_word": "sandig",
