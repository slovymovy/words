                ],
                "senses": [
                    {
                        "sense_id": "23d670b3-d8d4-36ef-a737-bded1ac82a00",
                        "entry_id": "f161bb20-1fe4-3047-b36f-235e90b4cecb",
                        "glosses": [
                            "Action d’enfanter."
                        ],
                        "tags": [
                            "Reproduction"
                        ],
                        "examples": [
                            {
                                "example_id": "03590727-85ef-4418-a566-c3f4d2f11ffb",
                                "sense_id": "23d670b3-d8d4-36ef-a737-bded1ac82a00",
                                "text": "Le seul aspect de la femme révèle qu’elle n’est destinée ni aux grands travaux de l’intelligence, ni aux grands travaux matériels. Elle paie sa dette à la vie non par l’action mais par la souffrance, les douleurs de l’enfantement, les soins inquiets de l’enfance."
                            },
                            {
                                "example_id": "03fb2fe5-d9de-40d6-8775-d3bd4ea5b5ba",
                                "sense_id": "23d670b3-d8d4-36ef-a737-bded1ac82a00",
                                "text": "Le long enfantement de la grandeur romaine."
                            },
                            {
                                "example_id": "f7e5d25d-de1d-4437-b057-c583ec0c3a1e",
                                "sense_id": "23d670b3-d8d4-36ef-a737-bded1ac82a00",
                                "text": "Ce sont les machines qui, littéralement, enfantent notre monde. Et qui, de cet enfantement, permettent l’émergence d’un nouvel écosystème, d’une nouvelle espèce : depuis un peu moins d’un siècle, vous, moi, tous ceux qui lisent ce livre, doivent leur vie, leurs guérisons, leur agonie, leur bonheur et désespoir de moins en moins aux êtres qui peuplent leur désirs et de plus en plus aux machines qui les veillent calmement."
                            }
                        ]
                    }
                ],
