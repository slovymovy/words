                    {
                        "translation_id": "f554c674-92d8-4dc8-a2a8-3aae6ee4cc47",
                        "source_entry_id": "77cdacc0-7ce2-3d33-b53a-4be6854031a8",
                        "target_lang_word": "Euphorie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphorie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
                                            "ein begeisterter Gemütszustand der Lebensfreude, ein vorübergehendes gesteigertes gutes Lebensgefühl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7815a60-4eb7-4776-b184-a0f7a2e8a5c9",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "Jetzt in Optimismus oder gar Euphorie auszubrechen, wäre falsch, doch vorsichtige Hoffnungen darf man erstmals hegen."
                                            },
                                            {
                                                "example_id": "f6741dc0-2dca-45aa-9260-92b3596ff67c",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Ich hätte nicht geglaubt, dass seine Euphorie so lange vorhalten würde.“"
                                            },
                                            {
                                                "example_id": "0638160e-b4f2-4313-b2b7-674cb706c36a",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Die europäische Presse versammelte ihre Korrespondenten in London, deren Berichte sich vor wissenschaftlicher Euphorie überschlugen.“"
                                            },
                                            {
                                                "example_id": "dc6653d6-6176-4b8d-8430-b1756ee8a067",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Wie war es möglich, daß die gesamte Bevölkerung übergangslos vom Zustand der Katatonie in den der Euphorie kippte?“"
                                            },
                                            {
                                                "example_id": "f5a26361-d6f3-4313-8ab5-cc18c86b16e5",
                                                "sense_id": "3dc45396-9941-38dd-8af8-922b001980e9",
                                                "text": "„Eine Euphorie stellte sich ein, man kennt sie nach Fastenkuren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebdaed40-1850-31e0-ba4c-2dcb4c5165a2",
                                        "entry_id": "796f7160-6c59-3e0e-a215-917740857742",
                                        "glosses": [
                                            "subjektives Wohlbefinden Schwerkranker"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b290e29-f2a5-4774-b61d-d28d234b0d14",
                        "source_entry_id": "77cdacc0-7ce2-3d33-b53a-4be6854031a8",
                        "target_lang_word": "Hochgefühl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hochgefühl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd6a8b68-60b8-361e-840b-b2b041af0c09",
                                        "entry_id": "7a75c0c3-f0bc-3fbd-96a9-00264d344cfd",
                                        "glosses": [
                                            "Gefühl großen Glücks, großer Zufriedenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c55401-675a-4813-86bb-a271535f09ea",
                                                "sense_id": "cd6a8b68-60b8-361e-840b-b2b041af0c09",
                                                "text": "„Die Nervosität war von mir abgefallen und hatte einem Hochgefühl Platz gemacht.“"
                                            },
                                            {
                                                "example_id": "ebfcc835-524b-4bf1-a35f-dcb1b4906311",
                                                "sense_id": "cd6a8b68-60b8-361e-840b-b2b041af0c09",
                                                "text": "„Aber schon in das Hochgefühl der Siegesfeiern mischten sich dunkle Vorahnungen.“"
                                            },
                                            {
                                                "example_id": "3bfdcb10-494f-4318-b098-30667dd68547",
                                                "sense_id": "cd6a8b68-60b8-361e-840b-b2b041af0c09",
                                                "text": "„Seine Worte hatten ihr Hochgefühl zerstört.“"
                                            },
                                            {
                                                "example_id": "01052f54-f2b8-4375-81b6-bc001e7f227c",
                                                "sense_id": "cd6a8b68-60b8-361e-840b-b2b041af0c09",
                                                "text": "„Ich verließ meinen flinken Neapolitaner dennoch im Hochgefühl des verwöhnten Gastes, denn er verrichtete seine Arbeit mit jener heiteren romanischen Noblesse, die in seiner Heimat selbst Putzfrauen den Hauch des Königlichen verleiht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
