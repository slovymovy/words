    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9c25f748-a757-39bd-a512-651ead36d3da",
                    "sense_definition": "Osoba, która zachowuje się niepoważnie, ośmiesza się lub ciągle stroi sobie żarty.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "zachowanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestań robić z siebie <w>błazna</w> przed wszystkimi gośćmi na tym przyjęciu.",
                            "target_lang_translations": {
                                "ru": "Перестань строить из себя <w>шута</w> перед всеми гостями на этом приёме."
                            }
                        },
                        {
                            "text": "Przez swoje nieodpowiedzialne zachowanie wyszedł na kompletnego <w>błazna</w>.",
                            "target_lang_translations": {
                                "ru": "Из-за своего безответственного поведения он выставил себя полным <w>дураком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pajac",
                        "wesołek"
                    ],
                    "antonyms": [
                        "smutas"
                    ],
                    "common_phrases": [
                        "robić z siebie błazna",
                        "wyjść na błazna",
                        "udawać błazna"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который ведёт себя несерьёзно, выставляет себя на посмешище или постоянно шутит и кривляется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "о человеке, который кривляется или ведёт себя глупо"
                            },
                            {
                                "target_lang_word": "паяц",
                                "target_lang_sense_clarification": "переносно: несерьёзный человек, кривляка"
                            },
                            {
                                "target_lang_word": "клоун",
                                "target_lang_sense_clarification": "в переносном смысле: о смехотворном поведении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8dc344ea-c478-3f84-b5b5-b2978f44c2e6",
                    "sense_definition": "Dawny urzędnik lub artysta na dworze królewskim, którego zadaniem było zabawianie władcy żartami i dowcipem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "historia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnych czasach nadworny <w>błazen</w> jako jedyny mógł bezkarnie krytykować króla.",
                            "target_lang_translations": {
                                "ru": "В давние времена придворный <w>шут</w> был единственным, кто мог безнаказанно критиковать короля."
                            }
                        },
                        {
                            "text": "Stańczyk to chyba najbardziej znany królewski <w>błazen</w> w historii Polski.",
                            "target_lang_translations": {
                                "ru": "Станьчик — пожалуй, самый известный королевский <w>шут</w> в истории Польши."
                            }
                        }
                    ],
                    "synonyms": [
                        "trefniś",
                        "krotochwilnik"
                    ],
                    "common_phrases": [
                        "nadworny błazen",
                        "królewski błazen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "odnosi się do realiów historycznych"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо при дворе монарха или вельможи, в чьи обязанности входило развлекать господ шутками и остротами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "придворный шут"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4626aff-ea1e-3bc4-8017-931967c9ade4",
                    "sense_definition": "Artysta cyrkowy odgrywający komiczne scenki i bawiący publiczność; klown.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cyrk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dzieci z głośnym śmiechem oglądały zabawne występy cyrkowego <w>błazna</w>.",
                            "target_lang_translations": {
                                "ru": "Дети заливисто смеялись, глядя на забавные выступления циркового <w>клоуна</w>."
                            }
                        },
                        {
                            "text": "Na arenie pojawił się kolorowo ubrany <w>błazen</w> z wielkim nosem.",
                            "target_lang_translations": {
                                "ru": "На арене появился ярко одетый <w>паяц</w> с огромным носом."
                            }
                        }
                    ],
                    "synonyms": [
                        "klaun"
                    ],
                    "common_phrases": [
                        "błazen w cyrku",
                        "występy błazna"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цирковой артист, исполняющий комические сценки и развлекающий публику; клоун."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паяц",
                                "target_lang_sense_clarification": "цирковой или балаганный комик"
                            },
                            {
                                "target_lang_word": "клоун",
                                "target_lang_sense_clarification": "цирковой артист комического жанра"
                            },
                            {
                                "target_lang_word": "шут",
                                "target_lang_sense_clarification": "устаревающее обозначение комического артиста"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}