{
    "word_family": [
        "perch",
        "percher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a49e4a34-74fd-3b5f-97be-4e95c923a7f0",
                    "sense_definition": "The act of resting or sitting on a branch or similar elevated spot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "resting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird's <w>perching</w> on the high branch allowed it to scan the entire field for food.",
                            "target_lang_translations": {
                                "cs": "Ptákovo <w>hřadování</w> na vysoké větvi mu umožnilo prohledat celé pole kvůli potravě."
                            }
                        },
                        {
                            "text": "Observers noted the frequent <w>perching</w> of the hawks on the telephone wires during the migration.",
                            "target_lang_translations": {
                                "cs": "Pozorovatelé zaznamenali časté <w>posedávání</w> jestřábů na telefonních drátech během migrace."
                            }
                        }
                    ],
                    "synonyms": [
                        "roosting",
                        "sitting"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost spočívající v sezení nebo odpočívání na větvi či jiném vyvýšeném místě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hřadování",
                                "target_lang_sense_clarification": "zejména u ptáků"
                            },
                            {
                                "target_lang_word": "posedávání",
                                "target_lang_sense_clarification": "obecné sezení na vyvýšeném místě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70a2371c-3d85-3561-a2c7-ad2f693b38e1",
                    "sense_definition": "The process of inspecting cloth for defects before the final finishing stage.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quality control team performed a thorough <w>perching</w> of the fabric to ensure no threads were loose.",
                            "target_lang_translations": {
                                "cs": "Tým kontroly kvality provedl důkladné <w>prohlížení</w> látky, aby se ujistil, že žádné nitě nejsou uvolněné."
                            }
                        },
                        {
                            "text": "After the <w>perching</w> was complete, the textile was sent to the dyeing department.",
                            "target_lang_translations": {
                                "cs": "Po dokončení <w>kontroly</w> byl textil odeslán do barvírny."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspection",
                        "examination"
                    ],
                    "target_lang_definitions": {
                        "cs": "Proces kontroly látky před finální úpravou za účelem nalezení vad."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prohlížení látky",
                                "target_lang_sense_clarification": "odborná kontrola textilu"
                            },
                            {
                                "target_lang_word": "kontrola jakosti",
                                "target_lang_sense_clarification": "v textilním průmyslu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd3df665-1d30-3fa8-bc1e-cb9c0504e487",
                    "sense_definition": "The present participle and gerund of <w>perch</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The owl was <w>perching</w> silently on the fence post while waiting for its prey.",
                            "target_lang_translations": {
                                "cs": "Sova tiše <w>seděla</w> na sloupku plotu a čekala na svou kořist."
                            }
                        },
                        {
                            "text": "We saw several eagles <w>perching</w> in the tall pine trees near the lake.",
                            "target_lang_translations": {
                                "cs": "Viděli jsme několik orlů <w>sedících</w> ve vysokých borovicích u jezera."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb perch."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'perch' (sedět na vyvýšeném místě)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sedící",
                                "target_lang_sense_clarification": "příčestí přítomné"
                            },
                            {
                                "target_lang_word": "hřadující",
                                "target_lang_sense_clarification": "o ptácích"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}