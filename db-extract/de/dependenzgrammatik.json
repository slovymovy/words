                ],
                "senses": [
                    {
                        "sense_id": "d00c9f53-14d9-349e-9a0d-6360fd91f8a4",
                        "entry_id": "c0bb9d5f-1ad3-362d-aaa1-d1a4d6410667",
                        "glosses": [
                            "ein Grammatiktyp aus der strukturellen Linguistik, bei dem die Abhängigkeiten zwischen den Wörtern und Wortgruppen innerhalb des Satzes herausgearbeitet werden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be8cc414-e185-49f5-94e0-d0505d571b27",
                                "sense_id": "d00c9f53-14d9-349e-9a0d-6360fd91f8a4",
                                "text": "Die Dependenzgrammatik ist einer unter vielen verschiedenen Ansätzen, Grammatiken zu konzipieren."
                            },
                            {
                                "example_id": "10fa3ba0-f583-46a2-977d-0bf312bf105e",
                                "sense_id": "d00c9f53-14d9-349e-9a0d-6360fd91f8a4",
                                "text": "„Als Begründer der modernen Dependenzgrammatik gilt der französische Sprachwissenschaftler Lucien Tesnière.“"
                            },
                            {
                                "example_id": "afa18167-085a-43b6-874e-9b842459933e",
                                "sense_id": "d00c9f53-14d9-349e-9a0d-6360fd91f8a4",
                                "text": "„Bei der Dependenzgrammatik geht es nicht um die Beschreibung linearer Verkettungsregeln, sondern um Abhängigkeitsbeziehungen zwischen den Elementen, die mehr oder weniger stark sein können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8ff63a5-85e9-433e-a0a8-044c21b6635a",
                        "source_entry_id": "c0bb9d5f-1ad3-362d-aaa1-d1a4d6410667",
                        "source_sense_id": "d00c9f53-14d9-349e-9a0d-6360fd91f8a4",
                        "source_sense_description": "ein Grammatiktyp, bei dem die Abhängigkeiten zwischen Satzbestandteilen herausgearbeitet werden",
                        "target_lang_word": "dependency grammar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dependency grammar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9aaa2342-3118-3943-bad6-f7dee1bfc1ff",
                                        "entry_id": "0d81f7af-ddf6-39bd-a68d-b44fd7e94ff6",
                                        "glosses": [
                                            "Any of a class of grammars based on the dependency relation (as opposed to the constituency relation), in which words are interconnected by directed links, and the (finite) verb is regarded as the centre of clause structure."
                                        ],
