                ],
                "senses": [
                    {
                        "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                        "entry_id": "6d488afc-a026-3688-a298-711591345977",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in einem Gefängnis, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0f85c7-d627-400f-858a-224d6d31d2ac",
                                "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                                "text": "„Eine Analyse der Gefängniskapellen wird durch den Umstand erschwert, dass das Gefängnis kulturtheoretisch eher ein Randthema ist.“"
                            },
                            {
                                "example_id": "9b185994-6a8b-4b3d-82fb-9c3d92a00192",
                                "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                                "text": "„Das von Zellblöcken umrahmte Gartengelände entdeckten die Häftlinge bei der Renovierung der Gefängniskapelle.“"
                            },
                            {
                                "example_id": "9754ea3f-2485-4010-9f7c-291e80546e6c",
                                "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                                "text": "„In dem Artikel über die Gefängniskapelle erfahren wir auch, dass etwa ein Viertel der Häftlinge am Gottesdienst teilnimmt.“"
                            },
                            {
                                "example_id": "23969d99-9f1a-4ba7-b799-8c918d8d288c",
                                "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                                "text": "„Einen Sonderfall eines Kirchenraumes stellt die Gefängniskapelle in Oslebshausen dar.“"
                            },
                            {
                                "example_id": "fe9a273c-4a5b-4b53-8560-c6f30b4b75a5",
                                "sense_id": "b1f3bdbf-a4e2-3add-bbc3-cf09e620eefd",
                                "text": "„Sie geht mit dem Häftling in die Gefängniskapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
