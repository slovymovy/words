                    "sense_id": "336d9ad9-8f8c-36de-95e0-d0dd487a7851",
                    "sense_definition": "in de richting van het binnenland, weg van de kust of de grens",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De storm trok langzaam <w>landinwaarts</w> en veroorzaakte veel schade.",
                            "target_lang_translations": {
                                "en": "The storm slowly moved <w>inland</w> and caused a lot of damage."
                            }
                        },
                        {
                            "text": "Als je verder <w>landinwaarts</w> reist, verandert het landschap snel.",
                            "target_lang_translations": {
                                "en": "If you travel further <w>inland</w>, the landscape changes quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "binnenwaarts"
                    ],
                    "antonyms": [
                        "zeewaarts"
                    ],
                    "common_phrases": [
                        "verder landinwaarts",
                        "landinwaarts trekken"
                    ],
                    "target_lang_definitions": {
                        "en": "in the direction of the interior of a country, away from the coast or border"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inland",
                                "target_lang_sense_clarification": "towards the interior of a country"
                            },
                            {
                                "target_lang_word": "landward",
                                "target_lang_sense_clarification": "towards the land"
                            }
                        ]
                    }
                }
            ]
        },
        {
