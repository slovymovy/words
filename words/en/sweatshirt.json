    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9809b583-95d2-3367-b0c5-9449ac93516b",
                    "sense_definition": "A loose shirt, usually made of a knit fleece, for athletic wear and now often used as casual apparel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to wear a <w>sweatshirt</w> because the morning air was quite chilly.",
                            "target_lang_translations": {
                                "ru": "Я решил надеть <w>толстовку</w>, так как утренний воздух был довольно прохладным."
                            }
                        },
                        {
                            "text": "He put on a <w>cotton</w> <w>sweatshirt</w> before heading out for his daily run.",
                            "target_lang_translations": {
                                "ru": "Он надел хлопковую <w>толстовку</w> перед тем, как отправиться на ежедневную пробежку."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cotton sweatshirt",
                        "hooded sweatshirt",
                        "oversized sweatshirt",
                        "wear a sweatshirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободная кофта, обычно из трикотажного флиса, предназначенная для занятий спортом, а теперь часто используемая как повседневная одежда."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толстовка",
                                "target_lang_sense_clarification": "наиболее общее название для спортивной кофты"
                            },
                            {
                                "target_lang_word": "свитшот",
                                "target_lang_sense_clarification": "модель без молнии и капюшона"
                            },
                            {
                                "target_lang_word": "худи",
                                "target_lang_sense_clarification": "модель с капюшоном"
                            },
                            {
                                "target_lang_word": "олимпийка",
                                "target_lang_sense_clarification": "спортивная куртка на молнии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b1da69e-f846-3562-88b3-6035e01c6f5c",
                    "sense_definition": "A shirt worn against the skin, usually under other clothing, to absorb sweat.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the past, a <w>sweatshirt</w> was often just a simple layer worn to protect outer garments.",
                            "target_lang_translations": {
                                "ru": "В прошлом <w>фуфайка</w> часто была просто обычным слоем одежды, который носили для защиты верхней одежды."
                            }
                        },
                        {
                            "text": "He wore a thin <w>sweatshirt</w> under his heavy wool coat to stay dry.",
                            "target_lang_translations": {
                                "ru": "Он надел тонкую <w>фуфайку</w> под тяжелое шерстяное пальто, чтобы оставаться сухим."
                            }
                        }
                    ],
                    "synonyms": [
                        "undershirt"
                    ],
                    "common_phrases": [
                        "absorbent sweatshirt",
                        "thin sweatshirt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Рубашка или майка, надеваемая на голое тело под другую одежду для впитывания пота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фуфайка",
                                "target_lang_sense_clarification": "нательная трикотажная рубашка"
                            },
                            {
                                "target_lang_word": "нижняя рубашка",
                                "target_lang_sense_clarification": "слой одежды под основной рубашкой"
                            }
                        ]
                    }
                }
            ]
        }
    ]
