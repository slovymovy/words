                "senses": [
                    {
                        "sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "glosses": [
                            "een minachtende of vernederende opmerking"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b5a5162-e1f2-4dbe-9445-1714436940bc",
                                "sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                                "text": "Hij kreeg een sneer omdat hij het niet goed gedaan had."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e70a69f-37ef-4804-8cc3-8b00ca9bae8a",
                        "source_entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "source_sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "source_sense_description": "een minachtende of vernederende opmerking",
                        "target_lang_word": "höhnische Bemerkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "07b7fa39-bdfa-4b86-8db4-b01d7d9c3c4f",
                        "source_entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "source_sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "source_sense_description": "een minachtende of vernederende opmerking",
                        "target_lang_word": "sneer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c686dee-3c99-3796-a845-31a653741a95",
                                        "entry_id": "a3ba2378-a96c-317f-b1f3-2eece4055041",
                                        "glosses": [
                                            "To raise a corner of the upper lip slightly, especially in scorn."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7814772-d3f4-4346-a6ea-110b18909d21",
                                                "sense_id": "2c686dee-3c99-3796-a845-31a653741a95",
                                                "text": "So General Oakfield's friends taunted him with having been beaten, and Blackeston's friends sneered at him for not having called the general out. Blackeston, a studious and sensitive man, felt the taunts of his friends as only a student can."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f975399-12d2-3c8f-8fb6-55395636c925",
                                        "entry_id": "a3ba2378-a96c-317f-b1f3-2eece4055041",
                                        "glosses": [
                                            "To utter with a grimace or contemptuous expression; to say sneeringly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "409cf0dc-9cc6-4a67-9c23-5fe02acb68a2",
                                                "sense_id": "1f975399-12d2-3c8f-8fb6-55395636c925",
                                                "text": "to sneer fulsome lies at a person"
                                            },
                                            {
                                                "example_id": "e75933aa-e2b7-47d6-b4a1-387c49b5b8db",
                                                "sense_id": "1f975399-12d2-3c8f-8fb6-55395636c925",
                                                "text": "There was a quick scuffle within the cabin. \"Leave me alone, I say, and git!\" cried the cook. \"Can't I be friendly without you hollerin?\" sneered the miner. \"You wouldn't have been 'lowed to stay round here if it hadn't been for me.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sneer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21761fc0-0ab6-32da-ba21-0e63289e3154",
                                        "entry_id": "b4582e1c-f17b-33ca-8f9a-13d57aeae88e",
                                        "glosses": [
                                            "A facial expression where one slightly raises one corner of the upper lip, generally indicating scorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d8ac7e8-3917-46dc-9baf-a43bedd153c0",
                                                "sense_id": "21761fc0-0ab6-32da-ba21-0e63289e3154",
                                                "text": "Near them, on the sand, / Half sunk, a shattered visage lies, whose frown, / And wrinked lip, and sneer of cold command, / Tell that its sculptor well those passions read"
                                            },
                                            {
                                                "example_id": "b53dd644-9bd4-4dc9-baf6-cafdd4887b0f",
                                                "sense_id": "21761fc0-0ab6-32da-ba21-0e63289e3154",
                                                "text": "He supposed then (with a sneer—M. Paul could sneer supremely, curling his lip, opening his nostrils, contracting his eyelids)—he supposed there was but one form of appeal to which I would listen [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a43b1dd1-444f-3619-aeb2-8241ad254b20",
                                        "entry_id": "b4582e1c-f17b-33ca-8f9a-13d57aeae88e",
                                        "glosses": [
                                            "A display of contempt; scorn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8223a22f-c0a3-4302-a097-c56d3ff4afeb",
                                                "sense_id": "a43b1dd1-444f-3619-aeb2-8241ad254b20",
                                                "text": "And wordy attacks against slavery drew sneers from observers which were not altogether undeserved. The authors were compared to doctors who offered to a patient nothing more than invectives against the disease which consumed him."
                                            },
                                            {
                                                "example_id": "5a28ef36-161d-4e2c-8375-5a74d09380bf",
                                                "sense_id": "a43b1dd1-444f-3619-aeb2-8241ad254b20",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "4b3059b5-caee-492c-980c-ebe9a3f33f87",
                                                "sense_id": "a43b1dd1-444f-3619-aeb2-8241ad254b20",
                                                "text": "During [Tucker] Carlson’s keynote, he wedged sneers at his critics for crying “racist!” in between racist remarks about [Ilhan] Omar, jeremiads against the media (“I know there’s a bunch of reporters here, so . . . screw you”), and an attack on Elizabeth Warren and her donors (“She’s a tragedy, because she’s now obsessed with racism, which is why the finance world supports her”)—all to gleeful applause."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02a6cd5a-5f90-4372-892d-e414a4f928be",
                        "source_entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "source_sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "source_sense_description": "een minachtende of vernederende opmerking",
                        "target_lang_word": "gibe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gibe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a2ac8a8-5b93-39cb-b20a-f0217c28750f",
                                        "entry_id": "013e2125-ad0c-3d2d-ae9c-76bfa62dfa74",
                                        "glosses": [
                                            "Alternative spelling of gybe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b745ed62-6709-3b23-9aff-080a494c8204",
                                        "entry_id": "013e2125-ad0c-3d2d-ae9c-76bfa62dfa74",
                                        "glosses": [
                                            "Alternative spelling of jibe (“facetious or insulting remark”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbe3384a-f982-48f6-b0e0-1fc91c1320e3",
                                                "sense_id": "b745ed62-6709-3b23-9aff-080a494c8204",
                                                "text": "Alas poore Yoricke, […] where be your gibes now? your gamboles? your ſongs? your flaſhes of merriment, that were wont to ſet the table on a roare, not one now to mocke your owne grinning, quite chopfalne."
                                            },
                                            {
                                                "example_id": "acb0ce15-791a-41c4-93e8-33f40d6d4ff7",
                                                "sense_id": "b745ed62-6709-3b23-9aff-080a494c8204",
                                                "text": "[George] Carlin's opening-night monologue included some blunt gibes at organized religion which would almost certainly have been cut out of any other network show."
                                            },
                                            {
                                                "example_id": "c3e36a6d-ebee-47aa-b7b1-21a1827f0cf7",
                                                "sense_id": "b745ed62-6709-3b23-9aff-080a494c8204",
                                                "text": "But an ugly eruption of racist gibes against some of its young Black players was a reminder that not everyone glories in the diverse portrait of the country that this team reflects."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gibe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf7d2963-216f-3176-be7b-0315a72f6ccd",
                                        "entry_id": "713e22a0-5a40-3639-a082-17a26ac6ef9d",
                                        "glosses": [
                                            "Alternative spelling of gybe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f99ce70f-4098-35da-b2ad-367c0bc121f9",
                                        "entry_id": "713e22a0-5a40-3639-a082-17a26ac6ef9d",
                                        "glosses": [
                                            "Alternative spelling of jibe."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7bb7a1d-b6ef-4ccb-9a52-e58da0dd9d8a",
                                                "sense_id": "f99ce70f-4098-35da-b2ad-367c0bc121f9",
                                                "text": "Why thats the way to choake a gibing ſpirrit, / Whoſe influence is begot of that looſe grace, / Which ſhallow laughing hearers giue to fooles, […]"
                                            },
                                            {
                                                "example_id": "b3864cac-3067-409d-924d-34afe5db02eb",
                                                "sense_id": "f99ce70f-4098-35da-b2ad-367c0bc121f9",
                                                "text": "[Y]ou / Did pocket vp my Letters: and with taunts / Did gibe my Miſive out of audience."
                                            },
                                            {
                                                "example_id": "c4f35d9f-352d-4b01-8735-16c13fba0df0",
                                                "sense_id": "f99ce70f-4098-35da-b2ad-367c0bc121f9",
                                                "text": "This ſet the old Gentlevvoman a Laughing at me, as you may be ſure it vvould: VVell, Madam, Forſooth, ſays ſhe, Gibing at me, you vvould be a Gentlevvoman, and hovv vvill you come to be a Gentlevvoman? VVhat vvill you do it by your Fingers Ends?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f16d664-1b17-40e5-8721-021ae7f54c7e",
                        "source_entry_id": "e9635dbe-5a6c-38d6-ae76-41e2ad1e6a18",
                        "source_sense_id": "e8b4599c-6320-387c-bbdc-4021e523b569",
                        "source_sense_description": "een minachtende of vernederende opmerking",
                        "target_lang_word": "pique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3f202e-c265-3e4d-b1eb-16a40f639896",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Sorte d’arme formée d’un long bois dont le bout est garni d’un fer plat et pointu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4febda-aeab-499f-8390-7598d0676845",
                                                "sense_id": "4d3f202e-c265-3e4d-b1eb-16a40f639896",
                                                "text": "[…]; tous tenaient à la main droite ou des épées, ou des piques, ou des arquebuses, et quelques-uns, à la main gauche, des flambeaux qui répandaient sur cette scène un jour funèbre et vacillant, […]."
                                            },
                                            {
                                                "example_id": "5af10077-b967-4f3e-a1c9-3e1116df11b9",
                                                "sense_id": "4d3f202e-c265-3e4d-b1eb-16a40f639896",
                                                "text": "[…] tous les hommes en état de porter les armes furent mis en activité. On s'enrôla sur les places publiques ; on fabriqua des fusils et des piques."
                                            },
                                            {
                                                "example_id": "0fe84b9d-a29d-4df6-ba5d-22571aaecc56",
                                                "sense_id": "4d3f202e-c265-3e4d-b1eb-16a40f639896",
                                                "text": "Celui-ci s’installa dans un palanquin semblable à celui d’un ministre et, se faisant suivre par deux ou trois soldats qui jouaient le rôle de l’escorte, portant des parasols, une longue pique, il se rendit à la maison de Trang Quynh."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9d4cc72-2de3-38e2-afdb-e74b89c4cf45",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Soldat qui portait la pique dans un régiment."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258b7932-aa23-49b7-9cd5-49e8d4d40de5",
                                                "sense_id": "e9d4cc72-2de3-38e2-afdb-e74b89c4cf45",
                                                "text": "Faire défiler les piques . Il y avait tant de piques dans ce régiment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92a56605-5fb7-32c2-a42b-53a39a147fb3",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Mesure de longueur de la grandeur de cette arme."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b20396d-fcf0-4ba1-83e4-cf1f34853006",
                                                "sense_id": "92a56605-5fb7-32c2-a42b-53a39a147fb3",
                                                "text": "Il y a une pique d’eau dans ce fossé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea948f8f-f7e7-36c1-96c8-5dad12a79fb9",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Objet piquant de forme pointue."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68709cb4-e8b9-483c-8d62-e6576f95f8c1",
                                                "sense_id": "ea948f8f-f7e7-36c1-96c8-5dad12a79fb9",
                                                "text": "On eût dit une grosse graine, à peu près de la taille d'un abricot, mais tout hérissée de petites piques semblables à celle des oursins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92eae76d-b8b0-3c40-9d26-b90b00b19b32",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Synonyme de bar commun, le poisson."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Parole, expression volontairement blessante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c68ec871-6ec8-49bb-b814-43d671d65b60",
                                                "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                                "text": "Nous avons eu naturellement des discussions avec lui, et ma mère a trouvé moyen de mettre la maison sens dessus dessous : histoires de corridors, disputes d’escalier, piques avec des femmes de voyageurs. On a discuté sur la note ; la bonne a réclamé un pourboire."
                                            },
                                            {
                                                "example_id": "57144270-ddbc-4fad-8291-8d9dd409f948",
                                                "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                                "text": "Elle affirmait sa personnalité par la contradiction et la pique comme d’autres par la douceur, le charme et l’harmonie."
                                            },
                                            {
                                                "example_id": "d3fd0c34-7bd1-4adf-bdab-45f00deb99a9",
                                                "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                                "text": "Depuis qu’il a clarifié ses intentions, les réactions sur les réseaux sociaux oscillent entre encouragements et piques."
                                            },
                                            {
                                                "example_id": "d581d7ac-469d-486f-8533-555348441504",
                                                "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                                "text": "Au-delà des échanges de piques, Moscou a clairement souligné que les remarques de M. Biden étaient, à ses yeux, inacceptables."
                                            },
                                            {
                                                "example_id": "ef0867f4-91a4-48d0-a40f-dbee0be59e18",
                                                "sense_id": "bcf4639a-8f77-3265-aaf8-e10697bb71d7",
                                                "text": "Envoyer une pique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebab9823-d6db-3562-a403-922d8c1397be",
                                        "entry_id": "6ecd7fec-0a4e-3901-aadf-440378253181",
                                        "glosses": [
                                            "Meuble représentant l’arme du même nom dans les armoiries. À rapprocher de dard, épieu, javelot, lance et lance de tournoi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97dfdf31-c29e-46ec-a008-13f91a7b5fd8",
                                                "sense_id": "ebab9823-d6db-3562-a403-922d8c1397be",
                                                "text": "D’azur à la pique d’or en pal fichée dans une motte de sinople, aux trois serpents d’argent en fasce brochant sur le fût de la pique, qui est de la commune de Montesquieu-Volvestre de Haute-Garonne → voir illustration « armoiries avec une pique »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03a07418-16fc-35cf-aa82-17d024f4517e",
                                        "entry_id": "efa5eb91-8832-34aa-9b45-7f21b772dc44",
                                        "glosses": [
                                            "Une des quatre enseignes d’un jeu de cartes français, ainsi nommée parce que les cartes de cette couleur sont marquées de piques noires stylisées (♠)."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0461d77-03c1-4d82-b981-6fac1f8bd6a2",
                                                "sense_id": "03a07418-16fc-35cf-aa82-17d024f4517e",
                                                "text": "M. Demangeot et le commandant Marigny se font tête, abattent cœur, pique et trèfle, l'atout, le roi, coupent et surcoupent impassibles comme s'ils risquaient des fortunes au lansquenet du roi."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "89e34b38-7ad4-30c4-88a7-a0b6df0464e8",
                                        "entry_id": "55eaca87-aa69-33dc-a7f3-0844be0085c0",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de piquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                        "entry_id": "55eaca87-aa69-33dc-a7f3-0844be0085c0",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de piquer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089dbd79-d134-4455-a65a-37f3f427f158",
                                                "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                                "text": "L’avion revient vers nous, plane un moment sur nos têtes, glisse, remonte et, dans une dernière caracole, pique vers son hangar."
                                            },
                                            {
                                                "example_id": "cc573a1b-e44d-4ffa-a1df-34d78da3032b",
                                                "sense_id": "c445cf72-fd41-350b-bed2-a1da7cd1bb16",
                                                "text": "Gundermann a plus d’une ressemblance avec le financier originaire de Frankfürt am Mein ; comme lui il est le patriarche d’une prolifique tribu ; comme lui il se plaint, il gémit d’être accablé de besogne ; comme lui encore il bibelotte, se pique de connaissances artistiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7176cd-d7b5-3578-9bd3-e8dc0b553dcb",
                                        "entry_id": "55eaca87-aa69-33dc-a7f3-0844be0085c0",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de piquer."
                                        ],
                                        "tags": [
