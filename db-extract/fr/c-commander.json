                ],
                "senses": [
                    {
                        "sense_id": "af39746b-31ea-368a-a8ae-5fc7d1e46a2c",
                        "entry_id": "367daef5-1c1a-3acb-95b2-61d1cbd560e6",
                        "glosses": [
                            "Pour deux nœuds A et B d’un arbre syntaxique, on dit que A c-commande B si A ne domine pas B, B ne domine pas A, et tous les ancêtres de A ayant strictement plus d’un descendant dominent B."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f43ff551-1f52-430d-9cdf-119af2b8fbb2",
                                "sense_id": "af39746b-31ea-368a-a8ae-5fc7d1e46a2c",
                                "text": "INDEX s’applique de \"haut en bas\" : elle ne s’applique à un NP que si elle s’est appliquée à tous les NP qui c-commandent ce NP."
                            },
                            {
                                "example_id": "9eaa1381-d630-4933-bc2b-e1434a18f774",
                                "sense_id": "af39746b-31ea-368a-a8ae-5fc7d1e46a2c",
                                "text": "Comme le QP3 et le nœud P' se c-commandent, chacun des deux peut se déplacer en premier, attiré par le trait [P]."
                            }
                        ]
                    }
                ],
