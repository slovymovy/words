                                        "glosses": [
                                            "Facile à fendre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f248d4b-3280-4235-bbbf-d0bf23721edd",
                                                "sense_id": "70b4528a-6100-3b40-b182-2498294721a1",
                                                "text": "Ces roches sont […] altérées […] elles deviennent plus fissiles, plus friables."
                                            },
                                            {
                                                "example_id": "6c29ecbb-2e44-4fd8-9d77-09f3124202ba",
                                                "sense_id": "70b4528a-6100-3b40-b182-2498294721a1",
                                                "text": "[B]ois homogène, blanc ou plus ou moins nacré, à densité élevée, très dur, peu fissile […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb298ced-6a71-35ef-b157-1e44579f8a5b",
                                        "entry_id": "ce9a5a10-c85e-3163-a314-04323f65dd4e",
                                        "glosses": [
                                            "susceptible de subir une fission sous l’effet d’un bombardement par des neutrons de toutes énergies, en parlant de noyau atomique"
                                        ],
                                        "tags": [
                                            "Physique des réacteurs nucléaires"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "077cd7c4-3426-4a71-b825-e7ed9218ce9b",
                                                "sense_id": "cb298ced-6a71-35ef-b157-1e44579f8a5b",
                                                "text": "Les isotopes fissiles commercialement utilisés sont l’uranium-235 et le plutonium-239."
                                            }
                                        ]
