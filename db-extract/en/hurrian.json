                    {
                        "translation_id": "90a28249-db65-4a72-87ca-f186d937c080",
                        "source_entry_id": "61373455-10b1-30bb-a930-c38154ab47c3",
                        "source_sense_id": "82d3633a-0f8a-3f4f-95c7-d645c7976d48",
                        "source_sense_description": "of or pertaining to the Hurrians, their language or culture",
                        "target_lang_word": "hurritisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurritisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ddce6b8a-f7e9-3576-b811-d2bebb8682d0",
                                        "entry_id": "7ee633a4-8b9e-3646-a0d6-5e0531b2fdcf",
                                        "glosses": [
                                            "die Gruppe, das Volk der Hurriter betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62988180-012e-451d-9092-1dd5c00ae598",
                                                "sense_id": "ddce6b8a-f7e9-3576-b811-d2bebb8682d0",
                                                "text": "„Über den dramatischen Zusammenbruch des hurritischen Großreiches berichtet lapidar eine Schlagzeile: ‚… und Mitanni ist zerfallen.‘“"
                                            },
                                            {
                                                "example_id": "a6cda8b4-1a67-455a-96e9-e2514196811b",
                                                "sense_id": "ddce6b8a-f7e9-3576-b811-d2bebb8682d0",
                                                "text": "„Da Ilawa auch der Name einer in hurritischem Milieu genannten Gottheit ist und der Name Perhena […] hurritischer Herkunft sein dürfte, ist der Schauplatz [der Erzählung] im hurritschen Siedlungsgebiet zu suchen. Dementsprechend sind auch die Namen der Protagonisten hurritisch, so dass von einer ursprünglich hurritischen Dichtung auszugehen ist.“"
                                            },
                                            {
                                                "example_id": "d43bdd15-cddf-4d64-b44b-370b361bf52d",
                                                "sense_id": "ddce6b8a-f7e9-3576-b811-d2bebb8682d0",
                                                "text": "„Zudem begegnet die in dieser Opferliste dokumentierte Abfolge der Gottheiten in gleicher bzw. in leicht veränderter Form in weiteren Opferlisten in hurritischer Sprache, so daß sie als repräsentativ für das kultische Pantheon und seine Hierarchie innerhalb der hurritischen Bevölkerungsschichten Ugarits gelten kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                        "entry_id": "7ee633a4-8b9e-3646-a0d6-5e0531b2fdcf",
                                        "glosses": [
                                            "die Sprache der Hurriter, das Hurritische, betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d50690a-ba51-44dc-9e4a-0e7df2b6b9f4",
                                                "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                                "text": "„Da Ilawa auch der Name einer in hurritischem Milieu genannten Gottheit ist und der Name Perhena […] hurritischer Herkunft sein dürfte, ist der Schauplatz [der Erzählung] im hurritschen Siedlungsgebiet zu suchen. Dementsprechend sind auch die Namen der Protagonisten hurritisch, so dass von einer ursprünglich hurritischen Dichtung auszugehen ist.“"
                                            },
                                            {
                                                "example_id": "1c3d0465-5ea1-4734-8125-a72d8a5a4654",
                                                "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                                "text": "„Zudem begegnet die in dieser Opferliste dokumentierte Abfolge der Gottheiten in gleicher bzw. in leicht veränderter Form in weiteren Opferlisten in hurritischer Sprache, so daß sie als repräsentativ für das kultische Pantheon und seine Hierarchie innerhalb der hurritischen Bevölkerungsschichten Ugarits gelten kann.“"
                                            },
                                            {
                                                "example_id": "935d27a2-4a44-46d5-b5b7-9a17deee7c7b",
                                                "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                                "text": "„Die Philologen hätten gern mehr und ausführlichere hurritische Texte, am besten gleich mit Übersetzung, denn die hurritische Sprache hat keine Verwandten und ist seit Jahrtausenden ausgestorben.“"
                                            },
                                            {
                                                "example_id": "46fd1780-5bc4-4faa-99df-d02dad7a1671",
                                                "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                                "text": "„Gegenstand der der vorliegenden Monographie ist die […] in der Oberstadt von Ḫattuša gefundene hurritisch-hethitische Bilingue […].“"
                                            },
                                            {
                                                "example_id": "b718ec61-210b-4cd7-bf43-1c763c964a44",
                                                "sense_id": "14023ebe-731f-3016-87e8-42df98fc0277",
                                                "text": "„Das häufig belegte Substantiv ašti ‚(Ehe)frau‘ gehört zu den ersten hurritischen Wörtern, deren richtige Bedeutung bereits in den Anfängen der hurritologischen Studien bestimmt wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "caece6a3-99eb-41c3-ae51-25d595c9020a",
                        "source_entry_id": "61373455-10b1-30bb-a930-c38154ab47c3",
                        "source_sense_id": "82d3633a-0f8a-3f4f-95c7-d645c7976d48",
                        "source_sense_description": "of or pertaining to the Hurrians, their language or culture",
                        "target_lang_word": "hurrisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hurrisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af7826c8-a6b7-3dc8-90b2-9a0b68bf5978",
                                        "entry_id": "29d7851f-41bf-31f1-affc-c06a5f33a291",
                                        "glosses": [
                                            "zur historischen Ethnie der Hurriter und deren Kultur gehörig"
                                        ],
                                        "tags": [
                                            "historical",
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50b4a64-bc08-4272-b7bc-3170a72ccd1c",
                                                "sense_id": "af7826c8-a6b7-3dc8-90b2-9a0b68bf5978",
                                                "text": "„Unter dieser Beute […] befinden sich nicht wenige Statuen hurrischer Gottheiten.“"
                                            },
                                            {
                                                "example_id": "e012009d-8978-4596-a699-49bb0c3b816f",
                                                "sense_id": "af7826c8-a6b7-3dc8-90b2-9a0b68bf5978",
                                                "text": "„Der Hauptimport an hurrischem Mythen- und Geistesgut in hethitischer Sprach und die Entstehung der meisten hurrischen Opferlisten […] in hethitischer Sprache dürfte in diese zweite Welle der hurrischen Beeinflussung und bewußten Kultkontamination mit den alten hattisch-hethitischen Vorstellungen am Hof und im Volk fallen […]“"
                                            },
                                            {
                                                "example_id": "0b886e0a-9359-4c9c-a5fb-da831d47d095",
                                                "sense_id": "af7826c8-a6b7-3dc8-90b2-9a0b68bf5978",
                                                "text": "„Es scheint, daß die älteste […] Bevölkerung Kizzuwatnas zuerst von einem luwischen und erst später von einem hurrischen Ethnos überlagert wurde […]“"
                                            },
                                            {
                                                "example_id": "a821a105-d8fb-41b8-99de-a18bf74f8a16",
                                                "sense_id": "af7826c8-a6b7-3dc8-90b2-9a0b68bf5978",
                                                "text": "„In Wirklichkeit berührt [das Thema] aber die wichtigen Fragen, wann der hurrische Einfluß auf die Oberschicht des Hethiterreiches erfolgt ist, wie alt jene in Ḫattuša-Boĝazköy […] erhaltenen hurrischen Traditionen sind […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                        "entry_id": "29d7851f-41bf-31f1-affc-c06a5f33a291",
                                        "glosses": [
                                            "zur Sprache Hurritisch gehörig"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fdc3750-87e2-4e1a-871f-11a9f320b3b5",
                                                "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                                "text": "„In Wirklichkeit berührt [das Thema] aber die wichtigen Fragen, wann der hurrische Einfluß auf die Oberschicht des Hethiterreiches erfolgt ist, wie alt jene in Ḫattuša-Boĝazköy […] erhaltenen hurrischen Traditionen sind […]“"
                                            },
                                            {
                                                "example_id": "8d354d00-ff89-49d2-9070-ef77d06e1daf",
                                                "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                                "text": "„Das gleiche Ideogramm tritt auch in hurrischen Götterlisten auf: so vermutet E. LAroche […] im Zuge von Yazilikaya eine Entsprechung zu jenem ᴰU.GUR, dessen hurrische Lesung Ḫešui sein könnte.“"
                                            },
                                            {
                                                "example_id": "bb4cd294-f01e-4e6e-a907-639cb9774f28",
                                                "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                                "text": "„Vor einer Etymologie, die sich auf indo-iran. -vāja berufen sollte, sei aber gewarnt, da -zz- in den hurrischen und hurrisch gefärbten Texten ziemlich sicher stimmlos ist.“"
                                            },
                                            {
                                                "example_id": "b1368be8-528d-45de-974c-65f70840abd3",
                                                "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                                "text": "„Der Schwerpunkt des Inhalts liegt in der Vermehrung des hurrischen Sprachmaterials, […]“"
                                            },
                                            {
                                                "example_id": "5986e2b6-ef2b-43c0-ba54-15389fe4f682",
                                                "sense_id": "4cc0dac1-14a7-3219-bdbe-883b4710cedb",
                                                "text": "„Dagegen scheint luliiasha- ‚Sumpfland, Moor‘, das H. Kronasser […] mit Recht zu luli- ‚Teich‘ stellt, ein ursprünglich hurrisches Suffix zu enthalten, wahrend das Grundwort unbekannter Herkunft ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
