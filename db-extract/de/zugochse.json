                "senses": [
                    {
                        "sense_id": "fe3a6a7d-5620-3bd6-9e8d-165cb736ab38",
                        "entry_id": "59115a98-8c35-3413-9959-04b393e50064",
                        "glosses": [
                            "Ochse, der als Zugtier eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa38309e-5a81-4a1f-83c5-441dbd67e60c",
                                "sense_id": "fe3a6a7d-5620-3bd6-9e8d-165cb736ab38",
                                "text": "„Erst verlieren die Portugiesen ihre Zugochsen, kräftige, gesunde Tiere.“"
                            },
                            {
                                "example_id": "004b1b71-cb78-4b96-a099-8c3fc6282f61",
                                "sense_id": "fe3a6a7d-5620-3bd6-9e8d-165cb736ab38",
                                "text": "„Als sie abends einen geschlachteten Zugochsen brieten, kam einer von Murats Reitern vorbei und behauptete, vom Berge aus seien die Türme Moskaus zu erblicken.“"
                            },
                            {
                                "example_id": "a42b140e-41f2-4a45-aeda-f51cf4347649",
                                "sense_id": "fe3a6a7d-5620-3bd6-9e8d-165cb736ab38",
                                "text": "„Der Zugochse schweigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
