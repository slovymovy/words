                ],
                "senses": [
                    {
                        "sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                        "entry_id": "1d4af4f8-ec8a-3512-b1b7-765af128f799",
                        "glosses": [
                            "kleiner Tisch, der bei Bedarf hinzugestellt werden kann"
                        ],
                        "tags": [
                            "Mobiliar"
                        ],
                        "examples": [
                            {
                                "example_id": "f65d91d0-f492-4f79-9755-0f65007e3c91",
                                "sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                                "text": "„Im Büro von Senator Peter Tschentscher liegen HSH-Akten auf einem Beistelltisch.“"
                            },
                            {
                                "example_id": "59a63657-2ed2-4440-8e72-a4bc03aa1a31",
                                "sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                                "text": "„Auf dem Beistelltisch stehen bereits Kaffeetassen und Kuchenteller bereit, ein Mix aus geblümtem und rein weißem Geschirr.“"
                            },
                            {
                                "example_id": "24364ba9-8bc1-49b8-a7ca-74d5d52f1be6",
                                "sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                                "text": "„Bens Augen folgten mir, als ich zu einem Beistelltisch mit einem alten Grammofon darauf ging.“"
                            },
                            {
                                "example_id": "c903adf6-5ffb-40cf-bff9-4714b92e5e66",
                                "sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                                "text": "„Elma deutete auf ein Bild auf dem Beistelltisch hinter ihnen, das eine schwangere, dunkelhaarige Frau zeigte, deren Hände ihren großen Bauch stützten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae69ab5f-c709-4f6b-890e-2eec1e8e1482",
                        "source_entry_id": "1d4af4f8-ec8a-3512-b1b7-765af128f799",
                        "source_sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                        "source_sense_description": "kleiner Tisch, der hinzugestellt werden kann",
                        "target_lang_word": "end table",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "end table",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2202a9ea-2e34-3f1d-b20b-e1a924a70120",
                                        "entry_id": "c9dad968-96d4-3507-b781-eb98760c7660",
                                        "glosses": [
                                            "A small table placed beside a chair or at each end of a sofa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b73d883-8c52-428b-bb2c-a2893311c947",
                                                "sense_id": "2202a9ea-2e34-3f1d-b20b-e1a924a70120",
                                                "text": "The tiny rooms are fitted with a burgundy leather chair, an end table stacked with phone books, and an ugly orange payphone common here in Australia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fae2db11-690c-400c-8811-adc94d4ff19e",
                        "source_entry_id": "1d4af4f8-ec8a-3512-b1b7-765af128f799",
                        "source_sense_id": "1748beff-5632-3cb2-aef9-660d6d9a7bd8",
                        "source_sense_description": "kleiner Tisch, der hinzugestellt werden kann",
                        "target_lang_word": "side table",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "side table",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                        "entry_id": "a3ddd346-e8c0-3e22-9193-9147630c0433",
                                        "glosses": [
                                            "A small table intended to be placed beside a larger piece of furniture, such as a bed or sofa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf82df7b-df47-4bbd-b32f-6e55f2e0c09b",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "Upon the infinitely wise countrywoman’s suggestion, she goose-penned, from the edge of her bed, on a side table with cabriole legs, a love letter and took five minutes to reread it in a languorous but loud voice […]"
                                            },
                                            {
                                                "example_id": "7548047f-a610-4be9-ad24-6965d8cc8717",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "For his own soiree, Kane went for somewhat more conventional decorations: on a side table, Apothia candles glimmered like fireflies, guarding a taxidermied owl, while masses of delphiniums, hydrangeas, lilacs and old Dutch roses perfumed the air."
                                            },
                                            {
                                                "example_id": "3adec537-a839-4746-9932-56c133c6b58a",
                                                "sense_id": "17edbc79-0b7e-3c33-851d-24f9563ae455",
                                                "text": "Lachlan rose to fetch a coffee pot from the side table and idly Holly wondered how those legs coped with the unroominess of canoes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
