                    {
                        "sense_id": "826b765f-a6a2-3c61-99d7-d91d01464558",
                        "entry_id": "69a1c451-da1d-322c-a5da-af269bbea29e",
                        "glosses": [
                            "durch die Obrigkeit erzwungene Aufgabe von Privateigentum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce8436b1-de49-460e-b8f1-60da7eccd12a",
                                "sense_id": "826b765f-a6a2-3c61-99d7-d91d01464558",
                                "text": "Durch die Enteignung verlor der Bauer sein Land."
                            },
                            {
                                "example_id": "0120fa0c-494b-4d50-b14c-1a51e197cd9b",
                                "sense_id": "826b765f-a6a2-3c61-99d7-d91d01464558",
                                "text": "Hugo Dietrich erarbeitete für die Nationalsozialisten die Verordnung über den Einsatz des jüdischen Vermögens vom 3. Dezember 1938, mit deren Hilfe die Enteignung jüdischen Eigentums im großen Stil legalisiert wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c16797ac-7925-4765-b591-aea4999cb4d4",
                        "source_entry_id": "69a1c451-da1d-322c-a5da-af269bbea29e",
                        "source_sense_id": "826b765f-a6a2-3c61-99d7-d91d01464558",
                        "source_sense_description": "durch die Obrigkeit erzwungene Aufgabe von Privateigentum",
                        "target_lang_word": "expropriation",
