                "senses": [
                    {
                        "sense_id": "e2e96b9d-da97-3309-8a09-c0b836e7d110",
                        "entry_id": "d802e1bc-80b0-3e0a-943c-a63ccd778951",
                        "glosses": [
                            "Teilnehmer im Viertelfinale eines Wettbewerbs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b032409-6269-4d9a-8be9-fd91494cbbf5",
                                "sense_id": "e2e96b9d-da97-3309-8a09-c0b836e7d110",
                                "text": "„Viertelfinalist Tschechien erwies sich erwartungsgemäß als zu stark für das ÖEHV-Team.“"
                            },
                            {
                                "example_id": "de86afdd-bf90-4efe-b047-f3ffe59561be",
                                "sense_id": "e2e96b9d-da97-3309-8a09-c0b836e7d110",
                                "text": "„Annähernd 20 Jahre liegt der grösste WM-Erfolg Dänemarks zurück, doch obwohl der damalige Viertelfinalist nun erstmals seit 2002 in den Achtelfinal einzieht und seit 18 Spielen nicht bezwungen worden ist, kam beim Anhang am Dienstag keine Partystimmung auf.“"
                            },
                            {
                                "example_id": "b4fceec5-595c-4f38-bb5f-62852ace20c8",
                                "sense_id": "e2e96b9d-da97-3309-8a09-c0b836e7d110",
                                "text": "„Viertelfinalist Marco Cecchinato wurde nach Betrugsvorwürfen einst vom Verdacht des Matchfixings freigesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
