                                        "sense_id": "f4cb67a7-636a-3cc7-bcbe-adfb3447da5e",
                                        "entry_id": "87911ec7-f109-3671-aa6e-970ab3712ba1",
                                        "glosses": [
                                            "With one's own body and physical presence; not through media, a representative, or indirectly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b7afc7-1883-45e9-900d-180fe74e0d67",
                                                "sense_id": "f4cb67a7-636a-3cc7-bcbe-adfb3447da5e",
                                                "text": "Have you ever seen a celebrity in person?"
                                            },
                                            {
                                                "example_id": "52a10cf5-e49a-4d80-8ad6-5642ea185579",
                                                "sense_id": "f4cb67a7-636a-3cc7-bcbe-adfb3447da5e",
                                                "text": "He had seen the burger on TV, but in person it looked so much juicier."
                                            },
                                            {
                                                "example_id": "f099f247-9865-484f-a8e4-40eee4deb3b2",
                                                "sense_id": "f4cb67a7-636a-3cc7-bcbe-adfb3447da5e",
                                                "text": "The Celebrity, by arts unknown, induced Mrs. Judge Short and two other ladies to call at Mohair on a certain afternoon when Mr. Cooke was trying a trotter on the track.[…]Their example was followed by others at a time when the master of Mohair was superintending in person the docking of some two-year-olds, and equally invisible."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32a148f5-28de-4f23-866d-4872acf15393",
