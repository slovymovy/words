                "senses": [
                    {
                        "sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                        "entry_id": "a1c191f1-9245-3d2f-b8cb-8dfab42748b8",
                        "glosses": [
                            "Synonym von Genitiv"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95b1551-457a-4128-8516-abd50c96cd29",
                                "sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                                "text": "Der Wesfall des Besitzes drückt aus, wessen Eigentum eine Sache ist."
                            },
                            {
                                "example_id": "2c47275d-cee1-4670-8036-10dbe0e96dba",
                                "sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                                "text": "Nach den Wörtern, die im Satz im Wesfall stehen, kann man mit dem Pronomen \"wessen\" fragen."
                            },
                            {
                                "example_id": "a30c51e2-3999-4b3b-802b-1844fa6bf34f",
                                "sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                                "text": "Das Metzler Lexikon Sprache führt zum Genitiv aus: „In Schulbüchern auch: Anteilgröße, Wesfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "914ad28c-4c1d-4b32-98ee-59465b5a031b",
                        "source_entry_id": "a1c191f1-9245-3d2f-b8cb-8dfab42748b8",
                        "source_sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                        "source_sense_description": "Grammatik: Synonym von Genitiv",
                        "target_lang_word": "genitive case",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "genitive case",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "687234f7-c0ec-337a-a22d-015b545ba353",
                                        "entry_id": "dd6acea5-b18d-3810-bff7-b50c44136cce",
                                        "glosses": [
                                            "The grammatical case, chiefly applicable to nouns, used to express a relationship of origin or possession. It corresponds roughly to the English preposition of and the suffix -'s."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd1bc627-f4b0-40fd-b53d-0dd95021e4f5",
                                                "sense_id": "687234f7-c0ec-337a-a22d-015b545ba353",
                                                "text": "In very early times a man seems to have been known by a single name together with his father's name in the genitive case, e.g. Marcus Marci; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9b438100-abbc-46f6-9da4-cd573230a2a7",
                        "source_entry_id": "a1c191f1-9245-3d2f-b8cb-8dfab42748b8",
                        "source_sense_id": "009e183c-c68d-318d-b88f-4b31f08a65ad",
                        "source_sense_description": "Grammatik: Synonym von Genitiv",
                        "target_lang_word": "génitif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "génitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46e82589-3daa-30c6-a724-36c551eba354",
                                        "entry_id": "ca69f2ca-e2bf-356e-a6a5-3e465db50078",
                                        "glosses": [
                                            "Relatif au génitif, cas de déclinaison."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "génitif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                        "entry_id": "2322af0c-bdf2-3c00-92c5-7963114eca57",
                                        "glosses": [
                                            "Cas grammatical servant principalement à marquer l’appartenance, la dépendance. Correspond souvent en français au complément du nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3f4ebe-9a99-4156-a8b0-cbf034c072f9",
                                                "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                                "text": "Pour cela, on utilise la désinence du génitif singulier : elle permet d’une part de rattacher le nom à l’un des cinq modèles de déclinaison, et d’autre part d’identifier le radical du mot (qui sera ensuite indispensable à la manipulation morphologique)."
                                            },
                                            {
                                                "example_id": "97921224-8c62-4636-a441-35fc249ff177",
                                                "sense_id": "de843d0b-ba56-3a74-9dd1-700e391e575c",
                                                "text": "Il lut triomphalement la phrase : « Par une belle matinée de mai, une svelte amazone montée sur une somptueuse jument alezane parcourait les allées pleines de fleurs du Bois de Boulogne ». Mais lus à haute voix, les trois génitifs qui terminaient la phrase, résonnèrent fâcheusement, et Grand bégaya un peu. Il s’assit, l’air accablé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "11fa7880-46f2-47b3-82e0-6ec4859eddb1",
                        "source_entry_id": "a1c191f1-9245-3d2f-b8cb-8dfab42748b8",
