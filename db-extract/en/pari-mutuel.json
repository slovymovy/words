                "senses": [
                    {
                        "sense_id": "1a6b1220-3b37-3e0e-beef-c762dfe6be48",
                        "entry_id": "a92dc072-b116-3e43-8975-aa9d6fe0da8d",
                        "glosses": [
                            "Any betting system in which all bets of a particular type are placed together in a pool; taxes and a house take are removed, and payoff odds are calculated by sharing the pool among all placed bets."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0127aada-7fb2-43ba-8202-663ad61b0c5a",
                                "sense_id": "1a6b1220-3b37-3e0e-beef-c762dfe6be48",
                                "text": "There is also a pari-mutuel option. You and a friend can wager that you will each lose 15 pounds over the next two months. If you both succeed, the money is returned. But if one fails while the other succeeds, then the loser pays the winner. If you both fail, then the one who loses the most is the winner."
                            }
                        ]
                    },
                    {
                        "sense_id": "17bed418-4d31-3e8a-9642-259e11b8a9b7",
                        "entry_id": "a92dc072-b116-3e43-8975-aa9d6fe0da8d",
                        "glosses": [
                            "A booth used to place such bets, or a machine used to record bets and calculate payoffs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc3d42d1-146e-4953-9f2c-be36e676427b",
                                "sense_id": "17bed418-4d31-3e8a-9642-259e11b8a9b7",
                                "text": "The Italian were full of manners and McAdams talked to Catherine while we went down to bet again. Mr Meyers was standing near the pari-mutuel."
                            }
                        ]
                    }
                ],
