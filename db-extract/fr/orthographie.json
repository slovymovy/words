                "senses": [
                    {
                        "sense_id": "49caecf9-46e1-3799-9cc9-97c4f560f988",
                        "entry_id": "23f3e496-0ae5-34b4-8381-1af803beed80",
                        "glosses": [
                            "Profil ou coupe perpendiculaire d’un bâtiment, élévation géométrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0def0ff3-0289-4e6a-9747-4010df23a6ec",
                                "sense_id": "49caecf9-46e1-3799-9cc9-97c4f560f988",
                                "text": "L’orthographie de ce bâtiment est fort régulière et fort fidèle."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2a7fa8e-1762-39e2-a984-fc3dc606f41a",
                        "entry_id": "23f3e496-0ae5-34b4-8381-1af803beed80",
                        "glosses": [
                            "Variante de orthographe."
                        ],
                        "tags": [
                            "alt-of",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "91aae3a2-c7ed-4203-be9c-e65a1c3db36f",
                                "sense_id": "f2a7fa8e-1762-39e2-a984-fc3dc606f41a",
                                "text": "Histoire de l’orthographie française"
                            },
                            {
                                "example_id": "d0c2069d-b4ee-4d31-b72d-bcb69ba619e5",
                                "sense_id": "f2a7fa8e-1762-39e2-a984-fc3dc606f41a",
                                "text": "Mme Cuerrier souligne que l’enseignement des deux techniques d’écriture, comme c’est le cas encore au Québec, crée une « surchage » chez l’élève, qui sera alors plus lent à maîtriser la graphomotricité et l’orthographie."
                            }
                        ]
                    }
                ],
