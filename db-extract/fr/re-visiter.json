                ],
                "senses": [
                    {
                        "sense_id": "b8822340-3b1a-3ab2-980c-1f1535449cb6",
                        "entry_id": "5b979958-81a9-367b-8ab6-1675d65b251d",
                        "glosses": [
                            "Variante orthographique de revisiter (visiter à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3eb27555-c3e1-4e2b-b5c7-bf0ad6fb38aa",
                                "sense_id": "b8822340-3b1a-3ab2-980c-1f1535449cb6",
                                "text": "Auteur-compositeur cherche nouvelles voix féminines pour reprendre des chansons inédites à re-maquetter et re-visiter!"
                            },
                            {
                                "example_id": "7ee3b22f-96fa-474a-8627-047b6606f34a",
                                "sense_id": "b8822340-3b1a-3ab2-980c-1f1535449cb6",
                                "text": "Faire progresser la pensée [écrit Eco] ne signifie pas seulement refuser le passé : c’est parfois le re-visiter pour comprendre non seulement ce qui a été effectivement dit, mais aussi ce qui aurait pu être dit, ou du moins ce que l’on peut dire aujourd'hui (et peut-être aujourd’hui seulement) à partir de ce qui a été dit auparavant » (Eco, 1988, p. 13)."
                            },
                            {
                                "example_id": "bb8f0351-2970-4036-8bc6-8088f48b5ef6",
                                "sense_id": "b8822340-3b1a-3ab2-980c-1f1535449cb6",
                                "text": "L’auteur re-visite avec humour les couvertures de nos grands-mères en surfant sur la tendance du nostalgique-design."
                            }
                        ]
                    }
