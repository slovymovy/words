                "senses": [
                    {
                        "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                        "entry_id": "006f3b30-8557-3c98-b220-ab27e8b8f8ce",
                        "glosses": [
                            "aus China stammendes geometrisches Figurenspiel, das unterhalten und auf kreative Weise mathematische Vorstellungen fördern soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "102353f9-4ffa-459a-96a2-e6858b6f42f5",
                                "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                                "text": "„Wir zitieren aus einer früheren deutschen Ausgabe des Tangramspiels durch den Mathematikprofessor C. L. A. Kunze, um die damalige Wertschätzung für das Spiel zu verdeutlichen, […].“"
                            },
                            {
                                "example_id": "fc20d9ce-3585-4302-9668-1d79d35bd227",
                                "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                                "text": "„Unter dem Inhaltsbereich Muster und Relationen werden schließlich Fähigkeiten und Fertigkeiten verstanden, die das Erkennen sowie das Fortsetzen von Mustern, Strukturen und Relationen betreffen, z.B. Bausteine mit Mustern analysieren, Muster mit dem Tangramspiel legen, Bandornamente fortsetzen etc.“"
                            },
                            {
                                "example_id": "5442b46f-754b-4f96-9015-b3674af51b64",
                                "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                                "text": "„Interessant sind ferner eine Reihe von mathematischen Fragestellungen an das Tangramspiel.“"
                            },
                            {
                                "example_id": "3066fb16-d8b1-430e-bb24-c0e9cd72d51a",
                                "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                                "text": "„Das Tangramspiel ist ein altes chinesisches Legespiel.“"
                            },
                            {
                                "example_id": "b72a3211-d965-4b59-af50-93232fb267f2",
                                "sense_id": "2bbc8d45-e225-3494-90cc-08b43c3a365d",
                                "text": "„Man erzeugt weitere Tangramspiele, indem man einfache geometrische Figuren wie Quadrat, Rechteck oder Kreis aufteilt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
