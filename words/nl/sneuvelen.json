            "senses": [
                {
                    "sense_id": "d509b332-93f9-3067-a9f8-67585e64cadd",
                    "sense_definition": "omkomen in een gewapende strijd of oorlog",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "oorlog_dood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens die bloedige veldslag <w>sneuvelden</w> er duizenden jonge soldaten.",
                            "target_lang_translations": {
                                "fr": "Au cours de cette sanglante bataille, des milliers de jeunes soldats ont <w>péri</w>."
                            }
                        },
                        {
                            "text": "Zijn overgrootvader is in de Eerste Wereldoorlog aan het front <w>gesneuveld</w>.",
                            "target_lang_translations": {
                                "fr": "Son arrière-grand-père est <w>tombé</w> au front pendant la Première Guerre mondiale."
                            }
                        }
                    ],
                    "synonyms": [
                        "vallen"
                    ],
                    "common_phrases": [
                        "gesneuveld in de strijd",
                        "aan het front sneuvelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "mourir au combat ou pendant une guerre"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tomber",
                                "target_lang_sense_clarification": "au combat ou à la guerre"
                            },
                            {
                                "target_lang_word": "périr",
                                "target_lang_sense_clarification": "dans une bataille"
                            },
                            {
                                "target_lang_word": "mourir au combat",
                                "target_lang_sense_clarification": "être tué à la guerre"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43055f58-c084-3967-a1f2-eb0149a0c0af",
                    "sense_definition": "kapotgaan of breken van voorwerpen, zoals glas of servies",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kapotgaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de zware storm <w>sneuvelden</w> tientallen ruiten in het oude centrum.",
                            "target_lang_translations": {
                                "fr": "Pendant la violente tempête, des dizaines de vitres se sont <w>brisées</w> dans le centre historique."
                            }
                        },
                        {
                            "text": "Er is een mooi wijnglas <w>gesneuveld</w> toen hij de tafel afruimde.",
                            "target_lang_translations": {
                                "fr": "Un beau verre à vin a <w>cassé</w> quand il a débarrassé la table."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ruiten sneuvelen"
                    ],
                    "target_lang_definitions": {
                        "fr": "se briser, casser ou être détruit en parlant d'objets (verre, vaisselle, vitres)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se briser",
                                "target_lang_sense_clarification": "pour du verre ou de la vaisselle"
                            },
                            {
                                "target_lang_word": "casser",
                                "target_lang_sense_clarification": "se rompre, s'abîmer"
                            },
                            {
                                "target_lang_word": "voler en éclats",
                                "target_lang_sense_clarification": "se briser violemment"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fedc0b63-30db-3aaa-915c-089612a1d137",
                    "sense_definition": "verdwijnen, ten onder gaan of niet overeind blijven, bijvoorbeeld van plannen, regels of kandidaten",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kapotgaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het ambitieuze wetsvoorstel zal naar verwachting tijdens het debat in het parlement <w>sneuvelen</w>.",
                            "target_lang_translations": {
                                "fr": "Le projet de loi ambitieux devrait selon toute attente <w>être rejeté</w> lors du débat au parlement."
                            }
                        },
                        {
                            "text": "De favoriete tennisser <w>sneuvelde</w> al onverwacht in de eerste ronde van het toernooi.",
                            "target_lang_translations": {
                                "fr": "Le joueur de tennis favori a été <w>éliminé</w> de façon inattendue dès le premier tour du tournoi."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitgeschakeld worden"
                    ],
                    "common_phrases": [
                        "in de eerste ronde sneuvelen",
                        "een voorstel sneuvelt"
                    ],
                    "target_lang_definitions": {
                        "fr": "échouer, disparaître, être rejeté ou éliminé (projets, lois, candidats)"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "être rejeté",
                                "target_lang_sense_clarification": "pour une loi ou une proposition"
                            },
                            {
                                "target_lang_word": "être éliminé",
                                "target_lang_sense_clarification": "pour un candidat ou un sportif"
                            },
                            {
                                "target_lang_word": "tomber à l'eau",
                                "target_lang_sense_clarification": "pour un plan ou projet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}