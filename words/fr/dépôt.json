                    ]
                },
                {
                    "sense_id": "b85fb2da-bfcb-31a5-b308-5336c14265d7",
                    "sense_definition": "Emplacement de stockage centralisé d'un ensemble de fichiers ou de code source en informatique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le développeur a cloné le <w>dépôt</w> distant pour travailler sur son ordinateur."
                        },
                        {
                            "text": "Toutes les modifications sont envoyées directement vers le <w>dépôt</w> principal."
