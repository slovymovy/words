{
    "word_family": [
        "bounce",
        "bouncy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87517783-a9a1-32b8-888e-a766dd0250b2",
                    "sense_definition": "A member of security personnel employed by bars or nightclubs to maintain order and control entry.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bouncer</w> refused to let the group enter because they were not dressed appropriately.",
                            "target_lang_translations": {
                                "ru": "<w>Вышиба́ла</w> отказался впустить группу, потому что они были одеты неподобающим образом."
                            }
                        },
                        {
                            "text": "When the fight started inside the club, the <w>bouncer</w> quickly removed the troublemakers.",
                            "target_lang_translations": {
                                "ru": "Когда в клубе началась драка, <w>вышиба́ла</w> быстро вывел зачинщиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "doorman",
                        "chucker-out"
                    ],
                    "common_phrases": [
                        "club bouncer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сотрудник службы безопасности в барах или ночных клубах, следящий за порядком и контролирующий вход."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышиба́ла",
                                "target_lang_sense_clarification": "разговорное обозначение охранника в увеселительном заведении"
                            },
                            {
                                "target_lang_word": "охранник",
                                "target_lang_sense_clarification": "более формальный термин для сотрудника охраны"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d37a08d0-3cc5-3ddd-a2c1-50612648df5c",
                    "sense_definition": "A seat for a baby that allows them to bounce up and down.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "baby_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby fell asleep while sitting in her <w>bouncer</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок уснул, сидя в своем <w>шезлонге</w>."
                            }
                        },
                        {
                            "text": "We placed the infant in the <w>bouncer</w> so he could watch us cook dinner.",
                            "target_lang_translations": {
                                "ru": "Мы посадили младенца в <w>шезлонг</w>, чтобы он мог наблюдать, как мы готовим ужин."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Детское кресло-качалка, которое позволяет ребенку пружинить вверх-вниз."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шезлонг",
                                "target_lang_sense_clarification": "детское кресло для отдыха и укачивания"
                            },
                            {
                                "target_lang_word": "кресло-качалка",
                                "target_lang_sense_clarification": "устройство для укачивания младенца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3af3a98-7c4a-3126-a74b-c07cc2cf416d",
                    "sense_definition": "A cricket ball that is pitched short so that it bounces high towards the batsman's head.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fast bowler surprised the batsman with a dangerous <w>bouncer</w>.",
                            "target_lang_translations": {
                                "ru": "Боулер удивил бьющего опасным <w>баунсером</w>."
                            }
                        },
                        {
                            "text": "He ducked under the <w>bouncer</w> to avoid being hit by the ball.",
                            "target_lang_translations": {
                                "ru": "Он пригнулся, чтобы избежать удара мячом после <w>баунсера</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bumper"
                    ],
                    "target_lang_definitions": {
                        "ru": "В крикете: мяч, который отскакивает от земли высоко к голове бьющего игрока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баунсер",
                                "target_lang_sense_clarification": "специальный термин в крикете для высокого отскока мяча"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be76da52-949c-3f2b-827b-fc0f6ace3999",
                    "sense_definition": "A bold or blatant lie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His excuse for being late was such a <w>bouncer</w> that nobody believed him.",
                            "target_lang_translations": {
                                "ru": "Его оправдание опоздания было такой <w>наглой ложью</w>, что никто ему не поверил."
                            }
                        },
                        {
                            "text": "She told a complete <w>bouncer</w> about her past to impress her new friends.",
                            "target_lang_translations": {
                                "ru": "Она рассказала полную <w>небылицу</w> о своем прошлом, чтобы произвести впечатление на новых друзей."
                            }
                        }
                    ],
                    "synonyms": [
                        "whopper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This term is rarely used in modern English to mean a lie."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наглая, очевидная ложь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наглая ложь",
                                "target_lang_sense_clarification": "выражение для обозначения явной неправды"
                            },
                            {
                                "target_lang_word": "небылица",
                                "target_lang_sense_clarification": "выдумка, неправдоподобная история"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}