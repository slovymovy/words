                                "target_senses": [
                                    {
                                        "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                        "entry_id": "f25f8f5f-d018-3fec-8146-c4b25d932af1",
                                        "glosses": [
                                            "Diskriminierung aufgrund des Geschlechts oder der sexuellen Neigung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a476db9-0bc4-4808-9e5d-4d27a64bfec3",
                                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                                "text": "Kritiker bezeichnen das Buch als puren Sexismus."
                                            },
                                            {
                                                "example_id": "59c04534-a9bf-47ea-9ca6-a62fc2b753db",
                                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                                "text": "„Mundarten haben auch keine Angst vor dem Vorwurf des Sexismus.“"
                                            },
                                            {
                                                "example_id": "27f68ef3-1522-43fe-abb2-be2221cde33c",
                                                "sense_id": "b4e43590-0914-3f15-9225-e02249a094d2",
                                                "text": "„Aber es war nicht nur der offensichtliche Sexismus, der mich in dieser Situation störte, sondern auch die schiere Dummheit, das Fehlen jeglicher Logik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94d50448-e2e5-4f6a-a52f-849221e9aaef",
                        "source_entry_id": "48a6c5c5-0077-3922-bf91-0ec48e5b0b92",
                        "target_lang_word": "sexism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
