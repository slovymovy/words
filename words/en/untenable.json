            "senses": [
                {
                    "sense_id": "fe49a85a-e3eb-3eae-a99f-5be7d80cb684",
                    "sense_definition": "Not able to be maintained, defended, or supported, especially regarding an argument, theory, or position.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sustain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist realized that his theory was <w>untenable</w> after the new data was published."
                        },
                        {
                            "text": "The manager found himself in an <w>untenable</w> position after the company lost all its funding."
                        }
                    ],
                    "synonyms": [
                        "indefensible",
                        "unsustainable"
                    ],
                    "antonyms": [
