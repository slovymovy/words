                "senses": [
                    {
                        "sense_id": "dce7f9b1-2bd1-38e2-8b77-bb56b385b816",
                        "entry_id": "72d8eece-1eba-343d-886c-fad40ccb2f5a",
                        "glosses": [
                            "Considérer d’un point de vue excessivement culturel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a1834b-5d04-4dd0-bdc0-8db955043c33",
                                "sense_id": "dce7f9b1-2bd1-38e2-8b77-bb56b385b816",
                                "text": "Le diagnostic doit éviter aussi bien de «surculturaliser» le problème que de le «surpathologiser»."
                            },
                            {
                                "example_id": "2d3fb078-3280-410e-9e42-86731099c01e",
                                "sense_id": "dce7f9b1-2bd1-38e2-8b77-bb56b385b816",
                                "text": "En pensant un double sida, du Nord et du Sud, le danger est présent de « surculturaliser » la maladie."
                            },
                            {
                                "example_id": "591a01dc-3650-487c-8182-c23c642971f5",
                                "sense_id": "dce7f9b1-2bd1-38e2-8b77-bb56b385b816",
                                "text": "Deux dangers à éviter : refouler et ignorer les cultures et surculturaliser les problèmes."
                            }
                        ]
                    }
