                "senses": [
                    {
                        "sense_id": "09c149b7-5be7-31b9-be5e-fa7ae40259f9",
                        "entry_id": "004ce060-9fe4-3a43-925d-828edd5fd636",
                        "glosses": [
                            "rechtsradikale Gesinnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "426db6cb-363e-48c9-8bc2-166bb8478558",
                                "sense_id": "09c149b7-5be7-31b9-be5e-fa7ae40259f9",
                                "text": "„Vier Münchner Bürger mobilisierten damals 400000 Menschen und gingen am 6. Dezember 1992 gegen Fremdenfeindlichkeit und Rechtsradikalismus auf die Straße.“"
                            },
                            {
                                "example_id": "0152c71e-34e5-4ad3-8cd9-573d172b5ecc",
                                "sense_id": "09c149b7-5be7-31b9-be5e-fa7ae40259f9",
                                "text": "„Wenn das linke, grüne und teilweise liberale Lager der deutschen Gesellschaft wirklich etwas gegen Rechtsradikalismus tun wollte, müsste es aufhören, jeden sofort in die rechte Ecke zu stellen, der einen handelsüblichen konservativen Gedanken äussert.“"
                            },
                            {
                                "example_id": "dfe26f20-a59a-4e54-bb56-d7586dc00b7e",
                                "sense_id": "09c149b7-5be7-31b9-be5e-fa7ae40259f9",
                                "text": "„Der neue polnische Rechtsradikalismus kommt lässig daher, ohne Nationalhymne, rot-weiße Flaggen und Uniformen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
