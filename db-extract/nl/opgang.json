        "nl-extract.jsonl": [
            {
                "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                "word": "opgang",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "fbcaa144-47cf-4ae4-a639-a19c71d3f169",
                        "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "opgangen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4818acfa-a8b6-3f4e-a82c-ef2c48cc2db3",
                        "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "glosses": [
                            "een weg, pad of trap die naar boven gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dfd039b-659a-44f1-8c8a-14f7723cca14",
                                "sense_id": "4818acfa-a8b6-3f4e-a82c-ef2c48cc2db3",
                                "text": "Op zich had ik niets te klagen. Ik had een onderkomen met een eigen opgang en op zolder installeerde ik een surround system om films te kunnen kijken. Zo’n vrijgezellenhol."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f141f71-0166-333b-8db8-ceabcb6d02a9",
                        "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "glosses": [
                            "populair worden"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3e265ae8-b95d-4460-b579-dacdcb3fa56e",
                                "sense_id": "3f141f71-0166-333b-8db8-ceabcb6d02a9",
                                "text": "De printtechniek is na een stormachtige start geen modegril gebleken. De omzet uit de printers die objecten in laagjes opbouwen neemt ook dit jaar met 20% toe, vergeleken op jaarbasis, aldus ABN Amro en Berenschot. In bijvoorbeeld tandheelkunde maakt 3D snel opgang."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f6b7e31-c6c6-338d-bffd-9004310dc443",
                        "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "glosses": [
                            "het naar boven gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cd48284-bb36-4d84-866c-ee0862c9eb7f",
                                "sense_id": "3f6b7e31-c6c6-338d-bffd-9004310dc443",
                                "text": "De prijs van koper, veel gebruikt in woninbouw en industrie, hervat zijn stormachtige opgang. Vooral de Chinese economische groei dit najaar stimuleert de prijs."
                            },
                            {
                                "example_id": "dd27ac59-f5ca-4880-bb77-7b6140734fb2",
                                "sense_id": "3f6b7e31-c6c6-338d-bffd-9004310dc443",
                                "text": "De productie blijkt een goudmijntje voor genoteerde producenten van zulke graphics processing units zoals NVIDIA en AMD. Hun koers schoot sinds mei weer omhoog, na een forse opgang sinds 2015."
                            },
                            {
                                "example_id": "2b34be47-d7d3-4256-b9c8-2351ca968e83",
                                "sense_id": "3f6b7e31-c6c6-338d-bffd-9004310dc443",
                                "text": "De grote hoeveelheden olie die door speculanten worden ge- en verkocht zullen tussentijds voor ,,forse prijsstijgingen\"zorgen, stelt Van Cleef. Momenteel daalt de olieprijs weer, na een korte opgang. De markt is volgens de bank toch ,,te negatief\"over de toekomst van de meest verhandelde grondstof."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc28b6e8-89ce-3f4f-a722-eae4596f61ce",
                        "entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "glosses": [
                            "het beginnen van iets"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "266d1e85-dcc6-4f24-adb1-2a72f409c211",
                                "sense_id": "cc28b6e8-89ce-3f4f-a722-eae4596f61ce",
                                "text": "In de vroege zondagmorgen, in het Duitse Viersen, kwam de halve finale maar moeizaam opgang."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0512646b-e83e-415b-8422-be3f143b1272",
                        "source_entry_id": "4f2bf129-0158-33ec-a11f-a2598b66f0e0",
                        "source_sense_id": "4818acfa-a8b6-3f4e-a82c-ef2c48cc2db3",
