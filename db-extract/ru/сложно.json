                        "target_lang_word": "difficult",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "difficult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ffe76751-830c-324f-8134-f1612f8411a1",
                                        "entry_id": "72023c85-8b9d-3ced-8981-75afa14b8a37",
                                        "glosses": [
                                            "Hard, not easy, requiring much effort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5c63e82-7f91-4057-9694-473b6d90609e",
                                                "sense_id": "ffe76751-830c-324f-8134-f1612f8411a1",
                                                "text": "However, the difficult weather conditions will ensure Yunnan has plenty of freshwater."
                                            },
                                            {
                                                "example_id": "2aebe88f-3a03-4045-bece-20c26cc7b498",
                                                "sense_id": "ffe76751-830c-324f-8134-f1612f8411a1",
                                                "text": "There is not the strength or courage left me to venture into the wide, strange, difficult world, alone."
                                            },
                                            {
                                                "example_id": "a876900b-81e2-4ce1-8151-528125891cbd",
                                                "sense_id": "ffe76751-830c-324f-8134-f1612f8411a1",
                                                "text": "In adults, the same kind of anger has been studied in people trying to solve a very difficult math problem. Though the tough math problem is very frustrating, there is an active attempt to solve the problem and meet the goal."
                                            },
                                            {
                                                "example_id": "20e647c6-dcef-4d9e-a8d1-ff7df4ecbcd2",
                                                "sense_id": "ffe76751-830c-324f-8134-f1612f8411a1",
                                                "text": "Economics is a messy discipline: too fluid to be a science, too rigorous to be an art. Perhaps it is fitting that economists’ most-used metric, gross domestic product (GDP), is a tangle too.[…]But as a foundation for analysis it is highly subjective: it rests on difficult decisions about what counts as a territory, what counts as output and how to value it. Indeed, economists are still tweaking it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "541b6924-2c6a-3200-b847-397a637db267",
                                        "entry_id": "72023c85-8b9d-3ced-8981-75afa14b8a37",
                                        "glosses": [
                                            "Hard to manage, uncooperative, troublesome."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71500464-2471-4a74-965a-a0cdd5546fe3",
                                                "sense_id": "541b6924-2c6a-3200-b847-397a637db267",
                                                "text": "Stop being difficult and eat your broccoli—you know it's good for you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db52a001-5716-3334-b88e-fe1791c2c553",
                                        "entry_id": "72023c85-8b9d-3ced-8981-75afa14b8a37",
                                        "glosses": [
                                            "Unable or unwilling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db9311a6-7d19-4fa3-b0a6-f44752d95149",
                                                "sense_id": "db52a001-5716-3334-b88e-fe1791c2c553",
                                                "text": "“I hope, madam,” said Jones, “my charming Lady Bellaston will be as difficult to believe anything against one who is so sensible of the many obligations she hath conferred upon him.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "difficult",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23de777b-01cc-36fb-ac7d-c692e8a65c25",
                                        "entry_id": "89bfa448-8226-36cb-892d-22238d5ec233",
                                        "glosses": [
                                            "To make difficult; to impede; to perplex."
                                        ],
                                        "tags": [
