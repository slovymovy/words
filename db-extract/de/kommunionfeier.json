                    {
                        "sense_id": "8af425cb-a4ea-3c0e-87d6-900bd233034a",
                        "entry_id": "63a33108-6c84-303e-a401-bf540e254fbf",
                        "glosses": [
                            "Gottesdienst, bei dem den Kommunionkindern die erste heilige Kommunion ausgeteilt wird"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "2ab4920d-f814-4b30-8677-273b10181b92",
                                "sense_id": "8af425cb-a4ea-3c0e-87d6-900bd233034a",
                                "text": "„‚Mit den Emmaus-Jüngern unterwegs‘ hieß das Motto der diesjährigen Kommunionfeier der Pfarrei Kemnath a.B.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9779a36c-0dde-33e5-b713-08c3dee84cc5",
                        "entry_id": "63a33108-6c84-303e-a401-bf540e254fbf",
                        "glosses": [
                            "Gottesdienst ohne Eucharistiefeier, bei dem den Gläubigen die heilige Kommunion ausgeteilt wird"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "02aa185f-16e6-3d83-9dc5-f6894c3d451f",
                        "entry_id": "63a33108-6c84-303e-a401-bf540e254fbf",
                        "glosses": [
                            "Feier im Kreis von Familie und Bekannten aus Anlass von [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea4c49d-9001-4f07-b2d2-161862525deb",
                                "sense_id": "02aa185f-16e6-3d83-9dc5-f6894c3d451f",
                                "text": "„Der stolze Johann Eckert hatte zu der Kommunionfeier über vierzig Gäste eingeladen, die ganze Familie, seine Mitarbeiter und Geschäftsfreunde.“"
                            },
                            {
                                "example_id": "c267f6e6-4811-4880-85ce-a77d1eaff048",
                                "sense_id": "02aa185f-16e6-3d83-9dc5-f6894c3d451f",
                                "text": "„Der größte Vorteil einer Kommunionfeier im Restaurant ist, dass Sie sich wenig Sorgen um ein stilvolles Ambiente und die aufwendigen Vorbereitungen machen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
