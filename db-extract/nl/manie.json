                "senses": [
                    {
                        "sense_id": "f3172a1f-610a-3d25-a546-3cfed66ec6f5",
                        "entry_id": "f8a9abf7-3098-3a3a-b90e-0f12b9246fc2",
                        "glosses": [
                            "Manie, eine affektive Störung, die mit einer gehobenen Affektivität (Stimmung), Enthemmung, Ideenflucht und Selbstüberschätzung einhergeht."
                        ],
                        "tags": [
                            "Psychiatrie"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5899b576-530e-3163-b16c-488b5503fefa",
                        "entry_id": "f8a9abf7-3098-3a3a-b90e-0f12b9246fc2",
                        "glosses": [
                            "von etwas so begeistert sein, dass man der Tätigkeit unaufhörlich mit großer Leidenschaft nachgeht"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e425be9a-4b51-4edd-a04c-cadaca1b5e54",
                        "source_entry_id": "f8a9abf7-3098-3a3a-b90e-0f12b9246fc2",
                        "source_sense_id": "f3172a1f-610a-3d25-a546-3cfed66ec6f5",
                        "target_lang_word": "Manie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Manie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "357cb3db-c541-3019-b9e1-43a28aaefa88",
                                        "entry_id": "3fd6d27a-b2aa-3c72-8287-573a76bb850e",
                                        "glosses": [
                                            "eine affektive Störung, die mit einer gehobenen Affektivität (Stimmung), Enthemmung, Ideenflucht und Selbstüberschätzung einhergeht"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69e295cc-d25c-486a-a911-da33ae220c55",
                                                "sense_id": "357cb3db-c541-3019-b9e1-43a28aaefa88",
                                                "text": "„Ein Rausch der Gefühle, unglaubliche Energie, die Welt verbessern, jetzt und hier. Und alle sollen helfen. Es ist der Enthusiasmus einer Manie, die eine Seite der Bipolaren Störung. Denn an anderen Tagen sind die vielen Ideen, die sexuelle Energie oder der Kaufrausch plötzlich verflogen.“"
                                            },
                                            {
                                                "example_id": "71e7afa4-5db4-4242-838b-c888bfbee50b",
                                                "sense_id": "357cb3db-c541-3019-b9e1-43a28aaefa88",
                                                "text": "„Bei der manischen Episode werden drei Formen unterschieden: Hypomanie, Manie ohne psychotische Symptome und Manie mit psychotischen Symptomen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "faeeb012-94d8-3715-82ef-eda234428b3e",
                                        "entry_id": "3fd6d27a-b2aa-3c72-8287-573a76bb850e",
                                        "glosses": [
                                            "Verhaltensweise: ein zwanghaftes Verhalten, eine krankhaft übersteigerte Neigung etwas Bestimmtes tun zu müssen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f590d9-608f-405a-a34b-09787beab85d",
                                                "sense_id": "faeeb012-94d8-3715-82ef-eda234428b3e",
                                                "text": "„[…] um 1730 eine Art Wiederentdeckung der van Dyckschen Mode in Gesellschaft und Porträt, die sich nach 1770 zu einer wahren Manie auswuchs, vor allem gefördert durch die gesellschaftliche Maskeradensucht.“"
                                            },
                                            {
                                                "example_id": "8e047ffe-ea30-4a06-aed5-510af910f747",
                                                "sense_id": "faeeb012-94d8-3715-82ef-eda234428b3e",
                                                "text": "„Sie beschrieb das Weihnachtsgeschäft des Jahres 1949: Vor Weihnachten hörte ich so viele Klagen über Geldmangel, dass es mir schon eine Manie zu sein schien.“"
                                            },
                                            {
                                                "example_id": "88d041fd-1a85-4abe-b804-4e8792ac23cc",
                                                "sense_id": "faeeb012-94d8-3715-82ef-eda234428b3e",
                                                "text": "„Katholischwerden war im ersten Jahrzehnt des neuen Jahrhunderts eine Mode, beinahe eine Manie. Es gab mancherlei, auch weltliche Gründe dafür, so die wachsende Bedeutung Wiens als Gegenhauptstadt zum Paris Napoleons.“"
                                            },
                                            {
                                                "example_id": "0135ac3c-cf3b-46bd-b3e6-71724df5125b",
                                                "sense_id": "faeeb012-94d8-3715-82ef-eda234428b3e",
                                                "text": "„Seine Manie ist das eigenhändige Klystieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
