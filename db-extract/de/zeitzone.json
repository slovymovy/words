                    {
                        "form_id": "0c1ecb6e-ad32-4f82-aa6d-a19249a301e2",
                        "entry_id": "9ab2526e-fda4-3718-8180-627edb008f35",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Zeitzonen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
                        "entry_id": "9ab2526e-fda4-3718-8180-627edb008f35",
                        "glosses": [
                            "Teil der Erdoberfläche, auf dem zu einem gegebenen Zeitpunkt dieselbe Uhrzeit und dasselbe Datum gelten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a28199f-33a6-4557-a3a4-a26f4c4d9c53",
                                "sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
                                "text": "London liegt in einer anderen Zeitzone als Berlin."
                            },
                            {
                                "example_id": "88cf699d-ae78-46c0-a586-3e22bd7d9188",
                                "sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
                                "text": "„Antwerpen kam ihr vor wie eine andere Stadt, wie eine andere Zeitzone.“"
                            },
                            {
                                "example_id": "64758057-986a-4767-b066-30112e9a0967",
                                "sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
                                "text": "„Die Zeitzonen leuchteten im Licht greller Explosionen, von denen keine das Werk Bin Ladens war.“"
                            },
                            {
                                "example_id": "6d6fa243-ce70-43ef-8453-354f57e9253f",
                                "sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
                                "text": "„Durch den Eisenbahnverkehr wurde ganz Deutschland schließlich eine einheitliche Zeitzone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ecec1bdc-803f-4369-a430-59bfe2320e9a",
                        "source_entry_id": "9ab2526e-fda4-3718-8180-627edb008f35",
                        "source_sense_id": "abdb0274-670d-30c5-aca2-e964fbc24773",
