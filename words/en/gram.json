                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We visited the historic castle located in the town of <w>Gram</w>.",
                            "target_lang_translations": {
                                "ru": "Мы посетили исторический замок, расположенный в городе <w>Грам</w>."
