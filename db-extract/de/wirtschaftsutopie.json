                "senses": [
                    {
                        "sense_id": "35ad1920-9a89-3a7e-b2ba-a55e277e4703",
                        "entry_id": "91016d28-17ee-3a02-a262-b736efb7fbfe",
                        "glosses": [
                            "utopische Vorstellung eines idealen wirtschaftlichen Systems"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d554970a-3656-4e15-9306-473fdbd150ed",
                                "sense_id": "35ad1920-9a89-3a7e-b2ba-a55e277e4703",
                                "text": "„Im ganzen strebt die Wirtschaftsutopie klar der Planwirtschaft und darüber hinaus der Auflösung der Wirtschaft zu.“"
                            },
                            {
                                "example_id": "6b4ccc27-d42d-4a64-b987-86e106d3d475",
                                "sense_id": "35ad1920-9a89-3a7e-b2ba-a55e277e4703",
                                "text": "„Aus dem Wunsch nach mehr sozialer Gerechtigkeit – was immer darunter im Einzelnen zu verstehen ist – wird eine abstruse Wirtschaftsutopie, die auf zentrale Lenkung und Kontrolle statt auf die bewährte Freiheit des Individuums setzt.“"
                            },
                            {
                                "example_id": "9741a6a1-a3da-4baa-a35f-60677450b931",
                                "sense_id": "35ad1920-9a89-3a7e-b2ba-a55e277e4703",
                                "text": "„In den konservativen Kreisen wurde sein Werk harsch abgelehnt, und zwar nicht nur wegen der Wirtschaftsutopie.“"
                            },
                            {
                                "example_id": "031703a7-88e6-47db-b24a-00f5d2e2d8be",
                                "sense_id": "35ad1920-9a89-3a7e-b2ba-a55e277e4703",
                                "text": "„Eine Wirtschaftsutopie ist ein Wirtschaftssystem, das unvereinbare Komponenten hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
