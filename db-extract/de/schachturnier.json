                "senses": [
                    {
                        "sense_id": "010b2409-6f4f-3858-88d6-f7a5c58942a6",
                        "entry_id": "f21f1512-b8d5-3e74-a4b6-8e9560d315af",
                        "glosses": [
                            "Wettbewerb von mehreren Schachspielern; Turnier im Schachsport"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "412974d3-841b-4513-8376-7c948f945fab",
                                "sense_id": "010b2409-6f4f-3858-88d6-f7a5c58942a6",
                                "text": "Das Schachturnier hat unsere Mannschaft doch noch überfordert."
                            },
                            {
                                "example_id": "2dbb5da6-ef70-40fa-b8c9-bfb588669e43",
                                "sense_id": "010b2409-6f4f-3858-88d6-f7a5c58942a6",
                                "text": "„Anlass für hitzige Debatten über das bereits im Dezember ausgesprochene Schach-Verbot ist das am Freitag in Mekka stattfindende Schachturnier.“"
                            },
                            {
                                "example_id": "d59c53a7-66d2-4518-8b83-a98f3826be05",
                                "sense_id": "010b2409-6f4f-3858-88d6-f7a5c58942a6",
                                "text": "„Trotz der Ukrainekrise empfangen mehrere National- und Ständeräte sechs russische Parlamentarier zum Schachturnier, darunter Ex-Weltmeister Karpow.“"
                            },
                            {
                                "example_id": "23a88eaa-c7d6-474a-9fa0-52094fa33acd",
                                "sense_id": "010b2409-6f4f-3858-88d6-f7a5c58942a6",
                                "text": "„Das würden die Russen seit Jahren machen, daher schnitten sie bei allen Schachturnieren auf der Welt so gut ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
