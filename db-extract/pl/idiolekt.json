                                "target_senses": [
                                    {
                                        "sense_id": "477ac9a3-d0ec-3a80-a91f-8c90070c6a2c",
                                        "entry_id": "63e508d3-b1f4-381d-a9db-6d48d35bcbd6",
                                        "glosses": [
                                            "jazykový styl typický pro konkrétního člověka"
                                        ],
                                        "tags": [],
