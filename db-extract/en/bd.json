                            {
                                "example_id": "84efb35f-96c0-4855-a083-1dd2e491153e",
                                "sense_id": "3a65f0a0-9795-3f6b-9d55-ea66d83436d2",
                                "text": "We haven't BD since day 21 (we had already BD 11 times in past 2 weeks)."
                            },
                            {
