                                                "sense_id": "b1ab1680-c759-3e78-b72d-035fc7c67d9f",
                                                "text": "Near-synonyms: conceptual, fancied, ideal, notional"
                                            },
                                            {
                                                "example_id": "a4d9d3e8-1e79-4ee3-906b-46b4852f7de9",
                                                "sense_id": "b1ab1680-c759-3e78-b72d-035fc7c67d9f",
