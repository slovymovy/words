                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>roven</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>roof</w> nooit iets van anderen omdat ik eerlijk wil leven.",
                            "target_lang_translations": {
                                "en": "I never <w>rob</w> anything from others because I want to live honestly.",
                                "ru": "Я никогда ничего не <w>граблю</w> у других, потому что хочу жить честно."
                            }
                        },
                        {
                            "text": "Als ik in dit spel goud <w>roof</w>, krijg ik extra punten van de computer.",
                            "target_lang_translations": {
                                "en": "If I <w>plunder</w> gold in this game, I get extra points from the computer.",
                                "ru": "Если я <w>похищаю</w> золото в этой игре, я получаю дополнительные очки от компьютера."
                            }
