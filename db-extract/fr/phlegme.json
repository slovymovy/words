                "senses": [
                    {
                        "sense_id": "17be3479-da66-3215-82b1-f558dc99ff37",
                        "entry_id": "15d64de1-7ae0-3770-b133-8a05e314be36",
                        "glosses": [
                            "Humeur muqueuse que l’on rejette en crachant."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "44a9d0bc-3796-4a10-b68e-acb93f37fa6d",
                                "sense_id": "17be3479-da66-3215-82b1-f558dc99ff37",
                                "text": "Si l’on souffrait d’un déséquilibre des quatre humeurs corporelles (le sang, la bile jaune, la bile noire et le phlegme), on n’avait qu’à consommer des épices. La noix de muscade passait pour être chaude et sèche, le gingembre chaud et humide, le poivre très chaud et très sec, et le clou de girofle soignait les maux de dents."
                            },
                            {
                                "example_id": "bbd5a5d9-13da-4f73-83b6-87a1acebfe6e",
                                "sense_id": "17be3479-da66-3215-82b1-f558dc99ff37",
                                "text": "La cause fondamentale de l’asthme réside dans l’accumulation de phlegme."
                            }
                        ]
                    },
                    {
                        "sense_id": "15ee677e-8371-3bf1-8d33-90ee760924b6",
                        "entry_id": "15d64de1-7ae0-3770-b133-8a05e314be36",
                        "glosses": [
                            "Qualité d’un esprit patient, maîtrise de soi."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "967453b0-4791-4c5e-a715-5afe5d2a534e",
                                "sense_id": "15ee677e-8371-3bf1-8d33-90ee760924b6",
                                "text": "C’est un homme qui a un grand phlegme, qui est d’un grand phlegme."
                            }
                        ]
                    }
