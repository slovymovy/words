                            "plural"
                        ],
                        "form": "Sprachbunds"
                    },
                    {
                        "form_id": "e73da767-5994-484b-a5ef-f39e4b3a8a02",
                        "entry_id": "69f286ef-27f6-35bc-b718-651118e5f622",
