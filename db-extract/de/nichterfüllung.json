                                "target_senses": [
                                    {
                                        "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "The condition of failing to meet an obligation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d81075e-41be-404e-9ad8-d9fdd8881c1f",
                                                "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                                "text": "He failed to make payments on time, and he is now in default."
                                            },
                                            {
                                                "example_id": "2b96ae44-1838-4deb-8062-b21b225efb5b",
                                                "sense_id": "ab9f8386-5138-3e96-9f4e-4ef66a9133ad",
                                                "text": "You may cure this default by paying the full amount within a week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a77a38f-4f05-3257-aa7e-06ee9cc689a3",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "The condition of being an obligation that has not been met."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105bdace-a6ae-45b6-8b16-758145628c0a",
                                                "sense_id": "3a77a38f-4f05-3257-aa7e-06ee9cc689a3",
                                                "text": "The deadline has passed, so the debt is now in default."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352a159f-0d9e-3117-abde-f27b97999f90",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "the original software programming settings as set by the factory"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91d9936f-1679-32ba-9251-ffbab135ef86",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "A loss incurred by failing to compete."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc316d8a-1648-4d71-9d8f-57bd585dd1ae",
                                                "sense_id": "91d9936f-1679-32ba-9251-ffbab135ef86",
                                                "text": "The team's three losses include one default."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "A selection made in the absence of an alternative."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e2124199-737a-4cc9-92e9-19dde838718d",
                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "The man became the leader of the group as a default."
                                            },
                                            {
                                                "example_id": "7e163601-4bf1-4999-8b37-eb63c02083a2",
                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "One of the darlings of the early vegetarian movement (particularly in its even sadder form, the cutlet), it was on the menu at John Harvey Kellogg's Battle Creek Sanitarium [sic], and has since become the default Sunday option for vegetarians – and a default source of derision for everyone else."
                                            },
                                            {
                                                "example_id": "3d00819b-1e4d-4359-af23-852e554c80d3",
                                                "sense_id": "f49a49d5-7977-36ec-aa04-095e5cd88642",
                                                "text": "Overall the signage at NIE has the appearance being a top-down artefact driven by institutional policy with English set as the default language."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e611b1-e942-3d8e-9a76-0822d969ebf9",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "A value used when none has been given; a tentative value or standard that is presumed."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93a35f3-a01a-4fa9-8141-c72da251e6a4",
                                                "sense_id": "30e611b1-e942-3d8e-9a76-0822d969ebf9",
                                                "text": "If you don't specify a number of items, the default is 1."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ed13029-eb9b-3827-8c96-e9a4d7486891",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "The failure of a defendant to appear and answer a summons and complaint."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "94c3f08f-ab14-30d1-8fad-fd51e72218fd",
                                        "entry_id": "1bb9c168-3f78-3f94-81a2-f525d6003052",
                                        "glosses": [
                                            "A failing or failure; omission of that which ought to be done; neglect to do what duty or law requires."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c9e4b90-978b-4163-9007-4efc50ccc714",
                                                "sense_id": "94c3f08f-ab14-30d1-8fad-fd51e72218fd",
                                                "text": "This evil has happened through the governor's default."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82cbb043-a21f-3add-b90f-c6ffec189a53",
