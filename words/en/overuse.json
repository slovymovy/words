{
    "word_family": [
        "use",
        "user",
        "useful",
        "useless",
        "usage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10173e26-9daa-33b6-ac6c-3cf72e7006a9",
                    "sense_definition": "To use something excessively or too frequently.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excessive_use",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many doctors warn that patients <w>overuse</w> antibiotics for simple viral infections.",
                            "target_lang_translations": {
                                "es": "Muchos médicos advierten que los pacientes <w>abusan de</w> los antibióticos para infecciones virales simples."
                            }
                        },
                        {
                            "text": "Try not to <w>overuse</w> common buzzwords when writing your university essay.",
                            "target_lang_translations": {
                                "es": "Intenta no <w>usar en exceso</w> palabras de moda comunes al redactar tu ensayo universitario."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwork"
                    ],
                    "common_phrases": [
                        "overuse antibiotics",
                        "overuse words"
                    ],
                    "target_lang_definitions": {
                        "es": "Usar algo de forma excesiva o con demasiada frecuencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "usar en exceso",
                                "target_lang_sense_clarification": "utilizar algo más de lo debido"
                            },
                            {
                                "target_lang_word": "abusar de",
                                "target_lang_sense_clarification": "hacer uso desmedido de algo"
                            },
                            {
                                "target_lang_word": "sobreutilizar",
                                "target_lang_sense_clarification": "utilizar en exceso un recurso o elemento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6f5a8e0-3bd4-30d0-874d-7c41f33f4e95",
                    "sense_definition": "The excessive, excessive frequency, or too intense use of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excessive_use",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runner suffered a painful knee injury due to the <w>overuse</w> of his joints.",
                            "target_lang_translations": {
                                "es": "El corredor sufrió una dolorosa lesión de rodilla debido al <w>uso excesivo</w> de sus articulaciones."
                            }
                        },
                        {
                            "text": "Critics complained about the heavy <w>overuse</w> of digital special effects in the movie.",
                            "target_lang_translations": {
                                "es": "Los críticos se quejaron del marcado <w>abuso</w> de efectos especiales digitales en la película."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overuse injury"
                    ],
                    "target_lang_definitions": {
                        "es": "Uso excesivo, demasiado frecuente o excesivamente intenso de algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "uso excesivo",
                                "target_lang_sense_clarification": "empleo desmedido de algo"
                            },
                            {
                                "target_lang_word": "sobreuso",
                                "target_lang_sense_clarification": "utilización excesiva"
                            },
                            {
                                "target_lang_word": "abuso",
                                "target_lang_sense_clarification": "uso indebido o desmedido"
                            },
                            {
                                "target_lang_word": "sobreutilización",
                                "target_lang_sense_clarification": "empleo por encima de lo normal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
