                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d21a8d65-f402-44a1-ab71-658633344552",
                                "sense_id": "9eede3e2-4d37-339b-8465-ff40ff2791cd",
                                "text": "„Anfang 2000 verlassen drei Container, die an Bord von Frachtschiffen der dänischen Reederei Maersk Sealand aus dem kolumbianischen Barranquilla nach Kalabrien gekommen waren, den Hafen von Gioia Tauro. Sie sind für Fudulis Firmen bestimmt und enthalten einen marmorähnlichen Stein, in dem 220,434 beziehungsweise 870 Kilo Kokain versteckt sind.“"
                            }
