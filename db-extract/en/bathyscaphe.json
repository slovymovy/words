                                    {
                                        "sense_id": "1dae0610-2cc6-39de-bb98-0790b3f717fe",
                                        "entry_id": "4451b0e3-3217-3f12-adb2-767e4745fec8",
                                        "glosses": [
                                            "druh ponorky určený k ponorům do velkých hloubek"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1748030d-73fc-4497-80e1-6f6e52441e2f",
                                                "sense_id": "1dae0610-2cc6-39de-bb98-0790b3f717fe",
                                                "text": "Vynálezcem batyskafu je švýcarský výzkumník profesor Auguste Piccard. Při konstrukci prvního batyskafu vycházel ze svých zkušeností se stratosférickým balónem FNRS a soudobých pokusů s batysférami."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c109a765-efb2-4dac-84b9-23efc4ccb532",
                        "source_entry_id": "813126ae-f565-3818-b193-ae558cdc0a87",
                        "source_sense_id": "ad3eef8e-159f-3bdf-81a9-620aaa8d6ace",
