                        "sense_id": "7174be77-27d0-3322-b4f5-bbdf9afc7f16",
                        "entry_id": "6e5d8c5c-7304-357e-8e91-c127a7270851",
                        "glosses": [
                            "Note finale d’un manuscrit ou d’un livre, comportant le nom de l’auteur, la date, etc."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "f3a923da-ed36-4b25-96e4-cd801f1a5bc2",
                                "sense_id": "7174be77-27d0-3322-b4f5-bbdf9afc7f16",
                                "text": "Le colophon des incunables est l’ancêtre de l’achevé d’imprimer moderne."
                            },
                            {
                                "example_id": "ceb9ce73-996b-4030-86a8-3d44029a836d",
                                "sense_id": "7174be77-27d0-3322-b4f5-bbdf9afc7f16",
                                "text": "Lorsque le colophon ne comporte que l’année, le mot sana est écrit tout de suite après le texte."
                            }
                        ]
                    }
                ],
