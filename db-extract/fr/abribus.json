                                "target_senses": [
                                    {
                                        "sense_id": "98d1c538-cb64-3f98-99b7-410c0d868b2c",
                                        "entry_id": "270fe684-97b8-3e8e-b065-2dea088d7e31",
                                        "glosses": [
                                            "A building or other structure constructed at a bus stop, to provide seating and protection from the weather for the convenience of waiting passengers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2c23a0d-0059-4633-8685-c2eaa35c0bd9",
                                                "sense_id": "98d1c538-cb64-3f98-99b7-410c0d868b2c",
                                                "text": "NR Chairman Sir Peter Hendy had made it clear that he didn't want anything that smacked of the bus shelters seen at many small, usually unstaffed stations."
                                            },
                                            {
                                                "example_id": "899a22ca-4e60-450f-b412-aefd791daab0",
                                                "sense_id": "98d1c538-cb64-3f98-99b7-410c0d868b2c",
                                                "text": "I eventually got to a smelly bus shelter and perched cautiously on the bench inside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
