                                        "sense_id": "b1482e64-5b16-3275-ba71-f57a5739a4ac",
                                        "entry_id": "df8bd1a0-eea8-32eb-aaa7-fdf4ae3a1324",
                                        "glosses": [
                                            "Many times; repeatedly."
