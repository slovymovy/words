                                "target_senses": [
                                    {
                                        "sense_id": "1ec2f1f6-d98d-3799-b935-3dd12921d89f",
                                        "entry_id": "35badc65-5793-30a7-8a74-1004c57bc93c",
                                        "glosses": [
                                            "Agent noun of dispatch; one who dispatches."
                                        ],
                                        "tags": [
                                            "agent",
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61eb5945-eee0-3f01-8a9a-292942e4cfe2",
                                        "entry_id": "35badc65-5793-30a7-8a74-1004c57bc93c",
                                        "glosses": [
                                            "In a transportation organization, a person who controls the movements of vehicles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018abffd-55d9-4ce0-861d-44475b7de182",
                                                "sense_id": "61eb5945-eee0-3f01-8a9a-292942e4cfe2",
                                                "text": "The organization of Decline to Sign involved trained teams sent out to where 608/610 supporters were gathering signatures, alerted by dispatchers operating a hotline to which anyone could call in—from a mall, the ferry terminals, holiday events, etc. when signature gatherers were sighted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1faec7cb-04ca-33bd-bcd8-11e1d3e9b503",
                                        "entry_id": "35badc65-5793-30a7-8a74-1004c57bc93c",
                                        "glosses": [
                                            "A piece of software responsible for assigning priorities and resources to tasks waiting to be scheduled."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8785c2a5-0b15-3e09-bf29-6d1c33514e4e",
                                        "entry_id": "35badc65-5793-30a7-8a74-1004c57bc93c",
                                        "glosses": [
                                            "Any die used for cheating, whether fraudulently weighted or bearing duplicate numbers."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43f930fb-1bd5-4e4d-90b4-017db463c37d",
                                                "sense_id": "8785c2a5-0b15-3e09-bf29-6d1c33514e4e",
                                                "text": "First see that each die has all six figures upon it, for some dice are dispatchers, made with double numbers, […]"
                                            },
                                            {
                                                "example_id": "ee777b6a-d3ef-43f1-9e24-874af4d57429",
                                                "sense_id": "8785c2a5-0b15-3e09-bf29-6d1c33514e4e",
                                                "text": "He also knew, with another proficient glance, that the dice the youngster jiggled were likely a pair of dispatchers—so named because they effectively \"dispatched\" their intended targets: suckers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
