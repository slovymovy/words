                "senses": [
                    {
                        "sense_id": "ceb33336-e380-3d95-b3f4-f1109bce7b68",
                        "entry_id": "9afd9c91-9a3c-3a52-9922-3cafbec10c73",
                        "glosses": [
                            "Homicide lié à un trafic de drogue, hors règlement de compte."
                        ],
                        "tags": [
                            "Mort"
                        ],
                        "examples": [
                            {
                                "example_id": "2ef89e70-42d8-4ffa-8944-efd5580e12fd",
                                "sense_id": "ceb33336-e380-3d95-b3f4-f1109bce7b68",
                                "text": "Lundi soir encore, une personne a été abattue à Marseille dans ce qui s’apparente au 44ᵉ « narchomicide » de l’année."
                            },
                            {
                                "example_id": "2cf7d7ce-23f2-4ed7-b2a9-b0f163be91ef",
                                "sense_id": "ceb33336-e380-3d95-b3f4-f1109bce7b68",
                                "text": "A Marseille, les «narchomicides» ont ainsi remplacé les «règlements de comptes»."
                            },
                            {
                                "example_id": "af3a9b45-be07-44da-9a4e-c47a8a3dffc4",
                                "sense_id": "ceb33336-e380-3d95-b3f4-f1109bce7b68",
                                "text": "La Belle-de-Mai, quartier populaire régulièrement classé parmi les plus pauvres d’Europe, fait partie de ces secteurs de la cité phocéenne particulièrement touchés par la criminalité liée aux trafics de stupéfiants. Ainsi, deux narchomicides avaient eu lieu en 2023 dans cette partie relativement centrale de la ville, et cinq en 2022."
                            },
                            {
                                "example_id": "939a6f2a-69fb-4e9e-8c73-1802963e41e6",
                                "sense_id": "ceb33336-e380-3d95-b3f4-f1109bce7b68",
                                "text": "Le Moonlight apparaît comme un dossier symbolique des affaires de narchomicides les plus complexes."
                            }
                        ]
                    }
