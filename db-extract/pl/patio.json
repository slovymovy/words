                                    {
                                        "sense_id": "45fb30ed-e4a1-3eb6-bb09-8b3eccf50a54",
                                        "entry_id": "a65eaf6c-e8b5-3438-9c98-849b02977f4f",
                                        "glosses": [
                                            "A paved outside area, adjoining a house, used for dining or recreation."
                                        ],
