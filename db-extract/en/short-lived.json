                                        "entry_id": "de4ca3b8-0f59-3afe-8856-d980c3a0d692",
                                        "glosses": [
                                            "eine kurze Lebensdauer besitzend"
                                        ],
                                        "tags": [
                                            "jargon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a448cc7-3469-43a8-89ad-47e230917a49",
                                                "sense_id": "4f1a1e88-dff7-3d5d-8901-fa61df693a21",
                                                "text": "„Das Prothallium entwickelt sich aus einer vom Sporophyt der Farne produzierten Spore. Es ist relativ kurzlebig, meist nur wenige Millimeter groß und wird wegen seiner Unscheinbarkeit kaum je vom Laien wahrgenommen – und wenn doch, dann wird es wegen seines thallösen Aussehens häufig zum Beispiel mit einem Lebermoos verwechselt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7ed1a87-5daf-368a-aa51-e3443c40b33e",
                                        "entry_id": "de4ca3b8-0f59-3afe-8856-d980c3a0d692",
                                        "glosses": [
                                            "kurzzeitig gültig/aktuell"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40ce0f32-ae93-4547-8aef-e2aa9a0cfcf3",
                                                "sense_id": "e7ed1a87-5daf-368a-aa51-e3443c40b33e",
                                                "text": "Sie machte nicht jeden kurzlebigen Trend der Mode mit, da ihr das Geld dafür zu schade ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
