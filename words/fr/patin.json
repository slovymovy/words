                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'entrée de la maison, la grand-mère exigeait toujours que l'on mît des <w>patins</w>."
