                "senses": [
                    {
                        "sense_id": "f1973ec6-5fb0-34b0-a44d-6c5ecb9dd7cc",
                        "entry_id": "fde840fc-50f0-3af6-b3e9-0919a8556d94",
                        "glosses": [
                            "Qui se plaît à l’ombre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "347f9cb8-f62d-3c49-8b49-1a6c5d5be9a3",
                        "entry_id": "fde840fc-50f0-3af6-b3e9-0919a8556d94",
                        "glosses": [
                            "Qualifie les plantes ou les groupes de plantes qui ont besoin d’ombre pour se développer."
                        ],
                        "tags": [
                            "Phytosociologie"
                        ],
                        "examples": [
                            {
                                "example_id": "993db07b-b72d-49e5-b7fe-9ab1adb85794",
                                "sense_id": "347f9cb8-f62d-3c49-8b49-1a6c5d5be9a3",
                                "text": "À la suite des coupes pratiquées en vue de protéger les propriétés riveraines des crues trop violentes, on observe aussi des stades régressifs marqués par la disparition des espèces plus ou moins sciaphiles alors que Phragmites, Eupatorium, Epilobium hursitum se développent en larges colonies […]"
                            },
                            {
                                "example_id": "bfa2cedd-7c85-4cb0-be24-a88bfc7a55b6",
                                "sense_id": "347f9cb8-f62d-3c49-8b49-1a6c5d5be9a3",
                                "text": "En évolution naturelle, dans un peuplement mélangé de chêne et de hêtre où chacune des deux espèces occupe au moins 30 % du couvert total, c’est principalement le hêtre, sciaphile et très dynamique, qui se régénère dans les petites trouées."
                            }
                        ]
                    }
