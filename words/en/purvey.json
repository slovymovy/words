                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Professor <w>Purvey</w> delivered an insightful lecture on medieval English literature yesterday afternoon.",
                            "target_lang_translations": {
                                "ru": "Вчера днем профессор <w>Перви</w> прочитал познавательную лекцию по средневековой английской литературе."
                            }
                        },
                        {
                            "text": "The police contacted Mr. <w>Purvey</w> to discuss the recent incident near his store.",
                            "target_lang_translations": {
                                "ru": "Полиция связалась с мистером <w>Перви</w>, чтобы обсудить недавнее происшествие возле его магазина."
                            }
