                        "glosses": [
                            "groep van mensen met een inkomen dat tussen een bepaalde boven- en ondergrens in zit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fec88b3a-8879-43b5-af78-79f0057d25d4",
                                "sense_id": "d60261f3-e815-39ba-a06e-c1657d5a97ca",
                                "text": "Het CBS constateerde ook dat er een verband is tussen de Cito-score van kinderen en het inkomen van het gezin waarin ze wonen. Kinderen uit gezinnen in de hoogste inkomensgroep scoorden gemiddeld bij 7 punten hoger dan die in de laagste inkomensgroep, aldus het CBS."
                            },
                            {
                                "example_id": "e966920a-e584-4263-b86a-350a3907b091",
                                "sense_id": "d60261f3-e815-39ba-a06e-c1657d5a97ca",
                                "text": "Zo is bijna een op de vijf jongeren uit de laagste inkomensgroep te zwaar, tegenover iets meer dan een op de tien uit de hoogste inkomensgroep. Ernstig overgewicht komt zelfs drie keer zo vaak voor bij mensen tussen de 2 en 25 jaar uit huishoudens met de laagste inkomens."
                            }
                        ]
