                    {
                        "translation_id": "55fd94dd-bb4e-4bd3-90a7-1f6f59f5da19",
                        "source_entry_id": "1e0fe9d8-4754-3b41-b203-c08536100c2d",
                        "source_sense_id": "943d3980-06df-307d-8b07-46fcc58bf7fa",
