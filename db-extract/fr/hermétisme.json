                                        "entry_id": "03fedd45-90cb-3f99-83fa-e068671aa66e",
                                        "glosses": [
                                            "eine antike Offenbarungslehre, die sich auf die mythische Gestalt des Hermes Trismegistos zurückführt und mit Magie und Alchemie zusammenhängt"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8673aaf8-0d0d-4b99-a215-c36ddeed4712",
                                                "sense_id": "c35ed1b1-413f-3ec3-b987-9e3a7a419241",
                                                "text": "Die Hermetik hat in der Renaissance stark nachgewirkt."
                                            },
                                            {
                                                "example_id": "2bed6818-c429-46ac-a9ce-df18a89069d9",
                                                "sense_id": "c35ed1b1-413f-3ec3-b987-9e3a7a419241",
                                                "text": "„Der Traum wehrt den Zensor durch seine Hermetik ab, der Witz tut es durch das Lachen, das er erregt.“"
                                            }
                                        ],
