                "senses": [
                    {
                        "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                        "entry_id": "0a87b2b1-d04f-3d66-acfb-0352eb585439",
                        "glosses": [
                            "Reklame, intensives Werben"
                        ],
                        "tags": [
                            "meist in der Formulierung ›die Werbetrommel rühren‹",
                            "als Sinnbild für"
                        ],
                        "examples": [
                            {
                                "example_id": "28d12812-37a1-4749-912c-4c167b55c677",
                                "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                                "text": "„Die Hochschule Bremen zum Beispiel rührt seit fünf Jahren die Werbetrommel. Und zwar ganz klassisch: Mit Anzeigen.“"
                            },
                            {
                                "example_id": "8889d60e-0b7f-4dbe-9ae0-d5d78bf73153",
                                "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                                "text": "„Damit hat keiner gerechnet! Eminem hat in einer Nacht-und-Nebel-Aktion mal eben so, ohne Ankündigung, ohne Werbetrommel, ohne großes Tam Tam, sein 10. Album veröffentlicht.“"
                            },
                            {
                                "example_id": "309b5f41-7e02-4f46-9dee-75eb5e0e1c9b",
                                "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                                "text": "Dass der Künstler im Interview kräftig die Werbetrommel schlägt, kann man ihm nicht verdenken."
                            },
                            {
                                "example_id": "5eb3d440-cdd0-402a-b6bd-cda79f1a15bc",
                                "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                                "text": "Das Touristikbüro rührt fleißig die Werbetrommel für die Bodensee-Region."
                            },
                            {
                                "example_id": "f6140cb6-dacc-41f7-b2e4-41d8cda00de4",
                                "sense_id": "59c3f3ef-a670-34c3-a29c-7e9b5acd35b1",
                                "text": "„Es scheint hingegen, als ob Galilei mit diesem kräftigen Rühren der Werbetrommel vollen Erfolg gehabt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
