                                "example_id": "96aeba1a-efc3-471b-b5b2-2bf99cc50656",
                                "sense_id": "18ace205-1017-3cee-ac73-c72866a89918",
                                "text": "For though the harpooneers, with the great body of the crew, were a far more barbaric, heathenish, and motley set than any of the tame merchant-ship companies which my previous experiences had made me acquainted with, still I ascribed this—and rightly ascribed it—to the fierce uniqueness of the very nature of that wild Scandinavian vocation in which I had so abandonedly embarked."
                            },
                            {
                                "example_id": "2f4741c7-c37f-46e0-af5c-ce54b20fc728",
                                "sense_id": "18ace205-1017-3cee-ac73-c72866a89918",
                                "text": "In the first days of their love she had been his slave; she had admired him abandonedly."
                            }
                        ]
                    }
