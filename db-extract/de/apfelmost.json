                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee3f5d73-0a5c-4cd6-85b6-753eb0cf2d44",
                                "sense_id": "9d4a9522-0339-32aa-a3d3-19312be10811",
                                "text": "„Ein kleines Mädchen, das barfuß in Holzpantinen lief und dessen Körper man durch das zerlumpte Kleidchen hindurch sehen konnte, brachte den Frauen zu trinken und goß ihnen Apfelmost aus einem Krug ein, den es gegen die Hüfte stützte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f9995995-7a45-3b60-80e2-ed783fa6df84",
                        "entry_id": "337097d8-725b-300e-bd87-26920d8b667f",
                        "glosses": [
                            "vergorener Apfelwein, der nach demselben Verfahren wie Traubenwein hergestellt wird"
                        ],
