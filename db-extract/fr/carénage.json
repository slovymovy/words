                    },
                    {
                        "translation_id": "e45d92c4-5e07-4217-9290-d23930bdbe7f",
                        "source_entry_id": "07a906f5-5ef4-3ea7-81ff-ce3b72d5415e",
                        "source_sense_description": "Carrosserie de véhicule diminuant la résistance à l’air",
                        "target_lang_word": "Schürze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schürze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                        "entry_id": "b4c6892a-8254-3f67-a554-255bb1db6192",
                                        "glosses": [
                                            "ein Kleidungsstück, welches man über der restlichen Kleidung trägt, um diese vor Schmutz zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfbfa242-52f5-48ba-b9a7-0e3cbab96e91",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "Bei der Hausarbeit tragen viele Frauen eine Schürze über der restlichen Kleidung."
                                            },
                                            {
                                                "example_id": "fa47401d-5716-4bbe-9440-527ad1d2b2bd",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "An der Schleife der Schürze von Dirndlkleidern erkennt man angeblich den ehelichen Status der Trägerin."
                                            },
                                            {
                                                "example_id": "dbd493fa-aaa0-46ad-a291-708739c3a270",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "Hätte das Kind beim Malen keine Latzschürze getragen, so wäre womöglich seine Oberbekleidung durch die Farbe beschmutzt worden."
                                            },
                                            {
                                                "example_id": "3fc16a40-421a-4a48-98ec-f9b6f4dbecac",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "Früher gehörten Schürzen jeglicher Art zur Alltags- und Schulkleidung von Mädchen."
                                            },
                                            {
                                                "example_id": "87f94456-9f5f-4b80-8497-0729550a6191",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "„Die Frau kam herein, wischte sich die Hände in einer dreckigen Schürze ab, drückte jedem schlaff und naß die Hand und verzog dabei den Mund wie zum Lachen.“"
                                            },
                                            {
                                                "example_id": "47aac422-f9fd-4b2d-a09f-763a5583f5fe",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "„Die Mutter wischte sich die Hände an der frischen Schürze ab, ging hinaus und war gleich zurück.“"
                                            },
                                            {
                                                "example_id": "9ec62c7b-fbf2-4278-bdba-b38df5398537",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "„Die Mädchen trugen Uniform: blaugraue, schlichte Kleider und darüber dunkelblaue Schürzen.“"
                                            },
                                            {
                                                "example_id": "e153dcd4-55bf-4aa8-aa19-01e2769ac497",
                                                "sense_id": "84b8362d-f48f-363a-8ee2-2707597f9868",
                                                "text": "„Die Haustür war mir jetzt gleichgültig, und ich kam mir dumm vor, fast auf dieselbe Weise dumm wie damals, als ich heimlich die Schürze meiner Witwe geküßt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "71d2a386-23a0-3e47-97f0-470394f0056f",
                                        "entry_id": "b4c6892a-8254-3f67-a554-255bb1db6192",
                                        "glosses": [
                                            "ein Schutzgehäuse bei technischen Geräten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a2e0bba-1dac-48be-945d-63dcd0013157",
                                                "sense_id": "71d2a386-23a0-3e47-97f0-470394f0056f",
                                                "text": "Eine Abdeckschürze aus Metall wird über die Maschine geklappt und schützt so vor eventuellen Verletzungen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd99aeae-7c7b-391f-865c-c6f2a7366156",
                                        "entry_id": "b4c6892a-8254-3f67-a554-255bb1db6192",
                                        "glosses": [
                                            "ein schürzen-ähnliches Kleidungsstück zum Schutz vor radioaktiver Strahlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a490f2d-d58c-4283-abac-b83bdc5bcf02",
                                                "sense_id": "cd99aeae-7c7b-391f-865c-c6f2a7366156",
                                                "text": "Während der Aufnahme eines Röntgenbildes musste der Patient eine schwere Bleischürze tragen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
