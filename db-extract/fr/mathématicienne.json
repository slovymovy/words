                ],
                "senses": [
                    {
                        "sense_id": "8569748b-dbe5-3d02-ba98-108b74e2f6f2",
                        "entry_id": "076eb7c6-3f08-3c79-973b-63f1a3ccc186",
                        "glosses": [
                            "Celle qui fait son étude principale des mathématiques, qui s'occupe d'ouvrages ou de travaux relatifs à cette science."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f50ad99d-87fd-4091-83f9-af2eb1f2e1cc",
                                "sense_id": "8569748b-dbe5-3d02-ba98-108b74e2f6f2",
                                "text": "Il se souvient que Selby lui a confié que sa sœur était une mathématicienne hors de pair, supérieure à lui."
                            },
                            {
                                "example_id": "de395fac-9256-4a92-8a15-5ba116c2fe3e",
                                "sense_id": "8569748b-dbe5-3d02-ba98-108b74e2f6f2",
                                "text": "La mathématicienne devient la première femme à obtenir un prix de l’Académie des sciences dans une discipline à l’époque entièrement masculine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c0364f0-3d22-46a4-8b60-c4dacc11c9cd",
                        "source_entry_id": "076eb7c6-3f08-3c79-973b-63f1a3ccc186",
                        "source_sense_id": "8569748b-dbe5-3d02-ba98-108b74e2f6f2",
                        "target_lang_word": "Mathematikerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mathematikerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba84c76f-5303-3da6-b41c-a015aa6571b6",
                                        "entry_id": "8632b43a-50cd-3479-b202-f4568f91a1b3",
                                        "glosses": [
                                            "weiblicher Mathematiker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3a0dafa-5a88-47ac-bd89-558d05ae2b0b",
                                                "sense_id": "ba84c76f-5303-3da6-b41c-a015aa6571b6",
                                                "text": "Eine Mathematikerin befasst sich mit Mathematik."
                                            },
                                            {
                                                "example_id": "88d4da5d-52f5-4e47-8048-097deccf4da5",
                                                "sense_id": "ba84c76f-5303-3da6-b41c-a015aa6571b6",
                                                "text": "„Da Käthe eine ganz gute Mathematikerin war, verstand sie, was er meinte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dd85364-03b4-4f04-a47b-5d6eee67495e",
                        "source_entry_id": "076eb7c6-3f08-3c79-973b-63f1a3ccc186",
                        "source_sense_id": "8569748b-dbe5-3d02-ba98-108b74e2f6f2",
                        "target_lang_word": "mathematician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mathematician",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bde8ef00-3268-3024-861c-0d215a160be1",
                                        "entry_id": "61fb46da-44a6-3201-a97c-ecd91f940a73",
                                        "glosses": [
                                            "An expert on mathematics; someone who studies mathematics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "973e715f-10d3-4cee-a669-7d9cc237d746",
                                                "sense_id": "bde8ef00-3268-3024-861c-0d215a160be1",
                                                "text": "I suspect that in their hearts most working mathematicians are Platonists, in that they take it as a matter of unassailable if unprovable fact that mathematical reality stands apart from the world, and is at least as real as the world, and possibly gives shape to the world, as Plato suggested. Most mathematicians would probably agree that the ratio of the circle to its diameter exists brilliantly in the nature beyond nature, and would exist even if the human mind was not aware of it, and might exist even if God had not bothered to create it."
                                            },
                                            {
                                                "example_id": "d2a77bfb-5626-4765-943d-12f966f1224a",
                                                "sense_id": "bde8ef00-3268-3024-861c-0d215a160be1",
                                                "text": "The true work of the mathematician is not experienced until the later parts of graduate school, when the student is challenged to create knowledge in the form of a novel proof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
