{
    "word_family": [
        "strutter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97755b90-9c4d-3c03-8b09-a16f6f0405a2",
                    "sense_definition": "To walk proudly or stiffly with one's head held high, often to impress others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proud_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>strut</w> around the office as if he owns the company.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>важно расхаживать</w> по офису, словно он владелец компании."
                            }
                        },
                        {
                            "text": "The models <w>strutted</w> down the runway in high fashion garments.",
                            "target_lang_translations": {
                                "ru": "Модели <w>дефилировали</w> по подиуму в нарядах высокой моды."
                            }
                        }
                    ],
                    "synonyms": [
                        "swagger"
                    ],
                    "common_phrases": [
                        "strut one's stuff"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ходить с гордым, напыщенным или самодовольным видом, высоко подняв голову."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важничать",
                                "target_lang_sense_clarification": "держаться или ходить с напыщенным видом"
                            },
                            {
                                "target_lang_word": "ходить гоголем",
                                "target_lang_sense_clarification": "шествовать с гордо поднятой головой, красоваться"
                            },
                            {
                                "target_lang_word": "вышагивать",
                                "target_lang_sense_clarification": "идти гордой, уверенной походкой напоказ"
                            },
                            {
                                "target_lang_word": "дефилировать",
                                "target_lang_sense_clarification": "идти важно, напоказ окружающим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52d69212-504e-309a-b67d-7f979b002135",
                    "sense_definition": "Of a bird, especially a rooster or peacock: to walk stiffly with the tail feathers spread out.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "proud_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rooster <w>strutted</w> across the farmyard, keeping watch over the hens.",
                            "target_lang_translations": {
                                "ru": "Петух <w>гордо вышагивал</w> по скотному двору, приглядывая за курами."
                            }
                        },
                        {
                            "text": "In the garden, the peacock <w>struts</w> proudly to show off its colorful feathers.",
                            "target_lang_translations": {
                                "ru": "В саду павлин гордо <w>красуется</w>, распуская свои яркие перья."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О птицах (петухе, павлине): важно вышагивать с распущенным хвостом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важно расхаживать",
                                "target_lang_sense_clarification": "о птицах, распушивших хвост"
                            },
                            {
                                "target_lang_word": "вышагивать",
                                "target_lang_sense_clarification": "ходить с гордым видом"
                            },
                            {
                                "target_lang_word": "токовать",
                                "target_lang_sense_clarification": "красоваться перед самками, распуская хвост"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31d36913-743c-3f20-ad5e-489782e5bb62",
                    "sense_definition": "To walk proudly or arrogantly across a specific place or stage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "proud_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead singer <w>struts</w> the stage while the crowd cheers wildly.",
                            "target_lang_translations": {
                                "ru": "Солист <w>вышагивает по</w> сцене под бурные возгласы толпы."
                            }
                        },
                        {
                            "text": "He began to <w>strut</w> the corridor like an arrogant general inspecting his troops.",
                            "target_lang_translations": {
                                "ru": "Он принялся <w>важно расхаживать по</w> коридору, словно высокомерный генерал, проводящий смотр войск."
                            }
                        }
                    ],
                    "synonyms": [
                        "swagger"
                    ],
                    "common_phrases": [
                        "strut the stage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гордо, вальяжно или высокомерно ходить по сцене или какому-либо пространству."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вышагивать по",
                                "target_lang_sense_clarification": "уверенно и гордо ходить по сцене или коридору"
                            },
                            {
                                "target_lang_word": "дефилировать по",
                                "target_lang_sense_clarification": "ходить напоказ по какому-либо месту"
                            },
                            {
                                "target_lang_word": "важно расхаживать по",
                                "target_lang_sense_clarification": "степенно и самодовольно шагать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38591b74-0711-38c3-9f40-4dc3901285d8",
                    "sense_definition": "To brace or strengthen a structure using a structural support rod or beam.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenters decided to <w>strut</w> the temporary framework to avoid collapse.",
                            "target_lang_translations": {
                                "ru": "Плотники решили <w>укрепить распорками</w> временный каркас, чтобы избежать обрушения."
                            }
                        },
                        {
                            "text": "They had to <w>strut</w> the trench walls carefully before beginning excavation work.",
                            "target_lang_translations": {
                                "ru": "Им пришлось тщательно <w>расклинить</w> стены траншеи перед началом земляных работ."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Укреплять или расклинивать конструкцию с помощью распорок, стоек или подкосов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расклинивать",
                                "target_lang_sense_clarification": "ставить распорки"
                            },
                            {
                                "target_lang_word": "укреплять распорками",
                                "target_lang_sense_clarification": "ставить подпорки или растяжки"
                            },
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "устанавливать опору или подкос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c817b196-ba4e-3433-928a-7b27b9a00ebd",
                    "sense_definition": "To swell, bulge, or stick out from being full.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bulge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong wind blew hard until the sails began to <w>strut</w> outward.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер дул всё яростнее, пока паруса не начали <w>надуваться</w>."
                            }
                        },
                        {
                            "text": "The tightly packed sacks would <w>strut</w> out along the sides.",
                            "target_lang_translations": {
                                "ru": "Плотно набитые мешки <w>выпирали</w> по бокам."
                            }
                        }
                    ],
                    "synonyms": [
                        "distend"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздуваться, надуваться или выпячиваться от наполненности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздуваться",
                                "target_lang_sense_clarification": "наполняться воздухом или содержимым"
                            },
                            {
                                "target_lang_word": "выпячиваться",
                                "target_lang_sense_clarification": "выпирать от полноты"
                            },
                            {
                                "target_lang_word": "набухать",
                                "target_lang_sense_clarification": "увеличиваться в объёме"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "188a419e-19f4-38d0-ad49-18e59f3a6702",
                    "sense_definition": "To cause something to swell or bulge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bulge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A fresh gust came to <w>strut</w> the canvas of the ship.",
                            "target_lang_translations": {
                                "ru": "Свежий порыв ветра налетел, чтобы <w>надуть</w> паруса корабля."
                            }
                        },
                        {
                            "text": "Heavy rainfall can <w>strut</w> the banks of small channels.",
                            "target_lang_translations": {
                                "ru": "Проливные дожди могут <w>распирать</w> берега небольших каналов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять что-либо раздуваться, распирать или наполнять до выпячивания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздувать",
                                "target_lang_sense_clarification": "наполнять ветром или газом"
                            },
                            {
                                "target_lang_word": "распирать",
                                "target_lang_sense_clarification": "давить изнутри наружу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc4dc06a-7849-3974-864c-116716eb3e03",
                    "sense_definition": "To be attached diagonally or inclined at an angle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The secondary braces <w>strut</w> upward toward the main ridge of the roof.",
                            "target_lang_translations": {
                                "ru": "Вспомогательные связи <w>идут наискось</w> вверх к главному коньку крыши."
                            }
                        },
                        {
                            "text": "Notice how the timber beams <w>strut</w> sharply against the ceiling joints.",
                            "target_lang_translations": {
                                "ru": "Обратите внимание, как деревянные балки круто <w>упираются</w> в потолочные стыки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Располагаться или упираться под углом (о распорках или балках)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упираться под углом",
                                "target_lang_sense_clarification": "служить наклонной распоркой"
                            },
                            {
                                "target_lang_word": "идти наискось",
                                "target_lang_sense_clarification": "быть направленным по диагонали в качестве подпорки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87477360-829f-3a6b-b07d-d268bf386014",
                    "sense_definition": "A proud, stiff, or pompous way of walking.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proud_walk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He entered the dining hall with a confident <w>strut</w> that drew attention.",
                            "target_lang_translations": {
                                "ru": "Он вошёл в столовую уверенной <w>походкой</w>, привлекшей всеобщее внимание."
                            }
                        },
                        {
                            "text": "The actor adopted a comical <w>strut</w> to play the arrogant nobleman.",
                            "target_lang_translations": {
                                "ru": "Актёр перенял комично-<w>напыщенную походку</w>, чтобы сыграть высокомерного дворянина."
                            }
                        }
                    ],
                    "synonyms": [
                        "swagger"
                    ],
                    "common_phrases": [
                        "cocky strut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гордая, чванливая, напыщенная или самоуверенная походка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "важная походка",
                                "target_lang_sense_clarification": "походка человека, желающего произвести впечатление"
                            },
                            {
                                "target_lang_word": "самодовольная походка",
                                "target_lang_sense_clarification": "уверенная походка напоказ"
                            },
                            {
                                "target_lang_word": "походка гоголем",
                                "target_lang_sense_clarification": "развязная и чванливая походка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc6c85f8-5f46-3715-a50f-bb1fab99a5ca",
                    "sense_definition": "A rigid bar or rod fitted into a structure or vehicle to resist compression and provide support.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic inspected the damaged suspension <w>strut</w> beneath the car.",
                            "target_lang_translations": {
                                "ru": "Механик осмотрел повреждённую амортизаторную <w>стойку</w> под автомобилем."
                            }
                        },
                        {
                            "text": "Each wing of the biplane was reinforced with a sturdy metal <w>strut</w>.",
                            "target_lang_translations": {
                                "ru": "Каждое крыло биплана было укреплено прочным металлическим <w>подкосом</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "suspension strut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жёсткий стержень, брус или балка, работающие на сжатие и обеспечивающие устойчивость конструкции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "вертикальный или наклонный несущий элемент, например, амортизаторная стойка"
                            },
                            {
                                "target_lang_word": "распорка",
                                "target_lang_sense_clarification": "деталь конструкции, работающая на сжатие"
                            },
                            {
                                "target_lang_word": "подкос",
                                "target_lang_sense_clarification": "наклонная подпорка в строительных или авиационных конструкциях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae8e7b54-2d2c-3954-bfe1-05a1ad24d313",
                    "sense_definition": "The act of bracing something with supports, or the deviation of a wheel spoke from its normal alignment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "structural_support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer checked the wheel for any improper <w>strut</w> among the spokes.",
                            "target_lang_translations": {
                                "ru": "Инженер проверил колесо на предмет неправильного <w>перекоса</w> спиц."
                            }
                        },
                        {
                            "text": "Excessive pressure caused an abnormal <w>strut</w> in the alignment of the rim.",
                            "target_lang_translations": {
                                "ru": "Чрезмерное давление вызвало ненормальный <w>перекос</w> в геометрии обода."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрепление подпорками либо отклонение спицы колеса от нормального положения (развал/наклон)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расклинивание",
                                "target_lang_sense_clarification": "установка распорок"
                            },
                            {
                                "target_lang_word": "перекос",
                                "target_lang_sense_clarification": "отклонение спицы или обода колеса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fbcb319-ab12-33f3-bbd4-63d311f9c345",
                    "sense_definition": "An instrument historically used for adjusting or shaping the pleats of a neck ruff.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tailor used a small metal <w>strut</w> to shape the stiff neckwear.",
                            "target_lang_translations": {
                                "ru": "Портной использовал небольшое металлическое <w>приспособление</w>, чтобы придать форму жёсткому воротнику."
                            }
                        },
                        {
                            "text": "In the museum display, a vintage <w>strut</w> lay beside seventeenth-century collars.",
                            "target_lang_translations": {
                                "ru": "В музейной витрине старинные <w>щипцы для плойки</w> лежали рядом с воротниками XVII века."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Исторический инструмент для расправления и укладки складок воротника-жабо или гофрированного воротника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щипцы для плойки",
                                "target_lang_sense_clarification": "приспособление для придания формы складкам воротника"
                            },
                            {
                                "target_lang_word": "приспособление для гофрирования",
                                "target_lang_sense_clarification": "инструмент для воротников-фрез"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c4c8144f-f7c8-3aa7-a81e-f726389cb64a",
                    "sense_definition": "Intoxicated or drunk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After several pints of ale at the tavern, the traveler was entirely <w>strut</w>.",
                            "target_lang_translations": {
                                "ru": "После нескольких пинт эля в таверне путник был совершенно <w>пьян</w>."
                            }
                        },
                        {
                            "text": "The noisy patrons became quite <w>strut</w> before midnight arrived.",
                            "target_lang_translations": {
                                "ru": "Шумные посетители изрядно <w>захмелели</w> ещё до наступления полуночи."
                            }
                        }
                    ],
                    "synonyms": [
                        "drunk",
                        "tipsy",
                        "inebriated"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "sense is archaic or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пьяный, находящийся в состоянии алкогольного опьянения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пьяный",
                                "target_lang_sense_clarification": "находящийся под воздействием алкоголя"
                            },
                            {
                                "target_lang_word": "хмельной",
                                "target_lang_sense_clarification": "навеселе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd83e798-bdb6-3c66-8a98-2e66c7f65180",
                    "sense_definition": "Swollen, protuberant, or bulging outward due to fullness.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bulge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The udders of the cow were full and <w>strut</w> before milking.",
                            "target_lang_translations": {
                                "ru": "Вымя коровы перед дойкой было полным и <w>набухшим</w>."
                            }
                        },
                        {
                            "text": "They admired the <w>strut</w> sails catching the evening breeze.",
                            "target_lang_translations": {
                                "ru": "Они любовались <w>туго надутыми</w> парусами, ловящими вечерний бриз."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "sense is archaic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздутый, набухший или выпирающий от наполненности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "набухший",
                                "target_lang_sense_clarification": "наполненный до предела"
                            },
                            {
                                "target_lang_word": "раздутый",
                                "target_lang_sense_clarification": "надутый от ветра или содержимого"
                            },
                            {
                                "target_lang_word": "тугой",
                                "target_lang_sense_clarification": "натянутый от переполнения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}