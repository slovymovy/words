                                    {
                                        "sense_id": "02929ef0-e740-3493-88a3-52683c59bd67",
                                        "entry_id": "27366026-00ab-342b-8f97-9488acf0995c",
                                        "glosses": [
                                            "der Sonntag nach Ostern, letzter der acht Tage der Osteroktav, „zweiter Sonntag der Osterzeit“ (nach katholischer Zählung)"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "116da424-8518-483d-bf84-64ff34068699",
                                                "sense_id": "02929ef0-e740-3493-88a3-52683c59bd67",
                                                "text": "„Seit Jahrhunderten ist in der katholischen Kirche der Weiße Sonntag traditionell der Tag für die feierliche Erstkommunion der Kinder. Wegen der Osterferien wählen viele Pfarreien dafür inzwischen einen anderen, meist späteren Termin.“"
                                            },
                                            {
                                                "example_id": "190d5e5f-d83b-4062-abeb-cc072cbd4b92",
                                                "sense_id": "02929ef0-e740-3493-88a3-52683c59bd67",
                                                "text": "„Maries Vater verkaufte nicht einmal Gebetbücher, obwohl das eine Möglichkeit gewesen wäre, besonders vor den Weißen Sonntagen ein bißchen Geld zu verdienen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
