                            {
                                "example_id": "975e3a83-2bdb-4ad1-ad2e-123776cdc50a",
                                "sense_id": "f5c293d1-0f49-3093-9cb4-05644df38f0c",
                                "text": "Het stagejaar moet hen stimuleren hun verantwoordelijkheid voor de gemeente te nemen en te ontdekken waar ze hun gaven kunnen inzetten, aldus de HGJB."
                            },
                            {
                                "example_id": "f5e26d1e-3904-4431-a76e-555411954605",
                                "sense_id": "f5c293d1-0f49-3093-9cb4-05644df38f0c",
                                "text": "Zij is een ‘haio’ (huisarts in opleiding) en inmiddels bezig aan haar negende jaar opleiding. “Dit en vorig jaar zijn stagejaren. Lessen volgen zijn er niet echt meer bij, tenzij facultatief. We moeten wel nog een thesis maken. Om de twee weken komen we samen met collega-haio’s om patiëntengevallen en andere problemen of vragen te bespreken.”de Standaard 11/02/2014 om 11:25 door (wv)"
                            }
