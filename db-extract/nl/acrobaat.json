                ],
                "senses": [
                    {
                        "sense_id": "972898ca-4938-30ff-ae89-398d483acb3b",
                        "entry_id": "fe4fa56a-b8c7-3b98-908e-9841f354e1fb",
                        "glosses": [
                            "artiest die allerlei moeilijke gymnastische toeren uithaalt (vaak werkend in een circus)"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "050c7fe5-e062-4631-9b9d-039d5b382ced",
                                "sense_id": "972898ca-4938-30ff-ae89-398d483acb3b",
                                "text": "Had zijn ontslag bij het circus van de frivole acrobaat een zelfingenomen laffe dikzak van hem gemaakt? Had hij zijn levenslust in een permanente sluimer gesust door zich te committeren aan een norm die hij stiekem evenveel verachtte als zijn overgebleven vrienden heimelijk deden?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08071c9c-c7af-46c0-b67c-4b53ed97f7f8",
                        "source_entry_id": "fe4fa56a-b8c7-3b98-908e-9841f354e1fb",
                        "source_sense_id": "972898ca-4938-30ff-ae89-398d483acb3b",
                        "source_sense_description": "gymnast",
                        "target_lang_word": "Akrobat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akrobat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "393e7578-c64b-3239-a7dd-3cf20be7fd54",
                                        "entry_id": "22519b3f-0953-3a79-8dad-70b1ac92a532",
                                        "glosses": [
                                            "Variété- oder Zirkuskünstler, der ungewöhnliche, besondere Geschicklichkeit erfordernde körperliche Leistungen vollbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14aa6746-eed8-4f9b-9cb2-efe6904c4d52",
                                                "sense_id": "393e7578-c64b-3239-a7dd-3cf20be7fd54",
                                                "text": "Die Akrobaten vollbringen auf dem Hochseil erstaunliche Leistungen."
                                            },
                                            {
                                                "example_id": "f7f9e9b7-7695-49b5-ad10-20887da377a1",
                                                "sense_id": "393e7578-c64b-3239-a7dd-3cf20be7fd54",
                                                "text": "„Akrobaten unterhalten die Gäste mit ihren Kunststücken.“"
                                            },
                                            {
                                                "example_id": "7e2d4f75-5766-4c42-a58a-607296eb76e7",
                                                "sense_id": "393e7578-c64b-3239-a7dd-3cf20be7fd54",
                                                "text": "„Der Akrobat hat noch etwas zu trinken angenommen.“"
                                            },
                                            {
                                                "example_id": "53cb5ee7-b634-4801-b016-2d0a131dfb28",
                                                "sense_id": "393e7578-c64b-3239-a7dd-3cf20be7fd54",
                                                "text": "„Gelenkig wie ein Akrobat kletterte er über drei Stuhlreihen, schwang sich auf die Empore und blieb schließlich vor Helens Tisch stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c09ed29-e4c4-40a1-8a04-e8c5ba9c5418",
                        "source_entry_id": "fe4fa56a-b8c7-3b98-908e-9841f354e1fb",
                        "source_sense_id": "972898ca-4938-30ff-ae89-398d483acb3b",
                        "source_sense_description": "gymnast",
                        "target_lang_word": "acrobat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrobat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a112b0b1-0538-39d0-8092-c1572e198a11",
                                        "entry_id": "bf6670bf-36cf-38f9-be9d-7072a64a755f",
                                        "glosses": [
                                            "An athlete who performs acts requiring skill, agility and coordination, often as part of a circus performance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "acrobat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "030e4368-898e-3dde-a85a-810074ee6b7d",
                                        "entry_id": "68e1bcb7-7200-3bf6-a23e-abc238009bdf",
                                        "glosses": [
                                            "To practise acrobatics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323a6976-9617-4ae8-805c-93d48cba0584",
                                                "sense_id": "030e4368-898e-3dde-a85a-810074ee6b7d",
                                                "text": "Tumbling is different from posturing, and means throwing summersets and walking on your hands; and acrobating means the two together […]"
                                            },
                                            {
                                                "example_id": "0a353278-1253-4ebf-8bee-178771add5ae",
                                                "sense_id": "030e4368-898e-3dde-a85a-810074ee6b7d",
                                                "text": "They seem to think as clowning and acrobating is a downright paradise, and comes as naturally to anybody as the measles."
                                            },
                                            {
                                                "example_id": "3b13e409-887c-4b88-8070-4809e78a6eef",
                                                "sense_id": "030e4368-898e-3dde-a85a-810074ee6b7d",
                                                "text": "Mother was teaching me the tight-rope; I’d learned a bit of acrobating, too."
                                            },
                                            {
                                                "example_id": "f1e42cf5-0a7a-495b-bb06-fec7db8482c0",
                                                "sense_id": "030e4368-898e-3dde-a85a-810074ee6b7d",
                                                "text": "The others were fairly hulking teenagers in terrible costumes and makeup, who tapped, acrobated, sang, recited, played saxoophones, and did bad magic […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                        "entry_id": "68e1bcb7-7200-3bf6-a23e-abc238009bdf",
                                        "glosses": [
                                            "To move like an acrobat (with agility, balance, long leaps, etc.)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e56d1ee-6105-439e-9189-17eeeeea6fce",
                                                "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                                "text": "We have known […] veteran reporters, so dumbfounded and confounded by the first fire of Ralph, and his grand and lofty acrobating in elocution, that they up, seized their hat and paper, and sloped, horrified at the prospect of an attempt to “take down” Mr. Emerson."
                                            },
                                            {
                                                "example_id": "75ad018a-d195-4342-bd81-94c03e7daf96",
                                                "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                                "text": "[…] I laughed at the very idea of one of those heavy-pouched, blue-clad fellows catching hold of an agile fellow like I was, who had on more than one occasion acrobated from the engine’s tender back to the rear end of the caboose, by swinging and vaulting from truck to truck, underneath long freight trains running at top speed, with no member of the ever-alert train crew having discovered him."
                                            },
                                            {
                                                "example_id": "42bc0389-9e36-42f9-8d23-dc7bda26599e",
                                                "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                                "text": "He acrobated into a shirt, pulled up the pants of his good suit, arching to draw them high […]"
                                            },
                                            {
                                                "example_id": "8c578450-65ae-4d3b-b011-03baf1a44108",
                                                "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                                "text": "Here [in the stage show] was all the paraphernalia I longed for—slit skirts, suntanned thighs, boleros, sequins, saucy looks, legs askew and whole bevies of girls acrobating gracefully while covering their more pertinent parts with fans or gigantic powder puffs."
                                            },
                                            {
                                                "example_id": "336dce1c-217f-4dbd-a45e-93d33b800cc2",
                                                "sense_id": "66789d33-6f6b-3362-9663-5f1b740d31e2",
                                                "text": "the blood-red cardinal acrobating about in his holly bush"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "676cdbea-e53d-4673-90de-cd3ddb26ab3b",
                        "source_entry_id": "fe4fa56a-b8c7-3b98-908e-9841f354e1fb",
                        "source_sense_id": "972898ca-4938-30ff-ae89-398d483acb3b",
                        "source_sense_description": "gymnast",
                        "target_lang_word": "acrobate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acrobate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                        "entry_id": "c1368bea-2ffb-3bed-bc50-e574407fc0b5",
                                        "glosses": [
                                            "Artiste de cirque, danseur, (ou danseuse) de corde qui exécute des tours d’agilité devant un public populaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23d34f17-0e9c-443b-b599-468dc55e21d9",
                                                "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                                "text": "Léotard, le célèbre acrobate, était atteint de la petite vérole. Chez cet athlète, alors dans la force de l’âge, la maladie avait pris tout d’un coup une violence extrême. Il délirait sans repos."
                                            },
                                            {
                                                "example_id": "d65903b8-19c6-43cf-ab0e-5f2aa8840e2d",
                                                "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                                "text": "Cependant, la jeune acrobate continuait ses tours subtils et périlleux. Elle marchait sur les mains, la jupe retournée, les pieds pendants en avant de la tête, entre des épées tranchantes et de longues pointes aiguës."
                                            },
                                            {
                                                "example_id": "2ff4b94f-6b20-41a9-8034-8c25e672c206",
                                                "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                                "text": "Baldi m’avait, par horreur du \"mort\", appris le whist et à tricher.\nJongleur, escamoteur, prestidigitateur, acrobate; les premiers temps que celui-vint chez nous, mon imagination sortait à peine du long jeûne à quoi l’avait soumise Heldenbruck ; j’étais affamé de merveilles, crédule et de tendre curiosité."
                                            },
                                            {
                                                "example_id": "ad877c6d-5a3e-41f0-b7a2-46b460bf23cb",
                                                "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                                "text": "C’était un « melon » qui naturellement, subissait toutes les phases du cabossage et de l’aplatissement. Son possesseur avait beau le retaper, l’épousseter, le placer à distance, une fatalité sournoise voulait que, tout à coup, tantôt l’un, tantôt l’autre des acrobates s’élançât à pieds joints sur lui."
                                            },
                                            {
                                                "example_id": "1a243dfc-2c93-4a7a-bbce-f72c86fd42a3",
                                                "sense_id": "668e7b31-768c-302c-94c7-50fa5fc89ce3",
                                                "text": "C’était un numéro de passing notamment, à deux trapèzes et neuf massues. Loco y assurait la réception au sol, renvoyant aux deux acrobates qui se croisaient en mouvement synchronisé les massues tournoyantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3963a203-4b51-3da1-8086-c948dd1d4c96",
                                        "entry_id": "c1368bea-2ffb-3bed-bc50-e574407fc0b5",
                                        "glosses": [
                                            "Illusionniste, imposteur, demi-savant suffisant, plein d’assurance ou de mépris pour les spécialistes confirmés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "243f4983-6a44-4c3c-ad25-2cb95912a819",
                                                "sense_id": "3963a203-4b51-3da1-8086-c948dd1d4c96",
                                                "text": "Hume ou tout autre acrobate réussira mieux en se faisant passer pour sorcier, possesseur d’un don surnaturel, que de dire que par l’étude il est arrivé à faire illusion; on aime toujours [mieux] croire au merveilleux qu’au réel."
                                            },
                                            {
                                                "example_id": "de0943f1-72c1-426d-90b3-6e93af5d24a4",
                                                "sense_id": "3963a203-4b51-3da1-8086-c948dd1d4c96",
                                                "text": "Jongleur de mots, acrobate d’idées. Il lançait à tour de bras des boules merveilleuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
