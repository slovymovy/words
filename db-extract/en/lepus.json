                        "target_lang_word": "Hase",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hase",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "Säugetier mit langen Ohren aus der Gattung Lepus, speziell der Feldhase"
                                        ],
                                        "tags": [
                                            "L. europaeus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e36e1350-7b02-49f0-83f7-530431c398b0",
                                                "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                                "text": "Der Hase gehört zum Niederwild."
                                            },
                                            {
                                                "example_id": "3efe7406-e0db-4da2-8c11-9687f9f94fdf",
                                                "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                                "text": "„Ein Hase lief über die Wiese.“"
                                            },
                                            {
                                                "example_id": "84742d6f-c9ea-4486-861e-a155e7e025a3",
                                                "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                                "text": "Ist es nach den jagdgesetzlichen Bestimmungen erlaubt, Hasen und Wildenten mit der Kugel zu erlegen? [Antwort: ja]"
                                            },
                                            {
                                                "example_id": "696c7c0c-4997-4377-8d37-89087edcf641",
                                                "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                                "text": "Der Hase ist durch seine langen Hinterbeine generell sehr flink, macht häufig hohe Sprünge, schlägt Haken und stellt sich zur Beobachtung der Lage auch öfter auf die Hinterbeine."
                                            },
                                            {
                                                "example_id": "97af07e6-d061-4c4a-80bd-d09df20a5cd7",
                                                "sense_id": "83cbd2c1-0559-356a-8801-dfc08a2b246e",
                                                "text": "„Es hatte den Anschein, als würde Milka im nächsten Augenblick den Hasen packen, allein sie holte ihn zwar ein, sauste aber an ihm vorbei, da der Hase einen Haken geschlagen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f864e5d-742a-35a4-b9f3-0d2a37da7eba",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "Kaninchen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d51ca3f-6650-41d5-9bab-1adfe2aae089",
                                                "sense_id": "2f864e5d-742a-35a4-b9f3-0d2a37da7eba",
                                                "text": "Hast du deinen Hasen schon gefüttert?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ee6b55c9-d50a-33d8-b6de-7d5e9bb55e8b",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "Kosewort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc78988c-9620-4a61-9bc5-067cb1a402b2",
                                                "sense_id": "ee6b55c9-d50a-33d8-b6de-7d5e9bb55e8b",
                                                "text": "Kaffee, mein Hase?"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b9f6b5c7-a1e4-309b-a49b-f8b5bc2d3e4d",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "Ausdruck für eine junge Frau"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43c3a200-52fe-4e1e-aa53-9e9d3ccbe33c",
                                                "sense_id": "b9f6b5c7-a1e4-309b-a49b-f8b5bc2d3e4d",
                                                "text": "Wenn ich so durch die Straßen geh', / Rufen alle Hasen: „He! Ein Wahnsinn!“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "98a8c32e-b458-3efe-8b4d-1f213e1c0dd1",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "die Tierfamilie, zu der Hase^([1]) und Kaninchen gehören"
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66410806-2878-440a-90a4-085bd6aa0397",
                                                "sense_id": "98a8c32e-b458-3efe-8b4d-1f213e1c0dd1",
                                                "text": "Wie der Volksmund zu Recht vermutet, gehört das Kaninchen zu den Hasen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d50e342d-2c50-3b70-9eeb-5fa63c967325",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "ein Begleiter, der außer Konkurrenz läuft"
                                        ],
                                        "tags": [
                                            "beim Langstreckenlauf"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30068f9-6135-4f14-9cdb-e786085be75e",
                                                "sense_id": "d50e342d-2c50-3b70-9eeb-5fa63c967325",
                                                "text": "Die Läuferin hat einen berühmten Hasen dabei."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "5383847f-9aa0-3803-bbfa-894b2daf93cb",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "ein Sternbild nahe dem Orion"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd2a6bc2-f85e-4a7c-a9bd-cf1814e254fc",
                                                "sense_id": "5383847f-9aa0-3803-bbfa-894b2daf93cb",
                                                "text": "Der Hase steht beim Jäger Orion und seinem Hund."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "fdacdfa2-5208-3164-90bf-c46cbd900041",
                                        "entry_id": "a7b1debb-7a64-352a-9493-26a4a2dd4119",
                                        "glosses": [
                                            "das Fleisch des Hasen^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9b0dd10-5aaf-44eb-98dd-9cf5510d9ed8",
                                                "sense_id": "fdacdfa2-5208-3164-90bf-c46cbd900041",
                                                "text": "Mein Leibgericht ist Hase in Pfefferrahmsoße mit Kartoffeln."
                                            }
                                        ],
