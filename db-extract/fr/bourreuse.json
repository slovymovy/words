                                        "examples": [
                                            {
                                                "example_id": "93ddc412-1dc9-46f7-bbff-968d2e0ddd7d",
                                                "sense_id": "2f9e2efd-97e1-30d1-9306-132dd3c15a4c",
                                                "text": "By 1958, there will be available for service 100 ballast tamping machines and 16 ballast cleaning machines."
                                            },
