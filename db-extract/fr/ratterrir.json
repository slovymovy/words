                "senses": [
                    {
                        "sense_id": "5a8147c4-abaf-36cc-99ec-1f3347c1d577",
                        "entry_id": "d6424c9c-4cd1-3878-a4dc-20b08ddbd2c4",
                        "glosses": [
                            "Atterrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91f833a9-7614-4df2-900c-8bef2ef42f24",
                                "sense_id": "5a8147c4-abaf-36cc-99ec-1f3347c1d577",
                                "text": "Je fléchis les genoux et sautai pour ne pas ratterrir."
                            },
                            {
                                "example_id": "91d0a2df-f457-4c3e-b71c-c2a9cf8b246d",
                                "sense_id": "5a8147c4-abaf-36cc-99ec-1f3347c1d577",
                                "text": "[…] rebondir, recommencer, jeter, brûler, veiller, découper patiemment le cadavre de l’ennui, de la lassitude et du remords, noter tout cela, vite, sauter de la théologie à la peinture, ratterrir sur Joyce, scander Céline, en saisir la fragilité, la nécessité, l’audace, la force, s’imprégner, composer, s’acoustiquer, imprimer, disposer ses papiers à terre, tenter d’en avoir une vue plongeante, apprendre à voler, alouette, faucon, buse, apercevoir quelque chose, fondre, être trop lent, mal emplumé, s’écraser, échapper la proie, maudire, foutre un grand coup de semelle dans ce fatras, brûler, pleurer de découragement, se rappeler à propos un passage dans tel chapitre à moitié écrit, qui ferait un excellent contrepoint à l’autre là […]"
                            }
                        ]
                    }
                ],
