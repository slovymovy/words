{
    "word_family": [
        "stijgen",
        "opstijgen",
        "afstijgen",
        "overstijgen",
        "stijging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0901f18-df36-31d1-ab04-d33981165705",
                    "sense_definition": "Beter, groter of belangrijker zijn dan een bepaald niveau, norm of anderen; figuurlijk boven iets of iemand uitsteken.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "overtreffen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wilde met haar prestaties <w>uitstijgen</w> boven de rest van de klas.",
                            "target_lang_translations": {
                                "en": "She wanted to <w>rise above</w> the rest of the class with her achievements."
                            }
                        },
                        {
                            "text": "De jonge kunstenaar wist met zijn unieke stijl <w>uit</w> te <w>stijgen</w> boven het gemiddelde niveau.",
                            "target_lang_translations": {
                                "en": "With his unique style, the young artist managed to <w>rise above</w> the average level."
                            }
                        }
                    ],
                    "synonyms": [
                        "overstijgen",
                        "overtreffen",
                        "uitblinken"
                    ],
                    "antonyms": [
                        "onderdoen"
                    ],
                    "common_phrases": [
                        "boven de rest uitstijgen",
                        "boven het gemiddelde uitstijgen"
                    ],
                    "target_lang_definitions": {
                        "en": "To rise above, exceed, or surpass a certain level, standard, or others; figuratively to stand out above something or someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rise above",
                                "target_lang_sense_clarification": "to exceed or surpass a level or standard"
                            },
                            {
                                "target_lang_word": "surpass",
                                "target_lang_sense_clarification": "to be better or greater than"
                            },
                            {
                                "target_lang_word": "exceed",
                                "target_lang_sense_clarification": "to go beyond a certain limit or average"
                            },
                            {
                                "target_lang_word": "transcend",
                                "target_lang_sense_clarification": "to rise above or go beyond the limits of"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8547b1a-43da-3163-baa1-57fc6a2c29d1",
                    "sense_definition": "Het verlaten van een voertuig of rijdier door naar beneden te stappen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verlaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange rit mochten de ruiters eindelijk <w>uitstijgen</w> van hun paarden.",
                            "target_lang_translations": {
                                "en": "After a long ride, the riders were finally allowed to <w>dismount</w> from their horses."
                            }
                        },
                        {
                            "text": "De passagiers moesten snel <w>uitstijgen</w> toen de koets tot stilstand kwam.",
                            "target_lang_translations": {
                                "en": "The passengers had to <w>alight</w> quickly when the carriage came to a standstill."
                            }
                        }
                    ],
                    "synonyms": [
                        "afstijgen",
                        "uitstappen"
                    ],
                    "antonyms": [
                        "instijgen",
                        "opstijgen"
                    ],
                    "common_phrases": [
                        "uit het rijtuig uitstijgen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Voornamelijk gebruikt in historische of formele contexten voor het afstappen van paarden of koetsen."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To dismount or alight from a vehicle or mount by stepping down."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismount",
                                "target_lang_sense_clarification": "to get off a horse"
                            },
                            {
                                "target_lang_word": "alight",
                                "target_lang_sense_clarification": "to step down from a carriage or vehicle"
                            },
                            {
                                "target_lang_word": "get off",
                                "target_lang_sense_clarification": "to descend from a horse or vehicle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}