                "senses": [
                    {
                        "sense_id": "af1fc691-fbd1-3698-8e59-e0ee7a5c5db6",
                        "entry_id": "c38372a7-8ca7-38bc-b10a-fbdc5c5c993c",
                        "glosses": [
                            "Apparition de gouttelettes d'eau, au petit matin, aux extrémités ou aux bords des feuilles chez certaines plantes vasculaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5a2a392-93e7-4106-98f1-199c36b1ff74",
                                "sense_id": "af1fc691-fbd1-3698-8e59-e0ee7a5c5db6",
                                "text": "Pour l’UNAF, l'avis de l’EFSA – qui souligne aussi la dangerosité de ces insecticides au stade de la guttation (l'exsudation, par la plante, de gouttelettes d'eau imprégnées du pesticide) – appelle une réponse plus radicale, pas seulement pour les cultures attractives pour les abeilles."
                            },
                            {
                                "example_id": "486265dd-020d-4137-ac5e-c747fccd4da2",
                                "sense_id": "af1fc691-fbd1-3698-8e59-e0ee7a5c5db6",
                                "text": "Cette croûte résulte d’une sudation – pour les végétaux, on parle de guttation – par des sortes de pores appelés hydathodes, en général proches de la bordure des feuilles."
                            }
                        ]
                    }
