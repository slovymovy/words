                        "examples": [
                            {
                                "example_id": "f3f02e68-505b-4b76-a070-ccdd138def22",
                                "sense_id": "db58f6d4-3af6-3404-986e-0687c42e1dec",
                                "text": "C’est toujours le même aspect granuleux, amorphe, quelconque, ressemblant vaguement à un corps amœbiforme, mais figé dans sa forme."
                            },
                            {
                                "example_id": "42f31518-4e0b-4e52-a1cd-7a810c23d29a",
                                "sense_id": "db58f6d4-3af6-3404-986e-0687c42e1dec",
                                "text": "Toutefois, l’auteur, malgré le caractère amœbiforme que présente souvent le parasite, n’a pas observé de mouvements ni de changements de forme rappelant ceux des Amibes."
                            }
                        ]
