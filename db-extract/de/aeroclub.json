                    {
                        "sense_id": "c26ed3ea-74cf-3a84-93bf-4863e0ea0e11",
                        "entry_id": "85289501-1a26-3b11-8d02-99baf0069996",
                        "glosses": [
                            "Verein für Flugsport, insbesondere für Sportflieger, Segelflieger und Fallschirmspringer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5aab82-d099-493f-8f12-d520ec628a6c",
                                "sense_id": "c26ed3ea-74cf-3a84-93bf-4863e0ea0e11",
                                "text": "„Die meisten der rund zwölf Modelle, mit denen gegenwärtig in England, Japan und Österreich an technischen Hochschulen und in Aeroclubs das Muskelfliegen betrieben wird, sind Kombinationen von einem Segelflugzeug mit einem Fahrrad.“"
                            },
                            {
                                "example_id": "996a9752-3a13-4a94-85e8-8f2042a71efe",
                                "sense_id": "c26ed3ea-74cf-3a84-93bf-4863e0ea0e11",
                                "text": "„Der Aeroclub Hoyerswerda hat seit einiger Zeit auch eine Sektion Gleitschirmfliegen. Auch mitten im platten Flachland wird diese Trend-Luftsportart also betrieben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
