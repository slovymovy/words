                            {
                                "example_id": "385ea1ce-e9d9-4761-a875-8e80c8fc71da",
                                "sense_id": "971377e2-dcf3-3487-bcc2-a475c0b588b5",
                                "text": "Le nombre des auteurs devait être immense en un temps où l’écrivain était son propre éditeur, le poète son propre incitateur, le dramaturge son propre acteur, mais l’homme mort, l’œuvre disparaissait."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8aac007-6ff2-42e2-bc81-f8333d9baf58",
                        "source_entry_id": "40db399b-8aef-36c9-ba84-9b482535aca5",
                        "source_sense_id": "971377e2-dcf3-3487-bcc2-a475c0b588b5",
                        "target_lang_word": "Anstifter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anstifter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8e75cfb-47ed-3bb7-9cce-75f3ffcbed35",
                                        "entry_id": "b16700d2-eabf-369e-884f-448c1ca6134f",
                                        "glosses": [
                                            "Person, die jemand dazu veranlasst, etwas Falsches/Unrechtmäßiges zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7de9ab1b-2891-4074-ae27-039a167db39c",
                                                "sense_id": "c8e75cfb-47ed-3bb7-9cce-75f3ffcbed35",
                                                "text": "„Einen oder zwei Tage später sagte mir Pater Giorgi, das Tagesgespräch in Rom sei die mißlungene Entführung der Tochter des Advokaten Dalacqua; man halte mich für den Anstifter der ganzen Sache, und das mißbillige er sehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9b19cd3-6e40-44b7-a631-ad283f3f1ada",
                        "source_entry_id": "40db399b-8aef-36c9-ba84-9b482535aca5",
                        "source_sense_id": "971377e2-dcf3-3487-bcc2-a475c0b588b5",
                        "target_lang_word": "Verführer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verführer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                        "entry_id": "54e91b65-e6d1-3f22-be23-873a6d43fe97",
                                        "glosses": [
                                            "jemand, der jemand anderen zu etwas bringt, das dieser nicht ohnehin beabsichtigt hatte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8558578-b38b-46a5-b94a-ab6157fd5b23",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Der wahre Verführer beginnt das Vorspiel am Herd.“"
                                            },
                                            {
                                                "example_id": "40ba8c06-c5a3-4d38-bf3e-88b2ba70d01d",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Im Lehrtheater lernt das Kind, wie eine Ampel funktioniert, wie man sicher eine Straße überquert, welche Verkehrszeichen, Einrichtungen oder Menschen helfen, wo Verführer und Gefahren lauern und wie man sich gegen sie wehren kann.“"
                                            },
                                            {
                                                "example_id": "2ce27e4a-605f-4e1a-8f32-13f0e39bacf2",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Wenn die Freundin sich, um nicht erröten zu müssen, eine ganz unbedeutende Gunst rauben läßt, wird sie die erste sein, die andere zu einer größeren anzuspornen; und wenn der Verführer geschickt ist, hat sich die Unschuldige bereits zu weit vorgewagt, um noch zurückweichen zu können.“"
                                            },
                                            {
                                                "example_id": "1eac1562-30e2-4b49-8396-3f847418da5b",
                                                "sense_id": "943e1186-78f0-3d2f-89fe-ca3dd4ffc5ef",
                                                "text": "„Blieb noch das ernste Bühnenstück oder das bürgerliche Trauerspiel, in dem untröstliche Familienväter, Diener, die ihre Herren retten, Reiche, die ihr Vermögen verschenken, unschuldige Näherinnen und ruchlose Verführer auftreten, ein Genre, das bei Diderot anfängt und sich bis zu Pixérécourt fortsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "017e1cb0-c459-4d43-bd9f-73af9a5e96ad",
                        "source_entry_id": "40db399b-8aef-36c9-ba84-9b482535aca5",
