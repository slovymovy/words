    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de3ca7e0-061b-3c00-9f2b-fe72c631d389",
                    "sense_definition": "Publication quotidienne ou périodique imprimée ou en ligne qui donne les nouvelles de l'actualité, avec des articles sur la politique, la société, la culture, le sport, etc.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presse et information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon père lit le <w>journal</w> tous les matins avec son café."
                        },
                        {
                            "text": "Les <w>journaux</w> annoncent de fortes pluies pour ce week-end."
                        },
                        {
                            "text": "Il achète un <w>journal</w> au kiosque en allant au travail."
                        }
                    ],
                    "synonyms": [
                        "canard"
                    ],
                    "common_phrases": [
                        "lire le journal",
                        "acheter un journal",
                        "article de journal",
                        "journal quotidien"
                    ]
                },
                {
                    "sense_id": "60f626ff-0168-350f-bbe2-19c2c2a143fa",
                    "sense_definition": "Émission de radio ou de télévision qui présente la synthèse des nouvelles du jour.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "presse et information",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as regardé le <w>journal</w> de vingt heures hier soir ?"
                        },
                        {
                            "text": "Le <w>journal</w> télévisé commence à vingt heures sur cette chaîne."
                        }
                    ],
                    "common_phrases": [
                        "journal télévisé",
                        "journal de vingt heures",
                        "regarder le journal"
                    ]
                },
                {
                    "sense_id": "10c90ae0-dc7e-3953-baf3-9c76f5100705",
                    "sense_definition": "Cahier personnel, considéré comme intime et secret, dans lequel une personne note ce qu'elle vit et ce qu'elle ressent, en principe jour après jour.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "document écrit quotidien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis l'adolescence, elle écrit chaque soir dans son <w>journal</w> intime."
                        },
                        {
                            "text": "Le <w>journal</w> d'Anne Frank est un témoignage célèbre sur la Seconde Guerre mondiale."
                        },
                        {
                            "text": "Ma sœur cache son <w>journal</w> sous son matelas pour que personne ne le lise."
                        }
                    ],
                    "synonyms": [
                        "journal intime"
                    ],
                    "common_phrases": [
                        "journal intime",
                        "tenir un journal",
                        "écrire dans son journal"
                    ]
                },
                {
                    "sense_id": "4640ab4a-d65c-3614-9238-cddab4167b85",
                    "sense_definition": "Document dans lequel on note, par ordre chronologique, les événements ou les opérations d'une période donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "document écrit quotidien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le capitaine note la météo dans le <w>journal</w> de bord chaque matin."
                        },
                        {
                            "text": "Le <w>journal</w> des erreurs du serveur permet de retrouver l'origine du problème."
                        }
                    ],
                    "common_phrases": [
                        "journal de bord",
                        "journal des événements",
                        "tenir un journal de bord"
                    ]
                },
