                "senses": [
                    {
                        "sense_id": "cbc354c6-314b-3451-9fdd-23e11f68ca74",
                        "entry_id": "0f436e16-658b-3b22-aa88-3e90fa09ce8e",
                        "glosses": [
                            "het hebben en dragen van (vuur)wapens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6f1a853-8250-4e5c-a8a2-b0104eb6118a",
                                "sense_id": "cbc354c6-314b-3451-9fdd-23e11f68ca74",
                                "text": "De rechter baseerde zich voor zijn oordeel op recente vonnissen, die het fundamenteel recht van een burger op wapenbezit voor zelfverdediging bevestigen. Op basis daarvan is er 'geen basis meer om te concluderen dat het verbod op wapendracht conform de grondwet is', zo citeert de krant de rechter."
                            },
                            {
                                "example_id": "9dd86683-2c91-4af3-b28a-c8e0cb237478",
                                "sense_id": "cbc354c6-314b-3451-9fdd-23e11f68ca74",
                                "text": "Wapendracht is voor veel extremisten een mannelijk voorrecht en ook de plannen om het drietal een aanslag uit te laten voeren, wekte kritiek. Met name bij de echtgenoot van de tweede Belgische vrouw. Die zat er niet zozeer mee dat hij zijn vrouw ging verliezen, maar vond wel dat terrorisme mannenwerk is."
                            }
                        ]
                    }
