                        ],
                        "examples": [
                            {
                                "example_id": "92f1ccc0-ba4d-423f-9f37-61251b9c0463",
                                "sense_id": "d87dbf36-be41-3607-adb7-fd43f9830f0d",
                                "text": "\"That's her real name, you know. I mean, a lot of girls working the topless joints, they take exotic, sexy names...well, Tiffany Carter, for example...but that was the name Tracy was born with.\""
                            },
                            {
                                "example_id": "0c4d4e42-4309-4297-b316-7d23dcf81b2e",
                                "sense_id": "d87dbf36-be41-3607-adb7-fd43f9830f0d",
                                "text": "Her name was Theresa (often Tracy) Oldenburg and she had eyes only for another young man, Richard Puls."
                            },
                            {
                                "example_id": "c0772e67-bc1e-418d-b6e2-29bc5d6a2ffe",
                                "sense_id": "d87dbf36-be41-3607-adb7-fd43f9830f0d",
                                "text": "His family, who live in West Des Moines, Iowa, have been left “devastated,” his owner Tracy Wolfe said in GWR press release. “He was just the best giant boy,” she added."
                            }
                        ]
                    },
