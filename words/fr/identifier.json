        "inidentifiable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "01f9bcc0-600b-32b1-9352-ebe8abc7e651",
                    "sense_definition": "Constater formellement l'identité d'une personne ou d'une chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reconnaissance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a rapidement réussi à <w>identifier</w> l'auteur de ce vol grâce aux caméras."
                        },
                        {
                            "text": "Le témoin doit <w>identifier</w> le suspect parmi plusieurs photographies présentées par les enquêteurs."
                        }
                    ],
                    "synonyms": [
                        "reconnaître"
                    ],
                    "common_phrases": [
                        "identifier un suspect",
                        "identifier la victime",
                        "identifier le problème"
                    ]
                },
                {
                    "sense_id": "c4b13cd1-a703-372b-848b-a63b795f29b2",
                    "sense_definition": "Établir son identité dans un système informatique pour accéder à un service.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez vous <w>identifier</w> avec votre adresse électronique avant de pouvoir commander en ligne."
                        },
                        {
                            "text": "Le site vous demande de vous <w>identifier</w> pour accéder à votre espace personnel sécurisé."
                        }
                    ],
                    "common_phrases": [
                        "s'identifier sur le site",
                        "s'identifier avec un mot de passe"
                    ]
                },
                {
                    "sense_id": "0e6e0934-7244-39d1-a47c-804c86647336",
                    "sense_definition": "Déterminer la nature, l'espèce ou l'origine d'un être ou d'un objet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le botaniste a examiné la feuille afin d'<w>identifier</w> avec certitude cette plante rare."
                        },
                        {
                            "text": "Les chercheurs tentent d'<w>identifier</w> la source exacte de cette nouvelle maladie infectieuse."
                        }
                    ],
                    "synonyms": [
                        "reconnaître"
                    ],
                    "common_phrases": [
                        "identifier une espèce",
                        "identifier une plante"
                    ]
                },
                {
                    "sense_id": "3d64e20e-0dd3-3c41-871b-60ae6d3509a4",
                    "sense_definition": "Considérer deux choses différentes comme identiques ou équivalentes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assimilation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tendance à <w>identifier</w> la réussite personnelle à la richesse matérielle."
                        },
                        {
                            "text": "On ne doit pas <w>identifier</w> ces deux concepts distincts sous une même idée générale."
                        }
                    ],
                    "synonyms": [
                        "assimiler",
                        "confondre"
                    ],
                    "antonyms": [
                        "différencier",
                        "discerner",
                        "distinguer"
                    ]
                }
            ]
        }
    ]
}