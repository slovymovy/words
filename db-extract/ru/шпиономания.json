                                "target_senses": [
                                    {
                                        "sense_id": "f3415ebd-f80a-3a7c-a9d7-dfee57425313",
                                        "entry_id": "30935418-dfbf-33a7-86e1-63388905a95c",
                                        "glosses": [
                                            "Paranoïa, délire de persécution qui fait croire qu'on est espionné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e25068-10da-43b1-a468-8fa03368268d",
                                                "sense_id": "f3415ebd-f80a-3a7c-a9d7-dfee57425313",
                                                "text": "Une espionite aigue."
                                            },
                                            {
                                                "example_id": "383174ee-5168-4883-80de-e9def5f4eae3",
                                                "sense_id": "f3415ebd-f80a-3a7c-a9d7-dfee57425313",
                                                "text": "À la Carlingue encore bien pire, je comprenais. L’espionnite entre eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
