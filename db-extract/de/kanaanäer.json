                                        "sense_id": "9c43ffd9-c9fe-33d5-b371-57903e966b4e",
                                        "entry_id": "a8a8b045-05cf-35dd-81f5-7c3e27b7b391",
                                        "glosses": [
                                            "Of or pertaining to this sect or its followers; Canaanitic."
                                        ],
