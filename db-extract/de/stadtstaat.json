                                        "entry_id": "a2480386-4edd-30dd-ba52-9f26f1393019",
                                        "glosses": [
                                            "A sovereign city, as in Ancient Greece, often part of a league of such cities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3837eecc-fe47-4066-a4c4-239d9d09e3f5",
                                                "sense_id": "e28e5b92-d782-38f5-8944-584d9ae317dc",
                                                "text": "Singapore is the world's most populous city state and the only island city-state in the world."
                                            },
                                            {
                                                "example_id": "b6628b42-9106-435a-ba02-7b67a6e46add",
                                                "sense_id": "e28e5b92-d782-38f5-8944-584d9ae317dc",
                                                "text": "The Vatican City State, a sovereign city-state, has a large number of embassies across the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab8ee384-5e35-45a8-b290-aa3d73daaf9e",
                        "source_entry_id": "b55aa9d6-68b4-3f04-90ba-73094b3ac3d8",
                        "source_sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                        "target_lang_word": "cité-État",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cité-État",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                        "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                                        "glosses": [
                                            "Espace géographique contrôlé exclusivement par une ville, qui possède généralement la souveraineté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99df7191-4d14-4a29-a4b0-32a43285d8b5",
                                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                                "text": "Singapour, cité-État, en troisième position de l’Indice mondial de l’innovation pour la deuxième année consécutive."
                                            },
                                            {
                                                "example_id": "08b6f0f5-dd7b-475b-854c-e1bb28e44f19",
                                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                                "text": "Athènes, Sparte et Thèbes étaient les trois plus puissantes cités-États de la Grèce antique."
                                            },
                                            {
                                                "example_id": "4082d1f9-8a30-4dcd-b8c3-da870441922c",
                                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                                "text": "Il a vu la République romaine, vieille cité-État inadaptée à l'immensité de ses conquêtes, vaciller et s'effondrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87a5523d-b417-3149-8ea5-63bd8bb3747b",
                                        "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                                        "glosses": [
                                            "Ville allemande qui constitue un land à elle seule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4688ffd-aaa5-4e6f-9d40-61dcb8197764",
                                                "sense_id": "87a5523d-b417-3149-8ea5-63bd8bb3747b",
                                                "text": "Berlin, Hambourg et Brême sont les trois cités-États allemandes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
