                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "531a5dd7-b42f-459e-b384-b5cc33e793ea",
                                "sense_id": "7c7414db-04a6-3274-900a-817a173e31a6",
                                "text": "Oui, il me semblait le voir, ce sourire, pitoyable, dédaignard et supérieur."
                            },
                            {
                                "example_id": "d322f2ba-d7ce-4623-a200-102a08855631",
                                "sense_id": "7c7414db-04a6-3274-900a-817a173e31a6",
                                "text": "Ils jugent simplement, tels des critiques qui ne sont pas auteurs eux-mêmes. D’en haut. Un petit peu dédaignards. Pour eux, tout artiste n’est qu'un amuseur, tout comédien ou chanteur, un guignol à leur solde, qu’ils admettent ou rejettent, le geste las."
                            },
                            {
                                "example_id": "5998d5ee-fd45-42d4-86b5-f88bee9f1149",
                                "sense_id": "7c7414db-04a6-3274-900a-817a173e31a6",
                                "text": "Certains critiques, qui ne se rendent au spectacle que pour faire des poids et haltères, ont salué d’une moue un rien dédaignarde ce divertissement."
                            }
                        ]
                    }
