                                                "sense_id": "9d24e91f-611d-3757-aaae-a0d62b32d2f9",
                                                "text": "Hejtman zastupuje kraj navenek."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d77680a4-35e4-333d-9c46-7aebacb1c993",
                                        "entry_id": "6b29cc77-2204-3746-a9db-ca7e0f9e0955",
                                        "glosses": [
                                            "úředník nebo politik stojící v čele (např. správního úřadu, země, léna, panství, hradu)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa30351-44d9-46ba-a948-aecfec21dbc0",
                                                "sense_id": "d77680a4-35e4-333d-9c46-7aebacb1c993",
                                                "text": "„Víš-li,“ rozkládal po chvíli soused dále, „že dosavadní konšelé i my obecní starší dneškem sesazeni a panem podkomořím a královským hejtmanem nová rada sazena?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15dfcdb1-b695-3d55-8a8d-8421c7874a4f",
                                        "entry_id": "6b29cc77-2204-3746-a9db-ca7e0f9e0955",
                                        "glosses": [
                                            "důstojnická hodnost v některých armádách"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13276344-f1de-45df-bf17-d978d8a378e0",
                                                "sense_id": "15dfcdb1-b695-3d55-8a8d-8421c7874a4f",
                                                "text": "Může být, že dnes hejtman Linhart i za republiky je dále hejtmanem. Přál bych si, aby mu byla započtena služební léta na garnizóně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08c9a56-b85f-3776-9879-f482aed57db5",
                                        "entry_id": "6b29cc77-2204-3746-a9db-ca7e0f9e0955",
