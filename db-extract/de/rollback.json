                "senses": [
                    {
                        "sense_id": "893b5895-4b56-3866-9545-6a631036fdbd",
                        "entry_id": "50d4e85a-de58-3773-9367-a668650a105b",
                        "glosses": [
                            "rückläufige Tendenz, rückschrittliche Entwicklung"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d0730c36-5ceb-3ed7-a423-5c684a58bdb2",
                        "entry_id": "50d4e85a-de58-3773-9367-a668650a105b",
                        "glosses": [
                            "Versuch, den Einfluss des Kommunismus während des Kalten Krieges zurückzudrängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76798b97-1ffb-4f24-a428-9a7fe283e628",
                                "sense_id": "d0730c36-5ceb-3ed7-a423-5c684a58bdb2",
                                "text": "Wenn auch Eisenhower und seine Mitarbeiter die Propaganda von „Befreiung“ und „Rollback“ nie aufgaben, stellte sich die konkrete „Befreiungs“-Politik nach dem DDR-Aufstand auf eine indirekte, friedliche, längerfristige Strategie ein."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3f16200d-3fcc-3d7e-a950-a91b46d00243",
                        "entry_id": "50d4e85a-de58-3773-9367-a668650a105b",
                        "glosses": [
                            "Abbruch eines Prozesses und anschließende teilweise oder ganze Wiederholung"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "1b20f2d7-54cd-40e9-a7d1-83ed1f7b8452",
                                "sense_id": "3f16200d-3fcc-3d7e-a950-a91b46d00243",
                                "text": "„Ein Rollback beschreibt eine Situation, in der der Prozess und damit einzelne Aktivitäten abgebrochen und teilweise oder ganz wiederholt werden muss.“"
                            },
                            {
                                "example_id": "ef3f6d48-304a-4c8b-ac54-b6f25dbbc72f",
                                "sense_id": "3f16200d-3fcc-3d7e-a950-a91b46d00243",
                                "text": "Das Rücksetzen einer Transaktion wird auch Rollback (rollback) oder Undo (undo) genannt und kann im laufenden Betrieb erfolgen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
