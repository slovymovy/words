                "senses": [
                    {
                        "sense_id": "344097f9-06c2-33e6-8b21-ef551cbb3dc6",
                        "entry_id": "3dbd9835-b9ca-3de4-b920-396f2faf15e3",
                        "glosses": [
                            "Qualifie une stratégie écologique où un agent pathogène se développe en deux phases successives : une première phase biotrophe où les cellules de l'hôte sont maintenues vivantes pendant leur colonisation et une deuxième phase nécrotrophe où le développement continue alors que ses cellules sont mortes."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "ee7fc140-8054-465a-9d74-8372d5ac356e",
                                "sense_id": "344097f9-06c2-33e6-8b21-ef551cbb3dc6",
                                "text": "L'un des exemples les plus connus d'agent pathogène hémibiotrophe est le champignon responsable de la pyriculariose du riz et du blé : Magnaporthe oryzae."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f38b3b52-6183-47b4-8fb5-822efab5a152",
                        "source_entry_id": "3dbd9835-b9ca-3de4-b920-396f2faf15e3",
                        "source_sense_id": "344097f9-06c2-33e6-8b21-ef551cbb3dc6",
                        "target_lang_word": "hemibiotrophic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hemibiotrophic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b088a80c-95ed-37b1-9fdc-8c2ea01928b2",
                                        "entry_id": "2964d0df-fa29-3b13-abb1-161c72de75cf",
                                        "glosses": [
                                            "Biotrophic in some circumstances, or some of the time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248b80d9-2042-4444-8761-449135c5bee0",
                                                "sense_id": "b088a80c-95ed-37b1-9fdc-8c2ea01928b2",
                                                "text": "Hemibiotrophic fungi include those that infect living tissue, similar to biotrophs, but after an extended incubation period of days or weeks the infected tissue dies, within which the fungus now continues to develop as a saprotroph, usually resulting in sporulation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
