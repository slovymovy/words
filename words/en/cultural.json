            "senses": [
                {
                    "sense_id": "0ca33537-bb47-313c-a011-df52015f4efc",
                    "sense_definition": "Relating to the ideas, customs, and social behavior of a society.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "culture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city offers a wide range of <w>cultural</w> activities, including museums, theaters, and art galleries.",
                            "target_lang_translations": {
                                "ru": "Город предлагает широкий спектр <w>культурных</w> мероприятий, включая музеи, театры и художественные галереи.",
                                "zh": "这座城市提供各种各样的<w>文化</w>活动，包括博物馆、剧院和美术馆。"
                            }
                        },
                        {
                            "text": "It is important to respect <w>cultural</w> differences when traveling to a foreign country.",
                            "target_lang_translations": {
                                "ru": "При поездке в чужую страну важно уважать <w>культурные</w> различия.",
                                "zh": "去国外旅行时，尊重<w>文化</w>差异非常重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "societal",
                        "ethnic",
                        "artistic"
                    ],
                    "common_phrases": [
                        "cultural heritage",
                        "cultural diversity",
                        "cultural identity",
                        "cultural background"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к идеям, обычаям и социальному поведению общества.",
                        "zh": "与一个社会的思想、习俗和社会行为有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "культурный",
                                "target_lang_sense_clarification": "связанный с культурой и традициями"
                            },
                            {
                                "target_lang_word": "просветительский",
                                "target_lang_sense_clarification": "связанный с образованием и искусством"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "文化的",
                                "target_lang_sense_clarification": "与文化、传统或社会习俗相关的"
                            },
                            {
                                "target_lang_word": "人文的",
                                "target_lang_sense_clarification": "侧重于人类文化活动或艺术方面的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "68de6717-4982-35c4-9381-e41862a3cf61",
                    "sense_definition": "Resulting from or influenced by human activity rather than occurring naturally.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "human_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist studied the <w>cultural</w> landscape to see how farming had changed the environment.",
                            "target_lang_translations": {
                                "ru": "Ученый изучил <w>культурный</w> ландшафт, чтобы увидеть, как сельское хозяйство изменило окружающую среду.",
                                "zh": "科学家研究了<w>人文</w>景观，以观察农业如何改变了环境。"
                            }
                        },
                        {
                            "text": "Urban areas often experience <w>cultural</w> lighting that obscures the natural view of the stars.",
                            "target_lang_translations": {
                                "ru": "Городские районы часто подвержены <w>искусственному</w> освещению, которое скрывает естественный вид на звезды.",
                                "zh": "城市地区经常受到<w>人为</w>光线的影响，这遮蔽了人们对星空的自然观察。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anthropogenic",
                        "man-made"
                    ],
                    "antonyms": [
                        "natural",
                        "biological"
                    ],
                    "common_phrases": [
                        "cultural landscape",
                        "cultural lighting"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникший в результате человеческой деятельности, а не естественным путем.",
                        "zh": "由人类活动引起或受其影响，而非自然发生的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "культурный",
                                "target_lang_sense_clarification": "в контексте антропогенного воздействия или ландшафта"
                            },
                            {
                                "target_lang_word": "антропогенный",
