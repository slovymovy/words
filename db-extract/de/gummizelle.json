                "senses": [
                    {
                        "sense_id": "b58c0213-7c82-3676-8d42-8b94ffbf9846",
                        "entry_id": "efb3c48a-6879-3a94-b3aa-f2a0685e1840",
                        "glosses": [
                            "kleiner, vollständig mit Weichmaterial ausgekleideter Raum in einer psychiatrischen Klinik, in den Patienten während eines Tobsuchtanfalls gesperrt werden können"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "56c4dba5-8eef-4907-ab24-195582dc7011",
                                "sense_id": "b58c0213-7c82-3676-8d42-8b94ffbf9846",
                                "text": "„Dass die Los Angeles Times über ihn lästerte, er sei weniger ein Kommentator als ein Kandidat für eine Gummizelle, tat der Quote keinen Abbruch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12e1eecc-8d22-417c-a48d-767061103a66",
                        "source_entry_id": "efb3c48a-6879-3a94-b3aa-f2a0685e1840",
                        "source_sense_id": "b58c0213-7c82-3676-8d42-8b94ffbf9846",
                        "target_lang_word": "rubber room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rubber room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8632d6-4a55-3bd1-bb70-05761ed92fd8",
                                        "entry_id": "08d23d46-75a3-3d46-a630-b5e1ccda6a99",
                                        "glosses": [
                                            "A cell lined with cushions used for confinement of a mentally disturbed person."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0af196c9-bc37-413f-8939-84df284251ed",
                                                "sense_id": "ff8632d6-4a55-3bd1-bb70-05761ed92fd8",
                                                "text": "\"If you kept on worrying about being killed you could end up in a rubber room.\""
                                            },
                                            {
                                                "example_id": "7bb19b8f-7161-4f56-97e7-f3a5935a5d66",
                                                "sense_id": "ff8632d6-4a55-3bd1-bb70-05761ed92fd8",
                                                "text": "Barry is... well, what? Borderline autistic and obsessive-compulsive, with serious anger management issues and a dangerous behavioural disorder that in the real world would get him a one-way ticket to the rubber room."
                                            },
                                            {
                                                "example_id": "18c58c21-cfaa-48a6-81df-5cc382b9f90d",
                                                "sense_id": "ff8632d6-4a55-3bd1-bb70-05761ed92fd8",
                                                "text": "How is it that the Virginia Tech shooter Seung Cho and Adam Lanza weren't in a rubber room instead of in a classroom shooting people?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f10a27f5-3dc8-37f1-83dc-c70f08d2a29b",
                                        "entry_id": "08d23d46-75a3-3d46-a630-b5e1ccda6a99",
                                        "glosses": [
                                            "Especially in New York City, a temporary workplace assigned to a teacher who is not permitted to teach in a classroom because he or she is under disciplinary review."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b15aeea-76a0-431f-b99e-97c5d328f3da",
                                                "sense_id": "f10a27f5-3dc8-37f1-83dc-c70f08d2a29b",
                                                "text": "The film briefly visits a “rubber room” in New York City where idle teachers accused of misconduct wait months and sometimes years for hearings while drawing full salaries."
                                            },
                                            {
                                                "example_id": "4cb93f64-c627-4498-bdb8-52bd002d0238",
                                                "sense_id": "f10a27f5-3dc8-37f1-83dc-c70f08d2a29b",
                                                "text": "The findings dropped the day before the one-year anniversary of his idling away in the rubber room, where teachers await disciplinary hearings."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63e9b235-b200-4e7e-a9d0-cd6a8889c44c",
                        "source_entry_id": "efb3c48a-6879-3a94-b3aa-f2a0685e1840",
