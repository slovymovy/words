                "translations": [
                    {
                        "translation_id": "a92ca2e2-1ff1-4363-b628-98617aef4a74",
                        "source_entry_id": "cf3484c0-cf09-3801-9814-1487df2a9cc6",
                        "source_sense_id": "0cc26dda-fe11-329d-abe5-5e5cbc06cd27",
                        "target_lang_word": "contrive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contrive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a61f0ebc-e09f-3218-ac44-d2d23003d4ae",
                                        "entry_id": "93542e8f-92db-3100-a779-ec228a518fc1",
                                        "glosses": [
                                            "To invent by an exercise of ingeniosity; to devise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e747f0-9ce1-4406-b9b6-85cb9999ca08",
                                                "sense_id": "a61f0ebc-e09f-3218-ac44-d2d23003d4ae",
                                                "text": "[…]I cannot bear the idea of two young women traveling post by themselves. It is highly improper. You must contrive to send somebody."
                                            },
                                            {
                                                "example_id": "dba31e3d-c5b0-4c6d-9086-388a233a1181",
                                                "sense_id": "a61f0ebc-e09f-3218-ac44-d2d23003d4ae",
                                                "text": "Neither do thou imagine that I shall contrive aught against his life."
                                            },
                                            {
                                                "example_id": "40474d38-5232-4dc0-b20f-a03c49479d41",
                                                "sense_id": "a61f0ebc-e09f-3218-ac44-d2d23003d4ae",
                                                "text": "With a little manœuvring they contrived to meet on the doorstep which was […] in a boiling stream of passers-by, hurrying business people speeding past in a flurry of fumes and dust in the bright haze."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec986f61-2e55-35bd-b47d-c23297975aa5",
                                        "entry_id": "93542e8f-92db-3100-a779-ec228a518fc1",
                                        "glosses": [
                                            "To invent, to make devices; to form designs especially by improvisation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dbb6a8f3-0221-3547-9f5e-fd1f747b2619",
                                        "entry_id": "93542e8f-92db-3100-a779-ec228a518fc1",
                                        "glosses": [
                                            "To project, cast, or set forth, as in a projection of light."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9a71bb5d-8c76-3846-b448-5a4b2e418cef",
