{
    "word_family": [
        "steeply",
        "steepness",
        "steepen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2867c6f4-f71b-3e34-b64e-3f219560d4a7",
                    "sense_definition": "Having a sharp or near-vertical slope or gradient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers struggled to climb the <w>steep</w> hill in the midday heat.",
                            "target_lang_translations": {
                                "ru": "Пешим туристам было тяжело подниматься на <w>крутой</w> холм в полуденный зной.",
                                "zh": "徒步旅行者在正午的酷热中艰难地爬上了那座<w>陡峭</w>的山丘。"
                            }
                        },
                        {
                            "text": "The road has a <w>steep</w> ascent that makes driving difficult for heavy trucks.",
                            "target_lang_translations": {
                                "ru": "У дороги <w>крутой</w> подъем, что затрудняет движение тяжелых грузовиков.",
                                "zh": "这条路有一个<w>陡峭</w>的坡道，使得重型卡车行驶起来很困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sharp"
                    ],
                    "antonyms": [
                        "gentle",
                        "shallow"
                    ],
                    "common_phrases": [
                        "steep hill",
                        "steep ascent",
                        "steep slope"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий резкий или почти вертикальный наклон или градиент.",
                        "zh": "指坡度很大或近乎垂直的斜坡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "о склоне или подъеме"
                            },
                            {
                                "target_lang_word": "обрывистый",
                                "target_lang_sense_clarification": "о береге или скале"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陡峭",
                                "target_lang_sense_clarification": "形容山坡或地形"
                            },
                            {
                                "target_lang_word": "险峻",
                                "target_lang_sense_clarification": "形容山势高而陡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60af2051-c262-324a-ba5e-78a47b417211",
                    "sense_definition": "Unreasonably expensive or high in price.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fifty dollars for a simple haircut seems a bit <w>steep</w> to me.",
                            "target_lang_translations": {
                                "ru": "Пятьдесят долларов за простую стрижку кажутся мне немного <w>дороговатыми</w>.",
                                "zh": "剪个简单的头发要五十美元，我觉得有点<w>贵</w>了。"
                            }
                        },
                        {
                            "text": "The price of the hotel room was a bit <w>steep</w> during the peak holiday season.",
                            "target_lang_translations": {
                                "ru": "Цена за гостиничный номер была немного <w>завышенной</w> в разгар праздничного сезона.",
                                "zh": "在度假高峰期，酒店房间的价格有点<w>虚高</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bit steep",
                        "steep price"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe prices"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Необоснованно дорогой или высокий по цене.",
                        "zh": "指价格过高，不合理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "высокий",
                                "target_lang_sense_clarification": "о цене"
                            },
                            {
                                "target_lang_word": "завышенный",
                                "target_lang_sense_clarification": "о цене или требовании"
                            },
                            {
                                "target_lang_word": "кусачий",
                                "target_lang_sense_clarification": "разговорное о цене"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "昂贵",
                                "target_lang_sense_clarification": "指价格高"
                            },
                            {
                                "target_lang_word": "虚高",
                                "target_lang_sense_clarification": "指价格不合理地高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14369838-4147-3b6e-947a-a4b94eb76c40",
                    "sense_definition": "Describing an angle, such as a windshield, that deviates significantly from the vertical.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>steep</w> rake of the windshield gives the sports car a very aerodynamic look.",
                            "target_lang_translations": {
                                "ru": "<w>Сильный</w> наклон лобового стекла придает спортивному автомобилю очень аэродинамичный вид.",
                                "zh": "挡风玻璃的<w>大角度</w>倾斜让这辆跑车看起来非常有空气动力学美感。"
                            }
                        },
                        {
                            "text": "Engineers designed a <w>steep</w> rake for the glass to reduce wind resistance.",
                            "target_lang_translations": {
                                "ru": "Инженеры спроектировали <w>острый</w> угол наклона стекла, чтобы снизить сопротивление ветра.",
                                "zh": "工程师为玻璃设计了<w>大角度</w>的倾斜，以减少风阻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steep rake"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical usage in design"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает угол, например, лобового стекла, который значительно отклоняется от вертикали.",
                        "zh": "指物体（如挡风玻璃）与垂直方向有较大的倾斜角度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сильный",
                                "target_lang_sense_clarification": "о наклоне"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "об угле наклона"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "指角度偏离垂直"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3e5e35ca-859b-39be-9641-2aa4e67f5294",
                    "sense_definition": "To soak something in a liquid to extract flavor or to soften it.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "soak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should let the tea <w>steep</w> for five minutes to get the best flavor.",
                            "target_lang_translations": {
                                "ru": "Вам следует дать чаю <w>настояться</w> пять минут, чтобы добиться лучшего вкуса.",
                                "zh": "你应该让茶<w>浸泡</w>五分钟，这样味道最好。"
                            }
                        },
                        {
                            "text": "The chef decided to <w>steep</w> the herbs in oil to create a fragrant dressing.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>вымочить</w> травы в масле, чтобы создать ароматную заправку.",
                                "zh": "厨师决定把香草<w>浸泡</w>在油里，以制作出香气四溢的调味汁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "let it steep",
                        "steep in water"
                    ],
                    "target_lang_definitions": {
                        "ru": "Замачивать что-либо в жидкости для извлечения аромата или размягчения.",
                        "zh": "将某物浸泡在液体中以提取味道或使其变软。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настаивать",
                                "target_lang_sense_clarification": "чай, травы или напиток"
                            },
                            {
                                "target_lang_word": "заваривать",
                                "target_lang_sense_clarification": "чай или кофе"
                            },
                            {
                                "target_lang_word": "вымачивать",
                                "target_lang_sense_clarification": "продукты или материалы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浸泡",
                                "target_lang_sense_clarification": "使物体在液体中变软"
                            },
                            {
                                "target_lang_word": "冲泡",
                                "target_lang_sense_clarification": "指茶或药材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56569d44-4233-3abf-b222-57aa935917f5",
                    "sense_definition": "To be deeply filled or permeated with a particular quality or influence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "soak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old university town is <w>steeped</w> in history and academic tradition.",
                            "target_lang_translations": {
                                "ru": "Старый университетский городок <w>пропитан</w> историей и академическими традициями.",
                                "zh": "这座古老的大学城<w>沉浸</w>在历史和学术传统之中。"
                            }
                        },
                        {
                            "text": "His childhood was <w>steeped</w> in music because both his parents were professional violinists.",
                            "target_lang_translations": {
                                "ru": "Его детство было <w>наполнено</w> музыкой, так как оба его родителя были профессиональными скрипачами.",
                                "zh": "他的童年<w>充满</w>了音乐，因为他的父母都是专业的小提琴手。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steeped in history",
                        "steeped in tradition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть глубоко наполненным или пропитанным определенным качеством или влиянием.",
                        "zh": "指深深地沉浸或充满某种特质、氛围或影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пропитанный",
                                "target_lang_sense_clarification": "историей, традициями"
                            },
                            {
                                "target_lang_word": "погруженный",
                                "target_lang_sense_clarification": "в атмосферу или среду"
                            },
                            {
                                "target_lang_word": "пронизанный",
                                "target_lang_sense_clarification": "духом или идеями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "指被某种氛围包围"
                            },
                            {
                                "target_lang_word": "沉浸",
                                "target_lang_sense_clarification": "指处于某种环境或文化中"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc2004ab-c1bf-3e9a-9d7e-9744efbdda37",
                    "sense_definition": "A very sharp slope or a precipitous place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "slope",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain goat moved effortlessly across the rocky <w>steep</w>.",
                            "target_lang_translations": {
                                "ru": "Горный козел без труда передвигался по скалистой <w>круче</w>.",
                                "zh": "山羊在岩石嶙峋的<w>陡坡</w>上轻松地穿行。"
                            }
                        },
                        {
                            "text": "From the top of the <w>steep</w>, they could see the entire valley below.",
                            "target_lang_translations": {
                                "ru": "С вершины <w>обрыва</w> они могли видеть всю долину внизу.",
                                "zh": "从<w>悬崖</w>顶端，他们可以俯瞰整个山谷。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain steep"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень крутой склон или обрывистое место.",
                        "zh": "指非常陡峭的斜坡或悬崖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "круча",
                                "target_lang_sense_clarification": "высокий крутой берег или обрыв"
                            },
                            {
                                "target_lang_word": "обрыв",
                                "target_lang_sense_clarification": "резкий спад высоты"
                            },
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "наклонная поверхность горы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陡坡",
                                "target_lang_sense_clarification": "指地形"
                            },
                            {
                                "target_lang_word": "悬崖",
                                "target_lang_sense_clarification": "指险峻的断崖"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}