                "senses": [
                    {
                        "sense_id": "5fcd3baa-ad77-3607-b5f0-05f3d8401cb6",
                        "entry_id": "3934eb5a-8eed-3ef2-acdd-e5bb76564c76",
                        "glosses": [
                            "Donner un caractère ancestral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db99f863-58eb-4a99-859a-d829619c8beb",
                                "sense_id": "5fcd3baa-ad77-3607-b5f0-05f3d8401cb6",
                                "text": "Du reste, cette tendance à « ancestraliser » les aînés est contrebalancée par l'usage de donner le prénom ancestral non au premier-né — qui dans la plupart des cas porte un nom original — mais au puîné."
                            },
                            {
                                "example_id": "d346bcce-c34c-4e57-8878-de4eca827159",
                                "sense_id": "5fcd3baa-ad77-3607-b5f0-05f3d8401cb6",
                                "text": "Nourrir et ancestraliser ses morts, nourrir son Ancêtre fondateur, c'est nourrir son Siang, nom patronymique de sa lignée et le fortifier."
                            }
                        ]
                    }
