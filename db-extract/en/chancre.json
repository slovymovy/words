                "senses": [
                    {
                        "sense_id": "76163743-c835-33bd-be3a-ae8b3f76bcfb",
                        "entry_id": "d59b4f26-f231-3379-a0ea-445906f90cb4",
                        "glosses": [
                            "Skin lesion, sometimes associated with certain contagious diseases such as syphilis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1efcd079-e2dc-48a7-b1d1-39bb9a18db6f",
                                "sense_id": "76163743-c835-33bd-be3a-ae8b3f76bcfb",
                                "text": "The nurse stood up and went towards the door. At that point the caretaker said to me, \"It's a chancre she's got.\" I didn't understand, so I looked at the nurse and saw that she had a bandage round her head just below the eyes. Where her nose should have been, the bandage was flat. Her face seemed to be nothing but a white bandage."
                            },
                            {
                                "example_id": "9264f936-cc21-4326-a426-ab18f9ac11ae",
                                "sense_id": "76163743-c835-33bd-be3a-ae8b3f76bcfb",
                                "text": "If the primary stage is not treated the chancre will disappear after four to eight weeks but remember that the germ is still in the body."
                            },
                            {
                                "example_id": "5a60964f-a6b3-462a-bbb2-9c8f8d1d6366",
                                "sense_id": "76163743-c835-33bd-be3a-ae8b3f76bcfb",
                                "text": "As Hiro approaches, Vitaly watches his sword uncertainly. Vitaly's eyes are dry and red, and on his lower lip he is sporting a chancre the size of a tangerine."
                            }
                        ]
                    }
                ],
