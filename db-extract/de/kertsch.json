                "senses": [
                    {
                        "sense_id": "1ec684f2-1717-34d2-b39f-9f1752f56725",
                        "entry_id": "d459a026-4ea4-35a7-b147-59105184e920",
                        "glosses": [
                            "Stadt auf der Krim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13bb4b6f-3a6e-424c-b021-fcf0c151218b",
                                "sense_id": "1ec684f2-1717-34d2-b39f-9f1752f56725",
                                "text": "„Die letzte Razzia vor dem Abzug der 11. Armee von der Krim fand nach der Rückeroberung von Kertsch statt, wo die meisten Juden bereits Anfang Dezember 1941 vom SK 10b ermordet worden waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "addcad3b-ec65-4555-9941-dfc4592f0a28",
                        "source_entry_id": "d459a026-4ea4-35a7-b147-59105184e920",
                        "source_sense_id": "1ec684f2-1717-34d2-b39f-9f1752f56725",
