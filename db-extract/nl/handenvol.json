                                "sense_id": "3f915857-afb7-3bd7-bdb1-bb395cdb2aa9",
                                "text": "Ik deed mijn leren handschoenen aan, trok het onkruid met handenvol uit en gooide het achter me op het pad."
                            },
                            {
                                "example_id": "81fdfde9-9c35-4f4e-a764-ba92f0346d0f",
                                "sense_id": "3f915857-afb7-3bd7-bdb1-bb395cdb2aa9",
                                "text": "Hij is een van mijn trouwste vrienden, maar die aardigheid en loyaliteit kosten blijkbaar ook handenvol tijd wanneer het griepseizoen is aangebroken."
                            },
                            {
                                "example_id": "8cc452f8-cd5f-422f-872e-bf6d364ef39d",
                                "sense_id": "3f915857-afb7-3bd7-bdb1-bb395cdb2aa9",
                                "text": "De rechter heeft er vaak handenvol werk aan."
                            }
                        ]
                    }
