                "senses": [
                    {
                        "sense_id": "cf7b5974-9edd-31bd-916c-2c6aa0c75e30",
                        "entry_id": "1e3598c2-ab4b-3019-8081-5130b81582c0",
                        "glosses": [
                            "Toge indienne constituée d’une pièce rectangulaire de cotonnade fine d'environ 5 m sur 1,20 m."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9170af1a-1793-408f-98d2-70c10d1b711e",
                                "sense_id": "cf7b5974-9edd-31bd-916c-2c6aa0c75e30",
                                "text": "Le Mahatma Gandhi prônait une vie frugale, détachée des biens terrestres. Il était simplement vêtu d’un dhotî blanc qu’il avait filé lui-même."
                            },
                            {
                                "example_id": "8e89ef8e-d705-4e30-987e-d85fc17b901e",
                                "sense_id": "cf7b5974-9edd-31bd-916c-2c6aa0c75e30",
                                "text": "Où que l’on soit en Inde, à la ville, dans la campagne ou sur un rivage, on est assuré d’avoir dans son champ visuel le spectacle d’un homme retroussant son dhoti et poussant sa crotte sur le sol."
                            },
                            {
                                "example_id": "5a8c36b9-eb7b-4b92-a584-50a57e5b821d",
                                "sense_id": "cf7b5974-9edd-31bd-916c-2c6aa0c75e30",
                                "text": "Les cinq roupies qu’il avait cachées dans son dhoti et les deux roupies qu’il venait de gagner."
                            },
                            {
                                "example_id": "5685a379-6786-4c22-af2c-e04c726ac377",
                                "sense_id": "cf7b5974-9edd-31bd-916c-2c6aa0c75e30",
                                "text": "Brati avait souri, sans rien dire. Ce jour-là, il portait un dhoti et une chemise. Il portait généralement des pantalons pour se déplacer mais il aimait beaucoup porter des dhoti."
                            }
                        ]
                    }
