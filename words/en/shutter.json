{
    "word_family": [
        "shuttering",
        "shuttered",
        "unshuttered"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d38d95bd-6d4d-3caa-89cc-156eab05050d",
                    "sense_definition": "Protective panels, usually wooden, placed over windows to block out light or provide security.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "window_coverings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She closed the wooden <w>shutter</w> to keep the room dark during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Она закрыла деревянный <w>ставень</w>, чтобы в комнате было темно днем."
                            }
                        },
                        {
                            "text": "The old house had a broken <w>shutter</w> hanging loosely from the window frame.",
                            "target_lang_translations": {
                                "ru": "У старого дома был сломанный <w>ставень</w>, который болтался на оконной раме."
                            }
                        }
                    ],
                    "synonyms": [
                        "blind"
                    ],
                    "common_phrases": [
                        "wooden shutter",
                        "window shutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитные панели, обычно деревянные, устанавливаемые на окна для защиты от света или в целях безопасности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ставень",
                                "target_lang_sense_clarification": "створка для прикрытия окна"
                            },
                            {
                                "target_lang_word": "ставни",
                                "target_lang_sense_clarification": "множественное число, оконные панели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e66f0468-886b-3034-a01c-a978932cc9bc",
                    "sense_definition": "The part of a camera that opens for a controlled period of time to let light in when taking a picture.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer adjusted the <w>shutter</w> speed to capture the fast-moving car.",
                            "target_lang_translations": {
                                "ru": "Фотограф настроил выдержку <w>затвора</w>, чтобы запечатлеть быстро движущийся автомобиль."
                            }
                        },
                        {
                            "text": "You can hear the click of the <w>shutter</w> every time she takes a photo.",
                            "target_lang_translations": {
                                "ru": "Каждый раз, когда она делает снимок, слышен щелчок <w>затвора</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shutter speed",
                        "shutter release"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть фотоаппарата, которая открывается на определенное время для пропускания света при съемке."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затвор",
                                "target_lang_sense_clarification": "механизм фотоаппарата"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3b7bdc5-cc65-34a4-b772-f79305306789",
                    "sense_definition": "Any other mechanical device that opens and closes to control access or light.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanical_devices",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A service hatch with a sliding <w>shutter</w> is situated at the end of the kitchen.",
                            "target_lang_translations": {
                                "ru": "В конце кухни расположено служебное окно со сдвижной <w>заслонкой</w>."
                            }
                        },
                        {
                            "text": "The ventilation <w>shutter</w> was stuck, preventing fresh air from entering the room.",
                            "target_lang_translations": {
                                "ru": "Вентиляционная <w>заслонка</w> застряла, не давая свежему воздуху проникать в комнату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sliding shutter",
                        "metal shutter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое другое механическое устройство, которое открывается и закрывается для контроля доступа или света."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заслонка",
                                "target_lang_sense_clarification": "механическая перегородка"
                            },
                            {
                                "target_lang_word": "жалюзи",
                                "target_lang_sense_clarification": "защитные шторы или пластины"
                            },
                            {
                                "target_lang_word": "затвор",
                                "target_lang_sense_clarification": "техническое устройство перекрытия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f945f92-bbe7-310a-97f5-892f75519ea9",
                    "sense_definition": "A person who shuts or closes something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gate-openers and <w>shutters</w> worked together to manage the cattle flow.",
                            "target_lang_translations": {
                                "ru": "Те, кто открывал и <w>закрывал</w> ворота, работали сообща, чтобы управлять потоком скота."
                            }
                        },
                        {
                            "text": "As the official <w>shutter</w> of the vault, he was the last to leave the bank.",
                            "target_lang_translations": {
                                "ru": "Как официальный <w>закрыватель</w> хранилища, он последним покидал банк."
                            }
                        }
                    ],
                    "antonyms": [
                        "opener"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который что-либо закрывает."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрыватель",
                                "target_lang_sense_clarification": "тот, кто закрывает"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c956b8a9-28be-34f3-b724-67fd50f99ec8",
                    "sense_definition": "To close the shutters covering a window.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "closing_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>shutter</w> the windows because there is a big storm coming tonight.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>закрой ставни</w> на окнах, потому что сегодня вечером ожидается сильный шторм."
                            }
                        },
                        {
                            "text": "It is common practice to <w>shutter</w> the house before the sun gets too hot.",
                            "target_lang_translations": {
                                "ru": "Обычно дом <w>закрывают ставнями</w> до того, как солнце станет слишком жарким."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shutter the windows"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать ставни на окнах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать ставни",
                                "target_lang_sense_clarification": "действие с окнами"
                            },
                            {
                                "target_lang_word": "затворять",
                                "target_lang_sense_clarification": "плотно закрывать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87e21f38-73d2-3639-afdc-a84255d37286",
                    "sense_definition": "To permanently close a business, program, or factory; to terminate operations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company was <w>shuttered</w> in 2002 after failing to make a profit.",
                            "target_lang_translations": {
                                "ru": "Компания была <w>закрыта</w> в 2002 году после того, как не смогла получить прибыль."
                            }
                        },
                        {
                            "text": "The government decided to <w>shutter</w> the program due to a lack of funding.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>свернуть</w> программу из-за отсутствия финансирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "close down",
                        "terminate",
                        "halt"
                    ],
                    "antonyms": [
                        "open",
                        "launch"
                    ],
                    "common_phrases": [
                        "shutter a program",
                        "shutter a factory"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Окончательно закрыть бизнес, программу или фабрику; прекратить деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закрывать",
                                "target_lang_sense_clarification": "прекращать работу предприятия"
                            },
                            {
                                "target_lang_word": "сворачивать",
                                "target_lang_sense_clarification": "ликвидировать проект или программу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b379e9-1e7c-3366-9e1c-06f94007eb3d",
                    "sense_definition": "To close up a building for a long period of time when it will not be used.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "closing_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took all day to <w>shutter</w> the cabin now that the summer season has ended.",
                            "target_lang_translations": {
                                "ru": "Потребовался целый день, чтобы <w>законсервировать</w> хижину теперь, когда летний сезон закончился."
                            }
                        },
                        {
                            "text": "They plan to <w>shutter</w> the cottage for the winter to protect it from the snow.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>закрыть</w> коттедж на зиму, чтобы защитить его от снега."
                            }
                        }
                    ],
                    "synonyms": [
                        "close up",
                        "seal"
                    ],
                    "common_phrases": [
                        "shutter for the winter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрыть здание на длительный период, когда оно не будет использоваться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "законсервировать",
                                "target_lang_sense_clarification": "закрыть на долгий срок"
                            },
                            {
                                "target_lang_word": "заколотить",
                                "target_lang_sense_clarification": "плотно закрыть здание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bbe888f-e7cc-3f40-bb90-1f7e438a262d",
                    "sense_definition": "To rain very heavily.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain <w>shuttered</w> down against the roof, making it hard to hear anything else.",
                            "target_lang_translations": {
                                "ru": "Дождь <w>барабанил</w> по крыше так сильно, что было трудно услышать что-либо еще."
                            }
                        },
                        {
                            "text": "It was a miserable day with heavy rain <w>shuttering</w> down on the empty streets.",
                            "target_lang_translations": {
                                "ru": "Это был ужасный день, когда сильный ливень <w>хлестал</w> по пустым улицам."
                            }
                        }
                    ],
                    "synonyms": [
                        "pour",
                        "pelt"
                    ],
                    "common_phrases": [
                        "rain shuttered down"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in Northern Ireland"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень сильно лить (о дожде)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "барабанить",
                                "target_lang_sense_clarification": "о сильном дожде по поверхности"
                            },
                            {
                                "target_lang_word": "хлестать",
                                "target_lang_sense_clarification": "о сильном ливне"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "63c9ffb1-c386-33ba-b561-238a05ed1d1e",
                    "sense_definition": "A family name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Shutter</w> was known throughout the town for his impressive collection of antique clocks.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Шаттер</w> был известен во всем городе своей впечатляющей коллекцией старинных часов."
                            }
                        },
                        {
                            "text": "The <w>Shutter</w> family has lived in this county for over three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Шаттер</w> живет в этом округе уже более трех поколений."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шаттер",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}