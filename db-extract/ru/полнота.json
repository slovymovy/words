                                        "entry_id": "7f6a50da-e7da-3146-aef4-45d7df3b9a05",
                                        "glosses": [
                                            "The area covered by a mobile phone (cellphone) or other radio network."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7d8876c-e09b-4a39-9c34-052b4d406976",
                                                "sense_id": "91329ff6-f130-3178-b662-19186f8f1e71",
                                                "text": "The primary coverage area of a station is that area throughout which the station can be received without objectionable interference from static, electrical interfering noises, or interference from other radio broadcasting stations, practically all of the time the station is in operation."
                                            }
                                        ]
                                    },
