                    {
                        "translation_id": "1ee7a29c-2b81-43aa-9a9a-d3024c723bff",
                        "source_entry_id": "68da084d-4541-3ef0-a9db-9fa31efefd12",
                        "source_sense_id": "4fce9b7f-2aea-37a3-8591-2bfd8bce94e8",
