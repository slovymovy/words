                ],
                "senses": [
                    {
                        "sense_id": "d86b6656-026d-3f15-8d42-230d19a55039",
                        "entry_id": "48ea9112-3deb-3730-8d25-b701886a6470",
                        "glosses": [
                            "швейн. об одежде: с пуговицами и петлями на каждом борту; пуговицы и петли на одном борту часто имеют функциональное значение (служат для застёгивания одежды), а на втором — декоративное"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b14c9d4-bc7c-4d9f-995f-0d82abc56255",
                                "sense_id": "d86b6656-026d-3f15-8d42-230d19a55039",
                                "text": "На официальный приём он надел двубортный костюм."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8ece29c-1a23-4d60-bfb7-66fe8ac1b37b",
                        "source_entry_id": "48ea9112-3deb-3730-8d25-b701886a6470",
                        "source_sense_id": "d86b6656-026d-3f15-8d42-230d19a55039",
                        "target_lang_word": "double-breasted",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "double-breasted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8114bed-daec-3455-893b-67a13493b6c3",
                                        "entry_id": "2251acd4-db2c-389b-a73e-aeb5326c3651",
                                        "glosses": [
                                            "Closing with a double row of buttons that form a wide overlap."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51394dfb-f3e6-427e-86e1-b037b572aaba",
                                                "sense_id": "b8114bed-daec-3455-893b-67a13493b6c3",
                                                "text": "The train staff were at least smartly dressed. They had better be, or they were sacked. They had to keep their double-breasted uniform coats buttoned right up at all times,[…]"
                                            },
                                            {
                                                "example_id": "458d19db-248a-45ab-85ef-942cb90d8dee",
                                                "sense_id": "b8114bed-daec-3455-893b-67a13493b6c3",
                                                "text": "The double-breasted blazer which is on every front row this season came with an elbow-length sleeve for spring, while jumpsuits, a signature of the label, came slinky and tailored or in a blowsier boiler suit silhouette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
