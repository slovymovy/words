                "senses": [
                    {
                        "sense_id": "43fd5607-d2ec-33f9-931f-f8d06afed011",
                        "entry_id": "b35f4cfa-7cdc-35f4-a424-49b13e96b543",
                        "glosses": [
                            "репетиция вокального коллектива, хора"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ccf840-31bd-4146-8c24-acb1be30308b",
                                "sense_id": "43fd5607-d2ec-33f9-931f-f8d06afed011",
                                "text": "— Я тоже приеду, но мне на спевку к графине Баниной надо."
                            },
                            {
                                "example_id": "94b1b47c-b0c5-4964-9a89-e8f909178494",
                                "sense_id": "43fd5607-d2ec-33f9-931f-f8d06afed011",
                                "text": "Говенье, спевки, долгие церковные службы отнимали большую часть времени у приютских воспитанниц."
                            },
                            {
                                "example_id": "3352a2de-2d46-4ba6-93a5-d335ac95d219",
                                "sense_id": "43fd5607-d2ec-33f9-931f-f8d06afed011",
                                "text": "Служитель раздаёт певчим ноты и все приготовляются к спевке, образовав полукруг."
                            }
                        ]
                    }
                ],
