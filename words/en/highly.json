                                "target_lang_sense_clarification": "крайне"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wyjątkowo",
                                "target_lang_sense_clarification": "w bardzo wysokim stopniu"
                            },
                            {
                                "target_lang_word": "bardzo",
                                "target_lang_sense_clarification": "w dużej mierze"
                            },
                            {
