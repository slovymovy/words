                        "examples": [
                            {
                                "example_id": "4e896a7c-709e-4963-a0f2-78b953813684",
                                "sense_id": "6a941809-341b-350f-9d5a-b5ae10a86829",
                                "text": "The unglued joints all fell apart in shipment, but the properly joined piece survived intact."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2a04e19-9747-3008-9234-2c892e7728ec",
                        "entry_id": "881bd657-0083-36a1-b688-09822cfb01cb",
                        "glosses": [
                            "Insane, upset."
                        ],
                        "tags": [
                            "comparable",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "348a8bd1-8c51-4cf0-80e7-5b2af05340a2",
                                "sense_id": "d2a04e19-9747-3008-9234-2c892e7728ec",
                                "text": "He was calm at first, then suddenly he came unglued and started screaming. He completely lost it."
                            },
                            {
                                "example_id": "f7fa6692-3aca-41ce-a37f-db9d8f536673",
                                "sense_id": "d2a04e19-9747-3008-9234-2c892e7728ec",
                                "text": "There is something inherently entertaining about the self-proclaimed defender of uncomfortable speech on college campuses coming unglued when he found a sentence on the Internet that he didn't like."
                            },
                            {
                                "example_id": "1a97d275-68fc-4bda-81c6-62d8d8f62f2c",
                                "sense_id": "d2a04e19-9747-3008-9234-2c892e7728ec",
                                "text": "One was Climategate, where global warming skeptics seized on the leaked emails of atmospheric scientists and produced reams of feverish, unglued analyses."
                            }
                        ]
                    }
