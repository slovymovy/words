                "senses": [
                    {
                        "sense_id": "5ed6891f-60be-3b20-90dd-261be0abc6ab",
                        "entry_id": "91e8fe73-83cc-3161-86b7-4eb6d3520ade",
                        "glosses": [
                            "onaangename vrouw #:⚠️ Dit gebruik van het woord roept twijfels op over de gebruiker."
                        ],
                        "tags": [
                            "pejorative",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "8f6fb355-c489-4002-b857-0c716c4295c9",
                                "sense_id": "5ed6891f-60be-3b20-90dd-261be0abc6ab",
                                "text": "Het was echt heel vervelend. Toen wij bij hem thuis waren, schold hij zijn vrouw uit voor \"kutwijf\"."
                            },
                            {
                                "example_id": "e8f424cb-8165-4e24-aa77-3c0407ffd0ac",
                                "sense_id": "5ed6891f-60be-3b20-90dd-261be0abc6ab",
                                "text": "Niet dat The Favourite zich iets aantrekt van de werkelijkheid, of hoe die werkelijkheid er in films over die periode doorgaans uitziet. Dat komt door het smeuïge scenario van Deborah Davis en Tony McNamara, vol seks en jaloezie, verraad en vulgariteiten. Het woord ‘kutwijf’ valt verrassend vaak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d152780-5f84-4621-82c5-b2ba41239f87",
                        "source_entry_id": "91e8fe73-83cc-3161-86b7-4eb6d3520ade",
                        "source_sense_id": "5ed6891f-60be-3b20-90dd-261be0abc6ab",
                        "source_sense_description": "(dysfemisme), (scheldwoord) een scheldwoord voor een vrouw",
                        "target_lang_word": "Schlampe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlampe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0228f51-acb2-3fbf-9750-efac8aa53d83",
                                        "entry_id": "4a276010-c046-3127-b750-0aa5bb372df0",
                                        "glosses": [
                                            "unordentlich, liederliche, ungepflegte Person"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8b2a9dc-ad10-4ade-b988-425fb53414ba",
                                                "sense_id": "b0228f51-acb2-3fbf-9750-efac8aa53d83",
                                                "text": "Wenn ich das hier so sehe, würde ich am liebsten sagen: Otto, du alte Schlampe!"
                                            },
                                            {
                                                "example_id": "f31ad542-fa45-4ccd-9c41-26812589f70c",
                                                "sense_id": "b0228f51-acb2-3fbf-9750-efac8aa53d83",
                                                "text": "„Dabei ging von ihr das Gerücht, dass sie eine Lügnerin und Diebin sei, eine »salope«, also eine Schlampe, überhaupt eine ganz schreckliche Person, die man möglichst weit von sich fernhalten solle.“"
                                            },
                                            {
                                                "example_id": "a6289d0b-a7ad-428b-b210-20a8c1a380e1",
                                                "sense_id": "b0228f51-acb2-3fbf-9750-efac8aa53d83",
                                                "text": "„›Jasmin war intrigante Schlampe, die mit wirklich jedem Ärger hatte!‹, fuhr nun Laura auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                        "entry_id": "4a276010-c046-3127-b750-0aa5bb372df0",
                                        "glosses": [
                                            "promiskuitive Frau"
                                        ],
                                        "tags": [
                                            "umgangssprachlich, abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f764da-3ac1-49e7-8534-e68a1fd39037",
                                                "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                                "text": "„Entsprechend hoch sind die Strafen: Wer ‚du Schlampe’ zu einer Politesse sagt, zahlt knapp 2000 Euro, Ordnungshüter als ‚Wichtelmänner’ zu bezeichnen, kostet immerhin noch 1000 Euro."
                                            },
                                            {
                                                "example_id": "193c6dc5-8a80-4046-9f72-7c127a11f727",
                                                "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                                "text": "„Nichtmuslimische Frauen als Schlampen, Huren oder Nutten zu bezeichnen hat sich schon bei den Jüngsten durchgesetzt, die noch nicht einmal verstehen können, was sie da eigentlich sagen.“"
                                            },
                                            {
                                                "example_id": "67b58b21-31f9-4d17-87f7-3160e258d41e",
                                                "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                                "text": "„Sie wollte alles genau spüren, als wollte sie büßen für die Schwangerschaft, die ihr Leben ruiniert und ihr den Ruf einer Schlampe eingebracht hatte.“"
                                            },
                                            {
                                                "example_id": "f460e705-3b4e-4ffa-b874-ac06d06d6ea2",
                                                "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                                "text": "„Selbst einige der Studenten bezeichneten Janie als Schlampe, gingen aber dennoch mit ihr ins Bett.“"
                                            },
                                            {
                                                "example_id": "6b2291f6-5a34-41c0-95b8-db6cb1321103",
                                                "sense_id": "86365a69-f9cb-308b-88af-9d4fc36e79e8",
                                                "text": "„Jemand hat Filzer aufs Holz geschrieben, dass jeder, der das wolle, die Schlampe Jasmin haben könne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "756b1e1c-f5f5-4ac0-8452-06ad3dd73535",
                        "source_entry_id": "91e8fe73-83cc-3161-86b7-4eb6d3520ade",
