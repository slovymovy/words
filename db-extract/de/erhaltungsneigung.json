                "senses": [
                    {
                        "sense_id": "a74cb694-0c71-374e-b553-d45ece32d908",
                        "entry_id": "d2c3af27-8628-361f-b7f3-97c9223cc982",
                        "glosses": [
                            "tendenzielle Eigenschaft des Wetters, sich über einen wesentlichen Zeitraum wenig bis gar nicht zu verändern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8de0d77-5501-428c-a87f-1fb975a9c48c",
                                "sense_id": "a74cb694-0c71-374e-b553-d45ece32d908",
                                "text": "„Wir beobachten in den vergangenen Jahren immer öfter, dass bestimmte Wetterlagen eine lange Erhaltungsneigung haben.“"
                            },
                            {
                                "example_id": "5b927f73-6dde-454d-a71f-ac3718b0c008",
                                "sense_id": "a74cb694-0c71-374e-b553-d45ece32d908",
                                "text": "„In allen Simulationen wurde demnach die Persistenz, also die Erhaltungsneigung des Wetters, deutlich unterschätzt.“"
                            },
                            {
                                "example_id": "6a167a7b-5e40-4f86-9956-c5786eeaf0d8",
                                "sense_id": "a74cb694-0c71-374e-b553-d45ece32d908",
                                "text": "„Manche Wetterlagen sind sehr stabil, Meteorologen sprechen von der sogenannten Erhaltungsneigung.“"
                            },
                            {
                                "example_id": "8256a2da-ba9c-47cb-8e8e-c6cf5e4ed637",
                                "sense_id": "a74cb694-0c71-374e-b553-d45ece32d908",
                                "text": "„Es ist generell so, dass besonders kräftige Wetterlagen eine starke Erhaltungsneigung haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
