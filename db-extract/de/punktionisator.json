                "senses": [
                    {
                        "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                        "entry_id": "f4c9bbed-a26d-316f-b30c-b624f794aa1e",
                        "glosses": [
                            "Ionisator mit auswechselbarem Ionisationskopf für elektrostatische Aufladungen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb69e02b-2543-4a27-a07f-5c58e13ce966",
                                "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                                "text": "„3810 Punktionisator Leistungsfähiger Ionisator zur Neutralisierung statischer Aufladungen und zur Staubentfernung an kleinen Objekten.“"
                            },
                            {
                                "example_id": "58546a75-1a3b-483d-8c5a-92eef321e82c",
                                "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                                "text": "„Der Punktionisator 1265 dient zur Neutralisierung statischer Aufladungen an Bändern, Säumen, Garnen, Glasfasern usw. “"
                            },
                            {
                                "example_id": "e5594566-db48-4b67-b5a9-a35e73f829c5",
                                "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                                "text": "„Der vom Punktionisator 1260 erzeugte hohe Ionisierungsgrad ist ausreichend zur Neutralisierung höchster elektrostatischer Ladungen.“"
                            },
                            {
                                "example_id": "44503cd4-e553-4af2-b670-4388944d5854",
                                "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                                "text": "„Die Baureihe umfasst Ionisierungsstäbe in zwei Leistungsklassen SB55 und SB80, SB55CR für den Einsatz in Reinräumen, für besonders beengte Einbausituationen den Punktionisator SP55 sowie weitere Systeme für eine Vielzahl von besonderen Anwendungen.“"
                            },
                            {
                                "example_id": "aab230b6-e662-4685-9f7e-8e619f1789ab",
                                "sense_id": "85abdf27-9e1c-3b15-9ad7-9014c5789a90",
                                "text": "„Es besteht aus einem Punktionisator, der in sechs verschiedenen Positionen je nach Probengrösse und -form sowie für die Bedienung durch Links- oder Rechtshänder befestigt werden kann. “"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
