                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8303ca8-babd-492f-823d-c87e7cfca262",
                        "source_entry_id": "6233f29f-7f8a-322a-94f0-c179d3ddafe9",
