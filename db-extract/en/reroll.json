                        "entry_id": "b6b2168c-b26b-3617-b1d9-5d4ca2f2c2c4",
                        "glosses": [
                            "To convert (an unrolled instruction sequence) back into a loop."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ea0b0789-6ebc-49d1-9211-ad1599ce47d1",
                                "sense_id": "8e8d7988-9100-3e62-b91e-1b2e6dfe8428",
                                "text": "Their procedure is to unroll the loop once, trace schedule the two iterations, and then reroll the loop into one."
                            }
