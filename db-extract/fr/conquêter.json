                "senses": [
                    {
                        "sense_id": "e59f6a09-0c33-3a28-9523-dbf842852c34",
                        "entry_id": "5207de8c-251c-38cd-bc1d-a3c72cbc33bf",
                        "glosses": [
                            "Conquérir, vaincre."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "44155ed3-9813-47bf-9430-ed4fe2cb7222",
                                "sense_id": "e59f6a09-0c33-3a28-9523-dbf842852c34",
                                "text": "Quelle moins hautaine espérance\nPourrons-nous concevoir alors\nQue de conquêter à la France\nLa Propontide…"
                            },
                            {
                                "example_id": "521dcad0-7373-4a5e-b208-03405f1c40ba",
                                "sense_id": "e59f6a09-0c33-3a28-9523-dbf842852c34",
                                "text": "Est-il possible que je connaisse si peu la fermeté de votre majesté pour croire que je conquêterai sa faveur par les armes ?"
                            },
                            {
                                "example_id": "3268e3ee-c086-478f-9798-dac89f81f9fb",
                                "sense_id": "e59f6a09-0c33-3a28-9523-dbf842852c34",
                                "text": "Vous le pouvez bien croire, et pour le témoigner,\n Choisissez en quels lieux il vous plaît de régner :\n Ce bras tout aussitôt vous conquête un empire ;\n J'en jure par lui-même, et cela c'est tout dire."
                            }
                        ]
                    }
                ],
