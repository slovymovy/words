                        "examples": [
                            {
                                "example_id": "e8e46866-b1da-4b21-8c4c-863ae93f9894",
                                "sense_id": "95ccd84f-8773-3446-883f-de983c961633",
                                "text": "The archbishop made the \"proclamacion on the iiij quarters of the scaffolde, seyend in this wyse: Sirs, heere comyth Henry, kyng Henryes sone the Vth, on whose sowle God have mercy, Amen."
                            },
                            {
                                "example_id": "3bb432bf-2858-4965-9fc1-3f5b67260c48",
                                "sense_id": "95ccd84f-8773-3446-883f-de983c961633",
                                "text": "Beleeve mee nowe, I do not blame my frende To fishe in trobled streames for such a pearle, Or digge in black mowled for so ritch a myne; But to redeeme a chast and inocent sowle Forthe from the fierye jawes of lust and hell, Exprest a most comended charitye."
                            }
                        ]
                    }
