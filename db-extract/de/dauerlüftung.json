                "senses": [
                    {
                        "sense_id": "8adedb32-2013-32ea-a6a1-841a2d3c1ecf",
                        "entry_id": "4f1a113d-57ad-3b39-9f70-946f9ecb4633",
                        "glosses": [
                            "das Dauerlüften; zeitliche Erstreckung eines Lüftungsvorgangs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75e4e6a7-9831-4651-95d3-45906a6c2bd9",
                                "sense_id": "8adedb32-2013-32ea-a6a1-841a2d3c1ecf",
                                "text": "„Mit der Dauerlüftung (z.B. Fenster dauernd in Kippstellung) wird Energie vergeudet und die Luft nicht komplett ausgetauscht.“"
                            },
                            {
                                "example_id": "3948d0c3-863f-4baa-8cf5-e6874cc50af6",
                                "sense_id": "8adedb32-2013-32ea-a6a1-841a2d3c1ecf",
                                "text": "„Die Dauerlüftung ist ein Element des gesamten Ventilationssystems und sichert einen Zufluss von frischer Luft.“"
                            },
                            {
                                "example_id": "fe407386-e952-4179-914f-6a64c6c24d35",
                                "sense_id": "8adedb32-2013-32ea-a6a1-841a2d3c1ecf",
                                "text": "„Die mit dieser Dauerlüftung unbestrittenen erhöhten Wärmeverluste lassen sich in Grenzen halten, wenn Folgendes beachtet wird: Es sollte Dauerzug vermieden werden, d. h. die Schlafzimmertür muss geschlossen bleiben und am besten mit einer Fugendichtung versehen werden.“"
                            },
                            {
                                "example_id": "31335419-354e-4430-961a-872ef3f4303a",
                                "sense_id": "8adedb32-2013-32ea-a6a1-841a2d3c1ecf",
                                "text": "„Wenn die Dauerlüftung auch noch bei geöffneten Thermostatventilen erfolgt, arbeitet der Heizkörper auf einer maximalen Leistungsstufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
