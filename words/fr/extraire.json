        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "508469fe-e611-339a-b76f-b8789e9a6421",
                    "sense_definition": "Tirer ou retirer une chose ou une personne d'un lieu où elle se trouve enfermée, fixée ou enfoncée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "retirer_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le dentiste a réussi à lui <w>extraire</w> une dent sans douleur.",
                            "target_lang_translations": {
                                "en": "The dentist managed to <w>extract</w> a tooth from him without pain.",
                                "ru": "Стоматологу без боли удалось <w>вырвать</w> ему зуб.",
                                "de": "Der Zahnarzt konnte ihm ohne Schmerzen einen Zahn <w>ziehen</w>.",
                                "es": "El dentista logró <w>extraer</w> una muela de su paciente sin dolor.",
                                "zh": "牙医无痛地把他的一颗牙<w>拔出</w>来了。"
                            }
                        },
                        {
                            "text": "Les pompiers ont dû découper la portière pour <w>extraire</w> le conducteur blessé.",
                            "target_lang_translations": {
                                "en": "The firefighters had to cut through the door to <w>pull</w> the injured driver <w>out</w>.",
                                "ru": "Пожарным пришлось разрезать дверцу, чтобы <w>вытащить</w> раненого водителя.",
                                "de": "Die Feuerwehrleute mussten die Autotür aufschneiden, um den verletzten Fahrer <w>herauszuziehen</w>.",
                                "es": "Los bomberos tuvieron que cortar la puerta del coche para <w>sacar</w> al conductor herido.",
                                "zh": "消防员不得不切开车门，把受伤的司机<w>拉出</w>来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retirer",
                        "tirer",
                        "ôter"
                    ],
                    "antonyms": [
                        "insérer",
                        "introduire"
                    ],
                    "common_phrases": [
                        "extraire une dent"
                    ],
                    "target_lang_definitions": {
                        "en": "To take or pull something out of a place where it is enclosed, fixed, or embedded.",
