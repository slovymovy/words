{
    "word_family": [
        "corn"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ef860df-bac4-32a9-8a00-2b3a3bab4b76",
                    "sense_definition": "Hackneyed, excessively sentimental, or unoriginal in a way that is annoying or embarrassing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unoriginal_sentimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was okay, but the love scene was really <w>corny</w>.",
                            "target_lang_translations": {
                                "pl": "Film był w porządku, ale scena miłosna była naprawdę <w>kiczowata</w>."
                            }
                        },
                        {
                            "text": "He sent a <w>corny</w> card with a poem that everyone has heard before.",
                            "target_lang_translations": {
                                "pl": "Wysłał <w>banalną</w> kartkę z wierszykiem, który wszyscy już słyszeli."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheesy",
                        "tacky",
                        "kitsch",
                        "kitschy",
                        "campy",
                        "schmaltzy"
                    ],
                    "common_phrases": [
                        "corny joke",
                        "corny line",
                        "corny movie"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ośmieszający, przesadnie sentymentalny lub mało oryginalny w sposób irytujący lub żenujący."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kiczowaty",
                                "target_lang_sense_clarification": "odnoszący się do czegoś o niskiej wartości artystycznej, tandetnego"
                            },
                            {
                                "target_lang_word": "banalny",
                                "target_lang_sense_clarification": "odnoszący się do czegoś oklepanego, mało oryginalnego"
                            },
                            {
                                "target_lang_word": "słodkawy",
                                "target_lang_sense_clarification": "odnoszący się do przesadnie sentymentalnego tonu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0bc18e6-b156-31e7-8594-3195703c5959",
                    "sense_definition": "Uncool, lame, or foolish.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unoriginal_sentimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to bed because you are all being <w>corny</w>.",
                            "target_lang_translations": {
                                "pl": "Idę spać, bo wszyscy zachowujecie się <w>obciachowo</w>."
                            }
                        },
                        {
                            "text": "That idea is <w>corny</w> and nobody will want to participate.",
                            "target_lang_translations": {
                                "pl": "Ten pomysł jest <w>słaby</w> i nikt nie będzie chciał w tym uczestniczyć."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieciekawy, niemodny, głupi lub żenujący."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "obciachowy",
                                "target_lang_sense_clarification": "potoczne określenie czegoś, co przynosi wstyd lub jest niemodne"
                            },
                            {
                                "target_lang_word": "słaby",
                                "target_lang_sense_clarification": "potoczne określenie czegoś, co jest nieciekawe lub nieudane"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3667bcb3-f7b1-31e5-960d-519178427787",
                    "sense_definition": "Containing or made with corn.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>corny</w> muffins were a perfect side dish for the spicy soup.",
                            "target_lang_translations": {
                                "pl": "<w>Kukurydziane</w> muffinki były idealnym dodatkiem do ostrej zupy."
                            }
                        },
                        {
                            "text": "She baked a delicious <w>corny</w> bread using fresh stone-ground meal.",
                            "target_lang_translations": {
                                "pl": "Upiekła pyszny <w>kukurydziany</w> chleb, używając świeżej mąki mielonej w żarnach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "corny muffin",
                        "corny bread"
                    ],
                    "target_lang_definitions": {
                        "pl": "Zawierający kukurydzę lub zrobiony z kukurydzy."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kukurydziany",
                                "target_lang_sense_clarification": "zrobiony z kukurydzy lub zawierający ją jako składnik"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}