                "senses": [
                    {
                        "sense_id": "19f17411-ae2f-336d-94b6-de24fe15bfb2",
                        "entry_id": "5aaa555a-d7b2-3e35-9b8f-686d2f6d8ac2",
                        "glosses": [
                            "Politik in Südafrika, die strikte Rassentrennung betrieb"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bcc26e0-c79a-4ac6-8ff2-b7c5c1bf32e0",
                                "sense_id": "19f17411-ae2f-336d-94b6-de24fe15bfb2",
                                "text": "„Die südafrikanische Regierung will sich nicht vorwerfen lassen, sie betreibe ihre Apartheidpolitik nicht konsequent und strikt genug.“"
                            },
                            {
                                "example_id": "26af966e-cb44-43c3-a72f-0cc437b49b55",
                                "sense_id": "19f17411-ae2f-336d-94b6-de24fe15bfb2",
                                "text": "„Im unabhängigen Südafrika gipfelte diese Entwicklung in der Apartheidpolitik, die bis 1994 bestand, als Nelson Mandela Präsident wurde.“"
                            },
                            {
                                "example_id": "6707871b-e748-4945-94aa-9c9062f868f7",
                                "sense_id": "19f17411-ae2f-336d-94b6-de24fe15bfb2",
                                "text": "„Politisch orientierte er sich an Südafrika und seiner Apartheidpolitik, was bis hin zur Forderung nach einer «Gemeinschaftsentwicklung» unter Schwarzen ging – ein in Südafrika gebrauchter Euphemismus für Retribalisierung und Retraditionalisierung durch Aufwertung der Chiefs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
