                                        "glosses": [
                                            "darauf bedacht, anderen zu gefallen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d418619-226a-4947-ad4c-255d20e98405",
                                                "sense_id": "fa0f3131-8722-332b-aee7-241ef8adf99a",
                                                "text": "„So kam meine Bitte als Wunsch nach Strapsen und Spitzen und erotischer Extravaganz an, und wenn sie erfüllt wurde, geschah es in koketter Pose. Das war es nicht, wovon ich meine Augen nicht hatte lassen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bf0cb256-3071-3619-9a3e-bf88f8e8c8fe",
                                        "entry_id": "d7708541-003f-3980-8f12-c5b877aa9cc2",
                                        "glosses": [
                                            "verführerisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d922f1bd-f261-4299-ab87-38b6665a5055",
                                                "sense_id": "bf0cb256-3071-3619-9a3e-bf88f8e8c8fe",
                                                "text": "„Ihre Spiellust und ihr koketter Charme wirken auf den Komponisten unwiderstehlich. Er fühlt sich auf einmal mit ihr seelenverwandt und zu einem Hymnus auf die Musik animiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "62293efb-fe89-35c5-8ce3-df8b1bd254e8",
                                        "entry_id": "d7708541-003f-3980-8f12-c5b877aa9cc2",
                                        "glosses": [
                                            "von einem gekünstelten Verhalten geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3045474c-a250-481f-9905-669c69167451",
                                                "sense_id": "62293efb-fe89-35c5-8ce3-df8b1bd254e8",
                                                "text": "„Sieht man heute ins 18. und 19. Jahrhundert zurück, so spürt man erst, von wieviel kreativen und koketten Narzißmen die bürgerliche Kultur durchströmt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
