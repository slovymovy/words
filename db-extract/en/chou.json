                        "glosses": [
                            "A bunch, knot, or rosette of ribbon or other material, used as an ornament in women's clothing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a24ad83-ff77-44f8-9725-12b2a1533b5a",
