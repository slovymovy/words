                "senses": [
                    {
                        "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                        "entry_id": "3376e47d-d989-3079-b10e-118ab84a3ff9",
                        "glosses": [
                            "Immeuble de logement géré par un organisme d’habitation à loyer modéré, public ou privé, qui bénéficie d’un financement public partiel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1636416c-6221-426d-9747-a81a7bc1ad50",
                                "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                                "text": "Il faut savoir ce que l’on aime\nEt rentrer dans son HLM\nManger du poulet aux hormones."
                            },
                            {
                                "example_id": "db8d28a5-4ca2-406b-b6a4-eb978523629b",
                                "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                                "text": "C’est ainsi que, de fil en aiguille, par des modifications successives dictées par la plus sage raison, on en est venu aux HLM qui sont l’orgueil des urbanistes de notre époque."
                            },
                            {
                                "example_id": "f0acd209-8d5f-4a42-94eb-938b47cd16e0",
                                "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                                "text": "Bien sûr, la plupart d’entre elles ont déposé des demandes de logements sociaux restées trop longtemps sans réponse : « Depuis 1982, je n'ai cessé d’adresser des demandes d'attribution de logement dans une HLM », témoigne une famille."
                            },
                            {
                                "example_id": "fb7db025-7e72-4708-85df-dc0e594cc19c",
                                "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                                "text": "Le directeur de cabinet de Christine Boutin habite une HLM de la ville de Paris."
                            },
                            {
                                "example_id": "773f6149-f557-43fe-87e2-19580fe58ba2",
                                "sense_id": "38e26682-8d3a-3442-a2df-4bedab6a70a8",
                                "text": "En ménage dans un HLM de Pantin (Seine-Saint-Denis) avec un professeur de français-histoire en lycée professionnel, elle s’en sort : « On n’a pas d’enfant, je ne suis pas propriétaire. »"
                            }
                        ]
                    }
                ],
