                "senses": [
                    {
                        "sense_id": "d1f3d52a-0154-3cb4-aa73-c37744fcb5d6",
                        "entry_id": "28aa466e-3e61-324d-bbc7-328dc2c2b265",
                        "glosses": [
                            "A tribal chieftain in certain areas of Afghanistan and Pakistan, especially among the Pashtuns."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c31754ac-8641-4dd2-a644-360bb11f1309",
                                "sense_id": "d1f3d52a-0154-3cb4-aa73-c37744fcb5d6",
                                "text": "These outsiders introduced the idea that certain maliks in the nang areas, like the khans in the qalang areas, could receive special privileges in representing the jirga to the outside world. ¶ The notion of paying favored maliks in the FATA for their cooperation did not begin with the British."
                            }
                        ]
                    },
                    {
                        "sense_id": "79e451e6-d956-3e01-9064-9dc3de80eccd",
                        "entry_id": "28aa466e-3e61-324d-bbc7-328dc2c2b265",
                        "glosses": [
                            "A tribal chieftain in modern Assyrian society."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9ae1834-2436-4663-b097-68cf8caa10a4",
                                "sense_id": "79e451e6-d956-3e01-9064-9dc3de80eccd",
                                "text": "The leader of this party was Khoshaba, one of the chiefs, though not the real malik of the Lower Tiyari clan."
                            }
                        ]
                    }
                ],
