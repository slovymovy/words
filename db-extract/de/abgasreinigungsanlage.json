                            {
                                "example_id": "5197aebd-bc86-4d0c-9bdc-eda0aabd3fe7",
                                "sense_id": "b13fda6f-512e-329c-b96f-4e92f31ddbc9",
                                "text": "„Dank verschärfter Abgasvorschriften entwickelte die Automobilindustrie bessere Motoren, die weniger Sprit verbrauchen, und baute Abgasreinigungsanlagen in die Fahrzeuge ein.“"
                            },
                            {
                                "example_id": "83a93b45-bb66-45a3-bca4-27e20875f20a",
                                "sense_id": "b13fda6f-512e-329c-b96f-4e92f31ddbc9",
                                "text": "„Beim Dieselmotor gibt es Abgasreinigungsanlagen in Form von Partikelfiltern und Stickstoff-Katalysatoren.“"
                            }
                        ],
