                                "sense_id": "e287af2c-de4c-34ec-b845-870a20792e1e",
                                "text": "Sein Herz ist voller Verbitterung.",
                                "translation": "His heart is full of bitterness.",
                                "english": "His heart is full of bitterness."
                            }
                        ]
                    }
