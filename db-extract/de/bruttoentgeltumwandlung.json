                        "tags": [],
                        "examples": [
                            {
                                "example_id": "607265c1-fe6f-4c82-a635-60beeb939d5d",
                                "sense_id": "1cc7f57b-745a-3818-b67d-cf08e5fb05de",
                                "text": "„Zudem findet sich der Begriff Bruttoentgeltumwandlung, mit dem hervorgehoben wird, dass die Umwandlungsbeträge das Bruttoentgelt und damit auch die Steuern und Sozialabgaben mindern.“"
                            },
                            {
                                "example_id": "4187258b-de2f-4a33-b5bc-a102cc833054",
                                "sense_id": "1cc7f57b-745a-3818-b67d-cf08e5fb05de",
                                "text": "„Gleichzeitig haben nur zwölf Prozent von dem Begriff »Bruttoentgeltumwandlung« je etwas gehört.“"
                            },
                            {
                                "example_id": "25761161-4511-4314-9077-79daa8271ad2",
                                "sense_id": "1cc7f57b-745a-3818-b67d-cf08e5fb05de",
                                "text": "„Frag doch dort einfach nach, ob die Beiträge über Bruttoentgeltumwandlung oder Nettoentgeltumwandlung entrichtet wurden.“"
                            }
                        ],
