                "senses": [
                    {
                        "sense_id": "9b679017-c202-3ce3-ac20-a39645749a68",
                        "entry_id": "2a052d0c-f6b5-3ab3-9f29-d23d914fddcf",
                        "glosses": [
                            "Person, die untertreibt, die vorgibt, weniger zu sein und zu können, als sie ist und kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcc1251d-ca08-4a54-9740-76b55aae1259",
                                "sense_id": "9b679017-c202-3ce3-ac20-a39645749a68",
                                "text": "Tiefstapler unterschätzen ihre wahren Fähigkeiten und Talente."
                            },
                            {
                                "example_id": "4a9cb4f5-98e4-4007-be8d-d00043923b59",
                                "sense_id": "9b679017-c202-3ce3-ac20-a39645749a68",
                                "text": "„Elvis Costello ist entweder sehr bescheiden oder ein Tiefstapler: ‚Ich bin nicht wirklich ein Musiker‘, sagte der Sänger und Komponist dem ‚Zeitmagazin‘.“"
                            },
                            {
                                "example_id": "c928354c-8844-4736-923c-24be10c96b01",
                                "sense_id": "9b679017-c202-3ce3-ac20-a39645749a68",
                                "text": "„Ein Tiefstapler will nicht am Start beeindrucken, sondern am Ziel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
