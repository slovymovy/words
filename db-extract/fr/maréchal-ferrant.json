                "senses": [
                    {
                        "sense_id": "70c18a64-d473-39fa-a820-993527f94f78",
                        "entry_id": "bd01096a-7882-3ec9-b827-34b37ce22b13",
                        "glosses": [
                            "Celui dont le métier est de ferrer les chevaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25118f15-5b76-41ac-b032-6f825d6cc8b6",
                                "sense_id": "70c18a64-d473-39fa-a820-993527f94f78",
                                "text": "… ; au-delà de cet espace étaient des tentes avec des vivres et des rafraîchissements de toute espèce, avec des armuriers, des maréchaux-ferrants et autres serviteurs prêts à offrir leurs services partout où l’on en aurait besoin."
                            },
                            {
                                "example_id": "cc156436-cbb3-4dd7-978f-eb846fa68d99",
                                "sense_id": "70c18a64-d473-39fa-a820-993527f94f78",
                                "text": "Le cheval était en honneur alors et les vétérinaires si rares que le maréchal-ferrant qui les suppléait, même dans les villes, usurpait en même temps qu’un peu de leur art un peu de leur dignité."
                            },
                            {
                                "example_id": "672248ec-e61f-4347-a203-07f31c6829e7",
                                "sense_id": "70c18a64-d473-39fa-a820-993527f94f78",
                                "text": "À un bout les épiceries, à l’autre les selliers, les maréchaux-ferrants, les chevaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
