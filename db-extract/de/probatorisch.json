                ],
                "senses": [
                    {
                        "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                        "entry_id": "1cea5bad-857c-3670-a084-02516fe8de84",
                        "glosses": [
                            "als Versuch (durchgeführt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64c2f0f-f207-4372-95a5-62f4b89d64af",
                                "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                                "text": "„Da insbesondere Lactulose Bauchkrämpfe verursachen kann, kann probatorisch Simeticon eingesetzt werden.“"
                            },
                            {
                                "example_id": "4682c3d0-c689-4f9d-8773-24141f2167ce",
                                "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                                "text": "„Dieses Vorgehen ist probatorisch, nicht immer erfolgreich und mit Läsionsgefahr verbunden.“"
                            },
                            {
                                "example_id": "56279881-e65e-4dee-a22c-f5c82665ce9c",
                                "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                                "text": "„Besteht die Möglichkeit, die Patientin aufgrund der langen Vorgeschichte zunächst symptomatisch und probatorisch zu behandeln?“"
                            },
                            {
                                "example_id": "31d70f1d-276c-4745-b164-da2a797a67a6",
                                "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                                "text": "„Eine Anti-Reflux-Therapie wird zwar in einzelnen Fällen probatorisch versucht, ist nach unserer Erfahrungen jedoch in der Mehrzahl der Fälle nutzlos.“"
                            },
                            {
                                "example_id": "1bdad3c3-fbd2-41a3-8d58-94d9046b1a88",
                                "sense_id": "65e0196d-3fb5-3a07-b7fe-070f50fef9d5",
                                "text": "„Ist trotzdem unklar, ob der Patient an Schmerzen leidet, können probatorisch (versuchsweise) Analgetika verabreicht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
