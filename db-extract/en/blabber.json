                    {
                        "translation_id": "c78e1fde-a2f9-41c1-b52d-f69db6a59ef5",
                        "source_entry_id": "d489079b-b390-31f5-87d5-ecde747a732c",
                        "source_sense_description": "to let out a secret",
                        "target_lang_word": "разбалтывать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "разбалтывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "31269909-e8df-3cba-bf0d-83454b1e9b51",
                                        "entry_id": "af099720-ba1c-32e4-8d88-07cb6a5ac500",
                                        "glosses": [
                                            "разг. взбалтывая, растворять, равномерно распределять в жидкости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10be3f30-9511-44b0-92e1-24be09bff79a",
                                                "sense_id": "31269909-e8df-3cba-bf0d-83454b1e9b51",
                                                "text": "Разбалтывает таблетки чайной ложечкой; взбудораженное шампанское кипит."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "разбалтывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "aa1ab34b-435e-3773-bbee-70e49f2341ae",
                                        "entry_id": "585b78a6-6fef-3071-9269-c9304fa1c104",
                                        "glosses": [
                                            "разг. делать неустойчивым; расшатывать"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c89fe6a7-3231-3fd3-8b45-42e0700d131d",
                                        "entry_id": "585b78a6-6fef-3071-9269-c9304fa1c104",
                                        "glosses": [
                                            "перен., разг. уменьшать требовательность, ослаблять дисциплину; распускать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81261412-88e8-44d7-a2f1-14e761d0ce51",
                                                "sense_id": "c89fe6a7-3231-3fd3-8b45-42e0700d131d",
                                                "text": "Общение со штатскими разбалтывало офицеров, никак не добавляя им чисто технических знаний, потому что участвовать в монтаже Ращупкин офицерам запрещал."
                                            },
                                            {
                                                "example_id": "b5e078bf-0fcc-451d-8ffa-4bc17f45ef22",
                                                "sense_id": "c89fe6a7-3231-3fd3-8b45-42e0700d131d",
                                                "text": "При таком способе работы длительное время уходит на вялую «раскачку», весьма мало продвигающую ученика вперёд, но зато сильно «разбалтывающую» его, разбивающую рабочее настроение."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "разбалтывать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e228ac6e-f4c6-36f9-ba66-ac227028e8d9",
                                        "entry_id": "6b9a0237-1baf-3cd8-9439-3dca3d5aba8a",
                                        "glosses": [
                                            "разг. рассказывать кому-либо то, о чём не следует говорить; выдавать секрет"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "961a7ef9-222b-4527-927d-ed63e8eda62b",
                                                "sense_id": "e228ac6e-f4c6-36f9-ba66-ac227028e8d9",
                                                "text": "Тит не любил разбалтывать в своей семье и ничего не сказал жене про вчерашнее."
                                            },
                                            {
                                                "example_id": "b92e4621-4cad-45a5-accf-ac41fd376c80",
                                                "sense_id": "e228ac6e-f4c6-36f9-ba66-ac227028e8d9",
                                                "text": "О заседаниях клуба и о его делах, как говорится в пункте седьмом, никому разбалтывать нельзя."
                                            },
                                            {
                                                "example_id": "4c384f34-8cd6-4a31-a23c-865f53542a2d",
                                                "sense_id": "e228ac6e-f4c6-36f9-ba66-ac227028e8d9",
                                                "text": "Различные партии ведут борьбу друг с другом, умышленно разбалтывая одни факты и утаивая другие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
