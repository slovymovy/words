                    {
                        "translation_id": "14794b57-2891-4834-8bec-682519e8a9fb",
                        "source_entry_id": "57ed3767-c890-3c98-a351-241bc5f811a9",
                        "source_sense_id": "ce99b7ba-5c31-386a-bb3a-5b13d6464064",
                        "target_lang_word": "Begabung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begabung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                        "entry_id": "c209dbc2-7141-3ac9-a8e9-8901207af49c",
                                        "glosses": [
                                            "angeborene überdurchschnittliche, besondere Fähigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28da1ba7-ac3e-4e21-957c-343601202eb8",
                                                "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                                "text": "Er hat eine besondere Begabung für Sprachen."
                                            },
                                            {
                                                "example_id": "310c0112-b98d-4d29-97c1-20556a8fec79",
                                                "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                                "text": "„Die Bilanz aller Auskünfte rechtfertigt jedenfalls die Annahme, daß der Grund für das frühe Außenseitertum, in dem Siggi J. sich vorfand, einzig und allein in seiner Begabung zu suchen ist.“"
                                            },
                                            {
                                                "example_id": "92ac1c5a-7ce8-400f-98db-b570db6e85f3",
                                                "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                                "text": "„Nach dem Krieg diente er dem Münchner Reichswehrkommando wegen seiner rednerischen Begabung zunächst als Schulungsredner.“"
                                            },
                                            {
                                                "example_id": "11a93755-6d7a-46ab-9729-ac309aa8325a",
                                                "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                                "text": "„Er war ein eleganter Bonvivant geworden und schien eine echte Begabung für die Leitung eines Hotels zu haben.“"
                                            },
                                            {
                                                "example_id": "4de97fa7-70d2-4300-a995-bc04b69bb623",
                                                "sense_id": "66f8f9bc-433b-3809-ab2f-61461c1a462b",
                                                "text": "„Buschs Werdegang wäre leichter gewesen, wenn ihn eine eindeutige Begabung der Malerei zugeführt hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
