                ],
                "senses": [
                    {
                        "sense_id": "a428554b-0bb3-31ef-bd34-4844a038092d",
                        "entry_id": "751835ae-7229-3054-abdf-0b6968899c86",
                        "glosses": [
                            "diep verdrietig en treurig makend; op een grievende manier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acf2b6dd-100f-41aa-b4ac-cf75e78c0efb",
                                "sense_id": "a428554b-0bb3-31ef-bd34-4844a038092d",
                                "text": "En opnieuw kwam de vreselijke herinnering, die altijd weer haar hart deed ineenkrimpen, in haar op aan de dood van haar jongste zoontje dat nog als baby aan kroep was gestorven, aan zijn begrafenis, aan de algemene onverschilligheid rondom het kleine roze kistje en aan haar eigen hartbrekend, eenzaam verdriet bij het zien van dat witte voorhoofd met de kleine krullen bij de slapen, van het verwonderde, half geopende mondje dat nog als laatste zichtbaar was, toen zij er het roze deksel met het geborduurde kruis overheen legden."
                            },
                            {
                                "example_id": "81e49fd4-d901-4ca0-aa54-e7828775910e",
                                "sense_id": "a428554b-0bb3-31ef-bd34-4844a038092d",
                                "text": "Afgelasting festivals: ‘Enorm bittere pil’ en ‘hartbrekend’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2faf202-5e0d-4a4a-ab85-bac77f444e58",
                        "source_entry_id": "751835ae-7229-3054-abdf-0b6968899c86",
                        "source_sense_id": "a428554b-0bb3-31ef-bd34-4844a038092d",
                        "source_sense_description": "diep verdrietig en treurig makend; op een grievende manier",
                        "target_lang_word": "poignant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poignant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba6311db-ecf9-324b-b3a6-73e1aa29ed57",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Sharp-pointed; keen."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3102a968-e500-4146-9b13-ee5206661dbe",
                                                "sense_id": "ba6311db-ecf9-324b-b3a6-73e1aa29ed57",
                                                "text": "His siluer shield, now idle maisterlesse; / His poynant speare, that many made to bleed [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e2ce93-a6c3-3e01-922e-32e1d543f54e",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Neat; eloquent; applicable; relevant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81bd89ec-8f13-4195-b32b-b5810fc6da87",
                                                "sense_id": "44e2ce93-a6c3-3e01-922e-32e1d543f54e",
                                                "text": "A poignant reply will garner more credence than hours of blown smoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Evoking strong mental sensation, to the point of distress; emotionally moving."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310ec0a1-8cf2-4705-b260-dd7c69b40c29",
                                                "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                                                "text": "Flipping through his high school yearbook evoked many a poignant memory of yesteryear."
                                            },
                                            {
                                                "example_id": "f966ac2e-1dd3-461b-af9a-2bd80fc52b71",
                                                "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                                                "text": "The shabby chest of drawers was spread with a lace cover, and set out with a few gold-topped boxes and bottles, a rose-coloured pin-cushion, a glass tray strewn with tortoise-shell hair[-]pins—he shrank from the poignant intimacy of these trifles, and from the blank surface of the toilet-mirror above them."
                                            },
                                            {
                                                "example_id": "bb7db722-0cd1-4e48-8ee4-833d656a8b0d",
                                                "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                                                "text": "A particularly poignant example of this is a child called Genie (see Curtiss 1977; Rymer 1993), who was deprived of speech input and kept locked up on her own in a room until age thirteen. When eventually taken into care and exposed to intensive language input, her vocabulary grew enormously, but her syntax never developed."
                                            },
                                            {
                                                "example_id": "35d795ce-0fa7-489a-9c3b-9c8a7e49bb59",
                                                "sense_id": "4f8fc875-4a9e-3bd6-97c4-25f67129844f",
                                                "text": "Hanks shepherds the young girl to safety – first brusquely, and then with a sudden outburst of affection made all the more poignant for the way it is reserved previously. He once again reminds us, quite literally, that he is in many ways the ultimate dad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c6508e1-4a7d-39b6-ac91-ae8f6693de87",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Piquant, pungent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ad30cc3-c523-3632-86d0-99707c359a64",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Incisive; penetrating; piercing."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8937a6b-b938-4b56-b605-53f96ca6c9fe",
                                                "sense_id": "3ad30cc3-c523-3632-86d0-99707c359a64",
                                                "text": "His comments were poignant and witty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40d4476e-71e1-387e-b2be-a8107491e767",
                                        "entry_id": "699adb76-e27a-358f-98eb-08fc62c3cfb9",
                                        "glosses": [
                                            "Inducing sharp physical pain."
                                        ],
                                        "tags": [
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
