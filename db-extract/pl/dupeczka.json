                "senses": [
                    {
                        "sense_id": "0c91f043-2905-3b46-a06b-8504a1e8af64",
                        "entry_id": "85a9be06-fde2-3c83-8fc6-209774d036db",
                        "glosses": [
                            "od: dupa"
                        ],
                        "tags": [
                            "colloquial",
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "cdfe2b4e-22ad-4824-92aa-6bab4475ddcf",
                                "sense_id": "0c91f043-2905-3b46-a06b-8504a1e8af64",
                                "text": "Dwadzieścia lat, 170 centymetrów wzrostu, para wspaniałych nóg i dupeczka – jak dla mnie – mistrzostwo świata. Miała lekki kompleks z powodu małych piersi, moim zdaniem jednak nic im nie brakowało."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5bb66b0f-98e0-328b-8a13-47a5145789a5",
                        "entry_id": "85a9be06-fde2-3c83-8fc6-209774d036db",
                        "glosses": [
                            "młoda, seksualnie atrakcyjna dziewczyna/kobieta"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "70aea749-f6b6-4985-92f1-584a767a16d0",
                                "sense_id": "5bb66b0f-98e0-328b-8a13-47a5145789a5",
                                "text": "Udami natrafiła na podłokietnik kanapy. Wtedy jego palce musnęły bok jej szyi. – Do diabła, naprawdę niezła z ciebie dupeczka."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
