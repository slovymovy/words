                        ],
                        "examples": [
                            {
                                "example_id": "61be002c-d0ef-42e7-997e-58f8da5d4ab4",
                                "sense_id": "92c82c27-98a5-3902-b073-b1bd46006b31",
                                "text": "L’armement se composait de fusils de rebut de toute provenance ou de Martini-Henry fabriqués par la makina de Fez. Cette manufacture d’armes, créée par Mouley El-Hassan et dirigée par une mission militaire italienne, produisait en moyenne cinq fusils par jour."
                            },
                            {
                                "example_id": "3f93c9a9-23be-4278-8627-67b63eb4b4ca",
                                "sense_id": "92c82c27-98a5-3902-b073-b1bd46006b31",
                                "text": "Moulay Hassan 1ᵉʳ (1873-1894) va inaugurer les constructions modernes et industrielles ; c'est lui qui fait construire la Makina, l'arsenal de Fès et agrandir Dar el Makhzen."
                            }
                        ]
                    }
