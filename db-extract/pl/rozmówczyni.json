                        "examples": [
                            {
                                "example_id": "0256e3cc-b431-4396-bd92-4ed452e1e12c",
                                "sense_id": "302fec97-5802-32f9-9434-9186797fd10a",
                                "text": "Widocznie mojej wytapirowanej rozmówczyni wcale nie było to na rękę."
                            },
                            {
                                "example_id": "995f4238-24c8-4222-a218-21303578bbdb",
                                "sense_id": "302fec97-5802-32f9-9434-9186797fd10a",
                                "text": "Rozmówczyni dreptała więc spiesznie długim korytarzem w kierunku kuchni, która mieściła się przy końcu służbowego skrzydła domu."
                            }
                        ],
