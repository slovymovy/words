                        "cross_references": [
                            {
                                "target_word": "sex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c661a07-9db5-323a-8e25-292b4df4f4cb",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "A category into which sexually-reproducing organisms are divided on the basis of their reproductive roles in their species; the system of such categories, which can differ by organism or by taxonomic branch."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58a63c1f-9181-4180-a4fe-308f1a76a086",
                                                "sense_id": "2c661a07-9db5-323a-8e25-292b4df4f4cb",
                                                "text": "The effect of the medication is dependent upon age, sex, and other factors."
                                            },
                                            {
                                                "example_id": "979528ae-25f2-4f4f-8972-040c2ad6d04e",
                                                "sense_id": "2c661a07-9db5-323a-8e25-292b4df4f4cb",
                                                "text": "The right of citizens of the United States to vote shall not be denied or abridged by the United States or by any State on account of sex."
                                            },
                                            {
                                                "example_id": "039f6822-da92-4605-ade5-c4bff6c45d0f",
                                                "sense_id": "2c661a07-9db5-323a-8e25-292b4df4f4cb",
                                                "text": "I would never have guessed […] that slime molds can have thirteen sexes."
                                            },
                                            {
                                                "example_id": "fcfc5c6d-7565-44b5-b670-2945f14f9b54",
                                                "sense_id": "2c661a07-9db5-323a-8e25-292b4df4f4cb",
                                                "text": "The State Department and current Secretary of State Marco Rubio are expressly directed under the injunction to “to process and issue passports [...] consistent with the State Department’s policy as of January 19, 2025,” and to allow passport applicants to self-declare their gender even if that information is “different from the sex assigned to those individuals under the [Trump] Passport Policy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a62adf-9149-3d1c-b062-331e0b753975",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "Another category, especially of humans and especially based on sexuality or gender roles."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e0fc5c-38a1-4392-b080-1ebc54297e19",
                                                "sense_id": "c0a62adf-9149-3d1c-b062-331e0b753975",
                                                "text": "Still there are some loop-holes out of which a man may creep, and dare to think and act for himself; but for a woman it is an herculean task, because she has difficulties peculiar to her sex to overcome, which require almost super-human powers."
                                            },
                                            {
                                                "example_id": "67ca135b-13e0-46eb-8009-612f7fe06f96",
                                                "sense_id": "c0a62adf-9149-3d1c-b062-331e0b753975",
                                                "text": "\"But now another sex, in arms, is brought, / And, realms to guard, are eunuchs able thought!\""
                                            },
                                            {
                                                "example_id": "1855435b-f611-4508-9387-fa9e16c886cf",
                                                "sense_id": "c0a62adf-9149-3d1c-b062-331e0b753975",
                                                "text": "A black old neutral personage / Of the third sex stept up."
                                            },
                                            {
                                                "example_id": "de3287a9-6778-411d-a50d-499d00be800b",
                                                "sense_id": "c0a62adf-9149-3d1c-b062-331e0b753975",
                                                "text": "I have encountered officers who believe a woman got a better assignment or somehow \"got over\" because of her sex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87338f01-4c4c-35db-b0a4-4c91516ed282",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "The members of such a category, taken collectively."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2c96255-510f-40a6-97cd-0314e23ca333",
                                                "sense_id": "87338f01-4c4c-35db-b0a4-4c91516ed282",
                                                "text": "the fairer sex"
                                            },
                                            {
                                                "example_id": "dcfca3e0-4d0e-4597-82bf-c0afa6c4a6bc",
                                                "sense_id": "87338f01-4c4c-35db-b0a4-4c91516ed282",
                                                "text": "It was a weakness / In me, but incident to all our sex."
                                            },
                                            {
                                                "example_id": "a89bd81e-5e65-4dee-a52a-3912e740b8dd",
                                                "sense_id": "87338f01-4c4c-35db-b0a4-4c91516ed282",
                                                "text": "The sensibility of the female sex appears […] to be greater than that of the male."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13354210-86ff-384d-bb9f-7ab41e156c5a",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "The distinction and relation between these categories, especially in humans; gender."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3259c318-7d62-4c34-9e47-a52db2792d4f",
                                                "sense_id": "13354210-86ff-384d-bb9f-7ab41e156c5a",
                                                "text": "A lot of women now like men to pay for them on dates... We've dealt with the outdated view of sex underpinning this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc3cd26e-77ea-3aae-b482-a02478df3a53",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "Women; the human female gender and those who belong to it."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete",
                                            "uncountable",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15d58fcb-d956-4d95-9abc-47103bd5b180",
                                                "sense_id": "dc3cd26e-77ea-3aae-b482-a02478df3a53",
                                                "text": "The sex of Venice are undoubtedly of a distinguished beauty."
                                            },
                                            {
                                                "example_id": "fe6bb944-3f9e-47f4-a60d-2c36f6ef3d7b",
                                                "sense_id": "dc3cd26e-77ea-3aae-b482-a02478df3a53",
                                                "text": "I was not, however, better than my neighbors; the Sex had its charms for me as it had for others; But there always remained a sting, that time only wore away."
                                            },
                                            {
                                                "example_id": "81a33c91-05fc-41f2-80dd-0aff2ce31aca",
                                                "sense_id": "dc3cd26e-77ea-3aae-b482-a02478df3a53",
                                                "text": "Even the reptile temperament of Noel Vanstone warmed under the influence of the sex: he had an undeniably appreciative eye for a handsome woman, and Magdalen's grace and beauty were not thrown away on him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "Sexual activity, usually sexual intercourse unless preceded by a modifier."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b574f0-b0c0-453a-88e5-7f815828785a",
                                                "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                                "text": "1934, translation of the Qur'an (23:5) by Abdullah Yusuf Ali\n(The believers ... those ... ) who abstain from sex"
                                            },
                                            {
                                                "example_id": "6bf6639f-6507-4fb6-964e-5e5e87d32945",
                                                "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                                "text": "We marry in fear and trembling, sex for a home is the woman's traffic, and the man comes to his heart's desire when his heart's desire is dead."
                                            },
                                            {
                                                "example_id": "d653bbd4-3dba-4ac0-9fa4-7e61871da65f",
                                                "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                                "text": "If you want to have sex, you've got to trust / At the core of your heart, the other creature."
                                            },
                                            {
                                                "example_id": "aae2e88a-7cfd-4b54-96d2-ac05eb81ba60",
                                                "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                                "text": "Why wasn't Bond ‘more tender’ in his love-making? Why did he just ‘have sex’ and disappear?"
                                            },
                                            {
                                                "example_id": "b004af36-284d-496e-b2b3-cb2ff0a121ca",
                                                "sense_id": "b7a3b27f-ab7e-3ed4-9b72-c5f99f3c5edd",
                                                "text": "It wouldn't work with you... Sex, I mean. You're... easy to be with. You're... you're not dangerous. You're my best friend, John. I couldn't have it on with my best friend, John. It would be embarrassing. Sorry. Honest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a9c910f-4f30-3f5b-9498-27bba5c3154d",
                                        "entry_id": "bea26970-9c7e-3ecc-b1dc-e1fb23cd7432",
                                        "glosses": [
                                            "Genitalia: a penis or vagina/vulva."
                                        ],
                                        "tags": [
                                            "countable",
                                            "euphemistic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f444a4a-cafc-4ce0-b0a1-ef648f991700",
                                                "sense_id": "9a9c910f-4f30-3f5b-9498-27bba5c3154d",
                                                "text": "Another ha's gon through with the bargain... One that will find the way to her Sex, before you'le come to kissing her hand."
                                            },
                                            {
                                                "example_id": "66449724-e5d1-40d6-a230-0cc9e4847db0",
                                                "sense_id": "9a9c910f-4f30-3f5b-9498-27bba5c3154d",
                                                "text": "And the black cypresses strained upwards like the sex of a hanged man."
                                            },
                                            {
                                                "example_id": "66a8a509-1e50-4f84-8e2b-c4e187ec7d6f",
                                                "sense_id": "9a9c910f-4f30-3f5b-9498-27bba5c3154d",
                                                "text": "She touched his sex with her hand."
                                            },
                                            {
                                                "example_id": "1fd801b4-f478-490a-b826-b6131aa776fe",
                                                "sense_id": "9a9c910f-4f30-3f5b-9498-27bba5c3154d",
                                                "text": "And he put in a fake sex (penis) because he wanted to make the scene more real, more rude."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sex",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d595424a-535c-3f97-9353-c73c259ba894",
                                        "entry_id": "b3daef83-e020-3932-86cc-5c07f8d03883",
                                        "glosses": [
                                            "To determine the sex of (an animal)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97b882f9-1af0-4064-8cf2-566c4e8811f5",
                                                "sense_id": "d595424a-535c-3f97-9353-c73c259ba894",
                                                "text": "If we sex the cattle, which is the only way to get at their value, we shall have... 400 cows, 200 yearling heifers."
                                            },
                                            {
                                                "example_id": "eafb467c-3b37-4170-b0a8-dd71e7f216b8",
                                                "sense_id": "d595424a-535c-3f97-9353-c73c259ba894",
                                                "text": "If, in fact, in L. funebris there is no sex marker on the song elements themselves, then a young bird must be able to sex its tutor. The same is true if the individuals were predisposed to produce the total vocabulary of any population, or of both sexes in their own population, and then under experience had to suppress a sex-specific subset of that repertoire [7]. It seems unrealistic to assume the reverse, that a parent bird can sex by some hidden cues newly hatched sexually monomorphic offspring and direct its own vocabulary to consexual young only."
                                            },
                                            {
                                                "example_id": "a8325e5c-1b4c-4d8b-ac98-2d9d87daa319",
                                                "sense_id": "d595424a-535c-3f97-9353-c73c259ba894",
                                                "text": "The ability to sex birds invasively through laparoscopy initially solved that problem, but now it is even easier and less stressful on the birds through testing the DNA of their feathers or blood."
                                            },
                                            {
                                                "example_id": "ea1d6bc1-5cef-421d-b574-d478b13fdb4a",
                                                "sense_id": "d595424a-535c-3f97-9353-c73c259ba894",
                                                "text": "Semen usually is sexed at 90% accuracy, and the sexes of calves at birth almost always are in that statistical range if averaged over […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                        "entry_id": "b3daef83-e020-3932-86cc-5c07f8d03883",
                                        "glosses": [
                                            "To have sex with."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958d4f25-efb9-4dd1-8e9c-92fe9928dcf0",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "As good as Muddah had handled me in bed, sexing her hadn't done a damn thing to take my mind off my cousin Smoove."
                                            },
                                            {
                                                "example_id": "a9aa76d6-d852-4d59-ad05-3c18fe4e5183",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "He shows some glimpses, but most of the released singles are about flossing, partying, and sexing women."
                                            },
                                            {
                                                "example_id": "347e50ec-eb3f-4e2d-a905-450e2079be8c",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "Sex with Ivory had gotten better than sexing his wife. Herschel laughed with Ivory, cried with Ivory. They dreamt aloud together. Unlike Nikki, Ivory believed in him. Every man needed a woman who believed in him."
                                            },
                                            {
                                                "example_id": "126f7257-60cc-4978-8d55-cab81a2744eb",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "\"Do you ever think about how you're betraying your client while you're sexing his wife?\""
                                            },
                                            {
                                                "example_id": "5f218c91-2060-4891-969a-3ae7ecf0d99d",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "Wosick-Correa, K. R., 81 Joseph, L. J. Sexy ladies sexing ladies: Women as consumers in strip clubs. Journal of Sex Research, 45, 3 (July 2008), 201-216."
                                            },
                                            {
                                                "example_id": "16d85e9d-107f-45ee-9640-3157ea443a0b",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "His body shook uncontrollably as he imagined another man sexing his wife."
                                            },
                                            {
                                                "example_id": "2aae971a-2b90-4e72-9d95-3cb15f88e861",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "The last thing a jealous husband wants to think about is another man sexing his wife when he's dead and gone."
                                            },
                                            {
                                                "example_id": "1dc2f6e0-b76b-4e57-8886-a8ecda3743a7",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "Sexing his wife anally would remind him of having sex with Baron."
                                            },
                                            {
                                                "example_id": "9251d765-38c3-462f-b4f6-2a065f6c6601",
                                                "sense_id": "be15141e-cfe7-3a54-aba9-7154c2e5a561",
                                                "text": "The neighbor guy, I just came to understand, is sexing the lady across the street from him. He's got a girlfriend. She is married. While I don't think that is particularly cool, I also don't think it is any of my business either."
                                            }
                                        ]
                                    },
                                    {
