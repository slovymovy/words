                "senses": [
                    {
                        "sense_id": "af4717c9-15e2-3eb7-bce0-d4acc4217469",
                        "entry_id": "24a038fd-a42c-3125-81e5-4d0109d037f9",
                        "glosses": [
                            "Wahrnehmung von Geruch in der Luft, an sich selbst oder an Stoffen, der von Essigsäure stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0886b4d-e75e-4e71-9eab-2c2b29b0e1a4",
                                "sense_id": "af4717c9-15e2-3eb7-bce0-d4acc4217469",
                                "text": "„Erkennbar ist dieser Prozess an einem strengen Essiggeruch (Plumb 1995; McEvoy 1992).“"
                            },
                            {
                                "example_id": "13d1a156-77ea-4e74-97da-01d8af6b74e7",
                                "sense_id": "af4717c9-15e2-3eb7-bce0-d4acc4217469",
                                "text": "„Es tritt ein intensiver Essiggeruch auf.“"
                            },
                            {
                                "example_id": "7753a058-2fac-40f6-a52a-03b10ef74f60",
                                "sense_id": "af4717c9-15e2-3eb7-bce0-d4acc4217469",
                                "text": "„Der beim Verarbeiten auftretende Geruch gibt Hinweise auf die Vernetzungsart des Silikondichtstoffes, und sicherlich ist jedem der typische Essiggeruch bei vielen dieser Produkte bekannt.“"
                            },
                            {
                                "example_id": "b743ceb0-1b3d-4d66-aad2-64d2fb8083f8",
                                "sense_id": "af4717c9-15e2-3eb7-bce0-d4acc4217469",
                                "text": "„Die bildtragende Schicht der betroffenen Filme droht sich vom darunter liegenden Trägermaterial abzuspalten, was durch einen intensiven Essiggeruch (sog. \"vinegar syndrome\") angekündigt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
