{
    "word_family": [
        "promote",
        "promotion",
        "promotional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7b80d91d-68fa-3d38-ae5c-6575737622a6",
                    "sense_definition": "A person or organization that helps organize, finance, or advertise events or products.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "promoter_organizer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert <w>promoter</w> sold thousands of tickets in just a few hours.",
                            "target_lang_translations": {
                                "tr": "Konser <w>organizatörü</w> sadece birkaç saat içinde binlerce bilet sattı."
                            }
                        },
                        {
                            "text": "She works as an event <w>promoter</w> for local sports tournaments.",
                            "target_lang_translations": {
                                "tr": "Yerel spor turnuvalarında etkinlik <w>organizatörü</w> olarak çalışıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "organizer",
                        "sponsor"
                    ],
                    "common_phrases": [
                        "event promoter",
                        "music promoter",
                        "concert promoter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Etkinliklerin veya ürünlerin düzenlenmesine, finanse edilmesine veya reklamının yapılmasına yardımcı olan kişi veya kuruluş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "organizatör",
                                "target_lang_sense_clarification": "etkinlik düzenleyici"
                            },
                            {
                                "target_lang_word": "promatör",
                                "target_lang_sense_clarification": "reklam ve organizasyon yapan kimse"
                            },
                            {
                                "target_lang_word": "sponsor",
                                "target_lang_sense_clarification": "finansal destek sağlayan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0dcf71b-768f-3252-ac89-720969adc8da",
                    "sense_definition": "A person who actively supports or encourages a cause, idea, or activity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "promoter_supporter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a strong <w>promoter</w> of healthy living and daily exercise.",
                            "target_lang_translations": {
                                "tr": "O, sağlıklı yaşamın ve günlük egzersizin güçlü bir <w>savunucusudur</w>."
                            }
                        },
                        {
                            "text": "As a vocal <w>promoter</w> of peace, she spent her life advocating for disarmament.",
                            "target_lang_translations": {
                                "tr": "Barışın sesini duyuran bir <w>savunucusu</w> olarak, hayatını silahsızlanmayı savunmaya adadı."
                            }
                        }
                    ],
                    "synonyms": [
                        "advocate",
                        "supporter",
                        "proponent"
                    ],
                    "antonyms": [
                        "detractor"
                    ],
                    "common_phrases": [
                        "vocal promoter",
                        "strong promoter"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir davayı, fikri veya faaliyeti aktif olarak destekleyen veya teşvik eden kişi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "savunucu",
                                "target_lang_sense_clarification": "fikir veya ilkeleri destekleyen kimse"
                            },
                            {
                                "target_lang_word": "destekçi",
                                "target_lang_sense_clarification": "teşvik eden kişi"
                            },
                            {
                                "target_lang_word": "öncü",
                                "target_lang_sense_clarification": "bir hareketin öncülüğünü yapan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a89d89e8-fe71-3969-bcc3-6941298a7cdf",
                    "sense_definition": "A region of DNA that initiates transcription of a particular gene.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "genetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enzyme binds to the gene's <w>promoter</w> to begin RNA synthesis.",
                            "target_lang_translations": {
                                "tr": "Enzim, RNA sentezini başlatmak için genin <w>promotörüne</w> bağlanır."
                            }
                        },
                        {
                            "text": "Mutations in the <w>promoter</w> region can affect gene expression levels.",
                            "target_lang_translations": {
                                "tr": "<w>Promotör</w> bölgesindeki mutasyonlar gen ifade düzeylerini etkileyebilir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "promoter region",
                        "promoter gene"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/technical domain"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Belirli bir genin transkripsiyonunu başlatan DNA bölgesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "promotör",
                                "target_lang_sense_clarification": "genetikte DNA dizilimi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43f26e90-1bb3-3894-8835-17995f315e9d",
                    "sense_definition": "A substance added to a catalyst to increase its activity or selectivity.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Adding a chemical <w>promoter</w> enhanced the efficiency of the reaction.",
                            "target_lang_translations": {
                                "tr": "Kimyasal bir <w>hızlandırıcı</w> eklemek reaksiyonun verimliliğini artırdı."
                            }
                        },
                        {
                            "text": "The catalyst relies on a small amount of a <w>promoter</w> to function effectively.",
                            "target_lang_translations": {
                                "tr": "Katalizör, etkili bir şekilde çalışmak için az miktarda bir <w>promatöre</w> ihtiyaç duyar."
                            }
                        }
                    ],
                    "synonyms": [
                        "accelerator"
                    ],
                    "common_phrases": [
                        "catalyst promoter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/technical domain"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Aktivitesini veya seçiciliğini artırmak için bir katalizöre eklenen madde."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "promatör",
                                "target_lang_sense_clarification": "kimyada katalizör aktifleştirici"
                            },
                            {
                                "target_lang_word": "hızlandırıcı",
                                "target_lang_sense_clarification": "reaksiyon hızını artıran madde"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}