                "senses": [
                    {
                        "sense_id": "dcb4d8fb-f78b-353b-88d6-5807d951a4a3",
                        "entry_id": "58bcf663-f340-3c49-8e7c-50a473936464",
                        "glosses": [
                            "vruchten van het geslacht Capsicum van de nachtschadefamilie (Solanaceae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cd4d91f-f581-4f52-820e-3f78365a55af",
                                "sense_id": "dcb4d8fb-f78b-353b-88d6-5807d951a4a3",
                                "text": "Hoewel niet iedereen gaat stralen bij de gedachte aan chilipeper, schijnt dit toch een oppepper te zijn voor je humeur. Onze hersenen maken endorfine aan om het lichaam te kalmeren zodra we de stof capsaïcine binnenkrijgen. Capsaïcine is de stof die chilipeper pittig maakt. Door heel pittig eten kun je zelfs een euforisch gevoel krijgen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0b2b82f-50ef-3081-9dc5-1befe39626a7",
                        "entry_id": "58bcf663-f340-3c49-8e7c-50a473936464",
                        "glosses": [
                            "gedroogde specerij gemaakt van de vruchten van het geslacht Capsicum van de nachtschadefamilie (Solanaceae)"
                        ],
                        "tags": [
                            "specerij"
                        ],
                        "examples": [
                            {
                                "example_id": "a37b1065-4f6d-413d-9aff-bbd846b92ab8",
                                "sense_id": "f0b2b82f-50ef-3081-9dc5-1befe39626a7",
                                "text": ". \"Mijn bieren hebben echt een eigen stijl, die bij mij past. Uitgesproken smaken, bijzondere namen, een beetje rock ’n roll. Neem bijvoorbeeld onze ‘Sambal bij’, een blond biertje met een beetje honing en…. chilipeper."
                            },
                            {
                                "example_id": "b53bf3a2-e4f1-4ffd-be8c-bbaa0c4a07a4",
                                "sense_id": "f0b2b82f-50ef-3081-9dc5-1befe39626a7",
                                "text": "In het Verenigd Koninkrijk is een man met spoed overgebracht naar het ziekenhuis. Hij had hevige buikpijn gekregen na het eten van drie kippenvleugeltjes die gedoopt waren in een saus van de heetste chilipeper ter wereld."
                            }
                        ]
                    }
