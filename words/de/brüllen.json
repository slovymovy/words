{
    "word_family": [
        "Gebrüll",
        "Brüller",
        "anbrüllen",
        "aufbrüllen",
        "niederbrüllen",
        "Brüllaffe"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66722766-59f4-3530-9927-4b82bf5475f1",
                    "sense_definition": "mit sehr lauter, erregter oder unkontrollierter Stimme rufen oder schreien, meist aus Wut, Angst oder Schmerz",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "menschliche_stimme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der wütende Mann <w>brüllte</w> laut über den Hof, sodass alle Nachbarn erschraken."
                        },
                        {
                            "text": "Als er sich den Finger einklemmte, <w>brüllte</w> er vor Schmerz."
                        }
                    ],
                    "synonyms": [
                        "schreien",
                        "rufen"
                    ],
                    "antonyms": [
                        "flüstern",
                        "wispern",
                        "sprechen"
                    ],
                    "common_phrases": [
                        "vor Schmerz brüllen",
                        "vor Lachen brüllen",
                        "wie am Spieß brüllen"
                    ]
                },
                {
                    "sense_id": "40fddf8c-bf61-339b-8b82-0ad8dce827db",
                    "sense_definition": "von Tieren: einen lauten, tiefen Ruf oder Drohlaut ausstoßen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "tierlaut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Zoo <w>brüllte</w> der mächtige Löwe so laut, dass die Besucher erschrocken zurückwichen."
                        },
                        {
                            "text": "In der Ferne <w>brüllen</w> die Affen durch den dichten Dschungel."
                        }
                    ],
                    "common_phrases": [
                        "wie ein Löwe brüllen"
                    ]
                },
                {
                    "sense_id": "b71937ed-801a-3556-8c49-e93dbee055b0",
                    "sense_definition": "mit gewaltiger Lautstärke tönen, tosen oder dröhnen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geraeusch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laute Musik <w>brüllte</w> den ganzen Nachmittag aus den geöffneten Fenstern der Wohnung."
                        },
                        {
                            "text": "Die schweren Motoren der Rennwagen <w>brüllten</w> beim Start über die ganze Strecke."
                        }
                    ],
                    "synonyms": [
                        "dröhnen",
                        "tosen",
                        "donnern"
                    ],
                    "common_phrases": [
                        "aus den Lautsprechern brüllen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "02fcae8e-3601-3377-9998-6e02f12046de",
                    "sense_definition": "das laute Schreien oder Tönen; Substantivierung des Verbs <w>brüllen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "substantiviert",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das laute <w>Brüllen</w> des Löwen riss die Touristen mitten in der Nacht aus dem Schlaf."
                        },
                        {
                            "text": "Aus dem Klassenzimmer drang ein hemmungsloses <w>Brüllen</w>, das bis auf den Flur zu hören war."
                        }
                    ],
                    "common_phrases": [
                        "ein lautes Brüllen"
                    ]
                }
            ]
        }
    ]
}