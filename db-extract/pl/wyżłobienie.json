                "translations": [
                    {
                        "translation_id": "6965ab81-d1dd-46cc-9596-0270c89a5297",
                        "source_entry_id": "808f9e0c-7a36-3fee-80ab-123c1d56f6b2",
                        "source_sense_id": "a458de85-916d-3c68-981e-9c9d3facf7a2",
                        "target_lang_word": "groove",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c33ce8b8-cbd3-3a70-b153-ce42811eacac",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "A long, narrow channel or depression; e.g., such a slot cut into a hard material to provide a location for an engineering component, a tire groove, or a geological channel or depression."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef07b490-e2e8-38a7-988f-00213cd50ccd",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "A fixed routine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b1460ec-f34c-4a6f-907e-023194666423",
                                                "sense_id": "ef07b490-e2e8-38a7-988f-00213cd50ccd",
                                                "text": "Through these distresses, the Odd Girl was cheerful and exemplary. But within four hours after dark we had got into a supernatural groove, and the Odd Girl had seen “Eyes,” and was in hysterics."
                                            },
                                            {
                                                "example_id": "7eb6bf33-64a6-45a6-a72d-33d3c12aebe0",
                                                "sense_id": "ef07b490-e2e8-38a7-988f-00213cd50ccd",
                                                "text": "The gregarious trifling of life in the social groove."
                                            },
                                            {
                                                "example_id": "84d82455-f7b7-48d3-8c6d-2a65a945f154",
                                                "sense_id": "ef07b490-e2e8-38a7-988f-00213cd50ccd",
                                                "text": "His counterpart Neil Warnock got his tactics spot on as Chelsea struggled to get into any sort of groove in the first half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa98d754-a610-3e2c-9fd7-e290aca9a8da",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "The middle of the strike zone in baseball where a pitch is most easily hit."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a058949c-0175-39bc-9dfd-98c31faaeb8f",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "A pronounced, enjoyable rhythm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5865d050-e302-4a6b-a420-1bbf4c11c3de",
                                                "sense_id": "a058949c-0175-39bc-9dfd-98c31faaeb8f",
                                                "text": "Now, what you hear is not a test, I'm rapping to the beat / And me, the groove, and my friends are gonna try to move your feet"
                                            },
                                            {
                                                "example_id": "45df5cf6-3578-4bef-99d0-7251dd1d917a",
                                                "sense_id": "a058949c-0175-39bc-9dfd-98c31faaeb8f",
                                                "text": "Let the music play / He won't get away / This groove he can't ignore"
                                            },
                                            {
                                                "example_id": "5f6f1407-18eb-441e-95fb-2d4dabd174ce",
                                                "sense_id": "a058949c-0175-39bc-9dfd-98c31faaeb8f",
                                                "text": "Get into the groove / Boy, you've got to prove / Your love to me / Get up on your feet / Yeah, step to the beat"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f693de34-4f52-394d-979a-6527585ff0d3",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "A good feeling (often as in the groove)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839b805c-bd7a-439a-ac1f-d8d2d6ca4f3d",
                                                "sense_id": "f693de34-4f52-394d-979a-6527585ff0d3",
                                                "text": "You can't hide forever, just decide to make it better / Turn it into something good / Remember, you can choose not to lose / Find your groove and be a winner"
                                            },
                                            {
                                                "example_id": "488895a6-9eda-4f8f-8138-fda68084ff13",
                                                "sense_id": "f693de34-4f52-394d-979a-6527585ff0d3",
                                                "text": "How could he be expected to make music that put the audience in a groove, he reasoned, if he wasn't grooving himself?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca6190d5-0fbc-312f-af79-32b935bba6f7",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "A shaft or excavation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "01de609b-e461-35fe-a20f-12ea97841c04",
                                        "entry_id": "deefc8cc-4c8a-3b8b-b9ec-5ef57d149fb2",
                                        "glosses": [
                                            "The optimal route around the track, or any of several such routes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "groove",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af081611-326d-3bf0-84e0-59e72f4989eb",
                                        "entry_id": "9b288888-8a93-39c1-b95b-9a187e01ab15",
                                        "glosses": [
                                            "To cut a groove or channel in; to form into channels or grooves; to furrow."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29e22854-f317-49c6-baa5-02c1da0381b9",
                                                "sense_id": "af081611-326d-3bf0-84e0-59e72f4989eb",
                                                "text": "The path to my fixed purpose is laid with iron rails, whereon my soul is grooved to run."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61cf35fa-abbb-351a-8258-112d9b2bb4a3",
                                        "entry_id": "9b288888-8a93-39c1-b95b-9a187e01ab15",
                                        "glosses": [
                                            "To perform, dance to, or enjoy rhythmic music."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a5ef4ab-b0d5-42dd-b9c8-3976a8e0c81b",
                                                "sense_id": "61cf35fa-abbb-351a-8258-112d9b2bb4a3",
                                                "text": "I was just starting to groove to the band when we had to leave."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed296f39-9dcd-4376-8686-f9460fc22205",
                        "source_entry_id": "808f9e0c-7a36-3fee-80ab-123c1d56f6b2",
                        "source_sense_id": "a458de85-916d-3c68-981e-9c9d3facf7a2",
                        "target_lang_word": "furrow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "A trench cut in the soil, as when plowed in order to plant a crop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de844c95-7efe-44ca-8c8e-f3be5b20098c",
                                                "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                                "text": "Don't walk across that deep furrow in the field."
                                            },
                                            {
                                                "example_id": "16a627d3-4120-4840-969e-07922b634ea8",
                                                "sense_id": "154e8929-812d-3f97-8b3f-9f2b473210e9",
                                                "text": "The family feeling was intensified as we stopped to speak to mothers in the cottage gardens, or waved to distant tractors turning over chocolate-brown furrows and driven by 'my dad' or 'my Uncle Bob'."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "427d9365-d559-3bca-960c-6b6a951aa040",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "Any trench, channel, or groove, as in wood or metal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7bcffa7b-890c-3ebc-94d1-4c4363f24082",
                                        "entry_id": "7993cac4-cb09-3fb7-8467-a57632188210",
                                        "glosses": [
                                            "A deep wrinkle in the skin of the face, especially on the forehead."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "463d91f6-2ad0-4cac-92df-c8f5a9454dda",
                                                "sense_id": "7bcffa7b-890c-3ebc-94d1-4c4363f24082",
                                                "text": "When she was tired, a deep furrow appeared on her forehead."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "furrow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To cut one or more grooves in (the ground, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f7c2df6-7ab4-4d6e-a286-b0dd11dbbc65",
                                                "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                                "text": "Cart wheels can furrow roads."
                                            },
                                            {
                                                "example_id": "d8efa477-65c7-46f7-a59e-168ea43d46ff",
                                                "sense_id": "8a886832-8a2d-3bf4-afa9-725ac1e9f78b",
                                                "text": "Morn in the white wake of the morning star / Came furrowing all the orient into gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "040f9fba-9041-30e3-ab22-a6fd7845c97e",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To wrinkle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf2abce6-a228-34cf-a6f5-b169651bbcbf",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "To pull one's brows or eyebrows together due to concentration, worry, etc."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06054e58-5104-43ee-a0b0-106f1f742b4f",
                                                "sense_id": "cf2abce6-a228-34cf-a6f5-b169651bbcbf",
                                                "text": "As she pored over the company's bewildering tax documents, she furrowed her brows, wrinkled her nose, and began to frown her befuddlement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c064d335-75c7-313e-af1e-74d73548423d",
                                        "entry_id": "513ae711-3c59-3aba-87e6-f4bb8b69b109",
                                        "glosses": [
                                            "to become furrowed"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40cdab0-0960-40e7-90c4-1663f592d7af",
                                                "sense_id": "c064d335-75c7-313e-af1e-74d73548423d",
                                                "text": "If you were bold enough to ask Antonin Scalia questions, you had to be precise. Otherwise the bushy black brows would furrow, the chin would crumple and the pudgy, puckish body would start to rock, eager to get at you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
