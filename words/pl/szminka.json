            "senses": [
                {
                    "sense_id": "ffa7c562-f133-359a-905e-648c9347fafe",
                    "sense_definition": "kosmetyk w sztyfcie używany do barwienia i pielęgnacji ust",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "makijaż",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyjściem z domu pomalowała usta czerwoną <w>szminką</w>.",
                            "target_lang_translations": {
                                "ru": "Перед выходом из дома она накрасила губы красной <w>помадой</w>."
                            }
                        },
                        {
                            "text": "W torebce zawsze nosiła małe lusterko oraz ulubioną <w>szminkę</w>.",
                            "target_lang_translations": {
                                "ru": "В сумочке она всегда носила маленькое зеркальце и любимую <w>помаду</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pomadka",
                        "pomadka do ust"
                    ],
                    "common_phrases": [
                        "czerwona szminka",
                        "malować usta szminką"
                    ],
                    "target_lang_definitions": {
                        "ru": "косметическое средство в виде стика, используемое для окрашивания и ухода за губами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "губная помада",
                                "target_lang_sense_clarification": "косметика для губ"
                            },
                            {
                                "target_lang_word": "помада",
                                "target_lang_sense_clarification": "для губ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02ad12e5-f891-39fb-b870-f71005db01b1",
                    "sense_definition": "kosmetyk kryjący używany w charakteryzacji i makijażu scenicznym",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "makijaż",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Charakteryzator nałożył grubą warstwę teatralnej <w>szminki</w> na twarz aktora.",
                            "target_lang_translations": {
                                "ru": "Гримёр нанёс толстый слой театрального <w>грима</w> на лицо актёра."
                            }
                        },
                        {
                            "text": "Do roli starca potrzebna była specjalna, kryjąca <w>szminka</w> sceniczna.",
                            "target_lang_translations": {
                                "ru": "Для роли старика требовался специальный плотный сценический <w>грим</w>."
                            }
