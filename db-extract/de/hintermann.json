                        "source_sense_id": "c9e626d0-24a6-3f65-9308-8afcb3d9c990",
                        "source_sense_description": "Person, die heimlich an etwas beteiligt ist, deren Aktivität aber nicht bekannt ist",
                        "target_lang_word": "instigateur",
