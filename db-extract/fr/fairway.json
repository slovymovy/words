                                                "example_id": "12cfa28d-6a9d-491d-9f6d-16a2841c75e7",
                                                "sense_id": "3c73ab53-b682-39d3-89af-46450a283bf1",
                                                "text": "Lights of ships moved in the fairway—a great stir of lights going up and going down."
