                        "form": "Same"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e309fba8-821e-3050-b512-93cc50871de1",
                        "entry_id": "7b1c82e5-3ca3-329c-bf3d-8e9b3e71360f",
                        "glosses": [
                            "Membre d’un peuple de Laponie parlant le sami."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1a7868-46e5-4076-8d38-db875eacb9cd",
                                "sense_id": "e309fba8-821e-3050-b512-93cc50871de1",
                                "text": "Le chemin de fer doit traverser des pâturages réservés aux rennes ? Rien de grave. Côté finlandais, le conseil régional de Laponie a aussi tranché que les Sami, peuple aborigène du nord de l’Europe, ne bénéficieraient d’aucun droit de veto pour un projet d’une telle importance – pour autant qu’il arrive à terme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18e7c0ba-09d0-4932-aa4b-78ae2df55738",
                        "source_entry_id": "7b1c82e5-3ca3-329c-bf3d-8e9b3e71360f",
                        "source_sense_id": "e309fba8-821e-3050-b512-93cc50871de1",
                        "target_lang_word": "Same",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Same",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93a03f85-d343-3702-ac49-bad60e690bdf",
                                        "entry_id": "69e78bed-ef73-3a13-8121-c8ffdbf5935b",
                                        "glosses": [
                                            "vielzelliger Fortpflanzungskörper der Samenpflanzen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e0dcd5d-4bb5-48f8-9dc7-f2a933c92c6e",
                                                "sense_id": "93a03f85-d343-3702-ac49-bad60e690bdf",
                                                "text": "Zum Schutz sind die Samen mit Hüllen umgeben."
                                            },
                                            {
                                                "example_id": "ea524051-b4ef-4d15-b43f-ef483b691d61",
                                                "sense_id": "93a03f85-d343-3702-ac49-bad60e690bdf",
                                                "text": "„Die Samen sind empfindlich, werden ranzig und faulen.“"
                                            },
                                            {
                                                "example_id": "38d5c58c-6af7-4737-80b5-ae8c2f23a843",
                                                "sense_id": "93a03f85-d343-3702-ac49-bad60e690bdf",
                                                "text": "„Sie verstreicht einen Teil des Samens mit dem Zeigefinger auf seinem Bauch, während sie die letzten schwachen Krämpfe beobachtet.“"
                                            },
                                            {
                                                "example_id": "ba048bba-d9df-4805-8454-f185ed7a7c49",
                                                "sense_id": "93a03f85-d343-3702-ac49-bad60e690bdf",
                                                "text": "„Die meisten Pflanzen hat sie selbst aus den Samen, die sie noch in der Herbstsonne getrocknet hat, gezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "462c0893-baac-3646-b81d-5467f8f4b40e",
                                        "entry_id": "69e78bed-ef73-3a13-8121-c8ffdbf5935b",
                                        "glosses": [
                                            "männliches Spermium beziehungsweise spermienhaltiges Sekret"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Same",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                        "entry_id": "f00e4adc-4f29-34cb-bf8b-fdcc3bd989b1",
                                        "glosses": [
                                            "ein eingeborenes Volk im Norden von Finnland, Schweden und Norwegen"
                                        ],
                                        "tags": [
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe650e5a-d8ae-4001-8b74-36643d4e3d71",
                                                "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                                "text": "Die Samen sind traditionell Rentierzüchter."
                                            },
                                            {
                                                "example_id": "6ad5ec08-d50a-41a2-a4a2-bd6038e3d267",
                                                "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                                "text": "Die rund 70.000 Samen leben im Norden von Norwegen (40.000), Schweden (20.000), Finnland (6.500) und auf der russischen Halbinsel Kola (2.000)."
                                            },
                                            {
                                                "example_id": "88cf3b77-8817-430a-abd1-e438fa482c65",
                                                "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                                "text": "„Um Ländergrenzen haben sich die Samen nie groß gekümmert.“"
                                            },
                                            {
                                                "example_id": "4a11e855-2764-4b4e-ae6c-66e91cd270c2",
                                                "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                                "text": "„Skandinavien ist zu jener Zeit vom Nomadenvolk der Samen, vor allem jedoch von germanischen Stämmen besiedelt, die eine gemeinsame Sprache sprechen.“"
                                            },
                                            {
                                                "example_id": "af13bcac-6198-42b9-a612-835f0c8503ae",
                                                "sense_id": "f7b35e3e-a2b8-3153-a615-eef32b669c32",
                                                "text": "Nach den DNA-Untersuchungen von Cavalli-Sforza bilden die Samen genetisch den Übergang von den Europäern zu den Ostasiaten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ff57ce6-3412-3e2f-b31c-3c89adc14bdf",
                                        "entry_id": "f00e4adc-4f29-34cb-bf8b-fdcc3bd989b1",
                                        "glosses": [
                                            "ein Angehöriger des gleichnamigen Volkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2566a703-ee10-4a6a-a222-188f5779f432",
                                                "sense_id": "7ff57ce6-3412-3e2f-b31c-3c89adc14bdf",
                                                "text": "Der Same züchtet traditionell Rentiere."
                                            },
                                            {
                                                "example_id": "ba15629c-e904-4105-acca-235d75ce1018",
                                                "sense_id": "7ff57ce6-3412-3e2f-b31c-3c89adc14bdf",
                                                "text": "„Kalevi ist Same und Besitzer einer halbwilden Rentierherde.“"
                                            },
                                            {
                                                "example_id": "972c5bf6-7d62-4e85-b488-5c65dd98b5bb",
                                                "sense_id": "7ff57ce6-3412-3e2f-b31c-3c89adc14bdf",
                                                "text": "„Sie hatte das breite Gesicht samischer Frauen, und laut dem Alten Tóvó gehörte zu ihren Ahnen tatsächlich der Same Aslak Orbes, der kurz nach der Reformation Barbier in Tórshavn gewesen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
