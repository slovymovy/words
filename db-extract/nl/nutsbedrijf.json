                ],
                "senses": [
                    {
                        "sense_id": "338bdff7-673f-36f0-83e2-8e4779ea8b1f",
                        "entry_id": "42fe3eb3-5458-378d-ab1c-99fad8931bdd",
                        "glosses": [
                            "een bedrijf dat, vaak vanuit een monopoliepositie, opereert in een sector die van openbaar nut is omdat het belangrijke producten of diensten levert die in het algemeen belang zijn (met name gas, water, elektriciteit en openbaar vervoer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d437fcaf-9797-4790-8a63-23c08958ae4a",
                                "sense_id": "338bdff7-673f-36f0-83e2-8e4779ea8b1f",
                                "text": "Als de grootste Vlaamse politieke partij N-VA haar plannen voor een groot Vlaamse nutsbedrijf voor energie hard wil maken, dan mag het alvast grote weerstand vanuit Limburg verwachten. Ludo Kelchtermans, de topman van Nuhma, de Limburgse intergemeentelijke investeringsmaatschappij, lost vandaag in het Belang van Limburg alvast een schot voor de boeg."
                            },
                            {
                                "example_id": "7cdd4b40-b2d4-4906-a865-ca73b80e09f7",
                                "sense_id": "338bdff7-673f-36f0-83e2-8e4779ea8b1f",
                                "text": "De betrokken gemeenten, uitgezonderd Berkelland, willen de AGEM een impuls geven door bij dat bedrijf vanaf 1 januari 2018 groene en duurzame energie af te nemen. Tot nu toe kochten ze hun stroom en gas collectief in bij een landelijk opererend nutsbedrijf, Greenchoice, maar dat contract loopt met ingang van volgend jaar af. De gemeenten grijpen nu de gelegenheid aan over te verstappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48e166f6-2347-41c3-9bf6-bf6905bbd3c7",
                        "source_entry_id": "42fe3eb3-5458-378d-ab1c-99fad8931bdd",
                        "source_sense_id": "338bdff7-673f-36f0-83e2-8e4779ea8b1f",
                        "source_sense_description": "een bedrijf dat, vaak vanuit een monopoliepositie, opereert in een sector die van openbaar nut is omdat het belangrijke producten of diensten levert die in het algemeen belang zijn (met name gas, water, elektriciteit en openbaar vervoer)",
                        "target_lang_word": "public service",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "public service",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "A service performed for the public good."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b83b0bc-919f-4491-871b-e270731655bc",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "They feel that public service is a noble calling that calls for every citizen in one way or another."
                                            },
                                            {
                                                "example_id": "37c4111a-3442-4d7b-a02d-a75bbeab847c",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "They provide counseling as a public service."
                                            },
                                            {
                                                "example_id": "3ee9e9d9-bc5a-40b9-b208-02863c6d8a53",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "This has been a public service announcement from the Advertising Council."
                                            },
                                            {
                                                "example_id": "78654f6a-e9ac-44e8-8a2d-442bfca2217a",
                                                "sense_id": "22d228fd-0230-35b6-9f7d-bc1a712208b2",
                                                "text": "A Hypocrite may put on the World in many specious Duties, to the Ruin of the Public, but never can be a Condidate^([sic]) for Fame, without doing a Public Service, a general Good ev’n by the very Hypocrisy […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2f95bb-62af-359b-a091-c183ec419e7a",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "A service such as health care, transport, or waste removal provided to the general public, often by the government."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30503d42-5bec-4fd7-8549-60a7e885a72d",
                                                "sense_id": "ca2f95bb-62af-359b-a091-c183ec419e7a",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. Essential public services are cut so that the rich may pay less tax. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f79646d9-5161-38c0-850b-d31ad4ceeb52",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "The organisation, department or business providing such a service."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                        "entry_id": "5a7c5138-fa0c-3c9e-a977-4e37a180bbbb",
                                        "glosses": [
                                            "Government employment, especially in the civil service."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3342d12e-67d0-4db1-b308-018ef91e0297",
                                                "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                                "text": "In spite of more than three decades of public service, I knew I was an unknown quantity to many of my countrymen and to much of the world when I assumed office."
                                            },
                                            {
                                                "example_id": "33ecf36f-caad-4fa6-a735-ed5aa1a52594",
                                                "sense_id": "66b9e020-a47e-3fb5-b364-315b8c144e0b",
                                                "text": "We know that there are people in much lower offices in public service who adhere to those principles without question and without problems. Does my right hon. Friend find it regrettable that the Prime Minister does not?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
