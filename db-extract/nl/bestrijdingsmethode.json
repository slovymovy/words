                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1141b2e-7c8d-49dd-aeea-c6d4dca86139",
                                "sense_id": "7dc86a10-fee0-3445-ae03-730f9550a99a",
                                "text": "De Vlinderstichting roept gemeenten op om per direct te minderen met het gebruik van bacteriepreparaten en aaltjes als bestrijdingsmethode tegen de eikenprocessierups. Want die doden niet alleen de eikenprocessierups, maar ook andere rupsen van ruim 100 andere soorten die in de eiken leven."
                            },
                            {
                                "example_id": "1c6427a0-f3c8-4b8b-8e5f-f4892a0c90af",
                                "sense_id": "7dc86a10-fee0-3445-ae03-730f9550a99a",
                                "text": "Er is een nieuwe bestrijdingsmethode tegen teken ontdekt: wormpjes. De beestjes kruipen bij een teek naar binnen en laten daar bacteriën los waardoor de teken sterven."
                            },
                            {
                                "example_id": "72ad143f-38d3-4100-8d67-3847cc662f74",
                                "sense_id": "7dc86a10-fee0-3445-ae03-730f9550a99a",
                                "text": "De rechtbank in Amsterdam verbiedt het bestrijden van meeuwen door hun nesten te verstoren. Steden moeten stoppen met die bestrijdingsmethode, omdat een ontheffing die de gemeenten kregen van het Rijk in strijd is met de wet."
                            }
                        ]
                    }
