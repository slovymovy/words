{
    "word_family": [
        "veerkracht",
        "veer",
        "kracht"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "12f1fcb0-9ec3-3ddb-baa1-2caeeff8275f",
                    "sense_definition": "in staat om na een tegenslag of vervorming snel de oorspronkelijke toestand of kracht te herstellen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "resilience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De economie bleek verrassend <w>veerkrachtig</w> na de zware crisis van vorig jaar.",
                            "target_lang_translations": {
                                "en": "The economy proved to be surprisingly <w>resilient</w> after last year's severe crisis."
                            }
                        },
                        {
                            "text": "Zij is een <w>veerkrachtig</w> persoon die altijd weer op haar pootjes terechtkomt.",
                            "target_lang_translations": {
                                "en": "She is a <w>resilient</w> person who always lands on her feet."
                            }
                        }
                    ],
                    "synonyms": [
                        "flexibel",
                        "elastisch",
                        "incasseringsvermogen"
                    ],
                    "antonyms": [
                        "kwetsbaar",
                        "star",
                        "onbuigzaam"
                    ],
                    "common_phrases": [
                        "veerkrachtig"
                    ],
                    "target_lang_definitions": {
                        "en": "able to recover quickly from setbacks, deformation, or difficult conditions to a former state or strength"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resilient",
                                "target_lang_sense_clarification": "recovering quickly from damaging events or conditions"
                            },
                            {
                                "target_lang_word": "elastic",
                                "target_lang_sense_clarification": "able to return to a former state after being depressed or overtaxed"
                            },
                            {
                                "target_lang_word": "flexible",
                                "target_lang_sense_clarification": "able to adapt to change or pressure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26695953-3914-37b6-aecd-742f32e885ec",
                    "sense_definition": "het bezitten van de fysieke eigenschap van <w>veerkracht</w>",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "resilience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sommige riffen hadden er tot dusver geen last van en wij dachten dat ze <w>veerkrachtig</w> waren.",
                            "target_lang_translations": {
                                "en": "Some reefs had not been affected so far, and we thought they were <w>resilient</w>."
                            }
                        },
                        {
                            "text": "De <w>veerkrachtige</w> bodem van het bos dempte het geluid van onze voetstappen.",
                            "target_lang_translations": {
                                "en": "The <w>springy</w> forest floor muffled the sound of our footsteps."
                            }
                        }
                    ],
                    "synonyms": [
                        "rekbaar",
                        "verend"
                    ],
                    "antonyms": [
                        "stijf"
                    ],
                    "common_phrases": [
                        "veerkrachtige"
                    ],
                    "target_lang_definitions": {
                        "en": "possessing the physical property of elasticity or springiness"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "resilient",
                                "target_lang_sense_clarification": "returning to original shape after force is applied"
                            },
                            {
                                "target_lang_word": "elastic",
                                "target_lang_sense_clarification": "capable of stretching and returning to original size"
                            },
                            {
                                "target_lang_word": "springy",
                                "target_lang_sense_clarification": "having a bouncy or flexible quality"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}