        "fr-extract.jsonl": [
            {
                "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                "word": "balustre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee501744-772e-4f6c-8e1c-f8420ce8f49b",
                        "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "tags": [
                            "plural"
                        ],
                        "form": "balustres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                        "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "glosses": [
                            "Sorte de petit pilier façonné constituant à plusieurs une balustrade."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dec67c6-7015-4b60-ba11-828c07867f39",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "Lorsqu’on voulait pénétrer dans l’habitation, on rencontrait un énorme escalier à rampe de bois taillée en balustre."
                            },
                            {
                                "example_id": "6a30258e-5d7d-45ca-962b-97fa4a98620f",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "Nous prîmes le café sur la terrasse dont les balustres, embrassés et arrachés à leur rampe de pierre par un lierre vigoureux, restaient pris entre les nœuds de la plante lascive, dans l’attitude éperdue des Athéniennes aux bras des centaures ravisseurs."
                            },
                            {
                                "example_id": "3d8218be-e910-4153-9bce-7ef14d410d89",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "La rampe de l’escalier était une rampe à balustres."
                            },
                            {
                                "example_id": "571699d2-7dbc-4e95-a3a5-639dca567d22",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "C’était une flamme de lampe, je n’en pus pas douter, qui venait vers nous, et les ombres des balustres se mirent à tourner lentement dans la cage de l’escalier."
                            },
                            {
                                "example_id": "dd6496cd-ed55-411e-ab23-f425c7515a34",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "La région a livré des céramiques à baguettes horizontales, notamment un vase ovoïde à pied balustre trouvé sur l’oppidum de Moulay."
                            },
                            {
                                "example_id": "a3bfdfaa-71f2-49eb-8962-44eeec68b51c",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "Balustre de marbre, de bronze, de bois."
                            },
                            {
                                "example_id": "39b54974-ec14-40a5-87f1-d61d0994c8d6",
                                "sense_id": "b0283941-fa0f-3a55-b5eb-c38169ac746c",
                                "text": "Balustre bien tourné."
                            }
                        ]
                    },
                    {
                        "sense_id": "651950ad-7029-376a-b016-e7a8a6cdb811",
                        "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "glosses": [
                            "Assemblage de plusieurs balustres servant de clôture dans une église ou dans une chambre."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b3f99525-f363-4ac1-96fa-429377a4e892",
                                "sense_id": "651950ad-7029-376a-b016-e7a8a6cdb811",
                                "text": "Balustre d’autel."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5b8bebc-5a59-3f03-b32c-686888d2f018",
                        "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "glosses": [
                            "Variété de compas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd562748-5238-4c55-a846-c24a934fc9be",
                                "sense_id": "a5b8bebc-5a59-3f03-b32c-686888d2f018",
                                "text": "Balustre à pompe."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc8b8afc-0d49-3720-849b-2c1989d6161f",
                        "entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "glosses": [
                            "Cépage donnant du raisin blanc. Cette espèce de vigne ne fait plus partie des espèces autorisées en France. Le vin issu de ce cépage était destiné à la distillation pour la production de cognac."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "df4b83be-3090-4b79-9aae-fdf8696d785f",
                                "sense_id": "dc8b8afc-0d49-3720-849b-2c1989d6161f",
                                "text": "Il n’existe donc aucune raison plausible pour lui adjoindre aucun autre cépage dans les vignes dont les produits sont destinés à la distillation, pas même le colombar, qui se comporte le mieux après lui, et encore moins la chalosse, la balustre, le saint-pierre, le blanc ramé, l’aubier, la franche, le pouillot, le muscadet, le clairet, dont les allures sont bien différentes parmi les cépages blancs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "986bb10a-1f46-4a77-a415-d25e0fd5c081",
                        "source_entry_id": "55513e43-8e55-3b17-8dbc-35a2a644f0ad",
                        "source_sense_description": "Sorte de petit pilier façonné.",
                        "target_lang_word": "Baluster",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Baluster",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                        "entry_id": "310f6f93-676f-34a5-aa6d-25f8511c3519",
                                        "glosses": [
                                            "gedrungenes, säulenartiges, unterschiedlich profiliertes Stützglied an einem Geländer oder an einer Brüstung"
                                        ],
                                        "tags": [
                                            "Möbeldesign"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd89d748-7d62-4324-8fb6-5019b1b782ca",
                                                "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                                "text": "\"In der Möbelkunst dienen Baluster seit der Antike als Tisch- und Stuhlbeine für Repräsentationsmöbel.\""
                                            },
                                            {
                                                "example_id": "8ae75346-072b-4ece-afd5-33e5527b0c95",
                                                "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                                "text": "Sagredo rückt den Baluster nahezu in den Rang einer eigenen Säulenordnung und leitet ihn aus dem Granatapfelbaum ab."
                                            },
                                            {
                                                "example_id": "8580d639-5c09-4bee-ba54-f39d4a652c7a",
                                                "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                                "text": "Der Baluster mit seiner Anspielung auf Granada als Symbol des vereinigten Spanien, dessen regierender Herrscher, Kaiser Karl V., Europa beherrschte, konnte daher die Bedeutung einer national-spanischen Ordnung gewinnen."
                                            },
                                            {
                                                "example_id": "362da9ad-2293-407e-a6c7-4beb0ffe630e",
                                                "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                                "text": "Sie leben vom Licht – die Fassaden und Figuren, die Baluster und Säulen, die Brunnen und Hauseingänge, die Vorhöfe und berankten Gitter, sie leben von der Sonne, den Schatten der Wolken, vom spiegelnden Regenpflaster und dem gelben Schein der Straßenlaternen, in dem es leichtfällt, sich das lebendige und prunkvolle Straßenleben im Bordeaux des 18. Jahrhunderts vorzustellen."
                                            },
                                            {
                                                "example_id": "219a7a81-fcc4-49d5-91b5-9288d93c1e76",
                                                "sense_id": "71aa3c9f-f995-36ea-9649-e72941c806d9",
                                                "text": "Also: Die Architrave, Gesimse und Baluster wurden demontiert, und Kiesel-Kratzputz kam an die Fassade."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
