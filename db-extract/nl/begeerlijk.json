                "senses": [
                    {
                        "sense_id": "c03f9ce6-e4f7-3c2a-b61d-d7e63a236bd6",
                        "entry_id": "9671a61e-485f-3d3a-8e75-9fdba3bd8c8b",
                        "glosses": [
                            "van iets dat je het graag zou willen hebben, van iets dat het hebzucht opwekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e00c96c0-e224-4e68-8eee-86081eae52c0",
                                "sense_id": "c03f9ce6-e4f7-3c2a-b61d-d7e63a236bd6",
                                "text": "De dvd-box met een groot aantal films van Woody Allen was te begeerlijk om op een vergeten schap in de winkel te laten wegkwijnen. Weliswaar had ik al een aantal titels in mijn bezit – dat is de pest van die verzamelboxen – maar er waren ook minder bekende films bij die ik lang geleden had gezien."
                            },
                            {
                                "example_id": "274363a5-b28c-46c9-8e14-3c08a412666e",
                                "sense_id": "c03f9ce6-e4f7-3c2a-b61d-d7e63a236bd6",
                                "text": "Chipmaker Qualcomm koopt branchegenoot NXP voor 43 miljard euro. Het Nederlandse bedrijf werd zelf begeerlijk dankzij slimme overnames ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ae5ecf6-ea16-4afa-b64e-302255c7f4a0",
                        "source_entry_id": "9671a61e-485f-3d3a-8e75-9fdba3bd8c8b",
                        "source_sense_id": "c03f9ce6-e4f7-3c2a-b61d-d7e63a236bd6",
                        "source_sense_description": "van iets dat je het graag zou willen hebben, van iets dat het hebzucht opwekt",
                        "target_lang_word": "desirable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desirable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                        "entry_id": "830289b1-f009-365b-bfa2-afe4885714f1",
                                        "glosses": [
                                            "Worthy to be desired; pleasing; agreeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "385de243-cf5f-4429-887a-7dbdf9f0515a",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "This applicant has almost all desirable properties."
                                            },
                                            {
                                                "example_id": "8e6117db-9421-4056-bfbf-ce5384961cbb",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "It has long been recognised that complete segregation of control of the respective services provided by the two undertakings, and of the power supply, signalling, and tracks relating to each was desirable."
                                            },
                                            {
                                                "example_id": "246bdfce-00a4-45ff-ac97-79bdbda1ba30",
                                                "sense_id": "2f0c12de-13f2-38c9-9ae2-db8225e559d9",
                                                "text": "With fresh material, taxonomic conclusions are leavened by recognition that the material examined reflects the site it occupied; a herbarium packet gives one only a small fraction of the data desirable for sound conclusions. Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "desirable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dddf41bf-02fa-3834-9b4e-d6f903367861",
                                        "entry_id": "77c6221a-36cf-3650-af67-ab1fbb3cdd35",
                                        "glosses": [
                                            "A thing that people want; something that is desirable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "135ea3ff-f980-42b1-ac2f-d4f6ac7ac1df",
                                                "sense_id": "dddf41bf-02fa-3834-9b4e-d6f903367861",
                                                "text": "There are plenty of desirables on display in the window."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
