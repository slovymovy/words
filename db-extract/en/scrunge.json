                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4eade10-16bb-4945-9c42-bbae97203499",
                                "sense_id": "3776d811-0ec0-39c5-a573-ed7312829a9c",
                                "text": "Can ' t get my million - dollar paws scrunged up ."
                            },
                            {
                                "example_id": "a6346f84-18c8-48c0-9c7e-401474893860",
                                "sense_id": "3776d811-0ec0-39c5-a573-ed7312829a9c",
                                "text": "Yu'know scrunge up like when rain wet them up."
                            },
                            {
                                "example_id": "0b5c56b3-183f-4cf4-8def-b4e32c105788",
                                "sense_id": "3776d811-0ec0-39c5-a573-ed7312829a9c",
                                "text": "You were very fussy about books not getting 'scrunged'. If a book had an even slightly damaged or tatty cover, you wouldn't buy it."
                            }
                        ]
                    }
