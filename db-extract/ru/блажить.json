                "senses": [
                    {
                        "sense_id": "da4a018e-0745-34c1-a747-94332c227410",
                        "entry_id": "e65c3057-5ba3-3c22-92fa-35db487446c1",
                        "glosses": [
                            "прост. проявлять блажь, поступать своенравно, сумасбродно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa089937-0819-4459-b2d5-6fa033a2ef09",
                                "sense_id": "da4a018e-0745-34c1-a747-94332c227410",
                                "text": "— Блажишь! — закричал супруг. — Глупостей в голове много у дуры!"
                            },
                            {
                                "example_id": "9bca9250-79df-4769-8c33-7f6b0f09c25a",
                                "sense_id": "da4a018e-0745-34c1-a747-94332c227410",
                                "text": "Купец… как можно: купец не то, что барин. Купец не блажит; ну, осерчает — побьёт, да и дело с концом."
                            },
                            {
                                "example_id": "43b4d2f3-0a94-4fd8-a18d-4d38be8abb46",
                                "sense_id": "da4a018e-0745-34c1-a747-94332c227410",
                                "text": "Сказал бы я во-первых: не блажи, / Именьем, брат, не управляй оплошно, / А, главное, поди-тка, послужи."
                            },
                            {
                                "example_id": "7e234b52-3e0c-421c-b4d8-5c7d504c4876",
                                "sense_id": "da4a018e-0745-34c1-a747-94332c227410",
                                "text": "Вижу, дитя блажит, у дитяти просто головка болит!"
                            }
                        ]
                    }
                ],
