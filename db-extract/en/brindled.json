                    },
                    {
                        "form_id": "82a9b5a6-8258-4124-9c82-88596f903253",
                        "entry_id": "f1fc1a5d-05f2-3888-9006-91d944c4dd5c",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most brindled"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f65f582b-593b-3bda-862f-917b8b06f91e",
                        "entry_id": "f1fc1a5d-05f2-3888-9006-91d944c4dd5c",
                        "glosses": [
                            "Of a brownish, tawny or gray colour, with streaks or spots; streaky, spotted."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7f683dc-fb38-4fa2-acc9-e3d07a6bcfe7",
                                "sense_id": "f65f582b-593b-3bda-862f-917b8b06f91e",
                                "text": "The palace in a woody vale they found,\nHigh raised of stone; a shaded space around;\nWhere mountain wolves and brindled lions roam,\n(By magic tamed,) familiar to the dome."
                            },
                            {
                                "example_id": "4b88547c-9d2e-4e2c-93f2-cfebd1a8c706",
                                "sense_id": "f65f582b-593b-3bda-862f-917b8b06f91e",
                                "text": "All round me were tokens of a divided empire. The old grass and the new grass were striving together. In the low wet swales the verdure peeped out in vivid green ; beyond, on the mountains, lay light patches of snow, strangely relieved against their russet sides; all the humped hills looked like brindled kine in the shivers."
                            },
                            {
                                "example_id": "d9f1fb21-d6e5-45ec-b64f-e9434c4659cb",
                                "sense_id": "f65f582b-593b-3bda-862f-917b8b06f91e",
                                "text": "And there, in the middle of it was the man himself—his face twisted like a lost soul in torment, and his great brindled beard stuck upwards in his agony."
                            },
                            {
                                "example_id": "ed966c8e-9f77-4795-8b18-303b3fc7febb",
                                "sense_id": "f65f582b-593b-3bda-862f-917b8b06f91e",
                                "text": "Some brindled curs hurried from beneath the houses to sniff at Flo […]"
                            }
                        ]
                    }
                ],
