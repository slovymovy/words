        "de-extract.jsonl": [
            {
                "entry_id": "38d59370-6f1e-3389-a7df-dd52175cc690",
                "word": "vivoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                        "entry_id": "38d59370-6f1e-3389-a7df-dd52175cc690",
                        "glosses": [
                            "(das zumeist geräumigste) Zimmer in einem Haus oder einer Wohnung, das für den Aufenthalt von Personen am Tag bestimmt ist"
                        ],
                        "tags": [
                            "Canada",
                            "literary",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "c0344dce-6cc1-4a80-838b-e92fb5b3f816",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Mon petit vivoir déborde de cartons roses, bleus, blancs, il parfume toutes les effluves printanières; […].»",
                                "translation": "„Mein kleines Wohnzimmer quillt über vor rosa, blauen und weißen Schächtelchen, es verströmt allerlei Frühlingsdüfte; […].“"
                            },
                            {
                                "example_id": "0d7977d3-2cc5-4e5c-b78b-72541c438fd5",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Pendant l’écoulement ininterrompu de ce monologue, Gagnon avait fait entrer le Beaucairois dans le vivoir, et lui avait offert, du geste, une grande berceuse en bois nature.»",
                                "translation": "„Während dieses endlosen Monologs hatte Gagnon den Beaucairer in das Wohnzimmer hineingeführt und ihm mit einer Geste einen großen Schaukelstuhl aus Naturholz angeboten.“"
                            },
                            {
                                "example_id": "60d03980-fb7d-43c4-a533-6c961f15cc6f",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Un jour, pendant que la mère et la fille lavaient la vaiselle après le souper, Tamareau entraîna Pilon au vivoir.»",
                                "translation": "„Eines Tages, während Mutter und Tochter nach dem Abendessen den Abwasch besorgten, zog Tamareau Pilon mit sich in das Wohnzimmer.“"
                            },
                            {
                                "example_id": "d3ee43fd-d1a6-4470-9218-973a7aa930f5",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Le soir nous étions tous quatre dans le vivoir de notre baraquement, causant, écoutant la radio, lisant.»",
                                "translation": "„Abends waren wir vier alle im Wohnzimmer unserer bescheidenen Hütte und quatschten, hörten Radio, lasen.“"
                            },
                            {
                                "example_id": "4c18553d-f1ea-4927-a26a-ab89ad32569d",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Et le vivoir, c’est le cas de le dire, est jonché d'instruments de musique.»",
                                "translation": "„Und das Wohnzimmer, das darf man wohl so sagen, ist übersät mit Musikinstrumenten.“"
                            },
                            {
                                "example_id": "4ead99bd-f079-48b1-bbd2-18ac860ad63b",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Son vivoir est rempli de magnifiques clavecins!»",
                                "translation": "„Sein Wohnzimmer ist voller großartiger Cembali!“"
                            },
                            {
                                "example_id": "e2b4b3ad-8aad-4917-9055-aff4f9e76de4",
                                "sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                                "text": "«Je vais tout décloisonner le cœur, que j’aménagerai en vivoir, chauffé au bois, cuisine à même, avec de grands châssis se répondant de bord en bord.»",
                                "translation": "„Ich werde alle Trennwände vom Gebäudekern einreißen, den ich in ein mit Holz beheiztes Wohnzimmer umbaue, zu dem sich die Küche öffnet und große Fenster parallel von einer Seite zur anderen verlaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "149584d6-7700-48f1-9dde-be85898bb95b",
                        "source_entry_id": "38d59370-6f1e-3389-a7df-dd52175cc690",
                        "source_sense_id": "882631a6-8064-3b10-8dcd-b90e8101b328",
                        "target_lang_word": "Wohnzimmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohnzimmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Raum in einem Haus oder einer Wohnung, der für den Aufenthalt von Personen am Tag bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c88b32-8655-4e34-81e9-fec041e72d1e",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "Das Wohnzimmer ist meist der größte Wohnraum."
                                            },
                                            {
                                                "example_id": "6d44d3f2-fe32-45ca-8b5b-d30f5d946645",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er stand auf, ließ Hugo und mich im Arbeitszimmer zurück und ging ins Wohnzimmer, wo er sich einen Whiskey aus der Hausbar einschenken würde, einen großen.“"
                                            },
                                            {
                                                "example_id": "648a9392-9d10-4fc8-a742-28cdd4675c4b",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Morell saß, an einem Glas Brandy nippend, in dem warmen Wohnzimmer in Westminster, dem seine Frau eine echt weibliche Note gegeben hatte.“"
                                            },
                                            {
                                                "example_id": "263baad3-9cc7-4d71-b4b3-da18c5f7a8c1",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Sie rannte mit wehender Pelerine ins Wohnzimmer und warf Aschenbecher unter das Klavier.“"
                                            },
                                            {
                                                "example_id": "3b550fb1-50f0-4a46-a6d6-5ec4008cee0d",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Neben ihrer Schlafcouch im Wohnzimmer hängt ein Wandteppich mit einer idyllischen Waldszene.“"
                                            },
                                            {
                                                "example_id": "b3287855-da2a-4b2e-87b9-3435fb7fb86f",
                                                "sense_id": "af4ff3a9-ba6b-3f9c-a327-6d129bd279ba",
                                                "text": "„Er beobachtete den unten schmiedeeisernen, oben grüngekachelten Ofen im Wohnzimmer wie ein widerspenstiges, gefährliches Biest.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                        "entry_id": "a2326fd5-4ead-3ace-b316-69930fc7b9fa",
                                        "glosses": [
                                            "Einrichtung eines Wohnzimmers^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab2700c-fda7-4abe-b0d4-455145bd5ac8",
                                                "sense_id": "87274038-cbab-372d-9ed1-ae28097ecfc4",
                                                "text": "Wir haben uns endlich entschlossen, ein neues Wohnzimmer zu kaufen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
