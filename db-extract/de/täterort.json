                        "glosses": [
                            "a site of perpetration, especially in reference to Nazi Germany"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "875f24cb-cb9d-49a8-95e8-b628b722dc64",
                                "sense_id": "f5f3e78d-929f-3ac7-a8f7-658fbda4f000",
                                "text": "Dass der Marinestützpunkt in Flensburg ein Täterort ist, steht außer Frage: Von hier aus führte Hitlers Nachfolger als Reichskanzler, Großadmiral Karl Dönitz, die Regierung in der letzten Tagen vor der Kapitulation, erließ Durchhaltebefehle, die in den ersten Maitagen noch mal Tausende Soldaten in den Tod schickten."
                            }
                        ]
                    }
